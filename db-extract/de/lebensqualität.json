                ],
                "senses": [
                    {
                        "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                        "entry_id": "2aff38b7-dafe-3ce7-923e-98adfc3d8704",
                        "glosses": [
                            "die Gesamtheit verschiedener Faktoren, die das Wohlbefinden eines Menschen innerhalb einer Gesellschaft beeinflussen"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "c88b5447-2109-42dd-bb5f-fa75329c2413",
                                "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                                "text": "„Die Befürworter des Referendums in der Schweiz erhoffen sich mehr Lebensqualität und einen höheren Wohlstand, wenn der Zuzug begrenzt wird.“"
                            },
                            {
                                "example_id": "1ae72986-f226-4a6d-9d43-7a0a3435f5e7",
                                "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                                "text": "„Die Einheimischen fürchten, durch die Entwicklung des Tourismus werde ihre Lebensqualität beeinträchtigt.“"
                            },
                            {
                                "example_id": "8a7746cb-04f7-4e96-a0ee-6dd3c600f4d8",
                                "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                                "text": "„In diesen Vororten ist eine Ahnung von der Lebensqualität erhalten geblieben, die das alte Dresden kennzeichnete.“"
                            },
                            {
                                "example_id": "df614af8-8bbc-4198-8538-44aea1469f0f",
                                "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                                "text": "„Dasselbe Herzmedikament bringt Frauen also in Lebensgefahr und verhilft Männern zu größerer Lebensqualität.“"
                            },
                            {
                                "example_id": "95fc7a00-e711-4d75-aea9-b5969b41fa44",
                                "sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                                "text": "„Erst wenn Mut, Zivilcvourage, Wagnisbereitschaft zu einer Art praktizierter Lebensphilosophie werden, wenn sie sich zu Charaktertugenden entwickeln, kann Wagen eine bedeutende wertbildende Wirksamkeit entfalten und zu einer wesentlichern Erhöhung der Lebensqualität beitragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "644ee6c0-d381-4990-9053-9a4d5cc87ba9",
                        "source_entry_id": "2aff38b7-dafe-3ce7-923e-98adfc3d8704",
                        "source_sense_id": "fb2fc9e9-240d-3fb6-94cb-e789e84bc1f3",
                        "target_lang_word": "quality of life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quality of life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6614d7-77e8-3c82-b342-d998d6b1f1f8",
                                        "entry_id": "9f2961c7-40ba-3862-9c0f-f5d5bb1b722a",
                                        "glosses": [
                                            "The general well-being of someone, and the degree to which someone's daily experience is enjoyable or unenjoyable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e2425d-b7da-4dde-8792-6b3d37ddf17f",
                                                "sense_id": "0b6614d7-77e8-3c82-b342-d998d6b1f1f8",
                                                "text": "health-related quality of life"
                                            },
                                            {
                                                "example_id": "1858d076-940c-4dc4-bc8a-ba6562b6eb25",
                                                "sense_id": "0b6614d7-77e8-3c82-b342-d998d6b1f1f8",
                                                "text": "And almost anyone can have quality of life destroyed by pain."
                                            },
                                            {
                                                "example_id": "8c72c4e4-f602-4ad4-8071-05d4eeb012fa",
                                                "sense_id": "0b6614d7-77e8-3c82-b342-d998d6b1f1f8",
                                                "text": "At the Liouguei Reconstruction centre, the guiding philosophy was helping people regain quality of life in ways that reconciled reconstruction activities with the maintenance of social and cultural traditions, both community and school-based."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc04f30-7754-3439-a727-263d538dad8d",
                                        "entry_id": "9f2961c7-40ba-3862-9c0f-f5d5bb1b722a",
                                        "glosses": [
                                            "The general well-being of someone, and the degree to which someone's daily experience is enjoyable or unenjoyable.",
                                            "Concerning prevailing conditions in public, such as cleanliness, safety, and the pleasantness of the surroundings or lack thereof."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c710d9f4-6dc9-430d-a936-6c5501b7a0f3",
                                                "sense_id": "3dc04f30-7754-3439-a727-263d538dad8d",
                                                "text": "quality-of-life offenses such as graffiti writing, loitering, public urination, public drinking, aggressive panhandling, and turnstile jumping"
                                            },
                                            {
                                                "example_id": "e1aa5e50-854d-4fd9-a7a1-074f2972549f",
                                                "sense_id": "3dc04f30-7754-3439-a727-263d538dad8d",
                                                "text": "In July 1994, New York City mayor Rudolph Giuliani and police commissioner William Bratton began implementing an order-maintenance policing strategy emphasizing proactive and aggressive enforcement of misdemeanor laws against quality-of-life offenses such as graffiti writing, loitering, public urination, public drinking, aggressive panhandling, turnstile jumping, and prostitution."
                                            }
                                        ]
                                    },
