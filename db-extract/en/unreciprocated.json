                    {
                        "sense_id": "da70973c-9cf3-3374-a582-4ca0d1f97e25",
                        "entry_id": "7b13931f-8f73-3143-9b5c-34e400d90d2e",
                        "glosses": [
                            "Not reciprocated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "acfd3b46-652b-4ae3-91cc-77a828fb01f6",
                                "sense_id": "da70973c-9cf3-3374-a582-4ca0d1f97e25",
                                "text": "His small gifts went unreciprocated."
                            },
                            {
                                "example_id": "d315add4-7bca-4fa3-9c44-7a9dd7eaba3c",
                                "sense_id": "da70973c-9cf3-3374-a582-4ca0d1f97e25",
                                "text": "Elementary-age kids might benefit from knowing that most aren’t ready for a relationship until ages 10 to 14. Until then, and even after, there is nothing wrong or weird about having unreciprocated crushes."
                            },
                            {
                                "example_id": "ed7f6560-2d46-48f2-8f11-769aef812d4f",
                                "sense_id": "da70973c-9cf3-3374-a582-4ca0d1f97e25",
                                "text": "Mankeeping describes the emotional labor women end up doing in heterosexual relationships. It goes beyond remembering birthdays or coordinating social plans. It means being your partner’s one-man support system. Managing his stress. Interpreting his moods. Holding his hand through feelings he won’t share with anyone else. All of it unpaid, unacknowledged, and often unreciprocated."
                            }
                        ]
                    }
