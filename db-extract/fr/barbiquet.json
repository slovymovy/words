                "senses": [
                    {
                        "sense_id": "f2677fe1-1a1b-330a-8c42-b117b8d7ccee",
                        "entry_id": "c75fde41-5ebf-3f64-9f3e-923bf8503bed",
                        "glosses": [
                            "Souteneur néophyte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2373cc2-04c6-4347-b48d-0ade14529c4f",
                                "sense_id": "f2677fe1-1a1b-330a-8c42-b117b8d7ccee",
                                "text": "Avec une escouade de cinglés comme l’équipe du petit Frédo, on pouvait s’attendre au pire. À du tir de rafale, à tout va, histoire simplement de faire monter leur cote, d’éblouir les petits barbiquets de leur coin en annonçant d’un air froid : — Hier soir, on a repassé Max-le-Menteur."
                            },
                            {
                                "example_id": "e904c6e0-0ef4-47a1-bd9d-2825ba95015b",
                                "sense_id": "f2677fe1-1a1b-330a-8c42-b117b8d7ccee",
                                "text": "Insensiblement, et sans se concerter, deux petits barbiquets, magnétisés par les talbins qu’ils ont vu disparaître dans le sac, ont repoussé d’un chouaye leurs godets sur le zinc en direction de Bijou."
                            },
                            {
                                "example_id": "d715b848-f48d-4c24-a1eb-6ad346019552",
                                "sense_id": "f2677fe1-1a1b-330a-8c42-b117b8d7ccee",
                                "text": "Elle le fait déjà avec son barbiquet !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "266e4dbc-3b82-4033-ab56-810e1b62aa84",
                        "source_entry_id": "c75fde41-5ebf-3f64-9f3e-923bf8503bed",
                        "source_sense_id": "f2677fe1-1a1b-330a-8c42-b117b8d7ccee",
