                    {
                        "sense_id": "3954e4bd-5983-31ce-9e89-52d9889ff27f",
                        "entry_id": "5ab7de65-a7cc-3450-b22a-09b030a58b8c",
                        "glosses": [
                            "истор. титул германских императоров; также лицо, имевшее такой титул"
                        ],
                        "tags": [],
