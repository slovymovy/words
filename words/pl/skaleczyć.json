{
    "word_family": [
        "kaleczyć",
        "kaleka",
        "kalectwo",
        "skaleczenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eee595b8-3d03-3b09-a238-ce39671d868e",
                    "sense_definition": "spowodować ranę na ciele poprzez przecięcie lub zadrapanie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko <w>skaleczyło</w> sobie palec podczas zabawy nożyczkami.",
                            "target_lang_translations": {
                                "en": "The child <w>cut</w> their finger while playing with scissors."
                            }
                        },
                        {
                            "text": "Musisz uważać, żeby nie <w>skaleczyć</w> się podczas krojenia warzyw.",
                            "target_lang_translations": {
                                "en": "You must be careful not to <w>cut</w> yourself while chopping vegetables."
                            }
                        }
                    ],
                    "synonyms": [
                        "zranić",
                        "zadrasnąć"
                    ],
                    "common_phrases": [
                        "skaleczyć palec",
                        "skaleczyć rękę"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a wound on the body by cutting or scratching."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to make an opening or wound in the skin with a sharp object"
                            },
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "to make a shallow mark or wound on the skin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a372db41-533b-3c6d-8058-18f036ead845",
                    "sense_definition": "spowodować u siebie ranę na ciele",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopiec <w>skaleczył</w> się w kolano, gdy upadł na chodnik.",
                            "target_lang_translations": {
                                "en": "The boy <w>cut</w> his knee when he fell on the sidewalk."
                            }
                        },
                        {
                            "text": "Nie <w>skalecz</w> się tym ostrym nożem.",
                            "target_lang_translations": {
                                "en": "Don't <w>cut</w> yourself with that sharp knife."
                            }
                        }
                    ],
                    "synonyms": [
                        "zranić się"
                    ],
                    "common_phrases": [
                        "skaleczyć się w palec"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a wound on one's own body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut oneself",
                                "target_lang_sense_clarification": "to accidentally injure one's own skin with a sharp object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddce6ab1-fe38-3df4-88c3-48522641d97a",
                    "sense_definition": "używać języka w sposób niepoprawny, zniekształcać go",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaforyczne_uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cudzoziemiec bardzo <w>skaleczył</w> język polski, używając błędnych końcówek.",
                            "target_lang_translations": {
                                "en": "The foreigner really <w>butchered</w> the Polish language by using the wrong endings."
                            }
                        },
                        {
                            "text": "Nie <w>skalecz</w> tego pięknego wiersza złym tłumaczeniem.",
                            "target_lang_translations": {
                                "en": "Don't <w>mangle</w> this beautiful poem with a bad translation."
                            }
                        }
                    ],
                    "synonyms": [
                        "zniekształcić",
                        "okaleczyć"
                    ],
                    "common_phrases": [
                        "skaleczyć język"
                    ],
                    "target_lang_definitions": {
                        "en": "To use a language incorrectly or distort it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "butcher",
                                "target_lang_sense_clarification": "to speak a language very poorly or incorrectly"
                            },
                            {
                                "target_lang_word": "mangle",
                                "target_lang_sense_clarification": "to ruin or spoil something, such as a language or text, by poor performance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}