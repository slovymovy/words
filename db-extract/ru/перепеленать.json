                "senses": [
                    {
                        "sense_id": "f941ceb9-8d21-37f3-90fc-14e750da8da7",
                        "entry_id": "1059966a-f501-393f-ad1c-9ac661eb50f7",
                        "glosses": [
                            "запеленать заново, ещё раз или иначе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d46a5e9-55be-4bac-ba7a-496ec3e7dc6a",
                                "sense_id": "f941ceb9-8d21-37f3-90fc-14e750da8da7",
                                "text": "Не умеет свертеть котлет, не умеет носки себе заштопать, не умеет перепеленать ребёнка, не умеет, — и теперь ещё это бывает! — даже постелить за собою постель и вынести ночную посуду."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b9828ea-a287-3e69-836c-5282b1c2b4d7",
                        "entry_id": "1059966a-f501-393f-ad1c-9ac661eb50f7",
                        "glosses": [
                            "спеленать всех, многих"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cabce7c-e422-4340-8183-97458ad62977",
                                "sense_id": "8b9828ea-a287-3e69-836c-5282b1c2b4d7",
                                "text": "Малыши всё время были с нами, только в послеродовом их забрали в детскую на 5 минут, чтобы перепеленать."
                            }
                        ]
                    }
