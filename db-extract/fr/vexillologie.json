                                "target_senses": [
                                    {
                                        "sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                                        "entry_id": "0cf6c10c-bef6-3f02-9ac2-5a2992f2a3cc",
                                        "glosses": [
                                            "Lehre vom Fahnen- und Flaggenwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eeabfc7-fe4d-4de0-abca-06de28ccd462",
                                                "sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                                                "text": "Allerorten begegnen uns Fahnen mit unterschiedlichen Bedeutungen. Z. B. in der Politik, in der Schifffahrt oder im Sport. Und es gibt eine eigene Wissenschaft über die farbigen Zeichen im Wind. Sie nennt sich Vexillologie und unterscheidet sogar zwischen Fahnen und Flaggen."
                                            }
                                        ],
