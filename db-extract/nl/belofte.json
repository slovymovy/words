                ],
                "senses": [
                    {
                        "sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                        "entry_id": "f5ff1c7b-dbd2-3a47-9a00-a6ab3f821018",
                        "glosses": [
                            "een mondelinge of schriftelijke verklaring waarin men iets belooft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f531eadb-fec1-48df-89cd-61d348f52c7c",
                                "sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                                "text": "Belofte maakt schuld."
                            },
                            {
                                "example_id": "a8dbc1c7-789c-411b-920e-3116c415331d",
                                "sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                                "text": "Tijdens de huwelijksplechtigheid doe je de belofte elkaar altijd trouw te blijven."
                            },
                            {
                                "example_id": "e32caa4d-c0ce-4087-89bd-a3f3305c41fe",
                                "sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                                "text": "Het kabinet-Schoof maakte beloften waarvan al vooraf duidelijk was dat ze nooit waargemaakt konden worden, zegt de Nationale Ombudsman. „Ik vind dat niet eerlijk tegenover de mensen in Nederland. Het heeft stilgestaan.”"
                            },
                            {
                                "example_id": "814df863-b160-4230-8619-ddd2877b673c",
                                "sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                                "text": "Hoewel ze elk woord van haar belofte meende, zou dit een onmogelijke opgave blijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d461ecd-09b5-4cfb-8ea1-600781cee621",
                        "source_entry_id": "f5ff1c7b-dbd2-3a47-9a00-a6ab3f821018",
                        "source_sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                        "source_sense_description": "een ondelinge of schriftelijke verklaring waarin men iets belooft",
                        "target_lang_word": "Versprechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versprechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                        "entry_id": "9998ce03-3c9e-3144-9d5b-ec93dca45ced",
                                        "glosses": [
                                            "Zusicherung einer Handlungsweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93dd546-86c5-4908-a01a-c2e8cf17dbf7",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "Bei einem Versprechen legt sich der Sprecher darauf fest, dass er in Zukunft etwas Bestimmtes tun oder unterlassen wird."
                                            },
                                            {
                                                "example_id": "ad289ff1-0ab2-4ab7-bea4-eafa09f2aa87",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Die Verteidigungsministerin bekräftigte zugleich ihr Versprechen, den Dienst in der Truppe attraktiver und familienfreundlicher zu gestalten.“"
                                            },
                                            {
                                                "example_id": "80e9600a-69ea-47cc-8739-80fd1ab17533",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Anna Michailowna teilte Natascha mit ein paar Worten den Inhalt des Briefes mit und nahm ihr das Versprechen ab, niemandem etwas davon zu sagen.“"
                                            },
                                            {
                                                "example_id": "76085211-730f-4ab8-b404-807138718d6a",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Endlich befreite sie ein Herr, der das Kreuz der Ehrenlegion trug; und nachdem sie ihre Namen, Vornamen und Wohnort angegeben hatten, zogen sie ab mit dem Versprechen, in Zukunft vorsichtiger zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0dff4ed-3d69-3c47-9080-dc0f93b4a503",
                                        "entry_id": "9998ce03-3c9e-3144-9d5b-ec93dca45ced",
                                        "glosses": [
                                            "Vorgang, irrtümlich etwas Anderes zu sagen, als man sagen wollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ec685c-f80e-4990-975f-67acd2a8f46d",
                                                "sense_id": "c0dff4ed-3d69-3c47-9080-dc0f93b4a503",
                                                "text": "„Druckfehler entstehen jedoch nicht einfach nur durch einen technisch-mechanischen Fehler, sondern sie sind wie oft beim Versprechen oder Verhören auch sinnvolle Versprecher im Sinne der Psychoanalyse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6e4df47-be47-4797-8593-7086d7a72e7e",
                        "source_entry_id": "f5ff1c7b-dbd2-3a47-9a00-a6ab3f821018",
                        "source_sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                        "source_sense_description": "een ondelinge of schriftelijke verklaring waarin men iets belooft",
                        "target_lang_word": "Gelöbnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelöbnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e978db-b2d6-359c-b20b-3cb243f37fd9",
                                        "entry_id": "2deaec88-67ac-3b07-af04-0133137074b0",
                                        "glosses": [
                                            "ein feierliches (rituelles) Versprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e3de29-01cf-4a11-8c9d-88983e251228",
                                                "sense_id": "84e978db-b2d6-359c-b20b-3cb243f37fd9",
                                                "text": "Ich unterzeichne dieses Gelöbnis, lerne es auswendig und wiederhole es täglich einmal laut."
                                            },
                                            {
                                                "example_id": "dea6f93b-9bba-4d13-bab2-8cd8081fb03f",
                                                "sense_id": "84e978db-b2d6-359c-b20b-3cb243f37fd9",
                                                "text": "„Wer das Gelöbnis bricht, so verkünden die Anführer, dem bringt es den Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b5fa216-677e-3226-977b-92d5e1f55133",
                                        "entry_id": "2deaec88-67ac-3b07-af04-0133137074b0",
                                        "glosses": [
                                            "Bekenntnis, das Rekruten ablegen und damit ihre Pflichten annehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b4c3dd-f2fa-480b-8500-1e57262960e9",
                                                "sense_id": "1b5fa216-677e-3226-977b-92d5e1f55133",
                                                "text": "Die Grundausbildung neigt sich dem Ende entgegen. Heute ist der Tag des Gelöbnisses."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dca238d-a0d0-4d4e-ab34-627ebb8ccd58",
                        "source_entry_id": "f5ff1c7b-dbd2-3a47-9a00-a6ab3f821018",
                        "source_sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                        "source_sense_description": "een ondelinge of schriftelijke verklaring waarin men iets belooft",
                        "target_lang_word": "promise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9030abc-d7a3-30b1-8ded-bd3c1187da20",
                                        "entry_id": "d9e77373-cb3e-37fe-871e-21feae8c89bb",
                                        "glosses": [
                                            "an oath or affirmation; a vow."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d900be-71bb-42cc-82c8-438dfd0b5725",
                                                "sense_id": "b9030abc-d7a3-30b1-8ded-bd3c1187da20",
                                                "text": "When I make a promise, I always stick to it."
                                            },
                                            {
                                                "example_id": "5bd41f07-f77c-43d8-ba23-740ddb2713d4",
                                                "sense_id": "b9030abc-d7a3-30b1-8ded-bd3c1187da20",
                                                "text": "He broke his promise: he said he'd return my jewellery, but never did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfb9ab2-63f5-3558-8860-798df485fd75",
                                        "entry_id": "d9e77373-cb3e-37fe-871e-21feae8c89bb",
                                        "glosses": [
                                            "A transaction between two persons whereby the first person undertakes in the future to render some service or gift to the second person or devotes something valuable now and here to his use."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40cd603d-1516-4056-b688-ff1f046b258a",
                                                "sense_id": "fdfb9ab2-63f5-3558-8860-798df485fd75",
                                                "text": "He purſued Andrew Houſtoun upon his promiſe, to give him the like Sallary for the next year, and in abſence obtained him to be holden as confeſt and Decerned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f6620f-0dfb-3c2f-9a86-9f88423f6416",
                                        "entry_id": "d9e77373-cb3e-37fe-871e-21feae8c89bb",
                                        "glosses": [
                                            "Reason to expect improvement or success; potential."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f8dc704-2a66-4f6d-886b-f8dee96ed28c",
                                                "sense_id": "f8f6620f-0dfb-3c2f-9a86-9f88423f6416",
                                                "text": "My native country was full of youthful promise."
                                            },
                                            {
                                                "example_id": "9eae0881-811b-4b43-925b-4d847dfe6004",
                                                "sense_id": "f8f6620f-0dfb-3c2f-9a86-9f88423f6416",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "f80cb939-767e-498e-9aa7-a51c6da56830",
                                                "sense_id": "f8f6620f-0dfb-3c2f-9a86-9f88423f6416",
                                                "text": "She shows great promise as an actress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288bbd62-5948-39db-a0b5-9ff2a180ba56",
                                        "entry_id": "d9e77373-cb3e-37fe-871e-21feae8c89bb",
                                        "glosses": [
                                            "A placeholder object representing the eventual result of an asynchronous operation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb74c4a1-b90c-4d61-bc30-3c3a433dcf50",
                                                "sense_id": "288bbd62-5948-39db-a0b5-9ff2a180ba56",
                                                "text": "You can often use observables instead of promises to deliver values asynchronously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e851e02-a96a-3c98-8ac1-49985b45b9c4",
                                        "entry_id": "d9e77373-cb3e-37fe-871e-21feae8c89bb",
                                        "glosses": [
                                            "bestowal or fulfillment of what is promised"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47f979f5-474b-465d-bcda-711987aad9f8",
                                                "sense_id": "3e851e02-a96a-3c98-8ac1-49985b45b9c4",
                                                "text": "He […] commanded them that they should not depart from Jerusalem, but wait for the promise of the Father."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "promise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                        "entry_id": "95b4150a-381c-32f2-979b-5ddf562cd64f",
                                        "glosses": [
                                            "To commit to (some action or outcome), or to assure (a person) of such commitment; to make an oath or vow."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f59d8cf-86b8-4193-b116-98822bd4f785",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "\"You think that I'll take anything.\"\n\"I know you will, sweet.\" …\n\"There wasn't going to be any of that. You promised there wouldn't be.\"\n\"Well, there is now,\" she said sweetly."
                                            },
                                            {
                                                "example_id": "baa91356-db8c-4e74-8a77-24112247d2df",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "1e4ce1aa-8feb-4146-ac86-7797c34bf048",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "If you promise not to tell anyone, I will let you have this cake for free."
                                            },
                                            {
                                                "example_id": "add61615-0c8e-45cb-abdb-1f05b4d960a0",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "She promised to never return to this town again."
                                            },
                                            {
                                                "example_id": "536dfb29-2199-43b8-9747-a63f33c10b05",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "He promised me a big kiss if I would drive him to the airport."
                                            },
                                            {
                                                "example_id": "45c9e140-5252-4cdf-a369-d016672618b5",
                                                "sense_id": "b3754ada-4424-3d1e-a1cc-1ccab203cb45",
                                                "text": "I can't promise success, but I'll do the best I can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fee1557-9ff9-3be6-acf7-655b5a913cea",
                                        "entry_id": "95b4150a-381c-32f2-979b-5ddf562cd64f",
                                        "glosses": [
                                            "To give grounds for expectation, especially of something good."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1efc85b8-4ac0-4e7a-b481-12dbe5387660",
                                                "sense_id": "4fee1557-9ff9-3be6-acf7-655b5a913cea",
                                                "text": "The clouds promise rain."
                                            },
                                            {
                                                "example_id": "914deb32-25fe-4a36-9f4e-8965071b3c20",
                                                "sense_id": "4fee1557-9ff9-3be6-acf7-655b5a913cea",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd76c1d7-5ddf-4c11-8fc5-04f9ae3a021b",
                        "source_entry_id": "f5ff1c7b-dbd2-3a47-9a00-a6ab3f821018",
                        "source_sense_id": "eb185779-1b31-3d7e-906e-6ab31e7ca60a",
                        "source_sense_description": "een ondelinge of schriftelijke verklaring waarin men iets belooft",
                        "target_lang_word": "promesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Action de promettre ; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7cdde-cd1d-4d5b-bb3d-cb608e33acbc",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Mettez-vous en garde contre ces belles promesses, elles cachent souvent la plus infame des tromperies."
                                            },
                                            {
                                                "example_id": "2e4ea110-0aa7-4ea3-bd17-ce3255016b0f",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Et il réfléchissait. Ce qui est inintelligible, se dit-il, c’est la disproportion qui existe entre les promesses que Jésus lui fit et les résultats qu’elles obtinrent."
                                            },
                                            {
                                                "example_id": "24a634ea-4833-44fc-b8a7-0ff03b941ebd",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si Dimitri ne voulait pas épouser Phoebe, il aurait au moins dû avoir le courage de l’avouer et de rompre formellement sa promesse. Au lieu de cela, il avait opté pour le silence et l'hypocrisie, […]."
                                            },
                                            {
                                                "example_id": "fd84f999-8461-44eb-aab2-b3a4802055d5",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si nous promettons une livraison, nous devons tenir notre promesse."
                                            },
                                            {
                                                "example_id": "e2199848-29a9-4050-8b7c-6a8d2e9fd84b",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Venus en Europe avec la promesse d’un salaire de 1 500 euros mensuels, « voire 2 200 avec les bonus » selon Brighton Jonasi, la plupart ne reçoivent qu’entre 600 et 700 euros, depuis octobre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Ce que l'on espère obtenir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d2bcca-4eb8-4ee7-862b-fa3c9f026cac",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le talent, chez les hommes est donc à peu près, quant au moral, ce qu’est la beauté chez les femmes, une promesse."
                                            },
                                            {
                                                "example_id": "0dbc55fc-1a54-4012-a58b-7450e1b0c595",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]."
                                            },
                                            {
                                                "example_id": "ee961b96-21bf-445e-b7bd-179a285fae5f",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Parmi les fléaux qui s'abattent sur la vigne, le plus terrible, dans ses effets, est évidemment la grêle. Le vignoble est beau, et plein de promesses, et cinq minutes plus tard il n'en reste rien ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Engagement à terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5065659e-7cba-4a64-a00b-de7f7fa300a5",
                                                "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                                "text": "Il faudrait, en premier lieu, répandre parmi nous, par le perfectionnement des institutions de crédit, l'usage des billets, des promesses, des reconnaissances. C'est dire que nos banques devraient cesser de vivre sous l'empire d'un monopole aussi absolu qu'injuste et funeste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
