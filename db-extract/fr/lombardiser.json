                "senses": [
                    {
                        "sense_id": "598174d0-1d5d-329a-bc8d-da607f148962",
                        "entry_id": "c2757ed6-b256-3c4f-8097-657663276232",
                        "glosses": [
                            "Donner un caractère lombard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8203dcc7-aa77-4dba-a202-3e174fb562e6",
                                "sense_id": "598174d0-1d5d-329a-bc8d-da607f148962",
                                "text": "Ajoutons que, comme il fallait s’y attendre, l’influence des grands centres de Milan et de Novarre tend à lombardiser de plus en plus le langage de toute la contrée."
                            },
                            {
                                "example_id": "3d738d56-2969-459d-81d1-808fa90694f3",
                                "sense_id": "598174d0-1d5d-329a-bc8d-da607f148962",
                                "text": "Pour les noms par exemple, je vais \"lombardiser\" les noms des nobles et chevaliers car ces noms avaient une consonance plus germanique que latine."
                            }
                        ]
                    }
