                ],
                "senses": [
                    {
                        "sense_id": "4b39b9df-2262-36ed-aeef-7ceae84f7dc0",
                        "entry_id": "b295bf15-e846-326a-8619-07653ce249fc",
                        "glosses": [
                            "Haut eines Babys (eines sehr jungen Kindes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3a42da-9fc8-4dcb-9b76-17288f617d4d",
                                "sense_id": "4b39b9df-2262-36ed-aeef-7ceae84f7dc0",
                                "text": "„Durch seine Sanftheit ist das Rosenhydrolat perfekt für die Pflege empfindlicher Babyhaut geeignet.“"
                            },
                            {
                                "example_id": "76a404d6-2131-467c-85f8-261df737abb0",
                                "sense_id": "4b39b9df-2262-36ed-aeef-7ceae84f7dc0",
                                "text": "„Dabei atmete er den köstlichen Duft der Babyhaut ein und spürte für einen Moment ein Glücksgefühl, das ein Lächeln auf seine sonst so.“"
                            },
                            {
                                "example_id": "86591cdf-f84f-42c3-a5e8-db3e740deb25",
                                "sense_id": "4b39b9df-2262-36ed-aeef-7ceae84f7dc0",
                                "text": "„Klar ist, dass das ohne Seife erfolgt, weil die Babyhaut gerade bei Frühgeborenen viel zu empfindlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
