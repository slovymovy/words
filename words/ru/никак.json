{
    "word_family": [
        "никакой",
        "кое-как"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "14b377c4-5c3f-3c1e-9b1c-b44ce0112e09",
                    "sense_definition": "Никоим образом, ни в коем случае, совсем не; обозначает полную невозможность совершения действия.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "negation_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>никак</w> не могу открыть эту дверь.",
                            "target_lang_translations": {
                                "en": "I <w>just</w> can't open this door.",
                                "zh": "我<w>怎么也</w>打不开这扇门。"
                            }
                        },
                        {
                            "text": "Эту проблему <w>никак</w> нельзя игнорировать.",
                            "target_lang_translations": {
                                "en": "This problem can <w>by no means</w> be ignored.",
                                "zh": "这个问题<w>无论如何</w>都不能忽视。"
                            }
                        }
                    ],
                    "synonyms": [
                        "никоим образом"
                    ],
                    "antonyms": [
                        "обязательно",
                        "непременно"
                    ],
                    "common_phrases": [
                        "никак нет",
                        "никак нельзя",
                        "никак не"
                    ],
                    "target_lang_definitions": {
                        "en": "In no way, by no means, not at all; denotes the complete impossibility of performing an action.",
                        "zh": "表示完全无法进行某项动作，意为无论如何都不、绝不。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in no way",
                                "target_lang_sense_clarification": "formal emphasis on impossibility"
                            },
                            {
                                "target_lang_word": "by no means",
                                "target_lang_sense_clarification": "formal negation"
                            },
                            {
                                "target_lang_word": "not at all",
                                "target_lang_sense_clarification": "general emphasis on negation"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "colloquial emphasis, often used with 'can't'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论如何",
                                "target_lang_sense_clarification": "强调在任何情况下都不可能"
                            },
                            {
                                "target_lang_word": "怎么也",
                                "target_lang_sense_clarification": "口语中强调无法达成某事"
                            },
                            {
                                "target_lang_word": "绝不",
                                "target_lang_sense_clarification": "正式的否定语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04586543-09d8-35cd-b176-fc94bad963ab",
                    "sense_definition": "По-прежнему не, так и не; указывает на то, что ожидаемое действие долго не происходит, несмотря на попытки.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "negation_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы всё <w>никак</w> не встретимся, хотя живём рядом.",
                            "target_lang_translations": {
                                "en": "We <w>still</w> haven't met, even though we live nearby.",
                                "zh": "虽然我们住得很近，但却<w>迟迟</w>没能见上一面。"
                            }
                        },
                        {
                            "text": "Дождь всё <w>никак</w> не прекращался.",
                            "target_lang_translations": {
                                "en": "The rain <w>just</w> wouldn't stop.",
                                "zh": "雨<w>一直没</w>停。"
                            }
                        }
                    ],
                    "synonyms": [
                        "так и не"
                    ],
                    "common_phrases": [
                        "всё никак",
                        "всё никак не"
                    ],
                    "target_lang_definitions": {
                        "en": "Still not, just not; indicates that an expected action has not happened for a long time despite attempts.",
                        "zh": "表示预期的动作经过很长时间仍未发生，意为一直没、迟迟不。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "indicating a situation continuing longer than expected"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "emphasizing the persistence of a negative situation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迟迟",
                                "target_lang_sense_clarification": "强调动作发生得太晚或未发生"
                            },
                            {
                                "target_lang_word": "一直没",
                                "target_lang_sense_clarification": "表示状态持续且未改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "746fa129-4bb3-3dae-9a91-1d5c0105c513",
                    "sense_definition": "Кажется, похоже; употребляется в вопросительных или восклицательных предложениях для выражения удивления или предположения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "modal_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Никак</w> ты заболел, раз лежишь днём?",
                            "target_lang_translations": {
                                "en": "<w>It looks like</w> you've gotten sick, since you're lying down during the day?",
                                "zh": "<w>莫非</w>你生病了，大白天的躺着？"
                            }
                        },
                        {
                            "text": "Смотри, <w>никак</w> гости приехали!",
                            "target_lang_translations": {
                                "en": "Look, <w>it seems</w> the guests have arrived!",
                                "zh": "快看，<w>好像</w>是客人到了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "кажется",
                        "похоже"
                    ],
                    "common_phrases": [
                        "никак ты",
                        "никак это"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "It seems, it looks like; used in questions or exclamations to express surprise or assumption.",
                        "zh": "用于疑问句或感叹句，表示惊讶或推测，意为好像、莫非。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it looks like",
                                "target_lang_sense_clarification": "expressing an assumption based on appearance"
                            },
                            {
                                "target_lang_word": "it seems",
                                "target_lang_sense_clarification": "expressing a supposition"
                            },
                            {
                                "target_lang_word": "must",
                                "target_lang_sense_clarification": "inferring a conclusion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫非",
                                "target_lang_sense_clarification": "用于推测，表示难道是"
                            },
                            {
                                "target_lang_word": "好像",
                                "target_lang_sense_clarification": "表示根据观察得出的推测"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}