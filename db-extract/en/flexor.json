                "senses": [
                    {
                        "sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                        "entry_id": "71b6e3d4-246e-3dee-93c6-5b0229ea814e",
                        "glosses": [
                            "A muscle whose contraction acts to bend a joint or limb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad67a5fb-ce55-485d-8df6-2052a12cb090",
                                "sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                                "text": "Starting at the point of shoulder, use muscle squeezings, picking-ups, kneadings and gentle frictions, interspersed with effleurages, over the triceps muscle as well as the fleshy part of the flexor and extensor muscle groups."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e4f1990-ae6a-4d4f-bc0d-3ea23b18a95f",
                        "source_entry_id": "71b6e3d4-246e-3dee-93c6-5b0229ea814e",
                        "source_sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                        "source_sense_description": "muscle",
                        "target_lang_word": "buigspier",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buigspier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "51561168-d46e-381f-9c73-0e487994b989",
                                        "entry_id": "098e6d13-532a-3c96-864c-be643661db38",
                                        "glosses": [
                                            "spier die zorgt dat een ledemaat buigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716ad222-a3cd-4879-ab28-2752b875f509",
                                                "sense_id": "51561168-d46e-381f-9c73-0e487994b989",
                                                "text": "De Braziliaan Gustavo Kuerten onthulde na de wedstrijd dat hij sukkelt met een blessure aan de buigspieren van de rechterheup."
                                            },
                                            {
                                                "example_id": "86b00999-23f5-4518-8f63-d7212a0681db",
                                                "sense_id": "51561168-d46e-381f-9c73-0e487994b989",
                                                "text": "Na verloop van tijd kan er ook verkorting van de buigspieren van de tenen optreden, met hamertenen als gevolg. Bij langdurig dragen van slippers zou ook heup- en lage rugpijn kunnen optreden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c88449f9-623f-43cf-b07c-40be9dd6a7fa",
                        "source_entry_id": "71b6e3d4-246e-3dee-93c6-5b0229ea814e",
                        "source_sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                        "source_sense_description": "muscle",
                        "target_lang_word": "fléchisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fléchisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f6945f-a2b9-33cd-8ae4-7c79231ae5ac",
                                        "entry_id": "b0041a9a-35be-3a81-a981-1455212fb766",
                                        "glosses": [
                                            "Qui est destiné à faire fléchir certaines parties de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0132faa-dffa-489c-9bab-00e3d12ca1ec",
                                                "sense_id": "d1f6945f-a2b9-33cd-8ae4-7c79231ae5ac",
                                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fléchisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03711b89-469b-3d59-9c34-1cb09b6b2bd5",
                                        "entry_id": "1eec9bd2-ea7c-3e86-83ce-06fbdc6abdd0",
                                        "glosses": [
                                            "Muscle fléchisseur."
                                        ],
                                        "tags": [
                                            "Substantivement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7914b7-5a9c-4dcd-ba8f-b46c172e06fb",
                                                "sense_id": "03711b89-469b-3d59-9c34-1cb09b6b2bd5",
                                                "text": "Autoétirer les fléchisseurs et les extenseurs du poignet."
                                            },
                                            {
                                                "example_id": "6d2d041d-797b-40bb-9417-bc61afa223e7",
                                                "sense_id": "03711b89-469b-3d59-9c34-1cb09b6b2bd5",
                                                "text": "Le fléchisseur superficiel fléchit les deuxièmes phalanges, le fléchisseur profond fléchit les deuxièmes et les troisièmes phalanges."
                                            },
                                            {
                                                "example_id": "553f57fa-1705-4dbb-a1d6-7c9d332b1e4d",
                                                "sense_id": "03711b89-469b-3d59-9c34-1cb09b6b2bd5",
                                                "text": "Les douleurs postéromédiales sont en faveur d’une tendinopathie du long fléchisseur de l’hallux, alors que les douleurs davantage médiales nous orientent vers une tendinopathie du tibial postérieur, lesquelles irradient vers le naviculaire, ou une lésion du ligament deltoïde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
