                ],
                "senses": [
                    {
                        "sense_id": "c485dafc-837a-3015-a426-d7da84c5bc40",
                        "entry_id": "dff0f0e8-903f-3ae4-8870-7c278beb4b1b",
                        "glosses": [
                            "Eigenschaft, schwach an Verstand und ungeschickt zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "bbd769d3-2b08-4eab-a0ca-902bf13ce708",
                                "sense_id": "c485dafc-837a-3015-a426-d7da84c5bc40",
                                "text": "„Nichtsdestotrotz hatte ich Angst, durch Tölpelhaftigkeit unser Auto ruiniert zu haben.“"
                            },
                            {
                                "example_id": "e46c2538-b6c0-4d70-b203-099280e0dc22",
                                "sense_id": "c485dafc-837a-3015-a426-d7da84c5bc40",
                                "text": "„Eines Tags entfachte seine berechnete Tölpelhaftigkeit einen schroffen, gewaltsamen Kampf zwischen dem Minister des Innern und dem Budgetberichterstatter für dieses Departement.“"
                            },
                            {
                                "example_id": "a42b5fa7-2696-461d-b682-eb2d57587f08",
                                "sense_id": "c485dafc-837a-3015-a426-d7da84c5bc40",
                                "text": "„Bei Kindern stellt er oft Verlegenheit und Tölpelhaftigkeit gegenüber Erwachsenen und Überheblichkeit gegenüber Jüngeren fest.“"
                            },
                            {
                                "example_id": "2fd24547-0450-4aac-a77f-11840ef840bb",
                                "sense_id": "c485dafc-837a-3015-a426-d7da84c5bc40",
                                "text": "„Er trägt eine rote Nase und unpassende Kleidung und wechselt zwischen ungehobelter Tölpelhaftigkeit und agiler List.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                        "entry_id": "dff0f0e8-903f-3ae4-8870-7c278beb4b1b",
                        "glosses": [
                            "etwas, das [1] zum Ausdruck bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670f5403-8a3e-4ad3-afae-68454197f151",
                                "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                                "text": "„Hatte er nicht eine Tölpelhaftigkeit begangen?“"
                            },
                            {
                                "example_id": "00ddd1d4-cba7-4b22-b276-2372266a2488",
                                "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                                "text": "„Durch eine Tölpelhaftigkeit macht er schließlich dem Verhältnis ein Ende.“"
                            },
                            {
                                "example_id": "08140c9b-d49d-4b4f-b363-384cde91778a",
                                "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                                "text": "„Auch der Held wird von Beginn an in ein komisches Licht gerückt , seine Ungeschicklichkeiten und Tölpelhaftigkeiten werden keineswegs von vornherein als Zeichen eines »poetischen Gemüts« verklärt, sondern auch ironisiert.“"
                            },
                            {
                                "example_id": "2b947c36-0037-4097-880a-e206aceb72f2",
                                "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                                "text": "„Bisweilen fehlte ein sonst reizendes Subjekt durch die Unart seiner Sitten oder durch eine alberne Tölpelhaftigkeit, die der Liebe entgegenstand.“"
                            },
                            {
                                "example_id": "da692f46-0e09-4b8d-89d0-12ac0a839f71",
                                "sense_id": "730a503f-28ab-357f-a752-920a038c6002",
                                "text": "„Man hätte bei allen meinen Tölpelhaftigkeiten meinen sollen, daß ich förmlich darauf ausgegangen wäre, den Haß einer liebenswürdigen und mächtigen Frau zu erregen, der ich mich in Wahrheit täglich mehr anschloß und deren Ungnade mir zuziehen zu wollen ich weit entfernt war, obgleich ich mit meinen Plumpheiten alles Nöthige dazu that.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
