                "senses": [
                    {
                        "sense_id": "4e36c91f-14d2-3f39-80dc-033b3b8f1b5d",
                        "entry_id": "c37b4c11-1ed9-349b-a69f-95971bcd3b8d",
                        "glosses": [
                            "Kuchen aus einem viel Zucker, Mehl und Fett und wenig Wasser enthaltenden, festen Teig; aus Mürbeteig hergestellter Kuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e25357-f128-449b-817c-9b97a90fbbb9",
                                "sense_id": "4e36c91f-14d2-3f39-80dc-033b3b8f1b5d",
                                "text": "„Im Hinausgehen zog sie ein Paar Leinwandhandschuhe an und trat in die Küche, wo die Mamsell mit rotem Kopf vor dem Backofen stand und Mürbkuchen herauszog.“"
                            },
                            {
                                "example_id": "cab7ebec-a812-45bc-9f44-982c2a606249",
                                "sense_id": "4e36c91f-14d2-3f39-80dc-033b3b8f1b5d",
                                "text": "„Locki hat sich an den kleinen selbstgebackenen Mürbkuchen und den eingemachten Früchten, die es als Nachtisch gibt, genug getan und beginnt ihr lustiges Geplänkel mit frisch gewonnener Kraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
