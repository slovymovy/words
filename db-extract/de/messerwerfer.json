                "senses": [
                    {
                        "sense_id": "6e0fbb38-1d8a-3fa3-899e-c6fd82471e5c",
                        "entry_id": "2786e6eb-42c0-33ab-b3ce-0c732d2a1d26",
                        "glosses": [
                            "Person, die ihr Können vorführt, mit einem geschleuderten (geworfenen) Messer Ziele zu treffen"
                        ],
                        "tags": [
                            "Zirkus",
                            "Varieté"
                        ],
                        "examples": [
                            {
                                "example_id": "5f99012e-4700-4400-87e8-4b469a6b862f",
                                "sense_id": "6e0fbb38-1d8a-3fa3-899e-c6fd82471e5c",
                                "text": "„Der Messerwerfer mit seiner Frau stand in der Manege, und niemand der Zugucker sagte ein Wort, wenn die scharfen Messer durch die Luft flogen.“"
                            },
                            {
                                "example_id": "273f60c9-274d-4d51-beeb-77b9d26318bf",
                                "sense_id": "6e0fbb38-1d8a-3fa3-899e-c6fd82471e5c",
                                "text": "„Im Wanderzirkus tritt auch ein Messerwerfer auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
