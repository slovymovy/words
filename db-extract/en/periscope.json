                "senses": [
                    {
                        "sense_id": "366ba46c-f723-3541-b62c-8aeca2ae25e6",
                        "entry_id": "b962c317-1b02-3a6f-8449-85510850cd39",
                        "glosses": [
                            "To broadcast live video stream using Periscope app via phone or tablet."
                        ],
                        "tags": [
                            "Internet",
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3dd1e500-f35b-4f39-ab45-a3bb5ae58a87",
                                "sense_id": "366ba46c-f723-3541-b62c-8aeca2ae25e6",
                                "text": "Presidential candidate Hillary Clinton Periscoped her first major campaign rally with Olympian Michelle Kwan as the host of the live stream."
                            },
                            {
                                "example_id": "2dc7f1a4-1197-48ec-a5cf-97eca01f7241",
                                "sense_id": "366ba46c-f723-3541-b62c-8aeca2ae25e6",
                                "text": "When Manchester City fan Josh Chambers “Periscoped” an entire away match at Crystal Palace in Febrary 2017, notionally for the benefit of his stay-at-nome dad, the stream was watched by more than 139,000 stay-at-home fans."
                            },
                            {
                                "example_id": "fcd9b145-509e-47c0-8b89-9c61842404fc",
                                "sense_id": "366ba46c-f723-3541-b62c-8aeca2ae25e6",
                                "text": "And photographer Patrick Witty (2015 ) Periscoped refugees landing in Lesbos, Greece, for BuzzFeed News."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
