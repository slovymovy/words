                                                "sense_id": "687b690d-26f7-324f-8263-08aea0ebfe0b",
                                                "text": "„Auch seine Briefe an mich waren lange Zeit ohne Erwiderung geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "239b670b-c827-34e2-b683-27e5ac846cd1",
                                        "entry_id": "e17594a2-a56c-3853-8704-a03025701539",
                                        "glosses": [
