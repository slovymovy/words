                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b713e71-0890-481f-8b0f-c3fb00a423ed",
                                "sense_id": "c833c343-5b4f-3e07-a78f-1b08ee0f03f8",
                                "text": "Григорьев Антошка был круглый румяный малец из 8-го \"Г\", выглядевший, как кот после блинов"
                            }
                        ]
                    },
                    {
                        "sense_id": "6d7004f3-d1cc-3d0b-b383-c49e9f26ca30",
                        "entry_id": "608d484f-9f2d-3702-824e-4f758e245ee3",
                        "glosses": [
                            "жарг. палец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ce391b-b5eb-4718-815d-bea801813149",
                                "sense_id": "6d7004f3-d1cc-3d0b-b383-c49e9f26ca30",
                                "text": "Да и толчея изрядная, одно удовольствие «мальцы в кишеню запустить» (то есть залезть пальцами в карман)."
                            }
                        ]
                    }
