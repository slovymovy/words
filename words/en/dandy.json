                            }
                        },
                        {
                            "text": "The roads through the <w>Dandy</w> are beautiful but winding.",
                            "target_lang_translations": {
                                "es": "Las carreteras que cruzan la <w>cordillera de Dandenong</w> son hermosas pero sinuosas."
                            }
                        }
                    ],
