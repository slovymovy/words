                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36490038-22b9-4be1-bcdf-0414583a0afd",
                                "sense_id": "24f88dba-0f17-37f3-bb81-6ee052d467e1",
                                "text": "Детей так много, что у Динки пестрит в глазах от их платьиц, рубашонок и вязанных, как чулок, с яркими полосками и с кисточками на концах, цветных фесок."
                            },
                            {
                                "example_id": "8b3aa884-0256-46b8-a7af-81657b0af4fc",
                                "sense_id": "24f88dba-0f17-37f3-bb81-6ee052d467e1",
                                "text": "Идите тёмненькое платьице оденьте, только быстро!"
                            }
                        ]
                    }
