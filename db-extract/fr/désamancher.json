                        ],
                        "examples": [
                            {
                                "example_id": "feef9a1b-c3ee-4cdd-8d18-6d2900031070",
                                "sense_id": "3e674cb5-0d38-30ec-9243-3f9a921df5d1",
                                "text": "Amanche la jambe dans l’épaule, désamanche le pied hors d’la pince de roche, me semble que ça coule en moé exactement, comme le même mouvement, mais à n’envers."
                            },
                            {
                                "example_id": "df9e72ef-116e-4861-91a3-1992bfb86de0",
                                "sense_id": "3e674cb5-0d38-30ec-9243-3f9a921df5d1",
                                "text": "A c’ t’ heure que ma vie n’est plus la vie de ma vie Que je suis désamanché Que je suis sans tendre moitié A c’ t’ heure je m’oublie."
                            }
                        ]
                    }
