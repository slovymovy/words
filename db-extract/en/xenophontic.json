                                    {
                                        "sense_id": "f9f3016d-eb0c-3a01-9a46-b2be637dbbeb",
                                        "entry_id": "20defc19-d7aa-3a58-9923-086e10611641",
                                        "glosses": [
                                            "Relatif à Xénophon, à sa philosophie…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9539c417-e9b1-462d-8c29-f9386799cebd",
                                                "sense_id": "f9f3016d-eb0c-3a01-9a46-b2be637dbbeb",
                                                "text": "Ce qu'on peut dire de tels ou tels mots et expressions : ce n'est pas platonicien, xénophonien, cela a d'ordinaire sa raison d'être dans le domaine linguistique plus que dans l'originalité."
                                            },
                                            {
                                                "example_id": "24e8b119-eec8-4958-8b3c-533888ba9405",
                                                "sense_id": "f9f3016d-eb0c-3a01-9a46-b2be637dbbeb",
                                                "text": "Socrate, enfin, est, lui aussi, à double visage : que ce soit dans la représentation platonicienne, ou dans le portrait xénophonien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4559f86c-7179-430b-bd80-d9ee280a6f97",
                        "source_entry_id": "2c8bd9bd-020a-3d6e-9497-94e60912d8d4",
