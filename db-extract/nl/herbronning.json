                        "examples": [
                            {
                                "example_id": "5278b649-d1af-4e69-9357-85a065f587e4",
                                "sense_id": "f7b3d350-76a1-36cf-8615-b49ea6e31464",
                                "text": "Hans Helgers, in de jaren negentig voorzitter en toen, na de grote nederlaag destijds, verantwoordelijk voor de 'herbronning' van de partij."
                            },
                            {
                                "example_id": "7da89262-97cf-46ee-ad57-51097c2411eb",
                                "sense_id": "f7b3d350-76a1-36cf-8615-b49ea6e31464",
                                "text": "Van Bommel zei in de Volkskrant verder dat de SP in de verkiezingscampagne zo veel nadruk heeft gelegd op de zorg, dat bijvoorbeeld het huurbeleid, de flexibilisering van de arbeidsmarkt en de inkomenspolitiek te weinig aandacht hebben gekregen. Hij pleitte in maart ook voor een 'herbronning' van links."
                            }
                        ]
