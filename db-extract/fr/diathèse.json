        "fr-extract.jsonl": [
            {
                "entry_id": "f2baeca1-3d48-3f0c-9b48-24f2d7570f71",
                "word": "diathèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "094ef335-8639-464f-8458-a1a42ebe1796",
                        "entry_id": "f2baeca1-3d48-3f0c-9b48-24f2d7570f71",
                        "tags": [
                            "plural"
                        ],
                        "form": "diathèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d793948a-8db5-33f2-b344-3f7608b8f625",
                        "entry_id": "f2baeca1-3d48-3f0c-9b48-24f2d7570f71",
                        "glosses": [
                            "Disposition générale d’une personne à être souvent ou habituellement affectée de telle ou telle maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6badf844-004b-4497-8d7e-e0751c8d66b0",
                                "sense_id": "d793948a-8db5-33f2-b344-3f7608b8f625",
                                "text": "Diathèse cancéreuse, scorbutique, rhumatismale, etc."
                            },
                            {
                                "example_id": "5b795035-093b-4d68-957f-8bcc46c1c750",
                                "sense_id": "d793948a-8db5-33f2-b344-3f7608b8f625",
                                "text": "D’ailleurs, l’amour est un mal inguérissable, comme ces diathèses où le rhumatisme ne laisse quelque répit que pour faire place à des migraines épileptiformes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c52779d-e1e1-3a0a-a218-5d5033a51b15",
                        "entry_id": "f2baeca1-3d48-3f0c-9b48-24f2d7570f71",
                        "glosses": [
                            "Trait grammatical décrivant comment s'organisent les rôles sémantiques dévolus aux actants par rapport au procès verbal, que l'on entend plus communément par « voix » verbale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bec684a-06a1-422a-bff7-0a2f9fed4672",
                                "sense_id": "6c52779d-e1e1-3a0a-a218-5d5033a51b15",
                                "text": "On considère qu'il existe deux diathèses principales que l'on peut permuter, la voix active et la voix passive. Ce ne sont cependant pas les seules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc80b111-7a42-4045-ad59-499c1fa463d1",
                        "source_entry_id": "f2baeca1-3d48-3f0c-9b48-24f2d7570f71",
                        "target_lang_word": "diathesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diathesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b083c4d7-d8f3-3b3e-9c13-1810f21bc119",
                                        "entry_id": "949e6ebb-a58e-346f-899e-21836b452476",
                                        "glosses": [
                                            "A hereditary or constitutional predisposition to a disease or other disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c9bc05-51c2-4c46-99c7-c60359c49aed",
                                                "sense_id": "b083c4d7-d8f3-3b3e-9c13-1810f21bc119",
                                                "text": "Medical materialism seems indeed a good appellation for the too simple-minded system of thought which we are considering. […] All such mental over-tensions, it says, are, when you come to the bottom of the matter, mere affairs of diathesis (auto-intoxications most probably), due to the perverted action of various glands which physiology will yet discover."
                                            },
                                            {
                                                "example_id": "4845e50d-78b7-47e8-b976-13be2f00da7f",
                                                "sense_id": "b083c4d7-d8f3-3b3e-9c13-1810f21bc119",
                                                "text": "When a coal miner developed the eye disease nystagmus, was this to be diagnosed as due to work conditions or to an inherent constitutional diathesis?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7320caa2-a5d8-393c-bd02-b117d1f4aaf2",
                                        "entry_id": "949e6ebb-a58e-346f-899e-21836b452476",
                                        "glosses": [
                                            "Voice (active or passive)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
