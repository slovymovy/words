                ],
                "senses": [
                    {
                        "sense_id": "8d60fcb8-750b-3b41-a14b-31348c9fc18b",
                        "entry_id": "82ffc811-c2bb-3bd0-9c4e-1e99acefbaaa",
                        "glosses": [
                            "übrig gebliebener Rest eines Beins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf37aaf-b9c3-4289-80af-5792216c099a",
                                "sense_id": "8d60fcb8-750b-3b41-a14b-31348c9fc18b",
                                "text": "„Ihr rechter Fuß schmerzte von dem langen Spaziergang, auch der linke Beinstumpf schmerzte, und selbst der Stock schmerzte.“"
                            },
                            {
                                "example_id": "f95bbb6f-a6b5-48d3-9e5f-c06e0d44593b",
                                "sense_id": "8d60fcb8-750b-3b41-a14b-31348c9fc18b",
                                "text": "„Der Mann sitzt auf zwei Beinstümpfen, er hat gar keine Beine mehr, die zu Raucherbeinen werden könnten.“"
                            },
                            {
                                "example_id": "d93ddfb9-f250-4926-aef4-aef37d47d4af",
                                "sense_id": "8d60fcb8-750b-3b41-a14b-31348c9fc18b",
                                "text": "„Bald fiel ihm Denissow und sein verändertes Wesen und seine endliche Unterwerfung ein, und dazu das ganze Spital mit diesen Arm- und Beinstümpfen, mit diesem Schmutz und diesen Krankheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
