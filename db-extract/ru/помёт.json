                    },
                    {
                        "form_id": "cef92119-5378-43dc-bc34-15747ad4f679",
                        "entry_id": "79bf3087-cc45-32c1-b7aa-af53a130ae89",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "помётах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0be833ea-df0e-3cd3-a200-484bd601ce9a",
                        "entry_id": "79bf3087-cc45-32c1-b7aa-af53a130ae89",
                        "glosses": [
                            "экскременты зверя или птицы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e887337-889a-4902-bc5a-67826bf22099",
                                "sense_id": "0be833ea-df0e-3cd3-a200-484bd601ce9a",
                                "text": "Увидал сухой лошадиный помет, вспомнил про лошадь: покупать придется."
                            },
                            {
                                "example_id": "cf64b8c3-1849-4361-8cb7-2289931b0279",
                                "sense_id": "0be833ea-df0e-3cd3-a200-484bd601ce9a",
                                "text": "Пробежала лошадь с санями, уронив между полозьев тёплый помёт."
                            },
                            {
                                "example_id": "167d8157-282d-4fb5-afc2-4ec28e1d73fe",
                                "sense_id": "0be833ea-df0e-3cd3-a200-484bd601ce9a",
                                "text": "В пустом курятнике белел давно высохший куриный помёт, пусто было в чуланчике под лестницею, где жил поросёнок."
                            }
                        ]
                    },
                    {
                        "sense_id": "915df665-eba3-334c-b886-7a1ac93456f6",
                        "entry_id": "79bf3087-cc45-32c1-b7aa-af53a130ae89",
                        "glosses": [
                            "собир. то же, что выводок; несколько одновременно родившихся детёнышей какого-либо зверя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fb6808-2f17-45e9-8a7e-12e9afe69187",
                                "sense_id": "915df665-eba3-334c-b886-7a1ac93456f6",
                                "text": "Собака родила, а хозяева уезжали за границу, и им надо было срочно продать весь помёт."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23e286e0-d61d-4dad-9418-cd61b53bde51",
                        "source_entry_id": "79bf3087-cc45-32c1-b7aa-af53a130ae89",
                        "source_sense_description": "экскременты",
                        "target_lang_word": "Mist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                        "entry_id": "bda90c80-3c64-327a-a8a2-1c4c210bc909",
                                        "glosses": [
                                            "als Schimpfwort beziehungsweise Fluch verwendeter Ausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bff54c8-a7d8-419c-b259-1718e5b2fa77",
                                                "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                                "text": "Mist! Habe ich mir doch mit dem Hammer auf den Daumen gehauen!"
                                            },
                                            {
                                                "example_id": "7e1df1b2-dd7b-4da8-93e2-510f977786da",
                                                "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                                "text": "Oh Mist!"
                                            },
                                            {
                                                "example_id": "3a9d68f0-c99e-4564-b5b6-65807bde34ff",
                                                "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                                "text": "Was für ein Mist!"
                                            },
                                            {
                                                "example_id": "46cbd996-9f4f-47c0-8718-85caebbaa3d1",
                                                "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                                "text": "Verdammter Mist!"
                                            },
                                            {
                                                "example_id": "750f3f9f-1b63-41e3-a8a4-6f43e4070ad4",
                                                "sense_id": "4c5b1792-adc7-3d1d-acaa-5f5b201ed79c",
                                                "text": "So ein Mist!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eec1aff-7205-3e88-b219-6affb36d5840",
                                        "entry_id": "09e13b95-2d4d-3b2d-b6a8-2bb2aea35260",
                                        "glosses": [
                                            "Exkremente von Stalltieren, vermischt mit Streu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e970c4b2-6899-429f-980d-5377c08e13c1",
                                                "sense_id": "7eec1aff-7205-3e88-b219-6affb36d5840",
                                                "text": "Ja, Mist stinkt und klebt lange unter den Gummistiefeln, aber andererseits ist er als Dünger auf Gemüsebeeten nützlich."
                                            },
                                            {
                                                "example_id": "572ea8b2-6bf2-4033-b552-d6fe5af62159",
                                                "sense_id": "7eec1aff-7205-3e88-b219-6affb36d5840",
                                                "text": "Mist ist auch im ökologischen Landbau als Dünger gestattet."
                                            },
                                            {
                                                "example_id": "f30c9449-6ddd-42e5-b0a8-8a05576e287c",
                                                "sense_id": "7eec1aff-7205-3e88-b219-6affb36d5840",
                                                "text": "Mineralstoffe und Spurenelemente im Boden entstammen gewöhnlich dem Dünger, egal ob Gülle, Mist oder Kunstdünger."
                                            },
                                            {
                                                "example_id": "c03c8073-7a4d-4ca1-bdf6-32cd9ab7ef9f",
                                                "sense_id": "7eec1aff-7205-3e88-b219-6affb36d5840",
                                                "text": "„Auf dem riesigen Hofe des Rostowschen Hauses lagen hier und dort Heuüberreste und Mist von den Pferden des Wagenzuges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea810ae7-4039-3437-ba60-496a33d121c6",
                                        "entry_id": "09e13b95-2d4d-3b2d-b6a8-2bb2aea35260",
                                        "glosses": [
                                            "etwas Ungeeignetes oder Unangenehmes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12c9e89-7fe1-4671-8964-aa292efc1f4d",
                                                "sense_id": "ea810ae7-4039-3437-ba60-496a33d121c6",
                                                "text": "Ich fürchte, ich habe großen Mist gebaut."
                                            },
                                            {
                                                "example_id": "72954fff-16aa-4eb7-bf24-c0935988db37",
                                                "sense_id": "ea810ae7-4039-3437-ba60-496a33d121c6",
                                                "text": "\"Opposition ist Mist.\" (Franz Müntefering)"
                                            },
                                            {
                                                "example_id": "22c6cae4-aa8a-4f79-b509-b8511d8fae37",
                                                "sense_id": "ea810ae7-4039-3437-ba60-496a33d121c6",
                                                "text": "… als eine Form der persönlichen Ansprache und Kritik eignet sich die Wendung: „Was soll der Mist!“, die gerne auch in Frageform vorgebracht werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ccb9b98f-0ebf-32c9-a63e-ae6a7c25977e",
                                        "entry_id": "09e13b95-2d4d-3b2d-b6a8-2bb2aea35260",
                                        "glosses": [
                                            "Abfall, Müll"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b672c564-2e78-4f08-bea5-e100dbf110de",
                                                "sense_id": "ccb9b98f-0ebf-32c9-a63e-ae6a7c25977e",
                                                "text": "Der Mist gehört in den Mistkübel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
