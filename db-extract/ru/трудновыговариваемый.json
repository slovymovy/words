                "translations": [
                    {
                        "translation_id": "ff17fdd0-b8d6-4d82-b979-2a5c58e42344",
                        "source_entry_id": "01794957-04ab-3e8b-b9bd-f116756f99a3",
                        "source_sense_id": "90d2d122-09bd-3af1-aaf2-e7e99f567f7b",
                        "target_lang_word": "unpronounceable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpronounceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d8aa7e-293c-3227-9849-c311ab68b954",
                                        "entry_id": "2ecd7a28-3ef2-3956-a249-ab97117391e3",
                                        "glosses": [
                                            "Impossible or difficult to pronounce or articulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a29183e-35d8-447a-a9ba-50f556e83be1",
                                                "sense_id": "f9d8aa7e-293c-3227-9849-c311ab68b954",
                                                "text": "A Hungarian baron, with an unpronounceable name, had that very morning been so struck with Lady Penrhyn's beauty, that, not knowing she was married, he laid himself, castle, sabre, and fur pelisses at her feet, for immediate acceptance."
                                            },
                                            {
                                                "example_id": "4ff80d37-a69b-4c55-bc85-f5db43ed07c6",
                                                "sense_id": "f9d8aa7e-293c-3227-9849-c311ab68b954",
                                                "text": "In many ways, the salarian political network functions like the noble families of Earth's Medieval Europe. Structurally the government consists of fiefdoms, baronies, duchies, planets, and marches (colonization clusters). These are human nicknames; the original salarian is unpronounceable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unpronounceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cbb2084-5eea-3861-8298-37a462210a76",
                                        "entry_id": "41996276-a19c-3957-84df-ec8cce786dee",
                                        "glosses": [
                                            "Something, especially an ingredient, that is difficult or impossible to pronounce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b3237e6-fbd8-4a80-a83f-6ad67e7b935f",
                                                "sense_id": "0cbb2084-5eea-3861-8298-37a462210a76",
                                                "text": "Synthetic fragrances can contain a laundry list of chemicals — hormone disrupters, petroleum-derived unpronounceables, asthma triggers and on and on."
                                            },
                                            {
                                                "example_id": "05cf4276-6bdc-4970-b2a7-d5827572719f",
                                                "sense_id": "0cbb2084-5eea-3861-8298-37a462210a76",
                                                "text": "Finally, if there are some “unpronounceables” in the list, ensure that they are minimal and not artificial anything—artificial colors, preservatives, flavors, or sweeteners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
