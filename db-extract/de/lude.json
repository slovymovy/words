                    {
                        "sense_id": "69286514-73cf-35bc-9bde-008f229e8f2c",
                        "entry_id": "0615980b-8d5b-3ed5-9a24-46121cc4965f",
                        "glosses": [
                            "Zuhälter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39dfbf33-a4b2-488e-b2d3-8dcabc7b829f",
                                "sense_id": "69286514-73cf-35bc-9bde-008f229e8f2c",
                                "text": "„So kassieren Luden die Kiez-Huren ab.“"
                            },
                            {
                                "example_id": "c9423380-cc1b-4ff2-a52c-301b64037722",
                                "sense_id": "69286514-73cf-35bc-9bde-008f229e8f2c",
                                "text": "„Franz bezeichnet sich selbst als ‚Lude‘, also Zuhälter von Sonja.“"
                            },
                            {
                                "example_id": "9c699699-5ad2-4016-994a-88959c0210ba",
                                "sense_id": "69286514-73cf-35bc-9bde-008f229e8f2c",
                                "text": "„Er schien schon da zu sein, als er Mietzens Lude wurde und frei herumspazierte mit einem goldenen Zigarettenetui und einer Ruderklubmütze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1d49b92-0f98-32c1-988b-0651fb6bc7bd",
                        "entry_id": "0615980b-8d5b-3ed5-9a24-46121cc4965f",
                        "glosses": [
                            "ungepflegter, schmutziger, unanständiger, moralisch anrüchiger Mensch"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "76000dde-afe1-49b0-8055-7ee1af420a5c",
                                "sense_id": "e1d49b92-0f98-32c1-988b-0651fb6bc7bd",
                                "text": "„‚So’n Strolch! So’n alter Lude!‘ sekundierte man ihm aus der Menge.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
