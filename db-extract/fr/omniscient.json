                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bebadc8-6c71-362d-940a-fb6fcebb7b51",
                        "entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                        "glosses": [
                            "Qui sait tout, ou paraît tout savoir."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "55b83982-6a41-44b4-9045-4812838d76a3",
                                "sense_id": "0bebadc8-6c71-362d-940a-fb6fcebb7b51",
                                "text": "– Nous avons, par sincérité, par faiblesse, renoncé à tenir devant nos enfants le rôle de parents omniscients, omnipotents et quasi divins ! Voilà le résultat !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0065d42d-63d7-386e-9373-c77e8a8b9021",
                        "entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                        "glosses": [
                            "(En parlant d'un narrateur) Qui sait toutes les pensées, les événements et chaque chose en rapport avec le récit."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "053a05c3-822c-4429-aff3-f1ffa7fca9c3",
                        "source_entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                        "target_lang_word": "allwissend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allwissend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                        "entry_id": "464d387e-f894-3986-a452-f435dc7bffd6",
                                        "glosses": [
                                            "jedwede Information kennend, alles wissend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9d2e48-88b0-4093-8d66-c94c78a40e0f",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "Gott gilt als allwissend."
                                            },
                                            {
                                                "example_id": "7a2985cb-5e2f-4d73-ae38-6ec9389bf90c",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "Ich bin doch nicht allwissend!"
                                            },
                                            {
                                                "example_id": "7f273ede-0afe-43e7-8294-ca043d5cb434",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "„An dieser Stelle muß ich als beinahe allwissender Erzähler wieder in den Hintergrund treten und erneut den Blickwinkel Lucas Corsos einnehmen, denn Sie, lieber Leser, sollen die dramatischen Ereignisse […] genau so nachvollziehen können, wie er selbst sie erlebt und mir später geschildert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f6968b7-6b00-43ef-ad5a-5117b29dd303",
                        "source_entry_id": "d56d91bf-ca47-33ca-bc61-7002c473f88e",
                        "target_lang_word": "omniscient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omniscient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                        "entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
                                        "glosses": [
                                            "Having total knowledge."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bdbed08-fb54-4741-8531-7ba753cf19c2",
                                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                                "text": "The story was narrated from an omniscient point of view."
                                            },
                                            {
                                                "example_id": "4ef3965c-cd90-468b-86c9-859604796197",
                                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                                "text": "The Abrahamic God is omniscient."
                                            },
                                            {
                                                "example_id": "f4ada1bf-3abc-41ae-b1e8-68fbe89add2e",
                                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                                "text": "For me, anything is possible. I am omniscient and omnipotent, extremely vain, and, what is more, I come in a handy self-carrying package."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "omniscient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0666e58-28b9-3637-aeff-22c7a055899b",
                                        "entry_id": "fbf5d5aa-31c3-339e-aa3b-732acd69518e",
                                        "glosses": [
                                            "One who has total knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40faaa7d-2e7d-4c52-8051-ce168b8ed904",
                                                "sense_id": "e0666e58-28b9-3637-aeff-22c7a055899b",
                                                "text": "Those blind omniscients , those almighty slaves , Untenanting creation of its God"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
