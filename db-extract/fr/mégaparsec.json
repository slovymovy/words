                        "sense_id": "ae474f54-69f1-3e86-900a-1005e4f23743",
                        "entry_id": "2a8d4b84-7296-3b52-9036-eb71a1c259c3",
                        "glosses": [
                            "Unité de mesure de distance, de symbole Mpc, équivalente à un million de parsecs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3388f522-cb18-43cb-aa16-b76a7189e16d",
                                "sense_id": "ae474f54-69f1-3e86-900a-1005e4f23743",
                                "text": "Pour les grandes distances dans la galaxie, on utilise le kiloparsec (kpc), et pour les distances aux autres galaxies, le mégaparsec (Mpc)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "548dd5f7-2e08-49be-b7cc-04a2d7b2ba3b",
                        "source_entry_id": "2a8d4b84-7296-3b52-9036-eb71a1c259c3",
                        "source_sense_id": "ae474f54-69f1-3e86-900a-1005e4f23743",
                        "target_lang_word": "Megaparsec",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Megaparsec",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                        "entry_id": "54e4a073-8a67-3b1d-a31c-750994f72577",
                                        "glosses": [
                                            "Entfernung von Sternen im Ausmaß von einer Million Parsec (entspricht etwa 3,26 Millionen Lichtjahren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed82ba7-8315-4943-8c38-bdc1e257f895",
                                                "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                                "text": "In der galaktischen und extragalaktischen Astronomie werden die üblichen Vorsätze für Maßeinheiten verwendet, insbesondere Kiloparsec (kpc; typische Größe von Galaxien), Megaparsec (Mpc; typische Größe von Galaxienhaufen) und Gigaparsec (Gpc; Durchmesser des beobachtbaren Universums)."
                                            },
                                            {
                                                "example_id": "57eec0fa-047a-4672-a27b-6301da882ba5",
                                                "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                                "text": "Mit Hilfe der PNLF können mit heutiger Technik Entfernungen bis zu 25 Megaparsec mit einer Genauigkeit von 10 Prozent bestimmt werden."
                                            },
                                            {
                                                "example_id": "5e45af66-f4ef-40e9-868f-254f29e710d8",
                                                "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                                "text": "Diese sogenannte Hubble-Konstante liegt im lokalen Kosmos demnach bei 73,2 Kilometern pro Sekunde pro Megaparsec."
                                            },
                                            {
                                                "example_id": "2075aee2-60e6-405d-ae5b-6db0b3e83dc3",
                                                "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                                "text": "Wie numerische Simulationen der Forscher zeigen, fallen kleinere Galaxien deshalb bevorzugt auf der Verbindungslinie in die Lokale Gruppe ein. Das führe zu einer deutlich anisotropen Verteilung der Galaxien in einem Radius von mehreren Megaparsec um die lokale Gruppe."
                                            },
                                            {
                                                "example_id": "6ca2a4ee-4560-4f09-88c5-9bb643df8880",
                                                "sense_id": "671a11ff-be32-3293-ac5c-50c56bd0591e",
                                                "text": "Und eine letzte Zahl, die mich besonders beeindruckt, weil das meine Vorstellungskraft ziemlich sprengt: Die Größe des beobachtbaren Universums beträgt 28000 Megaparsec."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
