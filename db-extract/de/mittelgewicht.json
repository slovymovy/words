                "translations": [
                    {
                        "translation_id": "3c55095a-f6e5-473c-9148-936f670c5e05",
                        "source_entry_id": "3494da18-2904-3ec7-aaa5-a3a0aa8273d4",
                        "source_sense_id": "09b60a63-7036-30b1-8655-f8c8e91bc292",
                        "source_sense_description": "Sport: Gewichtsklasse für Sportler im Boxen und Gewichtheben",
                        "target_lang_word": "middleweight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "middleweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80303bc9-0652-373c-b307-094b55b05b1e",
                                        "entry_id": "f6e79598-0a5f-3820-b46c-f038b558adf5",
                                        "glosses": [
                                            "A weight class in professional boxing between light middleweight or welterweight and super middleweight or cruiserweight; a similar division in wrestling and other sports"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d7f0610-4b83-3a93-bbb3-35d6511d822d",
                                        "entry_id": "f6e79598-0a5f-3820-b46c-f038b558adf5",
                                        "glosses": [
                                            "A boxer who fights in this division; a similar wrestler etc"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e137e0a-af2c-3e1d-9afa-f8227876dfd7",
                                        "entry_id": "f6e79598-0a5f-3820-b46c-f038b558adf5",
                                        "glosses": [
                                            "A class in between heavy and light."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d889b881-5dc7-4270-a681-33c9c3c347df",
                                                "sense_id": "7e137e0a-af2c-3e1d-9afa-f8227876dfd7",
                                                "text": "This would give the U.S. Army five parachute-capable brigades, or two \"middleweight\" infantry brigades, or six light infantry brigades, or six airmobile brigades in only two multicapable divisions."
                                            },
                                            {
                                                "example_id": "c64b8efc-2f70-4b06-82b0-22e8567c2f44",
                                                "sense_id": "7e137e0a-af2c-3e1d-9afa-f8227876dfd7",
                                                "text": "In Ukraine, jaeger brigades are middleweight infantry—neither as light as territorial brigades, which generally lack tracked vehicles, nor as heavy as tank or mechanized brigades with their hundreds of tanks and fighting vehicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb2aaa0-8877-37e5-8acd-99bc2d8ae508",
                                        "entry_id": "f6e79598-0a5f-3820-b46c-f038b558adf5",
                                        "glosses": [
                                            "An employee ranking anywhere between junior and senior."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2778fba3-eb1c-4e46-a246-4068db34dfd3",
                                                "sense_id": "deb2aaa0-8877-37e5-8acd-99bc2d8ae508",
                                                "text": "And it's interesting because in a way they're much more of a design company, and they've got their juniors and their seniors and their middleweights and all this stuff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
