{
    "word_family": [
        "when",
        "whensoever"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "2dedb621-a1a6-3913-8d38-1fa82101edf7",
                    "sense_definition": "Every time that something happens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whenever</w> it rains, the roof leaks in the hallway.",
                            "target_lang_translations": {
                                "ru": "<Всякий раз, когда> идёт дождь, крыша в коридоре протекает.",
                                "zh": "<w>每当</w>下雨，走廊的屋顶就会漏水。"
                            }
                        },
                        {
                            "text": "He smiles happily <w>whenever</w> he sees his grandchildren playing.",
                            "target_lang_translations": {
                                "ru": "Он счастливо улыбается <каждый раз, когда> видит, как играют его внуки.",
                                "zh": "<w>每当</w>看到孙子们玩耍，他都会开心地笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "every time"
                    ],
                    "common_phrases": [
                        "whenever possible",
                        "whenever necessary",
                        "whenever needed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждый раз, когда что-то происходит.",
                        "zh": "指某事发生的每一次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всякий раз, когда",
                                "target_lang_sense_clarification": "повторяющееся действие"
                            },
                            {
                                "target_lang_word": "каждый раз, когда",
                                "target_lang_sense_clarification": "повторяющееся действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每当",
                                "target_lang_sense_clarification": "表示每到某个时候"
                            },
                            {
                                "target_lang_word": "每次",
                                "target_lang_sense_clarification": "强调重复发生的频率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f53eb64-b5e4-3640-b8f5-224afb9f8146",
                    "sense_definition": "At any time that; at whatever time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choice_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can come and visit us <w>whenever</w> you want.",
                            "target_lang_translations": {
                                "ru": "Вы можете прийти к нам в гости <в любое время, когда> захотите.",
                                "zh": "你<w>随时</w>都可以来拜访我们。"
                            }
                        },
                        {
                            "text": "Please call me <w>whenever</w> you are ready to leave.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, позвони мне, <как только> будешь готов уйти.",
                                "zh": "你准备好离开时<w>随时</w>给我打电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "when",
                        "any time"
                    ],
                    "common_phrases": [
                        "whenever you want",
                        "whenever you like",
                        "whenever you are ready"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любое время, когда; в любой момент, когда.",
                        "zh": "在任何时间；无论何时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда угодно",
                                "target_lang_sense_clarification": "в любой момент"
                            },
                            {
                                "target_lang_word": "в любое время, когда",
                                "target_lang_sense_clarification": "свободный выбор времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随时",
                                "target_lang_sense_clarification": "在任何时间"
                            },
                            {
                                "target_lang_word": "无论何时",
                                "target_lang_sense_clarification": "强调选择的自由"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36cee27a-e705-3818-906d-105d26a1a529",
                    "sense_definition": "Regardless of the time that; no matter when.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must finish this project on time, <w>whenever</w> the materials arrive.",
                            "target_lang_translations": {
                                "ru": "Мы должны закончить этот проект вовремя, <когда бы ни> прибыли материалы.",
                                "zh": "无论材料<w>何时</w>到达，我们都必须按时完成这个项目。"
                            }
                        },
                        {
                            "text": "I will support your decision <w>whenever</w> you choose to make it.",
                            "target_lang_translations": {
                                "ru": "Я поддержу твое решение, <когда бы> ты <ни> решил его принять.",
                                "zh": "无论你<w>何时</w>决定，我都会支持你的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no matter when",
                        "regardless of when"
                    ],
                    "target_lang_definitions": {
                        "ru": "Независимо от того, когда; когда бы ни.",
                        "zh": "不管什么时候；无论何时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда бы ни",
                                "target_lang_sense_clarification": "уступка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论何时",
                                "target_lang_sense_clarification": "表示条件或让步"
                            },
                            {
                                "target_lang_word": "不管什么时候",
                                "target_lang_sense_clarification": "强调不受时间限制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f641fd04-0b6c-351e-8f59-3f9a4b39ca57",
                    "sense_definition": "Used to mean <w>when</w> in specific past contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dialectal_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whenever</w> I was a child, we lived in a small village.",
                            "target_lang_translations": {
                                "ru": "<Когда> я был ребенком, мы жили в маленькой деревне.",
                                "zh": "<w>当</w>我还是个孩子的时候，我们住在一个小村庄里。"
                            }
                        },
                        {
                            "text": "She moved to the city <w>whenever</w> she got married.",
                            "target_lang_translations": {
                                "ru": "Она переехала в город, <когда> вышла замуж.",
                                "zh": "她结婚<w>时</w>搬到了城市。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "common in Northern Irish and some US dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в значении «когда» в определенных контекстах прошедшего времени (диалектное).",
                        "zh": "在特定过去语境中表示“当……的时候”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда",
                                "target_lang_sense_clarification": "стандартная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当……的时候",
                                "target_lang_sense_clarification": "指代过去的时间点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4aae3715-72f9-3b56-8f49-71a9acdc2215",
                    "sense_definition": "At any unspecified time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adverbial_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You don't need an appointment; just drop by <w>whenever</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужно записываться, просто заходи <когда угодно>.",
                                "zh": "你不需要预约，<w>随时</w>过来就行。"
                            }
                        },
                        {
                            "text": "I am free all afternoon, so we can meet <w>whenever</w>.",
                            "target_lang_translations": {
                                "ru": "Я свободен весь день, так что можем встретиться <когда угодно>.",
                                "zh": "我整个下午都有空，所以我们<w>随时</w>可以见面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anytime",
                        "at any time"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любой неопределенный момент времени.",
                        "zh": "在任何不确定的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда угодно",
                                "target_lang_sense_clarification": "наречие"
                            },
                            {
                                "target_lang_word": "в любое время",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随时",
                                "target_lang_sense_clarification": "副词，表示时间不限"
                            },
                            {
                                "target_lang_word": "任何时候",
                                "target_lang_sense_clarification": "副词，表示时间不限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2baa98ae-dd6c-3c43-8009-2f03366d733e",
                    "sense_definition": "Emphatic form of <w>when</w> used in questions to express surprise or confusion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whenever</w> will I find the time to finish all this work?",
                            "target_lang_translations": {
                                "ru": "<Когда же> я найду время, чтобы закончить всю эту работу?",
                                "zh": "我<w>到底什么时候</w>才能找到时间完成所有这些工作？"
                            }
                        },
                        {
                            "text": "<w>Whenever</w> did you manage to buy such an expensive car?",
                            "target_lang_translations": {
                                "ru": "<Когда же> ты успел купить такую дорогую машину?",
                                "zh": "你<w>到底是什么时候</w>买得起这么贵的车的？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "emphatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Усилительная форма слова «когда», используемая в вопросах для выражения удивления или замешательства.",
                        "zh": "“when”的强调形式，用于疑问句中表示惊讶或困惑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда же",
                                "target_lang_sense_clarification": "эмоциональное усиление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底什么时候",
                                "target_lang_sense_clarification": "表示惊讶或困惑的强调"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}