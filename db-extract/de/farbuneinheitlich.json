                ],
                "senses": [
                    {
                        "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                        "entry_id": "e98a1916-7bee-3a4e-a627-740bf27cd6ae",
                        "glosses": [
                            "verschiedene Farben, nicht den gleichen Farbton aufweisend"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "62ebaa33-a423-457c-8de7-3ab0e35422f7",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "Die graue Irdenware verdrängte seit den ersten Jahrzehnten des 13. Jahrhunderts die ältere farbuneinheitliche Irdenware, zu der auch die spätslawische Keramik gehört. Farbuneinheitliche Irdenware spielte demnach im Zeitraum um 1229 kaum noch eine Rolle."
                            },
                            {
                                "example_id": "9ee956ab-502e-4172-95c3-5fff2f6e2482",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "In der Baugrube des Brunnens von 1228 fand sich kleinstückige und abgerollte Keramik grauer und farbuneinheitlicher Irdenware, die aus einer älteren Kulturschicht stammen muss, was auf eine Anlage des Dorfes vor 1228 verweist."
                            },
                            {
                                "example_id": "27f43235-3e2a-4cd6-819e-606d6dfaf822",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "Es handelt sich um farbuneinheitliche Irdenware, also Keramiken, bei denen während des Brands noch nicht die Sauerstoffzufuhr geregelt wurde."
                            },
                            {
                                "example_id": "104f6946-be94-4983-b873-82586d0b1123",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "Eine Grundfläche in sozusagen hellgrauer Farbe mit aufgesetztem wirklich weißem Punkt wäre vom menschlichen Auge nicht als farbuneinheitlich zu erkennen, könnte von der Kamera jedoch ohne weiteres farblich aufgelöst werden."
                            },
                            {
                                "example_id": "8df2813f-cd84-4778-bedb-5df0b285cf99",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "Das Ergebnis ist meist farbuneinheitlich oder grau."
                            },
                            {
                                "example_id": "7352c3a3-5239-42c3-bae9-d32f043d04ca",
                                "sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                                "text": "„Abb. 4: Verlauf der Hydrothermolyse von Baumwolle-Verschnitt, farbuneinheitlich - bei 295 ± 2°C …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea70458-edda-4157-9e74-88db44e3a235",
                        "source_entry_id": "e98a1916-7bee-3a4e-a627-740bf27cd6ae",
                        "source_sense_id": "52846875-b8a3-3ae4-9eab-10555c6afef0",
                        "source_sense_description": "Fachsprache, von Produkten: verschiedene Farben, nicht den gleichen Farbton aufweisend",
                        "target_lang_word": "varicolored",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "varicolored",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "047870f0-1dcd-3fea-a6c4-156020fdec77",
                                        "entry_id": "d0d8f45f-03e2-306d-ae97-c7a104e0c278",
                                        "glosses": [
                                            "Having a variety of colors; variegated or motley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96ad09d-cbb2-499a-b8be-271d4e51af34",
                                                "sense_id": "047870f0-1dcd-3fea-a6c4-156020fdec77",
                                                "text": "[…] the habit of the greater part of them is only a wreath of Callico tyed about their heads; their mid-parts are circled with a Zone of vari-colored plad, and have Sandalls upon their feet, elsewhere being naked […]"
                                            },
                                            {
                                                "example_id": "4119e836-0b7b-4efc-8ad3-54003226998c",
                                                "sense_id": "047870f0-1dcd-3fea-a6c4-156020fdec77",
                                                "text": "The Fisherman looked into the water and was much astonished to see therein vari-coloured fishes, white and red, blue and yellow; however he cast his net and, hauling it in, saw that he had netted four fishes, one of each colour."
                                            },
                                            {
                                                "example_id": "3b67c07a-6854-4aba-932d-6853f37ef910",
                                                "sense_id": "047870f0-1dcd-3fea-a6c4-156020fdec77",
                                                "text": "The varicolored cloud of dust that the sun had stirred up in the sky was settling by slow degrees."
                                            },
                                            {
                                                "example_id": "390e056e-f04b-414c-a101-7c6b8c6aae96",
                                                "sense_id": "047870f0-1dcd-3fea-a6c4-156020fdec77",
                                                "text": "Watching Jesse Jackson in tears in Grant Park, pressed up against the varicolored American public, it seemed like he, at least, had received the answer he needed: only a many-voiced man could have spoken to that many people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
