                "senses": [
                    {
                        "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                        "entry_id": "119053c7-a0cc-3a77-bc60-3d951a8044f7",
                        "glosses": [
                            "Attentat mit terroristischem Hintergrund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "459d42db-747b-47ca-9dbe-3522341abab9",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "Die Terroranschläge am 11. September 2001 waren die schlimmsten in der amerikanischen Geschichte."
                            },
                            {
                                "example_id": "036e2e8e-d670-4ec5-accb-09c1564182f5",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "„Im Verlauf des März und in der ersten Hälfte des April kam es wiederholt zu Terroranschlägen, sowohl von katholischer wie auch von protestantischer Seite.“"
                            },
                            {
                                "example_id": "aaa13f24-49c9-449e-af45-5a298cb4341b",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "Nach ersten Informationen handelt es sich um einen Terroranschlag mit 25 Toten."
                            },
                            {
                                "example_id": "9293cac0-b83f-43c6-8a6c-c645e2288d83",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "„Ich fragte ihn, ob er denn nichts von New York gehört habe, von den Terroranschlägen auf das Herz des Kapitalismus, das World Trade Center.“"
                            },
                            {
                                "example_id": "149018d9-e09c-4544-8899-b7198e6ba70c",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "„Nach den Terroranschlägen des 11. Septembers 2001 setzte der Nato-Rat erstmals den Bündnisfall nach Artikel 5 des Washingtoner Vertrags in Kraft.“"
                            },
                            {
                                "example_id": "bc3d483b-05b3-4888-b3be-45680ffbf24d",
                                "sense_id": "8f3d86cc-1229-3189-a834-cf63f5cb697c",
                                "text": "„In Frankreich herrscht nach den Terroranschlägen Ausnahmezustand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
