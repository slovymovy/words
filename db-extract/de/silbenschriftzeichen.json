                "senses": [
                    {
                        "sense_id": "2b5be6e5-8715-319c-ac6c-be05c1e0a3f7",
                        "entry_id": "70ff7116-4d28-316f-8ce6-5f2f6897cea6",
                        "glosses": [
                            "Schriftzeichen, das eine Silbe darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be58f49-e873-4f80-a3c4-9973abe37ca1",
                                "sense_id": "2b5be6e5-8715-319c-ac6c-be05c1e0a3f7",
                                "text": "„Bedingt durch die funktionale Notwendigkeit, Informationen dieser Art darzustellen, wurde von der auch im Chinesischen gegebenen, aber nur wenig genutzten Möglichkeit der quasi-phonetischen Verwendung der Wortzeichen als Silbenschriftzeichen Gebrauch gemacht.“"
                            },
                            {
                                "example_id": "eda20a8e-729e-4eae-a0ba-15262214eee0",
                                "sense_id": "2b5be6e5-8715-319c-ac6c-be05c1e0a3f7",
                                "text": "„Die Veranstaltung bot allen Besuchern einen nachhaltigen Einblick in eine eigenständige japanische Kunstform, die tief in der traditionellen Kultur Japans verwurzelt ist, und es steht zu hoffen, dass dieser Abend bei den Gästen das Interesse für die Kunst der Kalligraphie mit japanischen Silbenschriftzeichen gefördert hat. “"
                            },
                            {
                                "example_id": "fd404664-1983-485c-ac04-a1e395325ecc",
                                "sense_id": "2b5be6e5-8715-319c-ac6c-be05c1e0a3f7",
                                "text": "„Aus über 800 Zeichen – Silbenschriftzeichen und Logogrammen – bestand die Schrift der Mayas.“"
                            },
                            {
                                "example_id": "abd87408-061e-498c-837f-f62ff73538e5",
                                "sense_id": "2b5be6e5-8715-319c-ac6c-be05c1e0a3f7",
                                "text": "„Der Kurs umfasst Übungen in japanischer Lautlehre, Formenlehre und Syntax sowie die Erlernung beider Kana-Schriften (Hiragana und Katakana, 2 x 46 Silbenschriftzeichen) und ca. 120 chinesische Schriftzeichen (Kanji, einschließlich Aufbaukurs ca. 350).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
