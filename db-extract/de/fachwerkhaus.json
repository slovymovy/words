                        "form": "die Fachwerkhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                        "entry_id": "b5881027-ac4a-3bd9-9562-3845ffd11405",
                        "glosses": [
                            "Gebäude, welches einen Skelettbau aus Holz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee7ed68-cacd-4690-89ea-51a4e2f36566",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "In alten Städten findet man oft noch viele Fachwerkhäuser."
                            },
                            {
                                "example_id": "c3de95f4-5dca-4728-9c4f-6d764ba75841",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "Vor dem Zweiten Weltkrieg war Frankfurt am Main die Stadt mit den meisten Fachwerkhäusern Europas."
                            },
                            {
                                "example_id": "59ff1e38-93a9-4de6-aff5-411494589806",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "Fast jedes Fachwerkhaus hat einen eigenen Namen, der auf sich auf seine Mieter oder sein Äußeres bezieht: „Haus Zur Goldenen Waage“, „Waffenschmiedehaus“, „Haus Frauenstein“ oder „Umgestülpter Zuckerhut“."
                            },
                            {
                                "example_id": "443c94af-7589-4af5-81e5-dffeab3adbfc",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "„Das Fachwerk der Häuser ist dürftig: vornehmere Fachwerkhäuser sind selten, sind Sehenswürdigkeiten für Fremde, die Einzelheiten brauchen und die Landschaft nicht verstehen.“"
                            },
                            {
                                "example_id": "66eb449a-540f-47dc-82fc-24813147ff73",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "„Das Fachwerkhaus ist Anfang des 18. Jahrhunderts errichtet worden.“"
                            },
                            {
                                "example_id": "4848857a-9b08-4a43-b0b3-8d30ce7a5128",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "„Die Gärtnerei lag auf einer Anhöhe, oberhalb von Kornelimünster mit seinen Fachwerkhäusern, der Abtei und der Inde, die durch den Ort floss.“"
                            },
                            {
                                "example_id": "b13e2068-cf9a-4ab4-9564-93927d4a21d4",
                                "sense_id": "f71630ca-4ec8-3f71-a101-78df03173bd7",
                                "text": "„Gemeinhin bestanden diese Fürstensitze aus einer Festungsmauer, innerhalb derer sich größere Fachwerkhäuser befanden, in denen wohl der Hochadel wohnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
