                "senses": [
                    {
                        "sense_id": "35eaf134-01f1-3835-b8c0-fa65abd9c6e5",
                        "entry_id": "db9e1b70-18a5-3e7b-a7df-040340a3fc65",
                        "glosses": [
                            "A cyclic synthetic nucleoside C₈H₁₁N₅O₃ used as an antiviral drug (trademarks Avirax, Zovirax) chiefly in the treatment of chicken pox, shingles, the genital form of herpes simplex, and AIDS."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "290c4a9e-f2e9-4556-8464-e15c2246b9b2",
                                "sense_id": "35eaf134-01f1-3835-b8c0-fa65abd9c6e5",
                                "text": "In cells infected with the herpes virus, acyclovir is converted to a metabolic blocking agent, thereby largely overcoming the old and plaguing problem of toxicity to the host."
                            },
                            {
                                "example_id": "a2082bc5-d94b-4261-9718-2ba58ee29ce5",
                                "sense_id": "35eaf134-01f1-3835-b8c0-fa65abd9c6e5",
                                "text": "From the description, Letha felt sure Jane had herpes zoster, or shingles, which often strikes cancer patients or others with depressed immune systems. Jane spent another week in the Bubble, treated with acyclovir."
                            }
                        ]
                    }
                ],
