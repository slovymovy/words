                                "target_senses": [
                                    {
                                        "sense_id": "f5bcebd9-b3a8-3140-acda-4264065c3873",
                                        "entry_id": "20e97815-1cb0-3946-9569-91b95c7fa08f",
                                        "glosses": [
                                            "ženské rodné jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05264782-b4bb-4bc6-8fb9-59f1a9267c9c",
                                                "sense_id": "f5bcebd9-b3a8-3140-acda-4264065c3873",
                                                "text": "Davida si však zamilovala Saulova dcera Míkal. Oznámili to Saulovi a jemu se to zamlouvalo."
                                            },
                                            {
                                                "example_id": "1aee1a69-56f4-424f-816d-929692274e39",
                                                "sense_id": "f5bcebd9-b3a8-3140-acda-4264065c3873",
                                                "text": "Saul viděl a poznal, že Hospodin je s Davidem, a jeho dcera Míkal ho milovala."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86fd298f-f37d-4784-957a-6695b168f7c6",
                        "source_entry_id": "b3e8b580-d0f2-39f0-b280-406209cb5a6c",
                        "source_sense_description": "biblical character",
                        "target_lang_word": "Michał",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Michał",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                        "entry_id": "ccd3959e-8e3b-34ce-88ec-9955d8ab6778",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c96e20b-8a2c-4490-9ed0-df57ad36559d",
                                                "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                                "text": "Mój najlepszy przyjaciel ma na imię Michał."
                                            },
                                            {
                                                "example_id": "bbaf6570-b3ed-426c-a0c4-afeb3648a71b",
                                                "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                                "text": "Michał Stachowicz, polski rytownik i malarz epoki romantyzmu, w swej twórczości łączył prowincjonalną naiwność ze szczerym patriotyzmem."
                                            },
                                            {
                                                "example_id": "f9bc376d-ee29-472d-9103-2a3cc8f66388",
                                                "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                                "text": "W Kościele katolickim na 29 września przypada wspomnienie św. Michała Archanioła, pogromcy Szatana i obrońcy każdej duszy ludzkiej, patrona Kościoła, dobrej śmierci, żołnierzy i policjantów."
                                            },
                                            {
                                                "example_id": "97ddef98-7d12-4171-96dc-ed606d83a1d0",
                                                "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                                "text": "Lecz wśród ogólnych narzekań ani jeden głos nie podniósł się przeciw młodemu pułkownikowi, panu Jerzemu Michałowi Wołodyjowskiemu"
                                            },
                                            {
                                                "example_id": "c6d8220d-31e5-4f2b-8bb6-369b4c93d9ac",
                                                "sense_id": "bdb82323-3568-39d3-9017-42b916b76e5a",
                                                "text": "Michałowie dzień swego patrona, czyli imieniny, obchodzą 29 września, a także 10 kwietnia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
