                "senses": [
                    {
                        "sense_id": "2b4f138d-a44b-30c9-bfe0-cee51a125c34",
                        "entry_id": "1c238d73-e79f-3822-999e-695325c52848",
                        "glosses": [
                            "Lebewesen, das sowohl weibliche als auch männliche Geschlechtsmerkmale aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49b4d03-68d9-4821-b361-32dbb75a1434",
                                "sense_id": "2b4f138d-a44b-30c9-bfe0-cee51a125c34",
                                "text": "„Maria Patiño wäre nach dem prokreativen Kriterium entweder konventionell ein Mann oder innovativ ein Intersex bzw. nach Fausto-Sterling ein Merm.“"
                            },
                            {
                                "example_id": "4102508c-3e74-4efc-b312-bf8baa67dfa6",
                                "sense_id": "2b4f138d-a44b-30c9-bfe0-cee51a125c34",
                                "text": "„Im 21. Jahrhundert vermögen Mediziner sehr wohl vorauszusehen, ob ein Kind gesund zur Welt kommen wird oder nicht, ob es ein Junge oder ein Mädchen oder ein Intersex ist, wie lang sein Körper ist, wie groß der Umfang des Kopfes, wie dick seine Nackenfalte.“"
                            },
                            {
                                "example_id": "8c283995-4608-49b6-80b2-61b34deab28e",
                                "sense_id": "2b4f138d-a44b-30c9-bfe0-cee51a125c34",
                                "text": "„Anschließend sei noch ein Sonderbefund näher geschildert: Bei einem 6 Tage alten weißen hornlosen Intersex (ein Intersex als Wurfgeschwister) erschien die rechte Gonade samt Nebenhoden bei der makroskopischen Untersuchung dunkelrot gefärbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f98eb7ee-af6d-4f9c-933f-d87a1bc96bfc",
                        "source_entry_id": "1c238d73-e79f-3822-999e-695325c52848",
                        "source_sense_id": "2b4f138d-a44b-30c9-bfe0-cee51a125c34",
                        "source_sense_description": "Lebewesen mit weiblichen und männlichen Geschlechtsmerkmalen",
                        "target_lang_word": "intersex",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfd0975-5fda-30cf-b7f5-ef6df83baa83",
                                        "entry_id": "2c7e0534-a9a4-398f-9b4c-6f70224dc68d",
                                        "glosses": [
                                            "Of an individual, having any of a variety of inherent conditions (in a species with distinct sexes) in which one's sex characteristics differ from those of a typical male and female; for example, having sex characteristics relating to both male and female sexes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b674333-1b2d-439a-b4f9-068857f83375",
                                                "sense_id": "6dfd0975-5fda-30cf-b7f5-ef6df83baa83",
                                                "text": "His confidentiality was broken, and soon the entire staff and residential population were aware that Jim was intersex. […] we faced the fact that most programs were gender segregated and would not be a safe place for Jim to be known as intersex."
                                            },
                                            {
                                                "example_id": "c2117e4b-b99b-4c67-b9a9-b660b1ec538c",
                                                "sense_id": "6dfd0975-5fda-30cf-b7f5-ef6df83baa83",
                                                "text": "When I had learned that I was intersex, I brought this issue to my mother."
                                            },
                                            {
                                                "example_id": "004cd51d-af55-4cba-8396-85e4d9c8ffcd",
                                                "sense_id": "6dfd0975-5fda-30cf-b7f5-ef6df83baa83",
                                                "text": "A survey of 1100 lesbian, gay, bisexual, transgender, intersex and queer (LGBTIQ) people by Griffith and Bond University researchers found that the overwhelming majority had been victims of targeted harassment as well as physical and sexual abuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366959b8-575b-332e-97bb-80df398fa09b",
                                        "entry_id": "2c7e0534-a9a4-398f-9b4c-6f70224dc68d",
                                        "glosses": [
                                            "A person who can get pregnant and also impregnate someone else."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intersex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa943cd7-f6e9-3719-be62-7d1114044b4b",
                                        "entry_id": "bcb8f7a3-f116-317f-8138-0f23730cf20c",
                                        "glosses": [
                                            "The condition of being intersex; intersexuality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c4d332-2951-4350-8c30-1e12c169fec5",
                                                "sense_id": "fa943cd7-f6e9-3719-be62-7d1114044b4b",
                                                "text": "A much more common condition caused by early exposure of fish larvae to oestrogenic substances is intersex, which in males usually takes the form of ovotestis."
                                            },
                                            {
                                                "example_id": "6a072511-9325-44d4-bea9-763c53cdca88",
                                                "sense_id": "fa943cd7-f6e9-3719-be62-7d1114044b4b",
                                                "text": "A Canadian believes that he has solved the diagnostic problem in human intersex. All human cells, says Dr. Murray L. Barr of the University of Western Ontario, contain something called sex chromatin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                        "entry_id": "bcb8f7a3-f116-317f-8138-0f23730cf20c",
                                        "glosses": [
                                            "An individual with any of these conditions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a53e868-c44e-40c5-9741-32237d71f8df",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "Goldschmidt and others who have thought of the homosexual individual as an intersex have relied upon incidence figures which were pure guesses and which, as the data in the present chapter will show, bear little relation to the fact...."
                                            },
                                            {
                                                "example_id": "0cbd41b1-61d0-46e1-b7ec-36f6607c5e21",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "Conversely, a fertilized egg with one X-chromosome would develop not into a male but into an intersex […]"
                                            },
                                            {
                                                "example_id": "74b7e10c-efbf-41b0-afc9-ea4f10a20443",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "Pseudo-hermaphrodites or other intersexes are not to be confused with transsexualists; transvestites may be transsexualists, but not necessarily."
                                            },
                                            {
                                                "example_id": "d5cc2583-fc54-46c0-adaf-75a3fadd087f",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "Genital surgery on intersexes has been performed for about a century"
                                            },
                                            {
                                                "example_id": "575e5a17-882d-4d79-b640-daa8f52f6bbb",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "An intersex, then, is an animal that shows both male and female characteristics."
                                            },
                                            {
                                                "example_id": "817a5ec9-6b42-4947-ab7d-755af2c08ad5",
                                                "sense_id": "7d9c096f-7b17-3058-8972-62ee9905dd8d",
                                                "text": "Kubick also did not specifically include intersex people in the class of those seeking X gender markers, writing in her opinion that because the only Orr v. Trump plaintiffs seeking X gender markers were endosex nonbinary people, it was “not clear that non-binary class representatives could fully represent the interests of intersex class members.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intersex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82a8268e-b0a8-3ac8-a575-42914be8daf1",
                                        "entry_id": "92193f2c-638c-33f0-8441-a6852efdd675",
                                        "glosses": [
                                            "To make intersex."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f54744e-1579-40a2-8938-a20ce9750490",
                                                "sense_id": "82a8268e-b0a8-3ac8-a575-42914be8daf1",
                                                "text": "The point is significant in light of current political issues surrounding real intersexed individuals. [...] It is clearly the case that physical intersexing and psychological androgyny do not conform to sex and gender norms in society. [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
