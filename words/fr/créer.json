                {
                    "sense_id": "8a11fb6d-0833-3b2f-b505-53f7f6a0b81c",
                    "sense_definition": "Interpréter ou mettre en scène une œuvre théâtrale ou musicale pour la toute première fois.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette troupe renommée va <w>créer</w> la nouvelle pièce du dramaturge à l'automne."
                        },
                        {
                            "text": "Le comédien a <w>créé</w> ce personnage complexe lors de la première représentation."
