                        "examples": [
                            {
                                "example_id": "99357d95-b01c-499c-9ba1-271c2768d2ca",
                                "sense_id": "6c7b5bfe-4e1e-3e98-92fb-882b34162bd4",
                                "text": "Die Quästur ist Montag geschlossen."
                            },
                            {
                                "example_id": "5d3da3d1-3444-4ca8-86ea-85edf973e5ab",
                                "sense_id": "6c7b5bfe-4e1e-3e98-92fb-882b34162bd4",
                                "text": "„Dass man jedes Semester den Gang zur Quästur, der Finanzstelle der Universität, antreten musste, war selbstverständlich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d8aa3474-4e56-3e8f-88ca-3d3795cef69a",
