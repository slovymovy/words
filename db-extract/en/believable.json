                                        "sense_id": "1eeb8123-5509-350f-8d65-cd9980d92d9d",
                                        "entry_id": "12b62cfc-2489-3493-9f0a-74dbf0fa53ba",
                                        "glosses": [
                                            "Qui peut ou qui doit être cru."
                                        ],
                                        "tags": [],
                                        "note": "Il se dit surtout des choses",
                                        "examples": [
                                            {
                                                "example_id": "73914ee4-87e0-4969-9e66-9e05a8d5fc1c",
                                                "sense_id": "1eeb8123-5509-350f-8d65-cd9980d92d9d",
                                                "text": "On était bien loin alors de lui faire des procès sur les griffons ; on ne croyait que ce qui lui semblait croyable."
                                            },
                                            {
                                                "example_id": "c4d18269-eccd-4766-b744-3c703ff113b3",
                                                "sense_id": "1eeb8123-5509-350f-8d65-cd9980d92d9d",
                                                "text": "On retrouve encore aujourd'hui […] les vestiges de monastères-forteresses, élevés jadis, dit-on par les moines défricheurs ; une tradition plus croyable veut encore dans le pays que ces constructions, qui paraissent avoir tenu bien plutôt du château-fort que de l'abbaye, aient servi de refuge aux Templiers […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "croyable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50bf59da-19e3-3ea0-b175-d29e69eac91b",
                                        "entry_id": "fdebc613-efa0-36aa-989a-337d7ac09606",
                                        "glosses": [
                                            "Substantivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62500796-b7a6-4868-8aba-53965062d4a0",
                                                "sense_id": "50bf59da-19e3-3ea0-b175-d29e69eac91b",
                                                "text": "Ce récit va bien au-delà du croyable."
                                            },
                                            {
                                                "example_id": "a973bb5f-7974-4625-a403-39a44d2df31e",
                                                "sense_id": "50bf59da-19e3-3ea0-b175-d29e69eac91b",
                                                "text": "Mais si l’incroyable était plus vrai que le croyable..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26cacd47-1c0c-4154-a27c-c053fbf8aa78",
                        "source_entry_id": "fe213c1c-dc6e-31ce-8c8d-f20215a4d229",
