                    {
                        "sense_id": "bf4fafc6-c527-345e-a9a0-8433e350caee",
                        "entry_id": "5dc3e675-6d5e-336f-b46e-31b4163beb01",
                        "glosses": [
                            "simple past of strike"
                        ],
                        "tags": [
