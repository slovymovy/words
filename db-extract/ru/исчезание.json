                "senses": [
                    {
                        "sense_id": "d45cdeff-d089-3e01-89ef-57e62b453df3",
                        "entry_id": "8864a557-23df-3b41-86c6-108f2f9d7129",
                        "glosses": [
                            "устар. и книжн. действие по значению гл. исчезать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8c1242-9cc3-407b-afae-8c4d7d0d9cf4",
                                "sense_id": "d45cdeff-d089-3e01-89ef-57e62b453df3",
                                "text": "Сокровенные доселе внутренние каждого движения, заклёпанные, так сказать, ужасом, начали являться при исчезании надежды."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa269382-c96e-39ce-8684-000fd85053b6",
                        "entry_id": "8864a557-23df-3b41-86c6-108f2f9d7129",
                        "glosses": [
                            "устар. и книжн. результат такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235880dc-89f1-496d-91c5-f01985d654e3",
                                "sense_id": "aa269382-c96e-39ce-8684-000fd85053b6",
                                "text": "Отделения больного заразительны ещё в течение нескольких дней после исчезания пленок."
                            }
                        ]
                    }
                ],
