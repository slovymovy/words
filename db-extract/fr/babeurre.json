                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bcf404-3e52-4b7d-bfb4-19ff189e3ae3",
                                                "sense_id": "405a8dd9-5c91-381d-bd1b-bc382bea1464",
                                                "text": "Šlehané podmáslí se vyrábí z pasterizovaného mléka, které se zakyše kvasinkami smetanového zákysu."
                                            }
