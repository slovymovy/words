                                                "example_id": "dbd90c59-b8a3-49db-bbb5-5c7309d4cd46",
                                                "sense_id": "1990221a-212f-3eab-b300-edcd7333965b",
                                                "text": "For those who imagine the capital flows with milk and honey, or avocado and sourdough, Edmonton is your rebuttal. Once full of light industry, today it has some of the most deprived areas in England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a700a5-a120-3fd6-b75f-a3eee5300479",
