                ],
                "senses": [
                    {
                        "sense_id": "558ff0f9-2e1a-3418-924d-8f6fb67d23dd",
                        "entry_id": "321b9d78-d30a-3b8d-9a7d-91c8caae9cfd",
                        "glosses": [
                            "geschlossener Raum für den Fahrer eines Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b944ff-48de-42cf-a45b-86f89e16f76c",
                                "sense_id": "558ff0f9-2e1a-3418-924d-8f6fb67d23dd",
                                "text": "„Er war noch nie in der Fahrerkabine des Lasters gewesen und war überrascht, wie geräumig sie war.“"
                            },
                            {
                                "example_id": "74ec5f0e-c1f4-4129-a558-9b00855a204f",
                                "sense_id": "558ff0f9-2e1a-3418-924d-8f6fb67d23dd",
                                "text": "„Dann war für längere Zeit nur das monotone Brummen des Diesels in der Fahrerkabine des Trucks zu hören.“"
                            },
                            {
                                "example_id": "7347e962-70bb-4548-bf0d-38b84a71be6a",
                                "sense_id": "558ff0f9-2e1a-3418-924d-8f6fb67d23dd",
                                "text": "„Allan und Julius musste nach hinten zu Sonja, damit der Halbtote sich in der Fahrerkabine des Busses hinlegen konnte.“"
                            },
                            {
                                "example_id": "0e2618c0-8828-4818-bc1c-d074198fe082",
                                "sense_id": "558ff0f9-2e1a-3418-924d-8f6fb67d23dd",
                                "text": "„Er sprach mit Lee Jay übers Dach der Fahrerkabine hinweg, und wenn er mit Anse sprechen wollte, duckte er sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
