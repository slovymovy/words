                                    },
                                    {
                                        "sense_id": "f86bafe0-5edf-3ffd-834c-fc99c209f303",
                                        "entry_id": "975101f3-db91-3f75-ae4a-e61293125dab",
                                        "glosses": [
                                            "ten, kdo se snaží rychle či bezpracně zbohatnout, často na úkor jiných"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451f429b-160a-4735-9e2f-88b0d66683eb",
                                                "sense_id": "f86bafe0-5edf-3ffd-834c-fc99c209f303",
                                                "text": "Někteří finanční zprostředkovatelé se chovají doslova jako zlatokopové. Klientům radí tak, aby pro sebe vyrýžovali co nejvyšší provize."
                                            }
