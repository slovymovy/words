                        "target_lang_word": "полужопие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "полужопие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f2b5d9-e5a8-3dde-bbb1-cf3f9046a744",
                                        "entry_id": "4a66eedc-7b1e-337a-9985-2a774f1a5c42",
                                        "glosses": [
                                            "прост., шутл. то же, что ягодица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9377b1-1b0b-4282-ba02-d462c8783ff6",
                                                "sense_id": "a4f2b5d9-e5a8-3dde-bbb1-cf3f9046a744",
                                                "text": "Это Вампир ткнул его остриём шашки в правое полужопие, тем самым нарушив целостность данного о́ргана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0813f3af-1447-385c-bc71-612a5bc478e7",
                                        "entry_id": "4a66eedc-7b1e-337a-9985-2a774f1a5c42",
                                        "glosses": [
                                            "перен. прост., шутл. очень сложная, неприятная ситуация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b384491-5b0e-4558-bfe6-2ddd2b1cf2c2",
                                                "sense_id": "0813f3af-1447-385c-bc71-612a5bc478e7",
                                                "text": "У нас в стране конечно пока ещё не жопа, но уже́ явное какое-то полужопие."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11372641-1804-3278-a2de-ff4f91c6f9ac",
                                        "entry_id": "4a66eedc-7b1e-337a-9985-2a774f1a5c42",
                                        "glosses": [
                                            "прост., шутл. полушарие головного мозга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48ce7b5-5d62-43ff-8675-439150cae0c8",
                                                "sense_id": "11372641-1804-3278-a2de-ff4f91c6f9ac",
                                                "text": "А наши депутаты — они каким полужопием в своей Думе думы думают?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33993bba-fc94-43d2-aedb-23080e27b4db",
                        "source_entry_id": "de035867-56d9-30da-b2ef-ccb9430c7fb2",
