                    },
                    {
                        "translation_id": "76496a63-40e6-46c2-9900-cc9b61d2ccc3",
                        "source_entry_id": "d494a390-c0f9-399d-ade5-dbb1816a5c4d",
                        "target_lang_word": "dine and dash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dine and dash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9be323d6-a12a-3d90-91de-53d0ea8bdbd4",
                                        "entry_id": "8894e2ed-3837-367c-b540-c3844b5c5035",
                                        "glosses": [
                                            "The crime of eating a meal in a restaurant and leaving without paying."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8b7a0c-0408-4b63-80b0-f3023c006eb7",
                                                "sense_id": "9be323d6-a12a-3d90-91de-53d0ea8bdbd4",
                                                "text": "He was also an irresponsible boozehound who habitually ran out on the check in restaurants, even though he must have known it was the waitress who had to pay the bill for such dine-and-dash customers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dine and dash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "379d8fa0-aaca-307d-91f4-0d9c6b4ce371",
                                        "entry_id": "7c529d53-a39b-35a1-b684-9660baf0fd8b",
                                        "glosses": [
                                            "To commit such an act."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862763d0-053e-4eef-9a18-a923723637ce",
                                                "sense_id": "379d8fa0-aaca-307d-91f4-0d9c6b4ce371",
                                                "text": "Dine-and-dashed for an ice cream sundae. I did it two or three times a month. Kept it to a hot fudge sundae—never real food or anything like that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
