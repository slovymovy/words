{
    "word_family": [
        "abandonment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                    "sense_definition": "To leave a place, thing, or person, usually forever; to desert someone who needs help.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain gave the order to <w>abandon</w> ship immediately.",
                            "target_lang_translations": {
                                "ru": "Капитан отдал приказ немедленно <w>покинуть</w> корабль.",
                                "de": "Der Kapitän gab den Befehl, das Schiff sofort zu <w>verlassen</w>.",
                                "zh": "船长下令立即<w>弃</w>船。"
                            }
                        },
                        {
                            "text": "She had to <w>abandon</w> her car in the deep snow and walk home.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>оставить</w> машину в глубоком снегу и идти домой пешком.",
                                "de": "Sie musste ihr Auto im tiefen Schnee <w>zurücklassen</w> und zu Fuß nach Hause gehen.",
                                "zh": "她不得不把车<w>丢下</w>在深雪中，步行回家。"
                            }
                        },
                        {
                            "text": "The mother bear would never <w>abandon</w> her cubs.",
                            "target_lang_translations": {
                                "ru": "Медведица никогда не <w>бросит</w> своих медвежат.",
                                "de": "Die Bärenmutter würde ihre Jungen niemals <w>im Stich lassen</w>.",
                                "zh": "母熊绝不会<w>抛弃</w>它的小熊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leave behind",
                        "desert",
                        "forsake",
                        "leave",
                        "quit"
                    ],
                    "antonyms": [
                        "keep",
                        "retain",
                        "protect",
                        "cherish",
                        "hold",
                        "defend"
                    ],
                    "common_phrases": [
                        "abandon ship",
                        "abandon a child",
                        "abandon a vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покинуть место, вещь или человека, обычно навсегда; бросить кого-то, кто нуждается в помощи.",
                        "de": "Einen Ort, eine Sache oder eine Person verlassen, meist für immer; jemanden im Stich lassen, der Hilfe benötigt.",
                        "zh": "离开某地、某物或某人，通常指永久离开；抛弃需要帮助的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покидать",
                                "target_lang_sense_clarification": "уходить из места или оставлять кого-то (нейтральное/книжное)"
                            },
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "оставлять кого-то на произвол судьбы (разговорное/эмоциональное)"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "не брать с собой вещь или уходить от кого-то"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verlassen",
                                "target_lang_sense_clarification": "einen Ort oder eine Person hinter sich lassen"
                            },
                            {
                                "target_lang_word": "im Stich lassen",
                                "target_lang_sense_clarification": "jemanden in einer Notlage allein lassen"
                            },
                            {
                                "target_lang_word": "zurücklassen",
                                "target_lang_sense_clarification": "etwas oder jemanden an einem Ort lassen, während man geht"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "从某处走开或不再留在某地"
                            },
                            {
                                "target_lang_word": "抛弃",
                                "target_lang_sense_clarification": "丢弃某物或背弃某人"
                            },
                            {
                                "target_lang_word": "丢下",
                                "target_lang_sense_clarification": "将某物或某人留在原地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ca33cae-4dce-36a7-9fce-dd38f1480632",
                    "sense_definition": "To stop doing an activity, plan, or piece of work before it is finished.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>abandon</w> the project due to a lack of funding.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>отказаться</w> от проекта из-за недостатка финансирования.",
                                "de": "Sie beschlossen, das Projekt wegen fehlender Finanzierung <w>aufzugeben</w>.",
                                "zh": "由于缺乏资金，他们决定<w>放弃</w>该项目。"
                            }
                        },
                        {
                            "text": "Bad weather forced the climbers to <w>abandon</w> their attempt to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Плохая погода заставила альпинистов <w>оставить</w> попытку добраться до вершины.",
                                "de": "Schlechtes Wetter zwang die Bergsteiger, ihren Versuch, den Gipfel zu erreichen, <w>abzubrechen</w>.",
                                "zh": "恶劣的天气迫使登山者<w>中止</w>了登顶的尝试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "give up",
                        "discontinue",
                        "cease",
                        "drop",
                        "desist from"
                    ],
                    "antonyms": [
                        "maintain",
                        "uphold",
                        "undertake"
                    ],
                    "common_phrases": [
                        "abandon a plan",
                        "abandon an idea",
                        "abandon a project",
                        "abandon hope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить заниматься делом, планом или работой до их завершения.",
                        "de": "Eine Tätigkeit, einen Plan oder eine Arbeit abbrechen, bevor sie abgeschlossen ist.",
                        "zh": "在完成之前停止某项活动、计划或工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказываться",
                                "target_lang_sense_clarification": "переставать поддерживать план, идею или намерение"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "останавливать действие или попытку"
                            },
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "переставать делать что-то, не закончив (разговорное)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufgeben",
                                "target_lang_sense_clarification": "ein Vorhaben oder eine Bemühung beenden"
                            },
                            {
                                "target_lang_word": "abbrechen",
                                "target_lang_sense_clarification": "eine laufende Tätigkeit vorzeitig beenden"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "不再坚持计划、想法或意图"
                            },
                            {
                                "target_lang_word": "中止",
                                "target_lang_sense_clarification": "中途停止正在进行的活动或尝试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6239ae73-78f5-34fe-ac91-fd02479a11af",
                    "sense_definition": "To give oneself over completely to an emotion or impulse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>abandoned</w> himself to despair after hearing the tragic news.",
                            "target_lang_translations": {
                                "ru": "Услышав трагическую новость, он <w>предался</w> отчаянию.",
                                "de": "Nachdem er die tragische Nachricht gehört hatte, <w>überließ</w> er sich der Verzweiflung.",
                                "zh": "听到这个悲剧性的消息后，他<w>沉溺于</w>绝望之中。"
                            }
                        },
                        {
                            "text": "The dancers <w>abandoned</w> themselves to the rhythm of the drums.",
                            "target_lang_translations": {
                                "ru": "Танцоры <w>отдались</w> ритму барабанов.",
                                "de": "Die Tänzer <w>gaben</w> sich dem Rhythmus der Trommeln hin.",
                                "zh": "舞者们<w>沉浸在</w>鼓点的节奏中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surrender",
                        "yield"
                    ],
                    "antonyms": [
                        "stand one's ground"
                    ],
                    "common_phrases": [
                        "abandon oneself to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью поддаться эмоции или импульсу.",
                        "de": "Sich einer Emotion oder einem Impuls vollständig hingeben.",
                        "zh": "完全沉浸于某种情绪或冲动之中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предаваться",
                                "target_lang_sense_clarification": "позволять чувству или состоянию овладеть собой"
                            },
                            {
                                "target_lang_word": "отдаваться",
                                "target_lang_sense_clarification": "полностью погружаться в ощущение или ритм"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich hingeben",
                                "target_lang_sense_clarification": "sich voll und ganz einem Gefühl oder Rhythmus überlassen"
                            },
                            {
                                "target_lang_word": "sich überlassen",
                                "target_lang_sense_clarification": "sich einem Zustand oder einer Stimmung ausliefern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉溺于",
                                "target_lang_sense_clarification": "完全陷入某种情绪或状态"
                            },
                            {
                                "target_lang_word": "沉浸在",
                                "target_lang_sense_clarification": "全身心地投入到某种感觉或节奏中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                    "sense_definition": "A complete lack of inhibition or restraint; the state of acting freely without worrying about consequences.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played in the rain with wild <w>abandon</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли под дождем с дикой <w>необузданностью</w>.",
                                "de": "Die Kinder spielten mit wilder <w>Ungezwungenheit</w> im Regen.",
                                "zh": "孩子们在雨中<w>放纵</w>地玩耍。"
                            }
                        },
                        {
                            "text": "She laughed with <w>abandon</w>, not caring who was watching.",
                            "target_lang_translations": {
                                "ru": "Она смеялась с <w>самозабвением</w>, не заботясь о том, кто на неё смотрит.",
                                "de": "Sie lachte mit <w>Selbstvergessenheit</w>, ohne sich darum zu kümmern, wer zusah.",
                                "zh": "她<w>忘我</w>地大笑，根本不在乎谁在看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unrestraint",
                        "unconstraint",
                        "wantonness"
                    ],
                    "common_phrases": [
                        "with abandon",
                        "with wild abandon",
                        "with reckless abandon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное отсутствие запретов или сдержанности; свободное поведение без беспокойства о последствиях.",
                        "de": "Ein völliges Fehlen von Hemmungen oder Zurückhaltung; der Zustand, frei zu handeln, ohne sich um Konsequenzen zu sorgen.",
                        "zh": "完全没有拘束或节制；自由自在、不顾后果的行为状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необузданность",
                                "target_lang_sense_clarification": "отсутствие контроля над собой, дикость"
                            },
                            {
                                "target_lang_word": "самозабвение",
                                "target_lang_sense_clarification": "состояние крайней увлеченности, забывая о себе"
                            },
                            {
                                "target_lang_word": "бесшабашность",
                                "target_lang_sense_clarification": "безрассудное, легкомысленное поведение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ungezwungenheit",
                                "target_lang_sense_clarification": "natürliches, freies Verhalten ohne Zwang"
                            },
                            {
                                "target_lang_word": "Hingabe",
                                "target_lang_sense_clarification": "leidenschaftliches, selbstvergessenes Handeln"
                            },
                            {
                                "target_lang_word": "Selbstvergessenheit",
                                "target_lang_sense_clarification": "Zustand, in dem man sich selbst und die Umgebung vergisst"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放纵",
                                "target_lang_sense_clarification": "不受约束，任由自己的行为"
                            },
                            {
                                "target_lang_word": "忘我",
                                "target_lang_sense_clarification": "极度投入，忘记了自我和周围环境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}