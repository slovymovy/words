                "senses": [
                    {
                        "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                        "entry_id": "8ee50dd6-bc59-30f9-8d86-73bc121a4714",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667203e2-c3f7-49c7-a438-9dd27f27effb",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Frau Feustle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "58b056ee-dab6-4bf7-8390-b6325153d13e",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Herr Feustle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "349a6208-613c-4ebc-8d0a-c06524bee7c9",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Die Feustles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "74548718-59e7-4def-8c9a-9ea4825fba4a",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Der Feustle trägt nie die Schals, die die Feustle ihm strickt."
                            },
                            {
                                "example_id": "55d43cf2-4ef7-4bbe-b682-475688153a27",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feustle kommt, geht der Herr Feustle.“"
                            },
                            {
                                "example_id": "83d6e8ac-b62a-4478-9201-2e0ec8ba2e3e",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Feustle kommt und geht."
                            },
                            {
                                "example_id": "3f7be72f-2f93-44f2-8a5c-196d2c0304f1",
                                "sense_id": "0f1e6dc5-bb49-3cbf-a5fc-2758c8b29bbd",
                                "text": "Feustles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
