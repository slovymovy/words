                                        "glosses": [
                                            "A common tumour of the central nervous system, occurring in the meninges, usually benign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364edf6c-63d5-4c30-be73-5968a51da38b",
                                                "sense_id": "1d993266-4f66-38af-aa1d-35a3b1c256da",
                                                "text": "Ellen Wright, 48, was operated on for five hours Tuesday to remove a benign meningioma tumour from the left side of her brain, after Clarke practised on her case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
