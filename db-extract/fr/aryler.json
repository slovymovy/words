                "senses": [
                    {
                        "sense_id": "ef80764c-67e0-35ba-9705-515de2fcce0d",
                        "entry_id": "84deeb29-fdf2-3c0b-acd9-f366f5c9cc92",
                        "glosses": [
                            "Introduire un radical aryle dans une molécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7a227d-fdc9-40ff-8f9b-3059d8bfc1f8",
                                "sense_id": "ef80764c-67e0-35ba-9705-515de2fcce0d",
                                "text": "Grâce au couplage de Heck, il est possible d’alcényler ou d’aryler des oléfines ne possédant pas d'atome d'hydrogène en position allylique, avec des résultats prévisibles, comme l’éthylène, les éthylènes substitués par des groupes électroattracteurs et des styrènes."
                            },
                            {
                                "example_id": "daca0f31-c762-4dd3-bdcf-cc9318e4379d",
                                "sense_id": "ef80764c-67e0-35ba-9705-515de2fcce0d",
                                "text": "Leurs équipes ont développé une méthodologie pour aryler des composés contenant une fonction OH ou NH (Schéma 63)."
                            }
                        ]
                    }
                ],
