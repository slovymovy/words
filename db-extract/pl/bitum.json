                "translations": [
                    {
                        "translation_id": "3bf40139-9a40-4009-ae9e-07b89ba014a4",
                        "source_entry_id": "a937e2fa-8e1a-3d84-a35d-e2215afc1992",
                        "source_sense_id": "d46ac3af-077a-3743-a72c-960b2686409c",
                        "target_lang_word": "blacktop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blacktop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5dbe4d-ff08-303f-81e9-5b47781aba50",
                                        "entry_id": "48c5dfc0-3b5d-37de-8af0-cbbca79156f8",
                                        "glosses": [
                                            "To pave with blacktop."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0457123-1c86-47fd-a7d8-871d11159a88",
                                                "sense_id": "4f5dbe4d-ff08-303f-81e9-5b47781aba50",
                                                "text": "The county first blacktopped that road decades ago"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blacktop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "214e2ff6-8477-36a3-9189-3e2fee8f6ef4",
                                        "entry_id": "4869fda5-e280-302c-a472-b89563904998",
                                        "glosses": [
                                            "Asphalt concrete or similar bituminous black paving material used for the surface of roads (e.g., tarmacadam, tarmac)."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f018086-5de6-42e7-8ca1-360783255a88",
                                                "sense_id": "214e2ff6-8477-36a3-9189-3e2fee8f6ef4",
                                                "text": "Then I was around the hill on the blacktop and in another country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5c4c87-0f61-39bc-bf19-ccf096e3b62d",
                                        "entry_id": "4869fda5-e280-302c-a472-b89563904998",
                                        "glosses": [
                                            "A road so paved."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "319198a6-2f15-3db1-9999-25db8e62f8e4",
                                        "entry_id": "4869fda5-e280-302c-a472-b89563904998",
                                        "glosses": [
                                            "A paved area on a schoolground reserved for recess activities, often doubling as a parking lot."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bcd425-6486-450a-abb2-845b927cdbad",
                                                "sense_id": "319198a6-2f15-3db1-9999-25db8e62f8e4",
                                                "text": "At one time, students were able to play basketball on the blacktop behind the school building, and teachers were also able to park on campus. Now, teachers park on the streets, and there is no place for students to let off steam with casual, non-organized sports before or after school."
                                            },
                                            {
                                                "example_id": "6e70dab2-e2e4-4501-ac4d-386213a8be6a",
                                                "sense_id": "319198a6-2f15-3db1-9999-25db8e62f8e4",
                                                "text": "From the dismissive receptionist in the main office to the lines on the school blacktop for dropping off and picking up children, schools often make parents feel that they must justify their presence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97a7e7db-e745-4303-a448-0f99d34d6b77",
                        "source_entry_id": "a937e2fa-8e1a-3d84-a35d-e2215afc1992",
                        "source_sense_id": "d46ac3af-077a-3743-a72c-960b2686409c",
                        "target_lang_word": "bitumen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitumen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe631bc-d6a2-3c38-a1d8-10755afb59c4",
                                        "entry_id": "215c6c8b-bc45-38e4-a040-ad20820f81b3",
                                        "glosses": [
                                            "A sticky, black, highly viscous liquid or semi-solid form of petroleum, burning with a bright flame. It occurs as an abundant natural product in many places, as on the shores of the Dead and Caspian Seas. It is used in cements, in the construction of pavements, etc.; Mineral pitch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d99bb2-fdda-40e7-839d-ebb8d22ffdcf",
                                                "sense_id": "9fe631bc-d6a2-3c38-a1d8-10755afb59c4",
                                                "text": "You need to excavate and remove the topsoil, line the subsoil with a geotextile, then lay and compact hardcore. Follow this with a layer of compacted \"hoggin\" – compacted clay, gravel and sand. This is then sprayed with hot bitumen, and has a layer of pea shingle rolled into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24645d9-f766-3007-ac0e-491c644b6c01",
                                        "entry_id": "215c6c8b-bc45-38e4-a040-ad20820f81b3",
                                        "glosses": [
                                            "Any one of the natural hydrocarbons, including the hard, solid, brittle varieties called asphalt, the semisolid maltha and mineral tars, the oily petrolea, and even the light, volatile naphthas."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d841aa0-aa6d-3e5a-852e-acdbfe187a40",
                                        "entry_id": "215c6c8b-bc45-38e4-a040-ad20820f81b3",
                                        "glosses": [
                                            "Roads sealed with bitumen, as opposed to dirt roads."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "903d34e2-8fbd-32a4-b558-dc2e8fa649b6",
                                        "entry_id": "215c6c8b-bc45-38e4-a040-ad20820f81b3",
                                        "glosses": [
                                            "Canadian deposits of extremely heavy crude oil."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bitumen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                        "entry_id": "9d8c54a3-446e-30b4-b9a0-b7d1a9c017fe",
                                        "glosses": [
                                            "To cover or fill with bitumen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a46f0a-376b-4d81-adce-eac8f633eaf3",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "another star reflected itself in the glassy black of the bitumened road"
                                            },
                                            {
                                                "example_id": "f2e94fe1-8d3c-422d-82ac-8b8f786f1a85",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "The Litlata community have now built a mandi set in a pleasant garden, and to ensure the cleanliness of their yardna have bricked and bitumened the pool into which the water flows"
                                            },
                                            {
                                                "example_id": "a78a72c1-e9ac-4632-ba01-fce615ee05c6",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "Work is already under way to complete the bitumening of Western Australia's last unsurfaced stretch of Highway One, between Fitzroy Crossing and Hall's Creek."
                                            },
                                            {
                                                "example_id": "7434ac10-1cba-44b2-87f7-86cdc501ee8a",
                                                "sense_id": "86f9860c-ce05-3d4d-bf3c-b5cce139c8f6",
                                                "text": "The development of water reticulation occurred in parallel with street work — forming, kerbing, channelling and bitumening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
