        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9b02611-0af6-3255-b4b1-a8402c1f4f8c",
                    "sense_definition": "The practice of making an investment or financial transaction to reduce the risk of adverse price movements in an asset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline used financial <w>hedging</w> against fuel costs to protect its budget.",
                            "target_lang_translations": {
                                "nl": "De luchtvaartmaatschappij gebruikte financiële <w>hedging</w> tegen brandstofkosten om haar budget te beschermen."
                            }
                        },
                        {
                            "text": "Modern <w>hedging</w> strategies can significantly reduce exposure to market volatility.",
                            "target_lang_translations": {
                                "nl": "Moderne <w>afdekkingsstrategieën</w> kunnen de blootstelling aan marktvolatiliteit aanzienlijk verminderen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hedging strategy",
                        "hedging against risk"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het doen van een investering of financiële transactie om het risico op ongunstige prijsbewegingen van een activum te verkleinen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hedging",
                                "target_lang_sense_clarification": "financiële term"
                            },
                            {
                                "target_lang_word": "indekking",
                                "target_lang_sense_clarification": "financiële bescherming tegen risico"
                            },
                            {
                                "target_lang_word": "afdekking",
                                "target_lang_sense_clarification": "risicoafdekking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2822785-21cb-3c20-96fc-9e532561a186",
                    "sense_definition": "The use of intentionally ambiguous, cautious, or noncommittal language to avoid committing to a definitive stance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician replied with constant <w>hedging</w> instead of giving a direct answer.",
                            "target_lang_translations": {
                                "nl": "De politicus antwoordde met voortdurend <w>ontwijkend gedrag</w> in plaats van een direct antwoord te geven."
                            }
                        },
                        {
                            "text": "Academic writing often uses careful <w>hedging</w> to avoid overstating research conclusions.",
                            "target_lang_translations": {
                                "nl": "In academisch schrijven wordt vaak voorzichtig <w>voorbehoud</w> gebruikt om te voorkomen dat onderzoeksconclusies worden overdreven."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivocation",
                        "prevarication"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het gebruik van opzettelijk dubbelzinnige, voorzichtige of ontwijkende taal om te vermijden een duidelijk standpunt in te nemen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omfloerst taalgebruik",
                                "target_lang_sense_clarification": "voorzichtig formuleren"
                            },
                            {
                                "target_lang_word": "ontwijkend gedrag",
                                "target_lang_sense_clarification": "vermijden van toezeggingen"
                            },
                            {
                                "target_lang_word": "het indekken",
                                "target_lang_sense_clarification": "voorbehoud maken"
                            }
                        ]
