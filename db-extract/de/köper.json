                    {
                        "sense_id": "9c9d487a-dc26-3045-9129-fdcbb464b89c",
                        "entry_id": "a7617d41-1f4e-35e6-89b3-94908b61e150",
                        "glosses": [
                            "Bindung, bei welcher der Schuss nur unter einem Kettfaden hindurch, danach über (mindestens) zwei Kettfäden hinweg geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed9b6f7-8b92-4859-a8a7-5ac177873653",
                                "sense_id": "9c9d487a-dc26-3045-9129-fdcbb464b89c",
                                "text": "„Die Bindung kann sich beim Köper jedoch auch erst nach mehr als drei Fäden in jede Richtung wiederholen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a60f14e7-5bbd-38b8-9596-43ab2efa4d29",
                        "entry_id": "a7617d41-1f4e-35e6-89b3-94908b61e150",
                        "glosses": [
                            "Stoff aus [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
