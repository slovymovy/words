{
    "word_family": [
        "incidental",
        "incidentally",
        "incidence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                    "sense_definition": "An event or occurrence, especially one that is unusual, unpleasant, or distinct.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "event_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived shortly after the <w>incident</w> was reported.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла вскоре после того, как сообщили о <w>происшествии</w>.",
                                "tr": "Polis, <w>olay</w> bildirildikten kısa bir süre sonra geldi."
                            }
                        },
                        {
                            "text": "The protest ended peacefully and without further <w>incident</w>.",
                            "target_lang_translations": {
                                "ru": "Протест завершился мирно и без дальнейших <w>происшествий</w>.",
                                "tr": "Protesto barışçıl bir şekilde ve başka bir <w>olay</w> yaşanmadan sona erdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "event",
                        "occurrence",
                        "happening",
                        "episode",
                        "affair"
                    ],
                    "common_phrases": [
                        "without incident",
                        "isolated incident",
                        "serious incident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или случай, особенно необычный, неприятный или заслуживающий внимания.",
                        "tr": "Özellikle olağandışı, hoşa gitmeyen veya dikkat çekici bir olay veya gelişme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происшествие",
                                "target_lang_sense_clarification": "событие, нарушающее обычный порядок"
                            },
                            {
                                "target_lang_word": "инцидент",
                                "target_lang_sense_clarification": "неприятный случай, недоразумение"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "отдельное событие или обстоятельство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olay",
                                "target_lang_sense_clarification": "meydana gelen durum veya gelişme"
                            },
                            {
                                "target_lang_word": "olay/hadise",
                                "target_lang_sense_clarification": "dikkat çeken ya da sıra dışı durum"
                            },
                            {
                                "target_lang_word": "vaka",
                                "target_lang_sense_clarification": "somut olarak gerçekleşen olay"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b82b526-1343-3ef8-b059-412188fa04c5",
                    "sense_definition": "An event that causes or may cause an interruption or a crisis, such as a workplace illness or a software error.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "event_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government wanted to avoid a diplomatic <w>incident</w> with the neighboring country.",
                            "target_lang_translations": {
                                "ru": "Правительство хотело избежать дипломатического <w>инцидента</w> с соседней страной.",
                                "tr": "Hükümet, komşu ülkeyle diplomatik bir <w>olay</w> yaşanmasını önlemek istedi."
                            }
                        },
                        {
                            "text": "We need to report this security <w>incident</w> to the IT department immediately.",
                            "target_lang_translations": {
                                "ru": "Нам нужно немедленно сообщить об этом <w>инциденте</w> безопасности в IT-отдел.",
                                "tr": "Bu güvenlik <w>olayını</w> derhal BT departmanına bildirmemiz gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "affair"
                    ],
                    "common_phrases": [
                        "international incident",
                        "diplomatic incident",
                        "security incident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, вызывающее сбой, конфликт или кризис (например, в дипломатии или IT).",
                        "tr": "Aksamaya, anlaşmazlığa veya krize neden olan ya da olabilecek durum (ör. diplomatik kriz veya güvenlik ihlali)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инцидент",
                                "target_lang_sense_clarification": "конфликтная ситуация или технический сбой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olay",
                                "target_lang_sense_clarification": "krize yol açan olumsuz gelişme"
                            },
                            {
                                "target_lang_word": "hadise",
                                "target_lang_sense_clarification": "gerginlik yaratan durum"
                            },
                            {
                                "target_lang_word": "pürüz",
                                "target_lang_sense_clarification": "aksamaya neden olan küçük sorun"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f69871da-50b7-384f-8547-286c1f3b5013",
                    "sense_definition": "Arising as the result of an event; inherent or naturally attaching to something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are many risks <w>incident</w> to the life of a firefighter.",
                            "target_lang_translations": {
                                "ru": "Существует много рисков, <w>свойственных</w> жизни пожарного.",
                                "tr": "Bir itfaiyecinin yaşamına <w>bağlı</w> birçok risk vardır."
                            }
                        },
                        {
                            "text": "He was prepared for the fatigue <w>incident</w> to the long journey.",
                            "target_lang_translations": {
                                "ru": "Он был готов к усталости, <w>свойственной</w> долгому путешествию.",
                                "tr": "Uzun yolculuğa <w>özgü</w> yorgunluğa hazırlıklıydı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incident to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присущий чему-либо, вытекающий из обстоятельств или являющийся естественным следствием.",
                        "tr": "Bir durumun sonucunda ortaya çıkan, bir şeye özgü olan veya doğal olarak bağlı bulunan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свойственный",
                                "target_lang_sense_clarification": "характерный для чего-либо, присущий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bağlı",
                                "target_lang_sense_clarification": "bir durumdan kaynaklanan veya ona eşlik eden"
                            },
                            {
                                "target_lang_word": "özgü",
                                "target_lang_sense_clarification": "bir niteliğe veya mesleğe doğasından ötürü ait olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812caf74-e342-31cf-aaff-8f4b4cded44d",
                    "sense_definition": "Falling on or striking a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>incident</w> light is reflected by the mirror.",
                            "target_lang_translations": {
                                "ru": "<w>Падающий</w> свет отражается зеркалом.",
                                "tr": "<w>Gelen</w> ışık ayna tarafından yansıtılır."
                            }
                        },
                        {
                            "text": "We calculated the angle of the <w>incident</w> ray.",
                            "target_lang_translations": {
                                "ru": "Мы вычислили угол <w>падающего</w> луча.",
                                "tr": "<w>Gelen</w> ışının açısını hesapladık."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incident light",
                        "incident ray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Падающий на поверхность или ударяющийся о неё (о свете, лучах, частицах).",
                        "tr": "Bir yüzeye çarpan veya bir yüzey üzerine düşen (ışık, ışın vb.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падающий",
                                "target_lang_sense_clarification": "направленный на поверхность (физика)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelen",
                                "target_lang_sense_clarification": "yüzeye çarpan veya ulaşan (ışın/ışık)"
                            },
                            {
                                "target_lang_word": "düşen",
                                "target_lang_sense_clarification": "yüzey üzerine yansıyan veya isabet eden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}