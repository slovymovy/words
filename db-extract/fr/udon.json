                    {
                        "sense_id": "72ca4771-47d3-3e33-9400-0abab5a5d7ba",
                        "entry_id": "499f3610-fdcb-3968-951c-44c48392d2a9",
                        "glosses": [
                            "Rivière de Normandie, affluent de l’Orne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea5a73b3-8529-40f3-84fd-2308e98b9de6",
                                "sense_id": "72ca4771-47d3-3e33-9400-0abab5a5d7ba",
                                "text": "C. B. ouvre ce week-end les portes de son moulin de la Folletière, à Joué-du-Plain. Au bord de l’Udon, depuis 40 ans, il en restaure les ouvrages avec passion."
                            }
                        ]
                    }
