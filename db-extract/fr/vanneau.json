                        "target_lang_word": "lapwing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapwing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "Any of several medium-sized wading birds belonging to the subfamily Vanellinae, within family Charadriidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac01722-3583-4c5b-96ec-5cf59f722021",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "Plovers and lapwings are a large, virtually worldwide family that differs from sandpipers in, among other things, having a shorter, thicker, pigeonlike bill and more robust proportions."
                                            },
                                            {
                                                "example_id": "be746146-5b92-488e-ac82-0d571d4192f7",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "The resident tropical plovers have much less pointed wings, and most of the lapwings have fairly rounded wing-tips, a wing shape apparently more adapted to aerial manoeuvrability than to long-distance migration."
                                            },
                                            {
                                                "example_id": "cdd60c97-3fcd-4fd9-86db-8c63fbf7299d",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "Lapwings are abundant winter visitors to the area but, like the Golden Plovers, vary greatly in number between years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95805823-772f-3e1c-94bb-d3047ae779aa",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "Any of several medium-sized wading birds belonging to the subfamily Vanellinae, within family Charadriidae.",
                                            "The northern lapwing (Vanellus vanellus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d769b315-98db-36ef-bccd-081dd9606dd4",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "A silly man."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b2086b-9745-46cc-8a5c-4784a08edfdb",
                                                "sense_id": "d769b315-98db-36ef-bccd-081dd9606dd4",
                                                "text": "This lapwing runs away with the shell on his head."
                                            }
                                        ]
