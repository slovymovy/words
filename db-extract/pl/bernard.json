                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d11f06c-ccc0-4f9b-b442-72346d38dcaf",
                        "source_entry_id": "bd17486d-a9c0-3e9a-9425-8f30160be7ce",
                        "source_sense_id": "9642803f-0d84-338b-ad02-5226d1a7b9ac",
                        "target_lang_word": "Bernard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bernard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d07ae859-8a05-3aff-a9f9-9e90451a5595",
                                        "entry_id": "ac50fa5c-bcdb-33cf-9469-125976884612",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041b0490-7273-42f3-b774-265aab2e4f4a",
                                                "sense_id": "d07ae859-8a05-3aff-a9f9-9e90451a5595",
                                                "text": "A similar arrangement was made for her son Bernard, named in honor of the great Carthusian mystic (at least, that is what Jim Gaffney would softly tell Mrs. Kozinski) and of Bernie Astor, the publicist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92646114-8f39-3fa1-bfe2-c0d8283629ff",
                                        "entry_id": "ac50fa5c-bcdb-33cf-9469-125976884612",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "074d6041-0ee4-4527-aa30-e4c5367d5cdc",
                        "source_entry_id": "bd17486d-a9c0-3e9a-9425-8f30160be7ce",
                        "source_sense_id": "9642803f-0d84-338b-ad02-5226d1a7b9ac",
                        "target_lang_word": "Bernard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bernard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8336032d-7c28-387a-b24a-76419b2923d0",
                                        "entry_id": "33f0b774-1b79-31a5-85e8-64e60a4c6f1d",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "882b26e4-e5f5-49b6-a0c0-0272b912ed80",
                                                "sense_id": "8336032d-7c28-387a-b24a-76419b2923d0",
                                                "text": "Camille Laurin, René Lévesque, Bernard Landry et Jacques Parizeau doivent se retourner dans leur tombe."
                                            },
                                            {
                                                "example_id": "11abdf02-82bd-4b15-8364-39ffcbdd25c6",
                                                "sense_id": "8336032d-7c28-387a-b24a-76419b2923d0",
                                                "text": "C’est autour de la côte de Domancy, en Haute-Savoie, celle qui avait sacré Bernard Hinault en 1980, que devraient se dérouler les épreuves."
                                            },
                                            {
                                                "example_id": "abb4b4c6-9544-41be-93d0-35988b49fe79",
                                                "sense_id": "8336032d-7c28-387a-b24a-76419b2923d0",
                                                "text": "Bernard Blier recevait un coup de poing dans la figure chaque fois qu’il ouvrait une porte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bernard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a0a1ed1-2104-3e42-9eaf-9ed69af1b6f7",
                                        "entry_id": "8ab4ea75-ffd0-30ce-b422-debac1b6adde",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67aef16c-2343-497f-8827-cd3f480e02e1",
                                                "sense_id": "2a0a1ed1-2104-3e42-9eaf-9ed69af1b6f7",
                                                "text": "« Mais, vous avez coupé tous ces arbres qui se portaient très bien », tempère Marie-Noëlle Bernard, du Groupe national de surveillance des arbres (GNSA)."
                                            },
                                            {
                                                "example_id": "95f41cc3-d474-4c4a-b116-eabce73bfa0c",
                                                "sense_id": "2a0a1ed1-2104-3e42-9eaf-9ed69af1b6f7",
                                                "text": "« Le Svalbard se réchauffe sept fois plus vite que le reste de la planète », indique la glaciologue Heïdi Sevestre, dans Demain, c’est nous (éd. du Faubourg), livre qui retrace l’aventure de François Bernard, dont elle est partie prenante depuis le début."
                                            },
                                            {
                                                "example_id": "44417db2-a724-4e7a-a973-49664e34797d",
                                                "sense_id": "2a0a1ed1-2104-3e42-9eaf-9ed69af1b6f7",
                                                "text": "La métropole de Lyon, dirigée par l’écologiste Bruno Bernard, s’apprête à tester la semaine de quatre jours sur la base du volontariat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bernard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "841457e6-ca49-3217-ac2e-459914f144cc",
                                        "entry_id": "dff0bf86-b371-31f1-8c65-723d16d3efc6",
