                ],
                "senses": [
                    {
                        "sense_id": "a8bf4d26-a2ea-3c97-9511-2a037c82f3b2",
                        "entry_id": "aba2cae2-ace2-38e5-9e6d-2915e7160aa2",
                        "glosses": [
                            "Appellation autrefois réservée aux seules huîtres matures élevées en parcs à Riec-sur-Bélon en Bretagne."
                        ],
                        "tags": [
                            "Ostréiculture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3258b438-e645-30b7-a77b-cb06ab04449b",
                        "entry_id": "aba2cae2-ace2-38e5-9e6d-2915e7160aa2",
                        "glosses": [
                            "Nom vulgaire de l’huître indigène sauvage sur tout le territoire français et qui est élevée depuis l’époque des Romains (Ostrea edulis)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2c115b2e-eca2-417a-a43b-4a81c0c98313",
                                "sense_id": "3258b438-e645-30b7-a77b-cb06ab04449b",
                                "text": "Il leur [trois négociants écaillers] est reproché d’intituler belons toutes les huîtres plates sans distinction, causant ainsi un préjudice à la production des parcs de Riec-sur-Bélon (Finistère)."
                            },
                            {
                                "example_id": "90263bdd-1a68-4d2e-bd8f-52232c38e2dc",
                                "sense_id": "3258b438-e645-30b7-a77b-cb06ab04449b",
                                "text": "Le terme « belon » qui, vers 1890, désignait encore des huîtres effectivement arrivées à maturité à l’embouchure de la rivière portant ce nom dans le Finistère, a fait l’objet d’un procès il y a quelques années à Paris."
                            }
                        ]
                    }
