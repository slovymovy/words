                        ]
                    },
                    {
                        "translation_id": "1d615021-5dd9-45cd-b841-edbae6a11eec",
                        "source_entry_id": "74474328-0f4c-3c34-8789-0fe3289358f3",
                        "source_sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                        "target_lang_word": "dislexia",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
