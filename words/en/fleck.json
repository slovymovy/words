                            },
                            {
                                "target_lang_word": "snipper",
                                "target_lang_sense_clarification": "klein afgescheurd stukje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88bc6236-d194-3d73-b46d-57aa10653c94",
                    "sense_definition": "A small tuft or lock of material like wool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small <w>flecks</w> of wool were caught on the rough wooden fence.",
                            "target_lang_translations": {
                                "cs": "Na drsném dřevěném plotě zůstaly zachycené malé <w>chomáčky</w> vlny.",
                                "nl": "Kleine <w>pluisjes</w> wol bleven hangen aan het ruwe houten hek."
                            }
                        },
                        {
                            "text": "The sweater left <w>flecks</w> of fiber all over the dark chair.",
                            "target_lang_translations": {
                                "cs": "Svetr zanechal na tmavé židli <w>vlákna</w>.",
                                "nl": "De trui liet overal op de donkere stoel <w>vezeltjes</w> achter."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý chomáček nebo vlákno materiálu, jako je vlna.",
                        "nl": "Een klein pluisje of vezel van materiaal zoals wol."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chomáček",
                                "target_lang_sense_clarification": "malý shluk vláken"
                            },
                            {
                                "target_lang_word": "vlákno",
                                "target_lang_sense_clarification": "jednotlivý kousek materiálu"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "pluisje",
                                "target_lang_sense_clarification": "klein bolletje losse vezels"
                            },
                            {
                                "target_lang_word": "vezeltje",
                                "target_lang_sense_clarification": "klein stukje draad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "806cd3ea-0be1-38b4-8b32-38938c823b5b",
                    "sense_definition": "To mark a surface with small spots or streaks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunlight <w>flecked</w> the forest floor through the dense leaves.",
                            "target_lang_translations": {
                                "cs": "Sluneční světlo <w>poselo</w> lesní půdu skrze husté listí.",
                                "nl": "Het zonlicht <w>bespikkelde</w> de bosbodem door de dichte bladeren heen."
                            }
                        },
                        {
                            "text": "The artist <w>flecked</w> the canvas with bright yellow paint.",
                            "target_lang_translations": {
                                "cs": "Umělec <w>pokropil</w> plátno jasně žlutou barvou.",
                                "nl": "De kunstenaar <w>bespikkelde</w> het doek met felgele verf."
                            }
                        }
                    ],
                    "synonyms": [
                        "speckle",
                        "spot"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt povrch malými skvrnami nebo čarami.",
                        "nl": "Een oppervlak bedekken met kleine vlekjes of strepen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokropit",
                                "target_lang_sense_clarification": "vytvořit skvrny na povrchu"
                            },
                            {
                                "target_lang_word": "poset",
                                "target_lang_sense_clarification": "pokrýt povrch mnoha malými body"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bespikkelen",
                                "target_lang_sense_clarification": "iets met kleine vlekjes bedekken"
                            },
                            {
                                "target_lang_word": "spikkelen",
                                "target_lang_sense_clarification": "vlekjes aanbrengen"
                            }
                        ]
                    }
                }
            ]
        },
        {
