                "senses": [
                    {
                        "sense_id": "c626563c-8a2a-359d-a8ed-7c9839724e9c",
                        "entry_id": "5f2e6b48-3412-33ee-b87b-1d18f1c88345",
                        "glosses": [
                            "Autofahrerin, die ihr Auto an einer Stelle abstellt, an der es nicht erlaubt ist (beispielsweise im Parkverbot)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928a1af0-6ee4-4581-b62e-e2e9060eabdd",
                                "sense_id": "c626563c-8a2a-359d-a8ed-7c9839724e9c",
                                "text": "„Die Parkräume KG verlangte 254,70 Euro fürs Abschleppen, verriet Guse aber den Standort, bevor die Falschparkerin bezahlte: Ihre Tochter holte den Wagen ab, die Rechnung wurde nie beglichen.“"
                            },
                            {
                                "example_id": "5f11496e-90dc-43fb-ba52-850de540ba74",
                                "sense_id": "c626563c-8a2a-359d-a8ed-7c9839724e9c",
                                "text": "„Eine Falschparkerin aus Münster muss die Gebühren für das Buchen eines Abschleppwagens bezahlen, obwohl der gar nicht zum Einsatz kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
