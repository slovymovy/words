                    },
                    {
                        "sense_id": "94d68466-6256-31d2-a1d2-5b90825102a1",
                        "entry_id": "0f5d13d2-904f-3d7e-bcd6-4434af0e2a33",
                        "glosses": [
                            "Bild mit künstlerischem Anspruch, zu [1] gehörende Aufnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f9001d-cafa-4690-ac61-bf07106ba853",
                                "sense_id": "94d68466-6256-31d2-a1d2-5b90825102a1",
                                "text": "„Das Mobiliar war schlicht, aber man hatte erst kürzlich die Wände gestrichen, und an ihnen hingen expressive Poster mit Blumenmustern und ein halbes Dutzend Kunstfotografien, die an die berühmten Westküstenfotografen der Mitte des zwanzigsten Jahrhunderts erinnerten: Ansel Adams, Edward Weston, Imogen Cunningham.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
