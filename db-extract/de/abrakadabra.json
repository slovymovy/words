                        "form": "des Abrakadabras"
                    },
                    {
                        "form_id": "7e54faec-503f-4d8e-955f-64781d7a585c",
                        "entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Abrakadabra"
                    },
                    {
                        "form_id": "5838867e-a6ea-4ff1-8a0b-b9556f72855e",
                        "entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Abrakadabra"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                        "entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "glosses": [
                            "Zauberwort"
                        ],
                        "tags": [
                            "ohne Artikel"
                        ],
                        "examples": [
                            {
                                "example_id": "2d1bfb78-c3b3-46bd-8c82-16c9eb4aa250",
                                "sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                                "text": "Abrakadabra wird unter anderem auch als Zauberformel verwendet."
                            },
                            {
                                "example_id": "11be23e4-114f-4eb0-a28e-95407621949b",
                                "sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                                "text": "Abrakadabra, Simsalabim und dreimal schwarzer Kater!"
                            },
                            {
                                "example_id": "a82613f4-f6af-43c8-8a96-5907d5a90ffb",
                                "sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                                "text": "„Mit Abrakadabra Besteck zu zerbrechen, das gebe es nicht.“"
                            },
                            {
                                "example_id": "b185b09c-a877-42c2-b1b0-88e98ff1232e",
                                "sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                                "text": "„Aber ich weiß, dass ich jeden beneide, dem auf den knapp 45 Millionen Quadratkilometern Zauber und Abrakadabra begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "403cbf8c-1b8f-3a2c-bb2a-cf7927b7795e",
                        "entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "glosses": [
                            "sinnloses oder unverständliches Gerede"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "add2594d-67da-44c2-8743-7e30bb206d55",
                                "sense_id": "403cbf8c-1b8f-3a2c-bb2a-cf7927b7795e",
                                "text": "Das ist mir alles ein einziges Abrakadabra."
                            },
                            {
                                "example_id": "0d7a91db-973a-4374-80a8-0436570d662e",
                                "sense_id": "403cbf8c-1b8f-3a2c-bb2a-cf7927b7795e",
                                "text": "„Authentisch ist jedenfalls, daß sein Abrakadabra mit magischer Schnelligkeit um sich griff und ein Welt-Café nach dem andern aller kriegführenden Vaterländer eroberte.“"
                            },
                            {
                                "example_id": "78fd8918-cb4b-4e41-9ad3-f323777b93b9",
                                "sense_id": "403cbf8c-1b8f-3a2c-bb2a-cf7927b7795e",
                                "text": "„Man soll nicht zu große Ansprüche an Ärzte stellen, ist einer schlau, hat er bald das Abrakadabra der guten alten weisen Frauen begriffen, und an Stelle von roten Schutzbändchen und magischen Sprüchlein liefert er das Seinige.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba167b07-f15a-44eb-bb95-df408e76e47f",
                        "source_entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "source_sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                        "source_sense_description": "ohne Artikel: Zauberwort",
                        "target_lang_word": "abracadabra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abracadabra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81668783-05e0-3e49-bfd0-409ae1846a34",
                                        "entry_id": "7c1edf1c-8991-3028-8481-62b0d490a196",
                                        "glosses": [
                                            "A use of the mystical term ‘abracadabra’, supposed to work as part of a healing charm or a magical spell; any spell or incantation making use of the word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3526aa-a670-4007-aaf8-33598af7d1f4",
                                                "sense_id": "81668783-05e0-3e49-bfd0-409ae1846a34",
                                                "text": "Where is the necessity of this provision in the Constitution? […] Can anyone believe that we, by any amendments of ours, by any of our scribbling on that parchment, by any amulet, any legerdemain—charm—Abrecadabra—of ours can prevent our sons from doing the same thing—that is, from doing as they please, just as we are doing as we please? It is impossible. Who can bind posterity?"
                                            },
                                            {
                                                "example_id": "1881a958-7b91-479a-8606-d8865a4cb8f0",
                                                "sense_id": "81668783-05e0-3e49-bfd0-409ae1846a34",
                                                "text": "With a quiet bank holiday afternoon to fill, the Mill yesterday dug out the old magic kit, brushed the cobwebs off its top hat and practiced a few abracadabras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c00e59e-22b0-3f35-9cc3-b0be344456d9",
                                        "entry_id": "7c1edf1c-8991-3028-8481-62b0d490a196",
                                        "glosses": [
                                            "Mumbo jumbo; obscure language or technicalities; jargon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21d0dd7-593d-4c49-87eb-2b7aaf31e5bc",
                                                "sense_id": "7c00e59e-22b0-3f35-9cc3-b0be344456d9",
                                                "text": "I don’t know all the theoretical abracadabra about how it works, I’m only its pilot."
                                            },
                                            {
                                                "example_id": "d24c4886-7722-4523-bbe7-8bde815b0bbe",
                                                "sense_id": "7c00e59e-22b0-3f35-9cc3-b0be344456d9",
                                                "text": "Astrology was not specifically banned in the statutes against witchcraft, but so long as its technicalities remained abracadabra to the lay public there was always a risk that the practitioner might find himself arrested for sorcery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abracadabra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "471b0569-9bea-3a72-9728-4f285a17707e",
                                        "entry_id": "4731368c-4105-3506-a55e-2ce6d8695fe2",
                                        "glosses": [
                                            "Used to indicate that a magic trick or other illusion has been performed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fab1eaa-41e5-479b-8c6d-93cf1c127aec",
                                                "sense_id": "471b0569-9bea-3a72-9728-4f285a17707e",
                                                "text": "Next, the conjuror filled a glass with water from a big jug and then covered the tumbler with a cloth. \"Abracadabra,\" he cried and crumpled the cloth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75c450cf-afc7-4670-8b25-1f2a84abea83",
                        "source_entry_id": "ed91d7f0-fdee-317d-8e0d-af858764c0e8",
                        "source_sense_id": "074a9b0f-ea68-36c2-b372-9aadde0ae5c9",
                        "source_sense_description": "ohne Artikel: Zauberwort",
                        "target_lang_word": "abracadabra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abracadabra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57857277-9615-3ad1-b10f-7bfe32ddf741",
                                        "entry_id": "3976a458-dcfb-32e4-a24b-f856ddd2d2af",
                                        "glosses": [
                                            "Mot auquel on attribuait anciennement des vertus magiques, et qui, disait-on, guérissait la fièvre, lorsqu’on le portait inscrit sur une amulette autour du cou, écrit dans une certaine forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752027f2-a703-4762-9867-027e149fd30e",
                                                "sense_id": "57857277-9615-3ad1-b10f-7bfe32ddf741",
                                                "text": "— Parfois, répliqua Sigognac, tous les enchantements sont vains et l’ennemi pénètre en la place malgré les phylactères, les tétragrammes et les abracadabras."
                                            },
                                            {
                                                "example_id": "aac4c818-fc74-4b89-99d7-1301f2b9a739",
                                                "sense_id": "57857277-9615-3ad1-b10f-7bfe32ddf741",
                                                "text": "Alors Geta débita les abracadabras adéquats. Il se trouve qu’une forte averse survint presque aussitôt."
                                            },
                                            {
                                                "example_id": "59ef7b0a-2d6d-4332-b29d-943782e2a81e",
                                                "sense_id": "57857277-9615-3ad1-b10f-7bfe32ddf741",
                                                "text": "Or, en dépit des grands mots agités par les maîtres de nos vies, chacun sent que la tranquillité publique n’est nullement garantie par l’abracadabra magique, tour à tour répété par chacun de nos gouvernements, depuis 1924 : […]."
                                            },
                                            {
                                                "example_id": "51555fc5-1e18-4f2f-840b-a93453f5cc95",
                                                "sense_id": "57857277-9615-3ad1-b10f-7bfe32ddf741",
                                                "text": "Si, la boite de Pandore renfermait tous les maux de l’humanité, l’ensemble de ces abracadabras contient toutes les sottises de l’ignorance ; et, l’ignorance est la source même de ces maux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f2922f-fcf4-3662-9254-c337e7d3416f",
                                        "entry_id": "3976a458-dcfb-32e4-a24b-f856ddd2d2af",
                                        "glosses": [
                                            "Énoncé surprenant, incompréhensible, inexplicable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3264a286-866f-44a8-a5bc-06fa75ac6ca0",
                                                "sense_id": "e6f2922f-fcf4-3662-9254-c337e7d3416f",
                                                "text": "L’histoire du corbeau et du renard me sera longtemps opaque. Que fait au juste cet archevêque dans l’arbre du corbeau ? « Il ouvre un archevêque », c’est l’abracadabra que j’entends, et j’ai beau tenter de restituer un peu de cohérence à l’affaire en imaginant qu’il laisse tomber sa « croix », l’histoire me paraîtra obscure jusqu’au jour où le texte écrit me sera – enfin – une illumination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abracadabra",
                                "target_lang_code": "fr",
                                "target_senses": [
