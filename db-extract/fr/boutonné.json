                    },
                    {
                        "form_id": "cf750e04-3127-4a9c-b036-1c4dbaee1930",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "boutonnées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ade0fb8f-cf58-3906-870b-6bc1c8f3aa21",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Fermé au moyen de boutons."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "6dd6e8ba-38aa-4650-888b-eb56efcd2881",
                                "sense_id": "ade0fb8f-cf58-3906-870b-6bc1c8f3aa21",
                                "text": "Un tricot brun mal boutonné s’ouvrait sur sa poitrine."
                            },
                            {
                                "example_id": "76091cdf-f686-4016-aea6-bfb6b1f3990d",
                                "sense_id": "ade0fb8f-cf58-3906-870b-6bc1c8f3aa21",
                                "text": "Toutes les fois qu’elle se penchait sur la table, son corsage, boutonné très bas, montrait le flanc nu d’un sein de fillette…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ceea6b-9fc9-3c7e-9eb9-d86527ff4b75",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Dont le vêtement est fermé au moyen de boutons."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "487b6207-e520-4e75-ad1b-c7926398b609",
                                "sense_id": "e1ceea6b-9fc9-3c7e-9eb9-d86527ff4b75",
                                "text": "Il était poudré, ganté, brossé, boutonné ; son habit bleu clair ne faisait pas un pli."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9f73905-81ea-354a-a7f4-f35981e76fcb",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Convenable, correct."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd9be8d-d347-439a-a1ad-0101fbbca31c",
                                "sense_id": "e9f73905-81ea-354a-a7f4-f35981e76fcb",
                                "text": "Autant je suis débraillé dans mes autres livres, autant dans celui-ci je tâche d’être boutonné et de suivre une ligne droite géométrique."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c10c3b8-a8a4-3e03-b308-64b6a78060f1",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Renfermé, secret."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "136b27c5-1145-4bfd-853d-4afc99ff12a4",
                                "sense_id": "3c10c3b8-a8a4-3e03-b308-64b6a78060f1",
                                "text": "D’une nature peu expansive bien que sensible au fond, il passe pour être très boutonné."
                            }
                        ]
                    },
                    {
                        "sense_id": "a278d56c-a2af-3239-b6ad-6141ef0889e8",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Qualifie une fleur à bouton d’un autre émail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a83bf0e-9e93-4c62-a19a-31dd416a3e9d",
                                "sense_id": "a278d56c-a2af-3239-b6ad-6141ef0889e8",
                                "text": "La rose se dit boutonnée lorsque son cœur n'est pas du même émail que la fleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c3bf278-00e3-3b1a-88fa-f666296e7ef4",
                        "entry_id": "7426a8c6-c5b6-3e32-9c3c-43d66608248b",
                        "glosses": [
                            "Qualifie un fleuret dont l’extrémité est pourvue d’un bouton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ddcdad-e01d-4849-87c7-41bf2c046d28",
                                "sense_id": "4c3bf278-00e3-3b1a-88fa-f666296e7ef4",
                                "text": "Mais autre chose est un assaut courtois avec un fleuret boutonné, une poitrine garantie par un plastron et le visage caché sous un masque ; autre chose est un duel, l’épée nue à la main et les yeux dans les yeux d’un ennemi qui en veut à votre vie."
                            }
                        ]
                    }
                ],
