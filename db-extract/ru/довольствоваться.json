                "senses": [
                    {
                        "sense_id": "a9847b25-4c5b-3659-9d3b-9300478fd12d",
                        "entry_id": "48d1cead-76eb-3f0b-ae68-438375f4dc1e",
                        "glosses": [
                            "удовлетворяться, быть довольным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3b0469-a4a3-47bb-8f70-859ce5de8d24",
                                "sense_id": "a9847b25-4c5b-3659-9d3b-9300478fd12d",
                                "text": "Мы довольствовались тем, что видели наши глаза и слышали наши уши."
                            },
                            {
                                "example_id": "a6e02bf6-ddd2-4ad0-9d7e-5c40287338a3",
                                "sense_id": "a9847b25-4c5b-3659-9d3b-9300478fd12d",
                                "text": "Но ум не может довольствоваться одними игрушками гармонии, воображение требует картин и рассказов."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc144ea-47c2-3f71-8a3e-830cfd1cc2fb",
                        "entry_id": "48d1cead-76eb-3f0b-ae68-438375f4dc1e",
                        "glosses": [
                            "воен. быть на довольствии, снабжаться (продуктами питания, обмундированием и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d268c2b6-c67e-4591-9f42-d4edb77e2246",
                                "sense_id": "5cc144ea-47c2-3f71-8a3e-830cfd1cc2fb",
                                "text": "Жалованье получали одни яицкие казаки; прочие довольствовались грабежом."
                            }
                        ]
                    }
                ],
