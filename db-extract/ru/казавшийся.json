                        "sense_id": "39f08f55-dab7-3299-915d-4f16119e4f6a",
                        "entry_id": "24240bb2-4f40-3bae-9c16-40c6d977260a",
                        "glosses": [
                            "действ. прич. прош. вр. от казаться"
