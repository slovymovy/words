{
    "word_family": [
        "gisting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                    "sense_definition": "The main idea, substance, or most essential part of a longer or more complicated matter.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "core_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't want to go into too much detail, but I am sure you get the <w>gist</w> of what I am saying.",
                            "target_lang_translations": {
                                "ru": "Я не хочу вдаваться в подробности, но уверен, что вы уловили <w>суть</w> моих слов."
                            }
                        },
                        {
                            "text": "Although she missed the first half of the lecture, she managed to catch the <w>gist</w> of the presentation.",
                            "target_lang_translations": {
                                "ru": "Хотя она пропустила первую половину лекции, ей удалось уловить <w>смысл</w> презентации."
                            }
                        }
                    ],
                    "synonyms": [
                        "essence",
                        "core",
                        "crux",
                        "drift",
                        "substance",
                        "tenor"
                    ],
                    "common_phrases": [
                        "get the gist",
                        "gist of the matter",
                        "catch the gist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная идея, суть или наиболее важная часть какого-либо длинного или сложного вопроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суть",
                                "target_lang_sense_clarification": "самое существенное и основополагающее в чём-либо"
                            },
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "основное содержание, суть дела"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "главное, существенное в чём-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76a11171-3037-3c1c-b72e-d3ef0a1d503e",
                    "sense_definition": "A sharable snippet of source code, especially on the version-controlled pastebin-hosting site GitHub Gist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "software_code",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you want to see how the function works, take a look at this <w>gist</w> I uploaded.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите посмотреть, как работает функция, взгляните на этот <w>гист</w>, который я загрузил."
                            }
                        },
                        {
                            "text": "He shared a quick <w>gist</w> containing the configuration file for the server.",
                            "target_lang_translations": {
                                "ru": "Он поделился быстрым <w>гистом</w> с конфигурационным файлом для сервера."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon used among programmers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрагмент исходного кода, которым можно поделиться, особенно на сервисе GitHub Gist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гист",
                                "target_lang_sense_clarification": "фрагмент кода на GitHub Gist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06cf77de-d1fa-3c68-a5ee-5ef195fc870b",
                    "sense_definition": "Gossip or rumour; an instance of this.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire afternoon sharing the latest <w>gist</w> about their neighbors.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, делясь последними <w>сплетнями</w> о своих соседях."
                            }
                        },
                        {
                            "text": "I don't believe that rumor; it is just some harmless <w>gist</w> going around the office.",
                            "target_lang_translations": {
                                "ru": "Я не верю этим слухам; это просто безобидные <w>сплетни</w>, ходящие по офису."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплетни, слухи или их обсуждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетни",
                                "target_lang_sense_clarification": "слухи и разговоры о чужой жизни"
                            },
                            {
                                "target_lang_word": "слухи",
                                "target_lang_sense_clarification": "непроверенная информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                    "sense_definition": "The essential ground for action in a lawsuit, without which there is no cause of action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_grounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gist</w> of the indictment rested entirely on the defendant's fraudulent intent.",
                            "target_lang_translations": {
                                "ru": "Вся <w>суть</w> обвинения строилась исключительно на мошенническом умысле подсудимого."
                            }
                        },
                        {
                            "text": "Without proving actual damage, the plaintiff lacked the very <w>gist</w> of the action.",
                            "target_lang_translations": {
                                "ru": "Без доказательства реального ущерба у истца отсутствовало само <w>основание</w> для иска."
                            }
                        }
                    ],
                    "synonyms": [
                        "gravamen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существенное основание для иска в судебном процессе, без которого иск не может быть предъявлен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суть иска",
                                "target_lang_sense_clarification": "основное юридическое основание для судебного дела"
                            },
                            {
                                "target_lang_word": "основание иска",
                                "target_lang_sense_clarification": "юридическая основа судебного процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7aa04e0-000a-3f89-889b-259e8d109c82",
                    "sense_definition": "A stop for lodging or rest in a journey, or the place where this happens.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lodging_stop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers made their fourth <w>gist</w> at a small, quiet village along the river.",
                            "target_lang_translations": {
                                "ru": "Путешественники сделали свой четвертый <w>привал</w> в небольшой тихой деревушке у реки."
                            }
                        },
                        {
                            "text": "These migratory birds have established <w>gists</w> where they rest during their long flight.",
                            "target_lang_translations": {
                                "ru": "Эти перелетные птицы определили места для <w>отдыха</w>, где они восстанавливают силы во время долгого перелета."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановка для ночлега или отдыха во время путешествия, либо место, где это происходит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привал",
                                "target_lang_sense_clarification": "остановка в пути для отдыха"
                            },
                            {
                                "target_lang_word": "место отдыха",
                                "target_lang_sense_clarification": "место для ночлега или остановки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb5b02a6-7eb7-3472-81c3-f97aaa14b017",
                    "sense_definition": "Initialism of gastrointestinal stromal tumor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oncologist explained that a <w>GIST</w> is a rare type of tumor found in the digestive tract.",
                            "target_lang_translations": {
                                "ru": "Онколог объяснил, что <w>ГИСО</w> — это редкий тип опухоли, встречающийся в пищеварительном тракте."
                            }
                        },
                        {
                            "text": "Recent advancements have significantly improved the targeted therapy options for patients diagnosed with <w>GIST</w>.",
                            "target_lang_translations": {
                                "ru": "Последние достижения значительно улучшили варианты таргетной терапии для пациентов с диагнозом <w>ГИСО</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для гастроинтестинальной стромальной опухоли (ГИСО)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ГИСО",
                                "target_lang_sense_clarification": "гастроинтестинальная стромальная опухоль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97fd2150-2509-39ce-9712-07c5151df190",
                    "sense_definition": "To extract and present the main ideas or substance of a document or piece of writing; to summarize.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "summarizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assistant was asked to <w>gist</w> the lengthy report into a single-page brief.",
                            "target_lang_translations": {
                                "ru": "Помощника попросили <w>резюмировать</w> длинный отчет в одностраничный документ."
                            }
                        },
                        {
                            "text": "She spent the morning <w>gisting</w> the legal documents for the senior partners.",
                            "target_lang_translations": {
                                "ru": "Она провела утро, <w>составляя краткое изложение</w> юридических документов для старших партнеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "condense",
                        "précis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять и излагать основные идеи или суть документа; резюмировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "кратко излагать суть"
                            },
                            {
                                "target_lang_word": "конспектировать",
                                "target_lang_sense_clarification": "кратко записывать основное содержание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f21331c5-80d3-3134-8528-87c0db132100",
                    "sense_definition": "To talk idly, chat, or gossip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gossiping_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They would sit on the porch for hours, <w>gisting</w> about the local news.",
                            "target_lang_translations": {
                                "ru": "Они часами сидели на крыльце, <w>сплетничая</w> о местных новостях."
                            }
                        },
                        {
                            "text": "Instead of working, the employees stood by the water cooler <w>gisting</w> about their weekend plans.",
                            "target_lang_translations": {
                                "ru": "Вместо работы сотрудники стояли у кулера с водой, <w>болтая</w> о своих планах на выходные."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болтать, вести праздные разговоры или сплетничать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетничать",
                                "target_lang_sense_clarification": "обсуждать слухи и чужую жизнь"
                            },
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "вести праздные разговоры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}