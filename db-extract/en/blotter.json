                    },
                    {
                        "sense_id": "05f82424-b533-34dc-ba49-ea05b35ab64f",
                        "entry_id": "0557f5b8-8bfd-3373-bcf0-a80c158b486a",
                        "glosses": [
                            "A daily register of arrests and other events in a police station."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                        "entry_id": "0557f5b8-8bfd-3373-bcf0-a80c158b486a",
                        "glosses": [
                            "A register of the related events made in the form of the list of times and brief descriptions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d702f20-2878-48da-9746-825149950eb1",
                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                "text": "All transactions were entered in the cash blotter and agent's subsidiary ledger."
                            },
                            {
                                "example_id": "775e23d5-00a3-4f47-bf74-822dee3076e9",
                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                "text": "He maintains the political blotter blog."
                            },
                            {
                                "example_id": "650b1790-74a8-4984-b75b-19172dd22d75",
                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                "text": "\"The blotter was so full of his scribbling, it was getting harder and harder to find places to write in.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "331ba65f-0146-39c1-8a6c-a6e47f6661c8",
                        "entry_id": "0557f5b8-8bfd-3373-bcf0-a80c158b486a",
                        "glosses": [
                            "A portion of blotter acid."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7b3c0031-883e-46c1-a35b-e2d5896e5ad6",
                                "sense_id": "331ba65f-0146-39c1-8a6c-a6e47f6661c8",
                                "text": "Glass bottles of liquid LSD; moist blocks of Manali charras and Malana cream; sachets of smack; a hundred caps of MDMA and a phial of Australian DMT; ampoules of medical morphine and a dense pad of four thousand Californian blotters."
                            }
                        ]
                    }
