    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e741d983-26e1-3a30-9181-ab168ad5c8fb",
                    "sense_definition": "Having a pattern of squares of different colors.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a red and white <w>checked</w> shirt to the picnic.",
                            "target_lang_translations": {
                                "ru": "На пикник он надел красно-белую <w>клетчатую</w> рубашку."
                            }
                        },
                        {
                            "text": "The kitchen table was covered with a blue <w>checked</w> tablecloth.",
                            "target_lang_translations": {
                                "ru": "Кухонный стол был накрыт синей скатертью <w>в клетку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "checkered",
                        "chequered"
                    ],
                    "common_phrases": [
                        "checked shirt",
                        "checked pattern",
                        "checked tablecloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий узор из квадратов разных цветов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клетчатый",
                                "target_lang_sense_clarification": "об узоре ткани или поверхности"
                            },
                            {
                                "target_lang_word": "в клетку",
                                "target_lang_sense_clarification": "о рисунке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c80f04e-801b-33c0-b7cc-d515aac1681b",
                    "sense_definition": "Handed over to be stored in the hold of a plane, train, or ship during travel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline lost my <w>checked</w> luggage on the flight to Paris.",
                            "target_lang_translations": {
                                "ru": "Авиакомпания потеряла мой <w>зарегистрированный</w> багаж на рейсе в Париж."
                            }
                        },
                        {
                            "text": "You must pay an extra fee for each <w>checked</w> bag.",
                            "target_lang_translations": {
                                "ru": "Вы должны заплатить дополнительный сбор за каждую <w>сданную в багаж</w> сумку."
                            }
                        }
                    ],
                    "antonyms": [
                        "carry-on"
                    ],
                    "common_phrases": [
                        "checked luggage",
                        "checked baggage",
                        "checked bag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сданный для хранения в багажное отделение самолета, поезда или корабля во время поездки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарегистрированный",
                                "target_lang_sense_clarification": "о багаже"
                            },
                            {
                                "target_lang_word": "сданный в багаж",
                                "target_lang_sense_clarification": "о вещах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb126061-7912-393d-91ce-1b22e922f731",
                    "sense_definition": "Having been examined to ensure accuracy, safety, or quality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer provided a <w>checked</w> report to the manager.",
                            "target_lang_translations": {
                                "ru": "Инженер предоставил менеджеру <w>проверенный</w> отчет."
                            }
                        },
                        {
                            "text": "Always use <w>checked</w> data when performing these complex calculations.",
                            "target_lang_translations": {
                                "ru": "Всегда используйте <w>выверенные</w> данные при выполнении этих сложных расчетов."
                            }
                        }
                    ],
                    "synonyms": [
                        "verified",
                        "validated",
                        "confirmed"
                    ],
                    "antonyms": [
                        "carry-on"
                    ],
                    "common_phrases": [
                        "checked arithmetic",
                        "checked data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проверенный на предмет точности, безопасности или качества."
