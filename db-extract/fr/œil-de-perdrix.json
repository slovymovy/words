                "senses": [
                    {
                        "sense_id": "3afde526-a40b-3161-b216-82e686cbe60f",
                        "entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "glosses": [
                            "Sorte de cor qui survient entre les doigts des pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c33cc5-b38d-4772-9625-0ab95ce1be09",
                                "sense_id": "3afde526-a40b-3161-b216-82e686cbe60f",
                                "text": "Non seulement elles ont des cors\nDes œils-de-perdrix mais encore\nC'est fou ce qu'elles usent de grolles"
                            }
                        ]
                    },
                    {
                        "sense_id": "92b68128-94e3-35de-add1-f68b00997930",
                        "entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "glosses": [
                            "Point plus sombre qui apparaît au milieu d’un nœud d’une pièce de bois de la charpente d’un navire, c’est un signe de début de pourriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f282f745-d152-4c86-9474-a57d5e871b1e",
                                "sense_id": "92b68128-94e3-35de-add1-f68b00997930",
                                "text": "C’est ce qui constitue l’œil-de-perdrix, et c’est un indice presque certain qu’il existe au dessous un foyer de pourriture, que l’on appelle hupe."
                            }
                        ]
                    },
                    {
                        "sense_id": "b316dcd2-5955-3630-8be1-d8dfb6bf28b2",
                        "entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "glosses": [
                            "Vin rosé suisse d’origine neuchâteloise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fdcebb-4635-472f-b70b-064f888304ea",
                                "sense_id": "b316dcd2-5955-3630-8be1-d8dfb6bf28b2",
                                "text": "Un soir, nous nous rendons en Suisse et Marcel Prêtre m’initie aux vins de son pays, il me fait découvrir le fendant, l’aigle, le dézaley, l’yvorne, le pinot noir, la dole blanche, l’œil-de-perdrix, et quelques autres encore."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ac3b5e7-3453-3673-8dbd-32c378e8dd0f",
                        "entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "glosses": [
                            "Type particulier de pierre meulière que l'on trouve, entre autre à Domme en Dordogne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a8798d-589a-4aed-a250-e4bbd5a8023d",
                                "sense_id": "0ac3b5e7-3453-3673-8dbd-32c378e8dd0f",
                                "text": "Je sus bientôt picher une meule, et connaître la pierre à œil de perdrix, qui fait les meules bonnes pour le seigle, et la pierre à fusil qui vaut mieux pour le froment."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7f06c55-1ae1-3c1f-aaed-fb9ffca2836e",
                        "entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "glosses": [
                            "Toile damassée avec des petits motifs en cercle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6efc193f-4b1f-43e3-8841-0933b0da8403",
                        "source_entry_id": "746089ed-24aa-3f89-bb44-d93350abf8db",
                        "target_lang_word": "Hühnerauge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hühnerauge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                        "entry_id": "5a50fc2f-ecc2-3f68-a4eb-c3ccafbefbd7",
                                        "glosses": [
                                            "schmerzhafte kegelförmige Schwiele, besonders an den Zehen auftretende Hautverdickung"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155d83c4-c523-49d8-8edc-7afa429b332c",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "Zu enge Schuhe können zu Hühneraugen führen."
                                            },
                                            {
                                                "example_id": "12008669-1299-4401-8cf2-cb7a31d54ee5",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "„So sind die Menschen. Die einen gehen zugrunde an einem Hühnerauge, die anderen kann man mit Keulen nicht totschlagen, und die meisten sterben, weil sie nicht leben wollen.“"
                                            },
                                            {
                                                "example_id": "2fe99df9-257e-4e91-bdbc-58aabfd5d2fd",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "„Die Hühneraugen benehmen sich in den Schuhen, die sich Mutter für ihre Stadtfahrt übergezwängt hat, besonders rebellisch.“"
                                            },
                                            {
                                                "example_id": "65fd3a0b-9481-4384-96dd-de64ee04bf2e",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "Hühnerauge - klingt harmlos, trotzdem sind die Hornschwielen am Fuß ausgesprochen störend bis schmerzhaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "745082bd-2029-4626-a6ed-c01ef908691e",
