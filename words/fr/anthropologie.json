    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6daa8ce3-fe80-36c1-9c43-22e4f91147d3",
                    "sense_definition": "Ensemble des disciplines scientifiques qui étudient l'être humain dans ses dimensions biologiques, historiques et culturelles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ses études d'histoire, elle a choisi de se spécialiser en <w>anthropologie</w> à l'université."
                        },
                        {
                            "text": "Cette recherche interdisciplinaire associe la sociologie, la biologie et l'<w>anthropologie</w> contemporaine."
                        }
                    ],
                    "common_phrases": [
                        "anthropologie générale",
                        "cours d'anthropologie",
                        "département d'anthropologie"
                    ]
                },
                {
                    "sense_id": "eef8c539-1043-3024-ba4d-be50122e9f62",
                    "sense_definition": "Discipline qui étudie la diversité culturelle, les coutumes, les croyances et les structures sociales des groupes humains.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>anthropologie</w> culturelle permet de mieux comprendre les rituels complexes de ce peuple."
                        },
                        {
                            "text": "Ce chercheur consacre ses travaux à l'<w>anthropologie</w> des sociétés traditionnelles d'Afrique."
                        }
                    ],
                    "synonyms": [
                        "ethnologie"
                    ],
                    "common_phrases": [
                        "anthropologie culturelle",
                        "anthropologie sociale",
                        "anthropologie structurale"
                    ]
                },
                {
                    "sense_id": "0aad2e17-4add-3079-98dc-8fc4aff1a61a",
                    "sense_definition": "Discipline qui étudie l'anatomie, la morphologie et l'évolution biologique de l'espèce humaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>anthropologie</w> médico-légale aide souvent à identifier les restes de victimes inconnues."
                        },
                        {
                            "text": "Ses travaux en <w>anthropologie</w> physique portent sur les fossiles des premiers hominidés découverts."
                        }
                    ],
                    "common_phrases": [
                        "anthropologie biologique",
                        "anthropologie médico-légale",
                        "anthropologie physique"
                    ]
                },
                {
                    "sense_id": "860fe246-7d46-3a0c-bd4d-304e3452a329",
                    "sense_definition": "Conception philosophique ou doctrine religieuse relative à l'origine, au sens et à la nature de l'humain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>anthropologie</w> chrétienne repose sur l'idée que l'humain est créé à l'image divine."
                        },
                        {
                            "text": "Ce penseur développe une <w>anthropologie</w> nouvelle fondée sur la liberté absolue de l'esprit."
                        }
                    ],
                    "common_phrases": [
                        "anthropologie chrétienne",
                        "anthropologie philosophique",
                        "anthropologie théologique"
                    ]
                }
            ]
        }
    ]
