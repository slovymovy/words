                        "target_lang_word": "moutarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moutarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6583f728-ca2b-3303-b98c-461ad68f4065",
                                        "entry_id": "591e27ee-dfe7-3bc8-bd4f-4cfaa60e78c5",
                                        "glosses": [
                                            "Plante de la famille des Brassicacées (ou Crucifères) à fleurs jaunes dont certaines espèces sont cultivées pour le fourrage et d'autres pour les graines, ingrédient de base de condiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4babd9dc-f9fe-4e1b-ac50-8716a2331d87",
                                                "sense_id": "6583f728-ca2b-3303-b98c-461ad68f4065",
                                                "text": "— Je suis congestionné. J’ai le sang à la tête. Préparez-moi un bain de pieds à la moutarde…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178926e3-2c96-32c8-a591-100f28a393c1",
                                        "entry_id": "591e27ee-dfe7-3bc8-bd4f-4cfaa60e78c5",
                                        "glosses": [
                                            "Condiment préparé à partir de graines de moutarde broyées dans du vinaigre."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7932841-d5d1-44d9-af64-4addce75ecba",
                                                "sense_id": "178926e3-2c96-32c8-a591-100f28a393c1",
                                                "text": "Il en est de même des moutardes douces (type Savora), des sauces vinaigrées d’origine anglaise (pickles, chutney) et de la Worcestershire sauce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moutarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2cc77a-93ff-374c-880c-4cb81dc30988",
                                        "entry_id": "04263c8e-ca5c-3519-9599-69595941694d",
                                        "glosses": [
                                            "D’une couleur jaune soutenu très légèrement verdâtre. #C7CF00"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a983f6-8a06-4e5e-a0ea-00c9e7b5a672",
                                                "sense_id": "ab2cc77a-93ff-374c-880c-4cb81dc30988",
                                                "text": "Même avec la fenêtre ouverte, l’odeur de la pompeuse table de nuit, au dessus de marbre rouge, emplissait la pièce. Un tapis à fond moutarde recouvrait la table. Cet ensemble me plaisait comme un raccourci de la laideur et de la prétention humaine."
                                            },
                                            {
                                                "example_id": "50b64384-7deb-4748-92ce-862694d96f22",
                                                "sense_id": "ab2cc77a-93ff-374c-880c-4cb81dc30988",
                                                "text": "Dans un placard-penderie aménagé sous la partie mansardée du studio, elle trouva tout de suite ce qu’elle cherchait : un deux-pièces couleur moutarde, jupe unie et blouson en jersey imprimé de vert, qu’elle flaira : « À qui ? À Hermine ? Ou à Colombe ?... »"
                                            },
                                            {
                                                "example_id": "21038cca-5a90-4af4-98a8-da088700d768",
                                                "sense_id": "ab2cc77a-93ff-374c-880c-4cb81dc30988",
                                                "text": "Un poignard au manche effilé était planté entre ses deux épaules et une tache brune imbibait la laine moutarde de sa veste de cashmere."
                                            },
                                            {
                                                "example_id": "166773bb-936a-4104-8c09-5c87e00279d2",
                                                "sense_id": "ab2cc77a-93ff-374c-880c-4cb81dc30988",
                                                "text": "Il avait l'air d'un tragédien, tête nue, de longs cheveux gris, enveloppé d'une toge couleur moutarde d'où sortaient des mollets d'un rose qui faisait mal, il portait des sandales de moine et ses cheveux étaient entourés, en diadème, d'un ruban noir large de deux centimètres ; il rejetait en arrière sa tête couperosée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moutarde",
                                "target_lang_code": "fr",
                                "target_senses": [
