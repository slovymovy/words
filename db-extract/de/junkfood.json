                                        "entry_id": "e3a3be86-dee4-3b53-9abe-25b21bd44041",
                                        "glosses": [
                                            "Food with little or no nutritional value; alternatively, food that supplies a large amount of nutrients but also excess calories, excess sugar or starch, and so on."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52641687-ebcc-43f3-843e-e5c0045e1d14",
                                                "sense_id": "6cfc86b8-4546-364a-aec6-70e72781c35e",
                                                "text": "The episode begins with a lifetime of junk food, beer and no exercise catching up with Homer in the form of painful heart contractions."
                                            },
                                            {
                                                "example_id": "c25c40b0-1f97-4c58-af73-e9cb44035661",
                                                "sense_id": "6cfc86b8-4546-364a-aec6-70e72781c35e",
                                                "text": "Junk foods and fast foods such as pizzas, hot dogs, doughnuts, cookies, cakes, and so on increase inflammation, promote insulin resistance, and increase the risk of diabetes and obesity."
                                            }
                                        ]
                                    }
                                ]
                            }
