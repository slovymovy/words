                        "examples": [
                            {
                                "example_id": "212dc3e6-2f7b-463c-9cae-d48ccbe6db1f",
                                "sense_id": "175b6bbc-d0fd-3800-bfa9-84d3899aa628",
                                "text": "Faut que j'retrouve mes tepos\nJ'finirais pas dans la Seine, victime de la folie des fachos"
                            },
                            {
                                "example_id": "a34d7b91-26d1-438c-8825-34081d759387",
                                "sense_id": "175b6bbc-d0fd-3800-bfa9-84d3899aa628",
                                "text": "T'as p't'êt des frères, mais crois pas qu't'as des tepos\nAussi sûr qu'aucun MC ici-bas n'aura ma peau"
                            },
                            {
                                "example_id": "a3ee68d3-1454-464d-a000-d521f57a6299",
                                "sense_id": "175b6bbc-d0fd-3800-bfa9-84d3899aa628",
                                "text": "Haut la main non main en l'air mais bon fais gaffe a tes chepos\nJ'suis un poids lourd, les balances ne mentent pas fais gaffe à tes tepos"
                            }
                        ]
                    }
