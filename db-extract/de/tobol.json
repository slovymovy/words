                "senses": [
                    {
                        "sense_id": "57543ca0-12e7-3fb2-aac4-ec8eca4f904d",
                        "entry_id": "90a94821-b769-3f21-99f0-a0befe17f254",
                        "glosses": [
                            "Nebenfluss des Irtysch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1828c2-024a-45a3-a1df-a8b1f6a8374d",
                                "sense_id": "57543ca0-12e7-3fb2-aac4-ec8eca4f904d",
                                "text": "„Damit hatten sie [die Russen] eine wichtige Position zur Erschließung des großen westsibirischen Flußgebietes zwischen Tura, Tawda, Tobol, Irtysch und Ob, also des fruchtbarsten Teils Sibiriens für die Landwirtschaft, gewonnen.“"
                            },
                            {
                                "example_id": "4e7f20aa-8e93-49e7-99bd-bc4f89959eec",
                                "sense_id": "57543ca0-12e7-3fb2-aac4-ec8eca4f904d",
                                "text": "„Der Abstieg auf der Ostseite des Ural war unproblematisch. Auf dem rasch fließenden Tagil kam man gut vorwärts, dann ging es auf der Tura weiter, schließlich auf dem Tobol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
