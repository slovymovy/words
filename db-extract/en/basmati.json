                        "entry_id": "c8627e98-108f-375f-b6ba-cc093b246a24",
                        "glosses": [
                            "A variety of long-grain rice, notable for its fragrance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "de63a728-d4d7-4266-8bb7-6fed97949bdf",
                                "sense_id": "1fe46efe-5a38-3578-9b0b-6402171d9d2c",
                                "text": "Diwaniya is the capital of the almost completely Shiite farming province of Qadisiya, known for its marshy fields where farmers grow aromatic ambar rice, similar to India’s basmati."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a009bebf-8854-4584-9eb3-f126b16225e8",
                        "source_entry_id": "c8627e98-108f-375f-b6ba-cc093b246a24",
                        "source_sense_id": "1fe46efe-5a38-3578-9b0b-6402171d9d2c",
