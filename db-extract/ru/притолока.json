                                        "sense_id": "35d70a70-5ad9-303b-afe2-0e4b514e8458",
                                        "entry_id": "34901cef-d724-3bef-8ae3-9ff306f31ae8",
                                        "glosses": [
                                            "A horizontal structural beam spanning an opening, such as between the uprights of a door or a window, and which supports the wall above."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcddff24-daca-44a3-a78f-bb9d9a364749",
                                                "sense_id": "35d70a70-5ad9-303b-afe2-0e4b514e8458",
                                                "text": "Athelny had told him that he lived in a house built by Inigo Jones; he had raved, as he raved over everything, over the balustrade of old oak; and when he came down to open the door for Philip he made him at once admire the elegant carving of the lintel."
                                            }
                                        ]
                                    }
