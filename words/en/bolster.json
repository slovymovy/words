{
    "word_family": [
        "bolstering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "410411f2-239b-3c42-b90d-fe756e3ca9a1",
                    "sense_definition": "A long, cylindrical cushion or pillow.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cushion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed a decorative <w>bolster</w> on the bed to make it look more comfortable.",
                            "target_lang_translations": {
                                "zh": "她在床上放了一个装饰性的<w>长枕</w>，让床看起来更舒适。"
                            }
                        },
                        {
                            "text": "The guest rested their head on the soft <w>bolster</w> after a long day of travel.",
                            "target_lang_translations": {
                                "zh": "经过一整天的奔波，客人在柔软的<w>长枕</w>上休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pillow"
                    ],
                    "common_phrases": [
                        "bed bolster"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种长圆柱形的靠垫或枕头。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长枕",
                                "target_lang_sense_clarification": "指长圆柱形的枕头。"
                            },
                            {
                                "target_lang_word": "靠枕",
                                "target_lang_sense_clarification": "指放在床上或沙发上用于支撑的垫子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ea5aeb1-3c94-385e-860d-a76e7abee603",
                    "sense_definition": "A pad or support used to relieve pressure or protect a body part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cushion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used a soft <w>bolster</w> to keep the injured arm in a comfortable position.",
                            "target_lang_translations": {
                                "zh": "医生用一个柔软的<w>衬垫</w>来保持受伤手臂的舒适位置。"
                            }
                        },
                        {
                            "text": "A small <w>bolster</w> was placed under the patient's knee to reduce strain during recovery.",
                            "target_lang_translations": {
                                "zh": "在病人膝盖下放了一个小<w>衬垫</w>，以减轻康复期间的压力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于减轻压力或保护身体部位的衬垫或支撑物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "衬垫",
                                "target_lang_sense_clarification": "用于支撑或保护身体部位的垫子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96be398f-afc6-3144-8f1b-1af3f7afbe31",
                    "sense_definition": "The thick part of a knife blade where it meets the handle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef held the knife by the <w>bolster</w> for better balance while chopping vegetables.",
                            "target_lang_translations": {
                                "zh": "厨师握住刀的<w>刀格</w>处，以便在切菜时保持更好的平衡。"
                            }
                        },
                        {
                            "text": "High-quality kitchen knives often feature a forged <w>bolster</w> for added strength and safety.",
                            "target_lang_translations": {
                                "zh": "优质的厨刀通常配有锻造的<w>刀格</w>，以增加强度和安全性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "刀刃与刀柄连接处的加厚部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刀格",
                                "target_lang_sense_clarification": "指刀刃与刀柄之间的加厚护手部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "734b4f14-740b-3b5d-9340-3eba76862c21",
                    "sense_definition": "A wide-bladed chisel used for cutting or shaping bricks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason used a <w>bolster</w> to split the brick cleanly in half.",
                            "target_lang_translations": {
                                "zh": "泥瓦匠用<w>砖凿</w>将砖块整齐地劈成两半。"
                            }
                        },
                        {
                            "text": "He sharpened his <w>bolster</w> before starting the wall repair project.",
                            "target_lang_translations": {
                                "zh": "他在开始墙壁维修工程前磨快了他的<w>砖凿</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于切割或修整砖块的宽刃凿子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砖凿",
                                "target_lang_sense_clarification": "专门用于切割砖块的工具。"
                            }
                        ]
