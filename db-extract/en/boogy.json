                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0530694e-3b4f-4347-a180-2f5bcc698742",
                                "sense_id": "1fbf92f3-bfa0-3af4-8c5e-721f03944e02",
                                "text": "\"The boogy light!\" D'ri whispered. \"There't goes ag'in!\""
                            },
                            {
                                "example_id": "23c8a88f-99cc-4660-aa52-56f3e1d9b7ee",
                                "sense_id": "1fbf92f3-bfa0-3af4-8c5e-721f03944e02",
                                "text": "\"Ya mean, yah ain't no boogy? \" he jabbered. There was that sneaky, breathy laugh again. \" Of course I'm not a boogy! \""
                            },
                            {
                                "example_id": "6076f75c-cfa7-441a-977e-637b74eb00b3",
                                "sense_id": "1fbf92f3-bfa0-3af4-8c5e-721f03944e02",
                                "text": "\"I make a boogy for my boy-baby,” she say. Fat Fox laugh, he know she lie. “Ain't no blackfeather boogy. I never heared of such a thing.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "04ae1af9-16e3-397d-9e75-20be325805df",
                        "entry_id": "79d0cce3-766a-3865-b0ee-62bc5c902f5e",
                        "glosses": [
                            "Alternative form of bogey.",
                            "A piece of dried mucus in or removed from the nostril."
                        ],
                        "tags": [],
                        "examples": [
                            {
