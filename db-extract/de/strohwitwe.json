                "senses": [
                    {
                        "sense_id": "00e6912b-45a7-364f-aa26-5bf95e1e2f2f",
                        "entry_id": "3b2ed728-421f-3007-ba8b-1f1d750dd2c8",
                        "glosses": [
                            "grass widow (married woman whose spouse is away)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "21ffd2ab-920a-4fb7-995c-9536600f9cc1",
                                "sense_id": "00e6912b-45a7-364f-aa26-5bf95e1e2f2f",
                                "text": "Himmlisch kannst du sprechen, Herzkind, und einer jungen Strohwitwe, die noch dazu das Unglück hat, selbst in ihren Landläufer von Gemahl verliebt zu sein, den Kopf schon verdrehen; aber kennst du die Welt, das taube, hartmäulige Tier?",
                                "translation": "You can talk heavenly, sweet boy, and you can mess with the head of a young grass widow who is unfortunate enough to even love her vagabond of a husband; but do you know the world, the deaf, stubborn beast?",
                                "english": "You can talk heavenly, sweet boy, and you can mess with the head of a young grass widow who is unfortunate enough to even love her vagabond of a husband; but do you know the world, the deaf, stubborn beast?"
                            }
                        ]
                    }
