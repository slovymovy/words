                "senses": [
                    {
                        "sense_id": "18e19000-13a6-3def-af54-1cf0d8556d7c",
                        "entry_id": "4c025f72-0ab6-36cb-b3f0-e19714030b0b",
                        "glosses": [
                            "Vertreter einer Gattung fleischfressender Dinosaurier aus der frühen Kreidezeit, deren in China gefundenen Fossilien Spuren von Federn aufweisen"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "789ed723-3f6c-47d8-9ef2-9c788143d07c",
                                "sense_id": "18e19000-13a6-3def-af54-1cf0d8556d7c",
                                "text": "„Bis zum Fund des Yutyrannus nahmen die Forscher an, dass nur die kleineren Dinosaurier gefiedert waren. Die Entdeckung dieser Art macht die Annahme wahrscheinlicher, dass auch erwachsene Tyrannosaurier ein Federkleid besaßen.“"
                            },
                            {
                                "example_id": "874c017e-a5c9-43fa-a66d-4648609b5bc0",
                                "sense_id": "18e19000-13a6-3def-af54-1cf0d8556d7c",
                                "text": "„Ihre chinesischen und kanadischen Entdecker tauften den Fleischfresser auf den Namen Yutyrannus huali, eine Kunstform aus Latein und Mandarin, die übersetzt so viel bedeutet wie \"schön gefiederter Tyrann\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
