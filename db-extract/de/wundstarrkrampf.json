                        "glosses": [
                            "bakterielle, meldepflichtige Wundinfektionskrankheit von dem Bakterium Clostridium tetani hervorgerufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d942efe7-5e2c-4a02-aaf1-bead9150692d",
