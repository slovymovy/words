                "senses": [
                    {
                        "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                        "entry_id": "d3d6aabc-b30a-34af-be4e-35719d762c20",
                        "glosses": [
                            "eine iranische Sprache, die vor allem in Pakistan, aber auch in Teilen des Irans sowie Afghanistans vom Volk der Belutschen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552fe6f2-8219-41b4-a370-26772581a185",
                                "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                                "text": "„Es bildet mit dem Belutschi, Talischi, Gilki und Masendarani den nördlichen Zweig der westiranischen Gruppe innerhalb der indoeuropäischen Sprachfamilie.“"
                            },
                            {
                                "example_id": "ad68d155-c0d1-49e9-8b33-4669df0bbbfe",
                                "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                                "text": "„Die Sprache der Belutschen, das Belutschi, eine nordwestiranische Sprache, ist dem Dari verwandt.“"
                            },
                            {
                                "example_id": "c02c71d7-0c07-4c73-905e-40b525b800e8",
                                "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                                "text": "„Das war keineswegs ungefährlich. Deshalb führte er diese Aufzeichnungen damals fast immer in Belutschi.“"
                            },
                            {
                                "example_id": "3a2a2c97-e149-4cc9-bc6b-b92b7a1784c3",
                                "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                                "text": "„Von einer andern Seite her verdanke ich dem jetzt nach Indien abgegangenen Herrn Missionar G. H. Weigle […] die Mittheilung einiger Fragmente über das Afghanische und Belutschi, welche sich handschriftlich im Missionshause zu Basel finden, und von welchen die über das Belutschi von einem Gelehrten nützlich zu gebrauchen wären, welcher künftig einmal diesen bis jetzt ganz unbekannten Zweig indo-germanischer Sprachen wissenschaftlich untersuchen wollte.“"
                            },
                            {
                                "example_id": "bbc2b9c4-fe9b-4f75-92d7-b1823e5f54f7",
                                "sense_id": "ad94deaa-a0b6-3c0a-bc72-71ee9df22850",
                                "text": "„1998 gaben 3,6 Prozent der Einwohner Belutschi als Muttersprache an, allerdings verstehen sich in Belutschistan auch viele Brahui-Sprecher ethnisch als Belutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
