                    "frequency": "Low",
                    "semantic_group_id": "spule_elektrotechnik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Gleichstrom veranlasst die <w>Spule</w> ein Magnetfeld aufzubauen."
                        },
                        {
