                        "source_entry_id": "b00dd4b3-df26-384c-8196-4ecbad75b5ff",
                        "target_lang_word": "complain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To express feelings of pain, dissatisfaction, or resentment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4703c8f-2668-40d5-b50c-16fe6d6fa871",
                                                "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                                "text": "Joe was always complaining about the noise made by his neighbours."
                                            },
                                            {
                                                "example_id": "09c161b0-c436-4e00-a068-d364b780d1ec",
                                                "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                                "text": "O loſs of ſight, of thee I moſt complain!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To make a formal accusation or bring a formal charge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef67ee9-3465-4166-b760-6e1a37c6ab62",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "They've complained about me to the police again."
                                            },
                                            {
                                                "example_id": "2f546466-6cf0-4b38-8744-6fc217b7c8dc",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "Now, Master Shallow, you'll complain of me to the king?"
                                            },
                                            {
                                                "example_id": "334edb79-afae-454c-ada7-c1d6ac367d9e",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "If you get cheated by the Better Business Bureau, who do you complain to?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b9aab22-3c2f-38cc-a1ed-2bc0385e37d2",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To creak or squeak, as a timber or wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b426e2d0-f893-4086-ba8d-ac40d060f797",
                                                "sense_id": "6b9aab22-3c2f-38cc-a1ed-2bc0385e37d2",
                                                "text": "the complaining bed-springs"
                                            }
                                        ]
                                    }
