                "senses": [
                    {
                        "sense_id": "cf65c28d-1911-3994-b1c3-5255f73d0957",
                        "entry_id": "a0c3f6a2-7330-36b4-a049-1410bddddf85",
                        "glosses": [
                            "Faire cesser l’humiliation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80dadbb-09e4-444c-bdaa-23ef08c0358f",
                                "sense_id": "cf65c28d-1911-3994-b1c3-5255f73d0957",
                                "text": "[…] tout ce qu’elle a enfoui comme honteux et qui devient digne d’être retrouvé, déplié à la lumière de l’intelligence. Au fur et à mesure que sa mémoire se déshumilie, l’avenir est à nouveau un champ d’action."
                            },
                            {
                                "example_id": "88b71bb7-0ac4-4644-abdf-0e71812ec2d9",
                                "sense_id": "cf65c28d-1911-3994-b1c3-5255f73d0957",
                                "text": "L’auteur veut qu’on les démagotte et qu’on les déshumilie."
                            }
                        ]
                    }
                ],
