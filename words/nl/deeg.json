                        {
                            "text": "De bakker moet het <w>deeg</w> eerst goed kneden voordat het in de oven kan.",
                            "target_lang_translations": {
                                "en": "The baker must first knead the <w>dough</w> well before it can go into the oven."
                            }
                        },
                        {
                            "text": "Zij maakt elke zondag vers <w>deeg</w> voor een heerlijke appeltaart.",
                            "target_lang_translations": {
                                "en": "She makes fresh <w>dough</w> every Sunday for a delicious apple pie."
                            }
