                "senses": [
                    {
                        "sense_id": "251cc8d2-7601-321a-b2ca-02e9b39a51b3",
                        "entry_id": "5d19bed2-7f56-3d1e-92a4-43824eb31a31",
                        "glosses": [
                            "An obnoxious, selfish and overbearing person; an attention hog."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dd27b5dc-5f75-4c02-8c8b-409b7aec13e3",
                                "sense_id": "251cc8d2-7601-321a-b2ca-02e9b39a51b3",
                                "text": "And it's not even going to share with you?? What a Bogart!!! LOL"
                            },
                            {
                                "example_id": "f9502f72-f956-48e8-a023-06207b4ec346",
                                "sense_id": "251cc8d2-7601-321a-b2ca-02e9b39a51b3",
                                "text": "What a bogart... Hey, share some of the wealth, buddy"
                            },
                            {
                                "example_id": "9956ed95-6c7d-4d4e-911a-10c2665078b6",
                                "sense_id": "251cc8d2-7601-321a-b2ca-02e9b39a51b3",
                                "text": "I just thought Mike was getting high in the corner, and Heather put her camera down to run over and demand that he not be such a Bogart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6075c0bd-bf6a-40fc-87c1-25d4506f7ec5",
