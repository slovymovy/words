                    {
                        "translation_id": "b4b77235-6e62-4b45-ae13-308352cf726b",
                        "source_entry_id": "2bf9f323-af57-39c5-b25e-d758ba93a501",
                        "source_sense_id": "92b1a6f8-1c15-31f8-91cc-cd7848afaff0",
                        "source_sense_description": "Rassemblement de scouts",
