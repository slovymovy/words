                "senses": [
                    {
                        "sense_id": "f1927ddf-a694-3ca5-bd95-400181344dc3",
                        "entry_id": "d5f88a54-05ac-3704-8747-1cd43fc9faf7",
                        "glosses": [
                            "Truthahn, der als Festmahl zu Thanksgiving gegessen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5228f8f6-df5d-483e-8fa8-3c9e89a1689f",
                                "sense_id": "f1927ddf-a694-3ca5-bd95-400181344dc3",
                                "text": "„Wiederholt tauchten Worte wie Freiheit, Befreiung und Demokratie im Gefasel seines Gesprächspartners auf, was Driver irgendwie an Reklame für Thanksgiving-Truthähne erinnerte.“"
                            },
                            {
                                "example_id": "a14f09d3-d38d-441f-acf8-0813205c9ef7",
                                "sense_id": "f1927ddf-a694-3ca5-bd95-400181344dc3",
                                "text": "„Als der Footballmann bloß noch ein knochiger Thorax ist, so etwa wie ein abgenagter Thanksgiving-Truthahn, nur noch die bleichen Rippen und ein paar Hautfetzen, erst da schmeißt der Gehörnte die letzten Reste in den Käfig und verschließt die Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
