                        ],
                        "form": "abecadłowy"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e667e096-e3ab-3a28-bb84-3d524a3a376b",
                        "entry_id": "06be12cf-5d83-3b24-b3f9-8b83625f3758",
                        "glosses": [
                            "alphabetisch"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d3b2023c-fda0-47ce-b3cb-06b2dde98ca7",
                                "sense_id": "e667e096-e3ab-3a28-bb84-3d524a3a376b",
                                "text": "„Nauczyciel zaczął szukać tej familji w spisie abecadłowym pod literą Z — i nie znalazł.“",
                                "translation": "Der Lehrer begann diesen Familiennamen im alphabetischen Verzeichnis unter dem Buchstaben Z zu suchen – und fand ihn nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3bb84e6a-af24-34df-ba96-7cede431deaf",
                        "entry_id": "06be12cf-5d83-3b24-b3f9-8b83625f3758",
                        "glosses": [
                            "auf Buchstaben beruhend; Alphabet-"
                        ],
                        "tags": [
