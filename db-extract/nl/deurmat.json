                ],
                "senses": [
                    {
                        "sense_id": "cb1bba26-f982-3bf4-9b7e-2b99cf166a14",
                        "entry_id": "400c6f60-9223-355c-91e2-f12e249b206f",
                        "glosses": [
                            "een kleine mat, waarop men bij de deur de schoenen kan afvegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605c5925-3ef5-458b-bf34-23d89df345fc",
                                "sense_id": "cb1bba26-f982-3bf4-9b7e-2b99cf166a14",
                                "text": "De buurman kocht een deurmat waarop de tekst \"welkom!\" stond."
                            },
                            {
                                "example_id": "9879dc69-68f5-41d1-a3a8-20b56eba0c6c",
                                "sense_id": "cb1bba26-f982-3bf4-9b7e-2b99cf166a14",
                                "text": "Zonder een woord te zeggen duwden we haar zacht de deur uit. Ze liet zich helemaal slap worden toen ze op de deurmat stond. We hebben haar maar op de deurmat laten liggen. De volgende ochtend was ze verdwenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe7997b-0b47-45e0-b0ed-b9afd933b027",
                        "source_entry_id": "400c6f60-9223-355c-91e2-f12e249b206f",
                        "source_sense_id": "cb1bba26-f982-3bf4-9b7e-2b99cf166a14",
                        "source_sense_description": "een kleine mat, waarop men bij de deur de schoenen kan afvegen",
                        "target_lang_word": "Fußmatte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußmatte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21466bd3-4259-3ed7-84af-bd752783c378",
                                        "entry_id": "b818aecf-b835-3ecc-b652-dfe82d2da9cd",
                                        "glosses": [
                                            "Matte, auf der man die Schuhe abtreten/von Schmutz befreien soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b40cfd-e3c3-4327-bfe1-686a50a16802",
                                                "sense_id": "21466bd3-4259-3ed7-84af-bd752783c378",
                                                "text": "„Sogar die sechs Fußmatten hat er wieder ordentlich auf den Lichtschacht gelegt, durch den er möglicherweise eingestiegen war.“"
                                            },
                                            {
                                                "example_id": "63c91efc-4c96-494e-9a90-56c7e93e326b",
                                                "sense_id": "21466bd3-4259-3ed7-84af-bd752783c378",
                                                "text": "„Sævar wischte die Schuhe auf der Fußmatte ab und folgte ihr durch den Vorraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d92afd4-508d-3646-95c1-acdba78cfa6f",
                                        "entry_id": "b818aecf-b835-3ecc-b652-dfe82d2da9cd",
                                        "glosses": [
                                            "Matte als Bodenbelag"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fee37f4d-014d-489b-ba5c-589a351ee49f",
                        "source_entry_id": "400c6f60-9223-355c-91e2-f12e249b206f",
                        "source_sense_id": "cb1bba26-f982-3bf4-9b7e-2b99cf166a14",
                        "source_sense_description": "een kleine mat, waarop men bij de deur de schoenen kan afvegen",
                        "target_lang_word": "doormat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doormat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "A coarse mat at the entrance to a house, upon which one wipes one's shoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b30246c-3236-41ec-94e8-28c5802a77e8",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Wipe your shoes on the doormat before you start plodding around in the house."
                                            },
                                            {
                                                "example_id": "7b697b88-609a-4860-8240-e7f6f740d9b4",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Mr. Simpson adds that the station at Stanmore appears practically unchanged from the time of its opening, even to the L.N.W.R. rubber doormat, which \"shows no signs of wearing out.\""
                                            },
                                            {
                                                "example_id": "bb62fe51-48ee-4b6c-96b8-e04d526bf2b0",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Dimple glanced at an expensive-looking doormat with the words ‘LOSE THE SHOES’ woven into it and wondered why anyone would bother spending so much money on something people were going to wipe their feet on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "Someone who is overly submissive to others' wishes."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16889007-cf40-452f-a162-cefd2232b0c5",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "He's such a doormat, he lets everyone walk all over him."
                                            },
                                            {
                                                "example_id": "aa2834df-cc06-4629-a98c-58e817e45622",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "If you flipped through certain magazines at this time you could be forgiven for thinking that there was no right way to be a woman, only wrong ones — bimbo or frump, slut or prude, shrew or doormat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
