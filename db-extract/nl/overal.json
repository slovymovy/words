                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7a2b1913-1065-334c-81e5-126256cac947",
                                        "entry_id": "2abf48e4-88ea-3794-b54f-48ab89920870",
                                        "glosses": [
                                            "do każdego miejsca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a197a63f-75ea-496d-82ef-04a2cb9ab868",
                                                "sense_id": "7a2b1913-1065-334c-81e5-126256cac947",
                                                "text": "Śpiewałaś mi „Pójdę wszędzie z tobą” i „zrobię dla ciebie wszystko”."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
