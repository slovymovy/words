    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9aec85c0-30ff-378c-a9c1-4e783d0d754b",
                    "sense_definition": "Een plan of idee dat aan iemand wordt voorgelegd ter overweging.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voorstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heeft er iemand nog een goede <w>suggestie</w> voor een leuk restaurant in de buurt?",
                            "target_lang_translations": {
                                "en": "Does anyone have a good <w>suggestion</w> for a nice restaurant nearby?",
                                "ru": "Есть ли у кого-нибудь еще хорошее <w>предложение</w> по поводу приятного ресторана поблизости?"
                            }
                        },
                        {
                            "text": "Ik sta altijd open voor een <w>goede</w> <w>suggestie</w> om onze werkwijze te verbeteren.",
                            "target_lang_translations": {
                                "en": "I am always open to a good <w>suggestion</w> to improve our way of working.",
                                "ru": "Я всегда открыт для хороших <w>предложений</w> по улучшению нашего метода работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorstel",
                        "tip",
                        "idee",
                        "hint"
                    ],
                    "common_phrases": [
                        "goede suggestie",
                        "een suggestie doen"
                    ],
                    "target_lang_definitions": {
                        "en": "A plan or idea presented to someone for consideration.",
                        "ru": "План или идея, представленные кому-либо для рассмотрения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suggestion",
                                "target_lang_sense_clarification": "an idea or plan put forward"
                            },
                            {
                                "target_lang_word": "proposal",
                                "target_lang_sense_clarification": "a formal suggestion or plan"
                            },
                            {
                                "target_lang_word": "tip",
                                "target_lang_sense_clarification": "a helpful piece of advice"
                            },
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "a thought or suggestion as to a possible course of action"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "идея или план, выдвинутые на обсуждение"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "полезная рекомендация"
                            },
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "мысль о возможном плане действий"
                            },
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "небольшой совет или намек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb3abc82-5c40-36ae-8e54-a6c9661cecce",
                    "sense_definition": "Het wekken van een bepaalde indruk of gedachte zonder deze direct te benoemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit schilderij is er geen naakt te zien, er is vooral <w>suggestie</w>.",
                            "target_lang_translations": {
                                "en": "In this painting there is no nudity to be seen, there is mainly <w>suggestion</w>.",
                                "ru": "На этой картине нет обнаженной натуры, в ней есть прежде всего <w>намек</w>."
                            }
                        },
                        {
                            "text": "De <w>kracht</w> <w>van</w> <w>suggestie</w> kan mensen dingen laten geloven die er niet zijn.",
                            "target_lang_translations": {
                                "en": "The power of <w>suggestion</w> can make people believe things that aren't there.",
                                "ru": "Сила <w>внушения</w> может заставить людей поверить в то, чего нет."
                            }
                        }
                    ],
                    "synonyms": [
                        "wenk",
                        "hint"
                    ],
                    "common_phrases": [
                        "kracht van suggestie"
                    ],
                    "target_lang_definitions": {
                        "en": "Creating a certain impression or thought without naming it directly.",
                        "ru": "Создание определенного впечатления или мысли без прямого упоминания."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suggestion",
                                "target_lang_sense_clarification": "the process of implying something"
                            },
                            {
                                "target_lang_word": "hint",
                                "target_lang_sense_clarification": "a slight or indirect indication"
                            },
                            {
                                "target_lang_word": "innuendo",
                                "target_lang_sense_clarification": "an allusive or oblique remark or hint"
                            }
                        ],
                        "ru": [
                            {
