                ],
                "senses": [
                    {
                        "sense_id": "ca82d7fc-df23-33de-a558-1c3d31637980",
                        "entry_id": "a16f93d3-6729-33f8-b60d-4a3d6b11365a",
                        "glosses": [
                            "разг. щенок, небольшая собака"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61011e87-7a1d-456c-9cac-dd6fe64cc081",
                                "sense_id": "ca82d7fc-df23-33de-a558-1c3d31637980",
                                "text": "― А ну замолчи, собачья твоя душа. Ластишься, как цуцик. Ишь, добрый."
                            }
                        ]
                    },
                    {
                        "sense_id": "b02845e0-acc3-323f-898e-33ee647bdcdb",
                        "entry_id": "a16f93d3-6729-33f8-b60d-4a3d6b11365a",
                        "glosses": [
                            "перен., разг., шутл. молодой и неопытный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a501d0dc-7918-4b5e-98f7-26f5f9eba9ce",
                                "sense_id": "b02845e0-acc3-323f-898e-33ee647bdcdb",
                                "text": "― Подойди сюда, цуцик, ― тихо позвал он и сам удивился: откуда у него вырвалось это «цуцик»?"
                            }
                        ]
                    }
                ],
