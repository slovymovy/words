                ],
                "senses": [
                    {
                        "sense_id": "19e88eab-5b58-38e1-88d8-7c59e4bd46c7",
                        "entry_id": "d3842c94-b8df-3207-97b0-de5689e8130f",
                        "glosses": [
                            "ironische Bezeichnung für einen Erwachsenen, der sich in Kleidung und Verhalten wie ein Jugendlicher gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5061bce6-a780-4b8c-bf1b-f2cc3e4121c2",
                                "sense_id": "19e88eab-5b58-38e1-88d8-7c59e4bd46c7",
                                "text": "Filmschauspieler Moritz Bleibtreu: „Ich bin mittlerweile 36 Jahre alt. Ich bin zwar ein Berufsjugendlicher und tue immer noch, als wäre ich Anfang zwanzig, aber ich bin es nicht mehr.“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4681c675-8265-3b79-9049-f90825dd5e39",
                        "entry_id": "d3842c94-b8df-3207-97b0-de5689e8130f",
                        "glosses": [
                            "Funktionär eines Jugendverbandes, der dem Jugendalter längst entwachsen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119e4533-3fe0-4c24-8cd9-e6abbe2b0eac",
                                "sense_id": "4681c675-8265-3b79-9049-f90825dd5e39",
                                "text": "„Bestes Beispiel für einen Berufsjugendlichen war Egon Krenz, der mit achtundvierzig Jahren immer noch das Amt eines FDJ-Vorsitzenden innehatte, obwohl das FDJ-Statut eine Altersgrenze von fünfunddreißig Jahren vorsah.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
