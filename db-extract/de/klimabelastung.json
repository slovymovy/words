                ],
                "senses": [
                    {
                        "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                        "entry_id": "178061a6-a4dc-3922-8401-c08267c3a89f",
                        "glosses": [
                            "Ausstoß von klimaschädlichen Gasen oder Partikeln (oft durch Verbrennung mit nachfolgenden Schäden, beispielsweise der globalen Erwärmung, Versauerung der Meere)"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "b7578047-bc94-4585-a63c-bb5d923a5063",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[LNG:] „Die Gewinnung von Flüssigerdgas führt zu radioaktiven Abfällen, vergifteten Flüssen und einer enormen Klimabelastung.“"
                            },
                            {
                                "example_id": "c0cb48b8-a243-41db-96b5-855b5fc90588",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Erdgasleck in der Nordsee bei Probebohrungen:] „Erst in jüngerer Zeit stieg das Bewusstsein dafür, dass die Freisetzung des Methans in die Atmosphäre eine nennenswerte Klimabelastung darstellt, da Methan 20- bis 30-mal klimawirksamer als Kohlendioxid ist.“"
                            },
                            {
                                "example_id": "5a41e37e-9925-4f61-a6f8-accce8cbe19d",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Lecks im Elgin-Feld in der Nordsee:] „In der Luft verdünnen sich diese Gase allesamt sehr schnell. Sie stellen aber eine zusätzliche Klimabelastung dar.“"
                            },
                            {
                                "example_id": "3c15bbfb-c5c8-4a9f-9d31-87f02072f453",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Zemantproduktion:] „Mit einem Ausstoß von 800.000 Tonnen CO₂ pro Jahr leistet Heidelberg Materials einen signifikanten Beitrag zur Klimabelastung.“"
                            },
                            {
                                "example_id": "af6c1a8d-502b-4ec4-9a77-1ebe80276196",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "„Zerstörte Moore werden“ […] „zu einer großen Klimabelastung. Bei der Entwässerung und Bewirtschaftung der Moore oxidiert der über tausende Jahre eingelagerte Kohlenstoff. Es entsteht klimaschädliches CO2.“"
                            },
                            {
                                "example_id": "311e4cb8-7744-4121-9715-dd47d7e28029",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Tempolimit 120 km/h:] „Im Gegensatz zu diesen Sektoren, nimmt die Klimabelastung durch den Verkehr aber zu.“"
                            },
                            {
                                "example_id": "515f2b33-bf32-4bf0-8347-2528f1260986",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "„Mit unserem Pendler-Rechner kannst du dir einen Überblick über die Kosten und die Klimabelastung der Autofahrt verschaffen“ […]."
                            },
                            {
                                "example_id": "81c48678-4ff8-47e5-9ef7-f328884764e0",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Nutzung des Internets:] „Die Klimabelastung, die ich als einzelne Userin verursache, ist also eher klein.“"
                            },
                            {
                                "example_id": "8f1872c4-89a1-4c74-84cc-8fffc4b08bb1",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "„Nach Ansicht des Naturschutzbundes Deutschland (NABU) sollte sich die Höhe der Steuer nach der Klimabelastung der Verpackungsproduktion und der Anzahl ihrer Nutzungen richten.“"
                            },
                            {
                                "example_id": "8a2ba919-91e9-4208-a577-b07d28302325",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "„Der Vergleich von peruanischem und regionalem Spargel macht den enormen Unterschied in der transportbedingten Klimabelastung deutlich:“ […]."
                            },
                            {
                                "example_id": "e040b042-ea82-4b0d-9dd7-105d4acb3474",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "„Die Klimabelastung durch Mineralwasser, das in Einwegflaschen abgefüllt ist, ist in Deutschland fast 600-mal höher als bei Leitungswasser.“"
                            },
                            {
                                "example_id": "c660a42e-1e1b-4bba-869d-e03edf9f4775",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "Der Verbrauch von Mineralwasser durch die Berliner verusacht eine Klimabelastung von 105.000 Tonnen CO₂. Würden alle Berliner nur noch Leitungswasser trinken, dann wären es nur noch 175 Tonnen CO₂."
                            },
                            {
                                "example_id": "65a120f4-ccd9-4a44-9a48-c538572e9596",
                                "sense_id": "ec44d06e-d726-3eba-8bd2-e9033d97fd88",
                                "text": "[Anästhesie:] „Die einzelnen Substanzen haben dabei ein sehr unterschiedliches klimaschädigendes Potential. Dies erklärt sich vor allem aus deren jeweiligen Lebensspanne in der Erdatmosphäre: So entspricht die Klimabelastung einer Allgemeinnarkose von einer Stunde bei Verwendung von Sevofluran einer Fahrstrecke von etwa 28–62 km mit einem modernen PKW. Bei der Verwendung von Desfluran läge die entsprechende Fahrstrecke bei 375–750 km.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
