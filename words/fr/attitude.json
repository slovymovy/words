    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "144ee886-4131-3e1e-9243-332a2684df4b",
                    "sense_definition": "Manière de se comporter ou d'agir à l'égard de quelqu'un ou face à une situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il garde toujours une <w>attitude</w> positive devant les difficultés de la vie."
                        },
                        {
                            "text": "Le professeur lui demande de changer d'<w>attitude</w> en classe."
                        }
                    ],
                    "synonyms": [
                        "comportement",
                        "conduite",
                        "disposition"
                    ],
                    "common_phrases": [
                        "attitude positive",
                        "changer d'attitude",
                        "adopter une attitude"
                    ]
                },
                {
                    "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                    "sense_definition": "Position ou maintien du corps, naturel ou choisi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre demande au modèle de garder la même <w>attitude</w> pendant une heure."
                        },
                        {
                            "text": "Cette statue antique présente une <w>attitude</w> d'une grande noblesse."
                        }
                    ],
                    "synonyms": [
                        "maintien",
                        "pose",
                        "posture"
                    ],
                    "common_phrases": [
                        "attitude du corps"
                    ]
                },
                {
                    "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                    "sense_definition": "Manière d'agir affectée ou apparence feinte que l'on adopte pour faire impression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde s'est vite rendu compte que sa gentillesse n'était qu'une simple <w>attitude</w>."
                        },
                        {
                            "text": "Il aime prendre des <w>attitudes</w> pour impressionner les gens qui l'entourent."
                        }
                    ],
                    "synonyms": [
                        "affectation",
                        "pose"
                    ],
                    "antonyms": [
                        "naturel",
                        "sincérité"
                    ],
                    "common_phrases": [
                        "prendre des attitudes"
                    ]
                },
                {
                    "sense_id": "63193f5b-7c40-30c7-afbd-2980b3b197f7",
                    "sense_definition": "Prédisposition psychologique durable d'une personne à évaluer favorablement ou défavorablement un objet, une idée ou un groupe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étude sociologique mesure l'<w>attitude</w> des consommateurs envers les produits biologiques."
                        },
                        {
                            "text": "Les chercheurs observent une nette évolution de l'<w>attitude</w> du public vis-à-vis des énergies renouvelables."
                        }
                    ]
                },
                {
                    "sense_id": "3d5d7ac7-1c7e-3978-af52-4b96235fa7f1",
                    "sense_definition": "Orientation spatiale d'un corps, d'un engin aérospatial ou d'un repère par rapport à des axes de référence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les propulseurs ont immédiatement corrigé l'<w>attitude</w> du satellite en orbite."
                        },
                        {
                            "text": "Le pilote surveille attentivement l'<w>attitude</w> de l'appareil lors de la descente finale."
                        }
                    ],
                    "synonyms": [
                        "assiette",
                        "orientation"
                    ],
                    "common_phrases": [
                        "contrôle d'attitude"
                    ]
                }
            ]
        }
    ]
