                    {
                        "translation_id": "4c7e76b3-e16c-40f5-b990-dde151670f53",
                        "source_entry_id": "1a625d7d-714e-3d5f-9b02-d95901cab542",
                        "source_sense_id": "4c486eee-6381-3f13-9f57-57e7f418b6fb",
                        "source_sense_description": "Teil einer Gesellschaft, die nicht zur Sphäre der Politik, des Staatsapparats oder der Wirtschaft gehört",
                        "target_lang_word": "burgermaatschappij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burgermaatschappij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "835359e8-f217-3fa9-bc4e-7511a7627ec1",
                                        "entry_id": "d44786ca-de2e-34bb-9283-1b31fe6abd97",
                                        "glosses": [
                                            "de samenleving van niet-militairen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454563e7-4190-4a94-82fe-aca5e2024779",
                                                "sense_id": "835359e8-f217-3fa9-bc4e-7511a7627ec1",
                                                "text": "Doordat hij na 16 jaar uit dienst ging in plaats van de gebruikelijke 20, verloor hij zijn pensioen. Omdat hij werkloos werd, had hij ook geen zorgverzekering meer, hoewel hij nog altijd last heeft van oude verwondingen aan rug, ogen en nek. Hij vindt het moeilijk om een baan in de burgermaatschappij te krijgen, omdat zijn training daar niet op aansluit."
                                            },
                                            {
                                                "example_id": "b60e7b4a-93fb-4654-a15d-4d95c32c39a3",
                                                "sense_id": "835359e8-f217-3fa9-bc4e-7511a7627ec1",
                                                "text": "De nieuwe Georgische premier Ivanisjvili heeft aangekondigd dat hij maar anderhalf jaar in functie wil blijven. Daarna trekt hij zich terug uit de politiek en wil hij naar eigen zeggen een actief lid van de burgermaatschappij worden."
                                            },
                                            {
                                                "example_id": "d31b0e2e-92be-48fd-82af-f5e3f31b56b3",
                                                "sense_id": "835359e8-f217-3fa9-bc4e-7511a7627ec1",
                                                "text": "Nu Defensie gaat bezuinigen, moeten 12.000 militairen ook op zoek naar een baan in de burgermaatschappij. Maar Beneker ziet het niet somber voor ze in, volgens hem kunnen oud-militairen overal wel aan de slag. \"Ze hebben competenties die goed bruikbaar zijn bij elk bedrijf. Een militair weet wat een opdracht is, kan die zo nodig onder lastige omstandigheden uitvoeren, kent discipline, is flexibel en opleidbaar.\" En, bijzonder loyaal aan werkgever: \"Wie anders is bereid voor z'n werkgever het hoogste offer te brengen?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
