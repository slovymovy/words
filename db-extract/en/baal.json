                    }
                ],
                "senses": [
                    {
                        "sense_id": "46f82e78-acb7-30df-8c35-c4732302efc3",
                        "entry_id": "de0823dc-1ea9-3d83-befb-aa214be18eb8",
                        "glosses": [
                            "A storm and fertility god of the Phoenician and Canaanite pantheons, reckoned as chief of the gods by the 1st millennium BC."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca89f9fe-4bc9-3e1a-92c4-748c394a1beb",
                        "entry_id": "de0823dc-1ea9-3d83-befb-aa214be18eb8",
                        "glosses": [
                            "Various other Baalim, understood as distinct patron gods or as local patron aspects the great god Baal."
                        ],
                        "tags": [
                            "countable",
                            "lowercase",
                            "sometimes",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c18704bc-a40f-35b0-871b-6e5fb60145f9",
                        "entry_id": "de0823dc-1ea9-3d83-befb-aa214be18eb8",
                        "glosses": [
                            "One of the demons or fallen angels of Satan."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b62ffe6-1bfd-4172-99e9-959f095212a5",
                        "source_entry_id": "de0823dc-1ea9-3d83-befb-aa214be18eb8",
                        "source_sense_description": "deity",
                        "target_lang_word": "Baal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df9464ef-7b05-3e26-bafb-4fc9e72eceef",
                                        "entry_id": "8a86c78f-af60-3185-92db-ca44efe1e984",
                                        "glosses": [
                                            "semitischer Himmels-, Wetter- und Fruchtbarkeitsgott, oberster Gott verschiedener Pantheons; auch Titel anderer Gottheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887aba30-1eaf-4c95-985c-7feb676093f1",
                                                "sense_id": "df9464ef-7b05-3e26-bafb-4fc9e72eceef",
                                                "text": "„Wenn der HERR der wahre Gott ist, dann folgt ihm! Wenn aber Baal es ist, dann folgt diesem!“"
                                            },
                                            {
                                                "example_id": "9e168352-17ec-4ef7-9663-019e03a3fbb2",
                                                "sense_id": "df9464ef-7b05-3e26-bafb-4fc9e72eceef",
                                                "text": "„Es steht in jedem Tunesien-Reiseführer: Die antiken Karthager hätten alljährlich ihrem Gott Baal Säuglinge geopfert. Diese uralte Behauptung wurde von antiken Schriftstellern schon im 3. Jahrhundert v. Chr. in Umlauf gesetzt.“"
                                            },
                                            {
                                                "example_id": "8c89ff48-aecd-40d0-aa15-edfae02e2d67",
                                                "sense_id": "df9464ef-7b05-3e26-bafb-4fc9e72eceef",
                                                "text": "„Baal befiehlt: ›Zerstreue deine feindlichen Heere! Und übergibt uns deine köstlichen Vorräte an Nestlé-Crunch-Riegeln!‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49c536b6-3141-3da1-9e21-17f9554c6c95",
                                        "entry_id": "8a86c78f-af60-3185-92db-ca44efe1e984",
                                        "glosses": [
                                            "übernatürliches, nicht Gott gehorchendes Wesen"
                                        ],
                                        "tags": [
                                            "Dämonologie",
                                            "Esoterik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Baal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8550954-e519-3097-89a0-a7968679d96b",
                                        "entry_id": "ddb4b4f2-4bab-3798-aac0-aa1d305112ed",
                                        "glosses": [
                                            "Titel verschiedener altvorderasiatischer Götter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbafc04-97e0-488e-9958-f239a0887f0b",
                                                "sense_id": "a8550954-e519-3097-89a0-a7968679d96b",
                                                "text": "„Im Alten Testament kämpft der Prophet Elija verzweifelt gegen die Baale, die Götzen ewiger Fruchtbarkeit und unendlichen Wachstums. Für ihn ist Jahwe, der ‚Gott der Gerechtigkeit‘ der wahre Gott.“"
                                            },
                                            {
                                                "example_id": "eba8db96-6085-4a5c-b451-944d637416d6",
                                                "sense_id": "a8550954-e519-3097-89a0-a7968679d96b",
                                                "text": "„Damals beginnen die Baale von Doliche, Petra, Palmyra, Emesa zum Monotheismus des Sol zu verschmelzen, […]“"
                                            },
                                            {
                                                "example_id": "e25bd423-ee36-4bd5-92bb-64890eaad489",
                                                "sense_id": "a8550954-e519-3097-89a0-a7968679d96b",
                                                "text": "„Denn auch auf Erden haben die Götter ihre Wohnung, die Baale des Landes, in deren Erbe Jahve eingetreten ist; […]“"
                                            },
                                            {
                                                "example_id": "ea575b9c-1c95-4b27-a9af-f8b6c5fc5ec5",
                                                "sense_id": "a8550954-e519-3097-89a0-a7968679d96b",
                                                "text": "„Jedenfalls war die wichtigste mit Jahwe konkurrierende, weil funktionell sehr universelle Gestalt der Baal des Orts, der Eigentümer des »Landes« in wirtschaftlichem und politischem Sinn. Bei friedlicher oder gewaltsamer Angliederung von Städten an Israel verblieben diese Baale natürlich im Besitze der Stadt und ihrer Heiligtümer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc942fd9-df70-3124-875f-e1059cab27c0",
                                        "entry_id": "ddb4b4f2-4bab-3798-aac0-aa1d305112ed",
                                        "glosses": [
                                            "was (seltener: wer) das Leben beherrscht, Macht, viel Einfluss ausübt und dessen Regeln und Erfordernissen man sich deswegen unterwirft"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5902d15-ba3a-4968-9dbd-d0abff25afd4",
                                                "sense_id": "bc942fd9-df70-3124-875f-e1059cab27c0",
                                                "text": "„›Wol uns wenn unsre Seelen in ihren demüthigen schlichten Betstübchen die Ruhe und Zuversicht im Herrn finden, welche Denen stets fehlen werden die in prachtvollen Domen papistischen Greuel treiben, und Jenen die in der Welt dem rationalistischen Baal huldigen.‹“"
                                            },
                                            {
                                                "example_id": "b1e61eff-2a9d-46f8-b07e-48cb901b4075",
                                                "sense_id": "bc942fd9-df70-3124-875f-e1059cab27c0",
                                                "text": "„Massig, rätselhaft, halb jovial, halb grausam, noch im Lächeln unheimlich, ein Baal des Geldes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Baal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                        "entry_id": "7c8c6fca-3948-3ff2-8c69-6dea272b7fdf",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b644e0f3-dba5-4f18-8107-eeffb4af75a0",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Frau Baal ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ba31e34d-edf5-4fa4-bbe2-ccd5dd97344d",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Herr Baal wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a413ad72-7087-4957-ab58-574cdf642772",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Die Baals fahren heute in den Thüringer Wald."
                                            },
                                            {
                                                "example_id": "6c9d550f-5f08-46a7-9e25-64465112164e",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Der Baal trägt nie die Schals, die die Baal ihm strickt."
                                            },
                                            {
                                                "example_id": "01b37f00-38b3-42f2-ac0f-1a4c40d859a8",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baal kommt, geht der Herr Baal.“"
                                            },
                                            {
                                                "example_id": "7726c302-9cb6-4513-8f0b-4db56b8fe8f1",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Baal kommt und geht."
                                            },
                                            {
                                                "example_id": "8afa3c6f-009f-4278-a8c0-bf49c32b2d1c",
                                                "sense_id": "b937f56b-f659-331e-9e75-5f4df9db9e0a",
                                                "text": "Baals kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
