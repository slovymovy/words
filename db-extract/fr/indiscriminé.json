                    {
                        "sense_id": "1dfed325-80f6-3ed4-a127-e0185d7937f8",
                        "entry_id": "6901d3cf-0eb7-3d9c-9028-b65c7b0ad073",
                        "glosses": [
                            "Relatif à la non discrimination : qui n’est pas discriminé ou qui n'exerce aucune forme de discrimination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74365f3e-2e9f-43eb-9832-99dea12f8555",
                                "sense_id": "1dfed325-80f6-3ed4-a127-e0185d7937f8",
                                "text": "Les rebelles se sont par ailleurs rendus également coupables de bombardements indiscriminés sur des zones civiles."
                            },
                            {
                                "example_id": "e87d8445-7ac3-403a-b136-44271827ef0e",
                                "sense_id": "1dfed325-80f6-3ed4-a127-e0185d7937f8",
                                "text": "Elle s’est muée en une « guerre de l’eau », avec la boue des Deux-Sèvres pour tranchées, des procès en série et une violence institutionnelle et politique culminant aux abords du chantier de Sainte-Soline, le 25 mars 2023 : le déploiement hors de proportion des forces de sécurité et l’usage indiscriminé d’armes de guerre avait blessé, parfois gravement, des centaines d’opposants et opposantes pacifiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6c31a3d-9a9d-4f43-a15d-b61bb32c994b",
                        "source_entry_id": "6901d3cf-0eb7-3d9c-9028-b65c7b0ad073",
                        "source_sense_id": "1dfed325-80f6-3ed4-a127-e0185d7937f8",
