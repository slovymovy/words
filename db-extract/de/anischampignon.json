                                    {
                                        "sense_id": "34b1a1c2-db91-3baa-bf13-54a837ce52a0",
                                        "entry_id": "4d1ab64b-f07d-3d9c-bf80-3de554818c61",
                                        "glosses": [
                                            "Espèce de champignons à lames libres rosâtres puis brunâtres, à odeur anisée assez prononcée, au chapeau hémisphérique jeune, blanc puis jaunâtre, et au pied concolore avec anneau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e0f50c-268d-40b6-bea5-6d3b38d0225f",
                                                "sense_id": "34b1a1c2-db91-3baa-bf13-54a837ce52a0",
                                                "text": "L’ agaric des jachères, autrefois réputé comestible, est à rejeter."
                                            },
                                            {
                                                "example_id": "b77fe89c-5b27-4b3e-b113-1c18910f0e2a",
                                                "sense_id": "34b1a1c2-db91-3baa-bf13-54a837ce52a0",
                                                "text": "Habitat privilégié : l’agaric des jachères apprécie les forêts de conifères et de feuillus, mais aussi les parcs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "714f2b77-9a0f-46d9-8993-d4c486995555",
                        "source_entry_id": "c1886cfd-7a44-353f-872b-7971e9ccb025",
                        "source_sense_id": "6ce0c250-2bfa-376a-8727-25dc43480ad8",
                        "source_sense_description": "ungiftiger Pilz",
                        "target_lang_word": "boule de neige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boule de neige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "900c14bf-15ab-3455-93d5-4675221d1781",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Neige agglomérée en forme de boule utilisée comme projectile pour les jeux d’enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb19bae-bc91-4d9d-96b1-026c097b7453",
                                                "sense_id": "900c14bf-15ab-3455-93d5-4675221d1781",
                                                "text": "Il avait fortement neigé dès le début de décembre, et il y avait eu de magnifiques batailles à coups de boules de neige, au cours desquelles, malheureusement, on n’avait pu laver la figure aux deux Grangers ; […]."
                                            },
                                            {
                                                "example_id": "c1dddc73-a705-48af-a023-3e14b936db13",
                                                "sense_id": "900c14bf-15ab-3455-93d5-4675221d1781",
                                                "text": "Puis il arracha la feuille, la froissa en boule de neige et, d’un habile coup de pied, se souvenant qu’il avait naguère fait équipe au P.U.C., il expédia droit la balle au panier."
                                            },
                                            {
                                                "example_id": "a7b28b85-e391-47fe-a5b2-86553f54b8c4",
                                                "sense_id": "900c14bf-15ab-3455-93d5-4675221d1781",
                                                "text": "Quelques galopiaux à Aix s’amusaient à cribler de boules de neige des passants inoffensifs. J’étais de ceux-ci et ne savais que faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fde31b8-5b12-3b04-a2d4-0825cc09ee3d",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Objet décoratif qui contient de l’eau et des paillettes de plastique pour représenter la neige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69be6274-5694-42ef-9b77-734abff3f5ec",
                                                "sense_id": "3fde31b8-5b12-3b04-a2d4-0825cc09ee3d",
                                                "text": "Les Tour Eiffel en boule de neige ont été un grand succès commercial de l’exposition universelle de 1889."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a4e13c5-13cc-3981-b32e-b11d34a171df",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Variété à fleurs doubles de l’obier (ou viorne obier), appelée aussi caillebotte et pelote de neige."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb380829-bffd-3827-a325-f679fa256053",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Nom vulgaire de l’agaric champêtre, dit encore champignon des bruyères."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4b3a001-4a2a-379b-a0b2-cc827102bd60",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Synonyme d’agaric des jachères (espèce de champignons)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e2f07d1-1324-3b20-8103-be249da21b9e",
                                        "entry_id": "fb6b7eea-9b41-3095-a76d-2e09e5842969",
                                        "glosses": [
                                            "Conséquence en chaîne d’un événement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61015d6b-9a8a-49ab-95b3-66b79b487d8a",
                                                "sense_id": "1e2f07d1-1324-3b20-8103-be249da21b9e",
                                                "text": "La chute hier du cours de l’acier a fait boule de neige et s’est répercutée sur tous les marchés."
                                            },
                                            {
                                                "example_id": "ad465ff9-3cb8-4e53-8e70-ba7518634032",
                                                "sense_id": "1e2f07d1-1324-3b20-8103-be249da21b9e",
                                                "text": "Un rapport qui souligne l’effet « boule de neige » de l’endettement sur les finances publiques. La hausse de la dépense en 2024 « résulte d’abord de la forte progression de la charge de la dette de l’État »."
                                            }
                                        ]
                                    },
