                "senses": [
                    {
                        "sense_id": "fe2289e3-c699-325f-a0f1-6bf88d962f30",
                        "entry_id": "180b5959-2c59-3c6a-a485-2d7bf793c43c",
                        "glosses": [
                            "Backuper à nouveau."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "88620f6c-f5b7-4567-805f-52464b9b1ece",
                                "sense_id": "fe2289e3-c699-325f-a0f1-6bf88d962f30",
                                "text": "Je n'ai pas trop envie de démonter mes 3 disques internes de sauvegarde, de les rebackuper sur un autre PC pour les reformater, etc."
                            },
                            {
                                "example_id": "2bf11e8d-0c50-466d-a1ae-544e2ad082c8",
                                "sense_id": "fe2289e3-c699-325f-a0f1-6bf88d962f30",
                                "text": "Ha bon quand on change d'OS on doit rebackuper les données qu'on a déjà backupé."
                            },
                            {
                                "example_id": "4af6e196-02fc-4a3c-80d8-32fdcd58bb0b",
                                "sense_id": "fe2289e3-c699-325f-a0f1-6bf88d962f30",
                                "text": "Backuper, backuper et rebackuper. C'est facile il suffit de gérer ses fichiers par version sur son PC perso et de tout downloader dans un nouveau..."
                            }
                        ]
                    }
