    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07ac7e15-84a0-34a0-acfe-54475b3b12b7",
                    "sense_definition": "Nicht real existierende Vorstellung; etwas, das nur in der menschlichen Einbildung oder Fantasie existiert.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizei jagte monatelang einem <w>Phantom</w> nach, bis sich herausstellte, dass die Spuren verunreinigt waren."
                        },
                        {
                            "text": "Seine angebliche Traumkarriere erwies sich am Ende als ein unerreichbares <w>Phantom</w>."
                        }
                    ],
                    "synonyms": [
                        "Trugbild",
                        "Schimäre",
                        "Illusion",
                        "Hirngespinst"
                    ],
                    "antonyms": [
                        "Realität",
                        "Wirklichkeit"
                    ],
                    "common_phrases": [
                        "Jagd nach einem Phantom"
                    ]
                },
                {
                    "sense_id": "3953d135-6aa6-3f8c-816e-18d846011642",
                    "sense_definition": "Geisterhafte Gestalt, Erscheinung oder ein Gespenst.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das berühmte <w>Phantom</w> der Oper versetzte die Pariser Theaterwelt in Angst und Schrecken."
                        },
                        {
                            "text": "In der dunklen Gasse sah er plötzlich ein weißes <w>Phantom</w> lautlos an sich vorübergleiten."
                        }
                    ],
                    "synonyms": [
                        "Gespenst",
                        "Geist",
                        "Spukgestalt",
                        "Erscheinung"
                    ],
                    "common_phrases": [
                        "Phantom der Oper"
                    ]
                },
                {
                    "sense_id": "354c38e1-124d-3e4c-a96f-7182d8020c08",
                    "sense_definition": "Nachbildung eines menschlichen oder tierischen Körpers oder Organs zu Anschauungs-, Mess- und Übungszwecken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Medizinstudenten übten die schwierige Intubation zuerst an einem lebensechten <w>Phantom</w>."
                        },
                        {
                            "text": "Im Erste-Hilfe-Kurs trainierten alle Teilnehmer die Reanimation an einem speziellen <w>Phantom</w>."
                        }
                    ],
                    "synonyms": [
                        "Übungspuppe",
                        "Modell"
                    ],
                    "common_phrases": [
                        "Reanimation am Phantom"
                    ]
                }
            ]
        }
    ]
}