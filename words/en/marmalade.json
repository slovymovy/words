{
    "word_family": [
        "marmalady"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40d44a1c-b5e1-3cd7-a4a3-73f19b58d11d",
                    "sense_definition": "A type of preserve made from citrus fruit, typically oranges, containing pieces of peel and having a slightly bitter taste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spread thick <w>marmalade</w> on her morning toast.",
                            "target_lang_translations": {
                                "zh": "她在早晨的吐司上涂了厚厚一层<w>柑橘果酱</w>。"
                            }
                        },
                        {
                            "text": "The breakfast buffet offered a variety of jams and a bitter orange <w>marmalade</w>.",
                            "target_lang_translations": {
                                "zh": "早餐自助餐提供各种果酱和一种苦味<w>橙子果酱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve"
                    ],
                    "common_phrases": [
                        "orange marmalade",
                        "thick cut marmalade"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由柑橘类水果（通常是橙子）制成的果酱，含有果皮碎块，口感略带苦味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柑橘果酱",
                                "target_lang_sense_clarification": "特指含有果皮的柑橘类果酱"
                            },
                            {
                                "target_lang_word": "橙子果酱",
                                "target_lang_sense_clarification": "最常见的柑橘果酱类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "539ada7f-853d-3e1a-bf39-4fedb090e802",
                    "sense_definition": "A cat with orange or ginger-colored fur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The friendly <w>marmalade</w> cat slept peacefully on the sunny windowsill.",
                            "target_lang_translations": {
                                "zh": "那只友好的<w>橘猫</w>安静地睡在阳光明媚的窗台上。"
                            }
                        },
                        {
                            "text": "Many people find that a <w>marmalade</w> tabby has a very affectionate personality.",
                            "target_lang_translations": {
                                "zh": "许多人发现<w>橘色</w>虎斑猫性格非常粘人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ginger cat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe cat coat color."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指毛色为橙色或姜黄色的猫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "橘猫",
                                "target_lang_sense_clarification": "口语中对橙色毛发猫咪的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08ddabc1-2ea2-34ff-95ec-baab8128cbee",
                    "sense_definition": "A preserve made specifically from quince fruit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional recipe for quince <w>marmalade</w> requires slow cooking to achieve the right texture.",
                            "target_lang_translations": {
                                "zh": "传统的<w>榅桲果酱</w>配方需要慢火熬制才能达到理想的质地。"
                            }
                        },
                        {
                            "text": "She served a small dish of quince <w>marmalade</w> alongside the cheese board.",
                            "target_lang_translations": {
                                "zh": "她在奶酪拼盘旁端上了一小碟<w>榅桲果酱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quince jam"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to the original historical meaning of the word."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种专门用榅桲（quince）制成的果酱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "榅桲果酱",
                                "target_lang_sense_clarification": "历史上的原始定义，指榅桲制成的浓缩果酱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d6e10ed-2e74-3d34-9c7a-cee2537a83e9",
                    "sense_definition": "To apply or spread marmalade onto something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>marmalade</w> his toast with great care.",
                            "target_lang_translations": {
                                "zh": "他开始小心翼翼地在吐司上<w>涂抹柑橘果酱</w>。"
                            }
                        },
                        {
                            "text": "After the bread was toasted, she proceeded to <w>marmalade</w> it generously.",
                            "target_lang_translations": {
                                "zh": "面包烤好后，她大方地在上面<w>涂抹了柑橘果酱</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在某物上涂抹柑橘果酱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "涂抹柑橘果酱",
                                "target_lang_sense_clarification": "指将果酱涂在面包等食物上的动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}