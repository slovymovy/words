                        "source_sense_id": "5a94cadb-b9b6-3f3b-9ca3-3d01bea7b592",
                        "target_lang_word": "handsomeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handsomeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73308b8a-f115-3f20-b88e-96391b17d2ae",
                                        "entry_id": "07cea36b-1d71-3c9a-b4b5-24c58f9afd10",
                                        "glosses": [
                                            "The quality of being handsome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d5949b-86e8-47cc-bdda-2fc1c145e223",
                                                "sense_id": "73308b8a-f115-3f20-b88e-96391b17d2ae",
                                                "text": "Handsomeness […]is the mere animal excellence, […]beauty […]the mere imaginative."
                                            },
                                            {
                                                "example_id": "19d426ea-58d9-471c-85d4-1b1eb473a0c9",
                                                "sense_id": "73308b8a-f115-3f20-b88e-96391b17d2ae",
                                                "text": "His face looked like worn leather but retained the vestiges of an earlier handsomeness that reminded her of a Hollywood star."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e533a3a4-a57c-4a84-9581-836278a3af3f",
                        "source_entry_id": "8f4cf8d1-b805-3d83-84bd-2a5b9ebd7951",
                        "source_sense_id": "5a94cadb-b9b6-3f3b-9ca3-3d01bea7b592",
                        "target_lang_word": "neatness",
