                        "form": "das Silberbesteck"
                    },
                    {
                        "form_id": "1a9cacde-3823-4d7c-ab1e-c4a94f08183b",
                        "entry_id": "52762b54-b4a8-395d-b6ab-ff139f7d7fe8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Silberbestecke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e720c1d1-fcab-3ba1-bace-402a36f29f40",
                        "entry_id": "52762b54-b4a8-395d-b6ab-ff139f7d7fe8",
                        "glosses": [
                            "aus Silber hergestelltes Essbesteck beziehungsweise solches mit Silberauflage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0835d102-b9d6-43b3-b22c-964469f2c5d5",
                                "sense_id": "e720c1d1-fcab-3ba1-bace-402a36f29f40",
                                "text": "„Die Regeln, was man womit nicht schneiden darf, sind meines Wissens alle obsolet. Sie haben nichts mit Manieren zu tun, sondern mit dem Schonen des Silberbestecks vor Verfärbungen durch Chemikalien in bestimmten Lebensmitteln.“"
                            },
                            {
                                "example_id": "09ce7912-5e1c-49bd-bb2d-de5b908313b8",
                                "sense_id": "e720c1d1-fcab-3ba1-bace-402a36f29f40",
                                "text": "„Im Dezember 1943 wurde die Familie in Leipzig ausgebombt. Aber es gab da so einen kleinen Alukoffer, in den hat die Familie die wichtigsten Papiere, Bargeld und ein bisschen Silberbesteck getan.“"
                            },
                            {
                                "example_id": "014a9016-6c0f-4a42-bc83-615a3cf2001d",
                                "sense_id": "e720c1d1-fcab-3ba1-bace-402a36f29f40",
                                "text": "„Das Silberbesteck hätten die Flüchtlinge aus der Wagenremise mitgebracht.“"
                            },
                            {
                                "example_id": "7e572ce3-7afe-4f25-8b4a-b47a95627d56",
                                "sense_id": "e720c1d1-fcab-3ba1-bace-402a36f29f40",
                                "text": "„Sie werden mir zuhause niemals glauben, wenn ich das beschreibe, denkt sie, Kronleuchter, Kristallgläser, Silberbesteck, Rotwein in drei bauchigen Kristallglaskaraffen, und das aufgetragene Essen sieht so verlockend aus und duftet so gut, dass sich der Knoten in Guđriđurs Magen löst und heftiger Vorfreude weicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
