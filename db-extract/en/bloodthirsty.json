                                                "sense_id": "6085f966-a290-3c2e-aaab-f431bd0f6f09",
                                                "text": "Das ist ein blutrünstiger Film."
                                            },
                                            {
                                                "example_id": "8f65a924-e4d6-47e8-9898-a7a5191b8b35",
                                                "sense_id": "6085f966-a290-3c2e-aaab-f431bd0f6f09",
