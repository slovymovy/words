                ],
                "senses": [
                    {
                        "sense_id": "8da055d3-4d47-3cc4-92ae-5c3295e29565",
                        "entry_id": "72e5e53a-3143-301b-b271-4b5d70558c17",
                        "glosses": [
                            "Salamandern ähnelnd, an Salamander erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f81fa74-aae0-41bd-9717-e7f57e226034",
                                "sense_id": "8da055d3-4d47-3cc4-92ae-5c3295e29565",
                                "text": "„Im Hof hörte er einen Vogel schreien. Keine Saatkrähen in diesen obsidianfarbenen Winterbäumen, sondern seltsame Flügeltiere, bleiche, magere, salamanderartige Vögel, die nachts durch den blauen Schmelztiegel des Mondes fliegen, ohne sich dabei zu verbrennen.“"
                            },
                            {
                                "example_id": "b392002d-e77a-4617-8ee5-4dc6b59f9d4e",
                                "sense_id": "8da055d3-4d47-3cc4-92ae-5c3295e29565",
                                "text": "„Sogar die großen, hässlichen, salamanderartigen Reptilien, die nach Belieben aus der Dämmerungszone in die glühend heißen Wüsten und den nie endenden Tag überwechselten, waren allem Anschein nach harmlos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
