                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'have a ball'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень приятный или веселый опыт.",
                        "zh": "非常开心或有趣的一段经历。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кайф",
                                "target_lang_sense_clarification": "сленг, удовольствие"
                            },
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "приятное времяпрепровождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐趣",
                                "target_lang_sense_clarification": "快乐、开心的感受"
