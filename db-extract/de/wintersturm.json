                ],
                "senses": [
                    {
                        "sense_id": "74ef03d0-84c6-36c4-92c4-f546185cb905",
                        "entry_id": "e209f9a0-6133-310a-9c46-9b4566a15aa3",
                        "glosses": [
                            "Sturm, der in der Winterzeit auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f019167c-42e0-448e-85c8-4773a82c084d",
                                "sense_id": "74ef03d0-84c6-36c4-92c4-f546185cb905",
                                "text": "„Die Neptun mag ein beachtliches Kriegsschiff sein, aber einem Wintersturm könnte sie nicht standhalten.“"
                            },
                            {
                                "example_id": "5dfa0f2d-9d44-46b6-b9c3-66e0efd1aeae",
                                "sense_id": "74ef03d0-84c6-36c4-92c4-f546185cb905",
                                "text": "„Chaotische Wetterverhältnisse im ganzen Land – hören Sie gleich die aktuellen Nachrichten zum Wintersturm!““"
                            },
                            {
                                "example_id": "9beea497-6e43-4a86-9190-499f75a2da02",
                                "sense_id": "74ef03d0-84c6-36c4-92c4-f546185cb905",
                                "text": "„Der Norden des Vereinigten Königreichs ist von einem schweren Wintersturm getroffen worden.“"
                            },
                            {
                                "example_id": "514415ee-ceb7-46a3-91ea-98cc93cdeb43",
                                "sense_id": "74ef03d0-84c6-36c4-92c4-f546185cb905",
                                "text": "„Etwa fünf Prozent aller Bäume der spanischen Hauptstadt sind vom Wintersturm ‚Filomena‘ so schwer beschädigt, dass sie für die Menschen zur Gefahr werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
