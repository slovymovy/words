                    {
                        "translation_id": "b5cf0729-946d-4406-a019-8aaf11480cde",
                        "source_entry_id": "d1d3a3a4-0ebc-342b-95e0-fd98375b4d90",
                        "source_sense_id": "18948613-b1ae-3cc5-8345-a0868c45c1a8",
                        "source_sense_description": "unterhöhlt, ausgehöhlt, höhlenartig, höhlenreich, voller Höhlen",
                        "target_lang_word": "höhlenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "höhlenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                        "entry_id": "46821324-8870-3ab5-829c-6a977c9b3e0a",
                                        "glosses": [
                                            "einer Höhle ähnelnd, wie eine Höhle aussehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4600386-ad76-4d60-bc3a-feee0e5f5113",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Adolf taumelte vom Laken weg und durch das höhlenartige Dunkel unter der Matratze.“"
                                            },
                                            {
                                                "example_id": "599cb2b1-a38e-4202-8ee8-db11dc0e8c30",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Sie befanden sich in einem höhlenartigen, größtenteils leeren Restaurant an der Missouri Ave.“"
                                            },
                                            {
                                                "example_id": "83e41698-e1f8-4bbe-a2d1-a771e11cbb17",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Sie maß volle 30 Meter im Durchmesser und war 15 Meter hoch, mit niedrigen Torbogen, die sich ringsum auftaten, außer an einer Stelle, an der eine höhlenartige, schwarze, überwölbte Öffnung gähnte, die die Symmetrie der Gruft bis zu einer Höhe von nahezu vier Metern durchbrach.“"
                                            },
                                            {
                                                "example_id": "0d2b7128-00a3-49a3-890c-e137957a0836",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Ein Albtraum sich verzweigender Korridore führte sie vorbei an muffigen, höhlenartigen Vorlesungssälen, in denen, wie Jamal hätte schwören können, noch immer die Seelen verlorener Geisteswissenschaftsstudenten nach Rache dürsteten.“"
                                            },
                                            {
                                                "example_id": "ad364ee5-356d-4d33-a096-4bb25919bef5",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Jenseits der Galerie befindet sich das höhlenartige Arbeitszimmer, in dem mein Vater gestorben ist.“"
                                            },
                                            {
                                                "example_id": "13430149-0958-4ddd-a803-3c667a7f7064",
                                                "sense_id": "71443af0-173a-390a-8512-9d2543481d06",
                                                "text": "„Jede einzelne Ebene glich einem düsteren, höhlenartigen Loch, das vier gewaltige Turbinen beherbergte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
