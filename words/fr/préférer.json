                },
                {
                    "sense_id": "3d8c8dbb-d66f-307b-a761-3a3c0fef4ee5",
                    "sense_definition": "Désirer ou vouloir une chose plutôt qu'une autre, souvent pour exprimer un choix ou une volonté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "préférer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voulais rester, mais mon frère a <w>préféré</w> qu'on rentre."
                        },
                        {
                            "text": "Elle <w>préférerait</w> partir tout de suite pour éviter les embouteillages."
                        },
                        {
                            "text": "Les gens <w>préfèrent</w> rester optimistes malgré les mauvaises nouvelles."
                        }
                    ],
                    "common_phrases": [
