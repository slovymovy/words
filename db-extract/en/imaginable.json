                        ]
                    },
                    {
                        "translation_id": "d42c1b18-6d1e-4e89-963b-61b193953884",
                        "source_entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                        "source_sense_description": "able to be imagined; conceivable",
                        "target_lang_word": "imaginable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imaginable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                        "entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                                        "glosses": [
                                            "Qui peut être imaginé ; que l'on peut imaginer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe96705-be83-4e5f-ab24-410420aacecf",
                                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                                "text": "Pour en être convaincu en un moment, il faut remarquer qu'autre chose est dire qu'un Etre tres-parfait, ou qui a toutes les perfections imaginables existe, & dire qu’efectivement il existe un Etre qui a toutes les perfections imaginables, […]."
                                            },
                                            {
                                                "example_id": "fde26895-fd68-4430-8d41-e2cb0d24c56c",
                                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                                "text": "Ils se sont donné toutes les peines imaginables; soit pour s'informer du caractère de ceux qui venaient solliciter des secours, soit pour visiter eux-mêmes en personne leurs maisons, afin de se procurer les renseignemens les plus certains sur leurs facultés."
                                            },
                                            {
                                                "example_id": "a6ad3a84-37e8-4e51-8d62-dacffb8bfac4",
                                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                                            },
                                            {
                                                "example_id": "5cfdedc8-c2fa-4783-8919-e379cd18797d",
                                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                                "text": "[…]: Stendhal a montré, dans Lucien Leuwen, qu'en 1835, la monarchie parlementaire et bourgeoise de Louis-Philippe, pratiquait avec un art consommé toutes les turpitudes imaginables : on achetait l'élection d'un député avec cent mille francs, quelques nominations, quelques bureaux de tabac, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85a324c7-a05c-43d5-88a2-5ee3def591d1",
                        "source_entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                        "source_sense_description": "able to be imagined; conceivable",
                        "target_lang_word": "vorstellbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorstellbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                        "entry_id": "ee61d281-6521-30a4-bf51-2804922ddff5",
                                        "glosses": [
                                            "sich etwas vorstellen können, sich ein Bild von etwas machen können; Verwendung: häufig negativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8cb469-b727-4399-948e-9138585067bb",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Dass Herr Meier unser neuer Abteilungsleiter wird, ist durchaus vorstellbar."
                                            },
                                            {
                                                "example_id": "e0bf8d7f-abbb-4006-96d2-c047dbf5bad1",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es ist für kaum vorstellbar, dass wir in diesem Jahr von Umweltkatastrophen verschont bleiben werden."
                                            },
                                            {
                                                "example_id": "40182d86-0973-4ea8-bb24-97d4bc5176e0",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Profisportler, egal ob Radfahrer, Fußballer oder Basketballer, ist heute kaum noch vorstellbar ohne Werbung irgendwo auf der Kleidung. Aber wenn man Bilder aus den 50er und 60ern sieht, wird man eines besseren belehrt."
                                            },
                                            {
                                                "example_id": "34584982-0768-420f-aca3-2edc528f58da",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Noch vor wenigen Monaten war es kaum vorstellbar: Jetzt erlaubt die US-Regierung zum ersten Mal seit über 50 Jahren einige Importe aus Kuba."
                                            },
                                            {
                                                "example_id": "b4b529fb-6f26-4266-8d8c-8ae65f2933af",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es schien eigentlich kaum vorstellbar, dass es zwischen Deutschland und Israel nach dem Holocaust noch \"normale\" Beziehungen geben könne. Und doch gibt es Normalität in der Anormalität, meint Alexander Kudascheff."
                                            },
                                            {
                                                "example_id": "fc632778-ca9d-4af8-a79a-e5cf7e8ae826",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Rockkonzert, ohne die Musik zu hören? Für die meisten ist das nicht vorstellbar. Doch Laura Schwengber macht durch Zeichensprache, Bewegung und Tanz auch für Gehörlose ein lebendiges Konzerterlebnis möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
