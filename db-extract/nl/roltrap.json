                                        "glosses": [
                                            "Escalier mécaniquement entraîné destiné au transport ascendant ou descendant de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f16f63b-dc04-463c-b587-258261461304",
                                                "sense_id": "dab2a512-7df4-34fb-98e2-09110f050d53",
                                                "text": "Le premier escalier roulant a été présenté au Salon de Paris en 1900."
                                            },
                                            {
                                                "example_id": "be777cfc-df60-4422-9f29-62e8fefaa0db",
                                                "sense_id": "dab2a512-7df4-34fb-98e2-09110f050d53",
                                                "text": "L’escalier roulant du magasin du Louvre a été construit par la maison Piat, de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
