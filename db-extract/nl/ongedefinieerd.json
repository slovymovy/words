                "senses": [
                    {
                        "sense_id": "6e96db65-9748-3a46-9d9f-a1e70761a7f7",
                        "entry_id": "90c9cda8-797d-3c84-ae1c-eb2d4a412e8e",
                        "glosses": [
                            "niet precies te omschrijven, niet duidelijk vastgelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349c00d1-94d5-4ad8-b938-bd076eb3bbb7",
                                "sense_id": "6e96db65-9748-3a46-9d9f-a1e70761a7f7",
                                "text": "De deling van nul door nul is ongedefinieerd in de wiskunde."
                            },
                            {
                                "example_id": "6b7be755-3b74-48a0-9c11-ec91805f47eb",
                                "sense_id": "6e96db65-9748-3a46-9d9f-a1e70761a7f7",
                                "text": "In een vreemde stad, waar zij niemand kent en niemand haar, waar zij ongedefinieerd is, voelt zij zich op haar gemak."
                            }
                        ]
                    },
                    {
                        "sense_id": "6154097a-68ef-3126-b3d8-363bc8de77bc",
                        "entry_id": "90c9cda8-797d-3c84-ae1c-eb2d4a412e8e",
                        "glosses": [
                            "geen goede indruk makend"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9a7a0313-a96c-4fe2-b7c0-5d27414ac380",
                                "sense_id": "6154097a-68ef-3126-b3d8-363bc8de77bc",
                                "text": "De totaalklank tegen het einde van de Trauermarsch was als klonterige Brinta-pap: troebel, log en ongedefinieerd."
                            },
                            {
                                "example_id": "6a816afd-e815-4f29-a0b5-aec0fc757fd8",
                                "sense_id": "6154097a-68ef-3126-b3d8-363bc8de77bc",
                                "text": "De Denen zweren bijvoorbeeld bij frikadeller - niet die ongedefinieerde stukken gefrituurd vlees die wij in de snackbar bestellen, maar een soort platte gehaktbal van vis die wordt geserveerd met remouladesaus."
                            }
                        ]
                    }
