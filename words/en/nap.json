                    ],
                    "target_lang_definitions": {
                        "ru": "Карточная игра, в которой игроки берут взятки, официально известная как «Наполеон».",
                        "zh": "一种名为“拿破仑”的纸牌游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполеон",
                                "target_lang_sense_clarification": "карточная игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拿破仑牌",
                                "target_lang_sense_clarification": "一种纸牌游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "432203c9-99ca-3c22-821b-c9c4af230812",
                    "sense_definition": "A bid to take all five tricks in the card game Napoleon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "card games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went for a <w>nap</w>, hoping to win the entire round.",
                            "target_lang_translations": {
                                "ru": "Она объявила <w>наполеон</w>, надеясь выиграть весь раунд.",
                                "zh": "她叫了<w>拿破仑</w>，希望能赢得整局。"
                            }
                        },
                        {
                            "text": "Winning a <w>nap</w> is the highest achievement in this particular card game.",
