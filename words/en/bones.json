{
    "word_family": [
        "bony",
        "boneless",
        "debone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c3abac5-b8ba-3df4-93a0-fe16d4e8db92",
                    "sense_definition": "plural of <w>bone</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "skeleton",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog buried several large <w>bones</w> in the garden.",
                            "target_lang_translations": {
                                "tr": "Köpek bahçeye birkaç büyük <w>kemik</w> gömdü."
                            }
                        },
                        {
                            "text": "He broke two <w>bones</w> in his leg during the football match.",
                            "target_lang_translations": {
                                "tr": "Futbol maçı sırasında bacağındaki iki <w>kemiği</w> kırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broken bones",
                        "bare bones",
                        "dry bones"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"bone\" (kemik) kelimesinin çoğul hali; kemikler."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kemikler",
                                "target_lang_sense_clarification": "iskelet parçaları"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f06be7d9-f9db-37b9-9975-872aa4544566",
                    "sense_definition": "The essential structural framework or foundation of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house still stands strong because its <w>bones</w> are solid.",
                            "target_lang_translations": {
                                "tr": "Eski ev hala sapasağlam ayakta çünkü <w>iskeleti</w> sağlam."
                            }
                        },
                        {
                            "text": "We have the basic <w>bones</w> of a plan ready for the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantı için bir planın temel <w>çatısını</w> hazır ettik."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good bones"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yapının veya fikrin temel iskeleti, ana çatısı veya ana hatları."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iskelet",
                                "target_lang_sense_clarification": "bir şeyin ana çatısı"
                            },
                            {
                                "target_lang_word": "çatı",
                                "target_lang_sense_clarification": "temel yapı"
                            },
                            {
                                "target_lang_word": "ana hatlar",
                                "target_lang_sense_clarification": "temel unsurlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b9f932-5b99-3eba-941b-d25c0def8391",
                    "sense_definition": "A pair or set of dice used in gambling or board games.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shook the <w>bones</w> in his hand before rolling them on the table.",
                            "target_lang_translations": {
                                "tr": "Masanın üstüne atmadan önce <w>zarları</w> elinde salladı."
                            }
                        },
                        {
                            "text": "The players sat in an alley rolling the <w>bones</w> for cash.",
                            "target_lang_translations": {
                                "tr": "Oyuncular ara sokakta oturup para için <w>zar atıyorlardı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roll the bones"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal gambling term"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kumarda veya masa oyunlarında kullanılan bir çift veya bir set zar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zar",
                                "target_lang_sense_clarification": "oyun zarı, argo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73906e61-5c1e-353c-8bf6-76fd889cf013",
                    "sense_definition": "A percussive folk musical instrument consisting of a pair of curved pieces, often made of animal ribs or wood, clicked together in the hand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician played the <w>bones</w> with impressive rhythm during the tune.",
                            "target_lang_translations": {
                                "tr": "Müzisyen melodi sırasında etkileyici bir ritimle <w>kemikleri</w> çaldı."
                            }
                        },
                        {
                            "text": "Traditional folk songs were often accompanied by someone clicking the <w>bones</w>.",
                            "target_lang_translations": {
                                "tr": "Geleneksel halk şarkılarına genellikle <w>ritim kemiklerini</w> şakırdatan biri eşlik ederdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play the bones"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle hayvan kaburgası veya tahtadan yapılmış, elde birbirine vurularak çalınan ritim çalgısı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kemik çalgı",
                                "target_lang_sense_clarification": "vurmalı halk çalgısı"
                            },
                            {
                                "target_lang_word": "kastanyet benzeri ritim aleti",
                                "target_lang_sense_clarification": "kemik veya ahşap ritim çubukları"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f50ce6d-9785-357c-b558-f9be4216d30e",
                    "sense_definition": "A fist bump; an informal gesture of greeting, solidarity, or congratulations where two fists touch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He greeted his friend in the hallway with a smile and gave him <w>bones</w>.",
                            "target_lang_translations": {
                                "tr": "Koridorda arkadaşını bir gülümsemeyle selamladı ve onunla <w>yumruk tokuşturdu</w>."
                            }
                        },
                        {
                            "text": "Give me some <w>bones</w> for that great performance on stage.",
                            "target_lang_translations": {
                                "tr": "Sahnedeki o harika performans için bir <w>yumruk tokuşturalım</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fist bump",
                        "props"
                    ],
                    "common_phrases": [
                        "give bones"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal greeting gesture"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yumruk tokuşturma; samimi bir tebrik veya selamlama hareketi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yumruk tokuşturma",
                                "target_lang_sense_clarification": "selamlaşma hareketi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a66bda6c-2074-30b8-8611-6bef8cd69c53",
                    "sense_definition": "A surgeon, especially in military or nautical contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew called for <w>Bones</w> when the sailor fell from the mast.",
                            "target_lang_translations": {
                                "tr": "Denizci direkten düştüğünde mürettebat hemen <w>cerrahı</w> çağırdı."
                            }
                        },
                        {
                            "text": "Our old regimental <w>Bones</w> managed to patch up dozens of wounded soldiers.",
                            "target_lang_translations": {
                                "tr": "Alayımızın emektar <w>doktoru</w> düzinelerce yaralı askeri iyileştirmeyi başardı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "traditional military and naval slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle askeri veya denizcilik bağlamında cerrah veya askeri doktor (argo/lakap)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cerrah",
                                "target_lang_sense_clarification": "askeri/denizci argosu"
                            },
                            {
                                "target_lang_word": "doktor",
                                "target_lang_sense_clarification": "askeri/denizci argosu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58b21841-7027-358f-bfc3-9564bf63bea7",
                    "sense_definition": "third-person singular simple present indicative of <w>bone</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef carefully <w>bones</w> the fish before preparing the sauce.",
                            "target_lang_translations": {
                                "tr": "Şef sosu hazırlamadan önce balığın <w>kılçıklarını</w> dikkatle <w>ayıklar</w>."
                            }
                        },
                        {
                            "text": "She <w>bones</w> the chicken breasts quickly with a very sharp knife.",
                            "target_lang_translations": {
                                "tr": "Çok keskin bir bıçakla tavuk göğüslerinin <w>kemiklerini</w> çabucak <w>ayıklar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular simple present"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"bone\" (kemiğini veya kılçığını ayıklamak) fiilinin geniş zaman üçüncü tekil şahıs hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kılçıklarını ayıklar",
                                "target_lang_sense_clarification": "balık için"
                            },
                            {
                                "target_lang_word": "kemiklerini ayıklar",
                                "target_lang_sense_clarification": "et veya tavuk için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6b680652-3ebd-3b2f-8d15-b7f37ee3d331",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bones</w> arrived at the office early this morning for his appointment.",
                            "target_lang_translations": {
                                "tr": "Bay <w>Bones</w> randevusu için bu sabah ofise erken geldi."
                            }
                        },
                        {
                            "text": "The award was presented to Professor <w>Bones</w> for her research.",
                            "target_lang_translations": {
                                "tr": "Ödül araştırmalarından dolayı Profesör <w>Bones</w>'a takdim edildi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Bones",
                                "target_lang_sense_clarification": "özel soyadı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39e257f4-e845-3adf-bfc0-5328ae5df408",
                    "sense_definition": "plural of <w>Bone</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Bones</w> are hosting a large dinner party for their neighbours tonight.",
                            "target_lang_translations": {
                                "tr": "<w>Bones ailesi</w> bu akşam komşuları için büyük bir akşam yemeği partisi veriyor."
                            }
                        },
                        {
                            "text": "We spent the entire weekend visiting the <w>Bones</w> at their countryside home.",
                            "target_lang_translations": {
                                "tr": "Bütün hafta sonunu <w>Bone'ları</w> kır evlerinde ziyaret ederek geçirdik."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of proper name"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Bone\" soyadına sahip aile bireylerini belirten çoğul hal (Bone ailesi)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Bone'lar",
                                "target_lang_sense_clarification": "Bone ailesi mensupları"
                            },
                            {
                                "target_lang_word": "Bone ailesi",
                                "target_lang_sense_clarification": "aile bireyleri"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}