                "senses": [
                    {
                        "sense_id": "b82915f1-594e-3041-8291-b27d04b8a30c",
                        "entry_id": "46f7b6c7-e142-3849-9a78-87e4de6ac289",
                        "glosses": [
                            "Donner un caractère imaginaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2c86c0-13d2-4deb-a966-3a3b3fbe6cb6",
                                "sense_id": "b82915f1-594e-3041-8291-b27d04b8a30c",
                                "text": "Elle n’a de cesse d'imaginariser la lettre."
                            },
                            {
                                "example_id": "6c237026-6b7e-4737-a772-7e369f3b0c05",
                                "sense_id": "b82915f1-594e-3041-8291-b27d04b8a30c",
                                "text": "Dans le trauma, le réel fait irruption laissant le sujet sans recours pour l'imaginariser ou le symboliser."
                            },
                            {
                                "example_id": "b9a52520-3a95-455b-91b2-fa6f70004f8e",
                                "sense_id": "b82915f1-594e-3041-8291-b27d04b8a30c",
                                "text": "La castration, elle, n'est plus à imaginariser par la différence anatomique, car elle est un fait de structure lié à la prise de l'être humain dans le langage."
                            }
                        ]
                    }
