                                        "glosses": [
                                            "Ausfluss für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6195b5f-cb14-49fe-9083-7ca63290338c",
                                                "sense_id": "3af49ffc-f678-3639-9d78-253cae29f17f",
                                                "text": "Am Ende des Rohres befindet sich der Auslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57685d68-18e1-343e-b5a6-1d7914effe6b",
                                        "entry_id": "91ad6976-ede9-3eef-98b8-281c3589d0d8",
                                        "glosses": [
                                            "Strecke oder Zone, in der Abbremsen ermöglicht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784a3e71-d45a-4c40-bbd0-c7f2e99bf102",
                                                "sense_id": "57685d68-18e1-343e-b5a6-1d7914effe6b",
                                                "text": "Nach der Ziellinie betritt der Sportler den Auslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c34f58c8-9e92-34f9-bc82-6537cc45fa1b",
                                        "entry_id": "91ad6976-ede9-3eef-98b8-281c3589d0d8",
                                        "glosses": [
                                            "Zeitpunkt oder Bereich, an dem etwas endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6eac1d-38e2-4cb7-99cb-8339189d6f9c",
                                                "sense_id": "c34f58c8-9e92-34f9-bc82-6537cc45fa1b",
                                                "text": "Am Auslauf des Waldes befinden sich große Weideflächen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "befb02a8-89c5-45be-a541-1b733d8b9710",
                        "source_entry_id": "485025cb-eab0-364d-8425-138108ec063d",
                        "source_sense_id": "003ceafb-ded5-34d7-a165-6b8932cddad4",
                        "target_lang_word": "Auslass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auslass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27df98ca-1358-3fb8-9bb7-e8380aa0b5b3",
                                        "entry_id": "dfcd7099-04f5-3f6f-a424-ee710c4c7518",
                                        "glosses": [
                                            "Möglichkeit, z. B. Öffnung, durch die etwas entweichen, austreten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcc7f5a3-8528-4c13-aae8-1d2bd07ea63c",
                                                "sense_id": "27df98ca-1358-3fb8-9bb7-e8380aa0b5b3",
                                                "text": "„Doch der Ring lässt sich öffnen – dann erst wird der Auslass für den Kaffee sichtbar.“"
                                            },
                                            {
                                                "example_id": "6a8fa92b-3bea-440b-b541-37d55569ddf0",
                                                "sense_id": "27df98ca-1358-3fb8-9bb7-e8380aa0b5b3",
                                                "text": "„So, wie man sie nicht nicht streicheln kann, so wenig kann man nicht nicht mit seinen Katzen reden, wenn sie schon wieder vor der Balkontür sitzen und Auslass fordern, weil ihnen der Weg zur Katzenklappe zu beschwerlich ist.“"
                                            },
                                            {
                                                "example_id": "07f7df2e-c0d8-446e-919d-ffb3809ed56b",
                                                "sense_id": "27df98ca-1358-3fb8-9bb7-e8380aa0b5b3",
                                                "text": "„Noch-Minister Reichhold forciert den Technologietransfer zu Klein- und Mittelbetrieben, die Industrie sieht das ARCS, zu dem auch Arsenal Research gehört, als ‚Center of Excellence‘ und Auslass für EU- Gelder sowie als Andockstelle für die Technologiefördertöpfe der Länder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
