                    }
                ],
                "senses": [
                    {
                        "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                        "entry_id": "9f749943-278c-3e84-af72-2ea395ba21cb",
                        "glosses": [
                            "разг., фам. с шумом упасть либо удариться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5caeba-0adc-4f8b-a37d-ada2cc0cad34",
                                "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                                "text": "Грохнуться с лестницы."
                            },
                            {
                                "example_id": "4495c9e5-b3c1-4c0f-b761-4d68b9ea039c",
                                "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                                "text": "Грохнуться о́б пол."
                            },
                            {
                                "example_id": "20467538-63c4-4444-9ee1-dcbf776d6c37",
                                "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                                "text": "Грохнуться навзничь."
                            },
                            {
                                "example_id": "b41f3543-8007-421d-9d66-ba2c91657f33",
                                "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                                "text": "Анатолий грохнулся на пол."
                            },
                            {
                                "example_id": "afbb8cf1-2dc4-45ea-bf51-7ed98843df40",
                                "sense_id": "52a23175-bd50-3522-8f4e-07e34a353806",
                                "text": "Не надо раскачивать его ― грохнется в самый неподходящий момент."
                            }
                        ]
                    },
                    {
                        "sense_id": "d439f05e-9e4f-34c6-8778-bbd694dd76e8",
                        "entry_id": "9f749943-278c-3e84-af72-2ea395ba21cb",
                        "glosses": [
                            "перен., жарг. сломаться, погибнуть, потерпеть крах, закончиться неудачей, не состояться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a45ff9-3562-48a4-b79f-83454938800b",
                                "sense_id": "d439f05e-9e4f-34c6-8778-bbd694dd76e8",
                                "text": "Потому что ребята дают тольку такую гарантию: если поставленный ими винчестер грохнется (вместе с данными!), они его заменят."
                            }
                        ]
                    }
                ],
