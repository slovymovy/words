                                "target_senses": [
                                    {
                                        "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                        "entry_id": "49e40cd0-ba92-3c56-8412-d3904b9742ff",
                                        "glosses": [
                                            "für Toilette^([1])"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191cfeb3-41d5-4b3d-acb7-6345025ecad5",
                                                "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                                "text": "Er liest auf dem Lokus immer Zeitung."
                                            },
                                            {
                                                "example_id": "eb910b65-4f52-4ad7-9ce4-ae95989134b6",
                                                "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                                "text": "„Was ist zu tun nach einer solchen Heimkehr? Nur Nebensächliches. Satt essen, gründlich waschen, ausruhen, zum Lokus gehen, eine Zigarette rauchen.“"
                                            },
                                            {
                                                "example_id": "96ec005b-2dfa-4a95-932b-455b70cd872b",
                                                "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                                "text": "„Er steht in der Tür zum Lokus, und knöpft ganz unnötig an seinen Hosenträgern herum.“"
                                            },
                                            {
                                                "example_id": "9dd5f6b5-cf83-455d-accb-d146ac344299",
                                                "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                                "text": "„Als die ersten Gäste klingelten, Onkel Walter und Tante Hilde samt Trabanten, thronte Mama auf dem Lokus, und dann klingelte noch das Telefon.“"
                                            },
                                            {
                                                "example_id": "5a78619a-002d-4f27-820b-b674581c84c3",
                                                "sense_id": "723b130f-e555-3a05-9f60-594afb6b3bb7",
                                                "text": "„Wie ich in dem Waschraum meinen Latz zuknöpfe, sehe ich eine von ihnen darauf warten, daß ihre Freundin aus dem Lokus herauskommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
