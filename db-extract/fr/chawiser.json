                        "examples": [
                            {
                                "example_id": "c07ce189-db4a-41d7-94c8-276b7e5058df",
                                "sense_id": "72963066-c5ee-3d53-975d-fdf0ca9e4bfd",
                                "text": "Les Chawis appellent ce carrefour Lebrachma, certainement un mot d’origine française, chawisé."
                            },
                            {
                                "example_id": "e92f8507-3a30-436d-a2d2-8892bf251629",
                                "sense_id": "72963066-c5ee-3d53-975d-fdf0ca9e4bfd",
                                "text": "Honnêtement, connaissez-vous un Arabe, un Canadien, un Hindou, etc., lequel accepterait de se kabyliser, de se chawiser, sinon se japoniser par la force ?"
                            }
