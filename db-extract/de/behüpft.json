                ],
                "senses": [
                    {
                        "sense_id": "b2774283-d3de-3448-8320-e6274d772950",
                        "entry_id": "23f3dc73-7c7c-3797-bac7-1fcb21e2ed6e",
                        "glosses": [
                            "auf hüpfende Weise betreten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150c8e33-014b-4cef-9311-2ab55a403683",
                                "sense_id": "b2774283-d3de-3448-8320-e6274d772950",
                                "text": "„… in die feinsten Wasserfasern sich auflösender Alpengüsse auf das mild anziehende, blumendurchwirkte Grün der von klingelnden Herden behüpften Matten, …“"
                            },
                            {
                                "example_id": "508909f2-8411-4b8a-8788-58cd1aa42597",
                                "sense_id": "b2774283-d3de-3448-8320-e6274d772950",
                                "text": "„Ein Gang zum wieder stark behüpften Luftkissen in Begleitung der mittelalterlichen Belegschaft in Holzschuhen rundete das Zwischenziel des Besuchs ab, …“"
                            },
                            {
                                "example_id": "891afc37-136f-47ec-9cb9-4556c5dde64f",
                                "sense_id": "b2774283-d3de-3448-8320-e6274d772950",
                                "text": "„Ein unentwegt behüpftes Trampolin erfreut sich im Kinderbereich großer Beliebtheit, und eine Kinderschar jagt einem Clown nach, der so tut, als würde er über das Gewirr der Abspannseile stolpern.“"
                            },
                            {
                                "example_id": "d8eed136-c6ad-4740-b846-435a9e229729",
                                "sense_id": "b2774283-d3de-3448-8320-e6274d772950",
                                "text": "„Der einzige Zeitpunkt der Tour, in dem meine Beine doch etwas mehr schlottern als das behüpfte Zeltdach, kommt am Ende – als die Tür aufgeht und ich mich etwa 35 Meter über dem Boden des Olympiastations einfach fallen lassen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
