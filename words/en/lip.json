{
    "word_family": [
        "lipstick",
        "lipread",
        "lip-sync",
        "lippy",
        "lipgloss",
        "lipbalm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6587ce15-d4d9-39a9-889d-0580f4b09048",
                    "sense_definition": "Either of the two fleshy protrusions around the opening of the mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied bright red lipstick to her <w>lips</w> before the party.",
                            "target_lang_translations": {
                                "ru": "Она нанесла ярко-красную помаду на <w>губы</w> перед вечеринкой.",
                                "zh": "派对前，她在<w>嘴唇</w>上涂了鲜红色的口红。"
                            }
                        },
                        {
                            "text": "He bit his lower <w>lip</w> nervously while waiting for the results.",
                            "target_lang_translations": {
                                "ru": "Он нервно кусал нижнюю <w>губу</w> в ожидании результатов.",
                                "zh": "等待结果时，他紧张地咬着下<w>嘴唇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bite your lip",
                        "read my lips",
                        "stiff upper lip",
                        "upper lip",
                        "lower lip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух кожно-мышечных складок, окружающих вход в ротовую полость.",
                        "zh": "口腔周围的两片肉质部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губа",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "уста",
                                "target_lang_sense_clarification": "поэтическое или устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘴唇",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "唇",
                                "target_lang_sense_clarification": "书面语或解剖学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b258d266-fa8c-3743-b09a-8fcd44d9377d",
                    "sense_definition": "The projecting rim of an open container, bell, or similar object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coffee spilled over the <w>lip</w> of the mug and onto the table.",
                            "target_lang_translations": {
                                "ru": "Кофе перелился через <w>край</w> кружки на стол.",
                                "zh": "咖啡从杯<w>口</w>溢出，洒在了桌子上。"
                            }
                        },
                        {
                            "text": "There is a small chip on the <w>lip</w> of this glass vase.",
                            "target_lang_translations": {
                                "ru": "На <w>ободке</w> этой стеклянной вазы есть маленький скол.",
                                "zh": "这个玻璃花瓶的<w>边缘</w>有一个小缺口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rim",
                        "edge"
                    ],
                    "common_phrases": [
                        "lip of the cup",
                        "lip of the bottle",
                        "over the lip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий край открытого сосуда или похожего предмета.",
                        "zh": "容器、钟或其他类似物体的突出边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "верхняя граница"
                            },
                            {
                                "target_lang_word": "ободок",
                                "target_lang_sense_clarification": "выступающая кайма"
                            },
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "острый край"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "物体的边沿"
                            },
                            {
                                "target_lang_word": "口",
                                "target_lang_sense_clarification": "容器的开口处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e2fc5f6-7400-312b-b9e0-00c150f977e5",
                    "sense_definition": "Backtalk; verbal impertinence or rudeness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't give me any <w>lip</w> about doing your chores.",
                            "target_lang_translations": {
                                "ru": "Не смей мне <w>дерзить</w> по поводу своих обязанностей.",
                                "zh": "别因为做家务的事跟我<w>顶嘴</w>。"
                            }
                        },
                        {
                            "text": "The student got in trouble for giving <w>lip</w> to the principal.",
                            "target_lang_translations": {
                                "ru": "Ученик попал в неприятности за <w>дерзость</w> директору.",
                                "zh": "那个学生因为对校长<w>无礼</w>而惹上了麻烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backchat",
                        "cheek",
                        "impudence",
                        "rudeness",
                        "insolence"
                    ],
                    "common_phrases": [
                        "give someone lip",
                        "none of your lip",
                        "watch your lip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts to describe rude replies"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерзкий ответ или словесная грубость.",
                        "zh": "无礼的回答或顶嘴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзость",
                                "target_lang_sense_clarification": "грубый ответ"
                            },
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "вызывающее поведение"
                            },
                            {
                                "target_lang_word": "нахальство",
                                "target_lang_sense_clarification": "бесцеремонность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶嘴",
                                "target_lang_sense_clarification": "无礼地反驳"
                            },
                            {
                                "target_lang_word": "无礼",
                                "target_lang_sense_clarification": "态度傲慢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be7d2c24-000d-3741-acf0-b4c11a049f54",
                    "sense_definition": "The edge of a high spot of land, such as a cliff or canyon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stood at the <w>lip</w> of the canyon and looked down at the river below.",
                            "target_lang_translations": {
                                "ru": "Мы стояли на <w>краю</w> каньона и смотрели вниз на реку.",
                                "zh": "我们站在峡谷的<w>边缘</w>，俯瞰着下方的河流。"
                            }
                        },
                        {
                            "text": "The car stopped safely just before the <w>lip</w> of the steep drop.",
                            "target_lang_translations": {
                                "ru": "Машина благополучно остановилась прямо перед <w>кромкой</w> крутого обрыва.",
                                "zh": "汽车在陡坡的<w>边缘</w>前安全地停了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "edge"
                    ],
                    "common_phrases": [
                        "lip of the cliff",
                        "lip of the crater",
                        "lip of the falls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Край высокого участка земли, например, обрыва или каньона.",
                        "zh": "高地（如悬崖或峡谷）的边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "граница обрыва"
                            },
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "грань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "地形的边沿"
                            },
                            {
                                "target_lang_word": "崖边",
                                "target_lang_sense_clarification": "悬崖的边缘"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4aa4890-a89f-3a15-a0a1-1357d9f5f9c2",
                    "sense_definition": "To hit the edge of the hole without dropping in (used in sports like golf).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His putt <w>lipped</w> the cup and rolled two feet past.",
                            "target_lang_translations": {
                                "ru": "Его мяч <w>прошел по краю</w> лунки и укатился на два фута дальше.",
                                "zh": "他推的球<w>擦过</w>了洞口，又滚出了两英尺远。"
                            }
                        },
                        {
                            "text": "I thought the ball would go in, but it just <w>lipped</w> out.",
                            "target_lang_translations": {
                                "ru": "Я думал, мяч попадет, но он <w>выскочил, задев край</w>.",
                                "zh": "我以为球会进，结果它只是<w>擦过</w>洞口弹了出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lip out",
                        "lip the hole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удариться о край лунки, не падая в неё (в спорте).",
                        "zh": "在体育运动（如高尔夫）中，球触碰到洞口边缘但未落入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пройти по краю",
                                "target_lang_sense_clarification": "о мяче"
                            },
                            {
                                "target_lang_word": "задеть край",
                                "target_lang_sense_clarification": "коснуться края"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦过",
                                "target_lang_sense_clarification": "球触碰边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e92985a6-a664-3912-a6af-24829928ba47",
                    "sense_definition": "To simulate speech by moving the lips without making any sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>lipped</w> a silent warning to his friend across the room.",
                            "target_lang_translations": {
                                "ru": "Он <w>одними губами произнес</w> безмолвное предупреждение своему другу через всю комнату.",
                                "zh": "他隔着房间向朋友<w>动了动嘴唇</w>，发出无声的警告。"
                            }
                        },
                        {
                            "text": "She <w>lipped</w> the words to the song as the band played.",
                            "target_lang_translations": {
                                "ru": "Она <w>повторяла губами</w> слова песни, пока играла группа.",
                                "zh": "乐队演奏时，她跟着<w>动嘴唇</w>唱着歌词。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитировать речь движением губ без звука.",
                        "zh": "仅通过嘴唇动作模拟说话，不发出声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произносить одними губами",
                                "target_lang_sense_clarification": "беззвучно"
                            },
                            {
                                "target_lang_word": "шевелить губами",
                                "target_lang_sense_clarification": "имитировать речь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动嘴唇",
                                "target_lang_sense_clarification": "无声模仿"
                            },
                            {
                                "target_lang_word": "口型",
                                "target_lang_sense_clarification": "做出口型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc0b0b5e-7040-3480-b46f-2ac8b722677c",
                    "sense_definition": "To wash against a surface or touch lightly, often used regarding water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle waves <w>lipped</w> against the side of the small boat.",
                            "target_lang_translations": {
                                "ru": "Легкие волны <w>плескались</w> о борт маленькой лодки.",
                                "zh": "轻柔的波浪<w>拍打</w>着小船的侧面。"
                            }
                        },
                        {
                            "text": "The rising river <w>lipped</w> the top of the bank before receding.",
                            "target_lang_translations": {
                                "ru": "Поднимающаяся река <w>лизала</w> верхушку берега, прежде чем отступить.",
                                "zh": "上涨的河水在退去前<w>轻拍</w>着河岸的顶部。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often found in literary or poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягко касаться поверхности или плескаться о неё (о воде).",
                        "zh": "指水流轻轻拍打或触碰表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плескаться",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "лизать",
                                "target_lang_sense_clarification": "метафорически о волнах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "水流触碰"
                            },
                            {
                                "target_lang_word": "轻拍",
                                "target_lang_sense_clarification": "水波轻触"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}