                                "target_senses": [
                                    {
                                        "sense_id": "783b2932-47dd-30a2-946e-1b967caad320",
                                        "entry_id": "a9711c0c-8ee9-306f-b0fb-507aba995d21",
                                        "glosses": [
                                            "Somewhat young."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdca715-234a-41ad-b8ce-7ba9865023ed",
                                                "sense_id": "783b2932-47dd-30a2-946e-1b967caad320",
                                                "text": "In spite of his youngish appearance, he had much experience."
                                            },
                                            {
                                                "example_id": "7257d147-e745-4d6a-833f-9557bb967cde",
                                                "sense_id": "783b2932-47dd-30a2-946e-1b967caad320",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d616124f-3d37-42bd-9900-42c1c5550cb7",
