                                    {
                                        "sense_id": "5e70cf04-26c5-35b4-a18f-beae7b5ecd7c",
                                        "entry_id": "03698a92-94e5-36d1-873f-20db557abb37",
                                        "glosses": [
                                            "(Syzygium jambos) Árbol de la familia de las mirtáceas, nativo de la India y naturalizado en América tropical. Muestra hojas opuestas, lanceoladas e inflorescencia corimbosa, que fructifica en una baya redonda, de 2 a 5 cm de diámetro, de color amarillo verdoso, a veces algo rojizo. Su pulpa es de sabor agradable, blanca y firme."
                                        ],
                                        "tags": [
                                            "Árboles"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b190296-d897-4897-8e94-f2e1197a896f",
                        "source_entry_id": "c2d2e4e7-7514-3872-943c-05235ef06e49",
                        "source_sense_id": "dcef7122-6cbf-38d8-9893-1b1cff4225d0",
                        "target_lang_word": "Jambus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jambus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                        "entry_id": "b457c736-0fa0-3f1a-899d-6fa782be2cb2",
                                        "glosses": [
                                            "rhythmische Einheit, bei der erst eine kurze oder unbetonte, dann eine lange oder betonte Silbe auftritt"
                                        ],
                                        "tags": [
                                            "Lyrik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468a56a6-fcb3-4009-a9b3-88b5c678fab1",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "Die Struktur der Wörter Verstand, Ersatz, genau, Vernunft ist immer ein Jambus."
                                            },
                                            {
                                                "example_id": "6db0f8aa-ff5e-4346-bb6f-a63e92dc7a63",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "„Das Heft wimmelte von Ausdrücken wie Skandieren, Spondeus, Jambus, Molossus und anderen antiken Versfüßen, das alles sorgfältig, fast schon kalligraphisch eingetragen.“"
                                            },
                                            {
                                                "example_id": "d7a669de-2769-43a6-857f-807f487f4213",
                                                "sense_id": "51071b13-9bed-3b33-a4ea-fc378b8d3a76",
                                                "text": "„Das Versmaß des Gedichts ist, fürs erste Lesen, nicht anspruchsvoll, ein fünfhebiger Jambus, doch dieser verlangt, je nach Zeile, eine genaue, dem Gesprochenen gemäße Rhythmisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d678327f-2778-4dd0-9e1b-934356df44df",
                        "source_entry_id": "c2d2e4e7-7514-3872-943c-05235ef06e49",
