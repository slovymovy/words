                                "target_senses": [
                                    {
                                        "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                        "entry_id": "fbf1fee1-aba6-31c2-96fb-ff630db3861e",
                                        "glosses": [
                                            "An athletic contest comprising seven events; contested mostly by women, for whom this is an Olympic sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60faf51-b021-40d3-857c-3272eeea6a13",
                                                "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                                "text": "[Carolina Kluft] has won her last 19 heptathlons. Only the legendary Jackie Joyner-Kersee has scored higher."
                                            },
                                            {
                                                "example_id": "3eae6477-83ce-4c60-ba49-681cbbc8f7b8",
                                                "sense_id": "282e188c-24e4-34ce-b6fc-ccb51f552afa",
                                                "text": "For now, Gray and her peers are able to compete for Olympic berths only in the seven-event heptathlon, while the decathlon is restricted to men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
