            {
                "entry_id": "2cf7d596-d281-38ab-8de2-ede458bbbc95",
                "word": "gerijmel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                        "entry_id": "2cf7d596-d281-38ab-8de2-ede458bbbc95",
                        "glosses": [
                            "het schrijven van rijmende gedichtjes van weinig literaire kwaliteit"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "adcab8bc-e23e-4fc7-8ac1-15e914e96906",
                                "sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                                "text": "In deze macabere ambiance klonk in een sinistere hoek opeens een ridicuul gerijmel: een kwetterende kwibus sms’te met een vinkenslag een geïmproviseerde rap naar het mobiele nummer van de primus inter pares onder de pleitbezorgers voor onze normen en waarden."
                            },
                            {
                                "example_id": "155e82d1-b03e-4817-b47e-ea22a6c23867",
                                "sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                                "text": "Tot de jaren vijftig golden klassieke sonnetten van dichters als J.C. Bloem en Adriaan Roland Holst als het hoogst haalbare in de Nederlandstalige poëzie. De Vijftigers pakten het anders aan. „Geen gerijmel. Geen voorgeschreven dreun”, zo vat Kouwenaar hun zelf verkozen opdracht samen."
                            },
                            {
                                "example_id": "4bd6d897-aaf6-4ecf-8857-4b1c7ee2a518",
                                "sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                                "text": "Bijgevolg was er weinig waardering voor letterkunde van vóór de Gouden Eeuw, zoals het ‘misselijk gerijmel’ van Anna Bijns (1493-1575). En Karel ende Elegast (13de eeuw), een klassieker naar huidige maatstaven, was volgens Vaderlandsche letteroefeningen zelfs ‘een misselyke roman’."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d319fa6-81fb-38e5-9f67-d26753791e68",
                        "entry_id": "2cf7d596-d281-38ab-8de2-ede458bbbc95",
                        "glosses": [
                            "dichtwerk van zeer slechte kwaliteit"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7513654-43b1-4cad-905b-2043d14a9cb6",
                        "source_entry_id": "2cf7d596-d281-38ab-8de2-ede458bbbc95",
                        "source_sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                        "source_sense_description": "het schrijven van rijmende gedichtjes van weinig literaire kwaliteit",
                        "target_lang_word": "rhyme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhyme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "Rhyming verse (poetic form)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72ef24e0-181d-4aeb-ba13-abfb15e4a6ec",
                                                "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                                "text": "Many editors say they don’t want stories written in rhyme these days."
                                            },
                                            {
                                                "example_id": "83e7aefd-82ee-4f1c-9052-a7993d2f2373",
                                                "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                                "text": "Libels are caſt againſt thee in the ſtreete, / Ballads and rimes made of thy ouerthrovv."
                                            },
                                            {
                                                "example_id": "727d8f27-84f6-4a13-83b6-813b4d3cbf96",
                                                "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                                "text": "Thou, thou, Lyſander, thou haſt giuen her rimes, / And interchang'd loue tokens vvith my childe: […]"
                                            },
                                            {
                                                "example_id": "e079e68c-b001-4b93-82f7-4f53a41335ae",
                                                "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                                "text": "VVhen in the Chronicle of vvaſted time, / I ſee diſcriptions of the faireſt vvights, / And beautie making beautifull old rime, / In praiſe of Ladies dead, and louely Knights, […]"
                                            },
                                            {
                                                "example_id": "e9bf7ec5-f428-4275-85a6-6bb3925573bd",
                                                "sense_id": "78f4599c-25a1-32fa-8886-044c398f6a98",
                                                "text": "I thought, if I could dravv my paines, / Through Rimes vexation, I ſhould them allay, / Griefe brought to numbers cannot be ſo fierce, / For, he tames it, that fetters it in verſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ba2c1a-dcfd-3e23-aa72-c1b3fd7eed38",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "A thought expressed in verse; a verse; a poem; a tale told in verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f30a9fe-24e2-4d78-9ae2-e1c96f5b1c43",
                                                "sense_id": "a6ba2c1a-dcfd-3e23-aa72-c1b3fd7eed38",
                                                "text": "Tennyson’s rhymes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c92b698-f692-3ea0-a0e7-4f8f60af4863",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "A word that rhymes with another."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042abcb7-b6c1-4db9-b34d-9a451b4ee2c4",
                                                "sense_id": "9c92b698-f692-3ea0-a0e7-4f8f60af4863",
                                                "text": "Norse poetry is littered with rhymes like “sól … sunnan”."
                                            },
                                            {
                                                "example_id": "439755dc-be31-4a86-89c7-21164d6490cf",
                                                "sense_id": "9c92b698-f692-3ea0-a0e7-4f8f60af4863",
                                                "text": "Rap makes use of rhymes such as “money … honey” and “nope … dope”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8277dfa-25e8-3af7-98a7-8ed9f8e846d6",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "A word that rhymes with another.",
                                            "A word that rhymes with another, in that it is pronounced identically with the other word from the vowel in its stressed syllable to the end."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4111081-2844-4bc8-a074-d51c5b703173",
                                                "sense_id": "f8277dfa-25e8-3af7-98a7-8ed9f8e846d6",
                                                "text": "\"Awake\" is a rhyme for \"lake\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f86ac63-58a6-3373-ba03-78def40d1f11",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "Rhyming: sameness of letters or sounds of part of some words."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc70ef3-a0a0-435a-b55c-56e772328bb1",
                                                "sense_id": "5f86ac63-58a6-3373-ba03-78def40d1f11",
                                                "text": "The poem exhibits a peculiar form of rhyme."
                                            },
                                            {
                                                "example_id": "91db82e2-e974-46c9-914f-724c714656e8",
                                                "sense_id": "5f86ac63-58a6-3373-ba03-78def40d1f11",
                                                "text": "[M]ary I cannot ſhevv it in rime, I haue tried, I can finde out no rime to Ladie, but babie, an innocent rime: for ſcorne, horne, a hard rime: for ſchoole foole, a babling rime: very ominous endings, no, I vvas not borne vnder a riming plannet, nor i cannot vvooe in feſtiuall termes: […]"
                                            },
                                            {
                                                "example_id": "68d3ed3c-9db0-4151-b7b1-b01cefde8e7c",
                                                "sense_id": "5f86ac63-58a6-3373-ba03-78def40d1f11",
                                                "text": "Sometimes a man knovvs a place determinate, vvithin the compaſſe vvhereof he is to ſeek: […] as a man ſhould run over the Alphabet, to ſtart a rime."
                                            },
                                            {
                                                "example_id": "79bb54a5-ad18-4707-918f-051a2da33d44",
                                                "sense_id": "5f86ac63-58a6-3373-ba03-78def40d1f11",
                                                "text": "[S]hould not all the world delight to honour this unfortunate and loyal follower of the Muses? May Apollo send him rimes hitherto undreamed of; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a7bf57-7f5b-3b3d-8080-8bcbfc59b285",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "The second part of a syllable, from the vowel on, as opposed to the onset."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02dec4c8-4757-357c-9131-91d704a5585c",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "An instance of rapping; a rapped verse; a line or couple lines of rapping; a hip hop song."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75761de8-e09d-4cc7-a3d7-d5992b44cdc9",
                                                "sense_id": "02dec4c8-4757-357c-9131-91d704a5585c",
                                                "text": "I heard Drake's new rhyme last night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b291678-57dd-3b66-8a39-59131b63b29f",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "A rapper's oeuvre, lyricism or skill."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8427b300-48ef-4c17-8cd8-0bc3b1060a98",
                                                "sense_id": "6b291678-57dd-3b66-8a39-59131b63b29f",
                                                "text": "His rhymes are all weak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf546250-d25c-3e88-8a27-1f8e12044727",
                                        "entry_id": "d7ce125c-1835-373a-9457-7aa25f014740",
                                        "glosses": [
                                            "Number."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rhyme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "869f1411-fea3-3c24-861a-7197f76420f7",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To compose or treat in verse; versify."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885c5ba9-f9cb-40c7-a691-3a776fb0e936",
                                                "sense_id": "869f1411-fea3-3c24-861a-7197f76420f7",
                                                "text": "Ha, ha, hovv vildely doth this Cynicke rime?"
                                            },
                                            {
                                                "example_id": "d8bbbf8c-09a5-4a51-b2bd-3810c34e0542",
                                                "sense_id": "869f1411-fea3-3c24-861a-7197f76420f7",
                                                "text": "How Panurge and the rest rim'd with Poetick Fury [chapter title]"
                                            },
                                            {
                                                "example_id": "e5cd0993-1068-49a9-9461-0ecafbf9b0bb",
                                                "sense_id": "869f1411-fea3-3c24-861a-7197f76420f7",
                                                "text": "There marched the bard and blockhead, side by side, / Who rhymed for hire, and patronized for pride."
                                            },
                                            {
                                                "example_id": "ae6d33af-c30d-4029-88f0-9848e88ff20c",
                                                "sense_id": "869f1411-fea3-3c24-861a-7197f76420f7",
                                                "text": "“He was aye rimin’,” said Miss Newbigging, “about this bonny countryside and the dacent folk that bode in it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474e92cc-394c-3c20-9d6c-4509f0a578de",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To place (a word or words) in such a way as to produce a rhyme or an approximation thereof."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc5dd7b-835d-41cb-8404-e23a26e6b841",
                                                "sense_id": "474e92cc-394c-3c20-9d6c-4509f0a578de",
                                                "text": "Now she's tainted by the syringe\nTry to rhyme a word with orange"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45973b2-0691-3971-b5d4-3f270deaff42",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "Of a word, to be pronounced identically with another from the vowel in its stressed syllable to the end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08d8b73-61df-477b-a86e-8fad5950992c",
                                                "sense_id": "e45973b2-0691-3971-b5d4-3f270deaff42",
                                                "text": "India and windier rhyme with each other in non-rhotic accents."
                                            },
                                            {
                                                "example_id": "d0558664-929d-4851-bba2-44bee3c6181d",
                                                "sense_id": "e45973b2-0691-3971-b5d4-3f270deaff42",
                                                "text": "Creation rhymes with integration and station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b8da9f-19f5-3ebd-8840-2ffd09d49a2f",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To be pronounced identically from the vowel in the stressed syllable of each to the end of each."
                                        ],
                                        "tags": [
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e17f2d4a-1aec-4160-9038-d0cce235e8cd",
                                                "sense_id": "a3b8da9f-19f5-3ebd-8840-2ffd09d49a2f",
                                                "text": "Mug and rug rhyme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1581b0-da42-37ea-873b-dc228bf1f8e5",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To contain words that are pronounced identically to each other from the vowel in the stressed syllable to the end."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925d8a91-1927-42e5-88d3-bdda8115a9e4",
                                                "sense_id": "ea1581b0-da42-37ea-873b-dc228bf1f8e5",
                                                "text": "I rewrote the story to make it rhyme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbb4a62-509e-396b-a87e-68890b288dab",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To somewhat resemble or correspond with."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03547bfe-e801-4bb2-86ae-9bd4f82253e9",
                                                "sense_id": "efbb4a62-509e-396b-a87e-68890b288dab",
                                                "text": "In addition, the look rhymes with but inverts the meaning of the first silent look he gets instead of words when he asks Lucien in the photo shop if he remembers him, and Lucien shrugs his shoulders in denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89bb379-148a-38c4-b940-c36badc15cd9",
                                        "entry_id": "69bbf65a-868b-3af0-a2c1-efa54582014c",
                                        "glosses": [
                                            "To number; count; reckon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba75e676-dc8b-4d46-afb4-17c946a4d8ed",
                        "source_entry_id": "2cf7d596-d281-38ab-8de2-ede458bbbc95",
                        "source_sense_id": "2ce04462-6063-3e87-8546-978d07f4db8c",
                        "source_sense_description": "het schrijven van rijmende gedichtjes van weinig literaire kwaliteit",
                        "target_lang_word": "doggerel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doggerel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fad6c4-09d8-340c-9d6f-f85516117da6",
                                        "entry_id": "abbeb34e-cd0e-3add-ae74-86d439caf907",
                                        "glosses": [
                                            "Of a crude or irregular construction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d28d89-943f-47d9-979d-bed4b9e9f9d7",
                                                "sense_id": "e4fad6c4-09d8-340c-9d6f-f85516117da6",
                                                "text": "True Wit has ſeen its best days long ago, / It ne're look'd up, ſince we were dipt in Show: / When Senſe in Dogrel Rimes and Clouds was loſt, / And Dulneſs flouriſh'd at the Actors coſt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doggerel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f22e5782-a30c-3a01-86a8-00d562264b45",
                                        "entry_id": "f2a076ab-9103-314c-bf08-4cf98ea02d9d",
                                        "glosses": [
                                            "A comic or humorous verse, usually irregular in measure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0181256e-2410-43ce-931a-82f4db82dcf1",
                                                "sense_id": "f22e5782-a30c-3a01-86a8-00d562264b45",
                                                "text": "Taffy drew a long breath into his manly bosom, and kept it there as he read this characteristic French doggerel (for so he chose to call this touching little symphony in ère and ra)."
                                            },
                                            {
                                                "example_id": "2ca99264-c97f-473c-a159-8e0ad91801c5",
                                                "sense_id": "f22e5782-a30c-3a01-86a8-00d562264b45",
                                                "text": "As he marched he sang a bit of doggerel in a high and quavering voice: / \"Sing a song 'a vic'try, / A pocketful 'a bullets, / Five an' twenty dead men / Baked in a—pie.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e7fbdc0-19dd-3401-a0df-9258e70a9097",
                                        "entry_id": "f2a076ab-9103-314c-bf08-4cf98ea02d9d",
                                        "glosses": [
                                            "Any writing of crude composition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e1da1cd-5414-4536-8f7c-25658b002b2e",
                                                "sense_id": "8e7fbdc0-19dd-3401-a0df-9258e70a9097",
                                                "text": "It is very rare to find good, personal analysis of events that does not degenerate into chest-beating, pettiness, pomposity, or political doggeral ^([sic])."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "80afb327-cc98-4ac4-9d9d-cb94cf6fa327",
