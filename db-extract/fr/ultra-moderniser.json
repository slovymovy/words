                "senses": [
                    {
                        "sense_id": "c4c69416-01d3-391f-84fb-6f55408f5773",
                        "entry_id": "fc13e30d-6bbb-3cce-8f8c-cd649bd34c96",
                        "glosses": [
                            "Moderniser de façon extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e1ac65-494f-4637-a4f7-78056615a181",
                                "sense_id": "c4c69416-01d3-391f-84fb-6f55408f5773",
                                "text": "Que les puristes se rassurent : l'approche choisie n'a rien d'hérétique, il n'est pas question d'ultra-moderniser le ton comme Giorgio Moroder l'avait fait sur Metropolis (nous y revoilà) à coups de sons électroniques balancés sur un montage raccourci et colorisé."
                            },
                            {
                                "example_id": "92107238-a13b-4f7d-a301-8a98f0fe0a0a",
                                "sense_id": "c4c69416-01d3-391f-84fb-6f55408f5773",
                                "text": "Certains envisagent d'ultra-moderniser la ligne que Victor Hugo a vu naître."
                            }
                        ]
                    }
