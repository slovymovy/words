                        "entry_id": "d60e5ab2-2e69-397d-93b7-6970c6e21347",
                        "glosses": [
                            "Variante non standard de Viking, guerrier, explorateur et commerçant qui habita la région scandinave au Moyen Âge."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3015d982-2780-494c-a776-5ef27c11c589",
                                "sense_id": "7fc35d15-fb95-37a5-89ed-75b14385146b",
                                "text": "Ces redoutables pirates, connus sous le nom de Vikingues."
                            },
                            {
                                "example_id": "704c9771-d7b6-4702-b810-5da4a12ec419",
                                "sense_id": "7fc35d15-fb95-37a5-89ed-75b14385146b",
                                "text": "Véritable race de Vikingues, semblables à ceux d'autrefois qui, pour acquérir de la gloire et des trésors, traversait les flots sur des dragons."
                            },
                            {
                                "example_id": "a2e3861b-cb08-45db-9294-333180ea5f82",
                                "sense_id": "7fc35d15-fb95-37a5-89ed-75b14385146b",
                                "text": "Enfin il arriva en Écosse ; il s'y battit contre les Vikingues et contre les indigènes."
                            },
                            {
                                "example_id": "acebc33c-4e44-43eb-b957-9a47ddfbc7ea",
                                "sense_id": "7fc35d15-fb95-37a5-89ed-75b14385146b",
                                "text": "Plusieurs siècles avant la Révolution française, les vieux Vikingues auraient pu prendre pour devise : Liberté, Egalité, Fraternité; car ces trois mots renferment justement ce qu'ils allaient chercher en Islande."
                            }
                        ]
                    }
