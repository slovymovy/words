                "senses": [
                    {
                        "sense_id": "8230315b-7f8e-31ad-9382-a6104ed6cb87",
                        "entry_id": "ee24d98a-c827-3901-bac7-cbcf620666f1",
                        "glosses": [
                            "Cigarette manufacturée (par opposition aux cigarettes roulées à la main)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "46688e4f-b824-4d04-be98-d7c68d192bac",
                                "sense_id": "8230315b-7f8e-31ad-9382-a6104ed6cb87",
                                "text": "C'est toujours féminin d'ailleurs, une cigarette, une clope, une garrot, une shmire, une roulée, une indus..."
                            },
                            {
                                "example_id": "e2daf614-aa4a-4138-87c0-351ef4799ba9",
                                "sense_id": "8230315b-7f8e-31ad-9382-a6104ed6cb87",
                                "text": "Je fume tout le temps au tabac à rouler. Le tabac a rouler est haché plus finement que celui des indus, ce qui fait durer le pet plus longtemps."
                            },
                            {
                                "example_id": "17298e2c-6fb5-4083-ad60-1cb99ec88808",
                                "sense_id": "8230315b-7f8e-31ad-9382-a6104ed6cb87",
                                "text": "La roulée est la cigarette du déficient bancaire. S’il devait fumer des indus, il serait aussi endetté que la Grèce."
                            }
                        ]
                    }
                ],
                "translations": [],
