                        "entry_id": "dfce3b13-bca0-39ae-bb9e-06fba4e25715",
                        "glosses": [
                            "Petit bâtiment rural généralement en bois."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "f8b368ed-d644-4d8f-b34c-671381895aa6",
                                "sense_id": "6b6840ad-f9ce-33d2-a4e0-952a8d03507c",
                                "text": "Voici les clés de votre voiture et celle de votre mazot."
