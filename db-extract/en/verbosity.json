    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
                "word": "verbosity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "02e3ef62-5248-474f-94d9-51d9f8f9750b",
                        "entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
                        "tags": [
                            "plural"
                        ],
                        "form": "verbosities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d060a185-e26e-3e44-a82d-14db9a626de3",
                        "entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
                        "glosses": [
                            "The excess use of words, especially using more than are needed for clarity or precision."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8de8d2f-2570-4ac4-82a5-a981939da822",
                                "sense_id": "d060a185-e26e-3e44-a82d-14db9a626de3",
                                "text": "With Christie's words about \"all-talk-no-action\" in mind, notice that Obama and his two secretaries of state, Hillary Clinton and John Kerry, as well as his vice president, Joe Biden, were all senators, the last two serving for two or three decades, respectively. Not forgetting the ill-fated secretary of defense, Senator Chuck Hagel. Their capacity for talking so much and saying so little is astonishing. Their verbosity is unpalatable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c74acada-6b5e-4f84-80b9-00ec931d26e9",
                        "source_entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
                        "source_sense_id": "d060a185-e26e-3e44-a82d-14db9a626de3",
                        "source_sense_description": "the excess use of words; long-windedness",
                        "target_lang_word": "breedsprakigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breedsprakigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                                        "entry_id": "70989cd0-4e34-39e9-8edb-0ca248621d3b",
                                        "glosses": [
                                            "het (te) veel woorden gebruiken bij het spreken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4538a0-9fa8-4a3e-9fb4-8302dbdb8bf8",
                                                "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                                                "text": "Hij verliet de bombastische versmaat met zijn cesuur door de regels in een viervoetig metrum te persen, zoals men in proza met breedsprakigheid strijdt."
                                            },
                                            {
                                                "example_id": "67153b30-3306-4b73-9256-a7dcd3eece1b",
                                                "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                                                "text": "“We hebben duidelijke overeenkomsten, ja. Breedsprakigheid, graag een verhaal vertellen – ook al is het voor de vijftiende keer, creativiteit en vasthoudendheid. Ik moet het namelijk niet hebben van mijn talent, maar van heel erg m’n best doen.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "febe8acb-8253-4978-be46-089458940f14",
                        "source_entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
                        "source_sense_id": "d060a185-e26e-3e44-a82d-14db9a626de3",
                        "source_sense_description": "the excess use of words; long-windedness",
                        "target_lang_word": "verbosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                        "entry_id": "bb8477c1-76e8-372d-b529-ef57b39adaaf",
                                        "glosses": [
                                            "Caractère, défaut de ce qui est verbeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8963dc-289e-4c15-9135-2a662b72e6c3",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Elle pensait que cette verbosité épineuse n’était que l’appareil de défense d’une trop tendre amande."
                                            },
                                            {
                                                "example_id": "e21715c5-505b-4c85-9331-cb212b912b53",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Verbeux à la manière italienne qui prend souvent la verbosité pour l’éloquence, le faste pour la richesse, l’agitation pour le mouvement, la fébrilité pour le transport divin."
                                            },
                                            {
                                                "example_id": "f86ea4b4-7376-4d0c-9fab-529ec8f09cbc",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "La verbosité de cet avocat, de son éloquence."
                                            },
                                            {
                                                "example_id": "5d8ea3d8-b910-4471-83c5-d85a68bc7855",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Ce mémoire est d’une verbosité insupportable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7025cf61-39ea-4488-badc-2fc70badff48",
                        "source_entry_id": "b43864c4-e3e5-38fd-9357-3f68eb47733b",
