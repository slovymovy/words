                ],
                "senses": [
                    {
                        "sense_id": "0d60ec2a-7bdc-32c8-9274-f426a515e84f",
                        "entry_id": "c6fd68ad-f92a-311e-91d6-b3dfab05a757",
                        "glosses": [
                            "Qui appartient au seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a0c270a-9f01-4f7f-a1f5-b0e8808de30d",
                                "sense_id": "0d60ec2a-7bdc-32c8-9274-f426a515e84f",
                                "text": "Au nord ouest, près de la route de Sommerance, se dressaient les bois de la potence, instrument de la haute justice seigneuriale. Parfois y oscillait un squelette blanchi, et le vent, secouant lamentablement les os desséchés, chassait la sombre nuée de corbeaux venue pour les festins lugubres."
                            },
                            {
                                "example_id": "46849348-85be-4d7d-97da-a0b1e70e81b3",
                                "sense_id": "0d60ec2a-7bdc-32c8-9274-f426a515e84f",
                                "text": "Capestang, suivi à six pas par Cogolin, gagna la rue Dauphine, et, à l’angle du quai que lui avait signalé Concini, vit en effet un seigneurial hôtel qui ne pouvait qu’être celui qu’il cherchait."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e6e72e9-4320-30f2-98e7-3a547ff27962",
                        "entry_id": "c6fd68ad-f92a-311e-91d6-b3dfab05a757",
                        "glosses": [
                            "Qui donne des droits de seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89006438-25e1-4812-94e5-892e6a437411",
                                "sense_id": "5e6e72e9-4320-30f2-98e7-3a547ff27962",
                                "text": "Terre seigneuriale."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d0f0e31-67f2-3df5-9b31-5b918f1d7254",
                        "entry_id": "c6fd68ad-f92a-311e-91d6-b3dfab05a757",
                        "glosses": [
                            "Qui est relatif à un seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1eaaacb-29df-46be-a718-9f48473c2365",
                                "sense_id": "3d0f0e31-67f2-3df5-9b31-5b918f1d7254",
                                "text": "Elle était destinée à abriter la communauté de religieux chargée d’assurer le culte destiné aux fidèles, mais aussi à la famille seigneuriale. Il subsiste encore à proximité les ruines du château médiéval qui a abrité une famille autrefois célèbre jusqu’à son extinction au XVIIIᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad92888d-7de2-4c4d-980f-74103dcde77d",
                        "source_entry_id": "c6fd68ad-f92a-311e-91d6-b3dfab05a757",
                        "target_lang_word": "seigneurial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seigneurial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddcb914-943d-3243-8b23-447fa5cc22c8",
                                        "entry_id": "7bdb490a-bbaa-3d92-a8d9-d60bc70eff09",
                                        "glosses": [
                                            "Of or relating to a seigneur or to seigneurialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46a177e-fbb5-4abf-a1e8-cbfdaf8417e5",
                                                "sense_id": "9ddcb914-943d-3243-8b23-447fa5cc22c8",
                                                "text": "In April 1768 Carleton had proposed the restoration of the seigneurial militia system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                                        "entry_id": "7bdb490a-bbaa-3d92-a8d9-d60bc70eff09",
                                        "glosses": [
                                            "Befitting a seigneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef20a36-4225-4544-a0de-8bfe367f7089",
                                                "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                                                "text": "She would chat for hours, without thinking anything of it, with the chief of the village on her mother's estate, when he happened to come into town, and talk with him as if he were her equal, without any signs of seigneurial condescension."
                                            },
                                            {
                                                "example_id": "a4f3de94-2e26-448e-8828-de7dd419fbea",
                                                "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                                                "text": "It had a church, just at the junction of the roads, and a fine seigneurial chateau, in a garden, beside the church; otherwise it was a little lonely mean place, built of brick and plaster on a great lonely heap of chalk downland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
