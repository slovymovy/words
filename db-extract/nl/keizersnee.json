                    {
                        "sense_id": "e03424b6-e596-3798-97a7-e29acce1a2a1",
                        "entry_id": "8d3cfa58-3e19-3944-b00c-b1ff4cc802ed",
                        "glosses": [
                            "bevalling met behulp van een operatie"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "32efc001-2e1f-4783-ba41-ce0901170207",
                                "sense_id": "e03424b6-e596-3798-97a7-e29acce1a2a1",
                                "text": "Ze vertelt over een kennis die over twee weken een keizersnee gepland heeft staan."
                            },
                            {
                                "example_id": "6209baee-b852-4c2f-9a4c-dcf214157fb5",
                                "sense_id": "e03424b6-e596-3798-97a7-e29acce1a2a1",
                                "text": "Het was niet zijn lichaam dat de komende zes maanden door een ander mens zou worden bezet en uiteindelijk opnieuw geopereerd zou moeten worden, omdat ze na de twee eerdere keizersneeën deze keer zeker met een keizersnee zou moeten bevallen."
                            },
                            {
                                "example_id": "669d1b2b-0239-4fc6-83ce-64668d08845e",
                                "sense_id": "e03424b6-e596-3798-97a7-e29acce1a2a1",
                                "text": "Al die welvaartstypes die met hun blote aambeien over hun zadels schuren, terwijl de bierbuiken vlak boven de stang klotsen en de keizersneetjes glimlachen naar de bloeiende brandnetels."
                            }
                        ]
                    }
