                "senses": [
                    {
                        "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                        "entry_id": "a0b47fce-7598-3c9a-9f85-d38613c20666",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3890caa2-dcb7-4582-bbc0-76a0dddf075c",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Frau Scheerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "859d9d07-c2a7-47bc-9581-3cada5c25236",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Herr Scheerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2dfb2c56-749f-4e6b-bf94-93e0560df197",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Die Scheerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "28cfe8ed-de00-495b-94b7-8a742afd6596",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Der Scheerle trägt nie die Schals, die die Scheerle ihm strickt."
                            },
                            {
                                "example_id": "2e222b3a-9ddb-469c-a448-6577f5685c00",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheerle kommt, geht der Herr Scheerle.“"
                            },
                            {
                                "example_id": "5cf7f765-437b-4ba4-a857-5ae6182bc6f0",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Scheerle kommt und geht."
                            },
                            {
                                "example_id": "e4a03955-204b-4ab9-95cc-931d89e1d95a",
                                "sense_id": "93cd205d-f36a-39c6-937a-bf184aba6cd9",
                                "text": "Scheerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
