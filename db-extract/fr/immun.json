                "senses": [
                    {
                        "sense_id": "4937482b-6723-326e-b152-b00b9db47aa0",
                        "entry_id": "84d7e0ab-7681-3746-b20f-ed24fac25c3f",
                        "glosses": [
                            "Qui est immunisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5aa3ef4-269a-4658-9b61-494033642f24",
                                "sense_id": "4937482b-6723-326e-b152-b00b9db47aa0",
                                "text": "Par ailleurs, de nombreuses études démontrent que les chimiothérapies antitumorales classiques affectent de nombreux aspects des réponses immunes antitumorales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb97c30b-0fe4-4783-8cf0-29025373f54b",
                        "source_entry_id": "84d7e0ab-7681-3746-b20f-ed24fac25c3f",
                        "source_sense_id": "4937482b-6723-326e-b152-b00b9db47aa0",
                        "target_lang_word": "immun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d412b272-6a17-37cd-aa3c-f0c5bb5b7fae",
                                        "entry_id": "621f6c99-b630-3cc1-b0e3-ebfea405250a",
                                        "glosses": [
                                            "unempfindlich, widerstandsfähig, gefeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da578317-95a3-4f08-a961-4726f39c1a43",
                                                "sense_id": "d412b272-6a17-37cd-aa3c-f0c5bb5b7fae",
                                                "text": "Gegen seinen Spott sind wir immun."
                                            },
                                            {
                                                "example_id": "1507c08c-0e66-43c7-b709-5a40efa9f4db",
                                                "sense_id": "d412b272-6a17-37cd-aa3c-f0c5bb5b7fae",
                                                "text": "„Man kann beispielsweise Pflanzen mittels Gentechnik so manipulieren, dass sie gegen bestimmte Krankheiten immun oder unempfindlich gegen sonst giftige chemische Pflanzenschutzmittel werden.“"
                                            },
                                            {
                                                "example_id": "c9c3be5a-8dbb-4b96-9370-f8b0ee97637e",
                                                "sense_id": "d412b272-6a17-37cd-aa3c-f0c5bb5b7fae",
                                                "text": "[Masernimpfung:] „Nach den zwei empfohlenen Pieksern sind etwa 98 Prozent der Menschen immun gegen Masern.“"
                                            },
                                            {
                                                "example_id": "af3abbf1-7a64-4d3b-9da3-98ec24f39ce1",
                                                "sense_id": "d412b272-6a17-37cd-aa3c-f0c5bb5b7fae",
                                                "text": "[Coronapandmie 2022:] „»Sars-CoV-3 wird es eh nicht geben. Gegen die Sars-Spezies ist die Menschheit jetzt immun.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb18c4d6-404f-3af1-94f0-c01e35f49c0f",
                                        "entry_id": "621f6c99-b630-3cc1-b0e3-ebfea405250a",
                                        "glosses": [
                                            "Immunität genießend, unantastbar"
                                        ],
                                        "tags": [
                                            "Jura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a08a803-9cbc-4c67-aece-64797d7d4a26",
                                                "sense_id": "cb18c4d6-404f-3af1-94f0-c01e35f49c0f",
                                                "text": "Der Minister konnte nicht belangt werden, als Abgeordneter war er immun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67611256-c985-4cb8-825c-925f0b1ca7bc",
                        "source_entry_id": "84d7e0ab-7681-3746-b20f-ed24fac25c3f",
                        "source_sense_id": "4937482b-6723-326e-b152-b00b9db47aa0",
                        "target_lang_word": "immune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e17e5845-fd55-3b4d-84a3-f0c37ea6e42e",
                                        "entry_id": "94eaba62-d539-3d11-b1d0-0774991e863e",
                                        "glosses": [
                                            "Exempt; not subject to."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b67d24-edb8-4cf9-a69e-990076b4c0f0",
                                                "sense_id": "e17e5845-fd55-3b4d-84a3-f0c37ea6e42e",
                                                "text": "As a diplomat, you are immune from prosecution."
                                            },
                                            {
                                                "example_id": "a14c2555-d22d-4c0e-a992-4022e981b6df",
                                                "sense_id": "e17e5845-fd55-3b4d-84a3-f0c37ea6e42e",
                                                "text": "He had always been remarkably immune from such little ailments, and had only once in his life been ill, of a vicious pneumonia long ago at school. He hadn't the faintest idea what to with a cold in the head, he just took quinine and continued to blow his nose."
                                            },
                                            {
                                                "example_id": "971c72a9-c976-49b7-8fca-cfc04e02e473",
                                                "sense_id": "e17e5845-fd55-3b4d-84a3-f0c37ea6e42e",
                                                "text": "Bret Stephens believed that, by virtue of his comfortable position at the New York Times, he ought to be immune from insult or criticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaaa3a24-db4a-33e6-a7b7-6a0ddc971814",
                                        "entry_id": "94eaba62-d539-3d11-b1d0-0774991e863e",
                                        "glosses": [
                                            "Protected by inoculation, or due to innate resistance to pathogens."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5989d2d2-abd0-4992-9c6c-b75d74183c0c",
                                                "sense_id": "aaaa3a24-db4a-33e6-a7b7-6a0ddc971814",
                                                "text": "I am immune to chicken pox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53cf74c-1a27-3026-9599-be6efeffd66a",
                                        "entry_id": "94eaba62-d539-3d11-b1d0-0774991e863e",
                                        "glosses": [
                                            "Not vulnerable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd7bc2fe-d2d1-474a-b857-2f0856ab2101",
                                                "sense_id": "a53cf74c-1a27-3026-9599-be6efeffd66a",
                                                "text": "Alas, he was immune to my charms."
                                            },
                                            {
                                                "example_id": "b2945ca1-4d9d-4506-b395-caa176b7e732",
                                                "sense_id": "a53cf74c-1a27-3026-9599-be6efeffd66a",
                                                "text": "[...] most of the original electrical signalling equipment has had to be replaced by apparatus immune to 50-cycle currents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43754261-3966-3d92-b569-0415215b9663",
                                        "entry_id": "94eaba62-d539-3d11-b1d0-0774991e863e",
                                        "glosses": [
                                            "Of or pertaining to immunity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d83c3a-0d81-441b-894c-822bce5ebf13",
                                                "sense_id": "43754261-3966-3d92-b569-0415215b9663",
                                                "text": "immune system"
                                            },
                                            {
                                                "example_id": "b888fa6c-7d6a-456d-b91f-61291978b530",
                                                "sense_id": "43754261-3966-3d92-b569-0415215b9663",
                                                "text": "We examined the patient's immune response."
                                            },
                                            {
                                                "example_id": "0d83adbd-6e72-45ff-8bcb-ef90888a79b0",
                                                "sense_id": "43754261-3966-3d92-b569-0415215b9663",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de41bde0-731b-3e7e-9045-556e14530c7f",
                                        "entry_id": "ec70f43e-4601-3acc-a1c8-cb70e94c6bc2",
                                        "glosses": [
                                            "A person who is not susceptible to infection by a particular disease"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e151606a-07eb-4b7d-ac7e-9716e6a4ae1e",
                                                "sense_id": "de41bde0-731b-3e7e-9045-556e14530c7f",
                                                "text": "Susceptibles effectively exposed to cases become cases in the next time period; cases recovering from the infection accumulate as immunes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "725955e0-3ed6-381b-9748-f7e2261019ff",
                                        "entry_id": "33f6ad8f-adfc-3f5b-af2f-f87b53c7527e",
                                        "glosses": [
                                            "To make immune."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce79f94-d4a0-4624-85d5-26e68f21d817",
                                                "sense_id": "725955e0-3ed6-381b-9748-f7e2261019ff",
                                                "text": "In the seventies those who met me did not know / Of the vision / That immuned me from the chillings of mis-prision […]"
                                            },
                                            {
                                                "example_id": "ff85fb8f-a221-42f2-bf2d-ee94f58c42e9",
                                                "sense_id": "725955e0-3ed6-381b-9748-f7e2261019ff",
                                                "text": "The utilization of such milk will, however, necessitate an adaptable milk preservation method, through which the immuning agents will not be destroyed or diminished."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
