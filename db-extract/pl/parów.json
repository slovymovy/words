                    }
                ],
                "senses": [
                    {
                        "sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                        "entry_id": "74c75812-426c-35cf-89c9-1ea2ba57f824",
                        "glosses": [
                            "wąska, płaskodenna dolina o niezbyt stromych, najczęściej porośniętych zboczach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc30b1a7-4ddc-46f9-a355-eea72e879773",
                                "sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                                "text": "Nad głowami małych podróżników przelatywały ciągle z jednego brzegu parowu na drugi tukany o purpurowych głowach, niebieskich piersiach i żółtych skrzydłach"
                            },
                            {
                                "example_id": "98566ab1-518a-4702-a9e8-933d295ec92f",
                                "sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                                "text": "Jednak łagodne i wdzięczne zakręty łąki zwężały się coraz, aż ustąpiły miejsca wąskiej rozpadlinie, a ścieżki w głąb parowu prowadzące zaczęły piąć się po stokach gór; to nagie, skaliste, ostrymi rozpęknięciami poprzerywane i kolczystą wikliną zjeżone, to zielone i tajemniczo pod sklepieniami liściastej zarośli przepadające"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d704f23d-62cb-481d-9a87-68c5876c2413",
                        "source_entry_id": "74c75812-426c-35cf-89c9-1ea2ba57f824",
                        "source_sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                        "target_lang_word": "ravin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                        "entry_id": "332586a6-53c0-3c6e-936c-adc6c9f6dd5f",
                                        "glosses": [
                                            "Forte dépression de terrain ; vallon étroit et raide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd29653-3efb-4d36-915c-ea703f5732b2",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "Alors il descendit dans le ravin pierreux et escarpé, au fond duquel grondait le torrent."
                                            },
                                            {
                                                "example_id": "182f3654-c97d-464d-859e-e908511958f8",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "Nous nous regardions, séparés par un ravin qui n’était pas facile à franchir, et le soir on dormait encore assez tranquillement, quoiqu’on se canardât à distance."
                                            },
                                            {
                                                "example_id": "96614798-1b69-4c67-a814-14194e2afcf1",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "L’oued En-Nedja coule à nos pieds dans un ravin verdoyant et se perd dans un paysage rocheux au Sud-Ouest."
                                            },
                                            {
                                                "example_id": "98b8f56e-11ed-4254-8243-4ccf529a70ee",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. Dans sa partie orientale, elle couvre un plateau accidenté coupé de vallées et de ravins profonds."
                                            },
                                            {
                                                "example_id": "a82dcfe9-efc5-453a-8b81-251fdb3af229",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "Entre Rouvroy-sur-Audry et l'embranchement de Rémilly-les-Pothées, la route a été rectifiée à la fin de 1979, mais elle faisait auparavant un virage brusque, qui dominait l'abrupt d'un ravin."
                                            },
                                            {
                                                "example_id": "8d29232d-407e-415b-9cb1-93c328d71d56",
                                                "sense_id": "6f04856d-9756-31a0-941f-01cabe95195f",
                                                "text": "A l’ouest du village de Mosnay, près du hameau des Jadrets, s’ouvre un gouffre explorable. Il s'agit de la perte d’un ruisseau coulant depuis le sud et qui, au nord de la D 30a, s’encaisse profondément dans un ravin fermé par une falaise d’une vingtaine de mètres de haut, au pied de laquelle une cavité absorbe toutes les eaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "568c55f9-2133-4dca-a89c-e086b1309114",
                        "source_entry_id": "74c75812-426c-35cf-89c9-1ea2ba57f824",
                        "source_sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                        "target_lang_word": "Schlucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                        "entry_id": "54067c65-9ddc-313a-88a7-83d82756e18a",
                                        "glosses": [
                                            "enger und steiler Einschnitt in ein Tal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61df12fc-cbe7-46a4-8356-9305aba80d00",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "Der Grand Canyon ist eine bekannte Schlucht im Norden Arizonas."
                                            },
                                            {
                                                "example_id": "8943e53f-206a-485f-b279-a397da50b356",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Ende des 19. Jahrhunderts hatte ein geschäftstüchtiger Kopf die Idee, im oberen Teil der Schlucht Dämme zu errichten und das kostbare Nass zu speichern.“"
                                            },
                                            {
                                                "example_id": "3d4433ef-b521-49a2-8998-d2af9220c518",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Unten war eine Schlucht mit ebener Sohle, die nach rechts vorn führte.“"
                                            },
                                            {
                                                "example_id": "c7cac071-8fce-4c84-ba11-f8bb3dc66227",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Canyoning ist ein Extremsport, bei dem man dem Lauf des Wassers durch Schluchten folgt.“"
                                            },
                                            {
                                                "example_id": "f97bbfb8-d6f1-4ddd-ac16-cd295f7e78e4",
                                                "sense_id": "b84a523a-b274-3cbc-b539-b336a72a0710",
                                                "text": "„Hinter unserer Stellung zog sich eine steile und tiefe Schlucht hin, die für die Artillerie und Kavallerie einen Rückzug beträchtlich erschweren musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
