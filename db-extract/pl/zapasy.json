                    },
                    {
                        "translation_id": "5ee1ef3b-48e0-4ab4-b575-5d09c4632594",
                        "source_entry_id": "48445662-e941-3216-a501-1a9f037e5b07",
                        "source_sense_id": "fe977c88-9693-3288-8b8d-e1adfd0e024b",
                        "target_lang_word": "lutte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lutte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60ef593f-9c65-33e2-b17f-40cd70cbcf66",
                                        "entry_id": "c555d096-d697-368a-8732-5221a81935ec",
                                        "glosses": [
                                            "Sorte d’exercice, de combat, où deux hommes se prennent corps à corps et cherchent à se terrasser l’un l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a5735b-9984-4b31-99ad-a1a71f165b5b",
                                                "sense_id": "60ef593f-9c65-33e2-b17f-40cd70cbcf66",
                                                "text": "Nous voici à l'automne 1966. Cela fait trois ans et demi […] que le roi Constantin s’initie aux secrets de la lutte japonaise. Il a commencé par le jiu-jitsu, a continué avec le judo et maintenant, depuis un an, il s’adonne aux secrets de l'extraordinaire karaté."
                                            },
                                            {
                                                "example_id": "4d87276a-0c9c-48cf-85c5-0e09b9171e7c",
                                                "sense_id": "60ef593f-9c65-33e2-b17f-40cd70cbcf66",
                                                "text": "S’exercer à la lutte. — Être fort adroit à la lutte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                        "entry_id": "c555d096-d697-368a-8732-5221a81935ec",
                                        "glosses": [
                                            "Guerre ; dispute ; controverse ; conflit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07445a6-6257-49e3-949c-0354b39ae978",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "Plus la lutte contre les schismatiques s'aggrave, plus l’Église s’acharne contre les juifs, qu’elle soupçonne d’être de connivence avec les hérétiques."
                                            },
                                            {
                                                "example_id": "4a7fea06-16c8-4c5d-b194-42e741efd1ab",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "Au moment des luttes politiques, les électeurs du Léon, encadrés par leurs prêtres, font, grâce à leur discipline, échec aux aspirations sociales des populations citadines."
                                            },
                                            {
                                                "example_id": "5db15203-7ca3-4735-8a5e-1466bd771003",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "La lutte des intérêts matériels et des principes moraux, de l’utilité et du devoir, du matérialisme et du spiritualisme, se représente ici avec une nouvelle force, et sous un point de vue encore plus important."
                                            },
                                            {
                                                "example_id": "4a70a45d-2370-4117-a63d-fd48d8f6d039",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "[…] l’Assemblée de Versailles, […], consuma toute une année en controverses stériles, en discussions puériles, en luttes bysantines."
                                            },
                                            {
                                                "example_id": "31ad010c-2557-4e47-9d8c-8a71c4f6af9d",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "Les rois norvégiens cessèrent de s’intéresser à la lointaine colonie ; la discorde survint ; des luttes naquirent, soit intestines, soit entre colons et esquimaux."
                                            },
                                            {
                                                "example_id": "283e4cbe-10ba-491e-b159-fe61d55d62c9",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "La laïcité est engagée dans une lutte âpre et décisive contre le cléricalisme. L’État se bat contre l'Église."
                                            },
                                            {
                                                "example_id": "f4c5abaa-87c0-434d-8912-56a1899e5bab",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "Si profond était le fossé entre la bourgeoisie manufacturière et les ouvriers du textile que les luttes révolutionnaires, dans Sedan, prirent comme nulle part ailleurs le caractère d’un conflit entre classes."
                                            },
                                            {
                                                "example_id": "a8cbd5f3-db3e-44c5-ae8f-65d1a5f5d4f6",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "Cette transformation générale de la société ne se fera pas par la prise du pouvoir d’État par une majorité de gauche ; elle suppose une myriade de luttes locales et globales."
                                            },
                                            {
                                                "example_id": "0c78c8f0-b5f1-4ea8-bc74-511004e34809",
                                                "sense_id": "e4606286-802a-36e4-afd0-81d39f9a5035",
                                                "text": "La lutte permet de créer un rapport de force contraignant un adversaire à respecter le droit et la justice. Elle a pour fonction de rendre possible un dialogue vers une solution juste au conflit. Il n’y a de paix que dans la justice, et il n’y a de justice que par la lutte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b23f825-2ac6-32fa-b38f-b16482f6ac16",
                                        "entry_id": "c555d096-d697-368a-8732-5221a81935ec",
                                        "glosses": [
                                            "Action d'éradication des ravageurs des cultures ou des parasites des animaux."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b70288b-940d-47c5-9b98-db08c6e6828e",
                                                "sense_id": "0b23f825-2ac6-32fa-b38f-b16482f6ac16",
                                                "text": "La lutte contre les thrips peut être réalisée à l’aide d’insecticide tels que diméthoate ou thiométon."
                                            },
                                            {
                                                "example_id": "f422f22a-b337-4286-8a4a-af9cb47710be",
                                                "sense_id": "0b23f825-2ac6-32fa-b38f-b16482f6ac16",
                                                "text": "Le fénarimol est un fongicide largement utilisé dans la lutte contre l’oïdium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d034634-c5a3-3373-abf7-07f467409747",
                                        "entry_id": "c555d096-d697-368a-8732-5221a81935ec",
                                        "glosses": [
                                            "Catch."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4ed0a0-f841-4095-8a5f-a99770ac31a6",
                                                "sense_id": "9d034634-c5a3-3373-abf7-07f467409747",
                                                "text": "Tout ne s'était pas déroulé comme prévu, mais rien ne se déroule jamais comme prévu, sauf à la lutte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lutte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef912dd8-9149-34f1-be1a-2830ce462073",
