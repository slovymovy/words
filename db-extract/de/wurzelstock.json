                    },
                    {
                        "translation_id": "eaf883e5-3cf8-4b45-8cb8-078118ffca0f",
                        "source_entry_id": "e660910b-61d3-39f1-bd0f-0c574c169253",
                        "source_sense_id": "53e4011b-e483-355d-8d4b-f4d3f5438e89",
                        "source_sense_description": "Botanik, Pharmazie: ein meist unterirdisches oder dicht über dem Boden wachsendes Sprossachsensystem",
