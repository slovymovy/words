                        "glosses": [
                            "naam van een soort plant Citrullus colocynthis die groeit op droge zandgrond in het Middellandse Zeegebied en Azië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306e9f2d-cfcf-4a22-a571-ba51fe1f0dee",
                                "sense_id": "a90d8d8d-8f79-3fe6-98a2-42d7d0818089",
                                "text": "De groene ranken der kolokwint kruipen over de wortels van witbloeiende brem, van accacia's en tamarisken."
                            }
                        ]
                    },
                    {
                        "sense_id": "b188c42a-a09c-3aa0-8543-d5bcb57d3451",
                        "entry_id": "90aef4f2-57ec-322d-b270-5dd0afe7ab29",
                        "glosses": [
                            "naam voor de giftige vrucht van de Citrullus colcynthis, die erg bitter smaakt en vroeger wel als purgeermiddel werd gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "804a5b3e-fce0-49e9-b91c-42e51b33ef69",
                                "sense_id": "b188c42a-a09c-3aa0-8543-d5bcb57d3451",
                                "text": "Toen ging er een uit in het veld, om moeskruiden te lezen, en hij vond een wilden wijnstok, en las daarvan, zijn kleed vol wilde kolokwinten, en kwam, en sneed ze in den moespot; want zij kenden ze niet."
                            }
                        ]
                    }
