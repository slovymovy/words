                ],
                "senses": [
                    {
                        "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                        "entry_id": "dfd2c5c2-e89a-3f69-977e-c428b0d0914a",
                        "glosses": [
                            "sich (über einen gewissen Zeitraum hinweg) aufbauen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d3bd75a-6c4b-4427-857b-534532482fd3",
                                "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                                "text": "Es entspinnt sich ein hitziges Wortgefecht."
                            },
                            {
                                "example_id": "3267f130-d4e8-4117-b6a3-fba680c865b7",
                                "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                                "text": "Es entspann sich langsam aber sicher eine tiefe Zuneigung."
                            },
                            {
                                "example_id": "0594b2b1-403a-4a5a-a9b4-cb4ad9526898",
                                "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                                "text": "Die angeregte Unterhaltung, die sich spontan entsponnen hatte, flachte wieder ab."
                            },
                            {
                                "example_id": "f067ca2a-7c9a-4862-915b-518bc868fb28",
                                "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                                "text": "Aus dem plänkelhaften Wortwechsel hatte sich dann ein handfester Streit entsponnen."
                            },
                            {
                                "example_id": "031062f0-c865-47be-bdd4-73ef405a4df0",
                                "sense_id": "27253cfc-f59a-3cc7-9186-d6c61e87c2a5",
                                "text": "„Der Kampf, der sich jetzt in der Welt entspinnt, ist also äußerst vertrackt und betrifft auch die historische Rolle des Christentums in den Bereichen der Macht – also der Politik – und der Moral.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
