                        "examples": [
                            {
                                "example_id": "a7e6c23a-ae3d-4c22-a6b2-03a199a4758a",
                                "sense_id": "e87a341f-2e11-3b58-8c20-a896b97389a5",
                                "text": "1997: After the capture of Jerusalem, the genuine pilgrims had begun to trickle home; the Franks who remained in Outremer (as the Crusader lands in the Middle East had come to be called) were military adventurers, now out for what they could get. — John Julius Norwich, A Short History of Byzantium (Penguin 1998, p. 260)"
                            },
                            {
                                "example_id": "788d64c5-74e8-416e-b918-925954aa5461",
                                "sense_id": "e87a341f-2e11-3b58-8c20-a896b97389a5",
                                "text": "Life for ordinary barons in Outremer Jerusalem was probably better than for kings in Europe, where even potentates wore unlaundered wool and lived in bare-stone draughty keeps with rough furniture."
                            }
                        ]
                    }
