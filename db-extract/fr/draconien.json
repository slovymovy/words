                        ],
                        "form": "draconiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9e89c7f-c4d1-3f4a-86eb-b157005f5993",
                        "entry_id": "bcde8597-4db4-3c92-8c12-fdbd87e87e2a",
                        "glosses": [
                            "Qui est d’une excessive sévérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3051d9d4-9bb6-4979-b1b7-41cd5a2d6750",
                                "sense_id": "b9e89c7f-c4d1-3f4a-86eb-b157005f5993",
                                "text": "Mais cette Novelle marque une régression dans la voie de la répression de l’eunuchat. Estimant l’ancienne législation trop draconienne, Léon VI abolissait la peine du talion contre les opérateurs et adoucissait les autres pénalités."
                            },
                            {
                                "example_id": "b471634c-7331-4c23-b0cd-21cbe257656a",
                                "sense_id": "b9e89c7f-c4d1-3f4a-86eb-b157005f5993",
                                "text": "Pierre Laval avait remplacé Doumergue, fin 1934. Il pensait résoudre les problèmes financiers et économiques par la déflation. Il prit des mesures draconiennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "189802d2-cd04-48a7-9d80-8da2d384aef2",
                        "source_entry_id": "bcde8597-4db4-3c92-8c12-fdbd87e87e2a",
                        "source_sense_id": "b9e89c7f-c4d1-3f4a-86eb-b157005f5993",
                        "target_lang_word": "drakonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drakonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e4eadb-ab5f-3969-bf45-20a18130483c",
                                        "entry_id": "9eb2c721-9693-3db2-a46c-80e07335df90",
                                        "glosses": [
                                            "sehr bestimmt, sehr heftig, sehr streng"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da731a66-aa62-493a-a44e-17b656019251",
                                                "sense_id": "c8e4eadb-ab5f-3969-bf45-20a18130483c",
                                                "text": "Er drohte mit drakonischen Maßnahmen!"
                                            },
                                            {
                                                "example_id": "a3491e57-571d-4cb4-999b-572a26854d92",
                                                "sense_id": "c8e4eadb-ab5f-3969-bf45-20a18130483c",
                                                "text": "Der erste Ebola-Fall in den USA lässt die Behörden drakonische Maßnahmen ergreifen."
                                            },
                                            {
                                                "example_id": "c064b087-f512-43f7-9e4a-70666cc587be",
                                                "sense_id": "c8e4eadb-ab5f-3969-bf45-20a18130483c",
                                                "text": "„Zugleich hatten sie aber das drakonische Zwangsversteigerungsrecht für Steuerschuldner eingeführt und auf diese Weise viele Bauern um Haus und Hof gebracht.“"
                                            },
                                            {
                                                "example_id": "b36578fc-1a98-4a7a-9748-5c8b4d8374b4",
                                                "sense_id": "c8e4eadb-ab5f-3969-bf45-20a18130483c",
                                                "text": "„Der konventionellen Auffassung der Scharia entsprechend sah die Reform des Strafrechts drakonische Strafen für Alkoholkonsum, Ehebruch, Diebstahl und falsche Zeugenaussagen vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcad9ebc-42d0-4c0d-9926-ae1f2e52e3de",
                        "source_entry_id": "bcde8597-4db4-3c92-8c12-fdbd87e87e2a",
                        "source_sense_id": "b9e89c7f-c4d1-3f4a-86eb-b157005f5993",
                        "target_lang_word": "draconian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "draconian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b751845-d2c5-336c-91c9-02a3c60c1bb0",
                                        "entry_id": "6c9d5175-a76c-3c1a-92c0-4f370ac0de0d",
                                        "glosses": [
                                            "Very severe, cruel, or harsh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b673c366-2194-41ed-bc9f-7a69945f2616",
                                                "sense_id": "8b751845-d2c5-336c-91c9-02a3c60c1bb0",
                                                "text": "The mayor announced draconian budget cuts today."
                                            },
                                            {
                                                "example_id": "5f9a7e4d-4eb6-4486-a7c2-e449bb356738",
                                                "sense_id": "8b751845-d2c5-336c-91c9-02a3c60c1bb0",
                                                "text": "The conflict in the countryside resulted in a far more draconian punishment. The Southern Cross flag flew over the camps of striking shearers, who in revenge for their victimisation burned grass, fences, buildings and even riverboats[…]"
                                            },
                                            {
                                                "example_id": "a1cb59ff-0680-4f50-a515-e6ee0f71d173",
                                                "sense_id": "8b751845-d2c5-336c-91c9-02a3c60c1bb0",
                                                "text": "Perhaps lessons had already been learned from the Draconian infrastructure cuts on the Waterloo-Exeter route."
                                            },
                                            {
                                                "example_id": "85b285cd-52e8-4557-a6bc-171aee87bf5d",
                                                "sense_id": "8b751845-d2c5-336c-91c9-02a3c60c1bb0",
                                                "text": "And that movement, while it was eventually crushed through the extensive use of the draconian lese majeste law, shattered the taboo, by calling openly, for the first time, for the powers and financing of the monarchy to be accountable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "draconian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0f961e-e99d-37cb-a2f2-05ad956c3c3d",
                                        "entry_id": "d23ad928-b20b-3ab0-a229-edb6423abc8c",
                                        "glosses": [
                                            "Of or resembling a dragon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b07ede2-dd66-4bdb-98f7-8bba4b817ba3",
                                                "sense_id": "fc0f961e-e99d-37cb-a2f2-05ad956c3c3d",
                                                "text": "The dragon came low to the earth. It defied every image of a draconian being Kulp had ever seen."
                                            },
                                            {
                                                "example_id": "3cd420e3-b000-4a41-b118-f1dafa30034e",
                                                "sense_id": "fc0f961e-e99d-37cb-a2f2-05ad956c3c3d",
                                                "text": "A large sandwyrm (which isn't to be confused with a sandworm) popped its draconian head from the earth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "draconian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28178cf4-741b-336f-baae-dbd7c84d89df",
                                        "entry_id": "6a9378e3-72c2-35a3-9106-51960f5e8e01",
                                        "glosses": [
                                            "A creature resembling a dragon."
                                        ],
                                        "tags": [],
