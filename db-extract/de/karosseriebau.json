                ],
                "senses": [
                    {
                        "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                        "entry_id": "01867111-9ae8-3b96-aa7c-2f3349a6dc19",
                        "glosses": [
                            "Teilbereich des Fahrzeugbaus, der sich mit der Herstellung von Karosserien (Aufbau von Fahrzeugen) befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b04ee89-ea02-4819-850e-e5ef0a8ce72a",
                                "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                                "text": "„Mit 28 Jahren war er Planer für Karosseriebau und die Lackiererei bei Audi, drei Jahre später übernahm er dort die Verantwortung für den Karosseriebau des Audi A3 und weitere zwei Jahre später hatte er es zum Vorstandsassistenten Produktion bei Audi geschafft.“"
                            },
                            {
                                "example_id": "e415a4db-11a5-4fa3-91ce-2afd444cd32f",
                                "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                                "text": "„Das bestehende Motorenwerk soll für die Herstellung von Elektroantrieben ausgebaut und der vorhandene Karosseriebau erweitert werden.“"
                            },
                            {
                                "example_id": "2f675b2d-0fb8-4d28-bf85-d667a7026510",
                                "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                                "text": "„Auch der Karosseriebau, in dem 1600 Menschen überwiegend für den Passat arbeiten, habe ‚eine Option‘ auf eine Beteiligung am neuen Geländewagen, hieß es.“"
                            },
                            {
                                "example_id": "c788c196-7910-4750-87d7-6fed9ff9127b",
                                "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                                "text": "„So werden die einzelnen Komponenten des Karosseriebaus am Computer in einem CAD-Programm zu einer Anlage zusammengefügt und in den zur Verfügung stehenden Raum integriert - wie ein gigantisches Puzzle in 3D.“"
                            },
                            {
                                "example_id": "e6b73efd-5125-4c5b-af01-83a7317826fc",
                                "sense_id": "72303ca1-967b-3dc9-b373-c588c4ac0a19",
                                "text": "„Er war gelernte Wagner und Stellmacher und hatte sich in Paris in der Kunst des Karosseriebaues ausgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
