        "fr-extract.jsonl": [
            {
                "entry_id": "73900d53-d710-369e-bf95-0f5b80e41b4f",
                "word": "backgammon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2efe667-4de0-455e-bd4c-ea443451789b",
                        "entry_id": "73900d53-d710-369e-bf95-0f5b80e41b4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "backgammons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                        "entry_id": "73900d53-d710-369e-bf95-0f5b80e41b4f",
                        "glosses": [
                            "Jeu de hasard raisonné pour deux joueurs qui se joue sur un plateau (tablier) avec des dés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31be2d85-c6f4-4004-80c2-fdcb547a180f",
                                "sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                                "text": "Toute cette grisaille l’a déprimé, et je lui ai fait passer le temps en jouant au backgammon jusqu’à l’arrivée de Perry."
                            },
                            {
                                "example_id": "d72e17af-2d8b-4942-b806-eeb45d106916",
                                "sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                                "text": "Certes, de nombreux ludologues se sont penchés sur le cas et en ont déduit qu'il devait s'agir d'un ancêtre du jeu de l’oie, voire du backgammon ; certains ont même proposé, par déduction, un ensemble de règles."
                            },
                            {
                                "example_id": "42570d32-f7fd-41e2-9426-e11d29d14621",
                                "sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                                "text": "Et pas un de ces légendaires do chich que tu aimes tant, plaisanta-t-elle en faisant allusion au double-six tant recherché au backgammon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "341c417a-208d-42fa-82d9-caa9a1092913",
                        "source_entry_id": "73900d53-d710-369e-bf95-0f5b80e41b4f",
                        "source_sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                        "target_lang_word": "Backgammon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backgammon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21bb3741-1d58-3c78-8046-c2c8b9f6f24c",
                                        "entry_id": "9c7c34b0-1e93-3d3d-8664-666ab2c0fca5",
                                        "glosses": [
                                            "Brettspiel mit zwei Würfeln^([2]) für zwei Personen, bei dem Spielsteine aus dem Spiel genommen werden müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6898b352-0503-4286-809a-90e274f8760a",
                                                "sense_id": "21bb3741-1d58-3c78-8046-c2c8b9f6f24c",
                                                "text": "In seiner Freizeit spielte er mit seinem Bruder gerne Backgammon."
                                            },
                                            {
                                                "example_id": "2b21db0c-901a-4f3f-9011-87c49b2d9491",
                                                "sense_id": "21bb3741-1d58-3c78-8046-c2c8b9f6f24c",
                                                "text": "„In manchen Nächten ging Thomas hinein und spielte mit dem Alten, der nie zu schlafen schien, eine Partie Backgammon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9096796-dfe8-4dd0-b3c8-316d076ef770",
                        "source_entry_id": "73900d53-d710-369e-bf95-0f5b80e41b4f",
                        "source_sense_id": "d2b24380-306c-341f-aef8-a946c6d68dde",
                        "target_lang_word": "backgammon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backgammon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1eccf00-845b-37fa-9d64-37b920242c1d",
                                        "entry_id": "5c0caf10-3a05-3783-af18-b755a433616b",
                                        "glosses": [
                                            "A board game for two players in which each has 15 stones which move between 24 triangular points according to the roll of a pair of dice; the object is to move all of one's pieces around, and bear them off the board."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4504951-3c86-412d-944b-9e4b30f2dae1",
                                                "sense_id": "c1eccf00-845b-37fa-9d64-37b920242c1d",
                                                "text": "\"I have borrowed Mrs. Palmer's backgammon-board,\" said Isabella, whose notion of an elderly gentleman's amusements of an evening was derived from what she had seen Mr. Palmer do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d6b5a9-6de1-3792-b1b4-569309b5e5b8",
                                        "entry_id": "5c0caf10-3a05-3783-af18-b755a433616b",
                                        "glosses": [
                                            "A victory in the game when the loser has not borne off a stone, and still has one or more stones in the winner's inner home row or on the bar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "backgammon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c604dee-6f15-321f-81ab-6a387e9ac9b3",
                                        "entry_id": "3dddd28b-a84a-3aa8-97d3-dfab4ed546fd",
                                        "glosses": [
                                            "To win at a backgammon game with the opponent having one or more pieces in the winner’s inner home row or on the bar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
