                                    {
                                        "sense_id": "f663f30b-21b5-3752-955c-be45e07d9255",
                                        "entry_id": "653aad99-7ff4-384c-8ecb-e0d9bc8c4a91",
                                        "glosses": [
                                            "A country in East Asia, comprising the southern part of the Korean Peninsula. Official name: Republic of Korea. Capital: Seoul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a4edb7-63b2-4a5e-9ab9-91bd25c98b79",
                                                "sense_id": "f663f30b-21b5-3752-955c-be45e07d9255",
                                                "text": "HSI data indicates that up to a million dogs are bred and sacrificed annually in South Korea for human consumption, even though demand is at a “historic low,” with about 6 million dogs residing in South Korean homes and 57 percent of the population supporting the ban."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
