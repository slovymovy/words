                        "examples": [
                            {
                                "example_id": "b176d61b-6708-4a0d-9e09-650297c9823e",
                                "sense_id": "df54068a-6e8c-3bb8-beac-6c7093e5ef04",
                                "text": "De banken KBC en BBL verlagen vanaf maandag 3 september, in navolging van de Europese Centrale Bank (ECB), de rente op een aantal kredietvormen. Dat meldden beide banken vrijdag. De nieuwe rentevoet voor kaskredieten bedraagt 8,50 % (voorheen 8,75), voor discontokredieten 7,25 % (voorheen 7,5) en voor acceptkredieten 6,25 % (6,5)."
                            },
                            {
                                "example_id": "ba718058-8669-4e60-aa2d-42e436c97264",
                                "sense_id": "df54068a-6e8c-3bb8-beac-6c7093e5ef04",
                                "text": "Op drie jaar geven de kasbons bij KBC nog 3 procent in plaats van 3,15 en op vier jaar gaat de rente van 3,4 naar 3,25 procent. Bij Fortis en BBL is de rente op kas-, disconto- en acceptkredieten gedaald. Telkens met een kwart procentpunt tot respectievelijk 7,5, 6,25 en 5,25 procent."
                            }
                        ]
                    }
