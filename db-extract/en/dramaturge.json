                ],
                "senses": [
                    {
                        "sense_id": "0e5987e2-5795-3caa-a46e-7ebeb87d2883",
                        "entry_id": "3ebea05f-e0cd-3096-b6b1-b2724a284cc9",
                        "glosses": [
                            "Someone who writes or adapts theater plays, a playwright, dramatist, especially one connected with a specific theater or company."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ece4a404-b71d-3fa0-9b72-04283070fed6",
                        "entry_id": "3ebea05f-e0cd-3096-b6b1-b2724a284cc9",
                        "glosses": [
                            "A literary adviser or editor in a theater, opera, or film company that researches, selects, adapts, edits, and interprets scripts, libretti, texts, and printed programs (or helps others with these tasks), consults with authors, and does public relations work."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f152038-bc52-448b-aadb-6904516adcc4",
                        "source_entry_id": "3ebea05f-e0cd-3096-b6b1-b2724a284cc9",
                        "source_sense_description": "playwright",
                        "target_lang_word": "dramaturge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dramaturge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                                        "entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                                        "glosses": [
                                            "Auteur ou autrice de pièces de théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d161a928-3787-4c51-b9b0-e097ead8bd28",
                                                "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                                                "text": "L’auteur des Contes cruels reste un dramaturge mal connu et prétendument “mineur”, alors qu’il s’est toute sa vie consacré à l’écriture dramatique, et que c’est sans doute avec son théâtre qu’il est le plus inventif, à son époque."
                                            },
                                            {
                                                "example_id": "d0b3aba3-e5c7-4e63-98d6-ba6195705b11",
                                                "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                                                "text": "La dramaturge engagée termine aussi ColoniséEs, une pièce inspirée de la vie de Pauline Julien et de Gérald Godin qui sera présentée en janvier, et travaille à une adaptation de J'accuse pour la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d2e953-de0b-399f-84cc-436ffd70fb79",
                                        "entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                                        "glosses": [
                                            "Membre de l’équipe théâtrale spécialisé dans la recherche et le conseil littéraires, l’histoire théâtrale, la documentation linguistique ou le travail philologique ; il peut également, dans certains cas, être chargé de la mission de communication et des aspects pédagogiques du travail de l’équipe artistique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5508d298-b05a-4b88-bc0b-e74dd4df2f71",
                        "source_entry_id": "3ebea05f-e0cd-3096-b6b1-b2724a284cc9",
