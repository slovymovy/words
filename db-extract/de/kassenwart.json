                    {
                        "sense_id": "16cf2ea3-2ae9-33d8-a46b-b90eb23d7611",
                        "entry_id": "e177c209-2947-3e3b-99e1-078a51222558",
                        "glosses": [
                            "Person, die über eine (Vereins-)Kasse wacht und diese verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee0081b-eea7-45c3-be7d-582297191296",
                                "sense_id": "16cf2ea3-2ae9-33d8-a46b-b90eb23d7611",
                                "text": "Der Kassenwart vergriff sich an der Vereinskasse."
                            },
                            {
                                "example_id": "da215085-5189-4b1b-bed0-0e3349eb940f",
                                "sense_id": "16cf2ea3-2ae9-33d8-a46b-b90eb23d7611",
                                "text": "„Unter den wenigen Zuhörern auf den Bänken des Gerichtssaals war der Kassenwart des Schriftstellerverbandes, aber ob er aus Solidarität oder Neugierde gekommen war, wusste Eigil nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
