            "senses": [
                {
                    "sense_id": "9a1a2ac6-bffb-3beb-9dcf-be3ec8e42d68",
                    "sense_definition": "Qui cause de l'étonnement, qui frappe par son caractère inattendu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa décision rapide a provoqué une réaction très <w>surprenante</w> chez ses collègues.",
                            "target_lang_translations": {
                                "en": "Her quick decision provoked a very <w>surprising</w> reaction among her colleagues.",
                                "ru": "Её быстрое решение вызвало очень <w>удивительную</w> реакцию у коллег.",
                                "de": "Ihre schnelle Entscheidung löste bei ihren Kollegen eine sehr <w>überraschende</w> Reaktion aus.",
                                "es": "Su decisión rápida provocó una reacción muy <w>sorprendente</w> entre sus compañeros.",
                                "zh": "她迅速做出的决定在同事们中间引起了非常<w>令人惊讶的</w>反应。"
                            }
                        },
                        {
                            "text": "Il n'y a rien de <w>surprenant</w> à ce qu'il réussisse ses examens avec brio.",
                            "target_lang_translations": {
                                "en": "There is nothing <w>surprising</w> about him passing his exams with flying colours.",
                                "ru": "Ничего <w>удивительного</w> в том, что он блестяще сдаст экзамены.",
                                "de": "Es ist nicht <w>überraschend</w>, dass er seine Prüfungen mit Bravour besteht.",
                                "es": "No hay nada de <w>sorprendente</w> en que apruebe sus exámenes con brillantez.",
                                "zh": "他能够出色地通过考试，这并没有什么<w>令人惊讶的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "étonnant"
                    ],
                    "antonyms": [
                        "banal",
                        "ordinaire",
                        "prévisible"
                    ],
                    "common_phrases": [
                        "rien de surprenant",
                        "résultat surprenant",
                        "nouvelle surprenante"
                    ],
                    "target_lang_definitions": {
