            "senses": [
                {
                    "sense_id": "7201fe5e-2940-31ec-9923-a2d67a61bd37",
                    "sense_definition": "Choisir une personne ou une chose plutôt qu'une autre parce qu'on l'aime mieux ou qu'elle convient davantage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "préférer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>préfère</w> le thé au café le matin."
                        },
                        {
                            "text": "Entre la mer et la montagne, mes parents <w>préfèrent</w> la montagne."
                        },
                        {
                            "text": "Tu <w>préfères</w> manger maintenant ou plus tard ?"
                        },
                        {
                            "text": "Elle <w>préférait</w> rester à la maison plutôt que sortir sous la pluie."
                        }
                    ],
                    "synonyms": [
                        "aimer mieux"
                    ],
                    "common_phrases": [
                        "préférer le thé",
                        "préférer rester chez soi",
                        "préférer plutôt que",
                        "préférer à tout autre"
