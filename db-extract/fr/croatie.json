                ],
                "senses": [
                    {
                        "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                        "entry_id": "f0e686f4-a63a-379f-943b-225a420dbd29",
                        "glosses": [
                            "Pays d’Europe entouré par la Slovénie à l’ouest, la Hongrie au nord, la Serbie et la Bosnie-Herzégovine à l’est, et la mer Adriatique et le Monténégro au sud. Sa capitale est Zagreb."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "908aca57-5be0-4b16-9953-b8c1a39b9e90",
                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                "text": "Sous cet aspect pourtant, la Croatie intéresse à bien des égards."
                            },
                            {
                                "example_id": "4349b93f-6b59-4786-aa5f-b94dcac0044a",
                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                "text": "Faute de nouvelle formule associative, il n’y avait que l’alternative : ou laisser les minorités serbes de Croatie à la merci d’une croatisation annoncée et menaçante ; ou s’emparer de la Slavonie et de la Krajina et les décroatiser."
                            },
                            {
                                "example_id": "e5af9ecf-10b4-48bb-95b5-72a1001487a7",
                                "sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
                                "text": "De nouvelles secousses telluriques ont frappé mercredi la Croatie, après un séisme de magnitude 6,4 qui a fait au moins sept morts mardi, réduit des immeubles en poussière et privé des quartiers entiers d'électricité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f4c7b5c-c334-4a50-8559-ac05e8b6f87d",
                        "source_entry_id": "f0e686f4-a63a-379f-943b-225a420dbd29",
                        "source_sense_id": "ab9ad10c-6a5e-3a71-baea-80fd47347c22",
