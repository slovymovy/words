                "senses": [
                    {
                        "sense_id": "9afcb87b-71ed-32cc-9f90-191ce963a24c",
                        "entry_id": "1f92370d-3a03-377b-b279-f95818dd7b62",
                        "glosses": [
                            "A unit of distance, equal to 10 miles."
                        ],
                        "tags": [
                            "South-Asia",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e60481ff-5ef4-4d95-8891-ef25fdc792c1",
                                "sense_id": "9afcb87b-71ed-32cc-9f90-191ce963a24c",
                                "text": "Accordingly Mangamal had all the roads throughout the kingdom formed into avenues; and at the distance of every kadam (10 English miles) she had a choultry built"
                            },
                            {
                                "example_id": "a408e847-84f2-41c1-a1a4-8c908bd654f9",
                                "sense_id": "9afcb87b-71ed-32cc-9f90-191ce963a24c",
                                "text": "Where ten kadams equal 55 feet revenue under the rule adopted in Jhelum and Ludhiana would be remissible in whole or in part on 133 acres per mile, the land on both sides of the road being taken into account."
                            },
                            {
                                "example_id": "dfc46384-523d-4f2e-a36e-c64d5b746e3d",
                                "sense_id": "9afcb87b-71ed-32cc-9f90-191ce963a24c",
                                "text": "It is at a perpendicular distance of 16 kadams from a point 69 kadams from the corner of the square."
                            }
                        ]
                    }
                ],
