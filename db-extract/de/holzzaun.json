                "senses": [
                    {
                        "sense_id": "500d4af7-7a66-3c8a-a4c0-ec3f4f542398",
                        "entry_id": "32b951e9-51ea-3e95-83b2-c1c718d7ab5d",
                        "glosses": [
                            "Zaun, gefertigt aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd24f37-790e-4bdb-8591-033c26778c27",
                                "sense_id": "500d4af7-7a66-3c8a-a4c0-ec3f4f542398",
                                "text": "Der Holzzaun bei unserem Garten sollte wieder neu gestrichen werden."
                            },
                            {
                                "example_id": "23fcfaee-f480-4572-a5c5-e212c2174898",
                                "sense_id": "500d4af7-7a66-3c8a-a4c0-ec3f4f542398",
                                "text": "„Als ich aus der Umkleidekabine trete, entdecke ich den Holzzaun quer über den Strand.“"
                            },
                            {
                                "example_id": "b193fd30-1b8f-43e3-8009-7429b754bf39",
                                "sense_id": "500d4af7-7a66-3c8a-a4c0-ec3f4f542398",
                                "text": "„Der Weg zum kleinen Haus führte durch einen offenen Holzzaun, hinunter zu einem Gartenteich.“"
                            },
                            {
                                "example_id": "e1ea0704-a1d7-4fe4-b870-7d5a66c0e859",
                                "sense_id": "500d4af7-7a66-3c8a-a4c0-ec3f4f542398",
                                "text": "„In unserem von einem Holzzaun begrenzten Garten spielten Milena und ich Fangen oder suchten nach den Grillen, die immer zu zirpen aufhörten, wenn wir ihnen nahe kamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
