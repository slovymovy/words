                                                "example_id": "dae43a27-fff8-47dc-bed5-b37783d0d0ca",
                                                "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                                "text": "„Oft sind Alkohol und Drogen im Spiel.“"
