                "senses": [
                    {
                        "sense_id": "a067e21f-83be-3a12-bc90-334758d7e3d0",
                        "entry_id": "3b64e52a-df69-39cb-82cb-4f0bc916545b",
                        "glosses": [
                            "человек, торгующий старой одеждой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9e14f4-deae-42d2-b2e6-e7e3e33810df",
                                "sense_id": "a067e21f-83be-3a12-bc90-334758d7e3d0",
                                "text": "― Если тряпичник купил у нас за две копейки такую рвань, какую мы ему продали в прошлый раз, то за эту почти что новенькую калошу он, наверное, даст не менее рубля."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcb344b5-b3c1-3ef7-b2d3-0425267a950f",
                        "entry_id": "3b64e52a-df69-39cb-82cb-4f0bc916545b",
                        "glosses": [
                            "разг. тот, кто чрезмерно интересуется нарядами, одеждой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d127bae4-d50a-4d00-809f-58292b9d807a",
                        "source_entry_id": "3b64e52a-df69-39cb-82cb-4f0bc916545b",
                        "source_sense_description": "старьёвщик",
                        "target_lang_word": "ragman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ragman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "031eddc4-ca4c-327d-a635-e2d1e573d6a3",
                                        "entry_id": "347e7c77-772c-3201-adeb-bfee8689556b",
                                        "glosses": [
                                            "A person who collects and sells unwanted household items such as rags and other refuse for a living, a rag and bone man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35fe4f53-03bb-4f87-8434-5ec4b3790a66",
                                                "sense_id": "031eddc4-ca4c-327d-a635-e2d1e573d6a3",
                                                "text": "For travellers have to carry bags, / And swagmen have to hump their swags / Like bottle-ohs or ragmen."
                                            },
                                            {
                                                "example_id": "5877396b-5788-431b-bd00-b833dd22d918",
                                                "sense_id": "031eddc4-ca4c-327d-a635-e2d1e573d6a3",
                                                "text": "Oh, the ragman draws circles / Up and down the block / I'd ask him what the matter was / But I know that he don't talk"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ragman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a844048f-02ce-3537-ad31-a34cad77295d",
                                        "entry_id": "6c0dcc24-10e5-3161-80a7-22b45e758258",
                                        "glosses": [
                                            "A statute issued by Edward I in 1276."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b35a4976-fdb7-37cd-955a-fa5297422392",
                                        "entry_id": "6c0dcc24-10e5-3161-80a7-22b45e758258",
                                        "glosses": [
                                            "A document having many names or seals, such as a papal bull."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda9dea2-100d-4e72-a786-62c3ad6ef4cb",
                                                "sense_id": "b35a4976-fdb7-37cd-955a-fa5297422392",
                                                "text": "He bonched hem with his breuet · & blered here eyes / And rauȝte with his ragman · rynges and broches […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64bd3b12-bb81-33e1-98d8-b4d91d2c0466",
                                        "entry_id": "6c0dcc24-10e5-3161-80a7-22b45e758258",
                                        "glosses": [
                                            "A game in which players compete to pull an object from out of a roll of writing."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7d6f963-24a9-464d-869d-38e99245f1ef",
                        "source_entry_id": "3b64e52a-df69-39cb-82cb-4f0bc916545b",
