                                                "example_id": "1ecb239a-272f-4335-a605-91c08d264127",
                                                "sense_id": "131cdaa4-4194-3266-9813-23b31cb9fe36",
                                                "text": "Sie warteten, bis der Feind das Feuer eröffnete."
