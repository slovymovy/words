                "senses": [
                    {
                        "sense_id": "69625a03-4eb2-3650-aa3d-bab0ff3fc71b",
                        "entry_id": "c5db53c3-8a19-3c20-8bf7-52febe0391bc",
                        "glosses": [
                            "schirmförmiger Blütenstand, der aus einer Hauptblüte am Hauptspross und weiteren Blüten besteht, deren Blütenstiele an mehreren Stellen des apikalen Sprosses entspringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550876dd-4c0a-4bf6-9196-a338656f51bd",
                                "sense_id": "69625a03-4eb2-3650-aa3d-bab0ff3fc71b",
                                "text": "Die Trugdolde ist manchmal im Aussehen einer Dolde fast gleich, aber durch die Aufblühfolge von ihr zu unterscheiden."
                            },
                            {
                                "example_id": "3601a59c-2dad-4c0b-bacd-c9c7a6fc9ab8",
                                "sense_id": "69625a03-4eb2-3650-aa3d-bab0ff3fc71b",
                                "text": "Aus ihrer Mitte wachsen im Mai stattliche, bis zu 1,50 Meter hohe Pflanzen mit variabel gefiederten Blättern, auf deren kantigen hohlen Stängeln sich von Juni bis August die Blütenstände in so genannten Trugdolden bilden: vielen kleinen, auf Stängeln thronenden Einzelblüten, die dicht nebeneinander in einer Ebene wachsen."
                            },
                            {
                                "example_id": "f8beb8b6-b8f2-4a95-a93c-62639a496753",
                                "sense_id": "69625a03-4eb2-3650-aa3d-bab0ff3fc71b",
                                "text": "Wenn die Deckblätter, zwei an der Zahl, entgegengesetzt sind, so ist die Trugdolde dichotomisch, wie man es bei den Nelken und im Allgemeinen bei allen Caryophylleen sieht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
