                ],
                "translations": [
                    {
                        "translation_id": "50c07063-e67c-41a6-84d4-54f1d3e14864",
                        "source_entry_id": "159a6012-d0bb-3984-9897-bbe8bf81dbee",
                        "source_sense_id": "2cf768cf-f052-3767-b7a5-12567c1146d8",
                        "source_sense_description": "geheel der dingen waarover iemands macht zich uitstrekt, waarover hij heerst (bewind uitoefent) en het daarbij horende gezag geniet",
                        "target_lang_word": "Herrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3b00a9-8310-315f-b543-6232e3b6e106",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "Bezeichnung für Regierende, Personen mit Leitungsfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a050361-26dc-42c2-8e01-a1753f15df5d",
                                                "sense_id": "1f3b00a9-8310-315f-b543-6232e3b6e106",
                                                "text": "Die Herrschaft versammelte sich im Palast."
                                            },
                                            {
                                                "example_id": "e0a03ce1-4626-4f13-b905-05662580cb17",
                                                "sense_id": "1f3b00a9-8310-315f-b543-6232e3b6e106",
                                                "text": "In diesem Moment gab es keinen Unterschied zwischen Herrschaft und Gesinde."
                                            },
                                            {
                                                "example_id": "8c07cda5-b0e0-4198-805a-e1f780700974",
                                                "sense_id": "1f3b00a9-8310-315f-b543-6232e3b6e106",
                                                "text": "„Kämen die Herrschaften zurück, würden sie die geraubten Dinge in einer feierlichen Prozession ins Herrenhaus tragen und behaupten, sie hätten sie nur an sich genommen, um sie vor den Franzosen zu schützen.“"
                                            },
                                            {
                                                "example_id": "9b64ad33-d7fa-4e3f-a768-43fc73808164",
                                                "sense_id": "1f3b00a9-8310-315f-b543-6232e3b6e106",
                                                "text": "„Aber während er sich so tröstete, zogen auch wieder andere Bilder herauf, und er sah sich in einem Kutschwagen bei den prinzlichen Herrschaften vorfahren, um ihnen Victoire von Carayon als seine Braut vorzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "090bf9c9-5fac-39c4-bd2f-12ec81d88e85",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "Amtsperiode eines autokratisch Regierenden; Regierungsdauer eines Königs oder Regimes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348d26b6-d330-4fc8-9c0c-5d2b0bec78c7",
                                                "sense_id": "090bf9c9-5fac-39c4-bd2f-12ec81d88e85",
                                                "text": "Die Herrschaft des Winterkönigs dauerte nur ein Jahr."
                                            },
                                            {
                                                "example_id": "6e9cb8fd-f66a-454f-b1df-ce89bea395ac",
                                                "sense_id": "090bf9c9-5fac-39c4-bd2f-12ec81d88e85",
                                                "text": "„Die Herrschaft des Monarchen, der Zivilisation und Christentum nach Zentralafrika bringen und die Sklaverei dort beenden soll, entwickelt sich zu einem der größten Verbrechen der Geschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a26d7a1d-cf80-322e-9c83-ee02f259dfd5",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "Regierungsgewalt, Art und Weise, in der jemand (hauptsächlich Menschen und übertragen auch andere Lebewesen) regiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a049c3e-90c7-4d7f-bd3e-203dcee2e3b1",
                                                "sense_id": "a26d7a1d-cf80-322e-9c83-ee02f259dfd5",
                                                "text": "Das Volk litt unter der grausamen Herrschaft des Königs."
                                            },
                                            {
                                                "example_id": "d67484e6-60f5-4a8a-8b19-0e42da143118",
                                                "sense_id": "a26d7a1d-cf80-322e-9c83-ee02f259dfd5",
                                                "text": "„Daran sehen wir, dass die Sprache als Fundament der Herrschaft begriffen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "90b65907-9b55-30d6-b609-4f0a648b5caf",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "Kontrolle über Dinge oder Person, die sie ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbdac9f7-8758-450e-998c-46cdd21b00a4",
                                                "sense_id": "90b65907-9b55-30d6-b609-4f0a648b5caf",
                                                "text": "Es dauerte eine Weile, bis er die Herrschaft über seine geschundenen Glieder wiedererlangt hatte."
                                            },
                                            {
                                                "example_id": "96fa1393-ea0f-49fd-812e-9e1bdb88c337",
                                                "sense_id": "90b65907-9b55-30d6-b609-4f0a648b5caf",
                                                "text": "„Die beiden wurden der Herrschaft gemeldet, und dann war es, als sei unter der Dienerschaft des Fürsten eine gewisse Verwirrung und Bestürzung entstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "bab4a815-c55d-30f2-80f4-60ae3fe7868b",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "das Territorium oder Lehen eines Landesherrn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c91cd5c-27b8-45e2-aef3-31045c8cf093",
                                                "sense_id": "bab4a815-c55d-30f2-80f4-60ae3fe7868b",
                                                "text": "Herrschaft In- und Kniphausen"
                                            },
                                            {
                                                "example_id": "1bef3d1c-b04b-4386-b9ad-ba2ecb3b8e33",
                                                "sense_id": "bab4a815-c55d-30f2-80f4-60ae3fe7868b",
                                                "text": "„Sie sind Muslime, ihre Herrschaften, wie der Hafen Mombasa, gleichen eher Stadtstaaten denn Großreichen – und ihre Macht wird im 16. Jahrhundert unter den Angriffen portugiesischer Seefahrer kollabieren (…).“"
                                            },
                                            {
                                                "example_id": "5e165c6f-db40-4b24-9203-af3165e7420b",
                                                "sense_id": "bab4a815-c55d-30f2-80f4-60ae3fe7868b",
                                                "text": "„Solcherweise kam Jón Hreggvidsson in den Besitz von einem Paar guter Stiefel eines Herzogs, der drei Herrschaften besaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3a222d94-306e-3770-b482-d6e980dde93e",
                                        "entry_id": "744fdde2-1789-38b5-a1e2-b05f7f672aa3",
                                        "glosses": [
                                            "vornehme Anrede für eine Gruppe von Personen (insbesondere gemischten Geschlechts)"
                                        ],
                                        "tags": [
                                            "Plural; veraltend und mitunter ironisch gebraucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d06f066-a081-43d6-bd2e-dca6313d72a2",
                                                "sense_id": "3a222d94-306e-3770-b482-d6e980dde93e",
                                                "text": "Guten Tag die Herrschaften, wie geht es Ihnen?"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
