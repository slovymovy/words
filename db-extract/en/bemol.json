                "senses": [
                    {
                        "sense_id": "d4ed76ba-b6bc-3f10-9c76-3edda05dfacd",
                        "entry_id": "647c5811-70d2-3db4-aae1-e8e278b46795",
                        "glosses": [
                            "The flat symbol (♭), or a flattened note."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "93add319-b043-480c-bb6c-ec6d123b0ed9",
                                "sense_id": "d4ed76ba-b6bc-3f10-9c76-3edda05dfacd",
                                "text": "F natural has a Bemol on b. [...] B flat has a Bemol on b and e."
                            },
                            {
                                "example_id": "b2331050-b976-4605-8448-4c07fa4314b1",
                                "sense_id": "d4ed76ba-b6bc-3f10-9c76-3edda05dfacd",
                                "text": "Now B♭, which is ſuppoſed to be repreſented by Nº 6. of the hammers, is the generator of the next modulation or key in the bemol or flat mode, F."
                            },
                            {
                                "example_id": "6012e048-091e-42df-b884-712b68b20e1f",
                                "sense_id": "d4ed76ba-b6bc-3f10-9c76-3edda05dfacd",
                                "text": "Sol major has only one dièse for a signature; therefore sol ♭ major must have six bemols; six and one make seven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ac9996-d1f1-4d07-957b-25437b251e44",
                        "source_entry_id": "647c5811-70d2-3db4-aae1-e8e278b46795",
                        "source_sense_id": "d4ed76ba-b6bc-3f10-9c76-3edda05dfacd",
                        "source_sense_description": "bemol",
