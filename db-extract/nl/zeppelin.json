                "senses": [
                    {
                        "sense_id": "c8b5edcf-0657-372d-ab41-131ef82349d4",
                        "entry_id": "79a55693-5fc2-337d-af77-37a0c4880772",
                        "glosses": [
                            "luchtschip in de lucht gehouden door een groot volume waterstof of helium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815bb7ec-0a90-45cc-b8d0-4df841791a22",
                                "sense_id": "c8b5edcf-0657-372d-ab41-131ef82349d4",
                                "text": "Door de brand van de Hindenburg is de zeppelin in kwade reuk geraakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee99f219-f3b3-47ec-810d-e26e005237da",
                        "source_entry_id": "79a55693-5fc2-337d-af77-37a0c4880772",
                        "source_sense_id": "c8b5edcf-0657-372d-ab41-131ef82349d4",
                        "source_sense_description": "luchtschip in de lucht gehouden door een groot volume waterstof of helium",
                        "target_lang_word": "Zeppelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                        "entry_id": "523fd728-a170-3f3a-babd-178b788c9637",
                                        "glosses": [
                                            "bekanntester Luftschifftyp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c374d2-39f7-4c80-8b4c-330e8d3b6d34",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "Im Ersten Weltkrieg wurden Zeppeline zur Bombardierung der englischen Zivilbevölkerung eingesetzt."
                                            },
                                            {
                                                "example_id": "08f03a26-b036-41be-9680-fc08123471f7",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Nobile war mit dem Luftschiff ‚Italia‘ erneut zum Nordpol aufgebrochen, diesmal ohne Amundsen. Auf dem Rückweg stürzte der Zeppelin ab.“"
                                            },
                                            {
                                                "example_id": "6bf95538-1d40-46c6-b6c4-1895251909a6",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Bei Cuxhaven war ein Zeppelin durch Blitzschlag vernichtet.“"
                                            },
                                            {
                                                "example_id": "fa6bef46-0d10-4a46-8bb7-7304b0f0e902",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Aber der Zeppelin fliegt nicht los, Eckener will ihn nicht unnütz gefährden.“"
                                            },
                                            {
                                                "example_id": "4c70c79b-bc3e-4434-bb19-cc3ca1bb1d40",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Auch der Zeppelin erschien in Mainz, wenn auch mit etwas Verspätung, auf dem ersten Flug, der ihn vom Bodensee bis fast zur Nordsee hätte führen sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                        "entry_id": "144d7ead-45be-36af-a453-9c771fe27d8e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c2b41-582d-4a9f-9047-cfdb88707188",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Frau Zeppelin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e48b10fb-2fee-41af-88c1-7da4ecf8e5ae",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Herr Zeppelin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dbbc3bf2-f612-4eee-8b3f-9ff926b69799",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Die Zeppelins fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a2b1ac64-88f1-4f77-b013-4e43944c5431",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Der Zeppelin trägt nie die Schals, die die Zeppelin ihm strickt."
                                            },
                                            {
                                                "example_id": "f836ea5d-773d-4e36-ba9b-3d8ae10cbaf8",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zeppelin kommt, geht der Herr Zeppelin.“"
                                            },
                                            {
                                                "example_id": "988e924e-f851-4e39-ad75-74d82050ce9b",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelin kommt und geht."
                                            },
                                            {
                                                "example_id": "b841a79e-ee05-47b4-94f6-6b4a3c61d5ac",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7757bebc-0fb6-4d54-877d-75a2b59cbaed",
                        "source_entry_id": "79a55693-5fc2-337d-af77-37a0c4880772",
                        "source_sense_id": "c8b5edcf-0657-372d-ab41-131ef82349d4",
                        "source_sense_description": "luchtschip in de lucht gehouden door een groot volume waterstof of helium",
                        "target_lang_word": "airship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c825fd4-7f09-3217-9ffd-022405b47de1",
                                        "entry_id": "fc76fb7a-8431-3d02-b4a8-c6fc9a6447c9",
                                        "glosses": [
                                            "A lighter-than-air aircraft that can be propelled forward through the air as well as steered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b919d8-c819-41ac-ad13-74022343b910",
                                                "sense_id": "1c825fd4-7f09-3217-9ffd-022405b47de1",
                                                "text": "Airships are posited to be cheaper to operate over time than fixed-wing aircraft, but as there are no large fleets, this is hard to prove in practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0931b049-efcb-3730-b7dc-85162436a6f5",
                                        "entry_id": "fc76fb7a-8431-3d02-b4a8-c6fc9a6447c9",
                                        "glosses": [
                                            "A police air unit, a police helicopter."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c05a4278-4b95-39d6-b5bf-5e0077c0f953",
                                        "entry_id": "fc76fb7a-8431-3d02-b4a8-c6fc9a6447c9",
                                        "glosses": [
                                            "Any aircraft."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7adfd009-a9de-4f61-a725-1d050282f21e",
                                                "sense_id": "c05a4278-4b95-39d6-b5bf-5e0077c0f953",
                                                "text": "On weekends, I liked to spend my time at the airport watching the various airships take off and land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                        "entry_id": "fc76fb7a-8431-3d02-b4a8-c6fc9a6447c9",
                                        "glosses": [
                                            "A high ranking official of the RAF, viewed as arrogant and distant."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af2dd03-7971-40c3-b1a2-1f2bdb96a753",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "I only make them to add perhaps a little weight to my view that, whether one thinks of Their Lordships of the Admiralty, or of Their Airships of the Air Ministry, or of Their Coalships of Lansdowne House, or of any other governing body, what is vastly more important than the precise theoretical form of the superstructure is the will—and the capacity—throughout the organisation to make the organisation work."
                                            },
                                            {
                                                "example_id": "088ac830-f779-4626-abd3-1e9317a9e0f4",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "Then where does the Navy come in, since it is generally agreed that the primary role of the Navy is the protection of our merchant ships? It is obvious that neither their Lordships of the Admiralty nor their Airships of the Air Ministry will relinquish their power without a struggle."
                                            },
                                            {
                                                "example_id": "1b38906c-fe74-4656-9552-e6a260f0b4e1",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "And all the time, ever present but out of sight, \"their Airships,” as they called the RAF top brass, were also watching, praying."
                                            },
                                            {
                                                "example_id": "53958fc5-1a8b-4a76-8401-35ce397f88c2",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "But their Airships insisted that we fly there."
                                            },
                                            {
                                                "example_id": "30d0b415-7ae7-4dee-ac89-bef4474ba188",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "Trespassing on superior ground was frowned upon, and although it was difficult to look serious, and infra dig to salute when wearing only swimming trunks, a deferential nod on passing their Airships was expected and its absence noted!"
                                            },
                                            {
                                                "example_id": "be7cd77f-ffd1-4e97-add4-365f082cd613",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "For the Air Council – 'their airships', in counterpoint to the Board of Admiralty – nuclear deterrence and the manned bomber were the overriding concerns of the postwar era."
                                            },
                                            {
                                                "example_id": "4728d2a5-a533-4cae-a3b5-bbe930ae30cc",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "\"Their Airships back in London didn't give a bugger about Malta,\" he [Tom Neil] says"
                                            },
                                            {
                                                "example_id": "70dceed4-1943-49a7-9364-675973f81a06",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "An advance party from No 1 Flight had travelled this route some days previously to wherever 'Their Airships' decreed."
                                            },
                                            {
                                                "example_id": "29b4971f-1347-4168-8e7f-a560756fa8a6",
                                                "sense_id": "0d2f4081-9c75-3bd4-bea4-fefb135e6a4f",
                                                "text": "Still, when their Airships said 'Jump', we minions invariably replied 'How high?'"
                                            }
                                        ]
                                    }
                                ]
                            },
