                ],
                "senses": [
                    {
                        "sense_id": "9ab63f86-4f46-3f4a-8ea5-dfad4da31b15",
                        "entry_id": "2127eb6a-f979-3e10-8d88-d6491df3f418",
                        "glosses": [
                            "nach Art der Psycholinguistik, die Psycholinguistik betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c7e9fb-7522-458c-8f29-59a619782179",
                                "sense_id": "9ab63f86-4f46-3f4a-8ea5-dfad4da31b15",
                                "text": "„Auch hier scheint es so zu sein, daß erst eine brauchbare linguistische Theorie der Metapher, zu der Ansätze vorhanden sind, eine solide Basis für psycholinguistische Interpretation abgeben kann.“"
                            },
                            {
                                "example_id": "8790f3fe-4e1f-488f-8467-8dc3ecebf13f",
                                "sense_id": "9ab63f86-4f46-3f4a-8ea5-dfad4da31b15",
                                "text": "„Als »externe« Evidenz für das eine oder andere Silbenmodell werden in der Regel psycholinguistische Befunde, Arbeiten der Versprecherforschung, der Spracherwerb von Kindern, Reduplikationsphänomene undsoweiter (…) angeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
