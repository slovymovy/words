                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6cf2562-d23d-334f-9b9d-9389d9b227be",
                        "entry_id": "70b89017-6d06-39a0-8fbd-d9ad872cae30",
                        "glosses": [
                            "Voiture de louage, fiacre, taxi (transport de personnes)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "04a4cbc4-6c35-4e47-b9e5-f9fbd985cabf",
                                "sense_id": "f6cf2562-d23d-334f-9b9d-9389d9b227be",
                                "text": "On a dû marcher jusqu’à l’avenue du Maine pour trouver un bahut convenable, une traction noire, toute neuve."
                            },
                            {
                                "example_id": "146cc2b6-3725-4394-b785-d769b6c6340f",
                                "sense_id": "f6cf2562-d23d-334f-9b9d-9389d9b227be",
                                "text": "Il est rien moche son bahut. [le taxi de Charles dit Zazie]"
                            },
                            {
                                "example_id": "5248fa3b-ac78-4154-b25b-50d501e6c0f9",
                                "sense_id": "f6cf2562-d23d-334f-9b9d-9389d9b227be",
                                "text": "— Où qu’il est ton tapis ? — À Montparnasse. On attend le prochain métro ? — Non, t’es folle. Viens, on va prendre un bahut."
                            }
                        ]
                    },
                    {
                        "sense_id": "204d98c0-27d1-3758-a603-92d0d29f4de4",
                        "entry_id": "70b89017-6d06-39a0-8fbd-d9ad872cae30",
                        "glosses": [
                            "Camion, poids lourd (transport de marchandises)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "431d741b-4360-48c7-99ca-3b3c6d553ea7",
                                "sense_id": "204d98c0-27d1-3758-a603-92d0d29f4de4",
                                "text": "Les chauffeurs le savaient tous et ceux qui arrivaient après l’heure légale en étaient souvent quittes pour garer leur bahut dans la rue en attendant la reprise des activités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b67b9570-09b2-4c1c-836d-21af96655619",
                        "source_entry_id": "70b89017-6d06-39a0-8fbd-d9ad872cae30",
                        "source_sense_id": "f6cf2562-d23d-334f-9b9d-9389d9b227be",
                        "source_sense_description": "Meuble",
                        "target_lang_word": "Truhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Truhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                        "entry_id": "e3f83cb1-8342-39db-a0a7-39c6c4dfeae0",
                                        "glosses": [
                                            "verschließbarer, kastenartiger Behälter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5841bec1-eedf-42b9-93fc-ecb4da96df2f",
                                                "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                                "text": "Sie hat die Truhe im Antiquitätenhandel erworben."
                                            },
                                            {
                                                "example_id": "adbe9931-02c9-4b20-8564-5a19382359f9",
                                                "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                                "text": "„Zu dieser Truhe gab es einen Schlüssel.“"
                                            },
                                            {
                                                "example_id": "0054a830-6d87-44b8-92b1-170173689815",
                                                "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                                "text": "„Sie öffnete die Küchenbank, durchstöberte die Truhe darunter und fand ganz unten das Fotoalbum.“"
                                            },
                                            {
                                                "example_id": "69973e19-0312-4bc0-81e6-5b3eb4e92fca",
                                                "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                                "text": "„Als ich mit dem Gesandten Giovanni Donà an Bord ging, fand ich auf dem Schiff eine Truhe, die Jussuf mir zum Geschenk machte.“"
                                            },
                                            {
                                                "example_id": "67198881-02c7-427c-a233-99e8c0d136a6",
                                                "sense_id": "433c61a4-8c27-3fac-a827-1477c6dd3380",
                                                "text": "„Er holte aus den Fach einer Truhe die Flasche hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3808aba5-107f-4f34-80a0-5a3e8db49c69",
                        "source_entry_id": "70b89017-6d06-39a0-8fbd-d9ad872cae30",
                        "source_sense_description": "Lycée, Collège",
                        "target_lang_word": "Penne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Penne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1874f90-466b-3969-9114-5dd26fbd0691",
                                        "entry_id": "a5391cc0-a1a3-303c-a99f-842b5fdec62e",
                                        "glosses": [
                                            "salopper bis oft leicht negativer Ausdruck für eine (höhere) Schule"
                                        ],
                                        "tags": [
                                            "Schülerjargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf9c6a4-3a62-44e9-a717-8c443298da68",
                                                "sense_id": "d1874f90-466b-3969-9114-5dd26fbd0691",
                                                "text": "In diesem Gebäude war meine alte Penne."
                                            },
                                            {
                                                "example_id": "48a159bd-5da6-4810-a9d3-dd3e5d196894",
                                                "sense_id": "d1874f90-466b-3969-9114-5dd26fbd0691",
                                                "text": "„Er dachte auch daran, wie der alte Mann tagaus, tagein auf seinen Bock stieg, um ein paar Mark nach Hause zu bringen – aber das Schulgeld, alles, was Heinz für die Penne brauchte, wurde stets klaglos gezahlt.“"
                                            },
                                            {
                                                "example_id": "2dd5b16e-e667-48ff-bae1-30aa93cbe6d9",
                                                "sense_id": "d1874f90-466b-3969-9114-5dd26fbd0691",
                                                "text": "„Er sagte, bei den Deppen in seiner Penne sei das keine große Kunst, aber er hatte wieder Oberwasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68fc5968-2206-38cc-a997-a7c11671e529",
                                        "entry_id": "a5391cc0-a1a3-303c-a99f-842b5fdec62e",
                                        "glosses": [
                                            "Notunterkunft für die Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce28bf79-af2f-46c2-b55b-e26053f038e1",
                                                "sense_id": "68fc5968-2206-38cc-a997-a7c11671e529",
                                                "text": "Beim letzten Trip sind wir teilweise in den miesesten Pennen abgestiegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cb163c4-87c0-3b79-83a9-c17a91a24321",
                                        "entry_id": "a5391cc0-a1a3-303c-a99f-842b5fdec62e",
                                        "glosses": [
                                            "Prostituierte"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d557cf-004c-4d4e-a624-e2f5054df798",
                                                "sense_id": "3cb163c4-87c0-3b79-83a9-c17a91a24321",
                                                "text": "Er war gestern Nacht noch bei einer Penne."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Penne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b18b61b3-7b6b-3d92-9f57-24a0a316eba1",
                                        "entry_id": "4446a126-2377-3096-a2e3-d85e7e2d5544",
                                        "glosses": [
                                            "röhrenförmige Nudeln aus Hartweizenmehl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c15f8a-5156-4dc1-81fa-a49b78fa8452",
                                                "sense_id": "b18b61b3-7b6b-3d92-9f57-24a0a316eba1",
                                                "text": "Mein Leibgericht ist Penne mit Gemüse und Pute, und gerade bin ich auf dem Weg zum Italiener nebenan, um genau das zu essen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
