                "senses": [
                    {
                        "sense_id": "1aa4ebe2-f7bd-3be0-bbff-a23f579572d2",
                        "entry_id": "065a03c0-5344-30a3-b5a0-7e654684c62e",
                        "glosses": [
                            "Person oder Sache, die Geruch verursacht; jemand, der an der Geruchsbildung und der Geruchsemission die Schuld trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f640c390-a11c-4133-ac16-64b079d40f05",
                                "sense_id": "1aa4ebe2-f7bd-3be0-bbff-a23f579572d2",
                                "text": "„Es wird so geklärt, ob es im Bereich der vorhandenen Wohnhäuser (Immissionsorte) aufgrund des Emissionspotentials der vorhandenen bzw. der geplanten Geruchsverursacher zu Geruchsimmissionen kommen kann.“"
                            },
                            {
                                "example_id": "a7a18599-d53e-4873-8834-d4717b877598",
                                "sense_id": "1aa4ebe2-f7bd-3be0-bbff-a23f579572d2",
                                "text": "„Die oft schwierige Ermittlung der Geruchsverursacher grenzte sich auf bestimmte Verursacher ein.“"
                            },
                            {
                                "example_id": "785dff0f-c407-48ca-858d-8b11fce2637b",
                                "sense_id": "1aa4ebe2-f7bd-3be0-bbff-a23f579572d2",
                                "text": "„Als Geruchsverursacher haben die Anwohner der Prießnitzstraße einmal mehr die in Sichtweite gelegenen Recyclingfirmen Multiport und Multipet in der Ernst-Grube-Straße ausgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5fadf29c-20a9-30a3-8f79-dfbb454059c8",
                        "entry_id": "065a03c0-5344-30a3-b5a0-7e654684c62e",
                        "glosses": [
                            "Substanz oder Mikroorganismen die Geruch verursacht; jemand, der an der Geruchsbildung und der Geruchsemission die Schuld trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da567acb-286f-42f6-a6dd-7f873d782fdd",
                                "sense_id": "5fadf29c-20a9-30a3-8f79-dfbb454059c8",
                                "text": "„Als Geruchsverursacher haben die Anwohner der Prießnitzstraße einmal mehr die in Sichtweite gelegenen Recyclingfirmen Multiport und Multipet in der Ernst-Grube-Straße ausgemacht.“"
                            },
                            {
                                "example_id": "a3fdd7c1-50ce-4131-92f7-2a498970452e",
                                "sense_id": "5fadf29c-20a9-30a3-8f79-dfbb454059c8",
                                "text": "„Sollten Sie unter Mundgeruch leiden, dann zeigt Ihnen Ihr Zahnarzt, je nach Befund, gerne den richtigen Umgang mit Zahnbürste, Zungenreiniger und Mundwasser, so dass Sie die bakteriellen Geruchsverursacher schnell und wirksam in den Griff bekommen.“"
                            },
                            {
                                "example_id": "805bcba1-1ae3-429f-b1a7-e76fca89cbd0",
                                "sense_id": "5fadf29c-20a9-30a3-8f79-dfbb454059c8",
                                "text": "„Auf der Suche nach dem Geruchsverursacher wurden an einigen Stellen im Kindergarten Schimmelpilze fest gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
