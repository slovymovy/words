                    },
                    {
                        "form_id": "5c658763-b787-4710-aeed-44a603ef0233",
                        "entry_id": "03de4fe9-0060-3123-918b-02b4338f4bee",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "caloporteuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72949fb6-7a0c-3ad5-b1fe-b3bdeb40fc7e",
                        "entry_id": "03de4fe9-0060-3123-918b-02b4338f4bee",
                        "glosses": [
                            "Se dit d’un fluide transportant de l’énergie thermique d’un système à un autre et notamment du fluide circulant dans le cœur d’un réacteur nucléaire pour en évacuer la chaleur."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d24467c6-166d-4173-852f-7eadf4c0f1e8",
                                "sense_id": "72949fb6-7a0c-3ad5-b1fe-b3bdeb40fc7e",
                                "text": "Par exemple, l’importation de gazole repris à la nomenclature combinée 27 10 19 43 commercialisé pour une utilisation en tant que fluide caloporteur (décret 99-508 du 17 juin 1999) rend ce produit taxable à la TGAP, […]."
                            },
                            {
                                "example_id": "705e119e-dd0b-42f3-a21c-d9bdf89b23a2",
                                "sense_id": "72949fb6-7a0c-3ad5-b1fe-b3bdeb40fc7e",
                                "text": "Les unités de chauffage indépendantes par circulation d’huile caloporteuse présentent l'avantage d'être installées près de la presse avec une tuyauterie d'alimentation très courte et offrent une régulation précise de la température […]."
                            },
                            {
                                "example_id": "73e6f2ea-8601-4e95-8bd7-b26817a2ef09",
                                "sense_id": "72949fb6-7a0c-3ad5-b1fe-b3bdeb40fc7e",
                                "text": "Par régulation thermostatique, la chaudière se déclenche seulement si la chaleur solaire est insuffisante; néanmoins l’eau caloporteuse est préchauffée et réduit l’augmentation de température nécessaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78198281-e50a-449a-b412-f8317c4cbeb1",
                        "source_entry_id": "03de4fe9-0060-3123-918b-02b4338f4bee",
                        "source_sense_id": "72949fb6-7a0c-3ad5-b1fe-b3bdeb40fc7e",
                        "target_lang_word": "coolant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                        "entry_id": "029bb350-e5e0-37c2-b0e7-e59bf6de9640",
                                        "glosses": [
                                            "A medium, usually fluid, used to draw heat from an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d636eb25-3c91-43c6-8c15-3e190c3832af",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Coolant is used in car engines and industrial processes, where excess heat could cause machine damage."
                                            },
                                            {
                                                "example_id": "b97c4eb3-45cc-4cf9-9f5e-02102b1eb0d8",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Anti-freeze has not been found necessary, even in the most severe conditions, since the water is drained out if a locomotive spends any appreciable time out of service and in normal working conditions the coolant is always warm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
