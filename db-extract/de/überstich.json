                "senses": [
                    {
                        "sense_id": "19072fee-df9e-3929-b0bc-7bb8344f05bb",
                        "entry_id": "0e075b73-3cb3-38ee-84d3-92ad9c2dc295",
                        "glosses": [
                            "Stich, den der Alleinspieler über das Mindestmaß an notwendigen Stichen hinaus macht, um seinen Kontrakt zu erfüllen"
                        ],
                        "tags": [
                            "Bridge"
                        ],
                        "examples": [
                            {
                                "example_id": "82c55d5d-203b-470f-abe7-37d9c8f742ef",
                                "sense_id": "19072fee-df9e-3929-b0bc-7bb8344f05bb",
                                "text": "„Ein Spiel ist vom Alleinspieler gewonnen, wenn er mindestens so viel Stiche macht wie im Kontrakt, d. h. im letzten abgegebenen Gebot, versprochen. Zusätzliche Stiche heißen Überstiche.“"
                            },
                            {
                                "example_id": "1d541264-1d6c-45fd-aec3-f9afbb531c13",
                                "sense_id": "19072fee-df9e-3929-b0bc-7bb8344f05bb",
                                "text": "Laut Scoretabelle der Turnier-Bridge-Regeln des Deutschen Bridgeverbands wird jeder kontrierte Überstich mit 100 Punkten (nicht in Gefahr) bzw. 200 Punkten (in Gefahr) abgerechnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
