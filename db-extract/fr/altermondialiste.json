                "senses": [
                    {
                        "sense_id": "a3fc1846-fe84-3596-b368-1944fe144322",
                        "entry_id": "11ee7bc0-6399-3fbc-89b6-db4fb0061c96",
                        "glosses": [
                            "Personne qui recherche une autre façon d’organiser le commerce mondial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a90af1b-d2d0-43d6-8738-a3f6092e3507",
                                "sense_id": "a3fc1846-fe84-3596-b368-1944fe144322",
                                "text": "Il se révèle être un altermondialiste convaincu et remet en cause l'ordre établi."
                            },
                            {
                                "example_id": "a1fad152-c051-413a-a9e9-76b1e151c2a2",
                                "sense_id": "a3fc1846-fe84-3596-b368-1944fe144322",
                                "text": "En effet, après avoir longtemps penché pour l’hypothèse de l’accident, les enquêteurs avaient détecté les traces d’une cyberattaque sur le réseau de l’usine, remontant jusqu’à une secte d’altermondialistes de la région."
                            }
                        ]
                    }
                ],
