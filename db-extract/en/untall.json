                        ],
                        "examples": [
                            {
                                "example_id": "8d5c9311-d1ea-4b25-9589-7f7d0aad5e6e",
                                "sense_id": "ac58870d-d951-3f98-bc00-b30a0e8afc68",
                                "text": "Some mystics would say / that I myself selected this body, / a fitting vehicle in which to deal / with karma from lives gone by / when I no doubt poked fun / at the untall, the unwillowy."
                            },
                            {
                                "example_id": "9768939c-b215-4471-8af1-f48555c9fcdc",
                                "sense_id": "ac58870d-d951-3f98-bc00-b30a0e8afc68",
                                "text": "Untall, unfattish, with the balding coming flaw and the ordinary brownness of the man promising an unusual sandiness in a few years."
                            }
                        ]
                    }
