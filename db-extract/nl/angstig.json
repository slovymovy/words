                    }
                ],
                "senses": [
                    {
                        "sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                        "entry_id": "d624cf42-a1fe-3237-81e5-c5a3f443cb54",
                        "glosses": [
                            "vol van bange gevoelens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a65042-56e2-47dd-b38e-17b0a1889569",
                                "sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                                "text": "We hebben zo iets angstigs beleefd! We werden bijna door een grote vrachtauto van de weg gedrukt."
                            },
                            {
                                "example_id": "05d7598f-98eb-4c83-9bd9-92597c2b408d",
                                "sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                                "text": "Ondertussen was ik stukje bij beetje uit mijn angstige gemoedstoestand van de afgelopen weken gekomen en voelde ik me steeds beter op de trail."
                            },
                            {
                                "example_id": "dda02fa7-c8c5-4ccf-9555-2b0185e8d23f",
                                "sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                                "text": "Hij stak beide, gesloten handen omhoog en keek gemaakt angstig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "481f04b1-42ef-402f-9bf7-9f90a53984b7",
                        "source_entry_id": "d624cf42-a1fe-3237-81e5-c5a3f443cb54",
                        "source_sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                        "target_lang_word": "ängstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ängstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "von Angst ergriffen, erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a568197-0069-4c44-ba60-2f7f001eac3b",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "„… allmählich verschwanden die Menschen, ich armes Kind irrte ängstlich umher, stand endlich vor der Weidenhecke eines wüsten Bauerhofes und sah dort einen Mann, der mit dem Spaten die Erde aufwühlte, und neben ihm ein häßlich hämisches Weib, das etwas wie einen abgeschnittenen Menschenkopf in der Schürze hielt, …“ (Heinrich Heine:Heinrich Heine: „Ideen. Das Buch Le Grand“)"
                                            },
                                            {
                                                "example_id": "c5db7cae-8d27-458f-812b-c8d2653518d0",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Nun sei doch nicht so ängstlich, der Hund tut dir nichts!"
                                            },
                                            {
                                                "example_id": "18fa6369-5a38-49d1-a054-bdbac6cba1ec",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Sie warf ihrem Vater einen ängstlichen Blick zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "peinlich genau, akkurat"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def51077-74aa-4af9-80f9-014f7225adca",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Peter ist immer so ängstlich bemüht, ja kein Frage zu verpassen."
                                            },
                                            {
                                                "example_id": "85e31e26-0561-4376-b290-86c8905d3a3e",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Der Revisor ist ängstlich bestrebt, keinen Fehler zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "nicht so eilig, nicht so genau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e804bc20-fb11-4edf-9523-ef6829169e4f",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Das ist jetzt nicht so ängstlich mit der Post, die kann auch morgen raus."
                                            },
                                            {
                                                "example_id": "2f73b0aa-aa9c-4392-aade-d90aeda3d57a",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Du musst nicht so ängstlich mit der Temperaturwahl sein, ein paar Grad mehr oder weniger spielen hier keine Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4abebfb-0467-491e-ae27-0e7bc52375d2",
                        "source_entry_id": "d624cf42-a1fe-3237-81e5-c5a3f443cb54",
                        "source_sense_id": "719a22be-fe71-3266-af2d-5e02b31e338b",
                        "target_lang_word": "fearful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Frightening; causing fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be41e871-4f55-4fce-96b5-b98646dc0820",
                                                "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                                "text": "Sirs, stop their mouths, let them not speak to me,\nBut let them hear what fearful words I utter."
                                            },
                                            {
                                                "example_id": "6660a689-a025-481e-8779-2ebcdb92969c",
                                                "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                                "text": "In the later Hebrew midrash Lilith is presented as the woman who knows how to recite the fearful name of God to work calamity; that this little girl cries out the fearful name of the sun god and thereby causes an earthquake would indicate that this girl is linked in the structure of the myth with Lilith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1ea97a-54d9-36b9-b42e-e7a9a692e867",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Tending to fear; timid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbba78c-fec1-42b2-bda4-c9c31686d6b7",
                                                "sense_id": "6f1ea97a-54d9-36b9-b42e-e7a9a692e867",
                                                "text": "a fearful boy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d956c5-1812-3215-b615-f25ff0466185",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Terrible; shockingly bad."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f759f5-53d6-471c-8add-a60fad61da5b",
                                                "sense_id": "f1d956c5-1812-3215-b615-f25ff0466185",
                                                "text": "But every day after dinner, for an hour, we were all together, and then the Favourite and the rest of the Royal Hareem competed who should most beguile the leisure of the Serene Haroun reposing from the cares of State — which were generally, as in most affairs of State, of an arithmetical character, the Commander of the Faithful being a fearful boggler at a sum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Frightened; filled with terror."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ad73032-828f-422a-87ab-54dc6336778f",
                                                "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                                "text": "kings ſhall crouch vnto our conquering ſwords,\nAnd hoſtes of Souldiers ſtand amazd at vs,\nWhen with their fearfull tongues they ſhall confeſſe\nTheſe are the men that al the world admires,"
                                            },
                                            {
                                                "example_id": "4d7f792f-848d-48d9-99c6-e1808a16465a",
                                                "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                                "text": "Those two great champions did attonce pursew / The fearefull damzell with incessant payns […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                        "entry_id": "7e2b64df-f4d9-3469-94a8-3031097bc4bd",
                                        "glosses": [
                                            "Extremely; fearfully."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82e2baae-7359-4828-b2dc-5c4864dc1f9f",
                                                "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                                "text": "“He is fearful handsome, as you know,” she said remorsefully, “you cannot imagine, Georgiana, the joy when I first fell in love with him.”"
                                            },
                                            {
                                                "example_id": "8e96bdee-e266-4af5-a71f-925595f51741",
                                                "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                                "text": "“It's a fearful strong charm needs dragon's blood,” he said plaintively."
                                            },
                                            {
