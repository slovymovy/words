                        ],
                        "examples": [
                            {
                                "example_id": "d03b24e6-dbbc-4f0f-bf95-327c2e6ccc11",
                                "sense_id": "a4317bed-5438-3c28-8da5-ed535f56df8e",
                                "text": "Mon apparence d’insensibilité d’ailleurs ne portait pas à la pitié ; je me garais des horions tant bien que mal et pour la forme ; mais quand c’était fini, on ne voyait pas trace de peur ou de douleur sur ma figure. Je n’étais de la sorte ni un patiras ni un pestiféré."
                            },
                            {
                                "example_id": "eb5a5139-c6b9-4ce4-9d19-e93a876b766a",
                                "sense_id": "a4317bed-5438-3c28-8da5-ed535f56df8e",
                                "text": "Moi qui tout à l'heure étais le pâtiras de tout le monde."
                            }
                        ]
                    }
                ],
