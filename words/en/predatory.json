    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "119774da-9bf6-3681-83f8-2ac48881fdc5",
                    "sense_definition": "Living by preying on other animals for food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological predation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle is a <w>predatory</w> bird that hunts small mammals from the sky.",
                            "target_lang_translations": {
                                "ru": "Орел — это <w>хищная</w> птица, которая охотится на мелких млекопитающих с неба."
                            }
                        },
                        {
                            "text": "Many <w>predatory</w> animals have sharp claws and keen eyesight to help them catch their prey.",
                            "target_lang_translations": {
                                "ru": "Многие <w>хищные</w> животные обладают острыми когтями и острым зрением, помогающими им ловить добычу."
                            }
                        }
                    ],
                    "synonyms": [
                        "predaceous",
                        "predacious"
                    ],
                    "common_phrases": [
                        "predatory animals",
                        "predatory birds",
                        "predatory instincts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живущий за счет охоты на других животных для пропитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хищный",
                                "target_lang_sense_clarification": "о животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                    "sense_definition": "Exploiting or victimizing others for personal, financial, or sexual gain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exploitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new laws to protect vulnerable citizens from <w>predatory</w> lending practices.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые законы для защиты уязвимых граждан от <w>хищнических</w> методов кредитования."
                            }
                        },
                        {
                            "text": "He was described as a <w>predatory</w> businessman who would do anything to bankrupt his competitors.",
                            "target_lang_translations": {
                                "ru": "Его описывали как <w>хищного</w> бизнесмена, готового на все, чтобы обанкротить своих конкурентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "predatory lending",
                        "predatory pricing",
                        "predatory behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эксплуатирующий других или наживающийся на них ради личной, финансовой или сексуальной выгоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хищнический",
                                "target_lang_sense_clarification": "о методах, бизнесе или поведении"
                            },
                            {
                                "target_lang_word": "хищный",
                                "target_lang_sense_clarification": "о человеке или взгляде"
                            },
                            {
                                "target_lang_word": "эксплуататорский",
                                "target_lang_sense_clarification": "о практике или системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                    "sense_definition": "Relating to or characteristic of a predator, often used to describe a sharp or aggressive skill in sports.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological predation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker showed his <w>predatory</w> instincts by scoring a goal from a very difficult angle.",
                            "target_lang_translations": {
                                "ru": "Нападающий проявил свои <w>хищные</w> инстинкты, забив гол с очень сложного угла."
                            }
                        },
                        {
                            "text": "The journalist had a <w>predatory</w> look in his eyes as he waited for the politician to make a mistake.",
                            "target_lang_translations": {
                                "ru": "У журналиста был <w>хищный</w> блеск в глазах, пока он ждал, когда политик совершит ошибку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "predatory instincts",
                        "predatory best"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к качествам хищника; часто используется для описания острого или агрессивного мастерства в спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хищный",
                                "target_lang_sense_clarification": "об инстинктах или взгляде"
                            },
                            {
                                "target_lang_word": "хищнический",
                                "target_lang_sense_clarification": "о повадках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}