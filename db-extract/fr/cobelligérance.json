                "senses": [
                    {
                        "sense_id": "4473e90b-ea2d-3b9b-9986-450a170fdb38",
                        "entry_id": "78f098fe-c343-33d5-a50b-9cb58a8201d2",
                        "glosses": [
                            "Fait d’être belligérant, d’être en guerre contre un ennemi commun, en coopération avec un ou plusieurs alliés avec lesquels on n’a cependant pas de traité formel d’alliance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac3e76a4-ab46-4f38-9b2c-0700699b8cb4",
                                "sense_id": "4473e90b-ea2d-3b9b-9986-450a170fdb38",
                                "text": "En même temps, l’issue était certaine : l’isolement international de Kadhafi, la cobelligérance de l’Otan aux côtés des insurgés ne pouvaient qu’amener à la défaite de Kadhafi."
                            },
                            {
                                "example_id": "20adf433-42df-4811-b404-8df30aede03c",
                                "sense_id": "4473e90b-ea2d-3b9b-9986-450a170fdb38",
                                "text": "D’autres esprits chagrins ont alors qualifié de « cobelligérance » la participation des Etats-Unis et de la France à cette méchante guerre - ils fournissent aussi des renseignements très utiles aux Saoudiens -, sans obtenir pour autant l’ouverture d’un débat à Washington ou à Paris."
                            }
                        ]
                    }
                ],
