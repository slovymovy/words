                "senses": [
                    {
                        "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                        "entry_id": "402bacb8-a700-36cd-80dc-09f79cc5c053",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce3991e-8a36-48da-8346-e6c419960d73",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Frau Seyfried ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "69b547f9-f850-4437-80a7-19e93b598e26",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Herr Seyfried wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "96ac3804-e097-4caf-b622-a0aa126cd82f",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Die Seyfrieds fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "cfc3e214-781d-454d-b255-6f5aeab03604",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Der Seyfried trägt nie die Schals, die die Seyfried ihm strickt."
                            },
                            {
                                "example_id": "73fecaa0-2a2b-4781-8fae-b442052c3089",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seyfried kommt, geht der Herr Seyfried.“"
                            },
                            {
                                "example_id": "1da8f70e-a582-4a37-8c8a-1e36722fb761",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Seyfried kommt und geht."
                            },
                            {
                                "example_id": "6048656d-ae18-4eb3-89de-8c43f878574c",
                                "sense_id": "76d52080-2765-33b0-9de0-274213cd47b2",
                                "text": "Seyfrieds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
