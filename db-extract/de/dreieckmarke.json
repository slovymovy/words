                        "glosses": [
                            "Briefmarke, in der Form eines regelmäßigen oder unregelmäßigen Dreiecks, die auf einer Spitze oder Seite steht; das ungewöhnliche Format wies auf die Sonderbehandlung der Sendung hin."
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "1ea5c3ec-7cb1-4f18-9fb1-4a6744874eec",
                                "sense_id": "b338c23c-6cdf-35f1-9ffb-0717c450bad7",
                                "text": "In Deutschland kamen die ersten Dreieckmarken ab dem 1. Dezember 1939 im Besetzungsgebiet von Böhmen und Mähren heraus."
                            },
                            {
                                "example_id": "c3755e78-0471-482b-addb-6657f735d2a7",
                                "sense_id": "b338c23c-6cdf-35f1-9ffb-0717c450bad7",
                                "text": "Ich suche noch die Dreieckmarke vom Kap der guten Hoffnung."
                            }
