                "senses": [
                    {
                        "sense_id": "1e3fddd9-2111-37ee-a3b0-804148d443f6",
                        "entry_id": "58343cba-d99c-3de1-80a3-8484dc80a9e9",
                        "glosses": [
                            "eine von zumeist staatlichen Institutionen berufene Person, die die Bekämpfung von Antisemitismus organisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fad2e78-deaf-4ca9-8f70-6bffc33b2100",
                                "sense_id": "1e3fddd9-2111-37ee-a3b0-804148d443f6",
                                "text": "In Niedersachsen wird die Einführung eines Antisemitismusbeauftragten seit April 2018 geprüft."
                            },
                            {
                                "example_id": "15af5aca-0988-4238-a946-1e715443bea2",
                                "sense_id": "1e3fddd9-2111-37ee-a3b0-804148d443f6",
                                "text": "Der Antisemitismus-Beauftragte der Bundesregierung, Felix Klein, appelliert an die Bürger, am kommenden Samstag Kippa zu tragen."
                            },
                            {
                                "example_id": "06976c50-67bb-47d1-96e7-ee78a9f3e014",
                                "sense_id": "1e3fddd9-2111-37ee-a3b0-804148d443f6",
                                "text": "In den ersten Landesbericht des Antisemitismusbeauftragten Baden-Württembergs sind die Erhebungen der Leipziger Studien zu Autoritarismus und rechtsextremer Einstellung 2002-2018 gesondert für Baden-Württemberg ausgewertet worden."
                            },
                            {
                                "example_id": "33bec447-0cb4-4e30-9c0c-054e4bb04b05",
                                "sense_id": "1e3fddd9-2111-37ee-a3b0-804148d443f6",
                                "text": "Bischof Hein fordert Antisemitismusbeauftragten für die EKD."
                            }
                        ],
