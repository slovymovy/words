                ],
                "senses": [
                    {
                        "sense_id": "839ed83a-c512-3df8-9165-d88d4113dc48",
                        "entry_id": "63dd119b-e6e0-35ae-a069-af1019134530",
                        "glosses": [
                            "Bewohner des Alpengebietes"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "01233161-6568-477e-bc19-7c09d5569062",
                                "sense_id": "839ed83a-c512-3df8-9165-d88d4113dc48",
                                "text": "„Eigentümlich sind die vielen, teils in vorrömische Zeit hineinreichenden Volksbräuche und -sagen dieser Älpler, die meist Viehzuchtd, in den südlichen Alpen auch Acker- und Weinbau betreiben.“"
                            },
                            {
                                "example_id": "49508532-f57e-4724-8fb6-c2afa23b0e0c",
                                "sense_id": "839ed83a-c512-3df8-9165-d88d4113dc48",
                                "text": "„Nur zwei Älpler fanden den Weg ins Flachland, sekundiert von einem Portugiesen und einem einsamen Monegassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4b944e1-6166-30f3-a446-9bcf487be79c",
                        "entry_id": "63dd119b-e6e0-35ae-a069-af1019134530",
                        "glosses": [
                            "Hirte auf Almen oder Alpweiden"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "8465f8cf-c912-4278-a991-ef4c29072be7",
                                "sense_id": "a4b944e1-6166-30f3-a446-9bcf487be79c",
                                "text": "„Der Älpler wird eine Spezies der romantischen Idee »naiver Naturbursche«.“"
                            },
                            {
                                "example_id": "1b77f06a-4137-432e-972a-9b3a551d44ed",
                                "sense_id": "a4b944e1-6166-30f3-a446-9bcf487be79c",
                                "text": "„Ein Älpler, der seit 30 Jahren die Alp bewirtschaftet, hat so etwas auch noch nie erlebt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
