                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessécher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f79a6097-613b-3057-9283-6e19f7fe5608",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Rendre sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debda223-9ad2-4f13-91f0-c5cd9afb46c1",
                                                "sense_id": "f79a6097-613b-3057-9283-6e19f7fe5608",
                                                "text": "Vous verrez des femmes faisant du bois, c’est-à-dire collant des bouses de vache le long des murs pour les dessécher et les entasser comme les mottes à Paris ; puis, l’hiver, on se chauffe de ce bois-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d6a997-d2b5-386e-80a6-b7a3ed529781",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Mettre à sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7da1795-5753-46ed-907c-4c23bc9aad44",
                                                "sense_id": "05d6a997-d2b5-386e-80a6-b7a3ed529781",
                                                "text": "Dessécher les fossés d’une ville."
                                            },
                                            {
                                                "example_id": "28e5f87b-eff1-4ea5-b9b8-4ae140f818d2",
                                                "sense_id": "05d6a997-d2b5-386e-80a6-b7a3ed529781",
                                                "text": "Dessécher un étang."
                                            },
                                            {
                                                "example_id": "9734dc8c-3bfe-4a5b-b63f-248b06be3533",
                                                "sense_id": "05d6a997-d2b5-386e-80a6-b7a3ed529781",
                                                "text": "Ces marais se dessèchent en partie durant l’été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935db7d5-2c36-32c9-b3ca-0800eaa4627f",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Exténuer, amaigrir, consumer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea25760-c4ef-4de0-b664-39b5eb0aade8",
                                                "sense_id": "935db7d5-2c36-32c9-b3ca-0800eaa4627f",
                                                "text": "Un corps que les veilles et les travaux ont desséché."
                                            },
                                            {
                                                "example_id": "c63c0a38-1c31-4ee0-a5bf-57359c3872f8",
                                                "sense_id": "935db7d5-2c36-32c9-b3ca-0800eaa4627f",
                                                "text": "Son corps se dessèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c962c87-a2e7-3c68-8832-bd41142486b4",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Rendre sec, peu fourni."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900b5be3-1f40-4b81-9652-2bcfa027e11d",
                                                "sense_id": "6c962c87-a2e7-3c68-8832-bd41142486b4",
                                                "text": "Dessécher l’esprit, l’imagination, ôter à l’esprit, à l’imagination leur agrément."
                                            },
                                            {
                                                "example_id": "01cf1226-5532-4e05-9ae9-ca95401edffe",
                                                "sense_id": "6c962c87-a2e7-3c68-8832-bd41142486b4",
                                                "text": "Dessécher le cœur, le rendre sec, froid, insensible."
                                            },
                                            {
                                                "example_id": "4b0c6125-9b00-4561-8849-faeea3b4b19b",
                                                "sense_id": "6c962c87-a2e7-3c68-8832-bd41142486b4",
                                                "text": "Cette triste expérience lui a desséché le cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "670b4e2c-4186-3307-87c7-e8bc732a1f34",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Devenir sec."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e4f81c-c8c3-4762-b452-8ad7fa8e22e2",
                                                "sense_id": "670b4e2c-4186-3307-87c7-e8bc732a1f34",
                                                "text": "Ce lac est peu considérable , et se dessèche au mois d'août tellement qu'il n'a pas, en long et en large, plus de 80 sagènes (160 mètres)."
                                            },
                                            {
                                                "example_id": "adbf661a-612b-41eb-bac6-833fe68fad00",
                                                "sense_id": "670b4e2c-4186-3307-87c7-e8bc732a1f34",
                                                "text": "Il paraît que ce désert était autrefois occupé par un vaste bassin central. Il s’est desséché comme se desséchera la Caspienne, et cette évaporation s’explique par l’énergique concentration des rayons solaires […]."
                                            },
                                            {
                                                "example_id": "81aa8f00-931b-4b95-9878-acf29e8fd2ae",
                                                "sense_id": "670b4e2c-4186-3307-87c7-e8bc732a1f34",
                                                "text": "Dans les terres noires (tirs), les résultats sont moins aléatoires. […]. En été, elles se dessèchent et se crevassent, et les premières pluies de l'automne font couler dans les fentes les couches superficielles délayées, exposant ainsi des terrains toujours nouveaux à la surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45883d1-b304-38f1-9197-c6129917899e",
                                        "entry_id": "b08ce3e0-72e0-385e-9efb-cde6ffeacdbc",
                                        "glosses": [
                                            "Désirer quelque chose avec impatience, au point d’en maigrir."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
