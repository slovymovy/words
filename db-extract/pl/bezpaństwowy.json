                                "target_senses": [
                                    {
                                        "sense_id": "8ac7e75b-2a4f-37be-8949-732438538e89",
                                        "entry_id": "e7a52423-d9f4-348f-bdcd-73ecac82de91",
                                        "glosses": [
                                            "Of a system or protocol, such that it does not keep a persistent state between transactions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ea4c32-18a3-42c2-89c2-432070ceb4e8",
                                                "sense_id": "8ac7e75b-2a4f-37be-8949-732438538e89",
                                                "text": "A stateless server treats each request independently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bff7f56-5a33-3c0c-a960-d2d9a1d57a96",
                                        "entry_id": "e7a52423-d9f4-348f-bdcd-73ecac82de91",
                                        "glosses": [
                                            "Without state or pomp."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aa82094-6fd3-39a1-97e4-401b61266b0a",
                                        "entry_id": "e7a52423-d9f4-348f-bdcd-73ecac82de91",
                                        "glosses": [
                                            "Without a state or nationality; not subject to any state."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56d6e09-9ab0-4f6c-a096-82c6b2f5e0da",
                                                "sense_id": "3aa82094-6fd3-39a1-97e4-401b61266b0a",
                                                "text": "UN Convention relating to the Status of Stateless Persons"
                                            },
                                            {
                                                "example_id": "5e18ac1a-bd9e-4aab-9482-45e3dd9ecc63",
                                                "sense_id": "3aa82094-6fd3-39a1-97e4-401b61266b0a",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f3c74d-9ad8-3773-9b9e-bdb07268d53a",
                                        "entry_id": "e7a52423-d9f4-348f-bdcd-73ecac82de91",
                                        "glosses": [
                                            "Neither believing in nor supporting the idea of nations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebd8d1b3-cc1e-4828-a532-55f37bf9cffc",
                        "source_entry_id": "f5aef1b2-cdb6-324f-8371-43b60635dc9f",
                        "source_sense_id": "b807a4a1-38aa-336c-a641-b650a828a07f",
                        "target_lang_word": "apatride",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apatride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                        "entry_id": "87d49bbb-f8e3-3953-aa56-cdd587be21b2",
                                        "glosses": [
                                            "Qui est sans patrie, sans nationalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55611131-f747-4988-b087-f507c4c75643",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "Tandis que le socialisme s’acharnait à secouer la tutelle d’un pouvoir économique apatride, une classe moyenne qui aspirait à se pavaner en classe dirigeante, décida de s’emparer du pouvoir culturel."
                                            },
                                            {
                                                "example_id": "3d71b7c6-0830-4e83-bc6b-fb4f748bc4f1",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "– Il n’est plus « apatride », mais désormais « d’origine indéterminée ».\n– Je vois. Être apatride, c’est être quelque chose. Être indéterminé, c‘est louche."
                                            },
                                            {
                                                "example_id": "1fd8b426-bff6-4520-b4cb-d209d38567ac",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "Les 279 000 habitants qui vivent alors dans l’enclave deviennent apatrides, mais peuvent se rendre en Égypte, qui administre la région sans l’annexer, pour travailler et étudier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apatride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                        "entry_id": "00e00c2e-3830-3b97-9610-a6347ade9c89",
                                        "glosses": [
                                            "Personne qui ne sent d’appartenance à aucune patrie ni nationalité ou qui en a été privée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73864ed-5de3-4921-a0d3-34642bdeb5d9",
                                                "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                                "text": "À cause de ce malentendu, son histoire personnelle changea: Wiesel resta en France de 1945 jusqu’en 1956, mais comme un apatride."
                                            },
                                            {
                                                "example_id": "bbbd4719-a8da-49a8-86f8-b474ca3d4f8d",
                                                "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                                "text": "Apatride, il ne veut pas prendre la nationalité française. Pas question de faire son service militaire, il garde son passeport Nansen délivré par l’ONU aux réfugiés sans patrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
