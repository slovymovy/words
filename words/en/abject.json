        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbb2a9e2-16a5-342d-83b1-edd547801573",
                    "sense_definition": "To reject or cast off someone or something as inferior or contemptible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The society tends to <w>abject</w> those who do not conform to its rigid standards.",
                            "target_lang_translations": {
                                "ru": "Общество склонно <w>отвергать</w> тех, кто не соответствует его строгим стандартам."
                            }
                        },
                        {
                            "text": "She decided to <w>abject</w> the outdated traditions that no longer served her life.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>отбросить</w> устаревшие традиции, которые больше не приносили пользы её жизни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
