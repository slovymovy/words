                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tranny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d7bd4d8-b02d-3ffe-a49d-68e6beef9db6",
                                        "entry_id": "8921a2a5-99e5-3121-ad5d-c0611f0aa333",
                                        "glosses": [
                                            "A transgender person, especially a trans woman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76609d86-4613-4f76-8aa9-97b46a2a7431",
                                                "sense_id": "3d7bd4d8-b02d-3ffe-a49d-68e6beef9db6",
                                                "text": "Newton (1972) has indicated that they are professional performers, who carefully do not try to totally pass as women. This is seen as too 'tranny' (transvestite) and possibly offending an audience."
                                            },
                                            {
                                                "example_id": "767686ca-9e2c-4285-9ee7-3acc1ea8199d",
                                                "sense_id": "3d7bd4d8-b02d-3ffe-a49d-68e6beef9db6",
                                                "text": "\"This is the boys' corner – this block and the next,\" he says. \"Everybody has their territory: males, females, queens, trannies (transvestites) [...]"
                                            },
                                            {
                                                "example_id": "2f521624-e0a0-42b8-b23e-3fcc921d052a",
                                                "sense_id": "3d7bd4d8-b02d-3ffe-a49d-68e6beef9db6",
                                                "text": "When I spoke with lesbians, most would tell me, “I don't date trannies. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96f892ff-8c49-3301-a8b3-cedbf0831856",
                                        "entry_id": "8921a2a5-99e5-3121-ad5d-c0611f0aa333",
                                        "glosses": [
                                            "A transistor radio."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aded1f6f-f26b-4f8d-bd4c-f83160c7627b",
                                                "sense_id": "96f892ff-8c49-3301-a8b3-cedbf0831856",
                                                "text": "He spent most of his time in his darkened storeroom with a tranny and an earplug while his kid ran riot in the classroom."
                                            },
                                            {
                                                "example_id": "77ed103c-a9a2-48d1-84d9-ccb2c20d59ab",
                                                "sense_id": "96f892ff-8c49-3301-a8b3-cedbf0831856",
                                                "text": "We talk, and I listen to Radio Luxembourg on my tranny – I have a little earplug, so if any teachers come in they won't hear it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec88bc6f-3133-3833-baae-0df3fdf582a9",
                                        "entry_id": "8921a2a5-99e5-3121-ad5d-c0611f0aa333",
                                        "glosses": [
                                            "A vehicle's transmission."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f46c32d-ea4f-44f1-8ed1-4fb7be508d3a",
                                                "sense_id": "ec88bc6f-3133-3833-baae-0df3fdf582a9",
                                                "text": "Other incidents where the tranny suddenly locks up in high gear and requires that the car be restarted to return to normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28444eb0-151a-3f47-9f3d-464202e423ba",
                                        "entry_id": "8921a2a5-99e5-3121-ad5d-c0611f0aa333",
                                        "glosses": [
                                            "An electrical transformer."
