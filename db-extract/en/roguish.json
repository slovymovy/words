                        "examples": [
                            {
                                "example_id": "5a1e8c5b-bf6d-4b44-ba60-6fec66a082ab",
                                "sense_id": "510e25d6-6374-3505-a06f-ea74ee965cb5",
                                "text": "“The Orations […] denounced Catiline's senatorial sympathizers as roguish and dissolute debtors clinging to Catiline as a final and desperate hope.”",
                                "translation": "Die Reden entlarvten Catilinas Sympathisanten im Senat als schurkische und ausschweifende Schuldner, die sich an Catilina als ihre letzte, verzweifelte Hoffnung klammerten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
