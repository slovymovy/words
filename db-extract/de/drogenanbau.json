                            {
                                "example_id": "c92bf37b-3427-4462-ae1a-5d8b12cabe73",
                                "sense_id": "c339f662-285a-3867-a8c0-3c850653a3e7",
                                "text": "„Ganze Regionen im Süden und Südosten Afghanistans lebten vom Drogenanbau.“"
                            },
                            {
                                "example_id": "0f7ada98-b31b-4ebb-9a12-8bf51ea6d532",
                                "sense_id": "c339f662-285a-3867-a8c0-3c850653a3e7",
                                "text": "„Er sollte versuchen, den einheimischen Drogenanbau zu unterbinden und mit den Privatmilizen aufzuräumen.“"
                            },
                            {
                                "example_id": "ac0d2801-4eae-4506-8191-7a3ad63cc264",
                                "sense_id": "c339f662-285a-3867-a8c0-3c850653a3e7",
                                "text": "„Beim Salzburger Landesgericht ist am Dienstag eine Bande wegen Drogenanbaues und Drogenhandels zu Haftstrafen verurteilt worden.“"
                            }
