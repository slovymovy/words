                        "sense_id": "d0c17291-b5ef-38f9-abef-3a355b7e6912",
                        "entry_id": "01799a40-6252-3f72-8efd-775b69db34a7",
                        "glosses": [
                            "Celle qui dit, qui fait des blagues."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d0a5f6-215a-4642-98b6-01a38a72f1b0",
                                "sense_id": "d0c17291-b5ef-38f9-abef-3a355b7e6912",
                                "text": "Ne vous inquiétez pas Léonore est une blagueuse et bien sûr qu’elle accepte."
                            },
                            {
                                "example_id": "1b1ccfe6-67c1-42f3-9b5d-20b0afed066f",
                                "sense_id": "d0c17291-b5ef-38f9-abef-3a355b7e6912",
                                "text": "Elle travailla dans un atelier sombre où de vieux restes d’hiver croupissaient dans les coins, et la patronne aigre, et toutes les blagueuses avec leur imbécillité d’amoureuses au début lui semblaient de mauvaises choses comme elle en avait vues autrefois, à l’âge ingrat."
                            }
                        ]
                    }
