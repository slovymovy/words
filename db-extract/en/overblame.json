                        "glosses": [
                            "To blame excessively."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ef4b009d-dd04-4edd-ae60-3ecd55e04620",
                                "sense_id": "470211f2-8275-3204-9678-61d3902aa9ce",
                                "text": "When all is said, however, it is easy to overblame the cinema, to exaggerate the actual harm and ignore the possible good."
                            },
                            {
                                "example_id": "0666ebc0-ff99-43f7-9dbd-a3a154b923f4",
                                "sense_id": "470211f2-8275-3204-9678-61d3902aa9ce",
                                "text": "But in respect to the emotional crippling of children it seems to me that women have been overblamed for the kinds of mothers they make, and underblamed for the failure of their marriages."
                            }
                        ]
                    }
