            {
                "entry_id": "9f260ae3-d80b-3848-b51e-dad0aaa4f6df",
                "word": "riions",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "114ebe2e-1472-4e42-a1ed-b8b9f20d0324",
                        "entry_id": "9f260ae3-d80b-3848-b51e-dad0aaa4f6df",
                        "tags": [
                            "indicative",
                            "imperfect"
                        ],
                        "form": "nous riions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c15fa4bd-d7fe-36d5-806e-4027dc69329e",
                        "entry_id": "9f260ae3-d80b-3848-b51e-dad0aaa4f6df",
                        "glosses": [
                            "Première personne du pluriel de l'indicatif imparfait du verbe rire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df562e38-cca0-4fd5-ab14-038474dcd9c0",
                                "sense_id": "c15fa4bd-d7fe-36d5-806e-4027dc69329e",
                                "text": "Aussi lui trouvais-je plus d’esprit qu’à personne, et, sur un seul mot échangé, nous riions souvent ensemble, aux dépens de notre prochain ou de nous-mêmes, en fusée subite, jusqu’à en être pâmés, jusqu’à nous en jeter par terre."
                            },
                            {
                                "example_id": "5bbf111b-df47-4c4b-9618-231f57e9d19a",
                                "sense_id": "c15fa4bd-d7fe-36d5-806e-4027dc69329e",
                                "text": "Il s’est mis à chanter « Vole, mon cœur, vole », d’une voix tellement fausse que nous en riions aux larmes tous les trois."
                            },
                            {
                                "example_id": "8e64ee82-accc-4b5f-8319-d1c7c53323f2",
                                "sense_id": "c15fa4bd-d7fe-36d5-806e-4027dc69329e",
                                "text": "Et nous riions de bon cœur."
                            },
                            {
                                "example_id": "6d14e8cb-3b79-43cc-9476-bade48f55794",
                                "sense_id": "c15fa4bd-d7fe-36d5-806e-4027dc69329e",
                                "text": "Nous bavardions, nous riions, je grignotais un de ces faux objets qui me plaisaient tant — un martinet en réglisse — lorsque maman apparut à un détour du chemin."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
