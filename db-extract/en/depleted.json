                    {
                        "translation_id": "274a5f20-02c8-4266-8085-c055e14195b9",
                        "source_entry_id": "b417fea0-387d-38f7-b9e4-6153de0e1012",
                        "source_sense_id": "9041a0d8-7828-3622-bb3f-b10ac2486c40",
