                        "examples": [
                            {
                                "example_id": "5a33813f-b2ed-492b-94aa-04b2b5b3faac",
                                "sense_id": "da7b84cc-116e-3d04-b629-922bc664c7c8",
                                "text": "„Sie feierten eine Parkplatz-Party, die Luft roch nach Holzkohle und Barbecuesoße.“"
                            },
                            {
                                "example_id": "10ad9124-d4fe-4527-81b1-e6b3c901464a",
                                "sense_id": "da7b84cc-116e-3d04-b629-922bc664c7c8",
                                "text": "„Sie schicken mich in den Ruhestand und ersetzen mich durch einen Nerd in Houston, der eine Drohne fernsteuert, jemanden, der mit einer Hand Krieg führt und mit der anderen seine Pommes in Barbecuesoße tunkt.“"
                            }
                        ],
