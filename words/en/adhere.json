{
    "word_family": [
        "adherence",
        "adherent",
        "adhesion",
        "adhesive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1292d304-c285-3220-a404-621e7ea30b7a",
                    "sense_definition": "To stick fast or stay attached to a surface or substance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet snow began to <w>adhere</w> to the branches of the trees during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма мокрый снег начал <w>прилипать</w> к ветвям деревьев."
                            }
                        },
                        {
                            "text": "Make sure the surface is clean so the tape can <w>adhere</w> properly to the wall.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что поверхность чистая, чтобы лента могла должным образом <w>приклеиться</w> к стене."
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "cling",
                        "attach",
                        "bond"
                    ],
                    "antonyms": [
                        "deadhere"
                    ],
                    "common_phrases": [
                        "adhere to the surface",
                        "adhere properly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прикрепляться или прилипать к поверхности или веществу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипать",
                                "target_lang_sense_clarification": "о физическом сцеплении"
                            },
                            {
                                "target_lang_word": "приклеиваться",
                                "target_lang_sense_clarification": "с помощью клея или липкого слоя"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "плотно прилегать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5c6396-aa56-331e-b90a-df073ee46ed5",
                    "sense_definition": "To follow or remain devoted to a set of rules, beliefs, or a specific plan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "following rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All employees must strictly <w>adhere</w> to the safety guidelines while working in the factory.",
                            "target_lang_translations": {
                                "ru": "Все сотрудники должны строго <w>придерживаться</w> правил техники безопасности при работе на заводе."
                            }
                        },
                        {
                            "text": "The chef decided to <w>adhere</w> to the original recipe to ensure the dish tasted authentic.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>придерживаться</w> оригинального рецепта, чтобы вкус блюда был аутентичным."
                            }
                        }
                    ],
                    "synonyms": [
                        "stick with",
                        "cling"
                    ],
                    "common_phrases": [
                        "adhere to the rules",
                        "adhere to a policy",
                        "strictly adhere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать правилам, убеждениям или определенному плану, оставаться верным им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "правил, взглядов или плана"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "инструкции или нормы"
                            },
                            {
                                "target_lang_word": "оставаться верным",
                                "target_lang_sense_clarification": "принципам или традициям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91aae64-c55c-3e21-9cec-123edb3df78a",
                    "sense_definition": "To be consistent, coherent, or in agreement with something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness's testimony did not <w>adhere</w> to the facts presented by the police earlier.",
                            "target_lang_translations": {
                                "ru": "Показания свидетеля не <w>соответствовали</w> фактам, представленным полицией ранее."
                            }
                        },
                        {
                            "text": "His lifestyle choices <w>adhere</w> to the same pattern of simplicity he has always followed.",
                            "target_lang_translations": {
                                "ru": "Его образ жизни <w>соответствует</w> той же модели простоты, которой он всегда следовал."
                            }
                        }
                    ],
                    "synonyms": [
                        "cohere"
                    ],
                    "common_phrases": [
                        "adhere to a pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть последовательным, логичным или соответствовать чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "фактам или образцу"
                            },
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "единой линии или модели поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4508e807-5d86-3535-8b85-9deb066fc066",
                    "sense_definition": "To formally affirm or uphold a previous legal judgment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appellate court chose to <w>adhere</w> to the lower court's decision after reviewing the evidence.",
                            "target_lang_translations": {
                                "ru": "Апелляционный суд решил <w>оставить в силе</w> решение суда нижестоящей инстанции после изучения доказательств."
                            }
                        },
                        {
                            "text": "The judges will likely <w>adhere</w> to the established precedent in this specific case.",
                            "target_lang_translations": {
                                "ru": "Судьи, скорее всего, будут <w>придерживаться</w> установленного прецедента в этом конкретном деле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально подтверждать или поддерживать ранее вынесенное судебное решение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "судебного прецедента или решения"
                            },
                            {
                                "target_lang_word": "оставлять в силе",
                                "target_lang_sense_clarification": "решение суда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}