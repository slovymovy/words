                    {
                        "sense_id": "ff15e31f-fc09-3fd0-8e50-54a082b45f5b",
                        "entry_id": "68e19ee5-0ca5-3e76-83ff-d4517cd38bb0",
                        "glosses": [
                            "eine Aminosäure, Bestandteil der Proteine"
