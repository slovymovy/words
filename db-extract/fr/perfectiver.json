                "senses": [
                    {
                        "sense_id": "69174c31-d7bf-38b3-b17f-091f291aa3df",
                        "entry_id": "aa6a663e-7f24-3ef5-893e-244988255593",
                        "glosses": [
                            "Rendre perfectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "562ab338-98fe-4fac-b7d9-a441d6a0e2c0",
                                "sense_id": "69174c31-d7bf-38b3-b17f-091f291aa3df",
                                "text": "Par le biais des préverbes, le russe a d’autre part la possibilité de perfectiver un imperfectif, mais cela ne va pas sans modifier le sens du verbe."
                            },
                            {
                                "example_id": "c8f08e95-0880-4d6e-bad0-951b41134c92",
                                "sense_id": "69174c31-d7bf-38b3-b17f-091f291aa3df",
                                "text": "Contrairement aux verbes d’activité, ces verbes ne peuvent pas être perfectivés, même avec un préfixe limitatif ou perduratif."
                            }
                        ]
                    }
