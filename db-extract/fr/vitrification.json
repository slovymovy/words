                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8915d8ba-9674-3d5e-957d-59c7511d7b5b",
                                        "entry_id": "5e82918c-78a0-338a-95b6-4616379c4cea",
                                        "glosses": [
                                            "хим. переход жидкости в стеклообразное состояние при понижении температуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a0eafe-e39b-4180-ada1-32092db746bb",
                                                "sense_id": "8915d8ba-9674-3d5e-957d-59c7511d7b5b",
                                                "text": "Единственным способом витрификации жидкого или газообразного тела является столь быстрое его охлаждение, которое исключает возможность предварительной кристаллизации."
                                            },
                                            {
                                                "example_id": "d5f75347-bf95-4945-b2e2-7f389a27a6cf",
                                                "sense_id": "8915d8ba-9674-3d5e-957d-59c7511d7b5b",
                                                "text": "Процесс перехода в стеклообразное состояние, минуя кристаллизацию, называют витрификацией, а обратный переход к жидкому состоянию ― стеклоплавлением (он возможен лишь при быстром нагревании «застекловавшейся» жидкости, в противном случае она «по пути» проходит стадию кристаллизации)."
                                            }
                                        ]
                                    }
                                ]
                            }
