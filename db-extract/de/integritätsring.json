                    {
                        "sense_id": "1a725a63-d1bd-3b8a-b944-f1bcd29dd7d9",
                        "entry_id": "2930bce7-c12a-37f2-a0df-4fd141e586c4",
                        "glosses": [
                            "nullteilerfreier kommutativer Ring mit vom Nullelement verschiedenem Einselement"
                        ],
                        "tags": [],
