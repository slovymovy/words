                                        "entry_id": "f8e094e1-97e8-3797-a4f2-0ffaf62e5302",
                                        "glosses": [
                                            "Qui est capable de réaliser l’adsorption."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79042819-a248-40e4-a6c6-f4dfac799f24",
                                                "sense_id": "bfbc0806-d2b5-3bd7-99c3-2155a99dbec3",
                                                "text": "Ces horizons ne sont jamais calcaires, même s’ils sont issus d’une roche-mère carbonatée. Le complexe adsorbant peut être saturé ou déjà partiellement désaturé."
                                            }
                                        ]
