                                                "sense_id": "3d058ee4-0f62-31bd-93a0-ea460be99210",
                                                "text": "Heute tagt der Kongress."
                                            },
                                            {
                                                "example_id": "54c048c0-5ab5-4d25-a143-26ba13e4d77a",
                                                "sense_id": "3d058ee4-0f62-31bd-93a0-ea460be99210",
                                                "text": "„Die Mauer etwa kann Trump nur mit Genehmigung des Kongresses errichten lassen.“"
                                            },
