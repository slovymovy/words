{
    "word_family": [
        "премиальный",
        "премировать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c4c9d71-e9ca-343b-996e-8d486e637661",
                    "sense_definition": "Денежное или иное материальное поощрение в качестве награды за достижения или успехи.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "награда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы получили вторую <w>премию</w> на республиканском смотре.",
                            "target_lang_translations": {
                                "zh": "我们在全国评比中获得了二等<w>奖</w>。"
                            }
                        },
                        {
                            "text": "За отличную работу сотруднику выплатили денежную <w>премию</w>.",
                            "target_lang_translations": {
                                "zh": "员工因工作出色获得了现金<w>奖金</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "антипремия"
                    ],
                    "common_phrases": [
                        "получить премию",
                        "выплатить премию"
                    ],
                    "target_lang_definitions": {
                        "zh": "为表彰成就或成功而给予的奖金或其他物质奖励。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "奖金",
                                "target_lang_sense_clarification": "指因成绩优异而获得的金钱奖励。"
                            },
                            {
                                "target_lang_word": "奖品",
                                "target_lang_sense_clarification": "指因成绩优异而获得的实物奖励。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50793a91-cc10-3b87-b180-b65e68cdcf2d",
                    "sense_definition": "Дополнительное вознаграждение или надбавка к основной заработной плате за высокие показатели труда.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "награда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сотрудникам выплатили <w>премию</w> за выполнение годового плана.",
                            "target_lang_translations": {
                                "zh": "员工因完成年度计划而获得了<w>奖金</w>。"
                            }
                        },
                        {
                            "text": "Размер <w>премии</w> зависит от личных результатов каждого работника.",
                            "target_lang_translations": {
                                "zh": "<w>奖金</w>数额取决于每位员工的个人业绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "премиа́льные"
                    ],
                    "antonyms": [
                        "штраф"
                    ],
                    "common_phrases": [
                        "годовая премия",
                        "квартальная премия"
                    ],
                    "target_lang_definitions": {
                        "zh": "因工作表现出色而获得的额外报酬或工资补贴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "奖金",
                                "target_lang_sense_clarification": "工作绩效奖励。"
                            },
                            {
                                "target_lang_word": "津贴",
                                "target_lang_sense_clarification": "为特定目的或表现给予的额外补助。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87e7ad97-6d64-35e5-b91c-b0d860571e58",
                    "sense_definition": "Денежная сумма, которую страхователь регулярно платит страховой компании за страхование.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "финансы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ежегодная страховая <w>премия</w> была оплачена вовремя.",
                            "target_lang_translations": {
                                "zh": "年度<w>保险费</w>已按时缴纳。"
                            }
                        },
                        {
                            "text": "Размер страховой <w>премии</w> зависит от выбранных условий договора.",
                            "target_lang_translations": {
                                "zh": "<w>保险费</w>金额取决于所选的合同条款。"
                            }
                        }
                    ],
                    "antonyms": [
                        "пошлина"
                    ],
                    "common_phrases": [
                        "страховая премия"
                    ],
                    "target_lang_definitions": {
                        "zh": "投保人定期向保险公司支付的费用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保险费",
                                "target_lang_sense_clarification": "保险合同中约定的费用。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5584564a-303e-3069-b727-ebd22c8b8392",
                    "sense_definition": "Бесплатное дополнение или подарок при покупке определенного товара.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "торговля",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Покупатель получил небольшую <w>премию</w> к основному заказу.",
                            "target_lang_translations": {
                                "zh": "顾客在主订单之外收到了一份小<w>赠品</w>。"
                            }
                        },
                        {
                            "text": "В качестве <w>премии</w> к покупке прилагался фирменный сувенир.",
                            "target_lang_translations": {
                                "zh": "作为购物<w>赠品</w>，随附了一件品牌纪念品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "скидка"
                    ],
                    "target_lang_definitions": {
                        "zh": "购买商品时附赠的免费礼品或额外物品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赠品",
                                "target_lang_sense_clarification": "随商品附送的免费物品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0563b9-b99e-3a12-b935-6a4a394fb793",
                    "sense_definition": "Денежная сумма, выплачиваемая государством для стимулирования экспорта товаров.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "финансы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правительство ввело экспортную <w>премию</w> для поддержки местных производителей.",
                            "target_lang_translations": {
                                "zh": "政府为支持本地生产商引入了<w>出口补贴</w>。"
                            }
                        },
                        {
                            "text": "Получение экспортной <w>премии</w> помогло компании выйти на новые рынки.",
                            "target_lang_translations": {
                                "zh": "获得<w>出口补贴</w>帮助该公司开拓了新市场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "экспортная премия"
                    ],
                    "target_lang_definitions": {
                        "zh": "政府为鼓励出口而支付的财政补贴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出口补贴",
                                "target_lang_sense_clarification": "政府对出口企业的财政支持。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}