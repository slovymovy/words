                "senses": [
                    {
                        "sense_id": "4d474a64-5fb9-3be1-8dc8-e4b718dddbb4",
                        "entry_id": "cfb8f939-8e58-360a-881c-38ba90c98082",
                        "glosses": [
                            "дополнительное предварительное следствие или дознание по делу, ранее законченному расследованием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f26a622-a6ca-47fb-8db5-b5e1bd53354b",
                                "sense_id": "4d474a64-5fb9-3be1-8dc8-e4b718dddbb4",
                                "text": "В сентябре дело было прекращено, потом отправлено на доследование, а спустя месяц вновь закрыто."
                            },
                            {
                                "example_id": "01331b7e-3c94-4d5f-a411-bcbb27361fe6",
                                "sense_id": "4d474a64-5fb9-3be1-8dc8-e4b718dddbb4",
                                "text": "Судебный процесс был приостановлен более двух месяцев назад в связи с тем, что уголовное дело было отправлено на доследование в прокуратуру Чеченской Республики, отметили в суде."
                            }
                        ]
                    }
