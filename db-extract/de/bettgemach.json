                        "sense_id": "f97237be-f926-302d-9af9-d04dbd379da2",
                        "entry_id": "75d26010-f125-3c36-9c18-5b32c8c0e9b5",
                        "glosses": [
                            "Räumlichkeit mit mindestens einem Bett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fcb758-28fd-4025-bbec-041120ae5bf2",
                                "sense_id": "f97237be-f926-302d-9af9-d04dbd379da2",
                                "text": "„Mit Freude stellte ich fest, daß die Uhr im Bettgemach einen Wecker hatte, denn trotz der Liebe begann der Schlaf Macht über mich zu gewinnen.“"
                            },
                            {
                                "example_id": "698fbeb2-d960-4adb-9058-8db0986e18e6",
                                "sense_id": "f97237be-f926-302d-9af9-d04dbd379da2",
                                "text": "„Später wandelt sich der Stangenwald in eine Kirche, eine Burgflucht oder jenes Bettgemach, wo Elsa und Lohengrin sich erstmals unter vier Augen begegnen dürfen.“"
                            }
                        ],
