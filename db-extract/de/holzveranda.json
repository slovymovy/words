                "senses": [
                    {
                        "sense_id": "d2cabc4c-e78b-36b7-a53f-8ce7815b290b",
                        "entry_id": "d103f632-2f58-324c-ace1-56b771b4ad61",
                        "glosses": [
                            "aus Holz bestehende Veranda"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9c5564-7d7e-4ae0-b70b-391d75932798",
                                "sense_id": "d2cabc4c-e78b-36b7-a53f-8ce7815b290b",
                                "text": "„Sonia hatte die Eingangstür halb offen stehen lassen, und als Hazel auf die Holzveranda trat, fiel ihr unwillkürlich der seltsame Türklopfer ins Auge: ein Gesicht aus ausgebleichtem Messing mit großen, hohlen Augen, aber ohne Nase oder Mund.“"
                            },
                            {
                                "example_id": "a08fa796-b856-47b5-9bb8-c888b8fc5917",
                                "sense_id": "d2cabc4c-e78b-36b7-a53f-8ce7815b290b",
                                "text": "„Shaw betrat die niedrige, durchhängende Holzveranda und ging hinein, die Hand in der Nähe der Waffe.“"
                            },
                            {
                                "example_id": "908d2b8d-6c8e-4573-8a84-6f867868b746",
                                "sense_id": "d2cabc4c-e78b-36b7-a53f-8ce7815b290b",
                                "text": "„Er ist jetzt seit einer Woche wieder in The Grove, und jeden Morgen hat er sich vorne auf der Holzveranda in die Sonne gesetzt, manchmal nur ein paar Minuten, manchmal den ganzen Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
