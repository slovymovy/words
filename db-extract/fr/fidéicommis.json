        "fr-extract.jsonl": [
            {
                "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                "word": "fidéicommis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0512055a-9708-4b05-8dc8-edc7dbc0f4e5",
                        "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                        "tags": [],
                        "form": "fideicommis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                        "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                        "glosses": [
                            "Disposition par laquelle un testateur charge son héritier institué de conserver et de rendre à une personne désignée la totalité ou une partie des biens qu’il lui laisse, soit au bout d’un certain temps, soit dans un certain cas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7892d19a-976c-4ad4-a422-5bbb749f03ae",
                                "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                                "text": "Ici, une mère veut déshériter les enfants de son mari […]. Et c’est alors des combats, des craintes, des actes, des contre-lettres, des ventes simulées, des fidéicommis ; enfin, un gâchis pitoyable, ma parole d’honneur, pitoyable !"
                            },
                            {
                                "example_id": "72d8c136-fa85-4018-9d1a-6e6ae4743a77",
                                "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                                "text": "Hortense, ayant été séparée de biens avec son mari pendant les trois années de brouille, Victorin n’hésita plus à placer au nom de sa sœur les deux cent mille francs du fidéicommis, et il fit à Hortense une pension de douze mille francs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1542bad1-24fd-3d8c-9a67-56782d57b0ba",
                        "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                        "glosses": [
                            "Liste de biens donnés sous certaines conditions."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9556f43b-f982-4ef9-b55a-23c96480acc1",
                                "sense_id": "1542bad1-24fd-3d8c-9a67-56782d57b0ba",
                                "text": "Mais quelques-uns parmi les siens continuent en eux-mêmes à penser que la France appartient d’abord à elle-même, que ses enfants, ses citoyens, ne sont pas là pour donner des royaumes à la clique corse et pour faire de toute l’Europe un fidéicommis des Bonaparte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaab65b8-9bb9-493f-8bc8-3952db13cdc6",
                        "source_entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                        "target_lang_word": "trust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "Confidence in or reliance on some person or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fa07181-4522-4906-8e30-4c5dd41d693f",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "He needs to regain her trust if he is ever going to win her back."
                                            },
                                            {
                                                "example_id": "d2c48644-2139-472e-ace1-035268b9e91c",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "to lose trust in someone"
                                            },
                                            {
                                                "example_id": "7ed154ff-2038-400c-9a11-e6fb3a50d3b3",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "build up trust"
                                            },
                                            {
                                                "example_id": "035ddb56-0146-4c8f-9f63-8babbb1175d5",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "a relationship built on mutual trust"
                                            },
                                            {
                                                "example_id": "5240ffe0-65bf-46a5-b10e-67cebc0b755b",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "taking things upon trust."
                                            },
                                            {
                                                "example_id": "da369705-224e-4726-832b-2e956d7520fd",
                                                "sense_id": "79c751e0-9175-3182-b237-62f99fbf0d4c",
                                                "text": "O ever-failing trust / In mortal strength!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f710e9-4da7-3b77-b575-4565e54ebdb7",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "Dependence upon something in the future; hope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf8145f-2ecd-4734-b1a6-56b5be397101",
                                                "sense_id": "70f710e9-4da7-3b77-b575-4565e54ebdb7",
                                                "text": "Such trust have we through Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f880e4c-d0cc-3b65-b0d3-c0a30e45c3a0",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "Confidence in the future payment for goods or services supplied; credit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e68d856-f200-4c8e-94b7-9466f6aa94d0",
                                                "sense_id": "8f880e4c-d0cc-3b65-b0d3-c0a30e45c3a0",
                                                "text": "I was out of cash, but the landlady let me have it on trust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70836d4d-185f-365c-a959-b6e867ef5780",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "That which is committed or entrusted; something received in confidence; a charge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b06fe1aa-c6e7-32ef-acac-5fc0d2a4e887",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "That upon which confidence is reposed; ground of reliance; hope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62559030-b535-4bc3-9753-2f8cd8a8e8b7",
                                                "sense_id": "b06fe1aa-c6e7-32ef-acac-5fc0d2a4e887",
                                                "text": "O Lord God, thou art my trust from my youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a5e640-b507-3fe8-8786-0869a9b098ad",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "Trustworthiness, reliability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b915aa9-4e89-3903-b612-b78670fcc2d9",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "The condition or obligation of one to whom anything is confided; responsible charge or office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbb4130-7819-4c5d-849d-abc81ea2165d",
                                                "sense_id": "3b915aa9-4e89-3903-b612-b78670fcc2d9",
                                                "text": "I do profess to be no less than I seem; to serve him truly that\nwill put me in trust"
                                            },
                                            {
                                                "example_id": "7c94e005-a74e-4b89-8ad9-cbbdc093502c",
                                                "sense_id": "3b915aa9-4e89-3903-b612-b78670fcc2d9",
                                                "text": "17th century, John Denham, Of Justice\nReward them well, if they observe their trust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad3a7f0-9226-3ce9-8b36-744eb907dc07",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "The confidence vested in a person who has legal ownership of a property to manage for the benefit of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0adf759e-207c-404b-9829-636d80d09c60",
                                                "sense_id": "dad3a7f0-9226-3ce9-8b36-744eb907dc07",
                                                "text": "I put the house into my sister's trust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53037796-50a2-323d-ba74-22a00d6575c7",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "An arrangement whereby property or money is given to be held by a third party (a trustee), on the basis that it will be managed for the benefit of, or eventually transferred to, a stated beneficiary; for example, money to be given to a child when he or she reaches adulthood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c342b805-6c8f-3055-8d9d-f560a05d1189",
                                        "entry_id": "1272643e-2176-38fe-a58f-4bef7900f2ab",
                                        "glosses": [
                                            "A group of businessmen or traders organised for mutual benefit to produce and distribute specific commodities or services, and managed by a central body of trustees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
