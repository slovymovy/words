    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                    "sense_definition": "Pleurer sans motif sérieux ou avec affectation, sur un ton larmoyant et puéril.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "larmes_et_plaintes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant commence à <w>pleurnicher</w> dès qu'on lui refuse une friandise.",
                            "target_lang_translations": {
                                "en": "The child starts to <w>whine</w> as soon as someone refuses him a sweet.",
                                "ru": "Ребёнок начинает <w>хныкать</w>, как только ему отказывают в сладости.",
                                "de": "Das Kind fängt an zu <w>quengeln</w>, sobald man ihm eine Süßigkeit verweigert.",
                                "es": "El niño empieza a <w>lloriquear</w> en cuanto le niegan una golosina.",
                                "zh": "孩子一被拒绝给糖，就开始<w>哼唧</w>起来。"
                            }
                        },
                        {
                            "text": "Il a passé la soirée à <w>pleurnicher</w> au lieu d'expliquer calmement son désaccord.",
                            "target_lang_translations": {
                                "en": "He spent the evening <w>whining</w> instead of calmly explaining his disagreement.",
                                "ru": "Он провёл весь вечер <w>хныкая</w>, вместо того чтобы спокойно объяснить своё несогласие.",
                                "de": "Den ganzen Abend hat er <w>gequengelt</w>, statt seine Meinungsverschiedenheit ruhig zu erklären.",
                                "es": "Pasó la velada <w>lloriqueando</w> en lugar de explicar con calma su desacuerdo.",
                                "zh": "他整晚都在<w>哭哭啼啼</w>，而不是平心静气地说明自己的不同意见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chougner",
                        "chouiner"
                    ],
                    "common_phrases": [
                        "pleurnicher pour un rien"
                    ],
                    "target_lang_definitions": {
                        "en": "To cry over trivial matters, or in a childish, tearful tone.",
                        "ru": "Плакать по пустякам или с капризным, жалобным тоном, как ребёнок.",
                        "de": "Ohne ernsten Grund oder gekünstelt in weinerlichem, kindischem Ton weinen.",
                        "es": "Llorar sin motivo serio o de forma fingida, con un tono lloroso e infantil.",
                        "zh": "无正当理由或故意装出来的样子，用带哭腔、幼稚的语气哭闹。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whine",
                                "target_lang_sense_clarification": "crying in a childish, tearful way"
                            },
                            {
                                "target_lang_word": "snivel",
                                "target_lang_sense_clarification": "tearful, self-pitying crying"
                            },
                            {
                                "target_lang_word": "whimper",
                                "target_lang_sense_clarification": "soft, tearful crying"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хныкать",
                                "target_lang_sense_clarification": "тихий капризный плач"
                            },
                            {
                                "target_lang_word": "скулить",
                                "target_lang_sense_clarification": "жалобный плач, пренебрежительно"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "quengeln",
                                "target_lang_sense_clarification": "kindliches Jammern, Forderungen"
                            },
                            {
                                "target_lang_word": "flennen",
                                "target_lang_sense_clarification": "umgangssprachlich, abwertend"
                            },
                            {
                                "target_lang_word": "greinen",
                                "target_lang_sense_clarification": "weinerlich weinen, wimmern"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lloriquear",
                                "target_lang_sense_clarification": "llanto suave y quejumbroso"
                            },
                            {
                                "target_lang_word": "gimotear",
                                "target_lang_sense_clarification": "gemidos y lamentos infantiles"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哼唧",
                                "target_lang_sense_clarification": "幼稚的带哭腔抱怨"
                            },
                            {
                                "target_lang_word": "哭哭啼啼",
                                "target_lang_sense_clarification": "无故或装模作样地哭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "968d02a0-de64-3dd4-ac09-104ba1c3bd75",
                    "sense_definition": "Se plaindre sans cesse pour des futilités de manière puérile et agaçante ; geindre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "larmes_et_plaintes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de <w>pleurnicher</w> sur ton sort et cherche plutôt une solution.",
                            "target_lang_translations": {
                                "en": "Stop <w>whining</w> about your lot and look for a solution instead.",
                                "ru": "Хватит <w>ныть</w> о своей судьбе, лучше поищи решение.",
                                "de": "Hör auf, über dein Schicksal zu <w>jammern</w>, und suche lieber eine Lösung.",
                                "es": "Deja de <w>gimotear</w> sobre tu suerte y busca en cambio una solución.",
                                "zh": "别再为自己的处境<w>抱怨</w>了，还是去想想解决办法吧。"
                            }
                        },
                        {
                            "text": "Certains collègues ne font que <w>pleurnicher</w> sans jamais proposer d'améliorations constructives.",
                            "target_lang_translations": {
                                "en": "Some colleagues do nothing but <w>whine</w> without ever suggesting constructive improvements.",
                                "ru": "Некоторые коллеги только и делают, что <w>ноют</w>, никогда не предлагая конструктивных улучшений.",
                                "de": "Manche Kollegen tun nichts als <w>quengeln</w>, ohne jemals konstruktive Verbesserungsvorschläge zu machen.",
                                "es": "Algunos compañeros no hacen más que <w>quejarse</w> sin proponer nunca mejoras constructivas.",
                                "zh": "有些同事只会<w>抱怨</w>，从不提出建设性的改进意见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chougner",
                        "chouiner"
                    ],
                    "common_phrases": [
                        "pleurnicher sur son sort"
                    ],
                    "target_lang_definitions": {
                        "en": "To complain constantly about trivial things in a childish and irritating way.",
                        "ru": "Беспрестанно жаловаться по мелочам, по-детски и раздражающе.",
                        "de": "Sich ständig und kindisch-nervig über Belanglosigkeiten beklagen.",
                        "es": "Quejarse sin cesar por nimiedades, de forma infantil y molesta.",
                        "zh": "为一些琐事反复抱怨，态度幼稚而令人厌烦。"
                    },
