                    "sense_id": "ae51e078-4c1e-3087-8073-497347f35ed1",
                    "sense_definition": "In or towards the central business district.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location_city",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to go <w>downtown</w> to find the main bank.",
