                "senses": [
                    {
                        "sense_id": "fc724361-b518-3af0-9238-0219d55f167d",
                        "entry_id": "c8fdfe43-b223-3376-a81d-6601b10ca7e8",
                        "glosses": [
                            "Zimmer neben einem anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80510c22-15cd-4961-98a1-1cfc7486884c",
                                "sense_id": "fc724361-b518-3af0-9238-0219d55f167d",
                                "text": "„Möglicherweise könnte ich Heini vom Nachbarzimmer dazu bewegen, mit mir zusammen hochzugehen.“"
                            },
                            {
                                "example_id": "5646ab74-1301-43c7-9fc3-eeec4fd334d7",
                                "sense_id": "fc724361-b518-3af0-9238-0219d55f167d",
                                "text": "„Als ich trotz Flöhen, Falk und Malariaspray gerade einschlafen will, höre ich, wie Mekdes leise mit dem Lastwagenfahrer, der darin übernachtet, diskutiert, bevor sie die Tür von innen hinter sich schließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
