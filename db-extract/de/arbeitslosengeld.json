                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f932317-20a7-4f4f-99f7-d47e0ea90d85",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "The FY 1997/98 Commonwealth budget allocated funding of A$ 21.6 million to the Work for the Dole initiative for unemployed young people."
                                            },
                                            {
                                                "example_id": "d32591c8-3268-4499-a9f9-ffd012651c90",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "I get my dole paid twice a week."
                                            },
                                            {
                                                "example_id": "6b518468-e29e-429c-ab5f-e482409a821e",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "I've been on the dole for two years now."
                                            },
                                            {
                                                "example_id": "2977b28d-885c-4447-95c6-6c1b91a62b75",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "So, we are being fobbed off by second-rate American junk by smart aleck salesman from Pittsburgh while British factories stand empty and British workmen queue up for the dole."
                                            },
                                            {
                                                "example_id": "2be596cc-13ff-4857-a346-b4eea1952faf",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "From the ice age to the dole age / There is but one concern / I have just discovered"
                                            },
                                            {
                                                "example_id": "3e6273fd-102a-426c-a806-e71537e9e055",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "The men sit because they′re worn out from walking to the Labour Exchange every morning to sign for the dole, discussing the world’s problems and wondering what to do with the rest of the day."
                                            },
                                            {
                                                "example_id": "49ffd6aa-f29c-4c67-a1a8-b4089a8e3c4e",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "Sort your shit out, then roll / Sex, drugs, and on the dole / Some men rise, some men fall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088081b3-cbbf-34d8-9c29-f7739de11faf",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "A boundary; a landmark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04346652-5acb-4193-9d06-2a68857e5179",
                                                "sense_id": "088081b3-cbbf-34d8-9c29-f7739de11faf",
                                                "text": "Curſed be he which tranſlateth the bounds and dolles of his Neighbor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd913cc-a4c1-372d-a7fe-1676425a2dc1",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "A void space left in tillage."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f30ba39-27fa-36d4-a4af-99efcec74590",
                                        "entry_id": "16521105-6e82-3d45-b0cd-3d2cda2a2ca8",
                                        "glosses": [
                                            "A sorrow or grief; dolour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d4dd0c-f5ce-4be7-a3a1-fee2f53fbcf5",
                                                "sense_id": "0f30ba39-27fa-36d4-a4af-99efcec74590",
                                                "text": "Syr said sir gyngalyn I wote not what knyȝt he was / but wel I wote that he sygheth and maketh grete dole.\n\"Sir, said Sir Gingalin, I wot not what knight he was, but well I wot that he sigheth, and maketh great dole.\""
                                            },
                                            {
                                                "example_id": "535865cc-c008-4d51-b4e7-5c49cc844986",
                                                "sense_id": "0f30ba39-27fa-36d4-a4af-99efcec74590",
                                                "text": "But ten slow mornings past, and on the eleventh / Her father laid the letter in her hand, / And closed the hand upon it, and she died. / So that day there was dole in Astolat."
                                            },
                                            {
                                                "example_id": "e8435ea4-5611-4dce-ba4b-c8e66b8905c4",
                                                "sense_id": "0f30ba39-27fa-36d4-a4af-99efcec74590",
                                                "text": "These knights he keepeth there in great dole and misery, for it is said that their groans may be heard by the passers along the high-road below the castle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b639cc-70cb-3815-8e3d-91cbefad01c5",
                                        "entry_id": "16521105-6e82-3d45-b0cd-3d2cda2a2ca8",
                                        "glosses": [
                                            "Dolus."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b00ab96-cdf3-3c0a-8ae1-72b0d8c2906e",
                                        "entry_id": "accfd097-e363-33e3-adfa-557a3a04d2e7",
                                        "glosses": [
                                            "Alternative form of dhole (“Asian wild dog”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
