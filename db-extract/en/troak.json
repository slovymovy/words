                    {
                        "translation_id": "843926d0-e782-4807-bf91-55d12e870389",
                        "source_entry_id": "ce99d33d-36c3-38aa-9faa-72af4e2383eb",
                        "source_sense_description": "exchange goods or services without involving money",
                        "target_lang_word": "troquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                        "entry_id": "5da1ec0f-abf2-3b71-b017-93c66e121b0f",
                                        "glosses": [
                                            "Échanger, donner en troc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0741a333-bbfa-4edd-9081-32e4e66ddc99",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "Il reprit son habit galonné, qu'il troqua bientôt contre les haillons d'un mendiant."
                                            },
                                            {
                                                "example_id": "80f80491-2b4f-454e-bd43-e8efa0c71a21",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "Chaque fjord islandais a un petit chef-lieu […]. Dans ces localités résident des marchands qui troquent contre les marchandises du Danemark les produits de l'Islande : poissons séchés, fourrures, peaux de phoque, huile de baleine, etc."
                                            },
                                            {
                                                "example_id": "dc29ce94-f634-4221-ab21-f143d1faf1ea",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "À midi, Gredel et Lena, les cheveux sur la figure, sales et mouillées des pieds à la tête, regardaient fièrement leur œuvre, troquaient leurs sabots contre des pantoufles et allaient s’habiller."
                                            },
                                            {
                                                "example_id": "9ee47bf0-0143-4902-865d-55c5da261d38",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "Elle ne parle pas ce langage, bien sûr ! Oserait-elle troquer le doux roucoulement méridional contre cette brocaille sèche, ce brocard de pierrailles qu’on jurerait de l’allemand ? Ah ! pécheresse !"
                                            },
                                            {
                                                "example_id": "140da1a1-b186-4f85-89cf-d39d88ac3537",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "Plus cette Chine devient totalitaire, moins les Taïwanais sont intéressés à troquer leur démocratie contre le joug du Parti communiste chinois."
                                            },
                                            {
                                                "example_id": "62f61bb3-8277-42bd-ac6b-c84efa76cadb",
                                                "sense_id": "d8d9a291-aa4f-3590-a3b3-592c3c5b887c",
                                                "text": "Les soldats troquèrent leurs fusils contre des pioches et des pelles et, sous un soleil de plomb le jour, et dans un froid glacial la nuit, la route commença à entailler la montagne d’une plaie profonde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70de8b5c-502d-35f4-804d-9212aaadffa9",
                                        "entry_id": "5da1ec0f-abf2-3b71-b017-93c66e121b0f",
                                        "glosses": [
                                            "Pratiquer le troc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f8e5609-8d44-4ea4-8440-25841e708470",
                                                "sense_id": "70de8b5c-502d-35f4-804d-9212aaadffa9",
                                                "text": "M. Marsillat marchande toutes les pouliches du pays sans rien acheter ! ou bien, quand il achète, il fait semblant de se dégoûter bien vite, et il revient pour troquer."
                                            }
                                        ]
                                    }
                                ]
                            },
