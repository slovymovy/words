                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c68ece1-202a-4599-982e-029130614d9c",
                                "sense_id": "e5242587-e433-3536-905d-721ef6eb91e3",
                                "text": "Avec des moniteurs soupçonneux pour vérifier qu'il code-barrise bien tous ses articles, n'oubliant pas la caisse de Chassagne-Montrachet 2005 au fond de son chariot."
