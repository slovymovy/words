                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db75270-fa80-4399-986e-96553b050b24",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Frau Iwanowitsch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "19ded026-7a07-48ba-bdb5-e8af644979bf",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Herr Iwanowitsch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a1ea82c3-dc2f-4ded-8094-0c1927307902",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Die Iwanowitschs fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "83a98da4-7508-45d4-a849-5f9a7d14e7ce",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Der Iwanowitsch trägt nie die Pullover, die die Iwanowitsch ihm strickt."
                                            },
                                            {
                                                "example_id": "ea6cbd8c-e734-4b91-b91e-727b5c38d868",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Iwanowitsch kommt, geht der Herr Iwanowitsch.“"
                                            },
                                            {
                                                "example_id": "32c696f7-d7e3-495f-90da-c9b19e5226c0",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Iwanowitsch kommt und geht."
                                            },
                                            {
                                                "example_id": "8fefdd57-9b2e-4fd8-8c2c-69add7b6cc52",
                                                "sense_id": "b4063cc5-9a6a-35b8-a9b4-94f2a74c19a2",
                                                "text": "Iwanowitschs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83040920-554b-3608-95f8-56dd83994304",
                                        "entry_id": "3b13059b-87b9-3977-9f89-054e63d78901",
                                        "glosses": [
