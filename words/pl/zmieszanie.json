            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6183f000-8606-38f1-a15d-c2dfd6489d49",
                    "sense_definition": "proces łączenia ze sobą różnych substancji lub składników",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proces_fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po <w>zmieszaniu</w> wszystkich produktów wstawić do lodówki na dwie godziny.",
                            "target_lang_translations": {
                                "ru": "После <w>смешивания</w> всех продуктов поставьте в холодильник на два часа."
                            }
                        },
                        {
                            "text": "Dokładne <w>zmieszanie</w> składników jest kluczowe dla udanego ciasta.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>смешивание</w> ингредиентов — залог удачного теста."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymieszanie",
                        "rozmieszanie"
                    ],
                    "common_phrases": [
                        "dokładne zmieszanie",
                        "zmieszanie składników"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс соединения различных веществ или компонентов вместе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивание",
                                "target_lang_sense_clarification": "процесс объединения компонентов"
                            },
                            {
                                "target_lang_word": "перемешивание",
                                "target_lang_sense_clarification": "процесс приведения в однородное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40067985-5dfc-3103-873b-30f48c6f6ba9",
                    "sense_definition": "stan zakłopotania, zawstydzenia lub niepewności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stan_emocjonalny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jej twarzy pojawiło się wyraźne <w>zmieszanie</w> po usłyszeniu tego pytania.",
                            "target_lang_translations": {
                                "ru": "На её лице появилось явное <w>смущение</w> после того, как она услышала этот вопрос."
                            }
                        },
                        {
                            "text": "Jego <w>zmieszanie</w> było widoczne dla wszystkich obecnych w pokoju gości.",
                            "target_lang_translations": {
                                "ru": "Его <w>замешательство</w> было заметно всем гостям, присутствующим в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakłopotanie",
                        "skrępowanie",
                        "zawstydzenie"
                    ],
                    "common_phrases": [
                        "wielkie zmieszanie",
                        "okazywać zmieszanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние замешательства, смущения или неуверенности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущение",
                                "target_lang_sense_clarification": "чувство неловкости или стыда"
                            },
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "состояние растерянности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4485499f-95c6-3ce8-a8b8-be6286576cbe",
                    "sense_definition": "rzeczownik odczasownikowy od <w>zmieszać</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proces_fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybkie <w>zmieszanie</w> roztworów spowodowało gwałtowną reakcję chemiczną w naczyniu.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>смешение</w> растворов вызвало бурную химическую реакцию в сосуде."
                            }
                        },
                        {
                            "text": "Dzięki <w>zmieszaniu</w> kolorów uzyskała idealny odcień farby do salonu.",
                            "target_lang_translations": {
                                "ru": "Благодаря <w>смешиванию</w> цветов она получила идеальный оттенок краски для гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymieszanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "отглагольное существительное, обозначающее действие по глаголу смешать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешение",
                                "target_lang_sense_clarification": "результат или процесс объединения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
