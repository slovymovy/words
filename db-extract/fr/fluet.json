                                    {
                                        "sense_id": "b2c8f434-d099-38fa-b8d3-bfeb2d776b1b",
                                        "entry_id": "5494e4ec-8f62-37e2-9f66-d9a125f262ac",
                                        "glosses": [
                                            "wenig robust/widerstandsfähig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0b379d-ff41-4f55-abc4-589cb886e88e",
                                                "sense_id": "b2c8f434-d099-38fa-b8d3-bfeb2d776b1b",
                                                "text": "Menschen mit der sogenannten Glasknochenkrankheit haben meist zarte Knochen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "546aac03-2a18-3c93-998f-076f9590a487",
                                        "entry_id": "5494e4ec-8f62-37e2-9f66-d9a125f262ac",
                                        "glosses": [
                                            "als angenehm wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80656406-5bf1-4222-bd92-2370bc3a8c11",
                                                "sense_id": "546aac03-2a18-3c93-998f-076f9590a487",
                                                "text": "Schweizer Schokolade hat den Ruf, sehr zart zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "187a7630-5112-33a2-83f5-d95225fdb2e9",
                                        "entry_id": "5494e4ec-8f62-37e2-9f66-d9a125f262ac",
                                        "glosses": [
                                            "weich (von Speisen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c306667e-ca05-4d55-b596-baa0c954ca63",
                                                "sense_id": "187a7630-5112-33a2-83f5-d95225fdb2e9",
                                                "text": "„Der Vetturin aß mit größtem Appetit rohe Artischocken und Kohlrabi; freilich muß man gestehen, daß sie viel zärter und saftiger sind als wie bei uns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00f1b138-1064-4838-8ced-b3b62e635caa",
                        "source_entry_id": "25d4b2d4-a7ed-372e-951d-a86c1f762912",
                        "source_sense_id": "96a76a25-bb7b-3b7d-be2f-029bcc7d5a7a",
