                                    {
                                        "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                        "entry_id": "0f07dfe0-49c3-31b2-bf6f-e03925baa512",
                                        "glosses": [
                                            "weibliche Person, die Jura studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c55217-1442-4ea2-b5de-aaaa05729417",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Das Jurastudium war die Erfüllung ihres Vaters gewesen. Andrew hatte ebenfalls Ambitionen in dieser Richtung gehabt, sie selbst hatte jedoch nie in Erwägung gezogen, Juristin zu werden.“"
                                            },
                                            {
                                                "example_id": "83992708-0acc-4848-8ec5-f095f5cafcfe",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Sie begann ein Studium der Kunstgeschichte, wechselte dann und wurde Juristin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
