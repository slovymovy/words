                        ],
                        "examples": [
                            {
                                "example_id": "333564f1-b64e-426d-b774-6fef9c0bb4e1",
                                "sense_id": "b4358dc5-aa66-3fae-8821-0d7ff06440c1",
                                "text": "hübsche / pralle / süße Apfelbäckchen",
                                "translation": "pretty / puffy / cute round rosy cheeklets",
                                "english": "pretty / puffy / cute round rosy cheeklets"
                            },
                            {
                                "example_id": "415ff698-30d7-41f1-b532-3c7410c7217d",
                                "sense_id": "b4358dc5-aa66-3fae-8821-0d7ff06440c1",
                                "text": "Unsere Tochter hatte als Kind hübsche Apfelbäckchen.",
                                "translation": "Our daughter had as a child pretty round rosy cheeklets.",
                                "english": "Our daughter had as a child pretty round rosy cheeklets."
                            },
                            {
                                "example_id": "1e2a8c08-b4f1-4d71-aa69-081f919a4a44",
                                "sense_id": "b4358dc5-aa66-3fae-8821-0d7ff06440c1",
                                "text": "„Ich blende das Chaos erst mal aus“, sagt die 21-Jährige mit der tiefen, lauten Stimme einer erwachsenen Frau, während der Kontrast zu ihren kindlich strahlenden Apfelbäckchen nicht auffälliger sein könnte.",
                                "translation": "“I leave this chaos aside for now”, says the 21 year old with the deep, loud voice of an adult woman, whereas the contrast to her childlike beaming round rosy cheeklets could not have been more conspicuous.",
                                "english": "“I leave this chaos aside for now”, says the 21 year old with the deep, loud voice of an adult woman, whereas the contrast to her childlike beaming round rosy cheeklets could not have been more conspicuous."
                            }
                        ]
                    }
