                "senses": [
                    {
                        "sense_id": "07d87c4e-f777-31b4-b6f2-ce53d1513e46",
                        "entry_id": "e8a3713c-ee97-31f5-ada3-80edc8c2849e",
                        "glosses": [
                            "Pferd, das für Arbeiten, zum Beispiel in der Land- und Forstwirtschaft, eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1391b41-65e8-49b4-a88e-11bdc5ae9932",
                                "sense_id": "07d87c4e-f777-31b4-b6f2-ce53d1513e46",
                                "text": "„Ein Panther hatte erst vor wenigen Tagen eines seiner Füllen und die nächste Nacht ein großes, ausgewachsenes Arbeitspferd zerrissen, dem er von einem Baume aus auf den Hals gesprungen war; diesen unschädlich zu machen, war jedenfalls das Wichtigste, was sie vornehmen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f03ef376-e397-3792-b909-7051eccb92b6",
                        "entry_id": "e8a3713c-ee97-31f5-ada3-80edc8c2849e",
                        "glosses": [
                            "Person, die besonders viel/intensiv arbeitet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
