                ],
                "senses": [
                    {
                        "sense_id": "bba7cacf-0da4-3ebe-85a0-ff2b630424c3",
                        "entry_id": "cba79561-7030-3986-9604-0cc590d490fd",
                        "glosses": [
                            "een van de harde punten, bevestigd onder de zool van een sportschoen, bedoeld om wegglijden tegen te gaan"
                        ],
                        "tags": [
                            "atletiek"
                        ],
                        "examples": [
                            {
                                "example_id": "70759e28-d4bb-4190-8b33-edd9c78750f3",
                                "sense_id": "bba7cacf-0da4-3ebe-85a0-ff2b630424c3",
                                "text": "De ontwikkeling van de superschoen alleen al koste anderhalf miljoen dollar. Het vernuftige eraan is dat noppen van speciaal hard plastic de gebruikelijke keramische spikes hebben vervangen."
                            },
                            {
                                "example_id": "757a24a0-0f25-4a3e-bdd8-a4957b837c6a",
                                "sense_id": "bba7cacf-0da4-3ebe-85a0-ff2b630424c3",
                                "text": "Bij de den 2en Pinksterdag in het Stadion gehouden wedstrijden beweerden verschillende springers last van uitglijden te hebben. Het bleek ons evenwel, dat die deelnemers op gewone loopschoenen springen. Laten wij er nog eens op wijzen, dat een spike in elk der hakken bij het springen absoluut noodig is."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca23ef9f-5659-397c-8219-0483baaee547",
                        "entry_id": "cba79561-7030-3986-9604-0cc590d490fd",
                        "glosses": [
                            "sportschoen met metalen punten onder de zool"
                        ],
                        "tags": [
                            "atletiek"
                        ],
                        "examples": [
                            {
                                "example_id": "7433567b-8ea1-43f7-b1b6-f9cea0478dd3",
                                "sense_id": "ca23ef9f-5659-397c-8219-0483baaee547",
                                "text": "\"Ik verstapte me op een oneffen stuk,\" aldus Smits, \"mijn rechter spike kwam toen tegen de linkerknie aan. (…)\""
                            },
                            {
                                "example_id": "d9bb10c7-6d7a-48fd-a4cc-7ad14095162d",
                                "sense_id": "ca23ef9f-5659-397c-8219-0483baaee547",
                                "text": "De heer Zwart kon zeer zeker over zijn debuut tevreden zijn, en als hij wat gewend is aan het loopen op spikes, zal hij ongetwijfeld nog heel wat hooger springen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bb3d2ff-a778-3eae-ab41-665fa84a3ce2",
                        "entry_id": "cba79561-7030-3986-9604-0cc590d490fd",
                        "glosses": [
                            "punt onderaan de wandelstok"
                        ],
                        "tags": [
                            "nordic walking"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf31182-729f-4b14-80d0-4e5cff210499",
                                "sense_id": "0bb3d2ff-a778-3eae-ab41-665fa84a3ce2",
                                "text": "Bij het lopen op een harde ondergrond, zoals op stoeptegels en asfalt, kun je de metalen spike niet in de ondergrond prikken. De spike heeft dan onvoldoende grip op de ondergrond. In dat geval moet je op de spike een rubberen dop zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "38c156c5-0f47-33fa-ba3f-e0ba3d952c3e",
                        "entry_id": "cba79561-7030-3986-9604-0cc590d490fd",
                        "glosses": [
                            "metalen punten die uitsteken als stoere versiering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34b0ad7-36b4-485b-bad6-0fd5c317eb80",
                                "sense_id": "38c156c5-0f47-33fa-ba3f-e0ba3d952c3e",
                                "text": "Ze veegde het bloed van haar mes af aan de rug van haar slachtoffer en stak toen haar wapens terug in de zwartleren holsters aan haar met spikes versierde witte riem."
                            }
                        ]
                    },
                    {
                        "sense_id": "d77337d5-bd93-3891-bc79-587930fa8ce4",
                        "entry_id": "cba79561-7030-3986-9604-0cc590d490fd",
                        "glosses": [
                            "kegelvormig pootje onder luidsprekerboxen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf86d4f4-9e3d-4b2d-b977-ef23a23eeb02",
                                "sense_id": "d77337d5-bd93-3891-bc79-587930fa8ce4",
                                "text": "Als een luidspreker op spikes staat, rust inderdaad het totale gewicht van de luidspreker op een minuscuul oppervlak."
                            }
                        ]
                    }
