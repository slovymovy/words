                                        "entry_id": "b3a13ca3-d569-32ae-baa6-ffc0978ea5f3",
                                        "glosses": [
                                            "stur von sich, seiner Meinung und Position überzeugt und alle anderen Standpunkte ignorierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374768a0-23dc-4049-8b13-e59c053a039e",
                                                "sense_id": "c537ac1c-a690-3f7e-b2df-aaca06afb29c",
                                                "text": "„Er soll ja nicht bloßer Fachmensch, oder wie der Student das so treffend nennt: kein Fachsimpel sein; das gibt später im Leben die bornierten Spezialisten, die einseitigen Juristen oder Oberlehrer, aber keine allgemein gebildete, keine wirklich wissenschaftliche, überhaupt keine gebildete Menschen.“"
                                            },
                                            {
                                                "example_id": "a28f224d-7c4a-4b35-a1a3-3ec61a53d245",
                                                "sense_id": "c537ac1c-a690-3f7e-b2df-aaca06afb29c",
                                                "text": "„Bornierten Menschen sollte man nicht widersprechen. Widerspruch ist immerhin ein Zeichen von Anerkennung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
