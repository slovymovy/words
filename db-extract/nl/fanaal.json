                        "examples": [
                            {
                                "example_id": "ecf464bd-99e6-4092-a5a3-3a6dbe317079",
                                "sense_id": "1f985526-3843-31b5-b538-10402742113b",
                                "text": "De vyerboet of 't Fanaal, staat als een brandaris om de leydsman bij duijsterheyd en ontijden te syn van de spoorloose zeeman."
                            }
                        ]
                    },
                    {
                        "sense_id": "b353c850-ea85-35b2-9e22-8588b87b6834",
                        "entry_id": "a825406f-851c-32e1-9cad-18e296d5db9e",
                        "glosses": [
                            "zeer duidelijk teken dat de richting aangeeft"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2415911e-9a00-460c-a002-22d3e4d2b004",
                                "sense_id": "b353c850-ea85-35b2-9e22-8588b87b6834",
                                "text": "Van der Lubbe heeft niet alleen nimmer ontkend de Rijksdag in brand te hebben gestoken, hij kwam er in den beginne al direct voor uit, dat de brand zijn fanaal was om de wereld te waarschuwen tegen het nazidom."
                            }
                        ]
                    }
