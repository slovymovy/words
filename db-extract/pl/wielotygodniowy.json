                ],
                "senses": [
                    {
                        "sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                        "entry_id": "f5e1aeb7-a8d0-378a-8531-86fe0cb60e23",
                        "glosses": [
                            "trwający wiele tygodni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc03500-d7e6-4f47-adc2-49a5df831348",
                                "sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                                "text": "Historia reklamacji składanej przez Wiesławę Wnętrzak jest typowa. Sklep przyjmuje uwagi, deklaruje pomoc, a potem zaczynają się wielotygodniowe, a nawet kilkumiesięczne przepychanki"
                            },
                            {
                                "example_id": "8a05be53-9306-40e2-8f60-553e57115257",
                                "sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                                "text": "Piotr bez negocjacji zgadzał się na ceny, które proponowali mu podwykonawcy i dostawcy, bez mrugnięcia okiem przyjmował wielotygodniowe, a nawet wielomiesięczne opóźnienia płatności swoich klientów, nie mówiąc już o tym, że proponował im umiarkowane ceny i nigdy nie targował się, gdy prosili, żeby je obniżył"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06942766-c35d-4e53-8b4e-ffa88449cc37",
                        "source_entry_id": "f5e1aeb7-a8d0-378a-8531-86fe0cb60e23",
                        "source_sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                        "target_lang_word": "wochenlang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wochenlang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304db00b-e194-3180-aff7-6d02d273535b",
                                        "entry_id": "b4679ca8-8b3a-3b01-9cde-cc6e1d0f100c",
                                        "glosses": [
                                            "mehrere Wochen dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322a6034-c841-4c04-81bc-066cf9e902af",
                                                "sense_id": "304db00b-e194-3180-aff7-6d02d273535b",
                                                "text": "Die wochenlange Prüfungszeit ist eine zusätzliche Belastung für alle Beteiligten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23fdde22-7fa1-4ea1-acc3-3818af0cd527",
                        "source_entry_id": "f5e1aeb7-a8d0-378a-8531-86fe0cb60e23",
                        "source_sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                        "target_lang_word": "mehrwöchig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mehrwöchig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af05e59a-c1b7-3dce-ae23-d47b44067039",
                                        "entry_id": "ffdde491-65de-3887-b4ec-1f4843de47e5",
                                        "glosses": [
                                            "für mehrere Wochen, mehrere Wochen dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751cbff9-06f7-49a5-84df-9f7ff1c070fb",
                                                "sense_id": "af05e59a-c1b7-3dce-ae23-d47b44067039",
                                                "text": "Im Sommer wird Peter ein mehrwöchiges Praktikum bei der Tischlerei absolvieren."
                                            },
                                            {
                                                "example_id": "0cc2475a-4d9b-494a-b0bb-4cf1c99b5dde",
                                                "sense_id": "af05e59a-c1b7-3dce-ae23-d47b44067039",
                                                "text": "„In jenen Tagen im Mai 2015 beginnt eine mehrwöchige digitale Schlacht, wie es sie in Deutschland nie zuvor gegeben hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6dce55a-f41d-4fae-9edb-0fca56d96815",
                        "source_entry_id": "f5e1aeb7-a8d0-378a-8531-86fe0cb60e23",
                        "source_sense_id": "9234457c-6b8b-348e-978a-039b06440566",
                        "target_lang_word": "многонедельный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "многонедельный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca0b85d-2335-34aa-a053-dfb1f9ebe6df",
                                        "entry_id": "7b36070a-1370-3938-bdee-a3503d80ee4e",
                                        "glosses": [
                                            "продолжающийся много недель; рассчитанный на много недель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80afd755-75cd-48a8-8d7d-9fe73741961c",
                                                "sense_id": "0ca0b85d-2335-34aa-a053-dfb1f9ebe6df",
                                                "text": "Но они забывают, что, не зная об отраве, а зная, что утром врач считал больного уже выздоровевшим, жена могла временные боли считать за преходящий припадок и позволить себе отдохнуть после многонедельного ухода за больным, надорвавшего силы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
