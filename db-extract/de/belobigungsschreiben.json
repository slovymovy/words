                "senses": [
                    {
                        "sense_id": "06f21e00-c04d-3f1c-aac2-b418b7f9e2f3",
                        "entry_id": "8f5ca07f-e3da-3c7a-bcf7-28f79f0e1d14",
                        "glosses": [
                            "Schreiben, in dem zugunsten von jemandem eine Belobigung ausgesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff288a5-17f2-4485-b543-0a1f6d39a8cf",
                                "sense_id": "06f21e00-c04d-3f1c-aac2-b418b7f9e2f3",
                                "text": "„Zum Dank für seine Dienste liess ihm der Papst 1510 ein Belobigungsschreiben zukommen und verlieh ihm den St.-Silvester-Orden.“"
                            },
                            {
                                "example_id": "4a0dddbc-5dab-4dfe-9d2f-594210ff315a",
                                "sense_id": "06f21e00-c04d-3f1c-aac2-b418b7f9e2f3",
                                "text": "„Umso wichtiger war das Belobigungsschreiben der Konzilskongregation vom 10. April 1616. Darin werden den Englischen Fräulein der bischöfliche Schutz und die Obsorge zugesichert, die sie benötigten, um ihre Lehrtätigkeit auszuüben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
