                "senses": [
                    {
                        "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                        "entry_id": "c6c46ef8-ef50-3431-94f2-5ad235dd6663",
                        "glosses": [
                            "The condition of being penitent; a feeling of regret or remorse for doing wrong or sinning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1003390a-320b-4be9-8b20-934b6fa5c5b2",
                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                "text": "an assassin who misses his aim and flounders into penitence much as that discomfortable drama misses its point and stumbles into vacuity"
                            },
                            {
                                "example_id": "601ee196-b8bb-4521-a83e-1b1d916f4275",
                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                "text": "As for the moral turpitude that man unveiled to me, even with tears of penitence, I cannot, even in memory, dwell on it without a start of horror."
                            },
                            {
                                "example_id": "4c2a2575-68b4-4fca-b6d5-26caf97fbd56",
                                "sense_id": "08e0c08d-e514-3c40-9694-8b0b853b6232",
                                "text": "Away, Remorse! / Compunction, hence!. / Go, Moral Force! / Go, Penitence!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fed2642d-ea69-40eb-b4a2-e04c41812417",
