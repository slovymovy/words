                "senses": [
                    {
                        "sense_id": "7a178d95-c8fc-30b6-85c8-74ee044d9b3c",
                        "entry_id": "817fb5eb-3886-309d-838c-42e1f0c34d56",
                        "glosses": [
                            "in twee talen, in twee talen kunnen spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8bd35e-6c1a-42d5-87aa-5c21b6a1b438",
                                "sense_id": "7a178d95-c8fc-30b6-85c8-74ee044d9b3c",
                                "text": "In Nederland zijn er steeds meer middelbare scholen die tweetalig onderwijs geven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a986d606-9e81-4804-8b48-92f1f82a0559",
                        "source_entry_id": "817fb5eb-3886-309d-838c-42e1f0c34d56",
                        "source_sense_id": "7a178d95-c8fc-30b6-85c8-74ee044d9b3c",
                        "target_lang_word": "zweisprachig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweisprachig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "479042a7-a369-3670-b821-e8e8c42f142e",
                                        "entry_id": "5361477f-9e0b-335c-8fc3-4c5b6802e2b0",
                                        "glosses": [
                                            "zwei Sprachen beherrschend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73607008-59f3-43a1-8197-f2f9bfb30830",
                                                "sense_id": "479042a7-a369-3670-b821-e8e8c42f142e",
                                                "text": "„Im Rahmen einer Lizenziatsarbeit an der Universität Zürich untersuchte die Autorin die Entwicklung der Textkompetenz zweisprachiger Schülerinnen und Schüler der ersten sechs Schuljahre.“"
                                            },
                                            {
                                                "example_id": "451cb4bc-e716-4d08-afd8-4728929b52c6",
                                                "sense_id": "479042a7-a369-3670-b821-e8e8c42f142e",
                                                "text": "„Während der Großteil der ethnisch lettischen Bevölkerung zweisprachig Lettisch - Russisch war, lernten viele Zuwanderer aus anderen Teilen der Sowjetunion das Lettische nicht.“"
                                            },
                                            {
                                                "example_id": "ce592a94-2c0e-4216-b89b-aad2bfa6518e",
                                                "sense_id": "479042a7-a369-3670-b821-e8e8c42f142e",
                                                "text": "„Insgesamt ist die Jugend zwar nicht mehr so multilingual wie ihre Vorväter, aber viele sind doch wenigstens zweisprachig und natürlich lernen sie in zunehmendem Maße auch Englisch.“"
                                            },
                                            {
                                                "example_id": "5a96086c-da29-4e01-bd8a-0282a2bcec44",
                                                "sense_id": "479042a7-a369-3670-b821-e8e8c42f142e",
                                                "text": "„Südlich davon entstand aber zunächst, wohl drei Jahrhunderte lang, ein großes bis ungefähr zur Loire gehendes zweisprachiges Gebiet: nebeneinander also galloromanisch und fränkisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0d2ad0a-8a80-3784-b056-fbb8d60d6767",
                                        "entry_id": "5361477f-9e0b-335c-8fc3-4c5b6802e2b0",
                                        "glosses": [
                                            "in zwei Sprachen abgefasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "342dda8b-43e7-45fa-97f6-2fb831421dee",
                                                "sense_id": "e0d2ad0a-8a80-3784-b056-fbb8d60d6767",
                                                "text": "Bei der Erschließung alter Sprachen waren zweisprachige Texte oft sehr hilfreich."
                                            },
                                            {
                                                "example_id": "b23b6c6f-b6d1-4d0a-8874-f08aa72470e6",
                                                "sense_id": "e0d2ad0a-8a80-3784-b056-fbb8d60d6767",
                                                "text": "„In altbabylonischer Zeit fügte man der sumerischen Kolumne eine babylonische Übersetzung hinzu und schuf damit die ersten zweisprachigen Glossare oder Wörterbücher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcb14b26-5550-401e-9328-be23ab5123e9",
                        "source_entry_id": "817fb5eb-3886-309d-838c-42e1f0c34d56",
                        "source_sense_id": "7a178d95-c8fc-30b6-85c8-74ee044d9b3c",
                        "target_lang_word": "bilingual",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bilingual",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                        "entry_id": "3bfb885f-c6b1-3c7e-9577-758db8dde21f",
                                        "glosses": [
                                            "zwei Sprachen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55dca6fb-6616-4fea-9c6c-925d30fafa58",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "Manche Kinder, deren Eltern verschiedene Muttersprachen sprechen, wachsen bilingual auf."
                                            },
                                            {
                                                "example_id": "1697d660-02d3-4d42-988e-d3dd8db19b4c",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "Die Schule ist bilingual: Ein Teil der Fächer wird in Deutsch, ein anderer in Englisch unterrichtet."
                                            },
                                            {
                                                "example_id": "5e19aabd-c90c-4152-ad89-5accf6979cf2",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "„Diejenigen, die in einer Sprache lesen und schreiben konnten, waren nun auch fähig, andere Sprachen zu lernen, indem sie sich die Grammatikregeln und die Bedeutung der Wörter aus einem bilingualen Wörterbuch aneigneten.“"
                                            },
                                            {
                                                "example_id": "e00eda6a-0c16-4104-bbaf-ca542af71d97",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "„Pfarrerin Peltonens bilingualer Predigt vermochte ich leider nicht zu folgen.“"
                                            },
                                            {
                                                "example_id": "07d3d6ca-959f-4148-ad13-8bd9c61a7b79",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "„Sie waren auf Englisch, und schon stellte ich mir eine Zukunft als internationale oder zumindest bilinguale Journalistin vor.“"
                                            },
                                            {
                                                "example_id": "1ae73002-0ad3-41aa-8e6b-873607a13efa",
                                                "sense_id": "adcedfe8-ab15-37aa-8b1e-c24c221f851e",
                                                "text": "„Aber auch für bilinguale Kinder gilt: Eine Sprache ist meist die dominante.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa2ca1d5-3a33-4728-9603-41009963cc6f",
                        "source_entry_id": "817fb5eb-3886-309d-838c-42e1f0c34d56",
