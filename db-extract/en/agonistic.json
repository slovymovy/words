                        "form_id": "e50c0f4c-9abe-4e11-862a-957bf91ed255",
                        "entry_id": "3e4a32d6-6a9a-3b7b-8f9a-d85c9477bc31",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more agonistic"
                    },
                    {
                        "form_id": "219a8330-d9f5-46f1-89d1-8d75fbc15a5f",
                        "entry_id": "3e4a32d6-6a9a-3b7b-8f9a-d85c9477bc31",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most agonistic"
