                        "sense_id": "125df764-a24c-3a46-9954-f8de8321b64f",
                        "entry_id": "e5b2ff10-be86-3be9-8dbb-a7bd792739d0",
                        "glosses": [
                            "Anthologie, recueil de textes classiques ou tirés d’auteurs faciles, choisis avec soin et rassemblés dans un but pédagogique, par exemple pour se familiariser avec une langue ancienne ou une littérature étrangère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f77b43e-99b3-4763-94bd-d261c2713dd2",
                                "sense_id": "125df764-a24c-3a46-9954-f8de8321b64f",
                                "text": "Chrestomathie grecque."
                            },
                            {
                                "example_id": "805db2ab-569f-442e-ae83-d0941f6ed6b7",
                                "sense_id": "125df764-a24c-3a46-9954-f8de8321b64f",
                                "text": "Chrestomathie du Moyen-Âge."
                            },
                            {
                                "example_id": "de63924d-1b4b-4d4a-8293-3a5e95deebff",
                                "sense_id": "125df764-a24c-3a46-9954-f8de8321b64f",
                                "text": "Chrestomathie égyptienne, choix de textes égyptiens transcrits, traduits et accompagnés d'un commentaire perpétuel et précédés d’un abrégé grammatical."
                            },
                            {
                                "example_id": "e9e18bb8-8a09-4716-88b1-f8fc9d44e37d",
                                "sense_id": "125df764-a24c-3a46-9954-f8de8321b64f",
                                "text": "Après la parution de sa chrestomathie, les Anglais avaient été en effet vexés que le premier travail sérieux sur l’Afghanistan fût issu de Russie."
                            }
                        ]
                    }
