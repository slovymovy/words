                "senses": [
                    {
                        "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                        "entry_id": "0249574f-80e0-331d-856a-d5215cb9b790",
                        "glosses": [
                            "Qui se rapporte à l’octogone ; qui a la forme d’un octogone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08beb777-49a5-4383-a4fa-5a89be8121ed",
                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                "text": "Au centre, entre les Dômes, la Renommée embouchait sa trompette et lançait un grand jet vers le ciel, dans une cuve octogonale entourée d’une balustrade circulaire."
                            },
                            {
                                "example_id": "ea597d1a-451f-420c-b2cc-c218898eaa6d",
                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                "text": "Victor Horta trouve dans le hall octogonal de l'hôtel Tassel une solution élégante au problème posé par l’encombrement des radiateurs."
                            },
                            {
                                "example_id": "44d94686-7179-47ee-8210-d5837bad3457",
                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                "text": "La mosquée d’El-Sakhra, de forme octogonale, est surmontée d’une coupole qui se dresse dans les cieux à une hauteur de 29 mètres au-dessus du sol de l’Esplanade des mosquées. Elle est entourée de quatre portiques situés aux quatre points cardinaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e02c6d2-453c-440c-8eec-639853f16a4a",
                        "source_entry_id": "0249574f-80e0-331d-856a-d5215cb9b790",
                        "source_sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                        "target_lang_word": "octagonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octagonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                                        "entry_id": "fee86f1f-bce2-32d1-ad4d-963e6db56a88",
                                        "glosses": [
                                            "Shaped like an octagon, in having eight sides and eight angles."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e150b7f1-5407-4efc-abfe-6a99e728c8af",
                                                "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                                                "text": "Near Smeinogorsk an octagonal tumulus has been found containing the corpse of a horse near a rectangular one with a human corpse, both within stone circles."
                                            },
                                            {
                                                "example_id": "174ba53a-4d3f-4d07-82f8-7f829539cc31",
                                                "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                                                "text": "The sundials range in shape from octagonal to the usual round. Prices range from $75 to $375."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3217dccc-e563-475e-8ff2-baa860748bda",
