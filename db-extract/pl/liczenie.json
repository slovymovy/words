                    },
                    {
                        "translation_id": "db323f47-1ca6-46a9-bc84-3d2847c65b47",
                        "source_entry_id": "44cf2f35-17bd-32ad-94d0-0054d6266a83",
                        "source_sense_id": "dba8d52f-9f01-3c47-b61e-95b9d9f17d1c",
                        "target_lang_word": "счёт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "счёт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "действие по значению гл. считать; вычисление, определение каких-либо количественных показателей или перечисление элементов последовательности чисел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f1d173-dbbf-4afe-a06e-5cf2d19529d0",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Устный счёт."
                                            },
                                            {
                                                "example_id": "0447f998-c946-446e-80fb-08c8841d89a9",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Счёт от единицы до десяти."
                                            },
                                            {
                                                "example_id": "8b3a565f-8237-4fad-86d6-a7f3c7394f51",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Князь для белочки потом // Выстроил хрустальный дом, // Караул к нему приставил // И притом дьяка заставил // Строгий счёт орехам весть."
                                            },
                                            {
                                                "example_id": "9722b1a1-26bd-4b5b-8ade-5367aee2091d",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Счёта деньгам не знает."
                                            },
                                            {
                                                "example_id": "9670c4d3-2f2e-4357-bdb6-0e7b46fbbc68",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Затем Авдеев потерял счёт в выстрелах, которые делала по нём судьба, и для него быстро один за другим замелькали странные, небывалые дни, и каждый день приносил с собою какой-нибудь новый неожиданный сюрприз."
                                            },
                                            {
                                                "example_id": "ebafceb0-f209-46fc-8278-b2748873c732",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Сделать ружейный приём в три счёта."
                                            },
                                            {
                                                "example_id": "35a6ddc2-c609-47b5-a656-c89d2137bcb3",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Я счёт по-немецки знаю."
                                            },
                                            {
                                                "example_id": "f8c68e00-38b5-45c1-bd25-0943acd5471b",
                                                "sense_id": "f5f56756-937e-30d7-9d18-72ba71150e5c",
                                                "text": "Обучение счёту и письму."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a533fda-9f92-3268-a740-be4af9b39f57",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "спорт. результат сопоставления каких-либо показателей, выраженных в числах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987c40d4-93c6-4ea2-a31f-ae61ec8e96fb",
                                                "sense_id": "4a533fda-9f92-3268-a740-be4af9b39f57",
                                                "text": "Счёт в игре так и не был открыт."
                                            },
                                            {
                                                "example_id": "9af20965-0b61-4ff2-8710-e89e101741c5",
                                                "sense_id": "4a533fda-9f92-3268-a740-be4af9b39f57",
                                                "text": "К концу матча счёт был 2:1 в пользу «Динамо»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061dce3c-7ee5-3270-96a2-66af2b6eff2e",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "фин., документ с указанием денежной суммы, причитающейся к оплате за проданный товар или оказанную услугу"
                                        ],
                                        "tags": [
                                            "мн. ч. счета́"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b859912-042e-4f5e-8fef-8212e6a6fb2b",
                                                "sense_id": "061dce3c-7ee5-3270-96a2-66af2b6eff2e",
                                                "text": "Завтрак кончен, и компатриот с ужасом видит, что счёт всё-таки вырос до 14 франков!"
                                            },
                                            {
                                                "example_id": "591204aa-4f49-4fb0-aed7-db22b1acba41",
                                                "sense_id": "061dce3c-7ee5-3270-96a2-66af2b6eff2e",
                                                "text": "Все дорожные издержки относятся на счёт самих купцов."
                                            },
                                            {
                                                "example_id": "e5470e1e-a869-4c58-aa2c-9164c6aa9c80",
                                                "sense_id": "061dce3c-7ee5-3270-96a2-66af2b6eff2e",
                                                "text": "Требуйте счёт из гостиницы и рассчитывайтесь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb3d78f-1ea8-3bc0-bd58-1751bca67973",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "перен., разг. претензия к кому-либо, неудовлетворённая обида"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969f2807-ce46-4a42-a579-ed35527ccd7f",
                                                "sense_id": "adb3d78f-1ea8-3bc0-bd58-1751bca67973",
                                                "text": "Белокуров принял это на свой счёт, обиделся и ушёл."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80cbb9f7-c5bd-3ffd-bb46-44c00a7c0cfe",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "фин., бухг. запись в учётной системе финансовой организации, имеющая уникальный номер и соответствующая состоянию отношений между данной организацией и клиентом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e822bbe-b2a9-4eed-8a55-32be2c094edc",
                                                "sense_id": "80cbb9f7-c5bd-3ffd-bb46-44c00a7c0cfe",
                                                "text": "Банк может использовать имеющиеся на счёте денежные средства, гарантируя право клиента беспрепятственно распоряжаться этими средствами."
                                            },
                                            {
                                                "example_id": "59ba8873-db85-45b6-8546-94279c3adce8",
                                                "sense_id": "80cbb9f7-c5bd-3ffd-bb46-44c00a7c0cfe",
                                                "text": "Им главное ― оттрубить положенный срок и наслаждаться кругленькой суммой на счету."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc82bbd6-5371-3107-b521-9959bb621b71",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "фин. тип записи в бухгалтерском учёте"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb5ef30d-83b0-3fd9-9fa8-15b23ae304b0",
                                        "entry_id": "d463bba7-dd15-3648-9593-85ff948ad690",
                                        "glosses": [
                                            "муз. мера, показатель относительной длительности нот"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
