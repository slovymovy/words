                    {
                        "translation_id": "da968d46-fedf-4105-bd13-3a8e12ca14b6",
                        "source_entry_id": "4fe4364f-0baa-3445-8ef2-7746b1cb69cf",
                        "source_sense_description": "Any of various herbs of the family Gentianaceae",
                        "target_lang_word": "gentiane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentiane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b24f8bd-6a3f-3342-b890-9ea7e596625c",
                                        "entry_id": "924a2a88-dd1e-312d-8f23-e02349455d49",
                                        "glosses": [
                                            "Nom usuel des plantes du genre Gentiana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72ee2d1e-82f8-30d7-83c0-6f065516d601",
                                        "entry_id": "924a2a88-dd1e-312d-8f23-e02349455d49",
                                        "glosses": [
                                            "Désigne en particulier la gentiane jaune ou Gentiana lutea , grande plante vivace, au suc amer, de la famille des Gentianacées (Gentianaceae) dont elle est le type, elle est originaire des zones d’altitude de l’ouest européen."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d288184a-0f37-4a1d-a45e-20a87dd8e753",
                                                "sense_id": "72ee2d1e-82f8-30d7-83c0-6f065516d601",
                                                "text": "Les Aconits, les Asphodèles, les grandes Gentianes qui sont la parure de nos pâturages subalpins sont des plantes refusées par le bétail."
                                            },
                                            {
                                                "example_id": "e1815328-97f7-4969-a7ee-b39f69406ea7",
                                                "sense_id": "72ee2d1e-82f8-30d7-83c0-6f065516d601",
                                                "text": "La racine de la gentiane est topique utilisée en phytothérapie, autrefois les utilisations pouvaient être médicinales."
                                            },
                                            {
                                                "example_id": "479ce997-5d37-4f7a-96be-8c45ffc5ed4e",
                                                "sense_id": "72ee2d1e-82f8-30d7-83c0-6f065516d601",
                                                "text": "Il bâilla, s’étira, se roula durant une heure dans le rose des menus œillets de montagne et le bleu de méthylène des gentianes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31cbfc1-1a6e-396f-8b5d-57d522d2aa13",
                                        "entry_id": "924a2a88-dd1e-312d-8f23-e02349455d49",
                                        "glosses": [
                                            "Liqueur alcoolisée amère à base des racines de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f84947-4491-40dd-84f3-824985a02ce8",
                                                "sense_id": "e31cbfc1-1a6e-396f-8b5d-57d522d2aa13",
                                                "text": "Boire de la gentiane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f74d51-7951-3886-92c1-8f280a095ed7",
                                        "entry_id": "924a2a88-dd1e-312d-8f23-e02349455d49",
                                        "glosses": [
                                            "Sirop, tisane faite avec la racine de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
