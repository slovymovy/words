{
    "word_family": [
        "match",
        "matcher",
        "matchable",
        "mismatch",
        "rematch",
        "matchmaker",
        "matchmaking"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87782c39-83a1-3975-970c-0f6aece7c7bb",
                    "sense_definition": "Having the same appearance, color, or design as something else, often to form a set.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a new sofa and <w>matching</w> armchairs for the living room.",
                            "target_lang_translations": {
                                "ru": "Мы купили новый диван и <w>подходящие</w> к нему кресла для гостиной.",
                                "zh": "我们为客厅买了一张新沙发和与之<w>配套的</w>扶手椅。"
                            }
                        },
                        {
                            "text": "She wore a <w>matching</w> hat and scarf to keep warm.",
                            "target_lang_translations": {
                                "ru": "Она надела <w>сочетающиеся</w> шапку и шарф, чтобы согреться.",
                                "zh": "她戴了一顶<w>相配的</w>帽子和围巾来保暖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "identical",
                        "coordinating",
                        "paired",
                        "same"
                    ],
                    "antonyms": [
                        "clashing",
                        "mismatched",
                        "different"
                    ],
                    "common_phrases": [
                        "matching set",
                        "matching pair",
                        "matching colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий тот же внешний вид, цвет или дизайн, что и что-то другое, часто составляющий комплект.",
                        "zh": "指外观、颜色或设计与他物相同，通常用于组成一套。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходящий",
                                "target_lang_sense_clarification": "соответствующий по виду или назначению"
                            },
                            {
                                "target_lang_word": "сочетающийся",
                                "target_lang_sense_clarification": "гармонирующий"
                            },
                            {
                                "target_lang_word": "парный",
                                "target_lang_sense_clarification": "составляющий пару"
                            },
                            {
                                "target_lang_word": "в тон",
                                "target_lang_sense_clarification": "совпадающий по цвету"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配套的",
                                "target_lang_sense_clarification": "指成套或相互搭配的"
                            },
                            {
                                "target_lang_word": "相配的",
                                "target_lang_sense_clarification": "指在外观或风格上协调"
                            },
                            {
                                "target_lang_word": "同色的",
                                "target_lang_sense_clarification": "指颜色一致"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5430dab-28e9-3000-8e9f-bea810e027db",
                    "sense_definition": "Present participle of <w>match</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>matching</w> the receipts with the bank statement.",
                            "target_lang_translations": {
                                "ru": "В данный момент он <w>сверяет</w> чеки с банковской выпиской.",
                                "zh": "他目前正在把收据与银行对账单进行<w>核对</w>。"
                            }
                        },
                        {
                            "text": "The paint color is not <w>matching</w> the sample we chose.",
                            "target_lang_translations": {
                                "ru": "Цвет краски не <w>совпадает</w> с выбранным нами образцом.",
                                "zh": "油漆颜色与我们选的样本不<w>相符</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола match (соответствовать, подходить, сопоставлять).",
                        "zh": "动词 match 的现在分词，表示对应、相符或进行比对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствующий",
                                "target_lang_sense_clarification": "отвечающий требованиям"
                            },
                            {
                                "target_lang_word": "совпадающий",
                                "target_lang_sense_clarification": "идентичный"
                            },
                            {
                                "target_lang_word": "сопоставляющий",
                                "target_lang_sense_clarification": "сравнивающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相符",
                                "target_lang_sense_clarification": "指事物之间一致"
                            },
                            {
                                "target_lang_word": "核对",
                                "target_lang_sense_clarification": "指比对数据或信息"
                            },
                            {
                                "target_lang_word": "匹配",
                                "target_lang_sense_clarification": "指使两者对应"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27371872-1932-3fce-9408-f04eed2ebcdd",
                    "sense_definition": "The process of pairing things together based on similarities or suitability.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>matching</w> of donors to recipients is a critical medical procedure.",
                            "target_lang_translations": {
                                "ru": "<w>Подбор</w> доноров для реципиентов — важнейшая медицинская процедура.",
                                "zh": "捐赠者与接受者的<w>匹配</w>是一项关键的医疗程序。"
                            }
                        },
                        {
                            "text": "Computer algorithms assist in the <w>matching</w> of fingerprints from the database.",
                            "target_lang_translations": {
                                "ru": "Компьютерные алгоритмы помогают в <w>сопоставлении</w> отпечатков пальцев из базы данных.",
                                "zh": "计算机算法有助于数据库中指纹的<w>比对</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pairing",
                        "coupling"
                    ],
                    "common_phrases": [
                        "pattern matching",
                        "matching process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс объединения вещей в пары на основе сходства или пригодности.",
                        "zh": "基于相似性或适用性将事物配对的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбор",
                                "target_lang_sense_clarification": "выбор подходящего"
                            },
                            {
                                "target_lang_word": "сопоставление",
                                "target_lang_sense_clarification": "сравнение данных"
                            },
                            {
                                "target_lang_word": "согласование",
                                "target_lang_sense_clarification": "приведение в соответствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匹配",
                                "target_lang_sense_clarification": "指将事物进行对应处理"
                            },
                            {
                                "target_lang_word": "配对",
                                "target_lang_sense_clarification": "指将两个事物组合在一起"
                            },
                            {
                                "target_lang_word": "比对",
                                "target_lang_sense_clarification": "指通过比较进行筛选或确认"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46345eb4-a4cd-372e-9aec-746ef18604c3",
                    "sense_definition": "A set of edges in a graph that do not share any common vertices.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In graph theory, a perfect <w>matching</w> covers every vertex in the set.",
                            "target_lang_translations": {
                                "ru": "В теории графов совершенное <w>паросочетание</w> покрывает каждую вершину множества.",
                                "zh": "在图论中，完美<w>匹配</w>覆盖了集合中的每一个顶点。"
                            }
                        },
                        {
                            "text": "The algorithm calculates the maximum <w>matching</w> possible for this network.",
                            "target_lang_translations": {
                                "ru": "Алгоритм вычисляет максимальное возможное <w>паросочетание</w> для этой сети.",
                                "zh": "该算法计算了此网络中可能的最大<w>匹配</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор ребер в графе, не имеющих общих вершин.",
                        "zh": "图论中的一个术语，指图中没有公共顶点的边的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паросочетание",
                                "target_lang_sense_clarification": "термин теории графов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匹配",
                                "target_lang_sense_clarification": "图论中指边的集合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}