                ],
                "senses": [
                    {
                        "sense_id": "f99045d0-eae4-3f77-8795-80d593283dc6",
                        "entry_id": "54b7036c-74e8-32be-adc8-674e4e93f184",
                        "glosses": [
                            "Jeu à la mode au dix-neuvième siècle, dans lequel les joueurs cherchent à se défausser des valets qu'ils possèdent et en particulier du valet de pique."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "a6a63348-c69c-4b99-a7a1-c9f18c5f1ae5",
                                "sense_id": "f99045d0-eae4-3f77-8795-80d593283dc6",
                                "text": "Le reste du XIXᵉ siècle verra naître et mourir des jeux de salon comme le polignac, un jeu provincial connu, le bésigue, alors que s'efface la brisque qui avait probablement été son ancêtre en Gascogne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1339c9c-c614-3146-b598-8d67c7975797",
                        "entry_id": "54b7036c-74e8-32be-adc8-674e4e93f184",
                        "glosses": [
                            "Valet de pique, constituant la plus mauvaise carte de ce jeu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab27039e-b9bd-41a6-8bbe-4c0e591f56e5",
                                "sense_id": "f1339c9c-c614-3146-b598-8d67c7975797",
                                "text": "Lorsque toutes les cartes ont été jouées, les joueurs qui ont des valets devant eux sont pénalisés d'un point par valet, de deux points pour le valet de pique ou Polignac."
                            }
                        ]
                    }
