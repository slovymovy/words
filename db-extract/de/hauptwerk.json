                ],
                "senses": [
                    {
                        "sense_id": "f206bd42-4931-3609-af09-84249c289d43",
                        "entry_id": "0a00d8bc-cfcb-3e0d-8f18-68094f2349b9",
                        "glosses": [
                            "wichtigstes Werk eines Künstlers, Wissenschaftlers …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "089ec711-22ea-4106-9ea4-56b6bf0421d0",
                                "sense_id": "f206bd42-4931-3609-af09-84249c289d43",
                                "text": "„Dort schrieb er in den letzten Lebensjahren sein Hauptwerk nieder.“"
                            },
                            {
                                "example_id": "bad66a6a-0660-4e1c-be59-0a41351b2c27",
                                "sense_id": "f206bd42-4931-3609-af09-84249c289d43",
                                "text": "„1940 vollendete Pater Pierre sein Hauptwerk »Der Mensch im Kosmos«, erhielt allerdings keine kirchliche Druckerlaubnis.“"
                            },
                            {
                                "example_id": "3afbf231-64ab-4393-8672-0ad5487a2f32",
                                "sense_id": "f206bd42-4931-3609-af09-84249c289d43",
                                "text": "„Einige Hauptwerke werden auch in absehbarer Zukunft nicht öffentlich und frei verkauft werden können, sondern nur innerhalb eines geschlossenen, namentlich bekannten Kreises durch Subskriptionsausgaben oder bibliophile Drucke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65095ad1-6d12-3d0e-baf2-b2aeefb8f9ce",
                        "entry_id": "0a00d8bc-cfcb-3e0d-8f18-68094f2349b9",
                        "glosses": [
                            "zentraler/wichtigster Teil, zentrale/wichtigste Niederlassung eines Unternehmens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b9147f-7f4d-4d20-8749-faf3ced799b4",
                                "sense_id": "65095ad1-6d12-3d0e-baf2-b2aeefb8f9ce",
                                "text": "„Da die Rohstoffversorgung unterbrochen ist, wurden 20 Anlagen im Hauptwerk der BASF abgeschaltet beziehungsweise laufen nur noch auf Teillast.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
