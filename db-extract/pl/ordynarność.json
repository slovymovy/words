                ],
                "senses": [
                    {
                        "sense_id": "4b740d4c-40cf-37c6-b3d9-f7faf04caae0",
                        "entry_id": "fe406a65-814f-31e0-82a5-326d7b6cad59",
                        "glosses": [
                            "crudeness, debasedness, distastefulness, obsceneness, tactlessness, uncouthness, vulgarness"
                        ],
                        "tags": [
                            "feminine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9205de6-15bd-4352-91be-32e4ac4172f5",
                                "sense_id": "4b740d4c-40cf-37c6-b3d9-f7faf04caae0",
                                "text": "Kazik od razu nabrał sympatii do Klawera, mimo że go raziła trochę jego ordynarność.",
                                "translation": "Kazik immediately took a liking to Klawer, even though he was a little put off by his vulgarness.",
                                "english": "Kazik immediately took a liking to Klawer, even though he was a little put off by his vulgarness."
                            },
                            {
                                "example_id": "58dd314b-77f3-494d-bdce-75fb1a087d7b",
                                "sense_id": "4b740d4c-40cf-37c6-b3d9-f7faf04caae0",
                                "text": "Magdę raziła ta ordynarność Misi, ale teraz wdzięczna jej była za życzliwość.",
                                "translation": "Magda was offended by Misia's vulgarness, but now she was grateful for her kindness.",
                                "english": "Magda was offended by Misia's vulgarness, but now she was grateful for her kindness."
                            },
                            {
                                "example_id": "265a2e79-ea10-460f-9259-d37e4def5f7b",
                                "sense_id": "4b740d4c-40cf-37c6-b3d9-f7faf04caae0",
                                "text": "Alkohol jest absolutnie zakazany. Po pierwszym wypiciu dostaje się ostrzeżenie, po kolejnym trzeba opuścić dom.[…]Uciążliwość dla współmieszkańców, chamstwo, ordynarność, wyzwiska, trzaskanie drzwiami, to wszystko może doprowadzić do pożegnania z domem.",
                                "translation": "Alcohol is absolutely forbidden. After the first drink you get a warning, after the next one you have to leave the house. […] Nuisance to fellow residents, rudeness, vulgarness, name-calling, slamming doors, all of these can lead to a farewell from the house.",
                                "english": "Alcohol is absolutely forbidden. After the first drink you get a warning, after the next one you have to leave the house. […] Nuisance to fellow residents, rudeness, vulgarness, name-calling, slamming doors, all of these can lead to a farewell from the house."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                        "entry_id": "fe406a65-814f-31e0-82a5-326d7b6cad59",
                        "glosses": [
                            "cheapness, crappiness, tackiness (the state or condition of being in bad taste)"
                        ],
                        "tags": [
                            "feminine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4207a55f-a8a0-44b1-9300-3da19a148063",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "— Aha! i mospan Florismart jest tu? — na to ksiądz, — i jego zaraz mi z drugimi za okno, choć z takiego rodu i takie dziwne miał przygody w życiu; biédota i ordynarność stylu nie zasługują na lepszy los.",
                                "translation": "\"Senor Florismarte here?\" said the curate; \"then by my faith he must take up his quarters in the yard, in spite of his marvellous birth and visionary adventures, for the stiffness and dryness of his style deserve nothing else; into the yard with him and the other, mistress housekeeper.\"",
                                "english": "\"Senor Florismarte here?\" said the curate; \"then by my faith he must take up his quarters in the yard, in spite of his marvellous birth and visionary adventures, for the stiffness and dryness of his style deserve nothing else; into the yard with him and the other, mistress housekeeper.\""
                            },
                            {
                                "example_id": "d16700d5-c400-427f-a88a-634de2183345",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "ordynarność obyczajów",
                                "translation": "tackiness of customs",
                                "english": "tackiness of customs"
                            },
                            {
                                "example_id": "e8d0e82b-1380-41da-915c-ede17739470d",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "ordynarność pracy",
                                "translation": "cheapness of work",
                                "english": "cheapness of work"
                            },
                            {
                                "example_id": "5d7679ed-a7d3-4e17-8ce5-08af763c3928",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "ordynarność życia",
                                "translation": "crappiness of life",
                                "english": "crappiness of life"
                            },
                            {
                                "example_id": "8b2a3b8b-b750-459d-a7a6-71c856dc3b91",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "Tu oprócz ordynarności kształtów, rysów i odzieży nie widziałem nic i nie doświadczyłem niczego oprócz nudy.",
                                "translation": "Here, apart from the cheapness of shapes, features and clothing, I saw nothing and experienced nothing but boredom.",
                                "english": "Here, apart from the cheapness of shapes, features and clothing, I saw nothing and experienced nothing but boredom."
                            },
                            {
                                "example_id": "752c698a-cd62-460e-bd5d-f92f281ed856",
                                "sense_id": "b8e93cd5-1df3-3ddd-8e99-bb55faf4f829",
                                "text": "Kilka lat temu[…]autor monografii o Chopinie, napisał, że nienawidzi polskiej muzyki ludowej za jej ordynarność. Na szczęście Chopin był bardziej wrażliwy od swego biografa.",
                                "translation": "A few years ago […] author of a monograph on Chopin, wrote, that he hated Polish folk music for its tackiness. Chopin was fortunately more sensitive than his biographer.",
                                "english": "A few years ago […] author of a monograph on Chopin, wrote, that he hated Polish folk music for its tackiness. Chopin was fortunately more sensitive than his biographer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a50e9aa-d2a8-3e7e-9cf1-8629445fdda4",
                        "entry_id": "fe406a65-814f-31e0-82a5-326d7b6cad59",
                        "glosses": [
                            "crude/cheap word/expression/deed etc."
                        ],
                        "tags": [
                            "countable",
                            "feminine",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9df4bb6c-4b3a-4ee6-9273-414c08caf403",
                                "sense_id": "6a50e9aa-d2a8-3e7e-9cf1-8629445fdda4",
                                "text": "Nachodzi go ciekawość, jak też do tych ordynarności odnoszą się władze przełożone.",
                                "translation": "He is curious to know, how the higher authorities view these vulgarities.",
                                "english": "He is curious to know, how the higher authorities view these vulgarities."
                            }
                        ]
                    }
