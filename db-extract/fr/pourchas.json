        "fr-extract.jsonl": [
            {
                "entry_id": "f2ffb146-4a71-3164-9a20-deb55d7f041e",
                "word": "pourchas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "508051b5-04c8-4d14-873c-b7080cdbc82b",
                        "entry_id": "f2ffb146-4a71-3164-9a20-deb55d7f041e",
                        "tags": [],
                        "form": "pourchasse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96d9a4eb-369d-38e7-bced-18f8aa55d81c",
                        "entry_id": "f2ffb146-4a71-3164-9a20-deb55d7f041e",
                        "glosses": [
                            "Action de pourchasser, de rechercher."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1b0b9fdd-75e2-448a-8eea-44e9e5199475",
                                "sense_id": "96d9a4eb-369d-38e7-bced-18f8aa55d81c",
                                "text": "J’aurais besoin peut-être, d’ici à peu, de quelques braves à tout poil pour une expédition qu’on me propose, non tant lointaine que celle des Argonautes au pourchas de la toison d’or."
                            },
                            {
                                "example_id": "bfb0707d-546d-44d1-85a0-d008b485b514",
                                "sense_id": "96d9a4eb-369d-38e7-bced-18f8aa55d81c",
                                "text": "C’était un pourchas éperdu dans la nuit ; le vieux galopait, pareil à un fantôme dans sa chemise blanche, dont la bannière flottait au vent ; il galopait de toute la force de ses jambes maigres."
                            },
                            {
                                "example_id": "f40cfeb0-8856-43fc-8b4e-fec51c7ccc22",
                                "sense_id": "96d9a4eb-369d-38e7-bced-18f8aa55d81c",
                                "text": "Pour célébrer leurs seins et leurs bras ronds\nIl nous faudrait patients, nos mains serrant nos fronts,\nChercher la métaphore — et ce pourchas nous lasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c4d9507-62a9-3f60-a3ae-2f4b1058e52c",
                        "entry_id": "f2ffb146-4a71-3164-9a20-deb55d7f041e",
                        "glosses": [
                            "Poursuite, et particulièrement poursuite amoureuse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "678c910d-67b0-45a6-b070-3c07cd0c3362",
                                "sense_id": "6c4d9507-62a9-3f60-a3ae-2f4b1058e52c",
                                "text": "Nous rançonnerons au pourchas les Maures qui sont des Philistins!"
                            },
                            {
                                "example_id": "a0629c65-74d9-4d0e-a684-1b44d4d95568",
                                "sense_id": "6c4d9507-62a9-3f60-a3ae-2f4b1058e52c",
                                "text": "Il en venait à regretter les punaises. Il enrageait, et dans l’énervement de ce pourchas inutile acheva de compromettre son sommeil."
                            },
                            {
                                "example_id": "98e17772-0fe7-40ab-81bb-055d1eadaf46",
                                "sense_id": "6c4d9507-62a9-3f60-a3ae-2f4b1058e52c",
                                "text": "Il remâchait, avec une sorte d’amère délectation, les heures de pourchas fastidieux, à l’affût de la poire charitable et tapable."
                            },
                            {
                                "example_id": "b5d0d671-e632-4199-ad5e-0de4007b2efe",
                                "sense_id": "6c4d9507-62a9-3f60-a3ae-2f4b1058e52c",
                                "text": "La condition nécessaire pour que je sois, par-delà un monde que je fais venir à l'être, ce que je ne suis pas et que je ne sois pas ce que je suis, c'est qu'au cœur du pourchas infini que je suis, il y ait perpétuellement un insaisissable donné."
                            }
                        ]
                    }
                ],
