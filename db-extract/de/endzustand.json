                            "singular"
                        ],
                        "form": "den Endzustand"
                    },
                    {
                        "form_id": "6e595945-86f6-4fab-8acf-a348c051de35",
                        "entry_id": "81340448-822f-36de-bf81-993509697b56",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Endzustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb9508ef-0cc7-304d-8943-efcfd1d7e5a0",
                        "entry_id": "81340448-822f-36de-bf81-993509697b56",
                        "glosses": [
                            "der endgültige Status, die Konstellation am Ende einer Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26b148d-df01-497b-9068-cc5cc9eb8e0f",
                                "sense_id": "eb9508ef-0cc7-304d-8943-efcfd1d7e5a0",
                                "text": "„Ich sehe Glück nicht als Endzustand, sondern als ein Ziel, das man nie vollständig erreichen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "385d2509-23e1-3361-9cad-50a0f74982b1",
                        "entry_id": "81340448-822f-36de-bf81-993509697b56",
                        "glosses": [
                            "speziell ausgezeichneter Zustand eines Automaten, bei dessen Erreichen nach Lesen einer Eingabe diese akzeptiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df61abf5-a9e8-491f-99db-6ac7bd321df5",
                                "sense_id": "385d2509-23e1-3361-9cad-50a0f74982b1",
                                "text": "„Ein NEA soll Eingabeworte daraufhin prüfen, ob sie in einer gegebenen Sprache sind oder nicht. Er akzeptiert ein Wort, wenn er nach Lesen des ganzen Wortes in einem Endzustand gelandet ist.“"
                            },
                            {
                                "example_id": "c4d74ad2-e4b7-4a60-b895-d768752724f7",
                                "sense_id": "385d2509-23e1-3361-9cad-50a0f74982b1",
                                "text": "„Sofern der Zustand nach Abarbeiten des betreffenden Wortes ein Endzustand ist, gilt das Wort w als akzeptiert.“"
                            },
                            {
                                "example_id": "47add1b8-2fd7-40c9-965c-c74575e84c81",
                                "sense_id": "385d2509-23e1-3361-9cad-50a0f74982b1",
                                "text": "„Eine Folge von Übergängen ist ein erfolgreicher Suchprozess, wenn sie mit dem Startzustand beginnt und mit einem Endzustand endet.“"
                            },
                            {
                                "example_id": "f3f6287c-c135-4bbe-b044-a41599f4bfc7",
                                "sense_id": "385d2509-23e1-3361-9cad-50a0f74982b1",
                                "text": "„Bei der Propagierung eines zusammen mit dem Store inkonsistenten Constraints erhalten wir einen verklemmten Endzustand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a68b2e6-3163-4a4c-9fe3-17a9b98f8e2a",
                        "source_entry_id": "81340448-822f-36de-bf81-993509697b56",
                        "source_sense_id": "eb9508ef-0cc7-304d-8943-efcfd1d7e5a0",
                        "source_sense_description": "der endgültige Status, die Konstellation am Ende einer Entwicklung",
                        "target_lang_word": "finalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                        "entry_id": "ebdef35a-ac83-3adc-bc53-ef264202b5f8",
                                        "glosses": [
                                            "But, résultat attendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2fe294a-23e5-4eca-adf6-3b01ac5562e5",
                                                "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                                "text": "La blockchain n’est pas une finalité, mais un simple outil de sécurisation."
                                            },
                                            {
                                                "example_id": "bc96299f-983c-4e99-8f50-b2d769a698f7",
                                                "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                                "text": "La Cour a rappelé que la collecte de données au titre du RGPD « doit être adéquate, pertinente et limitée à ce qui est nécessaire au regard des finalités pour lesquelles ces données sont traitées »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635af1af-0f56-3936-b085-5e16d22cf966",
                                        "entry_id": "ebdef35a-ac83-3adc-bc53-ef264202b5f8",
                                        "glosses": [
                                            "Principe philosophique d’après lequel toute chose a été créée en vue d’une fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671f2c76-0e57-4dcb-a134-4584f4e9a437",
                                                "sense_id": "635af1af-0f56-3936-b085-5e16d22cf966",
                                                "text": "À coup sûr, l'essence de la laïcité, mis à part la séparation de la religion et de l'État, est l'acceptation de la proposition selon laquelle il n'y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
