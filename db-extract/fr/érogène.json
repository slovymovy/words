                            {
                                "example_id": "672902b6-8b75-43c7-88ce-f711f36e7006",
                                "sense_id": "350d49d4-20e3-3c27-823f-8646f7b326e6",
                                "text": "La qualité érogène de la douleur s’émousse au cours du développement pour disparaître presque totalement chez l’adulte."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2f09212-26be-368d-a3be-15f73e5f25e4",
                        "entry_id": "69e29a48-ac51-3890-8a6b-283457cd631c",
                        "glosses": [
