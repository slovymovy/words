                                        "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                        "entry_id": "e344f14b-7e21-3736-a0b7-daca2ae88629",
                                        "glosses": [
                                            "An intermediate person or means; intermediary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fdd5d9-b498-4e47-96e3-a6bd3204000c",
                                                "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                                "text": "“My Lord Oxford, by a second hand, proposed my being his chaplain, which I, by a second hand, excused."
                                            },
                                            {
                                                "example_id": "e4dfe013-0603-4dc0-8b8f-97d0305dabeb",
                                                "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                                "text": "Under certain circumstances there is always a danger in a young man's playing the benefactor towards the other sex, in his own person. A thousand times better do it by a second hand — engage the services of some kind aunt or female cousin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "second hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5de253-6af0-31f4-a70a-657d416405cb",
                                        "entry_id": "99d2fb4c-686e-3f5f-948a-aca04f19acc0",
                                        "glosses": [
                                            "On the clock face of a clock or watch, the hand (pointer) that shows the number of seconds that have passed."
                                        ],
