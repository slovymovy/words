    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7fb5232d-b500-36f6-b782-78afecce3ca3",
                "word": "reniform",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                        "entry_id": "7fb5232d-b500-36f6-b782-78afecce3ca3",
                        "glosses": [
                            "Synonym of kidney-shaped (“having an approximately circular or elongated ovoid shape with an inward curve or indentation on one side”)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "16de4aa7-fb92-45ca-a367-e55986e6b80b",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "intussusception with a reniform appearance"
                            },
                            {
                                "example_id": "7ea434cf-a2ad-4e8e-8e42-74cb049b40ea",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "multiple reniform circumscribed fat-containing masses"
                            },
                            {
                                "example_id": "6d2ec583-91eb-4f53-b00c-b654ad3ee1ad",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "The Bean […] is oval, and not at all reniform'd like the Kidney-Beans."
                            },
                            {
                                "example_id": "a0d65826-37a8-41c2-8115-10991efaa3af",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "[T]he antheræ are reniform: the germen is oval, and obtuſely trigonal; […]"
                            },
                            {
                                "example_id": "5f857d8a-ec7e-41a4-a358-36a81a8fc6fa",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "In one of the ſegments of the lovver portion of the kidney, there vvas a large reniform Papillæ, in the outer circumference of vvhich a ſmall part of the papillary fleſh vvas vvanting. […] In the oppoſite ſegment, there vvas a fourth reniform Papilla, reſembling the firſt; […]"
                            },
                            {
                                "example_id": "65f3cb69-a2a2-4ded-917f-941c7fa162ce",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "The oxyde of cobalt, […] is found either ſuperficial, interſperſed, or in lumps; ſometimes botryoidal or reniform or bearing particular impreſſions."
                            },
                            {
                                "example_id": "25fbd2ea-8db0-42f4-a62e-c612b06f96e7",
                                "sense_id": "283f2c59-18b7-3415-90fa-c0313bbf45a5",
                                "text": "Nothing could be more simple than the furniture. The chairs were either posts mounted on four legs spread out for a base, or three-legged stools with reniform seats."
                            }
                        ]
                    },
                    {
                        "sense_id": "422f572a-da0b-3cd5-959e-47d4212f1c1f",
                        "entry_id": "7fb5232d-b500-36f6-b782-78afecce3ca3",
                        "glosses": [
                            "Synonym of kidney-shaped (“having an approximately circular or elongated ovoid shape with an inward curve or indentation on one side”).",
                            "Of a leaf: kidney-shaped, with the petiole attached at the notch."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b9849a5-9f3f-4f44-b9ce-36d53eab2818",
                        "source_entry_id": "7fb5232d-b500-36f6-b782-78afecce3ca3",
                        "source_sense_description": "synonym of kidney-shaped — see also kidney-shaped",
                        "target_lang_word": "réniforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réniforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f424041a-a382-33fa-990e-a6e541276b29",
                                        "entry_id": "f6f64c96-f0d5-306c-b3fc-cbf9185d2bfa",
                                        "glosses": [
                                            "En forme de rein ou de haricot."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7928a31-053d-42dc-af38-2577487fabc7",
                                                "sense_id": "f424041a-a382-33fa-990e-a6e541276b29",
                                                "text": "RÉNIFORME, adj., reniformis ; nierenförmig (all.) (renum, rein, forma, forme) ; qui a la forme d’un rein. Cotylédon réniforme, celui dont la surface offre à peu près la figure de la coupe d’un rein dans le plan de sa courbure (ex. Anacardium occidentale) ; graine réniforme, celle qui est ellipsoïde ou oblongue, et courbée dans le sens de sa longueur, de manière qu’un côté présente une convexité et l’autre une concavité (ex. Phaseolus communis) ; feuilles réniformes, celles qui sont arrondies au sommet, et échancrées en rond autour de l’insertion du pétiole (ex. Geophila reniformis, Asplenium reniforme). Les anthères sont réniformes dans le Glechoma hederacea, la carcérule dans l’Anacardium occidentale, le pépon dans l’Elaterium, les utricules du pollen dans le Commelina tuberosa."
                                            },
                                            {
                                                "example_id": "6de29274-a985-43da-8b48-28d2472b55b1",
                                                "sense_id": "f424041a-a382-33fa-990e-a6e541276b29",
                                                "text": "Certaines de ces cellules (cellules épithéliales, phagocytantes) ont un noyau qui s’allonge et devient réniforme ; elles peuvent être confondues avec des monocytes, d’autant plus que certaines d’entre elles sont phagocytantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
