                                "target_senses": [
                                    {
                                        "sense_id": "f9d94ddf-1e17-3de7-b592-19ae8cd96bb8",
                                        "entry_id": "7604a5d3-5c9d-335a-b8e3-01a3c4f88725",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "childish",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e98aec1-00be-43a3-812b-1a095b79a160",
                                                "sense_id": "f9d94ddf-1e17-3de7-b592-19ae8cd96bb8",
                                                "text": "“They never shower with us,” says Shipley, glancing up from his calculator. “I’ve never even seen their winkies.”"
                                            },
                                            {
                                                "example_id": "0b606cf7-64fa-4976-8692-9b818f6b86b0",
                                                "sense_id": "f9d94ddf-1e17-3de7-b592-19ae8cd96bb8",
                                                "text": "She had seen him naked many times and that was how he was. But this! His winky was — well, enormous now. And standing up. And looked positively gigantic and very stiff and proud!"
                                            },
                                            {
                                                "example_id": "fddb6ddb-5f9d-4529-af81-818a474da284",
                                                "sense_id": "f9d94ddf-1e17-3de7-b592-19ae8cd96bb8",
                                                "text": "‘And like when I went to the toilet last week and caught my winky in my zip. I cried for ages then.’ ‘Wogan!' gasped Flora. 'What is wrong with you?’ […] ‘“Winky”? That's a very babyish name for it. It's called your “dangly-wangly”.’"
                                            },
                                            {
                                                "example_id": "1f70d8b0-d026-486f-9803-e526a35a3444",
                                                "sense_id": "f9d94ddf-1e17-3de7-b592-19ae8cd96bb8",
                                                "text": "Next, on with his favourite budgie smugglers. His sequined posing pouch. No winky shrinkage for him."
                                            }
