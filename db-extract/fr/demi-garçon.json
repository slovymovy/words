                ],
                "senses": [
                    {
                        "sense_id": "3a9f1b70-676a-3047-b26a-7a3720ab7132",
                        "entry_id": "e1a3f4b6-f6a3-3e62-b860-808d800ebc88",
                        "glosses": [
                            "Personne dont l’identité de genre est partiellement homme et partiellement un autre genre (ou partiellement agenre)."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "97786cfa-64ee-467a-999e-82689c5ab452",
                                "sense_id": "3a9f1b70-676a-3047-b26a-7a3720ab7132",
                                "text": "Tu as finalement découvert le terme Demiboy, terme auquel tu aimerais avoir davantage d’informations! En français, certaines personnes utilisent également les termes demi-garçon ou demi-homme pour référer à demiboy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "168eda91-928a-4728-90df-9ed79cdf9781",
                        "source_entry_id": "e1a3f4b6-f6a3-3e62-b860-808d800ebc88",
                        "source_sense_id": "3a9f1b70-676a-3047-b26a-7a3720ab7132",
                        "target_lang_word": "demiboy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demiboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed5cd41-cf6b-3bdd-a1c3-bf66a83ab2f0",
                                        "entry_id": "ccc35373-2482-3a3a-9229-fb4bd43a59a3",
                                        "glosses": [
                                            "One who identifies as partially, but not completely, male."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916e83aa-bf7d-4ee5-a4b1-51ee9cdc0c6d",
                                                "sense_id": "6ed5cd41-cf6b-3bdd-a1c3-bf66a83ab2f0",
                                                "text": "Near-synonym: demiman"
                                            },
                                            {
                                                "example_id": "16c0bcf6-6fa9-49c6-ba54-8424c738c6ea",
                                                "sense_id": "6ed5cd41-cf6b-3bdd-a1c3-bf66a83ab2f0",
                                                "text": "Polk also identifies as a genderqueer demiboy and uses the pronouns ze/hir (in place of he or she one would use “ze” and in place of him or her one would use “hir”)."
                                            },
                                            {
                                                "example_id": "70331e38-8a19-4d8e-a0f7-81e9df52e839",
                                                "sense_id": "6ed5cd41-cf6b-3bdd-a1c3-bf66a83ab2f0",
                                                "text": "“A member of our family is a Demiboy,” I murmur."
                                            },
                                            {
                                                "example_id": "e370e96b-03c0-4cf5-bdcb-4b481b0e0a1b",
                                                "sense_id": "6ed5cd41-cf6b-3bdd-a1c3-bf66a83ab2f0",
                                                "text": "Jinokimijin had chosen an androgynous male form tonight: not a demiboy, which would typically blend neuter with male, but a femboy, a masculine shape with some feminine elements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demiboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab467996-c81a-38be-b699-37749236c8e0",
                                        "entry_id": "06408685-3f9d-3b28-ba0f-dabd141fa670",
