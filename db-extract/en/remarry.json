                "senses": [
                    {
                        "sense_id": "efca5a62-1e99-3030-8ea9-52dfb457ec4b",
                        "entry_id": "49896dfc-a68e-35cf-b3f3-23a4a959c01c",
                        "glosses": [
                            "To marry a second or subsequent time (the same spouse or a different one) after the end of a marriage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d94620-d9b9-4942-a69a-035289ebe5f0",
                                "sense_id": "efca5a62-1e99-3030-8ea9-52dfb457ec4b",
                                "text": "After his wife's death, he never remarried."
                            },
                            {
                                "example_id": "5af9c0cd-a42e-4b09-8fa6-8265a2f11974",
                                "sense_id": "efca5a62-1e99-3030-8ea9-52dfb457ec4b",
                                "text": "To everyone's surprise, after being divorced for ten years the couple eloped to Las Vegas and remarried."
                            },
                            {
                                "example_id": "ef8b0f0b-af9e-4b3f-a9a9-6536def24c38",
                                "sense_id": "efca5a62-1e99-3030-8ea9-52dfb457ec4b",
                                "text": "This church will remarry widows or widowers, but not divorcés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a7b9c50-4ab2-4cfd-b15f-9948012a4d9e",
