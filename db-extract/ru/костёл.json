                ],
                "senses": [
                    {
                        "sense_id": "249a9a11-875b-36a4-9c8e-032afaecc96b",
                        "entry_id": "65af299e-90f6-3339-a324-faaa873af6e2",
                        "glosses": [
                            "католический храм (обычно в Польше или Литве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e797d0-d2cb-42e6-be5c-8c2c97021337",
                                "sense_id": "249a9a11-875b-36a4-9c8e-032afaecc96b",
                                "text": "Оська поднял правую руку над головой, проверил положение большого пальца относительно лба и громко произнёс, что перед лицом своих товарищей даёт торжественное обещание больше не ходить в синагогу, церковь и костёл, который в Лютеранском переулке, а если он нарушит своё слово, пусть его выкинут из пионеров и никто во дворе не играет с ним."
                            },
                            {
                                "example_id": "53264217-df6d-413c-8e0e-4202060cc565",
                                "sense_id": "249a9a11-875b-36a4-9c8e-032afaecc96b",
                                "text": "На этот раз он отошёл далеко за красный костёл и уже не останавливался."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5df62f82-32b6-4693-bdbb-3395389509a2",
                        "source_entry_id": "65af299e-90f6-3339-a324-faaa873af6e2",
                        "source_sense_id": "249a9a11-875b-36a4-9c8e-032afaecc96b",
                        "target_lang_word": "kościół",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kościół",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe220b1-e324-3a44-a8dd-ca4f523d2d97",
                                        "entry_id": "3b2fa844-42ee-3b26-a678-2c451d352bf3",
                                        "glosses": [
                                            "świątynia chrześcijańska"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80369e4a-fb1c-4c25-a20e-6fd409620b00",
                                                "sense_id": "2fe220b1-e324-3a44-a8dd-ca4f523d2d97",
                                                "text": "Pierwszej niedzieli po tym wypadku pomyślałam, że prędzej czy później odkryto by u mnie pierścień, będąc więc w kościele udałam, że znalazłam go pod nogami, i pokazałam mojej matce, która orzekła, że jest to bez wątpienia kawałek szkła, oprawny w tombak; zaleciła mi jednak, abym go schowała do kieszeni."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ad1861da-fabb-3759-b3c2-a825473c5d8d",
                                        "entry_id": "3b2fa844-42ee-3b26-a678-2c451d352bf3",
                                        "glosses": [
                                            "czas nabożeństwa"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6303d0b9-b76d-4b2e-bbc4-36fef2286e68",
                                                "sense_id": "ad1861da-fabb-3759-b3c2-a825473c5d8d",
                                                "text": "Zobaczę się z nią po kościele."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "339da58d-427a-4822-8892-bb16888c65eb",
                        "source_entry_id": "65af299e-90f6-3339-a324-faaa873af6e2",
                        "source_sense_id": "249a9a11-875b-36a4-9c8e-032afaecc96b",
                        "target_lang_word": "kostel",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kostel",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9b047ad0-f6f8-3b4e-aeec-83cf0f402c4f",
                                        "entry_id": "d64fc01e-07ab-3f98-a930-8e50c53740f5",
                                        "glosses": [
                                            "křesťanský chrám"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2b13bb-0a8e-43cc-bbf2-e6693f789806",
                                                "sense_id": "9b047ad0-f6f8-3b4e-aeec-83cf0f402c4f",
                                                "text": "V našem městě je krásný gotický kostel."
                                            },
                                            {
                                                "example_id": "2a761b28-ae44-4168-845c-b64b83d579b0",
                                                "sense_id": "9b047ad0-f6f8-3b4e-aeec-83cf0f402c4f",
                                                "text": "Náš soused chodil do kostela (účastnil se bohoslužeb) celý život."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be175320-a59e-35d1-87c0-9d1854a097bf",
                                        "entry_id": "d64fc01e-07ab-3f98-a930-8e50c53740f5",
                                        "glosses": [
                                            "(staročesky) církev"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3d8f444-dedf-378f-b3cc-adc9a73d98bc",
                                        "entry_id": "d64fc01e-07ab-3f98-a930-8e50c53740f5",
                                        "glosses": [
                                            "(staročesky) diecéze"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb87e542-59a7-45d6-8790-d0ad5b05cbfa",
                                                "sense_id": "b3d8f444-dedf-378f-b3cc-adc9a73d98bc",
                                                "text": "Následné punkty se hlásily k zajištění a stvrzování práv kolínského kostela, jemuž se měla v případě volebního zdaru postoupit řada hradů a pevností, výnosů z cel i jiných požitků."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
