                    "semantic_group_id": "okoliczność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taka dobra <w>zręczność</w> na tani zakup mieszkania może się już nie powtórzyć.",
                            "target_lang_translations": {
                                "ru": "Такой удачный <w>случай</w> купить дешёвую квартиру может больше не представиться."
                            }
                        },
                        {
                            "text": "Czekał na odpowiednią <w>zręczność</w>, by porozmawiać o podwyżce.",
                            "target_lang_translations": {
                                "ru": "Он ждал подходящего <w>случая</w>, чтобы поговорить о прибавке."
                            }
                        }
