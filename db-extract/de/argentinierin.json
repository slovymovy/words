                "senses": [
                    {
                        "sense_id": "307ea06d-c7b7-307d-8f8a-133585977604",
                        "entry_id": "9731707e-0759-3003-9b6d-994952cb36b3",
                        "glosses": [
                            "Staatsbürgerin von Argentinien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3808a5-b106-41e2-b00f-3a0fdb421b25",
                                "sense_id": "307ea06d-c7b7-307d-8f8a-133585977604",
                                "text": "„Der deutsche Privatfahrer Mirco Schultis und sein Schweizer Beifahrer Ulrich Leardi waren auf der ersten Etappe mit ihrem Auto von der Strecke abgekommen und hatten die Argentinierin erfasst, die später ihren Verletzungen erlag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06bceccb-528e-4460-8f9f-b71d6faac699",
