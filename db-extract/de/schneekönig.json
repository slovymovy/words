                "senses": [
                    {
                        "sense_id": "c9c6308b-458a-3bf4-92b1-4148fff4b7f6",
                        "entry_id": "defb788b-84c3-3dac-9f49-da5baa9e3a05",
                        "glosses": [
                            "anderer Name für den Zaunkönig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4735b21c-9e1b-42db-aa9f-3d8a98038f81",
                                "sense_id": "c9c6308b-458a-3bf4-92b1-4148fff4b7f6",
                                "text": "Der Schneekönig wird auch mancherorts der Winterkönig genannt."
                            },
                            {
                                "example_id": "74ee084a-2378-48ad-80ad-9c680291c26f",
                                "sense_id": "c9c6308b-458a-3bf4-92b1-4148fff4b7f6",
                                "text": "„Der Schneekönig flog über das Land und hatte eine riesige Menge Schneeflocken mitgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe705c16-fb8c-3dc4-aebf-40cb10d9afae",
                        "entry_id": "defb788b-84c3-3dac-9f49-da5baa9e3a05",
                        "glosses": [
                            "Spottname für König Gustav Adolf von Schweden"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "314cef38-843a-4f0e-8727-7a4730fd5166",
                                "sense_id": "fe705c16-fb8c-3dc4-aebf-40cb10d9afae",
                                "text": "„Am 4. Juli 1630 landete der Schneekönig – so wurde Adolf von seinen Gegnern genannt – mit einem Heere von 15,000 Schweden auf der Insel Usedom.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
