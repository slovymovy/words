                        "glosses": [
                            "Qui pétarade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf614d2-e892-483f-a09e-9c66b505140f",
                                "sense_id": "17118fd0-453b-3401-ae3c-8c2a133aa072",
                                "text": "Henri eut un petit rire. Il se souvint tout à coup d'une vieille chronique où il avait, pour flétrir, stigmatiser, juvénaliser les comportements bourgeois, accumulé des bataillons d'imprécations pétaradantes, de prosopopées incendiaires, d'antithèses fulgurantes, […]."
                            },
                            {
                                "example_id": "46e637a1-459d-4612-8a02-22e073cf5e66",
                                "sense_id": "17118fd0-453b-3401-ae3c-8c2a133aa072",
                                "text": "Une panoplie pétaradante à 22 millions d’euros, destinée à équiper CRS, gendarmes mobiles et compagnies d’intervention de la sécurité publique."
                            }
                        ]
                    }
