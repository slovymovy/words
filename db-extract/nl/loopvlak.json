                "senses": [
                    {
                        "sense_id": "13f6a484-1b5f-32d2-86cb-9793a18c4e7b",
                        "entry_id": "3e60d002-3390-381e-be97-698e906e6bfc",
                        "glosses": [
                            "het gedeelte van een voet, wiel, slee etc. dat met de ondergrond in aanraking is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3fd5372-ea66-49d6-9d47-678f104cb83e",
                                "sense_id": "13f6a484-1b5f-32d2-86cb-9793a18c4e7b",
                                "text": "Het loopvlak is scheef afgesleten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a820468-f4df-4a16-b173-67a4de801cfd",
                        "source_entry_id": "3e60d002-3390-381e-be97-698e906e6bfc",
                        "source_sense_id": "13f6a484-1b5f-32d2-86cb-9793a18c4e7b",
                        "source_sense_description": "bovenzijde van een voetzool",
                        "target_lang_word": "Lauffläche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lauffläche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3dc8261-2002-32aa-9f99-a600b89463d5",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "äußerste Belagschicht eines Reifens eines Automobils, Motorrads, Fahrrads oder Flugzeugs, der mit der Fahrbahn beziehungsweise Rollbahn in Berührung kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fecdfbc4-b907-46b5-96d1-0cb896502c6b",
                                                "sense_id": "c3dc8261-2002-32aa-9f99-a600b89463d5",
                                                "text": "Bei Aquaplaning berührt die Lauffläche des Reifens den Boden nicht mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38555343-140c-3c91-a624-0d45b7be4458",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "äußere Schicht eines Rades eines Schienenfahrzeugs, der mit der Schiene in Berührung kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f83fab3-62f5-4d02-b9a9-1a9aa44e923b",
                                                "sense_id": "38555343-140c-3c91-a624-0d45b7be4458",
                                                "text": "Fettverschmutzungen auf der Lauffläche können bei Triebrädern zum Schleudern („Durchdrehen“) beim Anfahren bzw. zum Gleiten („Blockieren“) beim Bremsen führen und Flachstellen am Rad sowie Schleuderstellen (Ausfräsungen) in der Schiene verursachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "52368047-a989-3a6d-95a4-84122e3a728d",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Sohle eines Schuhs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f77e7c6-11fe-4df3-9f3a-a97a2cda0d2a",
                                                "sense_id": "52368047-a989-3a6d-95a4-84122e3a728d",
                                                "text": "Die Schuhsohle ist die allgemeinsprachliche Bezeichnung für die Lauffläche eines Schuhs, also den unteren Teil des Schuhbodens, der sich in direktem Kontakt zum Untergrund befindet, und den der Fachmann Laufsohle oder Außensohle nennt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7fbd65e0-814f-3ace-8749-43ce97f1f2e4",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Innenfläche des Zylindermantels eines Hamsterrads"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5abc2f8-68e3-4faa-815a-87664f39da77",
                                                "sense_id": "7fbd65e0-814f-3ace-8749-43ce97f1f2e4",
                                                "text": "Die Lauffläche eines Drahtlaufrads wird als tierschutzwidrig eingestuft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9fe0c76d-1352-3bd0-9ca7-e986aee876b9",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Oberfläche einer aus Asphalt, Holz oder Kunststoff bestehenden Bahn beim Kegeln oder Bowling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7bc2257-1e5d-48c6-bfea-3197e244a621",
                                                "sense_id": "9fe0c76d-1352-3bd0-9ca7-e986aee876b9",
                                                "text": "In den letzten zwei Jahrzehnten hat sich die Ölung der Lauffläche der Bahn zu einer unverzichtbaren Komponente des Bowlingsports entwickelt,"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "69106284-2a30-35ab-9c80-7f252aa40378",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Zylinderlaufbuchse für den Kolben eines Zylinders eines Hubkolbenmotors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851789e7-5f21-451e-b256-f1f63fae5747",
                                                "sense_id": "69106284-2a30-35ab-9c80-7f252aa40378",
                                                "text": "Der Kolben läuft nicht immer direkt im Motorblockmaterial, weil dieses Material höhere tribologische Ansprüche nicht erfüllt und auch der Austausch von Kolben und Zylinder als Hauptverschleissteile sich erheblich komplizierter gestaltet. Deshalb wird oft eine Zylinderlaufbuchse als Lauffläche eingebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "a62d6a45-c322-3ee9-a2b9-43ee34988df2",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Unterseite eines Skis, Snowboards oder Schlittens, der mit Schnee oder Kunstschnee in Berührung kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d5dd1c-718a-4d08-acbb-08c00166cf87",
                                                "sense_id": "a62d6a45-c322-3ee9-a2b9-43ee34988df2",
                                                "text": "Für die Lauffläche von Skiern und Snowboards werden gesinterte ultrahochmolekulargewichtige Polyethylene oder normale extrudierte Polyethylene als Skibelag verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "ae694146-11f0-3f9e-b306-942b8d56ab62",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "Berührungsfläche einer Schlittschuhkufe mit dem Eis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3fea0c-faad-41ee-9290-ce2e68ea084d",
                                                "sense_id": "ae694146-11f0-3f9e-b306-942b8d56ab62",
                                                "text": "Die Lauffläche hat einen Planschliff mit einer schwachen Krümmung in Längsrichtung, die ein „Eingraben“ der Kufe in das Eis verhindern soll."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "c6fc108f-1dc9-3af1-a60f-925d1cc275c7",
                                        "entry_id": "e49f0b7e-a8f6-3c60-8cbd-081cc5729881",
                                        "glosses": [
                                            "allgemein: Untergrund, auf dem sich Menschen oder Tiere fortbewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8e778d-61a5-4120-a37f-ffb781a9f84e",
                                                "sense_id": "c6fc108f-1dc9-3af1-a60f-925d1cc275c7",
                                                "text": "Ein Ausstattungsmerkmal, das ein Laufband für Senioren besonders sicher und einfach macht, ist eine möglichst große Lauffläche."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "601904dc-e690-4c29-93da-5d9ca3b008a1",
                        "source_entry_id": "3e60d002-3390-381e-be97-698e906e6bfc",
                        "source_sense_id": "13f6a484-1b5f-32d2-86cb-9793a18c4e7b",
                        "source_sense_description": "bovenzijde van een voetzool",
                        "target_lang_word": "tread",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To step or walk (on or across something); to trample."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35540dc3-87b2-444b-abe8-e8ece911c25a",
                                                "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                                "text": "He trod back and forth wearily."
                                            },
                                            {
                                                "example_id": "1a84a7ee-8f21-486a-ab77-0e7c2d07e6ff",
                                                "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                                "text": "Don't tread on the lawn."
                                            },
                                            {
                                                "example_id": "79e7647f-36b3-4b65-96ea-7f0e399b370f",
                                                "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                                "text": "And Moses sware on that day, saying, Surely the land whereon thy feet haue troden, shall be thine inheritance, and thy childrens for euer, because thou hast wholly followed the Lord my God."
                                            },
                                            {
                                                "example_id": "56905803-4713-4667-aa60-cb2df9142488",
                                                "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                                "text": "Fools rush in where angels fear to tread."
                                            },
                                            {
                                                "example_id": "75f7e9ea-6f55-4ea6-81f9-737d1f6622a4",
                                                "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                                                "text": "yee that walk The Earth, and stately tread, or lowly creep"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da007e65-6905-36b0-a067-96b67c96c43b",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To step or walk upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d8c6c39-6593-4f71-bbd8-bb3855373769",
                                                "sense_id": "da007e65-6905-36b0-a067-96b67c96c43b",
                                                "text": "Actors tread the boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a771cbf5-d4a6-3bbb-951f-f212ee4d41c4",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To proceed, to behave (in a certain manner)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae0fe073-fd40-4f3a-99a6-6fc901263b8f",
                                                "sense_id": "a771cbf5-d4a6-3bbb-951f-f212ee4d41c4",
                                                "text": "to tread lightly, to tread gently"
                                            },
                                            {
                                                "example_id": "a737779e-136d-437a-986c-e62fb3ffbfb8",
                                                "sense_id": "a771cbf5-d4a6-3bbb-951f-f212ee4d41c4",
                                                "text": "to tread carefully, to tread cautiously, to tread warily"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bfcbb99-d228-318c-a6f8-7b588eb9932d",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To beat or press with the feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc19b7a4-6fe2-41bd-89f6-12c347e9218d",
                                                "sense_id": "0bfcbb99-d228-318c-a6f8-7b588eb9932d",
                                                "text": "to tread a path; to tread land when too light; a well-trodden path"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d582bf-595c-3ded-8d2f-64e02aceadaf",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To work a lever, treadle, etc., with the foot or the feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972472fc-048a-46ef-acce-909446f515b7",
                                                "sense_id": "a6d582bf-595c-3ded-8d2f-64e02aceadaf",
                                                "text": "Round about them was a circle of girls and wives of the neighbouring tenants; \"they trod the spinning-wheels with diligent feet, or were using the scraping carding-combs,\" as an author has it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e77f007-45a9-35f9-b777-1dead3856a8a",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To go through or accomplish by walking, dancing, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995c2433-3ec0-4184-a3b4-afec737776c2",
                                                "sense_id": "4e77f007-45a9-35f9-b777-1dead3856a8a",
                                                "text": "I am resolved to forsake Malta, tread a pilgrimage to fair Jerusalem."
                                            },
                                            {
                                                "example_id": "2300c1b7-7160-43dd-922f-e54769ccf0ac",
                                                "sense_id": "4e77f007-45a9-35f9-b777-1dead3856a8a",
                                                "text": "They have measured many a mile, / To tread a measure with you on this grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7087e2-c238-3dbb-a7b2-076c5b0f07b3",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To crush under the foot; to trample in contempt or hatred; to subdue; to repress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63363d6f-54be-4fe7-b180-0a63d617deb9",
                                                "sense_id": "9c7087e2-c238-3dbb-a7b2-076c5b0f07b3",
                                                "text": "Through thee will we push down our enemies: through thy name will we tread them under that rise up against us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bfb10d3-7c95-389a-8176-75cb9455c948",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To copulate; said of (especially male) birds."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2ea37f-6717-41dc-bb7b-8c6217507fd4",
                                                "sense_id": "4bfb10d3-7c95-389a-8176-75cb9455c948",
                                                "text": "When Turtles tread, and Rookes and Dawes,\nAnd Maidens bleach their summer smockes:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5232dcdf-6c28-3a73-8312-db4fc1a92ffb",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To copulate with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb0a89bc-c19f-4c3a-8d87-1b17fa80d274",
                                                "sense_id": "5232dcdf-6c28-3a73-8312-db4fc1a92ffb",
                                                "text": "Thus, a poultry-breeder describes a hen (colored Dorking) crowing like a cock, only somewhat more harshly, as a cockerel crows, and with an enormous comb, larger than is ever seen in the male. This bird used to try to tread her fellow-hens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e85b1e-6fae-3323-937c-92ffb19de9ce",
                                        "entry_id": "10258946-9ecf-372f-9857-13095505e8cd",
                                        "glosses": [
                                            "To crush grapes with one's feet to make wine"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "823f8abd-4fd7-33fe-af0d-4782cf46f1e2",
                                        "entry_id": "5ad801d0-dd5c-329b-8042-3c31499c4248",
                                        "glosses": [
                                            "A step taken with the foot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74999a55-318b-3a28-9327-4e4671899ca7",
                                        "entry_id": "5ad801d0-dd5c-329b-8042-3c31499c4248",
                                        "glosses": [
                                            "A manner of stepping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959396a5-97b6-4ee6-af65-f68f384e7f64",
                                                "sense_id": "74999a55-318b-3a28-9327-4e4671899ca7",
                                                "text": "She is coming, my own, my sweet; / Were it ever so airy a tread, / My heart would hear her and beat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c036aaf9-84f7-3985-9aec-98ede3e0a932",
                                        "entry_id": "5ad801d0-dd5c-329b-8042-3c31499c4248",
                                        "glosses": [
                                            "The sound made when someone or something is walking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac29cd4a-c45d-40ca-bd6c-581788eee200",
                                                "sense_id": "c036aaf9-84f7-3985-9aec-98ede3e0a932",
                                                "text": "The steps fell lightly and oddly, with a certain swing, for all they went so slowly; it was different indeed from the heavy creaking tread of Henry Jekyll. Utterson sighed. \"Is there never anything else?\" he asked."
                                            },
                                            {
                                                "example_id": "9df191f1-56a1-4a10-9ace-b446a2aa29ff",
                                                "sense_id": "c036aaf9-84f7-3985-9aec-98ede3e0a932",
                                                "text": "But when, after a singularly heavy tread and the jingle of spurs on the platform, the door flew open to the newcomer, he seemed a realization of our worst expectations."
                                            },
                                            {
                                                "example_id": "62c457e1-f7a7-49bd-86f5-8d621f938025",
                                                "sense_id": "c036aaf9-84f7-3985-9aec-98ede3e0a932",
                                                "text": "As we stood waiting for the departure time with the setting sun twinkling on the great brass dome of our 2-4-0, the sound of church bells was the only one apart from the measured tread of the guard slowly pacing towards his van, and, standing at an open window, I more than once heard the fireman's \"Right away!\" to his mate in acknowledgement of a desultory wave of the unfurled green flag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564dfdb9-5c62-3cb1-a5dd-abf76bc8863e",
                                        "entry_id": "5ad801d0-dd5c-329b-8042-3c31499c4248",
                                        "glosses": [
                                            "A way; a track or path."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
