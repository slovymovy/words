                "senses": [
                    {
                        "sense_id": "4cecf260-0a31-3fb5-8cd0-b0fb92124534",
                        "entry_id": "43d4a61b-9b8a-3f41-82e2-2e0f3313a909",
                        "glosses": [
                            "To untie the sash that holds an article of clothing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc5f869-1462-414d-a51a-23215d05b484",
                                "sense_id": "4cecf260-0a31-3fb5-8cd0-b0fb92124534",
                                "text": "I know how to make her run mad with passion that has nothing to do with books and animals. I know how to make her unpin her hair, unsash her gown, unhook — But he hadn't said a word, only allowed the devil's own smile to lift one corner of his mouth."
                            },
                            {
                                "example_id": "89a21b32-25a2-408e-9519-b31f9ec96581",
                                "sense_id": "4cecf260-0a31-3fb5-8cd0-b0fb92124534",
                                "text": "She watched him walk to the bed set on its foot-high dais, watched him walk in his bare feet, big feet that were really quite beautiful, watched him pull the covers back, unsash the dressing gown, shrug it off, and naked as a black-haired god, climb into the bed."
                            },
                            {
                                "example_id": "73f753ce-7dbb-4364-9e9a-0540d49e00fa",
                                "sense_id": "4cecf260-0a31-3fb5-8cd0-b0fb92124534",
                                "text": "But though she felt curious about the toys Ron had phoned to tell her he was bringing, she wished she could open the front door to Dirk and unsash her robe for him."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e6bedfc-b203-31ca-ba27-8ba7a0a47a3c",
                        "entry_id": "43d4a61b-9b8a-3f41-82e2-2e0f3313a909",
                        "glosses": [
                            "To remove or release a sash from."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9b4cf6-bf5b-4b0e-a583-31550d08632a",
                                "sense_id": "0e6bedfc-b203-31ca-ba27-8ba7a0a47a3c",
                                "text": "My job was to perform the Sashing Ceremony on the banks of the Esk. I should unsash the Honest Lad and Lass of 1953 with thanks for their services and then I should charge and sash the Honest Lad and Lass of 1954."
                            },
                            {
                                "example_id": "3150c120-7d32-45c8-b5f0-1b42bf3af86d",
                                "sense_id": "0e6bedfc-b203-31ca-ba27-8ba7a0a47a3c",
                                "text": "First, close the doors, unsash the curtains, turn off all the lights but the glass lamp."
                            },
                            {
                                "example_id": "224f76d2-7b97-48e7-b5fe-539b2ded1fd6",
                                "sense_id": "0e6bedfc-b203-31ca-ba27-8ba7a0a47a3c",
                                "text": "\"Shall I unsash the curtain, sir?\" the boy asked, bowing meekly to Tarrington."
                            }
                        ]
                    },
