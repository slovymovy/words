                ],
                "senses": [
                    {
                        "sense_id": "adcd2cfb-3a8d-38b8-9eeb-c84068274de1",
                        "entry_id": "13ba992f-c5a0-37d6-92b5-3876a84ced3b",
                        "glosses": [
                            "Personne stupide, désagréable ou mauvaise à force de bêtise."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0b69f3f3-19bd-474a-9f59-2d25f6a3946e",
                                "sense_id": "adcd2cfb-3a8d-38b8-9eeb-c84068274de1",
                                "text": "Ce qui me rend malade ce n'est pas que tu puises te taper cette guenon, mais qu’un looser de ton espèce puisse ainsi me prendre pour une conne en draguant sans retenue n'importe quoi."
                            },
                            {
                                "example_id": "34bfa1c4-4a7f-4731-aa07-0c34a5a23363",
                                "sense_id": "adcd2cfb-3a8d-38b8-9eeb-c84068274de1",
                                "text": "La souris gris’ se fâche et subito presto,\nEntre la rue Didot et la rue de Vanves,\nLa conne, la méchante,\nVa d’mander ma tête à ses p’tits poteaux,\nEntre la rue de Vanv’s et la rue Didot."
                            },
                            {
                                "example_id": "4ad82655-ecd7-4653-81ea-a13a6436ba50",
                                "sense_id": "adcd2cfb-3a8d-38b8-9eeb-c84068274de1",
                                "text": "– Avec qui s’est-il remarié ?\n– Une Suisse allemande, une conne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
