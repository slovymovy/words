                                                "example_id": "38c0cc41-5e24-408e-8349-3d0e3be9bd52",
                                                "sense_id": "f65d7d90-3765-3701-a3a7-7747d445b1b7",
                                                "text": "On milczał, szczyptę wziętą z tabakiery ważył / W palcach i długo dumał, nim ją w końcu zażył"
                                            }
                                        ],
