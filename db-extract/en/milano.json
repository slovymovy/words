                            {
                                "example_id": "73de4b77-75b7-4ab1-90f9-e8ddf1e9c42c",
                                "sense_id": "b8a52125-653f-39e8-be5e-1885fb4c5093",
                                "text": "Folko was not displeased to find that the ladies felt anxious to see beautiful Milano, and to leave Genoa on the morrow, as the autumnal gales were beginning to blow bleakly from the sea."
                            },
                            {
                                "example_id": "8f3f0594-e108-4fba-b144-87a3bc73ec01",
                                "sense_id": "b8a52125-653f-39e8-be5e-1885fb4c5093",
                                "text": "The need to be competent is made extreme in a town like Milano, Italy, which can be compared, in management terms, to a huge company."
                            },
                            {
                                "example_id": "10ec69e6-9902-4800-a30e-45c01fb93a19",
                                "sense_id": "b8a52125-653f-39e8-be5e-1885fb4c5093",
                                "text": "After admiring Milano’s skyline, he was hungry and tired from his flights. He wheeled his suitcase across the piazza, focusing on his reason for being in Milano: to track Chiara, who he thought would lead him to her father."
                            }
                        ]
                    },
