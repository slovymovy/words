                ],
                "senses": [
                    {
                        "sense_id": "161e479a-aeae-3d9c-b153-ba8636c9c61b",
                        "entry_id": "4308c495-3ab8-3657-ab07-5d3bdc954be9",
                        "glosses": [
                            "Mouvoir par un muscle adducteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c115bd-74f0-4800-b347-ce2a0a063cfa",
                                "sense_id": "161e479a-aeae-3d9c-b153-ba8636c9c61b",
                                "text": "Ensuite, le patient adducte le bras de 10° et fait une RM de l'humérus. L'examinateur exerce une force dirigée vers le bas, et le patient résiste."
                            },
                            {
                                "example_id": "a3242c99-cf4c-4db3-b3ae-8f76a3b5cc1b",
                                "sense_id": "161e479a-aeae-3d9c-b153-ba8636c9c61b",
                                "text": "Le patient adducte le bras relevé contre résistance. Le corps musculaire peut être observé et senti (flèche)."
                            },
                            {
                                "example_id": "8190c4f0-b6c3-43f7-b2e4-fa08b299bb66",
                                "sense_id": "161e479a-aeae-3d9c-b153-ba8636c9c61b",
                                "text": "Action : il stabilise, élève, adducte et fait une sonnette latérale de la scapula. Il fait une inclinaison de la tête et du cou."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e3772a8-e71a-390d-8b1f-bc799702a29e",
                        "entry_id": "4308c495-3ab8-3657-ab07-5d3bdc954be9",
                        "glosses": [
                            "Distribuer par adduction, en parlant de l'eau."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3368be40-5e3b-4ffe-9e73-7e83c4010708",
                                "sense_id": "9e3772a8-e71a-390d-8b1f-bc799702a29e",
                                "text": "Il finirait par être assez malfaisant pour adducter l'eau jusque dans les fermes les plus retirées !"
                            },
                            {
                                "example_id": "727fc20f-a8ca-469e-8b46-266f67cc6139",
                                "sense_id": "9e3772a8-e71a-390d-8b1f-bc799702a29e",
                                "text": "Dans les prévisions pour évaluer le volume d’eau à adducter et à distribuer dans la commune de Tunis à la fin du XIXe siècle, le mode de calcul est intéressant à relever."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d598860-b003-39fc-99fb-169871d22878",
                        "entry_id": "4308c495-3ab8-3657-ab07-5d3bdc954be9",
                        "glosses": [
                            "Amener à soi."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e1afe088-4b19-4455-be8d-f70b5d108a97",
                                "sense_id": "2d598860-b003-39fc-99fb-169871d22878",
                                "text": "J'ai, peu à peu, grisé par les succès du début, par l'argent si facile à adducter, perdu pied."
                            }
                        ]
                    }
                ],
