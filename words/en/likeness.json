{
    "word_family": [
        "like",
        "likely",
        "liken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97f3ca23-7081-3b59-92ae-7ddd962777ba",
                    "sense_definition": "The state or quality of being similar to someone or something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a striking <w>likeness</w> between the two sisters.",
                            "target_lang_translations": {
                                "zh": "这对姐妹之间有着惊人的<w>相似</w>。"
                            }
                        },
                        {
                            "text": "The <w>likeness</w> in their personalities is quite remarkable.",
                            "target_lang_translations": {
                                "zh": "她们性格上的<w>相似</w>非常引人注目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resemblance",
                        "similarity"
                    ],
                    "common_phrases": [
                        "bear a likeness"
                    ],
                    "target_lang_definitions": {
                        "zh": "人或事物之间相似的状态或性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相似",
                                "target_lang_sense_clarification": "指人或事物在特征、外貌等方面的相像。"
                            },
                            {
                                "target_lang_word": "相像",
                                "target_lang_sense_clarification": "指外表或性质上的类似。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbc9328-cc78-3fbe-bb31-aaddd97bc801",
                    "sense_definition": "A portrait or representation of a person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a perfect <w>likeness</w> of the queen.",
                            "target_lang_translations": {
                                "zh": "这位艺术家画了一幅完美的女王<w>肖像</w>。"
                            }
                        },
                        {
                            "text": "The museum displays a <w>likeness</w> of the famous explorer.",
                            "target_lang_translations": {
                                "zh": "博物馆里陈列着那位著名探险家的<w>肖像</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capture a likeness"
                    ],
                    "target_lang_definitions": {
                        "zh": "人物的肖像或描绘。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肖像",
                                "target_lang_sense_clarification": "指人物的画像或雕像。"
                            },
                            {
                                "target_lang_word": "画像",
                                "target_lang_sense_clarification": "指描绘人物形象的画作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe47b65f-4747-3372-bbee-b0195b9f6360",
                    "sense_definition": "The outward appearance or form of someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stranger appeared in the <w>likeness</w> of a weary traveler.",
                            "target_lang_translations": {
                                "zh": "那个陌生人以一位疲惫旅人的<w>形象</w>出现。"
                            }
                        },
                        {
                            "text": "He assumed the <w>likeness</w> of a ghost to scare the children.",
                            "target_lang_translations": {
                                "zh": "他装扮成鬼魂的<w>形象</w>来吓唬孩子们。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "某人或某物的外在形象或形态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "外貌",
                                "target_lang_sense_clarification": "指人或事物表现出来的外在样子。"
                            },
                            {
                                "target_lang_word": "形象",
                                "target_lang_sense_clarification": "指呈现出的样子或形态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f92b2ac3-53c5-3149-96d6-1afdec4e44d8",
                    "sense_definition": "To create a visual representation or portrait of someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter <w>likenessed</w> the king with great detail.",
                            "target_lang_translations": {
                                "zh": "画家极其细致地<w>描绘</w>了国王的形象。"
                            }
                        },
                        {
                            "text": "She was <w>likenessed</w> in a beautiful oil painting.",
                            "target_lang_translations": {
                                "zh": "她被<w>刻画</w>在一幅精美的油画中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is rare and considered dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为某人创作视觉肖像或描绘其形象。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "描绘",
                                "target_lang_sense_clarification": "指用绘画或文字表现人物形象。"
                            },
                            {
                                "target_lang_word": "刻画",
                                "target_lang_sense_clarification": "指通过艺术手段表现人物的形象。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}