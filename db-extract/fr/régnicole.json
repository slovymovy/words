                ],
                "senses": [
                    {
                        "sense_id": "71372515-059d-328a-a4ed-f550a54cd64b",
                        "entry_id": "4ee2ad2b-fee1-3796-aaa6-2894cb1a3777",
                        "glosses": [
                            "Qualifiait ceux des habitants d’un pays qui en ont la nationalité."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8dc1f90b-0962-45aa-b9a3-6e53acd7ab13",
                                "sense_id": "71372515-059d-328a-a4ed-f550a54cd64b",
                                "text": "Cette qualité de régnicole est opposée à celle d’aubain ou d’étranger."
                            },
                            {
                                "example_id": "c225dead-6513-4ba2-a421-f5e794d398a5",
                                "sense_id": "71372515-059d-328a-a4ed-f550a54cd64b",
                                "text": "Quand les juifs de Bordeaux obtinrent les lettres patentes de 1723, ils estimèrent qu’en tant que régnicoles, ils n’étaient pas soumis aux mêmes restrictions que les juifs étrangers […]."
                            },
                            {
                                "example_id": "26b26855-3270-45b9-bbd8-1c3c7fe06498",
                                "sense_id": "71372515-059d-328a-a4ed-f550a54cd64b",
                                "text": "Ceux [les artistes] qui ne furent point académifiés, on les subventionna, même s’ils étaient peu “réguliers”, même s’ils n’étaient point régnicoles."
                            },
                            {
                                "example_id": "0ea51f61-bee7-4e30-b62b-4f10ad3c8a4c",
                                "sense_id": "71372515-059d-328a-a4ed-f550a54cd64b",
                                "text": "Les indigènes étant considérés comme des régnicoles, sujets de la France, et devant conserver leur statut réel et personnel, on s'est demandé quel était le meilleur mode d'administration à leur donner."
                            }
                        ]
                    }
