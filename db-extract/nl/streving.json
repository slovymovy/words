                "senses": [
                    {
                        "sense_id": "955c91df-7df5-3dcb-97ba-3487e5700e46",
                        "entry_id": "734ca283-a39a-35ac-8059-7d28771915d1",
                        "glosses": [
                            "dat wat men wil bereiken; het streven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b6b278-2d3c-4107-a6bd-6a2b794059f2",
                                "sense_id": "955c91df-7df5-3dcb-97ba-3487e5700e46",
                                "text": "Bijna alle gedachten gaan immers over jezelf in relatie tot bepaalde verlangens, angsten en strevingen. De man die een aantrekkelijke vrouwelijke collega mentaal uitkleedt tijdens een vergadering is aan het dagdromen, evenals de vrouw die tijdens een ongeïnspireerde vrijpartij met haar vriend een boodschappenlijstje voor de volgende dag componeert."
                            },
                            {
                                "example_id": "27f27fe3-9e01-43dc-ad3f-d1c582a7d193",
                                "sense_id": "955c91df-7df5-3dcb-97ba-3487e5700e46",
                                "text": "Zelf ben ik alweer meer dan twintig jaar geleden ook op huwelijkse voorwaarden getrouwd, dus ik zou de wetswijziging moeten toejuichen. Toch doe ik dat niet, want onze beslissing destijds om de voorwaarden te nemen en niet de gemeenschap had niets te maken met emancipatoire strevingen mijnerzijds, maar met elkaar uit de wind houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2088b4b-e15d-41b8-8bb0-8b00176f0719",
                        "source_entry_id": "734ca283-a39a-35ac-8059-7d28771915d1",
                        "source_sense_id": "955c91df-7df5-3dcb-97ba-3487e5700e46",
                        "source_sense_description": "dat wat men wil bereiken; het streven",
                        "target_lang_word": "conation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                        "entry_id": "a462ebcf-37fc-3398-a646-2fda5c66f6f0",
                                        "glosses": [
                                            "The power or act which directs or impels to effort of any kind, whether muscular or psychical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48210175-9bbb-4612-abd1-cc1366e7b830",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "Any pleasing sense-experience, when it has once taken place, will, on subsequent occasions, give rise to a conation, when its conditions are only partially repeated..."
                                            },
                                            {
                                                "example_id": "57a576f1-64ee-45ff-8542-13afc02dfb99",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "You can sit quiet and hear the processes going on, going about their business; volition, desire, will, cognition, passion, conation."
                                            },
                                            {
                                                "example_id": "fcada7f1-035b-4f01-9ff1-a458a3a78dc6",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "[The] 'purposive conscious striving' aspect of conation is very likely a concept we need to treat separately if we are to study human motivation successfully […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
