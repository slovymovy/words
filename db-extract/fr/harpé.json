                "senses": [
                    {
                        "sense_id": "26ed6002-d829-3001-83a6-f06e7c591e7f",
                        "entry_id": "62995e53-a9b8-3ae8-b56d-7826ac67fd03",
                        "glosses": [
                            "Qualifie un chien dont la silhouette rappelle la forme d'une harpe."
                        ],
                        "tags": [],
                        "note": "Se dit particulièrement des lévriers",
                        "examples": [
                            {
                                "example_id": "0491efb8-ff78-45c4-b8e9-8ee396157c70",
                                "sense_id": "26ed6002-d829-3001-83a6-f06e7c591e7f",
                                "text": "Puis encore les lévriers charnaigres, qui bondissent; les lévriers harpés, sans ventre; les lévriers nobles, au râble large; les lévriers gigotés, aux os éloignés; les lévriers nobles, de longue encolure; les lévriers œuvres, au palais noir; […]."
                            }
                        ]
                    }
                ],
