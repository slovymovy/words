                                "target_senses": [
                                    {
                                        "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                        "entry_id": "e81d26d6-f6d8-3836-b32e-63355b67167f",
                                        "glosses": [
                                            "Junge oder Mädchen etwa im Alter zwischen 13 und 19 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15606abe-76b2-4c0e-a488-6f0330af86a0",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "Lisa ist ein Teenager."
                                            },
                                            {
                                                "example_id": "0c9afce0-4699-49a8-8804-c675f79f95ae",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Im siebten öffnete sich die Tür, ohne daß jemand aussteigen wollte, und im elften standen drei kichernde, aber sehr hübsche Teenager vor dem Lift, die dann nicht einsteigen wollten.“"
                                            },
                                            {
                                                "example_id": "8c8b623e-85bc-4b1f-9969-4b2d86f7df69",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Horst Eckert, ein Teenager ohne Abitur und mit nicht abgeschlossener Lehre als Schlosser, wird in Oldenburg Arbeit in der Baumwollspinnerei von Ripken finden, als Maschinenreiniger.“"
                                            },
                                            {
                                                "example_id": "345453dc-8c15-425d-b8fd-8ca34b159b61",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Andere Erzählungen zeigen Klein-Erna als Teenager oder als Frau und junge Mutter, so daß praktisch alle Arten von Witzen auf sie übertragen werden können.“"
                                            },
                                            {
                                                "example_id": "e2190439-ff57-448d-86ea-cc04bb861f78",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Vor wenigen Jahren verschied nach längerem seelischen Leiden sanft der Backfisch, und es begann der Einmarsch der Teenager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5dbf4e4-0ea1-4d44-b208-e10bdcf47110",
                        "source_entry_id": "edc7f51a-71ae-3f1d-87b2-20334b2604b6",
