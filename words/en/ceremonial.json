{
    "word_family": [
        "ceremony",
        "ceremonious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                    "sense_definition": "Relating to or used in a formal religious or public ceremony.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest performed the <w>ceremonial</w> rites of marriage in front of the guests.",
                            "target_lang_translations": {
                                "zh": "牧师在宾客面前主持了婚礼的<w>仪式性</w>礼节。"
                            }
                        },
                        {
                            "text": "The president arrived in a <w>ceremonial</w> car for the national holiday parade.",
                            "target_lang_translations": {
                                "zh": "总统乘坐<w>礼仪</w>用车抵达国庆游行现场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ritual"
                    ],
                    "common_phrases": [
                        "ceremonial rites",
                        "ceremonial car"
                    ],
                    "target_lang_definitions": {
                        "zh": "与正式的宗教或公共仪式有关的，或用于其中的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "仪式性的",
                                "target_lang_sense_clarification": "指与仪式相关的，强调其作为仪式一部分的属性。"
                            },
                            {
                                "target_lang_word": "礼仪的",
                                "target_lang_sense_clarification": "指符合礼节或仪式规范的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b833df27-f39c-3c84-975f-f33f1e7afd8b",
                    "sense_definition": "Used only for the purpose of ceremony; symbolic rather than functional.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king holds a <w>ceremonial</w> role with no real political power.",
                            "target_lang_translations": {
                                "zh": "国王担任的是一个<w>象征性</w>职位，没有实际的政治权力。"
                            }
                        },
                        {
                            "text": "They used a <w>ceremonial</w> sword that was never meant for actual combat.",
                            "target_lang_translations": {
                                "zh": "他们使用了一把<w>仪式性</w>佩剑，它从未打算用于实战。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ceremonial role"
                    ],
                    "target_lang_definitions": {
                        "zh": "仅用于仪式目的；象征性的而非功能性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "象征性的",
                                "target_lang_sense_clarification": "指仅具有象征意义，不具备实际功能的。"
                            },
                            {
                                "target_lang_word": "名义上的",
                                "target_lang_sense_clarification": "指仅有头衔或地位，而无实际权力的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                    "sense_definition": "Fond of ceremony or ritual; observing strict etiquette or formality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>ceremonial</w> man who insisted on following every social rule.",
                            "target_lang_translations": {
                                "zh": "他是一个<w>讲究礼节</w>的人，坚持遵守每一条社交规则。"
                            }
                        },
                        {
                            "text": "The <w>ceremonial</w> host greeted every guest with a formal bow.",
                            "target_lang_translations": {
                                "zh": "这位<w>拘泥形式</w>的主人以正式的鞠躬礼迎接每一位客人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ceremonious",
                        "formal",
                        "ritualistic"
                    ],
                    "target_lang_definitions": {
                        "zh": "喜欢仪式或礼节的；遵守严格礼仪或形式的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讲究礼节的",
                                "target_lang_sense_clarification": "形容人非常注重形式和礼仪。"
                            },
                            {
                                "target_lang_word": "拘泥形式的",
                                "target_lang_sense_clarification": "形容人过于刻板地遵守礼仪。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                    "sense_definition": "A ceremony or a series of ceremonies prescribed by ritual.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ceremonial</w> was marked by a stately and well-conducted display of tradition.",
                            "target_lang_translations": {
                                "zh": "这场<w>仪式</w>以庄重且井然有序的传统展示为特色。"
                            }
                        },
                        {
                            "text": "There was very little <w>ceremonial</w> to mark the opening of the new building.",
                            "target_lang_translations": {
                                "zh": "新大楼的落成典礼几乎没有什么<w>礼仪</w>活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ritual"
                    ],
                    "target_lang_definitions": {
                        "zh": "由仪式规定的仪式或一系列仪式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "指正式的典礼或程序。"
                            },
                            {
                                "target_lang_word": "礼仪",
                                "target_lang_sense_clarification": "指一系列固定的礼节性活动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}