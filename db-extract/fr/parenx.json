                                    },
                                    {
                                        "sense_id": "7c2c0440-cef7-3d5c-bdcc-085898a0510a",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "The source or origin of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90aa64b8-2147-41a0-9096-2d336cfde03f",
                                                "sense_id": "7c2c0440-cef7-3d5c-bdcc-085898a0510a",
                                                "text": "Misery is often the parent of the most affecting touches in poetry."
                                            },
                                            {
                                                "example_id": "4c775732-e9af-4ddc-8217-44ea28cd24ba",
                                                "sense_id": "7c2c0440-cef7-3d5c-bdcc-085898a0510a",
                                                "text": "Indolence and unalimentary food are the parents of this disease; but to neither are Indians accustomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a91fcd0-e044-35ab-8005-8c5be118cc1a",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "An organism from which a plant or animal is immediately biologically descended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2f8b15f-a804-3d5b-a40d-dbd920334fc7",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "Sponsor, supporter, owner, protector."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425547be-3729-4de4-b39f-0f8378e4bd3e",
                                                "sense_id": "a2f8b15f-a804-3d5b-a40d-dbd920334fc7",
                                                "text": "The dinghy was trailing astern at the end of its painter, and Merrion looked at it as he passed. He saw that it was a battered-looking affair of the prahm type, with a blunt snout, and like the parent ship, had recently been painted a vivid green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27d99b4-9702-36af-a82f-281b48f8ff5e",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "Sponsor, supporter, owner, protector.",
                                            "A parent company."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accfa7e5-665f-4e7d-8e47-b215ee2cb9f9",
                                                "sense_id": "f27d99b4-9702-36af-a82f-281b48f8ff5e",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36cf280-01af-3423-8dea-f3cbae41db72",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "The object from which a child or derived object is descended; a node superior to another node."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a34d903-bb90-3ceb-a728-fc2eaef4697e",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "The nuclide that decays into a daughter nuclide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
