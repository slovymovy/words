                        "examples": [
                            {
                                "example_id": "40964cc0-7ee2-45cb-8447-26b40820d492",
                                "sense_id": "906519c4-33b2-35c4-9a9f-35494351a1a9",
                                "text": "So oft man auch über Funde des Satanspilzes berichten hört, bleibt doch die Tatsache bestehen, daß nur wenige Pilzfreunde den wirklichen Satanspilz zu sehen bekommen haben."
                            },
                            {
                                "example_id": "2cada8f4-e117-47c3-933f-e1f8177ce169",
                                "sense_id": "906519c4-33b2-35c4-9a9f-35494351a1a9",
                                "text": "Haben Sie einen Satanspilz-Standort entdeckt, versuchen Sie über die Untere Naturschutzbehörde dieses Waldstück zu sichern."
                            }
                        ],
                        "sense_index_json": "\"1\""
