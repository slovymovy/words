                                "target_senses": [
                                    {
                                        "sense_id": "e1199ef1-546e-3e72-b15f-dc9d47d1225e",
                                        "entry_id": "53473bba-e971-3bd8-9e85-719abd5f76eb",
                                        "glosses": [
                                            "schießfreudiger Westernheld auf dem nordamerikanischen Kontinent"
                                        ],
                                        "tags": [
                                            "Belletristik/Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "153fbe8d-27e7-4a0c-99cc-dd66605744bf",
                                                "sense_id": "e1199ef1-546e-3e72-b15f-dc9d47d1225e",
                                                "text": "Treffen sich zwei Cowboys! … Beide tot!"
                                            },
                                            {
                                                "example_id": "10e4455e-43c6-411f-8b68-dacd43529c64",
                                                "sense_id": "e1199ef1-546e-3e72-b15f-dc9d47d1225e",
                                                "text": "Zum Fasching verkleide ich mich als Cowboy."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd373e13-bd11-3fe0-aaca-1a0f29e0ff93",
                                        "entry_id": "53473bba-e971-3bd8-9e85-719abd5f76eb",
                                        "glosses": [
                                            "ein Viehhüter auf Rinderfarmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e99373-61f6-428d-b791-5a0c8f38a0fe",
                                                "sense_id": "dd373e13-bd11-3fe0-aaca-1a0f29e0ff93",
                                                "text": "Die Cowboys trieben die Rinderherde zusammen und veranstalteten ein Rodeo."
                                            },
                                            {
                                                "example_id": "1fc7c8d0-848e-44bc-b1ff-cd2104098f88",
                                                "sense_id": "dd373e13-bd11-3fe0-aaca-1a0f29e0ff93",
                                                "text": "„Cowboys tragen solche Kleidung in Western-Filmen, wenn sie laut Regieanweisung lächerlich erscheinen sollen.“"
                                            },
                                            {
                                                "example_id": "c97274b6-0d34-4889-b8ed-b8715585bcb3",
                                                "sense_id": "dd373e13-bd11-3fe0-aaca-1a0f29e0ff93",
                                                "text": "„Kurz nachdem sie die Bar verlassen hat, bestellt sich der Cowboy noch einen Drink.“"
                                            },
                                            {
                                                "example_id": "6eaeca3d-d0f9-45cb-95f1-8720eebd1a57",
                                                "sense_id": "dd373e13-bd11-3fe0-aaca-1a0f29e0ff93",
                                                "text": "„Der Cowboy begegnet einem anderen, der in schwarzer Trauerkleidung auf seinem Pferd daherkommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33af6c48-4a0f-4f6c-b422-9af003d0ce99",
                        "source_entry_id": "033d1c67-06d4-3fb8-bd39-7c99fd73e0a3",
