                                    {
                                        "sense_id": "7fb83ba8-70ba-3b4e-986b-cca1d88870b6",
                                        "entry_id": "c7b9806b-6784-3c75-ace9-c8748b652fee",
                                        "glosses": [
                                            "islam polityczny – doktryna polityczna oparta na islamie, łącząca religię z ideologią, w której Koran uznany jest za podstawę prawa i polityki państwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536ffd7f-6462-477c-96f3-0b3903ffdb6b",
                                                "sense_id": "7fb83ba8-70ba-3b4e-986b-cca1d88870b6",
                                                "text": "Szukając wyjaśnień dla swych kłopotów, muzułmanie obmyślili trzy polityczne odpowiedzi na współczesne wyzwania: świeckość, reformizm i islamizm"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5094618b-4a5a-3ef7-9978-dc5c88bd9ec1",
                                        "entry_id": "c7b9806b-6784-3c75-ace9-c8748b652fee",
