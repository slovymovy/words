{
    "word_family": [
        "problem",
        "problematize",
        "problematization",
        "problematically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "412df64a-41dd-3cc0-a03b-c52cee05544e",
                    "sense_definition": "Difficult to overcome, solve, or deal with; posing a problem.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Estimating what consumers will pay in the future is <w>problematic</w> for many businesses.",
                            "target_lang_translations": {
                                "ru": "Оценка того, сколько потребители будут платить в будущем, является <w>проблематичной</w> для многих компаний."
                            }
                        },
                        {
                            "text": "The lack of funding proved to be a <w>problematic</w> issue for the new project.",
                            "target_lang_translations": {
                                "ru": "Отсутствие финансирования оказалось <w>проблемным</w> вопросом для нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficult",
                        "troublesome",
                        "complicated",
                        "complex",
                        "involved"
                    ],
                    "antonyms": [
                        "unproblematic"
                    ],
                    "common_phrases": [
                        "problematic issue",
                        "highly problematic",
                        "prove problematic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для преодоления, решения или урегулирования; создающий проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблематичный",
                                "target_lang_sense_clarification": "вызывающий затруднения"
                            },
                            {
                                "target_lang_word": "трудный",
                                "target_lang_sense_clarification": "сложный для выполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3cda71e-44fa-3364-8bd6-b3fdd7cc55cd",
                    "sense_definition": "Not settled or certain; open to doubt or debate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher provided a <w>problematic</w> analysis that many other experts questioned.",
                            "target_lang_translations": {
                                "ru": "Исследователь представил <w>сомнительный</w> анализ, который многие другие эксперты поставили под сомнение."
                            }
                        },
                        {
                            "text": "The sudden change in leadership portends a <w>problematic</w> future for the movement.",
                            "target_lang_translations": {
                                "ru": "Внезапная смена руководства предвещает движению <w>непростое</w> будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "doubtful",
                        "dubious",
                        "questionable",
                        "controversial",
                        "uncertain"
                    ],
                    "common_phrases": [
                        "problematic analysis",
                        "problematic future"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не решенный окончательно или неопределенный; вызывающий сомнения или споры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблематичный",
                                "target_lang_sense_clarification": "сомнительный, спорный"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий недоверие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13cfb944-63d8-3eb6-90c6-ea6fe483f74d",
                    "sense_definition": "Contributing to or reflecting social discrimination, such as racism or sexism.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many critics argued that the film's depiction of minorities was deeply <w>problematic</w>.",
                            "target_lang_translations": {
                                "ru": "Многие критики утверждали, что изображение меньшинств в фильме было глубоко <w>проблематичным</w>."
                            }
                        },
                        {
                            "text": "The comedian faced backlash after making several <w>problematic</w> comments during the show.",
                            "target_lang_translations": {
                                "ru": "Комик столкнулся с резкой критикой после нескольких <w>неуместных</w> высказываний во время шоу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deeply problematic",
                        "problematic behavior",
                        "problematic comments"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in social justice contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий социальной дискриминации или отражающий ее (например, расизм или сексизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблематичный",
                                "target_lang_sense_clarification": "неуместный или предосудительный в социальном контексте"
                            },
                            {
                                "target_lang_word": "неоднозначный",
                                "target_lang_sense_clarification": "вызывающий критику этического характера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3409ac41-7c8b-38cf-bb10-10d1915d49d4",
                    "sense_definition": "In logic, relating to a proposition that states something is possible but not necessarily true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, a <w>problematic</w> judgment expresses only the possibility of a predicate.",
                            "target_lang_translations": {
                                "ru": "В формальной логике <w>проблематическое</w> суждение выражает лишь возможность предиката."
                            }
                        },
                        {
                            "text": "The philosopher distinguished between apodictic and <w>problematic</w> statements.",
                            "target_lang_translations": {
                                "ru": "Философ проводил различие между аподиктическими и <w>проблематическими</w> утверждениями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "problematic judgment",
                        "problematic proposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term in logic and philosophy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В логике: относящийся к суждению, которое утверждает возможность, но не обязательную истинность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблематический",
                                "target_lang_sense_clarification": "в логике: вероятностный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c8d96a7-e393-36e2-9a42-66b2e07e887c",
                    "sense_definition": "A specific problem, difficulty, or set of issues within a particular field of study.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "academic_issue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author explores the <w>problematic</w> of identity in post-colonial literature.",
                            "target_lang_translations": {
                                "ru": "Автор исследует <w>проблематику</w> идентичности в постколониальной литературе."
                            }
                        },
                        {
                            "text": "This chapter addresses a particular <w>problematic</w> regarding the role of railways in economic development.",
                            "target_lang_translations": {
                                "ru": "В этой главе рассматривается конкретная <w>проблематика</w>, касающаяся роли железных дорог в экономическом развитии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "particular problematic",
                        "theoretical problematic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used primarily in academic or theoretical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная проблема, трудность или совокупность вопросов в определенной области знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблематика",
                                "target_lang_sense_clarification": "совокупность проблем в научной сфере"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}