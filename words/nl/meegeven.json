                    "sense_definition": "iemand een advies, boodschap of les overdragen om over na te denken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ik jullie vandaag vooral wil <w>meegeven</w> is een goede manier om met geweld op straat om te gaan.",
                            "target_lang_translations": {
                                "en": "What I especially want to <w>leave</w> you <w>with</w> today is a good way to deal with street violence."
                            }
                        },
                        {
                            "text": "De leraar wilde de leerlingen een belangrijke boodschap <w>meegeven</w> voor de toekomst.",
                            "target_lang_translations": {
                                "en": "The teacher wanted to <w>impart</w> an important message to the students for the future."
                            }
