                                        "glosses": [
                                            "von einem Sprecher vertontes und auf einem Speichermedium gespeichertes Buch (= Lesung), Hörspiel oder Feature, das auf Kassette oder CD publiziert wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
