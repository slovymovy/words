                "senses": [
                    {
                        "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                        "entry_id": "d73c34d7-bac5-37b4-87ef-766456bae2ee",
                        "glosses": [
                            "veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c927f6-8603-4c61-8b78-82972a0e238e",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Dabei handelt es sich um eine Nervenstörung, die mit Fehlempfindungen beginnt und schließlich zu Muskelschwäche, Lähmung und Atemlähmung führt.“"
                            },
                            {
                                "example_id": "ddd56f34-df74-4520-8557-55603a60e8c0",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Mit den Drogen versuchen FASD-Betroffene, zeitweilig einen Gefühlsausgleich zu erreichen und Fehlempfindungen zu kompensieren.“"
                            },
                            {
                                "example_id": "e3a97529-bcea-4bf6-b177-6fcba5f38d74",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Diese führt über Fehlempfindungen zu Taubheitsgefühlen, so daß beim Diabetiker häufig die Schmerzphänomene geschwächt oder gar nicht auftreten.“"
                            },
                            {
                                "example_id": "37dafbb6-1ec3-4329-adfe-289e0c910a4e",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Selbstverständlich müssen Fehlempfindungen oder sogar Kälteschmerzen erfragt und beachtet werden.“"
                            },
                            {
                                "example_id": "d34e8720-5cf7-465b-974d-f42394bc4826",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Trotz zahlreicher charakteristischer parästhetischer Erscheinungen, läßt sich aus der Art der Fehlempfindung keine Krankheitsdiagnose stellen.“"
                            },
                            {
                                "example_id": "525d639a-bcf4-4041-a696-1c2ea8f79610",
                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                "text": "„Reiben mit dem Eisball zur Durchblutungsförderung und Stimulation Fehlempfindungen oder sogar Kälteschmerzen erfragt und beachtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
