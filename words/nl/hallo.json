                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hallo</w>, hoe gaat het vandaag met jou?",
                            "target_lang_translations": {
                                "ru": "<w>Привет</w>, как у тебя сегодня дела?",
                                "en": "<w>Hello</w>, how are you today?",
                                "pl": "<w>Cześć</w>, jak się dzisiaj masz?",
                                "de": "<w>Hallo</w>, wie geht es dir heute?",
                                "fr": "<w>Bonjour</w>, comment vas-tu aujourd'hui ?",
                                "it": "<w>Ciao</w>, come stai oggi?",
