                        ],
                        "form": "die Zwerginnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5114a5eb-d53c-359b-82c7-a03c4913e8ac",
                        "entry_id": "ac220977-df2a-3b6a-a565-4f85659a4a4d",
                        "glosses": [
                            "sehr kleine, weibliche Märchenfigur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa53104-aa15-49d6-b2de-85283f98ed2c",
                                "sense_id": "5114a5eb-d53c-359b-82c7-a03c4913e8ac",
                                "text": "„Meine Großmutter, ein Anderthalbmeter-Mütterchen, ist wie eine Zwergin aus dem Märchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e685c140-a141-398c-9aa4-2601a35c9510",
                        "entry_id": "ac220977-df2a-3b6a-a565-4f85659a4a4d",
                        "glosses": [
                            "sehr kleine weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b36b293-8169-4b6d-a9b8-0cbf89cc5313",
                                "sense_id": "e685c140-a141-398c-9aa4-2601a35c9510",
                                "text": "„Ein ähnlicher Aufzug folgte mit den schwarzgekleideten Zwerginnen, deren Gesichter mit schwarzen Tüchern bedeckt waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0241eb03-477d-4981-9c88-1bfea5d683b9",
                        "source_entry_id": "ac220977-df2a-3b6a-a565-4f85659a4a4d",
                        "source_sense_id": "5114a5eb-d53c-359b-82c7-a03c4913e8ac",
                        "source_sense_description": "sehr kleine, weibliche Märchenfigur",
                        "target_lang_word": "dwarfess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwarfess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f32fc300-669a-3208-8883-6da8a9aa39b3",
                                        "entry_id": "659c68b5-774d-3550-9baa-eba473fe695c",
                                        "glosses": [
                                            "A human female dwarf."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2fc567-4e3b-4a26-bf91-1791a50378de",
                                                "sense_id": "f32fc300-669a-3208-8883-6da8a9aa39b3",
                                                "text": "Gibson and his wife were among the best English-born artists of their era. He was just three feet six inches in height; she was a dwarfess of the same proportion. This little couple had nine good-sized children, and having weathered the storms of civil war, lived happily together to old age."
                                            },
                                            {
                                                "example_id": "15648136-bea1-4f48-ac1e-692acd045fa2",
                                                "sense_id": "f32fc300-669a-3208-8883-6da8a9aa39b3",
                                                "text": "“I have no idea what they will do with it,” he [Vladimir Nabokov] said. “Of course they will have to change the plot. Perhaps they will make Lolita a dwarfess. Or they will make her 16 and Humbert 26. I just don’t know. It’s difficult to translate a book into a movie.”"
                                            },
                                            {
                                                "example_id": "a6ba3465-2c94-4bb9-a1e4-2149cff6c96a",
                                                "sense_id": "f32fc300-669a-3208-8883-6da8a9aa39b3",
                                                "text": "Beside him stood a dwarfess, even smaller than he was, snub-nosed and doll-faced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a691385-10d6-3081-8ff2-df98733846f9",
                                        "entry_id": "659c68b5-774d-3550-9baa-eba473fe695c",
                                        "glosses": [
                                            "A female of the dwarf race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8a655e-d65a-48e5-8ce3-0455a19390ac",
                                                "sense_id": "7a691385-10d6-3081-8ff2-df98733846f9",
                                                "text": "1990, Tanith Lee, “White As Sin, Now”, in Ellen Datlow and Terri Windling (editors), The Year’s Best Fantasy and Horror, Third Annual Collection, St. Martin's Press, 0-312-04450-X, page 328,\nHeracty has been told that the flaxen dwarfess once had an adventure in the mock forest below the Palace."
                                            },
                                            {
                                                "example_id": "339c1d2b-967c-427f-9f95-c4f386922acd",
                                                "sense_id": "7a691385-10d6-3081-8ff2-df98733846f9",
                                                "text": "She was a silver-haired, rather portly dwarfess...and the most powerful enchantress in Ilsdale, if not in the known world."
                                            },
                                            {
                                                "example_id": "27f7a7e6-8706-42fe-8d97-bdf663ab14e5",
                                                "sense_id": "7a691385-10d6-3081-8ff2-df98733846f9",
                                                "text": "Opening the door, I immediately see a stout dwarfess, probably the owner, behind a counter and a group of young cat-people girls in aprons serving food and alcohol to customers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0398ae16-5204-47ab-8479-6cf7c8059285",
                        "source_entry_id": "ac220977-df2a-3b6a-a565-4f85659a4a4d",
                        "source_sense_id": "5114a5eb-d53c-359b-82c7-a03c4913e8ac",
                        "source_sense_description": "sehr kleine, weibliche Märchenfigur",
                        "target_lang_word": "naine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f80ec64-809a-326c-96d8-b783df3fe652",
                                        "entry_id": "9300bee6-c3c9-3ff4-bdf4-897306fe1383",
                                        "glosses": [
                                            "Personne de petite taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff48df05-91e7-479d-a89d-51bf4b3b0403",
                                                "sense_id": "6f80ec64-809a-326c-96d8-b783df3fe652",
                                                "text": "Le nain et la naine étaient très recherchés comme fous du roi au Moyen Âge, puisqu’ils étaient physiquement différents, considérés même comme une race à part, mais capables de faire tout ce qu’un fou devait faire pour divertir le roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cedae4b-d9d1-3774-8e03-4a52b688dba2",
                                        "entry_id": "9300bee6-c3c9-3ff4-bdf4-897306fe1383",
                                        "glosses": [
