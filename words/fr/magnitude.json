                {
                    "sense_id": "68827658-42df-3298-9e65-1de618d9dabc",
                    "sense_definition": "Mesure de la luminosité ou de l'éclat apparent ou intrinsèque d'un astre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étoile possède une <w>magnitude</w> apparente élevée et reste difficile à observer sans télescope."
                        },
                        {
                            "text": "Les astronomes ont calculé la <w>magnitude</w> de cette comète pour évaluer son éclat."
