                "translations": [
                    {
                        "translation_id": "fa6b97c5-9e08-45e1-bc9f-1adfc7e1cd24",
                        "source_entry_id": "8dc49c77-04db-3e7e-b0cf-63cf532527d9",
                        "source_sense_id": "fa174393-d96e-3b06-8cb4-60e5e42dca08",
                        "source_sense_description": "offizielle Bezeichnung der höchsten Verwaltungsbehörden in den Vereinigten Staaten von Amerika",
