                                "example_id": "b2d3032f-d167-404b-94ef-de899907c509",
                                "sense_id": "eaa06d78-fc54-38aa-b748-59eae98670b6",
                                "text": "Présenter des allèchements à des gens qu’on veut séduire."
                            },
                            {
                                "example_id": "ac260b7c-aed0-4b36-98b2-147516d009a0",
                                "sense_id": "eaa06d78-fc54-38aa-b748-59eae98670b6",
                                "text": "Les allèchements du plaisir, de la faveur."
                            },
                            {
                                "example_id": "3ce1ebdc-cbca-486c-8b4f-01b4b8c996a0",
                                "sense_id": "eaa06d78-fc54-38aa-b748-59eae98670b6",
                                "text": "C'est ce qui me séparait aussi de lui, lʼallèchement était à mes yeux la forme suprême du désir."
                            }
                        ]
                    }
