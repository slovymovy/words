                        "target_lang_word": "pledge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13c9a1e1-41db-3220-a2a0-b72ca7102610",
                                        "entry_id": "cf0f2c42-85ad-3566-9c95-7d758a2ace42",
                                        "glosses": [
                                            "To make a solemn promise (to do something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6823fedb-abc4-4a88-ab5b-e0448d57af9a",
                                                "sense_id": "13c9a1e1-41db-3220-a2a0-b72ca7102610",
                                                "text": "pledge allegiance to the flag"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0590532-cc7d-3e32-9177-6e8da843b806",
                                        "entry_id": "cf0f2c42-85ad-3566-9c95-7d758a2ace42",
                                        "glosses": [
                                            "To deposit something as a security; to pawn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a307c28-5778-3563-89d2-d00efd669d71",
                                        "entry_id": "cf0f2c42-85ad-3566-9c95-7d758a2ace42",
                                        "glosses": [
                                            "To give assurance of friendship by the act of drinking; to drink to one's health."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c4ed3d-c0b8-418f-b496-7eb3cce25107",
                                                "sense_id": "0a307c28-5778-3563-89d2-d00efd669d71",
                                                "text": "HARDCASTLE [Taking the cup.] I hope you'll find it to your mind. I have prepared it with my own hands, and I believe you'll own the ingredients are tolerable. Will you be so good as to pledge me, sir? Here, Mr. Marlow, here is to our better acquaintance. [Drinks.]"
                                            },
                                            {
                                                "example_id": "8135836f-3260-400e-a591-12f3a462a917",
                                                "sense_id": "0a307c28-5778-3563-89d2-d00efd669d71",
                                                "text": "Reach me my golden cup that stands by thee,\nAnd pledge me in it first for courtesy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a3b37e-2710-3b69-9a64-f795f286225d",
                                        "entry_id": "f31be620-5d30-3729-817d-b6a44edcadce",
                                        "glosses": [
                                            "A solemn promise to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab0e724-b97c-4871-815b-74a7fca1e8e9",
                                                "sense_id": "c3a3b37e-2710-3b69-9a64-f795f286225d",
                                                "text": "Mr. Biden unveiled the pledge at a White House climate summit for world leaders, declaring that the United States is ready to reclaim a leadership role on climate change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226eef65-7e55-3506-9d1c-256d0ca9b8ac",
                                        "entry_id": "f31be620-5d30-3729-817d-b6a44edcadce",
                                        "glosses": [
                                            "A solemn promise to do something.",
                                            "A promise to abstain from drinking alcohol."
                                        ],
                                        "tags": [
                                            "with the"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ec0b018-a2b2-3922-8a44-b8e155df2d90",
                                        "entry_id": "f31be620-5d30-3729-817d-b6a44edcadce",
                                        "glosses": [
                                            "An asset or person temporarily handed over to guarantee the fulfilment of something promised, under threat of permanent loss of the thing handed over; surety, security, hostage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e53d140-c2c1-44c1-888c-79ee246ece35",
                                                "sense_id": "0ec0b018-a2b2-3922-8a44-b8e155df2d90",
                                                "text": "Iacke Straw. […] I haue his wife and children pledges, for his ſpeedie returne from the King, to whom he is gone with our meſſage.\nTom Miller. Let him take heede hee bring a wiſe anſwere to our worships, or els his pledges goes to the pot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3113115-3312-3869-bcf4-d02c6452681b",
                                        "entry_id": "f31be620-5d30-3729-817d-b6a44edcadce",
                                        "glosses": [
                                            "A bailment of personal property to secure payment of a debt without transfer of title."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e39a954b-d791-38df-b311-77ea8e205672",
                                        "entry_id": "f31be620-5d30-3729-817d-b6a44edcadce",
                                        "glosses": [
                                            "A bailment of personal property to secure payment of a debt without transfer of title.",
                                            "The personal property so pledged, to be kept until the debt is paid."
                                        ],
