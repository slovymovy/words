                ],
                "senses": [
                    {
                        "sense_id": "5bf8b04c-5508-31af-a1d4-4258d9147f83",
                        "entry_id": "a9405654-69f1-3a05-8d53-f25ca5a2aada",
                        "glosses": [
                            "gelegenheid waar men aan kansspelen kan deelnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a0c762-9ed5-4b30-8653-51c21d2cb42f",
                                "sense_id": "5bf8b04c-5508-31af-a1d4-4258d9147f83",
                                "text": "Alle vier wettige kinderen zijn afkomstig uit het eerste huwelijk van Otto met een nonna, een dame met gemengd bloed die tijdens de gebeurtenissen van de roman in Batavia woont en daar een speelhuis uitbaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6216a0b-48e1-309f-9183-e8091e39e914",
                        "entry_id": "a9405654-69f1-3a05-8d53-f25ca5a2aada",
                        "glosses": [
                            "nagebootste woning waarin kinderen kunnen spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06a65bd-bbb3-4a0c-822e-de66fae35bc8",
                                "sense_id": "f6216a0b-48e1-309f-9183-e8091e39e914",
                                "text": "In het houten speelhuis op het schoolplein kwamen Yannick en ik samen."
                            },
                            {
                                "example_id": "613c5821-f514-4246-b5bf-ad7be9026174",
                                "sense_id": "f6216a0b-48e1-309f-9183-e8091e39e914",
                                "text": "Hij prees Gottfrids timmermanswerk aan de twee nieuwe personeelswoningen achter aan het perceel bij de chauffeurswoning en aan het speelhuisje."
                            }
                        ]
                    },
                    {
                        "sense_id": "824962a2-5e5a-355c-9693-3f0a761afcfb",
                        "entry_id": "a9405654-69f1-3a05-8d53-f25ca5a2aada",
                        "glosses": [
                            "bij de rederijkers een constructie op het toneel die aan vier kanten kon worden afgeschermd, meestal met gordijnen, en die de mogelijkheid gaf de handeling op meer plaatsen (eventueel gelijktijdig) te laten plaatsvinden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7c529874-04da-4fa7-8f97-b019d263352c",
                                "sense_id": "824962a2-5e5a-355c-9693-3f0a761afcfb",
                                "text": "Het toneel bestaat in Nederland in de 16de eeuw uit een platform en een speelhuis. Het speelhuis is een aan alle vier zijden (meestal met gordijnen) afgesloten ruimte, kleiner dan het platform en er zo op geplaatst dat ervóór, en vaak ook ernaast, ruimte overblijft."
                            }
                        ]
                    }
