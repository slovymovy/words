                                                "example_id": "d9e11911-0e35-4bd7-ade4-c1f7e02eb64c",
                                                "sense_id": "6d8accf0-56ff-38e0-b8f8-b7ae7672f34f",
                                                "text": "a canon of beef or lamb"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933d76e5-a515-3094-9366-e735500bfa26",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
