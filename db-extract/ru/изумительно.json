                                "target_senses": [
                                    {
                                        "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "In an amazing manner; in a way that causes amazement; wonderfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4398029-fe65-4e86-b94f-3d3c6b466f7d",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "That violin solo was played amazingly."
                                            },
                                            {
                                                "example_id": "52598c2f-e63a-4edd-9940-69d360039eb1",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "While at first in the U.S.A. it may have been a matter of high-pressure salesmanship—and it has undoubtely been the irresistible enterprise of the General Motors Corporation, through its Electro-Motive subsidiary, that has set in motion this amazingly rapid transformation of American railway motive power, and has caused all the steam locomotive builders in the U.S.A. to follow suit or be left out in the cold—it seems now beyond dispute that, so far as the U.S.A. is concerned, the economics of the power question can be solved no other way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "Difficult to believe; strange but true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c126aba-30ec-4766-b567-f8e374b1f39d",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Amazingly, no one was injured in the crash."
                                            },
                                            {
                                                "example_id": "da94ad3b-671e-4197-9cb9-446127be676b",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Signalman Bridges was killed by the blast, as was fireman Nightall. Amazingly, driver Gimbert came round some 200 yards away, on the grass outside the Station Hotel where he had been flung."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "To a wonder-inspiring extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd227fff-34b0-4794-8367-a21f5fa01455",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The car has amazingly low fuel consumption."
                                            },
                                            {
                                                "example_id": "95d038e8-feab-40ae-975c-6325f9ef4331",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The disease AIDS is wiping out a significant portion of the Gay Community and concerns about it are well-justified. But there is another disease that strikes an amazingly high percentage in our community. This disease is Chemical Dependency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da341b2d-77b7-44a0-a9fc-011056280a28",
                        "source_entry_id": "dc214804-c156-3bd1-8db8-6fa0c9107143",
                        "target_lang_word": "wonderfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonderfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                        "entry_id": "038cf3f4-bf9f-330e-a028-7ad9e894bd8c",
                                        "glosses": [
                                            "In a wonderful manner.",
                                            "In an excellent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d11e28a-ae98-457d-91f0-9bd67c2fe24f",
                                                "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                                "text": "He entertained us wonderfully."
                                            },
                                            {
                                                "example_id": "51d061ba-d7ea-4ca6-854b-153ce3216ead",
                                                "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                                "text": "By freeing statisticians from dealing with complicated calculations, the statistical aspects of a problem can become the main focus. This point is wonderfully illustrated by Smith and Gelfand (1992)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                        "entry_id": "038cf3f4-bf9f-330e-a028-7ad9e894bd8c",
                                        "glosses": [
                                            "In a wonderful manner.",
                                            "To an extent inspiring wonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456f0992-53aa-4f4a-84a1-c109fd9c1b6c",
                                                "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                                "text": "On a clear night, the Montana sky is wonderfully vast and full of stars."
                                            },
                                            {
                                                "example_id": "31aae87d-f932-48b6-8066-eb3ecbce7e5b",
                                                "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                                "text": "It was wonderfully stormy and dark on the night when the ship went down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
