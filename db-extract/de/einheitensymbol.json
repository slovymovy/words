                "senses": [
                    {
                        "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                        "entry_id": "83e6acf7-7253-3de7-b015-55a212115921",
                        "glosses": [
                            "Abkürzung für eine Maßeinheit physikalischer Größen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0bf8f6-a975-455a-9d5b-ab9dcef1e858",
                                "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                                "text": "Das Einheitensymbol für die Kraft ist das „N“ und steht für Newton."
                            },
                            {
                                "example_id": "f7a4289c-7e56-4237-ac7d-6a9ed0a5e2df",
                                "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                                "text": "Das Einheitensymbol „μl“ bedeutet Mikroliter."
                            },
                            {
                                "example_id": "b4106bc7-8697-4ae0-8c29-34c66f8b42d5",
                                "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                                "text": "Produkte und Quotienten der Einheitensymbole werden nach den üblichen Regeln der Algebra gebildet."
                            },
                            {
                                "example_id": "3ed2383e-d710-469f-bef7-10d9a9c5df5e",
                                "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                                "text": "Die dezimalen Vielfachen, beispielsweise das 10³- oder 10⁻⁶-fache einer Einheit, bezeichnet man durch Vorsilben, die als Kurzzeichen vor das Einheitensymbol geschrieben wurden."
                            },
                            {
                                "example_id": "79388b8b-738d-4889-a7e9-0140fe5f7540",
                                "sense_id": "fbe9c041-600f-32c3-8fc8-a766a15eb115",
                                "text": "In der Technik benutzt man statt der Einheit 1 mol meistens das Kilomol, dessen Einheitensymbol kmol ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
