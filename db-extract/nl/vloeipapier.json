                                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                                "text": "All transactions were entered in the cash blotter and agent's subsidiary ledger."
                                            },
                                            {
                                                "example_id": "775e23d5-00a3-4f47-bf74-822dee3076e9",
                                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                                "text": "He maintains the political blotter blog."
                                            },
                                            {
                                                "example_id": "650b1790-74a8-4984-b75b-19172dd22d75",
                                                "sense_id": "60af6b13-44fa-335c-a806-c77cb377f7a9",
                                                "text": "\"The blotter was so full of his scribbling, it was getting harder and harder to find places to write in.\""
                                            }
                                        ]
                                    },
