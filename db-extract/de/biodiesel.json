                                    {
                                        "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                        "entry_id": "1aff0170-7bf4-3112-a115-d966d823f563",
                                        "glosses": [
                                            "Fuel for diesel engines made from renewable organic raw materials, as opposed to fossil hydrocarbons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46604b03-b499-47cf-b512-81d4c6684c1b",
                                                "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                                "text": "Biodiesel is an increasingly popular alternative fuel because it's made by refining oil. Thinner than vegetable oil, biodiesel can power diesel engines without further conversion."
                                            },
                                            {
                                                "example_id": "7179c9cb-3aff-4a81-8402-abbf245d9cc5",
                                                "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                                "text": "Biodiesel is a technologically feasible alternative to petrodiesel, but nowadays biodiesel costs 1.5 to 3 times more than fossil diesel in developed countries."
                                            }
                                        ]
                                    }
                                ]
                            }
