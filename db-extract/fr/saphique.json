                        ]
                    },
                    {
                        "translation_id": "1095f740-d1dd-4330-9f48-a5242973de07",
                        "source_entry_id": "4f0a0fef-ef35-39b3-8d6c-009344ad1cd8",
                        "target_lang_word": "sapphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sapphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d822e1f6-1ffa-35c9-850d-5c3d420d5d44",
                                        "entry_id": "3ea4dfc7-06f1-37e2-b004-739d18b82935",
                                        "glosses": [
                                            "Lesbian, relating to lesbianism, or (broadly) to women who are attracted (not necessarily exclusively) to women."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b5b8ad1-4329-4a5a-be38-a0171ce65ff2",
                                                "sense_id": "d822e1f6-1ffa-35c9-850d-5c3d420d5d44",
                                                "text": "Clinton and I became peripherally involved with a pair of Leckford Road girls who, principally sapphic in their interests, would arrange for sessions of group frolic."
                                            },
                                            {
                                                "example_id": "c09fc544-0d78-467c-96ce-6285fadfd43c",
                                                "sense_id": "d822e1f6-1ffa-35c9-850d-5c3d420d5d44",
                                                "text": "[...] and rumor had it that the Margo—Eve relationship was inspired by the bisexual Bankhead and her Skin of Our Teeth understudy [...] (The 1947 film version teamed Humphrey Bogart with sapphic stars Barbara Stanwyck and Alexis Smith.)"
                                            },
                                            {
                                                "example_id": "8402a0e4-a5c0-4ebd-b479-06966b42144c",
                                                "sense_id": "d822e1f6-1ffa-35c9-850d-5c3d420d5d44",
                                                "text": "Her lyrics are deeply personal and wide reaching and she weaves in indignation at the state of American politics while simultaneously exploring her identity as a black sapphic [pansexual] woman."
                                            },
                                            {
                                                "example_id": "d8ede7b0-f1bc-4e2a-a207-020dfcca420a",
                                                "sense_id": "d822e1f6-1ffa-35c9-850d-5c3d420d5d44",
                                                "text": "Perhaps the queer, unnatural, and possibly disturbing conjunctions of the trans and nonbinary sapphic can help to do just that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sapphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e57ecde-396c-368a-9482-c81c59119b30",
                                        "entry_id": "35a03666-1ced-35da-914b-1bfe424f028c",
                                        "glosses": [
                                            "Alternative letter-case form of Sapphic."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d1ebd3-8b1a-4ec7-8624-b67008314549",
                                                "sense_id": "1e57ecde-396c-368a-9482-c81c59119b30",
                                                "text": "Though they will not satisfy Mr. T. S. Omond's rules of quantity, and cannot be expected to reach Swinburne's exquisite sense of its balance, they give far more idea of the rhythm of Sappho than the body of English sapphics by other writers."
                                            },
                                            {
                                                "example_id": "0210d871-b959-4b80-96aa-db854db908d8",
                                                "sense_id": "1e57ecde-396c-368a-9482-c81c59119b30",
                                                "text": "Statius, in the Silvae, does offer two “lyric” poems, one in alcaics and one in sapphics, but lyric poetry in any form and of any consequence does not recur until the Christian hymns of St. Ambrose and Prudentius, ..."
                                            },
                                            {
                                                "example_id": "0048057e-699f-47bd-9647-8a3b26583491",
                                                "sense_id": "1e57ecde-396c-368a-9482-c81c59119b30",
                                                "text": "April 29: Thao & The Get Down Stay Down host local rock sapphics Kera & the Lesbians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
