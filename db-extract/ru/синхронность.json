                "senses": [
                    {
                        "sense_id": "2ae56056-4279-3e1d-8b9f-3d423a47e6a5",
                        "entry_id": "531fce63-f322-3b1f-90e1-14856cd58c9f",
                        "glosses": [
                            "свойство или состояние по значению прилагательного синхронный; одновременность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a9e8ee-761e-431a-9dc2-6eaca9116ad1",
                                "sense_id": "2ae56056-4279-3e1d-8b9f-3d423a47e6a5",
                                "text": "Синхронность проявления гелиофизических и геофизических процессов говорит об их причинно-следственной связи."
                            },
                            {
                                "example_id": "5d04b077-5cc3-41dc-bcbe-c19cb8d8f2f2",
                                "sense_id": "2ae56056-4279-3e1d-8b9f-3d423a47e6a5",
                                "text": "Овладение трелью надо начинать с восьмых, добиваясь предельной ритмической чёткости и синхронности ударов языков, постепенно ускоряя темп, переходя на 16-е, затем на 32-е."
                            }
                        ]
                    }
