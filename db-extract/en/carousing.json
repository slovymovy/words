                    {
                        "sense_id": "6b50ef51-523d-3444-b860-58767bd29fc0",
                        "entry_id": "19f39be1-90ef-30df-a312-07cd09216ba1",
                        "glosses": [
                            "Engaged in or associated with the act of carousing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60835fa-ae97-44f0-b347-a092277977fd",
                                "sense_id": "6b50ef51-523d-3444-b860-58767bd29fc0",
                                "text": "I remember I was once of a party of between twenty and thirty officers, from a squadron of four or five line-of-battle ships, and some smaller vessels, which met together at a tavern at St. Pierre's, Martinico, when a carousing scene took place, so characteristically unique, that it would require the pen of Scott, or the pencil of Cruikshank , to do it justice."
                            },
                            {
                                "example_id": "9ad81d21-0ae8-4d7f-8e4c-903312e24249",
                                "sense_id": "6b50ef51-523d-3444-b860-58767bd29fc0",
                                "text": "A carousing zone is a place where the ritualism of generating antinomian excitement prevails and may even be institutionalized."
                            },
                            {
                                "example_id": "e509433d-e1d3-404d-a48e-ee0324c1f9a6",
                                "sense_id": "6b50ef51-523d-3444-b860-58767bd29fc0",
                                "text": "A carousing group is almost always exclusively made up of men who are, more often than not, close in age, social position, and economic status."
                            }
                        ]
                    }
                ],
