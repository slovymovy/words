                        "examples": [
                            {
                                "example_id": "8092198f-1dff-4503-b876-feeb4b4ebfa9",
                                "sense_id": "7abd33f2-f0f2-3510-882c-70c795d2f0a9",
                                "text": "Внутри Натальина хатка была приглядной: яркий палас на полу, красивые накидки, цветастые шторы."
                            },
                            {
                                "example_id": "2e01c5fa-ffd8-4736-8763-f95aecb525c7",
                                "sense_id": "7abd33f2-f0f2-3510-882c-70c795d2f0a9",
                                "text": "Он пылесосил палас в Анькиной комнате, когда в дверь позвонили."
                            }
                        ]
                    }
