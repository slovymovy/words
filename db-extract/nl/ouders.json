            {
                "entry_id": "3b5f47fb-ffdd-392f-ae16-c38e1040a2b0",
                "word": "ouders",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                        "entry_id": "3b5f47fb-ffdd-392f-ae16-c38e1040a2b0",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord ouder"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "110731d2-84b0-4a32-9651-c92b3f617231",
                                "sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                                "text": "Wat zeiden je ouders ervan toen je ze vertelde dat je hier ging werken?' 'Mijn ouders?' 'Waren ze trots?' Ik wriemelde met mijn tenen in mijn schoenen."
                            },
                            {
                                "example_id": "1a6e7705-df09-4042-a85f-c5bb254e1cda",
                                "sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                                "text": "Hoewel ik gewoonlijk niet over mijn ouders sprak, voelde ik me nu toch verplicht om door te gaan."
                            },
                            {
                                "example_id": "3fe9834b-b4af-4b21-8a40-a2d64ff9ed75",
                                "sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                                "text": "De ouders hadden de kinderen van 10 en 12 na een hoop gedoe voor een halfjaar van school kunnen uitschrijven om gezamenlijk de PCT te lopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a3664d-b91f-4851-acff-dcfdb226d16f",
                        "source_entry_id": "3b5f47fb-ffdd-392f-ae16-c38e1040a2b0",
                        "source_sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                        "source_sense_description": "meervoud van het zelfstandig naamwoord ouder",
                        "target_lang_word": "Eltern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eltern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                        "entry_id": "85f764ec-3c63-34b6-995c-3e946c6d549b",
                                        "glosses": [
                                            "Vater und Mutter eines Kindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa1338c-628f-4b32-bc3e-74009666d888",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "Eltern haften für ihre Kinder."
                                            },
                                            {
                                                "example_id": "693d7dfb-db60-4273-ab5b-3c15cf95e1d8",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "\"Eltern brauchen Zeit, um ihre Kinder ins Leben zu begleiten, und sie brauchen Zeit, wenn Angehörige Unterstützung benötigen oder pflegebedürftig werden.\""
                                            },
                                            {
                                                "example_id": "03c681d5-3fea-4367-834a-969c26032e8a",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "Andere wiederum beneiden die Einzelkinder: wie schön es doch sein müsse, alleine aufzuwachsen, alle Aufmerksamkeit der Eltern zu genießen, sich nichts mit anderen teilen zu müssen."
                                            },
                                            {
                                                "example_id": "abbfa5d2-e2c3-4d33-a4b5-cab9a118ae10",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "„Oma und Opa waren da, meine Eltern, mein Bruder Sebastian und Onkel Hugo.“"
                                            },
                                            {
                                                "example_id": "3f85efe1-fa7c-4303-993c-0d0152c35753",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "„Meine Eltern wurden beide kurz nach Kriegsende geboren, in einer Zeit, die keine optimalen Startbedingungen für sie bot:…“"
                                            },
                                            {
                                                "example_id": "709e126b-1479-43f0-9e63-7b2e9dfa7a95",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "„Meine Eltern stammten aus der Türkei und hatten zuletzt in Istanbul gelebt.“"
                                            },
                                            {
                                                "example_id": "d68261b9-18ff-4eea-a983-1e750eb203ae",
                                                "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                                                "text": "„Der kleine Junge ist nicht das erste Baby mit drei genetischen Eltern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
