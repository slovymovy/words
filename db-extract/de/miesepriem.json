                "senses": [
                    {
                        "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                        "entry_id": "ed7218da-599b-3255-9271-3aa4ee0a9065",
                        "glosses": [
                            "Person, die Vieles schlecht findet oder macht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a8e4f28f-01ab-4ad9-891b-fc59f7484523",
                                "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                                "text": "„Das muß sich wohl irgendein Miesepriem ausgedacht haben, um die Leute zu kujonieren.“"
                            },
                            {
                                "example_id": "40a1945b-9166-4f23-b156-9204df629cc9",
                                "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                                "text": "„Dieser Kerl war ein richtiger Miesepriem, ein ekelhafter Kotzbrocken.“"
                            },
                            {
                                "example_id": "e947cdc8-0012-47d3-9ec0-ce877e2e314b",
                                "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                                "text": "„Wißt ihr, daß dieser Miesepriem in der Partei gewesen ist?“"
                            },
                            {
                                "example_id": "6a564f32-c5a0-4902-bcec-b27885d82d68",
                                "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                                "text": "„Hejsan, du alter Miesepriem, sagte ich und ging.“"
                            },
                            {
                                "example_id": "b0f229ce-30ca-43ec-8f5e-120c80bb4083",
                                "sense_id": "9e447492-dd4f-3975-a44d-b21fb381119d",
                                "text": "„Solche Gäste habe ich doch lieber als so trockene Miesepriems, das wißt ihr beide doch auch“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
