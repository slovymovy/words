                    "frequency": "Middle",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Geburtstag <w>fällt</w> in diesem Jahr glücklicherweise auf einen sonnigen Sonntag."
