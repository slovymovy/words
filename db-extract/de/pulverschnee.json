                                    {
                                        "sense_id": "40f708ac-fda9-3ba5-8713-7f400fb61512",
                                        "entry_id": "f1c9f8e8-e0be-3207-8506-20cbbd84f97d",
                                        "glosses": [
                                            "Neige peu compacte et légère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc9c92a-65f4-4187-9c7a-f6f9a0ac856e",
                                                "sense_id": "40f708ac-fda9-3ba5-8713-7f400fb61512",
                                                "text": "C'est donc dans la poudreuse jusqu'à la taille qu'ils apprivoisent l'usage de la motoneige en territoire escarpé et boisé."
                                            },
                                            {
                                                "example_id": "54c6b986-9c55-4b2a-836d-2784e0345b37",
                                                "sense_id": "40f708ac-fda9-3ba5-8713-7f400fb61512",
                                                "text": "À 40 minutes de Québec, on a l'impression que nos raquettes s'enfoncent dans la ouate tellement la poudreuse est humide, le temps doux aidant."
                                            },
                                            {
                                                "example_id": "571de279-2e08-49dc-b4cb-ed8439f8ab7d",
                                                "sense_id": "40f708ac-fda9-3ba5-8713-7f400fb61512",
                                                "text": "Imaginez si on devait passer d’une belle journée chaude au golf et souper sur la terrasse à un lendemain de rafales et 40 centimètres de poudreuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2562350f-3032-3b57-ac65-d3f1f628a3a5",
                                        "entry_id": "f1c9f8e8-e0be-3207-8506-20cbbd84f97d",
                                        "glosses": [
                                            "Coiffeuse, petite table de toilette, de maquillage, munie d'un miroir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0639c45-eeeb-4b39-86d2-ea1ade9a2dcd",
                                                "sense_id": "2562350f-3032-3b57-ac65-d3f1f628a3a5",
                                                "text": "… que l'ébéniste a doté de pieds tournés de même style ; et les meubles sont authentiques, sauf une poudreuse et le lit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f7b2a7-9c53-36fc-bdc2-177e83617b01",
                                        "entry_id": "f1c9f8e8-e0be-3207-8506-20cbbd84f97d",
                                        "glosses": [
                                            "Appareil destiné à disperser une poudre quelconque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f4720a2-f2de-3700-b0c6-21e3f9c67094",
                                        "entry_id": "f1c9f8e8-e0be-3207-8506-20cbbd84f97d",
                                        "glosses": [
                                            "Appareil destiné à disperser une poudre quelconque.",
                                            "Appareil destiné à disperser du sucre, de la farine, etc., sans faire de grumeaux, de manière régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3446c40-9e09-4166-b713-628ba3bbf17a",
                                                "sense_id": "3f4720a2-f2de-3700-b0c6-21e3f9c67094",
                                                "text": "Saupoudrez-le régulièrement et généreusement de sucre glace, avec une poudreuse si possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a54667-29ca-36c2-a025-3854087356ea",
                                        "entry_id": "f1c9f8e8-e0be-3207-8506-20cbbd84f97d",
                                        "glosses": [
                                            "Appareil destiné à disperser une poudre quelconque.",
                                            "Appareil agricole que l'on utilise à la main pour diffuser des produits phytosanitaires sous forme de poudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0452006-f87b-447a-a00d-197192a9fc35",
                                                "sense_id": "d1a54667-29ca-36c2-a025-3854087356ea",
                                                "text": "Il faut également une poudreuse ( pour les produits pulvérulents, comme le soufre, le lithothamne, les poudres de roches ) et un pulvérisateur, pour les produits liquides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poudreuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "175fb4da-1035-350c-8da6-d6fdc4ab1d81",
                                        "entry_id": "2e423f31-c46c-39d4-8e51-da466312a48e",
                                        "glosses": [
                                            "Féminin singulier de poudreur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "poudreuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba17781f-720f-3ae3-8764-8f257301f342",
                                        "entry_id": "5b3fa2b9-1ba5-3ef9-8a3b-ce826a5250a9",
                                        "glosses": [
                                            "Féminin singulier de poudreux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fb3377-7d4e-4f25-8fb3-2ef760a1db8e",
                                                "sense_id": "ba17781f-720f-3ae3-8764-8f257301f342",
                                                "text": "Lorsque j’aurai quitté la robe poudreuse du voyage, je me tiendrai devant toi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
