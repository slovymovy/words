                                                "example_id": "1282b97e-1eab-4a55-b194-e9fa228d2c99",
                                                "sense_id": "67927c53-6c09-3c11-98fb-8eea33855f01",
                                                "text": "Even at this late date, vaselining will preserve the best of these leathers."
                                            }
