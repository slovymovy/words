                    },
                    {
                        "form_id": "0abaf959-caaa-4591-bcd7-ed4caf3f62c4",
                        "entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "tags": [
                            "feminine"
                        ],
                        "form": "superviseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a5a428e-afdb-3832-8b44-07d40b2051f3",
                        "entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "glosses": [
                            "Celui qui supervise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc347d7-1da4-414e-89bd-7f4c5f9d2bef",
                                "sense_id": "3a5a428e-afdb-3832-8b44-07d40b2051f3",
                                "text": "… comme s'il s'agissait de la Quentin philosophale de la flicaille, celle capable de résoudre les crimes jamais élucidés qui balisent la carrière des détectives dans le discours de leur superviseur le jour de leur départ à la retraite."
                            }
                        ]
                    },
                    {
                        "sense_id": "3afdbdd1-ce6b-3606-a1b4-f3d00016c558",
                        "entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "glosses": [
                            "Logiciel incorporé dans un système d’exploitation dont le but est de contrôler l’enchaînement et la gestion des processus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "75a714b6-4b9e-3920-8047-b4ea8a49e1fd",
                        "entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "glosses": [
                            "Noyau du système d’exploitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7d4c74-e25c-4b79-a87c-40f5e8b2eb50",
                                "sense_id": "75a714b6-4b9e-3920-8047-b4ea8a49e1fd",
                                "text": "Le mode privilégié est aussi appelé mode superviseur, ou mode noyau."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab109fcf-30b5-3d85-8f5d-a337f476e527",
                        "entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "glosses": [
                            "compte utilisateur d'un système d’exploitation. Droit d'accès au système d’exploitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e7d9e0-957b-4ce8-8f45-b5b25ca36c9d",
                                "sense_id": "ab109fcf-30b5-3d85-8f5d-a337f476e527",
                                "text": "En tant qu'administrateur, superviseur ou utilisateur disposant de droits d'administrateur ou de superviseur, du serveur NetWare, vous pouvez conserver des versions de sauvegarde des fichiers de votre serveur NetWare et les restaurer rapidement et aisément en cas de perte ou de détérioration des fichiers originaux."
                            },
                            {
                                "example_id": "0d5b27ac-2f56-4b38-891f-2a1b82d418cd",
                                "sense_id": "ab109fcf-30b5-3d85-8f5d-a337f476e527",
                                "text": "Le niveau de privilège administrateur est obtenu par l'affectation du droit superviseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95dbb237-52ae-41fa-9495-7fd7a44b7e75",
                        "source_entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "source_sense_description": "Personne qui supervise",
                        "target_lang_word": "Aufsichtsperson",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufsichtsperson",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b425a6c7-0aac-3dcd-a702-0726fc5f7562",
                                        "entry_id": "58467fed-c417-327b-a28d-ae9665027447",
                                        "glosses": [
                                            "Person, die auf jemanden oder etwas aufpasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946c7d59-24fe-463c-b9a5-08e743f69902",
                                                "sense_id": "b425a6c7-0aac-3dcd-a702-0726fc5f7562",
                                                "text": "„Ein Beispiel aus der Lebensmittelindustrie sind Abfüllstationen für Joghurt in einer Molkerei; die Aufsichtsperson greift nur bei Störungen ein, ansonsten ist der Prozeßbereich durch Trennschürzen separiert (Bild 3).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fc90751-88ba-35d7-9e73-2f43777f6b85",
                                        "entry_id": "58467fed-c417-327b-a28d-ae9665027447",
                                        "glosses": [
                                            "Mitarbeiter eines Unfallversicherungsträgers, der für Maßnahmen zur Verhütung von Arbeitsunfällen, Berufskrankheiten und dergleichen zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e380efbc-4620-47cd-a5b4-624939af29a8",
                        "source_entry_id": "23a7106b-63e9-3dad-b8f3-11570619dab4",
                        "source_sense_description": "Personne qui supervise",
                        "target_lang_word": "supervisor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supervisor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person with the official task of overseeing the work of a person or group, or of other operations and activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cfc99c-1615-4e69-b012-f297fabebf3f",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "Thus, today, even if the objective does seem \"goalish,\" the supervisor assumes the problem inherent in trying to \"accomplish\" that goal will become clear to the librarian as the action plan evolves […]"
                                            },
                                            {
                                                "example_id": "e09c0214-e7de-429a-8958-4db00952d45e",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "The 1999 merger between Citibank (banking) and Travelers (insurance) created the model for megafinance and confirmed new challenges for supervisors."
                                            },
                                            {
                                                "example_id": "f1e84074-d228-4cad-91dc-decaff7678fd",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "I had learned a lot about supervising by observing other supervisors—the good things and the not-so-good things they did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person who monitors someone to make sure they comply with rules or other requirements set for them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e31c2-abd6-45e9-86dc-e01aa45040ce",
                                                "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                                "text": "Kashruth fraud in Brooklyn. Seems a goon squad of fake mashgichim or kosher supervisors have been making their way around the neighborhoods pulling surprise ‘inspections’ on different shops and restaurants, selling them fancy-looking certificates to put in the window […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d33c2c-7d5e-3497-aa27-882948a3f75e",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "In certain states, an elected member of the governing body for a county which is called the board of supervisors."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A process responsible for managing other processes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0229415-a935-4b10-9190-e9aad4f70c65",
                                                "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                                "text": "The clock burst which enables the supervisor to housekeep the console input and output and to change program status is currently set to 200 ms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
