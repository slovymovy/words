                            {
                                "example_id": "c720dfe2-46ef-4687-b910-635f4d00e905",
                                "sense_id": "f5691bb0-a20a-359f-b3ad-f223e355ff25",
                                "text": "Или в счастливых заботах на речке, в лесистом займище: рыбалка, купанье, грибы да ягоды."
                            }
                        ]
                    },
                    {
                        "sense_id": "896277bd-e2aa-36fb-8981-30a72fa0168f",
                        "entry_id": "d625b1b0-acd3-3895-af43-9651fd08db38",
                        "glosses": [
                            "место, где купаются"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8773a6-570a-4d03-a325-fd9b2693741f",
                                "sense_id": "896277bd-e2aa-36fb-8981-30a72fa0168f",
                                "text": "Фанагорийка пересыхает, но возле скалы Спасения попрежнему отличные купанья."
                            }
                        ]
                    }
