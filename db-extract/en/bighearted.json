                                            {
                                                "example_id": "9e82a9a6-4cd2-47dc-9280-35690e44fa80",
                                                "sense_id": "a42bef70-483d-35d5-b57e-42c1a79ea3b7",
                                                "text": "„Hauke schätzte vor allem die abendlichen Gespräche mit der großherzigen und lebensklugen Frau, die mit ihren fast neunzig Jahren mitten im Leben stand.“"
                                            },
                                            {
                                                "example_id": "9d4c676d-36c2-4683-9ba8-90259d1fdbc7",
                                                "sense_id": "a42bef70-483d-35d5-b57e-42c1a79ea3b7",
                                                "text": "Er ist ein großherziger Mensch."
                                            },
                                            {
                                                "example_id": "3c43986b-9e35-40a8-bd5c-5fd42add7385",
                                                "sense_id": "a42bef70-483d-35d5-b57e-42c1a79ea3b7",
                                                "text": "„Dann gilt mein Dank Eurem Vater, den ich als großherzigen und klugen Mann kennenlernen durfte.“"
                                            },
                                            {
                                                "example_id": "70663c67-db50-40c4-a757-bc9babb9016a",
                                                "sense_id": "a42bef70-483d-35d5-b57e-42c1a79ea3b7",
                                                "text": "„Marguerite, die sich mit ihrer großherzigen Stiefmutter regelrecht anfreundete, wurde zum Liebling der Familie und von ihrem Vater auf mehreren Bildern verewigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
