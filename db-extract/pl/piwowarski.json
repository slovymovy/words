                        "translation_id": "63db79b7-6641-4944-892c-2913cae81cd4",
                        "source_entry_id": "2ef460db-ae2d-3393-a4bb-4cb68ed1e68a",
                        "source_sense_id": "636f5f97-7cd6-3c39-bd15-77ad3eaa01e3",
                        "target_lang_word": "пивоваренный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пивоваренный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae3aaf6-8190-3138-8a11-de289e73cd8a",
                                        "entry_id": "a7f8cc55-5b26-3d31-b385-7fde530b33a2",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным пивоварение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82f961e-7a48-4275-b28b-b1a59b4281be",
                                                "sense_id": "5ae3aaf6-8190-3138-8a11-de289e73cd8a",
                                                "text": "Они ― широкие массы ― пили «Жигулёвское» с начала двадцатого века, а в рекламных публикациях использовалась торговая марка «Жигулёвское пиво», ставшая визитной карточкой самарского пивоваренного завода."
                                            },
                                            {
                                                "example_id": "e39c75af-fec0-4d5c-9c19-6068277ededb",
                                                "sense_id": "5ae3aaf6-8190-3138-8a11-de289e73cd8a",
                                                "text": "Компания Efes владеет также пивоваренными предприятиями в России, Казахстане, Украине и Румынии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab278f7-7048-35de-8324-47d14984a4bd",
                                        "entry_id": "a7f8cc55-5b26-3d31-b385-7fde530b33a2",
                                        "glosses": [
                                            "свойственный пивоварению, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3408e49-48b6-413e-98ed-aaa8ac219aca",
                                                "sense_id": "cab278f7-7048-35de-8324-47d14984a4bd",
                                                "text": "Пиво ― пенистый напиток из пивоваренного солода, хмеля и (или) продуктов, полученных в результате переработки пивоваренного хмеля (хмелепродуктов), питьевой воды, с применением или без применения зерна злаковых культур и продуктов их переработки .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
