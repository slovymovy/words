                    {
                        "translation_id": "cf57dc73-6def-4689-96fe-1b021481e412",
                        "source_entry_id": "6b0be566-3554-3b54-9bd0-4ed74fcec47b",
                        "source_sense_description": "military clothing",
                        "target_lang_word": "Tarnanzug",
                        "target_lang_code": "de",
