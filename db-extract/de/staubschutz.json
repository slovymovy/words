                "senses": [
                    {
                        "sense_id": "a4ea1122-94cb-33b5-baf5-a610e657e1ff",
                        "entry_id": "843105b6-62bd-3ba2-8f88-75d0bbedea7f",
                        "glosses": [
                            "Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die das Entstehen von Staub verhindert oder dessen Auswirkungen begrenzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd5dad6-991f-47df-b51f-6f93b26f4b25",
                                "sense_id": "a4ea1122-94cb-33b5-baf5-a610e657e1ff",
                                "text": "„Mit unseren modernen Prüfeinrichtungen in Straubing verfügt TÜV SÜD über alle notwendigen Kapazitäten, um IP-Schutzprüfungen für Wasser- und „Staubschutz“ durchzuführen. “"
                            },
                            {
                                "example_id": "1f41c6c8-79b3-482f-a971-5cda4d4ff384",
                                "sense_id": "a4ea1122-94cb-33b5-baf5-a610e657e1ff",
                                "text": "„Eine Röntgenkontrolle der an diesen Arbeitsplätzen eingesetzten Personen ist vorgesehen, ebenso eine Verbesserung des Staubschutzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc43aa17-1d50-3af6-a539-f0f5ab24673a",
                        "entry_id": "843105b6-62bd-3ba2-8f88-75d0bbedea7f",
                        "glosses": [
                            "Bauteil an einem Objekt, das dieses vor dem Einstauben schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e04edd-560c-4073-a6b4-f0a69844db2b",
                                "sense_id": "fc43aa17-1d50-3af6-a539-f0f5ab24673a",
                                "text": "„Der Staubschutz schützt die empfindlichen Wasserbettmatratzen optimal vor Staub, Salz und Körperasche (z.B. Schuppen) und erleichtert Ihnen erheblich die Pflege des Wasserbettes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
