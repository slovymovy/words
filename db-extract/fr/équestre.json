                                                "example_id": "b7dfff28-d409-42d8-8b73-ff7ca8f581f2",
                                                "sense_id": "3297ce79-50eb-39b9-8a6a-7e6717fe6f1f",
                                                "text": "Конный разъезд."
                                            },
