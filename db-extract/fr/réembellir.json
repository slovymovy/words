                "senses": [
                    {
                        "sense_id": "f34b94bd-b50e-3511-85cb-8ce5ee49be01",
                        "entry_id": "c094a73e-bea5-3f6a-a08a-ac823479a11d",
                        "glosses": [
                            "Embellir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4e8121-9c51-4314-a2e3-794d8369302c",
                                "sense_id": "f34b94bd-b50e-3511-85cb-8ce5ee49be01",
                                "text": "Je ferai de mon mieux pour l'honneur de notre France déchirée qu'il convient à ses fils-poètes de réembellir et de défendre."
                            },
                            {
                                "example_id": "e7bf8e63-23fa-422d-af85-471007cef86e",
                                "sense_id": "f34b94bd-b50e-3511-85cb-8ce5ee49be01",
                                "text": "(...) et embellir la vie, et la réembellir constamment, car elle a coûté et coûte beaucoup trop pour qu'on la méprise comme si elle ne valait rien."
                            }
                        ]
                    }
                ],
