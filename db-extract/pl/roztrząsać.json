                                        "sense_id": "91fda272-a39f-328d-8943-3e792b490068",
                                        "entry_id": "ba739271-2e32-370e-b5d1-7e954abdc17f",
                                        "glosses": [
                                            "A piece of material used as a cover (such as a bedspread)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3eac2a6-6c4e-463b-96b6-24b9702404bc",
                                                "sense_id": "91fda272-a39f-328d-8943-3e792b490068",
                                                "text": "Linen shawls and spreads show up in secondhand clothing stores like those in the row on St. Marks Place in New York City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c689ea0e-4bb0-38aa-a718-9db03173b937",
                                        "entry_id": "ba739271-2e32-370e-b5d1-7e954abdc17f",
                                        "glosses": [
                                            "A large meal, especially one laid out on a table."
