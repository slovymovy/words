                "senses": [
                    {
                        "sense_id": "d59319bb-ce34-3882-92f0-565b4134f18a",
                        "entry_id": "fab16620-c14e-311d-ba44-521730bc3746",
                        "glosses": [
                            "Wortgruppe (Phraseologismus) mit einer einheitlichen, lexikalisierten Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320f3fb6-da21-46b1-8bf3-b6772e172fb1",
                                "sense_id": "d59319bb-ce34-3882-92f0-565b4134f18a",
                                "text": "„Als entscheidendes Merkmal für ein Wortgruppenlexem gilt die »Stabilität der Besetzung«, die lexikalische Stabilität.“"
                            },
                            {
                                "example_id": "85d8fb19-596c-4e09-b38b-f7c821dc4431",
                                "sense_id": "d59319bb-ce34-3882-92f0-565b4134f18a",
                                "text": "Der allseits bekannte »Satz heiße Ohren«, den man sich einfangen kann, ist ein Wortgruppenlexem, dessen Bedeutung dem Sinn nach feststeht, die sich aber nicht mehr direkt aus den eingehenden Wörtern begreifen lässt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
