                        "entry_id": "52057a7d-a9d8-380a-a80e-31725af7f1c5",
                        "glosses": [
                            "Person, welche einen Doktortitel anstrebt; jemand, der seine Doktorarbeit erstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b1ab8f-fabf-4eda-8fa4-b415058f6997",
                                "sense_id": "55e1d9ff-c457-3126-91a7-50c2c42afb00",
                                "text": "Die Promovenden müssen zahlreiche Pflichtexemplare bei der Universität abliefern."
                            },
                            {
                                "example_id": "51f65933-1c1f-41fc-b99a-8667f344536c",
                                "sense_id": "55e1d9ff-c457-3126-91a7-50c2c42afb00",
                                "text": "Der Doktorvater sage dann, der Promovend lege sich zu wenig ins Zeug. Der Promovend beklage hingegen die fehlende Unterstützung."
                            }
                        ],
                        "sense_index_json": "\"1\""
