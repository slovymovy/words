                                    },
                                    {
                                        "sense_id": "374b56be-f7f2-3013-9852-1088f25534cb",
                                        "entry_id": "abf7792e-6db9-3875-978e-287cc1b4c301",
                                        "glosses": [
                                            "Habitant du Léon, pays au nord du Finistère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74698aa-0c94-477e-97e8-8fc0839466d7",
                                                "sense_id": "374b56be-f7f2-3013-9852-1088f25534cb",
                                                "text": "L’attitude même de l’habitant du Léon, […] fait songer à un être grandi à l’ombre du presbytère. La religion du Léonard n’est pas seulement […] une religiosité vague adultérée de superstitions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "011b0548-2ec7-4218-8d88-40b2c643d81e",
                        "source_entry_id": "c29776b0-6d86-3b6a-a386-aa560fe54bd2",
                        "source_sense_id": "02961054-faac-349c-83df-17504847cd83",
