                "senses": [
                    {
                        "sense_id": "991df48a-9b79-33b2-bb01-7c204326db9d",
                        "entry_id": "b228f061-2389-38c9-930c-55570baba515",
                        "glosses": [
                            "oenophile"
                        ],
                        "tags": [
                            "masculine",
