                                "target_senses": [
                                    {
                                        "sense_id": "afd35e25-c76e-31a7-ae28-af8fdc30a428",
                                        "entry_id": "c06939ee-cb1d-3942-b365-2ab607640a66",
                                        "glosses": [
                                            "Machine-outil de découpe équipé d’un disque (ou lame) denté, en rotation rapide, actionné par une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652c09aa-4cab-40bc-8e5b-f186a79d8c7f",
                                                "sense_id": "afd35e25-c76e-31a7-ae28-af8fdc30a428",
                                                "text": "Dans les scieries à mouvement continu on se sert d'une scie circulaire, simple disque en tôle d'acier dont la circonférence est garnie de dents semblables à celles des lames de scie ordinaire ; la vitesse dont elle est animée est très-considérable et dépasse souvent 500 tours par minute."
                                            },
                                            {
                                                "example_id": "e6fdecdd-cda8-4c8c-9db3-49667f5b6648",
                                                "sense_id": "afd35e25-c76e-31a7-ae28-af8fdc30a428",
                                                "text": "L'ensemble des matériaux et de l'équipement nécessaires (ce qui incluait le bois, une scie circulaire et son support, des perceuses-visseuses, forets et vis, une raboteuse électrique, de la peinture, des piquets, etc.) fut offert aux rangers par l'intermédiaire des deux acteurs non-aborigènes."
                                            },
                                            {
                                                "example_id": "dbcdf337-234a-45a2-af36-aa6bb97df692",
                                                "sense_id": "afd35e25-c76e-31a7-ae28-af8fdc30a428",
                                                "text": "Les policiers lyonnais entreprirent une vaste enquête nationale sur les détenteurs de scies circulaires portables, tandis que Bouclard reprenait plus sagement les éléments communs aux crimes précédents."
                                            }
                                        ]
                                    }
                                ]
                            }
