                "senses": [
                    {
                        "sense_id": "c4a89337-3ed4-35d6-96b2-b83964ae8703",
                        "entry_id": "4b35b957-629b-3e74-80d3-7f52df3ee8c0",
                        "glosses": [
                            "Forscher, der über Mitglieder gesellschaftlicher Eliten forscht"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "80806633-6654-4662-b595-cceec37d9e87",
                                "sense_id": "c4a89337-3ed4-35d6-96b2-b83964ae8703",
                                "text": "„Herr Hartmann, Sie sind Elitenforscher. Zählen Sie als Professor, der oft in den Medien auftaucht, selbst zur Elite?“"
                            },
                            {
                                "example_id": "56f77ab0-1bb5-4c61-ac96-6f8ced769287",
                                "sense_id": "c4a89337-3ed4-35d6-96b2-b83964ae8703",
                                "text": "„Herkunft ist für den Aufstieg ausschlaggebend, nicht Leistung, sagt Elitenforscher Michael Hartmann.“"
                            },
                            {
                                "example_id": "30a9c31f-891e-4081-8ba5-7e7186892da7",
                                "sense_id": "c4a89337-3ed4-35d6-96b2-b83964ae8703",
                                "text": "„Die Vorstände deutscher Unternehmen bestehen fast ausschließlich aus weißen deutschen Männern, stellt Elitenforscher Michael Hartmann im F.A.Z.-Gespräch fest.“"
                            },
                            {
                                "example_id": "7620477a-58ff-4f17-bd79-b9afcbdcd7d6",
                                "sense_id": "c4a89337-3ed4-35d6-96b2-b83964ae8703",
                                "text": "„Wichtig ist, sagt der Elitenforscher Michael Hartmann, schon als Kind den souveränen Umgang mit Macht erlernt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
