                ],
                "senses": [
                    {
                        "sense_id": "057d6fcf-ad5f-3ba2-8c92-860e1f8cabe7",
                        "entry_id": "c1e93cca-03e1-3882-9d0d-13041975828b",
                        "glosses": [
                            "Ensemble des sensations perçues lors du flairage ou de la mise en bouche d’un aliment : olfaction, goût et nociception."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "001dcf6d-45d9-438a-979a-63eb15aec36f",
                                "sense_id": "057d6fcf-ad5f-3ba2-8c92-860e1f8cabe7",
                                "text": "Influence du processus d'oxydation sur le développement du goût et de la flaveur des distillats de vin."
                            },
                            {
                                "example_id": "41701eed-179a-4997-b6b0-0726aa75aa53",
                                "sense_id": "057d6fcf-ad5f-3ba2-8c92-860e1f8cabe7",
                                "text": "On l’aura compris, il y a toujours du monde aux balcons quand il s’agit d’y débusquer les flaveurs du souper. Le nez au vent parfumé des cuisines intérieures, on soupçonne d’innombrables réjouissances gustatives, lesté d’une boîte de cassoulet ou de maquereaux au vin blanc au fond du sac à dos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
