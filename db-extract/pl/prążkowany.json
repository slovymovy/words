                ],
                "senses": [
                    {
                        "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                        "entry_id": "b67d65a4-538e-3987-90ba-ebd26bda30c1",
                        "glosses": [
                            "mający powierzchnię pokrytą prążkami, mający wzór w kształcie podłużnych, poprzecznych, skośnych, często kolorowych paseczków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae8c33c-96e2-4cdc-b07b-bed1ce7eff3d",
                                "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                                "text": "\"Mieszałam\" moje bikini, np. kwiatowy top, a do tego prążkowany dół"
                            },
                            {
                                "example_id": "ef9a5448-0720-4587-90ba-29262fac328f",
                                "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                                "text": "Podciągnął wysoko spodnie, ukazując prążkowane skarpety"
                            },
                            {
                                "example_id": "fd306b4c-4dda-4243-92cf-322f601bb68a",
                                "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                                "text": "Powierzchnia nasion może być gładka (…) niekiedy znów prążkowana i siatkowana"
                            },
                            {
                                "example_id": "bf218d53-158e-4385-a9a3-52376140a161",
                                "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                                "text": "Widziałem małe, żółtawe pszczółki i większe, tak zwane włoskie, czarno-prążkowane, jak siadając na kwiatach, to powojów, to wreszcie na żółtych kwiatkach bluszczów, zamiatały nogami słodki pył i obładowane odlatywały do ulów"
                            },
                            {
                                "example_id": "f5ad8ff1-fb0d-484d-b675-bf0d7c98f5a5",
                                "sense_id": "934656cf-ef64-37fd-b4f8-aeb130578dbf",
                                "text": "Krawcy są po prostu mordowani o udzielanie kredytów z długim terminem na paskowane i prążkowane garnitury"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
