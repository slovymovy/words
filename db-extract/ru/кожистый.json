                        "glosses": [
                            "имеющий толстую, плотную кожу или представляющий собой кожу, кожицу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d801dd-1e9c-43ea-9207-0e36df8f3c7f",
                                "sense_id": "2361275e-eda7-3933-bd54-7940394e0a3c",
                                "text": "Ирис кожистый."
                            },
                            {
                                "example_id": "4cb87954-e7be-4710-8594-114abae490fb",
                                "sense_id": "2361275e-eda7-3933-bd54-7940394e0a3c",
                                "text": "Кожистые листья."
                            },
                            {
                                "example_id": "2775d936-7671-4a0e-ab80-47fccd40116c",
                                "sense_id": "2361275e-eda7-3933-bd54-7940394e0a3c",
