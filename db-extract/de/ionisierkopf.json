                "senses": [
                    {
                        "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                        "entry_id": "5e1cfbbf-6fa6-33f5-b574-b28a56ffd65b",
                        "glosses": [
                            "Vorrichtung zur elektrostatischen Entladung über größere Distanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0514fa3-fee1-4388-b226-c6ae701df052",
                                "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                                "text": "„Mit DC-Ionisierköpfen wird der geschnittene Papierstapel nach dem Schneidmesser entladen, damit eine störungsfreie Ablage auf dem Papiertisch möglich ist.“"
                            },
                            {
                                "example_id": "31508d8a-1aaf-4918-8aa6-9cbd7d4392bc",
                                "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                                "text": "„Vorrichtung nach Anspruch 16, dadurch gekennzeichnet, daß die Entladestation (9) von einem mit mehreren Elektrodenspitzen (10) versehenen Ionisierkopf (12) gebildet ist, wobei die Elektrodenspitzen von einer Wechselhochspannung von etwa 5 KV gespeist werden.“"
                            },
                            {
                                "example_id": "0e42d5b7-0591-43b5-85fb-c28c2a381c6e",
                                "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                                "text": "„Durch die offene Bauweise des Ionisierkopfes und die Luftstromverstärkerdüse weist die 4110 eine marktführende Wirksamkeit auf: maximale Ionisierung und maximaler Luftstrom.“"
                            },
                            {
                                "example_id": "e9acaccc-6c15-4d06-b35f-a8ffa6671d21",
                                "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                                "text": "„Die in dem BH50 Ionisierkopf eingebaute antistatische Stäbe nutzen die Effekte der Luftausbreitung und der Ionisierung gleichzeitig aus, um einen ionisierenden Luftstreifen zu generieren, mit dem elektrostatische Ladungen auch über große Entfernungen neutralisiert werden können.“"
                            },
                            {
                                "example_id": "fd22d539-1083-466b-8d76-0b80123e4264",
                                "sense_id": "5aca68b0-9672-37a0-95d1-5bba62f14afe",
                                "text": "„Das Modell 935 besteht aus einem Ionisierkopf und einem integrierten Ventilatorsystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
