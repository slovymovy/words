                "senses": [
                    {
                        "sense_id": "927f69be-2635-32f5-b0ac-8e9be891d938",
                        "entry_id": "15f660c0-a8f1-3845-b15d-deded1a03e34",
                        "glosses": [
                            "Eingriff, der vorgenommen wird, um in einer akuten bedrohlichen Lage (schnell, provisorisch) Abhilfe zu schaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee991037-ccc7-48b3-bfaf-00f2b01ae662",
                                "sense_id": "927f69be-2635-32f5-b0ac-8e9be891d938",
                                "text": "„Die Zeit der Provisorien und kurzfristigen Notmaßnahmen zur Sicherung der Versorgung, die die frühe Nachkriegszeit in großem Maße geprägt hatten, war überwunden.“"
                            },
                            {
                                "example_id": "06ce7518-4911-4978-9872-2cd608a7a30a",
                                "sense_id": "927f69be-2635-32f5-b0ac-8e9be891d938",
                                "text": "„Ich bin mir selbstverständlich dabei bewußt, daß das nur eine vorübergehende Notmaßnahme sein kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
