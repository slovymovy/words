                                "example_id": "1c3d6020-3a69-482d-b314-9593f7f73a3a",
                                "sense_id": "9a10545c-21e0-3b82-8cc5-bf7343a2c757",
                                "text": "„Er konnte Bobbie van der Walt erkennen, eine einsame Figur hoch oben am Betongeländer der Schnellstraße.“"
                            }
