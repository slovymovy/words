                        "glosses": [
                            "Wiper à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55573dc5-e705-49c9-9119-bf38e388033e",
                                "sense_id": "bfc294b7-b822-30bf-9d72-d29b380390c9",
                                "text": "Maintenant je suis d'accord celui qui ne s'intéresse pas aux raids, qui ne peut se bloquer aucune soirée pour jouer, qui n'a pas envie de wiper et rewiper sur le même boss ne l'aura pas mais ça reste une récompense pour un fait de jeu précis et qui est censé être associé à une certaine difficulté, si on n'est pas près à aller au devant de celle-ci (qui n'est pas infaisable pour un joueur un minimum sérieux) alors pourquoi mériterait-on cette monture?"
                            },
                            {
                                "example_id": "28c070c9-aa70-42d4-9efe-e00c348e37ea",
                                "sense_id": "bfc294b7-b822-30bf-9d72-d29b380390c9",
                                "text": "On a tout le temps de wiper, de revenir, et de rewiper."
                            },
                            {
                                "example_id": "c4d0c168-3313-4f51-9cb0-8547bd5c6a03",
                                "sense_id": "bfc294b7-b822-30bf-9d72-d29b380390c9",
                                "text": "Bon bah toujours dispo pour rewiper moi :D"
                            }
                        ]
                    }
