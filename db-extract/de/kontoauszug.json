                "senses": [
                    {
                        "sense_id": "211da037-76dd-34dd-96b3-5f7b19a5f829",
                        "entry_id": "68d7eaad-b324-3525-a8d0-b2d23b3b7a9a",
                        "glosses": [
                            "Beleg, auf welchem alle Umsätze eines Bankkontos ersichtlich sind"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "02fb97b2-9a87-4dfa-b75b-0ecb884d8cc4",
                                "sense_id": "211da037-76dd-34dd-96b3-5f7b19a5f829",
                                "text": "Wenn die Kontoauszüge nicht am SB-Automat abgeholt werden, werden sie am Ende des Quartals zugeschickt."
                            },
                            {
                                "example_id": "c360bd53-937f-438a-b30c-a94ab7513c5b",
                                "sense_id": "211da037-76dd-34dd-96b3-5f7b19a5f829",
                                "text": "Er überprüfte den Kontoauszug auf seine Richtigkeit."
                            },
                            {
                                "example_id": "ff10a2c5-d5ba-4307-a5a4-3b978c456b3d",
                                "sense_id": "211da037-76dd-34dd-96b3-5f7b19a5f829",
                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                            },
                            {
                                "example_id": "91146b56-2224-4596-86c4-76d5bd4637bc",
                                "sense_id": "211da037-76dd-34dd-96b3-5f7b19a5f829",
                                "text": "„Er zieht einen mehrfach gefalteten Kontoauszug aus der Tasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
