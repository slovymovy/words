                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737cb174-530b-4b85-a173-aacc8477f7fd",
                                "sense_id": "91d7fac3-3092-34ac-b5ac-6ce396f58d68",
                                "text": "„Graham folgte ihnen, wobei er sich aufmerksam umsah, als er den Steinbruch passierte, wo einst die Steinköpfe behauen worden waren.“"
                            },
                            {
                                "example_id": "02b7b1ea-e556-4a8c-8625-bee2fbba8a7c",
                                "sense_id": "91d7fac3-3092-34ac-b5ac-6ce396f58d68",
                                "text": "„Sie stellten sich die Galerien vor, wie jedes Bild zerschlitzt und alle Statuen auf einen Haufen geworfen waren, als wäre es ein Massengrab aus Steinköpfen und abgetrennten Steinfingern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
