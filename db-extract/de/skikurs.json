                "senses": [
                    {
                        "sense_id": "3683b2e9-f458-3290-bdb3-1bb1c79a1197",
                        "entry_id": "1dcd6239-f0fa-38b1-bbfb-4e057c028e9a",
                        "glosses": [
                            "Lehrgang zum Erlernen einer Wintersportart in abschüssigem Gelände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36299540-3ed6-46dc-aa05-5780bb1acc79",
                                "sense_id": "3683b2e9-f458-3290-bdb3-1bb1c79a1197",
                                "text": "„Deshalb, und weil er sich weigert, einen Skikurs zu besuchen, kann man dem Bub die Grundkenntnisse erst mal selber beibringen.“"
                            },
                            {
                                "example_id": "0c74ba5e-54a0-49a3-8c32-7ee4dc048fd2",
                                "sense_id": "3683b2e9-f458-3290-bdb3-1bb1c79a1197",
                                "text": "„Eines schönen Tages – eines schönen Wintertages – würde auch er mit Stefnir ins Skarđsdalur-Skigebiet fahren, ihn zu einem Skikurs anmelden und vielleicht auch selbst einen neuen Anlauf wagen, es zu lernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
