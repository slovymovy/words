                    },
                    {
                        "sense_id": "17095971-7c14-39d7-a572-d4bdf0586429",
                        "entry_id": "8feb7abf-54b6-36ba-9842-8e5070e7483d",
                        "glosses": [
                            "osoba ujmująca rzeczywistość w sposób humorystyczny"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7c8db33-932b-4034-bd5c-103670d8d363",
                        "source_entry_id": "8feb7abf-54b6-36ba-9842-8e5070e7483d",
                        "source_sense_id": "43d75e96-c19b-374b-a259-c6b9f1a2f17f",
                        "target_lang_word": "humorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "921e3853-f8ac-3494-95a3-86760e67cb8e",
                                        "entry_id": "d5bbd6ec-e5f6-383a-a40e-fd6aeafa22a6",
                                        "glosses": [
                                            "Someone who believes that health and temperament are determined by bodily humours; a humoralist."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "996e9ef1-4c3d-351f-9ba7-47df102cf7ee",
                                        "entry_id": "d5bbd6ec-e5f6-383a-a40e-fd6aeafa22a6",
                                        "glosses": [
                                            "Someone subject to whims or fancies; an eccentric."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92732578-17f7-40e7-a7a6-e8eea824b4c0",
                                                "sense_id": "996e9ef1-4c3d-351f-9ba7-47df102cf7ee",
                                                "text": "She and the duke used to rally me upon my fondness for lord W—m, who was a sort of an humourist, and apt to be in a pet, in which case he would leave the company, and go to bed by seven o'clock in the evening."
                                            },
                                            {
                                                "example_id": "04135115-27a9-4576-a358-50d9c6ff4953",
                                                "sense_id": "996e9ef1-4c3d-351f-9ba7-47df102cf7ee",
                                                "text": "I called on him and found him a contemporary of Beauclerk and Langton at Trinity College, Oxford, and a man of reading and animation, but a kind of humourist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2786f25-9bc3-342c-aa15-219f8d590005",
                                        "entry_id": "d5bbd6ec-e5f6-383a-a40e-fd6aeafa22a6",
                                        "glosses": [
                                            "A humorous or witty person, especially someone skilled in humorous writing or performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b980096-5c5a-4ebe-bdc3-51c51b631bf4",
                                                "sense_id": "e2786f25-9bc3-342c-aa15-219f8d590005",
                                                "text": "Peter, after the manner of man at the breakfast table, had allowed half his kedgeree to get cold and was sniggering over a letter. Sophia looked at him sharply. The only letter she had received was from her mother. Sophia's mother was not a humourist."
                                            },
                                            {
                                                "example_id": "48cd56bc-3dee-4eb4-9aff-62aee9c7141e",
                                                "sense_id": "e2786f25-9bc3-342c-aa15-219f8d590005",
                                                "text": "Art Buchwald, who satirized the follies of the rich, the famous and the powerful for half a century as the most widely read newspaper humorist of his time, died Wednesday night in Washington."
                                            },
                                            {
                                                "example_id": "58bcd043-6a43-499d-ad48-d9c12279a073",
                                                "sense_id": "e2786f25-9bc3-342c-aa15-219f8d590005",
                                                "text": "But when it comes to conveying what made these people funny, what impact they had in their day and, especially, what debt they are owed by present-day humorists, Johnson doesn’t put much meat on the old bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788da9bd-6d57-3da8-abaa-6d6572176df7",
                                        "entry_id": "d5bbd6ec-e5f6-383a-a40e-fd6aeafa22a6",
                                        "glosses": [
                                            "One who studies or portrays the humours of people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64b06871-ddab-41fa-91f7-954ebbbd893c",
                        "source_entry_id": "8feb7abf-54b6-36ba-9842-8e5070e7483d",
                        "source_sense_id": "17095971-7c14-39d7-a572-d4bdf0586429",
                        "target_lang_word": "funnyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funnyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd03f72f-543b-3d5b-9015-5d6e053106e9",
                                        "entry_id": "40382bc3-22bd-3749-bbe1-a7775a90ef96",
                                        "glosses": [
                                            "comedian"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eb14590-4306-4945-ba4f-b445faac7350",
                                                "sense_id": "fd03f72f-543b-3d5b-9015-5d6e053106e9",
                                                "text": "To get the party started a professional funnyman was hired."
                                            },
                                            {
                                                "example_id": "cf3afcdb-3741-4047-afc6-90ea1bd960cf",
                                                "sense_id": "fd03f72f-543b-3d5b-9015-5d6e053106e9",
                                                "text": "From 1970 to 1974 he was one of the most familiar funnymen in Chicago: by day a heavily promoted personality journalist, by night a \"sit-down comic\" with a devoted following."
                                            },
                                            {
                                                "example_id": "3d6d0c77-65e3-4820-be8e-ce26e90e5483",
                                                "sense_id": "fd03f72f-543b-3d5b-9015-5d6e053106e9",
                                                "text": "As for Jones’s performance as Mandy Cohen, it united two leading facets of the funnyman’s repertoire: his fondness for female impersonation, and his passion for historical revisionism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "875b6aa6-f30b-4527-975c-b108987697ce",
                        "source_entry_id": "8feb7abf-54b6-36ba-9842-8e5070e7483d",
                        "source_sense_id": "17095971-7c14-39d7-a572-d4bdf0586429",
                        "target_lang_word": "joker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad9e5ef-fe27-3788-b00d-b0da619985d7",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A person who makes jokes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8a593d-2472-3143-84e9-9734c4386e14",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A funny person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fc4d605-369a-300e-8137-357b3132315a",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A jester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16b074f3-89ff-3767-87a8-f9555a3ff359",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A playing card that features a picture of a joker (that is, a jester) and that may be used as a wild card in some card games."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "Something kept in reserve that can be used to gain an advantage; a trump card."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6198425-59e1-4d44-8e07-5ca189363e01",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "Rebus decided to use their joker. 'Mr Lintz made a phone call to this office. He was talking for over twenty minutes.'"
                                            },
                                            {
                                                "example_id": "a47005c7-d1a8-4681-8adb-4be7108f5b13",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "Tash Wilson played her 'joker' , pulling her chair so close our legs were almost touching. 'Hey, Chris, do you want to go out sometime? All you've got to do is say the word.'"
                                            },
                                            {
                                                "example_id": "7080d0e6-b9a2-40f4-89c7-f84f42ff45a5",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "The director made me understand that my bubble of stardom could burst just as soon as it had been inflated if I didn't watch my attitude. Then he used his joker. I had an understudy so if I messed up or tried to create a scene, I would be summarily replaced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36926e8f-c6a0-3d3e-a927-20f048ec03a0",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "An unspecified, vaguely disreputable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5713a2d3-008f-4b46-9290-a792dbe4efdf",
                                                "sense_id": "36926e8f-c6a0-3d3e-a927-20f048ec03a0",
                                                "text": "Some joker keeps throwing eggs at my windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87048809-5a6e-3140-baf2-c2adf4d244fb",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "An unspecified, vaguely disreputable person.",
                                            "A loser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b302b7a5-1c66-42f4-b53c-b27758910a81",
                                                "sense_id": "87048809-5a6e-3140-baf2-c2adf4d244fb",
                                                "text": "Don't waste your breath on these jokers round here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480a0a5b-87f0-3382-a7d7-814e6725edf3",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A man."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A clause in a contract that undermines its apparent provisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7513ae7-c259-42d9-95ef-55e307b9bfb9",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Discussion of contracts and the many provisions contained therein led to a vote making it the sense of the convention that manufacturers should use a simple sales contract, free from jokers."
                                            },
                                            {
                                                "example_id": "5784fd73-457e-448e-bba3-053d9b2aa84b",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Then, sir, on page 12 of the agreement there is a joker clause, which provides for payments in addition to the ten per cent, […]"
                                            },
                                            {
                                                "example_id": "4cefa02a-01a0-4a82-9d77-b96eda4b04c7",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Stone claimed that there was a Joker in the contract, one clause (No. 2) calling for two weeks' notice and another (No. 8) calling for payment on a par-day basis after the first two weeks."
                                            },
                                            {
                                                "example_id": "cab65f81-7c8a-4355-8369-40e4661b2041",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "The object of these provisions is to prevent insertion of \"jokers\" or \"sleepers\" in bills and securing passage under the false color of the title."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5dad722-4489-3711-854a-d56309167100",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A friendly unit that acts as a suspected hostile unit in a military excercise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1998f197-b004-4c03-a006-cfe8bc7df216",
                                                "sense_id": "b5dad722-4489-3711-854a-d56309167100",
                                                "text": "Joker - A friendly track or contact acting as a \"suspect\" track for exercise purposes only. (STANAG 1241)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8f6add-5f73-36d9-8da4-eb544c9037a5",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "The option, in a pub quiz, of selecting one particular round in which one's team will score double points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c83afc9-e23e-4cda-b55f-de71e99e8655",
                                                "sense_id": "1b8f6add-5f73-36d9-8da4-eb544c9037a5",
                                                "text": "We used our joker as soon as the topic of sports was announced, since we are sport experts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39dfa485-0468-375f-9223-15ccd2ca63db",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A fairy chess piece that moves like the last piece that was moved by the opponent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a989fc43-f009-45fd-a09f-275f44cc57e5",
                                                "sense_id": "39dfa485-0468-375f-9223-15ccd2ca63db",
                                                "text": "The problem is that it would be difficult to use a joker offensively since you could never know how it was going to move, meaning it’d be most useful setting it up for potential queen/rook captures to disincentivize your opponent from moving those pieces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
