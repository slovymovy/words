                                "example_id": "773c01a7-4924-4f61-87d1-6e2fdb6d8c45",
                                "sense_id": "ba041cfb-95f6-3b01-896b-b98c25cf2c69",
                                "text": "Zatrzymały się w domu rekolekcyjnym archidiecezji katowickiej."
