{
    "word_family": [
        "aurique"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcbbfa6c-8341-3e4d-9dfd-b50f88a541e4",
                    "sense_definition": "Troisième personne du singulier du futur de l'indicatif du verbe <w>avoir</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Demain soir, il y <w>aura</w> une grande fête dans le centre du village."
                        },
                        {
                            "text": "La réunion importante <w>aura</w> lieu dans la salle de conférence principale."
                        }
                    ],
                    "common_phrases": [
                        "il y aura",
                        "aura lieu",
                        "aura besoin"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aca09713-5e69-32e4-b3f0-18ebd9fd2493",
                    "sense_definition": "Prestige, rayonnement ou influence particulière qui émane d'une personne ou d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur d'histoire bénéficie d'une véritable <w>aura</w> auprès de tous ses étudiants."
                        },
                        {
                            "text": "L'acteur dégage une telle <w>aura</w> de mystère qu'il captive immédiatement le public."
                        }
                    ],
                    "synonyms": [
                        "prestige",
                        "rayonnement",
                        "charisme"
                    ],
                    "common_phrases": [
                        "perdre son aura",
                        "aura de mystère",
                        "bénéficier d'une aura"
                    ]
                },
                {
                    "sense_id": "bfcc5c29-84a9-38bf-b1f7-f5a93ccf686b",
                    "sense_definition": "Dans les croyances ésotériques, halo lumineux ou énergie subtile invisible qui entourerait le corps d'un être vivant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains guérisseurs affirment pouvoir percevoir la couleur de l'<w>aura</w> de leurs patients."
                        },
                        {
                            "text": "Elle prétend ressentir l'<w>aura</w> énergétique des personnes qui entrent dans la pièce."
                        }
                    ],
                    "synonyms": [
                        "halo",
                        "émanation"
                    ],
                    "common_phrases": [
                        "couleur de l'aura",
                        "voir l'aura"
                    ]
                },
                {
                    "sense_id": "32ab5d34-86b9-3af9-bab2-48c7c9fbe5f2",
                    "sense_definition": "Ensemble de manifestations neurologiques ou sensorielles subjectives précédant une crise, notamment dans la migraine ou l'épilepsie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a diagnostiqué une migraine avec <w>aura</w> après avoir examiné les troubles visuels du patient."
                        },
                        {
                            "text": "Cette sensation étrange constitue l'<w>aura</w> qui annonce systématiquement le début de la crise."
                        }
                    ],
                    "common_phrases": [
                        "migraine avec aura"
                    ]
                }
            ]
        }
    ]
}