    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f24f673e-cd03-3201-a190-43aeb62eb796",
                "word": "burnished",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13893ffd-9040-3161-aa18-cdb5a90f51cf",
                        "entry_id": "f24f673e-cd03-3201-a190-43aeb62eb796",
                        "glosses": [
                            "Polished, made shiny by rubbing (especially with a burnisher)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9914cae4-0dd7-4c76-a42d-3356f2d83824",
                                "sense_id": "13893ffd-9040-3161-aa18-cdb5a90f51cf",
                                "text": "The frame of burnish'd steel, that cast a glare\nFrom far, and seemed to thaw the freezing air."
                            },
                            {
                                "example_id": "0f6fdc68-b99e-4f61-88c0-15656afd0839",
                                "sense_id": "13893ffd-9040-3161-aa18-cdb5a90f51cf",
                                "text": "The house was a big elaborate limestone affair, evidently new. Winter sunshine sparkled on lace-hung casement, on glass marquise, and the burnished bronze foliations of grille and door."
                            },
                            {
                                "example_id": "6bbdeb27-7c62-4c69-a507-5498f8ce9909",
                                "sense_id": "13893ffd-9040-3161-aa18-cdb5a90f51cf",
                                "text": "Henchmen had placed, as was their habit, each warrior's gear and trappings above his pile of skins. Thus you could see the burnished helmet of each warrior set in readiness above his head. It was the Viking habit."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dc65af6-3461-3070-a0bd-52acfb12fea5",
                        "entry_id": "f24f673e-cd03-3201-a190-43aeb62eb796",
                        "glosses": [
                            "Blazing, bright."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3a24657d-7f7f-46ec-9ed9-a5b2ca33f2ba",
                                "sense_id": "2dc65af6-3461-3070-a0bd-52acfb12fea5",
                                "text": "Mor. Miſlike me not for my complexion,\nThe ſhadowed liuerie of the burniſht ſunne,\nTo whom I am a neighbour,and neere bred.\nBring me the faireſt creature North-ward borne,\nWhere Phœbus fire ſcarce thawes the yſicles,\nAnd let vs make inciſion for your loue,\nTo proue whoſe blood is reddeſt,his or mine."
                            }
                        ]
                    }
