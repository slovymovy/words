                "senses": [
                    {
                        "sense_id": "8da5f1f3-be1b-3a8e-9522-8f7cd9b208e6",
                        "entry_id": "205fdc18-97f2-3ebd-8833-59804e4675c1",
                        "glosses": [
                            "Producteur de ciment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc91e548-e51b-429e-a6a1-4154d2f7c77a",
                                "sense_id": "8da5f1f3-be1b-3a8e-9522-8f7cd9b208e6",
                                "text": "En faisant évoluer sa technologie, le cimentier français Lafarge a réussi à réduire de 40 % sa consommation de combustibles avec à la clé de très substantielles économies et un gain de compétitivité appréciable."
                            },
                            {
                                "example_id": "6c11d3d6-9697-4ee5-b809-7a41578b01ad",
                                "sense_id": "8da5f1f3-be1b-3a8e-9522-8f7cd9b208e6",
                                "text": "Des militants d’Extinction Rébellion ont occupé ce lundi matin deux sites des cimentiers Lafarge et Cemex (filiale d’un groupe mexicain) à Paris pour dénoncer l’impact de l’industrie du BTP sur l’environnement et le réchauffement climatique, a constaté l’AFP."
                            }
                        ]
                    }
