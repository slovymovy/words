                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460846b9-5e0e-42e7-9730-dbf79d8a6d7b",
                                "sense_id": "8ce32aad-6b71-3b6a-8b7b-6acfb1bd94a2",
                                "text": "Pour extirper la verrue, pour inciser l’apostème … il faut qu’ils soient à point.’’— (Eugène Sue, Les Mystères de Paris, 1843)"
                            },
                            {
                                "example_id": "91c7bd58-d270-400f-a0e4-b870942d53e3",
                                "sense_id": "8ce32aad-6b71-3b6a-8b7b-6acfb1bd94a2",
                                "text": "Quelques fois, par injection subcutanée, on obtient seulement un apostème local."
                            },
                            {
                                "example_id": "c146c551-add2-41d9-927b-06b89b97e6a1",
                                "sense_id": "8ce32aad-6b71-3b6a-8b7b-6acfb1bd94a2",
                                "text": "Le lendemain notre guide était si mal et ses membres si enflés par l’apostème de ses deux blessures, qu'il ne put aller plus loin. — (Daniel Defoe, Robinson Crusoé, 1719)"
                            }
                        ]
                    }
