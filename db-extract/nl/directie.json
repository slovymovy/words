                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6030aa66-639b-317f-80ed-91d64687c99d",
                                        "entry_id": "666ae106-2f2d-354e-8a44-755d433e6423",
                                        "glosses": [
                                            "Führungsperson in einem Unternehmen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d566a81-2a18-4a5e-8624-19522c236f71",
                                                "sense_id": "6030aa66-639b-317f-80ed-91d64687c99d",
                                                "text": "Ich kenne den Vorstand einer großen AG sehr gut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56db58c1-d345-39ee-82a2-89eb1d77be06",
                                        "entry_id": "666ae106-2f2d-354e-8a44-755d433e6423",
                                        "glosses": [
                                            "Führungsgruppe in einem Verein oder Unternehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237ed150-f2c9-45bc-a842-f72af9777c43",
                                                "sense_id": "56db58c1-d345-39ee-82a2-89eb1d77be06",
                                                "text": "Anlässlich der Planungen für die 1000-Jahr-Feier der Stadt tagten die Vorstände der örtlichen Vereine gemeinsam in der Turnhalle."
                                            },
                                            {
                                                "example_id": "f0afb000-d723-4af8-b5e6-af9bd4e20abd",
                                                "sense_id": "56db58c1-d345-39ee-82a2-89eb1d77be06",
                                                "text": "„Als sie mit der Wahl eines neuen Vorstands begannen, machte ich mich davon.“"
                                            },
                                            {
                                                "example_id": "3871cf0a-617f-4b1b-a751-cec652a13e81",
                                                "sense_id": "56db58c1-d345-39ee-82a2-89eb1d77be06",
                                                "text": "„Kompetenzstreitigkeiten bringen den Vorstand auseinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
