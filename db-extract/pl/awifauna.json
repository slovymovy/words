                "senses": [
                    {
                        "sense_id": "b6f70161-310f-37c9-b5c6-114e953d53b6",
                        "entry_id": "8077ccd5-3313-3321-8bb9-d380ff20409c",
                        "glosses": [
                            "ogół gatunków ptaków zamieszkujących określony obszar geograficzny, biotop lub żyjących w określonym okresie geologicznym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb85491-1f34-425e-973f-96585dafd57d",
                                "sense_id": "b6f70161-310f-37c9-b5c6-114e953d53b6",
                                "text": "Profesor wydał książkę o awifaunie Polski."
                            },
                            {
                                "example_id": "b19b4582-8251-41d4-b39b-555ecc4475cd",
                                "sense_id": "b6f70161-310f-37c9-b5c6-114e953d53b6",
                                "text": "Opisem awifauny zajmuje się dział ornitologii nazywany awifaunistyką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26238539-5d6c-41d9-8a7c-5b358b3b3a42",
                        "source_entry_id": "8077ccd5-3313-3321-8bb9-d380ff20409c",
                        "source_sense_id": "b6f70161-310f-37c9-b5c6-114e953d53b6",
                        "target_lang_word": "avifauna",
