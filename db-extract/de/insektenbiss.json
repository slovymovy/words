                    {
                        "translation_id": "7490d9c6-8cd5-4bd8-9480-faf6561021d5",
                        "source_entry_id": "531c5a19-06a1-39b9-8b7b-de6f26a3544a",
                        "source_sense_id": "34530e88-b8d8-3ac4-bbc6-7703e50acbf7",
                        "source_sense_description": "Biss, verursacht durch ein Insekt",
                        "target_lang_word": "insectenbeet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insectenbeet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe874a44-aa7f-3886-ad3b-539580284213",
                                        "entry_id": "94cfa3d1-ac4a-320e-b70e-48f6b371f3e3",
                                        "glosses": [
                                            "beschadiging van de huid door een beet met de monddelen van een insect waarbij het insect zich voedt met het bloed van het slachtoffer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29c5fc5-3ee6-4ca2-a440-3efd403648fb",
                                                "sense_id": "fe874a44-aa7f-3886-ad3b-539580284213",
                                                "text": "De insectenbeten veranderen in jeukende vulkanen en haar gedachten in oneindige lussen."
                                            },
                                            {
                                                "example_id": "e3515d88-c313-42a4-a32c-ca3a459108b1",
                                                "sense_id": "fe874a44-aa7f-3886-ad3b-539580284213",
                                                "text": "De ziekte wordt veroorzaakt door de bacterie Mycobacterium ulcerans. Na infectie geeft de bacterie gifstoffen af die huidcellen, bloedvaten en vet wegvreten. Aanvankelijk lijkt de zweer op een insectenbeet. Uiteindelijk wordt de plek een uiterst pijnlijke zweer."
                                            },
                                            {
                                                "example_id": "2bfb5ea8-c0f1-4376-9824-932c31cf68fe",
                                                "sense_id": "fe874a44-aa7f-3886-ad3b-539580284213",
                                                "text": "Verder wijst het onderzoek uit dat zes procent van de ondervraagden niet weet wat je moet doen na een insectenbeet. Daarnaast weet 21 procent niet hoe een teek op de juiste manier moet worden verwijderd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
