                ],
                "senses": [
                    {
                        "sense_id": "f3f6eb38-0418-3eee-b604-d415dd80ff73",
                        "entry_id": "75e7d0e2-edd1-3b86-92f8-005f34022882",
                        "glosses": [
                            "небольшая движущаяся, скользящая вдоль оси часть в различных механизмах, устройствах"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bf470b1f-ee35-3d19-9b4e-e669ab518186",
                        "entry_id": "75e7d0e2-edd1-3b86-92f8-005f34022882",
                        "glosses": [
                            "разг. то же, что двигатель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7252709b-a304-4a2e-abca-527bf84402ae",
                                "sense_id": "bf470b1f-ee35-3d19-9b4e-e669ab518186",
                                "text": "Окно было совсем светлым, на лестнице уже бухали чьи-то шаги, где-то невдалеке тарахтел на холостых тракторный движок, и его шум отдавался в голове неприятным звоном."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4adbbf2-b010-3d78-a3a4-927f1e94c0fa",
                        "entry_id": "75e7d0e2-edd1-3b86-92f8-005f34022882",
                        "glosses": [
                            "широкая лопата для уборки снега"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e9329c28-99f7-3c31-951e-d894e6fccf08",
                        "entry_id": "75e7d0e2-edd1-3b86-92f8-005f34022882",
                        "glosses": [
                            "комп. жарг. основная часть программной системы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea5ba29e-e055-4eab-a7de-9c0b6c09c1ac",
                                "sense_id": "e9329c28-99f7-3c31-951e-d894e6fccf08",
                                "text": "Шахматный движок оценивает позицию как равную"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57cf5512-c599-430d-adbf-4dbf5851c018",
                        "source_entry_id": "75e7d0e2-edd1-3b86-92f8-005f34022882",
                        "source_sense_description": "двигатель",
                        "target_lang_word": "engine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26b0f70b-f91c-310d-9a90-84a97531c6c1",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A large construction used in warfare, such as a battering ram, catapult etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b2d79ee-762f-42af-a4be-ca175a8e6d4e",
                                                "sense_id": "26b0f70b-f91c-310d-9a90-84a97531c6c1",
                                                "text": "Their warlike Engins and munition\nExceed the forces of their martial men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5318bd18-c43c-3cfa-84e3-05da8c70e244",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A tool; a utensil or implement."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950d88aa-545b-4298-81d3-fb1bbf6ab202",
                                                "sense_id": "5318bd18-c43c-3cfa-84e3-05da8c70e244",
                                                "text": "Flattery must be the most powerful Argument that cou'd be used to Human Creatures. Making use of this bewitching Engine, they extoll'd the Excellency of our Nature above other Animals [...]."
                                            },
                                            {
                                                "example_id": "aab287e0-a773-4ac0-aae0-00748dda814e",
                                                "sense_id": "5318bd18-c43c-3cfa-84e3-05da8c70e244",
                                                "text": "What if the Foot, ordain'd the duſt to tread, / Or Hand, to toil, aſpir'd to be the Head? / What if the Head, the Eye, or Ear repin'd / To ſerve mere Engines to the ruling Mind?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8a44c2-8b6a-3eb7-becd-76143f51e8b4",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A complex mechanical device which converts energy into useful motion or physical effects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "501df621-d130-3cc0-97fe-35a852fd3f1b",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A person or group of people which influence a larger group; a driving force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e331d75-22b0-42ec-8129-51a7e24430db",
                                                "sense_id": "501df621-d130-3cc0-97fe-35a852fd3f1b",
                                                "text": "In France, the parliament soon became a mere engine in the hands of a few high-born and ambitious men, who had nothing in common with its interests, which were those of the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02eceba-5504-3017-8024-f89037f62ac2",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "The part of a car or other vehicle which provides the force for motion, now especially one powered by internal combustion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "249bd107-ee6f-3082-9a9e-c78ffbffda3e",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A self-powered vehicle used for moving cars along a track."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "147425d0-191f-34d8-a3b7-abcd7def149c",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A self-powered vehicle used for moving cars along a track.",
                                            "A locomotive."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31c1be6f-60a0-3f91-bad4-18b7659be3b1",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "A software or hardware system responsible for a specific technical task (usually with qualifying word)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccefef3c-33e2-4f03-8669-764c74e4a875",
                                                "sense_id": "31c1be6f-60a0-3f91-bad4-18b7659be3b1",
                                                "text": "a graphics engine"
                                            },
                                            {
                                                "example_id": "de8881fc-744d-4483-8d9f-809b353c5fc2",
                                                "sense_id": "31c1be6f-60a0-3f91-bad4-18b7659be3b1",
                                                "text": "a physics engine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196d11dd-bfe3-38f4-a0d8-48f01a496a54",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "Ingenuity; cunning, trickery, guile."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f89b617-a9b7-31e4-b6bf-b366ede3cfe3",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "The result of cunning; something ingenious, a contrivance; (in negative senses) a plot, a scheme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0202a820-e6ae-46f0-9bf1-7e91a6df30c5",
                                                "sense_id": "5f89b617-a9b7-31e4-b6bf-b366ede3cfe3",
                                                "text": "Therefore this craftie engine he did frame, / Againſt his praiſe to ſtirre vp enmitye [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c4605e3-f744-3d75-bfb3-82bf9572493f",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "Natural talent; genius."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25b3ae62-88a3-39f7-b11a-b13279a4bc47",
                                        "entry_id": "b70bf5eb-61c4-33a8-a43e-e3bb80e9b098",
                                        "glosses": [
                                            "Anything used to effect a purpose; any device or contrivance; an agent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15cca22-c8fe-4afd-b8a0-5680f195c8a8",
                                                "sense_id": "25b3ae62-88a3-39f7-b11a-b13279a4bc47",
                                                "text": "[...] their promiſes, entiſements, oathes, tokens, and all theſe engines of luſt [...]."
                                            },
                                            {
                                                "example_id": "42a84dc0-8014-4ab8-a57a-67d0c77234d3",
                                                "sense_id": "25b3ae62-88a3-39f7-b11a-b13279a4bc47",
                                                "text": "You ſee the ways the Fiſher-man doth take / To catch the Fiſh; what Engins doth he make?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "engine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cba5b01-2c06-3a6a-9a7f-8c0d3fcf425f",
                                        "entry_id": "467f7142-b4de-364b-8337-bf0fc7d42f83",
                                        "glosses": [
                                            "To equip with an engine; said especially of steam vessels."
                                        ],
                                        "tags": [
                                            "dated",
