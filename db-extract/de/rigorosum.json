                "senses": [
                    {
                        "sense_id": "5daa7d96-1bcf-31e6-9a4e-f92cccbf5ac7",
                        "entry_id": "431eb7d3-90a8-395d-8280-5dc2bdca346f",
                        "glosses": [
                            "die mündliche Prüfung bei einer Promotion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1201965-77a1-489a-881e-f39d2e3ce574",
                                "sense_id": "5daa7d96-1bcf-31e6-9a4e-f92cccbf5ac7",
                                "text": "„Das im 19. Jahrhundert eingeführte sog. ‚Rigorosum‘ […] war eine ‚strenge‘ Prüfung, die im Gegensatz zu der älteren und heute wieder üblichen Disputation nicht auf die Themen der schriftlichen Doktorarbeit bezogen war.“"
                            },
                            {
                                "example_id": "41ef42f0-e547-43d6-af9c-f8bb91dee277",
                                "sense_id": "5daa7d96-1bcf-31e6-9a4e-f92cccbf5ac7",
                                "text": "„Er bereitete sich gerade auf seine Rigorosen vor, die er im Spätherbst und Winter ablegen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
