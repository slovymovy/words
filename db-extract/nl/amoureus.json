                    {
                        "translation_id": "213d5e58-a738-4a5e-b203-03609c883ae3",
                        "source_entry_id": "3b10fe55-aee0-3cf3-b7ce-88bcc5b5b1b3",
                        "source_sense_id": "4cdf4799-1498-3a55-a137-5d4251d11742",
                        "target_lang_word": "amoureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d74fddb3-37ff-38de-90ec-653e4890709d",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui aime d’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb16390-5afd-4429-8e0c-55eff98d5dea",
                                                "sense_id": "d74fddb3-37ff-38de-90ec-653e4890709d",
                                                "text": "Modeste n’est pas seulement amoureuse, elle aime quelqu’un ! répondit obstinément la mère."
                                            },
                                            {
                                                "example_id": "a89012e8-19ff-42ad-9017-76f914585720",
                                                "sense_id": "d74fddb3-37ff-38de-90ec-653e4890709d",
                                                "text": "Les deux frères devinrent amoureux de moi, chacun avec les nuances de son caractère."
                                            },
                                            {
                                                "example_id": "25ec72f1-07cc-423f-91b6-5024dd60da0e",
                                                "sense_id": "d74fddb3-37ff-38de-90ec-653e4890709d",
                                                "text": "Dès le lendemain du crime, je devins éperdument amoureux de Rosalie. Je songeai aussitôt à en faire ma maîtresse […]"
                                            },
                                            {
                                                "example_id": "619a4430-5f59-4a17-b65a-09cf1d3a11bf",
                                                "sense_id": "d74fddb3-37ff-38de-90ec-653e4890709d",
                                                "text": "– « Je me marie parce que je suis… amoureux », fit David un peu gêné.\nJoseph rougit fortement et baissa les yeux. Il eût préféré que David ne se servît pas de ce mot suspect qui semblait couvrir un péché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fded68ed-09a7-3f94-a200-a03ac2fc7ddb",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui est enclin à l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b787708-3a12-4ac8-bf87-d9f3bf452260",
                                                "sense_id": "fded68ed-09a7-3f94-a200-a03ac2fc7ddb",
                                                "text": "Être d’un tempérament amoureux, de complexion amoureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c064a7-2f33-3e84-b0b8-f2b26076faa2",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui exprime, qui marque de l’amour, qui est plein de sentiments d’amour, ou qui tend, qui est propre à inspirer de l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27da5ae4-bec7-4c96-a931-c86c525fc058",
                                                "sense_id": "d1c064a7-2f33-3e84-b0b8-f2b26076faa2",
                                                "text": "Bon vin, bons mots, gaillardes chansonnettes ;\nSont aiguillons aux amoureux désirs,\nEn toute porte entr’ouverte aux plaisirs\nL’adroit Amour aisément s’insinue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90b8c063-8af6-3709-b66b-e08ff4818c47",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui a une grande passion pour quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8759100a-37f8-442e-bd65-aab7520db975",
                                                "sense_id": "90b8c063-8af6-3709-b66b-e08ff4818c47",
                                                "text": "Être amoureux de la gloire, de la liberté. - Il est amoureux de la peinture. - Il est amoureux de tableaux."
                                            },
                                            {
                                                "example_id": "325ac6f1-3d95-42ee-b4d1-71412307425b",
                                                "sense_id": "90b8c063-8af6-3709-b66b-e08ff4818c47",
                                                "text": "Il ne pouvait croire que je fusse amoureux de ses vers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0f92a9-3ade-31aa-9484-700c97654320",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui est relatif à l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929f4f43-8afb-4a5e-933b-3eb8ceabffff",
                                                "sense_id": "5f0f92a9-3ade-31aa-9484-700c97654320",
                                                "text": "Et ce fut sans plus tarder, parmi la paille, préparée d’avance bien sûr, la culbute amoureuse, l’éclair des cuisses sans pantalon, l’étreinte farouche et brutale."
                                            },
                                            {
                                                "example_id": "5f96059b-0e87-4d36-be70-35da1a69cd94",
                                                "sense_id": "5f0f92a9-3ade-31aa-9484-700c97654320",
                                                "text": "Les excès amoureux donnent plus d’entraînement que de lassitude et sont moins difficiles à recommencer le lendemain que la semaine suivante."
                                            },
                                            {
                                                "example_id": "656bac6d-83b4-40e5-8caf-290a4c09b0cc",
                                                "sense_id": "5f0f92a9-3ade-31aa-9484-700c97654320",
                                                "text": "La jeune fille arabe est toujours un enfant, et c’est par là qu’elle donne le ton (de même que la vierge hellène) à la poésie amoureuse toute naïve qui refleurit depuis trois mille ans autour des mers levantines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1cd2ea3-69a1-3d3b-8a23-c023f991574f",
                                        "entry_id": "f3a9a535-bc38-3ffc-8bf3-97f4f72c035b",
                                        "glosses": [
                                            "Qui prend, retient bien l’encre."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "amoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                        "entry_id": "dbbbd7b1-88a2-3af5-a0ea-39603c546afd",
                                        "glosses": [
                                            "Celui qui aime d’amour ou que l'on aime d’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6e3799-53a5-4a98-9dda-203e53463c8a",
                                                "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                                "text": "Ma grand’mère, un soir à sa fête,\nDe vin pur ayant bu deux doigts,\nNous disait en branlant la tête :\nQue d’amoureux j’eus autrefois !"
                                            },
                                            {
                                                "example_id": "6d6ddf21-803b-4f1b-8bf6-4d8c46c3b480",
                                                "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                                "text": "[…] il avait eu jadis une amoureuse, mais qu’en l’année 92, il était parti pour la levée en masse à cause de l’invasion des Prussiens, et qu’à son retour à Fénétrange, il avait trouvé cette personne mariée, chose naturelle, puisqu’il ne s’était jamais permis de lui déclarer son amour ; […]"
                                            },
                                            {
                                                "example_id": "93807983-ca45-45ae-8566-fca9fa7d5162",
                                                "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                                "text": "Il était la proie de Carmen […]. Et non seulement il la subissait, mais encore il la recherchait, épris de sa chair de grande amoureuse lascive et insatisfaite, parfois ruée dans des débordements insensés, de quoi combler l'imagination la plus follement macérée dans les laves de l'érotisme épuisant."
                                            },
                                            {
                                                "example_id": "810d1ccf-3e45-43f5-947c-9234dddaf857",
                                                "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                                "text": "Maintenant, il retrouvait les traits fins, le regard chargé de douceur de sa petite amoureuse d’autrefois dans cette jeune femme […]"
                                            },
                                            {
                                                "example_id": "ca981f2d-1d28-4174-b526-1ff01139dbaf",
                                                "sense_id": "df12e1ec-8cce-35fe-bc6f-81978beaa649",
                                                "text": "Un couple d’amoureux s'était arrêté devant un comptoir de pizzas à emporter et se roulait une galoche sous la pluie fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c77ee7c-49f4-356e-bc04-7e307d212509",
                                        "entry_id": "dbbbd7b1-88a2-3af5-a0ea-39603c546afd",
                                        "glosses": [
                                            "Celui qui joue les personnages d’amoureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02384b3-3ae8-4d7b-bce5-8037601d26b9",
                                                "sense_id": "6c77ee7c-49f4-356e-bc04-7e307d212509",
                                                "text": "Rôle d’amoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e85c63a-ac63-386b-9cfe-c52c0c77f4c2",
                                        "entry_id": "dbbbd7b1-88a2-3af5-a0ea-39603c546afd",
                                        "glosses": [
                                            "Celui qui passionne pour une chose."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d28d86a-e797-4d96-afff-1b2cfd18dffc",
                                                "sense_id": "1e85c63a-ac63-386b-9cfe-c52c0c77f4c2",
                                                "text": "Rendez-vous incontournable des amoureux de la pyrotechnie, de la musique et de la poésie, le spectacle pyromélodique de Saint-Hilaire-de-Riez a lieu chaque année le troisième vendredi de juillet."
                                            },
                                            {
                                                "example_id": "7dae4ca9-2009-4f61-82ad-dc4995b9737b",
                                                "sense_id": "1e85c63a-ac63-386b-9cfe-c52c0c77f4c2",
                                                "text": "Reprenons : le gouvernement se fait régulièrement ridiculiser par les amoureux de la langue française qui, comme A. Genty et bien d’autres, ne ratent pas une occasion de montrer les conséquences, farfelues ou aberrantes, de certains oukases linguistiques, surtout en matière de féminisation (que diriez-vous par exemple de la sapeuse-pompière » ? mignon, non ?)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9489d27-9032-33ac-85f0-ee260162a33e",
                                        "entry_id": "dbbbd7b1-88a2-3af5-a0ea-39603c546afd",
                                        "glosses": [
                                            "Sixième atout du tarot de Marseille."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
