{
    "word_family": [
        "stainless",
        "stainer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a306f3c8-c988-3877-acf8-17759852bab0",
                    "sense_definition": "A discolored spot or area caused by spillage or other contact with certain fluids or substances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_discoloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a large coffee <w>stain</w> on the carpet that I cannot remove.",
                            "target_lang_translations": {
                                "ru": "На ковре большое кофейное <w>пятно</w>, которое я не могу вывести.",
                                "zh": "地毯上有一大块我去不掉的咖啡<w>污渍</w>。"
                            }
                        },
                        {
                            "text": "She tried to wash the grass <w>stain</w> out of his jeans before it dried.",
                            "target_lang_translations": {
                                "ru": "Она пыталась отстирать <w>пятно</w> от травы с его джинсов, пока оно не засохло.",
                                "zh": "她想趁草<w>渍</w>还没干，先把它从他的牛仔裤上洗掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spot",
                        "mark",
                        "blemish",
                        "blot",
                        "smudge",
                        "blotch"
                    ],
                    "common_phrases": [
                        "remove a stain",
                        "stubborn stain",
                        "blood stain",
                        "coffee stain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязное или обесцвеченное место на поверхности, возникшее от контакта с жидкостью или веществом.",
                        "zh": "因液体泼洒或接触某种物质而形成的变色斑点或污痕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "на поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污渍",
                                "target_lang_sense_clarification": "表面上因液体或其他物质留下的脏印或变色痕迹"
                            },
                            {
                                "target_lang_word": "污点",
                                "target_lang_sense_clarification": "衣物、布料等上的斑痕"
                            },
                            {
                                "target_lang_word": "渍",
                                "target_lang_sense_clarification": "口语中常说，尤指衣物上的脏印"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d9ba66-74dd-34ed-a37b-705406ad2389",
                    "sense_definition": "A substance used to soak into a surface and colour it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wood_coloring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a dark walnut <w>stain</w> to finish the new bookshelves.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>морилку</w> цвета темного ореха для отделки новых книжных полок.",
                                "zh": "我们买了深胡桃色的<w>木器着色剂</w>来给新书架做最后的处理。"
                            }
                        },
                        {
                            "text": "The main function of a <w>stain</w> is to enhance the wood's natural color.",
                            "target_lang_translations": {
                                "ru": "Основная функция <w>морилки</w> — подчеркнуть естественный цвет дерева.",
                                "zh": "<w>木器着色剂</w>的主要作用是增强木材的天然色泽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dye",
                        "tint"
                    ],
                    "common_phrases": [
                        "wood stain",
                        "apply stain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, впитывающееся в поверхность (обычно дерева) для придания ей цвета.",
                        "zh": "一种可渗入表面并使其着色的材料，通常用于木材。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морилка",
                                "target_lang_sense_clarification": "для дерева"
                            },
                            {
                                "target_lang_word": "пропитка",
                                "target_lang_sense_clarification": "состав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "木器着色剂",
                                "target_lang_sense_clarification": "涂在木材等表面、渗入后使其着色的材料"
                            },
                            {
                                "target_lang_word": "木材染色剂",
                                "target_lang_sense_clarification": "尤其指木材用的着色涂料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a3096c7-e722-3a45-aa78-145d8feb0549",
                    "sense_definition": "A blemish on one's character or reputation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal left a permanent <w>stain</w> on the politician's career.",
                            "target_lang_translations": {
                                "ru": "Скандал оставил несмываемое <w>пятно</w> на карьере политика.",
                                "zh": "这场丑闻在这位政治家的职业生涯上留下了永久的<w>污点</w>。"
                            }
                        },
                        {
                            "text": "He lived a life without any <w>stain</w> on his honor or integrity.",
                            "target_lang_translations": {
                                "ru": "Он прожил жизнь без единого <w>пятна</w> на своей чести и репутации.",
                                "zh": "他一生清白，名誉和品格上没有任何<w>污点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blemish",
                        "taint",
                        "blot",
                        "stigma",
                        "slur"
                    ],
                    "common_phrases": [
                        "stain on one's reputation",
                        "stain on one's character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток или позорный факт в чьей-либо репутации или характере.",
                        "zh": "某人品格或名誉上的污点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "на репутации"
                            },
                            {
                                "target_lang_word": "позорное пятно",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污点",
                                "target_lang_sense_clarification": "比喻名誉、人格或履历上的可耻之处"
                            },
                            {
                                "target_lang_word": "瑕疵",
                                "target_lang_sense_clarification": "较书面，指对名声的玷污"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04140403-9710-35dd-b3a7-966805a35eda",
                    "sense_definition": "A reagent or dye used to stain microscope specimens so as to make some structures visible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "microscopy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist used a blue <w>stain</w> to make the cells visible under the lens.",
                            "target_lang_translations": {
                                "ru": "Биолог использовал синий <w>краситель</w>, чтобы сделать клетки видимыми под линзой.",
                                "zh": "生物学家使用了一种蓝色<w>染色剂</w>，使细胞在镜下清晰可见。"
                            }
                        },
                        {
                            "text": "Without the proper <w>stain</w>, the bacteria are hard to distinguish from the background.",
                            "target_lang_translations": {
                                "ru": "Без правильного <w>красителя</w> бактерии трудно отличить от фона.",
                                "zh": "没有合适的<w>染色剂</w>，细菌很难与背景区分开来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dye",
                        "reagent"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Реагент или краситель, используемый для окрашивания микроскопических образцов.",
                        "zh": "用于给显微镜标本染色、从而使某些结构显现出来的试剂或染料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краситель",
                                "target_lang_sense_clarification": "вещество"
                            },
                            {
                                "target_lang_word": "окраска",
                                "target_lang_sense_clarification": "препарат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "染色剂",
                                "target_lang_sense_clarification": "显微镜样本处理中使用的染料或试剂"
                            },
                            {
                                "target_lang_word": "染剂",
                                "target_lang_sense_clarification": "实验室语境中的通称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59023ca4-1253-38d5-ac24-188ae8c80472",
                    "sense_definition": "One of a number of non-standard tinctures used chiefly in post-medieval heraldry, especially tenné, murrey, or sanguine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a rare <w>stain</w> that indicated a specific historical dishonor.",
                            "target_lang_translations": {
                                "ru": "На гербе было редкое <w>пятно</w>, указывающее на определенный исторический позор.",
                                "zh": "这枚纹章上用了罕见的<w>污色</w>，表示一种特定的历史耻辱。"
                            }
                        },
                        {
                            "text": "In heraldry, a <w>stain</w> is distinct from the standard metals and colors.",
                            "target_lang_translations": {
                                "ru": "В геральдике <w>пятно</w> отличается от стандартных металлов и цветов.",
                                "zh": "在纹章学中，<w>污色</w>不同于标准的金属色和普通颜色。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из нестандартных тинктур (цветов) в поздней геральдике.",
                        "zh": "纹章学中主要见于后中世纪的一类非常规 tincture（色类），如 tenné、murrey 或 sanguine。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "геральдика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污色",
                                "target_lang_sense_clarification": "纹章学中后中世纪使用的非常规色类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f4780e1-383d-3e4c-87d0-8e37bbc05cb4",
                    "sense_definition": "To discolor, as by spilling or other contact with a fluid or substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_discoloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>stain</w> your white shirt with the tomato sauce.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>испачкай</w> свою белую рубашку томатным соусом.",
                                "zh": "小心别让番茄酱把你的白衬衫<w>弄脏</w>了。"
                            }
                        },
                        {
                            "text": "The spilled wine will <w>stain</w> the tablecloth if you do not wash it immediately.",
                            "target_lang_translations": {
                                "ru": "Пролитое вино <w>оставит пятно</w> на скатерти, если ты не постираешь её немедленно.",
                                "zh": "如果你不马上洗，洒出来的葡萄酒会把桌布<w>染上污渍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soil",
                        "dirty",
                        "mark",
                        "discolor",
                        "smear"
                    ],
                    "antonyms": [
                        "clean"
                    ],
                    "common_phrases": [
                        "stain one's clothes",
                        "stain the carpet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обесцвечивать или пачкать поверхность жидкостью или веществом.",
                        "zh": "因液体或其他物质接触而使某物变色或留下污痕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "оставлять следы"
                            },
                            {
                                "target_lang_word": "сажать пятна",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "把衣物、表面等弄脏或留下痕迹"
                            },
                            {
                                "target_lang_word": "染上污渍",
                                "target_lang_sense_clarification": "使表面留下洗不掉的痕迹或变色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8b422cf-1eef-30cb-93a4-4162493840d7",
                    "sense_definition": "To become stained; to take a stain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_discoloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This fabric <w>stains</w> very easily, so handle it with care.",
                            "target_lang_translations": {
                                "ru": "Эта ткань очень легко <w>пачкается</w>, поэтому обращайтесь с ней осторожно.",
                                "zh": "这种布料很容易<w>沾上污渍</w>，所以要小心处理。"
                            }
                        },
                        {
                            "text": "My hands <w>stained</w> blue from the dye I was using.",
                            "target_lang_translations": {
                                "ru": "Мои руки <w>окрасились</w> в синий цвет от краски, которую я использовал.",
                                "zh": "我的手因为用了那种染料而<w>染成</w>了蓝色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stain easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко загрязняться или впитывать красящие вещества; покрываться пятнами.",
                        "zh": "变得有污渍；沾染上颜色或污痕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкаться",
                                "target_lang_sense_clarification": "быть марким"
                            },
                            {
                                "target_lang_word": "окрашиваться",
                                "target_lang_sense_clarification": "менять цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沾上污渍",
                                "target_lang_sense_clarification": "自己变脏、容易留下污痕"
                            },
                            {
                                "target_lang_word": "染色",
                                "target_lang_sense_clarification": "被染成某种颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bda0fdd-dd0d-3945-a08a-c627b5e9d1ff",
                    "sense_definition": "To taint or tarnish someone's character or reputation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His criminal record will <w>stain</w> his reputation forever.",
                            "target_lang_translations": {
                                "ru": "Его судимость навсегда <w>запятнает</w> его репутацию.",
                                "zh": "他的犯罪记录将永远<w>玷污</w>他的名声。"
                            }
                        },
                        {
                            "text": "She did not want to <w>stain</w> her family name with a public scandal.",
                            "target_lang_translations": {
                                "ru": "Она не хотела <w>пятнать</w> имя своей семьи публичным скандалом.",
                                "zh": "她不想让一场公开丑闻<w>玷污</w>家族名声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tarnish",
                        "taint",
                        "sully",
                        "damage"
                    ],
                    "antonyms": [
                        "honor"
                    ],
                    "common_phrases": [
                        "stain one's reputation",
                        "stain one's honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Портить или чернить чью-либо репутацию или честь.",
                        "zh": "玷污或败坏某人的品格、名誉或声望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "репутацию"
                            },
                            {
                                "target_lang_word": "опорочить",
                                "target_lang_sense_clarification": "честь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "使名誉、人格或家声受损"
                            },
                            {
                                "target_lang_word": "败坏",
                                "target_lang_sense_clarification": "较正式，指败坏名声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2016ed72-1ced-3d47-b425-217e2df83c6f",
                    "sense_definition": "To coat a surface with a stain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wood_coloring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>stain</w> the fence to protect it from the rain.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>покрыть морилкой</w> забор, чтобы защитить его от дождя.",
                                "zh": "他们打算给栅栏<w>刷木器着色剂</w>，以防雨淋。"
                            }
                        },
                        {
                            "text": "He <w>stained</w> the oak table to match the other furniture in the room.",
                            "target_lang_translations": {
                                "ru": "Он <w>покрыл морилкой</w> дубовый стол, чтобы тот сочетался с остальной мебелью в комнате.",
                                "zh": "他给那张橡木桌子<w>刷了木器着色剂</w>，让它和房间里的其他家具更搭配。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dye",
                        "color"
                    ],
                    "common_phrases": [
                        "stain the deck",
                        "stain wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность (обычно дерева) морилкой.",
                        "zh": "在表面上涂覆着色剂，通常指给木材上色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морить",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "покрывать морилкой",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刷木器着色剂",
                                "target_lang_sense_clarification": "在木材等表面涂上着色材料"
                            },
                            {
                                "target_lang_word": "给木材染色",
                                "target_lang_sense_clarification": "技术性较强，指给木材上色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e5cbbb3-b83f-300a-a9b3-6f3672145d55",
                    "sense_definition": "To treat a microscopic specimen with a dye, especially one that dyes specific features.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "microscopy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learned how to <w>stain</w> plant cells for observation in biology class.",
                            "target_lang_translations": {
                                "ru": "Студенты учились <w>окрашивать</w> растительные клетки для наблюдения на уроке биологии.",
                                "zh": "学生们在生物课上学习了如何给植物细胞<w>染色</w>以便观察。"
                            }
                        },
                        {
                            "text": "The lab technician <w>stained</w> the sample to identify the virus.",
                            "target_lang_translations": {
                                "ru": "Лаборант <w>окрасил</w> образец, чтобы идентифицировать вирус.",
                                "zh": "实验室技术员给样本<w>染色</w>，以识别这种病毒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dye"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
