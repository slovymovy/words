{
    "word_family": [
        "disposal",
        "disposable",
        "disposition",
        "disposed",
        "indisposed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d58d3fb-6f4f-3a64-b55c-b901d1cbd5c4",
                    "sense_definition": "To get rid of something that is no longer wanted or needed, typically by throwing it away.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>dispose</w> of hazardous waste at a specialized collection center.",
                            "target_lang_translations": {
                                "ru": "Важно <w>утилизировать</w> опасные отходы в специализированных центрах сбора."
                            }
                        },
                        {
                            "text": "The company needs to <w>dispose</w> of old equipment before moving to the new office.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо <w>избавиться</w> от старого оборудования перед переездом в новый офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "discard"
                    ],
                    "common_phrases": [
                        "dispose of waste",
                        "dispose of trash",
                        "properly dispose of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавиться от чего-либо ненужного, обычно путем выбрасывания или утилизации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избавляться",
                                "target_lang_sense_clarification": "от ненужных вещей или отходов"
                            },
                            {
                                "target_lang_word": "утилизировать",
                                "target_lang_sense_clarification": "перерабатывать или уничтожать отходы"
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться от мусора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84cc171-4958-33db-a833-742e62bb5fd9",
                    "sense_definition": "To arrange or position things in a particular order or way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interior designer will <w>dispose</w> the furniture to maximize the natural light in the room.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьера <w>расположит</w> мебель так, чтобы максимально использовать естественное освещение в комнате."
                            }
                        },
                        {
                            "text": "The general began to <w>dispose</w> his troops along the ridge to prepare for the defense.",
                            "target_lang_translations": {
                                "ru": "Генерал начал <w>расставлять</w> свои войска вдоль хребта, готовясь к обороне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dispose in order",
                        "dispose the furniture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагать или расставлять предметы в определенном порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать",
                                "target_lang_sense_clarification": "размещать в пространстве"
                            },
                            {
                                "target_lang_word": "расставлять",
                                "target_lang_sense_clarification": "помещать на определенные места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "242a88a9-b875-327a-bb75-5b373f186da4",
                    "sense_definition": "To make someone feel willing or likely to do something or to think in a certain way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His friendly manner tends to <w>dispose</w> people to trust him almost immediately.",
                            "target_lang_translations": {
                                "ru": "Его дружелюбная манера обычно <w>располагает</w> людей к доверию почти мгновенно."
                            }
                        },
                        {
                            "text": "The peaceful atmosphere of the library might <w>dispose</w> you toward quiet reflection.",
                            "target_lang_translations": {
                                "ru": "Мирная атмосфера библиотеки может <w>склонить</w> вас к тихим размышлениям."
                            }
                        }
                    ],
                    "synonyms": [
                        "incline"
                    ],
                    "antonyms": [
                        "indispose",
                        "disincline"
                    ],
                    "common_phrases": [
                        "dispose toward",
                        "dispose to believe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонять кого-либо к определенному мнению, чувству или действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать",
                                "target_lang_sense_clarification": "вызывать симпатию или доверие"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "побуждать к какому-либо мнению или решению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b43f9b29-2ea7-35e3-bd9b-93d29e56dd8c",
                    "sense_definition": "To regulate, settle, or determine the outcome of a matter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man proposes, but God <w>disposes</w> the final outcome of our earthly endeavors.",
                            "target_lang_translations": {
                                "ru": "Человек предполагает, а Бог <w>распоряжается</w> конечным исходом наших земных начинаний."
                            }
                        },
                        {
                            "text": "The committee has the power to <w>dispose</w> the case as they see fit.",
                            "target_lang_translations": {
                                "ru": "Комитет имеет право <w>разрешить</w> это дело так, как сочтет нужным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man proposes god disposes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулировать, решать или определять исход дела или вопроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжаться",
                                "target_lang_sense_clarification": "определять судьбу или исход чего-либо"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "урегулировать вопрос или спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f56c5aa6-c28c-3e8c-a789-ef093d7fc71f",
                    "sense_definition": "To come to terms or reach an agreement through bargaining.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat attempted to <w>dispose</w> with the rival faction to prevent further conflict.",
                            "target_lang_translations": {
                                "ru": "Дипломат попытался <w>договориться</w> с соперничающей фракцией, чтобы предотвратить дальнейший конфликт."
                            }
                        },
                        {
                            "text": "Historical records suggest she had <w>disposed</w> with the emperor before the treaty was signed.",
                            "target_lang_translations": {
                                "ru": "Исторические записи свидетельствуют о том, что она <w>договорилась</w> с императором еще до подписания договора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical contexts regarding negotiations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти к соглашению или договориться путем переговоров (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договариваться",
                                "target_lang_sense_clarification": "приходить к соглашению"
                            },
                            {
                                "target_lang_word": "улаживать",
                                "target_lang_sense_clarification": "разрешать разногласия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "415c47bf-5d9d-35fc-aff5-b85936caed92",
                    "sense_definition": "A person's inherent qualities of mind and character; their temperament or behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young prince was known for his noble <w>dispose</w> and kind heart.",
                            "target_lang_translations": {
                                "ru": "Молодой принц был известен своим благородным <w>нравом</w> и добрым сердцем."
                            }
                        },
                        {
                            "text": "Her gentle <w>dispose</w> made her a favorite among the staff at the manor.",
                            "target_lang_translations": {
                                "ru": "Ее кроткий <w>нрав</w> сделал ее любимицей среди персонала поместья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now usually replaced by the word disposition"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Врожденные качества ума и характера человека; темперамент (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нрав",
                                "target_lang_sense_clarification": "характер или темперамент"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "душевный склад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c746ce-5e50-3575-9bd0-d1d0c542302d",
                    "sense_definition": "The act of managing, controlling, or dealing with something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left the entire <w>dispose</w> of his estate to the wisdom of his executors.",
                            "target_lang_translations": {
                                "ru": "Он оставил все <w>распоряжение</w> своим имуществом на усмотрение своих душеприказчиков."
                            }
                        },
                        {
                            "text": "The king maintained absolute <w>dispose</w> over the distribution of the conquered lands.",
                            "target_lang_translations": {
                                "ru": "Король сохранял абсолютное <w>управление</w> распределением завоеванных земель."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now usually replaced by the word disposal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт управления, контроля или распоряжения чем-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "право или акт управления имуществом"
                            },
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "контроль над чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}