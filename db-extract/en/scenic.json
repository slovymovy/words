                                "sense_id": "4af86ec9-021e-3760-9f48-e256620ddb41",
                                "text": "We have plenty of time: let's take the scenic route."
                            },
                            {
                                "example_id": "96d02be6-a282-4584-a023-42a75fad0d65",
                                "sense_id": "4af86ec9-021e-3760-9f48-e256620ddb41",
