                "senses": [
                    {
                        "sense_id": "e3fee76d-58bd-306d-92ef-bfb17e6a1ea5",
                        "entry_id": "3a0c7fbf-a5ca-3a27-a957-215eda1580b9",
                        "glosses": [
                            "представитель народа, составляющего основное население Мексики; житель, уроженец или гражданин Мексики"
                        ],
                        "tags": [],
