                "senses": [
                    {
                        "sense_id": "434d392a-38dd-3e56-a603-b478819c02c9",
                        "entry_id": "e006c8e4-8ccd-39a7-b98a-d77843808f0d",
                        "glosses": [
                            "op de proef gesteld worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1c677a-e96e-4bcc-b5d2-6ecff62f3e03",
                                "sense_id": "434d392a-38dd-3e56-a603-b478819c02c9",
                                "text": "Ik kreeg een beproeving van mijn collega's om te stoppen met roken."
                            },
                            {
                                "example_id": "1025392a-ab6c-4c2b-8f42-8898ac0052d6",
                                "sense_id": "434d392a-38dd-3e56-a603-b478819c02c9",
                                "text": "Honger,dorst, koude en regen waren een zware beproeving voor de militairen in opleiding"
                            },
                            {
                                "example_id": "ee29c295-c8f4-4d84-b5a3-1642fa61e35c",
                                "sense_id": "434d392a-38dd-3e56-a603-b478819c02c9",
                                "text": "De Italiaanse premier Meloni is naar eigen zeggen ook erg verdrietig. \"Ik heb het voorrecht gehad om te genieten van zijn vriendschap, zijn raad en zijn lessen, die nooit verkeerd waren, zelfs niet in tijden van beproeving en lijden.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "7afbf34b-35a9-3caf-929b-35245d2b5c84",
                        "entry_id": "e006c8e4-8ccd-39a7-b98a-d77843808f0d",
                        "glosses": [
                            "iets dat heel moeilijk is en het uiterste van iemand vergt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f0a2ce5-6e26-467d-ae17-0d8a342ebddb",
                                "sense_id": "7afbf34b-35a9-3caf-929b-35245d2b5c84",
                                "text": "Er waren een paar zware beproevingen vorige week."
                            },
                            {
                                "example_id": "358c79a9-cea6-4daa-bb8f-ba6c62a4e68d",
                                "sense_id": "7afbf34b-35a9-3caf-929b-35245d2b5c84",
                                "text": "De eerste engel kwam tijdens mijn beproeving op Mount Whitney heel sterk in mijn gedachten bij me binnen. Die engel was mijn vrouw, met wie ik al 20 jaar samenleef, die altijd weer mijn ogen opent om dankbaar en tevreden te zijn met mijn leven."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
