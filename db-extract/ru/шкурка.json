                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9eae39f5-df44-3bb3-a190-ee2bebd3013c",
                        "entry_id": "6c5964fc-e128-396b-b280-1355fca02633",
