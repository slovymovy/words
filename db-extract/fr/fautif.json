                                "target_senses": [
                                    {
                                        "sense_id": "f5b4bd60-6749-3e0a-bc43-19d97d458cef",
                                        "entry_id": "4ed7c862-e4fd-3c10-bc9f-1777029ad454",
                                        "glosses": [
                                            "Having or displaying faults; not perfect; not adequate or acceptable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2232db-fa06-4092-862b-8641cab4af74",
                                                "sense_id": "f5b4bd60-6749-3e0a-bc43-19d97d458cef",
                                                "text": "They replaced the faulty wiring and it has worked fine ever since."
                                            },
                                            {
                                                "example_id": "6d8c3c5b-6233-4b25-b135-8666457caf04",
                                                "sense_id": "f5b4bd60-6749-3e0a-bc43-19d97d458cef",
                                                "text": "I don't think you can infer that from the premise. It's a faulty argument."
                                            },
                                            {
                                                "example_id": "65864a8a-b79b-4ba0-8cc1-3b55b3f51b4b",
                                                "sense_id": "f5b4bd60-6749-3e0a-bc43-19d97d458cef",
                                                "text": "Sadly, the ever-eager Reverend Judith had not been able to conjure up many worshippers, even though it was Father’s Day. There was just one old dear sitting halfway back, her faulty hearing aid letting off a high-pitched whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa8b9231-c6d7-3291-a2c1-015085a9b391",
                                        "entry_id": "4ed7c862-e4fd-3c10-bc9f-1777029ad454",
                                        "glosses": [
                                            "At fault, to blame; guilty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893e60a3-050a-4711-a71e-5ee801210731",
                                                "sense_id": "aa8b9231-c6d7-3291-a2c1-015085a9b391",
                                                "text": "Her faultie Handmayd, which that bale did breede, / Confest, how Philemon her wrought to chaunge her weede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
