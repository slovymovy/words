                ],
                "senses": [
                    {
                        "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                        "glosses": [
                            "Wegbereiterin, Bahnbrecherin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f1216f2-a2f8-4d50-b39f-cdbc08f2bdd9",
                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                "text": "Sie war ein Pionierin der Genderwissenschaft."
                            },
                            {
                                "example_id": "b505c2ef-9c7e-4b33-9761-6d2a4d3bff7a",
                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                "text": "„Und so brach sie als Pionierin, die sie war, auf in ein neues Abenteuer.“"
                            },
                            {
                                "example_id": "5eef4c50-984b-4cb4-8a65-5dfb5cd424b1",
                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                "text": "„London war in der frühen Neuzeit nicht nur eine der am schnellsten wachsenden Städte der Welt, sondern wohl auch die dreckigste. Sie wurde zur Vorreiterin in Sachen Vermüllung – aber auch zu einer Pionierin moderner Abfallbeseitigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2aa45632-f135-3725-828d-0776b28fab0c",
                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                        "glosses": [
                            "Angehörige einer Pioniertruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28128e08-87f3-4961-a10f-e31e05df4e03",
                                "sense_id": "2aa45632-f135-3725-828d-0776b28fab0c",
                                "text": "Die Pionierinnen sprengten eine Brücke."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c48fc43f-95a0-3aa0-83fe-fa49cd86dd7d",
                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                        "glosses": [
                            "Angehörige einer Kinderorganisation der führenden Partei"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1c5a31bc-a4a1-4c71-9d2f-d4c2f227b961",
                                "sense_id": "c48fc43f-95a0-3aa0-83fe-fa49cd86dd7d",
                                "text": "Die Pionierinnen übten im Wald."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
