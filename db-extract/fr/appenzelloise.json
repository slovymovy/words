                                    {
                                        "sense_id": "64d68541-4b08-3ba0-b8b0-447b3b01a425",
                                        "entry_id": "194add42-cf42-3775-9eb4-b664f60e5a33",
                                        "glosses": [
                                            "Bürgerin eines der beiden Schweizer Halbkantone Appenzell Ausserrhoden und Appenzell Innerrhoden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c1cdb14-b41d-4af4-8f28-765d304ac645",
                                                "sense_id": "64d68541-4b08-3ba0-b8b0-447b3b01a425",
                                                "text": "Ruth Metzler ist Appenzellerin."
                                            },
                                            {
                                                "example_id": "3c8e522f-7e7b-43b4-97d8-550d1ca480b9",
                                                "sense_id": "64d68541-4b08-3ba0-b8b0-447b3b01a425",
                                                "text": "„Sophie Taeuber wurde in Davos-Platz als fünftes Kind des aus Preussen stammenden Apothekers Emil Taeuber und seiner Frau Sophie Taeuber-Krüsi, einer Appenzellerin aus Gais, als Deutsche geboren.“"
                                            },
                                            {
                                                "example_id": "66d7c380-6d9d-47e5-b4ad-e8a74fa7097a",
                                                "sense_id": "64d68541-4b08-3ba0-b8b0-447b3b01a425",
                                                "text": "„Doch ein Problem war damit nicht vom Tisch: Wie sollten die Appenzellerinnen ihr Zutrittsrecht zur Landsgemeinde, zu jener Versammlung unter freiem Himmel, an der politische Hauptfragen entschieden werden, symbolisieren?“"
                                            },
                                            {
                                                "example_id": "af40ff93-37fc-4a5e-adea-5e2a0d9001b2",
                                                "sense_id": "64d68541-4b08-3ba0-b8b0-447b3b01a425",
                                                "text": "„Auf der \"Sonnenwiese\" in St. Anton verwies die 28-jährige Appenzellerin die Italienerin Karen Putzer und die erste 19 Jahre alte Slalom-Weltmeisterin Anja Paerson aus Schweden auf die Plätze zwei und drei und sicherte sich damit den ersten WM-Titel ihrer Karriere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
