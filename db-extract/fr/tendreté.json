            {
                "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                "word": "tendreté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07870ba0-25be-45e0-9c53-b51c72add83a",
                        "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "tags": [
                            "plural"
                        ],
                        "form": "tendretés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64c77331-dc5d-3a94-8631-0eddf9e5f85f",
                        "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "glosses": [
                            "Qualité de ce qui est tendre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ef95cd25-cab7-3e26-8b4f-91de5d6f3c60",
                        "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "glosses": [
                            "Qualité de ce qui est tendre.",
                            "(Pour un matériau) Qualité de ce qui est facile à rayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa8a2c41-9f16-4d0d-8fed-9d9147fd5c92",
                                "sense_id": "ef95cd25-cab7-3e26-8b4f-91de5d6f3c60",
                                "text": "On peut le travailler comme de la cire et si une balle d'une arme à feu est tirée dedans, elle fait certes un trou, mais n'arrache aucun morceau grâce à la très grande tendreté du bois."
                            },
                            {
                                "example_id": "5622c938-8006-460a-8dc4-6ef23256b52a",
                                "sense_id": "ef95cd25-cab7-3e26-8b4f-91de5d6f3c60",
                                "text": "Il est l'œuvre d'un artiste, Philippe Cormand, qui a exploité avec talent la tendreté de la pierre de tuffeau pour réaliser une Anjou miniature."
                            }
                        ]
                    },
                    {
                        "sense_id": "994678b6-6dbb-38fa-9ec5-652bc96a57fc",
                        "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "glosses": [
                            "Qualité de ce qui est tendre.",
                            "(Pour un aliment) Qualité de ce qui est facile à manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f622456b-b921-46d5-bc29-06a94fcc86d4",
                                "sense_id": "994678b6-6dbb-38fa-9ec5-652bc96a57fc",
                                "text": "La tendreté est la facilité avec laquelle la viande est coupée et broyée au cours de la mastication. Cette qualité est en rapport avec les protéines insolubles du tissu musculaire."
                            },
                            {
                                "example_id": "212a6971-420e-4128-b838-5f101107d3d3",
                                "sense_id": "994678b6-6dbb-38fa-9ec5-652bc96a57fc",
                                "text": "Certains auteurs ont montré que la réduction du niveau alimentaire avant l'abattage détériore les qualités sensorielles de la viande, en particulier la tendreté."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c0c555-4bec-330e-b0b3-e97efc7dd5e7",
                        "entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "glosses": [
                            "Qualité de ce qui est encore jeune."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cd1ae355-aa15-471e-adf8-7c4a18fcb8fd",
                                "sense_id": "a8c0c555-4bec-330e-b0b3-e97efc7dd5e7",
                                "text": "Il percevait chez cette gamine, malgré la tendreté de son âge, une essence semblable à la sienne, et en était plus troublé qu'il ne l'aurait voulu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2cfa0c8-4cbb-43f7-9c8b-69fdfb973a8f",
                        "source_entry_id": "8abcf5b2-d8dc-30b3-a451-1df0f057c265",
                        "target_lang_word": "tenderness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenderness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A tendency to express warm, compassionate feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d6ff4-4459-4112-9015-bd7211d76a3b",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "When the lovers were together, their cold indifference gave way to love and tenderness."
                                            },
                                            {
                                                "example_id": "d2b3be4e-dbac-4f9f-a68a-7c1c5ddca360",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "I had known him jealous, suspicious; I had seen about him certain tendernesses, fitfulnesses—a softness which came like a warm air, and a ruth which passed like early dew, dried in the heat of his irritabilities: this was all I had seen."
                                            },
                                            {
                                                "example_id": "1b8b6812-4d12-404a-bc6b-813fbeec3c94",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "Love me, try to be understanding / Tenderness is all that I'm asking / Don't feel like I'm making conditions / I want to overcome my inhibitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A concern for the feelings or welfare of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c4063b-7cf4-47f6-b543-2c383550d5cb",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "When they saw the poor orphans, they were overwhelmed with tenderness for them."
                                            },
                                            {
                                                "example_id": "e414184b-6466-4038-a4d3-88bcac8bd1e6",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Everybody needs a little tenderness sometimes."
                                            },
                                            {
                                                "example_id": "28b2fa57-649a-483c-800d-1ed4add66bbe",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A pain or discomfort when an affected area is touched."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84d9696-ee46-4e78-9355-6b630d3836ca",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "He noted her extreme tenderness when he touched the bruise on her thigh."
                                            },
                                            {
                                                "example_id": "d84c563c-bca3-4ab2-80ce-6ac815af45fb",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
