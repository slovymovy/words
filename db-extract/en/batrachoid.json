                "senses": [
                    {
                        "sense_id": "b3bb5853-e2a8-3884-b9f9-a6798907249b",
                        "entry_id": "eb4d2860-6bf6-398c-9ece-b989e8fe09d4",
                        "glosses": [
                            "Any species of the family Batrachoididae; a batrachoidid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92c8e83-b597-4a00-8629-dee72685b010",
                                "sense_id": "b3bb5853-e2a8-3884-b9f9-a6798907249b",
                                "text": "Regardless of the type of water in which they are found, batrachoids are primarily bottom fishes."
                            },
                            {
                                "example_id": "8376e88e-7a0d-45b1-a0ae-f57c9ea5e15d",
                                "sense_id": "b3bb5853-e2a8-3884-b9f9-a6798907249b",
                                "text": "Somatically batrachoids are in fact highly modified if basal euteleosts."
                            },
                            {
                                "example_id": "ad5016d9-6927-4622-be70-953c33163f65",
                                "sense_id": "b3bb5853-e2a8-3884-b9f9-a6798907249b",
                                "text": "The batrachoids (toadfishes) are sedentary large species on mud or sand bottoms (Gill 1907, Gudger 1910) in which the male guards the large eggs (ca. 5 mm diameter in Opsanus tau)."
                            }
                        ]
                    }
