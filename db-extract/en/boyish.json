                    {
                        "form_id": "e90dedfd-2c28-47ce-8e13-68b0ceab2bea",
                        "entry_id": "6e528858-c429-317a-9057-d4d7d541cba9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most boyish"
