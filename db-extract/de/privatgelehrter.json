                "senses": [
                    {
                        "sense_id": "f5081baa-30dc-3021-8f3c-7548feabc145",
                        "entry_id": "0f0bf412-203e-30c1-bfbd-06185c9bd4c9",
                        "glosses": [
                            "meist akademisch gebildete, nicht angestellte Person, deren Forschung privat motiviert und finanziert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16243700-f244-4f88-aa37-50b1307e8a4f",
                                "sense_id": "f5081baa-30dc-3021-8f3c-7548feabc145",
                                "text": "„In seinen späten Jahren widmete er sich als Privatgelehrter und Etymologe der Philosophie und Theologie.“"
                            },
                            {
                                "example_id": "ecda163a-8e7b-494d-ac84-59adf2313b5a",
                                "sense_id": "f5081baa-30dc-3021-8f3c-7548feabc145",
                                "text": "„Ab 1831 lebte er zurückgezogen als Privatgelehrter in Frankfurt; dort ist er 1860 gestorben.“"
                            },
                            {
                                "example_id": "9233cb21-a8f4-43ca-be23-55c791790368",
                                "sense_id": "f5081baa-30dc-3021-8f3c-7548feabc145",
                                "text": "„Simrock wirkte seitdem als Privatgelehrter: Er übersetzte alt- und mittelhochdeutsche Dichtung, gab Volkslieder heraus, sammelte Märchen und Sagen.“"
                            },
                            {
                                "example_id": "5ea61874-bd7c-459e-a528-018ab5ecad4d",
                                "sense_id": "f5081baa-30dc-3021-8f3c-7548feabc145",
                                "text": "„Privatgelehrte und Kulturaktivisten veröffentlichten ihre Forschungen zur jüdischen Geschichte und zur jiddischen Sprache und Literatur vermehrt auf Jiddisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
