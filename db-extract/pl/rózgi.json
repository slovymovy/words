                        "cross_references": [
                            {
                                "target_word": "rossée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7daa87e5-da80-3e39-b3d6-79dd2179b495",
                                        "entry_id": "b45f827f-8624-34d6-9e37-6581ccd02bf8",
                                        "glosses": [
                                            "Correction vigoureuse ; grand nombre de coups."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9125debb-04b7-4613-b2db-75ef35d28c11",
                                                "sense_id": "7daa87e5-da80-3e39-b3d6-79dd2179b495",
                                                "text": "Je reçus une terrible rossée, après laquelle je me pelotonnai sous un canapé, où je me tins coi."
                                            },
                                            {
                                                "example_id": "2c648283-9050-47e0-a658-3af1ae4e1406",
                                                "sense_id": "7daa87e5-da80-3e39-b3d6-79dd2179b495",
                                                "text": "J'ai connu des types qui sont venus exprès du Texas ou de Californie à New York dans l'espoir de mettre la main sur lui et lui flanquer une rossée. Et quand je dis rossée, je suis timide — je veux dire le dérouiller, l'aplatir comme une crêpe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rossée",
                                "target_lang_code": "fr",
