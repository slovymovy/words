                    {
                        "sense_id": "e493bc6a-0fe4-3062-bdbe-750bd93f6773",
                        "entry_id": "fcbca615-acac-309e-a8f7-a64e5c1ad6ce",
                        "glosses": [
                            "een grote mate van kennis, kundigheid en opleidingsniveau bezittend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b40f23-7990-4b9d-b05f-747aba62e365",
                                "sense_id": "e493bc6a-0fe4-3062-bdbe-750bd93f6773",
                                "text": "Beren zijn gek op (hiker) eten en ruiken met hun scherp ontwikkelde neus alles wat we bij ons hebben, dwars door de plastic verpakkingen heen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0add59ba-1131-3063-8042-b10a6bcbd0b9",
                        "entry_id": "fcbca615-acac-309e-a8f7-a64e5c1ad6ce",
                        "glosses": [
                            "een grote mate van welopgevoedheid bezittend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c5db18-8850-48f3-a96f-8c5a836d142a",
                                "sense_id": "0add59ba-1131-3063-8042-b10a6bcbd0b9",
                                "text": "Het was alsof hij terug in de tijd reisde naar zijn studiejaren in Dresden. Maar ongetrouwde studentenbroekies kon je het vergeven, hij was er zelf een geweest. Met getrouwde, ontwikkelde mannen was het een heel andere kwestie."
                            }
                        ]
                    },
                    {
                        "sense_id": "e37f954f-95ee-36c7-8e07-849115daa399",
                        "entry_id": "fcbca615-acac-309e-a8f7-a64e5c1ad6ce",
                        "glosses": [
                            "een bepaald technologisch en economisch niveau bereikt hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7424905-5278-4dcc-9403-07995a6e856b",
                                "sense_id": "e37f954f-95ee-36c7-8e07-849115daa399",
                                "text": "Het is in de geschiedenis van het IMF, opgericht na de Tweede Wereldoorlog in 1945, niet eerder voorgekomen dat een ontwikkeld land zijn lening niet op tijd terugbetaalt. Toch lijkt dit te gaan gebeuren, zo liet een woordvoerder van de Griekse regering maandag al weten."
                            }
                        ]
                    }
