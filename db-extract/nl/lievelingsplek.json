                        "examples": [
                            {
                                "example_id": "7d90e277-eada-4cef-a27f-fe46902b0ff9",
                                "sense_id": "51611fa2-2484-35d7-a336-e71dfcb969ff",
                                "text": "Martijn Vroom, de burgemeester van Krimpen aan den IJssel, spreekt van een onacceptabele gebeurtenis. \"Ik ben zowel boos als verdrietig. Dit is een ontploffing bij een gebouw dat voor zo veel mensen de lievelingsplek is van het dorp. Echt afschuwelijk\", zei hij."
                            },
                            {
                                "example_id": "2dd91901-f215-4898-8453-9b19287ab9d0",
                                "sense_id": "51611fa2-2484-35d7-a336-e71dfcb969ff",
                                "text": "Ik omarm mijn grijze haren, maar twijfel inmiddels over het dragen van T-shirts. Kijkduin (Den Haag) is mijn lievelingsplek, de weidsheid van de zee is mijn zuurstof."
                            }
                        ]
                    }
