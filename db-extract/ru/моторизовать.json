                                        "glosses": [
                                            "einen Bereich auf Maschinen oder Motorfahrzeuge umstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9153025f-e8a8-445c-b7c6-73a2ca0fb9ae",
                                                "sense_id": "c935a89f-b795-3971-b569-f9584707ecb5",
                                                "text": "Er [der Fordson-Traktor] wurde entwickelt, um die Landwirtschaft mit kleinen Traktoren zu motorisieren."
                                            },
                                            {
                                                "example_id": "1cfb0b9e-2928-42b5-bf7c-cf8e7f59859a",
                                                "sense_id": "c935a89f-b795-3971-b569-f9584707ecb5",
                                                "text": "Ab dem 20. Jahrhundert begann man, die Müllabfuhr zu motorisieren und in diversen Entwicklungsschritten im Laufe der Zeit zu mechanisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32a7baaf-096b-361e-bce1-d489d6004921",
                                        "entry_id": "88dc9d3d-720d-3b9a-8c40-09d12dffca24",
                                        "glosses": [
                                            "einen Motor in ein Fahrzeug oder Gerät einbauen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c27239-4a2d-42dd-b4cc-0adb6c27f392",
                                                "sense_id": "32a7baaf-096b-361e-bce1-d489d6004921",
                                                "text": "Ein Rad selbst zu motorisieren ist nicht illegal, solange es weiterhin stabil und verkehrssicher ist und die Motoren das Rad nicht schneller elektrisch unterstützen als bis 25 Km/h."
                                            },
                                            {
                                                "example_id": "604f93f8-9d87-4732-abd3-ed673af9aa03",
                                                "sense_id": "32a7baaf-096b-361e-bce1-d489d6004921",
                                                "text": "In Österreich sind bereits mehr als 200.000 E-Fahrräder im Einsatz, jedes achte neugekaufte Rad ist motorisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c3c7ca9-3f1e-3de3-9649-f0711f605a93",
                                        "entry_id": "88dc9d3d-720d-3b9a-8c40-09d12dffca24",
                                        "glosses": [
                                            "sich ein Kraftfahrzeug anschaffen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0f8b3e-b74e-47e7-bfcf-0cfa4aafdce1",
                                                "sense_id": "9c3c7ca9-3f1e-3de3-9649-f0711f605a93",
                                                "text": "Motorisiert wurde ich zur Matura, meine Eltern schenkten mir einen Käfer, Baujahr 1954, mein Geburtsjahr."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
