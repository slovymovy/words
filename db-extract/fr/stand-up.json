                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30227565-8336-3a78-b55c-aa50c5eb0e72",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A news broadcast delivered by an announcer who is filmed standing near the scene of the event."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ad4326-6366-4f8b-b2b8-de79e2dce231",
                                                "sense_id": "30227565-8336-3a78-b55c-aa50c5eb0e72",
                                                "text": "Reporters covet standups rather than the voiceover narration of news footage because it puts their faces on the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A short meeting throughout which participants remain standing (to encourage brevity)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272b2dcd-474a-4bab-887e-940ebaf14a03",
                                                "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                                "text": "How come you weren't at the stand-up this morning?"
                                            },
                                            {
                                                "example_id": "862fdefb-9ee8-4e95-b1b8-a84a08e3e454",
                                                "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                                "text": "Esther Crawford, a project manager, asked people to join a “standup” meeting at 9:30 p.m. in San Francisco on Thursday as some layoff notices went out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6a04c0-a98f-3298-8742-e15f97a04de9",
