                                        "sense_id": "c92239ee-bbd2-3c54-86de-6a7c5eaff7fe",
                                        "entry_id": "b7d66ca8-a8f0-3076-a35e-16209edfdf52",
                                        "glosses": [
                                            "das Aufheben von staatlichen oder gesellschaftlichen Beschränkungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d41670f-a38c-4aac-a0bf-15a9e920a906",
                                                "sense_id": "c92239ee-bbd2-3c54-86de-6a7c5eaff7fe",
                                                "text": "„In Kontinentaleuropa und besonders in Frankreich betrachtet man die ersten Nachkriegsjahrzehnte, die von starken staatlichen Eingriffen geprägt waren, als eine segensreiche Zeit des Wachstums und macht häufig die um 1980 eingeleitete wirtschaftliche Liberalisierung für seinen Rückgang verantwortlich.“"
                                            },
                                            {
                                                "example_id": "5d191bd1-b380-465b-b005-52c8342db8c7",
                                                "sense_id": "c92239ee-bbd2-3c54-86de-6a7c5eaff7fe",
                                                "text": "„Die derzeitige Mitte-links-Regierung scheiterte 2024 mit einer Liberalisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
