                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbb0c5f7-9d72-3f36-8a4a-10abb71c719b",
                    "sense_definition": "To cause something to become boring or lose its novelty through overexposure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant repetition can <w>stale</w> even the most beautiful piece of music.",
                            "target_lang_translations": {
                                "ru": "Постоянное повторение может <w>лишить новизны</w> даже самое прекрасное музыкальное произведение."
                            }
                        },
                        {
                            "text": "He was careful not to <w>stale</w> his welcome by staying too many days.",
                            "target_lang_translations": {
                                "ru": "Он старался не <w>злоупотреблять</w> гостеприимством, оставаясь слишком долго."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать новизны, делать скучным или банальным из-за слишком частого повторения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приедаться",
                                "target_lang_sense_clarification": "становиться банальным"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "лишать свежести"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42ce8826-3de6-3733-bc1f-45ac44164ec1",
                    "sense_definition": "To become boring or uninteresting over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The routine began to <w>stale</w> after he had been doing it for three years.",
                            "target_lang_translations": {
                                "ru": "Рутина начала <w>приедаться</w> после того, как он занимался этим три года."
                            }
                        },
                        {
                            "text": "Their relationship started to <w>stale</w> as they ran out of things to talk about.",
                            "target_lang_translations": {
                                "ru": "Их отношения начали <w>угасать</w>, так как у них закончились темы для разговоров."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться скучным, неинтересным или обыденным со временем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приедаться",
                                "target_lang_sense_clarification": "о рутине, отношениях"
                            },
                            {
                                "target_lang_word": "выдыхаться",
                                "target_lang_sense_clarification": "терять интерес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ceafb0-7d1e-3051-8bd4-a1acc96d6144",
                    "sense_definition": "To urinate, specifically used when referring to horses or cattle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer waited for the horse to <w>stale</w> before continuing the long journey.",
                            "target_lang_translations": {
                                "ru": "Фермер подождал, пока лошадь <w>помочится</w>, прежде чем продолжить долгий путь."
                            }
                        },
                        {
                            "text": "It is common for cattle to <w>stale</w> in the fields during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Для крупного рогатого скота естественно <w>испражняться</w> на полях во второй половине дня."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мочиться (о лошадях или крупном рогатом скоте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочиться",
                                "target_lang_sense_clarification": "о животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
