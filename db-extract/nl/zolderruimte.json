                        "examples": [
                            {
                                "example_id": "c9ec331a-8b88-41fa-a957-1eb336685a4f",
                                "sense_id": "98a08b4e-d663-3abd-9c55-eac0c571af91",
                                "text": "Het plankje werd tien jaar geleden bij de verbouwing van het kantongerecht ontdekt op de zolderruimte."
                            },
                            {
                                "example_id": "1db37959-e5b5-4fff-836e-899ae6c0ef5d",
                                "sense_id": "98a08b4e-d663-3abd-9c55-eac0c571af91",
                                "text": "Het plan voorziet ook in het benutten van de zolderruimte, maar Christiaanse geeft aan dat dat valt of staat met de hoeveelheid geld dat beschikbaar is."
                            },
                            {
                                "example_id": "4a5ea680-cb8e-46bc-9702-fe48866e19fe",
                                "sense_id": "98a08b4e-d663-3abd-9c55-eac0c571af91",
                                "text": "„We wisten dat Kees een fervent puzzelaar was”, lacht Gerrit Boom, de horeca-uitbater die de zolderruimte ter beschikking stelde."
                            }
                        ]
                    }
