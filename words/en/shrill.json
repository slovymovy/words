{
    "word_family": [
        "shrilly",
        "shrillness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                    "sense_definition": "Having a high-pitched, piercing, or sharp sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was filled with the <w>shrill</w> cries of birds.",
                            "target_lang_translations": {
                                "cs": "Les byl naplněn <w>pronikavým</w> křikem ptáků."
                            }
                        },
                        {
                            "text": "She covered her ears because of the <w>shrill</w> whistle.",
                            "target_lang_translations": {
                                "cs": "Zakryla si uši kvůli tomu <w>ječivému</w> hvizdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "piercing",
                        "sharp"
                    ],
                    "antonyms": [
                        "muffled",
                        "deep"
                    ],
                    "common_phrases": [
                        "shrill cry",
                        "shrill whistle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávající vysoký, pronikavý nebo ostrý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pronikavý",
                                "target_lang_sense_clarification": "vhodné pro zvuky, které jsou velmi intenzivní a vysoké"
                            },
                            {
                                "target_lang_word": "ječivý",
                                "target_lang_sense_clarification": "vhodné pro zvuky připomínající křik nebo jekot"
                            },
                            {
                                "target_lang_word": "ostrý",
                                "target_lang_sense_clarification": "vhodné pro zvuky, které jsou náhlé a nepříjemně vysoké"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbbf064a-d3b9-3fca-96c7-2017d8ef676d",
                    "sense_definition": "Characterized by a loud, aggressive, or forceful tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke in a <w>shrill</w> voice during the heated argument.",
                            "target_lang_translations": {
                                "cs": "Během té vyhrocené hádky mluvil <w>ostrým</w> hlasem."
                            }
                        },
                        {
                            "text": "The politician made a <w>shrill</w> demand for immediate change.",
                            "target_lang_translations": {
                                "cs": "Politik vznesl <w>ostrý</w> požadavek na okamžitou změnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "strident",
                        "vehement"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyznačující se hlasitým, agresivním nebo důrazným tónem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ostrý",
                                "target_lang_sense_clarification": "vhodné pro tón řeči, který je útočný nebo velmi přísný"
                            },
                            {
                                "target_lang_word": "hlasitý",
                                "target_lang_sense_clarification": "vhodné pro tón, který je příliš silný a výrazný"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                    "sense_definition": "To produce a high-pitched, piercing sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>shrill</w> through the cracks in the old house.",
                            "target_lang_translations": {
                                "cs": "Vítr začal <w>ječet</w> skulinami ve starém domě."
                            }
                        },
                        {
                            "text": "The emergency alarm started to <w>shrill</w> across the entire building.",
                            "target_lang_translations": {
                                "cs": "Nouzový alarm začal <w>ječet</w> po celé budově."
                            }
                        }
                    ],
                    "synonyms": [
                        "screech",
                        "shriek"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat vysoký, pronikavý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ječet",
                                "target_lang_sense_clarification": "vydávat vysoký, pronikavý zvuk (často o lidech nebo strojích)"
                            },
                            {
                                "target_lang_word": "zaječet",
                                "target_lang_sense_clarification": "vydat náhlý, vysoký, pronikavý zvuk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c58362f6-38a9-320e-8db1-bed71cffb901",
                    "sense_definition": "A high-pitched, piercing sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>shrill</w> of the alarm startled everyone in the room.",
                            "target_lang_translations": {
                                "cs": "Náhlý <w>jekot</w> alarmu vylekal všechny v místnosti."
                            }
                        },
                        {
                            "text": "We heard the distant <w>shrill</w> of a train whistle in the night.",
                            "target_lang_translations": {
                                "cs": "V noci jsme slyšeli vzdálený <w>pronikavý zvuk</w> vlakové píšťaly."
                            }
                        }
                    ],
                    "synonyms": [
                        "screech",
                        "shriek"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vysoký, pronikavý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jekot",
                                "target_lang_sense_clarification": "vysoký, pronikavý zvuk"
                            },
                            {
                                "target_lang_word": "pronikavý zvuk",
                                "target_lang_sense_clarification": "popisný výraz pro velmi vysoký a slyšitelný zvuk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}