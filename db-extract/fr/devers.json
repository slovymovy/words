        "fr-extract.jsonl": [
            {
                "entry_id": "f445a7d4-9554-3ab5-9eab-b4f3bacebe94",
                "word": "devers",
                "pos": "prep",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                        "entry_id": "f445a7d4-9554-3ab5-9eab-b4f3bacebe94",
                        "glosses": [
                            "Du côté de."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6770185a-363d-4d49-ae28-a4e914313074",
                                "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                                "text": "Devers le ciel Sornit tendait les mains."
                            },
                            {
                                "example_id": "b456a627-d66f-4a4e-b16e-71f55411b06c",
                                "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                                "text": "« Voilà deux jolies dames qui viennent devers nous par le bout de l’allée. Comment allons-nous faire ? »"
                            },
                            {
                                "example_id": "0ecc0cf7-c798-46ab-bcb3-c12e75845ddf",
                                "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                                "text": "— Écoute, Biscotine, va jusque devers la butte pour savoir si ton père ne revient pas."
                            },
                            {
                                "example_id": "86f3db54-c960-4ee9-8865-a313a3826b93",
                                "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                                "text": "Puis l’Angelus, devers les chapelles prochaines,\nTintait d’une voix grêle, et, sans rompre les chaînes,\nNous allions dans la Nuit qui priait sous les chênes."
                            },
                            {
                                "example_id": "4575b32b-356d-409e-9a0a-05b0d196fe79",
                                "sense_id": "6ac4b7f4-286a-328f-9a81-ea7f4543d321",
                                "text": "Voici une quinzaine de mois, il cherchait des cèpes, devers les Bois du Roy, loin du hameau, au long de la frontière."
                            }
                        ]
                    },
                    {
                        "sense_id": "775c669b-b90f-3f58-bcb5-ffd37e9f88d2",
                        "entry_id": "f445a7d4-9554-3ab5-9eab-b4f3bacebe94",
                        "glosses": [
                            "Envers."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "422edd36-bd42-4c1c-894f-4907ab529609",
                                "sense_id": "775c669b-b90f-3f58-bcb5-ffd37e9f88d2",
                                "text": "« Mes intentions devers toi sont les mêmes, car mon cœur ne changera jamais. Si tu le veux, nous nous marierons vitement… »"
                            }
                        ]
                    }
                ],
