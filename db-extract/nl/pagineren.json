                                                "example_id": "51748e1d-3318-4273-960e-d15e9ac06866",
                                                "sense_id": "0c05b70a-41ae-3e9a-93f4-77108abc49e8",
                                                "text": "The graph is on page 30, but I opened the textbook at page 32."
