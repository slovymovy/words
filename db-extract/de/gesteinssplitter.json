                        "examples": [
                            {
                                "example_id": "7dc3dbbf-17f4-41f2-8d2c-35f753b5b87e",
                                "sense_id": "93002860-60e5-3195-b3e6-db677d9c74da",
                                "text": "„Geröll und zerschmetterte Felsbrocken, die wirkten wie große, vom Mond herabgefallene Gesteinssplitter, behinderten gegen Ende unser Fortkommen.“"
                            },
                            {
                                "example_id": "5783a301-0c00-4e9b-a906-bfe59eb75b4d",
                                "sense_id": "93002860-60e5-3195-b3e6-db677d9c74da",
                                "text": "„Eine Kugel schlug in die Mauer direkt neben ihm ein; Gesteinssplitter und Staub flogen ihm ins rechte Auge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
