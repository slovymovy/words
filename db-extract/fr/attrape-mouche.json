            {
                "entry_id": "c775d43f-62e9-37e4-9a1b-11d9a5bafd97",
                "word": "attrape-mouche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a05a649-922d-42e1-a3ea-181733dce0dd",
                        "entry_id": "c775d43f-62e9-37e4-9a1b-11d9a5bafd97",
                        "tags": [
