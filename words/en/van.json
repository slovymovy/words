{
    "word_family": [
        "minivan",
        "campervan",
        "vanguard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76a3562b-846a-3b35-9ceb-d4f25bbc86d6",
                    "sense_definition": "A medium-sized covered motor vehicle used for transporting goods or people, usually larger than a car but smaller than a truck.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rented a large <w>van</w> to move our furniture to the new house.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали большой <w>фургон</w>, чтобы перевезти мебель в новый дом.",
                                "zh": "我们租了一辆大<w>货车</w>把家具搬到新家。"
                            }
                        },
                        {
                            "text": "The delivery <w>van</w> arrived with the package early this morning.",
                            "target_lang_translations": {
                                "ru": "<w>Фургон</w> службы доставки прибыл с посылкой сегодня рано утром.",
                                "zh": "送货<w>货车</w>今天一早带着包裹到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "minivan",
                        "minibus"
                    ],
                    "common_phrases": [
                        "delivery van",
                        "white van",
                        "camper van",
                        "police van"
                    ],
                    "target_lang_definitions": {
                        "ru": "Среднеразмерный крытый автомобиль для перевозки грузов или людей, обычно больше легкового автомобиля, но меньше грузовика.",
                        "zh": "一种中型封闭式机动车，用于运输货物或人员，通常比轿车大，但比卡车小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фургон",
                                "target_lang_sense_clarification": "тип кузова для перевозки грузов"
                            },
                            {
                                "target_lang_word": "микроавтобус",
                                "target_lang_sense_clarification": "для перевозки пассажиров"
                            },
                            {
                                "target_lang_word": "вэн",
                                "target_lang_sense_clarification": "заимствование, тип кузова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货车",
                                "target_lang_sense_clarification": "用于运输货物的封闭式车辆"
                            },
                            {
                                "target_lang_word": "面包车",
                                "target_lang_sense_clarification": "常用于载人的小型封闭式车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "480525b9-60a6-39c5-ac33-2bc513f0f58c",
                    "sense_definition": "The leading part of an advancing military formation or movement; short for <w>vanguard</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regiment marched in the <w>van</w> of the army, ready to engage the enemy.",
                            "target_lang_translations": {
                                "ru": "Полк маршировал в <w>авангарде</w> армии, готовый вступить в бой с врагом.",
                                "zh": "该团走在军队的<w>先锋</w>位置，准备与敌人交战。"
                            }
                        },
                        {
                            "text": "She was always in the <w>van</w> of the movement for social change.",
                            "target_lang_translations": {
                                "ru": "Она всегда была в <w>авангарде</w> движения за социальные перемены.",
                                "zh": "她始终处于社会变革运动的<w>前锋</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the van"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "common in historical or literary contexts"
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping of vanguard"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передовая часть наступающего военного формирования или движения; сокращение от «авангард».",
                        "zh": "军事编队或运动的先头部队；“先锋”的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авангард",
                                "target_lang_sense_clarification": "военный или переносный смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先锋",
                                "target_lang_sense_clarification": "军事或运动的领头部分"
                            },
                            {
                                "target_lang_word": "前锋",
                                "target_lang_sense_clarification": "处于最前沿的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4018ab56-514a-36b6-8826-7e46cfa053de",
                    "sense_definition": "An enclosed railway vehicle used for transporting goods or luggage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor sat in the rear <w>van</w> of the train during the journey.",
                            "target_lang_translations": {
                                "ru": "Кондуктор сидел в заднем <w>вагоне</w> поезда во время поездки.",
                                "zh": "旅途中，列车员坐在火车的尾部<w>车厢</w>里。"
                            }
                        },
                        {
                            "text": "All the heavy luggage was loaded into the guard's <w>van</w> before departure.",
                            "target_lang_translations": {
                                "ru": "Весь тяжелый багаж был погружен в служебный <w>вагон</w> перед отправлением.",
                                "zh": "出发前，所有沉重的行李都被装进了<w>行李车厢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guard's van",
                        "luggage van"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крытый железнодорожный вагон, используемый для перевозки грузов или багажа.",
                        "zh": "用于运输货物或行李的封闭式铁路车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вагон",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "багажный вагон",
                                "target_lang_sense_clarification": "для багажа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "车厢",
                                "target_lang_sense_clarification": "铁路列车的载货或载人部分"
                            },
                            {
                                "target_lang_word": "行李车厢",
                                "target_lang_sense_clarification": "专门用于存放行李的铁路车厢"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2b94a3b-9efc-3a12-a51a-6d19420dbf84",
                    "sense_definition": "To transport something, especially horses, in a van.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>van</w> the horses to the racetrack before the competition starts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>перевезти</w> лошадей в фургоне на ипподром до начала соревнований.",
                                "zh": "比赛开始前，我们需要<w>用货车运送</w>马匹去赛马场。"
                            }
                        },
                        {
                            "text": "They decided to <w>van</w> the equipment to the site rather than shipping it by air.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>отправить</w> оборудование фургоном на объект, а не самолетом.",
                                "zh": "他们决定<w>用货车运送</w>设备到现场，而不是空运。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить что-либо, особенно лошадей, в фургоне.",
                        "zh": "用货车运输某物，尤指马匹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить в фургоне",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "транспортировать",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用货车运送",
                                "target_lang_sense_clarification": "使用货车进行运输的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f240ef-4fd6-364b-89c8-785361d2d990",
                    "sense_definition": "To arrest someone by picking them up in a police vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hacker was afraid he would get <w>vanned</w> by federal agents for his online activities.",
                            "target_lang_translations": {
                                "ru": "Хакер боялся, что его <w>повяжут</w> федеральные агенты за его действия в сети.",
                                "zh": "那个黑客担心自己会因为网络活动被联邦特工<w>抓捕</w>。"
                            }
                        },
                        {
                            "text": "He claimed that he was <w>vanned</w> shortly after leaking the documents.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что его <w>забрали</w> в полицейский фургон вскоре после утечки документов.",
                                "zh": "他声称自己在泄露文件后不久就被<w>抓捕</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Арестовать кого-либо, посадив в полицейский фургон.",
                        "zh": "指通过警车将某人逮捕并带走。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повязать",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "забрать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓捕",
                                "target_lang_sense_clarification": "逮捕并带走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a4573b64-6f07-3cf5-a92b-5d249ca941a6",
                    "sense_definition": "A short form of given names such as Vanessa, Vance, Ivan, or Evan.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Van</w> is coming to the party later with his friends.",
                            "target_lang_translations": {
                                "ru": "<w>Вэн</w> придет на вечеринку позже со своими друзьями.",
                                "zh": "<w>凡</w>稍后会和他的朋友们一起来参加聚会。"
                            }
                        },
                        {
                            "text": "Her name is Vanessa, but she prefers to be called <w>Van</w>.",
                            "target_lang_translations": {
                                "ru": "Ее зовут Ванесса, но она предпочитает, чтобы ее называли <w>Вэн</w>.",
                                "zh": "她叫凡妮莎，但她更喜欢别人叫她<w>凡</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма имен, таких как Ванесса, Вэнс, Иван или Эван.",
                        "zh": "如Vanessa、Vance、Ivan或Evan等名字的缩写形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вэн",
                                "target_lang_sense_clarification": "имя"
                            },
                            {
                                "target_lang_word": "Ван",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凡",
                                "target_lang_sense_clarification": "人名常用译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7a3d3a0-3778-3850-97b0-044f8da0899d",
                    "sense_definition": "A short informal name for the city of Vancouver.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We are flying to <w>Van</w> for the weekend to visit family.",
                            "target_lang_translations": {
                                "ru": "Мы летим в <w>Ванкувер</w> на выходные, чтобы навестить семью.",
                                "zh": "我们周末要飞去<w>温哥华</w>探亲。"
                            }
                        },
                        {
                            "text": "He lives in North <w>Van</w> and commutes to the city center.",
                            "target_lang_translations": {
                                "ru": "Он живет в Северном <w>Ванкувере</w> и ездит на работу в центр города.",
                                "zh": "他住在北<w>温哥华</w>，每天通勤到市中心。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое неофициальное название города Ванкувер.",
                        "zh": "温哥华市的非正式简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ванкувер",
                                "target_lang_sense_clarification": "полное название"
                            },
                            {
                                "target_lang_word": "Ван",
                                "target_lang_sense_clarification": "сленговое сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "温哥华",
                                "target_lang_sense_clarification": "城市全称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04d88227-6550-3c0d-aa6b-9ccb7c76a03b",
                    "sense_definition": "A city and province in eastern Turkey, located on the shore of Lake Van.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the ancient church on an island near <w>Van</w>.",
                            "target_lang_translations": {
                                "ru": "Они посетили древнюю церковь на острове недалеко от <w>Вана</w>.",
                                "zh": "他们参观了<w>凡城</w>附近岛上的一座古老教堂。"
                            }
                        },
                        {
                            "text": "The city of <w>Van</w> is famous for its unique breed of swimming cats.",
                            "target_lang_translations": {
                                "ru": "Город <w>Ван</w> знаменит своей уникальной породой плавающих кошек.",
                                "zh": "<w>凡城</w>以其独特的游泳猫品种而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город и провинция на востоке Турции, расположенные на берегу озера Ван.",
                        "zh": "位于土耳其东部，坐落在凡湖湖畔的城市和省份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ван",
                                "target_lang_sense_clarification": "город/озеро"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凡城",
                                "target_lang_sense_clarification": "土耳其城市名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}