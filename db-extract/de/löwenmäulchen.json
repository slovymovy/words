                "senses": [
                    {
                        "sense_id": "41438d8a-6ba8-33d8-af48-cfcaa0bc110d",
                        "entry_id": "b01911e7-dfc9-3cbd-92dc-767b2a577edc",
                        "glosses": [
                            "besonders in Nordamerika und dem westlichen Mittelmeer verbreitete Pflanzengattung, von der einige Arten als Zierpflanze genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749ee796-d796-46b6-942c-10b66786a1f6",
                                "sense_id": "41438d8a-6ba8-33d8-af48-cfcaa0bc110d",
                                "text": "„Ich trage Berge von Löwenmäulchen, Wicken und Salbei davon.“"
                            },
                            {
                                "example_id": "195bb564-6488-4f6b-b15a-73c84a660454",
                                "sense_id": "41438d8a-6ba8-33d8-af48-cfcaa0bc110d",
                                "text": "„Ihre Fantasiehäuser und Pflasterstraßen. Ihre Möwen, die über den Austernbooten kreisend von Bänken zurückkehrten, die Misty nie gesehen hatte. Die Fensterkästen überquellend von Löwenmäulchen und Zinnien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e35fce-7337-47f6-8aa7-4cc4dcc0dca3",
                        "source_entry_id": "b01911e7-dfc9-3cbd-92dc-767b2a577edc",
                        "source_sense_id": "41438d8a-6ba8-33d8-af48-cfcaa0bc110d",
                        "target_lang_word": "snapdragon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snapdragon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85cc4b3d-7a9e-31c4-a884-d1001658d9bd",
                                        "entry_id": "bc6dba2b-148a-3c1f-8ed0-bd157762147a",
                                        "glosses": [
                                            "Any plant of the genus Antirrhinum, with showy yellow, white or red flowers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f7b5dd-09ce-4d6e-9622-9e234241f423",
                                                "sense_id": "85cc4b3d-7a9e-31c4-a884-d1001658d9bd",
                                                "text": "[…]of kitchen-gardens, and straight herb-borders, and warm snap-dragon beset by bees;"
                                            },
                                            {
                                                "example_id": "967d4f0c-f39a-425c-8df6-0c2614660ea3",
                                                "sense_id": "85cc4b3d-7a9e-31c4-a884-d1001658d9bd",
                                                "text": "Snapdragon leaves are asymmetrical with respect to dorsal-ventral surfaces (Fig. 6.6A)."
                                            },
                                            {
                                                "example_id": "482b1aa4-ff5b-43ee-b872-78cf687cc825",
                                                "sense_id": "85cc4b3d-7a9e-31c4-a884-d1001658d9bd",
                                                "text": "2000, Margaret Roberts, Edible & Medicinal Flowers, New Africa Books (The Spearhead Press), page 72,\nThe snapdragon is indigenous to Europe and has been a much loved garden plant since before the Middle Ages, when it was considered an antidote against witchcraft."
                                            },
                                            {
                                                "example_id": "9c4a1fb0-0459-46c2-823c-fa1bf220a46b",
                                                "sense_id": "85cc4b3d-7a9e-31c4-a884-d1001658d9bd",
                                                "text": "Modern snapdragons aren't usually grown for their scent, although some do smell slightly spicy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17a5d36-c5f6-36d4-8386-e577ef538a6c",
                                        "entry_id": "bc6dba2b-148a-3c1f-8ed0-bd157762147a",
                                        "glosses": [
                                            "A game in which raisins are snatched from a vessel containing burning brandy, and eaten; the substance snatched and eaten during the playing of the game; the vessel used for the game."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd108b2-b0c1-4a0b-9e4f-1feb9becd7b6",
                                                "sense_id": "c17a5d36-c5f6-36d4-8386-e577ef538a6c",
                                                "text": "He bore a ſtrange kind of Appetite to Snap-dragon, and to the livid Snuffs of a burning Candle, which he would catch and ſwallow with an Agility, wonderful to conceive; [...]"
                                            },
                                            {
                                                "example_id": "dc06eab1-c632-4f25-9370-2770f4598164",
                                                "sense_id": "c17a5d36-c5f6-36d4-8386-e577ef538a6c",
                                                "text": "\"And now for snap-dragon,\" said Marian.\n\"Exactly as you predicted, Mr. Graham,\" said Madeline; \"blind-man's buff at a quarter past three, and snap-dragon at five.\""
                                            },
                                            {
                                                "example_id": "3e64747d-1e19-4f99-a36a-a63beb614ff8",
                                                "sense_id": "c17a5d36-c5f6-36d4-8386-e577ef538a6c",
                                                "text": "From the 16th to 19th centuries, no Christmas Eve celebration was complete without a hearty game of Snapdragon in the parlor."
                                            },
                                            {
                                                "example_id": "a6f2947e-5fe4-4765-8a63-0a463c715b7a",
                                                "sense_id": "c17a5d36-c5f6-36d4-8386-e577ef538a6c",
                                                "text": "2014, Sabrina Jeffries, When Sparks Fly, Simon & Schuster (Pocket Star Books), unnumbered page,\n\"I hope we play snapdragon,\" eight-year-old Timothy Metcalf said.\n\"I wish we could,\" Ellie said, \"but I doubt Papa will allow it. He'll say snatching raisins from a burning bowl of brandy is too dangerous.\"\n\"But snapdragon is a Christmas tradition!\" protested Percy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
