                "senses": [
                    {
                        "sense_id": "46e42319-3ead-306f-8c6d-0d9604c313a6",
                        "entry_id": "dff477e3-2307-3964-b6d0-e2529b445a1f",
                        "glosses": [
                            "feestelijke maaltijd die men nuttigt samen met gasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef516f1d-2fdb-4495-baf3-527d36b0d524",
                                "sense_id": "46e42319-3ead-306f-8c6d-0d9604c313a6",
                                "text": "Niet voor niets kwamen de Grieken in Plato's Gastmaal de avond ná het feest, zwaar katterig nog, met hun lofredes op Eros."
                            },
                            {
                                "example_id": "7364fcb3-17e6-44ff-a681-af3c12e80662",
                                "sense_id": "46e42319-3ead-306f-8c6d-0d9604c313a6",
                                "text": "De avond dat mijn bijdrage in de krant stond had ik een reservering bij De Keuken Van Gastmaal op de Utrechtse Biltstraat, een van mijn favoriete restaurants aller tijden. Chef Erik van den Eijnde moet in zijn reserveringsboek hebben gezien dat mijn vrouw en ik kwamen eten, want voor de maaltijd kregen we als amuse een mini-uitvoering van... mijn vaders aardappelschotel."
                            }
                        ]
                    }
                ],
