                    {
                        "translation_id": "a0bd12a0-1332-4c0c-91f9-ad53f4fc7405",
                        "source_entry_id": "ab1bd256-151c-32d4-b009-8c8fb4c536ce",
                        "target_lang_word": "Tirol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tirol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                        "entry_id": "22945f83-1bdd-3aa5-b24c-007ff13d022a",
                                        "glosses": [
                                            "Region, die sich in den Alpen über Teile der heutigen Staatsgebiete Österreichs und Italiens erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "746ce4a5-9949-4917-a98a-73f9b717699a",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "Die Burg hat der Grafschaft Tirol den Namen gegeben."
                                            },
                                            {
                                                "example_id": "9e51fe68-2849-4eca-ae51-805be8b2b6ec",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "Ich verbürge die Wahrheit der Nachricht nicht, so viel aber scheint mir gewiß, daß man vor Tirol Respekt bekommen hat, wo der Herr Duc de Danzig (General Lefebvre) Gott hat danken müssen, daß er mit heiler Haut aus den Bergschlupfen entkommen ist."
                                            },
                                            {
                                                "example_id": "5dbb6088-88d1-4076-8e3c-5636613a95ef",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "Da ist z. B. der Pulcinell, die eigentliche Nationalmaske, der Harlekin, aus Bergamo, Hanswurst, aus Tirol gebürtig."
                                            },
                                            {
                                                "example_id": "9e4f9fd5-74dc-432c-9193-a5782a68a4d9",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "c28e6ff8-71be-464b-bee0-ad8fbdf0bf2d",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "„Das deutsche Engagement gegen Italien bezog sich auf das Tirol und den Abschnitt am Isonzo.“"
                                            },
                                            {
                                                "example_id": "56b80a91-e435-47e1-ac3d-05f3dd3e8634",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "„Noch heutzutage sagen die Ehrenberger, wenn sie über den Fern reisen: wir gehen ins Tirol, und ebenso haben die Innthaler, wenigstens in früheren Zeiten, von der Gegend um Reute [sic!] immer so gesprochen, als läge sie in Schwaben.“"
                                            },
                                            {
                                                "example_id": "0d8bd32a-2477-4859-a2d3-961b65000cc1",
                                                "sense_id": "2207353a-a8c2-38b1-a114-5f3af527cdef",
                                                "text": "„Er wandte sich dann ins Tirol, war im April 1529 im Appenzellerland und wurde am 6. September 1529 in Clausen bei Innsbruck verbrannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ac5ba22-8de8-39d2-af79-630a4256298e",
                                        "entry_id": "22945f83-1bdd-3aa5-b24c-007ff13d022a",
                                        "glosses": [
                                            "ein Bundesland der Republik Österreich; österreichischer Teil von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b9a7a4-94a1-4dce-b00d-fa9bd81ff5c5",
                                                "sense_id": "7ac5ba22-8de8-39d2-af79-630a4256298e",
                                                "text": "Der Kristallkonzern baut in Tirol noch einmal 800 Mitarbeiter ab und verlagert Produktion nach Fernost und Osteuropa."
                                            },
                                            {
                                                "example_id": "69c08084-6fda-4e95-8ccf-e99d5e4414b9",
                                                "sense_id": "7ac5ba22-8de8-39d2-af79-630a4256298e",
                                                "text": "Beim niederländischen Fußballteam, das sich seit Mittwoch in Tirol auf die WM in Südafrika vorbereitet, herrscht gute Laune pur."
                                            },
                                            {
                                                "example_id": "56ad6ba5-e3f0-4a81-bdaa-fd9d0aad2a19",
                                                "sense_id": "7ac5ba22-8de8-39d2-af79-630a4256298e",
                                                "text": "In einem Wettlauf gegen die Zeit suchen seit Samstag österreichische Rettungskräfte in Tirol nach vier vermissten Schneeschuh-Wanderern aus Baden-Württemberg."
                                            },
                                            {
                                                "example_id": "aee18ba3-dd77-4a51-abf2-5328abe33b35",
                                                "sense_id": "7ac5ba22-8de8-39d2-af79-630a4256298e",
                                                "text": "„Mit Schreiben des Unabhängigen Verwaltungssenats im Tirol vom 16.03.2005 wurde der Berufungswerber aufgefordert, Umstände, die die Zustellung durch Hinterlegung mangelhaft erscheinen lassen könnten, darzutun und eine allfällige Ortsabwesenheit durch Beweismittel glaubhaft zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
