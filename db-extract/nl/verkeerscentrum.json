                        "entry_id": "fce66b7d-68d0-3c7c-a2b3-b3fe23c377b1",
                        "glosses": [
                            "plaats vanwaar men toezicht houdt op het wegverkeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d892483a-4c6c-4e94-b502-a5f697314b50",
                                "sense_id": "76246e8a-b9fd-35c4-afcc-73af1892c6ae",
                                "text": "De dichte mist die al dagen boven grote delen van Nederland hangt, veroorzaakt vooral hinder voor het verkeer. Bij het Verkeerscentrum in Utrecht staat verslaggever Kees van Dam."
                            },
                            {
                                "example_id": "498650f3-01e6-4260-978b-c797c3ac9a69",
                                "sense_id": "76246e8a-b9fd-35c4-afcc-73af1892c6ae",
                                "text": "Volgens het Verkeerscentrum Nederland passen de automobilisten zich goed aan. Ze rijden rustig en houden voldoende afstand. Voor zover bekend is het aantal ongelukken beperkt gebleven."
                            }
                        ]
                    },
                    {
                        "sense_id": "9099f75d-4785-35f0-886a-b04aa51f8f69",
                        "entry_id": "fce66b7d-68d0-3c7c-a2b3-b3fe23c377b1",
                        "glosses": [
                            "plaats vanwaar men toezicht houdt op het luchtvaartverkeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d3ed90-9d3f-4842-8ec9-eb87eb72fb81",
                                "sense_id": "9099f75d-4785-35f0-886a-b04aa51f8f69",
                                "text": "Het eerste vliegtuig brak daarop de landing af en cirkelde rondjes totdat een regionaal verkeerscentrum werd bereikt. Hoewel van daaruit werd gebeld met de verkeerstoren in Washington, kon ook op die manier geen contact worden gemaakt."
                            }
                        ]
