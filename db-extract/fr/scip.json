                        "glosses": [
                            "Société coopérative d’intérêt collectif, coopérative de production de biens ou de services de droit français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b2d21b-63a9-48a4-a223-2552aa39ccc6",
                                "sense_id": "b24cbdfd-abbb-3825-9714-608686358ac8",
                                "text": "« On travaille avec dix grossistes et soixante producteurs locaux », explique un des salariés de la Scic (Société Coopérative d’Intérêt Collectif)."
                            },
                            {
                                "example_id": "22161286-f475-469f-9c66-2a18021f06f0",
                                "sense_id": "b24cbdfd-abbb-3825-9714-608686358ac8",
                                "text": "Une Scic permet d’associer toute personne physique ou morale de droit privé ou de droit public autour du projet commun."
                            },
                            {
                                "example_id": "ace66483-f8e5-4938-b56a-a83d5ec0d611",
                                "sense_id": "b24cbdfd-abbb-3825-9714-608686358ac8",
                                "text": "Dans une Scic, les mécanismes coopératifs et participatifs sont identiques à ceux de la Scop."
