{
    "word_family": [
        "dairyman",
        "dairymaid",
        "dairying"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee1e24d0-5352-328d-a9db-3fa80ae3ac06",
                    "sense_definition": "Relating to milk or food products made from milk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "milk_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My sister is allergic to <w>dairy</w> products.",
                            "target_lang_translations": {
                                "ru": "У моей сестры аллергия на <w>молочные</w> продукты.",
                                "zh": "我妹妹对<w>乳制品</w>过敏。"
                            }
                        },
                        {
                            "text": "We visited a local <w>dairy</w> farm to see how cheese is made.",
                            "target_lang_translations": {
                                "ru": "Мы посетили местную <w>молочную</w> ферму, чтобы увидеть, как делают сыр.",
                                "zh": "我们参观了一家当地的<w>奶牛场</w>，看看奶酪是怎么制作的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-dairy"
                    ],
                    "common_phrases": [
                        "dairy products",
                        "dairy farm",
                        "dairy cattle",
                        "dairy cow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к молоку или продуктам питания, изготовленным из молока.",
                        "zh": "与牛奶或由牛奶制成的食品有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочный",
                                "target_lang_sense_clarification": "связанный с молоком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳制",
                                "target_lang_sense_clarification": "与乳制品相关的"
                            },
                            {
                                "target_lang_word": "奶制",
                                "target_lang_sense_clarification": "与奶制品相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24e4936f-9c9d-30f7-a840-7e73c99d64e2",
                    "sense_definition": "Relating to the business or industry of producing and processing milk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "milk_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dairy</w> industry has seen significant changes in technology.",
                            "target_lang_translations": {
                                "ru": "<w>Молочная</w> промышленность претерпела значительные технологические изменения.",
                                "zh": "<w>乳业</w>在技术方面经历了重大变革。"
                            }
                        },
                        {
                            "text": "He studied <w>dairy</w> science at the university.",
                            "target_lang_translations": {
                                "ru": "Он изучал <w>молочное</w> дело в университете.",
                                "zh": "他在大学里学习了<w>乳品</w>科学。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dairy industry",
                        "dairy farming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к бизнесу или индустрии производства и переработки молока.",
                        "zh": "与牛奶生产和加工的商业或行业有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочный",
                                "target_lang_sense_clarification": "относящийся к индустрии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳业",
                                "target_lang_sense_clarification": "指代行业"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8bd74c2f-7172-3b08-9f81-58e3548608e1",
                    "sense_definition": "Food and drink products made from milk, such as cheese, yogurt, and butter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to stop eating <w>dairy</w> for health reasons.",
                            "target_lang_translations": {
                                "ru": "Она решила перестать есть <w>молочные продукты</w> по состоянию здоровья.",
                                "zh": "出于健康原因，她决定不再食用<w>乳制品</w>。"
                            }
                        },
                        {
                            "text": "The doctor recommended reducing his intake of fat and <w>dairy</w>.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал снизить потребление жиров и <w>молочных продуктов</w>.",
                                "zh": "医生建议他减少脂肪和<w>乳制品</w>的摄入量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dairy free",
                        "eat dairy",
                        "avoid dairy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукты питания и напитки, изготовленные из молока, такие как сыр, йогурт и масло.",
                        "zh": "由牛奶制成的食品和饮料，如奶酪、酸奶和黄油。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочные продукты",
                                "target_lang_sense_clarification": "еда"
                            },
                            {
                                "target_lang_word": "молочка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳制品",
                                "target_lang_sense_clarification": "正式用语"
                            },
                            {
                                "target_lang_word": "奶制品",
                                "target_lang_sense_clarification": "常用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b45f40-54cb-3933-a7db-ab7b19851bee",
                    "sense_definition": "A farm dedicated to the production of milk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew up working on a <w>dairy</w> in the countryside.",
                            "target_lang_translations": {
                                "ru": "Он вырос, работая на <w>молочной ферме</w> в сельской местности.",
                                "zh": "他在乡下的一个<w>奶牛场</w>工作长大。"
                            }
                        },
                        {
                            "text": "The family owns a large <w>dairy</w> with over two hundred cows.",
                            "target_lang_translations": {
                                "ru": "Семья владеет большой <w>молочной фермой</w> с более чем двумя сотнями коров.",
                                "zh": "这家人拥有一个养了二百多头牛的大型<w>奶牛场</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ферма, специализирующаяся на производстве молока.",
                        "zh": "专门从事牛奶生产的农场。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочная ферма",
                                "target_lang_sense_clarification": "предприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奶牛场",
                                "target_lang_sense_clarification": "生产牛奶的农场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1150d2-6245-3563-b9cc-7e092614d212",
                    "sense_definition": "A building or room, often on a farm, where milk is stored and processed into products like butter or cheese.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh milk was carried to the <w>dairy</w> to be separated.",
                            "target_lang_translations": {
                                "ru": "Свежее молоко отнесли в <w>маслодельню</w> для сепарации.",
                                "zh": "鲜奶被送到<w>乳品加工间</w>进行分离。"
                            }
                        },
                        {
                            "text": "She works in the <w>dairy</w> making artisanal cheeses.",
                            "target_lang_translations": {
                                "ru": "Она работает в <w>молочной</w>, изготавливая ремесленные сыры.",
                                "zh": "她在<w>乳品加工间</w>工作，制作手工奶酪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "milkhouse",
                        "milkery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или помещение, часто на ферме, где хранится молоко и перерабатывается в такие продукты, как масло или сыр.",
                        "zh": "建筑物或房间，通常在农场，用于储存牛奶并将其加工成黄油或奶酪等产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маслодельня",
                                "target_lang_sense_clarification": "цех переработки"
                            },
                            {
                                "target_lang_word": "молочная",
                                "target_lang_sense_clarification": "помещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳品加工间",
                                "target_lang_sense_clarification": "加工场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57032d25-b879-3741-ba86-b974b2a58d2d",
                    "sense_definition": "A shop that primarily sells milk, eggs, cheese, and other milk products.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you run to the <w>dairy</w> and buy some cream?",
                            "target_lang_translations": {
                                "ru": "Ты можешь сбегать в <w>молочный магазин</w> и купить сливок?",
                                "zh": "你能跑一趟<w>乳品店</w>买点奶油吗？"
                            }
                        },
                        {
                            "text": "The old <w>dairy</w> on the corner sells the best fresh yogurt.",
                            "target_lang_translations": {
                                "ru": "Старая <w>молочная</w> на углу продает лучший свежий йогурт.",
                                "zh": "街角那家老<w>乳品店</w>卖的鲜酸奶最好喝。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Магазин, в котором в основном продаются молоко, яйца, сыр и другие молочные продукты.",
                        "zh": "主要销售牛奶、鸡蛋、奶酪和其他乳制品的商店。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочный магазин",
                                "target_lang_sense_clarification": "торговая точка"
                            },
                            {
                                "target_lang_word": "молочная",
                                "target_lang_sense_clarification": "разговорное название магазина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳品店",
                                "target_lang_sense_clarification": "专门店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "133755f7-2773-331a-940b-06fe1d71226f",
                    "sense_definition": "A small local convenience store or corner shop selling groceries and newspapers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stopped at the <w>dairy</w> to grab a drink and a pie.",
                            "target_lang_translations": {
                                "ru": "Я остановился у <w>магазинчика</w>, чтобы взять напиток и пирог.",
                                "zh": "我在<w>便利店</w>停下来买了一杯饮料和一个派。"
                            }
                        },
                        {
                            "text": "The kids rode their bikes to the <w>dairy</w> after school.",
                            "target_lang_translations": {
                                "ru": "Дети поехали на велосипедах в <w>магазин</w> после школы.",
                                "zh": "孩子们放学后骑自行车去了<w>便利店</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой местный магазин шаговой доступности, торгующий продуктами и газетами (преимущественно в Новой Зеландии).",
                        "zh": "小型本地便利店或杂货店，出售食品和报纸（主要在新西兰）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магазинчик",
                                "target_lang_sense_clarification": "небольшой магазин"
                            },
                            {
                                "target_lang_word": "продуктовый магазин",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便利店",
                                "target_lang_sense_clarification": "小型零售店"
                            },
                            {
                                "target_lang_word": "杂货店",
                                "target_lang_sense_clarification": "小型社区商店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d16162cd-3282-378a-9d07-f8e9cd82f9ba",
                    "sense_definition": "A slang term for a woman's breast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made an inappropriate joke about her <w>dairies</w>.",
                            "target_lang_translations": {
                                "ru": "Он отпустил неуместную шутку про её <w>дойки</w>.",
                                "zh": "他开了个关于她<w>奶子</w>的不当玩笑。"
                            }
                        },
                        {
                            "text": "The comedian used a vulgar term for <w>dairies</w> in his routine.",
                            "target_lang_translations": {
                                "ru": "Комик использовал вульгарный термин для <w>доек</w> в своем выступлении.",
                                "zh": "那位喜剧演员在表演中用了一个关于<w>奶子</w>的粗俗词汇。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название женской груди.",
                        "zh": "指代女性乳房的俚语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дойки",
                                "target_lang_sense_clarification": "вульгарное"
                            },
                            {
                                "target_lang_word": "буфера",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奶子",
                                "target_lang_sense_clarification": "粗俗俚语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
