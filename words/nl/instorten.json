                        {
                            "text": "Veel experts denken dat het politieke regime binnenkort kan <w>instorten</w> door de aanhoudende protesten.",
                            "target_lang_translations": {
                                "en": "Many experts think the political regime could soon <w>collapse</w> due to the ongoing protests."
                            }
                        }
                    ],
                    "synonyms": [
                        "ineenstorten"
                    ],
                    "common_phrases": [
                        "de markt instorten",
                        "het regime instorten"
                    ],
                    "target_lang_definitions": {
                        "en": "The ceasing to exist of a system, regime, or market due to external pressure or weakness"
                    },
                    "translations": {
