                        "entry_id": "c737ad0a-973b-391d-b0a7-75df2a0670df",
                        "glosses": [
                            "One who preëmpts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b68fcf-1990-4e97-a816-acd978905ed5",
                                "sense_id": "da615472-9313-31a7-8f63-d8d2d398f38a",
                                "text": "If the preëmptor filed his claim one day or one week before he commenced his occupation, his claim, as against the railroad company, is fraudulent."
                            },
                            {
                                "example_id": "5a67a11b-e815-4a16-b25e-56d7b92803ba",
                                "sense_id": "da615472-9313-31a7-8f63-d8d2d398f38a",
                                "text": "In spite of this, whenever there was no convenient machinery for determining who was the rightful preëmptor the land title remained unsettled."
                            },
                            {
                                "example_id": "7903e348-b4fe-49b6-b815-697d35dcddf4",
                                "sense_id": "da615472-9313-31a7-8f63-d8d2d398f38a",
                                "text": "The municipal preëmptor, like the agricultural preëmptor, is required to take his land in conformity with “the legal subdivisions of the public lands”. I apprehend the import of the requirement is the same in both cases. Neither class of preëmptors is to break the legal subdivisions as surveyed. The preëmptor of either case may take fractional sections if he will, but he is in every case to run his extreme lines with the lines of the surveyed subdivisions."
                            }
                        ]
                    }
