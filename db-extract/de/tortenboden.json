                "senses": [
                    {
                        "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                        "entry_id": "45f0ef8c-ece8-3469-9030-e8f3481b66fc",
                        "glosses": [
                            "unterste Schicht einer Torte/eines Kuchens, die (meist) aus Teig besteht"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "6954f17d-358b-4ae1-8afe-24da45881026",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "Er legte die Früchte auf den Tortenboden."
                            },
                            {
                                "example_id": "2234c0a7-664e-4a4e-a248-5e42dd59fdc4",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "Der Tortenboden ist etwas hart geworden."
                            },
                            {
                                "example_id": "171eae70-c1dd-4343-8849-83aa3dfae47d",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "Für den Tortenboden braucht man 150 g Mehl, fünf Eier, 120 g Zucker, 100 g Speisestärke, 1 Prise Salz, 1 Päckchen Vanillezucker und 50 ml Öl."
                            },
                            {
                                "example_id": "4a556967-28cb-4259-b65c-e4540b3ec199",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Der Mandelteig kann auch als feine Basis für einen Tortenboden dienen.“"
                            },
                            {
                                "example_id": "44d2fba6-abfe-4201-b21e-09b31cc27f72",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Wenn es schnell gehen muss, ist so ein gekaufter Tortenboden etwas Feines.“"
                            },
                            {
                                "example_id": "0a763b30-b9ef-4192-9a60-f03d99bdac02",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Sie weigern sich, fertigen Tortenboden zu kaufen? Nun, dann ist der schnellste Erdbeerkuchen nicht mehr ganz so schnell, aber mit diesem Rezept klappt es sicher:“ […]."
                            },
                            {
                                "example_id": "eeb39e9a-6f31-42b7-9434-260d984b41b8",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Brandteig eignet sich hervorragend für Windbeutel, Profiteroles oder als luftiger und saftiger Tortenboden.“"
                            },
                            {
                                "example_id": "39945696-dfae-4da4-8dfd-12434f95656a",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Mit diesem Grundrezept gelingen euch die nächste Biskuitrolle oder der nächste Tortenboden garantiert!“"
                            },
                            {
                                "example_id": "d82b4417-2cc1-4d18-ad9c-53002aa8bfa5",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Beim Backen von Biskuitteig ist das Einfetten der Form ein beliebter Fehler! Ist der Rand der Backform eingefettet, kann der Tortenboden sich nicht mehr nach oben arbeiten und fällt in sich zusammen, wenn man ihn aus dem Ofen nimmt.“"
                            },
                            {
                                "example_id": "f15dfa49-2df5-4d9f-80f1-5b7b488a2042",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Um zu verhindern, dass Tortenböden beim Backen in der Mitte einen Hubbel bekommen, wickeln Sie ein kühles feuchtes Tuch (ein Stück Stoffrest eignet sich gut) oder Alufolie um die Form. So erhitzt sich die Form gleichmäßig und der Kuchen geht an allen Stellen gleich auf.“"
                            },
                            {
                                "example_id": "c9591af2-c31d-4830-a214-a1bd14af7232",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Andrea Anwander aus Memmingen hat ein buntes Mehl aus Gemüse entwickelt. Es besteht aus einer Mischung aus Weizenmehl und Gemüsepulver. Damit soll man zum Beispiel bunte Tortenböden aus Mürbeteig machen können – als Alternative zu Lebensmittelfarbe.“"
                            },
                            {
                                "example_id": "020cea8e-8f8b-41ec-ac35-e7d628467a0e",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Zuallererst sollte der Tortenboden gut aufgegangen und vor dem Schneiden vollständig ausgekühlt sein. Im besten Fall lasst ihr den Biskuitboden sogar über Nacht ruhen.“"
                            },
                            {
                                "example_id": "6606b2e2-2497-4350-bf18-182b8ea330b3",
                                "sense_id": "1a9fbde6-f7e6-3d56-8638-e217c243222c",
                                "text": "„Vor allem ihre Halbfabrikate, die Tartelettes, seien in der Gastronomie gefragt. Dabei handelt es sich um leere Tortenböden in einer süssen oder salzigen Variante, welche in unterschiedlichen Grössen produziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
