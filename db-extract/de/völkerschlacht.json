                ],
                "senses": [
                    {
                        "sense_id": "96301acc-4d1e-319c-88d2-0452f0bbe906",
                        "entry_id": "bffd854a-213e-3569-ab3a-536407c997a1",
                        "glosses": [
                            "Bezeichnung für die Schlacht 1813 bei Leipzig, die mit der entscheidenden Niederlage Napoleons endete."
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "cd2217a7-e0ae-4f4d-9685-d0cc79ac607a",
                                "sense_id": "96301acc-4d1e-319c-88d2-0452f0bbe906",
                                "text": "„Völkerschlacht nannte Karl Freiherr von Müffling, wie Gombert, Festg. anschaulich gezeigt hat, mit sicherem Treffer die große Leipziger Schlacht vom Oktober 1813 und schuf damit ein Fahnenwort von bleibender Geltung.“"
                            },
                            {
                                "example_id": "ccbfd34c-d331-4a16-9f58-2e6dc76d811c",
                                "sense_id": "96301acc-4d1e-319c-88d2-0452f0bbe906",
                                "text": "„Indem Loest seinem Fredi Linden verschiedene Identitäten gibt, gelingt ihm der große Bogen von der Völkerschlacht über die Weltkriege und die friedliche Revolution von 1989 bis ins neue Jahrtausend.“"
                            },
                            {
                                "example_id": "3befea03-96a5-4f17-965b-9c5a81167e38",
                                "sense_id": "96301acc-4d1e-319c-88d2-0452f0bbe906",
                                "text": "„Dieses schwachmachende Wort Angst gab es seit der Völkerschlacht bei Leipzig im Haus der Ritter von Stuhr nicht.“"
                            },
                            {
                                "example_id": "f449b6f2-0cd0-4cc6-bfe8-a439254c73e3",
                                "sense_id": "96301acc-4d1e-319c-88d2-0452f0bbe906",
                                "text": "„In der Völkerschlacht bei Leipzig hatten sich die schlagkräftigsten deutschen Fürstentümer unter Preußen zusammengetan, um mit Hilfe Russlands und Schwedens Napoleon aus Deutschland zu verjagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "003031be-345f-3efb-a1e3-a4b4fb70b9d1",
                        "entry_id": "bffd854a-213e-3569-ab3a-536407c997a1",
                        "glosses": [
                            "große Kampfhandlung zwischen Angehörigen unterschiedlicher Bevölkerungsgruppen/Ethnien"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "450e37d8-6490-4eb7-9059-19860d0b78a2",
                                "sense_id": "003031be-345f-3efb-a1e3-a4b4fb70b9d1",
                                "text": "„Allerdings wird es kaum zu Völkerschlachten gekommen sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
