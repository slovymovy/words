                                            {
                                                "example_id": "fd7ff883-8eff-47f6-8222-3fd3da06fb54",
                                                "sense_id": "860f8380-e81a-37c7-bc3d-6cb28820a9b6",
                                                "text": "You never planned on the bombs in the sand\nOr sleeping in your dress blues."
