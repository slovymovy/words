                "senses": [
                    {
                        "sense_id": "98bf4a22-fa15-357f-b5ae-5c7676f48361",
                        "entry_id": "3137dcfe-68b8-3536-8b98-72f5f23a09fb",
                        "glosses": [
                            "Qualifie la frange de cils ou de membranelles, située tout autour du péristome de certaines espèces d’infusoires, qui s’en servent pour induire, en la faisant vibrer, un courant d’eau vers leur péristome pour se nourrir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccec3101-4cd6-4cb5-9955-65a5ce37f95b",
                                "sense_id": "98bf4a22-fa15-357f-b5ae-5c7676f48361",
                                "text": "La frange adorale des Tintinnoïdiens, comme celle de tous les Infusoires Hétérotriches, est constituée par une série de larges membranelles parallèles les unes aux autres, orientées dans un plan perpendiculaire à celui de la frange […]."
                            },
                            {
                                "example_id": "f4996474-b609-4456-994a-410fac127d24",
                                "sense_id": "98bf4a22-fa15-357f-b5ae-5c7676f48361",
                                "text": "Les Spirotriches ont une frange adorale sénestre, c’est-à-dire que, pour un observateur extérieur regardant le péristome, la frange adorale s’enroule à partir du cytostome dans le sens des aiguilles d’une montre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c4523c4-7b01-3ddf-ab8a-669a0a476913",
                        "entry_id": "3137dcfe-68b8-3536-8b98-72f5f23a09fb",
                        "glosses": [
                            "Qualifie ces cils ou membranelles eux-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026b416a-83e0-4527-ac35-5fb334f0548d",
                                "sense_id": "1c4523c4-7b01-3ddf-ab8a-669a0a476913",
                                "text": "Ses cils adoraux permettent à l’infusoire de se nourrir."
                            }
                        ]
                    }
                ],
