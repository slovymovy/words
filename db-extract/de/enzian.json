                        "entry_id": "57c25f39-a3aa-30c9-8151-e527740ead73",
                        "glosses": [
                            "Gebirgspflanze der Gattung Gentiana aus der Familie der Enziangewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd0bd27-6966-48a6-a717-7b0a8971a42e",
                                "sense_id": "e206d0f6-5fff-3575-9770-4160f9d8faad",
                                "text": "Die meisten Enziane blühen blau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                        "entry_id": "57c25f39-a3aa-30c9-8151-e527740ead73",
                        "glosses": [
                            "Spirituose, die aus den Wurzeln des gelben Enzians gebrannt wird"
                        ],
                        "tags": [
                            "Plural nur für Sorten"
                        ],
                        "examples": [
                            {
                                "example_id": "0289937f-7a29-412a-ba1d-a97d35deb904",
                                "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                                "text": "Enzian schmeckt ziemlich bitter."
                            },
                            {
                                "example_id": "4dcc4bee-5911-46e8-8fe3-47baa0a4e48e",
                                "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                                "text": "„Es gab auch anderes zu trinken, wunderbaren Kirsch, der im Tal hergestellt wurde, und Enzian, der aus Gebirgsenzian gebrannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
