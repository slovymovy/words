                                    {
                                        "sense_id": "4caaae26-b27b-3a2b-ad1e-5afb1b05324c",
                                        "entry_id": "22758908-f69e-3cb0-8dc5-daa095c1ff8c",
                                        "glosses": [
                                            "eine der Erinnyen (Rachegöttinnen)"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
