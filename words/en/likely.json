                                "target_lang_word": "很可能",
                                "target_lang_sense_clarification": "表示大概率"
                            },
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "表示推测"
                            }
                        ]
                    }
                }
