{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9b5f176d-0225-38a3-8ef5-8982c9259d14",
                    "sense_definition": "Used to express agreement, approval, or gratitude; thanks or cheers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "greeting_and_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He handed me a cold drink on that hot afternoon, and I simply said, \"<w>Chur</w>, bro!\"",
                            "target_lang_translations": {
                                "ru": "В тот жаркий день он протянул мне холодный напиток, и я просто сказал: «<w>Спасибо</w>, бро!»"
                            }
                        },
                        {
                            "text": "\"<w>Chur</w> for helping me change that flat tire earlier today,\" he said with a grateful smile.",
                            "target_lang_translations": {
                                "ru": "«<w>Пасиб</w>, что помог мне заменить пробитое колесо сегодня утром», — сказал он с благодарной улыбкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "thank you"
                    ],
                    "common_phrases": [
                        "chur bro"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "primarily New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное новозеландское выражение согласия, одобрения или благодарности; «спасибо», «отлично», «договорились»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасибо",
                                "target_lang_sense_clarification": "благодарность"
                            },
                            {
                                "target_lang_word": "пасиб",
                                "target_lang_sense_clarification": "разговорная благодарность"
                            },
                            {
                                "target_lang_word": "ништяк",
                                "target_lang_sense_clarification": "одобрение, отлично"
                            },
                            {
                                "target_lang_word": "ладов",
                                "target_lang_sense_clarification": "согласие, добро"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "074e6633-b879-3309-99f1-a00991a60ada",
                    "sense_definition": "Used as a friendly parting greeting; goodbye or see you later.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "greeting_and_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I have to catch the last bus now, so <w>chur</w>, see you tomorrow!\"",
                            "target_lang_translations": {
                                "ru": "«Мне пора на последний автобус, так что <w>бывай</w>, увидимся завтра!»"
                            }
                        },
                        {
                            "text": "He waved out the car window as he drove away, calling out, \"<w>Chur</w>, mate!\"",
                            "target_lang_translations": {
                                "ru": "Уезжая, он помахал из окна машины и крикнул: «<w>Пока</w>, приятель!»"
                            }
                        }
                    ],
                    "synonyms": [
                        "goodbye"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "primarily New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеское прощание в новозеландском сленге; «пока», «давай»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "прощание"
                            },
                            {
                                "target_lang_word": "бывай",
                                "target_lang_sense_clarification": "дружеское прощание"
                            },
                            {
                                "target_lang_word": "давай",
                                "target_lang_sense_clarification": "разговорное прощание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb74b275-5815-3ff3-a44d-c9d26e11cf88",
                    "sense_definition": "An island, sandbank, or shoal formed by river silt and sediment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the dry season, local farmers graze cattle on the newly formed <w>chur</w> in the river.",
                            "target_lang_translations": {
                                "ru": "В сухой сезон местные фермеры пасут скот на новообразованном речном <w>острове</w>."
                            }
                        },
                        {
                            "text": "The seasonal floodwaters completely washed away the fragile silt of the <w>chur</w> overnight.",
                            "target_lang_translations": {
                                "ru": "Сезонное половодье за одну ночь полностью смыло рыхлый ил песчаной <w>отмели</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Островок, песчаная отмель или коса, образованная речными илистыми отложениями (в Южной Азии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "речной остров",
                                "target_lang_sense_clarification": "наносной"
                            },
                            {
                                "target_lang_word": "отмель",
                                "target_lang_sense_clarification": "песчаная или илистая коса"
                            },
                            {
                                "target_lang_word": "чур",
                                "target_lang_sense_clarification": "термин для наносных речных островов в Южной Азии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "34dc2396-dadb-3c5f-a88b-f12d3ae5920e",
                    "sense_definition": "A town and the capital city of the canton of Graubünden in eastern Switzerland.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a scenic train ride through the mountains before stopping overnight in <w>Chur</w>.",
                            "target_lang_translations": {
                                "ru": "Мы совершили живописную поездку на поезде через горы перед тем, как остановиться на ночь в <w>Куре</w>."
                            }
                        },
                        {
                            "text": "As the oldest city in Switzerland, <w>Chur</w> has a fascinating historic center to explore.",
                            "target_lang_translations": {
                                "ru": "Будучи старейшим городом Швейцарии, <w>Кур</w> может похвастаться очаровательным историческим центром."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в восточной Швейцарии, столица кантона Граубюнден."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кур",
                                "target_lang_sense_clarification": "город в Швейцарии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ff6ab853-4e40-37a1-821f-132cd63fc2f6",
                    "sense_definition": "Overwhelming, demanding, or intense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "demanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Completing three difficult exams on the same afternoon was far too <w>chur</w> for the students.",
                            "target_lang_translations": {
                                "ru": "Сдача трех сложных экзаменов в один и тот же день оказалась слишком <w>лютым испытанием</w> для студентов."
                            }
                        },
                        {
                            "text": "Working twelve hours straight without any break proved to be a really <w>chur</w> task.",
                            "target_lang_translations": {
                                "ru": "Работа двенадцать часов подряд без перерыва оказалась по-настоящему <w>тяжёлой</w> задачей."
                            }
                        }
                    ],
                    "antonyms": [
                        "hea"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошеломляющий, крайне тяжелый, напряженный или выматывающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "крайне утомительный или трудный"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "интенсивный, хардкорный"
                            },
                            {
                                "target_lang_word": "лютый",
                                "target_lang_sense_clarification": "сленг: чересчур напряжённый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76775ab8-6720-37da-a3bf-3e02e3920c6b",
                    "sense_definition": "To undertake or do something overwhelming, demanding, or intense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "demanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletes had to <w>chur</w> all through the weekend to prepare for the national championship.",
                            "target_lang_translations": {
                                "ru": "Спортсменам пришлось <w>пахать</w> все выходные, чтобы подготовиться к национальному чемпионату."
                            }
                        },
                        {
                            "text": "If we want to hit the deadline, we will definitely have to <w>chur</w> tonight.",
                            "target_lang_translations": {
                                "ru": "Если мы хотим успеть к дедлайну, нам сегодня вечером точно придется <w>вкалывать</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Браться за что-то крайне напряженное; тяжело вкалывать, пахать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "усердно и тяжело работать"
                            },
                            {
                                "target_lang_word": "пахать",
                                "target_lang_sense_clarification": "напряженно трудиться"
                            },
                            {
                                "target_lang_word": "потеть",
                                "target_lang_sense_clarification": "прилагать огромные усилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
