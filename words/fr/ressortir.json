{
    "word_family": [
        "sortir",
        "sortie",
        "sortant",
        "ressort",
        "ressortissant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f68fb67-126c-30e0-abe0-c32d6195d111",
                    "sense_definition": "Sortir de nouveau d'un lieu après y être entré ou y être retourné.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est rentré chez lui un instant et en est <w>ressorti</w> quelques minutes plus tard."
                        },
                        {
                            "text": "Elle ne veut pas <w>ressortir</w> ce soir car la pluie tombe avec force."
                        }
                    ],
                    "antonyms": [
                        "rentrer"
                    ],
                    "common_phrases": [
                        "ressortir aussitôt",
                        "ressortir de la maison"
                    ]
                },
                {
                    "sense_id": "842eefe0-7da1-3989-9962-bca1e69855e3",
                    "sense_definition": "Sortir de nouveau un objet de l'endroit où il était rangé ou conservé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec l'arrivée du froid, nous avons enfin <w>ressorti</w> les gros manteaux du placard."
                        },
                        {
                            "text": "Il a <w>ressorti</w> ses vieux cahiers d'école pour aider son fils à réviser."
                        }
                    ],
                    "synonyms": [
                        "exhumer"
                    ],
                    "antonyms": [
                        "ranger"
                    ],
                    "common_phrases": [
                        "ressortir du placard",
                        "ressortir de vieux souvenirs"
                    ]
                },
                {
                    "sense_id": "7cd027f1-fa76-3143-9eba-3c1175394949",
                    "sense_definition": "Se détacher visuellement sur un fond ou être mis en valeur par un contraste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette écharpe rouge fait magnifiquement <w>ressortir</w> la couleur sombre de ton manteau."
                        },
                        {
                            "text": "Les lettres blanches <w>ressortent</w> très clairement sur ce panneau d'affichage noir."
                        }
                    ],
                    "synonyms": [
                        "se détacher",
                        "trancher"
                    ],
                    "common_phrases": [
                        "faire ressortir la couleur",
                        "faire ressortir les contrastes"
                    ]
                },
                {
                    "sense_id": "53c0fc45-8348-3dbe-803c-2d1397771918",
                    "sense_definition": "Se dégager ou résulter d'une observation, d'une analyse ou de faits établis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>ressort</w> de cette longue enquête que plusieurs erreurs administratives ont été commises."
                        },
                        {
                            "text": "De toutes les discussions de la journée, il <w>ressort</w> une volonté claire d'avancer."
                        }
                    ],
                    "synonyms": [
                        "découler",
                        "résulter",
                        "se dégager"
                    ],
                    "common_phrases": [
                        "il en ressort que",
                        "ressortir clairement des faits"
                    ]
                },
                {
                    "sense_id": "b6c9994a-d7d0-372a-af55-e1a5a861669c",
                    "sense_definition": "Relever de la compétence ou du domaine d'une juridiction, d'une autorité ou d'une catégorie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce litige commercial <w>ressortit</w> directement à la compétence du tribunal de commerce."
                        },
                        {
                            "text": "Cette décision administrative ne <w>ressortit</w> pas au pouvoir du maire mais à celui de l'État."
                        }
                    ],
                    "synonyms": [
                        "appartenir à",
                        "relever de"
                    ],
                    "common_phrases": [
                        "ressortir au domaine",
                        "ressortir à la compétence"
                    ]
                }
            ]
        }
    ]
}