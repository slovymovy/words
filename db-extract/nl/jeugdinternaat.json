                        "examples": [
                            {
                                "example_id": "18efd743-f107-4bf1-bf07-f6995c70910a",
                                "sense_id": "9123cc75-0be2-3ec2-aff8-208dc156a934",
                                "text": "Lecter was overtuigd dat er vanzelf aanwijzingen naar voren kwamen wanneer hij de details van de misdrijven onder ogen had, mogelijk iets wat te maken had met Gumbs opvoeding in het jeugdinternaat nadat hij zijn grootouders had vermoord."
                            },
                            {
                                "example_id": "82889a0f-abdb-4617-8654-ef5ba7893165",
                                "sense_id": "9123cc75-0be2-3ec2-aff8-208dc156a934",
                                "text": "Ze heeft geen aangifte gedaan tegen haar chauffeurs en klanten. \"Ik heb geen hulp gehad en ik heb zelf mijn klanten misleid\", zei ze. Momenteel verblijft ze in een jeugdinternaat in Noord-Brabant."
                            }
                        ]
