                        "source_sense_id": "11d92ff9-ae12-3258-9d5e-db51bcdef616",
                        "source_sense_description": "een hoog geluid voortbrengen zoals kleine zangvogels dat doen; piepen als een vogeltje",
                        "target_lang_word": "twitter",
