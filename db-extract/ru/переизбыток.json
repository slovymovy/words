                                        "sense_id": "802f777a-1c77-3898-9a99-c54c745b2dc7",
                                        "entry_id": "bf933154-3343-35b5-a647-d604b5380a5a",
                                        "glosses": [
                                            "Redundancy."
                                        ],
                                        "tags": [
