                "senses": [
                    {
                        "sense_id": "fc5d1087-4ecf-3275-ba49-ae2d92cdfcac",
                        "entry_id": "f92eb274-e247-36c0-9813-82b64a5ac217",
                        "glosses": [
                            "kugelige Membransäckchen, die im Golgi-Apparat gebildet werden und zum Transport von Proteinen etc. innerhalb der Zelle dienen. An den aufgeblähten Rändern der Membranzisternen von Dictyosomen werden die bläschenartigen Golgi-Vesikel abgeschnürt."
                        ],
                        "tags": [
                            "Cytologie"
                        ],
                        "examples": [
                            {
