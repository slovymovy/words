                                        "sense_id": "6f7735bb-8e49-3dc4-99d2-6dc5d4f81e16",
                                        "entry_id": "f509083f-ad6c-35f8-a5b8-e6e52107f9d0",
                                        "glosses": [
                                            "To stay beyond or longer than."
                                        ],
