                                    {
                                        "sense_id": "89ea2f72-d078-34ae-9b39-af142d680905",
                                        "entry_id": "bd43bb9b-2f93-37d0-89ac-3c024d3bd84d",
                                        "glosses": [
                                            "Celui qui se livre à l’exercice du skateboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20d351b-2fa2-44f1-9acb-30b0e6851553",
                                                "sense_id": "89ea2f72-d078-34ae-9b39-af142d680905",
                                                "text": "Surfeur et skateboardeur invétéré, Wendell travaillait uniquement pour financer sa passion de la glisse mais, malgré sa tignasse désordonnée et sa dégaine à la coule, il était brillant, pointilleux et avait un don pour les chiffres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae492e59-b65b-427f-974e-b04f7ae5823c",
                        "source_entry_id": "a0cd4e94-7eb2-3afb-8ff2-2eede93f72f4",
                        "source_sense_id": "6b55aebf-ec4f-31fc-a3b7-202d1878cc8e",
                        "target_lang_word": "skateboardeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skateboardeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7f8ecd-abff-30b7-a643-de446960f79e",
                                        "entry_id": "cc34c555-e88c-392a-ae63-693663575e4e",
                                        "glosses": [
                                            "Femme ou fille qui s'adonne à la pratique du skateboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a602e8c4-d2ab-4712-aea4-23e9382398de",
                                                "sense_id": "0b7f8ecd-abff-30b7-a643-de446960f79e",
                                                "text": "Elle me rappelait davantage une skateboardeuse qu'une cavalière mais tout le monde disait qu'elle montait depuis des années et qu'elle était excellente."
                                            },
                                            {
                                                "example_id": "6b18b683-337d-460c-b846-44daf6cc0658",
                                                "sense_id": "0b7f8ecd-abff-30b7-a643-de446960f79e",
                                                "text": "Pour photographier la petite skateboardeuse de la figure ci-contre, j'ai dû quantifier la lumière illuminant d'une part le visage et d'autre part la planche de skate."
                                            },
                                            {
                                                "example_id": "74742103-0e36-48d5-bef0-900cdc66df26",
                                                "sense_id": "0b7f8ecd-abff-30b7-a643-de446960f79e",
                                                "text": "C'était au départ un groupe de skateboardeuses qui voulaient un espace à elles dans une communauté dominée par des hommes blancs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2601473-c0c1-4bb0-b773-4d14d4752ba6",
                        "source_entry_id": "a0cd4e94-7eb2-3afb-8ff2-2eede93f72f4",
                        "source_sense_id": "6b55aebf-ec4f-31fc-a3b7-202d1878cc8e",
                        "target_lang_word": "planchiste",
