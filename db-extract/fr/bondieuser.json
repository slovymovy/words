                "senses": [
                    {
                        "sense_id": "4954779c-1f3e-3e5e-82a8-ee0cb97810e2",
                        "entry_id": "a8bc92df-281d-341b-9b12-49af3b6eabc4",
                        "glosses": [
                            "Être essentiellement préoccupé de religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720c6aa0-4bc3-4ae3-98ab-19f1eb84d96e",
                                "sense_id": "4954779c-1f3e-3e5e-82a8-ee0cb97810e2",
                                "text": "Certes, c’est beaucoup, je vous l’accorde, mais point assez vraiment, pour bondieuser, comme vous bondieusez, en ce moment, sur notre planète, —et je crois que l’avenir le signifiera durement à votre mémoire."
                            },
                            {
                                "example_id": "04fd4a49-a4dc-4fff-b8e8-0d3d509d901b",
                                "sense_id": "4954779c-1f3e-3e5e-82a8-ee0cb97810e2",
                                "text": "J’avais autre chose à faire que d’aller bondieuser toute ma vie dans un couvent."
                            }
                        ]
                    },
                    {
                        "sense_id": "bef8b29d-c59e-3933-8c9e-7fba16aebe0b",
                        "entry_id": "a8bc92df-281d-341b-9b12-49af3b6eabc4",
                        "glosses": [
                            "Donner un caractère divin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e81c977-0a1d-4f11-8034-fd8713b3d78b",
                                "sense_id": "bef8b29d-c59e-3933-8c9e-7fba16aebe0b",
                                "text": "Drôle de peuple que ce peuple français ! Il ne veut plus de Dieu, il ne veut plus de religion, et vient-il de débondieuser le Christ, aussitôt, il bondieuse Hugo et proclame l’hugolâtrie."
                            }
                        ]
                    }
