                "senses": [
                    {
                        "sense_id": "6021a788-479e-3f3d-86f6-77ea6e3eb8e0",
                        "entry_id": "fb42d431-2612-38dc-bf09-e466fbb365bb",
                        "glosses": [
                            "stopień kawaleryjski w wojskach kozackich carskiej Rosji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f3d6cd86-4062-3a01-b53a-3d4aa5d61727",
                        "entry_id": "fb42d431-2612-38dc-bf09-e466fbb365bb",
                        "glosses": [
                            "oficer noszący stopień esauła (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a5864c-9254-4505-80b5-7eda0c5f6157",
                                "sense_id": "f3d6cd86-4062-3a01-b53a-3d4aa5d61727",
                                "text": "Porządku między kurzeniami pilnowali esaułowie zbrojni w tęgie kije dębowe dla hamowania obradujących i w pistolety dla obrony własnego życia, które często bywało w niebezpieczeństwie"
                            },
                            {
                                "example_id": "fc73cac3-adbf-45e6-a7ac-ecf74582177f",
                                "sense_id": "f3d6cd86-4062-3a01-b53a-3d4aa5d61727",
                                "text": "Esauł okazał się domyślny. Rozwiązał zagadkę mego snu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7e7e90b5-ef1f-373d-88c3-1e92bfe62ea6",
                        "entry_id": "fb42d431-2612-38dc-bf09-e466fbb365bb",
                        "glosses": [
                            "zastępca lub przyboczny atamana koszowego u Kozaków zaporoskich"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
