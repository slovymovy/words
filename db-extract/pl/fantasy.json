                                "target_senses": [
                                    {
                                        "sense_id": "b3d94eb2-b3f7-3f70-aec0-80dd0dce4d2c",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To conceive (something) mentally; to imagine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d65fdc1-e973-342e-ade4-bc56a817bcfb",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To fantasize about something)."
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ecf349-408b-4e03-8e23-78e18c27b143",
                                                "sense_id": "4d65fdc1-e973-342e-ade4-bc56a817bcfb",
                                                "text": "Perhaps I would be able to help him recapture the well-being and emotional closeness he fantasied his brother had experienced with his parents prior to his birth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1232902e-4745-3a30-9f14-4f42ac29b7db",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To conceive mentally; to imagine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9a250a-8393-46b9-b399-9d7090dd437b",
                                                "sense_id": "1232902e-4745-3a30-9f14-4f42ac29b7db",
                                                "text": "Firſt I phantaſied that if I liſt to take vpon me the crowne and imperiall Scepter of the realme, now was the time propice and conuenient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To have a fancy for; to be pleased with; to like."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca19f5b0-7ab9-49d0-a83a-8b93af354eb6",
                                                "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                                "text": "Which he doth most fantasy."
                                            },
                                            {
                                                "example_id": "2d2c1f8d-6cf4-4956-bf39-2f98f9b34b32",
                                                "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                                "text": "The kyng fantasied so much his daughter Anne that almost everything began to grow out of frame and good order"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
