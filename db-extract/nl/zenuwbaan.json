        "nl-extract.jsonl": [
            {
                "entry_id": "f3558927-f155-39e7-9cdb-d7b3b4088933",
                "word": "zenuwbaan",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "13982c76-a38a-4005-a850-dd5f2bb1e9b1",
                        "entry_id": "f3558927-f155-39e7-9cdb-d7b3b4088933",
                        "tags": [
                            "plural"
                        ],
                        "form": "zenuwbanen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bb8deea-72d3-3b87-9fb5-265f503f8991",
                        "entry_id": "f3558927-f155-39e7-9cdb-d7b3b4088933",
                        "glosses": [
                            "een onderdeel van het perifere zenuwstelsel en bestaat uit gebundelde uitlopers van zenuwcellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0706e8f6-6df5-4b6f-8289-b030ab140885",
                                "sense_id": "2bb8deea-72d3-3b87-9fb5-265f503f8991",
                                "text": "De operatief onderhuids geplaatste ’neurostimulator’ tempert de pijngeleiding in de hersenen via stimulatie van de achterhoofdszenuw, de ’nervus occipitalis major’. Deze zenuwbaan in de hersenen is verantwoordelijk voor dikwijls vele hoofdpijnaanvallen per dag."
                            },
                            {
                                "example_id": "c12444d5-9cd1-471d-b6ca-93371749a9b9",
                                "sense_id": "2bb8deea-72d3-3b87-9fb5-265f503f8991",
                                "text": "Eenvoudig onderzoek op het wereld wijde web leert dat het middel een Amerikaanse vinding is van een paar jaar geleden. Het komt er op neer dat de wasachtige substantie rond de zenuwbanen die bij MS beschadigd raken waardoor signalen niet meer of vertraagd aankomen, wordt hersteld. De zogeheten remyelinisering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60d85499-b36e-47f4-b6d2-e4d28aaa4b62",
                        "source_entry_id": "f3558927-f155-39e7-9cdb-d7b3b4088933",
                        "source_sense_id": "2bb8deea-72d3-3b87-9fb5-265f503f8991",
                        "target_lang_word": "nerve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d0d7cb-f711-30f5-a634-4cf440046b4e",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "A bundle of neurons with their connective tissue sheaths, blood vessels and lymphatics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd6a04e-3350-446b-a142-c4bc1f1b13f5",
                                                "sense_id": "b5d0d7cb-f711-30f5-a634-4cf440046b4e",
                                                "text": "The nerves can be seen through the skin."
                                            },
                                            {
                                                "example_id": "e825b918-c971-4efc-aba3-69cd92ced574",
                                                "sense_id": "b5d0d7cb-f711-30f5-a634-4cf440046b4e",
                                                "text": "Like her I go; I cannot stay;\n⁠I leave this mortal ark behind,\nA weight of nerves without a mind,\nAnd leave the cliffs, and haste away […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6cb265-2253-3ee1-a189-ed3da73aa90f",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "A neuron."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "353752c1-9fd1-3e3d-be42-1c99b6ccf943",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "A vein in a leaf; a grain in wood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2bd65cf-77db-4e70-9fdb-c7f510c362c9",
                                                "sense_id": "353752c1-9fd1-3e3d-be42-1c99b6ccf943",
                                                "text": "Some plants have ornamental value because of their contrasting nerves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "Courage; boldness; audacity; gall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b31cbf-722a-4e9b-b972-c44900d69b9c",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "Southgate's side kept their nerve and discipline in the unsettling, intimidating surroundings of Budapest, with the behaviour of Hungary's fans leaving much to be desired, to turn up the heat and punish their opponents ruthlessly once they had gone ahead."
                                            },
                                            {
                                                "example_id": "ff73d893-1f40-4290-ad0b-7b129b84c260",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "He had the nerve to enter my house uninvited."
                                            },
                                            {
                                                "example_id": "7b24ede5-f33a-44a9-bce7-a85905470923",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "He hasn't the nerve to tell her he likes her."
                                            },
                                            {
                                                "example_id": "d66cc66c-c699-44f0-879d-22bb7376d568",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "“Oh?” she said. “So you have decided to revise my guest list for me? You have the nerve, the – the –” I saw she needed helping out. “Audacity,” I said, throwing her the line. “The audacity to dictate to me who I shall have in my house.” It should have been “whom”, but I let it go. “You have the –” “Crust.” “– the immortal rind,” she amended, and I had to admit it was stronger, “to tell me whom” – she got it right that time – “I may entertain at Brinkley Court and who” – wrong again – “I may not.”"
                                            },
                                            {
                                                "example_id": "1e087271-0c41-4bf4-aec7-aafd9c70a157",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "You got a lot of nerve / To say you are my friend / When I was down / You just stood there grinning"
                                            },
                                            {
                                                "example_id": "207ecb30-097d-4b2a-bab3-ed47bc577eeb",
                                                "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                                                "text": "A trip to the whistling, fire-cracking Stadio San Paolo is always a test of nerve but Wenger's men have already outplayed the Italians once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf216cc-445b-39f6-bbcc-71b6f1fb275a",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "Patience; stamina; endurance, fortitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7326f396-35d9-46fb-8ea7-e4beee96f8b8",
                                                "sense_id": "bdf216cc-445b-39f6-bbcc-71b6f1fb275a",
                                                "text": "The web-team found git-sed is really a time and nerve saver when doing mass changes on your repositories"
                                            },
                                            {
                                                "example_id": "a6d5fe6a-2179-420f-b669-32e4155494f7",
                                                "sense_id": "bdf216cc-445b-39f6-bbcc-71b6f1fb275a",
                                                "text": "He led me on to mightiest deeds, / Above the nerve of mortal arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed80430-c80c-3c6d-8b95-963a24a314e5",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "One's neural structures considered collectively as, and conceptually equated with, one's psyche."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf474d7a-88db-4186-94a4-1f9ecbbb398d",
                                                "sense_id": "1ed80430-c80c-3c6d-8b95-963a24a314e5",
                                                "text": "All these rationalizations for asinine behavior are getting on my nerves."
                                            },
                                            {
                                                "example_id": "7a6c10bf-bff0-4988-8fea-0d607504e265",
                                                "sense_id": "1ed80430-c80c-3c6d-8b95-963a24a314e5",
                                                "text": "His nerves could no longer handle the worry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73f7e78-4677-3525-8496-b9e8f450c674",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "Mental agitation caused by fear, stress or other negative emotions."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f237d6-7d15-472c-9bc1-69f3f3f953c4",
                                                "sense_id": "a73f7e78-4677-3525-8496-b9e8f450c674",
                                                "text": "Ellie had a bad case of nerves before the big test; she was a bundle of nerves."
                                            },
                                            {
                                                "example_id": "65cd97d4-e1c7-4acb-a18d-1865b895d24c",
                                                "sense_id": "a73f7e78-4677-3525-8496-b9e8f450c674",
                                                "text": "Put me in the hospital for nerves and then they had to commit me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8425f9a3-6f0f-3e55-8fe5-f22f73bbd268",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "The elastic resistance of raw rubber or other polymers to permanent deformation during processing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c155f2-41a7-4458-8b80-156911a5ff39",
                                                "sense_id": "8425f9a3-6f0f-3e55-8fe5-f22f73bbd268",
                                                "text": "The nerviness (ability to recover quickly from strain or stretching) ... generally requires it to be broken down or masticated on the mill before the other compounding ingredients are added. In the break-down operation, heat is inherently generated by the sheer action of the milling or mixing equipment on the polymer. Therefore, it is difficult to maintain the desired low temperatures during the milling or mixing... An object of this invention is to reduce the inherent nerve of ... polymers ... during break-down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a082dd55-b1f0-3423-bf0a-cf57175406a5",
                                        "entry_id": "ff8bbf5c-69ed-304c-8027-5b9b7270df3b",
                                        "glosses": [
                                            "Sinew, tendon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec3153d9-5dc3-4095-b66e-c4c4edf6dab4",
                                                "sense_id": "a082dd55-b1f0-3423-bf0a-cf57175406a5",
                                                "text": "Come on; obey: / Thy nerves are in their infancy again, / And have no vigour in them."
                                            },
                                            {
                                                "example_id": "f32b2d5b-deea-48c1-bc1f-27360e918a90",
                                                "sense_id": "a082dd55-b1f0-3423-bf0a-cf57175406a5",
                                                "text": "Whilst thus their fury rages at the bay,\n My sword our cables cut, I call'd to weigh,\nAnd charg'd my men, as they from fate would fly,\nEach nerve to strain, each bending oar to ply."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nerve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba166f43-b27a-3f87-9a34-a7088467fedc",
                                        "entry_id": "c0d2503f-29b9-34ed-8a80-40d611b916cf",
                                        "glosses": [
                                            "To give courage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679c2245-3c43-444b-b32d-3a15451674f0",
                                                "sense_id": "ba166f43-b27a-3f87-9a34-a7088467fedc",
                                                "text": "May their example nerve us to face the enemy."
                                            },
                                            {
                                                "example_id": "ed42d135-0194-4431-9a3a-394e7b5791ac",
                                                "sense_id": "ba166f43-b27a-3f87-9a34-a7088467fedc",
                                                "text": "The yellow-bearded Mailey, the old warrior, scarred with many combats and eager for more, stood beside his wife, the gentle squire who bore his weapons and nerved his arm."
                                            },
                                            {
                                                "example_id": "8bea08c3-28b8-47b5-8983-b33fa99a765c",
                                                "sense_id": "ba166f43-b27a-3f87-9a34-a7088467fedc",
                                                "text": "And how I strained my ears, and nerved my hands and limbs, beginning to twitch with convulsive movements, which I feared might betray me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675b8d03-a6e9-3a5d-a24e-a3a4d3d8e409",
                                        "entry_id": "c0d2503f-29b9-34ed-8a80-40d611b916cf",
                                        "glosses": [
                                            "To give strength; to supply energy or vigour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d38605-44cd-4896-9ba0-ea87338c33fd",
                                                "sense_id": "675b8d03-a6e9-3a5d-a24e-a3a4d3d8e409",
                                                "text": "The liquor nerved up several of the men after their icy march."
                                            },
                                            {
                                                "example_id": "9f8a8d2d-3a46-4cdc-9442-3f8b4081eb18",
                                                "sense_id": "675b8d03-a6e9-3a5d-a24e-a3a4d3d8e409",
                                                "text": "The shock nerved her, and she ran aimlessly till she fell, and for a time lay, but making a barrier of her arms, that the child should not be crushed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030c2876-2745-337b-a2cd-0dc210d797a6",
                                        "entry_id": "c0d2503f-29b9-34ed-8a80-40d611b916cf",
                                        "glosses": [
                                            "To perform a neurectomy on (someone or something)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01798b8-b41c-414c-9000-a6114ee40384",
                                                "sense_id": "030c2876-2745-337b-a2cd-0dc210d797a6",
                                                "text": "She has been trying everything (wedge pads, bar shoes, etc.) and he is still dead lame. Someone has suggested nerving him, which (I believe - correct me if I am wrong!) involves cutting the main nerve in his foot so he can be ridden without pain."
                                            },
                                            {
                                                "example_id": "21649d89-c531-42bd-8109-6dd2ddb6fb27",
                                                "sense_id": "030c2876-2745-337b-a2cd-0dc210d797a6",
                                                "text": "You can't nerve a hoof and I didn't realize that the cannon bone where the nerving takes place is not part of the leg."
                                            },
                                            {
                                                "example_id": "9995718c-695f-4425-b44c-a89171a0b5be",
                                                "sense_id": "030c2876-2745-337b-a2cd-0dc210d797a6",
                                                "text": "Her instructor was trying to convince me that her horse's tail \"needed\" to be nerved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63441c19-f169-33a4-85bb-a84e22b0158e",
                                        "entry_id": "c0d2503f-29b9-34ed-8a80-40d611b916cf",
                                        "glosses": [
                                            "To get on (someone’s) nerves; to annoy, irritate, or bother (someone)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b74030b-a7b6-4d62-938f-59a56a77bb2f",
                                                "sense_id": "63441c19-f169-33a4-85bb-a84e22b0158e",
                                                "text": "I guess, my previous message never came in the net..so again: (hope, i don't nerve anyone) We want to combine different LAN's via fiberoptic cable (Monomode) to the Internet."
                                            },
                                            {
                                                "example_id": "03873e75-21c6-45e6-9236-0e2d89fc2873",
                                                "sense_id": "63441c19-f169-33a4-85bb-a84e22b0158e",
                                                "text": "No way was I assured, but after that the doctor refused to answer anymore questions. Instead, he wouldn’t stop nerving me to give him a guided tour of the berserker."
                                            },
                                            {
                                                "example_id": "e42c2a52-76a4-416b-9171-9ea8ad05e4e0",
                                                "sense_id": "63441c19-f169-33a4-85bb-a84e22b0158e",
                                                "text": "Do not nerve others: Of course it helps to talk to others. But just when you've got a lot of information, that can be annoying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d883fe2b-d37b-32ac-8961-1e3141276bd0",
                                        "entry_id": "c0d2503f-29b9-34ed-8a80-40d611b916cf",
                                        "glosses": [
                                            "To be nervous."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc82da3-33ba-44ea-81c3-b931a97db572",
                                                "sense_id": "d883fe2b-d37b-32ac-8961-1e3141276bd0",
                                                "text": "Mathias slowly leads his hand down to the holster... yeah, cool steel... his fingers wrap around the grip of his Smith & Wesson's, dragging it out, aiming and... In other words: Stop nerving, damiac14!"
                                            },
                                            {
                                                "example_id": "7d1886b7-cdf4-4e68-863f-6409006ce551",
                                                "sense_id": "d883fe2b-d37b-32ac-8961-1e3141276bd0",
                                                "text": "use the extrapolar solution, don't nerve."
                                            },
                                            {
                                                "example_id": "a82d55a7-cbbd-4d8b-84a3-3b31ea61b866",
                                                "sense_id": "d883fe2b-d37b-32ac-8961-1e3141276bd0",
                                                "text": "Speaking of Camden, I pulled off I-676 once to clean my windshield on the side of some surface street before turning around to shoot the Ben Franklin Bridge Westbound and I must say I was a bit nervous knowing the reputation, and I don't \"nerve\" easily."
                                            },
                                            {
                                                "example_id": "36c90556-aa81-4262-8e6e-5ac400eea3f2",
                                                "sense_id": "d883fe2b-d37b-32ac-8961-1e3141276bd0",
                                                "text": "Broadband Quality :) Stop nerving!!!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "904cf9d5-b2d0-4e9b-a67b-5b8f24177704",
