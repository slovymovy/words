                "senses": [
                    {
                        "sense_id": "efb2f800-fa01-301e-8f87-3a56b359fbe3",
                        "entry_id": "5b834033-56d8-3ff8-824e-3ace5bf16b3a",
                        "glosses": [
                            "The quality of being physically caustic; burning, corrosive."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "57ac79b0-bd9a-493d-84f1-0d60487973ae",
                                "sense_id": "efb2f800-fa01-301e-8f87-3a56b359fbe3",
                                "text": "Causticity is that sharp and corroding quality, which many substances possess, such as the mineral acids, especially when concentrated, alkalies fixed and volatile, quicklime, arsenic, corrosive sublimate, lunar crystals, butter of antimony, and even most other salts with metallic bases."
                            },
                            {
                                "example_id": "0b5a4597-dd0d-4922-98d7-b7d3636dff0a",
                                "sense_id": "efb2f800-fa01-301e-8f87-3a56b359fbe3",
                                "text": "Some years ago, we read in a U.S. trade paper a method for determining causticity of bottle-washing solution when foil labels are contained on the bottles undergoing cleansing treatment."
                            },
                            {
                                "example_id": "28598884-ee45-408d-a8f3-5a41289699bc",
                                "sense_id": "efb2f800-fa01-301e-8f87-3a56b359fbe3",
                                "text": "1996, Christopher J. Biermann, Handbook of Pulping and Papermaking, Academic Press, 3.8 Kraft Pulping, p. 89, https://books.google.ca/books?id=sfZfyEmqs_AC&printsec=frontcover#v=onepage&q&f=false\nCausticity is the ratio of NaOH to active alkali (as always both chemicals are on an Na₂O basis), expressed as a percentage."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc45a78c-213d-3976-9500-5bdd49400e09",
                        "entry_id": "5b834033-56d8-3ff8-824e-3ace5bf16b3a",
                        "glosses": [
                            "Being caustic in speech, humour etc."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0454fab8-279e-4f3c-8973-866dee9eeb6e",
                                "sense_id": "bc45a78c-213d-3976-9500-5bdd49400e09",
                                "text": "[…] one in whom a discreet causticity went along with a manner less genial than polite […]"
                            },
                            {
                                "example_id": "f6725bca-018e-4274-ac1d-2d076eb1e70c",
                                "sense_id": "bc45a78c-213d-3976-9500-5bdd49400e09",
                                "text": "He had not, he remarked with crushing causticity to one of his ministers, liberated France ‘to worry about the macaroni ration’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1e6f3d4-1900-424f-85f1-b38fadd4378f",
                        "source_entry_id": "5b834033-56d8-3ff8-824e-3ace5bf16b3a",
                        "source_sense_description": "the quality of being caustic",
                        "target_lang_word": "causticité",
