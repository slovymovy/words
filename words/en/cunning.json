{
    "word_family": [
        "cunningly",
        "cunningness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91af8e9b-8361-3017-9d2d-c360e01badc8",
                    "sense_definition": "Sly, crafty, or clever in a way that involves deception or surreptitious behavior.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "deceptive_cleverness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cunning</w> fox managed to steal the bait without triggering the trap.",
                            "target_lang_translations": {
                                "ru": "<w>Хитрому</w> лису удалось украсть приманку, не приведя в действие ловушку."
                            }
                        },
                        {
                            "text": "He used a <w>cunning</w> plan to bypass the security system and enter the building.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>хитроумный</w> план, чтобы обойти систему безопасности и войти в здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "artful",
                        "crafty",
                        "guileful",
                        "shrewd",
                        "sly",
                        "tricky",
                        "wily"
                    ],
                    "common_phrases": [
                        "cunning plan",
                        "cunning smile",
                        "cunning fox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрый, ловкий или умный в способе, предполагающем обман или скрытное поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "склонный к обману или уловкам"
                            },
                            {
                                "target_lang_word": "лукавый",
                                "target_lang_sense_clarification": "хитрый, игриво-обманчивый"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "злонамеренно хитрый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fe5f02e-a5fe-34a2-abf8-3f4ebb5630f9",
                    "sense_definition": "Attractive or appealing in a delicate or endearing way; cute.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attractiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop was filled with <w>cunning</w> little trinkets that tourists loved to buy.",
                            "target_lang_translations": {
                                "ru": "Магазин был полон <w>прелестных</w> маленьких безделушек, которые так любили покупать туристы."
                            }
                        },
                        {
                            "text": "She wore a <w>cunning</w> little hat that matched her vintage dress perfectly.",
                            "target_lang_translations": {
                                "ru": "На ней была <w>миленькая</w> маленькая шляпка, которая идеально подходила к её винтажному платью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cunning little",
                        "cunning room"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательный или милый в изящном или трогательном смысле; симпатичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прелестный",
                                "target_lang_sense_clarification": "очаровательный и милый"
                            },
                            {
                                "target_lang_word": "миленький",
                                "target_lang_sense_clarification": "симпатичный, вызывающий симпатию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a3e64f-b0fc-304e-8ea3-939d11c34b76",
                    "sense_definition": "Showing great skill, ingenuity, or technical proficiency in workmanship.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skillfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan used <w>cunning</w> hands to carve the intricate patterns into the wood.",
                            "target_lang_translations": {
                                "ru": "Ремесленник использовал свои <w>искусные</w> руки, чтобы вырезать на дереве сложные узоры."
                            }
                        },
                        {
                            "text": "A <w>cunning</w> workman can create beautiful furniture even with simple tools.",
                            "target_lang_translations": {
                                "ru": "<w>Умелый</w> мастер может создать красивую мебель даже с помощью простых инструментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "astute",
                        "subtle"
                    ],
                    "common_phrases": [
                        "cunning hand",
                        "cunning workman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older usage referring to skill"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий большое мастерство, изобретательность или техническую квалификацию в работе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "обладающий высоким мастерством"
                            },
                            {
                                "target_lang_word": "умелый",
                                "target_lang_sense_clarification": "хорошо владеющий своим делом"
                            },
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "обладающий физическим или техническим мастерством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a519622-2b38-309b-bcb9-ea69867ee5e2",
                    "sense_definition": "Wrought with or exhibiting great skill or ingenuity; ingenious.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skillfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed <w>cunning</w> work from the medieval period.",
                            "target_lang_translations": {
                                "ru": "В музее были выставлены <w>искусные</w> работы средневекового периода."
                            }
                        },
                        {
                            "text": "The spider spun a <w>cunning</w> web that was almost invisible to its prey.",
                            "target_lang_translations": {
                                "ru": "Паук сплел <w>хитроумную</w> паутину, которая была почти невидима для его добычи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cunning work"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный с большим мастерством или изобретательностью; хитроумный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитроумный",
                                "target_lang_sense_clarification": "сложно и искусно сделанный"
                            },
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "мастерски выполненный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26348d26-8188-3a74-9dbe-94a83fab217a",
                    "sense_definition": "The quality or skill of being clever at planning something so as to get what you want, especially by tricking other people.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "deceptive_skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed great <w>cunning</w> in getting the promotion ahead of his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он проявил большую <w>хитрость</w>, получив повышение раньше своих коллег."
                            }
                        },
                        {
                            "text": "The detective admired the <w>cunning</w> of the thief who left no fingerprints.",
                            "target_lang_translations": {
                                "ru": "Детектив восхищался <w>хитростью</w> вора, который не оставил отпечатков пальцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "craftiness",
                        "guile",
                        "foxiness",
                        "wile"
                    ],
                    "antonyms": [
                        "artlessness",
                        "candor",
                        "honesty",
                        "innocence",
                        "naïveté"
                    ],
                    "common_phrases": [
                        "utmost cunning",
                        "show cunning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или навык умения планировать что-либо для достижения цели, особенно путем обмана других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "способность действовать обманным путем"
                            },
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "скрытая злонамеренная хитрость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77eb93c3-fa61-35dd-b8c9-fcddcb11e3a6",
                    "sense_definition": "Practical knowledge, aptitude, or skill in performance; proficiency.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skillfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played with such <w>cunning</w> that the audience was completely mesmerized.",
                            "target_lang_translations": {
                                "ru": "Пианист играл с таким <w>искусством</w>, что публика была полностью заворожена."
                            }
                        },
                        {
                            "text": "Her <w>cunning</w> in needlework was well known throughout the village.",
                            "target_lang_translations": {
                                "ru": "Её <w>умение</w> в рукоделии было хорошо известно всей деревне."
                            }
                        }
                    ],
                    "synonyms": [
                        "art",
                        "craft"
                    ],
                    "antonyms": [
                        "simplicity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older sense of general skill"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практические знания, способности или мастерство в исполнении; профессионализм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусство",
                                "target_lang_sense_clarification": "высокое мастерство в каком-либо деле"
                            },
                            {
                                "target_lang_word": "умение",
                                "target_lang_sense_clarification": "навык или способность что-то делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28cf169c-d89b-33d2-b03e-c473e3e3fe97",
                    "sense_definition": "The natural wit or survival instincts of an animal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "instinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cunning</w> of the fox allows it to survive in harsh winter conditions.",
                            "target_lang_translations": {
                                "ru": "<w>Хитрость</w> лисы позволяет ей выживать в суровых зимних условиях."
                            }
                        },
                        {
                            "text": "Hunters often underestimate the <w>cunning</w> of the deer they are tracking.",
                            "target_lang_translations": {
                                "ru": "Охотники часто недооценивают <w>сметливость</w> оленя, которого они выслеживают."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cunning of the fox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природная сообразительность или инстинкты выживания животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "природная смекалка животного"
                            },
                            {
                                "target_lang_word": "сметливость",
                                "target_lang_sense_clarification": "способность быстро соображать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "592e59cd-9fc4-3ac3-af5d-3699b190e330",
                    "sense_definition": "Skillful deceit or the use of craftiness in a secret or magical manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deceptive_skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sorcerer used his <w>cunning</w> to trick the king into giving up his crown.",
                            "target_lang_translations": {
                                "ru": "Колдун использовал свое <w>коварство</w>, чтобы обманом заставить короля отдать корону."
                            }
                        },
                        {
                            "text": "Through dark <w>cunning</w> and ancient spells, the witch hid the castle from view.",
                            "target_lang_translations": {
                                "ru": "С помощью темного <w>коварства</w> и древних заклинаний ведьма скрыла замок от посторонних глаз."
                            }
                        }
                    ],
                    "synonyms": [
                        "beguilement",
                        "subtlety"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in fantasy or historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умелый обман или использование хитрости тайным или магическим образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "использование хитрости в злых целях"
                            },
                            {
                                "target_lang_word": "лукавство",
                                "target_lang_sense_clarification": "хитрость с оттенком обмана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ef47618-b13e-34b5-889a-ca50250a697d",
                    "sense_definition": "Specialized knowledge or learning, sometimes implying occult or magical understanding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old scrolls contained <w>cunning</w> that had been lost for centuries.",
                            "target_lang_translations": {
                                "ru": "Старые свитки содержали <w>познания</w>, которые были утеряны на протяжении веков."
                            }
                        },
                        {
                            "text": "He sought the <w>cunning</w> of the elders to solve the mystery of the ruins.",
                            "target_lang_translations": {
                                "ru": "Он искал <w>мудрости</w> старейшин, чтобы разгадать тайну руин."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированные знания или учения, иногда подразумевающие оккультное или магическое понимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "познания",
                                "target_lang_sense_clarification": "глубокие или тайные знания"
                            },
                            {
                                "target_lang_word": "мудрость",
                                "target_lang_sense_clarification": "глубокое понимание вещей"
                            }
                        ]
                    }
                }
            ]
        },
        {
