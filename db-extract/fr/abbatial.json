                ],
                "senses": [
                    {
                        "sense_id": "01cf4ee7-7658-3ff4-975d-497ab37d68e0",
                        "entry_id": "f920043c-8caa-383c-b3f4-552e0379df34",
                        "glosses": [
                            "Qui a rapport à l’abbaye, à l’abbé ou à l’abbesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb1db22-07f2-4a2c-8d6a-f31d929eb404",
                                "sense_id": "01cf4ee7-7658-3ff4-975d-497ab37d68e0",
                                "text": "Outre le gros anneau abbatial d’or qui indiquait sa dignité cléricale, ses doigts, contrairement aux canons de l’Église, étaient chargés de joyaux précieux."
                            },
                            {
                                "example_id": "97d7f3ec-1820-4dfe-8975-a477292010e2",
                                "sense_id": "01cf4ee7-7658-3ff4-975d-497ab37d68e0",
                                "text": "Une statue d’abbé est appuyée contre le mur : un gros anneau au médius de la main droite, un menton long, des pommettes saillantes, …, et un écusson qui est d’hermine à trois fasces au chef chargé d’un lambel à trois pièces timbré de la croix abbatiale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "895961d0-4c49-42f9-98bd-1c03b1203624",
                        "source_entry_id": "f920043c-8caa-383c-b3f4-552e0379df34",
                        "source_sense_id": "01cf4ee7-7658-3ff4-975d-497ab37d68e0",
                        "target_lang_word": "abbatial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abbatial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7041eba-7000-3bda-afa0-80ccd4f3cbfc",
                                        "entry_id": "c04be40f-bdd8-38f2-8ffa-f2c3dd65ee50",
                                        "glosses": [
                                            "Belonging to, relating to, or pertaining to an abbey, abbot, or abbess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a62e92-04b0-4099-b547-315ae76294b1",
                                                "sense_id": "e7041eba-7000-3bda-afa0-80ccd4f3cbfc",
                                                "text": "a possible abbatial vacancy"
                                            },
                                            {
                                                "example_id": "3a16e997-9a63-438c-9f60-eb173a398ba9",
                                                "sense_id": "e7041eba-7000-3bda-afa0-80ccd4f3cbfc",
                                                "text": "Thus the abbatial succession came to be confined to members of the clan of the founder; and although originally the abbots were elected from the \"founder's kin,\" and were distinct from those of the clan who possessed the abbatial lands, yet in process of time ecclesiastical line was merged in the secular, and both were united in one lay official, like the successors of St. Patrick at Armagh, who were the objects of St. Bernard's denunciations"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
