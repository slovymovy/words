                                                "sense_id": "1efa08f4-c3ab-3fca-aa0b-b9f6ea87d7ee",
                                                "text": "John’s bet was a bluff: he bet without even so much as a pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975b9b69-72a8-3543-a02a-8599f0d76bd3",
