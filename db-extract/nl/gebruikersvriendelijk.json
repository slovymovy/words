                                        "entry_id": "3580ac9e-2302-3e4c-b24f-023bf800c1d1",
                                        "glosses": [
                                            "Designed to be easy for an untrained user to use, with intuitive ordering of steps, consistent and logical placement of controls, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5494c5a-196c-4d45-8541-74d6c371eb0a",
                                                "sense_id": "eda841bd-2f46-3754-bec7-64f090da72e6",
                                                "text": "In the past few years, product engineers have infused the basic telephone with lots of high-tech, razzle-dazzle, and user friendly innovations such as speed dialing, automatic redial, speakerphones, cordless phones, hold buttons, and dialing memories."
                                            }
                                        ]
