                "senses": [
                    {
                        "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                        "entry_id": "f7d3c076-d7e5-3d33-8976-64e566f0dc00",
                        "glosses": [
                            "Personne qui se déplace en glissant sur la glace à l’aide de patins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "647c725f-f65a-4f11-b838-0755d4a441b4",
                                "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                                "text": "Il y avait beaucoup de patineurs sur la rivière, sur le canal."
                            },
                            {
                                "example_id": "178223bb-44bc-4c6a-9878-5a84fb64715f",
                                "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                                "text": "Le patineur le plus fort est aussi le patineur le plus intelligent sur la piste, celui qui accepte de laisser ses adversaires le dépasser en sachant qu’il pourra reprendre la tête au bon moment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4729c8f4-3aec-41d0-9919-0dfadf701200",
                        "source_entry_id": "f7d3c076-d7e5-3d33-8976-64e566f0dc00",
                        "source_sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
