                        "environnement familial"
                    ]
                },
                {
                    "sense_id": "b164c1aa-4b35-3feb-824c-932bf4ad4da5",
                    "sense_definition": "Ensemble des matériels, systèmes d'exploitation et logiciels nécessaires au fonctionnement d'un programme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette application a été développée pour fonctionner dans un <w>environnement</w> Linux."
                        },
                        {
                            "text": "Les programmeurs testent le nouveau code dans un <w>environnement</w> de développement sécurisé."
