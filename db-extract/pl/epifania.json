                "forms": [],
                "senses": [
                    {
                        "sense_id": "9878d883-f706-3f3a-a4b3-362bfa45aef8",
                        "entry_id": "bad2663f-96b7-307f-8018-2740440bdd76",
                        "glosses": [
                            "święto chrześcijańskie obchodzone 6. stycznia, upamiętniające objawienie się Jezusa Chrystusa światu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eec35a22-3b55-4a27-a0cb-d30298d5c67e",
                        "source_entry_id": "bad2663f-96b7-307f-8018-2740440bdd76",
                        "source_sense_id": "9878d883-f706-3f3a-a4b3-362bfa45aef8",
                        "target_lang_word": "Epiphany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epiphany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e5615af-278a-378a-8a0d-537953212fb5",
                                        "entry_id": "e2ef92f2-742f-3544-ac41-14d5fa32807d",
                                        "glosses": [
                                            "A manifestation of the divinity of Jesus Christ, especially to the Magi (Matthew 2:1–12), but also at his baptism and the Wedding at Cana."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "093f5261-6983-4585-b67a-d7af4da23c9f",
                                                "sense_id": "6e5615af-278a-378a-8a0d-537953212fb5",
                                                "text": "That was also the reason why the Feast of the Epiphany, commemorating the three epiphanies of Christ's divinity, His Baptism, the Miracle of Cana, and the Visit of the Magi, was one of the most favorite feasts in the Eastern Church[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f8e052-de99-359b-804f-fee8ee866b4e",
                                        "entry_id": "e2ef92f2-742f-3544-ac41-14d5fa32807d",
                                        "glosses": [
                                            "An annual Christian feast celebrating these events, usually on January 6, the twelfth day after Christmas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711835e6-8bcb-4edc-a7ee-446fdfe2b520",
                                                "sense_id": "c6f8e052-de99-359b-804f-fee8ee866b4e",
                                                "text": "On the Festival of the Epiphany, and on the six Sundays called after its name, we have distinct pictures held up to our view connected with the life of Jesus of Nazareth[…]"
                                            },
                                            {
                                                "example_id": "e4a3616f-dee5-4fae-b23c-22b405ea6cd9",
                                                "sense_id": "c6f8e052-de99-359b-804f-fee8ee866b4e",
                                                "text": "That was also the reason why the Feast of the Epiphany, commemorating the three epiphanies of Christ's divinity, His Baptism, the Miracle of Cana, and the Visit of the Magi, was one of the most favorite feasts in the Eastern Church[…]"
                                            },
                                            {
                                                "example_id": "b75d30de-885d-411c-a3ce-4ea7a27ccddb",
                                                "sense_id": "c6f8e052-de99-359b-804f-fee8ee866b4e",
                                                "text": "The Epiphany, also known as the Feast of the Three Kings, Feast of Lights and Little Christmas, is known to have been observed earlier than 194 A.D.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b2ad71-efb7-39be-8419-40231fad9bf3",
                                        "entry_id": "e2ef92f2-742f-3544-ac41-14d5fa32807d",
                                        "glosses": [
                                            "The day of the celebration, January 6, or sometimes (in Western Christianity), the Sunday between January 2 and 8."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc9f9813-6893-340e-83de-1b1357e8ba94",
                                        "entry_id": "e2ef92f2-742f-3544-ac41-14d5fa32807d",
                                        "glosses": [
                                            "The season or time of the Christian church year, either from the Epiphany feast day to Shrove Tuesday (the day before Ash Wednesday, the start of Lent), or from the Epiphany feast day to the feast of Candlemas (marking the presentation of Jesus Christ in the Temple in Jerusalem)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b59108f9-fb17-3cb0-bdcb-b545825a0d72",
                                        "entry_id": "e2ef92f2-742f-3544-ac41-14d5fa32807d",
                                        "glosses": [
                                            "an experience of sudden and striking insight"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
