{
    "word_family": [
        "bruis",
        "bruisend",
        "bruistablet",
        "uitbruisen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b32d9d76-deb6-37c2-bf5e-4d9506950666",
                    "sense_definition": "Het overvloedig vormen van gasbelletjes in een vloeistof.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_bruisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De frisdrank <w>bruiste</w> hevig toen hij er een snoepje in gooide.",
                            "target_lang_translations": {
                                "en": "The soda <w>fizzed</w> violently when he threw a candy into it."
                            }
                        },
                        {
                            "text": "Als je een tablet in het water gooit, begint het direct te <w>bruisen</w>.",
                            "target_lang_translations": {
                                "en": "If you throw a tablet into the water, it immediately starts to <w>fizz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mousseren"
                    ],
                    "common_phrases": [
                        "hevig bruisen",
                        "bruisen van koolzuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The abundant formation of gas bubbles in a liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fizz",
                                "target_lang_sense_clarification": "to emit bubbles and make a hissing sound"
                            },
                            {
                                "target_lang_word": "effervesce",
                                "target_lang_sense_clarification": "to bubble, hiss, and foam as gas escapes"
                            },
                            {
                                "target_lang_word": "bubble",
                                "target_lang_sense_clarification": "to form or rise in bubbles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf67804-9fe1-33a5-8a35-ed25e3972f16",
                    "sense_definition": "Vol energie, activiteit en leven zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_bruisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stad <w>bruist</w> van de energie tijdens het jaarlijkse zomerfestival.",
                            "target_lang_translations": {
                                "en": "The city <w>buzzes</w> with energy during the annual summer festival."
                            }
                        },
                        {
                            "text": "Zij <w>bruist</w> altijd van de nieuwe ideeën voor haar bedrijf.",
                            "target_lang_translations": {
                                "en": "She is always <w>bubbling over</w> with new ideas for her company."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bruisen van energie",
                        "bruisen van leven"
                    ],
                    "target_lang_definitions": {
                        "en": "To be full of energy, activity, and life."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buzz",
                                "target_lang_sense_clarification": "to be full of excitement, activity, or energy"
                            },
                            {
                                "target_lang_word": "bubble over",
                                "target_lang_sense_clarification": "to be overflowing with an emotion or quality"
                            },
                            {
                                "target_lang_word": "bristle",
                                "target_lang_sense_clarification": "to be thick with or full of something active"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}