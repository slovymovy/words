                    {
                        "translation_id": "5c48257e-0008-4b06-8f37-1aa026c65041",
                        "source_entry_id": "981d1b30-18fd-3c01-9e06-1dc854fdf6f9",
                        "source_sense_description": "an ancient Greek mathematician",
                        "target_lang_word": "Archimède",
