                "translations": [
                    {
                        "translation_id": "4af4cde4-f2c3-458b-b878-9756356d51e6",
                        "source_entry_id": "985e6447-59f4-357b-ab97-9f6f8d11018b",
                        "source_sense_id": "4616bce3-a79c-3fa0-a4fa-45b5b9016684",
                        "source_sense_description": "klein voorwerp van hoge waarde",
                        "target_lang_word": "Kleinod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                        "entry_id": "43f9b6a4-a886-385f-a089-3b03d46b53eb",
                                        "glosses": [
                                            "Schmuckstück; etwas, das (im positiven Sinne) als besonders, kostbar, erstklassig gilt"
                                        ],
                                        "tags": [
                                            "meist im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e29575-d221-4012-b780-6ce8316dcca0",
                                                "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                                "text": "Die Schlumpfhäuser Kirche ist ein Kleinod des Schlumpftales."
                                            },
                                            {
                                                "example_id": "bd765935-692e-4e44-bcbe-3daa5d688611",
                                                "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                                "text": "„Ein Kleinod meiner Sammlung ist eine von Seepocken bewachsene Getränkedose mit mongolischen Schriftzeichen.“"
                                            },
                                            {
                                                "example_id": "0f3307bf-6ebe-4fda-8f71-16ad40c10d4a",
                                                "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                                "text": "„Im Beginenhof, diesem Kleinod des Weltkulturerbes, lebten früher unverheiratete Frauen zusammen, die Wert auf ein selbstbestimmten Leben in der Stadt legten.“"
                                            },
                                            {
                                                "example_id": "b60d61da-8d28-40d2-ba34-d7cf4fbcfecc",
                                                "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                                "text": "„Nachdem er unter anderem Hanauer Kleinodien, Skulpturen und Kunstwerke in einem Band mit Text und Foto versammelt hat, geht es dieses Mal um Orte in Hanau, die mit Licht und Dunkelheit, mit Tod und Grausamkeiten der Vergangenheit oder morbider Schönheit zu tun haben.“"
                                            },
                                            {
                                                "example_id": "7876bfd8-787f-4807-84e1-84d1a62ae62b",
                                                "sense_id": "89a1cb28-8e9a-3650-9191-85e53dffcd97",
                                                "text": "„Er brachte mich selbst zu diesem Prälaten wie ein hochgeschätztes Kleinod, das nur er allein ihm vorführen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aa64b52-02cc-417d-9f0a-af3368f90032",
