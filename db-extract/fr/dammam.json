                "entry_id": "6d25464d-711a-388f-aa2f-bb310152bb87",
                "word": "Dammam",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6de4dbd0-76d3-38cd-8739-e67767e24b64",
                        "entry_id": "6d25464d-711a-388f-aa2f-bb310152bb87",
                        "glosses": [
                            "Capitale de la province orientale d’Ach-Charqiya d’Arabie saoudite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aae7f33-6ba4-455f-9e80-4e1ae92f330f",
                                "sense_id": "6de4dbd0-76d3-38cd-8739-e67767e24b64",
                                "text": "De l’autre, Muhammad, à peu près le même âge, a pris l’avion en provenance de Dammam (Arabie saoudite), à 350 km au nord de Doha."
                            },
                            {
                                "example_id": "a30054af-d6a6-46bd-8568-607b848f9dc1",
                                "sense_id": "6de4dbd0-76d3-38cd-8739-e67767e24b64",
                                "text": "Nasser Al-Attiyah (à dr. sur la photo), le prince des dunes, a remporté, pour la cinquième fois, le Dakar, dimanche, à Dammam (Arabie saoudite)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
