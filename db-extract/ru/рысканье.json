                        "cross_references": [
                            {
                                "target_word": "hunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c37811-a3fb-3fc2-8c62-ae102704e72b",
                                        "entry_id": "64e62ac4-df2e-38e7-9246-bff0fb18c8db",
                                        "glosses": [
                                            "The act of finding and killing a wild animal, either for sport or with the intention of using its parts to make food, clothes, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2115be1c-a00c-45ee-9eb4-1382b9e58e5f",
                                                "sense_id": "19c37811-a3fb-3fc2-8c62-ae102704e72b",
                                                "text": "His pictures of huntings are particularly admired: the figures and animals of every species being designed with uncommon spirit, nature, and truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b648f72-a682-3655-b030-85c56e835370",
                                        "entry_id": "64e62ac4-df2e-38e7-9246-bff0fb18c8db",
                                        "glosses": [
                                            "The act of looking for something, especially for a job or flat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c92ab49-97a0-36d8-b949-26e0db64a9aa",
                                        "entry_id": "64e62ac4-df2e-38e7-9246-bff0fb18c8db",
                                        "glosses": [
                                            "Fluctuation or oscillation that does not stabilize."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2511af42-fe21-49f9-8938-ea72706cb2c1",
                                                "sense_id": "1c92ab49-97a0-36d8-b949-26e0db64a9aa",
                                                "text": "Bogie hunting is not caused by some sort of periodic disturbance but by dynamic instability; the oscillatory system is not the bogies alone but the complete assembly of bogie-plus-body; and variations in track rigidity do not affect the nature of the motion, only its intensity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a12843-8376-33d7-8dbf-4072d98e4e65",
                                        "entry_id": "64e62ac4-df2e-38e7-9246-bff0fb18c8db",
                                        "glosses": [
                                            "The process of determining which of a group of telephone lines will receive a call."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cb1319-e59f-34a1-8538-c288b2e96123",
                                        "entry_id": "b4dabe86-221c-3b4e-9347-7c207fddebbe",
                                        "glosses": [
                                            "present participle and gerund of hunt"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c709824-6a4b-4df6-89d1-98211266b8bb",
                                                "sense_id": "c5cb1319-e59f-34a1-8538-c288b2e96123",
                                                "text": "Even in an era when individuality in dress is a cult, his clothes were noticeable. He was wearing a hard hat of the low round kind favoured by hunting men, and with it a black duffle-coat lined with white."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
