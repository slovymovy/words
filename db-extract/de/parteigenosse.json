                    {
                        "form_id": "d3f22f5d-acef-4d08-8ed1-79d1a35f399b",
                        "entry_id": "b0977696-32c8-3812-9ba8-a8f4d6acac3c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Parteigenossen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cf33c05-7ff7-3259-a03f-8a04f913287f",
                        "entry_id": "b0977696-32c8-3812-9ba8-a8f4d6acac3c",
                        "glosses": [
                            "Mitglied der politischen Partei, der man selbst angehört"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bdaae024-82b4-4f30-84bf-d6846ff24df5",
                                "sense_id": "8cf33c05-7ff7-3259-a03f-8a04f913287f",
                                "text": "„Der Witz erhält seine Brisanz gar nicht so sehr aufgrund des Umstandes, dass der Parteigenosse schließlich doch die Gesellschaftsordnung der DDR verleugnet, denn auch ihm ist ja das Hemd näher als die Jacke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "45e55143-2cdb-3f1c-8876-2f230105101b",
                        "entry_id": "b0977696-32c8-3812-9ba8-a8f4d6acac3c",
                        "glosses": [
                            "Angehöriger der NSDAP (Nationalsozialistische Deutsche Arbeiterpartei)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "454bd113-97d0-4050-b944-5ad044cf0bae",
                                "sense_id": "45e55143-2cdb-3f1c-8876-2f230105101b",
                                "text": "„Denn er sah es bei jeder Gelegenheit, wie sie ständig einen Unterschied zwischen Volksgenossen und Parteigenossen machten.“"
                            },
                            {
                                "example_id": "0d4e634b-6caf-47d0-a5eb-cc8fbcbfbcf6",
                                "sense_id": "45e55143-2cdb-3f1c-8876-2f230105101b",
                                "text": "„Einmal an Weihnachten, ich war noch nicht drei Jahre alt, brachte mein Vater einen Parteigenossen mit nach Haus.“"
                            },
                            {
                                "example_id": "7a6428a7-5c54-41c1-b458-49e17492e0b2",
                                "sense_id": "45e55143-2cdb-3f1c-8876-2f230105101b",
                                "text": "„Er war ein fanatischer Parteigenosse, wie es weit und breit keinen zweiten gab, und offenbar hat er noch immer nicht aufgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3c4164f8-95d3-3dc1-abfd-42a75239e5f9",
                        "entry_id": "b0977696-32c8-3812-9ba8-a8f4d6acac3c",
                        "glosses": [
                            "Angehöriger einer Arbeiter- oder anderweitig links stehenden Partei"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e7878814-e24f-4224-b78e-2a03fd6b739e",
                                "sense_id": "3c4164f8-95d3-3dc1-abfd-42a75239e5f9",
                                "text": "„Lieber Parteigenosse Tietjen! Für ihre Zusage, die künstlerische Leitung über unser Ballett übernehmen zu wollen, danke ich Ihnen von ganzem Herzen.“"
                            },
                            {
                                "example_id": "c02da67c-9c12-453d-b60a-ac89f3cccefb",
                                "sense_id": "3c4164f8-95d3-3dc1-abfd-42a75239e5f9",
                                "text": "Er benutzte seither auch in einigen Fällen die Anrede „lieber Parteigenosse“ und ließ sich auch selbst so anreden."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a75c875-7e98-4fc1-b41a-8a9e5476eb65",
                        "source_entry_id": "b0977696-32c8-3812-9ba8-a8f4d6acac3c",
                        "source_sense_id": "45e55143-2cdb-3f1c-8876-2f230105101b",
                        "target_lang_word": "partisan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partisan",
