{
    "word_family": [
        "fairness",
        "fairly",
        "unfair",
        "unfairly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "279343d3-c1fc-31fd-91f0-2926fa879265",
                    "sense_definition": "Treating people equally without favouritism or discrimination; just and equitable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adj_justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not <w>fair</w> to blame him for the mistake when he was not there.",
                            "target_lang_translations": {
                                "ru": "Не <w>справедливо</w> винить его за ошибку, когда его там не было.",
                                "tr": "Orada değilken onu hatadan dolayı suçlamak <w>âdil</w> değil.",
                                "zh": "当他不在场时，因为那个错误而责怪他是不<w>公平</w>的。"
                            }
                        },
                        {
                            "text": "Everyone deserves a <w>fair</w> trial before being judged.",
                            "target_lang_translations": {
                                "ru": "Каждый заслуживает <w>справедливого</w> суда, прежде чем быть осужденным.",
                                "tr": "Herkes yargılanmadan önce <w>âdil</w> bir mahkeme sürecini hak eder.",
                                "zh": "每个人在被定罪前都应享有<w>公正</w>的审判。"
                            }
                        }
                    ],
                    "synonyms": [
                        "just",
                        "equitable",
                        "equal"
                    ],
                    "common_phrases": [
                        "fair play",
                        "fair trial",
                        "to be fair",
                        "fair enough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям одинаково, без фаворитизма или дискриминации; справедливый и беспристрастный.",
                        "tr": "İnsanlara ayrımcılık yapmadan, eşit ve hakkaniyetli davranan; adil.",
                        "zh": "对待他人一视同仁，不偏袒或歧视；公正且合乎情理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справедливый",
                                "target_lang_sense_clarification": "just, impartial"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "honest, fair play"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "âdil",
                                "target_lang_sense_clarification": "adaletli, hakkaniyetli"
                            },
                            {
                                "target_lang_word": "hakça",
                                "target_lang_sense_clarification": "adalete uygun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公平",
                                "target_lang_sense_clarification": "公正，不偏不倚"
                            },
                            {
                                "target_lang_word": "公正",
                                "target_lang_sense_clarification": "正义，合乎道理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5adc362d-7932-38cb-89dc-bf8901280c06",
                    "sense_definition": "Having light-colored skin or hair.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adj_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>fair</w> hair and blue eyes.",
                            "target_lang_translations": {
                                "ru": "У нее <w>светлые</w> волосы и голубые глаза.",
                                "tr": "<w>Açık</w> renkli saçları ve mavi gözleri var.",
                                "zh": "她有着<w>浅色</w>的头发和蓝色的眼睛。"
                            }
                        },
                        {
                            "text": "He burns easily in the sun because of his <w>fair</w> skin.",
                            "target_lang_translations": {
                                "ru": "Он легко обгорает на солнце из-за своей <w>светлой</w> кожи.",
                                "tr": "<w>Açık</w> tenli olduğu için güneşte kolayca yanıyor.",
                                "zh": "因为皮肤<w>白皙</w>，他在阳光下很容易晒伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pale",
                        "light"
                    ],
                    "antonyms": [
                        "swarthy"
                    ],
                    "common_phrases": [
                        "fair hair",
                        "fair skin",
                        "fair complexion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий светлую кожу или волосы.",
                        "tr": "Açık renkli tene veya saça sahip olan.",
                        "zh": "指皮肤或头发颜色较浅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлый",
                                "target_lang_sense_clarification": "light-colored (hair/skin)"
                            },
                            {
                                "target_lang_word": "белокурый",
                                "target_lang_sense_clarification": "blond (hair)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açık renkli",
                                "target_lang_sense_clarification": "ten veya saç rengi için"
                            },
                            {
                                "target_lang_word": "beyaz tenli",
                                "target_lang_sense_clarification": "açık tenli"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浅色",
                                "target_lang_sense_clarification": "指肤色或发色"
                            },
                            {
                                "target_lang_word": "白皙",
                                "target_lang_sense_clarification": "指皮肤颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bd35b63-6b84-3191-9365-8bae66a2cdf3",
                    "sense_definition": "Acceptable or average in quality or amount, but not excellent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was only <w>fair</w>, so I would not watch it again.",
                            "target_lang_translations": {
                                "ru": "Фильм был весьма <w>посредственным</w>, так что я бы не стал смотреть его снова.",
                                "tr": "Film sadece <w>orta</w> seviyedeydi, bu yüzden tekrar izlemem.",
                                "zh": "这部电影表现<w>尚可</w>，所以我不会再看一遍。"
                            }
                        },
                        {
                            "text": "There is a <w>fair</w> chance that it will rain later today.",
                            "target_lang_translations": {
                                "ru": "Есть <w>неплохой</w> шанс, что сегодня позже пойдет дождь.",
                                "tr": "Bugün ilerleyen saatlerde yağmur yağması için <w>oldukça</w> yüksek bir ihtimal var.",
                                "zh": "今天晚些时候有<w>相当</w>大的可能会下雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "OK",
                        "okay",
                        "average",
                        "mediocre"
                    ],
                    "common_phrases": [
                        "fair amount",
                        "fair share",
                        "fair condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приемлемый или средний по качеству или количеству, но не отличный.",
                        "tr": "Kalite veya miktar olarak kabul edilebilir veya ortalama, ancak mükemmel değil.",
                        "zh": "质量或数量尚可，处于平均水平，但并不出色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посредственный",
                                "target_lang_sense_clarification": "mediocre, average"
                            },
                            {
                                "target_lang_word": "сносный",
                                "target_lang_sense_clarification": "tolerable, okay"
                            },
                            {
                                "target_lang_word": "неплохой",
                                "target_lang_sense_clarification": "quite good (amount/chance)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "orta",
                                "target_lang_sense_clarification": "ortalama kalitede"
                            },
                            {
                                "target_lang_word": "fena değil",
                                "target_lang_sense_clarification": "kabul edilebilir"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尚可",
                                "target_lang_sense_clarification": "还可以，过得去"
                            },
                            {
                                "target_lang_word": "相当",
                                "target_lang_sense_clarification": "指数量或程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc334c7-637f-3ccc-b95e-2d3a4517d446",
                    "sense_definition": "Pleasant and not raining; clear and sunny (regarding weather).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hope for <w>fair</w> weather for the picnic this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на <w>ясную</w> погоду для пикника в эти выходные.",
                                "tr": "Bu hafta sonu piknik için <w>açık</w> bir hava umuyoruz.",
                                "zh": "我们希望这个周末野餐时天气<w>晴朗</w>。"
                            }
                        },
                        {
                            "text": "The ship sailed with a <w>fair</w> wind towards the island.",
                            "target_lang_translations": {
                                "ru": "Корабль плыл с <w>попутным</w> ветром к острову.",
                                "tr": "Gemi, adaya doğru <w>uygun</w> bir rüzgarla yelken açtı.",
                                "zh": "船只借着<w>顺风</w>向岛屿驶去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fair weather",
                        "fair wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятная, без дождя; ясная и солнечная (о погоде).",
                        "tr": "Hava durumu için; yağışsız, açık ve güneşli.",
                        "zh": "指天气晴朗、舒适，没有降雨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "clear (weather)"
                            },
                            {
                                "target_lang_word": "попутный",
                                "target_lang_sense_clarification": "favourable (wind)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "hava durumu için"
                            },
                            {
                                "target_lang_word": "güzel",
                                "target_lang_sense_clarification": "hava durumu için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晴朗",
                                "target_lang_sense_clarification": "天气好"
                            },
                            {
                                "target_lang_word": "顺风",
                                "target_lang_sense_clarification": "指风向有利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "173c0b0a-11da-31d5-a7fd-c036fa245f12",
                    "sense_definition": "Beautiful or pleasing to look at.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight fell in love with the <w>fair</w> maiden at first sight.",
                            "target_lang_translations": {
                                "ru": "Рыцарь влюбился в <w>прекрасную</w> деву с первого взгляда.",
                                "tr": "Şövalye, <w>güzel</w> kıza ilk görüşte aşık oldu.",
                                "zh": "骑士对那位<w>美丽</w>的少女一见钟情。"
                            }
                        },
                        {
                            "text": "Mirror, mirror on the wall, who is the <w>fairest</w> of them all?",
                            "target_lang_translations": {
                                "ru": "Свет мой, зеркальце, скажи, кто на свете всех <w>милее</w>?",
                                "tr": "Ayna ayna söyle bana, dünyadaki en <w>güzel</w> kim?",
                                "zh": "魔镜魔镜，谁是世界上最<w>美丽</w>的人？"
                            }
                        }
                    ],
                    "synonyms": [
                        "beautiful",
                        "pretty",
                        "lovely"
                    ],
                    "common_phrases": [
                        "fair maiden",
                        "fair lady"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красивый или приятный для глаз.",
                        "tr": "Güzel veya göze hoş gelen.",
                        "zh": "形容外貌美丽或令人赏心悦目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекрасный",
                                "target_lang_sense_clarification": "beautiful, lovely"
                            },
                            {
                                "target_lang_word": "красивый",
                                "target_lang_sense_clarification": "pretty"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güzel",
                                "target_lang_sense_clarification": "göze hoş gelen"
                            },
                            {
                                "target_lang_word": "güzel yüzlü",
                                "target_lang_sense_clarification": "edebi/eski kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美丽",
                                "target_lang_sense_clarification": "漂亮，好看"
                            },
                            {
                                "target_lang_word": "俊美",
                                "target_lang_sense_clarification": "容貌美好"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "550ab6c9-cf48-31e3-992c-5c04c7a7ce7e",
                    "sense_definition": "A gathering for public entertainment, often with games, rides, and competitions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "noun_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ate cotton candy and played games at the county <w>fair</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ели сахарную вату и играли в игры на окружной <w>ярмарке</w>.",
                                "tr": "Bölge <w>panayırında</w> pamuk şeker yedik ve oyunlar oynadık.",
                                "zh": "我们在县里的<w>游乐会</w>上吃了棉花糖并玩了游戏。"
                            }
                        },
                        {
                            "text": "The children rode the carousel at the summer <w>fair</w>.",
                            "target_lang_translations": {
                                "ru": "Дети катались на карусели на летней <w>ярмарке</w>.",
                                "tr": "Çocuklar yaz <w>panayırında</w> atlıkarıncaya bindiler.",
                                "zh": "孩子们在夏季<w>游乐会</w>上坐了旋转木马。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "county fair",
                        "fun fair",
                        "state fair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание для общественных развлечений, часто с играми, аттракционами и соревнованиями.",
                        "tr": "Oyunlar, eğlenceler ve yarışmaların olduğu halka açık etkinlik.",
                        "zh": "一种公共娱乐聚会，通常设有游戏、游乐设施和竞赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярмарка",
                                "target_lang_sense_clarification": "funfair, market"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "panayır",
                                "target_lang_sense_clarification": "eğlence odaklı pazar"
                            },
                            {
                                "target_lang_word": "şenlik",
                                "target_lang_sense_clarification": "festival/eğlence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游乐会",
                                "target_lang_sense_clarification": "娱乐性集会"
                            },
                            {
                                "target_lang_word": "集市",
                                "target_lang_sense_clarification": "带有娱乐性质的市集"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a03b75-8db8-3b61-8fba-7bdcda38a237",
                    "sense_definition": "An event where companies or professionals gather to show and sell their products or services.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found a new job after speaking to companies at the career <w>fair</w>.",
                            "target_lang_translations": {
                                "ru": "Он нашел новую работу после общения с компаниями на <w>ярмарке</w> вакансий.",
                                "tr": "Kariyer <w>fuarında</w> şirketlerle konuştuktan sonra yeni bir iş buldu.",
                                "zh": "他在招聘<w>博览会</w>上与各公司交流后找到了一份新工作。"
                            }
                        },
                        {
                            "text": "Publishers display their new novels at the annual book <w>fair</w>.",
                            "target_lang_translations": {
                                "ru": "Издатели выставляют свои новые романы на ежегодной книжной <w>ярмарке</w>.",
                                "tr": "Yayıncılar yeni romanlarını yıllık kitap <w>fuarında</w> sergiliyorlar.",
                                "zh": "出版商在年度书<w>展会</w>上展示他们的新小说。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trade fair",
                        "book fair",
                        "job fair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мероприятие, где компании или профессионалы собираются для демонстрации и продажи своих продуктов или услуг.",
                        "tr": "Şirketlerin veya profesyonellerin ürünlerini sergilemek ve satmak için toplandığı etkinlik.",
                        "zh": "企业或专业人士聚集在一起展示和销售其产品或服务的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярмарка",
                                "target_lang_sense_clarification": "trade/book/job fair"
                            },
                            {
                                "target_lang_word": "выставка",
                                "target_lang_sense_clarification": "exhibition"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fuar",
                                "target_lang_sense_clarification": "ticari etkinlik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "博览会",
                                "target_lang_sense_clarification": "大型展示活动"
                            },
                            {
                                "target_lang_word": "展会",
                                "target_lang_sense_clarification": "行业展示活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "de5d32e7-f0fa-3d5e-becf-b94ae2109e98",
                    "sense_definition": "In a fair, honest, or abiding manner; according to the rules.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adv_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team promised to play <w>fair</w> and respect the referee.",
                            "target_lang_translations": {
                                "ru": "Команда пообещала играть <w>честно</w> и уважать судью.",
                                "tr": "Takım <w>dürüstçe</w> oynamaya ve hakeme saygı duymaya söz verdi.",
                                "zh": "球队承诺会<w>公平地</w>比赛并尊重裁判。"
                            }
                        },
                        {
                            "text": "You must fight <w>fair</w> if you want to win respect from your opponents.",
                            "target_lang_translations": {
                                "ru": "Ты должен драться <w>честно</w>, если хочешь завоевать уважение своих противников.",
                                "tr": "Rakiplerinden saygı görmek istiyorsan <w>dürüstçe</w> dövüşmelisin.",
                                "zh": "如果你想赢得对手的尊重，就必须<w>公平地</w>竞争。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play fair",
                        "fight fair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честным, порядочным образом; по правилам.",
                        "tr": "Dürüst, kurallara uygun bir şekilde.",
                        "zh": "以公平、诚实或遵守规则的方式行事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честно",
                                "target_lang_sense_clarification": "honestly"
                            },
                            {
                                "target_lang_word": "справедливо",
                                "target_lang_sense_clarification": "justly"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dürüstçe",
                                "target_lang_sense_clarification": "dürüst bir şekilde"
                            },
                            {
                                "target_lang_word": "âdil bir şekilde",
                                "target_lang_sense_clarification": "kurallara uygun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公平地",
                                "target_lang_sense_clarification": "公正地"
                            },
                            {
                                "target_lang_word": "诚实地",
                                "target_lang_sense_clarification": "守规矩地"
                            }
                        ]
                    }
                },
                {
