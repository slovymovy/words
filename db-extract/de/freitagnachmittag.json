                        "examples": [
                            {
                                "example_id": "10e91139-aa31-4ee5-a7d8-2760d2fbef5c",
                                "sense_id": "0806641d-4272-3ee2-a9ae-679335762939",
                                "text": "Diese Woche findet am Freitagnachmittag eine Aufführung des Schultheaters statt."
                            },
                            {
                                "example_id": "5b04452f-aa67-481b-aed0-16203b48134a",
                                "sense_id": "0806641d-4272-3ee2-a9ae-679335762939",
                                "text": "Der Freitagnachmittag ist bei uns traditionell der Familie gewidmet."
                            },
                            {
                                "example_id": "6ed5423b-5387-45cd-9a9d-b1943a2740fc",
                                "sense_id": "0806641d-4272-3ee2-a9ae-679335762939",
                                "text": "„Wenn der Frost in den kommenden Nächten über den Grünkohl und Rosenkohl geht, dann muss sie den Freitagnachmittag ernten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
