                ],
                "senses": [
                    {
                        "sense_id": "23dff401-85e1-36cb-b3da-d3e750f4e3c9",
                        "entry_id": "b647e34c-47d2-3b2d-b176-8fcd4686bf39",
                        "glosses": [
                            "nadwyżka towaru lub pieniędzy stwierdzona na podstawie porównania stanu faktycznego i stanu wynikającego z ewidencji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135c742d-da1f-4502-a23b-cecb6de18925",
                                "sense_id": "23dff401-85e1-36cb-b3da-d3e750f4e3c9",
                                "text": "I – paradoksalnie – lepiej mieć manko niż superatę. Pierwsze można zwrócić z własnych pieniędzy, ale drugie oznacza, że albo oszukuje się klientów, albo – nie daj Boże – wprowadza do sklepu i sprzedaje własny towar."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4b6a6702-eafd-376f-bffc-4d6b4d4373dc",
                        "entry_id": "b647e34c-47d2-3b2d-b176-8fcd4686bf39",
                        "glosses": [
                            "nadwyżka pieniędzy w stosunku do bilansu zysków i strat, jaki był przewidywany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f26be7fe-3aaa-4d50-9d77-7e838e68feeb",
                                "sense_id": "4b6a6702-eafd-376f-bffc-4d6b4d4373dc",
                                "text": "Tylko Czechy miały lekką superatę w budżecie, tzn. odrobinę większe wpływy niż wydatki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "02397431-0d72-3f96-9837-33be4abf5bc1",
                        "entry_id": "b647e34c-47d2-3b2d-b176-8fcd4686bf39",
                        "glosses": [
                            "nadmierna liczba lub ilość czegokolwiek lub kogokolwiek"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d8f8a3a-a90b-41d7-9c9b-89b1bef43ddc",
                                "sense_id": "02397431-0d72-3f96-9837-33be4abf5bc1",
                                "text": "[…] Rzewuskiego późne wieki wspomną jak dopust Boży, kiedy w superacie po tych wielmożach pozostają w kraju obce hordy, sprowadzone przez nich, wspaniałomyślna protekcja imperatorowej i król pruski gospodarzący w Wielkopolsce."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
