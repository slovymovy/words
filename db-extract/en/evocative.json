                    {
                        "translation_id": "75be6c28-1b86-43d9-b4d4-ace77585ba76",
                        "source_entry_id": "fadd4da7-0f0b-30dc-8c1d-9f30813ab4de",
                        "source_sense_id": "6259ab23-94c5-35d5-aaa8-7e2f4ed21b5f",
                        "source_sense_description": "that evokes (brings to mind) a memory, mood or image; redolent or reminiscent",
                        "target_lang_word": "atmosphärisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atmosphärisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb4a454-a102-33b1-ad30-cf01a9dbd2ac",
                                        "entry_id": "739a4948-1daa-3de6-89f6-8b9c5aeb7ecf",
                                        "glosses": [
                                            "auf die Gashülle eines Himmelskörpers (Atmosphäre) bezogen; in ihr befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c5beca-06c7-48b2-be9c-368c154d3272",
                                                "sense_id": "fcb4a454-a102-33b1-ad30-cf01a9dbd2ac",
                                                "text": "„Eine atmosphärische Erscheinung gilt demzufolge als ‚erklärt‘, wenn es gelungen ist, sie aus den bewährten Sätzen der Physik deduktiv abzuleiten.“"
                                            },
                                            {
                                                "example_id": "3ce92a55-59d2-4b15-8789-842ba9b9ded1",
                                                "sense_id": "fcb4a454-a102-33b1-ad30-cf01a9dbd2ac",
                                                "text": "„Es mag auf den ersten Blick verwunderlich erscheinen, dass es gerade die Gase mit den geringsten Konzentrationen – fast ausschließlich im ppm-Bereich – sind, die den atmosphärischen Glashauseffekt bewirken und nicht die Hauptbestandteile Stickstoff und Sauerstoff.“"
                                            },
                                            {
                                                "example_id": "ec22e3fc-cc47-40e9-af70-967828cc945e",
                                                "sense_id": "fcb4a454-a102-33b1-ad30-cf01a9dbd2ac",
                                                "text": "„Im Allgemeinen bezeichnet man die Differenz zwischen dem absoluten Druck und einem atmosphärischen Druck als Überdruck.“"
                                            },
                                            {
                                                "example_id": "7c073dff-7adf-4c8c-a32a-71a4aecffe31",
                                                "sense_id": "fcb4a454-a102-33b1-ad30-cf01a9dbd2ac",
                                                "text": "„Wenn nicht starke atmosphärische Winde diesen Zyklus durchbrechen, kann aus dem Sturm ein Hurrikan werden. Die Winde erreichen dann über 100 Stundenkilometer und rotieren um ein ruhiges Auge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "606ce473-1e4b-3e4f-8b81-e64cad41ecf7",
                                        "entry_id": "739a4948-1daa-3de6-89f6-8b9c5aeb7ecf",
                                        "glosses": [
                                            "eine gewisse Stimmung hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfed5994-4927-48b1-bdef-a23c6c1f9060",
                                                "sense_id": "606ce473-1e4b-3e4f-8b81-e64cad41ecf7",
                                                "text": "„Der neue wunderbar atmosphärische und romantische Sommerroman von Liv Thomas entführt einen an die Küste Siziliens und in die kulinarische Welt Italiens.“"
                                            },
                                            {
                                                "example_id": "6b969e1d-3133-4855-9ed4-baed24ffed54",
                                                "sense_id": "606ce473-1e4b-3e4f-8b81-e64cad41ecf7",
                                                "text": "„Dieser atmosphärische Roman ist besiedelt von starken, geheimnisumwitterten Charakteren.“"
                                            },
                                            {
                                                "example_id": "5433e35f-2b41-4dd3-9164-64ca3730dea9",
                                                "sense_id": "606ce473-1e4b-3e4f-8b81-e64cad41ecf7",
                                                "text": "„Kurzweilig, dramatisch, atmosphärisch – drei herrliche Weihnachtskrimis zum Angebotspreis, bei denen Spannung auf Unterhaltung trifft!“"
                                            },
                                            {
                                                "example_id": "a83113dd-5a57-46b1-b8c2-f37fac11f3b4",
                                                "sense_id": "606ce473-1e4b-3e4f-8b81-e64cad41ecf7",
                                                "text": "„Seine faktenreichen und doch atmosphärisch dicht erzählten Romane sind ihrer Zeit auch dann voraus, wenn sie den Blick in die Vergangenheit richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
