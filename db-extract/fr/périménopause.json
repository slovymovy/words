                "senses": [
                    {
                        "sense_id": "d02c5ca9-8c6f-3d37-8c03-90c1596a1287",
                        "entry_id": "3278e405-38b4-3ef1-92db-ab88bc2c4747",
                        "glosses": [
                            "Période de cinq ans environ précédant la ménopause lors de laquelle le cycle menstruel devient irrégulier et la menstruation dure de moins en moins longtemps."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fb42d8f8-2a41-43d8-9181-da80cb0f21d8",
                                "sense_id": "d02c5ca9-8c6f-3d37-8c03-90c1596a1287",
                                "text": "La périménopause se déclenche dès que les ovaires commencent à moins bien fonctionner, c’est-à-dire 7ou 8 ans avant la ménopause, mais couvre également l’année qui suit la date des dernières règles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca7a325-8fbb-46c0-914b-87d20ceb819a",
                        "source_entry_id": "3278e405-38b4-3ef1-92db-ab88bc2c4747",
                        "source_sense_id": "d02c5ca9-8c6f-3d37-8c03-90c1596a1287",
                        "target_lang_word": "perimenopause",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perimenopause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3beb37-7d19-3546-90f3-f874b5076ae4",
                                        "entry_id": "c544758f-c554-38bd-8ddf-68785e7026dd",
                                        "glosses": [
                                            "The physiological stage that women approaching menopause go through when, due to hormonal changes, they progress from their usual pattern of menstruation through a phase of atypical menstruation, and finally cease menstruating. Perimenopause ends when a woman has not menstruated for a year."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cec0beb-fef7-496c-a201-3f63261e1a4d",
                                                "sense_id": "fe3beb37-7d19-3546-90f3-f874b5076ae4",
                                                "text": "Researchers at eight locations across the United States plan to examine the safety and effectiveness of estrogen therapy during perimenopause, the few years just prior to menopause."
                                            },
                                            {
                                                "example_id": "4c21fb9c-2612-4f5f-8ecc-12506bc85a0f",
                                                "sense_id": "fe3beb37-7d19-3546-90f3-f874b5076ae4",
                                                "text": "The scientific study of perimenopause has been going on for decades, and the cultural discussion of this mind and body shift has reached something of a new fever pitch, with several books on the subject coming out this spring and a gaggle of “femtech” companies vowing to disrupt perimenopause."
                                            },
                                            {
                                                "example_id": "67df0c0c-f50c-4820-ba5f-2f753b5c58d1",
                                                "sense_id": "fe3beb37-7d19-3546-90f3-f874b5076ae4",
                                                "text": "She noted that it is also more common while women are nursing or during perimenopause, and that certain medications, including some forms of birth control, can decrease lubrication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
