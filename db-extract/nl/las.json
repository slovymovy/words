                                "sense_id": "5e338e71-58d5-3f8d-9c6d-7a267b9a9210",
                                "text": "Ik las de mails zonder te antwoorden."
                            },
                            {
                                "example_id": "aac9a3dd-8731-47ed-b340-ac39233b91e1",
                                "sense_id": "5e338e71-58d5-3f8d-9c6d-7a267b9a9210",
                                "text": "Ik bladerde erdoorheen en las eindeloze verhalen over hoe geweldig die burger was: ‘Goddelijk – al dat lopen waard’, ‘Drie Michelinsterren’, ‘Nog nooit zo’n grote burger gezien’ en ‘Ik ga een franchise openen in Londen’."
                            },
                            {
                                "example_id": "526bed2f-2dc8-4b3a-b576-41aa392cfb16",
                                "sense_id": "5e338e71-58d5-3f8d-9c6d-7a267b9a9210",
                                "text": "Ook was ze gisteren niet op tv, las ik op social media."
                            }
                        ]
