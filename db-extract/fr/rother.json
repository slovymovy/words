                        "sense_id": "11915774-56a2-3954-989a-57fd04e82492",
                        "entry_id": "960c55b5-e0d7-3af9-8721-fda97d00f96f",
                        "glosses": [
                            "Rivière d’Angleterre, qui marque la frontière entre les comtés du Kent et du Sussex de l’Est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2bff42-f98f-439b-8f57-525ea0ec8c3d",
                                "sense_id": "11915774-56a2-3954-989a-57fd04e82492",
                                "text": "ROTHER, (Géog. mod.) riviere d’Angleterre. Elle a sa source dans le comté de Sussex, & se partage en deux bras qui se perdent dans le Rye-Haven."
                            },
                            {
                                "example_id": "ca3f509c-8b96-499a-8430-9c087587c375",
                                "sense_id": "11915774-56a2-3954-989a-57fd04e82492",
                                "text": "ROMNEY, (Géog. mod.) ou Rumney, bourg à marché d’Angleterre, dans la province de Kent, sur une élévation assez considérable de gravier & de sable. C’est un des cinq ports du royaume, & qui étoit fort bon & fort fréquenté avant que la mer eût détourné l’embouchure de la Rother."
                            },
                            {
                                "example_id": "53c97180-9d64-476b-9e78-17a9b04bc0d0",
                                "sense_id": "11915774-56a2-3954-989a-57fd04e82492",
                                "text": "RYE, (Géogr. mod.) ville d’Angleterre, dans la partie orientale du comté de Sussex, à l’embouchure du Rother."
                            }
                        ]
                    },
