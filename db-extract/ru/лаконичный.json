                        "form_id": "c4ccc8b2-19a6-4b9a-8df1-0785d7cae636",
                        "entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "лаконичней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce38498b-5a82-38e8-af69-3017363f0877",
                        "entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "glosses": [
                            "книжн. выраженный кратко, сжато, немногословно, без лишних подробностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46d9fb9-82b2-48b2-a4e8-62829167ffb8",
                                "sense_id": "ce38498b-5a82-38e8-af69-3017363f0877",
                                "text": "В большинстве стран основные конституционные положения, регулирующие организацию судебной власти, являются предельно лаконичными."
                            }
                        ]
                    },
                    {
                        "sense_id": "2718f948-7257-3731-af48-1f16677fd829",
                        "entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "glosses": [
                            "книжн. выражающийся, говорящий или пишущий кратко, сжато, немногословно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5088ba1e-b3c6-4b79-9912-51f1d42e1b32",
                                "sense_id": "2718f948-7257-3731-af48-1f16677fd829",
                                "text": "Можно быть более сдержанным и лаконичным, когда речь идёт о человеке, которого уже нет на земле."
                            }
                        ]
                    },
                    {
                        "sense_id": "c293085d-9cd7-3dae-a121-b1a4d62fd4dc",
                        "entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "glosses": [
                            "имеющий малое число деталей, простой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba089587-1983-40ee-aa9d-ac0b6cc808a3",
                                "sense_id": "c293085d-9cd7-3dae-a121-b1a4d62fd4dc",
                                "text": "Рисунки предельно лаконичные, но при этом удивительно ёмкие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b6a1647-a76d-4478-8d72-14b51807c0e7",
                        "source_entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "target_lang_word": "laconic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laconic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c100163e-5ed7-3717-96c3-3332be67e2a3",
                                        "entry_id": "25b25c6b-26ba-30a3-855c-056a4fdae808",
                                        "glosses": [
                                            "Using as few words as possible; pithy and concise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f697af0-63f5-4c30-8124-806e7204f8b6",
                                                "sense_id": "c100163e-5ed7-3717-96c3-3332be67e2a3",
                                                "text": "I grow laconick even beyond laconicism; for sometimes I return only yes, or no, to questionary or petitionary epistles of half a yard long."
                                            },
                                            {
                                                "example_id": "8a035906-d4ec-4cec-af86-c520f81cade5",
                                                "sense_id": "c100163e-5ed7-3717-96c3-3332be67e2a3",
                                                "text": "His sense was strong and his style laconic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e47835-37d8-327b-94f3-5c3a8860baa5",
                                        "entry_id": "25b25c6b-26ba-30a3-855c-056a4fdae808",
                                        "glosses": [
                                            "Laidback; casual; not intense."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa00d81c-bfdd-4d3d-b74b-f555805a6d8e",
                                                "sense_id": "d2e47835-37d8-327b-94f3-5c3a8860baa5",
                                                "text": "A key player up the other end of the ground is Harris Andrews, who sometimes gets unfairly criticised for his laconic playing style. He desperately cares for this team."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "421494c3-32db-4e70-89d5-fe4991f2e90d",
                        "source_entry_id": "fad716e0-8158-3c8f-bfb7-c4cfc666b5d1",
                        "target_lang_word": "short-spoken",
                        "target_lang_code": "en",
