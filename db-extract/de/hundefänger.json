                ],
                "senses": [
                    {
                        "sense_id": "82065246-c138-36cc-8169-adce51fa03c9",
                        "entry_id": "8237ec23-9ac4-3b32-84be-308494548f0d",
                        "glosses": [
                            "Person, die Hunde (meistens Straßenhunde) einfängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e3607a-2871-4700-9f62-95f582a4479c",
                                "sense_id": "82065246-c138-36cc-8169-adce51fa03c9",
                                "text": "„Teile des Wahlkreises Main-Spessart waren vor 100 Jahren noch ein deutsches Armenhaus, in dem der Hundefänger umging; heute hat es der Erneuerer Rützel hier schwerer als der Bewahrer Hoffmann.“"
                            },
                            {
                                "example_id": "8e7e5f41-561d-40a9-aa1a-05442d64c60b",
                                "sense_id": "82065246-c138-36cc-8169-adce51fa03c9",
                                "text": "„In vielen Städten, etwa in Köln, wurde einmal jährlich ein Hundefänger bestellt, auch Hundschläger oder Hundsleger genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
