                "senses": [
                    {
                        "sense_id": "820bd59d-c8e4-3e85-b2f8-2112ef4a764f",
                        "entry_id": "623f365e-62bb-3211-b419-951efaf17cf2",
                        "glosses": [
                            "именины высокопоставленного лица, принадлежащего к царствующей фамилии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db07cb75-ba38-4f62-b198-e9a6cd4aa201",
                                "sense_id": "820bd59d-c8e4-3e85-b2f8-2112ef4a764f",
                                "text": "Какой русский не веселится сегодня, празднуя тезоименитство великого нашего монарха!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7f5097b8-18fe-301b-abbc-d756cf84eba1",
                        "entry_id": "623f365e-62bb-3211-b419-951efaf17cf2",
                        "glosses": [
                            "день именин любого крещёного человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d1b1b0-d6d5-4653-8671-6fe355fc2626",
                                "sense_id": "7f5097b8-18fe-301b-abbc-d756cf84eba1",
                                "text": "Каждую субботу регулярно в доме мылись полы и выбивались ковры, каждое первое число служились молебны с водосвятием, каждое тезоименитство Татьяны Семеновны, её сына (и моё — в первый раз в эту осень) задавались пиры на весь околоток."
                            }
                        ]
                    }
