                        "examples": [
                            {
                                "example_id": "c6ba68f6-e7fe-45fd-a2a3-a0f3bd1793fb",
                                "sense_id": "d4c163c3-d445-399f-af9c-9f44b131808a",
                                "text": "De ongewapende man werd doodgeschoten, maar de schutter beweerde dat hij uit noodweer handelde."
                            },
                            {
                                "example_id": "80ae7e2b-1b88-4693-ac68-0da16088b17c",
                                "sense_id": "d4c163c3-d445-399f-af9c-9f44b131808a",
                                "text": "Uit onderzoek, geluidsopnames en verhalen van slachtoffers blijkt dat Russische militairen ongewapende Oekraïners opzettelijk gedood en verkracht hebben."
                            }
                        ]
                    }
