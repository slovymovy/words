                "senses": [
                    {
                        "sense_id": "27fb8a77-026c-358b-8934-f46b2b9fd5c5",
                        "entry_id": "aa526647-704a-3e51-98f3-56db0dcccc7f",
                        "glosses": [
                            "Redeweise Erwachsener, vor allem der Eltern, gegenüber Kleinkindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173032a2-690e-4b5f-a9fc-e6200c64e47c",
                                "sense_id": "27fb8a77-026c-358b-8934-f46b2b9fd5c5",
                                "text": "Elternsprache ist bei Glück ein Verweisstichwort für Ammensprache."
                            },
                            {
                                "example_id": "d089c12e-20b9-4d38-8141-4692a52cba7e",
                                "sense_id": "27fb8a77-026c-358b-8934-f46b2b9fd5c5",
                                "text": "„So wäre auch Elternsprache (engl. parentese) angebracht, nicht aber mehr die ältere Bezeichnung »Ammensprache«.“"
                            },
                            {
                                "example_id": "b67ebf67-3460-4668-b26c-bb9d0ed28968",
                                "sense_id": "27fb8a77-026c-358b-8934-f46b2b9fd5c5",
                                "text": "„Elternsprache („motherese“ … Elternsprache ist somit systematisch vereinfachte und verdeutlichte Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca58d34b-43eb-3f16-9c66-84c8f1d0b4c9",
                        "entry_id": "aa526647-704a-3e51-98f3-56db0dcccc7f",
                        "glosses": [
                            "Sprache, die die Eltern verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40aab2e3-c4e3-410a-9d85-cddf243da88d",
                                "sense_id": "ca58d34b-43eb-3f16-9c66-84c8f1d0b4c9",
                                "text": "„Seit Jahrhunderten leben aber im Gebiet des heutigen Österreich auch Menschen, die andere Elternsprachen haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0e1119e0-5dc8-32f9-9b9b-61f941f39159",
                        "entry_id": "aa526647-704a-3e51-98f3-56db0dcccc7f",
                        "glosses": [
                            "Sprache oder Sprachstufe, aus der eine spätere Sprache (= Tochtersprache) hervorgegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1a219b-fbda-4571-b275-4f86ee37f3b3",
                                "sense_id": "0e1119e0-5dc8-32f9-9b9b-61f941f39159",
                                "text": "„Stammbaummodelle sind hierarchische Modelle, in denen sich Tochtersprachen \"genetisch\" zusammenhängend aus Elternsprachen entwickeln. “"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
