                                "target_senses": [
                                    {
                                        "sense_id": "69c1ffd0-718a-3d5b-9e25-40a87da66dde",
                                        "entry_id": "40ac258b-0796-3ca9-9d49-6b5f3bfc0d14",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca3c135-3bde-49b3-9596-4ad006bb691e",
                                                "sense_id": "69c1ffd0-718a-3d5b-9e25-40a87da66dde",
                                                "text": "Pourvu que la Coliche ne vêle pas en même temps que moi ! répétait Lise chaque matin."
                                            },
                                            {
                                                "example_id": "ae04b4a0-2519-4048-b719-e2df097bf795",
                                                "sense_id": "69c1ffd0-718a-3d5b-9e25-40a87da66dde",
                                                "text": "Au menu : des tables rondes, dont celles animées par notre journaliste Lise Abou Mansour, à qui l’on doit la rubrique Ma tête et moi (la première traite du coming-out, la seconde a pour thème Filmer la psychanalyse), des ateliers interactifs, des talks."
                                            },
                                            {
                                                "example_id": "f8083da2-718a-4aa8-92a9-228b5a8c778a",
                                                "sense_id": "69c1ffd0-718a-3d5b-9e25-40a87da66dde",
                                                "text": "« Elle dégage une lumière intense et possède un instinct très sûr tout en n’ayant pas peur du travail », insiste la coréalisatrice Lise Akoka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
