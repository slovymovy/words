                    "sense_definition": "voltooid deelwoord van <w>verwinden</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verwinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had die diepe teleurstelling nog lang niet volledig <w>verwonden</w>.",
                            "target_lang_translations": {
                                "en": "He had by no means fully <w>gotten over</w> that deep disappointment."
                            }
                        },
                        {
                            "text": "De schok van het slechte nieuws scheen door niemand echt <w>verwonden</w> te zijn.",
                            "target_lang_translations": {
                                "en": "The shock of the bad news seemed to have been truly <w>overcome</w> by no one."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of verwinden: overcome, gotten over"
                    },
                    "translations": {
                        "en": [
