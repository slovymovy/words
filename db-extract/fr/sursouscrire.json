                "senses": [
                    {
                        "sense_id": "b303b83a-2d86-39e3-af69-f1a38647db36",
                        "entry_id": "4b139a14-d991-3f06-a5e7-04b9ed552dc4",
                        "glosses": [
                            "Souscrire, au-delà de ce qui est disponible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb81af2-f919-4a3f-9b08-fe624c943655",
                                "sense_id": "b303b83a-2d86-39e3-af69-f1a38647db36",
                                "text": "« Le fonctionnement des indices traditionnels a pu conduire de nombreux institutionnels à sursouscrire la dette des pays périphériques de la zone euro », relève Patrick Lajoinie, responsable de la clientèle institutionnelle chez Lombard Odier IM."
                            },
                            {
                                "example_id": "26a2a35b-e93a-46e7-b176-337057c82a87",
                                "sense_id": "b303b83a-2d86-39e3-af69-f1a38647db36",
                                "text": "La santé financière de BP ne préoccupe plus les marchés qui viennent de sursouscrire à un emprunt obligataire de 3,5 milliards de dollars émis mardi par le pétrolier."
                            },
                            {
                                "example_id": "23ba5118-b1ba-4bd3-9574-e0c4c6279645",
                                "sense_id": "b303b83a-2d86-39e3-af69-f1a38647db36",
                                "text": "Afin d'empêcher un utilisateur de sursouscrire à des ressources, il faut fixer des limites."
                            }
                        ]
                    }
                ],
