                "senses": [
                    {
                        "sense_id": "2c47b6f8-4e4d-3cb0-89b0-1dd85022a41f",
                        "entry_id": "f6ccb657-1aa4-3ba9-be9f-e81624103446",
                        "glosses": [
                            "wie eine Untertasse geformt, die Form einer Untertasse habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3379b474-8135-4ed4-9161-1a705385f5a1",
                                "sense_id": "2c47b6f8-4e4d-3cb0-89b0-1dd85022a41f",
                                "text": "„Sie fanden jetzt häufiger Spuren von Büffeln; mehrere Male zogen sie über festgetretene Trails, wie sie große Herden auf ihrem Weg zur Tränke am Fluss hinterlassen, und einmal stießen sie auf eine riesige, untertassenförmige Mulde, die an ihrer tiefsten Stelle zwei Meter maß und über zwölf Meter breit war.“"
                            }
                        ],
