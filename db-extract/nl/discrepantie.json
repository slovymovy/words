                                "target_senses": [
                                    {
                                        "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                        "entry_id": "a7506862-6b7b-3f45-8820-340a40051c0f",
                                        "glosses": [
                                            "An inconsistency between facts or sentiments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9574d201-1faf-46e8-a4b9-838ed94a919c",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "They found a discrepancy between the first set of test results and the second, and they're still trying to figure out why."
                                            },
                                            {
                                                "example_id": "eda1e472-b162-4779-9e31-cebb8b797295",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "Still, there is pilferage, mysterious discrepancies eating into the percentages."
                                            },
                                            {
                                                "example_id": "16bd5542-cc65-47bf-afe7-71fe4f2e24ab",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, […]. They also exposed the blatant discrepancy between the west's professed values and actual foreign policies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a78740d2-c679-37d3-ad10-f750ff683de6",
                                        "entry_id": "a7506862-6b7b-3f45-8820-340a40051c0f",
                                        "glosses": [
                                            "The state or quality of being discrepant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
