                "senses": [
                    {
                        "sense_id": "dbbde7d2-c9f1-3767-ad14-a895a0943fca",
                        "entry_id": "ee1cd1d7-6ae9-35a2-bcf0-4807e336b774",
                        "glosses": [
                            "Qui a l'aspect d'un schiste ; qui est grossièrement feuilleté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d928be-a51f-4808-b535-6ed5f3322739",
                                "sense_id": "dbbde7d2-c9f1-3767-ad14-a895a0943fca",
                                "text": "A mesure qu'on s'élève dans le système, le quarzite qui alterne avec ces roches devient plus noirâtre, pyritifère, schistoïde et pailleté."
                            },
                            {
                                "example_id": "c606726c-16e3-40b7-938f-11b10727fbb9",
                                "sense_id": "dbbde7d2-c9f1-3767-ad14-a895a0943fca",
                                "text": "Les couches de passage entre le calcaire massif et les couches schistoïdes sont constituées d'un banc mince de calcaire noir, d'un banc de calcaire argileux et de calcschistes en plaquettes, d'un banc de calcaire crinoïdique, dépourvu de surface taraudée qui attesterait d'une période d'émersion."
                            }
                        ]
                    }
                ],
