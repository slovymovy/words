                "senses": [
                    {
                        "sense_id": "6c3c42b8-7bd3-389b-87c7-7f036c58ecb7",
                        "entry_id": "50f42e71-2309-31d3-bd79-141677ff1896",
                        "glosses": [
                            "Enduire les moules du potier d’étain avec de la poudre de pierre ponce, délayée dans un blanc d’œuf."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b9b17d3b-b3f5-38e9-95e8-61774602e229",
                        "entry_id": "50f42e71-2309-31d3-bd79-141677ff1896",
                        "glosses": [
                            "Dans les fonderies, enduire les moules réutilisables avec de la poudre de graphite, ou de la plombagine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe8e964-d750-4add-8b11-da3adb243a9e",
                                "sense_id": "b9b17d3b-b3f5-38e9-95e8-61774602e229",
                                "text": "Dans une coquille [moule réutilisable ⁽ⁿᵒᵗᵉ⁾], il sera bon, par exemple, de poteyer fortement les alimentations qui doivent nourrir la pièce moulée. Le plus souvent, le poteyage se fait à la plombagine. Les mélanges de talc et d'ocre ou de kaolin et de talc dilués dans l'eau avec un peu de silicate de soude peuvent également être employés"
                            }
                        ]
                    }
