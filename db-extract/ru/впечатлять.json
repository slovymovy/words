                ],
                "translations": [
                    {
                        "translation_id": "1c9dec69-67df-4f92-9549-ae6620816c00",
                        "source_entry_id": "d81bb80a-6791-3b66-b3f2-628ff9272c7a",
                        "source_sense_id": "51cb2775-3ff9-36aa-8c44-d2718d11782d",
                        "target_lang_word": "impress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df8ed5fa-91b5-3d18-b9b3-7f7d3512afda",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To affect (someone) strongly and often favourably."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "531d24db-f568-46cc-a513-035bf6dad84b",
                                                "sense_id": "df8ed5fa-91b5-3d18-b9b3-7f7d3512afda",
                                                "text": "You impressed me with your command of Urdu."
                                            },
                                            {
                                                "example_id": "8c248831-86bd-4c94-b468-179e5d18477c",
                                                "sense_id": "df8ed5fa-91b5-3d18-b9b3-7f7d3512afda",
                                                "text": "Mr. Campion appeared suitably impressed and she warmed to him. He was very easy to talk to with those long clown lines in his pale face, a natural goon, born rather too early she suspected."
                                            },
                                            {
                                                "example_id": "4950a127-9866-4c3e-a109-f9e0b96d9893",
                                                "sense_id": "df8ed5fa-91b5-3d18-b9b3-7f7d3512afda",
                                                "text": "Okay, so you're a rocket scientist / That don't impress me much"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b5dc22-44fb-3a7b-a8b2-3559eabfdd1e",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To make an impression, to be impressive."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4080327a-8a44-433f-b047-d9e8c7f99851",
                                                "sense_id": "18b5dc22-44fb-3a7b-a8b2-3559eabfdd1e",
                                                "text": "Henderson impressed in his first game as captain."
                                            },
                                            {
                                                "example_id": "24dc1d1b-fc31-4462-b991-52a67852d172",
                                                "sense_id": "18b5dc22-44fb-3a7b-a8b2-3559eabfdd1e",
                                                "text": "Manchester United's Tom Cleverley impressed on his first competitive start and Lampard demonstrated his continued worth at international level in a performance that was little more than a stroll once England swiftly exerted their obvious authority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b658a5-e93d-3fd0-8c1a-5866b306de22",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To produce a vivid impression of (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d812a2bc-37db-4377-b2c0-b03e62789125",
                                                "sense_id": "00b658a5-e93d-3fd0-8c1a-5866b306de22",
                                                "text": "That first view of the Eiger impressed itself on my mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33626b7b-aa04-316b-a288-c7c74585892a",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To mark or stamp (something) using pressure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9daea7-119d-4b22-87f6-5d301c86b00a",
                                                "sense_id": "33626b7b-aa04-316b-a288-c7c74585892a",
                                                "text": "We impressed our footprints in the wet cement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47923439-6981-35e6-824d-3f7fe7730047",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To produce (a mark, stamp, image, etc.); to imprint (a mark or figure upon something)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf643959-8e48-33eb-ac77-ad57ed38425a",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To fix deeply in the mind; to present forcibly to the attention, etc.; to imprint; to inculcate."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e61173-9675-4845-9dc6-6d3c4ce25320",
                                                "sense_id": "bf643959-8e48-33eb-ac77-ad57ed38425a",
                                                "text": "impress the motives and methods of persuasion upon our own hearts, till we feel the force and power of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca7eafff-ab08-3921-8f8f-00b8923df88f",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To compel (someone) to serve in a military force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ce10b3-2483-45e6-b48f-0771d42e0f56",
                                                "sense_id": "ca7eafff-ab08-3921-8f8f-00b8923df88f",
                                                "text": "The press gang used to impress people into the Navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78cfacaf-1930-31fa-a91c-8776e15ea6e4",
                                        "entry_id": "aac0a271-8686-3169-8d91-19d7f965c2dc",
                                        "glosses": [
                                            "To seize or confiscate (property) by force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e7efd89-3f8e-41f8-a4b6-d556d3a993bd",
                                                "sense_id": "78cfacaf-1930-31fa-a91c-8776e15ea6e4",
                                                "text": "The liner was impressed as a troop carrier."
                                            },
                                            {
                                                "example_id": "7e42dd46-31fe-4ff4-bc0c-b55d3583252a",
                                                "sense_id": "78cfacaf-1930-31fa-a91c-8776e15ea6e4",
                                                "text": "the second £5,000 imprest for the service of the sick and wounded prisoners"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccbe56c-b5a4-3a4f-933b-27b23b446da5",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "The act of impressing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73b15504-7f37-3f71-88a7-9046e2b8d174",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "An impression; an impressed image or copy of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8231d06c-b080-4c04-8593-d5de324b3a53",
                                                "sense_id": "73b15504-7f37-3f71-88a7-9046e2b8d174",
                                                "text": "This weak impress of love is as a figure / Trenched in ice."
                                            },
                                            {
                                                "example_id": "c05c83c8-d042-4450-99a4-465efa4163f2",
                                                "sense_id": "73b15504-7f37-3f71-88a7-9046e2b8d174",
                                                "text": "We know that you were pressed for money, that you took an impress of the keys which your brother held […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e259aed7-21a7-3389-bcdf-b2b229fb1a89",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "A stamp or seal used to make an impression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd5a1c7a-0294-327e-8044-59ae18459402",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "An impression on the mind, imagination etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f7979d-2663-41c2-b331-9c60f998d22e",
                                                "sense_id": "fd5a1c7a-0294-327e-8044-59ae18459402",
                                                "text": "Such admonitions, in the English of the Authorized Version, left an indelible impress on imaginations nurtured on the Bible […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f704ca65-d0ca-33d7-ba72-0e0341973239",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "Characteristic; mark of distinction; stamp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae59ef2-1714-4e80-9596-3d1974d33d08",
                                                "sense_id": "f704ca65-d0ca-33d7-ba72-0e0341973239",
                                                "text": "we have God surveying the works of the creation, and leaving this general impress or character upon them"
                                            },
                                            {
                                                "example_id": "15f0a058-02a8-4c98-ac57-3565acf181c5",
                                                "sense_id": "f704ca65-d0ca-33d7-ba72-0e0341973239",
                                                "text": "As he himself [Sir Nigel Gresley] would doubtless have wished, he died in harness; only a few weeks previously he had been present at the first public view of his latest design, the Bantam Cock, which, like most of his products, bore all over it the impress of his personality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab34899-6e48-3e61-ab29-adef2f0d7414",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "A heraldic device; an impresa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c16e82-4243-4fc4-bee7-2d6b37c662b2",
                                                "sense_id": "5ab34899-6e48-3e61-ab29-adef2f0d7414",
                                                "text": "It commonly occurred that Knights who , on entering the Lists , wished to conceal their identity , would assume a Device with an allusive Motto , which was designated an IMPRESS"
                                            },
                                            {
                                                "example_id": "70c7e8b3-8f5c-4947-af9e-2789004264fb",
                                                "sense_id": "5ab34899-6e48-3e61-ab29-adef2f0d7414",
                                                "text": "To describe […] emblazon'd Shields, / Impreses quaint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07bcb73e-988d-3ef3-97ca-a66d5333c8d9",
                                        "entry_id": "f295856c-1455-3ea9-9ed8-6354cdc97654",
                                        "glosses": [
                                            "The act of impressing, or taking by force for the public service; compulsion to serve; also, that which is impressed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7d0b67-cab1-44aa-a46e-288fcc14d1ba",
                                                "sense_id": "07bcb73e-988d-3ef3-97ca-a66d5333c8d9",
                                                "text": "Why such impress of shipwrights?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
