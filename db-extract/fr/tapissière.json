                                        "entry_id": "1df01ac5-5f5a-3933-a8c5-e0deca8f9f86",
                                        "glosses": [
                                            "Handwerkerin, die Möbel mit Polstern versieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b41f35c-bfc8-416c-aa53-aad97be7cfe9",
                                                "sense_id": "0b506d73-81d9-30b3-861d-2634a5d99c36",
                                                "text": "„Es hatte sich eingebürgert, dass die Polsterin nach getaner Arbeit in die Stadt fuhr, wo sie sich in einem Traditionsladen mit einer Bluse belohnte.“"
                                            }
