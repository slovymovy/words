                "senses": [
                    {
                        "sense_id": "81d20c58-6707-3cc1-9ed8-a3b6c7ebe2ec",
                        "entry_id": "d6ae8fd9-dae6-3bf3-a498-3dc9d00e0dad",
                        "glosses": [
                            "Fait de rester zen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0a0b10-2ea9-4ba9-8157-1ccb854ec476",
                                "sense_id": "81d20c58-6707-3cc1-9ed8-a3b6c7ebe2ec",
                                "text": "Je m’exerce à la zénitude et c’est dur. Depuis le temps, cela devrait pourtant couler de source, être acquis, quand même, avec tout le travail que j’ai fait sur moi."
                            },
                            {
                                "example_id": "a9e3b5e9-7d70-4153-99e7-eff73ed2616d",
                                "sense_id": "81d20c58-6707-3cc1-9ed8-a3b6c7ebe2ec",
                                "text": "À l’heure des espaces de travail dépersonnalisés de type open-space, pourquoi ne pas opter pour la « zénitude » au bureau ?"
                            },
                            {
                                "example_id": "9af29dbd-be0e-410c-8d1f-86ddfdc8f263",
                                "sense_id": "81d20c58-6707-3cc1-9ed8-a3b6c7ebe2ec",
                                "text": "Le 26 juillet dans les Pyrénées, Macron a pu afficher sa zénitude."
                            }
                        ]
                    }
                ],
