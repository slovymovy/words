                        "glosses": [
                            "S’autoriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce40cf7-427d-4ea5-b88f-43eacf79ca5d",
                                "sense_id": "ee8ac744-c2de-3d21-b08d-84ffef349c59",
                                "text": "Les artisans ne sont pas soumis aux mêmes obligations, ils peuvent « s'auto-autoriser » à conduire un engin."
                            },
                            {
                                "example_id": "a4cf2429-49eb-4575-8560-eeed707d3386",
                                "sense_id": "ee8ac744-c2de-3d21-b08d-84ffef349c59",
                                "text": "S'auto-autoriser à s'occuper à nouveau de soi, et à se faire du bien."
                            },
                            {
                                "example_id": "8db0c3da-deac-4710-ade8-336a1bb1058e",
                                "sense_id": "ee8ac744-c2de-3d21-b08d-84ffef349c59",
                                "text": "Pour les auto-autorisations, je crois que les CTTs peuvent s'auto-autoriser, mais ce doit être les seuls."
