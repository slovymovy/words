                                    {
                                        "sense_id": "910e760b-a4f4-3776-bb32-7149dfb70a13",
                                        "entry_id": "18158f49-48f4-30bb-9f69-5f292886c8dd",
                                        "glosses": [
                                            "A person appointed, or chosen, by parties to determine a controversy between them; an arbitrator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "909b472b-3fe3-430a-8271-e5f3b442f9fb",
                                                "sense_id": "910e760b-a4f4-3776-bb32-7149dfb70a13",
                                                "text": "In order to protect individual liberty there must be an arbiter between the governing powers and the governed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15be00a4-9349-3035-801d-6599550c21b4",
                                        "entry_id": "18158f49-48f4-30bb-9f69-5f292886c8dd",
                                        "glosses": [
                                            "A person or object having the power of judging, determining, or ordaining; one whose power of deciding and governing is not limited."
                                        ],
                                        "tags": [
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6555b8b-26e9-4d5c-b13b-651b4689bf0e",
                                                "sense_id": "15be00a4-9349-3035-801d-6599550c21b4",
                                                "text": "Television and film, not Vogue and similar magazines, are the arbiters of fashion."
                                            },
                                            {
                                                "example_id": "2bbf3f61-6b1f-41b5-b2be-3f319202da3d",
                                                "sense_id": "15be00a4-9349-3035-801d-6599550c21b4",
                                                "text": "The grapholect of Standard English is not the exclusive system that arbiters of cultural purity wish to 'correct' us into believing"
                                            },
                                            {
                                                "example_id": "e0e2fa55-abfe-4d53-b12b-2a418e0408ea",
                                                "sense_id": "15be00a4-9349-3035-801d-6599550c21b4",
                                                "text": "The dreadnought is the ultimate arbiter of space warfare; millions of tons of metal, ceramic, and polymer dedicated to the projection of firepower against an enemy vessel of like ability. No sane commander would face a dreadnought with anything less than another dreadnought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d59bd6d7-e00f-354c-a1d7-5df165a977ae",
                                        "entry_id": "18158f49-48f4-30bb-9f69-5f292886c8dd",
                                        "glosses": [
                                            "A component in circuitry that allocates scarce resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arbiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71d3a864-fefe-3385-ba52-ba0428995c14",
                                        "entry_id": "b202763c-8cbf-3378-967d-cce175cb9caf",
                                        "glosses": [
                                            "To act as an arbiter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea2c43f4-587e-4027-a475-c390f86bccdd",
                                                "sense_id": "71d3a864-fefe-3385-ba52-ba0428995c14",
                                                "text": "Worse, since there was no institution to arbiter disagreements between Parliament and the government, whenever Parliament voted against the government on the smallest issues, coalitions fragmented, and governments had to be recomposed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
