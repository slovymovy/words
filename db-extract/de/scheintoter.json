                ],
                "senses": [
                    {
                        "sense_id": "58b1d30a-c91b-37f9-9892-f18f0118fd2a",
                        "entry_id": "9ddd0323-dcf3-3115-9b30-45e0ebdb6c9a",
                        "glosses": [
                            "Person, die lebt, aber den Anschein erweckt, tot zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851ca35c-19fa-4f63-84cb-88eef2b6f15b",
                                "sense_id": "58b1d30a-c91b-37f9-9892-f18f0118fd2a",
                                "text": "„Er ist noch kein Toter, nur ein Scheintoter, dem jetzt durch die geheimnisvolle Kraft einer unbekannten Idee wieder Leben eingehaucht worden ist.“"
                            },
                            {
                                "example_id": "f4b81cbc-9496-4743-b0ea-bbd9909cbdad",
                                "sense_id": "58b1d30a-c91b-37f9-9892-f18f0118fd2a",
                                "text": "„Man kannte nur die wenigen Fälle, in denen Scheintote gerettet worden waren, aber wer wußte, wie viele schweigend erstickt waren, die man nie gefunden hatte?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
