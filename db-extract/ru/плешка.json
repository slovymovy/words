                "senses": [
                    {
                        "sense_id": "1e8df694-804c-32e4-adbe-501e2c045167",
                        "entry_id": "a4eae5ab-b788-30a3-8b7c-e2c81d256b59",
                        "glosses": [
                            "разг. уменьш. к плешь; (небольшая) лысина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a835ab9-ee09-4dfa-966e-86d3e259057c",
                                "sense_id": "1e8df694-804c-32e4-adbe-501e2c045167",
                                "text": "У меня тут даже плешка, с семитку, пожалуй, а то и больше; волосами зачёсываю; хорошо, что густые — не видать…"
                            },
                            {
                                "example_id": "e90ec017-5d89-4764-b680-9e8b8fa264d0",
                                "sense_id": "1e8df694-804c-32e4-adbe-501e2c045167",
                                "text": "Спиной ко мне стоял человек без шапки, с зачаточной плешкой на затылке .."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7171459-af0b-3460-82f5-73780f66d326",
                        "entry_id": "a4eae5ab-b788-30a3-8b7c-e2c81d256b59",
                        "glosses": [
                            "разг. уменьш. к плешь; голое, лишённое растительности место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb746ba8-1c2f-48a2-90db-6166f3406ea6",
                                "sense_id": "f7171459-af0b-3460-82f5-73780f66d326",
                                "text": "Тёркин соскочил на лошади с полукруглого вала в плешку, покрытую мхом и хвоей."
                            }
                        ]
                    }
                ],
