                "translations": [
                    {
                        "translation_id": "15c912de-52af-4f3b-813d-0ae384515e8e",
                        "source_entry_id": "0792796a-4e69-38b0-900e-0cb9b27dc565",
                        "source_sense_id": "0c02b01f-2fa6-32e0-b6bf-8fbe66a3d0e4",
                        "target_lang_word": "omen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                                        "entry_id": "42643b0d-b6f3-3a68-b8fa-6a90fb66df3d",
                                        "glosses": [
                                            "Something which portends or is perceived to portend either a good or evil event or circumstance in the future, or which causes a foreboding; a portent or augury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fca03bc-a4b1-4a6c-965b-c726c960c407",
                                                "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                                                "text": "The ghost's appearance was an ill omen."
                                            },
                                            {
                                                "example_id": "025c89fa-ed08-4d4a-8de5-b659dec55c18",
                                                "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                                                "text": "A rise in imports might be an omen of economic recovery."
                                            },
                                            {
                                                "example_id": "57b0181b-8e17-4f2a-9f97-da039889b8fd",
                                                "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                                                "text": "The egg has, during the span of history, represented mystery, magic, medicine, food and omen."
                                            },
                                            {
                                                "example_id": "458b748e-338c-49aa-b539-3aaf967552b9",
                                                "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                                                "text": "Day broke. He saw three black hens asleep in a tree. He shuddered, horrified at this omen. Then he promised the Holy Virgin three chasubles for the church, and that he would go barefooted from the cemetery at Bertaux to the chapel of Vassonville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51faeb91-8f9d-3922-baaa-449dc2d460e3",
                                        "entry_id": "42643b0d-b6f3-3a68-b8fa-6a90fb66df3d",
                                        "glosses": [
                                            "A thing of prophetic significance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba587f15-029e-428d-91c7-64a251856590",
                                                "sense_id": "51faeb91-8f9d-3922-baaa-449dc2d460e3",
                                                "text": "A sign of ill omen."
                                            }
                                        ]
                                    }
                                ]
                            },
