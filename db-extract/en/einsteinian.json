                    },
                    {
                        "translation_id": "3dc59eff-7108-43f2-8192-0806db3b00fd",
                        "source_entry_id": "578f7baf-76f8-387e-81af-7ee5c009fa29",
                        "source_sense_id": "b4652488-4084-3e97-b5a2-a18437aada8a",
                        "source_sense_description": "of or relating to Albert Einstein",
                        "target_lang_word": "einsteinien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einsteinien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe693114-3f73-3316-aa1c-e35ac46a3b7c",
                                        "entry_id": "891ba43a-70c1-33e3-99f2-70ed8ec97640",
                                        "glosses": [
                                            "Relatif à la vie, à l’œuvre et aux découvertes d’Albert Einstein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496248bd-12f4-4308-b10d-d4cedcc9f283",
                                                "sense_id": "fe693114-3f73-3316-aa1c-e35ac46a3b7c",
                                                "text": "Cette approche systémique et relativiste post-moderne nous sort du monde newtonien pour nous propulser dans l’univers einsteinien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec4c71b6-5a88-3e6b-94b5-7f4b1359a2c5",
                                        "entry_id": "891ba43a-70c1-33e3-99f2-70ed8ec97640",
                                        "glosses": [
                                            "Relatif à une théorie physique développée par Albert Einstein."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95d3fc5f-b077-4648-9c1b-5f0efe027dde",
                                                "sense_id": "ec4c71b6-5a88-3e6b-94b5-7f4b1359a2c5",
                                                "text": "Mais dans les univers courbés du second système einsteinien, des boucles temporelles pourraient autoriser une certaine exploration du passé, sans condition de vitesse, le principe de causalité étant dans ce cas invalidé."
                                            },
                                            {
                                                "example_id": "5f276b4d-2d79-455d-aa04-df2373086c1b",
                                                "sense_id": "ec4c71b6-5a88-3e6b-94b5-7f4b1359a2c5",
                                                "text": "Tests et applications de la relativité einsteinienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c3f825a-43d3-3ca4-ba06-90a36aa78035",
                                        "entry_id": "891ba43a-70c1-33e3-99f2-70ed8ec97640",
                                        "glosses": [
                                            "Relatif à un scientifique soutenant les théories relativistes d’Albert Einstein."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
