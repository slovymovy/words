                ],
                "senses": [
                    {
                        "sense_id": "39a61e83-5ea1-3f3f-9887-d3f81df9027a",
                        "entry_id": "5c18adba-ba0f-316b-b89e-15c4add15ee6",
                        "glosses": [
                            "Se condamner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fd4cd84-8b9c-4ad7-9a9a-73a2d0a07239",
                                "sense_id": "39a61e83-5ea1-3f3f-9887-d3f81df9027a",
                                "text": "Cela nous oblige à nous abandonner en Dieu, à ne plus nous regarder à hauteur d’homme, à ne plus nous auto-condamner."
                            },
                            {
                                "example_id": "4b13ba38-0061-405b-be8a-4d8676784cb3",
                                "sense_id": "39a61e83-5ea1-3f3f-9887-d3f81df9027a",
                                "text": "Ne s’étant ni auto-créé, ni auto-sauvé, l’être humain doit renoncer à s’auto-condamner, à peser le poids de son péché en arbitre absolu, en se prenant comme norme ultime."
                            }
                        ]
                    }
