                        "glosses": [
                            "Deeply angered but not outwardly displaying it; full of ire; angry; wroth."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43f82209-9175-30c5-8aa7-d9a8ed232b84",
                        "entry_id": "4c6a8af6-c8d1-3271-976f-17402e958f46",
                        "glosses": [
                            "Threatening to storm, or storming; louring or stormy."
                        ],
                        "tags": [
                            "of clouds"
                        ],
                        "examples": [
                            {
                                "example_id": "0f08a176-7dbe-42a6-b1ef-3a84f8626821",
                                "sense_id": "43f82209-9175-30c5-8aa7-d9a8ed232b84",
                                "text": "... ireful clouds seemed to sink heavily toward the town. It wasn't supposed to rain here, and yet the sand beneath his feet was as soaked as any shoreline."
                            },
                            {
                                "example_id": "6fa3633e-4520-431f-8cbe-4a1560f70c23",
                                "sense_id": "43f82209-9175-30c5-8aa7-d9a8ed232b84",
                                "text": "... ireful clouds collect in stern array, / And bursting thunders speak the mighty fray;"
                            },
                            {
                                "example_id": "69d9b94f-0b52-44b7-982e-cfb82f8a34c5",
                                "sense_id": "43f82209-9175-30c5-8aa7-d9a8ed232b84",
                                "text": "... ireful crimson sky, as he gropes his broken way home after the trial."
                            },
                            {
                                "example_id": "0cc70490-f388-4d63-82fd-cd8001eeacca",
                                "sense_id": "43f82209-9175-30c5-8aa7-d9a8ed232b84",
                                "text": "... ireful clouds, as foreboding a day for starting a mission as Bennie and Sadie Mays could recall—and the weather became a nagging portent that lingered in their minds during a warm reception filled with hope and promises."
                            }
                        ]
                    }
