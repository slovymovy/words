    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71319f73-24ab-3b3e-b9c0-bc5020e5d3f7",
                    "sense_definition": "Of or relating to Rome or the ancient Roman Empire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rome_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Roman</w> legions marched across the continent.",
                            "target_lang_translations": {
                                "ru": "<w>Римские</w> легионы маршировали по континенту.",
                                "zh": "<w>罗马</w>军团横跨了整个大陆。"
                            }
                        },
                        {
                            "text": "We visited the ancient <w>Roman</w> ruins in Italy.",
                            "target_lang_translations": {
                                "ru": "Мы посетили древние <w>римские</w> руины в Италии.",
                                "zh": "我们参观了意大利的古<w>罗马</w>遗迹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Roman Empire",
                        "Roman law",
                        "Roman army",
                        "Roman history"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Риму или древней Римской империи.",
                        "zh": "指罗马或古罗马帝国的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "римский",
                                "target_lang_sense_clarification": "относящийся к Риму"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗马的",
                                "target_lang_sense_clarification": "形容词，指与罗马相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75905618-c7f7-3048-9dec-5b63f6289455",
                    "sense_definition": "Relating to the Latin alphabet or the system of numerals using letters like I, V, and X.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alphabet_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chapter numbers are written in <w>Roman</w> numerals.",
                            "target_lang_translations": {
                                "ru": "Номера глав написаны <w>римскими</w> цифрами.",
                                "zh": "章节编号是用<w>罗马</w>数字书写的。"
                            }
                        },
                        {
                            "text": "English is written using the <w>Roman</w> alphabet.",
                            "target_lang_translations": {
                                "ru": "Английский язык использует <w>латинский</w> алфавит.",
                                "zh": "英语使用<w>拉丁</w>字母书写。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Roman numerals",
                        "Roman alphabet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к латинскому алфавиту или системе цифр.",
                        "zh": "指拉丁字母或罗马数字系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "римский",
                                "target_lang_sense_clarification": "о цифрах"
                            },
                            {
                                "target_lang_word": "латинский",
                                "target_lang_sense_clarification": "об алфавите"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗马的",
                                "target_lang_sense_clarification": "指罗马数字"
                            },
                            {
                                "target_lang_word": "拉丁的",
                                "target_lang_sense_clarification": "指拉丁字母"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a35b227e-4a59-3117-8fc9-529997b6c4db",
                    "sense_definition": "Of or pertaining to the Roman Catholic Church.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was raised in the <w>Roman</w> Catholic faith.",
                            "target_lang_translations": {
                                "ru": "Он был воспитан в <w>римско</w>-католической вере.",
                                "zh": "他在<w>罗马天主教</w>信仰中长大。"
                            }
                        },
                        {
                            "text": "The <w>Roman</w> rite is used in many churches.",
                            "target_lang_translations": {
                                "ru": "<w>Римский</w> обряд используется во многих церквях.",
                                "zh": "许多教堂都使用<w>罗马</w>礼仪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Roman Catholic",
                        "Roman Catholic Church"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Римско-католической церкви.",
                        "zh": "指罗马天主教会的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "римский",
                                "target_lang_sense_clarification": "в контексте церкви"
                            },
                            {
                                "target_lang_word": "римско-католический",
                                "target_lang_sense_clarification": "полное название"
                            }
