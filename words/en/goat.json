{
    "word_family": [
        "goatee",
        "goatherd",
        "goatskin",
        "scapegoat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2761a6bd-0a28-342a-9174-2b038a9f4842",
                    "sense_definition": "A hardy domesticated hoofed mammal with backward curving horns and a beard, raised for milk, meat, and wool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a <w>goat</w> in the field to eat the grass.",
                            "target_lang_translations": {
                                "ru": "Фермер держит <w>козу</w> в поле, чтобы она ела траву.",
                                "zh": "农夫在田里养了一只<w>山羊</w>来吃草。"
                            }
                        },
                        {
                            "text": "We saw a wild <w>goat</w> climbing the steep rocks near the mountain top.",
                            "target_lang_translations": {
                                "ru": "Мы видели дикого <w>козла</w>, взбирающегося по отвесным скалам у вершины горы.",
                                "zh": "我们看到一只野生<w>山羊</w>正在攀爬山顶附近的陡峭岩石。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain goat",
                        "billy goat",
                        "nanny goat",
                        "get someone's goat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выносливое домашнее копытное млекопитающее с загнутыми назад рогами и бородой, разводимое ради молока, мяса и шерсти.",
                        "zh": "一种耐寒的家养有蹄哺乳动物，长有向后弯曲的角和胡须，主要用于产奶、产肉和产毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коза",
                                "target_lang_sense_clarification": "животное (обычно самка или вид в целом)"
                            },
                            {
                                "target_lang_word": "козёл",
                                "target_lang_sense_clarification": "самец козы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山羊",
                                "target_lang_sense_clarification": "指代该动物物种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf38e7b-a0ac-3949-b79f-4b107d1d12b5",
                    "sense_definition": "The meat of a goat used as food.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a spicy curry made with tender <w>goat</w> and potatoes.",
                            "target_lang_translations": {
                                "ru": "Они подали острое карри из нежной <w>козлятины</w> с картофелем.",
                                "zh": "他们端上了一道用鲜嫩<w>羊肉</w>和土豆做的辣味咖喱。"
                            }
                        },
                        {
                            "text": "I have never eaten <w>goat</w> before, but I heard it tastes like lamb.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не ел <w>козлятину</w>, но слышал, что она по вкусу напоминает ягнятину.",
                                "zh": "我以前从没吃过<w>羊肉</w>，但听说味道像羔羊肉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goat cheese",
                        "curry goat",
                        "goat milk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо козы, употребляемое в пищу.",
                        "zh": "作为食物的羊肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козлятина",
                                "target_lang_sense_clarification": "мясо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羊肉",
                                "target_lang_sense_clarification": "食用肉类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec20da03-0973-3ac6-b974-895a142049f9",
                    "sense_definition": "An acronym for \"Greatest of All Time\", referring to a person or thing considered the best in their field.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many basketball fans believe Michael Jordan is the <w>GOAT</w>.",
                            "target_lang_translations": {
                                "ru": "Многие баскетбольные фанаты считают, что Майкл Джордан — <w>величайший</w> игрок всех времён.",
                                "zh": "许多篮球迷认为迈克尔·乔丹是<w>史上最伟大</w>的球员。"
                            }
                        },
                        {
                            "text": "She is the <w>GOAT</w> of gymnastics because of her incredible records.",
                            "target_lang_translations": {
                                "ru": "Она — <w>величайшая</w> гимнастка в истории благодаря своим невероятным рекордам.",
                                "zh": "凭借其不可思议的纪录，她是体操界的<w>传奇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the GOAT"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often written as GOAT"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним фразы \"Greatest of All Time\" (Величайший всех времён), относящийся к человеку или явлению, считающемуся лучшим в своей области.",
                        "zh": "“史上最伟大”的缩写，指在特定领域被公认为最优秀的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величайший",
                                "target_lang_sense_clarification": "лучший в истории"
                            },
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "史上最伟大",
                                "target_lang_sense_clarification": "指代领域内的顶尖人物"
                            },
                            {
                                "target_lang_word": "传奇",
                                "target_lang_sense_clarification": "指代杰出人物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "614b8456-ca1b-34c4-892b-31378d5d8bee",
                    "sense_definition": "A person who is blamed for a failure or mistake, often unfairly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper became the <w>goat</w> after letting in the winning goal in the final minute.",
                            "target_lang_translations": {
                                "ru": "Вратарь стал <w>козлом отпущения</w> после того, как пропустил победный гол на последней минуте.",
                                "zh": "守门员在最后一分钟失球后，成了众矢之的的<w>替罪羊</w>。"
                            }
                        },
                        {
                            "text": "He did not want to be the <w>goat</w> for the project's failure, so he explained what went wrong.",
                            "target_lang_translations": {
                                "ru": "Он не хотел быть <w>козлом отпущения</w> за провал проекта, поэтому объяснил, что пошло не так.",
                                "zh": "他不想为项目的失败当<w>替罪羊</w>，所以他解释了出错的原因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scapegoat"
                    ],
                    "antonyms": [
                        "hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого обвиняют в неудаче или ошибке, часто несправедливо.",
                        "zh": "因失败或错误而受到指责的人，通常是不公正的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козёл отпущения",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替罪羊",
                                "target_lang_sense_clarification": "指代被冤枉承担责任的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42f68f6e-69de-38e5-be5f-9bc2dfa4252c",
                    "sense_definition": "A man who is lecherous or lustful.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to avoid the old <w>goat</w> who was staring at her in the bar.",
                            "target_lang_translations": {
                                "ru": "Она старалась избегать этого старого <w>козла</w>, который пялился на неё в баре.",
                                "zh": "她试图避开酒吧里那个盯着她看的<w>老色鬼</w>。"
                            }
                        },
                        {
                            "text": "He acts like a lecherous <w>goat</w> whenever he is around young women.",
                            "target_lang_translations": {
                                "ru": "Он ведёт себя как похотливый <w>козёл</w>, когда находится рядом с молодыми женщинами.",
                                "zh": "他一见到年轻女性就表现得像个好色的<w>老色鬼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lecher"
                    ],
                    "common_phrases": [
                        "old goat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, проявляющий похоть или развратное поведение.",
                        "zh": "指好色或淫荡的男人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козёл",
                                "target_lang_sense_clarification": "бранное, о похотливом мужчине"
                            },
                            {
                                "target_lang_word": "старый козёл",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老色鬼",
                                "target_lang_sense_clarification": "贬义，指好色的男人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7f6fcedd-040c-3c53-abfd-5af2cdc06192",
                    "sense_definition": "The eighth animal in the twelve-year cycle of the Chinese zodiac.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astrology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "My brother was born in the Year of the <w>Goat</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат родился в год <w>Козы</w>.",
                                "zh": "我哥哥出生于<w>羊</w>年。"
                            }
                        },
                        {
                            "text": "People born under the sign of the <w>Goat</w> are said to be creative and gentle.",
                            "target_lang_translations": {
                                "ru": "Говорят, что люди, рождённые под знаком <w>Козы</w>, творческие и мягкие.",
                                "zh": "据说属<w>羊</w>的人富有创造力且性格温和。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Year of the Goat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восьмое животное в двенадцатилетнем цикле китайского зодиака.",
                        "zh": "中国十二生肖中的第八种动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коза",
                                "target_lang_sense_clarification": "знак зодиака"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羊",
                                "target_lang_sense_clarification": "生肖属相"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8cf7e62a-ffb2-39ca-8dab-9f47324dbff7",
                    "sense_definition": "To blame someone unfairly for a failure or mistake.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach was <w>goated</w> by the media after the team lost the championship.",
                            "target_lang_translations": {
                                "ru": "СМИ <w>сделали</w> тренера <w>козлом отпущения</w> после того, как команда проиграла чемпионат.",
                                "zh": "球队输掉冠军赛后，媒体把教练当成了<w>替罪羊</w>。"
                            }
                        },
                        {
                            "text": "He felt he was being <w>goated</w> for errors that were actually caused by the management.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что из него <w>делают козла отпущения</w> за ошибки, которые на самом деле были вызваны руководством.",
                                "zh": "他觉得管理层犯的错却让他来<w>背黑锅</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scapegoat",
                        "blame"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несправедливо обвинять кого-либо в неудаче или ошибке.",
                        "zh": "不公正地将失败或错误的责任归咎于某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать козлом отпущения",
                                "target_lang_sense_clarification": "идиома"
                            },
                            {
                                "target_lang_word": "сваливать вину",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "找替罪羊",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}