                "translations": [
                    {
                        "translation_id": "8bf7111a-5097-43ed-b1cf-27752d1df695",
                        "source_entry_id": "6182c43e-d5a4-3fb1-8b78-d22f78e626a6",
                        "target_lang_word": "accommodation",
                        "target_lang_code": "en",
