                            },
                            {
                                "target_lang_word": "辣",
                                "target_lang_sense_clarification": "辣得难受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e4adb25-d8fc-39e7-bfb0-99108e379bc8",
                    "sense_definition": "Używać źródła światła; mieć włączone światło.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziadek jeszcze nie śpi, widać, że w jego pokoju <w>pali</w> się światło.",
                            "target_lang_translations": {
                                "ru": "Дедушка еще не спит, видно, что в его комнате <горит> свет.",
                                "en": "Grandpa is not asleep yet; you can see the light <is on> in his room.",
                                "zh": "爷爷还没睡，看得到他房间里的灯还<亮着>。"
                            }
                        },
                        {
                            "text": "Nie <pal> niepotrzebnie lampy, jeśli wychodzisz z pokoju.",
                            "target_lang_translations": {
                                "ru": "Не <жги> зря лампу, если выходишь из комнаты.",
                                "en": "Don't <leave> the lamp <on> unnecessarily if you're leaving the room.",
                                "zh": "要是离开房间，就别白白<开着>灯。"
                            }
                        }
