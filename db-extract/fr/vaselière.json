                        "examples": [
                            {
                                "example_id": "d3f4e63d-ffec-4874-b6ef-9e5f6a8bafbc",
                                "sense_id": "758f065e-9bd3-3a28-9196-2b64cdbd8f82",
                                "text": "Si les travaux pour le Port 2000 commencent à être visibles, les nourricières de poissons et d’invertébrés, des nitrates, des vaselières, roselières et des prairies subhalophiles sont invisibles à l’œil néophyte."
                            },
                            {
                                "example_id": "ff1804b2-103d-4132-9e20-aee61d07aaff",
                                "sense_id": "758f065e-9bd3-3a28-9196-2b64cdbd8f82",
                                "text": "Le corps bourgeonne d’une activité intense et la beauté florale renverse les catégories du monstrueux attachées d’ordinaire à la vaselière au point qu’on s’interroge sur l’état et l’identité de ce personnage énigmatique, mort ou vif, au visage si peu féminin."
                            },
                            {
                                "example_id": "eb22cc62-2fa2-4ad9-8e1b-a4e5aa526016",
                                "sense_id": "758f065e-9bd3-3a28-9196-2b64cdbd8f82",
                                "text": "[…] une portion de la vaselière (envahie par une saulaie rudérale) est maintenue et reprise en gestion afin d’en valoriser les potentialités écologiques ;"
                            }
                        ]
                    }
