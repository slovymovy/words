                    "frequency": "Middle",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>spatten</w> elkaar nat in het zwembad.",
                            "target_lang_translations": {
