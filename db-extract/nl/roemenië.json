                ],
                "translations": [
                    {
                        "translation_id": "eec6d6a9-a23c-48dc-aa4d-bd8889effe64",
                        "source_entry_id": "5a8e435e-0b33-32df-a76b-d40f0e6ad82d",
                        "source_sense_id": "1bc94bb5-24f9-3314-93cf-652c7601664c",
                        "source_sense_description": "een land in Oost-Europa ten noorden van Bulgarije",
                        "target_lang_word": "Rumänien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rumänien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                        "entry_id": "296cd59b-48ae-3f29-a901-714d6ea001ea",
                                        "glosses": [
                                            "Land in Südosteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "560d1b06-99e1-4c6a-9162-f3b62173d416",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "Die Donau fließt über 1000 Kilometer durch Rumänien."
                                            },
                                            {
                                                "example_id": "1efcd4bc-7428-4130-ba31-7aa0bbea9bcb",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "Bukarest ist die Hauptstadt von Rumänien."
                                            },
                                            {
                                                "example_id": "c17e4ab7-358f-404e-a940-5867471b37da",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "„Rumänien hat als säkulares Land keine Staatsreligion.“"
                                            },
                                            {
                                                "example_id": "b5030c26-7ed1-44af-a691-e1d27945a93d",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "„Mein erster Tag in Rumänien begann also mit einem Schrecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "576c7672-06b8-46a0-accb-e2b8e81d338a",
                        "source_entry_id": "5a8e435e-0b33-32df-a76b-d40f0e6ad82d",
                        "source_sense_id": "1bc94bb5-24f9-3314-93cf-652c7601664c",
                        "source_sense_description": "een land in Oost-Europa ten noorden van Bulgarije",
                        "target_lang_word": "Romania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b59d0362-1835-38c4-8b5b-d906973f87bc",
                                        "entry_id": "7cf623a8-0c73-3dca-95ca-f5ee6b7c1cf7",
                                        "glosses": [
                                            "A country in Southeast Europe. Capital and largest city: Bucharest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04519b28-c697-4abd-8b9a-b4148c3ee0bf",
                                                "sense_id": "b59d0362-1835-38c4-8b5b-d906973f87bc",
                                                "text": "There is strong resistance in much of Europe to fracking, the practice of forcing liquid and sand into wells to release trapped oil and gas. France has a ban on fracking, Germany has imposed a moratorium, and opposition has cropped up and sometimes delayed shale exploration in Eastern European countries like Romania and Poland."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Romania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2cb421a-fbe4-38e6-b9ae-4494a38a2041",
                                        "entry_id": "d999ff98-fc2b-3d2b-ab44-36ac8ff02fc6",
                                        "glosses": [
                                            "The Latin or Romance-speaking areas of Europe, collectively."
                                        ],
                                        "tags": [
                                            "historical",
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                        "entry_id": "d999ff98-fc2b-3d2b-ab44-36ac8ff02fc6",
                                        "glosses": [
                                            "Synonym of Byzantine Empire, also used for its former territories."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdd45fd-c0b2-4137-988e-1fb96abba93d",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "There is a significant coincidence of dates between several events: the splitting of the Paulician community in Rhomania in consequence of Séryios’s innovations; the breach between Séryios’s partisans and the East Roman Imperial Government, […]"
                                            },
                                            {
                                                "example_id": "0a96550f-106f-4439-bfb7-465f5dfb1ed9",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "The Doge of Venice was honored with his full title of dominator of one-quarter and one-eighth of the whole Empire of Romania; and he was promised repossession of all the rights and properties that his people had held in Constantinople in the years of the Latin occupation."
                                            },
                                            {
                                                "example_id": "f2c39714-858d-441d-96e6-effae5d03198",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "In this letter the basileus informed the Pope that Béla III had attacked Serbia, since he was not content with his own country, “which he acquired with difficulties and with the help of the armies and the money of Rhomania [i.e. Byzantium]”."
                                            },
                                            {
                                                "example_id": "c5b242f2-bdbb-4383-9356-22ca2de7754e",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "The Fourth Crusade ended in 1204 with the Western or Latin conquest of Constantinople and signalled the beginning of a new era in the history of the Byzantine lands or Romania."
                                            },
                                            {
                                                "example_id": "bebb00b3-665f-4ba6-ada3-0dcb9a0a9c34",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "If the Constantinopolitan Byzantines regarded the Anatolian Turkic territories as lands temporarily lost from their indivisible universal Rhomania, the Turkoman rulers of the twelfth century considered Rhomania as being factually divided between several rulers."
                                            },
                                            {
                                                "example_id": "9947b3e8-5751-4a03-a012-35fed8ab6325",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "The dramatic fall of Constantinople in 1204 and the Latin conquest of the Empire’s provinces in the following decade resulted in the dismemberment of Romania."
                                            },
                                            {
                                                "example_id": "45a36f9b-519a-4fda-9c76-688c390406a5",
                                                "sense_id": "2df14aa0-3227-3d31-9bf5-7eb8c0b83640",
                                                "text": "Next to them, the maritime region extending south to the Hellespont is Romania—a Greek nation, though it was once barbarian, and it is returning to barbarism in our own time, now that the empire of the Greeks has been destroyed and the Turks hold sway. The capital city of this country [Thrace] is Byzantium, formerly called Agios."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Romania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b779407c-e287-3935-9779-2e2ebbabf221",
                                        "entry_id": "367bfab1-9ed9-3260-8b4e-cb385250d0ee",
                                        "glosses": [
                                            "Obsolete form of Romagna."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b299f0a6-24ae-498a-9a3c-8ec9dde539ee",
                                                "sense_id": "b779407c-e287-3935-9779-2e2ebbabf221",
                                                "text": "In the end of Ianuarie, Borbon passed the Po with all his troupes, and directed his iourney towards Romania: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8018c74f-80ce-423a-985c-3be7db72f6ad",
                        "source_entry_id": "5a8e435e-0b33-32df-a76b-d40f0e6ad82d",
                        "source_sense_id": "1bc94bb5-24f9-3314-93cf-652c7601664c",
                        "source_sense_description": "een land in Oost-Europa ten noorden van Bulgarije",
                        "target_lang_word": "Roumanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roumanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45150ead-e7b3-37fc-b8ec-387995bcf9b5",
                                        "entry_id": "74717df3-2cf7-3936-afa6-21c73a2a7d6e",
                                        "glosses": [
                                            "Pays de l’Europe orientale, bordé par la Hongrie, l’Ukraine, la Moldavie, la Bulgarie, la Serbie et la mer Noire, et dont la capitale est Bucarest."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a3975f-690b-4072-8e07-bf4308f1bb8f",
                                                "sense_id": "45150ead-e7b3-37fc-b8ec-387995bcf9b5",
                                                "text": "Il faut dire que le fabricant a fait très tôt le choix de la délocalisation, […]. 45 % des tissus des collections du groupe sont tricotés et découpés en France, la confection étant sous-traitée au Maghreb, en Roumanie ou en Asie."
                                            },
                                            {
                                                "example_id": "36a1f254-55a8-40de-ae97-e5315ce286dc",
                                                "sense_id": "45150ead-e7b3-37fc-b8ec-387995bcf9b5",
                                                "text": "La nouvelle Roumanie, surnommée la Grande Roumanie, fut créée en plusieurs étapes : le 27 mars/7 avril 1918 les représentants politiques de la Bessarabie votèrent l’union de cette province avec la Roumanie ; le 18/28 novembre 1918 les représentants politiques de la Bucovine décidèrent aussi l’union avec la Roumanie ; enfin, le 1ᵉʳ décembre 1918, les délégués des Roumains votèrent à Alba Iulia l’union de la Transylvanie avec la Roumanie."
                                            },
                                            {
                                                "example_id": "072a1acd-612a-446d-84ec-35722fba263b",
                                                "sense_id": "45150ead-e7b3-37fc-b8ec-387995bcf9b5",
                                                "text": "En plus, la Roumanie a souffert d’être tiraillée entre la tentation du repli sur les sources lointaines (les Daces? les Romains?) et celle de l’ouverture vers l’Europe de l’Ouest, mais aussi entre le slavisme et la latinité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
