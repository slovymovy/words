                ],
                "senses": [
                    {
                        "sense_id": "99f43cc1-aa24-3e37-b5b3-1bd6884bd4b5",
                        "entry_id": "e5b32aa9-9dbb-36db-b020-fade5fc40eee",
                        "glosses": [
                            "Raconter une troisième fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce14e17c-bfde-4150-9477-1b0395415f6e",
                                "sense_id": "99f43cc1-aa24-3e37-b5b3-1bd6884bd4b5",
                                "text": "Comme Margaret Atwood, je pense qu'il est en effet important que les mythes puissent savoir se re-re-raconter sans interruption."
                            },
                            {
                                "example_id": "be2a248f-7f02-4019-96f7-45fe5f1ad7b2",
                                "sense_id": "99f43cc1-aa24-3e37-b5b3-1bd6884bd4b5",
                                "text": "Vais-je re-re-raconter la brèche dans les mœurs asilaires de l'H.P. d'Armentières en 1940, moi retour de guerre, mais la guerre y étant toujours, là."
                            },
                            {
                                "example_id": "db512376-f8a6-46ad-a7a9-2e3e8eb37737",
                                "sense_id": "99f43cc1-aa24-3e37-b5b3-1bd6884bd4b5",
                                "text": "Bref je ne vous re-re-raconte pas l'histoire."
                            },
                            {
                                "example_id": "9c5b818a-742b-43e7-b781-f938d36e5c1b",
                                "sense_id": "99f43cc1-aa24-3e37-b5b3-1bd6884bd4b5",
                                "text": "Après quoi les huiles arrivèrent et nous re-racontâmes notre histoire devant des sténographes et des magnétophones. Et puis de plus grosses huiles arrivèrent : nous sortîmes nos papiers d’identité et nous re-re-racontâmes notre histoire."
                            }
                        ]
                    }
                ],
