                                        "sense_id": "a395f798-5c5b-3278-a311-a2b65b60da8a",
                                        "entry_id": "45b3a335-fdc3-3f32-a733-da1ee96d6899",
                                        "glosses": [
                                            "Either of the arms of a pair of spectacles, running from the side of the lens to behind the wearer's ear."
                                        ],
                                        "tags": [],
