            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad1bdc3a-bfa2-38d1-862a-69fd01d0a303",
                    "sense_definition": "Qui est plongé dans une obscurité profonde, très sombre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obscurite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La silhouette disparut rapidement dans les recoins les plus <w>ténébreux</w> de la forêt."
                        },
                        {
                            "text": "La nuit était si <w>ténébreuse</w> qu'on ne distinguait aucun repère le long du sentier."
                        }
                    ],
                    "synonyms": [
                        "obscur",
                        "sombre"
                    ],
                    "antonyms": [
                        "clair",
                        "lumineux"
                    ],
                    "common_phrases": [
                        "nuit ténébreuse",
                        "bois ténébreux"
                    ]
                },
                {
                    "sense_id": "c7b1f610-2ec5-33d4-850d-f044de95d61b",
                    "sense_definition": "Difficile à percer ou à comprendre, mystérieux et inquiétant.",
