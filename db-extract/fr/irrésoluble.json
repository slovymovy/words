                                        "glosses": [
                                            "That cannot be solved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38891c39-1236-4df7-8438-693219306ab1",
                                                "sense_id": "9b5624b1-ad19-34ea-a0a2-17aa53396825",
                                                "text": "The reason Fisher concluded that the problem is likely insoluble is that the ability of real-world agents to act on new perceived opportunities of arbitrage – including those that turn out to be incorrect – makes stability impossible to demonstrate without additional strong (and unrealistic) assumptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df5d2185-8519-35d9-93e3-a3f82353ba48",
