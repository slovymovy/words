                "forms": [],
                "senses": [
                    {
                        "sense_id": "db735365-3faf-3ade-828b-53251f5b33f3",
                        "entry_id": "00f372e9-9049-3580-949e-177c81a743c3",
                        "glosses": [
                            "een water gebruiken om er vis te vangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a1d882c-66b8-4218-9e89-5b0204fb272f",
                                "sense_id": "db735365-3faf-3ade-828b-53251f5b33f3",
                                "text": "'De slag om de Jacobsschelpen' tussen de Franse en Engelse vissers is al lange tijd aan de gang. De Franse vissers mogen die dure delicatesse maar een beperkt aantal maanden bevissen, tussen 1 oktober en 15 mei."
                            },
                            {
                                "example_id": "87deb7c3-2f5e-4bee-b595-da92f2aca860",
                                "sense_id": "db735365-3faf-3ade-828b-53251f5b33f3",
                                "text": "De milieuorganisatie wil voorkomen dat het schip kwetsbare visgronden gaat bevissen. De activisten probeerden eerst te verhinderen dat een loods aan boord ging van de vistrawler. Toen dat mislukte, gingen ze voor het schip liggen."
                            }
                        ]
                    }
