                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b09590-ee07-4a9e-9424-da4535d314b5",
                                                "sense_id": "c7089ba2-7fa5-3778-9f83-64f30ed73ba2",
                                                "text": "Zu unserem Spieleabend werden diesmal nicht wieder die Drecksäcke aus dem achten Stock eingeladen."
                                            },
                                            {
                                                "example_id": "c9cfa5ff-f3bd-413d-948a-bec8b9336507",
                                                "sense_id": "c7089ba2-7fa5-3778-9f83-64f30ed73ba2",
                                                "text": "Dieser Drecksack von nebenan hat Rattengift ausgelegt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed1a4d76-5da8-3f0c-9826-21670fe982b3",
                                        "entry_id": "d994463e-c881-33cb-b4f2-fc9093e2f893",
                                        "glosses": [
                                            "der menschliche Leib"
                                        ],
