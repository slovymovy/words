                        "entry_id": "26f888da-5e13-3ea8-b4c0-f2d278eceb4e",
                        "glosses": [
                            "hoch wachsendes, zu den Lolchen gehörendes Süßgras, dessen Früchte giftig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749d6ece-b675-4600-a16a-8b23d780fcd2",
                                "sense_id": "bcf8bc25-10f4-3d8c-8537-f7b91490a5f7",
                                "text": "„Ich verbiete es euch, weil es eine Scheuer voll Unkraut, eine Scheuer voll Tollkraut, eine Scheuer voll Taumellolch mit nur wenigen Ähren guten Weizens ist.“"
                            },
                            {
                                "example_id": "f0a6298a-0f49-437d-bd81-aed263402c73",
                                "sense_id": "bcf8bc25-10f4-3d8c-8537-f7b91490a5f7",
                                "text": "Die Samen des Taumellolchs verursachen durch einen alkaloidhaltigen Pilz Mehlvergiftungen."
                            }
                        ],
