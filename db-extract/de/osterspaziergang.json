                "senses": [
                    {
                        "sense_id": "e3d4056d-a93e-3a47-8ea4-4abff06e1645",
                        "entry_id": "27bd47c3-7c93-3a3b-bb91-07b710a0db6c",
                        "glosses": [
                            "geruhsamer Gang im Freien zur Erholung, kleine Wanderung an den Osterfeiertagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb154879-d138-4b26-91ac-788fdcf5150a",
                                "sense_id": "e3d4056d-a93e-3a47-8ea4-4abff06e1645",
                                "text": "„Weit verbreitet ist auch der Osterspaziergang ins Grüne, dem Johann Wolfgang von Goethe im ersten Teil seines Dramas ‚Faust‘ ein Denkmal setzte.“"
                            },
                            {
                                "example_id": "3d27fc0d-c85b-40a6-8473-aed18fc8047e",
                                "sense_id": "e3d4056d-a93e-3a47-8ea4-4abff06e1645",
                                "text": "„Die warme Jacke sollte beim Osterspaziergang nicht fehlen: Für die Feiertage ist klassisches Aprilwetter angekündigt.“"
                            },
                            {
                                "example_id": "aa037080-55c3-4ff5-ae6d-255744e1a95e",
                                "sense_id": "e3d4056d-a93e-3a47-8ea4-4abff06e1645",
                                "text": "„Neben Eiersuchen, Osterspaziergängen und sonstigem Freizeitvergnügen war am Wochenende ein Besuch im Biergarten fast Pflicht. Noch am Abend luden frühsommerliche Temperaturen in München zum Verweilen im Freien ein.“"
                            },
                            {
                                "example_id": "aaacf5f4-8811-48e3-b959-559a45d0cb60",
                                "sense_id": "e3d4056d-a93e-3a47-8ea4-4abff06e1645",
                                "text": "„Vorsicht beim Osterspaziergang an der Alster: Nicht jedes Ei auf der Wiese ist aus Schokolade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
