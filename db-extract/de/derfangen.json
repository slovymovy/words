                "senses": [
                    {
                        "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                        "entry_id": "365d5cce-1e5c-34b8-b9f3-471a39c37ed1",
                        "glosses": [
                            "sich fangen, sich erholen, sich beruhigen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "3fd48b72-2ead-4aff-ba55-5106971bdace",
                                "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                                "text": "„»Des net. Oba wissen tat i holt gern, ob sie sich derfangt hat.« Die Schwester sah in die offene Tür hinter sich und schloß sie dann vorsichtig. »Naa«, sagte sie leise, »die derfangt sich net mehr.«“"
                            },
                            {
                                "example_id": "c131080b-ce1c-4faa-a48c-e55818029c79",
                                "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                                "text": "„Doch 's Everl, die hat sie glei wieder dafangt.“"
                            },
                            {
                                "example_id": "e75f3a5f-a15f-46f1-92db-f57263010d1c",
                                "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                                "text": "„Der Joche kann sich kaum derfanga, so is der Schuß nach hint losganga.“"
                            },
                            {
                                "example_id": "6b5430af-ec5a-42a7-9da8-08b9539b9ade",
                                "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                                "text": "„Aber wir haben uns Gott sei Dank gleich wieder derfangen, wie man in Bayern sagt.“"
                            },
                            {
                                "example_id": "1b4b544e-c70a-4d76-bc4e-ae7df169fec2",
                                "sense_id": "5791fb78-24ee-3c94-b6a7-6f7808dfe71a",
                                "text": "„Na — im letzten Moment hab’ ich mich noch derfangen, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
