                                    {
                                        "sense_id": "7e88ce1f-bf3a-3457-833f-4b580d6d21e1",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "The act of converting power into motion, by turning a crankshaft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4afac536-63bf-44e1-8745-0eb660fc9fa7",
                                                "sense_id": "7e88ce1f-bf3a-3457-833f-4b580d6d21e1",
                                                "text": "Yes, a crank was all it needed to start."
                                            },
                                            {
                                                "example_id": "d73263c3-4086-4f5b-ab18-feba913e37b2",
                                                "sense_id": "7e88ce1f-bf3a-3457-833f-4b580d6d21e1",
                                                "text": "Give it a forceful crank."
                                            },
                                            {
                                                "example_id": "f688a6b9-d623-463f-b156-7d388417b4ab",
                                                "sense_id": "7e88ce1f-bf3a-3457-833f-4b580d6d21e1",
                                                "text": "By comparision, consider the conductor of a double-decked Blackpool tram on August Monday, who hurries up and down stairs to a hundred or more passengers and serves each one by a simple crank of a handle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81a1742-d7d6-3d23-8718-89f5073d41ff",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "Any bend, turn, or winding, as of a passage."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8f4ff5-f702-4767-a45e-8cfd5ce36877",
                                                "sense_id": "b81a1742-d7d6-3d23-8718-89f5073d41ff",
                                                "text": "So many turning cranks these have, so many crooks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54932ac-91fc-3705-b987-6eb7c3867e57",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "Synonym of methamphetamine."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680d3f7b-6dfe-4fb7-a692-fa0ae2c2c1a4",
                                                "sense_id": "d54932ac-91fc-3705-b987-6eb7c3867e57",
                                                "text": "Danny got abscesses from shooting all that bathtub crank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05794b5e-ce8e-310a-84ef-857d8fadf3f8",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "A twist or turn in speech; word play consisting in a change of the form or meaning of a word."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4340522e-c98e-4c3c-abf6-af00506257b1",
                                                "sense_id": "05794b5e-ce8e-310a-84ef-857d8fadf3f8",
                                                "text": "Quips and Cranks, and wanton Wiles,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa07200-955e-33bc-97ea-883f0d3ec8c7",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b83be20-f0c1-4b91-97ec-9d41da4aeb55",
                                                "sense_id": "0fa07200-955e-33bc-97ea-883f0d3ec8c7",
                                                "text": "It was going to be hard not to blow with a girl like her sucking on his crank."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63df0f47-eafd-3349-a043-232393262b13",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To turn by means of a crank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff80639-800d-4bc7-8913-b9b66e6ede67",
                                                "sense_id": "63df0f47-eafd-3349-a043-232393262b13",
                                                "text": "Motorists had to crank their engine by hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c15dc66b-156e-32cb-98df-a5704b800f1c",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To turn a crank."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5224bc54-a622-4450-99e2-8bddfdff217d",
                                                "sense_id": "c15dc66b-156e-32cb-98df-a5704b800f1c",
                                                "text": "He's been cranking all day and yet it refuses to crank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff6caf3-5738-34fc-888b-c3ef10dbc2ea",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To turn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd78ec57-0294-4def-9887-abf45757220b",
                                                "sense_id": "7ff6caf3-5738-34fc-888b-c3ef10dbc2ea",
                                                "text": "He's been cranking all day and yet it refuses to crank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "863d0737-5a42-3f5e-a3fd-ddd99482454b",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To cause to spin via other means, as though turned by a crank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b20584-dfbc-42c5-b5b3-22bccba9f2f8",
                                                "sense_id": "863d0737-5a42-3f5e-a3fd-ddd99482454b",
                                                "text": "I turn the key and crank the engine; yet it doesn't turn over"
                                            },
                                            {
                                                "example_id": "e5d15e9c-d14f-488a-90ad-8e36ebd47efe",
                                                "sense_id": "863d0737-5a42-3f5e-a3fd-ddd99482454b",
                                                "text": "Crank it up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e11e24-915f-3dc4-87b5-c3c5c596193f",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To act in a cranky manner; to behave unreasonably and irritably, especially through complaining."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef7ccbd-f946-49fe-b4bc-37a5f9632352",
                                                "sense_id": "61e11e24-915f-3dc4-87b5-c3c5c596193f",
                                                "text": "Quit cranking about your spilt milk!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5919f34-5271-3c85-aa8c-05bd3a7cf458",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To be running at a high level of output or effort."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f000be5d-60a4-4ade-b1c9-fbba70c0c745",
                                                "sense_id": "c5919f34-5271-3c85-aa8c-05bd3a7cf458",
                                                "text": "By one hour into the shift, the boys were really cranking."
                                            },
                                            {
                                                "example_id": "de504174-d328-4cbd-8e85-8fc152595ebf",
                                                "sense_id": "c5919f34-5271-3c85-aa8c-05bd3a7cf458",
                                                "text": "Better computers use variable speed fans so they run at top speed only when the computer is really cranking"
                                            },
                                            {
                                                "example_id": "fea6e742-d878-4f5c-93ed-fa0a4b8deb3d",
                                                "sense_id": "c5919f34-5271-3c85-aa8c-05bd3a7cf458",
                                                "text": "When we were playing at the top of our ability and really cranking, the whole thing could sound like a jet plane taking off in the club."
                                            },
                                            {
                                                "example_id": "7d4794df-13c8-4db0-bb51-9a14bc039390",
                                                "sense_id": "c5919f34-5271-3c85-aa8c-05bd3a7cf458",
                                                "text": "expected that the NVA and VC were in a position to dish out what they're dishing out, and the rumor mill is really cranking overtime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d826ae-1661-3c05-9b46-8b0bd3d29f62",
                                        "entry_id": "97a33b8a-ec36-37bc-8d90-d4a207d83626",
                                        "glosses": [
                                            "To run with a winding course; to double; to crook; to wind and turn."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9697b821-bb67-4d43-8247-29ce2a4936f0",
                                                "sense_id": "38d826ae-1661-3c05-9b46-8b0bd3d29f62",
                                                "text": "See how this river comes me cranking in."
                                            }
                                        ]
                                    }
