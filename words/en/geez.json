{
    "word_family": [
        "geezer"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fd9bb623-cb79-3907-ab02-702d168fa720",
                    "sense_definition": "Used to express mild surprise, frustration, annoyance, or disbelief.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Geez</w>, that was one heck of a difficult week.",
                            "target_lang_translations": {
                                "es": "<w>Caramba</w>, esa fue una semana sumamente difícil."
                            }
                        },
                        {
                            "text": "Oh <w>geez</w>, I completely forgot to lock the front door.",
                            "target_lang_translations": {
                                "es": "Ay, <w>cielos</w>, olvidé por completo cerrar con llave la puerta principal."
                            }
                        }
                    ],
                    "synonyms": [
                        "gee",
                        "gosh",
                        "sheesh",
                        "cripes"
                    ],
                    "common_phrases": [
                        "oh geez",
                        "geez Louise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an informal minced oath"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Expresión utilizada para manifestar sorpresa moderada, frustración, molestia o incredulidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "¡caramba!",
                                "target_lang_sense_clarification": "expresión de sorpresa o disgusto leve"
                            },
                            {
                                "target_lang_word": "¡ostras!",
                                "target_lang_sense_clarification": "coloquial, común en España"
                            },
                            {
                                "target_lang_word": "¡cielos!",
                                "target_lang_sense_clarification": "expresión suave de sorpresa o asombro"
                            },
                            {
                                "target_lang_word": "¡Jesús!",
                                "target_lang_sense_clarification": "exclamación ante un sobresalto o frustración"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "414ce359-7557-3233-890f-d2a62252ffb9",
                    "sense_definition": "A familiar or informal term of address for a man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hi <w>geez</w>, are you alright today?",
                            "target_lang_translations": {
                                "es": "Hola, <w>tío</w>, ¿estás bien hoy?"
                            }
                        },
                        {
                            "text": "Listen here, <w>geez</w>, you cannot park your car there.",
                            "target_lang_translations": {
                                "es": "Oye, <w>amigo</w>, no puedes estacionar tu coche allí."
                            }
                        }
                    ],
                    "synonyms": [
                        "buddy",
                        "dude",
                        "mate",
                        "pal"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal address"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tratamiento informal o coloquial para dirigirse a un hombre."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tío",
                                "target_lang_sense_clarification": "coloquial, España"
                            },
                            {
                                "target_lang_word": "amigo",
                                "target_lang_sense_clarification": "tratamiento familiar común"
                            },
                            {
                                "target_lang_word": "tipo",
                                "target_lang_sense_clarification": "tratamiento informal hacia un desconocido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d7d7fc2a-71bf-3947-9a9b-f21d7b38f79d",
                    "sense_definition": "Alternative form of <w>Ge'ez</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Ancient religious manuscripts in Ethiopia were frequently written in classical <w>Geez</w>.",
                            "target_lang_translations": {
                                "es": "Los antiguos manuscritos religiosos en Etiopía se escribían frecuentemente en <w>ge'ez</w> clásico."
                            }
                        },
                        {
                            "text": "He spent years studying liturgical texts composed in the <w>Geez</w> language.",
                            "target_lang_translations": {
                                "es": "Pasó años estudiando textos litúrgicos compuestos en la lengua <w>gueez</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Lengua semítica clásica de Etiopía y Eritrea (forma alternativa de gueez / ge'ez)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ge'ez",
                                "target_lang_sense_clarification": "lengua clásica etíope"
                            },
                            {
                                "target_lang_word": "gueez",
                                "target_lang_sense_clarification": "variante ortográfica en español"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}