                    {
                        "form_id": "f97ac4c7-ab23-4c45-9d1f-b572d6855fc3",
                        "entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Todeslager"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                        "entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "glosses": [
                            "Lager, dessen Insassen in großer Zahl umkommen/getötet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d07a1fe-d642-4691-80c3-d0400afcfb84",
                                "sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                                "text": "„Es ist bekannt, daß Laubwalde kein Arbeitslager, sondern ein Todeslager war.“"
                            },
                            {
                                "example_id": "59e2fabc-003c-48c7-bc2f-794fbd41a692",
                                "sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                                "text": "„Für diejenigen Juden, die Krieg, Verfolgungen und Todeslager überlebt hatten, blieb die Situation auch nach der Befreiung katastrophal.“"
                            },
                            {
                                "example_id": "2cb34034-e72c-417a-87fc-65066ef9ede6",
                                "sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                                "text": "„Hirsch war außer sich darüber, daß die Juden von den Deutschen gefangen wurden wie Kaninchen und daß sie sich zu so vielen Tausenden ohne Widerstand in die überfüllten Viehwagen stopfen ließen, die zu den Todeslagern fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "992ac730-f4b0-410f-8067-1b20bbc26268",
                        "source_entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "source_sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                        "source_sense_description": "Lager, dessen Insassen in großer Zahl umkommen/getötet werden",
                        "target_lang_word": "death camp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2439576c-bc66-3821-8498-ac889368ed80",
                                        "entry_id": "6f0d6868-954b-3884-bf06-cbd17f3eaab1",
                                        "glosses": [
                                            "A prison camp in which a large number of prisoners die for various reasons, such as starvation, disease, brutality, and neglect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadd2fd6-fb6f-43e3-b50d-3ffd8aeb4ad3",
                                                "sense_id": "2439576c-bc66-3821-8498-ac889368ed80",
                                                "text": "Included in this figure, since the fall of South Vietnam in 1975, are over 250,000 boat people and 250,000 other civilians who were either ruthlessly murdered outright or who perished in communist death camps set up to \"re-educate\" non-communists."
                                            },
                                            {
                                                "example_id": "b5af1e49-27fd-46d7-a02c-99b5e8758e2f",
                                                "sense_id": "2439576c-bc66-3821-8498-ac889368ed80",
                                                "text": "Three years after Stalin's death, with ghostly figures returning to Moscow and Leningrad from Stalin's death camps, the leaders in the Kremlin agreed that Stalin's ghost had to be laid to rest if they were to get on with the reforms that would allow them to stay in power."
                                            },
                                            {
                                                "example_id": "31b399e0-b407-4d7a-a3b6-286c46e3c717",
                                                "sense_id": "2439576c-bc66-3821-8498-ac889368ed80",
                                                "text": "In America's death camps, 1,500,000 babies annually are put to death in their mother's womb. The war being waged on the womb front killed more children than soldiers in the history of warfare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e34d22-b5a8-30e8-9b3a-db42c0dc1210",
                                        "entry_id": "6f0d6868-954b-3884-bf06-cbd17f3eaab1",
                                        "glosses": [
                                            "A concentration camp built during the Holocaust by the Nazis to kill especially the Jewish people through gassing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4277e02-37fd-42db-8fc4-34f679a255e7",
                        "source_entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "source_sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                        "source_sense_description": "Lager, dessen Insassen in großer Zahl umkommen/getötet werden",
                        "target_lang_word": "camp de la mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camp de la mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f89d39-7fc6-3bda-a579-9e811ba6d217",
                                        "entry_id": "93feedca-8d44-3db9-8eed-5f46aa8ab47d",
                                        "glosses": [
                                            "Surnom donné aux camps de concentration et aux camps d'extermination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0863358-f31f-4e18-a737-d23cb3cb06e7",
                                                "sense_id": "a7f89d39-7fc6-3bda-a579-9e811ba6d217",
                                                "text": "Dans le secret du laboratoire, testant sur de petits animaux martyrs ses cocktails de chlore, le cruel employé du gaz — et, à l’horizon de ses recherches, les futurs camps de la mort — n’ignorait pas qu’il enfreignait les conventions de La Haye par lesquelles les pays habitués à en découdre étaient convenus, afin d’en réduire les coûts, de livrer la guerre suivante à la régulière, selon la mystique chevaleresque et la science du duel, version planétaire du Combat des Trente où l’on s’entretuerait sur le pré de trois départements, sans débord du périmètre de lice ni dommage pour la multitude des vilains que n’ont jamais concerné ces joutes princières."
                                            },
                                            {
                                                "example_id": "4285b4b0-08f4-4b46-9f4c-4d971f99e34e",
                                                "sense_id": "a7f89d39-7fc6-3bda-a579-9e811ba6d217",
                                                "text": "Dans son livre, le réalisateur a réuni les quelque 80 photographies qui nous sont parvenues, prises par des déportés dans les camps de la mort."
                                            },
                                            {
                                                "example_id": "82771bc0-8025-4b52-be77-76589e278126",
                                                "sense_id": "a7f89d39-7fc6-3bda-a579-9e811ba6d217",
                                                "text": "Ma grand-mère, seule survivante après la guerre, n’est plus jamais entrée dans une synagogue. Dieu était mort dans les camps de la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4152228-2da6-4501-a1b6-3cf5fedf4112",
                        "source_entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "source_sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                        "source_sense_description": "Lager, dessen Insassen in großer Zahl umkommen/getötet werden",
                        "target_lang_word": "centre de mise à mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centre de mise à mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3547a4a5-cd70-3dc8-94c0-1967a6cfc5c4",
                                        "entry_id": "12c08c87-602f-3644-9f02-78eb708743fa",
                                        "glosses": [
                                            "Lieu d’extermination de masse mis en place par les nazis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99a4726f-9b93-4c2a-8d7b-9a819b25ae4a",
                                                "sense_id": "3547a4a5-cd70-3dc8-94c0-1967a6cfc5c4",
                                                "text": "Cependant, le terme de « camp d’extermination » fut remis en cause dès 1961 dans La Destruction des Juifs d’Europe, ouvrage majeur et faisant toujours référence, de Raul Hilberg. L’auteur préfère la mention de « centre de mise à mort ». Le « camp d’extermination » en lui-même pose problème. Le « camp » suppose que l’on « campe »."
                                            },
                                            {
                                                "example_id": "ee0a8e6c-e620-4350-bb34-57bf3d55c782",
                                                "sense_id": "3547a4a5-cd70-3dc8-94c0-1967a6cfc5c4",
                                                "text": "Le premier centre de mise à mort fut le camp d’extermination de Chelmno (Kulmhof), en Pologne, où furent menées les premières expériences d’assassinat au gaz. Chelmno commença à liquider des convois entiers de déportés à partir de novembre 1941."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474a5c5e-ca05-4c44-8a4b-114f3325556d",
                        "source_entry_id": "0f47485e-eed7-39cf-a4d6-04c5468f7886",
                        "source_sense_id": "9a1e1fd6-633c-3c1c-9524-373461714ece",
                        "source_sense_description": "Lager, dessen Insassen in großer Zahl umkommen/getötet werden",
                        "target_lang_word": "vernietigingskamp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernietigingskamp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a4775ee-2280-3c63-8ec3-eadb8f74ff5a",
                                        "entry_id": "7e4c858f-8de8-3e95-a44d-51032f195c79",
                                        "glosses": [
                                            "concentratiekamp in de Tweede Wereldoorlog, waar mensen stelselmatig vermoord werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6606e62c-d43d-44ac-b82d-b0e4a73de0f4",
                                                "sense_id": "5a4775ee-2280-3c63-8ec3-eadb8f74ff5a",
                                                "text": "De meerderheid van de zes miljoen vermoorde joden is niet in concentratiekampen omgekomen, maar in greppels doodgeschoten, in bossen geëxecuteerd en in de vernietigingskampen vermoord."
                                            },
                                            {
