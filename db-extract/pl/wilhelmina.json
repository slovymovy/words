                                                "sense_id": "461c220a-4441-3882-91bc-5a0ccf592f23",
                                                "text": "Guillemette de la Borie est l’auteure d’une quinzaine de romans périgourdins."
                                            }
                                        ]
                                    }
                                ]
                            }
