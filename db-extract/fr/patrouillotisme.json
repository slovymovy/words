                        "glosses": [
                            "Manie de faire des patrouilles armées par patriotisme exacerbé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9c4521-f1a4-47ce-a5cb-ac0b9eae7def",
                                "sense_id": "e1b11350-683d-3429-86ac-abcaf582c187",
                                "text": "C’est épatant comme ça a du chien, les notaires, les vitriers, les percepteurs, les menuisiers, et tous les ventres, qui, chassepot au cœur, font du patrouillotisme aux portes de Mézières ; ma patrie se lève !"
                            },
                            {
                                "example_id": "8807c0db-a64e-444d-b05c-a9bf998073df",
                                "sense_id": "e1b11350-683d-3429-86ac-abcaf582c187",
                                "text": "Dès ce moment, ce ne fut plus, pour le Philipotin, que rêves d'ordre public, crispations de revues, de gardes, d'exercices, d'arrestations et de patrouillotisme."
                            },
                            {
                                "example_id": "63ea7e86-5fdb-4a40-a36f-67d53e7d5217",
                                "sense_id": "e1b11350-683d-3429-86ac-abcaf582c187",
                                "text": "Le patrouillotisme chassant le patriotisme. Impitoyables patrouilles, longues harangues raffinées et de rares pains mal cuits, plus semblables à des briques cuites et produisant un effet sur les intestins !"
                            }
                        ]
                    }
