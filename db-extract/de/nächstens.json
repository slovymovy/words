                                        "sense_id": "d6620499-2825-37b7-a50c-040b893d4070",
                                        "entry_id": "620ce649-f514-308a-bda6-f5084e8c5065",
                                        "glosses": [
                                            "Bientôt ; dans un temps fort peu éloigné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10deedb6-c7ad-45b5-adf6-3ff306dc5aaf",
                                                "sense_id": "d6620499-2825-37b7-a50c-040b893d4070",
                                                "text": "Un mémoire que je publierai prochainement ne laissera plus, je l'espère, aucune incertitude dans l'esprit de tous les archéologues de bonne foi."
                                            },
                                            {
                                                "example_id": "1a88f730-19d6-4d34-9733-8ea5301072d3",
                                                "sense_id": "d6620499-2825-37b7-a50c-040b893d4070",
                                                "text": "Un brise-glace avait délivré le bateau qui devait repartir prochainement."
                                            }
                                        ]
                                    }
                                ]
                            }
