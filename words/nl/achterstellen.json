    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69bc9591-6e2e-3239-bc12-8e85149e2dec",
                    "sense_definition": "Iets of iemand minder gunstig behandelen dan anderen, of te laag waarderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die organisatie mag men werknemers niet op basis van hun afkomst <w>achterstellen</w>.",
                            "target_lang_translations": {
                                "en": "In that organization, employees must not be <w>discriminated against</w> on the basis of their origin."
                            }
                        },
                        {
                            "text": "Hij heeft geen schijn van kans, zij zullen hem altijd <w>achterstellen</w>.",
                            "target_lang_translations": {
                                "en": "He doesn't stand a ghost of a chance; they will always <w>subordinate</w> him."
                            }
                        }
                    ],
                    "synonyms": [
                        "benadelen",
                        "discrimineren",
                        "onderwaarderen"
                    ],
                    "antonyms": [
                        "bevoordelen",
                        "overwaarderen",
                        "privilegiëren",
                        "voortrekken"
                    ],
                    "common_phrases": [
                        "iemand achterstellen",
                        "groepen achterstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat someone or something less favorably than others, or to value them too lowly; to discriminate against or subordinate."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "discriminate against",
                                "target_lang_sense_clarification": "to treat unfavorably based on identity or origin"
                            },
                            {
                                "target_lang_word": "subordinate",
                                "target_lang_sense_clarification": "to treat as of less value or importance"
                            },
                            {
                                "target_lang_word": "neglect",
                                "target_lang_sense_clarification": "to slight or treat with lack of attention"
                            },
                            {
                                "target_lang_word": "disadvantage",
                                "target_lang_sense_clarification": "to place in an unfavorable position"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd43d219-87ec-3b79-b171-43e459922f96",
