                "senses": [
                    {
                        "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                        "entry_id": "6ce910fd-0574-353b-ae9a-39a40a1f7281",
                        "glosses": [
                            "Vorgang, Maßnahme, etwas in eine bestimmte, geeignete, Regeln folgende Form (Struktur) zu bringen; Zustand oder Vorhandensein hiervon"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "0ce53b89-e9c8-4912-b790-fa58da73347d",
                                "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                                "text": "„Für die Strukturierung von Vorträgen gibt es verschiedene Ansätze.“"
                            },
                            {
                                "example_id": "00ebe054-3b64-4c25-b4c4-4633f930728a",
                                "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                                "text": "„Die betriebswirtschaftliche Entscheidungstheorie stellt ein wichtiges Instrumentarium zur Strukturierung und Lösung von Entscheidungsproblemen zur Verfügung.“"
                            },
                            {
                                "example_id": "596a911f-28df-4341-a382-9eb22496d160",
                                "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                                "text": "„Insbesondere für den naturwissenschaftlichen Unterricht ist eine transparente und sinnvolle Strukturierung von Bedeutung.“"
                            },
                            {
                                "example_id": "303b1cc4-e81b-40a1-97b3-a8e0f000b966",
                                "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                                "text": "„Wie in Kapitel 2 dargelegt, liegen für die beiden Unterrichtsqualitätsmerkmale Strukturierung und Differenzierung bereits einige Untersuchungen vor.“"
                            },
                            {
                                "example_id": "51c5cfea-e87f-493b-948a-d9dcee8b6a42",
                                "sense_id": "bac78047-3436-3e5e-9b85-be772b15885c",
                                "text": "„In diesem Kapitel wird aufgezeigt, welche Anforderungen an die Strukturierung von Produktionssystemen gestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
