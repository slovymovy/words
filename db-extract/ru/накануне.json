                                                "example_id": "88bc91ef-82ef-4280-82aa-274cfd71a9a9",
                                                "sense_id": "91d378c4-bed5-3780-98ac-a50c0b4507db",
                                                "text": "Je t’assure que je ne suis pas à la veille de recommencer…"
                                            },
                                            {
                                                "example_id": "6a7b2e3d-d769-4f18-a9dc-a1a77e6ae98e",
                                                "sense_id": "91d378c4-bed5-3780-98ac-a50c0b4507db",
                                                "text": "Pour toutes ces opérations, il fallait du personnel et l’on était toujours à la veille d’en manquer."
                                            }
