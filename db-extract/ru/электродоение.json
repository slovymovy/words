                                ]
                            },
                            {
                                "target_word": "traite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Parcours qu’un voyageur fait d’un lieu à un autre sans s’arrêter, sans se reposer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec1dce36-135a-4c22-8810-f9017950cdf8",
                                                "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                                "text": "Aller tout d’une traite d’un lieu à un autre."
                                            },
                                            {
                                                "example_id": "d0b2a72b-cb9f-4e55-99d9-009b67da8c00",
                                                "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                                "text": "Il fit dix lieues d’une seule traite."
                                            },
                                            {
                                                "example_id": "81abf7ee-647d-40f6-a295-6ead67398f8d",
                                                "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                                "text": "Et par ce que la traite n'était pas trop longue, ils arrivèrent de bonne heure au logis : la ou ils se rafraîchirent en buvant, & burent en se rafraîchissant, et en attendant le train à venir, donnèrent ordre au soupper."
                                            },
                                            {
                                                "example_id": "bf53d78d-5761-4564-84cc-10d6807ab10b",
                                                "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                                "text": "Nos comédiens avaient la bourse bien garnie et marchaient rondement, pouvant louer des chevaux et faire de bonnes traites."
                                            },
                                            {
                                                "example_id": "67e4e87d-eb06-4151-a940-e35806232017",
                                                "sense_id": "1f6dd374-b6ee-3768-b8ac-aa532741d274",
                                                "text": "Le manteau indique le cavalier qui fait des traites à cheval ; de même le chapeau à plumes et à larges bords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73baab0-5a96-3792-89d0-77ba4df9fcf1",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Transport de certaines marchandises, telles que blés, vins, etc., d’une province à une autre, ou d’un état à un autre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2bc23f6-0784-45d1-9549-18ee444f4392",
                                                "sense_id": "c73baab0-5a96-3792-89d0-77ba4df9fcf1",
                                                "text": "Il s’est fait de grandes traites de vins."
                                            },
                                            {
                                                "example_id": "b9bdfd0c-a5d3-4ec7-9a3c-1b35506558fa",
                                                "sense_id": "c73baab0-5a96-3792-89d0-77ba4df9fcf1",
                                                "text": "On a permis la traite des blés."
                                            },
                                            {
                                                "example_id": "73c54760-9d98-45af-9c4f-65b9dccdc055",
                                                "sense_id": "c73baab0-5a96-3792-89d0-77ba4df9fcf1",
                                                "text": "Quant à la trafic, que les Princes exercent sur les sujets, ce n'est pas trafic, mais impôts, & exaction : c’est à savoir de défendre la traite, & mettre les blés, & vins des sujets entre les mains des receveurs, & les payer à vil prix, pour les vendre aux étrangers, ou aux sujets mêmes à son mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507778e4-ffd5-356a-8464-a8b8ab5b630b",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Trafic que font des bâtiments de commerce sur les côtes d’Afrique, en échangeant leurs marchandises contre de l’ivoire, de la gomme, de la poudre d’or, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671d17ae-274b-4d79-a67b-af846ac3382a",
                                                "sense_id": "507778e4-ffd5-356a-8464-a8b8ab5b630b",
                                                "text": "Ce bâtiment fait la traite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46338a7c-8dd4-3e55-9bb9-78ba658e06ee",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Commerce des esclaves."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b91442-6266-42e3-a584-89b466b5e7e3",
                                                "sense_id": "46338a7c-8dd4-3e55-9bb9-78ba658e06ee",
                                                "text": "Mais ce qui lui fit le plus d’honneur parmi les marchands d’esclaves, ce fut là construction, qu’il dirigea lui-même, d’un brick destiné à la traite."
                                            },
                                            {
                                                "example_id": "569d84fa-265e-4d91-b37e-882bbe308be5",
                                                "sense_id": "46338a7c-8dd4-3e55-9bb9-78ba658e06ee",
                                                "text": "En 1929, les États-Unis protestèrent à Monrovia contre le recrudescence de la traite des indigènes."
                                            },
                                            {
                                                "example_id": "beade2ae-fdfa-4ea8-84a9-78f092877aff",
                                                "sense_id": "46338a7c-8dd4-3e55-9bb9-78ba658e06ee",
                                                "text": "La traite des Esclaves est le plus important Commerce que les Portugais fassent au Congo; & il est surprenant combien est grand le nombre qu'ils en envoyent tous les ans à l'Amérique, pour faite subsister les Colonies qu'ils y ont, qui ne peuvent s'en passer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c708230-d925-3c0f-88b3-a91b76603fe6",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Droit tiré des marchandises qui sortaient du royaume, ou qui y entraient, ou même qui passaient d’une province dans une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd91013-757c-4ea6-ad23-f2802331656b",
                                                "sense_id": "7c708230-d925-3c0f-88b3-a91b76603fe6",
                                                "text": "On payait la traite des marchandises en Bretagne, en Dauphiné."
                                            },
                                            {
                                                "example_id": "8625f742-c327-449c-a3f1-94aa3cda3ff9",
                                                "sense_id": "7c708230-d925-3c0f-88b3-a91b76603fe6",
                                                "text": "Sous l'Ancien Régime, la traite foraine d'Anjou ou encore appelée traite par terre était un droit perçu sur les passages de marchandises en dehors du duché d'Anjou, et en pratique du Comté de Laval."
                                            },
                                            {
                                                "example_id": "6211cbe5-c194-4006-88de-6e3deee21e7c",
                                                "sense_id": "7c708230-d925-3c0f-88b3-a91b76603fe6",
                                                "text": "La traite foraine était un impôt de sortie. Henri IV, par ses déclarations de 1594 et 1595, avait voulu que, pour obvier aux fraudes que l'on commettait contre les droits."
                                            },
                                            {
                                                "example_id": "d62365dc-1c7b-4238-8bdd-14aa41170b1d",
                                                "sense_id": "7c708230-d925-3c0f-88b3-a91b76603fe6",
                                                "text": "Nous voulons que la forme qui a coutume être gardée de tout temps a lever nôtre dit droit d'imposition Foraine traicte & trépas de loire, ne soit aucunement changée ni muée en quelque manière que ce soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c2e446-3b86-378a-be74-588871743539",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Lettre de change qu’un banquier tire sur un de ses correspondants, un commerçant sur celui à qui il a fourni une marchandise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739484c8-3fa8-4ac7-8446-d6ea78c5daa8",
                                                "sense_id": "32c2e446-3b86-378a-be74-588871743539",
                                                "text": "Le Foirond a été refait et comment. J'ai payé les trois premières traites et j'ai laissé protester les autres, sous prétexte que le pinard tournait. Aujourd'hui je n'ai pas encore payé et je ne payerai point."
                                            },
                                            {
                                                "example_id": "95c949f5-4b0a-4814-a514-f3c360ec2126",
                                                "sense_id": "32c2e446-3b86-378a-be74-588871743539",
                                                "text": "Il porte un chapeau bicorne et un portefeuille à chaîne de cuivre, comme les messieurs qui viennent présente les traites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dfb8070-efbb-330e-bd5b-5a408baf7f7c",
                                        "entry_id": "d52ca632-533f-32fe-8171-d7ef60a67541",
                                        "glosses": [
                                            "Action de traire le lait du bétail."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a3ec2d-325e-4a7b-89c6-eebecfacf2b1",
                                                "sense_id": "7dfb8070-efbb-330e-bd5b-5a408baf7f7c",
                                                "text": "L’heure de la traite."
                                            },
                                            {
                                                "example_id": "7fd4627c-599d-4843-ba4c-673a6e2b9308",
                                                "sense_id": "7dfb8070-efbb-330e-bd5b-5a408baf7f7c",
                                                "text": "Traite mécanique."
                                            },
                                            {
                                                "example_id": "bda04b78-1e08-424c-bfa7-2d5997ca1b06",
                                                "sense_id": "7dfb8070-efbb-330e-bd5b-5a408baf7f7c",
                                                "text": "La traite a pour but d'extraire le lait de la mamelle d'une femelle domestique afin d'obtenir un lait d'excellente qualité, sans répercussion sur la santé de l'animal. C'est l'une des phases les plus importantes de la conduite de la vache laitière."
                                            },
                                            {
                                                "example_id": "cfb1068e-907e-48cb-bbe0-fa07cf691692",
                                                "sense_id": "7dfb8070-efbb-330e-bd5b-5a408baf7f7c",
                                                "text": "Le Roy lui demanda la traicte des vaches de ce jour, & s'en étant fait apporter le laict se mit à table avec douze ou quinze qui l'avoient accompagné, aulquels pour entrée de table il dit: Mesamis, nous sommes tous compagnons, a table d'hote, faisons bonne chere pour notre argent; car nous avons un hôte qui nous fera bien payer l'écot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
