                ],
                "senses": [
                    {
                        "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                        "entry_id": "a313daff-8f4b-3312-a7d8-b82a16bfa5bd",
                        "glosses": [
                            "A small tray containing pens and an inkwell; (by extension) a pot for holding ink, inkpot, inkwell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d41fe2-da43-4c33-8690-6346063b4e4c",
                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                "text": "1765, Laurence Sterne, letter published in Original Letters of the Late Reverend Mr. Laurence Sterne, never before published, London: 1788, pp. 89-90,\n[…] if I thought any thing I might hereafter write would be within their reach, I would throw the Manuscript that is now before me into the fire, and never dip my pen into my Ink-stand again […]"
                            },
                            {
                                "example_id": "123753d3-6886-4d28-aad5-1c58e8a27a68",
                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                "text": "I beg your pardon for being here. I come to look for you, and after waiting a little while in hope of your coming in, was making use of your inkstand to explain my errand."
                            },
                            {
                                "example_id": "a31626b0-fe9a-4524-9c71-3229c50508a6",
                                "sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                                "text": "If you have no ink with you, the first time you go out, stop in at a stationer’s store, and buy a small sixpenny bottle that will stand steadily alone, and answer the purpose of an inkstand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caa2792d-82ad-423c-89dd-08cac667f823",
                        "source_entry_id": "a313daff-8f4b-3312-a7d8-b82a16bfa5bd",
                        "source_sense_id": "8f45d059-b56e-3c40-a5ff-b79702fe01db",
                        "source_sense_description": "Small tray containing pens and an inkwell",
                        "target_lang_word": "Schreibzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                        "entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                                        "glosses": [
                                            "Materialien, die zum Schreiben genutzt werden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dabc025-4e8a-444c-b714-facd2178c754",
                                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                                "text": "Ich habe mein Schreibzeug zuhause vergessen."
                                            },
                                            {
                                                "example_id": "de5dacd7-87ed-4238-894d-e47069ec43ea",
                                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                                "text": "„Er hatte sich mit seinem Schreibzeug in der Wohnstube des Bauernhauses etabliert, in dem er im Quartier lag.“"
                                            },
                                            {
                                                "example_id": "d5d4fd91-852a-4a38-9d28-e55c7ed76801",
                                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                                "text": "„Cooper wurde mit dem Schreibzeug und den Papieren des Kapitäns zum Treffpunkt geschickt, und Letzterer wurde freigelassen.“"
                                            },
                                            {
                                                "example_id": "aeb11ca2-4379-4e4e-a7fd-0821226eeec5",
                                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                                "text": "„Nachdem er gewählt hatte, bat er mich um Schreibzeug, um mir eine Quittung auszustellen.“"
                                            },
                                            {
                                                "example_id": "217af3fb-5af8-4435-baf7-640f59a2863e",
                                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                                "text": "„Ich breite mein Schreibzeug auf die Back und versuche zu arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43f0ccc0-821a-36de-a036-f98cd7554102",
                                        "entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                                        "glosses": [
                                            "oft kunstvoll gestalteter Tischschmuck mit integrierten Tintenfässern und Ablagemöglichkeit für die Feder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffef1873-154f-4c5d-90d4-2bef71abb67d",
                                                "sense_id": "43f0ccc0-821a-36de-a036-f98cd7554102",
                                                "text": "Als nächste Position wird ein bronzenes Schreibzeug im Jugendstil versteigert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
