                    {
                        "translation_id": "c9a20d0f-958e-4705-961e-dc88aa6b1517",
                        "source_entry_id": "02670d46-7aaa-3464-8c1e-77d494dfab5c",
                        "source_sense_id": "02036cd6-b8bd-3a3a-a56e-43b9eba8cc28",
                        "source_sense_description": "state or quality of being believable",
                        "target_lang_word": "crédibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crédibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                        "entry_id": "112df902-0261-3446-bf38-2d3fc3de7603",
                                        "glosses": [
                                            "Ce qui rend une chose digne d’être crue. Sérieux d'une information qui la rend digne de confiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c29097-6130-44ea-8afe-007ca4a8d6b6",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Il a commencé par nous dire qu’il allait nous donner un exemple de la crédibilité due aux attestations que nous présentions."
                                            },
                                            {
                                                "example_id": "7992c762-d043-462e-bfcd-19407a28b975",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Certes il est facile de comprendre qu’un accusé ait tout intérêt à nier son crime et à mettre en cause la victime, et qu’il puisse bénéficier de la présomption d’innocence (mais il faudrait en miroir que la victime puisse bénéficier de la présomption de crédibilité)."
                                            },
                                            {
                                                "example_id": "3ab2b14b-e6c7-4e00-921a-f2f954ee53c9",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité d’une encyclopédie, d’un dictionnaire de langue. — Les conditions sur lesquelles se fonde la crédibilité d’un fait."
                                            },
                                            {
                                                "example_id": "7ff293b2-3bc0-4afc-abe8-3e15b577f783",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité de l’histoire des premiers siècles de Rome a donné lieu à de savantes discussions."
                                            },
                                            {
                                                "example_id": "c275ebc1-737c-4b3a-98b0-c1fca22f5414",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité est, dans un roman de mœurs, une condition nécessaire."
                                            },
                                            {
                                                "example_id": "c9625351-45c8-457f-be49-ce6a359963e3",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Très bon résumé.... que c'est triste de perdre un mec comme Griezmann. Deschamps a perdu encore en crédibilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec901d6-dc80-4cb0-98c9-d83d3ba214ce",
                        "source_entry_id": "02670d46-7aaa-3464-8c1e-77d494dfab5c",
                        "source_sense_id": "02036cd6-b8bd-3a3a-a56e-43b9eba8cc28",
                        "source_sense_description": "state or quality of being believable",
                        "target_lang_word": "Glaubwürdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glaubwürdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                        "entry_id": "b92440bd-6716-39ce-8527-ba16aeb087a9",
                                        "glosses": [
                                            "Glaubwürdigsein; glaubwürdige Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0da5a0-bc7d-47a7-b997-f0979149de62",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Glaubwürdigkeit und Vertrauen sind ein überaus hohes Gut und bilden die Grundlage für einen ernsthaften und lebendigen Glauben an Gott, aber ebenso für Demokratie und erfolgreiches, nachhaltiges Wirtschaften.“"
                                            },
                                            {
                                                "example_id": "1c7f6204-0987-4510-ac11-0dd977ad406e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Ich zeige ihr grinsend meine Bücher, berühmte Namen und wahre Zitate, die ich mit Blaustift unterstrichen habe und deren Glaubwürdigkeit unantastbar ist.“"
                                            },
                                            {
                                                "example_id": "9808055d-0947-4bfe-baea-e2fb94e9615e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Er wusste nicht, ob das stimmte, aber kaum dass er es ausgesprochen hatte, wusste er, dass er jetzt seine letzte Glaubwürdigkeit verspielt hatte.“"
                                            },
                                            {
                                                "example_id": "df52e2db-afe1-4662-b101-c02ad8c3ae89",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Diese Einschätzungen haben dadurch an Glaubwürdigkeit gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
