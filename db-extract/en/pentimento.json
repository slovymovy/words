                                        "glosses": [
                                            "Veränderungen, die während des künstlerischen Schaffensprozesses an Grafiken, Gemälden oder Wandmalereien vorgenommen wurden"
                                        ],
                                        "tags": [
                                            "Bildende Kunst",
