                            {
                                "example_id": "bd584365-1b2a-4875-97e3-2499978f73f6",
                                "sense_id": "a67dcc1d-a740-3218-907f-131fb7a846d7",
                                "text": "'Het geboortehuis van Lenin is nu een museum voor volkskunst,'zegt Valentina trots."
                            },
                            {
                                "example_id": "f6f18a86-befa-431d-be59-11ccbc1d9e9d",
                                "sense_id": "a67dcc1d-a740-3218-907f-131fb7a846d7",
                                "text": "Bijkerk volgde aan de AKI in Enschede een kunstopleiding. In combinatie met haar fascinatie voor volkskunst en liefde voor natuurlijke materialen als linnen en riet, ontstond een bijzondere expositie."
                            }
                        ]
                    },
                    {
                        "sense_id": "8441d239-47ef-3105-b172-10e5bd7fc34c",
                        "entry_id": "3c269fea-9f09-3ced-b272-ce1c491e3ae3",
                        "glosses": [
                            "kunst die door grote groepen van de bevolking wordt gewaardeerd"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "043c0e8b-6d47-4cc7-a1c4-c18b045dc83d",
