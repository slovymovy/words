                    {
                        "sense_id": "313ecb25-a462-3b00-996f-236ab8538f90",
                        "entry_id": "b975ae00-89a8-3b21-8b5d-5cd91cd78cde",
                        "glosses": [
                            "Marchande d’œufs et d’animaux de basse-cour, qui achetait ses produits de ferme en ferme, pour les revendre en ville."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4766d0aa-b3ae-4c7b-88f7-1f17a75796d9",
                                "sense_id": "313ecb25-a462-3b00-996f-236ab8538f90",
                                "text": "La coquassière quitta sa poêle et tira dans la cour Ulenspiegel et Lamme sur leurs ânes, lesquels se mirent à braire incontinent."
                            },
                            {
                                "example_id": "47af8582-acc8-430b-99cf-83ab93518ed2",
                                "sense_id": "313ecb25-a462-3b00-996f-236ab8538f90",
                                "text": "En plus du vin, du bois, du sel et du courrier, il arrivait que les gabares embarquent des passagers, à l’exemple de la coquassière qui montait sur le pont et coinçait ses jupes avec son panier à œufs et celui des volailles."
                            }
                        ]
                    }
