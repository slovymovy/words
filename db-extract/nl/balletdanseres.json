                    },
                    {
                        "translation_id": "31ded107-e275-4b89-b36c-db27fb76e1b4",
                        "source_entry_id": "2b224e65-fb43-37cc-bd52-c52535552181",
                        "source_sense_id": "2216d047-ef49-313d-9536-42094f460070",
                        "target_lang_word": "ballerine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballerine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f13047f2-7232-39ec-b977-baf0e2502a24",
                                        "entry_id": "1e17024d-0e7c-3211-956e-3458c51b8b9d",
                                        "glosses": [
                                            "Danseuse de ballet, de théâtre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163b919d-d314-4f7a-8d05-3984939a538c",
                                                "sense_id": "f13047f2-7232-39ec-b977-baf0e2502a24",
                                                "text": "Car il était devenu danseur célèbre, « premier danseur des principaux théâtres du globe », et avait fourni à ces principaux théâtres du globe quinze ballerins et ballerines, et avait par surcroît philosophé à sa manière sur son art, sur l’art, au point d’inventer sa fameuse métaphysique de la danse."
                                            },
                                            {
                                                "example_id": "a019d599-370f-4ec6-846a-a93602aa7b6c",
                                                "sense_id": "f13047f2-7232-39ec-b977-baf0e2502a24",
                                                "text": "Une fillette, qui a adoré la séance de ballet à laquelle elle a assisté avec sa maman, est déterminée à devenir ballerine."
                                            },
                                            {
                                                "example_id": "0b49d209-cece-471b-a651-c5fc9dc137ce",
                                                "sense_id": "f13047f2-7232-39ec-b977-baf0e2502a24",
                                                "text": "Par exemple, la danse classique forme des corps féminins et masculins différenciés et la ballerine et souvent prise comme paradigme de la féminité patriarcale."
                                            },
                                            {
                                                "example_id": "e492709d-3c16-486f-9130-4557ca37e0d0",
                                                "sense_id": "f13047f2-7232-39ec-b977-baf0e2502a24",
                                                "text": "Les plus belles femmes du monde, les grandes ballerines, les prime donne, les Rachel, les Duse et les Garbo,-voilà ce à quoi, dans son esprit, j'étais destiné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a145682d-0913-37d2-ae79-c253f17e553e",
                                        "entry_id": "1e17024d-0e7c-3211-956e-3458c51b8b9d",
                                        "glosses": [
                                            "Chausson pour la danse classique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee4b099-2a10-436b-90e4-bfdcbcb5c1db",
                                                "sense_id": "a145682d-0913-37d2-ae79-c253f17e553e",
                                                "text": "Face à lui, une paire de ballerines violettes à plat sur le sol ; la personne qui les porte a les jambes nues, des chevilles fines et gracieuses."
                                            },
                                            {
                                                "example_id": "fe41cbc3-5879-44e8-b8b2-33b186114f45",
                                                "sense_id": "a145682d-0913-37d2-ae79-c253f17e553e",
                                                "text": "À l'intérieur, trois douzaines et demie de paires de souliers alignés étincellent. Des ballerines blanches. Plusieurs sortes d'escarpins noirs, des sandales vernies, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cdcdf61-6a0c-3b79-a0a5-dc12b8921890",
                                        "entry_id": "1e17024d-0e7c-3211-956e-3458c51b8b9d",
                                        "glosses": [
                                            "Chaussure féminine fermée et décolletée à bouts ronds, souvent plate et possédant parfois un talon très mince ou aucun talon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14d685b0-7bc0-47df-af93-27b630453875",
                                                "sense_id": "6cdcdf61-6a0c-3b79-a0a5-dc12b8921890",
                                                "text": "Sa quête ne souffrait plus d’accalmie et Louise allait maintenant d’un trottoir à l’autre, sans souci des dangers de la chaussée, attirée par la fatigue ou l’éclat d’un chevreau, ballerine ou richelieu, bottillon ou petit soulier, séminariste ou semi-poulaine, boucle, élastiques ou boutons."
                                            },
                                            {
                                                "example_id": "2220b00b-bb63-4929-a734-bb17004005cf",
                                                "sense_id": "6cdcdf61-6a0c-3b79-a0a5-dc12b8921890",
                                                "text": "Lone retira ses ballerines sur le ponton et, d’une ample enjambée, franchit le balcon avant"
                                            },
                                            {
                                                "example_id": "65511d67-409f-4c24-b52b-185d6b84e536",
                                                "sense_id": "6cdcdf61-6a0c-3b79-a0a5-dc12b8921890",
                                                "text": "J’ai finalement opté pour ma robe rouge avec des ballerines de la même couleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
