                        ],
                        "form": "die Verdauung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                        "glosses": [
                            "Verwertung der Nahrung, vor allem durch Magen und Darm; Umsetzung der Nahrung in Lebenskraft; Teil des Stoffwechsels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d958ce73-72d5-463a-8b61-70cf5efb26ae",
                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                "text": "Verdauung ist ein lebenswichtiger körperlicher Vorgang."
                            },
                            {
                                "example_id": "8cd6e4c4-a624-4b72-a94b-d8a1165b6224",
                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                "text": "Auch Nagetiere haben das Problem der schwerverdaulichen Pflanzennahrung, das die meisten – ausgenommen etwa Siebenschläfer – wie die Hasentiere durch Caecotrophie, die doppelte Verdauung, lösen."
                            },
                            {
                                "example_id": "59f945f5-a416-4615-b71d-de6e70e368df",
                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                "text": "„Die Frage ist halb ernst gemeint, aber Lampe fängt sofort an zu plappern, über seine Erfahrungen mit Gänsen, die mit Fenchel gefüllt werden müßten, der Verdauung wegen; oder Hasen, die in Buttermilch eingelegt, schneller gar würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "195e4c2d-2eb9-378f-89f3-4b254fca8ea1",
                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                        "glosses": [
                            "Stuhlgang"
                        ],
                        "tags": [
                            "euphemistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e5fd0d25-2a31-4492-8992-d4bb17c4ee32",
                                "sense_id": "195e4c2d-2eb9-378f-89f3-4b254fca8ea1",
                                "text": "Hatten Sie heute schon Verdauung?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dce858f0-4760-34b9-af4d-825152a40088",
                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                        "glosses": [
                            "(psychische) Verkraftung von etwas Belastendem"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "026bf541-e52a-48b9-b972-dc25d7b42e72",
                                "sense_id": "dce858f0-4760-34b9-af4d-825152a40088",
                                "text": "Die Verdauung der Niederlage erforderte viel Kraft."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c6575e5-cbbe-4d37-8f69-a92c46368579",
                        "source_entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                        "source_sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                        "source_sense_description": "Verwertung der Nahrung im Körper",
                        "target_lang_word": "digestion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digestion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The process, in the gastrointestinal tract, by which food is converted into substances that can be used by the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ca9726-b217-469b-a0ab-06d2fb884fca",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            },
                                            {
                                                "example_id": "cd2e1045-3679-498f-8235-72dd8954e5d9",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "As for Grierson, he poured liquor into himself as if it were so much soothing syrup, demonstrating that a good digestion is the highest form of good conscience."
                                            },
                                            {
                                                "example_id": "a4ecf268-b5a2-4621-8719-a2d316519f5d",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544f2a99-8393-3c5f-a543-f39ae13be263",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The result of this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5144a7ac-12b2-382b-91b4-680461a270b7",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The ability to use this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5db9a5f-c84f-344c-baf5-d96baf60379a",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The processing of decay in organic matter assisted by microorganisms."
