                "senses": [
                    {
                        "sense_id": "ab4ad16d-d5f8-3111-abdc-9fac834bf3c5",
                        "entry_id": "7d6747ee-97c3-32b6-9e1a-6ba0d80aea39",
                        "glosses": [
                            "Donner un caractère acoustique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22cef51c-8890-4126-9cf2-05ee50af1f81",
                                "sense_id": "ab4ad16d-d5f8-3111-abdc-9fac834bf3c5",
                                "text": "Et hop un deuxième morceau dispo sur adrive assez electro, à acoustiser si vous êtes intéressé pour le jouer..."
                            },
                            {
                                "example_id": "bfc82ce4-1a07-450f-9b8e-fd7de1985761",
                                "sense_id": "ab4ad16d-d5f8-3111-abdc-9fac834bf3c5",
                                "text": "Dès lors je m'amuse à \"acoustiser\" certains grands classiques, à en reprendre d'autres (et à en composer :p) )."
                            },
                            {
                                "example_id": "0efe8807-a093-4266-8966-e85777ae5757",
                                "sense_id": "ab4ad16d-d5f8-3111-abdc-9fac834bf3c5",
                                "text": "L'électro n'a pas à mon sens forcément besoin de s'acoustiser pour s'humaniser, même si je sais que c'est le fond d'un vieux débat."
                            }
                        ]
                    }
