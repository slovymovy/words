                "senses": [
                    {
                        "sense_id": "9e2bed83-c9b0-3d16-a5f3-e91f35d22274",
                        "entry_id": "b3cc05ef-7d96-366d-aaa3-6a4f7a5ed2ef",
                        "glosses": [
                            "An opponent; an enemy; the opposition."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7067ccc8-e3bd-415d-86e8-9f151e80d186",
                                "sense_id": "9e2bed83-c9b0-3d16-a5f3-e91f35d22274",
                                "text": "Seeing the opps slumped in the front seats, I went for the duffel bag that was lying on the backseat."
                            },
                            {
                                "example_id": "df8d3354-c070-4eb7-b42f-0a93b17f5324",
                                "sense_id": "9e2bed83-c9b0-3d16-a5f3-e91f35d22274",
                                "text": "The opps killed my man Snipes two years ago today."
                            },
                            {
                                "example_id": "de6ea4a4-1f40-4cb1-b930-c2e32caff4ba",
                                "sense_id": "9e2bed83-c9b0-3d16-a5f3-e91f35d22274",
                                "text": "Better watch your back if you're my opp\nWipe the floor with them like you're my mop"
                            },
                            {
                                "example_id": "8d9ac7b4-28bf-4e25-b876-7b81393adcf0",
                                "sense_id": "9e2bed83-c9b0-3d16-a5f3-e91f35d22274",
                                "text": "Damn, I see you still kick it with them opp bitches\nI'm the only reason that your goofy ass got bitches"
                            }
                        ]
                    },
                    {
                        "sense_id": "6d73c7c9-ab26-336b-8bf9-368517c7f60a",
                        "entry_id": "b3cc05ef-7d96-366d-aaa3-6a4f7a5ed2ef",
                        "glosses": [
                            "Any person on unfriendly terms."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "de441767-cb85-4050-b47b-9671299c81a0",
                                "sense_id": "6d73c7c9-ab26-336b-8bf9-368517c7f60a",
                                "text": "When I saw her I fled on the spot man, me and her are opps."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc892093-b5d1-38e4-9f51-40e9c27961c6",
                        "entry_id": "b3cc05ef-7d96-366d-aaa3-6a4f7a5ed2ef",
                        "glosses": [
                            "Abbreviation of opportunity."
                        ],
                        "tags": [
