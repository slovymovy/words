                    },
                    {
                        "translation_id": "3051c098-83c1-4892-b13b-53eec4560874",
                        "source_entry_id": "fa07f009-3937-3233-acc6-c0797ceb0d31",
                        "source_sense_id": "b8ba662b-f54f-3abe-9ade-8c51bc2282c7",
                        "target_lang_word": "Arktis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arktis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0ee2af-9c15-368d-b4cf-3cac9726ba18",
                                        "entry_id": "74f586da-0346-3635-890e-c28b7847df80",
                                        "glosses": [
                                            "das nördliche Polargebiet der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b414b995-0ced-4842-830b-499b95bf454d",
                                                "sense_id": "ae0ee2af-9c15-368d-b4cf-3cac9726ba18",
                                                "text": "Die Arktis ist im Gegensatz zur Antarktis kein Kontinent."
                                            },
                                            {
                                                "example_id": "ef269b5d-68d8-4581-9d0a-164b819f8b5b",
                                                "sense_id": "ae0ee2af-9c15-368d-b4cf-3cac9726ba18",
                                                "text": "„Katrine ist Anfang dreißig, eine schlanke blonde Dänin mit spöttischen grünen Augen, einem Bubikopf und einem ausgesprochenen Hang zur Arktis.“"
                                            },
                                            {
                                                "example_id": "5ef06cd2-7bd6-414a-83c1-9dc49105352d",
                                                "sense_id": "ae0ee2af-9c15-368d-b4cf-3cac9726ba18",
                                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                                            },
                                            {
