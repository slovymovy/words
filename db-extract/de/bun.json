                "senses": [
                    {
                        "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                        "entry_id": "84f89432-8795-32a2-bafc-b0a64211b3fc",
                        "glosses": [
                            "weiches Brötchen für Hamburger und Hot Dogs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0243f34d-1654-4ee8-8171-875b5802080b",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Die Schnittflächen der Buns werden vor dem Belegen in der Regel geröstet."
                            },
                            {
                                "example_id": "9319ff45-dd22-4625-9c69-67f70dedaf07",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Mit einem klassischen Bun, also diesem weichen Hamburger-Brötchen, das aber zusätzlich mit Brezellauge behandelt worden war, sodass es den charakteristischen Geschmack von Laugengebäck angenommen hatte."
                            },
                            {
                                "example_id": "a294916a-25bb-498f-a01b-f9880072bf76",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Und weil wir auch die Buns (Brötchen) selber backen, haben wir die besten Chancen, echte Burger-Meister zu werden."
                            },
                            {
                                "example_id": "d8aefe13-84fa-4350-9e63-f683ec736eb2",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Der Hefekloß Bánh Bao dient nun als Bun für den Asia-Burger - er ersetzt also das klassische Brötchen."
                            },
                            {
                                "example_id": "7f7e6a6f-991b-41a5-a67d-117a34733019",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Dank Skinny Bitch, Leinsamenpizza und Burger ohne Bun kann man sich nun unter Leute mischen und dennoch kalorienbewusst leben."
                            },
                            {
                                "example_id": "9cfdcd5d-4e82-460d-b734-e84984bad194",
                                "sense_id": "c12a16fa-4d70-3c7d-b5ed-136c4e88625f",
                                "text": "Die Fleisch-Variationen kann man auch einzeln mit Bun (Weichbrötchen), das vor dem Belegen leicht angetoastet wird, mit Salat oder als Platte bestellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
