                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le feu d'artifice a complètement <w>illuminé</w> le ciel sombre de cette nuit d'été."
