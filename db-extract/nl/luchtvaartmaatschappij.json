                "senses": [
                    {
                        "sense_id": "096ea776-4582-3b0b-8848-7b1005c494a7",
                        "entry_id": "5c546ecd-b2f2-30e8-a203-213b2ac98914",
                        "glosses": [
                            "een bedrijf dat vervoer door de lucht aanbiedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84fe722b-ca99-4e50-811a-72a3ff61e884",
                                "sense_id": "096ea776-4582-3b0b-8848-7b1005c494a7",
                                "text": "De KLM is de grootste Nederlands luchtvaartmaatschappij."
                            },
                            {
                                "example_id": "dc80bf58-1752-4f91-a723-05f1a041d7bc",
                                "sense_id": "096ea776-4582-3b0b-8848-7b1005c494a7",
                                "text": "Een woordvoerder van de luchtvaartmaatschappij zei op zaterdag: ,,Alle passagiers kregen een diner. De passagiers die niet meer meekonden, werden voorzien van vervoer en hotelaccommodatie en zullen op de volgende beschikbare vlucht worden gezet. PIA betreurt het ongemak dat haar passagiers als gevolg van dit incident is overkomen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40683638-d9d3-4499-bd1c-59a73e72afe4",
                        "source_entry_id": "5c546ecd-b2f2-30e8-a203-213b2ac98914",
                        "source_sense_id": "096ea776-4582-3b0b-8848-7b1005c494a7",
                        "source_sense_description": "een bedrijf dat vervoer door de lucht aanbiedt",
                        "target_lang_word": "Fluglinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fluglinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                        "entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                                        "glosses": [
                                            "Unternehmen, das Flugverkehr betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92cc2401-9c30-4bf4-9dfb-3224fe9b0341",
                                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                                "text": "„Die Fluglinie Finnair führte 2012 die Liste der sichersten Fluglinien an.“"
                                            },
                                            {
                                                "example_id": "73e99d48-7525-49ce-befb-239073dac95e",
                                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                                "text": "„Das Hotel, in dem uns die Fluglinie unterbrachte, war schäbig.“"
                                            },
                                            {
                                                "example_id": "588681bd-9bdd-4642-8699-431e93054fb1",
                                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                                "text": "„Nur die Reichen und Mächtigen unter den Flüchtlingen hatten einen legalen oder illegalen Zugang zu dieser Fluglinie, was zugleich bedeutete, dass sie mit ihrer Anreise aus der Luft ihre Asylchancen erhöhten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c322e827-569f-3b40-9c98-5f458f3e44a5",
                                        "entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                                        "glosses": [
                                            "Strecke, die regelmäßig beflogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3968ec1c-74d0-4d4c-aca4-b769ed2890ff",
                                                "sense_id": "c322e827-569f-3b40-9c98-5f458f3e44a5",
                                                "text": "Heute wird die neue Fluglinie nach New York endlich eröffnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
