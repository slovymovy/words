                ],
                "senses": [
                    {
                        "sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "glosses": [
                            "bes van de braamstruik"
                        ],
                        "tags": [
                            "fruit"
                        ],
                        "examples": [
                            {
                                "example_id": "9d4a8608-61ec-4c86-8ef1-9536ba916756",
                                "sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                                "text": "Rim lanceert een eerste mobiele toestel: de Blackberry 950. Het krijgt de naam Blackberry omdat de toesten doen denken aan een braambes. Verder lijkt het op veel andere ‘palmtops’, maar het bedrijf introduceert wel een belangrijke nieuwigheid: de e-mailfunctie. Andere producenten kregen dit niet voor elkaar, maar door het gebruik van eigen servers slaagt het bedrijf erin om mailverkeer van en naar het toestel in goede banen te leiden"
                            },
                            {
                                "example_id": "e635f5ad-f3c8-4099-b526-49d10566a5fe",
                                "sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                                "text": "De perfecte mix om van de eindejaarsfeesten te bekomen en toch niet op gifgroen sap te moeten overleven, is deze detoxcocktail met framboos, braambes en aardbei. Een recept van het Gentse Cafe Theatre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4074a5a3-e92b-4a7d-a23d-983a47d55bb3",
                        "source_entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "source_sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "target_lang_word": "Brombeere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brombeere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "854f2fca-9aea-3194-866b-5d39f7351fe3",
                                        "entry_id": "ba1f98b7-dd6b-3c26-818f-6c9ee5715c1b",
                                        "glosses": [
                                            "Früchte tragender Strauch der Art Rubus fruticosus und ähnlicher Arten aus der Familie der Rosengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2999f12f-ae78-4013-81c0-5f05b84b2246",
                                                "sense_id": "854f2fca-9aea-3194-866b-5d39f7351fe3",
                                                "text": "Der Weg war mit Brombeeren zugewachsen."
                                            },
                                            {
                                                "example_id": "597f5a3e-cdb9-4050-9b63-d196cbb56d9d",
                                                "sense_id": "854f2fca-9aea-3194-866b-5d39f7351fe3",
                                                "text": "Die Brombeere gehört zu den Rosengewächsen."
                                            },
                                            {
                                                "example_id": "19b68048-2ffc-49af-a3ea-56a3e56022c1",
                                                "sense_id": "854f2fca-9aea-3194-866b-5d39f7351fe3",
                                                "text": "„Der Großteil der Fassade ist inzwischen von Efeu und Brombeeren bewachsen, deshalb ist es nicht so schlimm anzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "412b215d-e308-36bb-a703-42534a611203",
                                        "entry_id": "ba1f98b7-dd6b-3c26-818f-6c9ee5715c1b",
                                        "glosses": [
                                            "Frucht (Sammelsteinfrucht), die von Sträuchern der Art Rubus fruticosus und ähnlicher Arten (Familie Rosengewächse) hervorgebracht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae7d107-1fe8-461d-a755-258305dbcb16",
                                                "sense_id": "412b215d-e308-36bb-a703-42534a611203",
                                                "text": "Zum Nachtisch gibt's Brombeeren."
                                            },
                                            {
                                                "example_id": "ef5c1587-1399-45f3-9cf2-c6bed161e358",
                                                "sense_id": "412b215d-e308-36bb-a703-42534a611203",
                                                "text": "„Wir tobten über die Hänge, kletterten auf Bäume, pflückten Maulbeeren, Brombeeren, Feigen und was sonst noch alles wuchs, und spielten Picknick.“"
                                            },
                                            {
                                                "example_id": "71749165-e261-4d9b-9ca0-e9d8470be841",
                                                "sense_id": "412b215d-e308-36bb-a703-42534a611203",
                                                "text": "„Wir wussten, welche Farbe der Himmel für die andere hatte, welchen Duft die Apfelblüten und welchen Geschmack die Brombeeren aus dem Garten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f98ec6bb-eb1e-4ae7-bf83-26ba8d5ebbdf",
                        "source_entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "source_sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "target_lang_word": "blackberry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackberry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "912d7558-7672-3bc7-9421-85cd1f52dda0",
                                        "entry_id": "33228337-beb1-3d82-a2e0-b057fc8379a4",
                                        "glosses": [
                                            "A fruit-bearing shrub of the aggregate species Rubus fruticosus and some hybrids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "592ac66e-c972-35d1-82da-b7029370fd7c",
                                        "entry_id": "33228337-beb1-3d82-a2e0-b057fc8379a4",
                                        "glosses": [
                                            "The soft fruit borne by this shrub, formed of a black (when ripe) cluster of drupelets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db5fc0a-fb0a-42b6-98a1-6a5b48a6367a",
                                                "sense_id": "592ac66e-c972-35d1-82da-b7029370fd7c",
                                                "text": "Here at the creek, a ways off from the trail, we have blackberries for now, not as fat and sweet as they get, but I like them tart, with that little bit of red still at their tops, or if they’re just a little hard and not so soft they come off when you pull at them and leave your fingers stained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b32244-c14d-3669-8805-d797fd360408",
                                        "entry_id": "33228337-beb1-3d82-a2e0-b057fc8379a4",
                                        "glosses": [
                                            "Any Rubus berry that is black or blackish; the plant that produces it."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8c2af20-4d0d-31d0-9ec7-588905305a17",
                                        "entry_id": "33228337-beb1-3d82-a2e0-b057fc8379a4",
                                        "glosses": [
                                            "The blackcurrant."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blackberry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                        "entry_id": "a0b20a7f-91a1-3369-9510-cb355840bc22",
                                        "glosses": [
                                            "To gather or forage for blackberries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02342cf1-39b8-4690-b9fc-cd816736908f",
                                                "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                                "text": "She had gone up into the tower alone and left them blackberrying in the sun"
                                            },
                                            {
                                                "example_id": "9585ff09-e29c-405a-805f-c5fbbcca3c5e",
                                                "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                                "text": "My mother and Cordelia were blackberrying along the woods edge of a nearby meadow."
                                            },
                                            {
                                                "example_id": "440e1d97-37c3-480c-ab39-497602f10d91",
                                                "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                                "text": "Thereafter we blackberried unceasingly and returned with a large basketful, together with some maggoty windfall apples found neglected in the wet grass on the edge of an orchard and Mrs Clare duly stewed these for us."
                                            },
                                            {
                                                "example_id": "6f0f3bfe-c7fd-40ba-923b-c39d26f91eea",
                                                "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                                "text": "My wife and children were blackberrying at the end of the garden and I was simply reading."
                                            },
                                            {
                                                "example_id": "9696a802-1150-4594-bac5-ab35ee6a0c87",
                                                "sense_id": "ba846a4b-9deb-3d9a-99cc-a484634dc852",
                                                "text": "Another instance of someone who is blackberrying and sees fairies can be found at Kingheriot Farm (South-West Wales: Pembrokeshire): maybe gathering berries puts the percipient into a relaxed or dissociated frame of mind, more conducive to being able to see things that one would perhaps not normally be able to see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "533cffeb-7272-4531-833c-63c6595efb39",
                        "source_entry_id": "160f79fe-2db8-3549-85c1-816c325843e6",
                        "source_sense_id": "288643a3-2567-3a77-8022-cba40f0b20c1",
                        "target_lang_word": "bramble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bramble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                        "entry_id": "8a4ee5e3-12ac-3c94-806b-ea6473855c5d",
                                        "glosses": [
                                            "Any of many closely related thorny plants in the genus Rubus including the blackberry and likely not including the raspberry proper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fde363-20f8-4f80-a9d2-9ef1727fe060",
                                                "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                                "text": "The hovel stood in the centre of what had once been a vegetable garden, but was now a patch of rank weeds. Surrounding this, almost like a zareba, was an irregular ring of gorse and brambles, an unclaimed vestige of the original common."
                                            },
                                            {
                                                "example_id": "d7c4d833-e099-4247-9cc7-0548fde6402c",
                                                "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                                "text": "At the same time, the encroachment of vegetation proceeds apace, and broom and brambles have already made portions of the line impassable, even on foot."
                                            },
                                            {
                                                "example_id": "ae12f663-264b-471d-aac8-a52f35cdc058",
                                                "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                                "text": "Jeanette is making bramble jelly. She is trying to listen to the Morning Story on Radio 4 while she goes about her task. Jeanette's brow is furrowed as she weighs the deep purple fruit and tips the berries into the heavy jelly pan […]"
                                            },
                                            {
                                                "example_id": "52030346-3180-4753-b04b-0755b635c29d",
                                                "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                                "text": "A similar instinct for self-preservation was the cause of my first lie. My governess left me alone for half an hour with strict instructions to eat no blackberries during her absence. When she returned I was suspiciously near the brambles. ‘You have been eating blackberries’, she said. ‘I have not’, I replied. ‘Put out your tongue!’ she said. Shame overwhelmed me, and I felt utterly wicked."
                                            },
                                            {
                                                "example_id": "ae0b86fa-e33b-42c7-bf90-40dd67a8ce18",
                                                "sense_id": "a4ac651e-5581-347e-9f8d-c50633300349",
                                                "text": "There seems to be a term for just about everything… it turns out there’s even a term for the scientific study of members of the Rubus genus— batology. No, not the study of bats. In exploring batology you’ll find that the most commonly cultivated brambles come from a complex lineage…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da8fe19-98f6-3e13-8516-a8b827978836",
                                        "entry_id": "8a4ee5e3-12ac-3c94-806b-ea6473855c5d",
                                        "glosses": [
                                            "Any thorny shrub."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a47eaa65-dc29-3b74-a87b-5a5255407fc2",
                                        "entry_id": "8a4ee5e3-12ac-3c94-806b-ea6473855c5d",
                                        "glosses": [
                                            "A cocktail of gin, lemon juice, and blackberry liqueur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6200f629-cd6d-33b4-a7a5-b4937af84f04",
                                        "entry_id": "8a4ee5e3-12ac-3c94-806b-ea6473855c5d",
                                        "glosses": [
                                            "The soft fruit borne by the species Rubus fruticosus formed of a black (when ripe) cluster of drupelets."
                                        ],
