{
    "word_family": [
        "local",
        "localize",
        "localization",
        "locally",
        "location",
        "locate",
        "locale"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "860f658d-51e3-3eb6-b0d6-bca75026e8af",
                    "sense_definition": "An area or district considered as the site of certain activities; a neighbourhood.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "place_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families in the <w>locality</w> send their children to the new school.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в этой <w>местности</w> отправляют своих детей в новую школу.",
                                "zh": "这个<w>地区</w>的许多家庭都把孩子送到那所新学校上学。"
                            }
                        },
                        {
                            "text": "We searched the immediate <w>locality</w> but could not find the missing dog.",
                            "target_lang_translations": {
                                "ru": "Мы обыскали ближайшие <w>окрестности</w>, но не смогли найти пропавшую собаку.",
                                "zh": "我们在<w>附近</w>搜寻了一遍，但没能找到那只走失的狗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neighborhood",
                        "district",
                        "vicinity",
                        "area",
                        "region"
                    ],
                    "common_phrases": [
                        "in the locality",
                        "immediate locality",
                        "general locality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Район, окрестность или населённый пункт, рассматриваемый как место определённой деятельности.",
                        "zh": "指特定的区域、地区或社区，通常被视为某种活动的场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местность",
                                "target_lang_sense_clarification": "определённая территория или участок земли"
                            },
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "часть города или территории"
                            },
                            {
                                "target_lang_word": "окрестность",
                                "target_lang_sense_clarification": "прилегающая территория"
                            },
                            {
                                "target_lang_word": "населённый пункт",
                                "target_lang_sense_clarification": "официальное название поселения (города, села)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地区",
                                "target_lang_sense_clarification": "指一定范围内的区域"
                            },
                            {
                                "target_lang_word": "附近",
                                "target_lang_sense_clarification": "指邻近的区域"
                            },
                            {
                                "target_lang_word": "社区",
                                "target_lang_sense_clarification": "指居住的邻里区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b02f9f6-ae61-3f54-b1c0-29928374deae",
                    "sense_definition": "The situation or position of an object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exact <w>locality</w> of the ancient ruins is still debated by archaeologists.",
                            "target_lang_translations": {
                                "ru": "Точное <w>местоположение</w> древних руин всё ещё обсуждается археологами.",
                                "zh": "考古学家们仍在争论这些古代遗迹的具体<w>位置</w>。"
                            }
                        },
                        {
                            "text": "GPS technology helps pinpoint the <w>locality</w> of the vehicle.",
                            "target_lang_translations": {
                                "ru": "Технология GPS помогает точно определить <w>местонахождение</w> транспортного средства.",
                                "zh": "GPS技术有助于精确定位车辆的<w>所在地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "location",
                        "position",
                        "site",
                        "spot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Местоположение или точное расположение объекта.",
                        "zh": "物体所处的具体位置或方位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местоположение",
                                "target_lang_sense_clarification": "географическая позиция"
                            },
                            {
                                "target_lang_word": "местонахождение",
                                "target_lang_sense_clarification": "текущее место пребывания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "位置",
                                "target_lang_sense_clarification": "物体所处的空间方位"
                            },
                            {
                                "target_lang_word": "所在地",
                                "target_lang_sense_clarification": "某人或某物所在的具体地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "683b11cd-851c-3fc4-9b4c-dd8bfafa2b04",
                    "sense_definition": "The condition of being local.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condition_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software is optimized to take advantage of spatial <w>locality</w>.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение оптимизировано для использования преимуществ пространственной <w>локальности</w>.",
                                "zh": "该软件经过优化，以利用空间<w>局部性</w>。"
                            }
                        },
                        {
                            "text": "Temporal <w>locality</w> of reference ensures frequently used data stays in the cache.",
                            "target_lang_translations": {
                                "ru": "Временная <w>локальность</w> обращения гарантирует, что часто используемые данные остаются в кэше.",
                                "zh": "时间<w>局部性</w>确保了频繁使用的数据保留在缓存中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "locality of reference",
                        "spatial locality",
                        "temporal locality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть локальным, сосредоточенность в определённом месте (технический термин).",
                        "zh": "指事物在空间或时间上集中于某处的特性（常用于计算机科学）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "локальность",
                                "target_lang_sense_clarification": "технический термин, напр. в информатике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "局部性",
                                "target_lang_sense_clarification": "计算机科学中指数据访问的集中特性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "682ff22a-fb57-303d-a81e-b120170749f7",
                    "sense_definition": "Limitation to a county, district, or place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>locality</w> of trial is determined by the jurisdiction where the crime occurred.",
                            "target_lang_translations": {
                                "ru": "<w>Место</w> проведения судебного разбирательства определяется юрисдикцией, где было совершено преступление.",
                                "zh": "审判的<w>管辖地</w>由犯罪发生的司法管辖区决定。"
                            }
                        },
                        {
                            "text": "Legal disputes often arise regarding the <w>locality</w> of the court's authority.",
                            "target_lang_translations": {
                                "ru": "Юридические споры часто возникают относительно <w>территории</w> полномочий суда.",
                                "zh": "关于法院权力的<w>属地</w>问题，经常会引发法律纠纷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "locality of trial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничение определённой территорией или округом (юридический контекст).",
                        "zh": "法律或行政管辖权的地域范围限制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "место проведения или совершения действия"
                            },
                            {
                                "target_lang_word": "территориальная принадлежность",
                                "target_lang_sense_clarification": "отношение к определённой территории"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管辖地",
                                "target_lang_sense_clarification": "法律权力行使的地域范围"
                            },
                            {
                                "target_lang_word": "属地",
                                "target_lang_sense_clarification": "归属于特定行政区域的范围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}