        "fr-extract.jsonl": [
            {
                "entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                "word": "bêtement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                        "entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                        "glosses": [
                            "Comme une bête le ferait, stupidement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cdcd26b0-eea2-4e91-acb7-1d7afc4ea130",
                                "sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                                "text": "Il a bêtement agi. Il a répondu bêtement."
                            },
                            {
                                "example_id": "3367deeb-6099-4b5e-9f3f-cadeb79c9498",
                                "sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                                "text": "Il parle et agit bêtement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfdc1527-193e-448b-80f8-e82cff12150d",
                        "source_entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                        "source_sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                        "target_lang_word": "mechanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mechanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68fe39ba-ecd0-3bad-b6f9-e256a4671e07",
                                        "entry_id": "813e8237-491b-3186-af41-67840a000402",
                                        "glosses": [
                                            "in Bezug auf die Mechanik und ihre Gesetze"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98ef4518-605c-3ce5-bb2f-c0a3262c0e9e",
                                        "entry_id": "813e8237-491b-3186-af41-67840a000402",
                                        "glosses": [
                                            "mit Hilfe von Maschinen oder Geräten; maschinell"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9a153c4a-aa3a-30b5-8c19-5ebd3ce1e306",
                                        "entry_id": "813e8237-491b-3186-af41-67840a000402",
                                        "glosses": [
                                            "wie von selbst ablaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fd8af9-d488-4e78-9fcb-f242e637c77d",
                                                "sense_id": "9a153c4a-aa3a-30b5-8c19-5ebd3ce1e306",
                                                "text": "„Mechanisch wiederholte ich Absatz für Absatz, was der Rebbe auf hebräisch sagte, ohne ein Wort zu verstehen.“"
                                            },
                                            {
                                                "example_id": "5ed2930a-a346-46df-8061-e506aa5fb9fd",
                                                "sense_id": "9a153c4a-aa3a-30b5-8c19-5ebd3ce1e306",
                                                "text": "Songtext: „du hast ‘n Schatten im Blick - dein Lachen ist gemalt - deine Gedanken sind nicht mehr bei mir. - Streichelst mich mechanisch, - völlig steril, - eiskalte Hand, - mir graut vor Dir. - […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3589d678-efcc-4c51-9e87-489cbc5bb837",
                        "source_entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                        "source_sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                        "target_lang_word": "gedankenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gedankenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6fd9e57-e6ef-3172-b374-ca0467f85c4a",
                                        "entry_id": "42daaffd-8279-37ec-9709-1c59b8c0a771",
                                        "glosses": [
                                            "ohne vorheriges Nachdenken, nicht überdacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad9c61c-3945-4423-8c19-c86308541ecb",
                                                "sense_id": "d6fd9e57-e6ef-3172-b374-ca0467f85c4a",
                                                "text": "Da sie, während ihre Augen bei diesen gedankenlos hervorgesprudelten Phrasen überall hin, nur nicht auf ihn gerichtet waren, offenbar keine Antwort erwartete, hatte er sie sich erspart."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2343499a-d9c7-3f3c-bd12-02b71bceb9da",
                                        "entry_id": "42daaffd-8279-37ec-9709-1c59b8c0a771",
                                        "glosses": [
                                            "geistig abwesend, nicht auf eine Sache konzentriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d212874f-7429-4dd3-96be-f37fc8ca8e40",
                                                "sense_id": "2343499a-d9c7-3f3c-bd12-02b71bceb9da",
                                                "text": "Jeden Sonntag ging er mit den Alten zur Kirche und saß dort still mit gedankenlosem Blick; […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170eb69b-8347-4d21-81ae-a21ac8ac295c",
                        "source_entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                        "source_sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                        "target_lang_word": "stupidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "In a stupid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd8f4e5-5e9f-4877-8a6c-f1f205cda69b",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "She was so modest, so expressive, she had looked so soft in her thin white gown that he felt he had acted stupidly."
                                            },
                                            {
                                                "example_id": "d05f7205-47ce-491a-b132-0e592d73b797",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "\"Don't we behave just as stupidly in our pursuit of happiness - don't we?\" Simpson nodded dejectedly."
                                            },
                                            {
                                                "example_id": "5d0e05f0-9b21-4a34-b7c6-6025be9b0dd3",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "As I write this, drivers' union ASLEF has announced yet another series of one-day strikes, because ministers are stupidly insisting that the modest below-inflation pay rise they have offered drivers still comes with strings attached over working conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "To an extreme or excessive degree; absurdly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6690e55-4632-4f57-960e-1a6c0826f602",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "He is so—so proud of his money, and thinks every one ought to be as stupidly rich as he is himself."
                                            },
                                            {
                                                "example_id": "5fdc3d65-7d18-4e8a-8b42-033c1b8a9787",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "As well as being stupidly hungry I had a raging thirst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9751818f-c0d6-4c27-a6dd-da4eb48d4d34",
                        "source_entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                        "source_sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                        "target_lang_word": "foolishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foolishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "In a foolish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54204a58-e657-437f-9889-75f85fe2fd74",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "He dressed foolishly to entertain the children."
                                            },
                                            {
                                                "example_id": "318ddac9-000a-4de7-8850-186e20c70e58",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "I never wish to offend, but I am so foolishly shy, that I often seem negligent, when I am only kept back by my natural aukwardness."
                                            },
                                            {
                                                "example_id": "21e51553-8547-4cc9-bf5f-47640497c46d",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "“Nothing to speak of,” said Adam Woodcock, answering for the boy—“a foolish quarrel with me, which was more foolishly told over again to my honoured lady, cost the poor boy his place.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "Without good judgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6ae2c0-6925-42e3-9b61-966c672840b3",
                                                "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                                "text": "Foolishly, he had decided that, because a home was the best investment, two homes were even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "065d6989-4cf0-44f1-8d64-56ebecb79208",
