                "senses": [
                    {
                        "sense_id": "e5fabdc3-7a3d-364f-9456-f776574306f4",
                        "entry_id": "5c262308-0756-3531-b73d-5f78f9a44509",
                        "glosses": [
                            "„Lehre von der Heilkraft des Magnetismus“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e65f25-6ab4-436b-83bd-d2c3d67ee04e",
                                "sense_id": "e5fabdc3-7a3d-364f-9456-f776574306f4",
                                "text": "„Da gab es eine Broschüre über Mesmerismus, die allem Anschein nach reichlich oft benutzt worden war.“"
                            },
                            {
                                "example_id": "bc734bcf-e68d-436a-8e34-0011686935de",
                                "sense_id": "e5fabdc3-7a3d-364f-9456-f776574306f4",
                                "text": "„Interessanterweise griffen viele Naturforscher und Ärzte unter dem Eindruck des Mesmerismus noch in der Mitte des 19. Jahrhunderts auf die Tradition der antiken Traumdeutung zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc48a8f7-ada4-4b29-92e5-529db13dbe63",
                        "source_entry_id": "5c262308-0756-3531-b73d-5f78f9a44509",
                        "source_sense_id": "e5fabdc3-7a3d-364f-9456-f776574306f4",
                        "target_lang_word": "mesmerism",
