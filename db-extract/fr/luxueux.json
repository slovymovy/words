                    {
                        "translation_id": "4c86c2fb-b7b3-4ee0-8bd5-fcaef2d937a7",
                        "source_entry_id": "e7591ff1-3f0d-3f95-a0f8-f218224ffbd3",
                        "source_sense_id": "a9fbf386-2a81-338d-8fe6-b01c7dc8305a",
                        "target_lang_word": "роскошный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "роскошный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "870f8068-2b23-30ee-af39-39e2c1947163",
                                        "entry_id": "2bc13213-783d-3e95-8291-29cfa4f203f5",
                                        "glosses": [
                                            "отличающийся роскошью, великолепием в отделке, убранстве"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f23991-b09f-4043-832f-7b00c556c190",
                                                "sense_id": "870f8068-2b23-30ee-af39-39e2c1947163",
                                                "text": "Жил верстах в десяти от рудника, в роскошном барском поместьи с огромным садом, и приезжал на рудник в коляске с тройкою лошадей и кучером в бархатной безрукавке, с павлиньими перьями на круглой шляпе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "894743a6-1cd8-3ae7-af3c-43eccd7eeb68",
                                        "entry_id": "2bc13213-783d-3e95-8291-29cfa4f203f5",
                                        "glosses": [
                                            "свойственный богатым людям, сопровождающийся большой тратой денег"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6821fecd-0770-402c-b2cd-37d5ba5a7371",
                                                "sense_id": "894743a6-1cd8-3ae7-af3c-43eccd7eeb68",
                                                "text": "― Обрати внимание, Вера, ― говорил Бунин, держа в руке мои сочинения и кивая на меня головой, ― как и все начинающие, он воображает, что литература принесет ему славу, деньги, роскошную жизнь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b88c9982-556e-3129-9c2d-d73978252a51",
                                        "entry_id": "2bc13213-783d-3e95-8291-29cfa4f203f5",
                                        "glosses": [
                                            "удовлетворяющий высшим требованиям; вызывающий восхищение своей красотой, превосходный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c654a8-37d0-4756-89ce-6212a9a91f7f",
                                                "sense_id": "b88c9982-556e-3129-9c2d-d73978252a51",
                                                "text": "Природа постаралась и обрамила его широкое лицо роскошной седеющей гривой, чтобы придать ему сходство со львом…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af39376-4f34-397e-a0c1-cdf8def26ab9",
                                        "entry_id": "2bc13213-783d-3e95-8291-29cfa4f203f5",
                                        "glosses": [
                                            "перен. изобильный, цветущий, пышный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03687e75-17bd-4060-b5a8-f709b77403de",
                                                "sense_id": "0af39376-4f34-397e-a0c1-cdf8def26ab9",
                                                "text": "Кругом на сотни километров без просветов тогда ещё тянулся сплошной роскошный хвойный лес."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
