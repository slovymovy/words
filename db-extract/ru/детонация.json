                    },
                    {
                        "translation_id": "99d65ab2-c0ea-4d26-a01b-7f320eb83b8a",
                        "source_entry_id": "b75302d8-cf0b-39f0-9c0c-79625483acbf",
                        "source_sense_description": "взрыв",
                        "target_lang_word": "Detonation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Detonation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                        "entry_id": "cd5bd1d3-d415-3690-854b-4de14214d7c3",
                                        "glosses": [
                                            "heftige Explosion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396a7ea9-f395-46d5-bfbf-ad987750c59b",
                                                "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                                "text": "Die Detonation war noch kilometerweit zu hören."
                                            },
                                            {
                                                "example_id": "ba40da6d-d2e8-429f-b624-e9bf6606798e",
                                                "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                                "text": "„Detonationen sind zu hören.“"
                                            },
                                            {
                                                "example_id": "7cf49211-77b1-4778-826a-166c7c0b8864",
                                                "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                                "text": "„Die Detonation hörte sich an, als würde ein Hammer ohne jeden Hall, ja fast ohne alle Luftschwingungen auf ein anderes Stück Metall schlagen - dumpf, trocken, schwer.“"
                                            },
                                            {
                                                "example_id": "6aa1bddb-5f65-43c0-aeba-ecf99732953e",
                                                "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                                "text": "„Es gab eine Detonation, und der Rückschlag riß mir fast die Waffe aus der Hand.“"
                                            },
                                            {
                                                "example_id": "9caed744-3aec-48d6-9097-4e9b0927d970",
                                                "sense_id": "eb64b01d-5e2e-3b25-831b-f4d085ef73a6",
                                                "text": "„Auf die Minute genau ließ eine fürchterliche Detonation die ganze Insel erzittern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f30e2c21-e571-3b31-a3f3-e9ce1470791e",
                                        "entry_id": "cd5bd1d3-d415-3690-854b-4de14214d7c3",
                                        "glosses": [
                                            "unreines Singen oder Musizieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370afa00-c04b-4b93-bbf6-6605a303b797",
                                                "sense_id": "f30e2c21-e571-3b31-a3f3-e9ce1470791e",
                                                "text": "Die Detonation vieler im Stimmbruch befindlicher jugendlicher Sänger war nicht zu überhören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03757875-8714-4df1-a592-74a4c2417b09",
                        "source_entry_id": "b75302d8-cf0b-39f0-9c0c-79625483acbf",
                        "source_sense_description": "взрыв",
                        "target_lang_word": "détonation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détonation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                        "entry_id": "c6fe62fb-f510-3a4d-a923-d22f319c53d5",
                                        "glosses": [
                                            "Explosion violente et subite accompagnée de bruit, telle que celle de la poudre à canon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90a754b-d724-4d3a-9e06-90044bd6eb6a",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Il épaula d'un air délibéré, un éclair jaillit, la forêt répercuta sourdement la détonation. L'aigle battit des ailes, un instant il parut encore soulevé par l'air, puis il tomba lourdement comme une pierre."
                                            },
                                            {
                                                "example_id": "7cfca5e4-b4e9-4b17-b070-5e7ad978670e",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Des détonations retentissaient incessamment, comparables aux décharges continues d'une formidable artillerie."
                                            },
                                            {
                                                "example_id": "a95d1f4e-3ece-49c7-abd1-80c9f270b8a9",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Je chassais dans la montagne lorsque j'entendis des détonations irrégulières et continues; je compris qu'il s'agissait de quelque attaque à main armée, […]."
                                            },
                                            {
                                                "example_id": "bc914c29-2ee9-47db-8c08-cad46bc6688c",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Et il ajusta le chien, le pauvre chien, le lamentable chien qui avait délaissé son os, […] ; les femmes se bouchaient les oreilles pour ne pas entendre la détonation ; […]."
                                            },
                                            {
                                                "example_id": "7fc4f114-4650-4f43-8dbb-bcdaab1a3565",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Une assourdissante détonation partit du zénith, et l’aéronat décrivit une terrible embardée."
                                            },
                                            {
                                                "example_id": "e5d48669-77bd-44c2-a6e3-111f7fc614d1",
                                                "sense_id": "ce431b9e-5314-30e4-afb0-23edb159c9aa",
                                                "text": "Un adolescent est retiré de la file. Juste avant qu'une forte détonation venue d'une tour militaire l’envoie bouler sur l’asphalte, la tête broyée par une balle de mitrailleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
