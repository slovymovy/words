                ],
                "senses": [
                    {
                        "sense_id": "151218bb-abfb-3c43-ac6a-10557e4a76f8",
                        "entry_id": "a1f5eb80-9ca9-3de7-b3b6-865c7e1aeda4",
                        "glosses": [
                            "Möbelstück für einen Büroraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7497e9-48a6-4436-bf36-849f20b94c1f",
                                "sense_id": "151218bb-abfb-3c43-ac6a-10557e4a76f8",
                                "text": "Ich habe im Internet neue Büromöbel bestellt."
                            },
                            {
                                "example_id": "9b14b794-c690-4e25-b118-9dc90ad293af",
                                "sense_id": "151218bb-abfb-3c43-ac6a-10557e4a76f8",
                                "text": "„Mit einem Umsatzplus um 12 Prozent auf 2,5 Milliarden Euro waren die Büromöbel im vergangenen Jahr der wachstumsstärkste Bereich in der deutschen Möbelbranche.“"
                            },
                            {
                                "example_id": "6992ec4e-5114-49d6-bfed-d8263e40a28e",
                                "sense_id": "151218bb-abfb-3c43-ac6a-10557e4a76f8",
                                "text": "„Nur wenige Tage vor der Eröffnung des Frankfurter Museums für Komische Kunst (MKK) sind gerade einmal die Büromöbel für den Museumsleiter Frenz und dessen Mitarbeiter geliefert worden – doch als einzige Mitarbeiterin gibt es seit Anfang September eine Sekretärin.“"
                            },
                            {
                                "example_id": "17fc9fa7-ce7e-4c99-af26-60568d4fe177",
                                "sense_id": "151218bb-abfb-3c43-ac6a-10557e4a76f8",
                                "text": "„Sich ein Arbeitszimmer einzurichten, es mit Büromöbeln und -materialien auszustatten ist dann das Privatvergnügen des Arbeitnehmers und geschieht im Interesse seiner individuellen Freiheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
