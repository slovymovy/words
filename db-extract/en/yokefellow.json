    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1a32fa97-a9e4-32ba-9490-88c76a573f63",
                "word": "yokefellow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6791519d-d2e7-4108-8d26-24310f0e8814",
                        "entry_id": "1a32fa97-a9e4-32ba-9490-88c76a573f63",
                        "tags": [
                            "plural"
                        ],
                        "form": "yokefellows"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcefe7d6-b9e9-3b0a-bca3-2b1a6b81faf1",
                        "entry_id": "1a32fa97-a9e4-32ba-9490-88c76a573f63",
                        "glosses": [
                            "A companion; a fellow labourer, a person who works at the same task as another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116ff20c-7c23-41e7-b729-53f3f5436e21",
                                "sense_id": "bcefe7d6-b9e9-3b0a-bca3-2b1a6b81faf1",
                                "text": "I’ll see their trial first. Bring in their evidence. / [To Edgar] Thou, robed man of justice, take thy place. / [To the Fool] And thou, his yokefellow of equity, / Bench by his side."
                            },
                            {
                                "example_id": "0ad387bb-2c2a-4b37-9325-9216e248da43",
                                "sense_id": "bcefe7d6-b9e9-3b0a-bca3-2b1a6b81faf1",
                                "text": "“[…] If two people like each other, why shouldn’t they consent to live together?” / “They tire of each other—they tire of each other in a month. A yokefellow is not a companion; he or she is a fellow-sufferer.”"
                            },
                            {
                                "example_id": "7fc91366-d2c5-4c81-ac68-357b741098a2",
                                "sense_id": "bcefe7d6-b9e9-3b0a-bca3-2b1a6b81faf1",
                                "text": "Brain and hand, and means and muscle, are true yokefellows in modern industrialism. Without the inventor, there could be no machinery..."
                            },
                            {
                                "example_id": "917b8cd4-1670-4005-887b-bbe71e6260d0",
                                "sense_id": "bcefe7d6-b9e9-3b0a-bca3-2b1a6b81faf1",
                                "text": "Jesus treats his disciples as yokefellows rather than as camels and donkeys to be loaded down (23:4)."
                            }
                        ]
                    },
                    {
                        "sense_id": "01f51629-3392-3086-93d5-2bb90c8ace3c",
                        "entry_id": "1a32fa97-a9e4-32ba-9490-88c76a573f63",
                        "glosses": [
                            "Someone joined in marriage to another; a spouse."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5de48b52-5472-46e5-9fac-803659ec80c0",
                                "sense_id": "01f51629-3392-3086-93d5-2bb90c8ace3c",
                                "text": "[H]is industrious yoke-fellow executed every circumstance of the plan she had projected; so that, when he recovered his vision, he was an utter stranger in his own house."
                            },
                            {
                                "example_id": "90753e4b-425d-43bb-8123-fd01426a7742",
                                "sense_id": "01f51629-3392-3086-93d5-2bb90c8ace3c",
                                "text": "...till new grounds of quarrel had arisen between the two unequal yokefellows who were at last fully coupled together."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
