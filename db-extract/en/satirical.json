                        "glosses": [
                            "Of, pertaining to, or connected with satire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25a9e03-2640-42cd-bb8c-f857471eec92",
                                "sense_id": "9393451e-0fda-3396-829c-6ffa45891d81",
                                "text": "Spitting Image was a famous satirical television program."
                            },
                            {
                                "example_id": "84e2b47c-add8-45ff-a047-649ff53fb535",
                                "sense_id": "9393451e-0fda-3396-829c-6ffa45891d81",
                                "text": "Given his remarks in The English People about the dangers of Standard English, and the fact that the satirical Newspeak of Nineteen Eighty-Four is an engineered language[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c185551-73f3-4e76-8c91-ecb3b7682f90",
