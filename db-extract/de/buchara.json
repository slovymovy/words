                    {
                        "translation_id": "77f8df8e-4836-4918-9a83-3f69f50d509a",
                        "source_entry_id": "80eb0bff-485b-3d6e-80a1-3d2a72324cbf",
                        "source_sense_id": "de2ef651-609e-314c-8a4d-63fe81be2ce5",
                        "source_sense_description": "Stadt in Usbekistan",
                        "target_lang_word": "Boukhara",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boukhara",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31e3fc10-a8d2-35ec-863b-912715fa78f0",
                                        "entry_id": "74716a4d-6c11-351c-a97e-8054620563dd",
                                        "glosses": [
                                            "Ville d’Ouzbékistan, au centre-sud du pays, capitale de la province du même nom, sur le cours inférieur de la rivière Zarafshan, au milieu d’une oasis, à la limite orientale du désert de Kyzyl Kum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008a7f61-fffe-443f-8b52-a5cef62cfe59",
                                                "sense_id": "31e3fc10-a8d2-35ec-863b-912715fa78f0",
                                                "text": "KANETI, lieu du Turkestan, sur la route de Boukhara à Khokand, célèbre par une grande victoire d’Abdallah-Saheb-Kéran, kan de Boukhara, sur les kans de Tachkond, du Turkestan et de Kaptchak, en 1569."
                                            },
                                            {
                                                "example_id": "2cf784e6-9664-4fdf-9b8a-77dc14e76290",
                                                "sense_id": "31e3fc10-a8d2-35ec-863b-912715fa78f0",
                                                "text": "Lorsque Nadir Châh revint de son expédition de l’Inde, Aboul Feïz Khan, fils de Soubhan Qouly Khan, descendant de Djenghiz Khan, était souverain de Boukhara. Ilbars Khan Qazaq, qui était aussi de la race de Djenghiz, gouvernait le Kharezm."
                                            },
                                            {
                                                "example_id": "6f9d2f3c-7eac-4063-91e9-5356202715d4",
                                                "sense_id": "31e3fc10-a8d2-35ec-863b-912715fa78f0",
                                                "text": "Abou-Taher est, en cette année 1072, l’un des rares dignitaires religieux à garder un rapport étroit avec le prince, il lui rend souvent visite dans la citadelle de Boukhara, sa principale résidence, il l’accueille avec solennité chaque fois qu’il s’arrête à Samarcande."
                                            },
                                            {
                                                "example_id": "ae8e5bcd-3c7c-43cf-af6d-4cb84cd9426c",
                                                "sense_id": "31e3fc10-a8d2-35ec-863b-912715fa78f0",
                                                "text": "C’est durant le règne de l’émir de Boukhara, Muzaffar-Ed-Din (1860-1885), que la broderie d’or atteint son apogée et sa renommée en termes de technique, de qualité et aussi de créativité de la part des maîtres artisans qui travaillaient dans l’atelier privé de l’émir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
