                    {
                        "translation_id": "c70c7cd0-4346-45cf-bf05-7d2812292a7c",
                        "source_entry_id": "65f6a346-03bf-37b9-aae2-15348cdef271",
                        "source_sense_id": "327a7604-965a-3ace-bb8f-52d1b7d326ac",
                        "target_lang_word": "kinderloosheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kinderloosheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "18731dc4-9644-3e8b-8e4c-ba821239e05f",
                                        "entry_id": "cd2b1f82-ca01-3055-81a6-67a691a18579",
                                        "glosses": [
                                            "het kinderloos zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175341ff-b3c3-4205-a181-b2e1069d1c07",
                                                "sense_id": "18731dc4-9644-3e8b-8e4c-ba821239e05f",
                                                "text": "Kinderloosheid is voor veel wat oudere echtparen een groot probleem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c17297f5-4cdb-409b-ba08-093f74dc9907",
                        "source_entry_id": "65f6a346-03bf-37b9-aae2-15348cdef271",
                        "source_sense_id": "327a7604-965a-3ace-bb8f-52d1b7d326ac",
                        "target_lang_word": "Kinderlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kinderlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                        "entry_id": "ba6c0f14-bac2-3d92-8e4a-a8668eef9414",
                                        "glosses": [
                                            "das Fehlen von unmittelbar eigener Nachkommenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09eaf51d-6dc5-4a2b-af7e-ae2fb573d09d",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Nicht nur in Deutschland, auch in anderen europäischen Ländern hat die Kinderlosigkeit stark zugenommen.“"
                                            },
                                            {
                                                "example_id": "b217be0a-429f-4150-ab26-9a64d96ed548",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Manche sehen in ihr die Ausgeburt einer egozentrischen Gesellschaft, für andere ist sie Ausdruck selbstbestimmter Lebensgestaltung: Kinderlosigkeit polarisiert und führt immer wieder zu erregten Diskussionen.“"
                                            },
                                            {
                                                "example_id": "26d014f8-a806-4ba6-939a-4d235ddb1def",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Die Frage der Kinderlosigkeit stellt sich in jeder Lebensphase neu.“"
                                            },
                                            {
                                                "example_id": "abfdd04b-b0a6-45ab-a9b0-aea62a585172",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Je nach Region und Generation ist ein anderer Faktor für Kinderlosigkeit in Europa dominant, sagen Forscher.“"
                                            },
                                            {
                                                "example_id": "b3c2fe1f-b84f-4c3f-a295-0c6a98ef7d8d",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Die Studienautoren erklären dies [nur eine Geburt] mit der zwar negativen Einstellung zu Kinderlosigkeit in den ehemaligen sozialistischen Ländern, gleichzeitig sei die Arbeitsbelastung der oft Vollzeit arbeitenden Eltern hoch, sodass sie auf weiteren Nachwuchs verzichteten.“"
                                            },
                                            {
                                                "example_id": "f8e2f880-fafc-427b-8a04-780e7e219f23",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Zuletzt etwa, als im März eine Studie der Universität Bochum erschien, in der Kinderlosigkeit als ‚Trittbrettfahrerverhalten‘ bezeichnet wird – schließlich sparten sich Kinderlose die Aufwendungen für Erziehung und Ausbildung, gleichzeitig könnten sie mehr arbeiten und dadurch höhere Pensionsansprüche erwerben.“"
                                            },
                                            {
                                                "example_id": "142b7017-9a12-49aa-9ecc-27b19384984d",
                                                "sense_id": "fc51c24a-7a90-3e5d-9d65-eec3349a684c",
                                                "text": "„Ungewollte Kinderlosigkeit ist ein so intimes Thema, das nur schwer öffentlich zu diskutieren ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
