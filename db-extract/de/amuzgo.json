                "senses": [
                    {
                        "sense_id": "1d7eb82c-c971-3c25-b941-1369ce496b0e",
                        "entry_id": "1f7a2cfe-055f-3ec2-966f-fe35ad40fd3a",
                        "glosses": [
                            "Sprache des gleichnamigen indigenen Volks in Zentralamerika, von der 4 Varietäten anerkannt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeba1210-a5f8-45b8-ac1b-9dfd9c8be6f0",
                                "sense_id": "1d7eb82c-c971-3c25-b941-1369ce496b0e",
                                "text": "„Die Otomí-Sprache […] gehört […] zu den Oto-Pame-Sprachen, die wiederum zu den Otomangue-Sprachen (zusammen mit Amuzgo, Chinantekisch, Mixtekisch, Popoloca, Tlapanekisch und Zapotekisch).“"
                            },
                            {
                                "example_id": "0935e3e5-73aa-43dd-97bb-ca0afc2c159b",
                                "sense_id": "1d7eb82c-c971-3c25-b941-1369ce496b0e",
                                "text": "„[…] mythologisch gerechtfertigt werden, da sie das Böse verkörpern, war das Dorf intern bis vor ca. 150 Jahren gut integriert und funktionierte mit seinen traditionellen Normen und einer eigenen Sprache, dem lokalen Dialekt des Amuzgo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
