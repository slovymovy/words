                                        "sense_id": "060a1538-fc4e-3f1a-92cf-02a6c7d04ee8",
                                        "entry_id": "1d5fe8d4-73af-3be9-b8b3-8ab951ec2b57",
                                        "glosses": [
                                            "Féminin singulier de le. Représente un groupe nominal féminin singulier complément d’objet direct (pour le pronom féminin complément d’objet indirect, voir lui)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b2c727-5d19-4ae3-955f-7ce17c0af758",
                                                "sense_id": "060a1538-fc4e-3f1a-92cf-02a6c7d04ee8",
                                                "text": "Je la reconnais et non pas Je reconnais elle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "la",
                                "target_lang_code": "fr",
                                "target_senses": [
