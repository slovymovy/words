                "senses": [
                    {
                        "sense_id": "ba88d4fd-256b-3c79-b46b-c87f68bde434",
                        "entry_id": "88806d73-b7b2-3f71-821c-e48dce3b2d4b",
                        "glosses": [
                            "elektrisch angetriebenes Automobil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3a6b2a-3611-4ecc-92fa-790ccf51428e",
                                "sense_id": "ba88d4fd-256b-3c79-b46b-c87f68bde434",
                                "text": "Unsere Firmenflotte besteht fast komplett aus E-Autos."
                            },
                            {
                                "example_id": "edf2ba5a-3952-4081-a1bd-9130b62e7223",
                                "sense_id": "ba88d4fd-256b-3c79-b46b-c87f68bde434",
                                "text": "Den alten Benziner haben wir verkauft, wir fahren jetzt ein E-Auto."
                            },
                            {
                                "example_id": "a8d6c079-c951-4ad6-a8f7-249960bbbf24",
                                "sense_id": "ba88d4fd-256b-3c79-b46b-c87f68bde434",
                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                            }
                        ],
