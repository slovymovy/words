                ],
                "senses": [
                    {
                        "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                        "entry_id": "70b21280-d7f6-311b-bb39-517cc1669a0d",
                        "glosses": [
                            "chemisches Mittel zur Oberflächenreinigung von Polymeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11bd5cfd-1203-47e8-8217-bb42b6f7dcd7",
                                "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                                "text": "„Unser Kunststoffreiniger entfaltet seine hohe Wirksamkeit natürlich nicht nur bei der Außenpflege des Fahrzeugs, sondern auch innen.“"
                            },
                            {
                                "example_id": "04e61bad-771d-4acd-a39a-626c6c837a13",
                                "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                                "text": "„Der Kunststoffreiniger löst mit seiner Schaumfunktion selbst hartnäckigen Schmutz und reinigt kraftvoll alle Kunststoff-Oberflächen, pflegt sie und lässt sie wie neu aussehen.“"
                            },
                            {
                                "example_id": "5bd07c06-5f2c-4563-80e3-ec3867dbdbad",
                                "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                                "text": "„Bei stärkeren Verschmutzungen durch Rauch und Autoabgase normale fettlösende Küchenreiniger oder spezielle Kunststoffreiniger aus dem Baumarkt.“"
                            },
                            {
                                "example_id": "d54e5efb-fd98-4112-afcd-b53485d67834",
                                "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                                "text": "„In der heutigen Zeit gibt es immer mehr Gegenstände in einem Haushalt, die aus Kunststoff gemacht sind. Demzufolge ist ein gründlicher Hausputz ohne den richtigen Kunststoffreiniger gar nicht mehr möglich.“"
                            },
                            {
                                "example_id": "a37e37e9-ee06-4b3a-a5a3-231eb1bdbcba",
                                "sense_id": "12c2baa5-0ad3-3388-8deb-8a48768af69a",
                                "text": "„Swissvax Plastic Wash ist ein hochwirksamer und effizienter Kunststoffreiniger für jegliche Kunststoffarten im Innenraum, Motorraum und/oder Fahrzeug aussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
