                        "entry_id": "5b92d24b-5991-335d-b10a-3ebfcb78ebe4",
                        "glosses": [
                            "weibliche Person, die verdächtigt wird, eine Tat begangen zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28528c07-f0fc-4538-880a-2778fc6e2a10",
                                "sense_id": "f27f79f8-86cb-3b25-afd8-f88affd14fff",
                                "text": "Frau M. gilt momentan als Tatverdächtige in einem Doppelmord von einem älteren Ehepaar."
                            },
                            {
                                "example_id": "6cb3e215-dd2a-4448-9de0-930d551c8e5b",
                                "sense_id": "f27f79f8-86cb-3b25-afd8-f88affd14fff",
                                "text": "„Er hätte seine Tochter als Tatverdächtige vorladen, schlimmstenfalls gegen sie ermitteln müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
