                                "example_id": "054f63f9-8ad7-45cb-abb5-36e1680fc1ff",
                                "sense_id": "7057cf9c-6d11-34aa-86b2-1ff7cc4bd0d4",
                                "text": "On ne lit plus, ô mon cher imprimeur-libraire! on ne lit plus que les journaux"
                            },
                            {
                                "example_id": "82f528fe-7162-4f03-ac1d-dd0fa6139b66",
                                "sense_id": "7057cf9c-6d11-34aa-86b2-1ff7cc4bd0d4",
                                "text": "Léon Bellé, libraire-imprimeur à Lagny"
                            }
                        ]
                    }
