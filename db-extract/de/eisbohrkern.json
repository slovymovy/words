                "senses": [
                    {
                        "sense_id": "3b368ba6-d948-3fe0-905a-0c45018691a7",
                        "entry_id": "6c3776ce-83c5-3b0f-9f09-a95f5b1ade51",
                        "glosses": [
                            "Probe aus einem Eisschild oder Gletscher, die durch Bohrung gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df98189-aadc-48c2-a2b0-c2bf4d41bfd1",
                                "sense_id": "3b368ba6-d948-3fe0-905a-0c45018691a7",
                                "text": "„Forschende wollten Klimadaten von einem Eisbohrkern aus den Schweizer Alpen ablesen - und stellten überrascht fest, dass das Klimaarchiv unbrauchbar war.“"
                            },
                            {
                                "example_id": "d2d7e2b7-f57d-4d5e-af63-69b5fac0fe14",
                                "sense_id": "3b368ba6-d948-3fe0-905a-0c45018691a7",
                                "text": "„Aus Eisbohrkernen ist bekannt, dass die atmosphärische CO2-Konzentration innerhalb der vergangenen 800 Tausend Jahre lediglich zwischen etwa 200 und 300 ppm (parts per million) schwankte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
