                                    {
                                        "sense_id": "83f17f25-2a61-3331-9b8e-35decc8af8bc",
                                        "entry_id": "2eecc561-a7a6-34d3-8d2d-9fda5f4884bb",
                                        "glosses": [
                                            "Küchengerät, um Konservendosen zu öffnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccbf4c6a-4aea-4b80-8486-9a05ed8d671c",
                                                "sense_id": "83f17f25-2a61-3331-9b8e-35decc8af8bc",
                                                "text": "Gibst du mir mal den Büchsenöffner?"
                                            },
                                            {
                                                "example_id": "938f56b6-986a-40e6-bb8c-ed73cabc5065",
                                                "sense_id": "83f17f25-2a61-3331-9b8e-35decc8af8bc",
                                                "text": "„In der Schublade befand sich ein Büchsenöffner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f347b63-83d4-4c77-a0b0-97148e6c0a05",
                        "source_entry_id": "cf9b70f6-d8e1-3279-9316-606e81b69c23",
                        "source_sense_id": "26349c98-2190-3323-90dc-f3e9ba8c30b3",
                        "target_lang_word": "Dosenöffner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dosenöffner",
