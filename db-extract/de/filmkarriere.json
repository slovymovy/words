                "senses": [
                    {
                        "sense_id": "742e9417-a638-3a9d-b961-9f0d43cb7867",
                        "entry_id": "f33641bc-9b30-3231-b987-c537dff3f500",
                        "glosses": [
                            "(erfolgreicher) Werdegang eines Filmschauspielers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614644c3-edae-4989-928e-8d1f4ad2685d",
                                "sense_id": "742e9417-a638-3a9d-b961-9f0d43cb7867",
                                "text": "„Über soziale Aktivitäten stieg Temple nach ihrer Filmkarriere in die Politik ein.“"
                            },
                            {
                                "example_id": "a70fd9fb-e6bd-46aa-a456-3ea7b981bf82",
                                "sense_id": "742e9417-a638-3a9d-b961-9f0d43cb7867",
                                "text": "„Colin Firth ist schon viel länger da, als wir ahnen: Seine Filmkarriere reicht weiter zurück als unser Gedächtnis.“"
                            },
                            {
                                "example_id": "f69fcb6f-a866-49fa-a295-8f93a750ce20",
                                "sense_id": "742e9417-a638-3a9d-b961-9f0d43cb7867",
                                "text": "„Nach ihrer Filmkarriere feierte die über Siebzigjährige in den Nachtclubs von Las Vegas, in den Theatern und Konzertsälen Amerikas und Europas als Chanson-Sängerin Triumphe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
