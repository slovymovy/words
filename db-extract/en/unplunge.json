                        "sense_id": "f0591780-a341-35c1-a2a5-b2f7abe55c8b",
                        "entry_id": "ad183244-8322-3501-b752-28dc697cca0b",
                        "glosses": [
                            "To plunge back out of something; to emerge suddenly."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89ff565b-f63a-4a72-a3ed-4ed8d6fe8760",
                                "sense_id": "f0591780-a341-35c1-a2a5-b2f7abe55c8b",
                                "text": "After that he plunges into a dark-room to develop the picture, unplunges indefatigably into the sunlight to print it, enlarge it, reduce it, stick it in, unstick it, stick it in straight, unstick himself, […]"
                            },
                            {
                                "example_id": "4641af32-b744-42e7-8c6b-dec0e0407e20",
                                "sense_id": "f0591780-a341-35c1-a2a5-b2f7abe55c8b",
                                "text": "The crucial image for Cocteau's oeuvre of the poet unplunging out of the mirror in Le sang d'un poète (1930) has its origins in this very poem."
                            }
                        ]
                    }
