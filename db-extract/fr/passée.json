                        "form": "passées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc8865b8-86d8-374e-bd24-5bb9be5eda3b",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
                            "Action de passer. Passage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5bdab1-bf3d-4ff3-ab38-c114d90e464f",
                                "sense_id": "cc8865b8-86d8-374e-bd24-5bb9be5eda3b",
                                "text": "Les passées de l'ouragan, comme dans une chevelure fragile, ouvraient de rapides et fugitives tranchées dans la masse des arbres gris qu'elles écartaient comme des herbes, et l'on voyait alors l'espace d'une seconde un sol nu, des rocs noirs, les fissures étroites des ravins."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb4e00fe-8054-3da7-85a6-6701bb6cd496",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
                            "Moment du soir où les bécasses se lèvent du bois pour se diriger vers les champs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5db6b86-4eee-4c87-83ac-e748a3c40473",
                                "sense_id": "eb4e00fe-8054-3da7-85a6-6701bb6cd496",
                                "text": "Tuer, prendre des bécasses à la passée. Voici bientôt l’heure de la passée."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a2d9ff6-9654-36ba-aa8c-2e8e6e42a4b1",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
                            "Grand filet pour prendre les bécasses."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5c0b9fd2-213c-3d4a-8367-9bd6820be1e5",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
                            "Trace laissée, en passant, par certaines bêtes fauves, le cerf, le daim, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1532d380-f96a-4598-b77e-dfbcd79f13f9",
                                "sense_id": "5c0b9fd2-213c-3d4a-8367-9bd6820be1e5",
                                "text": "Une centaine de ces rongeurs, dont la passée se reconnaissait aisément sur la neige, grossirent bientôt les réserves du fort."
                            },
                            {
                                "example_id": "13505c7a-3d00-4b91-8a8b-e38f60316052",
                                "sense_id": "5c0b9fd2-213c-3d4a-8367-9bd6820be1e5",
                                "text": "A sa gauche, s’ouvre la rue Belhomme. Il l’enquille, telle la bête de chasse reprenant sa passée."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a6d1021-e9c8-3199-99d3-c5017791da53",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
                            "Mouvement de va-et-vient d'une navette."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4133452b-6cd6-3a0b-acc6-0149fca9b8a0",
                        "entry_id": "3da4877d-b6ab-3fb0-a358-d07838e03102",
                        "glosses": [
