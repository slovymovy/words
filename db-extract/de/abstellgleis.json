                "senses": [
                    {
                        "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                        "entry_id": "6f46bc65-788f-366e-9a44-c2cfa663db18",
                        "glosses": [
                            "Gleis, auf dem Eisenbahnfahrzeuge abgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd220f59-e876-48b4-a812-d3d6d89d649c",
                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                "text": "Eisenbahn-Starterset mit Güterzug und Abstellgleis."
                            },
                            {
                                "example_id": "8dcda004-e2ce-420e-9793-9cde9217b46e",
                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                "text": "„Sie haben uns auf ein Abstellgleis geschoben.“"
                            },
                            {
                                "example_id": "4fe8c9a5-f72e-4d99-a334-70568a494343",
                                "sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                                "text": "„Vielleicht war es ihnen obendrein gelungen, auf den Bahngleisen ein paar heruntergefallene Briketts oder Steinkohlebrocken aufzusammeln oder – der Herrgott drücke ein Auge zu! – von lässlich bewachten Waggons auf den Abstellgleisen der Reichsbahn zu stehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df3052ca-7ca8-44f9-8caa-211d857d70f9",
                        "source_entry_id": "6f46bc65-788f-366e-9a44-c2cfa663db18",
                        "source_sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
                        "source_sense_description": "Gleis, auf dem Eisenbahnfahrzeuge abgestellt werden",
                        "target_lang_word": "siding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7630c3-ea88-3dcb-affc-7519e400d7f6",
                                        "entry_id": "230a05f0-41fa-3a0f-ae89-b4c886a93475",
                                        "glosses": [
                                            "A building material which covers and protects the sides of a house or other building."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d3f20c-d314-488e-bafd-e139160da1d3",
                                                "sense_id": "fd7630c3-ea88-3dcb-affc-7519e400d7f6",
                                                "text": "Ugh. If there's one thing I can't stand it's cheesy vinyl siding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "siding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b87b0b11-9905-3ed4-82f4-66dae5cbf5da",
                                        "entry_id": "04e8f33a-2dba-3b6c-98de-75f6f7bf3b6d",
                                        "glosses": [
                                            "present participle and gerund of side"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a34bff-1ca1-4442-9b8b-62ad040331c4",
                                                "sense_id": "b87b0b11-9905-3ed4-82f4-66dae5cbf5da",
                                                "text": "Whenever he hears an argument, he can't help siding with one party or the other."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "siding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4a77f3-830d-3fb5-9093-2ec9ed4dd41a",
                                        "entry_id": "2f30976d-0aa7-33bd-9d39-b71ce865f182",
                                        "glosses": [
                                            "A second, relatively short length of track just to the side of a railroad track, joined to the main track by switches at one or both ends, used either for loading or unloading freight, storing trains or other rail vehicles; or to allow two trains on a same track to meet (opposite directions) or pass (same direction) (the latter sense is probably an American definition)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec38bb9-fb74-4847-b622-cbe26a6e73a0",
                                                "sense_id": "9e4a77f3-830d-3fb5-9093-2ec9ed4dd41a",
                                                "text": "They slept where they could, sometimes in an empty truck on a siding near the station, sometimes in a cart behind a warehouse; [...]"
                                            },
                                            {
                                                "example_id": "4b8b86d8-95d8-4fe3-874b-bafecb6b33cf",
                                                "sense_id": "9e4a77f3-830d-3fb5-9093-2ec9ed4dd41a",
                                                "text": "Laid out over six square kilometres, Sellafield is like a small town, with nearly a thousand buildings, its own roads and even a rail siding – all owned by the government, and requiring security clearance to visit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2159488-4baa-4f4d-98e9-3bd759f4d90a",
                        "source_entry_id": "6f46bc65-788f-366e-9a44-c2cfa663db18",
                        "source_sense_id": "89f7319c-a375-37f5-800b-3fcb4cf45143",
