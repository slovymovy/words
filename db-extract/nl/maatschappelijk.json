                "senses": [
                    {
                        "sense_id": "7644b242-30cf-3bfd-a2f8-4e59b66f0bb0",
                        "entry_id": "47a94ff8-18f8-3fd4-baee-be5494f6bf6b",
                        "glosses": [
                            "op de maatschappij betrekking hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b091bf-e575-4266-968d-e2d80e0812cc",
                                "sense_id": "7644b242-30cf-3bfd-a2f8-4e59b66f0bb0",
                                "text": "Misdaad is een maatschappelijk verschijnsel waar alle regeringen mee worstelen."
                            },
                            {
                                "example_id": "aab13166-13bb-4e78-85bb-f3f8eac82343",
                                "sense_id": "7644b242-30cf-3bfd-a2f8-4e59b66f0bb0",
                                "text": "Hij had zijn kinderen veel belangrijke waarden meegegeven, zijn liefde voor muziek en het belang van maatschappelijke verantwoordelijkheid."
                            },
                            {
                                "example_id": "def447dd-776f-4fe5-9fa2-4adff26672d3",
                                "sense_id": "7644b242-30cf-3bfd-a2f8-4e59b66f0bb0",
                                "text": "Buikhuisen kwam eind jaren 70 in opspraak nadat hij had aangekondigd onderzoek te willen doen naar de rol die erfelijkheid speelt bij crimineel gedrag. Buikhuisen was op dat moment werkzaam als hoogleraar criminologie aan de Universiteit van Leiden. Zowel in het maatschappelijk debat als onder zijn collega's kregen zijn onderzoeksvoorstellen felle kritiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4f6299f-71dc-4c77-bffa-6baae757ac04",
                        "source_entry_id": "47a94ff8-18f8-3fd4-baee-be5494f6bf6b",
                        "source_sense_id": "7644b242-30cf-3bfd-a2f8-4e59b66f0bb0",
                        "source_sense_description": "op de maatschappij betrekking hebbend",
                        "target_lang_word": "gesellschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesellschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                        "entry_id": "ce2f37d0-5788-32b1-a23b-f04be7ec8e4f",
                                        "glosses": [
                                            "die sozialen und wirtschaftlichen Verhältnisse einer Gruppe von Personen oder eine Gesellschaft als Ganzes betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585e5a4a-5ea4-4977-8919-7a3c3966fb46",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "Gewalt unter Jugendlichen ist auch ein gesellschaftliches Problem."
                                            },
                                            {
                                                "example_id": "6cdcb82c-907a-406b-9061-ac666b3250e4",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "\"Uns fehlt eine Willkommenskultur für Kinder\", das ist das Fazit von Cornelia Spachtholz, Vorstandsvorsitzende des Verbands berufstätiger Mütter. Kinder erziehen - also bilden und betreuen - sei über die elterliche Verantwortung hinaus eine gesamtgesellschaftliche Aufgabe."
                                            },
                                            {
                                                "example_id": "f3d0e59c-297b-4c84-862c-32fdfad37441",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "\"In Frankreich ist es normal, dass die Mutter arbeiten geht, das ist gesellschaftlich akzeptiert, sie müssen sich im Gegensatz zu uns hier dafür nicht rechtfertigen und werden nicht als Rabenmütter bezeichnet."
                                            },
                                            {
                                                "example_id": "85b9093b-bc2f-42a7-9801-48094f84d950",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "\"Wenig wird sich ändern\", sagt er [Claus Wesslau]. \"Es sei denn, wir wagen den Bruch mit dem, was bislang gesellschaftlicher Konsens war.\""
                                            },
                                            {
                                                "example_id": "8dea5ac7-2a03-4a78-ab94-bf4d5e39e3b1",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "Nach der Geburt jedes ihrer Kinder ist Isabel Gronack-Walz schnell wieder arbeiten gegangen. Als ihre erste Tochter vor 16 Jahren auf die Welt kam, fiel ihr diese Entscheidung nicht leicht, erinnert sich Gronack-Walz. Aber dem gesellschaftlichen Druck hielt sie stand."
                                            },
                                            {
                                                "example_id": "3e37266d-6c7a-4ff5-8747-01415129de92",
                                                "sense_id": "e1ea8a19-5b9f-3e3e-8b0a-cdddcb987d73",
                                                "text": "„Noch stärker als bisher müssen Sprachwissenschaft und Sprachdidaktik dazu beitragen, die mit kultureller Diversität und intrakulturellen Sprachdifferenzen verbundenen gesellschaftlichen Herausforderungen zu gestalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d8891d4-fa18-3b9f-981d-3af699848379",
                                        "entry_id": "ce2f37d0-5788-32b1-a23b-f04be7ec8e4f",
                                        "glosses": [
                                            "in der Gesellschaft üblich, das Benehmen und die Umgangsformen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6def12d-2e96-4828-8c60-b29830b16b97",
                                                "sense_id": "0d8891d4-fa18-3b9f-981d-3af699848379",
                                                "text": "Durch sein permanentes Saufen machte er sich im Verein gesellschaftlich unmöglich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fda2ae9a-f273-3ddf-9979-95d3b141b6ea",
                                        "entry_id": "ce2f37d0-5788-32b1-a23b-f04be7ec8e4f",
                                        "glosses": [
                                            "die Oberschicht einer Gesellschaft betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4508903-d089-401c-a258-e6ab613f779f",
                                                "sense_id": "fda2ae9a-f273-3ddf-9979-95d3b141b6ea",
                                                "text": "Als Bundespräsident hat man viele gesellschaftliche Verpflichtungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
