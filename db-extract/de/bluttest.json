                                        "entry_id": "88586588-d4c1-3cb3-871b-6b2f2483552a",
                                        "glosses": [
                                            "A laboratory analysis performed on a blood sample that is usually extracted from a vein in the arm using a hypodermic needle, or by fingerprick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0051104-28b8-4524-afd6-385a0800f2a9",
                                                "sense_id": "73c51c79-91e1-3ffc-a365-0d3f0a5759dc",
                                                "text": "HIV-positive persons may test falsely on the standard syphilis blood tests because they may not be able to mount the \"normal\" immunological response required of such tests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd36ace-2872-3435-be44-7cabbff733b0",
                                        "entry_id": "88586588-d4c1-3cb3-871b-6b2f2483552a",
                                        "glosses": [
                                            "An analysis of blood performed on two subjects to determine whether they are biologically related, such as a paternity test."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
