                    },
                    {
                        "sense_id": "8aa2b713-df4c-39c2-aee5-d98f853943a5",
                        "entry_id": "685865e9-7e6e-30bd-bea8-501151ff9fbc",
                        "glosses": [
                            "перен. любовный, эротический (о сюжете, произведении и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037b4707-c975-4ee0-99f8-0749cb97ab1d",
                                "sense_id": "8aa2b713-df4c-39c2-aee5-d98f853943a5",
                                "text": "А Семеныч, между нами говоря, редчайший бабник и утопист, история мира привлекала его единственно лишь альковной своей стороной."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccce82cb-fa1d-410c-b172-6d1b222467d6",
                        "source_entry_id": "685865e9-7e6e-30bd-bea8-501151ff9fbc",
                        "source_sense_description": "относящийся к алькову",
                        "target_lang_word": "alcove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e06626-e3f9-3d5c-b0e9-0c913e5d4295",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "A small recessed area set off from a larger room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d94176-f09f-466e-9c10-7a084dd7dc74",
                                                "sense_id": "c8e06626-e3f9-3d5c-b0e9-0c913e5d4295",
                                                "text": "It was very different from such bookstores as he had been accustomed to patronize. Two stories of the old house had been thrown into one: the lower space was divided into little alcoves; above, a gallery ran round the wall, which carried books to the ceiling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6a88fb-ad8c-3541-96ca-af206105c4ba",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "A shady retreat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e12985-f0e7-4bcc-b6ed-f3d970343c65",
                                                "sense_id": "3a6a88fb-ad8c-3541-96ca-af206105c4ba",
                                                "text": "The house was situated in a leafy alcove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8077d124-7a0a-326e-9089-384bc0c582cb",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "The geographical and geological term for a steep-sided hollow in the side of an exposed rock face or cliff of a homogeneous rock type, that was water eroded."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
