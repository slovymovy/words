                    }
                ],
                "senses": [
                    {
                        "sense_id": "51dd18a9-91e8-3153-90b9-53e71ae48613",
                        "entry_id": "1f456ea1-55f2-3ca5-9964-bff5b1a4f282",
                        "glosses": [
                            "to warrant, to guarantee, to certify, to answer for, to vouch for"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1383a5b5-eaec-4a6a-9ee0-837a9d5f0a73",
                                "sense_id": "51dd18a9-91e8-3153-90b9-53e71ae48613",
                                "text": "Я руча́юсь за э́то голово́й.",
                                "translation": "I'll answer/vouch for it with my life; I'll stake my life on it.",
                                "english": "I'll answer/vouch for it with my life; I'll stake my life on it."
                            },
                            {
                                "example_id": "11972197-38e5-4e15-a2ce-c846af504048",
                                "sense_id": "51dd18a9-91e8-3153-90b9-53e71ae48613",
                                "text": "Руча́юсь за то, что ....",
                                "translation": "I guarantee that ....",
                                "english": "I guarantee that ...."
                            },
                            {
                                "example_id": "f56c1d99-cff4-4fa3-80f9-bbae7c861b17",
                                "sense_id": "51dd18a9-91e8-3153-90b9-53e71ae48613",
                                "text": "Я за себя́ не руча́юсь.",
                                "translation": "I don't guarantee I'll control myself.",
                                "english": "I don't guarantee I'll control myself."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe1e9469-cc74-3376-899a-74dbd9c4803e",
                        "entry_id": "1f456ea1-55f2-3ca5-9964-bff5b1a4f282",
                        "glosses": [
                            "to assure, to promise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96752608-2cea-481a-91ab-58a64a6c512d",
                                "sense_id": "fe1e9469-cc74-3376-899a-74dbd9c4803e",
                                "text": "Руча́юсь тебе́, что ....",
                                "translation": "I assure you that ...",
                                "english": "I assure you that ..."
                            },
                            {
                                "example_id": "a45e2f01-93c4-469c-90cc-d83182800cef",
                                "sense_id": "fe1e9469-cc74-3376-899a-74dbd9c4803e",
                                "text": "Руча́юсь, что сде́лаю э́то.",
                                "translation": "I promise I will do it.",
                                "english": "I promise I will do it."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fd768d3-1710-3541-9b07-adac0dd4ed28",
                        "entry_id": "1f456ea1-55f2-3ca5-9964-bff5b1a4f282",
                        "glosses": [
                            "to bet, to be sure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803fc0aa-ace6-4794-b7c7-020609abce32",
                                "sense_id": "1fd768d3-1710-3541-9b07-adac0dd4ed28",
                                "text": "Руча́юсь, что ...",
                                "translation": "I bet (that) ...; I am sure (that) ...",
                                "english": "I bet (that) ...; I am sure (that) ..."
                            },
                            {
                                "example_id": "869a6f4b-05e7-4c9c-8350-6ce787630f9b",
                                "sense_id": "1fd768d3-1710-3541-9b07-adac0dd4ed28",
                                "text": "Руча́юсь, что вам э́того не сде́лать.",
                                "translation": "I bet you can't do that.",
                                "english": "I bet you can't do that."
                            }
                        ]
                    }
                ],
