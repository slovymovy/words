                                        "glosses": [
                                            "právo ohrožené osoby odvrátit bezprostřední a neoprávněný zásah do svého subjektivního práva"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c76072b-fa41-495c-8c79-8860ed0e6e71",
                                                "sense_id": "eb08a309-bd21-3bcf-8298-b04529abec97",
                                                "text": "Některé právní řády svépomoc jako subjektivní právo vůbec neupravují, počítají s ní však jako s okolností vylučující odpovědnost za škodu (typický v tom směru je Code civil)."
                                            },
                                            {
                                                "example_id": "7c957140-02e1-4079-8042-7d2fccba57fa",
                                                "sense_id": "eb08a309-bd21-3bcf-8298-b04529abec97",
                                                "text": "V moderním právu je svépomoc jako nástroj ochrany práv potlačena na míru nezbytně nutnou."
                                            },
                                            {
                                                "example_id": "dfcee990-22f9-41de-a504-ec17532e9005",
                                                "sense_id": "eb08a309-bd21-3bcf-8298-b04529abec97",
                                                "text": "Moderní stát vykázal svépomoc na periferii dovolených exekučních prostředků."
                                            }
                                        ]
                                    }
                                ]
                            }
