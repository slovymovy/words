                    {
                        "sense_id": "65b688b4-7ef8-3602-aca6-67e6a39c8e71",
                        "entry_id": "4f0b73e1-1478-34a7-b46a-71b36041f15d",
                        "glosses": [
                            "Wissenschaft, die sich mit dem erzählenden Text (Epik, Geschichtsschreibung, Zeitungsartikel) beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e9adfe-4f5a-4a11-8691-bffbe4f62bc8",
                                "sense_id": "65b688b4-7ef8-3602-aca6-67e6a39c8e71",
                                "text": "„Bis heute wirkungsvoll ist hingegen seine Unterscheidung von erzählter Zeit und Erzählzeit, die in der Narratologie eine bedeutende Rolle spielt.“"
                            },
                            {
                                "example_id": "77f7779e-ee51-45f8-b9de-f61d17a2c3fa",
                                "sense_id": "65b688b4-7ef8-3602-aca6-67e6a39c8e71",
                                "text": "„Vor allem in der volkskundlichen Narratologie gilt es, fortan neben den Quellen aus mündlicher und gedruckter Überlieferung verstärkt auch das in den Neuen Medien bereitgestellte Forschungspotential zu nutzen (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
