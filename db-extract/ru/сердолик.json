                "senses": [
                    {
                        "sense_id": "a427e726-0fcf-3777-99cb-80631d07e2e6",
                        "entry_id": "c17cb6a6-2802-3725-a8f6-5959e4d5e901",
                        "glosses": [
                            "минер. полудрагоценный поделочный камень красного или красно-жёлтого цвета, разновидность халцедона"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559eecce-d3b5-403f-83a5-ffb371b30cb9",
                                "sense_id": "a427e726-0fcf-3777-99cb-80631d07e2e6",
                                "text": "Поскольку сердолик добывался в районе Инда, Хейердал вполне мог предположить, что шумерские плетёные суда выходили в Индийский океан."
                            }
                        ]
                    }
                ],
