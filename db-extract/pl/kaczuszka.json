                                "target_senses": [
                                    {
                                        "sense_id": "9c3a3a22-8a0c-38e6-9a96-1146234ef98b",
                                        "entry_id": "78475601-8251-35b3-adf1-9cd9e41fe202",
                                        "glosses": [
                                            "A short, slender heel on a woman's shoe or sandal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a964c7-21f9-4983-b6ea-ede11abf81b7",
                                                "sense_id": "9c3a3a22-8a0c-38e6-9a96-1146234ef98b",
                                                "text": "Her new shoes, with their little perched heels, lent a swing to her hips. She smiled, pleased by the image. Lily in her kitten heels."
                                            },
                                            {
                                                "example_id": "17044ad3-238a-4e47-975e-6ec97cbacfa2",
                                                "sense_id": "9c3a3a22-8a0c-38e6-9a96-1146234ef98b",
                                                "text": "Escorted by an entourage of large flies, we made our way through a grid of muddy corrals. I was in kitten heels and a skirt, a fact from which DePeters, in filth-encrusted rubber boots and worn T-shirt, derived lasting merriment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
