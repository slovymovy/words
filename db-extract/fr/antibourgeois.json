                "senses": [
                    {
                        "sense_id": "6d84b163-f00c-3172-b250-6e6d75cfded5",
                        "entry_id": "c7928582-cc1b-3333-b6b7-a0b5e26320fa",
                        "glosses": [
                            "Qui est contre la bourgeoisie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b277ac43-595a-4b11-a3e1-bc590d52adfa",
                                "sense_id": "6d84b163-f00c-3172-b250-6e6d75cfded5",
                                "text": "Que le romantisme français, viscéralement antibourgeois, ait largement recruté dans les milieux d’inspiration monarchiste (Chateaubriand, Balzac, Hugo, etc.) et qu’il ait pu en même temps remettre le Moyen Âge au goût du jour (par exemple Notre-Dame de Paris, 1831) ne sont ainsi certainement pas une coïncidence."
                            },
                            {
                                "example_id": "e2f375f4-7c2b-45cf-956f-9b1b3c4bc2c4",
                                "sense_id": "6d84b163-f00c-3172-b250-6e6d75cfded5",
                                "text": "Sans doute son côté antibourgeois a-t-il plu à l’ancien chroniqueur de L’Humanité."
                            },
                            {
                                "example_id": "f754ad2e-d5b9-4b04-ab84-0953b641bd0e",
                                "sense_id": "6d84b163-f00c-3172-b250-6e6d75cfded5",
                                "text": "Du haut potentiel antibourgeois."
                            }
                        ]
                    }
                ],
