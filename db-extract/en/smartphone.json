                    },
                    {
                        "translation_id": "5986851e-32ad-44d8-8578-7bbbceafde25",
                        "source_entry_id": "52b3e12a-f69b-3a71-b4a3-af77ee2c26cc",
                        "source_sense_id": "a15f62c6-9f98-3e74-8cb4-633eeaf92e9b",
                        "source_sense_description": "electronic handheld device",
                        "target_lang_word": "téléphone intelligent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléphone intelligent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07d97bc4-e008-32f9-9529-a754e9e3cacc",
                                        "entry_id": "317a15ce-ac01-36dc-a0c6-2f19c424e916",
                                        "glosses": [
                                            "Téléphone mobile comportant un ordinateur de poche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5ea668-1672-46ff-8ae8-5199f6b0be17",
                                                "sense_id": "07d97bc4-e008-32f9-9529-a754e9e3cacc",
                                                "text": "Par rapport au smartphone, l’appareil photo compact conserve un autre avantage : il se prête facilement entre amis ou au sein des familles, alors que le téléphone intelligent est plus personnel et circule moins de main en main, remarquent les analystes."
                                            },
                                            {
                                                "example_id": "0a5c82ee-861c-4679-b955-e1c2dc3a0e55",
                                                "sense_id": "07d97bc4-e008-32f9-9529-a754e9e3cacc",
                                                "text": "80 % des utilisateurs de téléphone intelligent ne le quittent jamais. Les propriétaires de iPhone, BlackBerry et autres Samsung Galaxy sont si attachés à leur appareil que près de 80 % d’entre eux ne quittent jamais la maison sans leur bidule électronique."
                                            },
                                            {
                                                "example_id": "21d1e2ee-1c0c-447c-bae2-f93317f7827a",
                                                "sense_id": "07d97bc4-e008-32f9-9529-a754e9e3cacc",
                                                "text": "Fait surprenant, le téléphone intelligent est moins répandu au Tessin que dans les autres régions de Suisse."
                                            },
                                            {
                                                "example_id": "c135811a-afc3-432e-b3c2-e743cfe37058",
                                                "sense_id": "07d97bc4-e008-32f9-9529-a754e9e3cacc",
                                                "text": "Certaines compagnies, comme Virgin American, envisagent pour les passagers dépourvus d’ordinateur portable ou de téléphone intelligent de pouvoir envoyer des emails via l’écran de télévision installé sur le dos des sièges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e379cfb-3f0b-469b-bcc2-5dac897383a3",
                        "source_entry_id": "52b3e12a-f69b-3a71-b4a3-af77ee2c26cc",
                        "source_sense_id": "a15f62c6-9f98-3e74-8cb4-633eeaf92e9b",
                        "source_sense_description": "electronic handheld device",
                        "target_lang_word": "Smartphone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Smartphone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                        "entry_id": "17b8aa3c-9dd0-3f19-814f-96dd9e230375",
                                        "glosses": [
                                            "Mobiltelefon, das eine deutlich gesteigerte Computerfunktionalität und Konnektivität zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "780acf4d-03bb-4bf6-9166-396ced114996",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "Ein Smartphone kann als ein Minicomputer verstanden werden."
                                            },
                                            {
                                                "example_id": "73b89d34-15d2-4097-86a1-1373a90a9c89",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "Und übrigens: Telefonieren sollte man mit einem Smartphone auch noch können!"
                                            },
                                            {
                                                "example_id": "6e960577-a265-46e0-8b99-28c0c7ea80d7",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "„Das Smartphone wird noch einmal neu definiert, es wird zum Schweizer Taschenmesser des Digitalzeitalters, es transportiert Software, Spiele, Musik und Inhalte aller Art.“"
                                            },
                                            {
                                                "example_id": "caba1a7c-a2bd-485b-abd2-522b9b05606d",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "„Das Problem des iPhones, des Smartphones mit Touchscreen, das die stinknormalen Handys längst abgelöst hat, ist, dass es ebenso unbehaust ist wie sein Besitzer, es folgt ihm in das bewegte Leben.“"
                                            },
                                            {
                                                "example_id": "4e240359-e5d7-4c03-9579-2283df966501",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "„Um mich herum nahm ich das Klicken von Laptoptastaturen und das Blinken und Surren von Smartphones wahr.“"
                                            },
                                            {
                                                "example_id": "4609667b-285a-41a6-a652-bc17c06accb0",
                                                "sense_id": "11c2dfaf-3a8a-3b23-8aa9-fc726fb8d08c",
                                                "text": "„Am Nebentisch sitzen drei Asiaten mit drei Smartphones, die sie an Selfiesticks befestigt haben und nun hintereinander ihre Bilder auf eine externe Festplatte überspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
