                "senses": [
                    {
                        "sense_id": "8b59bf96-b4e5-3b4b-a132-9a3a0044c53b",
                        "entry_id": "32e0180e-c2af-32e7-984a-3c692efd8184",
                        "glosses": [
                            "Faire subir à quelqu'un le même sort que ce qui est arrivé à François Fillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7be5b57-f44e-4079-af90-5cfd08ab8d48",
                                "sense_id": "8b59bf96-b4e5-3b4b-a132-9a3a0044c53b",
                                "text": "J'espère qu'il va filloniser Montebourg (le Juppé du PS) et Valls (le Sarko du PS)."
                            },
                            {
                                "example_id": "745b6098-41ac-40b8-a2bd-2a41a98695e0",
                                "sense_id": "8b59bf96-b4e5-3b4b-a132-9a3a0044c53b",
                                "text": "En démissionnant, le Premier Ministre Valls éviterait de se « filloniser » comme l'a été Fillon au cours du quinquennat de Nicolas Sarkozy."
                            }
                        ]
                    },
                    {
                        "sense_id": "10608b39-999e-3112-96a5-0f4c6c5399f0",
                        "entry_id": "32e0180e-c2af-32e7-984a-3c692efd8184",
                        "glosses": [
                            "Soumettre à l’influence de François Fillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2114a60-4177-40fb-996d-4b0ae176fc7b",
                                "sense_id": "10608b39-999e-3112-96a5-0f4c6c5399f0",
                                "text": "Avec Fillon et une France qui donne l'impression de se filloniser ou de se macroniser de plus en plus, pas si tôt..."
                            }
                        ]
                    }
