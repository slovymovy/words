                        "source_sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                        "source_sense_description": "heimlicher, nur wenigen bekannter Weg, der abseits der großen, bekannten Straßen verläuft",
                        "target_lang_word": "rat run",
                        "target_lang_code": "en",
