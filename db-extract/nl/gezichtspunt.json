                "translations": [
                    {
                        "translation_id": "8708c4c0-0da2-4c94-a868-cceed42584fa",
                        "source_entry_id": "5c20af6e-1dad-341e-987f-3f99ba8ebcde",
                        "source_sense_id": "1c35e8a3-4987-30a1-8fd5-a1323846daac",
                        "target_lang_word": "Gesichtspunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesichtspunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                        "entry_id": "7450cedd-4ec5-39ea-bf98-76fdf0584a1c",
                                        "glosses": [
                                            "Art und Weise, von der eine Sache betrachtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a17deac-1039-4eae-8680-90cdb891844a",
                                                "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                                "text": "Unter dem Gesichtspunkt des Umweltschutzes war sein Handeln mehr als fraglich."
                                            },
                                            {
                                                "example_id": "95d94184-8260-4954-a2fe-967195f58a8e",
                                                "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                                "text": "„Hebel hat diese Anekdote unter einem bestimmten Gesichtspunkt erzählt.“"
                                            },
                                            {
                                                "example_id": "6a6b383b-c232-4625-a4fe-071a445c7d7d",
                                                "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                                "text": "„Das Leben im Ruhestand wird unter dem Gesichtspunkt der Sinnfindung, möglicher neuer Aufgaben, der körperlichen Bewegung, des Reisens, der angemessenen Ernährung beschrieben.“"
                                            },
                                            {
                                                "example_id": "b0c88c9d-47bd-4ccc-8358-45491ef28094",
                                                "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                                "text": "„Der junge Häuptling eines der bedeutendsten indianischen Stämme Mexikos sah daher natürlich den Fall mit den gefangenen Seeräubern aus einem andern Gesichtspunkte an.“"
                                            },
                                            {
                                                "example_id": "89a960d5-17f6-4cdf-bee7-6734d5551b0e",
                                                "sense_id": "d699a5f5-9606-3795-b204-72fb9bc67151",
                                                "text": "„Nachdem vorher soviel von Gesichtspunkten, Standpunkten, auch Null-Punkten die Rede war, hier die lapidare Quintessenz, daß offenbar der archimedische Punkt des Stils noch nicht entdeckt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9240ca10-3f4c-4502-b3a6-bbdc0152174b",
                        "source_entry_id": "5c20af6e-1dad-341e-987f-3f99ba8ebcde",
                        "source_sense_id": "1c35e8a3-4987-30a1-8fd5-a1323846daac",
                        "target_lang_word": "viewpoint",
