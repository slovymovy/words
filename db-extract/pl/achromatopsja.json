                "translations": [
                    {
                        "translation_id": "cceb9c39-b0a4-4c74-9abe-2d1e02cb7f26",
                        "source_entry_id": "b04cc5ba-076c-33a9-94ec-a66d865796ba",
                        "source_sense_id": "79829965-0221-3d7d-9b26-e62e985e627e",
                        "source_sense_description": "Medizin: Achromatopsie, Farbenblindheit",
                        "target_lang_word": "Achromatopsie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achromatopsie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                        "entry_id": "167b86cf-5d2e-3b81-8bc3-6777313f84d0",
                                        "glosses": [
                                            "angeborener oder erworbener gänzlicher Ausfall des Farbensehens durch Fehlen der Zapfenfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bb7aa7-c35c-40fb-80e0-d5f541306952",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "Achromatopsie (Farbenblindheit) ist nicht Farbenfehlsichtigkeit."
                                            },
                                            {
                                                "example_id": "adaa863a-01f1-4730-a77d-ca3bd6143e49",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Die Tests und die allgemeine neurologische Untersuchung hatten die Diagnose bestätigt: totale Farbenblindheit, Achromatopsie.“"
                                            },
                                            {
                                                "example_id": "b8d0b905-c491-4525-8390-c5286e35d7b4",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Das Unvermögen, die Farben richtig zu unterscheiden, die Achromatopsie, ist manchen Menschen angeboren und in diesem Falle kein amaurotisches Symptom.“"
                                            },
                                            {
                                                "example_id": "6b275447-30e2-4d68-bffd-15e72266882b",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Die Farbenblindheit oder Achromatopsie ist eine relativ seltene vererbte Netzhauterkrankung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25414370-dac7-4dda-95a2-fbf3f0a7b8e3",
                        "source_entry_id": "b04cc5ba-076c-33a9-94ec-a66d865796ba",
                        "source_sense_id": "79829965-0221-3d7d-9b26-e62e985e627e",
