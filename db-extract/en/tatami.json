                                "target_senses": [
                                    {
                                        "sense_id": "0cab291e-a462-3142-a56e-c10c9e328b50",
                                        "entry_id": "33e716d5-6fc8-31c9-90b8-dedae6d2f893",
                                        "glosses": [
                                            "žíněnka nebo celé zápasiště pro judo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9c4715-bcb7-48a9-952d-0fe0003eb615",
                                                "sense_id": "0cab291e-a462-3142-a56e-c10c9e328b50",
                                                "text": "Los turnaje měl jednadvacetiletý Krpálek přísný. V prvním kole měl sice volno, ale pak ho na tatami čekal mistr světa z roku 2010 Takamasu Anai z Japonska, kterého porazil na ipon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "851f0c88-31b4-4310-8813-343be21fa0f3",
                        "source_entry_id": "2afcf6c6-9a1f-3fc8-b330-bec350369f88",
                        "source_sense_description": "straw matting in Japanese houses",
                        "target_lang_word": "tatami",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatami",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c57a7ae0-21dd-393e-adb1-1622a4ae03d1",
                                        "entry_id": "de9aac89-3444-35b9-9e08-1d92a8fa497a",
                                        "glosses": [
                                            "Au Japon, tapis épais d’intérieur, traditionnellement fait en jonc épars tressée et ayant une taille de 91 cm par 182 cm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6870f380-e1cf-43a3-a779-cecfc1c04286",
                                                "sense_id": "c57a7ae0-21dd-393e-adb1-1622a4ae03d1",
                                                "text": "Il faut toujours se déchausser avant de marcher sur les tatamis."
                                            },
                                            {
                                                "example_id": "b8120420-6d8c-484b-84cc-7ab2b00f1fbc",
                                                "sense_id": "c57a7ae0-21dd-393e-adb1-1622a4ae03d1",
                                                "text": "De là, on entre dans le grand salon, une espèce de hall, au plancher comme toutes les autres pièces, recouvert de tatami, de fines nattes blanches, doublées d’une paille de riz très serrée, d’une épaisseur de sept centimètres, sur lequel le marcher est tout moelleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ffac8c-fd2c-35ef-bacb-f1a21dba4654",
                                        "entry_id": "de9aac89-3444-35b9-9e08-1d92a8fa497a",
                                        "glosses": [
                                            "Tapis sur lequel on pratique les entraînements ou les combats dans un dojo."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722265a9-cd13-4104-84f6-70e93a0070a3",
                                                "sense_id": "53ffac8c-fd2c-35ef-bacb-f1a21dba4654",
                                                "text": "Le long quadrilatère était divisé en deux parties : l'une, au sol couvert de tatamis et l’autre, au fond, réservée à la boxe avec sacs de frappe et ring sorti d'un film américain des années 50."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a100df14-1af3-492f-bffb-8013f0457428",
