                        "source_sense_id": "803992b2-b83c-3ec7-a213-becc782be16f",
                        "source_sense_description": "iemand die een vermogen heeft van meer dan een miljoen eenheden van een bepaalde valuta (bijvoorbeeld euro, dollar)",
                        "target_lang_word": "millionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
