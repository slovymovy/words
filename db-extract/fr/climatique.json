        "fr-extract.jsonl": [
            {
                "entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                "word": "climatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9495a4c1-f630-46ae-ac25-beb9427fa2ab",
                        "entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "climatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                        "entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "glosses": [
                            "Relatif au climat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b705c02-ff0c-4017-9fbd-e49a69646bfa",
                                "sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                                "text": "On nous rappelle que les montagnes attirent les précipitations ; on nous rappelle aussi qu'elles constituent, de la base au sommet, une sorte de complexe biologique où voisinent, rapprochées et comme juxtaposées dans l'espace, les zones climatiques les plus diverses et, par suite, les mondes zoobotaniques les plus variés."
                            },
                            {
                                "example_id": "215f19d3-e49f-4830-b57d-0dcdde564339",
                                "sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                                "text": "Le temps écoulé entre la première gelée d’automne et la dernière gelée de printemps représente, par son influence sur la végétation, l’une des données climatiques les plus importantes."
                            },
                            {
                                "example_id": "36874dda-5a41-4539-bc17-030a60b55cee",
                                "sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                                "text": "Dans la province du Cap, où les conditions climatiques sont de type méditerranéen, se rencontre un type d’écosystème homologue de nos garrigues et maquis, le fynbos, dont la végétation, constituée d’espèces sclérophylles très caractéristiques, qui possède des affinités avec celle de l’Australie méridionale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "315b5441-64e4-4d72-bac3-e90a058c9723",
                        "source_entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "source_sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                        "target_lang_word": "klimatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klimatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72b2c7c9-9b5b-3dde-be0c-807ad72a29ce",
                                        "entry_id": "7e2abe25-13a7-36c2-9765-2494b247c461",
                                        "glosses": [
                                            "das Klima betreffend, zu ihm gehörig und durch es verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b396519-5e3f-4882-84b5-d61ff1284d1e",
                                                "sense_id": "72b2c7c9-9b5b-3dde-be0c-807ad72a29ce",
                                                "text": "„Aufgrund sich ändernder klimatischer Bedingungen machen tropische Wälder Buschformationen Platz und diese wiederum Wüsten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9449c4b7-b968-4e56-8fcb-15a2d7a7b8fd",
                        "source_entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "source_sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                        "target_lang_word": "Klima-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a0ece932-7344-43d9-9b33-f859496711b7",
                        "source_entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "source_sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                        "target_lang_word": "climate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94ff21f0-942f-377c-82ca-b9e423fa641a",
                                        "entry_id": "9fbf3fa5-7052-3f60-a3eb-f305ce004ced",
                                        "glosses": [
                                            "The long-term manifestations of weather and other atmospheric conditions in a given area or country, now usually represented by the statistical summary of its weather conditions during a period long enough to ensure that representative values are obtained (generally 30 years)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "458ee4d7-d566-4d96-8378-9d261d36a298",
                                                "sense_id": "94ff21f0-942f-377c-82ca-b9e423fa641a",
                                                "text": "As fruits of hotter countries, transearthed in colder climates, have vigour enough in themselves to be fructuous according to their nature: but, that they are hindered by the chilling nips of the air, and the soil, wherein they are planted."
                                            },
                                            {
                                                "example_id": "526e9c89-f2b3-4d8f-87f5-f866f34cbcc6",
                                                "sense_id": "94ff21f0-942f-377c-82ca-b9e423fa641a",
                                                "text": "And the effects from climate change are already extreme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00382762-af24-36f1-a13f-032044867e0f",
                                        "entry_id": "9fbf3fa5-7052-3f60-a3eb-f305ce004ced",
                                        "glosses": [
                                            "The context in general of a particular political, moral, etc., situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d86290-4305-4e36-8e67-8c942d6c2f56",
                                                "sense_id": "00382762-af24-36f1-a13f-032044867e0f",
                                                "text": "Industries that require a lot of fossil fuels are unlikely to be popular in the current political climate."
                                            },
                                            {
                                                "example_id": "e5391e47-adef-42c6-8e7a-0725b7f60579",
                                                "sense_id": "00382762-af24-36f1-a13f-032044867e0f",
                                                "text": "In polling by the Pew Research Center in November 2008, fully half the respondents thought the two parties would cooperate more in the coming year, versus only 36 percent who thought the climate would grow more adversarial."
                                            },
                                            {
                                                "example_id": "a536faf4-9fdf-4ba8-be1b-25f6191c14f3",
                                                "sense_id": "00382762-af24-36f1-a13f-032044867e0f",
                                                "text": "This isn't the time for militant unionism. If I were at ScotRail, in the current climate I'd trade a pay freeze [sic: pay rise?] for job security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a96ed8d9-aed3-3211-96b9-6b7567f9fc1b",
                                        "entry_id": "9fbf3fa5-7052-3f60-a3eb-f305ce004ced",
                                        "glosses": [
                                            "An area of the earth's surface between two parallels of latitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "626c2cfc-9114-3d12-bca4-f88fa7beb34b",
                                        "entry_id": "9fbf3fa5-7052-3f60-a3eb-f305ce004ced",
                                        "glosses": [
                                            "A region of the Earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "climate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a506bc6-1c12-33d9-8b28-13f6d559625b",
                                        "entry_id": "4bfc4697-e09b-3389-b967-88b1a7fbc345",
                                        "glosses": [
                                            "To dwell."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3217f24-3134-4570-b5b0-50fe34d137a0",
                                                "sense_id": "8a506bc6-1c12-33d9-8b28-13f6d559625b",
                                                "text": "The blessed gods / Purge all infection from our air whilst you / Do climate here!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e4719e1-91cc-4ad2-b9af-4d289fb109c1",
                        "source_entry_id": "ba4b22a6-cf49-32bb-95dd-abcb66155f1f",
                        "source_sense_id": "de836975-222a-3f0e-9363-7b7b1068ff3c",
                        "target_lang_word": "climatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70f2b30-88ec-3fb2-bdc6-6e2f5f9ccc39",
                                        "entry_id": "9328a574-7c44-3ba8-9bc1-a539542fee9e",
                                        "glosses": [
                                            "Of, relating to, or influenced by climate."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef87bb96-8b3f-46ea-b980-b8629d533fa0",
                                                "sense_id": "a70f2b30-88ec-3fb2-bdc6-6e2f5f9ccc39",
                                                "text": "The people of the United States, owing, no doubt, to climatic reasons, have been thoroughly educated in the use of ice[…]"
                                            },
                                            {
                                                "example_id": "71f74ee2-e137-49f8-9d20-e5096e8f7243",
                                                "sense_id": "a70f2b30-88ec-3fb2-bdc6-6e2f5f9ccc39",
                                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cf1a6f2-8fe7-4052-9734-a59d854c6721",
