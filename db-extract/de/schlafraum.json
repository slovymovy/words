                ],
                "senses": [
                    {
                        "sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                        "entry_id": "f06e78a2-54b7-3a3f-a649-10826f4a680f",
                        "glosses": [
                            "ein Raum, der zum Schlafen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395f492e-47d8-407c-bddb-0ce2a9a645c8",
                                "sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                                "text": "„Zur besseren Beleuchtung befahl sie, noch ein paar Tranlampen in den Schlafraum zu bringen.“"
                            },
                            {
                                "example_id": "d66ed80d-99e9-48a4-9135-d63bc20d65ec",
                                "sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                                "text": "„Von einer großzügigen Eingangshalle mit gewundener Treppe gelangt man in ein knappes Dutzend Räume, darunter ein Salon, ein Esszimmer, ein Raucherzimmer, ein Arbeitszimmer plus Bibliothek und im Obergeschoss mindestens fünf Schlafräume.“"
                            },
                            {
                                "example_id": "4446f3d7-06ad-495f-8b6b-95d84960f573",
                                "sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                                "text": "„Die Biedermanns, Fräulein Rahn und Fräulein Trautmann behalten vorläufig ihren Schlafraum bei der Ecksch und sind bloß den Tag über bei uns.“"
                            },
                            {
                                "example_id": "a7e11bea-0402-4f90-b983-66c035aadb01",
                                "sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                                "text": "„Auch die Schlafräume im Konvikt hatten grönländischen Iglus geglichen; dazu Sport in arktischer Kälte; das probate Mittel zur Dämpfung unzüchtiger Gedanken und Gefühle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1f1c87d-a17d-4d3e-aa41-f77651a45af1",
                        "source_entry_id": "f06e78a2-54b7-3a3f-a649-10826f4a680f",
                        "source_sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                        "source_sense_description": "ein Raum, der zum Schlafen dient",
                        "target_lang_word": "dormitory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dormitory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "061f76f4-5918-3d66-9bb1-17d251fdef42",
                                        "entry_id": "4cc58f82-17dd-34d1-8e78-3da869a844bd",
                                        "glosses": [
                                            "A room containing a number of beds (and often some other furniture and/or utilities) for sleeping, often applied to student and backpacker accommodation of this kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16389f6-1747-4040-85e3-1b3088a9e6f0",
                                                "sense_id": "061f76f4-5918-3d66-9bb1-17d251fdef42",
                                                "text": "She will be much more likely to meet his wishes after a residence at the castle, than an imprisonment on short commons in her dormitory in Welbeck Street; for in one case she only learnt how much she could endure, in the other she will find how much she can enjoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925e02d0-d0dc-3a40-9ec7-d4ebe401b83d",
                                        "entry_id": "4cc58f82-17dd-34d1-8e78-3da869a844bd",
                                        "glosses": [
                                            "A building or part of a building which houses students, soldiers, monks etc. who sleep there and use communal further facilities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e032af8-857c-3276-befe-f4cfebd2dc6f",
                                        "entry_id": "4cc58f82-17dd-34d1-8e78-3da869a844bd",
                                        "glosses": [
                                            "A dormitory town."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c50765e-23ce-4d7c-877f-d55b6f9f4186",
                        "source_entry_id": "f06e78a2-54b7-3a3f-a649-10826f4a680f",
                        "source_sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                        "source_sense_description": "ein Raum, der zum Schlafen dient",
                        "target_lang_word": "dortoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dortoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed421acf-e4a3-30bc-a497-6a9b57dec9ec",
                                        "entry_id": "0b7151dc-0700-3fdf-87b5-1ea97d98f62a",
                                        "glosses": [
                                            "Grande salle où l’on couche, garnie de plusieurs lits et qui se trouve dans les communautés religieuses, les maisons d’éducation ou dans certains hospices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41c559a-db2f-4e62-be1f-c1be0afe682a",
                                                "sense_id": "ed421acf-e4a3-30bc-a497-6a9b57dec9ec",
                                                "text": "Ils arrivèrent à la salle qui servait de dortoir aux bandits, ils dormaient étendus çà et là."
                                            },
                                            {
                                                "example_id": "dee7506d-2733-4aea-b5de-81379fa8fe4b",
                                                "sense_id": "ed421acf-e4a3-30bc-a497-6a9b57dec9ec",
                                                "text": "Et l'abat-jour du quinquet, accroché dans la muraille au-dessus de la tête d'Emma, éclairait tous ces tableaux du monde, qui passaient devant elle les uns après les autres, dans le silence du dortoir et au bruit lointain de quelque fiacre attardé qui roulait encore sur les boulevards."
                                            },
                                            {
                                                "example_id": "fd748d7c-0679-41a7-892b-9a331e5e3453",
                                                "sense_id": "ed421acf-e4a3-30bc-a497-6a9b57dec9ec",
                                                "text": "Le dortoir était une pièce au plafond bas, percée de petites fenêtres armées de barreaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e9ddbe-19a5-37e6-a0b7-fc97f3dfd48b",
                                        "entry_id": "0b7151dc-0700-3fdf-87b5-1ea97d98f62a",
                                        "glosses": [
                                            "Regroupement d’animaux qui dorment ensemble."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc1a454-62e5-4bad-841d-88f7078ab53c",
                                                "sense_id": "95e9ddbe-19a5-37e6-a0b7-fc97f3dfd48b",
                                                "text": "Un dortoir d'étourneaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18d54f31-73d6-488d-a98b-41019709b29c",
                        "source_entry_id": "f06e78a2-54b7-3a3f-a649-10826f4a680f",
                        "source_sense_id": "e768967f-0572-3382-ab78-eabb25816034",
                        "source_sense_description": "ein Raum, der zum Schlafen dient",
                        "target_lang_word": "chambre à coucher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambre à coucher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                        "entry_id": "1fb6fff7-e89e-36a4-9cbf-d701a30fcf89",
                                        "glosses": [
                                            "Pièce d’une habitation utilisée pour dormir, pour une personne ou peu de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbd9628-2b4a-462c-9c4c-a41568a95e6d",
                                                "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                                "text": "La cuisine est adossée à la salle à manger, et le salon est doublé d’un cabinet qui servait alors de chambre à coucher à monsieur et à madame Dumay."
                                            },
                                            {
                                                "example_id": "123325c3-808e-46e9-8680-dc3707030dab",
                                                "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                                "text": "L’armoire en noyer, le lit à colonnes et à bonnes-grâces, ornements de la chambre à coucher, furent sans doute le fruit de quelque risette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
