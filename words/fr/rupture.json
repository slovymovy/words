    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3bd00e6-da08-39d0-8283-6a4449661586",
                    "sense_definition": "Fin d'une relation amoureuse ou séparation d'un couple.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après trois ans de vie commune, leur <w>rupture</w> a surpris tous leurs amis."
                        },
                        {
                            "text": "Il a eu beaucoup de mal à surmonter cette <w>rupture</w> douloureuse."
                        }
                    ],
                    "synonyms": [
                        "séparation"
                    ],
                    "antonyms": [
                        "réconciliation",
                        "union"
                    ],
                    "common_phrases": [
                        "rupture amoureuse",
                        "annoncer une rupture"
                    ]
                },
                {
                    "sense_id": "202f7bbd-d81c-342e-9795-7816b786fcc8",
                    "sense_definition": "Fait de casser, de briser ou de se rompre sous une tension physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le câble a cédé car la tension a dépassé son point de <w>rupture</w>."
                        },
                        {
                            "text": "Les ingénieurs vérifient la résistance des matériaux à la <w>rupture</w> avant la construction."
                        }
                    ],
                    "synonyms": [
                        "cassure",
                        "fracture",
                        "bris"
                    ],
                    "common_phrases": [
                        "point de rupture",
                        "résistance à la rupture",
                        "risque de rupture"
                    ]
                },
                {
                    "sense_id": "58446f74-5620-3a6c-bf1d-d6f1581ed23e",
                    "sense_definition": "Résiliation ou interruption officielle d'un contrat, d'un accord ou d'un engagement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé et la direction ont négocié une <w>rupture</w> conventionnelle du contrat de travail."
                        },
                        {
                            "text": "Cette clause prévoit de lourdes pénalités en cas de <w>rupture</w> unilatérale de l'accord."
                        }
                    ],
                    "synonyms": [
                        "résiliation",
                        "annulation"
                    ],
                    "antonyms": [
                        "conclusion",
                        "signature"
                    ],
                    "common_phrases": [
                        "rupture conventionnelle",
                        "rupture de contrat"
                    ]
                },
                {
                    "sense_id": "3f04af74-ec93-338b-9b54-9a452787ae80",
                    "sense_definition": "Cessation des relations politiques, diplomatiques ou amicales entre des personnes ou des pays.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux pays voisins ont annoncé la <w>rupture</w> de leurs relations diplomatiques."
                        },
                        {
                            "text": "Un désaccord politique majeur a provoqué la <w>rupture</w> entre ces deux anciens alliés."
                        }
                    ],
                    "synonyms": [
                        "brouille"
                    ],
                    "antonyms": [
                        "alliance",
                        "rapprochement"
                    ],
                    "common_phrases": [
                        "rupture des relations diplomatiques",
                        "provoquer une rupture"
                    ]
                },
                {
                    "sense_id": "b1160b10-f6bf-364b-93a7-cf2fe7826576",
                    "sense_definition": "Déchirement ou éclatement accidentel d'un organe, d'un tissu ou d'un vaisseau sanguin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sportif a été opéré en urgence suite à une <w>rupture</w> des ligaments du genou."
                        },
                        {
                            "text": "La patiente a été transportée à l'hôpital après une <w>rupture</w> d'anévrisme soudaine."
                        }
                    ],
                    "synonyms": [
                        "déchirure"
                    ],
                    "common_phrases": [
                        "rupture d'anévrisme",
                        "rupture des ligaments"
                    ]
                }
            ]
        }
    ]
