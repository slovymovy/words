                "senses": [
                    {
                        "sense_id": "e5a6e4d0-2ab7-3e0a-b608-f674b4b07069",
                        "entry_id": "de00bf87-f780-3f11-b3f2-fcace506faf8",
                        "glosses": [
                            "Explosion de fumées dans un local clos provoquée par une entrée d'air frais, typiquement lors de l'ouverture d'une fenêtre ou d'une porte."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2b3629f-819f-4794-a521-4ca2d64372f2",
                        "source_entry_id": "de00bf87-f780-3f11-b3f2-fcace506faf8",
                        "source_sense_id": "e5a6e4d0-2ab7-3e0a-b608-f674b4b07069",
                        "source_sense_description": "Inflammation explosive",
                        "target_lang_word": "Rückzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "die Beendigung, das Niederlegen einer zuvor ausgeübten Betätigung oder Funktion (eines Amtes, einer Kandidatur und so weiter), das Verlassen (einer Organisation oder dergleichen); Sichentfernen (von einer Örtlichkeit); übertragen auch von unbelebten Konkreta und Abstrakta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c0da33-883f-4b2d-9a7d-2904a06a0971",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Wie wenig der winterliche Rückzug des Bären als Winterschlaf gedeutet werden kann, geht auch daraus hervor, daß die Geburt der Jungen regelmäßig in den Januar fällt.“ (1864)"
                                            },
                                            {
                                                "example_id": "70da49f9-6504-4e22-b2b9-d33c079158e9",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Die SPD jedenfalls wirkt nach dem Rückzug Gabriels wie von einer Last befreit, und die Umfragen schnellen in die Höhe.“"
                                            },
                                            {
                                                "example_id": "0383d01c-980d-47b8-8947-8c331e608322",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Nicht zuletzt diese Forderung des Psychoanalytikers […] provoziert Feindseligkeit, Haß, Enttäuschung, bisweilen auch Rückzug beim Patienten.“"
                                            },
                                            {
                                                "example_id": "c21f88ad-b166-4e6a-bae4-59294acdddb2",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Der Rückzug des Krieges auf eine innerstaatliche, oft ethnische Ebene hat laut SIPRI Folgen für die Handhabung von bewaffneten Konflikten […]“"
                                            },
                                            {
                                                "example_id": "ce8906bc-844a-4ac7-ab98-e532a6bb0659",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Doch im Zeitalter von HIV und Aids hat die Pille den Rückzug in die feste Beziehung angetreten. Einer aktuellen Studie der Universität Zürich zufolge verhüten 79 Prozent der 20jährigen, die in einer festen Beziehung leben, mit der Pille.“"
                                            },
                                            {
                                                "example_id": "e5e77e60-f507-4af9-83a1-3b9765b5b2f8",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Nach so vielen Katastrophen folgen die Frage nach dem Sinn des Lebens und der Rückzug auf innere Werte. Mit afrikanischen und asiatischen Masken, Kakokongo und ‚Lohan im Moment der Erleuchtung‘.“"
                                            },
                                            {
                                                "example_id": "56d82770-173b-4131-a1b2-30e95c9ff6bd",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Immer wieder das Gefühl, als habe sich die Bevölkerung, aus Trotz oder Einsicht, ins Landesinnere zurückgezogen, ins Réduit. Die Durchquerung der Insel zeigt, wie schwer der Rückzug fallen muss. “"
                                            },
                                            {
                                                "example_id": "a9902f50-03b7-4d2b-8ab5-830e64915dab",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Ihr Tod, nach Beendigung der Dreharbeiten zu ‚Der Rosenkönig‘ (1984), war vielleicht mitentscheidend für den Rückzug vom Film.“"
                                            },
                                            {
                                                "example_id": "15ab743f-0380-48b9-a25a-5a8a62d5e987",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Die Cantautori padri, Wort- und Tonführer vergangener brisanter italienischer Tage und Nächte, befinden sich auf Rückzug, nicht erst seit Bossi, nicht erst seit Berlusconi.“"
                                            },
                                            {
                                                "example_id": "2325b5a7-27b3-4435-a035-568007fc8725",
                                                "sense_id": "00f3b0fc-7c1e-31fb-ad79-2639f5747356",
                                                "text": "„Auf einen Rückzug der Seuche ließen die Zahlen nicht schließen: Es gebe seit den 1950er Jahren ein stetes Auf und Ab der anzeigepflichtigen, für den Menschen aber ungefährlichen Krankheit, erklärt die Wissenschaftlerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "88bd5b6a-71a1-3e44-b8f4-fc7584357eba",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "Zurückweichen, Sichentfernen von einem Gegner"
                                        ],
                                        "tags": [
                                            "speziell; von militärischen Truppen oder Ähnlichem"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb80e30-1413-46e7-9549-79f4163aad9d",
                                                "sense_id": "88bd5b6a-71a1-3e44-b8f4-fc7584357eba",
                                                "text": "„Um sich an dem Herzog von Pommern zu rächen, ließ der kaiserliche General auf dem Rückzuge seine Truppen die schreyendsten Gewaltthätigkeiten gegen die Einwohner Pommerns verüben, welche sein Geiz längst schon aufs grausamste gemißhandelt hatte.“ (1792)"
                                            },
                                            {
                                                "example_id": "75185348-37f2-4393-ada0-d53f8ee524be",
                                                "sense_id": "88bd5b6a-71a1-3e44-b8f4-fc7584357eba",
                                                "text": "„Allerdings war der Rückzug bereits auf breiter Front in vollem Gange.“"
                                            },
                                            {
                                                "example_id": "888e00ed-4fdd-464e-89ad-e1971777b2af",
                                                "sense_id": "88bd5b6a-71a1-3e44-b8f4-fc7584357eba",
                                                "text": "„Dann kommt der Befehl zum Rückzug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "81424a9e-aa11-3cb1-9ae3-46d44b0d8bd7",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "sukzessive Abnahme der räumlichen Ausdehnung als Folge fortgesetzten Abschmelzens"
                                        ],
                                        "tags": [
                                            "speziell; von Gletschern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c08c7b8-60b8-4539-84f6-d25163f634be",
                                                "sense_id": "81424a9e-aa11-3cb1-9ae3-46d44b0d8bd7",
                                                "text": "„Wie Keller sagt, wird ‚diese doppelte Schmelze‘ dazu führen, dass in naher Zukunft kein eigentlicher Rückzug der Gletscher mehr stattfinden wird, sondern dass es vermehrt zu einem Zerfall kommen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "3c1edd69-f320-3c30-8858-e3c2d58aee70",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "eine Möglichkeit, ein Ort zum Rückzug [1a, 1b]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c882290-6475-4c00-8da2-deb6ea315be8",
                                                "sense_id": "3c1edd69-f320-3c30-8858-e3c2d58aee70",
                                                "text": "„Unsere Stellung hier vor Biradschik ist ohne Rückzug und die schulgerechte Kritik wird sie also tadeln; ich rechne ihr das als einen Vorzug mehr an.“ (1841)"
                                            },
                                            {
                                                "example_id": "f65e4ab3-1988-437d-a4a4-ddca9bb965ef",
                                                "sense_id": "3c1edd69-f320-3c30-8858-e3c2d58aee70",
                                                "text": "„Er gab Apulien und Lucanien, sogar Metapont auf und zog sich mit seinen Truppen zurück in das brettische Land, dessen Häfen sein einziger Rückzug waren.“ (1854)"
                                            },
                                            {
                                                "example_id": "ae0b0986-2ff3-4d90-9dcb-112e995d555f",
                                                "sense_id": "3c1edd69-f320-3c30-8858-e3c2d58aee70",
                                                "text": "„Der Senat machte jetzt den Versuch Gracchus einen leidlichen Rückzug zu eröffnen; zwei Consulare forderten ihn auf die Angelegenheit in der Curie weiter zu verhandeln und eifrig ging der Tribun hierauf ein.“ (1855)"
                                            },
                                            {
                                                "example_id": "e6ca05cb-4246-4d65-b562-1b1401a7c016",
                                                "sense_id": "3c1edd69-f320-3c30-8858-e3c2d58aee70",
                                                "text": "„[…] bei dem Worte ‚Perfectibilität‘ wußte Moorfeld sogleich, wohin der edle Lord ziele. Er sah sich nach einem passenden Rückzuge um, der Engländer aber nahm ihn freundlich bei der Hand und hielt ihn fest. Moorfeld seufzte. Der Engländer fuhr fort […]“ (1855)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "Wegnehmen (von etwas zuvor Gewährtem); Beendigung (einer regelmäßigen Leistung; eines Verkaufs); Zurücknehmen (eines Antrags, eines Rechtsmittels etc.)"
                                        ],
                                        "tags": [
                                            "das Zurückziehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c893dfcb-166a-4a8b-a023-17b356de6412",
                                                "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                                "text": "„Mit dem Rückzug der Tabletten will die Firma einen Beitrag zur Eindämmung des Rohypnol-Missbrauchs in der Drogenszene leisten.“"
                                            },
                                            {
                                                "example_id": "197a72c3-67f9-4898-aad7-0f4faf987de6",
                                                "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                                "text": "„Pemba bekommt den Rückzug westlicher Gelder stärker zu spüren.“"
                                            },
                                            {
                                                "example_id": "dd94ed1f-7408-4a99-a34f-5ac23cf39a4f",
                                                "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                                "text": "„Mit dem Rückzug ihres Antrags vermied es die Koalition, von ihrem eigenen Bündnispartnern FWG und den oppositionellen Sozialdemokraten düpiert zu werden.“"
                                            },
                                            {
                                                "example_id": "3c00774a-6b73-42dd-a570-90ff89c7fbc9",
                                                "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                                "text": "„Die Hausangestellten hatten für den Rückzug der Anzeige von unbekannter Seite eine Entschädigung in unbekannter Höhe erhalten, wie ihr Anwalt am Dienstag bestätigte.“"
                                            },
                                            {
                                                "example_id": "07151f21-cc9a-47f3-b39b-54de7302cc0a",
                                                "sense_id": "e896e097-ebc8-37e5-affb-4d6dac6138cf",
                                                "text": "„Die SVP-Fraktion schreibt in ihrer Mitteilung, sie trage den Kompromiss mit, erwarte auf der Gegenseite aber ‚den baldigen Rückzug‘ der Initiative.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e08851d6-a476-3acb-8267-70f696047faa",
                                        "entry_id": "9582e3c0-f6be-328e-90c0-59334a84cb63",
                                        "glosses": [
                                            "Abhebung (von einem Bankkonto)"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4d22061-e7a2-42e9-9e53-5a4e373b83f9",
                                                "sense_id": "e08851d6-a476-3acb-8267-70f696047faa",
                                                "text": "„Der Rückzug ist beschränkt auf CHF 50 000 respektive EUR 30 000 pro Monat. Höhere Rückzüge sind erst nach Ablauf der dreimonatigen Kündigungsfrist möglich.“"
                                            },
                                            {
                                                "example_id": "da6c3a63-cb47-4643-8a3c-8670d5ba1eeb",
                                                "sense_id": "e08851d6-a476-3acb-8267-70f696047faa",
                                                "text": "„Ab dem 13. Rückzug pro Jahr wird eine Administrationsgebühr von CHF 10 pro Rückzug berechnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
