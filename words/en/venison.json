                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "mięso z antylopy",
                                "target_lang_sense_clarification": "jadalne mięso antylopy"
                            },
                            {
                                "target_lang_word": "dziczyzna",
                                "target_lang_sense_clarification": "w szerokim znaczeniu mięsa zwierząt kopytnych z odłowu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2defcde7-313c-3877-b86e-164b70e17d5a",
                    "sense_definition": "The meat of any wild animal that has been hunted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef specializes in preparing wild game <w>venison</w> for his guests.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni specjalizuje się w przyrządzaniu <w>dziczyzny</w> dla swoich gości."
                            }
                        },
                        {
                            "text": "Eating <w>venison</w> is common for those who prefer wild-caught food sources.",
                            "target_lang_translations": {
