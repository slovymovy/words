                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b6ec29b-3137-39d2-900d-fff903a656f2",
                                        "entry_id": "85a8b6a9-7b46-3d40-a92a-56b5296abab6",
                                        "glosses": [
                                            "To bring bad luck to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6b43de2-76ee-3124-88a7-cd3ddc095a76",
                                        "entry_id": "85a8b6a9-7b46-3d40-a92a-56b5296abab6",
                                        "glosses": [
                                            "To cause something to happen by mentioning it, usually sarcastically."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7c7534-e305-4343-95f2-63554a6f7a93",
                                                "sense_id": "f6b43de2-76ee-3124-88a7-cd3ddc095a76",
                                                "text": "“So you'll all be near New York!” Maggie says. “We don't know for sure yet.” Sara stresses. “Don't jinx it.”"
                                            },
                                            {
                                                "example_id": "e53babe7-e655-46d1-a76c-54d24ffb4545",
                                                "sense_id": "f6b43de2-76ee-3124-88a7-cd3ddc095a76",
                                                "text": "I've no idea if she guessed what I was intending to do. I don't know why I was so reluctant to talk about it, even to her. Maybe I was afraid that verbalising my intentions would jinx it in some way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jinx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c54123d8-a821-3720-8122-19e460295c0d",
                                        "entry_id": "cdcd714c-987d-37b1-9ccc-b5a7ea4c5a72",
                                        "glosses": [
                                            "Used after the same thing is said by two people simultaneously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0b42815-76b3-434b-9bd0-8c303e4001d5",
                                                "sense_id": "c54123d8-a821-3720-8122-19e460295c0d",
                                                "text": "Bart: I'm telling Mom and Dad! / Lisa: You're telling who? / Bart: Mom and Dad! / Girls: MOM AND DAD? JINX! / Janey Powell: Now you can't talk, 'til somebody says your name!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
