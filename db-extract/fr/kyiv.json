                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                        "entry_id": "a31b4680-1f6a-3f35-8967-dd4d5fd179f3",
                        "glosses": [
                            "alternative form of Kiev"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8f90aa-80d4-421a-8807-79f9f013131e",
                                "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                                "text": "La dispersion par les Allemands des assemblées des paysans, les arrestations faites à Kyiv après le coup d’état devinrent le signal de la révolte des paysans."
                            },
                            {
                                "example_id": "3815bfdd-ad88-4a80-a299-1cb4b5b00e21",
                                "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                                "text": "La deuxième petite rivière, Lybed, maintenant à peine visible, autrefois assez importante (3), limitait les hauteurs de Kyiv au sud ; […]"
                            },
                            {
                                "example_id": "87d0a576-f3d7-46a8-83ec-73804e5652be",
                                "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                                "text": "Soixante élèves sont également inscrits à l’«école du dimanche» de la communauté juive ukrainienne, à Kyiv."
                            },
                            {
                                "example_id": "a426978c-91b3-47ae-8ed5-b114e4dcfeec",
                                "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                                "text": "De 1941 à 1945, les armées hitlériennes luttèrent contre celles de Staline à Kyiv, Lviv, Odessa et Sébastopol.",
                                "translation": "From 1941 to 1945, Hitler's armies fought against those of Stalin at Kyiv, Lviv, Odessa and Sebastopol.",
                                "english": "From 1941 to 1945, Hitler's armies fought against those of Stalin at Kyiv, Lviv, Odessa and Sebastopol."
                            },
                            {
                                "example_id": "0faec1a5-0480-4900-99df-28e8d38a722b",
                                "sense_id": "f720d46a-33ef-3a86-8bf2-f896f88ae32a",
                                "text": "D’origine japonaise, j’ai grandi en Ukraine, où je suis arrivée à l’âge de 10 ans avec mes parents, qui se sont installés à Kyiv après avoir travaillé trois ans à Moscou.",
                                "translation": "Of Japanese origin, I grew up in Ukraine, where I turned 10 with my parents, who moved to Kyiv after working for three years in Moscow.",
                                "english": "Of Japanese origin, I grew up in Ukraine, where I turned 10 with my parents, who moved to Kyiv after working for three years in Moscow."
                            }
                        ]
                    }
                ],
