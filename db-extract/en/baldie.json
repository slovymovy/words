                        "entry_id": "a98d8018-4272-3e87-9d47-8a6a72883033",
                        "glosses": [
                            "Somebody who is bald."
                        ],
                        "tags": [
                            "derogatory",
                            "informal",
                            "often"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3326e9bc-1ae2-3fa2-adfc-636cb38e97d0",
                        "entry_id": "a98d8018-4272-3e87-9d47-8a6a72883033",
                        "glosses": [
                            "A bald eagle (Haliaeetus leucocephalus)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "10480be9-7a3b-4028-97ad-e2228c4527f0",
                                "sense_id": "3326e9bc-1ae2-3fa2-adfc-636cb38e97d0",
                                "text": "The bald eagle is the national bird of the United States. Plus the bird is endangered. So, yeah, I'd probably have a problem with sitting down to a plate of baldie for dinner."
                            },
                            {
                                "example_id": "b3fdd47d-1f59-4eaa-add8-3164c7be610b",
                                "sense_id": "3326e9bc-1ae2-3fa2-adfc-636cb38e97d0",
                                "text": "They are almost always accompanied by immature bald eagles that, although about the same size as a mature baldie, have a darkened head and mottled feathers."
                            }
                        ]
                    },
                    {
                        "sense_id": "0de44cac-5256-3d19-a99d-d2854e5e5870",
                        "entry_id": "a98d8018-4272-3e87-9d47-8a6a72883033",
                        "glosses": [
                            "The baldchin groper (Choerodon rubescens)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "084a127c-693d-4f73-82eb-33ce23d323ac",
                                "sense_id": "0de44cac-5256-3d19-a99d-d2854e5e5870",
                                "text": "\"Baldies. Baldchin gropers. Tastiest fish I've caught this week,\" I replied."
                            }
                        ]
                    }
                ],
