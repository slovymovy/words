        "nl-extract.jsonl": [
            {
                "entry_id": "41fa0380-dcd1-35c8-ae2b-d5dae9b09237",
                "word": "eclecticisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44b0639a-5d7f-3545-aa14-19e3e4e9bd80",
                        "entry_id": "41fa0380-dcd1-35c8-ae2b-d5dae9b09237",
                        "glosses": [
                            "een nieuwe filosofische stroming die is gebaseerd op diverse oudere filosofische stromingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab8179aa-fedc-4d27-b3c6-bc2a774d75b5",
                                "sense_id": "44b0639a-5d7f-3545-aa14-19e3e4e9bd80",
                                "text": "Het begrip eclecticisme wordt onder meer in de kunst, de filosofie en de theologie gebruikt. De grondgedachte is dat uit meerdere stromingen of stijlen steeds de beste elementen worden geselecteerd en gecombineerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e5e2e47-bd4d-370a-8116-1627d860d086",
                        "entry_id": "41fa0380-dcd1-35c8-ae2b-d5dae9b09237",
                        "glosses": [
                            "een nieuwe bouwstijl die is gebaseerd op verschillende oudere bouwstijlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c209b7c7-05c6-4fa7-b6c2-c6402a13d1fd",
                                "sense_id": "9e5e2e47-bd4d-370a-8116-1627d860d086",
                                "text": "Het eclecticisme in de architectuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e498ac77-4265-3aaa-b40d-4d06c4cf469b",
                        "entry_id": "41fa0380-dcd1-35c8-ae2b-d5dae9b09237",
                        "glosses": [
                            "het selecteren van verschillende doctrines, methoden enz. of een bepaald onderdeel hiervan, om zo tot een geheel nieuw systeem, nieuwe opvatting enz. te komen"
                        ],
                        "tags": [
                            "bij uitbreiding"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97e78cbb-afa6-4124-9f45-c49977bff1b9",
                        "source_entry_id": "41fa0380-dcd1-35c8-ae2b-d5dae9b09237",
                        "source_sense_id": "44b0639a-5d7f-3545-aa14-19e3e4e9bd80",
                        "source_sense_description": "een nieuwe filosofische stroming die is gebaseerd op diverse oudere filosofische stromingen",
                        "target_lang_word": "eclecticism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eclecticism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "The quality of being eclectic"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04adf62-32dc-47d8-89de-2d1381ea6962",
                                                "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                                "text": "In those days she had admired his pluralistic openness of mind, and struggled, in her kitchen, towards a parallel eclecticism, learning to cook the dosas and uttapams of South India as well as the soft meatballs of Kashmir."
                                            },
                                            {
                                                "example_id": "ff947766-6b35-4267-baf1-6307adc898cc",
                                                "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                                "text": "I am concerned that this encouraging but brief period of success will foster the opinion, already widely held, that the monetary pillar is superfluous, and lead monetary policy analysis back to the kind of muddled eclecticism that brought us the 1970s inflation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "987ec297-fadc-3e40-b80e-bcf44930232b",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "An approach to thought that draws upon multiple theories to gain complementary insights into phenomena"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "772e0e85-694a-3c84-a19a-dabc8bf9a1b0",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "Any form of art that borrows from multiple other styles"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
