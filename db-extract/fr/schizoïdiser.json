                        "examples": [
                            {
                                "example_id": "d1e78d9c-1822-4f03-8651-f38c8710efdf",
                                "sense_id": "36c72ea9-1eaa-3b76-b6d0-650ad0b26af8",
                                "text": "Elle dichotomise - elle «schizoïdise» - notre rapport à l’étendue."
                            },
                            {
                                "example_id": "37bc6ff0-fd71-4f64-b582-08077d91226e",
                                "sense_id": "36c72ea9-1eaa-3b76-b6d0-650ad0b26af8",
                                "text": "Le manifeste mutantiste force à penser ? . . sûr . . comme tout ce qui fulgure, schizoïdise, entropise, néologise, métasyntextualise, . . donc indispensabilise, pour le moment, quoique !"
                            }
                        ]
