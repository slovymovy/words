{
    "word_family": [
        "gallerist",
        "galleried"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                    "sense_definition": "An institution, building, or room for the exhibition and conservation of important objects, especially works of art.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art_venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the entire afternoon wandering through the art <w>gallery</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, бродя по художественной <w>галерее</w>.",
                                "zh": "我们整个下午都在艺术<w>美术馆</w>里漫步。"
                            }
                        },
                        {
                            "text": "The national <w>gallery</w> displays genuine artifacts recovered from the ancient site.",
                            "target_lang_translations": {
                                "ru": "В национальной <w>галерее</w> выставлены подлинные артефакты, найденные на месте древних раскопок.",
                                "zh": "国家<w>美术馆</w>展出了从古遗址中发掘出的珍贵文物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "museum",
                        "exhibition hall"
                    ],
                    "common_phrases": [
                        "art gallery",
                        "national gallery",
                        "visit a gallery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учреждение или помещение для выставки и хранения произведений искусства",
                        "zh": "用于展示和保存重要物品，特别是艺术品的机构、建筑或房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "художественный музей"
                            },
                            {
                                "target_lang_word": "выставочный зал",
                                "target_lang_sense_clarification": "место проведения выставок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美术馆",
                                "target_lang_sense_clarification": "专门展示艺术品的机构"
                            },
                            {
                                "target_lang_word": "画廊",
                                "target_lang_sense_clarification": "展示艺术品的空间"
                            },
                            {
                                "target_lang_word": "展览馆",
                                "target_lang_sense_clarification": "举办展览的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e4dd4c-0f04-308a-9a69-81bb629a49d5",
                    "sense_definition": "A browsable collection of digital images, videos, font styles, or other media.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click on the thumbnail to view the full photo <w>gallery</w>.",
                            "target_lang_translations": {
                                "ru": "Нажмите на миниатюру, чтобы просмотреть всю фото<w>галерею</w>.",
                                "zh": "点击缩略图查看完整照片<w>图库</w>。"
                            }
                        },
                        {
                            "text": "The software includes a <w>gallery</w> of templates to help you get started.",
                            "target_lang_translations": {
                                "ru": "Программа включает <w>галерею</w> шаблонов, которые помогут вам начать работу.",
                                "zh": "该软件包含一个模板<w>图库</w>，可以帮助你快速上手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collection",
                        "album",
                        "library"
                    ],
                    "common_phrases": [
                        "photo gallery",
                        "image gallery",
                        "view gallery"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in computing and internet contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коллекция цифровых изображений, видео или других медиафайлов",
                        "zh": "可供浏览的数字图像、视频、字体样式或其他媒体的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "набор изображений в интерфейсе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图库",
                                "target_lang_sense_clarification": "数字图像集合"
                            },
                            {
                                "target_lang_word": "相册",
                                "target_lang_sense_clarification": "照片集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                    "sense_definition": "An establishment that buys, sells, and displays works of art.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some of her best paintings are available for purchase at a local <w>gallery</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые из её лучших картин можно купить в местной <w>галерее</w>.",
                                "zh": "她的一些优秀画作可以在当地的一家<w>画廊</w>买到。"
                            }
                        },
                        {
                            "text": "He hopes to find a <w>gallery</w> willing to represent his work to collectors.",
                            "target_lang_translations": {
                                "ru": "Он надеется найти <w>галерею</w>, готовую представлять его работы коллекционерам.",
                                "zh": "他希望能找到一家愿意向收藏家代理他作品的<w>画廊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "art dealer",
                        "showroom"
                    ],
                    "common_phrases": [
                        "gallery owner",
                        "open a gallery",
                        "commercial gallery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческое учреждение, занимающееся продажей и выставкой произведений искусства",
                        "zh": "买卖和展示艺术品的商业机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "салон по продаже картин"
                            },
                            {
                                "target_lang_word": "арт-галерея",
                                "target_lang_sense_clarification": "современное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画廊",
                                "target_lang_sense_clarification": "艺术品交易场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "027dd399-50bd-3f41-9e22-e24be12103e2",
                    "sense_definition": "The uppermost seating area projecting from the rear or side walls of a theater, concert hall, or auditorium, usually containing the cheapest seats.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theater_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could only afford the less expensive seats up in the <w>gallery</w>.",
                            "target_lang_translations": {
                                "ru": "Мы могли позволить себе только недорогие места на <w>галёрке</w>.",
                                "zh": "我们只能买得起<w>楼座</w>那些较便宜的座位。"
                            }
                        },
                        {
                            "text": "From the <w>gallery</w>, the actors looked quite small, but the sound was excellent.",
                            "target_lang_translations": {
                                "ru": "С <w>галёрки</w> актёры казались совсем маленькими, но звук был отличным.",
                                "zh": "从<w>楼座</w>看去，演员们显得很小，但音响效果非常好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "balcony",
                        "gods"
                    ],
                    "antonyms": [
                        "stalls",
                        "orchestra"
                    ],
                    "common_phrases": [
                        "peanut gallery",
                        "sit in the gallery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхний ярус зрительного зала в театре или концертном зале, обычно с самыми дешёвыми местами",
                        "zh": "剧院、音乐厅或礼堂后墙或侧墙突出的最高座位区，通常票价最便宜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галёрка",
                                "target_lang_sense_clarification": "верхний ярус, разг."
                            },
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "архитектурный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "楼座",
                                "target_lang_sense_clarification": "剧院高层座位"
                            },
                            {
                                "target_lang_word": "顶层看台",
                                "target_lang_sense_clarification": "位置最高、价格最低的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13646b96-5648-3d71-9fa6-ee43c3015470",
                    "sense_definition": "A roofed promenade, especially one extending along the wall of a building and supported by arches or columns on the outer side.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace features an elegant <w>gallery</w> looking out onto manicured gardens.",
                            "target_lang_translations": {
                                "ru": "Во дворце есть элегантная <w>галерея</w> с видом на ухоженные сады.",
                                "zh": "这座宫殿有一条优雅的<w>长廊</w>，可以俯瞰修剪整齐的花园。"
                            }
                        },
                        {
                            "text": "Guests walked through the long <w>gallery</w> to reach the main banquet hall.",
                            "target_lang_translations": {
                                "ru": "Гости прошли через длинную <w>галерею</w>, чтобы попасть в главный банкетный зал.",
                                "zh": "客人们穿过那条长长的<w>回廊</w>才到达主宴会厅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colonnade",
                        "arcade",
                        "corridor",
                        "loggia"
                    ],
                    "common_phrases": [
                        "long gallery",
                        "minstrels' gallery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крытый проход, часто с арками или колоннами, соединяющий части здания",
                        "zh": "有顶棚的走廊，尤指沿建筑物墙壁延伸，外侧由拱门或柱子支撑的通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            },
                            {
                                "target_lang_word": "крытая галерея",
                                "target_lang_sense_clarification": "проход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长廊",
                                "target_lang_sense_clarification": "建筑中的长通道"
                            },
                            {
                                "target_lang_word": "回廊",
                                "target_lang_sense_clarification": "带顶棚的建筑通道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                    "sense_definition": "The spectators at an event or in a courtroom, considered collectively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spectators",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's speech was clearly appealing to the <w>gallery</w> rather than addressing the core issues.",
                            "target_lang_translations": {
                                "ru": "Речь политика явно была рассчитана на <w>публику</w>, а не на решение основных проблем.",
                                "zh": "这位政客的演讲显然是在迎合<w>观众</w>，而不是在解决核心问题。"
                            }
                        },
                        {
                            "text": "The judge ordered the <w>gallery</w> to remain silent during the testimony.",
                            "target_lang_translations": {
                                "ru": "Судья приказал <w>присутствующим</w> соблюдать тишину во время дачи показаний.",
                                "zh": "法官命令<w>旁听席</w>在作证期间保持安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "audience",
                        "spectators",
                        "public"
                    ],
                    "common_phrases": [
                        "play to the gallery",
                        "public gallery"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in idioms regarding public opinion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зрители или публика, особенно те, чьё мнение считается поверхностным или массовым",
                        "zh": "活动或法庭上的观众，作为一个整体来看。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "публика",
                                "target_lang_sense_clarification": "зрители, общественность"
                            },
                            {
                                "target_lang_word": "зрители",
                                "target_lang_sense_clarification": "присутствующие в зале"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "观众",
                                "target_lang_sense_clarification": "在场观看的人"
                            },
                            {
                                "target_lang_word": "旁听席",
                                "target_lang_sense_clarification": "法庭上的观众"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3ca437-6de7-3b7b-a664-c10fcd57b39b",
                    "sense_definition": "A horizontal underground passage, level, or drive in a mine or fortification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners worked in the lower <w>gallery</w> extracting coal.",
                            "target_lang_translations": {
                                "ru": "Шахтёры работали в нижней <w>галерее</w>, добывая уголь.",
                                "zh": "矿工们在下层的<w>巷道</w>里采煤。"
                            }
                        },
                        {
                            "text": "Soldiers moved through the fortified <w>gallery</w> to reach the defensive walls.",
                            "target_lang_translations": {
                                "ru": "Солдаты двигались по укреплённой <w>галерее</w>, чтобы добраться до оборонительных стен.",
                                "zh": "士兵们穿过加固的<w>坑道</w>到达防御墙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tunnel",
                        "passage",
                        "drift"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context (mining/military)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальный подземный ход в шахте или фортификационном сооружении",
                        "zh": "矿井或防御工事中的水平地下通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галерея",
                                "target_lang_sense_clarification": "горное или военное дело"
                            },
                            {
                                "target_lang_word": "штольня",
                                "target_lang_sense_clarification": "горизонтальная выработка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坑道",
                                "target_lang_sense_clarification": "矿井或军事通道"
                            },
                            {
                                "target_lang_word": "巷道",
                                "target_lang_sense_clarification": "矿山水平通道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "849c103f-2474-3407-abe0-87c744be5008",
                    "sense_definition": "A surname of Irish origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gallery</w> has lived in this town for over fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Галлери</w> живёт в этом городе уже более пятидесяти лет.",
                                "zh": "<w>加勒里</w>先生在这个镇上已经住了五十多年了。"
                            }
                        },
                        {
                            "text": "We are looking for the records of the <w>Gallery</w> family.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье <w>Галлери</w>.",
                                "zh": "我们正在寻找<w>加勒里</w>家族的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "from Irish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия ирландского происхождения",
                        "zh": "爱尔兰裔姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Галлери",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加勒里",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4205b14d-3d0c-3dd7-80fe-ffa0444c949b",
                    "sense_definition": "To show off or display oneself ostentatiously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the evening <w>gallerying</w> around the club, trying to impress everyone.",
                            "target_lang_translations": {
                                "ru": "Он провёл вечер, <w>рисуясь</w> в клубе и пытаясь произвести на всех впечатление.",
                                "zh": "他整个晚上都在俱乐部里<w>作秀</w>，试图给每个人留下深刻印象。"
                            }
                        },
                        {
                            "text": "Stop <w>gallerying</w> and help us with the work.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>работать на публику</w> и помоги нам с работой.",
                                "zh": "别再<w>哗众取宠</w>了，过来帮我们干活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show off",
                        "posture"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "rare or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставлять себя напоказ, вести себя демонстративно",
                        "zh": "炫耀或虚伪地展示自己。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рисоваться",
                                "target_lang_sense_clarification": "вести себя неестественно"
                            },
                            {
                                "target_lang_word": "играть на публику",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作秀",
                                "target_lang_sense_clarification": "为了博取关注而表演"
                            },
                            {
                                "target_lang_word": "哗众取宠",
                                "target_lang_sense_clarification": "用浮夸言行吸引人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}