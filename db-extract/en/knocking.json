    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aa543e3c-0e7a-3e82-a7a4-0daef8b88824",
                "word": "knocking",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1e0adad-be2c-4266-bb24-bb28d1da6eeb",
                        "entry_id": "aa543e3c-0e7a-3e82-a7a4-0daef8b88824",
                        "tags": [
                            "plural"
                        ],
                        "form": "knockings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dfae786-6ab1-3776-92ed-21747c4d7bdf",
                        "entry_id": "aa543e3c-0e7a-3e82-a7a4-0daef8b88824",
                        "glosses": [
                            "An act in which something is knocked on, or the sound thus produced"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c30d35-a335-48fe-a131-78e34c68256c",
                                "sense_id": "9dfae786-6ab1-3776-92ed-21747c4d7bdf",
                                "text": "These strange openings and closings and knockings were warnings and reminders from the spirits who attend the dying."
                            },
                            {
                                "example_id": "7b3d4685-d863-4020-a4b8-ace62065bc7c",
                                "sense_id": "9dfae786-6ab1-3776-92ed-21747c4d7bdf",
                                "text": "There was no response to continued knockings."
                            },
                            {
                                "example_id": "608fe94b-2340-4551-be8f-ff127ed16296",
                                "sense_id": "9dfae786-6ab1-3776-92ed-21747c4d7bdf",
                                "text": "Recorded live to CD with new instrumentation--artillery shells, tuned suspension cables, boxes filled with springs--and deemphasized guitar parts, it's a beautiful collection of echoes and whispers, drones and knockings, with a gently swelling sense of the sinister."
                            }
                        ]
                    },
                    {
                        "sense_id": "64bff667-452f-3cad-9a38-bc9b37e76253",
                        "entry_id": "aa543e3c-0e7a-3e82-a7a4-0daef8b88824",
                        "glosses": [
                            "A repetitive ping, knock, or similar sound coming from an engine in which there are repeated uncontrolled explosions in the combustion chamber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b172516-2072-41c7-9dc5-3f46c11811e0",
                                "sense_id": "64bff667-452f-3cad-9a38-bc9b37e76253",
                                "text": "Sir―I was greatly interested in a short article in The Motor Cycle on the subject of engine knocking."
                            },
                            {
                                "example_id": "f3f0c0e8-6f09-4823-a255-e27997cebc73",
                                "sense_id": "64bff667-452f-3cad-9a38-bc9b37e76253",
                                "text": "Knocking can also occur at high speed, but that may go undetected by the driver."
                            }
                        ]
                    }
                ],
