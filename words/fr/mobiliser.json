                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association cherche constamment à <w>mobiliser</w> les citoyens autour des questions environnementales."
                        },
                        {
                            "text": "Pour mener à bien ce grand projet, nous devons <w>mobiliser</w> toutes nos forces."
                        }
                    ],
                    "synonyms": [
                        "rassembler",
                        "fédérer"
                    ],
                    "antonyms": [
                        "démobiliser"
                    ],
                    "common_phrases": [
                        "mobiliser les énergies",
                        "mobiliser l'opinion",
                        "mobiliser des ressources"
                    ]
                },
                {
                    "sense_id": "854a100d-4282-3fde-b1d5-f159125b4e42",
                    "sense_definition": "Mettre des troupes ou des réservistes sur le pied de guerre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à la menace grandissante, le gouvernement décida de <w>mobiliser</w> immédiatement l'armée."
                        },
                        {
                            "text": "Le pays a dû <w>mobiliser</w> ses réservistes dès le début des hostilités."
