                "senses": [
                    {
                        "sense_id": "754c1825-eacf-3229-a5fc-ace2631626f1",
                        "entry_id": "234f6b7b-687f-33a6-90e1-54fd4a40083d",
                        "glosses": [
                            "Ergebnis, das im Jahr vor dem aktuellen Jahr erzielt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f57cde10-7843-4610-8035-5978492f94a4",
                                "sense_id": "754c1825-eacf-3229-a5fc-ace2631626f1",
                                "text": "„Der Gesamtumsatz lag im ersten Halbjahr 2020 mit 417 Millionen Euro um 1,9 Prozent unter dem Vorjahresergebnis.“"
                            },
                            {
                                "example_id": "ed7afe43-1676-478b-a0aa-97fa13321516",
                                "sense_id": "754c1825-eacf-3229-a5fc-ace2631626f1",
                                "text": "„Benjamin drehte dabei das Vorjahresergebnis um und schnappte sich mit 20-19-18 erstmals den Sieg vor Florian (20-18-18) und dem Hippersdorfer Ferdinand Haas (20-18-18).“"
                            },
                            {
                                "example_id": "4aaa1667-4ed5-4c19-8045-c226014bd297",
                                "sense_id": "754c1825-eacf-3229-a5fc-ace2631626f1",
                                "text": "„Der Brasilianer überholte damit übrigens unter ganz anderen Vorzeichen sein Vorjahresergebnis.“"
                            }
                        ],
