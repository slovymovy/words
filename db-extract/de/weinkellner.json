                        "glosses": [
                            "derjenige Kellner, der die Gäste, aber auch den Inhaber eines gastronomischen Betriebes über Weine berät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cae18f5-9183-47d7-8576-e66123fc5da6",
                                "sense_id": "f9c35d9c-4fcc-3ac2-81be-86240de67ddb",
                                "text": "„Ich hielt währenddessen die Stellung beim Weinkellner und reichte volle Gläser nach hinten.“"
                            },
                            {
                                "example_id": "960d866b-8743-4258-b805-88fe2083cc49",
                                "sense_id": "f9c35d9c-4fcc-3ac2-81be-86240de67ddb",
                                "text": "„Sommeliers sind einfach Weinkellner auf gehobenem Niveau.“"
                            }
                        ],
