                    {
                        "sense_id": "63c0b54a-b37f-3eda-af59-f5f557dc0780",
                        "entry_id": "3a9edf3f-5cb4-35f3-88bc-c31e7742d435",
                        "glosses": [
                            "One who bathes (cleans oneself with water, for example in a bathtub)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878ef258-9bce-4dba-8219-7d37d7f6dba1",
                                "sense_id": "63c0b54a-b37f-3eda-af59-f5f557dc0780",
                                "text": "When using sitz tubs that have been placed in a bathtub, the bather can use the tub's sides to assist their movement. Otherwise, to make it easier for the bather to get up and down, it helps to elevate the sitz tub on blocks."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e9180ad-7ff1-3035-998f-00dcb8f7ab4e",
                        "entry_id": "3a9edf3f-5cb4-35f3-88bc-c31e7742d435",
                        "glosses": [
                            "One who immerses oneself in water for pleasure or refreshment: one who swims (for example at a lake or beach)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1167064d-4d97-43bf-940b-ecc043d8a45d",
                                "sense_id": "5e9180ad-7ff1-3035-998f-00dcb8f7ab4e",
                                "text": "Both bathers on the beach and bathers in the water at the time of sample collection were categorized as fewer than 20, 20-100, 101-200, and more than 200."
                            }
                        ]
                    },
                    {
                        "sense_id": "771bf147-0e5e-3c81-b6a6-442394408910",
                        "entry_id": "3a9edf3f-5cb4-35f3-88bc-c31e7742d435",
                        "glosses": [
                            "One who gives a bath to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c93fa24-7aae-4417-a5c7-62a439fdd1df",
                                "sense_id": "771bf147-0e5e-3c81-b6a6-442394408910",
                                "text": "Even though becoming a dog groomer requires training, many grooming salons will hire somebody with no experience to be a dog bather and will then train that person to become a dog groomer."
                            }
                        ]
