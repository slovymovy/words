                        "entry_id": "43e0822a-9064-36d2-980e-5340406f4fdb",
                        "glosses": [
                            "kobieta pełna entuzjazmu, chęci i wiary w możliwość zrealizowania jakiejś idei; kobieta żywo poruszona, pobudzona jakąś ideą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d38950-c99d-4036-8e10-dcf905c80fe2",
                                "sense_id": "80b7bf84-ac74-3c0c-8c10-e1ea4a8ee3bb",
                                "text": "Gabrysia jest entuzjastką skoków spadochronowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e39f87a-b992-428c-93c8-63cc5a3ac987",
                        "source_entry_id": "43e0822a-9064-36d2-980e-5340406f4fdb",
                        "source_sense_id": "80b7bf84-ac74-3c0c-8c10-e1ea4a8ee3bb",
                        "target_lang_word": "entusiasta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entusiasta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "44d8c285-0fee-3a48-b445-bc9fcc9dff81",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Que siente entusiasmo por alguien o algo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f055cd-f68b-4db1-8d55-2dd218f11e57",
                                                "sense_id": "44d8c285-0fee-3a48-b445-bc9fcc9dff81",
                                                "text": "«Un seguidor entusiasta de Kepler fue Jeremiah Horrocks (1618-1641), fallecido a los 22 años»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac711d0e-4b7d-3d4c-b01d-1c45226a942b",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Propenso a entusiasmarse."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d42a5bb-2597-4825-b448-87d02e8afeff",
                                                "sense_id": "ac711d0e-4b7d-3d4c-b01d-1c45226a942b",
                                                "text": "«Muchos son los medios de que se puede valer el maestro o profesor entusiasta y deseoso de progresar, para mejorar su desempeño profesional; (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c040f6c2-5d11-35f4-b259-0023e39dbc8a",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Entusiástico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229ce3d7-7ed5-4ba2-b1c4-2102eecc5673",
                                                "sense_id": "c040f6c2-5d11-35f4-b259-0023e39dbc8a",
                                                "text": "«El público de Milán, tan crítico cuando se trata de aquellos roles que se consideraban dominio de tenores italianos desde siempre, me ovacionó de forma entusiasta»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
