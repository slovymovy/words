                "senses": [
                    {
                        "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                        "entry_id": "976dd1af-07ea-3070-bfb7-8581ac22b52f",
                        "glosses": [
                            "Ziege, die in Gebirgen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df00056f-01aa-4ed0-8e2f-f50311e01cf8",
                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                "text": "„Der aserbaidschanische Schmuggler brachte eine große, wasserundurchlässige Tasche ins Zimmer, wie sie oft an Booten auf dem Kaspischen Meer festgemacht ist oder von Bergziegen auf dem Rücken getragen wird, die die verschneiten Höhen des Kaukasus überqueren.“"
                            },
                            {
                                "example_id": "b4bb0e37-0fb2-4c40-bafb-14a57791d8b5",
                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                "text": "„Der Indianer stieg das Kliff hinauf wie eine Bergziege.“"
                            },
                            {
                                "example_id": "e71895b4-633c-42d0-b035-6106d6170fea",
                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                "text": "„›Ich weiß noch, wie ich drüben in Wyoming mal einen Winter lang allein eingeschneit war. Oberhalb der Baumgrenze, und kein Weg nach unten. So hoch, dass es da kein Wild gab; den ganzen Winter habe ich nur von meinem Pferd und von einer Bergziege gelebt; an Unterschlupf hatte ich nur, was ich mir aus dem Fell meines Gauls zusammenbauen konnte.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
