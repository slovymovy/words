                                            "A carangoid fish of California."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c3cc32d-ab37-4c5f-90f6-0fa114306abf",
                        "source_entry_id": "a4fb24f3-809c-3966-ae78-6d041f682f44",
                        "target_lang_word": "sheefish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sheefish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa9fbe3-d10e-3cd1-aef0-3b9f2a534641",
                                        "entry_id": "5de57732-a1a4-3c35-983f-96220d46a7eb",
                                        "glosses": [
                                            "Synonym of inconnu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dece5c30-77a5-4d08-86ce-a7484129e835",
                                                "sense_id": "2aa9fbe3-d10e-3cd1-aef0-3b9f2a534641",
                                                "text": "Anglers who successfully locate, hook, and land sheefish usually accomplish the feat using stout 12- and 15-pound spinning gear cast into deep, moderate-flowing rivers, and retrieved deep along a graveled stream bottom."
                                            },
                                            {
                                                "example_id": "217dd32b-590d-4394-a616-b056ff402d18",
                                                "sense_id": "2aa9fbe3-d10e-3cd1-aef0-3b9f2a534641",
                                                "text": "I've been fortunate to taste a wide variety of fish from around the globe, and one whose flavor always makes my mouth water is the sheefish."
                                            },
                                            {
                                                "example_id": "22798f4b-1c07-40c7-ad69-3120a583d64d",
                                                "sense_id": "2aa9fbe3-d10e-3cd1-aef0-3b9f2a534641",
                                                "text": "Furthermore, sheefish in the Kuskokwim drainage come and go unpredictably, which meant we might be casting to fish that were actually hundreds of miles away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
