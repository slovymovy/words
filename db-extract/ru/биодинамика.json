                                "target_senses": [
                                    {
                                        "sense_id": "ad3e1bc9-0d59-3be3-bd8c-84aac5263999",
                                        "entry_id": "c052aa43-2337-3952-8801-4b33d7b8634d",
                                        "glosses": [
                                            "Biodynamic agricultural practices similar to organic farming."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5914189-e779-44d4-a6fd-c9685506ce85",
                                                "sense_id": "ad3e1bc9-0d59-3be3-bd8c-84aac5263999",
                                                "text": "Marc Kreydenweiss, an Alsatian producer, is a champion of biodynamics, an extreme form of organic agriculture based on the planets’ positions."
                                            },
                                            {
                                                "example_id": "3dfe33ec-d2f5-4a32-bfb2-9a8ee47116a9",
                                                "sense_id": "ad3e1bc9-0d59-3be3-bd8c-84aac5263999",
                                                "text": "I had heard that a cool cosmetic company, Dr. Hauschka, used biodynamically grown botanicals, and something about the teetotaling founder of the Waldorf Schools, philosopher Rudolph Steiner, who had also founded biodynamics and died in the 1920s. But several of the wines I'd already earmarked as winners turned out to be made either purely or in part with biodynamics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e878e81b-126b-34a5-974e-bff7153a7aaf",
                                        "entry_id": "c052aa43-2337-3952-8801-4b33d7b8634d",
                                        "glosses": [
                                            "The doctrine of vital forces or energy."
                                        ],
