                        "examples": [
                            {
                                "example_id": "37431699-b925-4726-9bfc-2ecf9007cd0c",
                                "sense_id": "1c802640-ffc6-37b8-a06b-610d37e28759",
                                "text": "In de nasleep van het ongeluk verloor de man zijn werk, zijn huis en zijn vrouw."
                            },
                            {
                                "example_id": "2a62092b-9fc1-4de1-9c36-64ce2681812c",
                                "sense_id": "1c802640-ffc6-37b8-a06b-610d37e28759",
                                "text": "Onderzoekers van de LHC-deeltjesversneller hebben bewijs gevonden voor een ongekend zware en exotische vorm van antimaterie. Die ontdekten ze in de nasleep van een botsing tussen extreem snelle looddeeltjes."
                            }
                        ]
                    }
