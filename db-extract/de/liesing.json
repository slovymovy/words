                        "form_id": "1453b6ca-3c0e-41d6-8707-fede0ed0ff31",
                        "entry_id": "693433f1-f81e-32f6-8c1a-2c8b7d7e33ad",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Liesing"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c07cef28-5f72-3ec1-b039-c9a3f972f205",
                        "entry_id": "693433f1-f81e-32f6-8c1a-2c8b7d7e33ad",
                        "glosses": [
                            "ein 30 Kilometer langer Fluss, der im Wienerwald entspringt, den 23. Wiener Bezirk durchfließt und beim Ort Schwechat in den Fluss Schwechat mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4db46e4-4a36-41e8-9fe3-c265a6a5735a",
                                "sense_id": "c07cef28-5f72-3ec1-b039-c9a3f972f205",
                                "text": "Die Liesing entspringt an zwei verschiedenen Quellen auf rund 520 m Höhe im Wienerwald."
                            },
                            {
                                "example_id": "5b5cbb40-0737-4c4a-91a5-0c79b9c4bf7d",
                                "sense_id": "c07cef28-5f72-3ec1-b039-c9a3f972f205",
                                "text": "Das zurzeit betonierte Bachbett der Liesing verhindert nämlich die Selbstreinigung des Flusses."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23d8cb8a-f1c0-3301-a971-2d23efeadab3",
                        "entry_id": "693433f1-f81e-32f6-8c1a-2c8b7d7e33ad",
                        "glosses": [
                            "ein 40 Kilometer langer Fluss im Bezirk Leoben in der Obersteiermark, der in den Seckauer Alpen entspringt und bei Sankt Michael auf 596 Meter Seehöhe in die Mur fließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981f20d5-3125-431e-bceb-a9e623dfb65a",
                                "sense_id": "23d8cb8a-f1c0-3301-a971-2d23efeadab3",
                                "text": "Benannt nach den beiden Flüssen Palten und Liesing trennen sich die beiden Gewässer gleich nach deren Ursprung im Gebiet des Schoberpasses durch die Wasserscheide."
                            },
                            {
                                "example_id": "c41ff083-5db1-499c-be1c-2bad8642565e",
                                "sense_id": "23d8cb8a-f1c0-3301-a971-2d23efeadab3",
                                "text": "Das Tal der Liesing bildet den südlichen Teil des über den Schoberpass führenden Verbindungstales zwischen dem Ennstal und dem Murtal."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
