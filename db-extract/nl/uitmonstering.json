                                        "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A set of clothing (with accessories)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "428e6ed8-a0f8-4885-ab45-033453be0dcb",
                                                "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                                "text": "She wore a fashionable outfit with matching purse and shoes."
                                            },
                                            {
                                                "example_id": "dd86e578-270d-4d51-acbf-1eb31aa6e581",
                                                "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                                "text": "Don't call what you're wearing an outfit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6ce33b-aef5-3396-b9bb-1ef00672d3ef",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "Gear consisting of a set of articles or tools for a specified purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d311f768-c527-3a46-bedc-50d5348e816c",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "Any cohesive group of people; a unit; such as a military company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34deeb2-d1c5-47d7-8e67-24afbbd9ac20",
                                                "sense_id": "d311f768-c527-3a46-bedc-50d5348e816c",
                                                "text": "The League of One was suddenly exposed and in danger of being hunted by enemies of the salarians. Before any harm could be done, the team mysteriously disappeared.[...]Realizing the threat posed by this rogue outfit, the Special Tasks Group dispatched a team of hunters. When they didn't return, the STG dispatched ten of its brightest operators with broad discretionary powers. Only two returned; they reported no evidence of the League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9364ab77-5b61-34aa-8cce-abb4bb474f1f",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A business or firm."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79737ddb-22a7-4713-a187-ffde0196e938",
                                                "sense_id": "9364ab77-5b61-34aa-8cce-abb4bb474f1f",
                                                "text": "Should we buy it here, or do you think the outfit across town will have a better deal?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7b5f09-ed37-3980-9f2b-30b15cdadda4",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3d716e-e45e-4dad-b18b-2beae695a2a7",
                                                "sense_id": "db7b5f09-ed37-3980-9f2b-30b15cdadda4",
                                                "text": "With only two fit centre-backs available, Tottenham boss Harry Redknapp employed young midfielder Jake Livermore at the back alongside Sebastien Bassong but Spurs struggled against a seasoned Champions League outfit, who beat Barcelona at the Nou Camp in 2009-10 and continually worked their way between the home defence to create some golden opportunities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f59af32-e3d9-3f8c-bb25-290c3b7f212a",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "An outlier-sensitive fit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a206c1c5-15e3-3ae2-8cb1-e6393a09b044",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A fiscal year of the Hudson's Bay Company, or the supplies required for such a period."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "128c0f25-5da8-40c0-bcbd-67ed69845284",
                                                "sense_id": "a206c1c5-15e3-3ae2-8cb1-e6393a09b044",
                                                "text": "[…] the outfit of 1821, which outfit suffered a loss. From 1822 there were profits on each outfit as the many subsequent credit entries indicate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a66150-358c-3b3c-8838-c6f4fc6485ce",
                                        "entry_id": "26be500a-4ee0-3c7f-92da-09a4e474a892",
                                        "glosses": [
                                            "To provide with, usually for a specific purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
