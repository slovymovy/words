                "senses": [
                    {
                        "sense_id": "917e04ce-d35d-3457-aa22-ca3d3abc5fca",
                        "entry_id": "a6ed2fc1-006e-3351-895b-10da1488cd6b",
                        "glosses": [
                            "kleines Spülbecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7409211-3dae-4733-955c-841f47e65f28",
                                "sense_id": "917e04ce-d35d-3457-aa22-ca3d3abc5fca",
                                "text": "„Dort stand die Mutter über den Handstein gebeugt, einen Arm auf den Messinghahn gelegt und darauf die Stirn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "795777a7-3f5b-3e79-b69e-703d05b443eb",
                        "entry_id": "a6ed2fc1-006e-3351-895b-10da1488cd6b",
                        "glosses": [
                            "schönes Gesteinsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8a9da1-0bee-4800-9ba7-6f16cacd493d",
                                "sense_id": "795777a7-3f5b-3e79-b69e-703d05b443eb",
                                "text": "„Die Handsteine des 16. Jahrhunderts entstanden in der Zeit der Spätrenaissance, also des Manierismus, und sind charakteristische Arbeiten dieser Periode: Eine Verbindung von Natur und Kunst, wertvoll gefaßte, seltene und bizarre Mineralien und Kristalle, dazu bestimmt, in der Kunst- und Wunderkammer einer hochgestellten Persönlichkeit oder eines Fürsten präsentiert zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
