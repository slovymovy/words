                                "target_senses": [
                                    {
                                        "sense_id": "4a846ec6-4738-39c5-9f4b-b2b447afe35e",
                                        "entry_id": "1220c6b5-6171-38d6-b831-245057a2399f",
                                        "glosses": [
                                            "Espèce de concombre dont la pulpe est extrêmement amère et très purgative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9ac300-b411-4019-b45a-e2e0398a1b93",
                                                "sense_id": "4a846ec6-4738-39c5-9f4b-b2b447afe35e",
                                                "text": "Pomme de coloquinte."
                                            },
                                            {
                                                "example_id": "df4486fc-89b6-43fe-884d-515f601aa925",
                                                "sense_id": "4a846ec6-4738-39c5-9f4b-b2b447afe35e",
                                                "text": "Amer comme coloquinte."
                                            },
                                            {
                                                "example_id": "40e0fe81-a73a-4ec9-8815-16630521053c",
                                                "sense_id": "4a846ec6-4738-39c5-9f4b-b2b447afe35e",
                                                "text": "Il lui avait prescrit des pilules à base de coloquinte pour soigner ses maux d’estomac."
                                            },
                                            {
                                                "example_id": "0007fe6a-92bd-46d1-bcfe-935a09b224ee",
                                                "sense_id": "4a846ec6-4738-39c5-9f4b-b2b447afe35e",
                                                "text": "Femmes montées sur une estrade improvisée, attachant en l’air des branches de pin, des coloquintes, des pièces de poésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36909ce2-cc5b-316e-83c2-357d036d2492",
                                        "entry_id": "1220c6b5-6171-38d6-b831-245057a2399f",
                                        "glosses": [
                                            "Quelque chose rempli d’amertume."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ea7924-5ca4-4e1b-b04b-2f172beeef82",
                                                "sense_id": "36909ce2-cc5b-316e-83c2-357d036d2492",
                                                "text": "Ce bizarre bonhomme hérissé [Ferdinand Brunetière], et dont la vie fut une perpétuelle coloquinte, sut mourir admirablement, héroïquement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
