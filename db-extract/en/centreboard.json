                                    },
                                    {
                                        "sense_id": "b028df86-9b85-3d47-be34-348928b3fb76",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Angle que la quille du bâtiment fait avec la direction réelle de sa route."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "219ae61e-84c0-374b-94ee-85c245f22666",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Déplacement en mer, au gré du vent et des courants, en parlant des glaces ou des varechs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7f68ae-3751-489d-bad4-36f8bca8a768",
                                                "sense_id": "219ae61e-84c0-374b-94ee-85c245f22666",
                                                "text": "La dérive des glaces parallèle au Groenland est attribuée au courant polaire ; elle peut être influencée par les vents, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c0649d-0b2b-3695-95d7-751b9ff08020",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Mauvaise direction, mauvaise pente."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1983303d-c0a1-44ee-a71a-a23ebb2942ea",
                                                "sense_id": "04c0649d-0b2b-3695-95d7-751b9ff08020",
                                                "text": "Cet homme va à la dérive."
                                            },
                                            {
                                                "example_id": "99dd8971-f795-4c26-a020-ea0ee523674f",
                                                "sense_id": "04c0649d-0b2b-3695-95d7-751b9ff08020",
                                                "text": "Professeur retraitée, j’ai assisté, au cours des décennies, à la dérive constante due à la démission des « élites » responsables."
                                            },
                                            {
                                                "example_id": "f45a9596-5468-4e7f-8988-852749b89ee4",
                                                "sense_id": "04c0649d-0b2b-3695-95d7-751b9ff08020",
                                                "text": "Depuis 1980 la dérive des comptes publics fut systématique, quelle que soit la couleur politique des gouvernements."
                                            },
                                            {
                                                "example_id": "dbad0247-6eda-486b-b1b2-adc56518e03b",
                                                "sense_id": "04c0649d-0b2b-3695-95d7-751b9ff08020",
                                                "text": "Pensé comme un antidote à la dérive sensationnaliste de X, Bluesky intègre de nombreux outils configurables pour se protéger des contenus problématiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee2cae27-7658-373c-a92d-1f3f001e5537",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Élément fixe ou mobile d'un bateau permettant de réduire les déplacements du bateau dans la direction perpendiculaire à son plan de symétrie, à la différence du gouvernail, qui est destiné à permettre le changement de cap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "136f7c89-3025-3e6f-a729-0eac47a8e96d",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Aileron situé sous la planche de surf, et qui sert la stabiliser."
                                        ],
                                        "tags": [
                                            "Surf"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0cc81d7-7a20-33e5-adb7-418f03369949",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Empennage vertical qui comporte une partie mobile qui a la même fonction que le gouvernail sur un navire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad444e5e-13eb-32c6-bc9e-55f587a0c5e4",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Action, en particulier politique, qui diffère de celle annoncée par ceux qui la mènent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1502434-b7e7-489b-bbff-87fe33bcfdfd",
                                                "sense_id": "ad444e5e-13eb-32c6-bc9e-55f587a0c5e4",
                                                "text": "A l’occasion des élections législatives de dimanche, la presse hexagonale a redécouvert les dérives du miracle économique allemand, dénoncées depuis dix ans."
                                            },
                                            {
                                                "example_id": "b4b10a1b-29b2-4fe7-9489-5d6c1529db88",
                                                "sense_id": "ad444e5e-13eb-32c6-bc9e-55f587a0c5e4",
                                                "text": "Plus personne, c’est le moins qu’on puisse dire, ne croit vraiment au récit enchanté de la mondialisation heureuse. Au contraire, on constate de mille manières ses dérives."
                                            },
                                            {
                                                "example_id": "d8614e2f-6cb5-47d1-afaa-b710edc884fe",
                                                "sense_id": "ad444e5e-13eb-32c6-bc9e-55f587a0c5e4",
                                                "text": "Par-delà les débats idéologiques, on a déjà pointé les dérives potentielles d’une société ultra-gérée (de Gaulejac, 2005) dans laquelle la production se réoriente en fonction d’indicateurs et d’objectifs de plus en plus souvent détachés de la réalité, tandis que le non-mesurable tend à être négligé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac843c11-022a-31a3-994d-c80195d1c742",
                                        "entry_id": "b468e705-8ee7-38cf-8d4e-8480c2cc3e58",
                                        "glosses": [
                                            "Tendance des abeilles à retourner à la mauvaise ruche à la fin d’un vol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9a263d-361c-4a9a-8448-8cb64e5539e7",
                                                "sense_id": "ac843c11-022a-31a3-994d-c80195d1c742",
                                                "text": "Seuls défauts pour l’apiculture, sa tendance à la dérive, c’est-à-dire à se tromper de ruche, ce qui favorise la diffusion des maladies et des parasites, et sa tendance au pillage, due à un rayon de butinage moins important que celui des autres races européennes."
                                            }
                                        ]
                                    }
                                ]
                            },
