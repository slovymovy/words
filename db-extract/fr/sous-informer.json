                "senses": [
                    {
                        "sense_id": "61b0dc51-a4b6-3051-96f7-8c2bb7a832f1",
                        "entry_id": "71424e2a-1618-3829-8319-9ace686e57d7",
                        "glosses": [
                            "Informer insuffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ac15ec-cb1b-4b88-85e4-cca8e39d7ce1",
                                "sense_id": "61b0dc51-a4b6-3051-96f7-8c2bb7a832f1",
                                "text": "Et il est ainsi conduit à poser une éthique du journalisme : Il ne faut ni désinformer ni sous-informer."
                            },
                            {
                                "example_id": "d2e7b282-80de-425e-9f35-67a75d8c50dc",
                                "sense_id": "61b0dc51-a4b6-3051-96f7-8c2bb7a832f1",
                                "text": "Ils estiment aussi que les journalistes occidentaux sous-informent l'opinion publique des pays industrialisés quant aux problèmes essentiels du tiers monde."
                            }
                        ]
                    }
