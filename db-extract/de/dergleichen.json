                                "sense_id": "9236890e-4fef-3bbc-8cf3-d35de2f17a83",
                                "text": "Fernsehtürme und dergleichen hohe Gebäude schätzt der unter Höhenangst leidende Xaver gar nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
