                    },
                    {
                        "sense_id": "97cb1db8-eb85-3360-ae3d-ca47ecb08b84",
                        "entry_id": "d54e4f7b-3099-3f0b-a524-39032f5cabe7",
                        "glosses": [
                            "porywczy, dziki, kierowany silnymi emocji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c97112-e3d8-486d-88dd-9d4952960ebb",
                                "sense_id": "97cb1db8-eb85-3360-ae3d-ca47ecb08b84",
                                "text": "Po godzinie żywiołowych dyskusji zebranie wreszcie się skończyło."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "60bbda17-1fed-35a2-a329-766944bfd896",
