                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ea1391-7d6f-4e3d-8077-c93ad2dadf4a",
                                "sense_id": "7b44be9d-7846-3096-8776-843d58b28afb",
                                "text": "Dans la suite, les Confucianistes parvinrent à imposer leur conception aux Empereurs, à « confucianiser les lois » ;"
                            },
                            {
                                "example_id": "54d783c4-6878-4ba6-9b18-439031aa0871",
                                "sense_id": "7b44be9d-7846-3096-8776-843d58b28afb",
                                "text": "Cette injonction a énormément contribué à « confucianiser » les esprits chinois et, de manière plus large, à façonner la civilisation chinoise."
                            }
                        ]
                    }
