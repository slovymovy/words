                                    {
                                        "sense_id": "e946464f-5185-388e-9323-41d05d5708b7",
                                        "entry_id": "c57c1b32-733d-3a23-814e-faea2ae8a6a0",
                                        "glosses": [
                                            "Medikament, welches Opium enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987e5bc5-015a-429c-b0d6-04077c05fd1c",
                                                "sense_id": "e946464f-5185-388e-9323-41d05d5708b7",
                                                "text": "„Der Handel mit den Betäubungsmitteln war perfekt organisiert: DHL lieferte die Päckchen mit den Opiaten in Tablettenform, die Drogengelder wiederum wurden per ICE-Kurier an die Lieferantin überstellt.“"
                                            },
                                            {
                                                "example_id": "04899056-6bed-4b93-b0e7-1db5e8d94526",
                                                "sense_id": "e946464f-5185-388e-9323-41d05d5708b7",
                                                "text": "Der Drogentest auf Opiate war beim ihm positiv."
                                            },
                                            {
                                                "example_id": "69eb0e6d-c872-48e8-bc6c-e94e96512983",
                                                "sense_id": "e946464f-5185-388e-9323-41d05d5708b7",
                                                "text": "„Auch wissen wir, dass Cook auf seiner zweiten Reise mit Opiaten behandelt worden war, dem einzigen effektiven Schmerzmittel in der Medizinkiste des Schiffsarztes.“"
                                            }
                                        ],
