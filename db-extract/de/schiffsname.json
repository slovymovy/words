                ],
                "senses": [
                    {
                        "sense_id": "6df4187a-0d55-3066-9970-c54757f774e8",
                        "entry_id": "6ac2b060-c904-3812-8d44-80e44c6493bd",
                        "glosses": [
                            "Name eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7804c0c-c9fc-4bc7-b771-2aadfaab7cc3",
                                "sense_id": "6df4187a-0d55-3066-9970-c54757f774e8",
                                "text": "„Bis heute kenne ich den Schiffsnamen nicht.“"
                            },
                            {
                                "example_id": "49bdf8fa-7c02-4004-8442-79a6d447e330",
                                "sense_id": "6df4187a-0d55-3066-9970-c54757f774e8",
                                "text": "„Er war es einfach gewohnt, Schiffsnamen angeführt zu sehen, und hat, wie bei Imitatoren üblich, das Umständliche mit dem Wesentlichen verwechselt.“"
                            },
                            {
                                "example_id": "aaa36e8c-f050-4a2b-beba-dafa1d77518b",
                                "sense_id": "6df4187a-0d55-3066-9970-c54757f774e8",
                                "text": "„Ich sah einen kleinen buckligen Kommis aus dem gegenüberliegenden Büro der Schiffahrtsgesellschaft heraustreten, um auf das dürre Täfelchen vor der Tür einen Schiffsnamen einzutragen, eine Abfahrtszeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
