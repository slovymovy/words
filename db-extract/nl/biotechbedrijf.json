                        "sense_id": "0ed0e3ca-49f5-3eaf-8e9c-db71751bbf0b",
                        "entry_id": "4662ac02-9e70-33af-9f6b-09a198e1aa42",
                        "glosses": [
                            "bedrijf dat biotechnologie op een commerciële wijze gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15778d42-8810-4e80-9fe8-a180e742dd24",
                                "sense_id": "0ed0e3ca-49f5-3eaf-8e9c-db71751bbf0b",
                                "text": "Elk uur worden 4500 jonge hanenkuikens die net uit het ei zijn gekomen, gedood. Ze hebben geen waarde voor de pluimveeindustrie. Een Leids biotechbedrijf heeft een methode ontwikkeld waarmee mogelijk een einde kan komen aan het massale doden van kuikens. Met die methode kan in korte tijd worden bepaald of er een mannetje of vrouwtje in het ei zit."
                            },
                            {
                                "example_id": "84c85b01-49da-4e5b-a734-c798e5e2f18a",
                                "sense_id": "0ed0e3ca-49f5-3eaf-8e9c-db71751bbf0b",
                                "text": "Monsanto produceert genetisch gemanipuleerde zaden en bestrijdingsmiddelen voor de landbouw. Ook vraagt het biotechbedrijf veel patenten aan op natuurlijke eigenschappen van groenten. Er wordt wereldwijd regelmatig tegen het bedrijf gedemonstreerd."
                            }
                        ]
                    }
