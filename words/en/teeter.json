    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "140c8b7d-3720-3034-9b59-c0d61d13eb71",
                    "sense_definition": "To tilt or sway back and forth while balanced on an edge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>teeter</w> on the edge of the wooden bench."
                        },
                        {
                            "text": "The heavy box started to <w>teeter</w> before finally falling off the table."
                        }
                    ],
                    "synonyms": [
                        "wobble",
                        "sway"
                    ],
                    "common_phrases": [
                        "teeter on the edge"
                    ]
                },
                {
                    "sense_id": "75bcad26-9da9-3d96-b5bd-6f37f55f2758",
                    "sense_definition": "To move in an unsteady or shaky manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>teeter</w> across the icy path in her high heels."
                        },
                        {
                            "text": "The old man began to <w>teeter</w> as he stood up from his chair."
                        }
                    ],
                    "synonyms": [
                        "totter",
                        "stagger"
                    ],
                    "antonyms": [
                        "steady"
                    ]
                },
                {
                    "sense_id": "a173b782-4afd-3c4b-8c0a-2ff4929e79aa",
                    "sense_definition": "To be unable to make a decision or to hesitate between two choices.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They continued to <w>teeter</w> between the two job offers for several weeks."
                        },
                        {
                            "text": "Do not <w>teeter</w> when you need to make a quick choice."
                        }
                    ],
                    "synonyms": [
                        "hesitate",
                        "waver"
                    ],
                    "antonyms": [
                        "decide"
                    ]
                },
                {
                    "sense_id": "e09e3905-ba6e-3338-b884-58da7da76447",
                    "sense_definition": "To be in a precarious state close to a negative outcome.",
