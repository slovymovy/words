                "senses": [
                    {
                        "sense_id": "ebf64bc4-a835-35c0-a17a-e6b42f77a703",
                        "entry_id": "acc3b02c-467d-380f-894c-61bc6ab2763c",
                        "glosses": [
                            "есть много, с жадностью, до пресыщения, тем самым причиняя себе вред"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8265b467-2a7d-453c-aef6-39a0c16b4f51",
                                "sense_id": "ebf64bc4-a835-35c0-a17a-e6b42f77a703",
                                "text": "— А где ты собираешься обжираться? — Обжираться следует в «Обжоре» — это же элементарно! — снисходительно объяснил я."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0636c0d1-ce5e-4f46-ad98-c06f364b380e",
                        "source_entry_id": "acc3b02c-467d-380f-894c-61bc6ab2763c",
                        "source_sense_id": "ebf64bc4-a835-35c0-a17a-e6b42f77a703",
                        "target_lang_word": "überfressen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überfressen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b512c8f-7804-35d5-ad2c-cddd0b4957c9",
                                        "entry_id": "14c80887-3741-372e-98b1-2eabaefae60f",
                                        "glosses": [
                                            "eine unverträglich große Menge fressen/essen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d20f81-832a-4b5c-b873-1743959fec74",
                                                "sense_id": "2b512c8f-7804-35d5-ad2c-cddd0b4957c9",
                                                "text": "„Wenn aber ein paar Schweine kränkeln, rote Ohren und blaue Nasen haben und nicht richtig essen wollen, verputzen andere ihre Ration und überfressen sich. Das ist teuer und schlimmstenfalls tödlich.“"
                                            },
                                            {
                                                "example_id": "4e9354ef-69ef-43a0-86c1-337adbbb39fe",
                                                "sense_id": "2b512c8f-7804-35d5-ad2c-cddd0b4957c9",
                                                "text": "„Sie hatten sich vermutlich an den Meeresfrüchten überfressen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
