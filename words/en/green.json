                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sally looks pretty <w>green</w>—is she going to be sick?",
                            "target_lang_translations": {
                                "ru": "Салли выглядит совсем <w>зелёной</w> — её сейчас стошнит?"
                            }
                        },
                        {
                            "text": "He turned <w>green</w> as soon as the boat started moving.",
                            "target_lang_translations": {
                                "ru": "Он <w>позеленел</w>, как только лодка тронулась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "look green",
                        "turn green"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe nausea"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненный, бледный (обычно от тошноты)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "о цвете лица при тошноте"
