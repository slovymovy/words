                "senses": [
                    {
                        "sense_id": "75497c09-318d-31df-a6e4-b2eeb2b6f9e3",
                        "entry_id": "dd939aac-ff16-38e2-a641-1d160e7992dc",
                        "glosses": [
                            "eine Art des Singens (besonders im Musiktheater), die ausschließlich von der gesprochenen Prosa ausgeht"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "7b97019e-506b-4ff7-9416-c6b9d763237a",
                                "sense_id": "75497c09-318d-31df-a6e4-b2eeb2b6f9e3",
                                "text": "„Der Sprechgesang ersetzt nach Meinung der Franzosen sowohl den griechischen Chor wie auch unser Rezitativ, das sie verachten, aber nicht verachten würden, wenn sie unsere Sprache verstünden.“"
                            },
                            {
                                "example_id": "1a62fe4c-17dd-421c-b966-592287862296",
                                "sense_id": "75497c09-318d-31df-a6e4-b2eeb2b6f9e3",
                                "text": "„Weitere Gedanken zu Arie und Rezitativ folgen, denn auf die ist Wielands Singspielkonzept eingeschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
