                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f3497b7-291d-38b8-9030-66cd823ebb12",
                        "entry_id": "db226685-275b-3b8f-b0ea-1ee76f9f35c8",
                        "glosses": [
