                    "sense_id": "c5fb3661-c766-3d3d-a527-ceb526378c88",
                    "sense_definition": "To count or list items one by one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher will <w>numerate</w> each sample before testing them in the laboratory.",
                            "target_lang_translations": {
                                "tr": "Araştırmacı, laboratuvarda test etmeden önce her bir numuneyi <w>numaralandıracak</w>."
                            }
                        },
                        {
                            "text": "Please <w>numerate</w> the items on the checklist to ensure nothing is missing.",
                            "target_lang_translations": {
                                "tr": "Hiçbir şeyin eksik olmadığından emin olmak için lütfen kontrol listesindeki maddeleri <w>sayın</w>."
