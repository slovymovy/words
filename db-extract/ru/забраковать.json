                                                "sense_id": "45b454e1-5f17-3cb8-b169-6d4e4c8fa5ff",
                                                "text": "I've been rejected three times this week."
                                            },
                                            {
                                                "example_id": "823811b8-9795-49a9-8715-cb089610f24c",
                                                "sense_id": "45b454e1-5f17-3cb8-b169-6d4e4c8fa5ff",
                                                "text": "It's unexpected / It usually is / When you're rejected / Or you take a hit"
                                            }
                                        ]
                                    }
                                ]
                            },
