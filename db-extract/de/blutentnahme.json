                        "entry_id": "88655d49-9750-3635-959b-814ab0659b6f",
                        "glosses": [
                            "Prise de sang, prélèvement sanguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d73c41f-6875-4e3d-9b24-8b4429180ccd",
                                "sense_id": "ef7fb1a3-21ac-3505-9bad-49120111fbae",
                                "text": "Die Staatsanwaltschaft ordnete eine Blutentnahme zur Überprüfung auf Alkohol- und Drogenkonsum an.",
                                "translation": "Le parquet a ordonné un prélèvement sanguin afin de vérifier la consommation d’alcool et de drogues."
                            },
                            {
                                "example_id": "75a420a4-a26c-47c4-97ac-7dd9814b5887",
                                "sense_id": "ef7fb1a3-21ac-3505-9bad-49120111fbae",
                                "text": "Die Unfallverursacherin wurde daraufhin zur Blutentnahme gebracht, ihr Führerschein wurde sichergestellt.",
                                "translation": "La responsable de l’accident a ensuite subi une prise de sang et son permis lui a été retiré."
                            }
                        ]
                    }
