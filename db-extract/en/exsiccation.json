                                "example_id": "b0d818c0-5b8d-43ee-a78a-c536a7b6fd96",
                                "sense_id": "0dc29be9-b7d2-3fcb-9f0b-cf96996c97f9",
                                "text": "That which is concreted by exsiccation or expression of humidity, will be resolved by humectification, as earth, dirt and clay."
