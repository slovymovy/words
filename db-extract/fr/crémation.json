                                "target_senses": [
                                    {
                                        "sense_id": "106255a4-1d51-3427-8bae-5b852d620bfe",
                                        "entry_id": "40b18543-c34b-3bc3-bd2b-1dabef04a7bf",
                                        "glosses": [
