                "senses": [
                    {
                        "sense_id": "d0e690eb-2b39-35f9-b60d-8b39fc06c0ab",
                        "entry_id": "df5f1638-2883-3734-9626-1c3917713f27",
                        "glosses": [
                            "mit Kopfsteinpflaster belegte Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b27f346b-c231-4375-9c69-5aa7a16b7aa0",
                                "sense_id": "d0e690eb-2b39-35f9-b60d-8b39fc06c0ab",
                                "text": "„Einen guten Kilometer nachdem er auf die alte Kopfsteinpflasterstraße eingebogen war, stieß er auf den Teufelsfriedhof.“"
                            },
                            {
                                "example_id": "d49c881d-1d17-4023-b939-e94a5cc5c166",
                                "sense_id": "d0e690eb-2b39-35f9-b60d-8b39fc06c0ab",
                                "text": "„Am nächsten Morgen ging ich zu Fuß den Berg hinab zur Stadt und durch die schmalen Kopfsteinpflasterstraßen mit den hohen geweißten Wänden und den bunten Fassaden der Geschäfte mit ihren Vordächern.“"
                            },
                            {
                                "example_id": "3cdcaab1-e534-479e-9f99-3dc4bedb1d8b",
                                "sense_id": "d0e690eb-2b39-35f9-b60d-8b39fc06c0ab",
                                "text": "„Kameras fürchtete er schon eher, weshalb er die Kopfsteinpflasterstraßen von Èze mit ihren Läden und Hotels und Restaurants mied, die bestimmt alle mit Sicherheitskameras mit Internetzugang ausgerüstet waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
