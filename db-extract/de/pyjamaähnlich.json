                        "glosses": [
                            "wie ein Pyjama; einem Pyjama ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c0f365-0200-4130-83e4-bae551ad9141",
                                "sense_id": "0c5e7393-7bf6-3fb3-9382-a7ad66d30e9c",
                                "text": "Das kleine Kind trägt ein pyjamaähnliches Kleid."
                            },
                            {
                                "example_id": "a109ddeb-f2f2-4118-ae13-6f648e0c0d53",
                                "sense_id": "0c5e7393-7bf6-3fb3-9382-a7ad66d30e9c",
                                "text": "„Sie trägt einen pyjamaähnlichen Anzug aus dunkelroter Seide mit Glitzersteinen verziert und wenn sie grinst, was sie häufig tut, kommt eine unvollständige Zahnreihe zum Vorschein.“"
                            }
                        ],
