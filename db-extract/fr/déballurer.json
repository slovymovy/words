                "senses": [
                    {
                        "sense_id": "56cd79de-4212-378a-a5f4-718a3d317270",
                        "entry_id": "e526e09c-2c60-3bdf-be50-4e142925e282",
                        "glosses": [
                            "Nettoyer la tête usée d’un outil percuté de ses appendices métalliques en frappant les bords de celle-ci dans le sens inverse de son usage habituel afin d’éviter les éclats accidentels lors de l’utilisation."
                        ],
                        "tags": [
                            "Taille de pierre"
                        ],
                        "examples": [
                            {
                                "example_id": "03b2054f-104a-4be8-a77b-0944b48e789a",
                                "sense_id": "56cd79de-4212-378a-a5f4-718a3d317270",
                                "text": "Ne pas déballurer ses vieux outils de temps en temps, c’est prendre le risque de recevoir un éclat métallique dans l’œil lors de leur utilisation."
                            }
                        ]
                    }
