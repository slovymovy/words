                "senses": [
                    {
                        "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                        "entry_id": "b2df7282-f240-3834-a895-fd0b6a5be6cd",
                        "glosses": [
                            "Handlung, Maßnahme, etwas Bestimmtes nicht zu beachten, in Betracht zu ziehen, zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971c394d-ee8d-4ca3-9a80-dc5bf300aa72",
                                "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                                "text": "„Ein zentrales Problem der Betreuung der Klientin liegt in deren partieller Ausblendung von problematischen Aspekten ihrer eigenen Lebenssituation.“"
                            },
                            {
                                "example_id": "b1c740bd-89ff-40ba-ba5a-56cf61de3596",
                                "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                                "text": "„Streitkulturell interessant ist aber das Problem, wie Kommentare zu beurteilen sind, die auf der bewussten Ausblendung von Tatsachen beruhen.“"
                            },
                            {
                                "example_id": "df3827a7-ae09-4a97-bb39-9ca9768f21e5",
                                "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                                "text": "„Der Ausfall der Selbstprüfung führt deshalb tendenziell zur Ausblendung der zum Abendmahl versammelten Leiber (einschließlich des eigenen Leibes).“"
                            },
                            {
                                "example_id": "688a89bd-06a2-409f-91da-18e9e0d44abb",
                                "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                                "text": "„Während aber im ersten Fall, auf die bekannten Details geschaut wird, geht es hier um die gezielte Ausblendung unangenehmer Details.“"
                            },
                            {
                                "example_id": "c47d6883-cbe3-49a8-9dab-011d73c52b58",
                                "sense_id": "aeec43a5-652c-346d-aa6a-ed2e3ac7a733",
                                "text": "„Die Ausblendung negativer Zukunftserwartungen kann aber auch in zwischenmenschlichen Beziehungen dazu führen, dass man auf eigentlich vorhersehbare Krisen nicht eingestellt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
