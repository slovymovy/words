                "senses": [
                    {
                        "sense_id": "28f6ff21-54cf-3212-bf9e-2c7522c61708",
                        "entry_id": "a031204f-18ee-355f-983f-301d1be2874d",
                        "glosses": [
                            "Substance phytosanitaire, de formule chimique C₉H₁₃ClN₆, à usage d'herbicide de certaines graminées et de certaines dicotylédones et sélectif des cultures de pois et de maïs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96922ec5-8324-4f86-b547-dd163486501a",
                                "sense_id": "28f6ff21-54cf-3212-bf9e-2c7522c61708",
                                "text": "L'ajout de métolachlore à la cyanazine augmente son efficacité contre les graminées adventices annuelles comme la sétaire verte."
                            },
                            {
                                "example_id": "e27d72ff-0648-4a55-a81f-d581a311c01a",
                                "sense_id": "28f6ff21-54cf-3212-bf9e-2c7522c61708",
                                "text": "Un herbicide appliqué à un pois chiche infesté par différentes espèces de mauvaises herbes risque de ne pas éliminer la totalité des mauvaises herbes. Celles qui échappent, peuvent causer des pertes en rendement non négligeables. C'est le cas des herbicides suivants: Maloran (chlorbromuron), Gesagard (prometryne), Tribunil (metabenzthiazuron), Bladex (cyanazine)."
                            }
                        ]
                    }
