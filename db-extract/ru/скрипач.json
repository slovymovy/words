                ],
                "senses": [
                    {
                        "sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                        "entry_id": "9bd82838-8210-3733-b8f4-271e9aae184c",
                        "glosses": [
                            "музыкант, специалист по игре на скрипке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2327d1-ef3e-452e-aa61-c2ea713339f6",
                                "sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                                "text": "Скрипач из оркестра Большого театра."
                            },
                            {
                                "example_id": "9a0564e3-9eb9-4d29-9a26-543e1d772dbc",
                                "sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                                "text": "Отдельный скрипач сам управляет собой, оркестр нуждается в дирижере."
                            },
                            {
                                "example_id": "8488def8-aa8c-45f5-bc16-6935e20f27a1",
                                "sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                                "text": "Тенор здесь хрипит рулады, // Там скрипит скрипач слепой // Так, что все оглохнуть рады, // Только б дать ушам покой."
                            },
                            {
                                "example_id": "68449a4a-96c3-4b6d-8d8e-fe2a38808297",
                                "sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                                "text": "Скрипач-виртуоз может извлечь и из обычной скрипки такие звуки, которые недоступны для других, даже хороших музыкантов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afc27dc1-dcc1-450c-a0ce-4b3851e4cb79",
                        "source_entry_id": "9bd82838-8210-3733-b8f4-271e9aae184c",
                        "source_sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                        "target_lang_word": "violinist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violinist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                        "entry_id": "1e1771f9-7a89-3604-b6dc-c1f679de1a22",
                                        "glosses": [
                                            "A person who plays the violin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941bbffa-8684-408b-8b1a-1095bd7dad44",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            },
                                            {
                                                "example_id": "646e586c-2003-47e5-8b38-6a39546babab",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "Founded in 1975 and led by the violinist Richard Tognetti since 1989, the orchestra looks youthful and hip onstage, its players clad in varying shades of black semiformality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fa48a5b-b1c2-4dbf-a46c-287a88721d51",
                        "source_entry_id": "9bd82838-8210-3733-b8f4-271e9aae184c",
                        "source_sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                        "target_lang_word": "fiddler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiddler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f3f46a-d7a8-3bfe-8bb1-a736262bb7a9",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who plays the fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles; a cheat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b6849e-7b62-4099-8f26-e4619a8eca54",
                                                "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                                "text": "We were the self-controlled, cautious, nifty merchants, decorous fiddlers of accounts, hoarders of wealth, excellent bribers, family and community creatures governed by manners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles or tweaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f61b1b-f94c-4d06-96c9-dcb45ff5c6ff",
                                                "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                                "text": "The community of radio amateurs—trespassing fiddlers on the cutting edge of technological possibilities—prefigured the geek community that was to inhabit Silicon Valley 50 years later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a97453-d8db-336f-b34e-c168cd038dc6",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A burrowing crab of the genus Gelasimus, of many species. The male has one claw very much enlarged, and often holds it in a position similar to that in which a musician holds a fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30529351-33fb-3a4b-8854-82ba111ea5ba",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The common European sandpiper (Actitis hypoleucos); so called because it habitually wags its tail up and down resembling the back and forth movement of a fiddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a2437c0-6f3a-3e54-89c7-75e82ff5011a",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A large species of cicada, Macrotristria angularis, of eastern Australia; cherry nose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f15b00a-aa16-333d-83d1-73c84b908306",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A coin of little value: a sixpence or a farthing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The capstan-house on a steamer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5921ef5-7642-48d3-b970-bb4e57f1d057",
                                                "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                                "text": "Whereupon you shake hands with him […] and make room for him by your side in the \"Fiddler,\" when the pleasant time of night is come, and the stewardess is tucking up the ladies, and putting oranges and other goodies under their pillows, and the menfolk assemble in the capstan house to smoke their last cigar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b43195e-3681-4ba5-b9a4-fc1cba56556e",
                        "source_entry_id": "9bd82838-8210-3733-b8f4-271e9aae184c",
                        "source_sense_id": "e6337210-d250-3b52-9e9c-62fd327cc5ad",
                        "target_lang_word": "Geiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                        "entry_id": "3fb22f66-8cb1-3597-bb90-269c2c0c2ab3",
                                        "glosses": [
                                            "Person, die Geige spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbddc30e-48f5-4901-a44c-2581115fde44",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "Ihnen fehlt noch ein guter Geiger."
                                            },
                                            {
                                                "example_id": "d21385b3-a96a-4ca1-9100-129f1511c8c8",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Ihr Vater war ein jüdischer Geiger aus Prag, der Anfang der 30er Jahre erfolgreich in Berlin tätig war, Deutschland aber 1935 verlassen musste.“"
                                            },
                                            {
                                                "example_id": "c18b3c0f-7245-4b99-9681-c2a72f347c38",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Serana hatte zu der Zeit einen Geiger zur Seite, einen jener unwirklichen Bewohner der Pußta, der ungarischen Flachlandschaften, wo zu allen Zeiten die jungen Herren aufbrechen, um die Welt kennenzulernen, und nie kehren sie nach Hause zurück.“"
                                            },
                                            {
                                                "example_id": "d53675ae-ea3a-4bfb-ab19-24bade0d6b2e",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„In weniger als acht Tagen stand ich ohne einen Soldo da; da entschloß ich mich, Geiger zu werden.“"
                                            },
                                            {
                                                "example_id": "bba0c4f8-337e-41f5-b1e8-1885fff2d6db",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Als der Geiger in der sinkenden Nacht eine Romanze spielte, stieg ihr eine Weichheit aus dem Atem in die Stirn, daß die Augen schwer wurden vor plötzlich dahinter stehenden Tränen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
