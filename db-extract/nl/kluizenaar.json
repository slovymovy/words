                            {
                                "example_id": "aa3e7b78-7425-40ed-92a4-829c7f5e23c0",
                                "sense_id": "817e099d-bb73-33ec-bcf8-1c705f04db04",
                                "text": "Tijdens het lopen was ik vaak een kluizenaar, in het gezelschap van mijn gedachten."
                            }
                        ]
                    },
                    {
                        "sense_id": "053335c1-567c-3155-878b-2a7c85757254",
                        "entry_id": "c150903d-c448-34fc-873f-6b66676f043e",
