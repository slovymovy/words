                            },
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "劣质事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f3f8658-871b-3a9e-bdc5-d13fcd9f44d5",
                    "sense_definition": "A translation used as a study aid; loosely, a crib, a cheat-sheet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "study_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught using a Latin <w>pony</w> during the exam.",
                            "target_lang_translations": {
                                "ru": "Его поймали за использованием <w>подстрочника</w> по латыни во время экзамена.",
                                "zh": "他在考试时因使用拉丁语<w>小抄</w>被抓住了。"
                            }
                        },
                        {
                            "text": "She relied on a <w>pony</w> to understand the difficult text.",
                            "target_lang_translations": {
                                "ru": "Она полагалась на <w>шпаргалку</w>, чтобы понять сложный текст.",
                                "zh": "她依靠<w>翻译对照本</w>来理解那篇难懂的文章。"
                            }
                        }
