                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a7b99b6-5e3e-3162-98d3-96edae6d6396",
                        "entry_id": "2d9f32dd-743d-38b9-a124-8add34f3b70c",
                        "glosses": [
                            "Aufsichtsführung über Geldmittel eines Betriebes, Unternehmens oder Ähnlichen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "97144e35-33ff-4059-8b96-f676fcb1535b",
                                "sense_id": "6a7b99b6-5e3e-3162-98d3-96edae6d6396",
                                "text": "„Die operative Gebarung umfasst Ein- und Auszahlungen aus der operativen Verwaltungstätigkeit und laufende Transfers.“"
                            },
                            {
                                "example_id": "cf4d9876-5c44-43ea-ab68-0d252b50b374",
                                "sense_id": "6a7b99b6-5e3e-3162-98d3-96edae6d6396",
                                "text": "„Von einer ordnungsgemäßen Gebarung konnte keine Rede sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bda59a08-8480-4a58-868c-bdda96d5842f",
                        "source_entry_id": "2d9f32dd-743d-38b9-a124-8add34f3b70c",
                        "source_sense_id": "81b2ef6a-a3dc-3018-b3cd-4d501d950f9c",
                        "source_sense_description": "gehoben: Verhalten, das durch bestimmte Besonderheiten gekennzeichnet ist",
                        "target_lang_word": "conduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "756a9f96-6628-3d61-a5c8-a12a647eb99c",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "The act or method of controlling or directing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a80d7a85-30d5-49d9-9010-c25c888083e0",
                                                "sense_id": "756a9f96-6628-3d61-a5c8-a12a647eb99c",
                                                "text": "There are other restrictions imposed upon the conduct of war, not by the law of nature primarily, but by the laws of war first, and by the law of nature as seconding and ratifying the laws of war."
                                            },
                                            {
                                                "example_id": "1299c625-ebd7-4ef0-8605-151864467c92",
                                                "sense_id": "756a9f96-6628-3d61-a5c8-a12a647eb99c",
                                                "text": "the conduct of the state, the administration of its affairs, its policy, and its laws, are for more uncertain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64674d7-233b-3590-b9d4-2776ceefb16f",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "Skillful guidance or management."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57283fe8-9ed6-44c8-8194-a3c7695afb8c",
                                                "sense_id": "d64674d7-233b-3590-b9d4-2776ceefb16f",
                                                "text": "If thou wilt ſtay with me renowmed man, / And lead thy thouſand horſe with my conduct, / Beſides thy ſhare of this Egyptian prize, / Thoſe thouſand horſe shall ſweat with martiall ſpoyle / Of conquered kingdomes, and of Cities ſackt, […]"
                                            },
                                            {
                                                "example_id": "e573d20f-be16-4715-88ef-0c1a9663d0e2",
                                                "sense_id": "d64674d7-233b-3590-b9d4-2776ceefb16f",
                                                "text": "1722 (first printed) Edmund Waller, Poems, &c. written upon several occasions, and to several persons\nConduct of armies is a prince's art."
                                            },
                                            {
                                                "example_id": "136ae842-583d-41a3-b811-1c32ae1dfb58",
                                                "sense_id": "d64674d7-233b-3590-b9d4-2776ceefb16f",
                                                "text": "[…] attacked the Spaniards […] with great impetuosity, but with so little conduct, that his forces were totally routed."
                                            },
                                            {
                                                "example_id": "0cc8c5cb-ded3-4bc2-8db6-2481a500a99a",
                                                "sense_id": "d64674d7-233b-3590-b9d4-2776ceefb16f",
                                                "text": "At the head of that division which had Westminster Bridge for its approach to the scene of action, Lord George Gordon took his post; with Gashford at his right hand, and sundry ruffians, of most unpromising appearance, forming a kind of staff about him. The conduct of a second party, whose route lay by Blackfriars, was entrusted to a committee of management"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "Behaviour; the manner of behaving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67839f26-77cf-44b5-bad0-98cb5226d721",
                                                "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                                                "text": "Good conduct will be rewarded and likewise poor conduct will be punished."
                                            },
                                            {
                                                "example_id": "9cb5b0a2-977b-4af7-9800-56cbfaa7dd7a",
                                                "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                                                "text": "when she came to recall the affectionate and natural manner of the young Indian girl, and all the evidences of good faith and sincerity she had seen in her conduct during the familiar intercourse of their journey, she rejected the idea with the unwillingness of a generous disposition to believe ill of others"
                                            },
                                            {
                                                "example_id": "059bca62-2e7f-4dc2-b52b-019d46c1ebbf",
                                                "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                                                "text": "All these difficulties were increased by the conduct of Shrewsbury."
                                            },
                                            {
                                                "example_id": "f5ef6186-b962-491c-a7a6-cbf0234bfb79",
                                                "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                                                "text": "What in the conduct of our life appears / So well designed, so luckily begun, / But when we have our wish, we wish undone?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4043fd6-bab3-334a-8325-2b6399384be0",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "Plot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c246d5ee-8b9e-4108-a4f1-ea229816b9bf",
                                                "sense_id": "a4043fd6-bab3-334a-8325-2b6399384be0",
                                                "text": "The book of Job, indeed, in conduct and diction, bears a considerable resemblance to some of his dramas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430d44a1-b3f7-3a67-811f-0a2ecfa71fb0",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "Convoy; escort; person who accompanies another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c9cc58-6488-4557-a9e6-4b8d3f230fa4",
                                                "sense_id": "430d44a1-b3f7-3a67-811f-0a2ecfa71fb0",
                                                "text": "I will be your conduct."
                                            },
                                            {
                                                "example_id": "25e21b5d-aa31-4c00-8d5c-f8792b5bd8d5",
                                                "sense_id": "430d44a1-b3f7-3a67-811f-0a2ecfa71fb0",
                                                "text": "In my conduct shall your ladies come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc4f220-e60d-3f67-9d0a-81730116a7d1",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "Something which carries or conveys anything; a channel; an instrument; a conduit."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af8bf970-9c77-473a-b9fc-ec60d9fb4bcf",
                                                "sense_id": "9dc4f220-e60d-3f67-9d0a-81730116a7d1",
                                                "text": "although thou hast been conduct of my chame"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b15500-c3f2-3927-a82a-f433722a3cac",
                                        "entry_id": "6fcce6bc-184a-39f5-8f90-0a635a0ab468",
                                        "glosses": [
                                            "A priest hired to hold services without secure title; now a chaplain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676b6d4f-414f-4bbd-bbe1-fac8289e357e",
                                                "sense_id": "72b15500-c3f2-3927-a82a-f433722a3cac",
                                                "text": "[…] at this present it is one of the most goodly and uniform Colledges in Europe; wherein is a Master, 60 Fellows, 67 scholars, 4 Conducts, 3 Publique Professours […] besides officers and servants of the foundation, with many other students, being in all 440."
                                            },
                                            {
                                                "example_id": "b28bdd4f-9a45-4f76-a030-1303906703d8",
                                                "sense_id": "72b15500-c3f2-3927-a82a-f433722a3cac",
                                                "text": "Cory in 1722 obtained a licence of non-residence from Bishop Fleetwood, his patron, he being at that time one of the conducts, or chaplains, of King’s College."
                                            },
                                            {
                                                "example_id": "c5d79045-36cb-43ec-986c-a78577f40029",
                                                "sense_id": "72b15500-c3f2-3927-a82a-f433722a3cac",
                                                "text": "The Rev Charles Mitchell-Innes, Conduct of Eton College, officiated, assisted by Mr Ralph Allwood, Precentor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c5aee48-54f9-37d5-abce-0d43af936b5b",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To lead, or guide; to escort."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d7784f-41d1-4b83-aa01-08e25d35f21b",
                                                "sense_id": "3c5aee48-54f9-37d5-abce-0d43af936b5b",
                                                "text": "I can conduct you, lady, to a low / But loyal cottage, where you may be safe.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a090f256-69fe-30a0-b699-38664a65ff04",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To lead; to direct; to be in charge of (people or tasks)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91908d2-32d4-4442-b472-69bfbe93f214",
                                                "sense_id": "a090f256-69fe-30a0-b699-38664a65ff04",
                                                "text": "The commander conducted thousands of troops."
                                            },
                                            {
                                                "example_id": "89800cea-12cf-4d3d-b1b1-d6d6ec5a8e6c",
                                                "sense_id": "a090f256-69fe-30a0-b699-38664a65ff04",
                                                "text": "to conduct the affairs of a kingdom"
                                            },
                                            {
                                                "example_id": "604ae61b-5d13-4d96-9070-8098a1e13dbf",
                                                "sense_id": "a090f256-69fe-30a0-b699-38664a65ff04",
                                                "text": "the Turks, however efficient they may have been in field operations, had little skill as engineers, and no acquaintance with the true principles of conducting a siege"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "947e8295-4e0f-349c-8a78-a849bf7efbb1",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To behave."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe64cd2-b625-4b02-b82f-226a3d6acc31",
                                                "sense_id": "947e8295-4e0f-349c-8a78-a849bf7efbb1",
                                                "text": "He conducted himself well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222180d4-db05-3d29-a5a7-22ba99e3a9a3",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To serve as a medium for conveying; to transmit (heat, light, electricity, etc.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34e74aa-2240-4e03-9a03-ac798e7c9a5e",
                                                "sense_id": "222180d4-db05-3d29-a5a7-22ba99e3a9a3",
                                                "text": "Water and many other liquids do not conduct heat well. Wildland fuels in general, wood, and wood products conduct heat slowly, and so do soil and rocks."
                                            },
                                            {
                                                "example_id": "6dcb6c9b-0a34-46e3-b38c-b5203c7b1c2b",
                                                "sense_id": "222180d4-db05-3d29-a5a7-22ba99e3a9a3",
                                                "text": "The metal easily conducts electricity and doesn't rust in water, properties that have made it valuable in uses from household plumbing and electric wiring"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21711b0-90fe-398e-8682-4290b5c35cdb",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To direct, as the leader in the performance of a musical composition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb78d10-2b85-4a4f-ad34-2c9a78602e45",
                                                "sense_id": "e21711b0-90fe-398e-8682-4290b5c35cdb",
                                                "text": "For a while, Walter Pohlmann, a well-known German conductor, conducted the orchestra in Compound 3. Later, Willi Mets, who had conducted the world-renowned Leipzig Symphony Orchestra, conducted the Compound 3 orchestra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44a39df-b552-3962-bf30-409b59012644",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To act as a conductor (as of heat, electricity, etc.); to carry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5561d308-2b8e-3e03-97d6-b30dccc9bd8b",
                                        "entry_id": "73fd6d64-8420-310d-bb71-bfc602f8a25c",
                                        "glosses": [
                                            "To carry out (something organized)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d0b66f-1b32-4078-93ad-e3db3f4d2050",
                                                "sense_id": "5561d308-2b8e-3e03-97d6-b30dccc9bd8b",
                                                "text": "The world's largest surveyor of deepwater oil fields won a contract to conduct a survey of the French Gulf of Lion to map sand reserves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
