                        "entry_id": "d2fe6e79-1a77-3f04-a8de-6afd66fbf82e",
                        "glosses": [
                            "Se dit des objets qui sont ou qui paraissent dans une situation opposée à leur situation la plus habituelle."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf5e3a8-79b9-4f62-b184-eb910696cf4a",
                                "sense_id": "3fa9dfb4-6296-3141-a89c-7df3e3461409",
                                "text": "Un cône renversé."
                            },
                            {
                                "example_id": "bc14e729-017b-4acb-a164-3d4c47982c03",
                                "sense_id": "3fa9dfb4-6296-3141-a89c-7df3e3461409",
                                "text": "Une pyramide renversée."
                            }
                        ]
                    },
                    {
                        "sense_id": "58942060-a129-3960-b51a-af076f5f20cf",
                        "entry_id": "d2fe6e79-1a77-3f04-a8de-6afd66fbf82e",
                        "glosses": [
                            "Se dit d’une pièce, d’un meuble représenté à l’envers (tête en bas). Synonyme de versé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6103a609-b9e6-4bdb-84c8-85e34fff35d3",
                                "sense_id": "58942060-a129-3960-b51a-af076f5f20cf",
                                "text": "De sinople à une étoile à douze rais d’or chargée d’un tourteau d’azur; au mantel renversé aussi d’or, chargé d’un fer de trident renversé de gueules, qui est d’Échenoz-la-Méline → voir illustration « mantel et trident renversés »"
                            }
                        ]
                    }
