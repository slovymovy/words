                        "examples": [
                            {
                                "example_id": "8d721e8f-c09b-4eb1-92b4-697be1dd1358",
                                "sense_id": "b5ecf99d-9183-38b7-8c91-d2baeccfa9ed",
                                "text": "A philhippic discourse is to be endured from him, not incomparable to that of those pubescent girls who would readily entrap the Unicorn and who doubtless would make the Minocorn no less welcome […]."
                            },
                            {
                                "example_id": "b323d3e7-c899-4093-9e81-57f23d571717",
                                "sense_id": "b5ecf99d-9183-38b7-8c91-d2baeccfa9ed",
                                "text": "This is a particularly apt satire of Englishness inasmuch as it is surrounded by the jingoistic mockery of the philhippic Neapolitan, the fantastical Frenchman, the cowardly Scot and the drunk German."
                            }
                        ]
