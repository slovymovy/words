                                "example_id": "aa0cef62-bf01-4477-8633-13d249294354",
                                "sense_id": "fc0286f8-2605-325a-a2ab-05ef6c660ccf",
                                "text": "In the town center of the village I live in, there is an Oxfam shop, a Salvation Army shop, a Heart Disease UK shop, and a Cancer Research shop. They sell the usual thrift store stuff of used clothes and books."
                            }
