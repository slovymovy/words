                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                        "entry_id": "2a231997-fdc2-3676-a4d7-fb1ea350816b",
                                        "glosses": [
                                            "At or in a distant but indicated place."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc0680f-bd81-4e75-a41c-09184738ca73",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "See who yonder is."
                                            },
                                            {
                                                "example_id": "c2a1a606-00d7-4521-b190-0e00df64e8dc",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day. He is strengthening his forces now against Mr. Benton out there.\""
                                            },
                                            {
                                                "example_id": "229353c4-3d20-4bb0-b73b-482859f8eaed",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "Whose doublewide is that over yonder?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                        "entry_id": "2a231997-fdc2-3676-a4d7-fb1ea350816b",
                                        "glosses": [
                                            "Synonym of thither: to a distant but indicated place."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bef7ae-897f-4d18-aa0e-f92e51db5b12",
                                                "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                                "text": "As for me and the childe, we wyl go yonder."
                                            },
                                            {
                                                "example_id": "755e2bee-2f75-49f1-9e9a-6e5136b20a25",
                                                "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                                "text": "They headed on over yonder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a252b0-55d4-3d79-b3b4-cb1bbf150c64",
                                        "entry_id": "6cb9aca6-f708-326a-85ab-9438c2af9ecb",
                                        "glosses": [
                                            "The farther, the more distant of two choices."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1c2422-5f15-4238-851c-41fed99878ee",
                                                "sense_id": "47a252b0-55d4-3d79-b3b4-cb1bbf150c64",
                                                "text": "\"You have all necessary proofs in your possession, though you may not be aware of their existence,\" replied Arden; \"will you allow me to open yonder box?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                        "entry_id": "1b466650-3799-352e-bed7-a2a134076242",
                                        "glosses": [
                                            "Who or which is over yonder, usually distant but within sight."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764724ec-face-4865-a72c-ddf8b344f74e",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "Yonder lass, who be she?"
                                            },
                                            {
                                                "example_id": "a0b194cc-9681-4a05-8bd0-cd183359846d",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "But ſoft, what light through yonder window breaks?\nIt is the Eaſt, and Iuliet is the Sunne[…]"
                                            },
                                            {
                                                "example_id": "458ba5dd-a278-40a5-87e7-cef9f0ef1799",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "Fire, the Sword, and Plagueǃ They may all be found in the yonder city; on my head alone may they fallǃ"
                                            },
                                            {
                                                "example_id": "e7e30dba-3120-43c3-9807-3f3dc43835b4",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "\"You have all necessary proofs in your possession, though you may not be aware of their existence,\" replied Arden; \"will you allow me to open yonder box?\""
                                            },
                                            {
                                                "example_id": "dd05578e-f0b4-4197-a3bf-639f3fd154ec",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "I wish I were on yonder hill\nand there I’d sit and I’d cry my fill,\nand ev’ry tear would turn a mill,\nAnd a blessing walk with you, my love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9cdfde-ffed-34a8-9a24-8b03a6c512a7",
                                        "entry_id": "1b466650-3799-352e-bed7-a2a134076242",
                                        "glosses": [
                                            "One who or which is over yonder, usually distant but within sight."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495c0695-d597-4d24-8d33-c56d51eef5a3",
                                                "sense_id": "2a9cdfde-ffed-34a8-9a24-8b03a6c512a7",
                                                "text": "The yonder is Queen Niobe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e94f23f5-fc5d-3264-87e1-f58a1281ce94",
                                        "entry_id": "5aa345dc-f63c-3cd2-a156-dece28961c52",
                                        "glosses": [
                                            "The vast distance, particularly the sky or trackless forest."
                                        ],
