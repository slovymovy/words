                "senses": [
                    {
                        "sense_id": "bd948f47-3fc3-3126-b9d7-7c787e16f87c",
                        "entry_id": "ae977ff0-d8de-3ed3-bd10-842571b680e4",
                        "glosses": [
                            "simple past and past participle of smite"
                        ],
                        "tags": [
                            "form-of",
                            "obsolete",
                            "participle",
