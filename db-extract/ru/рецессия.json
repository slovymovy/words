                ],
                "senses": [
                    {
                        "sense_id": "bb439c4e-64a8-3311-b753-da015f47d55d",
                        "entry_id": "91ccaa73-f394-3965-a7d0-8b065af27764",
                        "glosses": [
                            "экон. один из этапов цикла деловой активности, характеризующийся снижением уровня спроса, незначительными объёмами инвестирования и растущей безработицей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74e4875-50c9-4e5b-97d2-c3be93352725",
                                "sense_id": "bb439c4e-64a8-3311-b753-da015f47d55d",
                                "text": "…ослабление доллара связано с тем, что экономика США находится в стадии рецессии и «просела» несколько больше, чем все ожидали, вот евро и вырвался так сильно вперёд."
                            }
                        ]
                    },
                    {
                        "sense_id": "505ae5cb-4900-37d8-a95b-5cf4963915d6",
                        "entry_id": "91ccaa73-f394-3965-a7d0-8b065af27764",
                        "glosses": [
                            "лингв. перенос ударения в сторону начала слова"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "289f3352-e0d7-478f-84cb-8a61f93262ce",
                        "source_entry_id": "91ccaa73-f394-3965-a7d0-8b065af27764",
                        "target_lang_word": "recession",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "250510a0-adc9-3895-938a-aaa4c9dec761",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "The act or an instance of receding or withdrawing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29016606-837e-4be8-bb7c-588a4d74f963",
                                                "sense_id": "250510a0-adc9-3895-938a-aaa4c9dec761",
                                                "text": "[…]that light may break forth from the deepest enclosures of darkness, and mercy may rejoice upon the recessions of justice, and grace may triumph upon the ruin of sin, and God may be glorified in the miracles of our conversion, and the wonders of our preservation and glories of our being saved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1687fbd9-b884-3cfa-9436-fccd177dc719",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "A period of low temperatures that causes a reduction in species; ice age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe23e7ac-630a-4f6e-a238-d8ece552e902",
                                                "sense_id": "1687fbd9-b884-3cfa-9436-fccd177dc719",
                                                "text": "Eastward in Bosnia, while the central European clime prevails, the thermic gradient does not follow the recession in the north latitude, but the elevation of the terrain."
                                            },
                                            {
                                                "example_id": "75b168c7-e304-44ec-9bdd-617f18fc1ef9",
                                                "sense_id": "1687fbd9-b884-3cfa-9436-fccd177dc719",
                                                "text": "Had this climate recession not occurred, the settlements might have provided the first real bridgehead into the continent of America, rather than being rediscovered by Columbus and later by Cabot."
                                            },
                                            {
                                                "example_id": "aebc3fa5-5292-4651-a0a8-18a2594728eb",
                                                "sense_id": "1687fbd9-b884-3cfa-9436-fccd177dc719",
                                                "text": "The climatic recession which produced Britain's last glaciers came rapidly to an end about 10,000 bp, as temperatures rose during the end of the protocratic phase of the present interglacial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0b68ec0-51dc-3bb5-97cc-26c3c0822511",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "A period of reduced economic activity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21725e45-5c2b-427c-af07-a695df6a52f6",
                                                "sense_id": "a0b68ec0-51dc-3bb5-97cc-26c3c0822511",
                                                "text": "Statisticians often define a recession as negative real GDP growth during two consecutive quarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a91fe6-8d0d-33a3-b744-7b5c4dd014d9",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "The ceremonial filing out of clergy and/or choir at the end of a church service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c2b8509-343f-34ae-afbe-9a62623ddd07",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "The act of ceding something back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76d77fab-b5f8-34dc-89a8-a9714cd48593",
                                        "entry_id": "03a9ec5e-18dc-3b0c-b080-8cb544cfc623",
                                        "glosses": [
                                            "A procedure in which an extraocular muscle is detached from the globe of the eye and reattached posteriorly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c1eed2-a447-4c7d-bfd3-159b942444e0",
                                                "sense_id": "76d77fab-b5f8-34dc-89a8-a9714cd48593",
                                                "text": "Bilateral medial rectus muscle recession when angle is stable. Controversy exists regarding optimal timing of surgery. If greater than 40 prism diopter esotropia, some recommend bimedial recession with resection of one lateral rectus muscle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
