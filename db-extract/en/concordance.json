                                            {
                                                "example_id": "72ba4f92-15e3-421c-8db1-7b971a2b3a64",
                                                "sense_id": "60d102e1-9030-300f-90e4-58e4959bbde8",
                                                "text": "Dodatkowo zamieszczony został wykaz konkordancji sygnatur i numerów pozycji, która zawiera spis sygnatur stałych i akcesji"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                                        "glosses": [
                                            "alfabetyczny spis wyrazów, zdań, znaków, symboli lub motywów znajdujących się w jakimś dziele literackim lub zbiorze dokumentów czy ksiąg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f8c3f5-d834-4b50-8ddc-acecf46793ab",
                                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                                "text": "Był autorem wielkiego słownika aramejsko-grecko-hebrajsko-łacińskiego, konkordancji do dzieł Józefa Flawiusza oraz encyklopedii Talmudu"
                                            },
                                            {
                                                "example_id": "14cb4d23-78dd-4844-9e9d-369942e11231",
                                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                                "text": "W konkordancji do Biblii Hebraica występuje ponad 6800 miejsc występowania JHVH"
                                            },
                                            {
                                                "example_id": "95ce58e8-92d4-49c2-a914-ff2e81d86cd1",
                                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                                "text": "Konkordancja tematyczna (rzeczowa) jest alfabetycznym spisem idei, zagadnień i nazw własnych występujących w danej księdze świętej ze wskazaniem miejsc ich występowania (w Koranie sura i wers) i przytoczeniem ich kontekstu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "626ab999-fed9-3296-b52a-e20b304d6f27",
                                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                                        "glosses": [
                                            "zgodność wzajemnego stosunku stykających się ze sobą 2 warstw skał osadowych"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "2578cdcf-bb5b-360d-9079-4a91f2f5634d",
                                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                                        "glosses": [
                                            "wystąpienie szukanej frazy lub słowa w tekście, ich zestawie lub korpusie językowym z dodatkowym krótkim kontekstem, też: zbiór takich wystąpień"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8b580a-6e77-4fab-93fd-4f481edc5e21",
                                                "sense_id": "2578cdcf-bb5b-360d-9079-4a91f2f5634d",
                                                "text": "W językach bogatych fleksyjnie ortograficznie rozszerzone zapytanie może zwracać mało dokładne konkordancje, w których warianty fleksyjne są przemieszane z derywatami należećmi do innej kategorii części mowy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "6ccc2b2f-ddd0-3acc-a84b-4136fbdef545",
