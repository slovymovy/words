                                    {
                                        "sense_id": "af86eb63-dcee-3e0e-ac53-30536c18fcdb",
                                        "entry_id": "907ff0e3-15c7-303a-9ae8-67da4e759413",
                                        "glosses": [
                                            "Initialism of too long; didn't read (or sometimes too long; don't read).",
                                            "Used to indicate that one did not read a (long) text."
