                "senses": [
                    {
                        "sense_id": "c726bb7f-36aa-384f-b6a7-cabe4c8e887f",
                        "entry_id": "558bf788-7340-34aa-8838-742a8815e034",
                        "glosses": [
                            "to be acquired [with у (u, + genitive) ‘by someone’] (idiomatically translated by English get or acquire with the object of у (u) as the subject)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee7a3e2-9bcf-4800-9476-55486a105cfe",
                                "sense_id": "c726bb7f-36aa-384f-b6a7-cabe4c8e887f",
                                "text": "у него́ заво́дятся де́ньги",
                                "translation": "he's is getting money (to spend)",
                                "english": "he's is getting money (to spend)"
                            },
                            {
                                "example_id": "4bb0f629-eb4b-4a98-911d-4e5cbb23cc86",
                                "sense_id": "c726bb7f-36aa-384f-b6a7-cabe4c8e887f",
                                "text": "там у меня́ заво́дятся но́вые друзья́",
                                "translation": "I am getting/meeting/acquiring new friends there",
                                "english": "I am getting/meeting/acquiring new friends there"
                            }
                        ]
                    },
                    {
                        "sense_id": "f94198bd-cbd0-33de-b036-959b18cfbdcb",
                        "entry_id": "558bf788-7340-34aa-8838-742a8815e034",
                        "glosses": [
                            "to infest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c75b3d-0635-4aa6-a661-2cb648b434c0",
                                "sense_id": "f94198bd-cbd0-33de-b036-959b18cfbdcb",
                                "text": "у неё заво́дятся вши",
                                "translation": "she's becoming infested with lice",
                                "english": "she's becoming infested with lice"
                            },
                            {
                                "example_id": "5bb48b66-6332-4a58-aab5-861958098982",
                                "sense_id": "f94198bd-cbd0-33de-b036-959b18cfbdcb",
                                "text": "в ста́ром до́ме заво́дятся мы́ши",
                                "translation": "mice are infesting the old house",
                                "english": "mice are infesting the old house"
                            }
                        ]
                    },
                    {
                        "sense_id": "0125574b-139e-3ef0-975f-d8eaa42a93c9",
                        "entry_id": "558bf788-7340-34aa-8838-742a8815e034",
                        "glosses": [
                            "to be wound up (of a mechanism or clock); to start (of a car or motor)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846b429d-4bb1-43da-88bb-e8e0f52085b8",
                                "sense_id": "0125574b-139e-3ef0-975f-d8eaa42a93c9",
                                "text": "У меня́ сего́дня не заводи́лась маши́на",
                                "translation": "My car wouldn't start today.",
                                "english": "My car wouldn't start today."
                            }
                        ]
                    },
                    {
                        "sense_id": "a545c714-4d0c-31e6-828f-afcbe2c7918f",
                        "entry_id": "558bf788-7340-34aa-8838-742a8815e034",
                        "glosses": [
                            "to get worked up, to be turned on"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "11313aea-583c-4143-ac91-bf71ffb23475",
                                "sense_id": "a545c714-4d0c-31e6-828f-afcbe2c7918f",
                                "text": "не заводи́сь и́з-за пустяка́!",
                                "translation": "don't get all worked up over nothing!",
                                "english": "don't get all worked up over nothing!"
                            }
                        ]
                    },
