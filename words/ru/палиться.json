{
    "word_family": [
        "палить",
        "пал",
        "палящий",
        "запал",
        "выпал"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59c1c03b-ee0d-38a5-a883-a5b6d7a0b7c8",
                    "sense_definition": "нечаянно выдать себя, обнаружить свой секрет или провалиться в каком-либо деле",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "выдача секрета",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный вор никогда не <w>палится</w> на мелочах, потому что всегда соблюдает осторожность.",
                            "target_lang_translations": {
                                "en": "An experienced thief never <w>gets caught</w> over small details because they are always cautious."
                            }
                        },
                        {
                            "text": "Я не понимаю, на чём именно я <w>палюсь</w>, когда пытаюсь скрыть свои планы.",
                            "target_lang_translations": {
                                "en": "I don't understand what exactly I'm <w>giving myself away</w> on when I try to hide my plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "проколоться",
                        "выдавать себя"
                    ],
                    "antonyms": [
                        "шифроваться"
                    ],
                    "common_phrases": [
                        "палиться на мелочах"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "широко используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To accidentally reveal oneself, give away a secret, or get caught doing something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to get caught",
                                "target_lang_sense_clarification": "General term for being discovered in an act."
                            },
                            {
                                "target_lang_word": "to give oneself away",
                                "target_lang_sense_clarification": "Specifically revealing one's own secret or identity."
                            },
                            {
                                "target_lang_word": "to blow one's cover",
                                "target_lang_sense_clarification": "Idiomatic expression for losing the secrecy of one's actions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb1980e0-88c8-3637-b3b3-9291c09aaeff",
                    "sense_definition": "страдательный залог к глаголу <w>палить</w> (в значении подвергать воздействию огня)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "воздействие огня",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В деревне все собрались вокруг <w>палящейся</w> на костре туши свиньи.",
                            "target_lang_translations": {
                                "en": "In the village, everyone gathered around the pig carcass <w>being singed</w> over the bonfire."
                            }
                        },
                        {
                            "text": "Шерсть животного <w>палилась</w> на открытом огне для очистки кожи.",
                            "target_lang_translations": {
                                "en": "The animal's fur <w>was being scorched</w> over an open flame to clean the skin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive voice of 'to burn' or 'to singe' (subjected to fire)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be singed",
                                "target_lang_sense_clarification": "To burn the surface of something slightly."
                            },
                            {
                                "target_lang_word": "to be scorched",
                                "target_lang_sense_clarification": "To be burned by fire or heat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91b8d904-de59-3912-8778-b9fa4d1f30fe",
                    "sense_definition": "сильно волноваться, горячиться или проявлять излишнее нетерпение",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "эмоциональное состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не <w>пались</w> раньше времени, всё ещё можно исправить спокойным разговором.",
                            "target_lang_translations": {
                                "en": "Don't <w>get worked up</w> ahead of time; everything can still be fixed with a calm conversation."
                            }
                        },
                        {
                            "text": "Он постоянно <w>палился</w> из-за пустяков, что мешало ему принимать верные решения.",
                            "target_lang_translations": {
                                "en": "He was constantly <w>losing his cool</w> over trifles, which prevented him from making the right decisions."
                            }
                        }
                    ],
                    "synonyms": [
                        "горячиться",
                        "волноваться"
                    ],
                    "antonyms": [
                        "успокаиваться"
                    ],
                    "common_phrases": [
                        "не пались"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее или региональное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be overly anxious, agitated, or impatient."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to get worked up",
                                "target_lang_sense_clarification": "Becoming agitated or upset about something."
                            },
                            {
                                "target_lang_word": "to lose one's cool",
                                "target_lang_sense_clarification": "Losing composure due to anxiety or impatience."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9e0bbe4-9127-35e7-817c-885512ef793b",
                    "sense_definition": "стрелять друг в друга из огнестрельного оружия",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "стрельба",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старых вестернах бандиты часто начинают <w>палиться</w> прямо посреди улицы.",
                            "target_lang_translations": {
                                "en": "In old westerns, bandits often start <w>having a shootout</w> right in the middle of the street."
                            }
                        },
                        {
                            "text": "Они вышли на дуэль и начали <w>палиться</w> с близкого расстояния.",
                            "target_lang_translations": {
                                "en": "They went out for a duel and started <w>exchanging fire</w> at close range."
                            }
                        }
                    ],
                    "synonyms": [
                        "перестреливаться"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To shoot at each other with firearms."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to have a shootout",
                                "target_lang_sense_clarification": "Engaging in a gunfight."
                            },
                            {
                                "target_lang_word": "to exchange fire",
                                "target_lang_sense_clarification": "Formal or descriptive term for shooting at each other."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}