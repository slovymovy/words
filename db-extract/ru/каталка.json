                    },
                    {
                        "translation_id": "024fb107-9190-4b13-855b-9c8d71840d98",
                        "source_entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "source_sense_description": "специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях",
                        "target_lang_word": "Fahrtrage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "552b668e-6dee-4cd2-8203-dc2ef38253d1",
                        "source_entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "source_sense_description": "специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях",
                        "target_lang_word": "Rollbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b605f8e3-e2e5-4037-91ee-cfb5b051eb13",
                        "source_entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "source_sense_description": "специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях",
                        "target_lang_word": "chariot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chariot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2673dca9-888a-3b5c-85ce-d84335ddd81e",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Sorte d'engin qui peut être ou non motorisé, à quatre roues, propre à porter divers fardeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4140bcd1-6747-40fa-b346-befd75906556",
                                                "sense_id": "2673dca9-888a-3b5c-85ce-d84335ddd81e",
                                                "text": "Avez-vous une âme de pionnier ? Si oui, vous disposez de chariots bâchés tels que vous en avez vu dans les westerns, lesquels nous montrent également des tipis."
                                            },
                                            {
                                                "example_id": "d5e5b4a8-00d5-4f6e-8ca6-06166b345ad0",
                                                "sense_id": "2673dca9-888a-3b5c-85ce-d84335ddd81e",
                                                "text": "Le pain était arrivé, non sans peine et sans perte : en venant de Grandpré, où se trouvait la boulangerie, plusieurs chariots étaient restés embourbés, d’autres étaient tombés dans les mains de l’ennemi […]"
                                            },
                                            {
                                                "example_id": "745cec13-dbe7-4585-add0-d831eaaf550e",
                                                "sense_id": "2673dca9-888a-3b5c-85ce-d84335ddd81e",
                                                "text": "La roue en bois avec cerclage en fer, utilisée notamment en Afrique du Nord, en Égypte et à Madagascar, équipait autrefois tous les chariots avant l’emploi des pneumatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abef07c9-40c3-35b5-8e9c-9d6bb0efa0ba",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Sorte de civière roulante utilisée dans les hôpitaux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ecfe17-42a3-4f39-b932-19234b6188a1",
                                                "sense_id": "abef07c9-40c3-35b5-8e9c-9d6bb0efa0ba",
                                                "text": "Un matin, elle assista à une scène qui la bouleversa. Un patient attendait son tour afin de passer une radio. Assis sur un chariot, il lisait un policier de la collection le Masque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8970330-66c1-3094-aa4a-30add39d3b91",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Fauteuil roulant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bd7726d-871a-44df-8b11-4f03e445cba0",
                                                "sense_id": "e8970330-66c1-3094-aa4a-30add39d3b91",
                                                "text": "Il y avait bien une semaine qu’Albane la voyait tous les matins, vers la même heure, poussant le chariot d’une jeune et belle infirme chaudement emmitouflée sous un affreux capuchon verdâtre dissimulant le plus souvent ses traits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b148ca-6eeb-36cd-b6bc-0c3815a60075",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Contenu de ce chariot."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4910f26f-ea38-41a4-820d-786f4c88238d",
                                                "sense_id": "27b148ca-6eeb-36cd-b6bc-0c3815a60075",
                                                "text": "Cette grange contient quinze chariots de foin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc9d2d1-ab6f-37ac-b12b-70ab6c264e47",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Ancienne mesure de Paris, ou plutôt, estimation à laquelle se vendaient autrefois les pierres de taille."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72931af8-629a-47cd-a0db-f2d3c8fcd2f8",
                                                "sense_id": "7bc9d2d1-ab6f-37ac-b12b-70ab6c264e47",
                                                "text": "Le chariot faisait 2 voies = 10 carreaux = 30 pieds cubes de Paris = 36.317 pieds cubes anglais = 1.02832 stère ou mètre cube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ef55df-f187-3bb3-842b-04affe42191e",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Poussette permettant à la clientèle des magasins en libre-service de transporter les articles achetés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45bfb067-e8c3-3c8c-bf04-d80a89b1cac9",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Cadre de bois porté sur quatre roues dans lequel on place les enfants pour leur apprendre à marcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73451c97-ab49-44fb-85a7-9678617a3195",
                                                "sense_id": "45bfb067-e8c3-3c8c-bf04-d80a89b1cac9",
                                                "text": "D’une part on voyait des nouveau-nés dans des choux, d’autre part un bébé à bourrelets, en train de s’essuyer les yeux avec les poings et de brailler, soutenu sous les bras par une armature circulaire à roulettes jouant le rôle des actuels « parcs » et dite à cette époque « chariot »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36644c2a-c1e4-3124-becd-dcc3f0d719b0",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Pièce mobile, animée d’un mouvement de va-et-vient, qui relie les divers organes d’une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9e4a29-4d3a-4078-8a78-1d0810e7ab82",
                                                "sense_id": "36644c2a-c1e4-3124-becd-dcc3f0d719b0",
                                                "text": "Le chariot c est un organe mobile, d’une longueur égale à celle du métier qui s’éloigne et se rapproche des cannelés. Le chariot porte les broches f sur lesquelles a lieu la confection du fil et son renvidage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85d98d7-a0bb-3386-938d-bd4bfb8f1e50",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Grand chariot, petit chariot : Astérismes de la Grande, la Petite Ourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b443389a-7779-428c-b4a6-75a28139af56",
                                                "sense_id": "d85d98d7-a0bb-3386-938d-bd4bfb8f1e50",
                                                "text": "— Oh ! vous vous trompez, monsieur Léon, j’y serai bien avant dix heures, reprit Jeanne en regardant les étoiles, cette horloge des bergers, grâce à laquelle ils savent l’heure à quelques minutes près, d’après la position du grand et du petit chariot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d220a2c-c01a-3ad1-afc2-fb19cc5b7d4c",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Planche montée pour le cordier."
                                        ],
                                        "tags": [
                                            "Histoire des techniques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "044c2728-d57a-33c7-8c91-b5189d1289a1",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Ancienne mesure pour les pierres."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42328b0a-45ea-3723-88bb-909fb150fbb5",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Support mobile destiné à transporter le sac d’un joueur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c71ff41a-b64d-38e0-a60d-425236fe30dc",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Meuble représentant l’engin du même nom dans les armoiries. Il n’y a pas de forme particulière prédéfinie. Toutefois, il est représenté sur la base d’un véhicule à roues munie de bras permettant d’atteler un ou plusieurs chevaux. Comme tous véhicules, il est présenté de profil, l’avant orienté à dextre et posé en fasce."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5c1800-c108-437d-8985-8294414b45aa",
                                                "sense_id": "c71ff41a-b64d-38e0-a60d-425236fe30dc",
                                                "text": "De sinople à un chariot d’argent, qui est de la commune de Charroux de l’Allier « armoiries avec un chariot »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e40b50f-5eb6-36f5-80b6-c839794e2923",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Septième atout du tarot de Marseille."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea576553-9b19-362d-a99a-668fe726492c",
                                        "entry_id": "61d17376-6920-3105-b82d-962f5479c04e",
                                        "glosses": [
                                            "Plateau roulant sur lequel sont présentées les bouteilles d'apéritifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b4a83f-07f0-4943-acb6-2dd8fab6c1de",
                                                "sense_id": "ea576553-9b19-362d-a99a-668fe726492c",
                                                "text": "Des gravures anglaises représentant des scènes de chasse à courre, et le petit chariot des apéritifs, en forme de tilbury, complétaient ce décor hippique."
                                            },
                                            {
                                                "example_id": "9814302f-9b4c-410b-ae27-2fd9277ac89a",
                                                "sense_id": "ea576553-9b19-362d-a99a-668fe726492c",
                                                "text": "Bejardy roula vers eux un chariot d'apéritifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
