        "fr-extract.jsonl": [
            {
                "entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                "word": "magnifiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                        "entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "glosses": [
                            "D’une façon magnifique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4145c385-d1ea-4389-baf3-95bcda8b9004",
                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                "text": "Et elle se montre en minaudant, en s’exposant comme un beau fruit magnifiquement dressé dans l’étalage d’un marchand de comestibles."
                            },
                            {
                                "example_id": "b2bdb128-ccd3-4109-82d9-5068c4fc96af",
                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                "text": "C'est dans les palais des rois que se trouvent ceux qui sont vêtus magnifiquement, et qui vivent dans les délices."
                            },
                            {
                                "example_id": "adaf3a81-c904-4a1c-8d8f-2072145ba2f9",
                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                "text": "L'on a trouvé le moyen de distinguer les naissances illustres d’avec les naissances viles et vulgaires […] et par-là vous voyez déjà sa naissance magnifiquement relevée."
                            }
                        ]
                    },
                    {
                        "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                        "entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "glosses": [
                            "En termes magnifiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bed19d5-b3e5-4d9d-ad54-b385717186ec",
                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                "text": "Cette vérité importante [que Dieu veut être servi par des créatures raisonnables] nous est magnifiquement exprimée dans le livre de Josué, où nous voyons […]"
                            },
                            {
                                "example_id": "a9a66c0f-ca42-4ea0-9010-f9a2d9d07d60",
                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                "text": "Vous parlez magnifiquement De cinq ou six contes d’enfant."
                            },
                            {
                                "example_id": "ca8047be-8313-4214-8d48-9a74ec9e9572",
                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                "text": "Parlant magnifiquement de la vertu et pratiquant mal ce que nous disons."
                            },
                            {
                                "example_id": "3a01d62d-2939-4d6d-a8db-61e53e16df7d",
                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                "text": "Platon lui-même parle si magnifiquement de Dieu, qu’on croit souvent entendre un chrétien. — (Etienne Bonnot de Condillac, Historique ancien XV, 7)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba468cd6-109c-400e-a9a0-b3d0542f9d23",
                        "source_entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "target_lang_word": "hervorragend",
