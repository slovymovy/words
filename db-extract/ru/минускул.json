                "senses": [
                    {
                        "sense_id": "7f5b11fc-2251-33df-b0ca-ae612fcedcba",
                        "entry_id": "e11a8356-d8d7-30bc-808a-8ca3af9e20fd",
                        "glosses": [
                            "строчная буква в древнем латинском и греческом письме"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f7f05977-cbdc-39db-8a7e-c781ef125ffe",
                        "entry_id": "e11a8356-d8d7-30bc-808a-8ca3af9e20fd",
                        "glosses": [
                            "письмо, шрифт, состоящий из таких букв"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899738bc-77a1-493c-bec3-459e2f315693",
                                "sense_id": "f7f05977-cbdc-39db-8a7e-c781ef125ffe",
                                "text": "Писцов усаживали в архивы многократно переписывать манускрипты — учебники, энциклопедии, антологии. Для увеличения эффективности этого труда монахи развили новый вид письма — каролингский минускул, и он по-прежнему остаётся основой нашей письменной латиницы."
                            }
                        ]
                    }
