                    {
                        "translation_id": "f715d9e1-9084-4eba-a4f5-860879b3a0dc",
                        "source_entry_id": "e2ce3f59-3467-345b-b6bf-16fda25dd26f",
                        "target_lang_word": "normalcy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
