                    "frequency": "Middle",
                    "semantic_group_id": "dispense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a accepté d'<w>excuser</w> cet employé souffrant pour la réunion importante."
                        },
                        {
                            "text": "Elle a téléphoné pour faire <w>excuser</w> son absence au dîner annuel de l'association."
