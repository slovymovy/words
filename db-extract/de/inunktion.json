                        "source_sense_description": "Medizin: Einreibung (von flüssigen, pasten- oder salbenartigen Arzneimitteln)",
                        "target_lang_word": "embrocation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
