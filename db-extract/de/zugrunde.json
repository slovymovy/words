                        "tags": [
                            "nur in festen Wendungen"
                        ],
                        "examples": [
                            {
                                "example_id": "63427b07-a724-4bcf-b1c1-04cdc8191b62",
                                "sense_id": "26c4973d-5e6c-307b-addb-5fe3acf4ea42",
                                "text": "„Der Präsident sei ein ideales Beispiel dafür, wie Washington einen guten Mann zugrunde richten könne.“"
                            },
                            {
                                "example_id": "4d805b54-ac60-4887-9f17-b6451273c592",
                                "sense_id": "26c4973d-5e6c-307b-addb-5fe3acf4ea42",
                                "text": "„Die gefürchteten Epidemien werden durch Erreger ausgelöst, die mit dem Tod ihres Wirts ebenfalls zugrunde gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0882312d-40e7-3e6b-832d-3ec5661ca2b9",
                        "entry_id": "5a4448b4-144e-3ffd-9f59-002ef5430732",
                        "glosses": [
                            "bereits vorhanden; eine Voraussetzung bietend, auf der aufgebaut werden kann"
                        ],
                        "tags": [
                            "nur in festen Wendungen"
                        ],
                        "examples": [
                            {
                                "example_id": "5d2ad3b3-7495-4e32-b03a-05657abd5ead",
                                "sense_id": "0882312d-40e7-3e6b-832d-3ec5661ca2b9",
                                "text": "Welche Randbedingungen legst du deiner Berechnung zugrunde?"
                            },
                            {
                                "example_id": "347438d0-c10f-409c-b97f-b745b5b22175",
                                "sense_id": "0882312d-40e7-3e6b-832d-3ec5661ca2b9",
                                "text": "„Legt man nur den Faktor Lebenserwartung zugrunde, hat sich die Situation sogar in sechs Ländern in Afrika südlich der Sahara – darunter auch Südafrika – sowie in Russland, Weißrussland und der Ukraine verschlechtert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
