                        "entry_id": "4af54b23-ef00-3a13-ac27-a812936c749d",
                        "glosses": [
                            "A language disorder that affects a person's ability to write."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dacc57e3-486f-422b-80cb-757c72383ff2",
                                "sense_id": "9a573ec5-35ba-3a59-b211-17163ac33fbc",
                                "text": "Students with dysgraphia have severe problems learning to write."
                            }
                        ]
                    }
                ],
