                                "target_senses": [
                                    {
                                        "sense_id": "39f20956-0ad9-3f1d-8ff7-6761e3aa84da",
                                        "entry_id": "984a64be-026d-38a9-b172-ddf29a967da8",
                                        "glosses": [
                                            "Any of a group of seamen who cruised on their own account on the Spanish Main and in the Pacific in the 17th century, who were similar to pirates but did not prey on ships of their own nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3167e183-6103-4eab-9b40-a33d6878d616",
                                                "sense_id": "39f20956-0ad9-3f1d-8ff7-6761e3aa84da",
                                                "text": "“Heard of him!” cried the squire. “Heard of him, you say! He was the bloodthirstiest buccaneer that sailed.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8353406-26f0-380f-8b52-a2a5dde2fcab",
                                        "entry_id": "984a64be-026d-38a9-b172-ddf29a967da8",
                                        "glosses": [
                                            "A pirate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "buccaneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "045d65f9-6a79-3020-b44d-1937e4022936",
                                        "entry_id": "793553c8-4bdf-371d-9617-7acedc284958",
                                        "glosses": [
                                            "To engage in piracy against any but one's own nation's ships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b19d68f-f17a-4d79-be6b-2db643433585",
                                                "sense_id": "045d65f9-6a79-3020-b44d-1937e4022936",
                                                "text": "In 1596 and 1597 he bucaneered against Sao Thomi, the Portuguese slaving settlement off the coast of West Africa, and in the Spanish Main"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
