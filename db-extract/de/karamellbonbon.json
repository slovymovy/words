                "senses": [
                    {
                        "sense_id": "414b18b9-540b-395a-b09a-1dda23ddec35",
                        "entry_id": "a2532658-3fec-327c-9573-48efb612ce75",
                        "glosses": [
                            "Bonbon aus Karamell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d6061b-fd34-426d-b86d-28a0a1f9979e",
                                "sense_id": "414b18b9-540b-395a-b09a-1dda23ddec35",
                                "text": "„Er verdrehte den Kopf und beäugte die Karamellbonbons misstrauisch von der Seite.“"
                            },
                            {
                                "example_id": "98379499-6222-490e-867b-93f46532f4b6",
                                "sense_id": "414b18b9-540b-395a-b09a-1dda23ddec35",
                                "text": "„Er weiß, dass Alice in ihren Pausen gern Karamellbonbons isst.“"
                            },
                            {
                                "example_id": "eb181a6a-c9c7-472a-9af1-568fe9e0170f",
                                "sense_id": "414b18b9-540b-395a-b09a-1dda23ddec35",
                                "text": "„Das Mädchen ließ sich Zeit, mochte vielleicht nicht von seinem Karamellbonbon lassen, an dem es eifrig lutschte, um an den süßen Geschmack zu kommen.“"
                            },
                            {
                                "example_id": "e684f7c9-4165-47ad-8807-178b559dcd4a",
                                "sense_id": "414b18b9-540b-395a-b09a-1dda23ddec35",
                                "text": "„Eine große zitronengelbe Katze saß auf einem Holzofen und beobachtete ihn. Er drehte den Kopf, um sie besser sehen zu können; sie dehnte sich wie ein schmelzendes Karamellbonbon über den Rand des Ofens und verschwand vornüber geräuschlos im Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
