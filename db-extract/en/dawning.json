                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ca83f0-370d-49cd-a7d6-a979fc096c18",
                        "source_entry_id": "e7655c23-a806-3a07-b757-c1660e3197cd",
                        "source_sense_description": "dawn",
                        "target_lang_word": "рассве́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рассве́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2d40d6-de71-35ad-adec-2fab4a480f1a",
                                        "entry_id": "05bba321-ef17-374f-b9ea-49b1a05fa908",
                                        "glosses": [
                                            "время суток ранним утром, непосредственно перед восходом солнца и сразу после него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574c76db-0ac4-454d-b6bd-212d95acc875",
                                                "sense_id": "6d2d40d6-de71-35ad-adec-2fab4a480f1a",
                                                "text": "Был уже рассвет, в окно видно было, как горела утренняя заря."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07beb579-7eb4-392c-8e21-2c11e907b212",
                                        "entry_id": "05bba321-ef17-374f-b9ea-49b1a05fa908",
                                        "glosses": [
                                            "перен. картина неба перед восходом солнца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9fc0a5-41b6-48a6-9cac-44deb2814ca4",
                                                "sense_id": "07beb579-7eb4-392c-8e21-2c11e907b212",
                                                "text": "Его он отложил лишь три часа спустя, когда уже заголубел рассвет в единственном узеньком окошке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92dbb742-179e-3bbf-8dec-a051e7922f3c",
                                        "entry_id": "05bba321-ef17-374f-b9ea-49b1a05fa908",
                                        "glosses": [
                                            "перен. период начального подъёма в каком-либо явлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de4d5d1-4313-4dff-8958-9b56bc50b718",
                                                "sense_id": "92dbb742-179e-3bbf-8dec-a051e7922f3c",
                                                "text": "История Брайтон-Бич разворачивалась так стремительно, что я успел застать рассвет, расцвет и закат нашей эмигрантской столицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
