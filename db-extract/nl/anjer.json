                                        "entry_id": "b8727c4f-43a2-3f6a-a9eb-463842ab3a2c",
                                        "glosses": [
                                            "schmalblättrige, weiß bis rotviolett blühende Pflanze der Gattung Dianthus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f09700b-5f53-44a7-bba8-4120883ddb0a",
                                                "sense_id": "8fdce905-1a45-3552-9e12-e21c39de042c",
                                                "text": "Er trug eine Nelke im Knopfloch."
                                            },
                                            {
                                                "example_id": "7269bdfd-5ad5-44d8-b48c-00293d1889b4",
                                                "sense_id": "8fdce905-1a45-3552-9e12-e21c39de042c",
                                                "text": "„Wahrscheinlich war sie von den Nelken des Emigranten Wiesenhoff angelockt worden und suchte nun nach anderen Blumen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "620214be-7617-3a8c-bd99-0dc9d6973d7b",
                                        "entry_id": "b8727c4f-43a2-3f6a-a9eb-463842ab3a2c",
                                        "glosses": [
                                            "stark duftende und brennend scharf schmeckende, getrocknete Blütenknospen des Gewürznelkenbaums (Syzygium aromaticum)"
                                        ],
                                        "tags": [
                                            "Gewürz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba33a70-014b-43af-8901-3bbb981bef44",
                                                "sense_id": "620214be-7617-3a8c-bd99-0dc9d6973d7b",
                                                "text": "Ich spicke den Schweinebraten mit Nelken."
                                            },
                                            {
                                                "example_id": "f28a3f0e-f582-4027-bfca-5217bd9b8957",
                                                "sense_id": "620214be-7617-3a8c-bd99-0dc9d6973d7b",
                                                "text": "„Zusammen hatten sie achtunddreißig Tonnen Nelken und fünf oder sechs Tonnen Muskatnüsse sowie ebensoviel Zimt an Bord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
