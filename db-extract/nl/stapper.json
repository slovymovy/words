                "senses": [
                    {
                        "sense_id": "d6a369cc-5505-3756-b109-4b8b89d26056",
                        "entry_id": "296f0afe-8150-3324-a416-e802720304ef",
                        "glosses": [
                            "wandelschoen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ace7b81a-fea8-4c9f-abfa-d16c0ba6e4d5",
                                "sense_id": "d6a369cc-5505-3756-b109-4b8b89d26056",
                                "text": "Afgezien van dechique jas was de man gekleed in een lichtblauwe trui met in witte letters CLUB MED erop gestikt, een Schots geruite broek en natte, maar zo te zien gloednieuwe bruine Italiaanse stappers."
                            },
                            {
                                "example_id": "be92313f-ce1b-4812-b29e-cfd2a4858f81",
                                "sense_id": "d6a369cc-5505-3756-b109-4b8b89d26056",
                                "text": "Zijn kleren vormen geen aanwijzingen: stevige stappers, zwarte broek van moleskin, een leren jasje dat ooit zwart is geweest, maar nu tot grijs is afgedragen. Als je hem ergens tussen de mensen zag lopen zou je denken 'architect' of 'lector filosofie. Maar waarschijnlijk zou je hem over het hoofd zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe4b7281-230e-386f-98d4-5af9b095a78d",
                        "entry_id": "296f0afe-8150-3324-a416-e802720304ef",
                        "glosses": [
                            "iemand die vaak naar een café of andere uitgaansgelegenheid gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780ebe2d-b8da-415a-8e2e-d7031b528691",
                                "sense_id": "fe4b7281-230e-386f-98d4-5af9b095a78d",
                                "text": "Moeder denkt dat stomdronken stapper zoon is en biedt hem slaapplaats aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c16064ab-f669-3c37-b4d5-e0db559f2590",
                        "entry_id": "296f0afe-8150-3324-a416-e802720304ef",
                        "glosses": [
                            "iemand die loopt, iemand die een lange trektocht maakt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edd9d98e-7bd0-4f19-96d2-8da5d706407a",
                        "source_entry_id": "296f0afe-8150-3324-a416-e802720304ef",
                        "source_sense_id": "c16064ab-f669-3c37-b4d5-e0db559f2590",
                        "source_sense_description": "wandelaar",
                        "target_lang_word": "hiker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b056b7e-e492-37cc-a560-a716feabe97a",
                                        "entry_id": "a5e73d39-1055-3904-a533-f18de2f4d85c",
                                        "glosses": [
                                            "One who hikes, especially frequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de323eea-f913-4772-bbfb-16bb48c603cc",
                                                "sense_id": "5b056b7e-e492-37cc-a560-a716feabe97a",
                                                "text": "The mother looks over her shoulder, and the hiker could swear she gives the weaning calf a dirty look; the time has come for the young animal to enter moosehood, to stop living in two worlds, […]"
                                            },
                                            {
                                                "example_id": "999b8047-a781-4cc7-bc4c-af210fdba242",
                                                "sense_id": "5b056b7e-e492-37cc-a560-a716feabe97a",
                                                "text": "On Taipa Island, there are two trails, the 2.2km Taipa Grande and 2.3km Taipa Pequena which take hikers to the two highest points of the island, offering a panoramic view of Macau. The Taipa Grande trail takes about 2? hours and can be reached through a short paved road off the Estrada Colonel Nicolau de Mesquita, near the United Chinese Cemetery. Adjacent to the trail on the east side of Taipa Grande, near the airport, is the Taipa Grande Nature Park. The Taipa Pequena trail can be accessed from the Estrada Lou Lim Ieoc, behind the Regency Hotel, and takes about two hours."
                                            },
                                            {
                                                "example_id": "66ce6d26-2e78-40dd-90cf-2405ae91e220",
                                                "sense_id": "5b056b7e-e492-37cc-a560-a716feabe97a",
                                                "text": "Members of the Taitung County Fire Department’s Kuanshan Branch rescue an injured hiker in Taitung on Thursday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
