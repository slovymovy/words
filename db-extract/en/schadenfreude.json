                        "glosses": [
                            "Malicious enjoyment derived from observing someone else's misfortune."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a71193aa-ab13-4fd4-a982-3854cabe0ac3",
                                "sense_id": "a5ac39de-3070-3827-958c-64a16bcc9ebb",
                                "text": "But it is Schadenfreude, a mischievous delight in the misfortunes of others, which remains the worst trait in human nature."
                            }
                        ]
