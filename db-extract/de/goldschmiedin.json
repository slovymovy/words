                    {
                        "sense_id": "79232c3c-9e75-314a-a856-fd51b699a4c8",
                        "entry_id": "a6ad9237-4eed-389d-9122-70914a85f4e4",
                        "glosses": [
                            "weibliche Person, die Gold (zu Schmuck) verarbeitet"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "f3f9ae1b-c8b4-479d-bfda-d37d21253a0d",
                                "sense_id": "79232c3c-9e75-314a-a856-fd51b699a4c8",
                                "text": "„Anders ist das bei Todesfällen, hier kommt es durchaus vor, dass sich Witwen einen Anhänger aus dem Ehering des Partners machen lassen, erzählt Goldschmiedin Neuwirth.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d05fd798-ee58-487c-bbde-5df72e1d56fe",
