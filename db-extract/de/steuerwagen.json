                "senses": [
                    {
                        "sense_id": "7ba91b2a-6aa6-3c96-94e7-1a7b8ba04c1f",
                        "entry_id": "4782506c-9b9f-3417-8212-1a63dfa64472",
                        "glosses": [
                            "Eisenbahnfahrzeug am Ende des Zuges, von dem aus das Triebfahrzeug bei Rückwärtsfahrt bedient werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234f2214-737d-485c-8f9f-e1e0ebe7e12c",
                                "sense_id": "7ba91b2a-6aa6-3c96-94e7-1a7b8ba04c1f",
                                "text": "„Nach Darstellung der Bahn gibt es, anders als bei Autos, keine Vorkehrungen an den Triebfahrzeugen oder Steuerwagen, die eigens dafür gedacht sind, bei Kollisionen mit Lebewesen deren Überlebenschancen zu erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70c91f77-5a9a-40f8-9c66-4a521ffa0e33",
                        "source_entry_id": "4782506c-9b9f-3417-8212-1a63dfa64472",
                        "source_sense_id": "7ba91b2a-6aa6-3c96-94e7-1a7b8ba04c1f",
                        "target_lang_word": "control car",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
