                            },
                            {
                                "target_lang_word": "重于",
                                "target_lang_sense_clarification": "重要性超过"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "superare",
                                "target_lang_sense_clarification": "in valore, importanza o portata"
                            },
                            {
                                "target_lang_word": "prevalere su",
                                "target_lang_sense_clarification": "avere un'influenza o peso maggiore"
                            },
                            {
                                "target_lang_word": "pesare più di",
