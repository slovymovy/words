                                    {
                                        "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "Something deeply misguided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d19b8b-9523-4d1c-9059-14b0a3840af4",
                                                "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                                "text": "Two days have passed since that day of lunacy. What a noise and a fuss and a chattering and an uproar there was! And what a welter of unseemliness and disorder and stupidity and bad manners! And I the cause of it all! Yet part of the scene was also ridiculous—at all events to myself it was so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69cf1811-b003-410d-b41c-85e1050a1c6b",
                        "source_entry_id": "32b3a2c2-95bd-32ed-b20d-93c3e177a026",
                        "source_sense_id": "5e6f1f37-dcc8-3cc6-aaf0-1eef345ffe66",
                        "target_lang_word": "madness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                        "entry_id": "9d5c48f5-7621-356c-a9d4-6f3670a58b97",
                                        "glosses": [
                                            "The state of being mad; insanity; mental disease."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0c2cc5-9343-4fb3-b200-6e0e1bf45db6",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "Though this be madneſſe, / Yet there is Method in 't: […]"
                                            },
                                            {
                                                "example_id": "cfcba4c9-1c35-42bb-a642-d897a3b8b3d3",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "You were lonely for a man\nI said, \"Take me as I am\"\n'Cause you might enjoy some madness for a while"
                                            },
                                            {
                                                "example_id": "cee48d41-9d77-4eb8-9667-712d733d1203",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "Shepard: What's wrong with your assistant?\nDr. Warren: Manuel has a brilliant mind, but he's always been a bit... unstable. Genius and madness are two sides of the same coin.\nDr. Manuel: Is it madness to see the future? To see the destruction rushing towards us? To understand there is no escape? No hope? No, I am not mad. I'm the only sane one left!\nDr. Warren: I gave him an extra dose of his meds after the attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a61686e-11f0-3bcc-b18b-e7d7ac834ff2",
                                        "entry_id": "9d5c48f5-7621-356c-a9d4-6f3670a58b97",
