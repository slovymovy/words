                "senses": [
                    {
                        "sense_id": "72cd057d-08de-3f5b-9eb9-0bb97cac7365",
                        "entry_id": "2843dc43-052c-3eef-a23d-dbc94b6d0f69",
                        "glosses": [
                            "pasek, taśma lub gumka u dołu spodni, zakładane pod stopę, zapobiegające podciąganiu się nogawki w górę"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b4cd4e60-1196-35e7-91eb-3e7bd1504ff0",
                        "entry_id": "2843dc43-052c-3eef-a23d-dbc94b6d0f69",
                        "glosses": [
                            "kosteczka słuchowa znajdująca się w uchu środkowym człowieka i ssaków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d096f1ce-7820-4dfc-943c-c29b967c3eb8",
                                "sense_id": "b4cd4e60-1196-35e7-91eb-3e7bd1504ff0",
                                "text": "Gdy słyszymy dźwięk, układ kosteczek słuchowych – młoteczek, kowadełko i strzemiączko – przekazuje drgania z błony bębenkowej do ucha wewnętrznego."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9ce56fa2-2cbb-32f9-b4d2-aa5a46e4d6f3",
                        "entry_id": "2843dc43-052c-3eef-a23d-dbc94b6d0f69",
                        "glosses": [
                            "narzędzie ogrodnicze w kształcie małego strzemienia osadzonego na długim trzonku, służące do spulchniania gleby i pielenia chwastów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e886ef8-73f1-4037-8e42-cfb4323152bf",
                        "source_entry_id": "2843dc43-052c-3eef-a23d-dbc94b6d0f69",
                        "source_sense_id": "b4cd4e60-1196-35e7-91eb-3e7bd1504ff0",
                        "target_lang_word": "Steigbügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steigbügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                        "entry_id": "f9bfb6de-e158-3472-83fe-3ba7c4a5bc09",
                                        "glosses": [
                                            "seitlich am Sattel befestigte metallene Fußstütze für den Reiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74066f8-de1a-443a-b3d9-6b4964ec9e39",
                                                "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                                "text": "Er kann die Steigbügel nicht finden."
                                            },
                                            {
                                                "example_id": "76a75836-1f5a-4a01-bdaf-9de592f6cb0d",
                                                "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                                "text": "„Auf diese Weise wurden wir den ganzen Weg nach Halifax gebracht, auf Militärmänteln als Sätteln reitend, ohne Steigbügel, die Pferde in flinkem Schritt.“"
                                            },
                                            {
                                                "example_id": "3a6f5897-11eb-4336-ad06-09037fc5b6a6",
                                                "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                                "text": "„Die Steigbügel leuchteten wie Silber.“"
                                            },
                                            {
                                                "example_id": "7eb7987f-a117-40d3-a1a5-83a9a36d1cd2",
                                                "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                                "text": "„Der Regimentskommandeur hielt mit dem Major Ekonomow an einer Brücke und liess die abmarschierenden Kompagnien an sich vorüberziehen, als ein Soldat auf ihn zutrat, seinen Steigbügel fasste und sich so dicht an ihn herandrängte, dass er sich fast gegen das Bein des Regimentskommandeurs lehnte.“"
                                            },
                                            {
                                                "example_id": "fba20b6c-2497-4952-8d50-150113204cea",
                                                "sense_id": "3a9e7ee0-748e-37e5-9202-5687eabad843",
                                                "text": "„Er hatte jetzt den richtigen Fuß in den Steigbügel gebracht, warf das rechte Bein über den Sattel und kam, als das kleine, muntere Tier ein wenig zusammenfuhr, mit plötzlichem Ruck »an Bord«, wie er's nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cc9ae3b4-b24c-350f-a5cd-ced658b2ac0b",
                                        "entry_id": "f9bfb6de-e158-3472-83fe-3ba7c4a5bc09",
                                        "glosses": [
                                            "eines der Gehörknöchelchen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64141429-5749-4638-b0ec-fc9a630f23a3",
                        "source_entry_id": "2843dc43-052c-3eef-a23d-dbc94b6d0f69",
                        "source_sense_id": "b4cd4e60-1196-35e7-91eb-3e7bd1504ff0",
