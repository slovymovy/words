                ],
                "senses": [
                    {
                        "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                        "entry_id": "32eaa26d-9f7a-3154-bfd0-70e09d473823",
                        "glosses": [
                            "Sammelbezeichnung für den Teil des Keltischen, der auf dem Festland verbreitet war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a02c98-7e16-4b09-9ec3-6880bfd9b5c8",
                                "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                                "text": "„Es werden die Sprachen des Festlandkeltischen (Gallisch mit Galatisch, Keltiberisch und Lepontisch) und des Inselkeltischen unterschieden.“"
                            },
                            {
                                "example_id": "a5c515da-8d91-4f14-af00-b1526bc35037",
                                "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                                "text": "„Neben dieser geographischen Einteilung in Festlandkeltisch und Inselkeltisch lässt sich das Keltische aufgrund sprachlicher Kennzeichen aber auch noch auf andere Weise gliedern.“"
                            },
                            {
                                "example_id": "e077103e-207d-48c7-a36d-b1f4b23f8e2b",
                                "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                                "text": "„Die auf dem europäischen Kontinent gesprochenen keltischen Dialekte nennt man Festlandkeltisch, im Gegensatz zum Inselkeltischen, das die auf den britischen Inseln und in der Bretagne gesprochenen Dialekte umfaßt.“"
                            },
                            {
                                "example_id": "73d79bc9-069b-431e-b012-24bcc19b62f8",
                                "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                                "text": "„Die älteste Sprachform des Keltischen ist das Festlandkeltische, das in der Antike weit verbreitet war.“"
                            },
                            {
                                "example_id": "a7a35cc2-cdbd-4260-9d9a-1a764bf574f9",
                                "sense_id": "738cb949-5471-3fc8-a23b-fd1fec6eb875",
                                "text": "„Das Festlandkeltische, gesprochen unter anderem von den Galliern der Römerzeit, ist fast nur durch Inschriften überliefert, die großenteils aus Eigennamen bestehen; diese Sprachen sind daher in Wortschatz und Aufbau weitgehend unbekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
