                        "entry_id": "fe848748-8194-354a-9e5f-0dff9f02e754",
                        "glosses": [
                            "A quantity that fills or forms a maze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f04387-d190-41bc-9b54-8f787ace4112",
                                "sense_id": "5f99cd10-5b5d-3046-bff9-6e73ad211e62",
                                "text": "There will be another four waiting to be gobbled there, as well as a whole new mazeful of cheese bits."
                            },
                            {
                                "example_id": "81937090-3f4b-4973-ad1c-aa50f464e4d7",
                                "sense_id": "5f99cd10-5b5d-3046-bff9-6e73ad211e62",
                                "text": "When you were young and fell in love for the first time with a stranger, the emotional involvement and novelty being so strong that you did not have a chance to judge it with a cool head and normally get entangled in a mazeful of false sentiments."
                            }
                        ]
                    }
