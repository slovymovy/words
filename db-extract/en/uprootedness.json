                "senses": [
                    {
                        "sense_id": "b6df39d5-2a03-3224-b4f9-59643312397e",
                        "entry_id": "6fc40c47-e0de-3408-aa85-bded2ae36e14",
                        "glosses": [
                            "The quality of being uprooted."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ae1b8ec0-94c9-4480-9a9e-5003441fcfaf",
                                "sense_id": "b6df39d5-2a03-3224-b4f9-59643312397e",
                                "text": "Regularity of rhythm came under assault from modernists in the last century, and its frequent absence accounts substantially for a sense of uprootedness and anxiety in their music that is more often attributed to atonal melody or harmony."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
