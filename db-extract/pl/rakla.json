                                "target_senses": [
                                    {
                                        "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                                        "glosses": [
                                            "Werkzeug, mit dem man Folien glatt streicht oder abkratzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054fb3a7-2f40-42b7-b106-aa24f7de0b3a",
                                                "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                                                "text": "Der Dekorateur streicht vorsichtig die Folie mit der Rakel auf dem Schaufenster glatt, während seine Kollegin die Schutzfolie abzieht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                                        "glosses": [
                                            "flexibles Werkzeug, mit dem überschüssige Farbe von der Druckform abgezogen wird"
                                        ],
                                        "tags": [
                                            "Drucktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5481ac5c-cba5-4e0d-8cf7-cb2243be4b8a",
                                                "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                                                "text": "Beim Tiefdruck dient die Rakel dazu, die überschüssige Druckfarbe von den Stegen des Druckzylinders abzustreifen, so dass nur noch die Näpfchen mit Farbe gefüllt sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
