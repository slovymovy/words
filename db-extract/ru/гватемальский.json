                "senses": [
                    {
                        "sense_id": "2b133a4b-ce19-382b-bfc0-5a6139966265",
                        "entry_id": "d8d7dd9e-8395-3722-ba99-cd58bedea89d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными Гватемала, гватемальцы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa70649-35e4-4a68-9883-b5411d973600",
                                "sense_id": "2b133a4b-ce19-382b-bfc0-5a6139966265",
                                "text": "В Гватемалу я въехал буквально с чёрного хода, через бывшую английскую колонию Белиз и наиболее глухой и отдаленный гватемальский департамент Петен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7794fde0-2231-440e-aff1-c78a3b998494",
                        "source_entry_id": "d8d7dd9e-8395-3722-ba99-cd58bedea89d",
                        "source_sense_id": "2b133a4b-ce19-382b-bfc0-5a6139966265",
                        "target_lang_word": "Guatemalan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guatemalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                        "entry_id": "8468cc48-4895-324b-b35c-bc949ab9e05b",
                                        "glosses": [
                                            "A person from Guatemala or of Guatemalan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2b7053-b7f5-4d6a-97f1-4848ffce73fa",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "The Guatemalans offered United Fruit $627,572 (about $2.99 an acre) in compensation, a figure that came from the company's own tax value assessment for the land."
                                            },
                                            {
                                                "example_id": "8f2303ba-a2d4-43c1-9c50-e66f37ffd8ce",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "Guatemala has pledged a 40% increase in deportation flights carrying Guatemalans and migrants of other nationalities from the United States, President Bernardo Arévalo announced Wednesday during a press conference with US Secretary of State Marco Rubio."
                                            },
                                            {
                                                "example_id": "13ff7ec5-9a02-449a-a22b-6e52aeacbe54",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "MAGA Republicans are calling for Democratic Representative Delia Ramirez to be deported after she said, \"I'm a proud Guatemalan before I'm an American.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guatemalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509b508f-be7f-367e-8f98-84f7c156a6d1",
                                        "entry_id": "aef8f05a-06c7-3ce2-a09c-f2a6aff93210",
                                        "glosses": [
                                            "Of, from, or pertaining to Guatemala or the Guatemalan people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
