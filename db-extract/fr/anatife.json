                ],
                "senses": [
                    {
                        "sense_id": "afd53f15-5c92-3404-ac06-9c2558e4eead",
                        "entry_id": "37470ca9-9408-3beb-b66d-9cbfdaf91569",
                        "glosses": [
                            "Crustacé cirripède pédonculé marin parfois confondu avec le pouce-pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce76db2-dd6f-4a1d-94e4-aa9d618bc8f8",
                                "sense_id": "afd53f15-5c92-3404-ac06-9c2558e4eead",
                                "text": "Le pédicule des anatifes est toujours fixé sur des corps marins, spécialement sur la cale des navires."
                            },
                            {
                                "example_id": "a31e42a7-930a-4c3e-bd08-d8bd7c234639",
                                "sense_id": "afd53f15-5c92-3404-ac06-9c2558e4eead",
                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues. Ces étranges crustacés cirripèdes sont de lointains cousins des minuscules balanes."
                            },
                            {
                                "example_id": "f056abd0-2940-4f14-b144-7679e66a75f2",
                                "sense_id": "afd53f15-5c92-3404-ac06-9c2558e4eead",
                                "text": "D’instinct, je leur reprochai toujours de s’attacher au passant robuste, comme fait l’anatife…"
                            }
                        ]
                    }
                ],
