                "senses": [
                    {
                        "sense_id": "52fa66e4-df02-3b5e-8082-c8509e9bba16",
                        "entry_id": "6b93c6cf-3c7d-338e-88c0-3300dd3c908d",
                        "glosses": [
                            "das Material Holz, das nicht durch Zerspanung oder Zusätze verändert wurde, sondern so wie gewachsen verarbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17d776a-0a02-4f17-8aea-43f9973d1e05",
                                "sense_id": "52fa66e4-df02-3b5e-8082-c8509e9bba16",
                                "text": "„Bei Möbeln ist eine grundlegende Entscheidung: Massivholz oder Pressspan? Bei Pressspan sei die Gefahr, dass Formaldehyd enthalten ist, größer als bei Vollholz ohne Klebemittel, sagt Hausmann. Vollholz könne aber mit Bioziden belastet sein, auch auf den Lack müsse man schauen.“"
                            },
                            {
                                "example_id": "9c547bab-1d38-4512-aa5a-3101f9a55b4e",
                                "sense_id": "52fa66e4-df02-3b5e-8082-c8509e9bba16",
                                "text": "„Blumen, überall Blumen. Echte Blumen. Die Frankfurter Messehallen sind voll davon. Sie stehen in hauchdünnen Keramikvasen namens 'Papyrus', zwischen Bücherregalen aus Vollholz, Kuhglocken-Deko und Outdoor-Utensilien.“"
                            },
                            {
                                "example_id": "dcf8552f-7e58-4188-af5e-78701e259322",
                                "sense_id": "52fa66e4-df02-3b5e-8082-c8509e9bba16",
                                "text": "„Das Vollholz einfacher Möbel wurde nur lackiert oder gestrichen, während die Oberflächen hochwertiger Möbel furniert und mit Schellack überzogen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
