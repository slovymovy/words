                        "entry_id": "6b4e8bc9-0dcd-3045-b30d-d154d24f25a0",
                        "glosses": [
                            "Eigenschaft einer Sprache, die keine/möglichst wenige fremdsprachige Einflüsse aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9e67eb-0231-43f1-84c0-1494fc78467f",
                                "sense_id": "c4bcedb7-109f-3dbf-9697-78bab6c4887c",
                                "text": "„Man darf jedoch nicht vergessen: die heutigen Bemühungen um Sprachreinheit stammen aus der Pionierzeit der - für das nationale Bewußtsein so wichtigen - Fjölnismänner.“"
                            },
                            {
                                "example_id": "78d14141-da3c-4d11-a128-60cd950a3b8a",
                                "sense_id": "c4bcedb7-109f-3dbf-9697-78bab6c4887c",
                                "text": "„Nach der Sprachlogik und der Sprachschönheit, die in den ersten Kapiteln näher ins Auge gefaßt worden sind, kann die Sprachreinheit als ein weiteres Hauptkriterium heutiger Stilkritik gelten.“"
                            }
                        ],
