                                    },
                                    {
                                        "sense_id": "ff9404e0-0ba7-3b0b-9e97-d3a596f6f825",
                                        "entry_id": "3439de0f-a349-3fbb-94a8-01dd137ee74c",
                                        "glosses": [
                                            "persoon die bij officiële gelegenheden het vaandel draagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0176d34b-810c-4217-b870-29149a685803",
                                                "sense_id": "ff9404e0-0ba7-3b0b-9e97-d3a596f6f825",
                                                "text": "Daarna marcheerden we door het Vasaparken met het blaasorkest en de vaandeldragers voorop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7bd0160-0dbf-359e-9df9-8cbf2e586bed",
                                        "entry_id": "3439de0f-a349-3fbb-94a8-01dd137ee74c",
                                        "glosses": [
                                            "belangrijkste vertegenwoordiger"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9bcca4-9a1e-4507-9247-0f5d42595e69",
                                                "sense_id": "e7bd0160-0dbf-359e-9df9-8cbf2e586bed",
                                                "text": "\"De 76-jarige Oscarwinnaar Hayao Miyazaki (Ponyo, Spirited away) was met zijn Studio Ghibli decennialang de vaandeldrager van de Japanse animatiefilm\"."
                                            },
                                            {
                                                "example_id": "448deea2-244e-479e-b983-d561591a395c",
                                                "sense_id": "e7bd0160-0dbf-359e-9df9-8cbf2e586bed",
                                                "text": "Toen Adolf Hitler midden jaren twintig uitgroeide tot de vaandeldrager van het revanchistische, antisemitische nationalisme in Duitsland was Wiener een van de eersten die op het gevaar van de nazibeweging wees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca73f3b-8f9b-307f-bca7-aa1f8d466d64",
                                        "entry_id": "3439de0f-a349-3fbb-94a8-01dd137ee74c",
                                        "glosses": [
                                            "Lindenia een libellesoort uit een geslacht van de familie van de rombouten (Gomphidae), onderorde echte libellen (Anisoptera)"
                                        ],
                                        "tags": [
                                            "libellen"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
