                        ],
                        "examples": [
                            {
                                "example_id": "88828cd9-0d6a-4459-98b4-14475717edfb",
                                "sense_id": "9f327c92-9416-3ae5-9473-91c719db4025",
                                "text": "À la longue, les téguments s’œdématient, la peau s’ulcère au contact des vêtements ; on a même vu les malades maigrir et se cachexier."
                            },
                            {
                                "example_id": "0973a9cf-b97c-4148-8f47-faccb95182e2",
                                "sense_id": "9f327c92-9416-3ae5-9473-91c719db4025",
                                "text": "Vers la fin du sixième mois, les pieds commencèrent à s’œdématier, puis les jambes, les cuisses, les parties génitales, les mains, les bras, et en dernier lieu la face."
                            },
                            {
                                "example_id": "7c718527-c0b7-4067-9eaa-425df2f9d366",
                                "sense_id": "9f327c92-9416-3ae5-9473-91c719db4025",
                                "text": "J’ai vu le visage et le corps des malades s’œdématier, et le tissu cellulaire se bouffir et se gonfler par l’irritation herpétique."
                            }
                        ]
                    }
