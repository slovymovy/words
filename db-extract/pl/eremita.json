                "senses": [
                    {
                        "sense_id": "c757a12f-4424-3e09-be18-a8f8836f90d3",
                        "entry_id": "e88d0c95-3846-3184-882e-98f0d12ca977",
                        "glosses": [
                            "zakonnik żyjący w odosobnieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2956a473-5638-4c65-bb42-0ad3ace4a3e2",
                                "sense_id": "c757a12f-4424-3e09-be18-a8f8836f90d3",
                                "text": "Na wyspie żył od trzydziestu lat eremita, który oddał się pokucie i modlitwie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "96be6f77-1f8d-3608-8965-aed5d29b17e3",
                        "entry_id": "e88d0c95-3846-3184-882e-98f0d12ca977",
                        "glosses": [
                            "człowiek żyjący w odosobnieniu szczególnie z pobudek religijnych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52462ab8-7382-4a19-ba40-97a31898f777",
                        "source_entry_id": "e88d0c95-3846-3184-882e-98f0d12ca977",
                        "source_sense_id": "c757a12f-4424-3e09-be18-a8f8836f90d3",
                        "target_lang_word": "hermit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b8879d-8f5a-3e7c-9a1e-1d5dd444e3bd",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A religious recluse; someone who lives alone for religious reasons; an eremite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A recluse; someone who lives alone and shuns human companionship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d4a2f7-03bc-4887-a0d8-7378273651a6",
                                                "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                                "text": "Solitary the thrush, / The hermit withdrawn to himself, avoiding the settlements, / Sings by himself a song."
                                            },
                                            {
                                                "example_id": "45bf5937-26c4-4dc9-bc80-6c776ac29ea4",
                                                "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                                "text": "Millie told him he sounded like some batty hermit who lived in a cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c309ec7e-3d43-36de-8770-3d310551ef29",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A spiced cookie made with molasses, raisins, and nuts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da66f48b-b5e6-389a-a1ee-b62e48813510",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A hermit crab."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659f38c3-636e-4765-bb6a-790954d557c6",
                                                "sense_id": "da66f48b-b5e6-389a-a1ee-b62e48813510",
                                                "text": "Because hermits are decapods and do not live within their own shells, they are not considered to be true crabs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1f2dce-db5f-380b-ab1d-3513a22967f0",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "Any in the subfamily Phaethornithinae of hummingbirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5d9fa2-1976-4751-8d96-419fc3e03251",
                        "source_entry_id": "e88d0c95-3846-3184-882e-98f0d12ca977",
                        "source_sense_id": "c757a12f-4424-3e09-be18-a8f8836f90d3",
                        "target_lang_word": "Eremit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eremit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "in Zurückgezogenheit lebender Mann (zum Beispiel aus religiöser Überzeugung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "025662d5-ec63-4bbd-9f19-f458542696df",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "Nicht alle Eremiten haben sich aus religiösen Gründen für ein Leben in Abgeschiedenheit entschieden."
                                            },
                                            {
                                                "example_id": "946db05e-05d8-4147-98be-4cff5d18c96a",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„1573 hatte sich der Eremit Claus Scheffer am Rande der Nuenhagener Wüstung niedergelassen.“"
                                            },
                                            {
                                                "example_id": "eea747de-1d52-4231-92a8-18c21edef9b4",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Endlich erblickte ich in der Ferne eine gotische Kapelle mit einer Hütte, die die Klause eines Eremiten zu sein schien.“"
                                            },
                                            {
                                                "example_id": "eeb390ff-9b8d-4afe-8bc2-3a70c44af328",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                                            },
                                            {
                                                "example_id": "fa9da3af-67d5-414a-8436-b5d040c1e38b",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die ernste, eindringliche Warnung des heiligen Eremiten, die so voll Vernunft war, hatte Eingang nicht nur in seine Ohrmuschel, sondern auch in seinen Verstand und sein Herz gefunden und sein Gewissen wachgerüttelt.“"
                                            },
                                            {
                                                "example_id": "d4c49fea-2d00-4cc7-9206-7744ffc90e65",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die frühen Asketen hatten auch Kontakte mit christlichen Eremiten im Irak und in Syrien, und es gab einen gewissen Austausch zwischen den beiden Gruppen, die gleichermaßen von der Vergänglichkeit und Nutzlosigkeit aller irdischen Freuden wussten und nur Gott ersehnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "seltener Käfer der Art Osmoderma eremita aus der Familie der Rosenkäfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53634d08-be47-4ff7-a7be-6ed012457470",
                                                "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                                "text": "Eremiten leben in Baumhöhlen, vor allem an Eichen, die sie oft ihr Leben lang nicht verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
