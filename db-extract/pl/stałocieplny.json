        "pl-extract.jsonl": [
            {
                "entry_id": "6660d16c-ce62-3c8d-a9fc-f6040e09d7cf",
                "word": "stałocieplny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ab3416b-454f-3fa8-ab82-0f9dc4fe253c",
                        "entry_id": "6660d16c-ce62-3c8d-a9fc-f6040e09d7cf",
                        "glosses": [
                            "utrzymujący stałą temperaturę niezależnie od temperatury otoczenia"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b4caa50-bbb2-45c6-a4e8-a3c6f3359a93",
                        "source_entry_id": "6660d16c-ce62-3c8d-a9fc-f6040e09d7cf",
                        "source_sense_id": "5ab3416b-454f-3fa8-ab82-0f9dc4fe253c",
                        "target_lang_word": "warm-blooded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warm-blooded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c820ed-793b-3eac-82b6-2503ee55b7ef",
                                        "entry_id": "e888af0e-dae6-3e67-b569-bb00e1f797c3",
                                        "glosses": [
                                            "Maintaining a relatively constant and warm body temperature, regardless of the ambient temperature; endothermic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abd3fe6-796a-41d7-9653-44ebeb507bef",
                                                "sense_id": "a9c820ed-793b-3eac-82b6-2503ee55b7ef",
                                                "text": "The cold-blooded animals are all feeble breathers, and the most energetic breathers are the warmest-blooded. A mollusc, a fish, a frog, a quadruped, and a bird, represent the various stages of this correspondence."
                                            },
                                            {
                                                "example_id": "a507a50f-b647-4f6c-8b38-384033bafe91",
                                                "sense_id": "a9c820ed-793b-3eac-82b6-2503ee55b7ef",
                                                "text": "Moreover, instead of hibernating like our northern reptiles, they [birds] are able to remain active all winter, even in arctic latitudes, so long as sufficient food is available to maintain the body. This retention of heat increases the body temperature, and implies an increase as well of the creature’s activity, so that birds in addition to being the warmest-blooded animals are at the same time the quickest and most active."
                                            },
                                            {
                                                "example_id": "0e29d2d3-c7a4-4f88-a63d-0d98e689a077",
                                                "sense_id": "a9c820ed-793b-3eac-82b6-2503ee55b7ef",
                                                "text": "“It’s getting chilly,” the Asian chick said, maybe just to hear the sound of her own voice. […] / “Oh, I don’t know. Feels all right to me.” / “I guess you’re warmer-blooded than I am. Could I have my sweatshirt now?”"
                                            },
                                            {
                                                "example_id": "b1b9b9af-f0ff-4f0c-85ac-720023d4ba26",
                                                "sense_id": "a9c820ed-793b-3eac-82b6-2503ee55b7ef",
                                                "text": "We stood there, shivering, colder even than when we had been on our horses, for horses are warmer-blooded than their riders, and one always gains heat from them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "227ca51a-608d-3583-bbae-e0c75110d7e1",
                                        "entry_id": "e888af0e-dae6-3e67-b569-bb00e1f797c3",
                                        "glosses": [
                                            "Passionate."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72bb5376-6966-4cb8-aa10-32f81207da6f",
                                                "sense_id": "227ca51a-608d-3583-bbae-e0c75110d7e1",
                                                "text": "Claire jumped from her chair and smiled the warmest-blooded smile that she could muster."
                                            },
                                            {
                                                "example_id": "94df9df5-843c-498e-a43d-60ca57d0d317",
                                                "sense_id": "227ca51a-608d-3583-bbae-e0c75110d7e1",
                                                "text": "Chasseur said, “Murder is a grisly, nasty business, Jessica. The female species simply doesn’t have the genetic makeup to deal sensibly with it. Murder is a cold-blooded act. Women are, by nature, warmer-blooded than men, which is why they’re so attractive to the male of the species.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e79854e-5bdc-4250-8221-5f50ccc81863",
                        "source_entry_id": "6660d16c-ce62-3c8d-a9fc-f6040e09d7cf",
                        "source_sense_id": "5ab3416b-454f-3fa8-ab82-0f9dc4fe253c",
                        "target_lang_word": "warmblütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warmblütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                        "entry_id": "e4c9b2ef-b53f-347b-b1ea-200dc64534b1",
                                        "glosses": [
                                            "die Körpertemperatur annähernd konstant haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f5e252-41f0-4e95-9203-5859d66a5a3b",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "Die warmblütigen Vögel haben meistens eine höhere Körpertemperatur als Säugetiere."
                                            },
                                            {
                                                "example_id": "06bd7579-b5a2-4331-8886-a9307e936cf9",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Pythons] „ernähren sich üblicherweise von warmblütigen Tieren, das heißt von Vögeln und Säugetieren.“"
                                            },
                                            {
                                                "example_id": "b320d6cf-85eb-4d50-94c8-6f7d6ad73668",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Toxoplasma gondii:] „Dieser einzellige Parasit aus der Familie der Protozoen kann sich prinzipiell in allen warmblütigen Tieren durch Teilung vermehren – auch im Menschen.“"
                                            },
                                            {
                                                "example_id": "65d0e467-19e6-4a44-831f-e34f116951bb",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Leptospira:] „Die Bakterien vermehren sich in warmblütigen Tieren, insbesondere in Ratten, Mäusen, Schweinen, Hunden, Katzen, Pferden, Schafen, Ziegen und Rindern.“"
                                            },
                                            {
                                                "example_id": "19c9f206-cb3a-4fa9-854f-e8ea3fd9454f",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Im gleichen Jahr erließen sie auch ein Tierschutzgesetz, das unter anderem festlegte, dass warmblütige Tiere nicht mehr ohne Betäubung geschlachtet werden durften.“"
                                            },
                                            {
                                                "example_id": "e82b83d0-bd6d-479a-883a-9efdbb65a049",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Die Richter waren aber der Meinung, dass das Töten warmblütiger Tiere ohne vorherige Betäubung nicht qualvoller sei als die üblichen Schlachtmethoden.“"
                                            },
                                            {
                                                "example_id": "7bc36144-c63c-4a6e-8b0d-c55269b62869",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Auf warmblütige Lebewesen wirkt Blausäure schon in geringer Dosis tödlich (1/22 der Dosis für Wirbellose).“"
                                            },
                                            {
                                                "example_id": "84d5c613-8c1c-47d2-aa71-0b2a1f70cf74",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[…] „Fische erhalten kaum das gleiche Maß an Mitgefühl und konkretem Tierschutz wie die warmblütigen Wirbeltiere.“"
                                            },
                                            {
                                                "example_id": "d9b623dc-4d32-4efd-b7af-9ed86cca9903",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Das Gefieder] „schützt den warmblütigen Vogelkörper vor Abkühlung, seine Flügel- und Schwanzfedern dienen der Fortbewegung.“"
                                            },
                                            {
                                                "example_id": "50a9ea03-600e-4828-9554-05063d626d8c",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„»Wie können diese warmblütigen Haie – was schon sehr ungewöhnlich bei Kiemenatmern ist – in Gebieten überwintern, wo die Wassertemperatur nur 2 Grad Celsius beträgt?«“"
                                            },
                                            {
                                                "example_id": "f86ff6ee-ad25-4086-bc95-80c5882240ea",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Es ist möglich, dass einige Dinosaurier warmblütig waren, andere aber nicht.“"
                                            },
                                            {
                                                "example_id": "f3dcdcba-123a-4e11-85a5-4fea11bc5337",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Dinosaurier:] „Die Urzeitechsen waren weder kaltblütig wie Reptilien noch warmblütig wie heutige Säuger. Die Wahrheit lag wohl in der Mitte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7ab737b-e8ae-3cdc-8e7c-360c7b3e5188",
                                        "entry_id": "e4c9b2ef-b53f-347b-b1ea-200dc64534b1",
                                        "glosses": [
