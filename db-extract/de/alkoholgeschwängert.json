                ],
                "senses": [
                    {
                        "sense_id": "26b853ca-2a86-3a5a-afaa-7d127c9ea270",
                        "entry_id": "3bb3d994-0de2-367b-b470-10d586a2e29e",
                        "glosses": [
                            "voller Alkohol, stark nach Alkohol riechend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14954f80-a233-4459-8b03-f31130f4dc8d",
                                "sense_id": "26b853ca-2a86-3a5a-afaa-7d127c9ea270",
                                "text": "„Er beugte sich so nah an seinen Chef heran, dass er dessen kratzige Bartstoppeln spüren und seinen alkoholgeschwängerten Atem riechen konnte, und küsste ihn auf beide Wangen.“"
                            },
                            {
                                "example_id": "81bb52bf-75cd-4234-8920-8d9df80d4f5d",
                                "sense_id": "26b853ca-2a86-3a5a-afaa-7d127c9ea270",
                                "text": "„Aber ich war zu müde, um mich in weiteren alkoholgeschwängerten Spekulationen zu ergehen.“"
                            },
                            {
