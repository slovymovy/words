                                        "entry_id": "296ab567-091f-361c-b766-37b6ac73da8b",
                                        "glosses": [
                                            "One who returns something, such as defective goods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a662280-a416-4252-b952-83b6690b2bb2",
                                                "sense_id": "82f75911-bd2a-3b99-85c8-81f15477b635",
                                                "text": "For instance, some merchants suppress the names of “serial returners”; basically, customers who repeatedly buy products that they quickly return after using them once."
                                            }
                                        ]
