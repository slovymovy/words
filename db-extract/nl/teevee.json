                        "examples": [
                            {
                                "example_id": "bc927775-3044-467c-81e1-92763a1e0cc7",
                                "sense_id": "fe299697-a118-3b6f-863f-8df95d831126",
                                "text": "De mini-computers met namen als Filmspeler, Teevee.io, Ditistv en Allefilmskijken beloven vrijwel alles wat er op internet te vinden is met een paar klikken aan te bieden in goede kwaliteit én met ondertiteling. Ze kosten tussen de 80 en 160 euro."
                            },
                            {
                                "example_id": "0fa53560-99ae-4ea3-9e19-a360cb365cd6",
                                "sense_id": "fe299697-a118-3b6f-863f-8df95d831126",
                                "text": "Toch begrijpt Titulaer wel dat het líjkt alsof hij minder in het nieuws is. \"Vroeger waren er maar twee mogelijkheden: teevee or not teevee. De eigen programma's die ik in die tijd had, over ruimtevaart, sterrenkunde, computerkunde, meteorologie en wetenschap en vele andere onderwerpen, hadden een enorme kijkdichtheid."
                            }
                        ]
