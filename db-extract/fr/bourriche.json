        "fr-extract.jsonl": [
            {
                "entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                "word": "bourriche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9340036b-8301-4281-a6ba-e9719865558a",
                        "entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourriches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                        "entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                        "glosses": [
                            "Espèce de panier tressé, sans anse, fermé par un couvercle, dont on se sert pour transporter du gibier, de la volaille, du poisson, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd30ec04-2b2e-46a4-bd04-81f3068bbb21",
                                "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                                "text": "Duchotel.— Je lui dis : \"Du gibier empaqueté dans une bourriche…\", il entend : \"en pâté dans une bourriche !\""
                            },
                            {
                                "example_id": "96423721-8f66-485b-ad3e-e85902246617",
                                "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                                "text": "Une bourriche d’huîtres."
                            },
                            {
                                "example_id": "dd9952c1-d002-49f2-8ba7-f164b79524b4",
                                "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                                "text": "Derrière lui, sur le carreau de la rue Rambuteau, on vendait des fruits. Des rangées de bourriches, de paniers bas, s’alignaient, couverts de toile ou de paille"
                            },
                            {
                                "example_id": "c7f908e9-df6d-4099-85e2-b2451e938f30",
                                "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                                "text": "Tu sais que, si nous la livrons dimanche, je t’ai promis une bourriche de pensées pour ton jardin."
                            },
                            {
                                "example_id": "e0c7a34b-a118-4634-af2f-24555a01e140",
                                "sense_id": "4d02b97b-4306-3310-9b3a-6fab8a384ec9",
                                "text": "Pour manger une noix, il faut mettre une nappe, dit Manuela qui extirpe de son vieux cabas une petite bourriche de bois clair dont dépassent des volutes de papier de soie carmin et, nichées dans cet écrin, des tuiles aux amandes."
                            }
                        ]
                    },
                    {
                        "sense_id": "27c78fde-f50c-3f1d-9552-ba975b60c17a",
                        "entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                        "glosses": [
                            "Cageot de bois déroulé, munie d'un couvercle, servant le plus souvent au transport des huîtres."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0abe454e-cdcf-3ad0-bb61-60b42c109a10",
                        "entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                        "glosses": [
                            "Espèce de panier anciennement en osier, actuellement en filet métallique fermé par une trappe, que le pêcheur met dans l’eau et dans lequel il conserve vivants les poissons capturés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a50483ad-ccd7-46b1-a8d3-139badf6e589",
                                "sense_id": "0abe454e-cdcf-3ad0-bb61-60b42c109a10",
                                "text": "À ses pieds, dans l’eau claire, sa bourriche métallique, où tournaient les canifs des ablettes."
                            },
                            {
                                "example_id": "819ca56d-f2f2-4310-b3e8-538f4656361b",
                                "sense_id": "0abe454e-cdcf-3ad0-bb61-60b42c109a10",
                                "text": "Sur le fond, et autour de l’aquarium, des présentoirs exhibaient les attirails, des plus simples aux plus compliqués : gaules en bambou, cannes en fibre de verre, grandes cannes télescopiques pour moulinet à tambour tournant, boîtes de mouches et de cuillères, d’hameçons et de plombs, devons, moulinets de tous calibres, montures pour poissons morts, dégorgeoirs, bourriches, épuisettes, appâts réputés fantastiques ! fabuleux ! ou, plus prosaïquement, épatants !"
                            },
                            {
                                "example_id": "91d35e86-921d-4b5a-b941-03fc171eef5f",
                                "sense_id": "0abe454e-cdcf-3ad0-bb61-60b42c109a10",
                                "text": "Ils s’apprêtent à se jeter à l’eau avec dans une bourriche, un précieux trésor ramassé quelques jours plus tôt sur des plages varoises : des graines de posidonies, ces herbes sous-marines aux mille vertus écologiques présentes uniquement en Méditerranée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d34c3fc-45c8-4c34-8144-52b39b624706",
                        "source_entry_id": "8f1f1ebd-bdd7-30d7-90e0-0f0ea44e4423",
                        "source_sense_id": "27c78fde-f50c-3f1d-9552-ba975b60c17a",
                        "source_sense_description": "Espèce de panier en filet métallique de pêcheur pour les poissons",
