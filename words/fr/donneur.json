            "senses": [
                {
                    "sense_id": "d51d6bbd-d6ad-30c8-9a52-532d411aef4f",
                    "sense_definition": "Personne qui consent à donner son sang, des tissus ou un organe à des fins thérapeutiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital recherche d'urgence un <w>donneur</w> de sang compatible avec ce patient hospitalisé."
                        },
                        {
                            "text": "Le rein a été prélevé sur un <w>donneur</w> vivant après une longue série d'examens médicaux."
                        }
                    ],
                    "antonyms": [
                        "receveur"
                    ],
                    "common_phrases": [
                        "donneur de sang",
                        "donneur d'organes"
                    ]
                },
                {
                    "sense_id": "96383d8e-bf8c-3745-8ab6-54ad9912bc2e",
                    "sense_definition": "Personne qui bat et distribue les cartes ou les jetons au début d'une manche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au début de la partie, le <w>donneur</w> distribue cinq cartes à chaque joueur assis à la table."
                        },
                        {
                            "text": "Chaque joueur devient à son tour le <w>donneur</w> selon le sens des aiguilles d'une montre."
                        }
                    ]
                },
                {
                    "sense_id": "a378cd56-3827-332c-8045-2e67ab04428c",
                    "sense_definition": "Personne qui prodigue, accorde ou impose quelque chose à autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne n'apprécie ce collègue prétentieux qui agit toujours en <w>donneur</w> de leçons avec tout le monde."
                        },
                        {
                            "text": "Dans ce grand projet immobilier, notre entreprise agit en tant que <w>donneur</w> d'ordre principal."
                        }
                    ],
                    "common_phrases": [
                        "donneur de leçons",
                        "donneur d'ordre"
                    ]
                },
                {
                    "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                    "sense_definition": "Personne qui dénonce quelqu'un auprès des autorités ou de la police.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delateur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les criminels ont rapidement découvert l'identité du <w>donneur</w> qui renseignait secrètement la police."
                        },
                        {
                            "text": "Dans ce polar sombre, le témoin refuse de parler pour éviter d'être traité de <w>donneur</w>."
