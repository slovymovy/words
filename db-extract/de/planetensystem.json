                                "target_senses": [
                                    {
                                        "sense_id": "54ccabfc-33d0-3fc7-90c4-a36e34f5f86c",
                                        "entry_id": "c5c3d76d-51e7-3c40-804e-13d1d9db421b",
                                        "glosses": [
                                            "астрон. система звезды (звёзд) и различных незвёздообразных астрономических объектов, вращающихся вокруг общего барицентра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f510586-b761-4d1b-8ebb-5c210ca740e7",
                                                "sense_id": "54ccabfc-33d0-3fc7-90c4-a36e34f5f86c",
                                                "text": "Этот телескоп, в частности, поможет как изучению эволюции галактик, так и обнаружению планетных систем."
                                            },
                                            {
                                                "example_id": "f41574ff-f682-4a61-8eb6-62eb146a23f8",
                                                "sense_id": "54ccabfc-33d0-3fc7-90c4-a36e34f5f86c",
                                                "text": "Пока неизвестно, на какой стадии эволюции у этой звезды могла появиться планетная система."
                                            },
                                            {
                                                "example_id": "c17386c0-a557-4679-bb36-822eaed8c47a",
                                                "sense_id": "54ccabfc-33d0-3fc7-90c4-a36e34f5f86c",
                                                "text": "Представим себе первоначальную газообразную массу, из которой образовалась потом планетная система."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
