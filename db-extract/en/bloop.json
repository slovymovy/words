                "senses": [
                    {
                        "sense_id": "60804d61-acec-3f06-995f-e6752abe1cae",
                        "entry_id": "a020b855-71b1-3ade-a8db-a423e7f8dcdd",
                        "glosses": [
                            "The sound of a fish blowing air bubbles in water."
                        ],
                        "tags": [
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "0597fe7b-10b2-4b8b-b7f3-09f322f5de32",
                                "sense_id": "60804d61-acec-3f06-995f-e6752abe1cae",
                                "text": "Slowly exhale using short, quick bursts through the mouth, making 'bloop' sounds to mimic a fish each time."
                            }
                        ]
                    },
                    {
                        "sense_id": "35391255-b057-3f51-857f-3b03ff1b5790",
                        "entry_id": "a020b855-71b1-3ade-a8db-a423e7f8dcdd",
                        "glosses": [
                            "The sound of something, especially a fish, sloshing about in water."
                        ],
                        "tags": [
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "0d7238fc-9266-46ef-96f6-343779083f3f",
                                "sense_id": "35391255-b057-3f51-857f-3b03ff1b5790",
                                "text": "A loud bloop bloop from the fish tank made me jump, the three-year-old Reader’s Digest almost slipping from my grip."
                            },
                            {
                                "example_id": "ecf8b711-c6fd-4b8c-a092-1929c557d50f",
                                "sense_id": "35391255-b057-3f51-857f-3b03ff1b5790",
                                "text": "Still, it’s a good place to stand and try to catch sight of a heron or to be quiet to hear the bloop, bloop of fish surfacing to eat a water bug."
                            }
                        ]
                    },
                    {
                        "sense_id": "6edb766e-38ad-3a50-aa17-be986402e701",
                        "entry_id": "a020b855-71b1-3ade-a8db-a423e7f8dcdd",
                        "glosses": [
                            "A low-pitched beeping sound."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ebdbcfd6-c958-4076-983b-935ebf11d112",
                                "sense_id": "6edb766e-38ad-3a50-aa17-be986402e701",
                                "text": "The robot produced a series of beeps and bloops before giving its answer to the problem."
                            },
                            {
                                "example_id": "e9ba1d83-365e-4643-a8b0-6044c2a938cd",
                                "sense_id": "6edb766e-38ad-3a50-aa17-be986402e701",
                                "text": "A fiendish yell then followed / Ev'ry salvo's 'bang' and 'bloop'."
                            }
                        ]
                    },
