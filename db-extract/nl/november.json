                                "target_senses": [
                                    {
                                        "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                        "entry_id": "0123fcf2-2292-313e-b504-8d4c4b2ca95c",
                                        "glosses": [
                                            "The eleventh month of the Gregorian calendar, following October and preceding December."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80746465-0c67-4cf4-8929-002b7de19855",
                                                "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "0cc0e2e3-00a1-4665-8898-09dd04ad373c",
                                                "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                                "text": "Red o'er the forest glows the setting sun, / The line of yellow light dies fast away / That crown'd the eastern copse, and chill and dun / Falls on the moor the brief November day."
                                            },
                                            {
                                                "example_id": "1403565c-33bc-4b55-b65c-a3857aa5a2b0",
                                                "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                                "text": "This is an annotated wordlist of the Ayere language, spoken in Ayere village in Kwara State, Nigeria. The wordlist was written by Mr. E.O. Olumorin for the West African Languages Survey in November 1961."
                                            },
                                            {
                                                "example_id": "25312658-3321-43c7-9f1d-b6043b53683b",
                                                "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                                "text": "Stadia, Google’s cloud gaming service, launched in November 2019, with some likening it to the Netflix (NFLX) of video games."
                                            },
                                            {
                                                "example_id": "25d8fb82-ef87-4f98-8e3d-b3bcb37ebc38",
                                                "sense_id": "96b2ed94-6b03-334b-b6ac-dffc2f3b9be5",
                                                "text": "An LMPD Board Notice of Hearing states part of Cosgrove’s hearings took place in November. The second half of his hearing is set to begin Monday and end Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e938ffa4-ddb2-3c61-9b52-a477b69ebe18",
                                        "entry_id": "0123fcf2-2292-313e-b504-8d4c4b2ca95c",
                                        "glosses": [
                                            "A female given name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f679c1d-bbf4-4db3-a0c6-c2d1f92742a5",
                        "source_entry_id": "706dd143-66dd-33d1-91d1-d0cf4d310eba",
                        "source_sense_id": "d046c9d4-5310-3a41-95d7-1755a3127994",
