                    {
                        "sense_id": "4c29861e-8353-3428-947c-ae08dbada8ab",
                        "entry_id": "df73a17a-f079-3a7a-88ea-9742fd7d26cf",
                        "glosses": [
                            "een droge doosvrucht, die minstens driemaal zo lang als breed is, zoals bij koolzaad en pinksterbloem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6cc58e8-98d8-4834-9cff-e00c52b27609",
                                "sense_id": "4c29861e-8353-3428-947c-ae08dbada8ab",
                                "text": "Een hauw bestaat uit twee steriele en twee fertiele vruchtbladen, waarvan de bladranden van de fertiele vruchtbladen zijn vergroeid tot randstandige zaadlijsten en een hauw is daarmee tweehokkig en tweekleppig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2aa88d3-f11f-4cd5-8c71-ffbd5b149aeb",
                        "source_entry_id": "df73a17a-f079-3a7a-88ea-9742fd7d26cf",
                        "source_sense_id": "4c29861e-8353-3428-947c-ae08dbada8ab",
                        "source_sense_description": "een droge doosvrucht, die minstens driemaal zo lang als breed is, zoals bij koolzaad en pinksterbloem.",
                        "target_lang_word": "角果",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2016f2b0-718a-4b14-a4b0-cda12a446089",
                        "source_entry_id": "df73a17a-f079-3a7a-88ea-9742fd7d26cf",
                        "source_sense_id": "4c29861e-8353-3428-947c-ae08dbada8ab",
                        "source_sense_description": "een droge doosvrucht, die minstens driemaal zo lang als breed is, zoals bij koolzaad en pinksterbloem.",
                        "target_lang_word": "Schote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6572400b-0af1-345b-ba1a-82263535c84f",
                                        "entry_id": "3a0d2882-5735-31b7-ae2c-2d4f194cd755",
                                        "glosses": [
                                            "Kapselfrucht der Kreuzblütengewächse"
                                        ],
                                        "tags": [
                                            "Brassicaceae"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2b30dd-3090-4cea-a297-aac9e55a6681",
                                                "sense_id": "6572400b-0af1-345b-ba1a-82263535c84f",
                                                "text": "Die Früchte werden als Schoten bezeichnet, wenn sie mindestens dreimal so lang wie breit sind, sind sie gedrungener, so heißen sie Schötchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30c4bda7-beba-32f3-82fc-e0c8fd27a33e",
                                        "entry_id": "3a0d2882-5735-31b7-ae2c-2d4f194cd755",
                                        "glosses": [
                                            "Frucht von Hülsenfrüchtlern , besonders von Erbsen und Bohnen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcef811c-1b01-46bb-894e-4274e835a5e8",
                                                "sense_id": "30c4bda7-beba-32f3-82fc-e0c8fd27a33e",
                                                "text": "„Wir überschritten die breiten, sandigen Betten zweier ausgetrockneter Flüsse; über sie ragten mächtige Bäume, unter denen der ansehnlichste der Kombuk (Pentaptera paniculata) war, aus dessen kalkiger Rinde die Eingeborenen eine Art Leim für ihren Betel bereiten, und von den Zweigen hingen über die wasserlosen Rinnen hin die riesigen Hülsen der kolossalen Pusnoaël-Bohne ( Entada pursaetha), deren Schote bei einer Breite von sechs Zoll drei Ellen in der Länge mißt.“"
                                            },
                                            {
                                                "example_id": "a3a49554-0c25-4ea5-b04c-5ecaa42752f9",
                                                "sense_id": "30c4bda7-beba-32f3-82fc-e0c8fd27a33e",
                                                "text": "„Während sie in einem Erbsenfeld rasteten und sich an grünen Schoten satt aßen, erschreckte sie ein Donnern, so fern, als ziehe von Osten her ein Gewitter auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3fc14b60-bfa7-3a4d-a643-adca5d8932a0",
                                        "entry_id": "3a0d2882-5735-31b7-ae2c-2d4f194cd755",
                                        "glosses": [
                                            "Frucht von Paprika"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2416ec70-a5f1-4cf8-8b63-9cc7212de5f1",
                                                "sense_id": "3fc14b60-bfa7-3a4d-a643-adca5d8932a0",
                                                "text": "Wählen Sie je eine rote und eine gelbe Paprikaschote, waschen Sie die Schoten, und schneiden Sie sie in schmale Strefen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d9412cb-0e7b-38e5-a817-512163904600",
                                        "entry_id": "54f986b0-2a4e-3008-a0cb-84f8eb57f5f4",
                                        "glosses": [
                                            "Nebenform von Schot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4115ff2-6305-4e87-8c70-d0f053f995a0",
                                                "sense_id": "8d9412cb-0e7b-38e5-a817-512163904600",
                                                "text": "„Darauf setzte er den Mast wieder ein, löste die Segel, gab seinem Schüler die Schote des Klüvers in die Hand und unterrichtete ihn, wie er anziehen und loslassen sollte.“"
                                            },
                                            {
                                                "example_id": "f949f515-478a-450f-841c-7c4e90a21470",
                                                "sense_id": "8d9412cb-0e7b-38e5-a817-512163904600",
                                                "text": "„»Jungens, Jungens«, sagte der Mate, während er das Glas neben sich legte und die Schote des Segels ein klein wenig mehr anzog, um den Wind besser zu fangen.“"
                                            },
                                            {
                                                "example_id": "6b836df5-3ec7-4b04-99bf-e1c6a2598e1c",
                                                "sense_id": "8d9412cb-0e7b-38e5-a817-512163904600",
                                                "text": "„Sie befestigt die Schote nicht am Knopf, sondern behält das Tau in der Hand, bereit, es loszulassen, sobald ein Windstoß kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c19a4c4b-7762-38f4-b4db-77029e8b85c4",
                                        "entry_id": "bd328d9f-62d1-362b-a87c-9e1f61efc2ce",
                                        "glosses": [
                                            "(nur zum Vergnügen ausgedachte, zumeist humorvolle) Geschichte"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267eb83a-fc57-4e22-ab50-c0052963a482",
                                                "sense_id": "c19a4c4b-7762-38f4-b4db-77029e8b85c4",
                                                "text": "Der hatte aber ein paar saftige Schoten auf Lager!"
                                            },
                                            {
                                                "example_id": "9c36f436-8f80-4baa-93cb-ffe1146f0c88",
                                                "sense_id": "c19a4c4b-7762-38f4-b4db-77029e8b85c4",
                                                "text": "„Oder wenn Fischer auf die Frage, seit wann er denn wusste, dass das mit dem Irak schief läuft, diese Schote erzählt: \"Colin Powell, der Außenminister, sagte leise zu mir: 'Ich muss irgendwas im Irak machen'.\"“"
                                            },
                                            {
                                                "example_id": "c70cc39d-d544-4d64-bcc0-f7390290ced9",
                                                "sense_id": "c19a4c4b-7762-38f4-b4db-77029e8b85c4",
                                                "text": "„Es gibt Fotos, Geschichten und Objekte, so manche_r [sic] kann sich und seine Lieben auf den Bildern wiederentdecken, manch alte Schote wird erzählt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eee2a50-6d0b-36ee-9db7-a183da2bd9c2",
                                        "entry_id": "49b2591e-9db9-352f-8c32-ff3e99b64595",
                                        "glosses": [
                                            "törichter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34f2396-bb62-43b4-b5a1-158554bb6b5c",
                                                "sense_id": "5eee2a50-6d0b-36ee-9db7-a183da2bd9c2",
                                                "text": "Was bist du doch nur für ein Schote!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
