                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9aec3c35-2299-3430-a32c-81774a1ba9a4",
                        "entry_id": "dc964f17-1d1d-3031-80b2-e993fe7ca9d0",
                        "glosses": [
                            "The meaning of this term is uncertain. Possibilities include:",
                            "also, as well"
                        ],
                        "tags": [
                            "Middle",
                            "Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "73e4ca16-de90-468f-a808-190fda7e8ab6",
                                "sense_id": "9aec3c35-2299-3430-a32c-81774a1ba9a4",
                                "text": "a yeſzly yſzczyą przyrownam anyolom/ o zayſte doſtoynyeyſzaſz nath anyoly"
                            },
                            {
                                "example_id": "3421e283-c154-46fc-9b2d-095611311277",
                                "sense_id": "9aec3c35-2299-3430-a32c-81774a1ba9a4",
                                "text": "ábowiem Egipcżánie ſą rozomni/ ktorzy iż ſny rozwodzą/ známioná vkazuią"
                            },
                            {
                                "example_id": "2a2b88f6-4ab9-4b28-8fa4-9dc38ce6c95d",
                                "sense_id": "9aec3c35-2299-3430-a32c-81774a1ba9a4",
                                "text": "Iſch powyedzial yſch Thalierzse paniczewſkie, kthore gineli Zyanem wolkyem nagradzal panſkimy"
                            },
                            {
                                "example_id": "3ea23f3b-fd1f-45bb-a1b2-338a9e4966fe",
                                "sense_id": "9aec3c35-2299-3430-a32c-81774a1ba9a4",
                                "text": "Byli oni ludźie bárzo pilni/ á w káżdey wolney náuce/ iż z ſámego zwycżáiu bárzo biegli [Erant viri illi perquam diligentes et ab omni liberali eruditione etiam usu ipso paratissimi]"
                            }
                        ]
                    },
                    {
                        "sense_id": "72d76a19-daf1-3a7d-bd26-7c78522fc35c",
                        "entry_id": "dc964f17-1d1d-3031-80b2-e993fe7ca9d0",
                        "glosses": [
                            "The meaning of this term is uncertain. Possibilities include"
                        ],
                        "tags": [
                            "Middle",
                            "Polish"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "01ae9e78-786f-3bc7-850f-018beb559187",
                        "entry_id": "dc964f17-1d1d-3031-80b2-e993fe7ca9d0",
                        "glosses": [
                            "The meaning of this term is uncertain. Possibilities include:",
                            "interrogative; why"
                        ],
                        "tags": [
                            "Middle",
                            "Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "3cda3728-1dd3-4192-a815-04d5f1f8acb3",
                                "sense_id": "01ae9e78-786f-3bc7-850f-018beb559187",
                                "text": "ſilj moie nie ſą ták doſtátecżne iáko morzá ábo wielorybá/ iż mię śćiſkaſz tákowem vtrapieniem ktorego vydz nie mogę."
                            },
                            {
                                "example_id": "eee0b161-a1c6-4c4d-a5dd-2f1d90898e02",
                                "sense_id": "01ae9e78-786f-3bc7-850f-018beb559187",
                                "text": "y przeſlvge ſwego wſkazala ze ya ſkrolyem j. m. nycz nyemąm jſz do mnye slye"
                            }
                        ]
                    },
                    {
                        "sense_id": "1529d009-5c43-3656-b90c-549a14413512",
                        "entry_id": "dc964f17-1d1d-3031-80b2-e993fe7ca9d0",
                        "glosses": [
                            "The meaning of this term is uncertain."
                        ],
                        "tags": [
                            "Middle",
                            "Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "b6e64c9b-9a9d-4751-bf6f-dbb2e462417d",
                                "sense_id": "1529d009-5c43-3656-b90c-549a14413512",
                                "text": "Kto ſie cnotą ſpráwuie/ á Bogá ſie boi/ Iż go márna ſwawola/ ále rozum ſtroi."
                            },
                            {
                                "example_id": "de1cbc40-a29f-4beb-915f-5d3c3dd625d5",
                                "sense_id": "1529d009-5c43-3656-b90c-549a14413512",
                                "text": "Proximus sum egomet mihi, Bliſzſzym ſam ſobie/ Nikomum ták wiele nie powinien iż yednák więcey ſam ſobie."
                            },
                            {
                                "example_id": "7db33a79-9f08-4240-a345-e4d2312af8e0",
                                "sense_id": "1529d009-5c43-3656-b90c-549a14413512",
                                "text": "Ow záſię ná málucżki cżás walał ſię iáko we błocie ſwiniá w onych márnych roſkoſzach ſwoich/ thák iáko tu Ewányeliſtá ſwięty piſze/ y z onymi godowniki ſwoiemi/ y iż kęs poſkakáłá przed nim oná márna á plugáwa zwodnicá iego/ ktora nie tylko ciáło/ ále zwiodłá á zátráćiłá y nędzną duſzę iego."
                            },
                            {
                                "example_id": "5e60ce31-aaa2-4fc5-8d6b-b2d180e8b86a",
                                "sense_id": "1529d009-5c43-3656-b90c-549a14413512",
                                "text": "Otoż álbo te dwie mieyſcá ſą iáſnie máluiące Cżyśćiec/ albo więc iż iáſność ſwoię z wykłádu ták wielkich y świętych dwu kośćielnych Doktorow biorą"
                            }
                        ]
                    }
                ],
