                        "glosses": [
                            "The condition of being flocculent; wooliness, flakiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ebc1ce9-f640-47d0-a5db-560cc270b250",
                                "sense_id": "2714606c-fba5-3cbf-964c-8171f7d685f4",
                                "text": "This paragraph is remarkable for its own flocculence. The Times implies, without quite saying it, both that it approves of Obama's evasions […] and that it would approve if he took a different approach[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c67c62e-eec5-3c55-956a-95962cb9cdc7",
                        "entry_id": "16fdc125-4309-3a15-9a0d-b4d8d0d2dcf6",
                        "glosses": [
                            "A substance or condition that causes a surface to be flocculent; fluff, flakes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a11e65cc-c29e-4217-9d6d-a55a78b8c35d",
                                "sense_id": "1c67c62e-eec5-3c55-956a-95962cb9cdc7",
                                "text": "Branches and leaves become covered with the waxy filaments creating a flocculence (wool-like tufts) that indicates a heavy infestation. Rain will wash away the flocculence, but nymphs will soon secrete more."
                            },
                            {
                                "example_id": "3a5c2203-6654-4277-8926-9a421801bdda",
                                "sense_id": "1c67c62e-eec5-3c55-956a-95962cb9cdc7",
                                "text": "However, its nymphs (immatures) are easy to detect from the copious amounts of waxy flocculence (white fluff) that they secrete onto melaleuca leaves and stems."
                            },
                            {
                                "example_id": "1dc54d10-d34d-4bd4-80ab-9d41f6bbbc88",
                                "sense_id": "1c67c62e-eec5-3c55-956a-95962cb9cdc7",
                                "text": "elastic, thinly skinned, easy to rupture, with purple brown flocculences when torn by hand."
                            }
                        ]
                    }
