                "senses": [
                    {
                        "sense_id": "f6b5c3e1-4ab6-3be8-b568-64cf46073d6d",
                        "entry_id": "436af00e-e2ad-37dc-ba32-0b958cbb1e04",
                        "glosses": [
                            "Gebäude, in dem Frauen sexuelle Dienstleistungen gegen Entgelt anbieten"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ed2ca712-0cac-402b-9bcc-4c632f6191f3",
                                "sense_id": "f6b5c3e1-4ab6-3be8-b568-64cf46073d6d",
                                "text": "„Hat mich der Kerl, der Gose-Schleppfuß in eine Schlupfbude geführt!“"
                            },
                            {
                                "example_id": "5bb34e1b-455b-4b45-bf2f-99f4efb2602e",
                                "sense_id": "f6b5c3e1-4ab6-3be8-b568-64cf46073d6d",
                                "text": "„So standen die Dinge, als eines Tages der Faßbinder sich mit anderen munteren Gesellen nach Konstanz begab, wo Kirchweih war und wo sie einen guten Tag hatten, so daß sie am Abend der Haber stach und sie beschlossen, in eine Schlupfbude zu Weibern zu gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
