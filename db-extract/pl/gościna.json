                                        "glosses": [
                                            "vorübergehendes Aufsuchen des Aufenthaltsorts einer Person, vorübergehendes Aufsuchen eines Gebäudes oder einer Institution auf eigene Initiative"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9995d807-e36e-4f00-858e-984262f90342",
                                                "sense_id": "8dff2120-4a27-38e7-915c-ff83b5aa97dd",
                                                "text": "Er kündigt seinen Besuch für den Nachmittag an."
                                            },
                                            {
                                                "example_id": "ccbc9c86-b419-4038-a1af-3e217824410c",
                                                "sense_id": "8dff2120-4a27-38e7-915c-ff83b5aa97dd",
                                                "text": "Wir werden Euch einen Besuch abstatten."
                                            },
                                            {
                                                "example_id": "e808c314-3755-48dc-b8b4-559b2f28a7fa",
                                                "sense_id": "8dff2120-4a27-38e7-915c-ff83b5aa97dd",
                                                "text": "„Die zweite scheinbare Blamage erlitt Gall bei einem Besuche in einem Gefängnis, wo er in der Kanzlei einen Sträfling nach seiner Schädelform als technisches Genie diagnostiziert hatte.“"
                                            },
                                            {
                                                "example_id": "054831cc-6bc1-4699-a331-a8e440bd6878",
                                                "sense_id": "8dff2120-4a27-38e7-915c-ff83b5aa97dd",
                                                "text": "„Da ich Signora Manzoni noch nicht gesehen hatte, machte ich ihr einen Besuch und fand sie mir gegenüber unverändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a00710f-0a44-3f5a-87a1-2d11b4461456",
                                        "entry_id": "dfa89724-e478-33f0-b5d5-7f3beac9403e",
                                        "glosses": [
                                            "Person oder Personen, die ^([1]) tätigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaddf8dd-4084-4ea7-a4b3-0cf37358dc26",
                                                "sense_id": "0a00710f-0a44-3f5a-87a1-2d11b4461456",
                                                "text": "Euer Besuch hat's ja ziemlich lange ausgehalten."
                                            }
