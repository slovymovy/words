                                        "glosses": [
                                            "A researcher who studies the Berber languages or cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6526c7-a32d-4ec9-b9e1-22124d839566",
                                                "sense_id": "1e7d5e8e-21fa-377c-b672-df832a9b7a84",
                                                "text": "The language is clearly an archaic version of modern Tashelhiyt, and, while sometimes unusual from a southwestern Moroccan perspective, holds little surprises to the Berberologist."
                                            },
                                            {
                                                "example_id": "a1182012-79ee-4c57-97bc-91e5122c4f9e",
                                                "sense_id": "1e7d5e8e-21fa-377c-b672-df832a9b7a84",
                                                "text": "Traditionally, Berberologists regard the functional difference between them as one of status […]"
