{
    "word_family": [
        "clip",
        "clipper",
        "clipping"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4fdcaa6-06ec-32b7-b167-781a76d9b43f",
                    "sense_definition": "Having an end cut off or trimmed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener used <w>clipped</w> hedges to create a neat border around the garden.",
                            "target_lang_translations": {
                                "cs": "Zahradník použil <w>zastřižené</w> živé ploty k vytvoření úhledného lemu kolem zahrady.",
                                "ru": "Садовник использовал <w>подстриженную</w> живую изгородь, чтобы создать аккуратную границу вокруг сада."
                            }
                        },
                        {
                            "text": "The barber swept the <w>clipped</w> hair from the floor.",
                            "target_lang_translations": {
                                "cs": "Holič zametl <w>ostříhané</w> vlasy z podlahy.",
                                "ru": "Парикмахер смет с пола <w>остриженные</w> волосы."
                            }
                        }
                    ],
                    "synonyms": [
                        "trimmed"
                    ],
                    "common_phrases": [
                        "clipped hedge",
                        "clipped wings"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající konec ustřižený nebo zastřižený.",
                        "ru": "Имеющий срезанные или подстриженные края/концы."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zastřižený",
                                "target_lang_sense_clarification": "upravený stříháním (např. živý plot)"
                            },
                            {
                                "target_lang_word": "ostříhaný",
                                "target_lang_sense_clarification": "zkrácený stříháním (např. vlasy)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подстриженный",
                                "target_lang_sense_clarification": "о растениях, волосах или шерсти"
                            },
                            {
                                "target_lang_word": "остриженный",
                                "target_lang_sense_clarification": "о волосах, ногтях"
                            },
                            {
                                "target_lang_word": "подрезанный",
                                "target_lang_sense_clarification": "укороченный срезанием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "655b0419-f009-3feb-ae31-90867482390d",
                    "sense_definition": "Spoken with each word pronounced separately and distinctly, often sounding short or abrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer spoke in a <w>clipped</w> tone that made everyone feel nervous.",
                            "target_lang_translations": {
                                "cs": "Důstojník mluvil <w>úsečným</w> tónem, ze kterého byli všichni nervózní.",
                                "ru": "Офицер говорил <w>отрывистым</w> тоном, который заставил всех занервничать."
                            }
                        },
                        {
                            "text": "He gave a <w>clipped</w> answer and walked away without looking back.",
                            "target_lang_translations": {
                                "cs": "Dal <w>úsečnou</w> odpověď a odešel, aniž by se ohlédl.",
                                "ru": "Он дал <w>отрывистый</w> ответ и ушёл, не оглядываясь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clipped tone",
                        "clipped accent"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvený s každým slovem vysloveným odděleně a zřetelně, často znějící krátce nebo úsečně.",
                        "ru": "Произнесённый отрывисто, с чётким разделением слов, резкий или лаконичный по звучанию."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úsečný",
                                "target_lang_sense_clarification": "stručný a strohý tón řeči"
                            },
                            {
                                "target_lang_word": "trhaný",
                                "target_lang_sense_clarification": "přerušovaný, neplynulý způsob mluvy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отрывистый",
                                "target_lang_sense_clarification": "о тоне, голосе, речи"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "краткий и строгий по манере речи"
                            },
                            {
                                "target_lang_word": "рубленый",
                                "target_lang_sense_clarification": "о фразах или манере говорить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7da9a5c4-1e6d-3bc2-8bc8-cf3fd6b2ea9f",
                    "sense_definition": "Having undergone the surgical removal of the foreskin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ritual ensures the child is <w>clipped</w> according to ancient tradition.",
                            "target_lang_translations": {
                                "cs": "Rituál zajišťuje, že je dítě <w>obřezáno</w> podle starodávné tradice.",
                                "ru": "Ритуал гарантирует, что ребёнок будет <w>обрезан</w> согласно древней традиции."
                            }
                        },
                        {
                            "text": "Medical records noted that the patient was <w>clipped</w> at birth.",
                            "target_lang_translations": {
                                "cs": "Zdravotní záznamy uváděly, že pacient byl <w>obřezán</w> při narození.",
                                "ru": "В медицинских картах было указано, что пациент был <w>обрезан</w> при рождении."
                            }
                        }
                    ],
                    "synonyms": [
                        "circumcised"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal or euphemistic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající chirurgicky odstraněnou předkožku.",
                        "ru": "Обрезанный (подвергшийся хирургическому удалению крайней плоти)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obřezaný",
                                "target_lang_sense_clarification": "po obřízce"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обрезанный",
                                "target_lang_sense_clarification": "прошедший обрезание (разг./жарг.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8927771e-c4e1-3c34-9f34-aded90ac7008",
                    "sense_definition": "Simple past and past participle of <w>clip</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>clipped</w> the coupon from the newspaper before going to the store.",
                            "target_lang_translations": {
                                "cs": "Před odchodem do obchodu si z novin <w>vystřihl</w> kupón.",
                                "ru": "Он <w>вырезал</w> купон из газеты перед тем, как пойти в магазин."
                            }
                        },
                        {
                            "text": "The barber <w>clipped</w> his hair very short for the summer.",
                            "target_lang_translations": {
                                "cs": "Holič mu na léto <w>ostříhal</w> vlasy velmi nakrátko.",
                                "ru": "Парикмахер очень коротко <w>подстриг</w> ему волосы на лето."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clipped off",
                        "clipped together"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa clip (stříhat, přistřihnout).",
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола clip (стричь, вырезать, скреплять)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ustřihl",
                                "target_lang_sense_clarification": "minulý čas slovesa stříhat"
                            },
                            {
                                "target_lang_word": "přistřihl",
                                "target_lang_sense_clarification": "zkrátil stříháním"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вырезал",
                                "target_lang_sense_clarification": "прошедшее время от вырезать (ножницами)"
                            },
                            {
                                "target_lang_word": "подстриг",
                                "target_lang_sense_clarification": "прошедшее время от подстричь"
                            },
                            {
                                "target_lang_word": "скрепил",
                                "target_lang_sense_clarification": "прошедшее время от скрепить скрепкой/зажимом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}