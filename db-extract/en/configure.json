                        "entry_id": "d06cdfd0-2d27-3324-b2d0-fa8422fe08bd",
                        "glosses": [
                            "To set up or arrange something in such a way that it is ready for operation for a particular purpose, or to someone's particular liking"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba9b7de-ef80-4e3f-91df-cc7c0c10637e",
                                "sense_id": "a53145fd-e09f-3fac-8e56-07bfa6081acc",
                                "text": "Users may configure the settings to enhance their experience."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f59f746-9baa-4b13-a7f4-74d5587a1842",
                        "source_entry_id": "d06cdfd0-2d27-3324-b2d0-fa8422fe08bd",
                        "source_sense_id": "a53145fd-e09f-3fac-8e56-07bfa6081acc",
                        "source_sense_description": "to set up or arrange something",
