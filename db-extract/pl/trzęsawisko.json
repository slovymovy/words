                    {
                        "translation_id": "bfff5be9-1ead-4668-bedf-2375b46a8353",
                        "source_entry_id": "328d411e-7fb0-3704-96e3-aa9e46afdd64",
                        "source_sense_id": "52e5d374-e35c-39ca-9a3c-280bca9337d4",
                        "target_lang_word": "Moor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                        "entry_id": "459f0c30-9f1a-35f7-9d2a-4b187123aaca",
                                        "glosses": [
                                            "Sumpf, dessen Grund aus Torf besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63964f3-a41e-4fb0-bba7-8af67467f0dc",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "Moore trockenzulegen ist aus heutiger Sicht ein großer Fehler gewesen."
                                            },
                                            {
                                                "example_id": "aff9c147-91e4-4eef-98c6-859b5f9e8acb",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Die Pflanzen und Tiere, die im Moor leben, haben sich auf diesen besonderen Le- bensraum spezialisiert. Wenn es das Moor nicht mehr gibt, werden viele Pflanzen und Tiere aussterben.“"
                                            },
                                            {
                                                "example_id": "02def2d8-03c1-470b-855c-3f0950734275",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„[…] aus trockenen Mooren und solchen, in denen Torf abgebaut wird, entweichen jährlich Millionen Tonnen CO2.“"
                                            },
                                            {
                                                "example_id": "3ae6fb42-4685-4807-8f08-12e2bf555f94",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Wichtige Moor-Grundstücke wurden schon in den Siebzigerjahren aufgekauft, es wurden Dämme errichtet, Wasser wurde gestaut, das Moor wiedervernässt.“"
                                            },
                                            {
                                                "example_id": "82874d66-d64f-4329-bf3a-887634436346",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„[…] der Umweltminister weiß auch, dass Versprechen und das Werben der Naturschutzbehörden für den Schutz der Moore allzu oft völlig wirkungslos bleiben.“"
                                            },
                                            {
                                                "example_id": "99b4f4e6-ab2f-45be-9b76-880b3ce94658",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Dann rennen fast alle Frauen ins Moor hinaus, um sich irgendwo im Buschwerk zu verstecken.“"
                                            },
                                            {
                                                "example_id": "5b2a2731-5189-47de-b467-333300f37f43",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Kurz vor dem winzigen Bad Salomonsbrunn (Bagni di Salomone) führt die Straße durch ein verlandetes Moor, die Rasner Möser.“"
                                            },
                                            {
                                                "example_id": "6c8ca6b9-1786-4245-98a3-c4bd1f1740e3",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Moore sind wertvolle Lebensräume für seltene Tiere und Pflanzen und speichern viel ⁠CO2⁠.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65059efe-1afc-316c-a3e9-8d6c2ebe805b",
                                        "entry_id": "459f0c30-9f1a-35f7-9d2a-4b187123aaca",
                                        "glosses": [
                                            "Torfschlamm für Heilzwecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4152bbee-654c-4753-b811-f98d44943192",
                                                "sense_id": "65059efe-1afc-316c-a3e9-8d6c2ebe805b",
                                                "text": "Sie ließ sich Bäder aus Moor verschreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc5fd261-1489-4fb4-a4c6-0bc70900757d",
                        "source_entry_id": "328d411e-7fb0-3704-96e3-aa9e46afdd64",
                        "source_sense_id": "52e5d374-e35c-39ca-9a3c-280bca9337d4",
                        "target_lang_word": "Sumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                        "entry_id": "900f99bb-b52f-334f-a81c-2c54c9036b19",
                                        "glosses": [
                                            "flache, stehende Wasserfläche mit Vegetation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60aeb60e-b88c-4920-aac2-67e3a217007c",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "Durch den Bau des Wasserkraftwerks trocknete der am unteren Flusslauf gelegene Sumpf vollständig aus, wodurch viele geschützte Arten zugrunde gingen."
                                            },
                                            {
                                                "example_id": "0feea7bf-57df-426e-a5be-354eb659b4c2",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "Als wir des Nachts durch den Sumpf wateten, konnten wir wegen des starken Nebels die Sterne nicht mehr erkennen."
                                            },
                                            {
                                                "example_id": "41ad5724-95d1-4fde-891d-b6766e9f9a4e",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "„Hier wird der Sumpf flacher, weniger Moosblüten, mehr Weidengestrüpp.“"
                                            },
                                            {
                                                "example_id": "ed5b5097-8e65-4dfc-a266-41502e383743",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "„Phil Graham, später der große Mann hinter der Washington Post, wuchs auf einem Wohnboot in den Sümpfen der Everglades auf.“"
                                            },
                                            {
                                                "example_id": "bbb6f528-8b90-452a-8e4a-85fee6bc2f59",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "„Im Westen stand die Sonne schon tief über dem Sumpf, doch bis die Dunkelheit anbrach, konnten sie noch mit zwei Stunden Helligkeit rechnen.“"
                                            },
                                            {
                                                "example_id": "a2b9a3af-a97f-4a5c-85b6-1d00a7a78fba",
                                                "sense_id": "6ca262a3-1b0f-3370-9936-15728e8bee5b",
                                                "text": "„In dem schmalen Raum zwischen Plateau und blasser werdenden Sternen schien der Tag aus den Sümpfen zu steigen, schälte die schwarzen Silhouetten der Moorbirken, Weiden und Ebereschen aus dem blasser werdenden Nachblau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a536cb9a-6f08-3c26-a2f9-eeb36702082c",
                                        "entry_id": "900f99bb-b52f-334f-a81c-2c54c9036b19",
                                        "glosses": [
                                            "tiefster Teil eines Schachtes, in dem sich Grubenwasser ansammelt"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
