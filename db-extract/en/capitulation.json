                    {
                        "translation_id": "495956e8-676f-492a-9e06-c92b4bb34b9e",
                        "source_entry_id": "0de01737-dc13-3e03-9b8a-6ea869e7ea8b",
                        "source_sense_description": "surrender to an enemy",
                        "target_lang_word": "капитуля́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "капитуля́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d1800a3c-827d-33ba-9086-16911bb4d03d",
                                        "entry_id": "3f3e2d44-1bcc-34ac-9f02-52facb906306",
                                        "glosses": [
                                            "воен. прекращение военных действий одной из противоборствующих сторон и сдача победителю на условиях, им предъявленных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7789371e-f171-474d-87d2-a2141cc07e3f",
                                                "sense_id": "d1800a3c-827d-33ba-9086-16911bb4d03d",
                                                "text": "Из-под Митавы Пётр отправил к крепости Боуск бомбардирского капитан-поручика Керхина и полковника Балка с двумя пехотными и одним драгунским полками, предписав первому, в случае сильной обороны, уговаривать к сдаче на капитуляцию; в противном случае — на дискрецию etc."
                                            },
                                            {
                                                "example_id": "70df023f-a54b-4c98-84d5-bdaea85b0c3e",
                                                "sense_id": "d1800a3c-827d-33ba-9086-16911bb4d03d",
                                                "text": "Ожидания Кутузова сбылись как относительно того, что предложения капитуляции, ни к чему не обязывающие, могли дать время пройти некоторой части обозов, так и относительно того, что ошибка Мюрата должна была открыться очень скоро."
                                            },
                                            {
                                                "example_id": "8f025478-46d0-46ea-91af-992e5063f7da",
                                                "sense_id": "d1800a3c-827d-33ba-9086-16911bb4d03d",
                                                "text": "Главнокомандующий Вооружёнными силами на юге России мог бы согласиться на прекращение гражданской войны на этих условиях, но оно было бы ему абсолютно неприемлемо в форме капитуляции перед советской Россией."
                                            },
                                            {
                                                "example_id": "221c270e-62f5-4b58-99a5-138752c1803a",
                                                "sense_id": "d1800a3c-827d-33ba-9086-16911bb4d03d",
                                                "text": "— Мои друзья на родине считают — и я разделяю их точку зрения полностью, — что скорейшая капитуляция всех немецких армий и ликвидация всех частей СС спасёт миллионы жизней."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86bb8675-d58d-3181-892d-6a02c374ea7c",
                                        "entry_id": "3f3e2d44-1bcc-34ac-9f02-52facb906306",
                                        "glosses": [
                                            "перен. отказ от дальнейшей борьбы с кем-либо, чем-либо, сдача своих позиций, признание своего бессилия в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b9dc71-e5cd-4d9b-962d-ca54c3467c76",
                                                "sense_id": "86bb8675-d58d-3181-892d-6a02c374ea7c",
                                                "text": "— Нет и не может быть таких условий, которые заставили бы нас пойти на соглашение… — Что же это такое — капитуляция? — я спрашиваю."
                                            },
                                            {
                                                "example_id": "57c8cfcf-bfca-40fa-a002-172116bfe78f",
                                                "sense_id": "86bb8675-d58d-3181-892d-6a02c374ea7c",
                                                "text": "Эта благотворная диверсия разом решила дело в нашу пользу; Балалайкин сейчас же сдался на капитуляцию, выговорив, впрочем, в свою пользу шестьсот рублей, которые противная сторона обязывалась выдать в том случае, ежели возникнет судебное разбирательство."
                                            },
                                            {
                                                "example_id": "9ee757be-53f1-4478-b4c1-270c1712ac1b",
                                                "sense_id": "86bb8675-d58d-3181-892d-6a02c374ea7c",
                                                "text": "Итак, уездная оппозиция сдалась на капитуляцию… Уже до своей поездки губернатор понемногу вводил «своих людей», которые занимали позиции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
