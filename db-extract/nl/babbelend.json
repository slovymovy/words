            {
                "entry_id": "6f297b6c-21e3-3c6d-ba26-d3fdebfe74d2",
                "word": "babbelend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e80de0c8-9c33-3077-af59-789fe878b245",
                        "entry_id": "6f297b6c-21e3-3c6d-ba26-d3fdebfe74d2",
                        "glosses": [
                            "zonder veel nadenkend pratend en keuvelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c500db6c-e848-4b4a-ac9e-f6e79c57e975",
                                "sense_id": "e80de0c8-9c33-3077-af59-789fe878b245",
                                "text": "Schijnbaar ontspannen nippend van een grote mok thee bleek Adele (28) nog steeds het vrolijk babbelende buurmeisje en de als een misthoorn galmende diva in één."
                            },
                            {
                                "example_id": "82a6dcae-2bd1-46b8-a672-eccebee0b484",
                                "sense_id": "e80de0c8-9c33-3077-af59-789fe878b245",
                                "text": "Volgens Cobelens komt 60 procent van de informatie die wordt gebruikt voor inlichtingendoeleinden, uit het openbaar domein. Hij wijst daarbij op het 'babbelende, twitterende, facebookende, hyvende en bloggende individu' dat zelf van alles naar buiten brengt zonder erbij stil te staan dat het kan worden gebruikt."
                            },
                            {
                                "example_id": "7458f1d1-7fef-420b-ad1a-fa0f6d544d50",
                                "sense_id": "e80de0c8-9c33-3077-af59-789fe878b245",
                                "text": "De vlot babbelende docent bloemsierkunst van AOC Oost in Almelo geeft deze museummiddag in Ootmarsum uitleg over de adventstijd en de gebruiken die daarbij passen."
                            }
                        ]
                    }
