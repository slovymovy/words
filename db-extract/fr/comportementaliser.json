                "senses": [
                    {
                        "sense_id": "3c27679e-2655-3c5a-bc58-41c196f80904",
                        "entry_id": "981f0d34-e24a-3ec2-be09-6181a6e10d10",
                        "glosses": [
                            "Considérer d’un point de vue purement comportemental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc12c2b6-3fb9-4c6c-a957-99da8c27f1e8",
                                "sense_id": "3c27679e-2655-3c5a-bc58-41c196f80904",
                                "text": "Tel qu'il est devenu, tel qu'ils se le sont taillé sur mesure pour médicaliser l'existence, paramédicaliser, comportementaliser et cognitiviser le psychisme, le titre de psychothérapeute d’État est-il si enviable ?"
                            },
                            {
                                "example_id": "79e0bb42-9d6a-41e6-9b2b-e4c41ffc56be",
                                "sense_id": "3c27679e-2655-3c5a-bc58-41c196f80904",
                                "text": "Donc, si l'on veut se protéger des fuites, c'est l'Exécutif que l'on devrait comportementaliser, non pas le Congrès des Etats-Unis."
                            },
                            {
                                "example_id": "47ddd8c9-16e9-405a-a224-6f716e4a0fe2",
                                "sense_id": "3c27679e-2655-3c5a-bc58-41c196f80904",
                                "text": "Empêcher que les enfants deviennent des objets à rafistoler, prothétiser, rééduquer, bien comportementaliser."
                            }
                        ]
                    }
                ],
