                "senses": [
                    {
                        "sense_id": "14165dc7-a111-3153-af58-0fe228be4e5a",
                        "entry_id": "0ddca237-d2cc-3a14-81ff-4c5b1fb42f43",
                        "glosses": [
                            "Bereich, innerhalb dessen jemand (z. B. beruflich) wirkt, Tätigkeiten ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a27ec9-46cb-4779-a574-996b658fb931",
                                "sense_id": "14165dc7-a111-3153-af58-0fe228be4e5a",
                                "text": "Im Laufe der Jahre hat sich mein Wirkungsbereich in der Firma stetig erweitert."
                            },
                            {
                                "example_id": "f7ca5e86-0722-4bc4-9ab3-edc9d5e4fcd3",
                                "sense_id": "14165dc7-a111-3153-af58-0fe228be4e5a",
                                "text": "„Der Wirkungsbereich von Feldwebel Bieselang – seit zwei Jahren verwitwet, Vater einer mannbaren, außerordentlich hübschen Tochter – lag 95 Kilometer nordwestlich von der Reichshauptstadt Berlin, nahe dem Ort Wittstock an der Dosse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
