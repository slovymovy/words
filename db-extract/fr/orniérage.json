                        "sense_id": "21ef1561-041a-36c2-b67f-6988a2855452",
                        "entry_id": "61022db7-611f-3189-8d61-a0a70cd724fb",
                        "glosses": [
                            "Propension à former, formation des ornières."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8a88a3-f03d-4f5f-924a-5f1099ee2352",
                                "sense_id": "21ef1561-041a-36c2-b67f-6988a2855452",
                                "text": "D'ailleurs FRANCKEN indique que lorsque le mastic d'un béton bitumineux Cᵥ passe de 0,53 à 0,26, l’orniérage, toutes choses égales par ailleurs, du béton bitumineux augmente de 72%."
                            },
                            {
                                "example_id": "72d8fdb6-c775-4b40-829b-afaa31360911",
                                "sense_id": "21ef1561-041a-36c2-b67f-6988a2855452",
                                "text": "À l’inverse, des trafics lourds et lents ainsi que des hautes températures peuvent nécessiter l’emploi de bitumes durs qui rigidifient l’enrobé et diminuent ainsi les problèmes d’orniérage."
                            },
                            {
                                "example_id": "c92e0054-4e8a-4ad8-b9ca-23129183d8a4",
                                "sense_id": "21ef1561-041a-36c2-b67f-6988a2855452",
                                "text": "Nous commençons donc par dresser l’état des connaissances sur les mécanismes de tassement et orniérage et sur la restauration des sols."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d7635e3-04dc-319e-b839-cbd31d284aa3",
                        "entry_id": "61022db7-611f-3189-8d61-a0a70cd724fb",
                        "glosses": [
                            "Ensemble des ornières d'une voie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "148e9fd9-ff53-4139-8e24-526b67564bf3",
                                "sense_id": "0d7635e3-04dc-319e-b839-cbd31d284aa3",
                                "text": "Gêné par les projections d’eau du poids lourd consécutives à un fort orniérage de la chaussée, il freine pour revenir sur la voie de droite à l’arrière du poids lourd."
                            }
                        ]
                    }
