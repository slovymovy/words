                ],
                "senses": [
                    {
                        "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                        "entry_id": "d0a200f8-55d1-3b95-9262-f8597b68eb02",
                        "glosses": [
                            "fachlich durchgeführte Untersuchung und Auswertung des Bewegungsablaufs beim Laufen, meist zur Verbesserung der Lauftechnik oder zur Ableitung individueller Trainingsempfehlungen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "639a643c-d726-40f9-ab83-7972d8c3175a",
                                "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                                "text": "„Aus meiner langjährigen Trainererfahrung weiß ich, dass eine Lauftechnikanalyse nicht sehr zielführend ist, wenn die entsprechenden Übungen dann nicht durchgeführt werden.“"
                            },
                            {
                                "example_id": "153911c9-d4a1-40c0-970b-bd7ca54c3192",
                                "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                                "text": "„Und wenn Du eine Frau/ein Mann der Tat bist, dann buche direkt ein Personal Training, eine Lauftechnikanalyse mit anschließenden Trainingstipps oder eines meiner Gruppenangebote.“"
                            },
                            {
                                "example_id": "b596ca6d-bd2b-4398-8eec-d4b5de61a726",
                                "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                                "text": "„Gezielt für LäuferInnen [sic] bieten wir auch Lauftechnikanalyse und Lauftechnik bzw. Koordinationstraining an.“"
                            },
                            {
                                "example_id": "5237a57a-70b7-4dce-8ab3-aee16d716ff1",
                                "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                                "text": "„Unter idealen Bedingungen führt Hahn-Training-Systems TM Leistungsdiagnostiken, Bike-Fit Vermessungen und Lauftechnikanalysen bei Kunden durch, ohne dass diese mit ihrem Fahrrad anreisen müssen.“"
                            },
                            {
                                "example_id": "0448f531-f5c2-4656-84d0-95edc3fbb882",
                                "sense_id": "aea5464d-b33c-32e7-a115-43cf9d8cda09",
                                "text": "„Gleichzeitig kann die Firma im mobilen Diagnostiktrailer bei der Laufdiagnostik die Lauftechnikanalyse durchführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
