                                                "example_id": "c805325f-2bd0-4000-9d4f-ceac8d34b3db",
                                                "sense_id": "60399f33-404a-3b74-b440-ca83e632a16c",
                                                "text": "We used to brew a tonic from a particular kind of root."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8b959d-2846-365b-b0fd-1e0446a4de3d",
                                        "entry_id": "59eb3c71-e83b-3a76-96ab-4731a6d1abe8",
                                        "glosses": [
                                            "Tonic water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d8f5c86-8f56-3f38-a508-ab633076828d",
                                        "entry_id": "59eb3c71-e83b-3a76-96ab-4731a6d1abe8",
                                        "glosses": [
                                            "Any of various carbonated, non-alcoholic beverages; soda pop."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e436e86d-aa44-324a-88b4-8fe03fc349a6",
                                        "entry_id": "59eb3c71-e83b-3a76-96ab-4731a6d1abe8",
                                        "glosses": [
                                            "Someone or something that revitalises or reinvigorates."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4df8855-cf3f-4405-8787-9f31bdc50aad",
                                                "sense_id": "e436e86d-aa44-324a-88b4-8fe03fc349a6",
                                                "text": "'You're a tonic, Dee,' she said. 'And a real friend. Thanks.'"
                                            },
                                            {
                                                "example_id": "2819fd93-34e6-4a7f-b23b-d914e13753e8",
                                                "sense_id": "e436e86d-aa44-324a-88b4-8fe03fc349a6",
                                                "text": "The result is the perfect tonic for Newcastle, coming at the end of a week that saw the departure of Andy Carroll to Liverpool on Monday and an injury to Shola Ameobi during Wednesday's defeat at Fulham."
                                            },
                                            {
                                                "example_id": "a6ab225a-c1a8-4a79-8a78-b0e3180794a1",
                                                "sense_id": "e436e86d-aa44-324a-88b4-8fe03fc349a6",
                                                "text": "Charlie ain't no Nazi / She likes to wear her leather boots / 'Cause it's exciting for the veterans / And it's a tonic for the troops."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cfe2f6d-c7cd-363e-a6ed-84ddcb051abf",
                                        "entry_id": "b1865230-1f18-3ac2-8c92-9a9004558c3b",
                                        "glosses": [
                                            "To restore or invigorate."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "660a5c1e-a7f6-4cd3-a4db-9c3ee6390ba9",
                                                "sense_id": "7cfe2f6d-c7cd-363e-a6ed-84ddcb051abf",
                                                "text": "When all signs of effusion, dulness, pain, œgophony, and cough had disappeared he was dieted, stimulated, and tonicked."
                                            },
                                            {
                                                "example_id": "f0420062-f3bc-47ae-90c4-67952ee7e3e1",
                                                "sense_id": "7cfe2f6d-c7cd-363e-a6ed-84ddcb051abf",
                                                "text": "The Persians, as a nation, were first to discover that fish were edible. The time is fixed at about 3000 B.C. This was their secret for some centuries—until the Assyrians learned about the elegance of fish for tonicking the brain."
                                            }
                                        ]
                                    }
                                ]
                            },
