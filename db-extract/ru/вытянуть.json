                        "examples": [
                            {
                                "example_id": "9369b8ee-694a-4ec5-9b3c-57b06c5e2e16",
                                "sense_id": "f2b957c2-3654-39bd-ac76-ce5308c420e1",
                                "text": "Председатель ничего не сказал и вышел. Он был сильно расстроен и, забравшись в двуколку, со злостью вытянул лошадь кнутом. Непривычная к подобному обращению, лошадь на миг замерла и даже как бы присела, а потом рванула и понесла, едва не опрокинув двуколку."
                            }
                        ]
