                "senses": [
                    {
                        "sense_id": "4bfeec83-247a-3d38-9ff1-64041cbff7ac",
                        "entry_id": "cf3dd006-63e2-3882-bf91-a8e87b930d9d",
                        "glosses": [
                            "„unerwünschte und unangemessene Verhaltensauffälligkeiten, die überwiegend aus dem Schlaf heraus auftreten“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb28708d-09e1-4f7e-a1e7-2bce13407e3a",
                                "sense_id": "4bfeec83-247a-3d38-9ff1-64041cbff7ac",
                                "text": "„Talia leidet unter Parasomnie, sie schlafwandelt nicht nur und schreckt nachts abrupt hoch, sie hat sich durch den Verlust ihrer Mutter auch einen Schutz aufgebaut, verdrängt alles Traumatische, ersetzt es durch ihre eigene Fiktion.“"
                            },
                            {
                                "example_id": "03185847-638d-489a-804a-0a2f62638f56",
                                "sense_id": "4bfeec83-247a-3d38-9ff1-64041cbff7ac",
                                "text": "„Daneben, das wird nicht immer exakt getrennt, leidet das Mädchen an Parasomnie, das heisst, sie erwacht abrupt aus Albträumen, schlafwandelt.“"
                            },
                            {
                                "example_id": "fa6f1955-d488-4447-8dc1-c37b99fff301",
                                "sense_id": "4bfeec83-247a-3d38-9ff1-64041cbff7ac",
                                "text": "„Diese ungewöhnliche, aber durchaus gefährliche Art der Parasomnie kommt Schätzungen zufolge bei rund 0,4 Prozent der Gesamtbevölkerung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
