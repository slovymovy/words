                                                "sense_id": "39df6844-015a-3317-a0e2-ca81d2b1afc1",
                                                "text": "Tante Agathe verwässert den Kaffee immer so sehr, dass er fast nach gar nichts schmeckt."
                                            },
                                            {
                                                "example_id": "4efffc57-ef83-4b29-9cb8-b98d3a1a0995",
                                                "sense_id": "39df6844-015a-3317-a0e2-ca81d2b1afc1",
                                                "text": "Hast du schon wieder den Wein verwässert?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4de93c61-1f70-3456-a8b5-432237ac70ab",
                                        "entry_id": "3f316c60-4899-34a2-9161-448be0ed35fe",
                                        "glosses": [
                                            "wässrig werden, einen zu hohen Wasseranteil bekommen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca71e46-ba0b-4ed9-926c-cb43d5e9f768",
                                                "sense_id": "4de93c61-1f70-3456-a8b5-432237ac70ab",
                                                "text": "Du musst den Wasserhahn zudrehen, sonst verwässert dein Blumenwasser ja viel zu sehr und der Düngeranteil wird zu gering."
                                            },
                                            {
                                                "example_id": "1fac7fa2-78c1-4c44-926b-984b8e70c2d7",
                                                "sense_id": "4de93c61-1f70-3456-a8b5-432237ac70ab",
                                                "text": "Nachdem die geernteten Äpfel zu lange nicht verarbeitet wurden, sind sie mit der Zeit total verwässert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fbf59a5a-ab30-3954-b5e9-9c52a64ba561",
                                        "entry_id": "3f316c60-4899-34a2-9161-448be0ed35fe",
                                        "glosses": [
                                            "den Inhalt, die Wirkungs- oder Aussagekraft von etwas abschwächen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e2219b-2ccb-4228-895c-ac903f27dadb",
                                                "sense_id": "fbf59a5a-ab30-3954-b5e9-9c52a64ba561",
                                                "text": "„Die Trennungslinie zwischen Staat und Kirche wird verwässert.“"
                                            },
                                            {
                                                "example_id": "6e113cf8-eeaf-4c2c-8a6f-58ca93a3ac3d",
                                                "sense_id": "fbf59a5a-ab30-3954-b5e9-9c52a64ba561",
                                                "text": "„Das Sparpaket war nach der Beschlussfassung zunächst verwässert, anschließend aber wieder verschärft worden.“"
                                            },
                                            {
                                                "example_id": "f8562e69-57fc-4967-b5d5-0646befad864",
                                                "sense_id": "fbf59a5a-ab30-3954-b5e9-9c52a64ba561",
                                                "text": "„Weder wird der Bestand der Mitgliedschaft oder die Mitgliedschaft als relevantes Beteiligungsrecht berührt, noch der Vermögenswert der Beteiligung verwässert“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
