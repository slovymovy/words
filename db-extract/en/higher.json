                ],
                "senses": [
                    {
                        "sense_id": "567227fc-e844-35d9-b26b-ac28949ca6fd",
                        "entry_id": "091527f6-e778-3804-83ab-6bf503c58dcd",
                        "glosses": [
                            "To make higher; to raise or increase in amount or quantity."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "757a5c53-0f7d-43cd-aa11-09cffeb9236f",
                                "sense_id": "567227fc-e844-35d9-b26b-ac28949ca6fd",
                                "text": "It is a fact that other countries have not followed our example, nay, that they have in fact, in some cases, highered the duties upon the admission of our goods. But what has been the result of that policy upon the amount of your exports?"
                            },
                            {
                                "example_id": "daf205a4-1459-461a-95d0-f6bdcc4c4a33",
                                "sense_id": "567227fc-e844-35d9-b26b-ac28949ca6fd",
                                "text": "I am glad also that my hon. friend the Minister of Finance had the firmness to oppose all these influences to make him change his policy, and I hope, for the good of the country and the blessing of the Dominion, that when any change takes place it will be in the direction of lowering rather than of highering the tariff."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ac942c4-70ea-3850-b439-4cb85edcf162",
                        "entry_id": "091527f6-e778-3804-83ab-6bf503c58dcd",
                        "glosses": [
                            "To ascend."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
