                                "target_word": "décembriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1daa4d94-522f-3d89-ac07-0305967f7dce",
                                        "entry_id": "da46ac80-dc5a-36f9-b6e8-66f9856edbcc",
                                        "glosses": [
                                            "Mutin de la révolte du 14 décembre 1825 (Calendrier julien), lors du couronnement du tsar Nicolas Iᵉʳ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc66e3bb-4f1b-4891-83dc-fdc924c58ab2",
                                                "sense_id": "1daa4d94-522f-3d89-ac07-0305967f7dce",
                                                "text": "Cette première révolte, qui porte le nom du soulèvement des décembristes ou dékabristes, ouvre une ère nouvelle dans la russie impériale. Son échec est engendré par son impréparation, sa spontanéïté, nous dirions presque son innocence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
