                                "example_id": "0f2d4f66-7e28-4de4-a902-fa228408e8b7",
                                "sense_id": "939c684f-7fdf-3201-80b4-258133f13f9b",
                                "text": "„Blitze zuckten, erleuchteten mit grellem Stroboskop-Glanz eine dicht wuchernde Dschungellandschaft.“"
                            },
                            {
                                "example_id": "a5684df6-cbd8-42d4-934a-3ea0b3ce5711",
                                "sense_id": "939c684f-7fdf-3201-80b4-258133f13f9b",
                                "text": "„Fitzroy nahm einen Schluck, hob sein Glas dann zum Balkon hinter seinem Rücken und wies damit auf die Dschungellandschaft am östlichen Meeresufer.“"
                            }
