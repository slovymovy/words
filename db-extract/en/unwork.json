                                "example_id": "a1d5b219-9fa8-42a7-b87e-4e4cbd8e0c0d",
                                "sense_id": "f1fcb885-da84-3e91-bf21-98f2efe0938e",
                                "text": "That comfortable philosophy which modern transcendentalism has but dimly shadowed forth — that poetic agrarianism, which gives all to each and each to all— is the real life of this city of unwork."
                            },
                            {
                                "example_id": "74a4bdff-aef2-411d-adbd-831e8f0d483c",
                                "sense_id": "f1fcb885-da84-3e91-bf21-98f2efe0938e",
                                "text": "Collective bargaining has a crisis of \"unwork\" — that is, work which Justice Douglas once called \"unwanted . . . totally useless.\" So much \"unwork\" clutters the table that collective bargaining is no longer able to do what it should: […]"
                            }
                        ]
                    }
