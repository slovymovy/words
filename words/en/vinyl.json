{
    "word_family": [
        "polyvinyl"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11c84200-f634-3673-8303-abb1ffe8aab1",
                    "sense_definition": "Any of various compounds and substances containing the vinyl radical, especially various tough, flexible, shiny plastics.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen floor was covered in cheap <w>vinyl</w> that was easy to clean.",
                            "target_lang_translations": {
                                "ru": "Пол на кухне был покрыт дешевым <w>винилом</w>, который легко мыть.",
                                "zh": "厨房地板铺着一层容易清洁的廉价<w>乙烯基塑料</w>。"
                            }
                        },
                        {
                            "text": "She wore a shiny black <w>vinyl</w> coat to the party last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером она надела на вечеринку блестящее черное пальто из <w>винила</w>.",
                                "zh": "昨晚她穿着一件闪亮的黑色<w>乙烯基</w>外套去参加派对。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vinyl flooring",
                        "vinyl siding",
                        "vinyl seat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных соединений и веществ, содержащих виниловый радикал, особенно различные прочные, гибкие, блестящие пластмассы.",
                        "zh": "指含有乙烯基的各种化合物和物质，尤指坚韧、柔韧且有光泽的塑料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́л",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "поливинилхлори́д",
                                "target_lang_sense_clarification": "полное название материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乙烯基塑料",
                                "target_lang_sense_clarification": "作为材料的塑料"
                            },
                            {
                                "target_lang_word": "聚氯乙烯",
                                "target_lang_sense_clarification": "材料的化学名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4a9706e-8581-32d3-a8f6-22c31099fbd3",
                    "sense_definition": "Phonograph records as a medium.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many professional DJs still prefer <w>vinyl</w> to digital formats for mixing music.",
                            "target_lang_translations": {
                                "ru": "Многие профессиональные диджеи для сведения музыки до сих пор предпочитают <w>винил</w> цифровым форматам.",
                                "zh": "许多专业DJ在混音时仍然更喜欢<w>黑胶</w>而非数字格式。"
                            }
                        },
                        {
                            "text": "The band decided to release their new album on <w>vinyl</w> as well as streaming.",
                            "target_lang_translations": {
                                "ru": "Группа решила выпустить свой новый альбом как на <w>виниле</w>, так и на стриминговых сервисах.",
                                "zh": "乐队决定除了流媒体外，还要发行新专辑的<w>黑胶</w>版本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on vinyl",
                        "vinyl collection",
                        "vinyl record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грампластинки как носитель информации.",
                        "zh": "作为音乐媒介的唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́л",
                                "target_lang_sense_clarification": "носитель звука"
                            },
                            {
                                "target_lang_word": "грампласти́нки",
                                "target_lang_sense_clarification": "собирательное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑胶",
                                "target_lang_sense_clarification": "作为音乐媒介"
                            },
                            {
                                "target_lang_word": "唱片",
                                "target_lang_sense_clarification": "指代音乐载体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc70a44a-f7b2-3d1d-85b4-3f06d6887ef6",
                    "sense_definition": "A phonograph record.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon flipping through old <w>vinyls</w> at the local music shop.",
                            "target_lang_translations": {
                                "ru": "Он провел день, перебирая старые <w>пластинки</w> в местном музыкальном магазине.",
                                "zh": "他花了一下午在当地的唱片店里翻找旧的<w>黑胶唱片</w>。"
                            }
                        },
                        {
                            "text": "I bought a rare <w>vinyl</w> of a jazz concert from the fifties.",
                            "target_lang_translations": {
                                "ru": "Я купил редкую <w>виниловую пластинку</w> с записью джазового концерта пятидесятых годов.",
                                "zh": "我买了一张五十年代爵士音乐会的珍稀<w>黑胶唱片</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Граммофонная пластинка.",
                        "zh": "一张唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́ловая пласти́нка",
                                "target_lang_sense_clarification": "предмет"
                            },
                            {
                                "target_lang_word": "пласти́нка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑胶唱片",
                                "target_lang_sense_clarification": "具体的唱片实体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f0bdfc5-16f2-35f1-ada0-19e151b8bdc2",
                    "sense_definition": "The univalent radical CH₂=CH−, derived from <w>ethylene</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vinyl</w> group is a fundamental component in the synthesis of many polymers.",
                            "target_lang_translations": {
                                "ru": "<w>Виниловая</w> группа является фундаментальным компонентом в синтезе многих полимеров.",
                                "zh": "<w>乙烯基</w>是合成许多聚合物的基本成分。"
                            }
                        },
                        {
                            "text": "Chemists study how the <w>vinyl</w> radical reacts with other organic compounds.",
                            "target_lang_translations": {
                                "ru": "Химики изучают, как радикал <w>винила</w> реагирует с другими органическими соединениями.",
                                "zh": "化学家们研究<w>乙烯基</w>自由基如何与其他有机化合物发生反应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ethenyl"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одновалентный радикал CH₂=CH−, производное этилена.",
                        "zh": "由乙烯衍生出的单价基团 CH₂=CH−。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́л",
                                "target_lang_sense_clarification": "химический радикал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乙烯基",
                                "target_lang_sense_clarification": "化学基团"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c3ef323-0256-32df-8e6e-8b6d1b0834ac",
                    "sense_definition": "Made of polyvinyl chloride.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to install <w>vinyl</w> windows because they are durable and energy efficient.",
                            "target_lang_translations": {
                                "ru": "Мы решили установить <w>виниловые</w> окна, потому что они долговечны и энергоэффективны.",
                                "zh": "我们决定安装<w>乙烯基</w>窗户，因为它们耐用且节能。"
                            }
                        },
                        {
                            "text": "The old diner had red <w>vinyl</w> booths that stuck to your legs in summer.",
                            "target_lang_translations": {
                                "ru": "В старой закусочной были красные <w>виниловые</w> кабинки, которые летом прилипали к ногам.",
                                "zh": "那家老餐馆里有红色的<w>乙烯基</w>卡座，夏天坐上去会粘在腿上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vinyl gloves",
                        "vinyl stickers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из поливинилхлорида.",
                        "zh": "由聚氯乙烯制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́ловый",
                                "target_lang_sense_clarification": "сделанный из винила"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乙烯基的",
                                "target_lang_sense_clarification": "形容词，指材料成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d32444-99c9-36dc-aa69-6ad387782bb6",
                    "sense_definition": "Pertaining to a phonograph record.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is trying to complete his <w>vinyl</w> collection of classic rock albums.",
                            "target_lang_translations": {
                                "ru": "Он пытается собрать полную <w>виниловую</w> коллекцию классических рок-альбомов.",
                                "zh": "他正试图补齐他的经典摇滚<w>黑胶</w>唱片收藏。"
                            }
                        },
                        {
                            "text": "The store specializes in <w>vinyl</w> releases from independent music labels.",
                            "target_lang_translations": {
                                "ru": "Магазин специализируется на <w>виниловых</w> релизах независимых музыкальных лейблов.",
                                "zh": "这家店专门销售独立音乐厂牌发行的<w>黑胶</w>唱片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vinyl release",
                        "vinyl album"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грампластинкам.",
                        "zh": "与唱片相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́ловый",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑胶的",
                                "target_lang_sense_clarification": "形容词，指音乐载体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53d4b079-3206-39ff-96ba-f4b4b8f4e73a",
                    "sense_definition": "Containing the vinyl radical.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>vinyl</w> polymer exhibits excellent resistance to moisture and chemicals.",
                            "target_lang_translations": {
                                "ru": "Этот <w>виниловый</w> полимер демонстрирует отличную устойчивость к влаге и химикатам.",
                                "zh": "这种<w>乙烯基</w>聚合物表现出极佳的防潮和抗化学腐蚀性能。"
                            }
                        },
                        {
                            "text": "The experiment required a specific <w>vinyl</w> compound to initiate the reaction.",
                            "target_lang_translations": {
                                "ru": "Для эксперимента требовалось специфическое <w>виниловое</w> соединение, чтобы инициировать реакцию.",
                                "zh": "实验需要一种特定的<w>乙烯基</w>化合物来引发反应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vinylic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий виниловый радикал.",
                        "zh": "含有乙烯基的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вини́ловый",
                                "target_lang_sense_clarification": "химический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乙烯基的",
                                "target_lang_sense_clarification": "形容词，指化学性质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
