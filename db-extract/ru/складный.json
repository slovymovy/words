        "ru-extract.jsonl": [
            {
                "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                "word": "складный",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "729668e2-e005-3dc4-b952-c54e36cc8b64",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "хорошо сложенный, статный, стройный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc260533-6d47-441a-9cf8-982f49a43bdf",
                                "sense_id": "729668e2-e005-3dc4-b952-c54e36cc8b64",
                                "text": "Ты всем взяла: и ростом, и дородством, И поступью, и уж складна, бог дал."
                            },
                            {
                                "example_id": "38c759e2-391f-4800-8a69-e64a3506b755",
                                "sense_id": "729668e2-e005-3dc4-b952-c54e36cc8b64",
                                "text": "Кони у обоих казаков были складные, с хорошим экстерьером."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d56fb35-ea05-3097-95dd-d0587cf5c417",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "(о речи) связный, гладкий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c962cc-30ab-4959-8148-ca65b7803564",
                                "sense_id": "0d56fb35-ea05-3097-95dd-d0587cf5c417",
                                "text": "— Меня вынуждают говорить… Я не готовился, господа, а потому, простите, моя речь будет недостаточно складна."
                            },
                            {
                                "example_id": "5b4a8fcd-03a9-4e6a-a23c-3c7763b9f433",
                                "sense_id": "0d56fb35-ea05-3097-95dd-d0587cf5c417",
                                "text": "Бастрыков присматривался к Исаеву, прислушивался к его плавной, складной речи."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b7b237e-510c-34bf-8d0e-99947ed1b3ab",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "(о речи) мерный, рифмованный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff571470-88a0-4fed-8e07-79ad1af1a1bd",
                                "sense_id": "8b7b237e-510c-34bf-8d0e-99947ed1b3ab",
                                "text": "А Павел сидел радостный и говорил складной речью: — Как увижу тебя — словно в солнышке греюсь… и про все позабуду, и на счастье надеюсь."
                            },
                            {
                                "example_id": "29664aee-8d30-433e-9904-8c81fa060d1d",
                                "sense_id": "8b7b237e-510c-34bf-8d0e-99947ed1b3ab",
                                "text": "У него, должно быть, на всякий случай жизни были в большом запасе складные присловья и поговорки."
                            }
                        ]
                    },
                    {
                        "sense_id": "3768798b-84e6-30c8-8908-7070fdcbfb82",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "разг. (о пении, музыке) стройный, согласный, слаженный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325c4e1d-675f-4d93-8bdc-4b3eb2e8676d",
                                "sense_id": "3768798b-84e6-30c8-8908-7070fdcbfb82",
                                "text": "Где парни деревенские // И девки собиралися, // Гремела песня складная, // Любимая моя."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b154dd8-7542-3c3e-a682-51a7e88d4562",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "разг. хороший, красивый, сделанный так, как надо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d621457f-ba9c-47dc-b160-19614aea8410",
                                "sense_id": "6b154dd8-7542-3c3e-a682-51a7e88d4562",
                                "text": "Изделья Марфины не очень были складные, да зато крепкие, долговечные. Как сама она."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7e46bd7-bd97-3f7b-8910-67473e952fef",
                        "entry_id": "c7689a79-d632-3b50-b244-5087fe387b8c",
                        "glosses": [
                            "прост. удобный, аккуратный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79b674c-3e2f-42a7-944d-1949b528e08d",
                                "sense_id": "b7e46bd7-bd97-3f7b-8910-67473e952fef",
                                "text": "— Полсапожки мне [сын] привез, новехонькие, складные."
                            }
                        ]
                    }
                ],
                "translations": [],
