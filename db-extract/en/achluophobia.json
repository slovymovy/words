                                "example_id": "68393238-283b-489c-92d3-9940dc638b10",
                                "sense_id": "02278731-1287-3117-8fd1-895e4c31a165",
                                "text": "If you have a severe case of achluophobia (fear of the dark), for instance, you may want to wait at the mouth of the cave."
                            },
                            {
                                "example_id": "b80c838e-37c5-4a53-896a-b66cc1604ef2",
                                "sense_id": "02278731-1287-3117-8fd1-895e4c31a165",
                                "text": "When I was little, I had achluophobia and had to sleep with some kind light, any kind of light."
                            },
                            {
                                "example_id": "51a1d1ad-b62b-4574-899d-1109020d798c",
                                "sense_id": "02278731-1287-3117-8fd1-895e4c31a165",
                                "text": "I'm not exactly sure when I was diagnosed with achluophobia—the fear of darkness—but I've always been afraid to be left alone in the dark."
                            }
                        ]
                    }
