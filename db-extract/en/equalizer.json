                                        "entry_id": "b83eb5ea-8a34-3d3c-9c2f-05188c135093",
                                        "glosses": [
                                            "een geluidstechnisch apparaat dat een of meer frequentiegebieden (banden) van het signaal versterkt of verzwakt, opdat de balans tussen de banden, en dus het timbre, naar wens kan worden aangepast"
                                        ],
