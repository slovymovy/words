                "senses": [
                    {
                        "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                        "entry_id": "5042d432-b756-3719-be3f-af1cfaf8b2de",
                        "glosses": [
                            "männliche Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
                            "Österr."
                        ],
                        "examples": [
                            {
                                "example_id": "c7b754d9-5429-455c-bec9-a3cd396e41b1",
                                "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                                "text": "„Als die Hunde nacheinander schnappten, gerieten ihre Herrln in einen wilden Streit.“"
                            },
                            {
                                "example_id": "b0d8e8c0-cabd-4732-8a35-059de859366a",
                                "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                                "text": "„Das Phänomen ist bekannt: Wo ein Hund, da oft ein Herrl (oder Frauerl), das ihm wie aus der Schnauze geschnitten ist.“"
                            },
                            {
                                "example_id": "811febe9-6df8-44b3-8be3-e6703cb71193",
                                "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                                "text": "„Dank Hundemarke war es nicht schwer, das Herrl ausfindig zu machen.“"
                            },
                            {
                                "example_id": "8f718844-45d0-45ac-b225-4ac1650500c7",
                                "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                                "text": "„Scoopy, ein sechs Monate alter Chihuahua, verschwand am vergangenen Wochenende bei einem Spaziergang mit seinem Herrl in St. Tropez.“"
                            },
                            {
                                "example_id": "0b31dee1-6474-42af-86f0-aa9cce833ee4",
                                "sense_id": "451385bf-df19-3729-8b63-ee337cd72c69",
                                "text": "„Als Kind war es besser, man mied diese Hunde, da sie bissig waren und auf Befehl des Herrls: ‚Fass!‘ da fassten sie zu und manch einer kam weinend heim: ‚Da Hund von … dea hod mi einbiss’n!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
