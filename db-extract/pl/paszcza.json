                "senses": [
                    {
                        "sense_id": "00ea487c-822c-39a5-bc69-ad1e5f6ff25f",
                        "entry_id": "d1447f46-3551-35ee-8ce3-7f775258e4a5",
                        "glosses": [
                            "zwierzęcy otwór gębowy, zwłaszcza gdy pokaźnych rozmiarów lub u drapieżnika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ecb484-ea4a-41d4-a562-b310258c3ccf",
                                "sense_id": "00ea487c-822c-39a5-bc69-ad1e5f6ff25f",
                                "text": "Z kryjówki wystawił paszczę żabogłów."
                            },
                            {
                                "example_id": "c1c0c938-813f-49da-8d51-3962625cc11f",
                                "sense_id": "00ea487c-822c-39a5-bc69-ad1e5f6ff25f",
                                "text": "Aligatory mają krótsze paszcze niż krokodyle."
                            },
                            {
                                "example_id": "cea07b50-57fc-4bbc-a725-90bcbd3770ff",
                                "sense_id": "00ea487c-822c-39a5-bc69-ad1e5f6ff25f",
                                "text": "Bądź więc teraz przeklęty na tej roli, która rozwarła swą paszczę, aby wchłonąć krew brata twego, przelaną przez ciebie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
