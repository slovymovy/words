                    {
                        "sense_id": "d0afbdca-ac9d-3788-a5c0-ea97d3a91974",
                        "entry_id": "5afe7444-adb1-38a3-be41-0c515aab25ba",
                        "glosses": [
                            "Marque française d’entremets, créée en 1892."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0c7f37-4d6b-491c-b09a-dec2b8dddbb7",
                                "sense_id": "d0afbdca-ac9d-3788-a5c0-ea97d3a91974",
                                "text": "« Voulez-vous du flan ? »\nGabriel refusa le petit pot où tremblait un rose Franco-russe : dessert hâtif et bon marché qu’affectionnait Mme Esteva."
                            }
                        ]
                    }
