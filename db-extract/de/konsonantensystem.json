                "senses": [
                    {
                        "sense_id": "8eb064ce-6834-3c1c-bd30-4a184fc2bb64",
                        "entry_id": "c8dbaf3e-5ad5-33cd-8791-9dd4b23bac18",
                        "glosses": [
                            "der Teil des Lautsystems einer Sprache, der die Konsonanten enthält"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b448ba-f25d-473d-bcd2-0f581b5c4f81",
                                "sense_id": "8eb064ce-6834-3c1c-bd30-4a184fc2bb64",
                                "text": "„Aus der Vergleichung der Einzelsprachen ergibt sich für die indogermanische Grundsprache folgendes Konsonantensystem...“"
                            },
                            {
                                "example_id": "83558ab7-b422-4b05-9c6f-c0d1b64754be",
                                "sense_id": "8eb064ce-6834-3c1c-bd30-4a184fc2bb64",
                                "text": "Im „dtv-Atlas Deutsche Sprache“ ist die „Entwicklung des Konsonantensystems vom Germanischen zum Althochdeutschen“ in einem Schema dargestellt."
                            },
                            {
                                "example_id": "f605567c-1376-40d6-91cf-83bd0e47feba",
                                "sense_id": "8eb064ce-6834-3c1c-bd30-4a184fc2bb64",
                                "text": "„Was jedoch bei der Beschreibung des dänischen Konsonantensystems Schwierigkeiten macht, ist seine kontroverse Darstellung in der Forschungs- und Lehrbuchliteratur (…).“"
                            },
                            {
                                "example_id": "8fc21d37-deb4-4e3d-8211-045ec4c1a9ff",
                                "sense_id": "8eb064ce-6834-3c1c-bd30-4a184fc2bb64",
                                "text": "„Diese Vorhersagen allgemeiner Art werden dann in Beziehung gesetzt zu den phonetischen und phonologischen Merkmalen des deutschen Konsonantensystems, das ebenfalls im Laufe von Kapitel drei besprochen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
