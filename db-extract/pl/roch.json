                                "target_senses": [
                                    {
                                        "sense_id": "11f54d21-ad45-37d9-ad93-abacea2414b5",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "A diminutive of the male given names Robert, Ricky, Rocco, Roch, or Rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3dcb50e-2ee5-4125-a871-531bdb1180da",
                                                "sense_id": "11f54d21-ad45-37d9-ad93-abacea2414b5",
                                                "text": "‘I didn′t know your son′s name was Rocky,’ I quietly said as we started walking again.\n‘It's really Richard. When he was a kid we called him Ricky, which somehow turned into Rocky. Some people call him Rocco. He gets called a lot of things.’"
                                            },
                                            {
                                                "example_id": "3851263e-46bb-4034-bc93-b718c9ef239e",
                                                "sense_id": "11f54d21-ad45-37d9-ad93-abacea2414b5",
                                                "text": "Philadelphia Museum of Art:[…]This venue is also famous for its notable appearance in the 1976 movie 'Rocky', where Robert \"Rocky\" Balboabounds up the museum's steps as he prepares for his upcoming title match with Apollo Creed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8978d8-b6fa-3061-9105-1d93af1b74e8",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "Diminutive of Rock (“surname”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "diminutive",
                                            "form-of",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8af954f0-394a-3bb1-a83d-36e6a40a8aa1",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "Rocky Balboa, a fictional boxer in a series of films."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af5a4b78-06ba-3c0b-9041-7db3bcd9f42c",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "The Rocky Horror Picture Show, a motion picture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "777cc36b-deb0-3e8c-9aa4-e1b7789d6d9a",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "A placename",
                                            "Diminutive of Rockhampton; the regional city of Rockhampton; a city in Queensland, Australia."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "diminutive",
                                            "form-of",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4122fc-2dce-4852-b601-3fdeca1c7e7a",
                                                "sense_id": "777cc36b-deb0-3e8c-9aa4-e1b7789d6d9a",
                                                "text": "Rocky is the major city on the central Queensland coast and likes to call itself the beef capital of Australia."
                                            },
                                            {
                                                "example_id": "02d367be-3255-4ebe-bfa9-03c655a329e3",
                                                "sense_id": "777cc36b-deb0-3e8c-9aa4-e1b7789d6d9a",
                                                "text": "Rocky has a smattering of attractions but is best seen as the gateway to the coastal gems of Yeppoon and Great Keppel Island."
                                            },
                                            {
                                                "example_id": "e75be6c8-2991-4be8-8369-30f1c613d160",
                                                "sense_id": "777cc36b-deb0-3e8c-9aa4-e1b7789d6d9a",
                                                "text": "“I wonder when I′ll be asked to leave?” Kevin thought. “This is very different to how things went last time in Rocky (Rockhampton). It all seems very relaxed here. The staff seem to expect you to hang around. What for?”"
                                            }
                                        ]
                                    },
