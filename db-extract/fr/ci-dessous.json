                                                "example_id": "0fddd252-5791-4f88-851e-abb269a2e4de",
                                                "sense_id": "0033c0e6-77fc-3e2c-bfc2-1aaebf4b5e99",
                                                "text": "Below the sofa is a low, round coffee table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "below",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
