                "senses": [
                    {
                        "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                        "entry_id": "7471d66e-aaed-3f4f-ae94-fe67b9f8b44a",
                        "glosses": [
                            "das Verlangen, jemanden zu töten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "331063b1-ad70-45c5-8cbe-5447b917b477",
                                "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                                "text": "„Das, was sich da anmuffalt mit hängenden Schultern, Mordlüsternheit im Bauch?“"
                            },
                            {
                                "example_id": "87c02d78-9889-40f7-831b-2a8fa5e3a620",
                                "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                                "text": "„Bölkow war es gewohnt, mit den direkten Folgen von Unfällen, Verfolgungsjagden oder Mordlüsternheit umzugehen.“"
                            },
                            {
                                "example_id": "e71ee620-9321-49a6-9c5a-ee78729947a2",
                                "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                                "text": "„Die Antwort kam so kalt, so eisig rüber, dass Spottas Bauchgefühl – und nicht zuletzt die vor Mordlüsternheit funkelnden Augen Johnsons – ihm signalisierte , dass er besser das Thema wechselte, wenn er nicht zusammengeknüllt in irgendeinem Müllcontainer landen wollte.“"
                            },
                            {
                                "example_id": "1d07d6e1-233c-452c-bcee-8f94c935e9ee",
                                "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                                "text": "„Traulich soll es sein – trotz aller Mordgier und Mordlüsternheit.“"
                            },
                            {
                                "example_id": "70441b00-0262-4114-bc00-ee5eb30eb575",
                                "sense_id": "0a97b973-3eee-32e6-97f3-4b25eda2d4f7",
                                "text": "„Darin soll die Menschenfreundlichkeit Gottes mitten in der von Machtgier, Mordlüsternheit und Unmenschlichkeit befallenen Welt zum Licht der Menschen im Glauben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
