                    {
                        "translation_id": "c65647ae-2ed3-44d5-baad-e755cc5e757e",
                        "source_entry_id": "dacbec8c-cec9-3c9f-91d1-382afb114942",
                        "source_sense_id": "cc6c1023-0571-3d2d-b0da-dba8d7884cde",
                        "target_lang_word": "Wortschöpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortschöpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                        "entry_id": "1725a359-6d96-3aa0-91e4-2e22ebc8e726",
                                        "glosses": [
                                            "neues Wort, das nicht aus den in der Sprache vorhandenen Morphemen nur unter Wahrung der erlaubten Lautverbindungen gebildet wird"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c1d7fd0-f97a-442b-be2b-d9c87e401bd6",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "Wortschöpfungen kommen in Werbung (\"Kelts\" für eine Biermarke), Literatur (engl. Beispiel: \"Quark\" [kvɔːk] aus Joyce's Finnegan's Wake, in der Physik jetzt im Sinne von Elementarteilchen), Science fiction (\"Stimic\" für ein Musikinstrument), Kindersprache (\"dongen\" mit unklarer Bedeutung), Kindersendungen (\"Urmel\" = kleiner Drache) und linguistischen Experimenten (besonders bekannt: \"wug\" für ein vogelähnliches Tierbild) vor, werden aber nur ganz selten in Wörterbücher aufgenommen."
                                            },
                                            {
                                                "example_id": "a53139dc-ea09-47d0-9e57-79357dbd4660",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "Es gibt in der Linguistik eine Tradition, zwischen Wortbildung und Wortschöpfung zu unterscheiden: „W o r t s c h ö p f u n g besteht dagegen darin, daß Wörter aus Lautkomplexen ‚geschaffen‘ werden, die in der Sprache (noch) nicht als bedeutungstragende Elemente (Zeichen) vorhanden sind; es entstehen also neue Wortwurzeln.“"
                                            },
                                            {
                                                "example_id": "d0b9b5ea-77d1-4b52-b5bd-efc97967101b",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "„Eine große Rolle spielt die Schallnachahmung in der Kindersprache oder Ammensprache, denn nicht nur die Kinder haben solche Wortschöpfungen...“"
                                            },
                                            {
                                                "example_id": "d1c37dc4-b017-4ae9-ac1f-fc41def67852",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "„Wenn ich es auch nur für einzelne, selbsterlebte Fälle beweisen kann, bin ich doch überzeugt, daß diese Lautbilder nach Bedarf immer neu gebildet werden, daß es sich hier also um ein nicht abgeschlossenes Gebiet der Wortschöpfung handelt.“"
                                            },
                                            {
                                                "example_id": "a15c8bcf-69cc-4a86-b553-45195cd95b10",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "„Die Kindersprache enthält usualisierte Wortschöpfungen: »Tick-Tack« (‚Uhr‘), »Puff-puff« (‚Eisenbahn‘).“"
                                            },
                                            {
                                                "example_id": "668b0126-a7e3-492d-b66b-f16870a93e86",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "„Dabei tritt der Aspekt der Verständlichkeit dieser meist artifiziellen Wortschöpfungen eindeutig in den Hintergrund.“"
                                            },
                                            {
                                                "example_id": "3ccd67c5-f112-4583-ac64-0da3a526a3f4",
                                                "sense_id": "7eb82f57-4455-309c-a8a6-ae5772e9b694",
                                                "text": "„Wir leben in Zeiten, in denen eine rassistisch motivierte Mordserie junger Neonazis in den Medien in aller Unbefangenheit mit der rassistischen Wortschöpfung \"Döner-Morde\" bezeichnet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
