                    {
                        "sense_id": "bf1b0e3b-10a2-36c2-94a1-ce229f34df83",
                        "entry_id": "c6ef67a9-9134-3449-8d86-6f156ae61ddd",
                        "glosses": [
                            "Procédé consistant à réduire oralement et graphiquement un mot ou un syntagme en lui ôtant certaines parties."
                        ],
                        "tags": [
                            "especially",
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "b95e4951-cd1b-48e6-ba6c-7e33a5dae81e",
                                "sense_id": "bf1b0e3b-10a2-36c2-94a1-ce229f34df83",
                                "text": "L’abrègement est couramment employé à l’oral."
                            },
                            {
                                "example_id": "18695c12-52e4-435a-8182-7ff702392409",
                                "sense_id": "bf1b0e3b-10a2-36c2-94a1-ce229f34df83",
                                "text": "Une troncation est un abrègement d’abord oral puis graphique (ciné, bus, v’là). Une siglaison est un abrègement d’abord graphique puis oral (S.N.C.F., Assédic)."
                            }
                        ]
                    },
                    {
                        "sense_id": "353c7780-2a51-3c92-bbcc-5a93af2d8e88",
                        "entry_id": "c6ef67a9-9134-3449-8d86-6f156ae61ddd",
                        "glosses": [
