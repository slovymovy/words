                "senses": [
                    {
                        "sense_id": "a4bc7190-68b3-38e0-a112-0ba3d36bc870",
                        "entry_id": "e616f570-7f83-3804-916a-e0c3f891d663",
                        "glosses": [
                            "Aquavit, Wodka, Schnaps, Lebenswasser"
                        ],
