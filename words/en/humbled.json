{
    "word_family": [
        "humble",
        "humbleness",
        "humility",
        "humbly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                    "sense_definition": "Feeling grateful, honored, or flattered, especially by the support or praise of others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am deeply <w>humbled</w> by the kind words and support from my community.",
                            "target_lang_translations": {
                                "ru": "Я глубоко <w>тронут</w> добрыми словами и поддержкой моего сообщества."
                            }
                        },
                        {
                            "text": "The athlete felt <w>humbled</w> to receive such a prestigious award from her peers.",
                            "target_lang_translations": {
                                "ru": "Спортсменка сочла за огромную <w>честь</w> получить столь престижную награду от своих коллег."
                            }
                        }
                    ],
                    "synonyms": [
                        "honored",
                        "flattered",
                        "touched",
                        "grateful"
                    ],
                    "antonyms": [
                        "proud",
                        "arrogant",
                        "unmoved"
                    ],
                    "common_phrases": [
                        "deeply humbled",
                        "honored and humbled",
                        "humbled by the support"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство благодарности, чести или признательности, особенно в ответ на поддержку или похвалу окружающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "польщен",
                                "target_lang_sense_clarification": "чувствовать себя удостоенным чести"
                            },
                            {
                                "target_lang_word": "тронут",
                                "target_lang_sense_clarification": "быть глубоко признательным за поддержку"
                            },
                            {
                                "target_lang_word": "преисполнен благодарности",
                                "target_lang_sense_clarification": "чувствовать смирение перед добротой других"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "564a24c8-ca16-3e1e-b939-866fc7904829",
                    "sense_definition": "Feeling a sense of lowliness or awe when faced with something much greater, stronger, or more impressive than oneself.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Standing at the foot of the massive mountain, I felt <w>humbled</w> by the sheer scale of nature.",
                            "target_lang_translations": {
                                "ru": "Стоя у подножия массивной горы, я почувствовал себя <w>песчинкой</w> перед лицом истинного величия природы."
                            }
                        },
                        {
                            "text": "He was <w>humbled</w> by the strength and resilience shown by the survivors during the crisis.",
                            "target_lang_translations": {
                                "ru": "Он был <w>поражен</w> силой и стойкостью, проявленными выжившими во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "awed",
                        "diminished",
                        "subdued"
                    ],
                    "antonyms": [
                        "superior",
                        "overconfident"
                    ],
                    "common_phrases": [
                        "humbled by the experience",
                        "humbled by the strength"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство собственного ничтожества или благоговения перед чем-то гораздо более великим, сильным или впечатляющим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлен величием",
                                "target_lang_sense_clarification": "чувствовать себя маленьким перед чем-то грандиозным"
                            },
                            {
                                "target_lang_word": "преклоняться",
                                "target_lang_sense_clarification": "испытывать глубокое уважение и трепет"
                            },
                            {
                                "target_lang_word": "смиренный",
                                "target_lang_sense_clarification": "осознающий свою незначительность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c50a3fd7-8e3e-3b10-8603-343c470ac332",
                    "sense_definition": "The simple past and past participle of <w>humble</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected defeat <w>humbled</w> the champion and made him work harder.",
                            "target_lang_translations": {
                                "ru": "Неожиданное поражение <w>усмирило</w> чемпиона и заставило его работать усерднее."
                            }
                        },
                        {
                            "text": "She <w>humbled</w> her opponent with a series of brilliant strategic moves.",
                            "target_lang_translations": {
                                "ru": "Она <w>поставила на место</w> своего оппонента серией блестящих стратегических ходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliated",
                        "lowered",
                        "deflated"
                    ],
                    "antonyms": [
                        "exalted",
                        "praised"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола «humble» — усмирить, сбить спесь или заставить почувствовать себя скромнее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставил на место",
                                "target_lang_sense_clarification": "сбить спесь или самоуверенность"
                            },
                            {
                                "target_lang_word": "усмирил",
                                "target_lang_sense_clarification": "сделать более скромным"
                            },
                            {
                                "target_lang_word": "унизил",
                                "target_lang_sense_clarification": "заставить почувствовать поражение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}