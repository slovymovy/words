                ],
                "translations": [
                    {
                        "translation_id": "61802d89-bbec-49c3-bc5d-ea67de312705",
                        "source_entry_id": "f6c98928-cce3-328a-974d-733dfc852013",
                        "source_sense_id": "805e1b30-47b2-3170-8c7a-810bf3e8cb0d",
                        "target_lang_word": "absent-mindedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absent-mindedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                        "entry_id": "8f4ac312-2442-3e9d-8119-bd42763fd162",
                                        "glosses": [
                                            "The characteristic or state of being easily distracted or preoccupied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1dbd6d-7af6-4b23-baf9-11dd86717c64",
                                                "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                                "text": "I don't mean to make mistakes; it's just absent-mindedness."
                                            },
                                            {
                                                "example_id": "1e823982-f64c-4c59-b8bd-89d224f97848",
                                                "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                                "text": "For six years they had taken care of him and loved him—watched over his outgoings and his incomings and forgiven all his absent-mindednesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa1b2efe-e851-4b1c-9cd4-8bdc06da216c",
                        "source_entry_id": "f6c98928-cce3-328a-974d-733dfc852013",
                        "source_sense_id": "805e1b30-47b2-3170-8c7a-810bf3e8cb0d",
                        "target_lang_word": "distraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Something that distracts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28321ee-2b35-4b15-8530-4748faf84bdd",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "Poking one's eye is a good distraction from a hurting toe."
                                            },
                                            {
                                                "example_id": "d37d09d4-0811-47a6-aa59-d1bf92c76baa",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "At last the Duke of Anjou arrived, dressed, as his brother said, to distraction."
                                            },
                                            {
                                                "example_id": "a1618cc4-2dab-4b2a-91ea-d4611b79094d",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "“… This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "The process of being distracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f701c1e9-cf4e-4535-9d9c-2252126bbdfe",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We have to reduce distraction in class if we want students to achieve good results."
                                            },
                                            {
                                                "example_id": "e75ce999-88b9-40fa-a47d-173537338fda",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\",[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "9976f64f-8bdc-4c39-af5d-e359d58b3105",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We determined that the probable cause of the Tishomingo, Oklahoma, collision was the teen driver’s acceleration through the intersection after briefly slowing without stopping, due to distraction from having five teen passengers in the car, limited driving experience, and likely impairment from cannabis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Perturbation; disorder; disturbance; confusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de3b38e9-2e28-445e-8d66-683a13493993",
                                                "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                                "text": "It's true that the Copernican Systeme introduceth distraction in the universe of Aristotle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Mental disarray; a deranged state of mind; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c55cbc-725d-42eb-b546-965607926361",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "The incessant nightmares drove him to distraction."
                                            },
                                            {
                                                "example_id": "72ff139c-5411-44b3-bc8f-c79e0e2c6b43",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "[…] if he speak the words of an oath in a strange language, thinking they signify something else, or if he spake in his sleep, or deliration, or distraction, it is no oath, and so not obligatory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a56a58-05e1-3de7-90bd-7100f40ac23b",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Traction so exerted as to separate surfaces normally opposed."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9447534a-99ea-481a-a9a3-a9681b64c0dd",
                        "source_entry_id": "f6c98928-cce3-328a-974d-733dfc852013",
                        "source_sense_id": "305a2683-53b4-3f65-adee-2a540da73d1b",
                        "target_lang_word": "dissociation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissociation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf86960c-9ecf-3305-a500-a2996efbfc39",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "The act of dissociating or disuniting; a state of separation; disunion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e832faab-69e9-4a63-b5b4-9ab0a2ead964",
                                                "sense_id": "bf86960c-9ecf-3305-a500-a2996efbfc39",
                                                "text": "A general observation in memory studies of individuals with ASD is that they tend to experience greater difficulties on tests of free recall than tests of recognition or cued recall (Boucher, Mayes, & Bigham, 2012). In its own right, this pattern suggests greater difficulties with retrieval through recollection than through familiarity, but there is also more direct evidence for this dissociation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "The process by which a compound body breaks up into simpler constituents; said particularly of the action of heat on gaseous or volatile substances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bf61b6-0c73-478b-b1e9-9b8e2a4461bd",
                                                "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                                "text": "the dissociation of the sulphur molecules"
                                            },
                                            {
                                                "example_id": "d6134a79-83ba-4421-b63b-2efb694817a2",
                                                "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                                "text": "the dissociation of ammonium chloride into hydrochloric acid and ammonia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2ab25a-6f71-3dd1-b25c-7dcde90a99c4",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "A defence mechanism where certain thoughts or mental processes are compartmentalised in order to avoid emotional stress to the conscious mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2cad7d-d2b0-4d64-b5bc-96f3ac05ff3d",
                                                "sense_id": "aa2ab25a-6f71-3dd1-b25c-7dcde90a99c4",
                                                "text": "Project MONARCH could be best described as a form of structured dissociation and occultic integration, carried out in order to compartmentalize the mind into multiple personalities within a systematic framework."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
