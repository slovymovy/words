{
    "word_family": [
        "charisma",
        "charism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19577036-c41f-3677-9271-a01b1558cbb4",
                    "sense_definition": "Having a compelling charm that inspires devotion in others due to a strong personality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>charismatic</w> leader easily convinced the crowd to support his new vision.",
                            "target_lang_translations": {
                                "zh": "这位<w>富有魅力</w>的领袖轻易说服了大众支持他的新愿景。"
                            }
                        },
                        {
                            "text": "She has a <w>charismatic</w> personality that makes everyone feel welcome and important.",
                            "target_lang_translations": {
                                "zh": "她有着<w>富有魅力</w>的性格，让每个人都感到受重视和受欢迎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charming",
                        "magnetic",
                        "fascinating"
                    ],
                    "antonyms": [
                        "unappealing"
                    ],
                    "common_phrases": [
                        "charismatic leader",
                        "charismatic personality"
                    ],
                    "target_lang_definitions": {
                        "zh": "有魅力的，具有超凡个人魅力的，能吸引并感召他人的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有魅力的",
                                "target_lang_sense_clarification": "指具有吸引人的个性或魅力"
                            },
                            {
                                "target_lang_word": "富有魅力的",
                                "target_lang_sense_clarification": "指充满强烈吸引力的"
                            },
                            {
                                "target_lang_word": "有感召力的",
                                "target_lang_sense_clarification": "指具有号召、鼓动他人的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20eda1d-fbf2-3cde-a26b-6585ee990d8f",
                    "sense_definition": "Relating to a form of Christianity that emphasizes the active role of the Holy Spirit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church follows a <w>charismatic</w> tradition that includes speaking in tongues.",
                            "target_lang_translations": {
                                "zh": "这座教堂遵循包括说方言在内的<w>灵恩派</w>传统。"
                            }
                        },
                        {
                            "text": "Many <w>charismatic</w> congregations focus on healing and spiritual gifts during their services.",
                            "target_lang_translations": {
                                "zh": "许多<w>灵恩派</w>聚会在礼拜期间注重医治与属灵恩赐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "charismatic movement",
                        "charismatic church"
                    ],
                    "target_lang_definitions": {
                        "zh": "（基督教）灵恩派的，神赐能力的，强调圣灵作工的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灵恩派的",
                                "target_lang_sense_clarification": "基督教派别，强调圣灵的恩赐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa691140-ef91-3357-9114-5bc3e4069447",
                    "sense_definition": "A member of the Charismatic Movement within Christianity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>charismatics</w> believe in the modern-day manifestation of spiritual gifts.",
                            "target_lang_translations": {
                                "zh": "许多<w>灵恩派信徒</w>相信属灵恩赐在当代的显现。"
                            }
                        },
                        {
                            "text": "The local group of <w>charismatics</w> meets every Wednesday for prayer and worship.",
                            "target_lang_translations": {
                                "zh": "当地的<w>灵恩派信徒</w>团体每周三都会聚在一起祈祷和敬拜。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（基督教）灵恩派信徒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灵恩派信徒",
                                "target_lang_sense_clarification": "指属于灵恩运动的基督教徒"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}