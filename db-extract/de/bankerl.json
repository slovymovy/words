                "senses": [
                    {
                        "sense_id": "6f719246-0ddc-3787-b428-31604ceb3ee2",
                        "entry_id": "ab4c2e89-687b-3dd0-8170-fc8b79d1f135",
                        "glosses": [
                            "(kleine) Sitzbank"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5f678d0d-d25a-4d44-aec8-45c05e38a0bc",
                                "sense_id": "6f719246-0ddc-3787-b428-31604ceb3ee2",
                                "text": "Bei schönem Wetter setzte sie sich gerne mit einem Buch auf ein Bankerl im Englischen Garten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0282ab6b-3b07-3f22-9719-8aa7a83946b9",
                        "entry_id": "ab4c2e89-687b-3dd0-8170-fc8b79d1f135",
                        "glosses": [
                            "Sitzplatz für Spieler, die bei einem Spiel nicht von Anfang an teilnehmen, aber je nach Bedarf später eingesetzt werden können"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba92247-a4d0-413a-a35f-e22ab753cdfe",
                                "sense_id": "0282ab6b-3b07-3f22-9719-8aa7a83946b9",
                                "text": "Er hat es satt, immer nur am Bankerl zu sitzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "24cb8f9c-c285-31f8-8375-c633d6c6b9c4",
                        "entry_id": "ab4c2e89-687b-3dd0-8170-fc8b79d1f135",
                        "glosses": [
                            "Sitzplatz für Trainer und Trainerteam während eines Spiels"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "daa2205b-8ab0-4a9c-86f2-ee7dcff27b88",
                                "sense_id": "24cb8f9c-c285-31f8-8375-c633d6c6b9c4",
                                "text": "„Die einen können kein Spiel, die anderen keine Wahl gewinnen. Egal, was der auf dem Bankerl unter Taktik versteht …“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
