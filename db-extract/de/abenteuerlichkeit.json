                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be4fe1bb-77d1-3207-9657-eb63cccd4618",
                                        "entry_id": "e619e033-dcf7-3ee5-aa89-4066a2643665",
                                        "glosses": [
                                            "The state or quality of being adventuresome."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10451a3b-45ef-4934-b586-97da0301cd12",
                                                "sense_id": "be4fe1bb-77d1-3207-9657-eb63cccd4618",
                                                "text": "But toughness was not their quality—adventuresomeness was—and a mean determination to explore everything that interested them."
                                            }
