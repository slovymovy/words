                "forms": [
                    {
                        "form_id": "df446ad8-e698-4533-a8d3-84bd84b7bc58",
                        "entry_id": "6ff6ee0d-1a17-3de0-bb3c-1ec4ea81dcde",
                        "tags": [
                            "plural"
                        ],
                        "form": "verworvenheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa03b079-0c4a-3d93-b4b5-0581dd3db32c",
                        "entry_id": "6ff6ee0d-1a17-3de0-bb3c-1ec4ea81dcde",
                        "glosses": [
                            "wat men, meestal aan onstoffelijke zaken, bereikt heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2023c2b-403e-4bee-92af-140eaffcae03",
                                "sense_id": "fa03b079-0c4a-3d93-b4b5-0581dd3db32c",
                                "text": "Enkele jaren geleden stonden deze verworvenheden onder druk. De economie kromp, het begrotingstekort was bijna 4 procent en het aantal mensen op zoek naar werk piekte op 700.000, ongeveer 8 procent van onze beroepsbevolking. Daarnaast waren de huizenprijzen fors gedaald, dreigde de AOW onbetaalbaar te worden en stegen de zorgkosten jaar op jaar veel sneller dan het nationaal inkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b15345-a737-475a-ac7f-50bb9c0de69c",
                        "source_entry_id": "6ff6ee0d-1a17-3de0-bb3c-1ec4ea81dcde",
                        "source_sense_id": "fa03b079-0c4a-3d93-b4b5-0581dd3db32c",
                        "target_lang_word": "acquirement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquirement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a685506-676f-30b7-bcbd-3b8bf2480d7d",
                                        "entry_id": "36f13822-b956-3e71-874c-58f4af78385e",
                                        "glosses": [
                                            "Something that has been acquired; an attainment or accomplishment."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09533855-eb74-4e86-85e0-cab27e8f20ed",
                                                "sense_id": "6a685506-676f-30b7-bcbd-3b8bf2480d7d",
                                                "text": "[…] his acquirements by industrie were […] enriched and enlarged by many excellent endowments of nature."
                                            },
                                            {
                                                "example_id": "0cc929cf-23db-4425-828d-091cc5ecccf9",
                                                "sense_id": "6a685506-676f-30b7-bcbd-3b8bf2480d7d",
                                                "text": "If she can think, that the part she has had in your education, and your own admirable talents and acquirements, are to be thrown away upon such a worthless creature as Solmes, I could heartily quarrel with her."
                                            },
                                            {
                                                "example_id": "f0b18799-2a55-45bb-8792-6d92e5bde21d",
                                                "sense_id": "6a685506-676f-30b7-bcbd-3b8bf2480d7d",
                                                "text": "[…] there was a degree of deference in his deportment toward that young gentleman which seemed to indicate that he felt himself conscious of a slight inferiority in point of genius and professional acquirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab0a273-626d-3615-839c-9c2b93f4df24",
                                        "entry_id": "36f13822-b956-3e71-874c-58f4af78385e",
                                        "glosses": [
                                            "The act or fact of acquiring something; acquisition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7396a0d5-353a-48ab-8078-2eed1e9603ba",
                                                "sense_id": "dab0a273-626d-3615-839c-9c2b93f4df24",
                                                "text": "[…] rules for the acquirement of a taste […]"
                                            },
                                            {
                                                "example_id": "d877411b-1b63-4f01-b77e-3f6e4b75d0dc",
                                                "sense_id": "dab0a273-626d-3615-839c-9c2b93f4df24",
                                                "text": "One man's life or death were but a small price to pay for the acquirement of the knowledge which I sought […]."
                                            },
                                            {
                                                "example_id": "b8890fd8-e152-4c92-8aa1-2115c86f1bc3",
                                                "sense_id": "dab0a273-626d-3615-839c-9c2b93f4df24",
                                                "text": "At best, a considerable time elapses between authorization and land acquirement, during which land values may vary impredictably."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dfdfeba-c833-4013-8275-4ce2753b0a39",
                        "source_entry_id": "6ff6ee0d-1a17-3de0-bb3c-1ec4ea81dcde",
                        "source_sense_id": "fa03b079-0c4a-3d93-b4b5-0581dd3db32c",
                        "target_lang_word": "acquis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6b042b-4642-32bc-aae3-c6ffc9eeda2a",
                                        "entry_id": "04a208de-a013-3899-a8f2-c2b45f20116c",
                                        "glosses": [
                                            "Qui est obtenu, sans que cela ait été auparavant déjà possédé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "022da893-146d-4dae-bd4f-6ac35b127991",
                                                "sense_id": "dc6b042b-4642-32bc-aae3-c6ffc9eeda2a",
                                                "text": "Il faut bien distinguer les défenses innées des défenses acquises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e88ab37-2dac-32d6-9b6a-702d1ad2560a",
                                        "entry_id": "04a208de-a013-3899-a8f2-c2b45f20116c",
                                        "glosses": [
                                            "Définitif, incontestable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c1aece-9519-467b-8cdd-426064069794",
                                                "sense_id": "5e88ab37-2dac-32d6-9b6a-702d1ad2560a",
                                                "text": "C’est une chose acquise, nous n’y reviendrons plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4077a2c-8964-35e8-82e8-ba0e029c29ea",
                                        "entry_id": "04a208de-a013-3899-a8f2-c2b45f20116c",
                                        "glosses": [
                                            "Qualifie des semis, une fructification ou une régénération suffisante pour couper les semenciers qui les ont générés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c3e4ad-d9e4-46a4-b6f5-5f80fc2adc3d",
                                                "sense_id": "e4077a2c-8964-35e8-82e8-ba0e029c29ea",
                                                "text": "Une fois les peuplements ouverts et en l’absence de semis, le parterre des coupes se « salit » (colonisation par les graminées, par les rejets de taillis…) et, peu de temps après, le terrain devient impropre à la germination des glands. Les coupes d’ensemencement doivent donc être réalisées, soit sur semis acquis, soit sur glandée annoncée ou au sol."
                                            },
                                            {
                                                "example_id": "89696c89-1461-4f33-8939-905cddb2af7b",
                                                "sense_id": "e4077a2c-8964-35e8-82e8-ba0e029c29ea",
                                                "text": "Maintenir un renouvellement en chêne passe donc par une gestion très réactive de l’ouverture du couvert sur glandée acquise pour le [c]hêne pédonculé ou sur semis acquis pour le [c]hêne sessile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf6ada7-98b6-3b7f-a941-bc9193a6fb40",
                                        "entry_id": "04a208de-a013-3899-a8f2-c2b45f20116c",
                                        "glosses": [
                                            "Survenant après la fécondation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "acquis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f39fcd71-5eda-39df-8e2b-0790b0be07c8",
                                        "entry_id": "59034cc3-34b4-3f4a-8d99-7da8cdb29a86",
                                        "glosses": [
                                            "Ce qui s’obtient par l’effort ou l’expérience, par opposition à ce qui est inné ou naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fbf0473-7de0-476b-b949-e68018ef3068",
                                                "sense_id": "f39fcd71-5eda-39df-8e2b-0790b0be07c8",
                                                "text": "Il avait le regard rusé et le rire franc. Pour un observateur, cela signifiait que le regard était de l’acquis. Le rire ne se contraint pas ; s’il est faux, il ne peut s’empêcher de le paraître, ce qui est encore une façon d’être sincère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c94de0e-5b78-3e3b-b85b-cb77d03d5ece",
                                        "entry_id": "59034cc3-34b4-3f4a-8d99-7da8cdb29a86",
                                        "glosses": [
                                            "Capacité ou connaissance d’ores et déjà obtenue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024459ca-2fa2-4e60-b980-c12a8984a34e",
                                                "sense_id": "0c94de0e-5b78-3e3b-b85b-cb77d03d5ece",
                                                "text": "Il a des acquis solides en matière de linguistique."
                                            },
                                            {
                                                "example_id": "eafd7dd0-1aac-4453-a368-72721202b9ae",
                                                "sense_id": "0c94de0e-5b78-3e3b-b85b-cb77d03d5ece",
                                                "text": "A l’autre bout de la chaîne de production, le diplôme est reçu par le jeune comme un acquis: il ouvre la porte des études supérieures, voire d’un emploi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c51044f-198a-3b54-bb08-2a20e85c3efb",
                                        "entry_id": "59034cc3-34b4-3f4a-8d99-7da8cdb29a86",
                                        "glosses": [
                                            "Droit d’ores et déjà obtenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3fd1cd-e64c-49a3-8692-a9ec9a67e676",
                                                "sense_id": "6c51044f-198a-3b54-bb08-2a20e85c3efb",
                                                "text": "Les acquis sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a9cdae-1be3-3d1f-a110-c7c1c316a360",
                                        "entry_id": "59034cc3-34b4-3f4a-8d99-7da8cdb29a86",
                                        "glosses": [
                                            "Ensemble des législations (règlement, directive, et autres actes contraignants) adopté dans l’Union européenne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
