                "senses": [
                    {
                        "sense_id": "eecdae51-e821-36b8-86db-1ba7d9caf0f2",
                        "entry_id": "e6080cdb-4fdf-3e99-82f0-f7b6eb304a62",
                        "glosses": [
                            "einzelnes Stück eines mehrteiligen Objekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e015fef-7f06-4ff6-9db9-ac9f01512f6b",
                                "sense_id": "eecdae51-e821-36b8-86db-1ba7d9caf0f2",
                                "text": "„Im restaurierten Teilstück nördlich von Peking ist die Chinesische Mauer 6,6 m hoch, am Boden 6,5 m und oben 5,5 m breit.“"
                            },
                            {
                                "example_id": "ba2df7d1-fd9e-4b03-b6af-9a9c7423a652",
                                "sense_id": "eecdae51-e821-36b8-86db-1ba7d9caf0f2",
                                "text": "„Wir bekamen tatsächlich flüchtig ein Teilstück der Themse zu sehen, mit den Lampen am Ufer, die auf das breite, stille Wasser schienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
