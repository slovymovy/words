                        "entry_id": "278f9ce6-1542-3544-93c4-adc8a95a21ba",
                        "glosses": [
                            "устар. предаваться чревоугодию, обжорству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34cac9a-923e-4ce3-b384-1d86c7746e10",
                                "sense_id": "c61d67e5-3a61-3647-b522-7d6e122ead1d",
                                "text": "О прочем умалчиваю. Что чревоугодничать, что дым глотать, в принципе нет никакой разницы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5cc180-59a4-41df-9d8f-a5d0e942a04d",
                        "source_entry_id": "278f9ce6-1542-3544-93c4-adc8a95a21ba",
                        "source_sense_id": "c61d67e5-3a61-3647-b522-7d6e122ead1d",
                        "target_lang_word": "gluttonize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gluttonize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a588ee-4d5f-3ff1-b848-01f46b2647fe",
                                        "entry_id": "4f57a038-76cd-354f-923b-8842b169c06c",
                                        "glosses": [
                                            "To eat an excessive amount, or voraciously."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "534c488c-89ed-40af-b29d-a44891251a16",
                                                "sense_id": "62a588ee-4d5f-3ff1-b848-01f46b2647fe",
                                                "text": "the material Demons do strangely gluttonize upon the Nidours and Bloud of Sacrifices"
                                            },
                                            {
                                                "example_id": "953caa6f-4b7d-456c-a0ac-0d091e8c5c58",
                                                "sense_id": "62a588ee-4d5f-3ff1-b848-01f46b2647fe",
                                                "text": "Mayflies are among Mother Nature's most graceful and beautiful creations, and I think I'd believe that even if trout didn't gluttonize on them when they ride on a stream's currents to dry their wings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
