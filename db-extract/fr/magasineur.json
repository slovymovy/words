                                "target_senses": [
                                    {
                                        "sense_id": "4e029fbf-f8a1-3e41-a0b2-c52ec0eecc3f",
                                        "entry_id": "26176ddf-8853-320a-a18a-3dc2e3327038",
                                        "glosses": [
                                            "A person who shops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94a0896-4065-4be8-9534-6531aa437604",
                                                "sense_id": "4e029fbf-f8a1-3e41-a0b2-c52ec0eecc3f",
                                                "text": "The San Juan market is Mexico City's most famous deli of exotic meats, where an adventurous shopper can hunt down hard-to-find critters such as ostrich, wild boar and crocodile."
                                            },
                                            {
                                                "example_id": "2ca33696-4599-4573-aadf-4cb9612bc525",
                                                "sense_id": "4e029fbf-f8a1-3e41-a0b2-c52ec0eecc3f",
                                                "text": "On November 29 1952, a special train ran from Sunderland to Leeds for Christmas shoppers and those attending a Leeds vs. Brentford match. It caused controversy, with Sunderland traders protesting that their shops were just as good as those in Leeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75558050-b72f-30bd-9f14-74d508cd5277",
                                        "entry_id": "26176ddf-8853-320a-a18a-3dc2e3327038",
                                        "glosses": [
                                            "A free local newspaper containing advertisements for local shops etc; sometimes includes discount coupons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a6e0dbc-f3e0-3126-9712-bacdd2880ab6",
                                        "entry_id": "26176ddf-8853-320a-a18a-3dc2e3327038",
                                        "glosses": [
                                            "A kind of bicycle suited to riding short distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3f855d-de6b-492a-bd53-68fd0fdec6ac",
                                                "sense_id": "9a6e0dbc-f3e0-3126-9712-bacdd2880ab6",
                                                "text": "Every conceivable type of cycle's represented; modern stripped down carbon fibre race bikes, state of the art touring machines and humble shoppers, tandems, tandem trikes, racing trikes and shopping trikes, mountain and BMX bikes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "841d585f-acfc-313e-b25a-1e8a9bb239b6",
                                        "entry_id": "26176ddf-8853-320a-a18a-3dc2e3327038",
                                        "glosses": [
                                            "A plastic shopping bag."
                                        ],
