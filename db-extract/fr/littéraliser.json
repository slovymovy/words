                ],
                "senses": [
                    {
                        "sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                        "entry_id": "a8905513-f473-372e-b931-b2034bff35d2",
                        "glosses": [
                            "Donner un caractère littéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c272e7c0-fd8e-4dc7-8f43-b78de96fc2b6",
                                "sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                                "text": "@Abdessalam, tout à fait, mais c'est une tendance bien trop ancrée que de vouloir arabiser / \"littéraliser\" la darija."
                            },
                            {
                                "example_id": "f47d9c19-ad52-427d-b049-18bda6481de7",
                                "sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                                "text": "Ce sens clair se rattache au programme galiléen : une science entreprend de littéraliser une matière contingente."
                            },
                            {
                                "example_id": "88aa7cbb-76ba-4b68-a481-55f394dd55b6",
                                "sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                                "text": "L'écrivain voyage-t-il pour littéraliser ses découvertes ou est-ce les aventures du voyage qui créent l'appétence d'écriture ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d345490-2df9-4abd-877e-d419ef06e4d8",
                        "source_entry_id": "a8905513-f473-372e-b931-b2034bff35d2",
                        "source_sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                        "target_lang_word": "literalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "literalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "206aa11c-765c-380a-b7ef-ce158b4555bb",
                                        "entry_id": "78ed859c-d6f2-3e62-9f5e-9e1b3aafed3f",
                                        "glosses": [
                                            "To make literal or prosaic"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c62c00-391a-4187-a2d7-bb530d7165a2",
                                                "sense_id": "206aa11c-765c-380a-b7ef-ce158b4555bb",
                                                "text": "The popular \"peephole\" style of cover art, suggesting stolen glimpses into exotic interior territories at once psychological and geographical, literalized the voyeuristic appeal of early postwar paperback art."
                                            },
                                            {
                                                "example_id": "67855af3-7755-40ce-a354-d4fa6c43392f",
                                                "sense_id": "206aa11c-765c-380a-b7ef-ce158b4555bb",
                                                "text": "The band seemed at the start to literalize a mysterious piece of writing; its structure was clear when this band played it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "390be25a-3123-4fb9-bdd0-15d880f4170c",
                        "source_entry_id": "a8905513-f473-372e-b931-b2034bff35d2",
                        "source_sense_id": "614283a4-67f0-31e6-9f1e-e64f09b8c4d7",
                        "target_lang_word": "literalise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "literalise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8077ce15-85a3-324a-9478-3c52e44d96fa",
                                        "entry_id": "58e04bac-4780-3f7c-b1d7-9bdfa05bde1e",
                                        "glosses": [
                                            "Alternative form of literalize."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc44dbb-9fb4-440f-9129-992610cb647e",
                                                "sense_id": "8077ce15-85a3-324a-9478-3c52e44d96fa",
                                                "text": "Its highest-concept blockbuster to date, Inside Out (Disney, U), dares to literalise this process, guiding viewers’ feelings by personifying them, placing them at the centre of a narrative they’d usually accompany."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
