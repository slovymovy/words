                "senses": [
                    {
                        "sense_id": "09b92097-2833-3f10-bf73-bdbc6231b735",
                        "entry_id": "6d42c6dd-1c34-31ea-a604-d06edb19a3f5",
                        "glosses": [
                            "Donner un caractère diamagnétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b37fa5f1-3bc2-49ac-b55f-4003be638c26",
                                "sense_id": "09b92097-2833-3f10-bf73-bdbc6231b735",
                                "text": "Concentrer son attention, la diriger sur la peau des mains et diamagnétiser par poses, immédiatement avant de les employer, les divers remèdes en question."
                            },
                            {
                                "example_id": "c9057511-160d-4b05-a761-d7b74433f620",
                                "sense_id": "09b92097-2833-3f10-bf73-bdbc6231b735",
                                "text": "C'est la science de l'infiniment petit qui nous permet de comprendre comment les atomes vibrent et comment nous pouvons provoquer une oscillation générale du réseau cristallin pour diamagnétiser le corps et altérer la matière à distance à l'aide d'ondes longitudinales complexes bien pulsées et sans se brûler comme certains yogi."
                            },
                            {
                                "example_id": "2d371d36-8636-4c11-ab2f-283bf15815b3",
                                "sense_id": "09b92097-2833-3f10-bf73-bdbc6231b735",
                                "text": "Le yacht émergea lentement du hangar, flottant à quelques centimètres au-dessus du sol grâce à sa coque diamagnétisée, massif comme une baleine."
                            }
                        ]
                    }
