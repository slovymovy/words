                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A brawler or disputant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8613f2-51e7-431b-aeca-6ee686f4c071",
                                                "sense_id": "43b49651-66fb-30ea-b380-ebe1a7f46819",
                                                "text": "The Seas and Windes (old Wranglers) tooke a Truce, / And did him ſeruice; he touch'd the Ports desir'd,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94961ed-fad9-3679-ad8e-72882f51546d",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A cowboy who takes care of saddle horses."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f88b448a-fd9f-4349-9bd8-5d286f3a1d3e",
                                                "sense_id": "d94961ed-fad9-3679-ad8e-72882f51546d",
                                                "text": "Even as I stretched my arms and shivered a little, the two wranglers threw down their tin plates with a clatter, mounted horses and rode away in the direction of the thousand acres or so known as the pasture."
                                            }
                                        ]
                                    },
                                    {
