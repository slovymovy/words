                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12329447-25d3-4af8-a28f-bf1f73faa04f",
                                                "sense_id": "1aed5e83-698c-3f3d-a627-8acc7856286e",
                                                "text": "Mattotaupa und Harka können die Schwarzfußindianer durch ihre Leistungen überzeugen, sie bei sich aufzunehmen."
                                            },
                                            {
                                                "example_id": "b9a0ef78-f4c8-4470-9bf5-f89df7693ebe",
                                                "sense_id": "1aed5e83-698c-3f3d-a627-8acc7856286e",
                                                "text": "Auch die Religion der Schwarzfußindianer wurde nach derselben Schablone beurteilt."
                                            }
