                "senses": [
                    {
                        "sense_id": "705827f3-c41d-338b-a991-523f04db4877",
                        "entry_id": "1a118d25-76ae-3d4f-aa57-21a1be7431e3",
                        "glosses": [
                            "Personne qui rage."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cb3d5175-1b32-4085-b23b-5e6a7fa9b324",
                                "sense_id": "705827f3-c41d-338b-a991-523f04db4877",
                                "text": "La rageuse est venue vingt-sept fois me demander vingt francs."
                            },
                            {
                                "example_id": "cb517838-4876-48ff-942e-90f792b5fb46",
                                "sense_id": "705827f3-c41d-338b-a991-523f04db4877",
                                "text": "Les pleureuses sont devenues des rageuses, – mais pas plus les pleurs que les colères ne nous feront repentir d’avoir exprimé sur le père Hyacinthe les seuls sentiments qu’il puisse désormais inspirer."
                            },
                            {
                                "example_id": "ccf9f00e-cb79-4140-b1e0-1bb826164c15",
                                "sense_id": "705827f3-c41d-338b-a991-523f04db4877",
                                "text": "Un soir, je me suis battue avec un petit groupe qui s'était formé pour faire en sorte que je sois mise à la porte. Elles se sont acharnées et je peux affirmer, qu’il n’y a pas pire que les femmes. Ce sont des rageuses, des vicieuses, des menteuses et des garces pour une bonne partie…"
                            }
                        ]
                    }
