                "entry_id": "c8664393-967d-307f-9ace-2036d34c54ef",
                "word": "homosexualisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6274a98-d08e-4da1-82dd-4efecb17d26c",
                        "entry_id": "c8664393-967d-307f-9ace-2036d34c54ef",
                        "tags": [
                            "plural"
                        ],
