                    },
                    {
                        "translation_id": "7629b977-60f3-40f7-8713-e39064757b7c",
                        "source_entry_id": "d5b3deda-e4ff-36d7-afe5-721ada4f4bf1",
                        "source_sense_description": "day when God is expected to judge the world",
                        "target_lang_word": "Jüngstes Gericht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jüngstes Gericht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea3c029-3e52-39fa-87c4-7fe0968c5d23",
                                        "entry_id": "e17f6636-95d1-3950-9e43-2ce321c4969a",
                                        "glosses": [
                                            "das das Weltgeschehen abschließende, allgemeine göttliche Gericht am Ende der Zeiten"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f20e324-443a-4387-8ab5-cb13f8203168",
                                                "sense_id": "6ea3c029-3e52-39fa-87c4-7fe0968c5d23",
                                                "text": "Entsprechend der Bedeutung des Jüngsten Gerichts im christlichen Mittelalter findet man zahlreiche bildliche Darstellungen von der Romanik bis in die Renaissance, vor allem aber in der Gotik."
                                            },
                                            {
                                                "example_id": "6170cfd0-f1b1-47f2-a031-30c6bb714f56",
                                                "sense_id": "6ea3c029-3e52-39fa-87c4-7fe0968c5d23",
                                                "text": "„Das Jünste Gericht wird in Filmen so gut wie nie dargestellt, weil die Regisseure ihren Zuschauern wahrscheinlich nicht vorzeitig die gute Laune verderben wollen.“"
                                            },
                                            {
                                                "example_id": "946a2902-758e-490e-a371-01036af9b08e",
                                                "sense_id": "6ea3c029-3e52-39fa-87c4-7fe0968c5d23",
                                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                                            },
                                            {
                                                "example_id": "afe4193a-e849-4eeb-94a8-ad422c5f2d35",
                                                "sense_id": "6ea3c029-3e52-39fa-87c4-7fe0968c5d23",
                                                "text": "„Seit dem Ausbleiben der Apokalypse bei den frühen Christen gehört das Organisieren der Zeit bis zum Jüngsten Gericht zum Kerngeschäft der römischen Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
