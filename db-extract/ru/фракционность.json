                "senses": [
                    {
                        "sense_id": "0b908683-3789-303f-8418-bf95ac106a90",
                        "entry_id": "1d927ef7-c096-3d3a-98a6-3e8bb9c374d1",
                        "glosses": [
                            "книжн. свойство по значению прилагательного фракционный; наличие фракций в составе чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d9fcf5-27f6-4adf-97e5-11eb97287043",
                                "sense_id": "0b908683-3789-303f-8418-bf95ac106a90",
                                "text": "В этом-то и коренятся причины неистребимой фракционности, а проще говоря ― групповщины или семейственности, которые пронизывают общественную и политическую жизнь Японии, проникая даже в деловой мир."
                            },
                            {
                                "example_id": "1e271443-1ad1-4670-b3fe-9981ee7f4c00",
                                "sense_id": "0b908683-3789-303f-8418-bf95ac106a90",
                                "text": "Сырье и материалы классифицируются так: цемент — по маркам, лес — по сортам, сталь — по маркам, гравий, песок, щебень и другие заполнители — по весу, фракционности, гранулометрическому составу и т. д."
                            }
                        ]
                    }
