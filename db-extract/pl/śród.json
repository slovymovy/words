            {
                "entry_id": "e564a373-b957-3b03-a9fb-413d30d1a8c7",
                "word": "śród",
                "pos": "prep",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "026e9be8-5b06-3dc4-88eb-c4444813c15b",
                        "entry_id": "e564a373-b957-3b03-a9fb-413d30d1a8c7",
                        "glosses": [
                            "in der Mitte von, inmitten, mitten, unter"
                        ],
                        "tags": [
                            "archaic",
                            "genitive prepositional"
                        ],
                        "examples": [
                            {
                                "example_id": "5298d660-95ab-4f01-9614-61a7a37e5428",
                                "sense_id": "026e9be8-5b06-3dc4-88eb-c4444813c15b",
                                "text": "„Zamek na barkach nowogródzkiéj góry / Od miesięcznego brał pozłotę blasku, / Po wałach z darni, i po sinym piasku, / Olbrzymim słupem łamał się cień bury / Spadając w fossę, gdzie śród wiecznych cieśni, / Dyszała woda spod zielonych pleśni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da7f0c15-46c0-4ee3-8071-db3f4e8b5ecf",
                        "source_entry_id": "e564a373-b957-3b03-a9fb-413d30d1a8c7",
                        "source_sense_id": "026e9be8-5b06-3dc4-88eb-c4444813c15b",
                        "source_sense_description": "veraltet, Präposition mit Genitiv: in der Mitte von, inmitten, mitten, unter",
                        "target_lang_word": "inmitten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inmitten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                        "entry_id": "23565a80-a100-320d-86f9-80f1ed77eb40",
                                        "glosses": [
                                            "mitten in, mitten unter"
                                        ],
                                        "tags": [
                                            "mit Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4bc6d2-3463-46b0-8ef6-bfa12b173ffb",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "Inmitten einer Menschenansammlung habe ich deinen Freund getroffen."
                                            },
                                            {
                                                "example_id": "fc38b2cf-65db-416b-b349-4a9bfaa0be01",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "„Immerhin fiel inmitten des weltweit verbreiteten Schwachsinns ein kritischer Nebenton auf.“"
                                            },
                                            {
                                                "example_id": "82173f10-6371-4857-bf21-2026aacdcdbf",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "„Muskau, heute etwas großspurig »Bad«, den Adelstitel für Gemeinden tragend, war vor 200 Jahren ein kaum erwähnenswertes Immediatstädtchen inmitten der gleichnamigen Standesherrschaft, die eine der größten Deutschlands war.“"
                                            },
                                            {
                                                "example_id": "cae14b21-0cbe-411f-8530-632726eb40d4",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "Der Schwan saß inmitten des Teichs."
                                            },
                                            {
                                                "example_id": "987d6503-6196-492e-ac8d-481226f44157",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "„Der Ort inmitten des von Nomadenstämmen beherrschten Wüstenlandes entwickelt sich über Jahrhunderte zu einem florierenden Umschlagplatz.“"
                                            },
                                            {
                                                "example_id": "d8ff8dec-a582-4152-8540-b8ff94c1d2b5",
                                                "sense_id": "9649610a-bf38-3f47-b7ca-a1b660e9bef8",
                                                "text": "„Neben dem rechtsextremistischen Gewaltpotenzial gehörten die Abgründe an Häme und Hass inmitten unserer Gesellschaft gegenüber denen, die in unserem Land Verantwortung übernähmen, zu den beklemmenden Erfahrungen der jüngsten Tage, sagte Schäuble.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "inmitten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7404f74-a100-3ea4-ada4-edeadcf650da",
                                        "entry_id": "48fe7fa6-d588-3393-9b88-225401d6c9ee",
                                        "glosses": [
                                            "mitten in, mitten unter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26bd523d-da77-4e1e-b438-c99ea2c37ba5",
                                                "sense_id": "a7404f74-a100-3ea4-ada4-edeadcf650da",
                                                "text": "Er fand sich inmitten von Fans der gegnerischen Mannschaft wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f74513e7-c2e8-4a22-a133-03bcf9856498",
                        "source_entry_id": "e564a373-b957-3b03-a9fb-413d30d1a8c7",
                        "source_sense_id": "026e9be8-5b06-3dc4-88eb-c4444813c15b",
                        "source_sense_description": "veraltet, Präposition mit Genitiv: in der Mitte von, inmitten, mitten, unter",
                        "target_lang_word": "mitten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e181dc16-7adc-3939-8d9c-29e8ed78d0b7",
                                        "entry_id": "fac48e72-efc5-30bf-a480-3a5623222e26",
                                        "glosses": [
                                            "in der Mitte, in die Mitte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89c3cc6-59d2-4fd8-bcdb-8352fe5e9568",
                                                "sense_id": "e181dc16-7adc-3939-8d9c-29e8ed78d0b7",
                                                "text": "Mitten in der Nacht, ich schlief tief und fest, kam der Anruf."
                                            },
                                            {
                                                "example_id": "9ad6e788-7a55-4795-940b-2db5de94c18e",
                                                "sense_id": "e181dc16-7adc-3939-8d9c-29e8ed78d0b7",
                                                "text": "Holzhäuser schmiegen sich in die Hügel, Nachbarn schwatzen, Katzen streunen, langhalsige Palmen stehen im Abendrot. Es herrscht kleinstädtische Stille mitten im Moloch."
                                            },
                                            {
                                                "example_id": "35e77b19-cb06-46a6-8c87-d816adb3d473",
                                                "sense_id": "e181dc16-7adc-3939-8d9c-29e8ed78d0b7",
                                                "text": "„Produziert in einem derartigen Telegrammstil, erweckt es vielleicht den Eindruck, als hätte ich mitten in einer Naturkatastrophe gesteckt, und meine Freunde wollten wissen, ob ich sie überlebte.“"
                                            },
                                            {
                                                "example_id": "e7684b9e-61a2-4ea9-860c-66ab28c3072f",
                                                "sense_id": "e181dc16-7adc-3939-8d9c-29e8ed78d0b7",
                                                "text": "„Mitten in dem vergnügten Gewimmel der heimkehrenden Sportler standen drei Neger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
