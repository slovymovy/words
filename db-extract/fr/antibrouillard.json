                        "cross_references": [
                            {
                                "target_word": "Nebelscheinwerfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd287e5-3ad9-3a7e-a4d0-a5113067ad36",
                                        "entry_id": "059f858e-24d4-315b-8412-acbfabc49506",
                                        "glosses": [
                                            "vordere Fahrzeugbeleuchtung, welche die Straße bei Nebel besser ausleuchten soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c990fc2-c016-4b81-8618-25178bb2f368",
                                                "sense_id": "dbd287e5-3ad9-3a7e-a4d0-a5113067ad36",
                                                "text": "„Nebelscheinwerfer müssen so angebracht sein, dass ihre Lichtaustrittsfläche nicht höher liegt als der höchste Punkt der Lichtaustrittsfläche der Scheinwerfer, mit denen Abblendlicht ausgestrahlt werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
