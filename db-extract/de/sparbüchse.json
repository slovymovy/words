                "translations": [
                    {
                        "translation_id": "2846b21d-536d-4c70-8642-86311ea84d10",
                        "source_entry_id": "c8041691-0f16-371c-8800-c84f9359aca7",
                        "source_sense_id": "84c0cddd-6853-31c7-b722-fbb8919f61e7",
                        "source_sense_description": "Behältnis, in dem man Kleingeld sammelt, um es zu sparen",
                        "target_lang_word": "piggy-bank",
