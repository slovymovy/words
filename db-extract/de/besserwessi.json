                    {
                        "form_id": "7a7db243-30bd-4233-b21e-5d753b981233",
                        "entry_id": "68e8ca86-513c-373d-ab61-dc26e1547c95",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Besserwessis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3968768-2a0a-383e-82df-66080cf72ae5",
                        "entry_id": "68e8ca86-513c-373d-ab61-dc26e1547c95",
                        "glosses": [
                            "Westdeutscher, der Ostdeutschen gegenüber ein arrogantes, besserwisserisches Verhalten an den Tag legt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "71163c96-0ff4-41a5-a8de-f15a3ea45d8d",
                                "sense_id": "d3968768-2a0a-383e-82df-66080cf72ae5",
                                "text": "„Wer hätte am 10. November 1989 vermutet, dass wir knapp 21 Jahre später nach wie vor von Ost und West, von Menschen „zweiter Klasse“ oder von Jammerossi und Besserwessi sprechen?“"
                            },
                            {
                                "example_id": "4e7d7353-89ed-4ff2-aead-dafbdbddcd83",
                                "sense_id": "d3968768-2a0a-383e-82df-66080cf72ae5",
                                "text": "„Dafür ist er gelobt worden und schwer beschimpft. Immer wieder von ostdeutschen Sportfunktionären, die Frankes Aufklärung über den pharmakologischen Unterbau des DDR-Sports als Machwerk eines einäugigen Besserwessis betrachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
