                "senses": [
                    {
                        "sense_id": "043c283a-0b4f-32ce-be0f-b73380baf6c9",
                        "entry_id": "8fdfe3b9-8501-3d13-a6ea-381e64764133",
                        "glosses": [
                            "Gruppe von Schauspielern eines Theaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76fbd009-c767-4cef-9126-c5ff77c5b387",
                                "sense_id": "043c283a-0b4f-32ce-be0f-b73380baf6c9",
                                "text": "„Sei es nun aus Unbeständigkeit oder aus Gründen der Eifersucht, jedenfalls verließ er die Fragoletta und wurde in Venedig Mitglied einer Schauspieltruppe, die im Theater San Samuele spielte.“"
                            },
                            {
                                "example_id": "8d0718b0-6fae-4014-b1d6-14bc0c65de46",
                                "sense_id": "043c283a-0b4f-32ce-be0f-b73380baf6c9",
                                "text": "„Es wanderten einzelne Dramen Shakespeares durch die deutschen Länder, so wie die einzelnen Schauspieltruppen ihren Weg machten, einen »Shakespeare« kannte man nicht.“"
                            },
                            {
                                "example_id": "4cec390d-e46b-4d12-ba07-4aa583efef75",
                                "sense_id": "043c283a-0b4f-32ce-be0f-b73380baf6c9",
                                "text": "„Es war an Palermo adressiert, wo die Schauspieltruppe eine Woche, nachdem Skúli nach Hólmavík gefahren und es zur Post gebracht hatte, gastieren sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
