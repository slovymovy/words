                "senses": [
                    {
                        "sense_id": "ca087027-b100-301c-b6e1-0b1fc8ae9cda",
                        "entry_id": "6331630c-eb2b-38ce-b500-85c13e99965b",
                        "glosses": [
                            "van iets dat het iemand emotioneel raakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095a925a-3a9e-49d3-8add-e70530dcd757",
                                "sense_id": "ca087027-b100-301c-b6e1-0b1fc8ae9cda",
                                "text": "Het resultaat mocht er zijn en bleek een enorme verrassing voor tekenaar Paul Kusters uit Maastricht. „Ik wist dat Toos & Henk geliefd zijn in de krant, maar dat zoveel lezers de moeite namen te mailen en brieven te sturen met originele teksten is hartroerend.”"
                            },
                            {
                                "example_id": "98c93e92-800e-4ddf-85be-242782f80550",
                                "sense_id": "ca087027-b100-301c-b6e1-0b1fc8ae9cda",
                                "text": "Het is een uitgangspunt waar regisseur Reiner vroeger mogelijk een vlotte en hartroerende komedie mee had gemaakt. Nu komt het allemaal niet meer lekker uit de verf. De humor is oubollig en het verhaal verloopt teleurstellend veilig volgens het boekje."
                            }
                        ]
                    }
