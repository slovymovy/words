                        "glosses": [
                            "IT-technische Veranstaltung, bei der Kryptographietechniken für E-Mails und die Arbeit im Internet vermittelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2441d281-f28c-462e-b0e5-189f453633da",
                                "sense_id": "639a9d1f-714f-3196-8134-e85837393000",
                                "text": "„Piraten saßen auf Podien und in Fernsehstudios und lehrten Bürger auf Kryptopartys wie sie ihre Mails verschlüsseln.“"
                            },
                            {
                                "example_id": "ab96e755-8242-4f14-b6e4-ca735ea09252",
                                "sense_id": "639a9d1f-714f-3196-8134-e85837393000",
                                "text": "„Die Big Brother Awards sind dieses Jahr erstmals Teil der Privacy Week, eine Veranstaltungsreihe zum Thema Privatsphäre, die in Wien noch bis zum 30.10. mit spannenden Vorträgen und einer ‚Kryptoparty‘ am Donnerstagabend läuft.“"
                            }
                        ],
