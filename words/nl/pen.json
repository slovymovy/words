                {
                    "sense_id": "d26253e0-9915-3066-9c1d-cf6985ffb7ca",
                    "sense_definition": "Het metalen uiteinde van een vulpen waarmee de inkt over het papier verdeeld wordt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_tool_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>pen</w> van mijn vulpen is verbogen en krast nu.",
                            "target_lang_translations": {
                                "en": "The <w>nib</w> of my fountain pen is bent and scratches now.",
                                "ru": "<w>Перо</w> моей ручки погнулось и теперь царапает.",
                                "pl": "<w>Stalówka</w> mojego pióra wiecznego jest wygięta i teraz drapie.",
                                "de": "Die <w>Feder</w> meines Füllfederhalters ist verbogen und kratzt jetzt.",
                                "fr": "La <w>plume</w> de mon stylo-plume est tordue et gratte maintenant.",
                                "it": "Il <w>pennino</w> della mia penna stilografica è piegato e ora graffia.",
                                "cs": "<w>Hrot</w> mého plnicího pera je ohnutý a teď škrábe.",
                                "tr": "Dolma kalemimin <w>ucu</w> büküldü ve şimdi çiziyor.",
                                "es": "El <w>plumín</w> de mi pluma estilográfica está doblado y ahora raspa."
                            }
                        },
                        {
                            "text": "Je moet de <w>pen</w> voorzichtig schoonmaken als de inkt is opgedroogd.",
                            "target_lang_translations": {
                                "en": "You must clean the <w>nib</w> carefully if the ink has dried up.",
                                "ru": "Нужно осторожно очистить <w>перо</w>, если чернила засохли.",
                                "pl": "Musisz ostrożnie wyczyścić <w>stalówkę</w>, jeśli atrament zasechł.",
                                "de": "Du musst die <w>Feder</w> vorsichtig reinigen, wenn die Tinte eingetrocknet ist.",
                                "fr": "Il faut nettoyer délicatement la <w>plume</w> si l'encre a séché.",
                                "it": "Devi pulire attentamente il <w>pennino</w> se l'inchiostro si è asciugato.",
                                "cs": "Pokud inkoust zaschl, musíte <w>hrot</w> opatrně vyčistit.",
                                "tr": "Mürekkep kuruduğunda <w>ucu</w> dikkatlice temizlemelisin.",
                                "es": "Debes limpiar la <w>plumilla</w> con cuidado si la tinta se ha secado."
                            }
                        }
