                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a3b827-9d2f-4cdd-8eeb-021e57d6a954",
                                                "sense_id": "8a4d1d3a-1106-3c90-960d-045ac3846146",
                                                "text": "Der Motor besitzt eine Einführung für den Messstab zur Kontrolle des Ölstandes."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "4d6aa528-88dc-389c-82c1-b8521437cca2",
