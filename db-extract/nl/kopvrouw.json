                            {
                                "example_id": "4e796302-d2bb-4009-a07a-89b32e85f9df",
                                "sense_id": "4efb4fc3-1cee-3d57-bdb4-f36712a6b7e6",
                                "text": "Nederland miste in Den Bosch kopvrouw Kiki Bertens, die de voorkeur gaf aan haar eigen carrière. De kans is uiterst miniem dat ze tegen Japan wel van de partij zal zijn, omdat dan het gravelseizoen volop bezig is."
                            },
                            {
                                "example_id": "09e00e6c-f541-4886-9d2b-8b5ac77e2b7d",
                                "sense_id": "4efb4fc3-1cee-3d57-bdb4-f36712a6b7e6",
                                "text": "Vos, de 31-jarige kopvrouw van WaowDeals Pro Cycling, viert in Groot-Brittannië haar rentree in het peloton. Ze is helemaal hersteld van een sleutelbeenbreuk, die ze op 22 april opliep bij een valpartij in Luik-Bastenaken-Luik. De Ronde van Groot-Brittannië voor vrouwen eindigt zondag."
                            }
                        ]
