                ],
                "senses": [
                    {
                        "sense_id": "91cf3fce-cece-35b0-8dcc-8c60f5b4be23",
                        "entry_id": "a7ebcfea-c595-377d-af87-22bd76c10038",
                        "glosses": [
                            "школьн. оценка «два»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35034d46-17e5-49fc-b969-a4222da13fe8",
                                "sense_id": "91cf3fce-cece-35b0-8dcc-8c60f5b4be23",
                                "text": "Три двояка за один день."
                            },
                            {
                                "example_id": "6dec7987-f69a-4cff-b0d0-66a4e1c70373",
                                "sense_id": "91cf3fce-cece-35b0-8dcc-8c60f5b4be23",
                                "text": "Он даже не удосужился исправить двояк."
                            }
                        ]
                    },
                    {
                        "sense_id": "bde87747-fff7-37af-a818-56f5bea0a547",
                        "entry_id": "a7ebcfea-c595-377d-af87-22bd76c10038",
                        "glosses": [
                            "устар. круглая балка длинной 18 футов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca1015a0-9fcf-481d-ab28-704f5980b27b",
                                "sense_id": "bde87747-fff7-37af-a818-56f5bea0a547",
                                "text": "Двояки, или медловки, заготавливались в западных губерниях."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dc04c57-4ce2-3138-a909-f0e190a2b1d3",
                        "entry_id": "a7ebcfea-c595-377d-af87-22bd76c10038",
                        "glosses": [
                            "устар. вид брусового леса; сосновый брус 15/15 дюймов, при распиловки которого выходил шлипер, две шпалы и отброс, в виде бруска 5/5 дюймов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb414ee5-81aa-4c21-b595-a4a5f0d5d525",
                                "sense_id": "1dc04c57-4ce2-3138-a909-f0e190a2b1d3",
                                "text": "Двояки вывозились за границы."
                            }
                        ]
                    }
