        "fr-extract.jsonl": [
            {
                "entry_id": "ab5d674b-a18c-3d75-934c-78232bc55201",
                "word": "catharsis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "82da7d3a-99a8-3d28-af4d-253a54ee2d37",
                        "entry_id": "ab5d674b-a18c-3d75-934c-78232bc55201",
                        "glosses": [
                            "Purification des passions (selon Aristote) chez le spectateur d’une représentation dramatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2e2ce9-3902-47ea-9f59-79527e4c8107",
                                "sense_id": "82da7d3a-99a8-3d28-af4d-253a54ee2d37",
                                "text": "La catharsis fait intervenir une représentation d’un acte réprimé (par la morale, voire par la Loi) ainsi que sa punition, et c’est cette représentation qui dégoûte le spectateur de sa passion."
                            }
                        ]
                    },
                    {
                        "sense_id": "07be2686-211b-3ab9-a10b-6384650e57b4",
                        "entry_id": "ab5d674b-a18c-3d75-934c-78232bc55201",
                        "glosses": [
                            "Thérapie utilisant l’extériorisation des traumatismes vécus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04043590-cd4f-497b-8ded-02535a9ac6f7",
                                "sense_id": "07be2686-211b-3ab9-a10b-6384650e57b4",
                                "text": "Ce qui a été réprimé veut se libérer, manifeste le besoin de s’exprimer : c’est la catharsis."
                            },
                            {
                                "example_id": "9274177d-005f-4729-81c2-f0582e6ca3f6",
                                "sense_id": "07be2686-211b-3ab9-a10b-6384650e57b4",
                                "text": "[…] une catharsis, une liquidation, dont l’activité littéraire – et particulièrement la littérature dite « de confession » – apparaît l’un des plus commodes instruments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a4ca90-8c3c-4137-83eb-28e972e8c3a3",
                        "source_entry_id": "ab5d674b-a18c-3d75-934c-78232bc55201",
