{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "789a31d2-eed3-320f-9dbc-4fcc4cd62d6c",
                    "sense_definition": "Any person or any one out of an indefinite number of people",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indefinite_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is there <w>anybody</w> in the kitchen right now?",
                            "target_lang_translations": {
                                "ru": "Есть <w>кто-нибудь</w> на кухне прямо сейчас?"
                            }
                        },
                        {
                            "text": "I do not think <w>anybody</w> can solve this difficult puzzle.",
                            "target_lang_translations": {
                                "ru": "Я не думаю, что <w>кто-то</w> сможет решить эту сложную головоломку."
                            }
                        },
                        {
                            "text": "If <w>anybody</w> calls for me please take a message.",
                            "target_lang_translations": {
                                "ru": "Если <w>кто-нибудь</w> будет меня спрашивать, пожалуйста, примите сообщение."
                            }
                        }
                    ],
                    "synonyms": [
                        "anyone"
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "if anybody calls",
                        "hardly anybody",
                        "is anybody there"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой человек или кто-либо из неопределенного числа людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто-нибудь",
                                "target_lang_sense_clarification": "в вопросах и утверждениях о будущем"
                            },
                            {
                                "target_lang_word": "кто-либо",
                                "target_lang_sense_clarification": "более формальный вариант"
                            },
                            {
                                "target_lang_word": "никто",
                                "target_lang_sense_clarification": "в отрицательных предложениях"
                            },
                            {
                                "target_lang_word": "любой",
                                "target_lang_sense_clarification": "в значении «каждый»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "271babf6-3858-366a-8fc1-c5a464f61069",
                    "sense_definition": "A person of importance, consideration, or high social standing",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "important_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked very hard because he really wanted to be <w>anybody</w> in this town.",
                            "target_lang_translations": {
                                "ru": "Он очень много работал, потому что очень хотел стать <w>кем-то значимым</w> в этом городе."
                            }
                        },
                        {
                            "text": "In that exclusive club you are not <w>anybody</w> unless you own a yacht.",
                            "target_lang_translations": {
                                "ru": "В этом эксклюзивном клубе ты <w>никто</w>, если у тебя нет яхты."
                            }
                        }
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "want to be anybody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важный, значимый человек или лицо с высоким социальным положением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важная персона",
                                "target_lang_sense_clarification": "человек, имеющий вес в обществе"
                            },
                            {
                                "target_lang_word": "важная птица",
                                "target_lang_sense_clarification": "разговорное о влиятельном человеке"
                            },
                            {
                                "target_lang_word": "большая шишка",
                                "target_lang_sense_clarification": "разговорное о начальнике или влиятельном лице"
                            },
                            {
                                "target_lang_word": "кто-то значимый",
                                "target_lang_sense_clarification": "в контексте стремления к успеху"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}