                "senses": [
                    {
                        "sense_id": "d68ab97e-2cad-3a24-84de-91eec6737748",
                        "entry_id": "d3b7ae7a-e6e1-3133-b317-08dd7cb839b2",
                        "glosses": [
                            "ogół blogów traktowanych jako przestrzeń społeczna i publicystyczna autorów oraz ich czytelników"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "b7021461-3692-47f2-ab38-034c4f1281ba",
                                "sense_id": "d68ab97e-2cad-3a24-84de-91eec6737748",
                                "text": "Za chwilę zagra w szachy, ale wcześniej podzieli się swymi uczuciami z internautami. Otworzył swój blog, wszedł w blogosferę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34743c41-fbca-4aa8-976b-6bc9cf94de28",
                        "source_entry_id": "d3b7ae7a-e6e1-3133-b317-08dd7cb839b2",
                        "source_sense_id": "d68ab97e-2cad-3a24-84de-91eec6737748",
                        "target_lang_word": "blogosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blogosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                        "entry_id": "6112bd62-a7ae-3fa5-906a-41e523ca1017",
                                        "glosses": [
                                            "The totality of blogs, especially the unique jargon, cultures and shared interests created by their interconnection."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca268126-5776-4c6c-a319-2eac0a6f04f8",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "2004 Air America Radio http://www.airamericaradio.com/\nRegular guest and blogger, Kos of DailyKos.com, provides Sam and Janeane the latest information from the blogosphere."
                                            },
                                            {
                                                "example_id": "5a123103-fe69-4902-bd97-83559a8c4142",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "The blogosphere is relentless: It rightfully hammered Eason Jordan and CNN from day one and refuses to stop."
                                            },
                                            {
                                                "example_id": "23fa6098-0a68-4f4e-8e41-11f1397d446b",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "there's some talk, as you said, on the blogosphere, that this book is controversial, but I think more properly it's a contribution..."
                                            },
                                            {
                                                "example_id": "29809c7b-738d-49f8-b57a-e05128ab771e",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "And the liberal blogosphere has long labeled Clinton part of the neoconservative wing, a conservative intellectual movement that supports an interventionist foreign policy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0982647-0947-4281-8b46-f173b3e83421",
                        "source_entry_id": "d3b7ae7a-e6e1-3133-b317-08dd7cb839b2",
                        "source_sense_id": "d68ab97e-2cad-3a24-84de-91eec6737748",
                        "target_lang_word": "blogosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blogosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                        "entry_id": "7e69dc38-4600-3784-9633-f3b8085bf008",
                                        "glosses": [
                                            "Communauté des blogueurs, ensemble des blogues."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe094f45-49cc-4802-afab-141552b4bebe",
                                                "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                                "text": "La blogosphère se déchaîne après la venue d’hommes politiques à la conférence sur le Web de demain."
                                            },
                                            {
                                                "example_id": "64ec715e-50a8-465a-b4fa-5c1a50aadd24",
                                                "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                                "text": "Avec l’augmentation du nombre de blogs, le phénomène du pollupostage (spam), à l'origine associé seulement au courrier électronique, pénètre aujourd'hui la blogosphère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
