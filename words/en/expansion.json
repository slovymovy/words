{
    "word_family": [
        "expand",
        "expansive",
        "expansively",
        "expansiveness",
        "expansible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b455dd83-34a3-3899-94eb-0729d839a18c",
                    "sense_definition": "The act of becoming larger in size, volume, quantity, or scope, or the state of being expanded.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "growth_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heat causes the <w>expansion</w> of metals and gases.",
                            "target_lang_translations": {
                                "ru": "Нагревание вызывает <w>расширение</w> металлов и газов.",
                                "zh": "热量会导致金属和气体的<w>膨胀</w>。"
                            }
                        },
                        {
                            "text": "The rapid <w>expansion</w> of the city has led to increased traffic congestion.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>разрастание</w> города привело к увеличению пробок.",
                                "zh": "城市规模的迅速<w>扩张</w>导致了交通拥堵加剧。"
                            }
                        }
                    ],
                    "antonyms": [
                        "contraction",
                        "shrinkage"
                    ],
                    "common_phrases": [
                        "rapid expansion",
                        "thermal expansion",
                        "business expansion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс увеличения в размере, объеме, количестве или масштабе, или состояние расширенности.",
                        "zh": "指体积、数量、范围或规模变大的过程或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширение",
                                "target_lang_sense_clarification": "увеличение объема или площади"
                            },
                            {
                                "target_lang_word": "увеличение",
                                "target_lang_sense_clarification": "рост количества или размера"
                            },
                            {
                                "target_lang_word": "разрастание",
                                "target_lang_sense_clarification": "города или ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扩张",
                                "target_lang_sense_clarification": "指势力、范围或规模的扩大"
                            },
                            {
                                "target_lang_word": "膨胀",
                                "target_lang_sense_clarification": "指体积或数量的增大"
                            },
                            {
                                "target_lang_word": "扩展",
                                "target_lang_sense_clarification": "指范围或领域的延伸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cdf5e28-8baa-3e8b-9983-43612b40753f",
                    "sense_definition": "A new room, wing, or section added to an existing building or structure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My new office is located in the <w>expansion</w> behind the main building.",
                            "target_lang_translations": {
                                "ru": "Мой новый офис находится в <w>пристройке</w> за главным зданием.",
                                "zh": "我的新办公室位于主楼后面的<w>扩建部分</w>。"
                            }
                        },
                        {
                            "text": "The museum is planning a large <w>expansion</w> to house its modern art collection.",
                            "target_lang_translations": {
                                "ru": "Музей планирует масштабное <w>расширение</w> для размещения коллекции современного искусства.",
                                "zh": "博物馆正计划进行大规模<w>扩建</w>，以容纳其现代艺术收藏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annex"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новое помещение, крыло или секция, пристроенные к существующему зданию.",
                        "zh": "在现有建筑物或结构上增建的新房间、侧翼或部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристройка",
                                "target_lang_sense_clarification": "часть здания"
                            },
                            {
                                "target_lang_word": "расширение",
                                "target_lang_sense_clarification": "процесс или результат достройки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扩建部分",
                                "target_lang_sense_clarification": "指建筑物增建的部分"
                            },
                            {
                                "target_lang_word": "附属建筑",
                                "target_lang_sense_clarification": "指附属于主体的建筑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                    "sense_definition": "A period of economic growth characterized by a rise in market value and business activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "growth_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country is currently enjoying a long period of economic <w>expansion</w>.",
                            "target_lang_translations": {
                                "ru": "В стране сейчас наблюдается длительный период экономического <w>роста</w>.",
                                "zh": "该国目前正处于一个长期的经济<w>增长</w>期。"
                            }
                        },
                        {
                            "text": "Unemployment rates usually decrease during an industrial <w>expansion</w>.",
                            "target_lang_translations": {
                                "ru": "Уровень безработицы обычно снижается во время промышленного <w>подъёма</w>.",
                                "zh": "在工业<w>扩张</w>期间，失业率通常会下降。"
                            }
                        }
                    ],
                    "antonyms": [
                        "contraction"
                    ],
                    "common_phrases": [
                        "economic expansion",
                        "period of expansion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период экономического роста, характеризующийся повышением рыночной стоимости и деловой активности.",
                        "zh": "经济增长时期，表现为市场价值和商业活动的上升。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "экономический"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "деловой активности"
                            },
                            {
                                "target_lang_word": "экспансия",
                                "target_lang_sense_clarification": "захват новых рынков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增长",
                                "target_lang_sense_clarification": "指经济规模的扩大"
                            },
                            {
                                "target_lang_word": "繁荣",
                                "target_lang_sense_clarification": "指经济活跃的时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca1ad2f-5296-3bec-8cc4-dde25504a5f4",
                    "sense_definition": "A supplement to a game, such as a video game or board game, that adds new content like levels, characters, or items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "product_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>expansion</w> requires the original game board to be played.",
                            "target_lang_translations": {
                                "ru": "Для этого <w>дополнения</w> требуется оригинальная настольная игра.",
                                "zh": "这个<w>扩展包</w>需要配合原版游戏棋盘才能玩。"
                            }
                        },
                        {
                            "text": "The developers released a new <w>expansion</w> that adds three new maps.",
                            "target_lang_translations": {
                                "ru": "Разработчики выпустили новое <w>дополнение</w>, добавляющее три новые карты.",
                                "zh": "开发商发布了一个新的<w>资料片</w>，增加了三张新地图。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "expansion pack",
                        "game expansion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнение к игре (видеоигре или настольной), добавляющее новый контент, такой как уровни или персонажи.",
                        "zh": "游戏（如电子游戏或棋盘游戏）的补充内容，增加了关卡、角色或物品等新元素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "к игре"
                            },
                            {
                                "target_lang_word": "расширение",
                                "target_lang_sense_clarification": "функционала игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扩展包",
                                "target_lang_sense_clarification": "指游戏内容的补充"
                            },
                            {
                                "target_lang_word": "资料片",
                                "target_lang_sense_clarification": "指大型游戏扩展内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dac75cf-2552-3495-9885-8c1709d1c047",
                    "sense_definition": "The process of writing a mathematical expression as a sum of terms.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student learned how to perform the <w>expansion</w> of algebraic equations.",
                            "target_lang_translations": {
                                "ru": "Студент учился выполнять <w>разложение</w> алгебраических уравнений.",
                                "zh": "学生学会了如何进行代数方程的<w>展开</w>。"
                            }
                        },
                        {
                            "text": "Binomial <w>expansion</w> is a fundamental concept in advanced algebra.",
                            "target_lang_translations": {
                                "ru": "Биномиальное <w>разложение</w> — фундаментальное понятие в высшей алгебре.",
                                "zh": "二项式<w>展开</w>是高等代数中的一个基本概念。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "binomial expansion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс записи математического выражения в виде суммы слагаемых.",
                        "zh": "将数学表达式写成各项之和的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разложение",
                                "target_lang_sense_clarification": "в ряд или на множители"
                            },
                            {
                                "target_lang_word": "раскрытие",
                                "target_lang_sense_clarification": "скобок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "指代数式的展开"
                            },
                            {
                                "target_lang_word": "展开式",
                                "target_lang_sense_clarification": "指展开后的结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}