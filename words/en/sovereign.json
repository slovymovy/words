{
    "word_family": [
        "sovereignty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "315c29b9-6d52-3883-913e-9ecacbbd1cbd",
                    "sense_definition": "A supreme ruler, especially a monarch.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "ruler_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sovereign</w> officially opened the new session of parliament today.",
                            "target_lang_translations": {
                                "ru": "<w>Монарх</w> сегодня официально открыл новую сессию парламента.",
                                "tr": "<w>Hükümdar</w> bugün parlamentonun yeni oturumunu resmen açtı."
                            }
                        },
                        {
                            "text": "Duties of the <w>sovereign</w> are strictly defined by the country's constitution.",
                            "target_lang_translations": {
                                "ru": "Обязанности <w>суверена</w> строго определены конституцией страны.",
                                "tr": "<w>Hükümdarın</w> görevleri ülke anayasası tarafından kesin olarak belirlenmiştir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reigning sovereign",
                        "British sovereign",
                        "sovereign lord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верховный правитель, особенно монарх.",
                        "tr": "Yüce yönetici, özellikle bir hükümdar veya monark."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монарх",
                                "target_lang_sense_clarification": "единоличный глава государства"
                            },
                            {
                                "target_lang_word": "суверен",
                                "target_lang_sense_clarification": "носитель верховной власти (юридический/политический термин)"
                            },
                            {
                                "target_lang_word": "государь",
                                "target_lang_sense_clarification": "правитель (традиционное/устаревшее)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hükümdar",
                                "target_lang_sense_clarification": "devlet başkanı veya monark"
                            },
                            {
                                "target_lang_word": "egemen",
                                "target_lang_sense_clarification": "yüce güç sahibi yönetici"
                            },
                            {
                                "target_lang_word": "kral",
                                "target_lang_sense_clarification": "monark, erkek hükümdar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bd14321-c850-399c-b1b4-86856ecd5bc4",
                    "sense_definition": "A British gold coin with a nominal value of one pound sterling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "coin_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He discovered a rare gold <w>sovereign</w> hidden in the antique desk.",
                            "target_lang_translations": {
                                "ru": "Он обнаружил редкий золотой <w>соверен</w>, спрятанный в старинном письменном столе.",
                                "tr": "Antika çalışma masasına gizlenmiş nadir bir altın <w>sovereign</w> buldu."
                            }
                        },
                        {
                            "text": "The collector paid a high price for the Victorian <w>sovereign</w>.",
                            "target_lang_translations": {
                                "ru": "Коллекционер заплатил высокую цену за викторианский <w>соверен</w>.",
                                "tr": "Koleksiyoncu, Viktorya dönemine ait <w>sovereign</w> için yüksek bir fiyat ödedi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold sovereign",
                        "half sovereign"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to a specific historical coin type"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британская золотая монета номиналом в один фунт стерлингов.",
                        "tr": "Nominal değeri bir sterlin olan İngiliz altın parası."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соверен",
                                "target_lang_sense_clarification": "золотая монета"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sovereign",
                                "target_lang_sense_clarification": "tarihi İngiliz altın parası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf8fc98-06a2-35cb-b1f6-848775574091",
                    "sense_definition": "God perceived as the supreme ruler of the universe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ruler_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hymn praises the <w>sovereign</w> of all creation for his mercy.",
                            "target_lang_translations": {
                                "ru": "Гимн восхваляет <w>Владыку</w> всего творения за его милосердие.",
                                "tr": "İlahide, merhameti için tüm yaratılmışların <w>Rabbine</w> övgüler yağdırılıyor."
                            }
                        },
                        {
                            "text": "Believers trust in the <w>sovereign</w> to guide their lives through difficulty.",
                            "target_lang_translations": {
                                "ru": "Верующие уповают на <w>Владыку</w>, надеясь, что он проведет их через трудности.",
                                "tr": "Müminler, zorluklar karşısında hayatlarına yol göstermesi için <w>Cenab-ı Hak'ka</w> güvenirler."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "religious or literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бог, воспринимаемый как верховный правитель вселенной.",
                        "tr": "Evrenin yüce yöneticisi olarak algılanan Tanrı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Владыка",
                                "target_lang_sense_clarification": "повелитель, господь (религиозное)"
                            },
                            {
                                "target_lang_word": "Вседержитель",
                                "target_lang_sense_clarification": "Бог как обладатель абсолютной власти"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Cenab-ı Hak",
                                "target_lang_sense_clarification": "dini bağlamda Tanrı, yüce yönetici"
                            },
                            {
                                "target_lang_word": "Rabb",
                                "target_lang_sense_clarification": "yüce efendi ve mutlak yönetici"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68e5066c-0b18-3d67-975d-ddbc8b813c91",
                    "sense_definition": "Possessing supreme or ultimate power; fully independent and self-governing.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "ruler_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every <w>sovereign</w> nation has the right to defend its own borders.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>суверенное</w> государство имеет право защищать свои границы.",
                                "tr": "Her <w>egemen</w> ulus kendi sınırlarını savunma hakkına sahiptir."
                            }
                        },
                        {
                            "text": "The committee was granted <w>sovereign</w> power to make all final decisions.",
                            "target_lang_translations": {
                                "ru": "Комитету была предоставлена <w>верховная</w> власть для принятия всех окончательных решений.",
                                "tr": "Komiteye tüm nihai kararları alması için <w>hükümran</w> yetki verildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "autonomous",
                        "supreme"
                    ],
                    "common_phrases": [
                        "sovereign state",
                        "sovereign nation",
                        "sovereign power",
                        "sovereign territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий верховной властью; полностью независимый и самоуправляемый.",
                        "tr": "Yüce veya mutlak güce sahip; tamamen bağımsız ve kendi kendini yöneten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суверенный",
                                "target_lang_sense_clarification": "независимый, обладающий суверенитетом"
                            },
                            {
                                "target_lang_word": "верховный",
                                "target_lang_sense_clarification": "высший, главный (о власти)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "egemen",
                                "target_lang_sense_clarification": "bağımsız, bağımlı olmayan"
                            },
                            {
                                "target_lang_word": "bağımsız",
                                "target_lang_sense_clarification": "kendi kendini yöneten"
                            },
                            {
                                "target_lang_word": "hükümran",
                                "target_lang_sense_clarification": "mutlak güce sahip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                    "sense_definition": "Extremely potent, effective, or excellent in quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a <w>sovereign</w> remedy that cured the illness immediately.",
                            "target_lang_translations": {
                                "ru": "Врач прописал <w>превосходное</w> средство, которое немедленно вылечило болезнь.",
                                "tr": "Doktor, hastalığı anında iyileştiren <w>son derece etkili</w> bir çare reçete etti."
                            }
                        },
                        {
                            "text": "Silence is often the most <w>sovereign</w> cure for a troubled mind.",
                            "target_lang_translations": {
                                "ru": "Тишина часто является самым <w>действенным</w> лекарством для беспокойного ума.",
                                "tr": "Sessizlik, huzursuz bir zihin için genellikle en <w>etkili</w> şifadır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sovereign remedy",
                        "sovereign cure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literature"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rare in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно действенный, эффективный или превосходный по качеству.",
                        "tr": "Son derece etkili, tesirli veya üstün kaliteli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходный",
                                "target_lang_sense_clarification": "высшего качества"
                            },
                            {
                                "target_lang_word": "действенный",
                                "target_lang_sense_clarification": "эффективный (о лекарстве)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "son derece etkili",
                                "target_lang_sense_clarification": "ilacın veya çarenin etkisi yüksek olan"
                            },
                            {
                                "target_lang_word": "üstün",
                                "target_lang_sense_clarification": "kalitesi mükemmel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "80c3d281-0091-3148-895e-2fec0e0e3877",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Sovereign</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Соверен</w> был известен своим вкладом в местную библиотеку.",
                                "tr": "Bay <w>Sovereign</w>, yerel kütüphaneye yaptığı katkılarla tanınırdı."
                            }
                        },
                        {
                            "text": "We are looking for a file belonging to a Janet <w>Sovereign</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем папку, принадлежащую Джанет <w>Соверен</w>.",
                                "tr": "Janet <w>Sovereign</w>'e ait bir dosyayı arıyoruz."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Соверен",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Sovereign",
                                "target_lang_sense_clarification": "özel isim / soyadı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03f99210-c99e-3ee6-b689-8db37d452acc",
                    "sense_definition": "To rule over as a monarch or supreme leader.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ruler_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>sovereigned</w> over the lands with absolute authority.",
                            "target_lang_translations": {
                                "ru": "Король <w>правил</w> землями с абсолютной властью.",
                                "tr": "Kral, topraklar üzerinde mutlak bir yetkiyle <w>hüküm sürdü</w>."
                            }
                        },
                        {
                            "text": "He <w>sovereigns</w> the territory without answering to any foreign power.",
                            "target_lang_translations": {
                                "ru": "Он <w>властвует</w> над территорией, не отчитываясь ни перед какой иностранной державой.",
                                "tr": "Hiçbir yabancı güce hesap vermeden bölgeye <w>hükmediyor</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Править как монарх или верховный лидер.",
                        "tr": "Bir hükümdar veya yüce lider olarak hüküm sürmek, yönetmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "править",
                                "target_lang_sense_clarification": "осуществлять власть"
                            },
                            {
                                "target_lang_word": "властвовать",
                                "target_lang_sense_clarification": "обладать властью"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hüküm sürmek",
                                "target_lang_sense_clarification": "yönetmek, idare etmek"
                            },
                            {
                                "target_lang_word": "hükmetmek",
                                "target_lang_sense_clarification": "mutlak güçle yönetmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}