                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les physiciens ont déterminé que le neutrino peut exister sous trois <w>saveurs</w> distinctes."
