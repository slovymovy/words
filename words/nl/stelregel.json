                            {
                                "target_lang_word": "das Prinzip",
                                "target_lang_sense_clarification": "theoretische oder juristische Grundlage"
                            },
                            {
                                "target_lang_word": "der Lehrsatz",
                                "target_lang_sense_clarification": "wissenschaftliche oder mathematische Regel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb894abe-f146-36d0-afb4-2674a4bc3fa6",
                    "sense_definition": "Richel of regel waarmee geprefabriceerde constructiedelen op de juiste plaats worden aangebracht.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bouwvakkers monteerden eerst de <w>stelregel</w> om de wandelementen nauwkeurig te plaatsen.",
                            "target_lang_translations": {
                                "de": "Die Bauarbeiter montierten zuerst die <w>Richtlatte</w>, um die Wandelemente präzise zu platzieren."
                            }
                        },
                        {
                            "text": "Zorg dat de houten <w>stelregel</w> waterpas ligt voordat je verder bouwt.",
                            "target_lang_translations": {
                                "de": "Sorge dafür, dass die hölzerne <w>Setzlatte</w> in der Waage liegt, bevor du weiterbaust."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Leiste, Latte oder Schiene im Bauwesen, die zur genauen Ausrichtung von Bauteilen dient."
                    },
                    "translations": {
