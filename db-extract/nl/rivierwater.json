                                        "entry_id": "c97338b0-2037-349a-94ba-228a3a569d3b",
                                        "glosses": [
                                            "Water found in or taken from a river."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a597fe8-96e2-4877-8714-ae6a56f179d4",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "They can be changed in various ways; for instance, river water is more turbid than that of lakes, since rivers drain water from the land, ..."
                                            },
                                            {
                                                "example_id": "9301577d-e053-45b1-90ce-9f6843de8acd",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "All these five directly use Pavana River, thus river water quality is very important for them."
                                            },
                                            {
                                                "example_id": "16dcf443-23b5-407e-a54a-7c4516dcbdca",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "River waters are used as drinking water and irrigation water for agricultural fields."
                                            },
                                            {
                                                "example_id": "19e5a17d-d16c-4761-b543-0ac65b1ded7b",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "Bad weather, therefore, cannot disrupt the metronomic existence of its regular users, but river water does come in, both from the Thames and its tributary the Walbrook. [...] This may be why the line is nicknamed 'The Drain', [...]"
                                            }
                                        ]
