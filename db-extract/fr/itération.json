                        ],
                        "form": "itérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d44474b-99cc-392a-a123-e6e77153d4df",
                        "entry_id": "156f0ce8-751e-39b0-b0ba-dceaebdd7383",
                        "glosses": [
                            "Action de répéter la même action sur tout un ensemble, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c3a800-056f-47d1-ae44-b05d69f0f297",
                                "sense_id": "3d44474b-99cc-392a-a123-e6e77153d4df",
                                "text": "Zermelo réussit à obtenir le résultat de cette itération transfinie, à totaliser l’itération transfinie, sans accomplir effectivement l’itération."
                            },
                            {
                                "example_id": "dbc55b19-139e-473e-a32c-89636abdc1e9",
                                "sense_id": "3d44474b-99cc-392a-a123-e6e77153d4df",
                                "text": "Les méthodes itératives donnent, en théorie, la solution x d’un système linéaire après un nombre infini d’itérations. A chaque pas, elles nécessitent le calcul du résidu du système."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5da8d99-6e87-4024-b165-7abbec7e37c5",
                        "source_entry_id": "156f0ce8-751e-39b0-b0ba-dceaebdd7383",
                        "source_sense_id": "3d44474b-99cc-392a-a123-e6e77153d4df",
                        "target_lang_word": "Iteration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iteration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91fed976-6c6a-301d-ae8f-481e71f84a77",
                                        "entry_id": "895c8499-e4c7-3a74-bbd9-79f84e870f19",
                                        "glosses": [
                                            "Methode, sich der Lösung eines Rechenproblems schrittweise, durch wiederholte Anwendung desselben Rechenverfahrens, anzunähern"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2e851b-d730-4911-9024-45fbeef7bf39",
                                                "sense_id": "91fed976-6c6a-301d-ae8f-481e71f84a77",
                                                "text": "Nullstellen von Polynomen höherer Ordnung können numerisch durch Iteration bestimmt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57472c15-1813-311e-a322-151cefd38a88",
                                        "entry_id": "895c8499-e4c7-3a74-bbd9-79f84e870f19",
                                        "glosses": [
                                            "Iterationsschritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d72081-701a-45dc-b996-d3e1a597e218",
                                                "sense_id": "57472c15-1813-311e-a322-151cefd38a88",
                                                "text": "Nach nur vier Iterationen weicht unser Ergebnis um weniger als 1% vom tatsächlichen Wert ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "38eb90d9-1be3-35ad-bb53-4b3d67f0efb9",
                                        "entry_id": "895c8499-e4c7-3a74-bbd9-79f84e870f19",
                                        "glosses": [
                                            "mehrfache Wiederholung eines sprachlichen Elements im Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df03ed6d-da2b-4016-8a5b-16e4d031f589",
                                                "sense_id": "38eb90d9-1be3-35ad-bb53-4b3d67f0efb9",
                                                "text": "„Pipapo“ und „vorvorvor…gestern“ sind Beispiele für Iterationen im Deutschen."
                                            },
                                            {
                                                "example_id": "d53691ec-3fa9-4006-8f8e-42365f6e58ad",
                                                "sense_id": "38eb90d9-1be3-35ad-bb53-4b3d67f0efb9",
                                                "text": "„Einige Beobachtungen sollen die Bedeutung von Doppelungen und Iterationen im Deutschen und damit die Notwendigkeit, sie etwas mehr als bisher zu berücksichtigen, unterstreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "292fe507-f53b-4b7d-bf9e-6093b8cbafc9",
                        "source_entry_id": "156f0ce8-751e-39b0-b0ba-dceaebdd7383",
                        "source_sense_id": "3d44474b-99cc-392a-a123-e6e77153d4df",
                        "target_lang_word": "Wiederholung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederholung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                        "entry_id": "b327cd12-b8c2-3d32-be07-527f29be9791",
                                        "glosses": [
                                            "nochmalige Durchführung einer Tat, einer Vorgehensweise, einer Übung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fceeddb-c8cc-4fc1-8a09-c2907772409a",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "Bei der Wiederholung der Übungsaufgaben sollte beachtet werden, dass nicht jede Lösung wichtig für die Prüfung ist."
                                            },
                                            {
                                                "example_id": "0a24b4f0-9bf0-4a78-87e9-3e008d63358e",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "Die Wiederholungen der Taten sind zu verhindern, indem man präventiv alles unternimmt, um eine Wiederholung zu ermöglichen."
                                            },
                                            {
                                                "example_id": "ea1a6088-0c5f-4412-a655-b63deaf47c25",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "„Schlafentzug für eine Nacht oder auch nur eine halbe Nacht (bevorzugt der zweiten Nachthälfte) wirkt eindeutig antidepressiv, wenn auch oft nur kurze Zeit, so dass Wiederholungen angezeigt sind.“"
                                            },
                                            {
                                                "example_id": "d6eaf741-9084-4ae5-8311-ba50e641d815",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "„Wir werden immer wieder sehen, dass Wieland der Maßregel folgte, dass Wiederholungen nicht gefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cb07d03-f6b4-3399-be2a-685b72d97b4a",
                                        "entry_id": "b327cd12-b8c2-3d32-be07-527f29be9791",
                                        "glosses": [
                                            "erneute Ausstrahlung einer Sendung"
                                        ],
                                        "tags": [
                                            "Rundfunk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c196c39-1335-4ce7-9272-f06b73bcd810",
                                                "sense_id": "8cb07d03-f6b4-3399-be2a-685b72d97b4a",
                                                "text": "Das Radio- und Fernsehprogramm ist voller Wiederholungen, so dass es sinnvoller ist entweder schlafen zu gehen oder einen Artikel zum Thema Wiederholung ins Internet einzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fecf0035-a6af-3cb4-af62-4d7147a81482",
                                        "entry_id": "b327cd12-b8c2-3d32-be07-527f29be9791",
                                        "glosses": [
                                            "sprachliches Stilmittel"
                                        ],
                                        "tags": [],
