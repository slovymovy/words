                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80449a33-ef96-49e8-98c8-b5df98abadc8",
                        "source_entry_id": "238db581-e48c-3f86-9a6f-87d6e39acdf8",
                        "source_sense_id": "d1b4a314-93b5-3e55-a481-1f710b4cf48d",
                        "target_lang_word": "instruction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instruction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Action d’instruire quelqu’un sur les préceptes, les principes nécessaires à son éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56a8e156-b840-456b-8019-77a29368d10a",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "Ma grand-mère ne comprenait pas, de très bonne foi, les bienfaits de l’instruction. Elle disait qu'il était inutile de se casser la tête pour y faire entrer des billevesées ; qu'il n'y avait pas d'autre science que celle de la vie, et que celle-là, l'expérience la donnait..., et non pas l'étude d'un grimoire ; que les livres étaient des paperasses, et les savants, des rêveurs."
                                            },
                                            {
                                                "example_id": "f71c96cf-6c04-4cff-b93c-b69dd65059e2",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "Celui-ci promettait naturellement à ses électeurs, comme don de joyeux avènement, la séparation de l’Église et de l’État, l’instruction laïque et la suppression du budget des cultes."
                                            },
                                            {
                                                "example_id": "057e2fd6-c0b8-4df1-877a-e886b975db59",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "Après avoir reçu une instruction générale très complète, il fut dressé par son père à la rude école de la chasse à la baleine."
                                            },
                                            {
                                                "example_id": "cc2b866f-143a-4bb5-8137-d721889ebc4b",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "Répandre le bienfait de l’instruction."
                                            },
                                            {
                                                "example_id": "de2b1ba3-c1a1-4476-8c9e-8afc9359c013",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "L’instruction des nouvelles recrues, L’éducation militaire du jeune soldat."
                                            },
                                            {
                                                "example_id": "246a9826-afa7-4a84-aabd-158da0466342",
                                                "sense_id": "6868641c-39af-30a3-be8b-46bde4c4d29c",
                                                "text": "instruction pastorale, Mandement d’évêque sur quelque point de doctrine ou de morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a77c95-4c40-34e3-8bb4-8d75c09ccdc1",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Connaissances ; savoir ; notions acquises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5d9c9a-952f-4b9c-9729-a3a864bc3417",
                                                "sense_id": "98a77c95-4c40-34e3-8bb4-8d75c09ccdc1",
                                                "text": "L’ouvrage, du reste, annonce une instruction et des connaissances historiques qu’il est rare de trouver dans une femme, […]."
                                            },
                                            {
                                                "example_id": "76ad418a-2542-44b3-b95b-1c3cff2ae766",
                                                "sense_id": "98a77c95-4c40-34e3-8bb4-8d75c09ccdc1",
                                                "text": "Elle essaye de donner des tons aristocratiques à sa voix aigre ; mais elle n’y réussit pas plus qu’à couvrir son défaut d’instruction."
                                            },
                                            {
                                                "example_id": "0ffed02d-50b1-47e0-a0d5-59d385b55df4",
                                                "sense_id": "98a77c95-4c40-34e3-8bb4-8d75c09ccdc1",
                                                "text": "[…]; la domesticité nobiliaire était fort recherchée, et il ne faudrait pas conclure que l’instruction musicale fût assez répandue à cette époque pour que tous les laquais jouassent du violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9990664-439b-3df4-b45c-289ee55721e0",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Leçon, précepte, surtout d’action morale, qu’on donne pour instruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d91a54f-f9c1-4f25-8b56-3c442ceaf0e7",
                                                "sense_id": "f9990664-439b-3df4-b45c-289ee55721e0",
                                                "text": "Vous lui donnez là une bonne instruction, une instruction salutaire."
                                            },
                                            {
                                                "example_id": "b1792c5d-d023-47ae-8544-47d65e9d69b4",
                                                "sense_id": "f9990664-439b-3df4-b45c-289ee55721e0",
                                                "text": "Les instructions qu’il recevait de son père."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6af71e8-15dc-3575-8bb4-1f1d443ae943",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Connaissance qu’on donne à quelqu’un de certains faits, de certains usages qu’il ignore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec3d43b-3967-4246-9a9a-1362118de2d0",
                                                "sense_id": "f6af71e8-15dc-3575-8bb4-1f1d443ae943",
                                                "text": "Je vous demande pour cela mon instruction."
                                            },
                                            {
                                                "example_id": "2f6b7cbd-3ee0-447e-8fe2-f511dbeef913",
                                                "sense_id": "f6af71e8-15dc-3575-8bb4-1f1d443ae943",
                                                "text": "J’ai fait un mémoire pour l’instruction de mon rapporteur."
                                            },
                                            {
                                                "example_id": "b4b4ad46-b150-4eb6-b368-dc807275bc39",
                                                "sense_id": "f6af71e8-15dc-3575-8bb4-1f1d443ae943",
                                                "text": "instruction sur la manière de se servir d’une chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88d47dba-f290-3c30-a13b-c936a84419dc",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Ordres, explications, avis qu’une personne donne à une autre pour la conduite de quelque affaire, de quelque entreprise. — Note d’usage : Dans ce sens, il s’emploie surtout au pluriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb9d8be3-129b-48aa-afe5-2d628b4feec9",
                                                "sense_id": "88d47dba-f290-3c30-a13b-c936a84419dc",
                                                "text": "Le 10 janvier, au petit jour, le citoyen Guillaume Recorder, maire de Gentilly, monte à la maison de détention, suivant les instructions qu'il a reçues : on lui présente les quarante proscrits ; […]."
                                            },
                                            {
                                                "example_id": "746ebc83-a27f-42c2-b2ac-6ddbe3a7033c",
                                                "sense_id": "88d47dba-f290-3c30-a13b-c936a84419dc",
                                                "text": "Marchand avait coutume de ne jamais donner d’instructions détaillées à ses collaborateurs, se bornant à leur préciser l’orientation qu'il souhaitait les voir adopter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Ordres, des explications écrites ou verbales qu’un prince ou un gouvernement donne à son ambassadeur, à son envoyé, à son délégué, sur la manière de se conduire dans la mission dont il le charge."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6766664f-2b0d-4979-a1dc-2a284d983afa",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Cet ambassadeur serait parti, s’il avait reçu ses instructions."
                                            },
                                            {
                                                "example_id": "cd40e3aa-4d48-4c6c-9f75-68b1b2a07c01",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Ce que vous me demandez est contre mes instructions."
                                            },
                                            {
                                                "example_id": "65fb0ef7-55be-435e-bdf9-f48acec58377",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Il n’a pas suivi ses instructions."
                                            },
                                            {
                                                "example_id": "9db6838f-d843-4b1f-bec7-2589d0aedaf1",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Il attend de nouvelles instructions."
                                            },
                                            {
                                                "example_id": "bbcb6af7-08b0-4ea0-89fb-a429bca39512",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Dresser des instructions."
                                            },
                                            {
                                                "example_id": "1ec4911c-e74b-45e2-a7d8-873db1c61487",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Instructions verbales."
                                            },
                                            {
                                                "example_id": "7a5a6eb2-5ef7-47c6-8d0c-79d1d160bde3",
                                                "sense_id": "e9981b15-c86a-3f41-a6d3-8df91b2847dd",
                                                "text": "Instructions secrètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc21510-f75c-3682-a657-7c88077ef88a",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Toutes les formalités nécessaires pour mettre une cause, une affaire délictuelle ou criminelle en état d’être jugée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80ca402-cee1-46cd-aedc-ba5864754a67",
                                                "sense_id": "adc21510-f75c-3682-a657-7c88077ef88a",
                                                "text": "Supposez maintenant un demi-criminel, comme Lucien qui, sauvé d’un premier naufrage de sa vertu, pourrait s’amender et devenir utile à son pays, il périra dans les traquenards de l’instruction."
                                            },
                                            {
                                                "example_id": "325effe0-6a51-434f-9b39-8e98b4cfdeb8",
                                                "sense_id": "adc21510-f75c-3682-a657-7c88077ef88a",
                                                "text": "Des journalistes anglais avaient donc passé le Chenal pour suivre, non seulement des débats, mais encore l’instruction."
                                            },
                                            {
                                                "example_id": "0b8b3f19-5199-4b43-81c2-f8e43c77a8d0",
                                                "sense_id": "adc21510-f75c-3682-a657-7c88077ef88a",
                                                "text": "Vous êtes arrêté, Fantômas, pour de nombreux assassinats, j’aurai à vous en parler en détail au cours de l’instruction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8c275a-0edb-3eb0-b11a-739f6b3cf981",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Informations ou directives présentées aux différents acteurs d’une opération avant le début de celle-ci."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9210b10c-b00d-3d5b-838b-5dd85d6f6318",
                                        "entry_id": "b345795a-6352-343e-83a2-152b0bcfbf90",
                                        "glosses": [
                                            "Étape d’un programme informatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43672031-266c-4c8a-abcf-2e783bd5e335",
                                                "sense_id": "9210b10c-b00d-3d5b-838b-5dd85d6f6318",
                                                "text": "Au lieu d'exécuter l’instruction MsgBox de la boucle, c'est le MsgBox situé à la suite de l'étiquette errFich qui est exécuté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
