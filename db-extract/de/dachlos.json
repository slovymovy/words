                "senses": [
                    {
                        "sense_id": "d6b84323-5b88-38b5-ba89-7df9f7285880",
                        "entry_id": "6109282d-f549-37b0-ac01-019923ca9bee",
                        "glosses": [
                            "ohne Dach, kein Dach habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3071cfc4-da2a-4469-9f94-ed68b800c813",
                                "sense_id": "d6b84323-5b88-38b5-ba89-7df9f7285880",
                                "text": "„Es war zu jener Stunde, die auf dem Mars den religiösen Kulthandlungen geweiht ist; zu jener Stunde, da die Aihai sich in ihren dachlosen Tempeln versammeln und die Rückkehr der scheidenden Sonne erflehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5e6dbd3-b755-4713-81e7-0f24b83e4379",
                        "source_entry_id": "6109282d-f549-37b0-ac01-019923ca9bee",
                        "source_sense_id": "d6b84323-5b88-38b5-ba89-7df9f7285880",
                        "source_sense_description": "ohne Dach",
                        "target_lang_word": "roofless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roofless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55a6c66b-15b0-380d-b045-a97b580a7bf7",
                                        "entry_id": "3332c73c-0b2a-3e11-a4be-2e85ca38a5db",
                                        "glosses": [
                                            "Without a roof, open to the sky."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038f0ee5-9e9f-410a-95e9-341af2786151",
                                                "sense_id": "55a6c66b-15b0-380d-b045-a97b580a7bf7",
                                                "text": "Before the tornado we had a dining room with a skylight; after it we had a roofless home with too much ventilation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "033acfe1-d521-38f6-af29-6a8d249b4a18",
                                        "entry_id": "3332c73c-0b2a-3e11-a4be-2e85ca38a5db",
                                        "glosses": [
                                            "Having no house or home; unsheltered."
                                        ],
                                        "tags": [
