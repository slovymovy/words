                    {
                        "sense_id": "ff058ca0-0dc3-38ae-9633-96461dc4b878",
                        "entry_id": "744ea1f3-ef95-32d6-8c0d-b362dc4b3b45",
                        "glosses": [
                            "toestel waarmee men afbeeldingen kan verzenden, ontvangen en afdrukken via de telefoonlijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bcde66-6ebf-4a60-bcaa-7f2005e41985",
                                "sense_id": "ff058ca0-0dc3-38ae-9633-96461dc4b878",
                                "text": "Eind 2012 begon het OM ook al een onderzoek, nadat in een strafzaak een brief werd verstuurd vanaf een faxapparaat in de Haagse rechtbank. In de anonieme brief stonden onjuiste gegevens, maar hij was wel geschreven op briefpapier van de rechtbank Den Haag. Het OM kon geen verdachte vinden. Daarom werd de zaak toen opgeschort."
                            },
                            {
                                "example_id": "7cfe3afa-27b4-4fbc-a477-5d0ba01cb397",
                                "sense_id": "ff058ca0-0dc3-38ae-9633-96461dc4b878",
                                "text": "Daar kwam maandag een faxapparaat binnen dat zaterdag te koop was aangeboden op een rommelmarkt in Middelburg. Een man uit Zevenbergen kocht het apparaat en zag de informatie op de afdrukrol. Het apparaat was vroeger van een bedrijf in het Zeeuwse Ritthem."
                            }
                        ]
                    }
