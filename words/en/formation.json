    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c90da8d-f551-3a78-abd3-cfa31153156c",
                    "sense_definition": "The act or process of creating something or the way in which something develops.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>formation</w> of the new government took several weeks of negotiation.",
                            "target_lang_translations": {
                                "ru": "<w>Формирование</w> нового правительства заняло несколько недель переговоров.",
                                "tr": "Yeni hükümetin <w>kurulması</w> birkaç hafta süren müzakereler gerektirdi.",
                                "zh": "新政府的<w>形成</w>经过了数周的谈判。"
                            }
                        },
                        {
                            "text": "Scientists are observing the <w>formation</w> of stars in a distant galaxy.",
                            "target_lang_translations": {
                                "ru": "Ученые наблюдают за <w>образованием</w> звезд в далекой галактике.",
                                "tr": "Bilim insanları uzak bir galakside yıldızların <w>oluşumunu</w> gözlemliyor.",
                                "zh": "科学家们正在观测遥远星系中恒星的<w>形成</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creation",
                        "development",
                        "establishment",
                        "constitution"
                    ],
                    "antonyms": [
                        "destruction",
                        "dissolution"
                    ],
                    "common_phrases": [
                        "formation of",
                        "star formation",
                        "capital formation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс создания чего-либо, или то, как что-то развивается.",
                        "tr": "Bir şeyin oluşturulması eylemi veya süreci, ya da bir şeyin gelişme şekli.",
                        "zh": "创造某事物的行为或过程，或者某事物发展的形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формирование",
                                "target_lang_sense_clarification": "процесс придания формы или развития"
                            },
                            {
                                "target_lang_word": "образование",
                                "target_lang_sense_clarification": "создание или возникновение чего-либо"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "процесс творения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oluşum",
                                "target_lang_sense_clarification": "bir şeyin meydana gelme süreci"
                            },
                            {
                                "target_lang_word": "oluşturma",
                                "target_lang_sense_clarification": "meydana getirme eylemi"
                            },
                            {
                                "target_lang_word": "kuruluş",
                                "target_lang_sense_clarification": "bir yapının veya örgütün kurulması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "形成",
                                "target_lang_sense_clarification": "事物产生或发展的过程"
                            },
                            {
                                "target_lang_word": "建立",
                                "target_lang_sense_clarification": "组织或制度的创建"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4dfd84-3a6c-3b9c-a3f1-a3286f4b7eee",
                    "sense_definition": "A specific arrangement or pattern in which people or things are organized, especially soldiers, vehicles, or sports players.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fighter jets flew over the stadium in a tight <w>formation</w>.",
                            "target_lang_translations": {
                                "ru": "Истребители пролетели над стадионом в плотном <w>строю</w>.",
                                "tr": "Savaş uçakları stadyumun üzerinde sıkı bir <w>düzen</w> halinde uçtu.",
                                "zh": "战斗机以紧密的<w>队形</w>飞过体育场上空。"
                            }
                        },
                        {
                            "text": "The football team switched to a defensive <w>formation</w> to protect their lead.",
                            "target_lang_translations": {
                                "ru": "Футбольная команда перешла на оборонительное <w>построение</w>, чтобы удержать преимущество.",
                                "tr": "Futbol takımı üstünlüğünü korumak için savunma <w>dizilişine</w> geçti.",
                                "zh": "足球队换成了防守<w>阵型</w>以保住领先优势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement",
                        "configuration",
                        "layout",
                        "alignment"
                    ],
                    "common_phrases": [
                        "in formation",
                        "fly in formation",
                        "battle formation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое расположение или порядок, в котором организованы люди или предметы, особенно солдаты, транспортные средства или спортсмены.",
                        "tr": "İnsanların veya nesnelerin, özellikle askerlerin, araçların veya sporcuların düzenlendiği belirli bir diziliş veya düzen.",
                        "zh": "人或事物组织起来的特定排列或模式，尤指士兵、车辆或运动员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строй",
                                "target_lang_sense_clarification": "военный или полетный порядок"
                            },
                            {
                                "target_lang_word": "построение",
                                "target_lang_sense_clarification": "расположение игроков или войск"
                            },
                            {
                                "target_lang_word": "боевой порядок",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "diziliş",
                                "target_lang_sense_clarification": "spor veya askeri gruptaki sıralanış"
                            },
                            {
                                "target_lang_word": "düzen",
                                "target_lang_sense_clarification": "düzenlenme biçimi"
                            },
                            {
                                "target_lang_word": "formasyon",
                                "target_lang_sense_clarification": "belirli bir yapıda yer alma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "队形",
                                "target_lang_sense_clarification": "人员或车辆的排列方式"
                            },
                            {
                                "target_lang_word": "阵型",
                                "target_lang_sense_clarification": "体育比赛中的布局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d231ff4-fd1d-33f1-aafc-518974b204d2",
                    "sense_definition": "A thing that has been formed, especially a natural structure or shape.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped to take pictures of the unusual rock <w>formation</w> in the desert.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы сфотографировать необычное скальное <w>образование</w> в пустыне.",
                                "tr": "Çöldeki sıra dışı kaya <w>oluşumunun</w> fotoğraflarını çekmek için durduk.",
                                "zh": "我们停下来拍摄沙漠中那处奇特的岩石<w>构造</w>。"
                            }
                        },
                        {
                            "text": "The pilot navigated around a dangerous cloud <w>formation</w> during the flight.",
                            "target_lang_translations": {
                                "ru": "Пилот облетел опасное облачное <w>образование</w> во время полета.",
                                "tr": "Pilot, uçuş sırasında tehlikeli bir bulut <w>kümesinin</w> etrafından dolandı.",
                                "zh": "飞行员在飞行过程中绕过了危险的云层<w>构造</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "structure",
                        "shape"
                    ],
                    "common_phrases": [
                        "rock formation",
                        "cloud formation"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что было сформировано, особенно природная структура или форма.",
                        "tr": "Oluşmuş bir şey, özellikle doğal bir yapı veya biçim.",
                        "zh": "已经形成的事物，尤指自然结构或形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образование",
                                "target_lang_sense_clarification": "геологическое или природное явление"
                            },
                            {
                                "target_lang_word": "структура",
                                "target_lang_sense_clarification": "строение или форма"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oluşum",
                                "target_lang_sense_clarification": "doğal kaya veya bulut şekli"
                            },
                            {
                                "target_lang_word": "yapı",
                                "target_lang_sense_clarification": "biçimlenmiş doğal şekil"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构造",
                                "target_lang_sense_clarification": "自然形成的结构"
                            },
                            {
                                "target_lang_word": "形态",
                                "target_lang_sense_clarification": "事物的形状或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "465ef83f-cda4-331a-9739-349832708574",
                    "sense_definition": "A distinct layer or body of rock that has a common origin and characteristics.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists identified a limestone <w>formation</w> that contains many ancient fossils.",
                            "target_lang_translations": {
                                "ru": "Геологи обнаружили известняковую <w>формацию</w>, содержащую множество древних окаменелостей.",
                                "tr": "Jeologlar, birçok kadim fosil içeren bir kireç taşı <w>formasyonu</w> tespit ettiler.",
                                "zh": "地质学家鉴定出一处含有许多古代化石的石灰岩<w>地层</w>。"
                            }
                        },
                        {
                            "text": "Oil was discovered deep within the shale <w>formation</w> beneath the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Нефть была обнаружена глубоко внутри сланцевого <w>пласта</w> под дном океана.",
                                "tr": "Okyanus tabanının altındaki şist <w>katmanının</w> derinliklerinde petrol keşfedildi.",
                                "zh": "在海底深处的页岩<w>地层</w>中发现了石油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stratum",
                        "layer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "geology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный слой или массив горной породы, имеющий общее происхождение и характеристики.",
                        "tr": "Ortak bir kökene ve özelliklere sahip olan belirgin bir kaya katmanı veya kütlesi.",
                        "zh": "具有共同起源和特征的独特岩石层或岩体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формация",
                                "target_lang_sense_clarification": "геологический термин"
                            },
                            {
                                "target_lang_word": "пласт",
                                "target_lang_sense_clarification": "слой породы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "formasyon",
                                "target_lang_sense_clarification": "jeolojik kaya katmanı"
                            },
                            {
                                "target_lang_word": "katman",
                                "target_lang_sense_clarification": "jeolojik tabaka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地层",
                                "target_lang_sense_clarification": "地质学中的岩石层"
                            },
                            {
                                "target_lang_word": "岩层",
                                "target_lang_sense_clarification": "特定类型的岩石堆积"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e358941-2c71-321c-94b3-3a858be76acb",
                    "sense_definition": "An organized military unit or group of units under a specific command.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy <w>formation</w> advanced slowly towards the border.",
                            "target_lang_translations": {
                                "ru": "Вражеское <w>формирование</w> медленно продвигалось к границе.",
                                "tr": "Düşman <w>birliği</w> sınıra doğru yavaşça ilerledi.",
                                "zh": "敌方<w>部队</w>缓慢地向边境推进。"
                            }
                        },
                        {
                            "text": "Several armored <w>formations</w> were deployed to support the infantry.",
                            "target_lang_translations": {
                                "ru": "Несколько бронетанковых <w>соединений</w> были развернуты для поддержки пехоты.",
                                "tr": "Piyadeyi desteklemek için birkaç zırhlı <w>birlik</w> konuşlandırıldı.",
                                "zh": "几支装甲<w>部队</w>被部署以支援步兵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unit",
                        "force"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная воинская часть или группа частей под определенным командованием.",
                        "tr": "Belirli bir komuta altındaki organize askeri birlik veya birlikler grubu.",
                        "zh": "在特定指挥下的有组织的军事单位或单位群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формирование",
                                "target_lang_sense_clarification": "военное подразделение"
                            },
                            {
                                "target_lang_word": "соединение",
                                "target_lang_sense_clarification": "крупная воинская часть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birlik",
                                "target_lang_sense_clarification": "askeri grup"
                            },
                            {
                                "target_lang_word": "düzen",
                                "target_lang_sense_clarification": "askeri konuşlanma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部队",
                                "target_lang_sense_clarification": "军事单位"
                            },
                            {
                                "target_lang_word": "编制",
                                "target_lang_sense_clarification": "军队的组织结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803b0b08-0f2e-3570-b512-94568f4d7c82",
                    "sense_definition": "The development of a person's character or spiritual life, especially in preparation for a religious vocation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seminary focuses on the spiritual <w>formation</w> of young priests.",
                            "target_lang_translations": {
                                "ru": "Семинария сосредотачивается на духовном <w>становлении</w> молодых священников.",
                                "tr": "Ruhban okulu, genç rahiplerin manevi <w>gelişimine</w> odaklanmaktadır.",
                                "zh": "神学院专注于年轻牧师的精神<w>塑造</w>。"
                            }
                        },
                        {
                            "text": "His moral <w>formation</w> was heavily influenced by his early teachers.",
                            "target_lang_translations": {
                                "ru": "На его нравственное <w>формирование</w> сильно повлияли его первые учителя.",
                                "tr": "Onun ahlaki <w>yetişimi</w> üzerinde ilk öğretmenlerinin büyük etkisi oldu.",
                                "zh": "他的道德<w>塑造</w>深受早期老师的影响。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "religious or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Развитие характера или духовной жизни человека, особенно при подготовке к религиозному служению.",
                        "tr": "Bir kişinin karakterinin veya manevi yaşamının gelişimi, özellikle dini bir göreve hazırlanırken.",
                        "zh": "个人性格或精神生活的培养，尤指为宗教职业做准备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становление",
                                "target_lang_sense_clarification": "развитие личности"
                            },
                            {
                                "target_lang_word": "формирование",
                                "target_lang_sense_clarification": "развитие качеств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelişim",
                                "target_lang_sense_clarification": "karakter veya manevi ilerleme"
                            },
                            {
                                "target_lang_word": "yetişme",
                                "target_lang_sense_clarification": "eğitim ve olgunlaşma süreci"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑造",
                                "target_lang_sense_clarification": "性格或精神的培养"
                            },
                            {
                                "target_lang_word": "培养",
                                "target_lang_sense_clarification": "教育和成长过程"
                            }
                        ]
                    }
                }
            ]
        }
