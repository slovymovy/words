                    "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                    "sense_definition": "Large in size, amount, or extent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "amount_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent a <w>considerable</w> amount of time preparing for the exam.",
                            "target_lang_translations": {
                                "ru": "Она потратила <w>значительное</w> количество времени на подготовку к экзамену.",
                                "tr": "Sınava hazırlanmak için <w>hatırı sayılır</w> miktarda zaman harcadı.",
                                "zh": "她花了<w>相当多</w>的时间准备考试。"
                            }
                        },
                        {
                            "text": "The team made <w>considerable</w> progress during the last quarter.",
                            "target_lang_translations": {
                                "ru": "Команда добилась <w>существенного</w> прогресса за последний квартал.",
