                "senses": [
                    {
                        "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                        "entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                        "glosses": [
                            "Gefühl zufolge einer unerwarteten schlechten Nachricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fec8d5-2549-40dd-8a9f-1240018e1627",
                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                "text": "Mit tiefer Bestürzung geben wir das Ableben unserer Großmutter bekannt."
                            },
                            {
                                "example_id": "0b649006-37bd-43db-ab1e-59f879df1975",
                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                "text": "„Aber danach hatte sie der Frau direkt ins Gesicht und in ihre Gedanken geschaut, geübt darin, die Mimik und Gestik zu lesen, keine Bestürzung wahrgenommen oder überhaupt etwas anderes als diese normale Hausfrauenmilde.“"
                            },
                            {
                                "example_id": "78cc4731-8ea6-4820-a216-b58aa94e621b",
                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                "text": "„Ihre Bestürzung wurde so stark, daß sie das Trommeln und den Tanz der anderen unterbrechen wollte.“"
                            },
                            {
                                "example_id": "90bbe320-55bb-4af8-9241-9ae2b4e2de6a",
                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                "text": "„Die beiden wurden der Herrschaft gemeldet, und dann war es, als sei unter der Dienerschaft des Fürsten eine gewisse Verwirrung und Bestürzung entstanden.“"
                            },
                            {
                                "example_id": "4cbf5f58-71b3-4da0-9bdd-d9e2fe9b9b69",
                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                "text": "„Die unnennbare Angst des Kindes hatte die Anwesenden mit Verwunderung und Bestürzung erfüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d29953-e6f8-48e6-a213-772f714d7f12",
                        "source_entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                        "source_sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                        "source_sense_description": "Gefühl zufolge einer unerwarteten schlechten Nachricht",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7edd26fa-327f-42bc-b2e4-5068114d8370",
                        "source_entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                        "source_sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                        "source_sense_description": "Gefühl zufolge einer unerwarteten schlechten Nachricht",
                        "target_lang_word": "consternation",
