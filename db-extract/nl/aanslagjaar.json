                        "glosses": [
                            "kalenderjaar waar een belastingaangifte betrekking op heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f7f0fc-bfe2-4f96-8878-3937ace57625",
                                "sense_id": "48359e15-6753-38bf-afd5-7f0401beb13b",
                                "text": "Techonderneming Uber wordt onderzocht door de Amerikaanse federale belastingdienst. Het onderzoek heeft betrekking op de aanslagjaren 2013 en 2014. Dat laat het bedrijf achter de bekende taxi-app weten in een bij de beurswaakhond SEC ingediend document."
                            },
                            {
                                "example_id": "750e99d8-ed13-4d26-bb60-879d140a5c59",
                                "sense_id": "48359e15-6753-38bf-afd5-7f0401beb13b",
                                "text": "Het nieuwe belastingformulier voor het aanslagjaar 2022 (over de inkomsten en uitgaven van 2021) is begin deze week verschenen in het Staatsblad en al consulteerbaar op de website van de federale overheidsdienst Financiën, ook al start de eigenlijke aangifteperiode (via de online belastingtool Tax-on-web) pas eind april."
                            }
                        ]
                    }
