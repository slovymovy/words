                    {
                        "translation_id": "a9ed90e3-3165-47c9-a17b-40fa3484e8c0",
                        "source_entry_id": "3936c9bf-6f96-3e80-b0d2-f296713f368d",
                        "source_sense_id": "86b75e7c-937d-3d2d-a9cc-f5665215227f",
                        "source_sense_description": "een bondgenootschap",
                        "target_lang_word": "alliance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alliance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "590d6dc4-7af5-32e3-aa18-231b32eb8b15",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Union entre personnes, y compris des organisations, qui est le résultat d’une entente ou d’un pacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2cfb56-5e3c-43fb-9d41-fb473665ef42",
                                                "sense_id": "590d6dc4-7af5-32e3-aa18-231b32eb8b15",
                                                "text": "Louis la donnait pour femme au roi Alphonse VI, avec lequel il désirait resserrer son alliance. Deux ans plus tard cette princesse déposa son mari, et épousa Don Pedro son beau-frère, […]."
                                            },
                                            {
                                                "example_id": "5b14fbae-beed-4f92-86d5-cae8602d588e",
                                                "sense_id": "590d6dc4-7af5-32e3-aa18-231b32eb8b15",
                                                "text": "Cette alliance des « partis ouvriers » avec des formations « bourgeoises ou petite-bourgeoises » allaient les empêcher de prendre les mesures énergiques et « anticapitalistes » que réclamait la situation économique et sociale du pays."
                                            },
                                            {
                                                "example_id": "7ab0299c-7c89-45c6-89b8-39c3dd8cfb79",
                                                "sense_id": "590d6dc4-7af5-32e3-aa18-231b32eb8b15",
                                                "text": "Cela dit, à l'intérieur de l’alliance centriste, chacun essaie de conquérir la position la plus forte, ce qui le conduit à s’appuyer dans une certaine mesure sur le parti extrême correspondant à sa tendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbf338b-ab67-3167-8fd5-f097388e3370",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Union entre personnes, y compris des organisations, qui est le résultat d’une entente ou d’un pacte.",
                                            "En particulier, Union entre parti politiques qui est le résultat d’une entente ou d’un pacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4acbb86-d06e-4bc9-a405-908e130ea283",
                                                "sense_id": "9cbf338b-ab67-3167-8fd5-f097388e3370",
                                                "text": "Au-delà d’une potentielle alliance des droites suggérée par Éric Zemmour, certains membres des Républicains pourraient au contraire être tentés de faire alliance avec la majorité présidentielle et répondre à l’appel du pied de Stéphane Séjourné."
                                            },
                                            {
                                                "example_id": "94ed933b-c4fe-4819-a523-092707ee5b60",
                                                "sense_id": "9cbf338b-ab67-3167-8fd5-f097388e3370",
                                                "text": "Alliance stratégique, la Nupes est également un accord programmatique."
                                            },
                                            {
                                                "example_id": "dc442403-545d-46fa-89a3-0a068ef8ec96",
                                                "sense_id": "9cbf338b-ab67-3167-8fd5-f097388e3370",
                                                "text": "Sur la 1ère circonscription, il semble acquis que Maina Sage soit élue le 17 juin, même en cas d’ alliance entre le Tavini Huiraatira et le Tapura Huiraatira."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a308984-371a-34a8-b915-0addda007345",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Union entre Dieu et les hommes."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4f8023c-a9bf-445a-8eaa-2d0759909592",
                                                "sense_id": "1a308984-371a-34a8-b915-0addda007345",
                                                "text": "Arche d’alliance. → voir arche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Union ou confédération qui se fait entre deux ou plusieurs États pour leurs intérêts communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1f1cfa-9894-4173-b183-e5d6b77ce42a",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Non seulement il invita ses concitoyens à déposer leurs ressentiments et leurs griefs sur l'autel de la patrie, mais il demanda encore que le bienfait de cette pacification fût étendu aux autres peuples, et que la France, introduisant parmi les nations une nouvelle diplomatie, jetât les fondements d'une alliance universelle."
                                            },
                                            {
                                                "example_id": "109ad750-c57e-4d18-80ac-b9f04b31e63b",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Toutes les parties idéologiques des traités locarniens sont tombées l'une après l'autre. Et le résidu constitue l’alliance."
                                            },
                                            {
                                                "example_id": "a6a474f8-79fe-4074-9e77-f65e6b27e842",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Il est le premier ministre de la Guerre qui se soit déclaré hostile à l’alliance franco-russe, thème favori des hommes de la « Jésuitière »."
                                            },
                                            {
                                                "example_id": "ee079107-b336-4586-80cd-9a7e9857f289",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "L’alliance qui existe entre ces deux souverains."
                                            },
                                            {
                                                "example_id": "2d9d8595-a6f9-4303-a902-3bd5fc050ce3",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Ils ont formé une alliance redoutable."
                                            },
                                            {
                                                "example_id": "3710297e-aea2-4547-af93-e6751d051a9f",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Renouveler une alliance."
                                            },
                                            {
                                                "example_id": "cc46f3e4-0445-4608-997c-0f8da667468b",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Rompre une alliance."
                                            },
                                            {
                                                "example_id": "0e972e0f-c05d-46b1-935d-3260ebadd40b",
                                                "sense_id": "1a3453db-b3e5-3ea8-b847-448ea7aab1eb",
                                                "text": "Deux partis font alliance, ont contracté une alliance, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ec3a06e-a54d-3946-b728-35e8b8964e99",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Liens contractés par le mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63117c0-53e0-419f-b29a-dbb1c43a27d0",
                                                "sense_id": "1ec3a06e-a54d-3946-b728-35e8b8964e99",
                                                "text": "Ce retour, nous l'avons vu, n'est pas la simple rémanence d'un passé tribal et paysan, mais la reconstitution dans une société moderne de modes traditionnels de loyauté et d'exercice du pouvoir : alliances matrimoniales, solidarité des corporations, clientélisme, c'est-à-dire échange de la loyauté politique contre une prébende matérielle."
                                            },
                                            {
                                                "example_id": "9fbe823a-e902-4ffe-b0c7-cf41083ecd26",
                                                "sense_id": "1ec3a06e-a54d-3946-b728-35e8b8964e99",
                                                "text": "Il a fait une grande alliance, une alliance honorable en mariant sa fille à un tel."
                                            },
                                            {
                                                "example_id": "542fe222-7707-4eee-9393-57baa58c8a0d",
                                                "sense_id": "1ec3a06e-a54d-3946-b728-35e8b8964e99",
                                                "text": "Bague, anneau d’alliance, ou, absolument,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Bague d’or ou d’argent, symbole de l’union contractée par le mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af2f49c8-b356-42fd-a23f-74c13534ee1a",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "Porter au doigt une alliance."
                                            },
                                            {
                                                "example_id": "0b0684ab-7bc2-4344-8a03-bc1c3e24cb62",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "12 mai 43 – On cherche des débris d’or pour fournir une contrepartie au bijoutier qui nous vend nos alliances. Véga a retrouvé une vieille dent qui fera l’affaire. Et si la guerre se prolonge, nous pourrons toujours remettre notre alliance au dentiste pour qu’il puisse nous faire une couronne. C’est le Cycle de l’Azote !"
                                            },
                                            {
                                                "example_id": "095fe1c8-7987-4d98-892d-3f252595ae96",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "« Et son alliance ? » a demandé Poupette en prenant l’anneau dans le tiroir de la table. Nous la lui avons passée au doigt. Pourquoi ? Sans doute parce qu’il n’y avait aucune place sur terre pour ce petit cercle d’or."
                                            },
                                            {
                                                "example_id": "f88f9d91-86fe-4410-bab6-c5b02bdbb711",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "Il y avait aussi les alliances que les deux hommes portaient à leur annulaire gauche et que la graisse de l’âge enchâssait déjà, mais amaigris ils ne les eussent jamais ôtées."
                                            },
                                            {
                                                "example_id": "7212b2dd-6412-42bf-99c0-d1cb0001c7c4",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "Les garçons et les filles couleur du pain bis qui passent près d'eux leur jettent le bref regard latin qui juge et jauge et résume à la fraction de seconde, avec une précision implacable : un couple de jeunes mariés (ils portent l’alliance), point riches, puisqu'ils sont ici et non là-bas ; elle, plus belle que lui ; lui, plus amoureux qu'elle."
                                            },
                                            {
                                                "example_id": "13fe9b93-cd9a-42da-a38a-7cf95f5e8c82",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "Une alliance se cachait au fond du coffret ; elle prit aussi le chemin de la fonte, ce genre d’anneau n’étant sacré que laissé au doigt d’une morte."
                                            },
                                            {
                                                "example_id": "82e13d52-85ba-407b-9ad1-b9f0842904d8",
                                                "sense_id": "6de487d2-9a5e-3f64-949c-0511ac8b8dde",
                                                "text": "Elle m’accompagne souvent au resto U de l’ÉcoIe et je pousse la plaisanterie jusqu’à m'acheter une alliance et la porter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb6c2550-88ab-3bae-b7db-6437f556f520",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Affinité entre un époux et les parents de l’autre époux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f57d3b-4597-4bf7-8ae9-187864f7ae06",
                                                "sense_id": "fb6c2550-88ab-3bae-b7db-6437f556f520",
                                                "text": "Cousin, neveu par alliance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d0f5cb-68fa-3e20-b13f-e60fb3e53c73",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Affinité spirituelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89d8c22e-88bd-33ba-87a4-b5e102cd6917",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Union et mélange de plusieurs choses différentes, opposées, disparates."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9020f4bb-caec-46b2-a415-de388289f667",
                                                "sense_id": "89d8c22e-88bd-33ba-87a4-b5e102cd6917",
                                                "text": "Faire une alliance du sacré et du profane, du vice et de la vertu."
                                            },
                                            {
                                                "example_id": "8ab3ee8b-eee1-49e2-ba87-973eaa833c53",
                                                "sense_id": "89d8c22e-88bd-33ba-87a4-b5e102cd6917",
                                                "text": "La hardiesse de certaines alliances de mots."
                                            },
                                            {
                                                "example_id": "f6f6dc8c-5eca-46c8-a352-2138766e086f",
                                                "sense_id": "89d8c22e-88bd-33ba-87a4-b5e102cd6917",
                                                "text": "L’hémistiche « Il aspire à descendre » offre une heureuse alliance de mots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc467912-c462-3963-b81b-873deef22404",
                                        "entry_id": "ad5d6472-0b1e-3f7b-bee2-bf49ee4b71a0",
                                        "glosses": [
                                            "Poucettes."
                                        ],
                                        "tags": [
                                            "plural",
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
