                                        "entry_id": "020cd7b2-2776-31e0-8dee-f5591e0ac7ba",
                                        "glosses": [
                                            "movimento politico alla fine dell'Ottocento con lo scopo di formare in Palestina uno stato per gli ebrei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9eae01-0d5b-423d-af19-1f506d5f4cc8",
                                                "sense_id": "c17abb93-9258-3651-a5fa-a9725c1c920c",
                                                "text": "prima di un’escalation bellica e belligerante, inizialmente il sionismo fu l’innocente speranza messianica per gli ebrei riguardo alla ricostruzione del Tempio di Gerusalemme"
                                            },
                                            {
                                                "example_id": "4a2abefe-ac5f-4dfc-98c4-1bd878f11886",
                                                "sense_id": "c17abb93-9258-3651-a5fa-a9725c1c920c",
                                                "text": "Ahimè, l'attuale sionismo è una strumentalizzazione anche ai danni della religione ebraica"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
