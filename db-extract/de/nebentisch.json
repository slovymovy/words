                ],
                "senses": [
                    {
                        "sense_id": "b30b4a95-adcb-34af-a668-da8073691495",
                        "entry_id": "402540ab-3e34-3ea9-9981-579349dc5039",
                        "glosses": [
                            "ein Tisch nebenan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b1e2f2-9463-4baf-b8d9-bc845a58b176",
                                "sense_id": "b30b4a95-adcb-34af-a668-da8073691495",
                                "text": "„Er schaut hinüber zu Dorata und Tomek am Nebentisch.“"
                            },
                            {
                                "example_id": "ec22ad9c-34ac-4b16-b175-9ea388f62a32",
                                "sense_id": "b30b4a95-adcb-34af-a668-da8073691495",
                                "text": "„In einem der Straßencafés kommen wir mit dem Paar am Nebentisch ins Gespräch.“"
                            },
                            {
                                "example_id": "b8432343-1f02-406a-a28b-b2cfecfb0717",
                                "sense_id": "b30b4a95-adcb-34af-a668-da8073691495",
                                "text": "„Dann wird mit einemmal die Unterhaltung am Nebentisch laut, der eine Neue führt das große Wort.“"
                            },
                            {
                                "example_id": "8c1da70c-361d-4ce8-a6a9-d90a6e1339b2",
                                "sense_id": "b30b4a95-adcb-34af-a668-da8073691495",
                                "text": "„Eine Frau setzte sich an den Nebentisch und fing an zu rauchen, ich meine, sie wollte zuhören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
