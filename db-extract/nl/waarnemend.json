                                    {
                                        "sense_id": "6108b0fb-45e4-3640-94cf-06a1c464d36f",
                                        "entry_id": "617d71d4-5dff-3dd4-a9ba-6c82610108db",
                                        "glosses": [
                                            "An action or deed."
                                        ],
