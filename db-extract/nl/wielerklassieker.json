                                    {
                                        "sense_id": "b098e589-8119-3e7f-87d7-d2a34761c10c",
                                        "entry_id": "166e3847-e533-3b25-8f81-41caf0e7ad08",
                                        "glosses": [
                                            "Se dit généralement d’un auteur à qui l’excellence ou le temps ont donné autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fc7c7a-05f0-4ef4-a0d1-6ca892adbf30",
                                                "sense_id": "b098e589-8119-3e7f-87d7-d2a34761c10c",
                                                "text": "Quelque mauvais auteur que vous estimiez ce livre [Lancelot, de Gilles Ménage], c’est un auteur classique pour vous, son autorité l’autorise."
                                            },
                                            {
                                                "example_id": "e2897603-e2e9-41b5-a7ad-8d9abd8a8570",
                                                "sense_id": "b098e589-8119-3e7f-87d7-d2a34761c10c",
                                                "text": "Classique ne se dit guère que des auteurs qu’on lit dans les classes, dans les écoles ou qui y ont grand autorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37fec927-7643-34e9-81bf-aee871816951",
                                        "entry_id": "166e3847-e533-3b25-8f81-41caf0e7ad08",
                                        "glosses": [
                                            "Qui relève d’une certaine esthétique, le classicisme, caractérisée par la recherche de l’équilibre et de la sobriété."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c28e34c3-8d93-332f-b327-3110f0782842",
                                        "entry_id": "166e3847-e533-3b25-8f81-41caf0e7ad08",
                                        "glosses": [
                                            "Traditionnel et sans extravagance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9020d5ed-677f-485b-a8cb-9077608bb041",
                                                "sense_id": "c28e34c3-8d93-332f-b327-3110f0782842",
                                                "text": "C’est une robe très sobre avec une coupe très classique."
                                            },
                                            {
                                                "example_id": "bf5ee6a8-3bc5-44a7-a908-9c69d89be631",
                                                "sense_id": "c28e34c3-8d93-332f-b327-3110f0782842",
                                                "text": "On oppose parfois l’esthétique classique à l’esthétique baroque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a06081ca-5783-3a6b-b664-cadf7e479e6b",
                                        "entry_id": "166e3847-e533-3b25-8f81-41caf0e7ad08",
                                        "glosses": [
                                            "Qui se rapporte à une période considérée comme particulièrement brillante ou équilibrée, et qui a servi de référence à des époques ultérieures."
                                        ],
                                        "tags": [],
                                        "examples": []
