    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "cb80ac2e-b366-3747-88fc-0a379c1f4565",
                    "sense_definition": "een onbepaalde of niet-gespecificeerde zaak of een ongenoemd voorwerp",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "onbepaald_voornaamwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit <w>iets</w> in mijn schoen dat erg pijn doet.",
                            "target_lang_translations": {
                                "en": "There is <w>something</w> in my shoe that hurts a lot.",
                                "ru": "В моем ботинке <w>что-то</w> есть, что причиняет сильную боль."
                            }
                        },
                        {
                            "text": "Hij heeft daarover wel <w>iets</w> gezegd maar het is me ontschoten.",
                            "target_lang_translations": {
                                "en": "He did say <w>something</w> about that, but it has slipped my mind.",
                                "ru": "Он <w>что-то</w> говорил об этом, но у меня вылетело из головы."
                            }
                        }
                    ],
                    "synonyms": [
                        "iet"
                    ],
                    "antonyms": [
                        "niets"
                    ],
                    "common_phrases": [
                        "iets te eten",
                        "iets anders",
                        "iets nieuws"
                    ],
                    "target_lang_definitions": {
                        "en": "an indefinite or unspecified thing or an unnamed object",
                        "ru": "неопределенная или неуказанная вещь или неназванный предмет"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "something",
                                "target_lang_sense_clarification": "an unspecified thing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "что-то",
                                "target_lang_sense_clarification": "некая вещь в утвердительных предложениях"
                            },
                            {
                                "target_lang_word": "кое-что",
                                "target_lang_sense_clarification": "нечто конкретное, но не названное"
                            },
                            {
                                "target_lang_word": "нечто",
                                "target_lang_sense_clarification": "более формальный вариант для неопределенного предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bb940c5-352d-3fe5-8d0b-8a5443e112a1",
                    "sense_definition": "gebruikt in vragen of ontkenningen om naar een willekeurige zaak te verwijzen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "onbepaald_voornaamwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilt u anders nog <w>iets</w> bestellen van de menukaart?",
                            "target_lang_translations": {
                                "en": "Would you like to order <w>anything</w> else from the menu?",
                                "ru": "Желаете заказать <w>что-нибудь</w> еще из меню?"
                            }
                        },
                        {
                            "text": "Heb je <w>iets</w> nodig voor het avondeten vanavond?",
                            "target_lang_translations": {
                                "en": "Do you need <w>anything</w> for dinner tonight?",
                                "ru": "Тебе нужно <w>что-нибудь</w> для сегодняшнего ужина?"
                            }
                        }
                    ],
                    "antonyms": [
                        "niets"
                    ],
                    "common_phrases": [
                        "anders nog iets"
                    ],
                    "target_lang_definitions": {
                        "en": "used in questions or negatives to refer to any arbitrary thing",
                        "ru": "используется в вопросах или отрицаниях для обозначения любой произвольной вещи"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anything",
                                "target_lang_sense_clarification": "used in questions or negative sentences"
                            },
                            {
                                "target_lang_word": "something",
                                "target_lang_sense_clarification": "used in polite offers or requests"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "что-нибудь",
                                "target_lang_sense_clarification": "любая вещь в вопросах"
                            },
                            {
                                "target_lang_word": "что-либо",
                                "target_lang_sense_clarification": "более формальный вариант для вопросов"
                            },
                            {
                                "target_lang_word": "что-то",
                                "target_lang_sense_clarification": "в вежливых просьбах или предложениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "145b983b-0527-336d-80f1-2ac92daa73af",
                    "sense_definition": "in geringe mate; een beetje of enigszins",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "graad_bijwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We komen <w>iets</w> later aan vanwege de drukte op de weg.",
                            "target_lang_translations": {
                                "en": "We are arriving <w>slightly</w> later because of the traffic on the road.",
                                "ru": "Мы приедем <w>немного</w> позже из-за пробок на дороге."
                            }
                        },
                        {
                            "text": "Het is op zich goed maar <w>iets</w> te prijzig voor ons budget.",
                            "target_lang_translations": {
                                "en": "It is good in itself, but <w>a bit</w> too pricey for our budget.",
                                "ru": "Само по себе это хорошо, но <w>немного</w> дороговато для нашего бюджета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets te veel",
                        "iets te groot",
                        "iets later"
                    ],
                    "target_lang_definitions": {
                        "en": "to a small degree; a bit or somewhat",
                        "ru": "в малой степени; немного или слегка"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slightly",
                                "target_lang_sense_clarification": "to a small degree"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "somewhat"
                            },
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "to a small extent"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "в небольшой степени"
                            },
                            {
                                "target_lang_word": "чуть-чуть",
                                "target_lang_sense_clarification": "разговорный вариант для очень малой степени"
                            },
                            {
                                "target_lang_word": "слегка",
                                "target_lang_sense_clarification": "в незначительной степени"
                            }
                        ]
                    }
                }
            ]
        }
