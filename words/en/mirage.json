{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b28aee3-ce72-35e6-8012-ba1485237475",
                    "sense_definition": "An optical phenomenon where light refraction creates an illusion of a distant object, such as water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler saw a <w>mirage</w> of water on the hot desert sand.",
                            "target_lang_translations": {
                                "zh": "旅行者在炎热的沙漠沙地上看到了水的<w>海市蜃楼</w>。"
                            }
                        },
                        {
                            "text": "Heat rising from the road created a <w>mirage</w> that looked like a puddle.",
                            "target_lang_translations": {
                                "zh": "从路面升腾的热气形成了一种看起来像水洼的<w>海市蜃楼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "desert mirage"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由于光线折射而产生的视觉现象，使人产生远处有物体（如水）的错觉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "海市蜃楼",
                                "target_lang_sense_clarification": "指大气中光线折射形成的虚幻景象，常用于沙漠或海面。"
                            },
                            {
                                "target_lang_word": "蜃景",
                                "target_lang_sense_clarification": "海市蜃楼的科学术语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a018b9-6391-3dba-9b8e-79fcb3e2ed0a",
                    "sense_definition": "Something that appears to be real but is actually an illusion or false hope.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many, the promise of instant wealth is just a <w>mirage</w>.",
                            "target_lang_translations": {
                                "zh": "对许多人来说，一夜暴富的承诺不过是一场<w>幻象</w>。"
                            }
                        },
                        {
                            "text": "Peace in the region proved to be a <w>mirage</w> that vanished quickly.",
                            "target_lang_translations": {
                                "zh": "该地区的和平被证明只是转瞬即逝的<w>泡影</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "illusion",
                        "delusion"
                    ],
                    "antonyms": [
                        "reality"
                    ],
                    "target_lang_definitions": {
                        "zh": "看似真实但实际上是幻觉或虚假希望的事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "幻象",
                                "target_lang_sense_clarification": "指虚幻的景象或想法。"
                            },
                            {
                                "target_lang_word": "泡影",
                                "target_lang_sense_clarification": "比喻容易破灭的希望或计划。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10be5b0d-7a1b-3d03-b0ee-50cf910e11aa",
                    "sense_definition": "To make something appear as if it were a mirage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun <w>miraged</w> the distant mountains into strange shapes.",
                            "target_lang_translations": {
                                "zh": "落日把远处的群山<w>幻化成</w>奇异的形状。"
                            }
                        },
                        {
                            "text": "Memories of the past were <w>miraged</w> before his eyes during the dream.",
                            "target_lang_translations": {
                                "zh": "梦境中，过去的记忆在他眼前<w>幻化为</w>虚幻的景象。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物看起来像海市蜃楼一样虚幻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……呈现幻象",
                                "target_lang_sense_clarification": "通过光线或心理作用使物体变得模糊或虚幻。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}