                ],
                "senses": [
                    {
                        "sense_id": "afd1c237-027e-3d7c-bd6a-61d4ed4ee635",
                        "entry_id": "0fb3fea5-112c-32ff-b0a1-376beb92c6af",
                        "glosses": [
                            "Herz einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1663d497-12d1-4bc9-a4bc-3f70ae7581ef",
                                "sense_id": "afd1c237-027e-3d7c-bd6a-61d4ed4ee635",
                                "text": "„Noch gebe es vieles, sagten sie, was sie über das Frauenherz nicht wussten.“"
                            },
                            {
                                "example_id": "fc1f42cb-69f8-4039-abcf-05f658e4ffef",
                                "sense_id": "afd1c237-027e-3d7c-bd6a-61d4ed4ee635",
                                "text": "„Das Frauenherz ist aber kleiner, zarter und filigraner und muss anderen Belastungen standhalten als ein Männerherz.“"
                            },
                            {
                                "example_id": "bc86db34-90e1-4a1d-b993-605cadfdfcba",
                                "sense_id": "afd1c237-027e-3d7c-bd6a-61d4ed4ee635",
                                "text": "„Wie anders das Frauenherz in vielerlei Hinsicht ist, wird nicht nur deutlich, wenn die Autorinnen von den Unterschieden zwischen hormonellen Prozessen bei Frauen und Männern berichten.“"
                            },
                            {
                                "example_id": "2bdcc0cf-ba69-476a-a05a-254bae3c6300",
                                "sense_id": "afd1c237-027e-3d7c-bd6a-61d4ed4ee635",
                                "text": "„Gleichzeitig erkranken Frauenherzen oft anders als Männerherzen, so betrifft beispielsweise das Broken-Heart-Syndrom zu 95 Prozent Frauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "36e5b302-813a-3186-9025-24e9defb6026",
                        "entry_id": "0fb3fea5-112c-32ff-b0a1-376beb92c6af",
                        "glosses": [
                            "Begehr einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e156d3-d0ce-4b84-9578-21d48a796fbd",
                                "sense_id": "36e5b302-813a-3186-9025-24e9defb6026",
                                "text": "Da gibt es alles, was das Frauenherz begehrt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
