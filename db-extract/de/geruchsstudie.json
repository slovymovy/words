                ],
                "senses": [
                    {
                        "sense_id": "5e0883ed-6f9e-3e45-925c-b57ebcf82f44",
                        "entry_id": "a54dbd05-6745-3d61-b259-38ea0f6df9f0",
                        "glosses": [
                            "wissenschaftliche Untersuchung von Geruchsstoffen und deren Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e70ddfc-4331-496c-9a24-481cc4b0e23f",
                                "sense_id": "5e0883ed-6f9e-3e45-925c-b57ebcf82f44",
                                "text": "„Castro vom Bates College im US-Bundesstaat Maine und sein Team ließen Algorithmen auf eine Datensammlung los, die bereits vielen Geruchsstudien als Grundlage diente.“"
                            },
                            {
                                "example_id": "b6220127-79b1-4f43-894c-02b2dd8c3210",
                                "sense_id": "5e0883ed-6f9e-3e45-925c-b57ebcf82f44",
                                "text": "„Ober und ihre Kolleginnen hatten für ihre Geruchsstudie 49 unverheiratete Frauen, die nie schwanger waren, als Freiwillige gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1d876c8-5fb1-3cf9-953d-419ccbab43cf",
                        "entry_id": "a54dbd05-6745-3d61-b259-38ea0f6df9f0",
                        "glosses": [
                            "Entwurf oder auch schemenhafte Vorarbeit zu einem größeren Werk im Bezug zu Gerüchen (stofflich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e86dce-8765-4224-b1f4-a4a014f449f4",
                                "sense_id": "a1d876c8-5fb1-3cf9-953d-419ccbab43cf",
                                "text": "„Nach dem Abschluss der ersten Geruchsstudie versuchen die Forscher in Seewiesen jetzt herauszubekommen, wie sich Geruchsgene und Verhalten der Vögel gleichzeitig untersuchen lassen, also wo und wann die Vögel ihren Geruchssinn auch einsetzen.“"
                            },
                            {
                                "example_id": "2ecea6ce-481a-4b84-8e8e-45716ca46be3",
                                "sense_id": "a1d876c8-5fb1-3cf9-953d-419ccbab43cf",
                                "text": "„Die Geruchsstudie gibt Ihnen die notwendigen Ergebnisse zur Ergreifung von Massnahmen an den wichtigsten Emissionsquellen, zum Einhalten der behördlichen Vorschriften und für die Erstellung von Verbreitungsmodellen der Schadstoffe um den Standort.“"
                            },
                            {
                                "example_id": "f0d3f25e-46fe-4ef1-9760-3aad63e9c57f",
                                "sense_id": "a1d876c8-5fb1-3cf9-953d-419ccbab43cf",
                                "text": "„Eine Geruchsstudie in Großbritannien förderte in dieser Hinsicht reichlich Seltsames zutage.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
