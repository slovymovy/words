                    },
                    {
                        "translation_id": "798d6fe9-567b-4a35-9017-e5e2ca123b25",
                        "source_entry_id": "fa024779-1e18-356b-84d9-6b7022d07212",
                        "source_sense_id": "67ced7d9-b754-39f1-9816-05784e5609fb",
                        "source_sense_description": "Schuss, bei dem das Projektil den Bereich des Bauches trifft",
                        "target_lang_word": "gut-shot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gut-shot",
