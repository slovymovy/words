{
    "word_family": [
        "тусклость",
        "тускнеть",
        "потускнеть"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "363635ac-16c0-30ff-ae2f-5ec55819f789",
                    "sense_definition": "Неяркий, слабый свет или источник света",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате горела <w>тусклая</w> лампочка, едва освещавшая углы.",
                            "target_lang_translations": {
                                "en": "A <w>dim</w> lightbulb was burning in the room, barely illuminating the corners."
                            }
                        },
                        {
                            "text": "Через <w>тусклое</w> стекло фонаря пробивался слабый жёлтый свет.",
                            "target_lang_translations": {
                                "en": "A weak yellow light shone through the <w>dim</w> glass of the lantern."
                            }
                        }
                    ],
                    "antonyms": [
                        "яркий",
                        "сверкающий",
                        "сияющий"
                    ],
                    "common_phrases": [
                        "тусклый свет",
                        "тусклая лампа"
                    ],
                    "target_lang_definitions": {
                        "en": "A dim, weak light or a source of such light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dim",
                                "target_lang_sense_clarification": "Used for light that is not bright or intense."
                            },
                            {
                                "target_lang_word": "faint",
                                "target_lang_sense_clarification": "Used for light that is barely perceptible or weak."
                            }
                        ]
                    },
                    "synonyms": [
                        "неяркий"
                    ]
                },
                {
                    "sense_id": "ac07e520-5046-3ea2-b5b1-5cf9106ad99e",
                    "sense_definition": "Не имеющий блеска, потерявший блеск",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старое серебро со временем стало <w>тусклым</w> и потемнело.",
                            "target_lang_translations": {
                                "en": "Old silver became <w>dull</w> and tarnished over time."
                            }
                        },
                        {
                            "text": "После долгого использования зеркало стало <w>тусклым</w>.",
                            "target_lang_translations": {
                                "en": "After long use, the mirror became <w>dull</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "блестящий"
                    ],
                    "common_phrases": [
                        "тусклая поверхность"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking luster; having lost its shine or polish."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "Used for surfaces that are not shiny or reflective."
                            },
                            {
                                "target_lang_word": "tarnished",
                                "target_lang_sense_clarification": "Specifically for metal that has lost its brightness due to oxidation."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe247f2-6719-3081-a10f-59f4c340d834",
                    "sense_definition": "Неяркий, выцветший, поблекший цвет",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На солнце краска на заборе стала <w>тусклой</w>.",
                            "target_lang_translations": {
                                "en": "The paint on the fence became <w>dull</w> in the sun."
                            }
                        },
                        {
                            "text": "Она выбрала для платья <w>тусклый</w> оттенок серого цвета.",
                            "target_lang_translations": {
                                "en": "She chose a <w>dull</w> shade of gray for her dress."
                            }
                        }
                    ],
                    "antonyms": [
                        "яркий",
                        "пёстрый",
                        "цветастый"
                    ],
                    "common_phrases": [
                        "тусклый цвет"
                    ],
                    "target_lang_definitions": {
                        "en": "A muted, faded, or washed-out color."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "Used for colors that are not vivid or bright."
                            },
                            {
                                "target_lang_word": "faded",
                                "target_lang_sense_clarification": "Used for colors that have lost their original intensity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cc5ef6b-026f-34fc-b32c-b32c20081602",
                    "sense_definition": "Лишенный блеска, выразительности (о глазах, взгляде)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От усталости его глаза стали <w>тусклыми</w>.",
                            "target_lang_translations": {
                                "en": "His eyes became <w>dull</w> from fatigue."
                            }
                        },
                        {
                            "text": "Больной человек смотрел на мир <w>тусклым</w> взглядом.",
                            "target_lang_translations": {
                                "en": "The sick man looked at the world with a <w>dull</w> gaze."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тусклый взгляд"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking sparkle, life, or expression (referring to eyes or a gaze)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "Used for eyes that lack animation or brightness."
                            },
                            {
                                "target_lang_word": "lifeless",
                                "target_lang_sense_clarification": "Used for a gaze that lacks spirit or emotion."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b406494-4a51-34f5-893f-ea179a4e8d54",
                    "sense_definition": "Бессодержательный, неинтересный, скучный",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был <w>тусклый</w> и монотонный доклад, который никто не слушал.",
                            "target_lang_translations": {
                                "en": "It was a <w>dull</w> and monotonous report that no one listened to."
                            }
                        },
                        {
                            "text": "Жизнь в маленьком городке казалась ему <w>тусклой</w>.",
                            "target_lang_translations": {
                                "en": "Life in the small town seemed <w>dull</w> to him."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking substance, interest, or excitement; boring."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "Used for something that is uninteresting or monotonous."
                            },
                            {
                                "target_lang_word": "drab",
                                "target_lang_sense_clarification": "Used for something that is cheerless or lacking in character."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}