    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "297512cd-e4f9-3714-9ae5-d4cc26fa6e8a",
                    "sense_definition": "wysuszona trawa i inne rośliny skoszone z łąki, używane jako pasza dla zwierząt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą zwierzęta gospodarskie karmi się <w>sianem</w>.",
                            "target_lang_translations": {
                                "ru": "Зимой домашний скот кормят <w>сеном</w>."
                            }
                        },
                        {
                            "text": "Rolnik zwoził <w>siano</w> do stodoły przed nadchodzącym deszczem.",
                            "target_lang_translations": {
                                "ru": "Фермер свозил <w>сено</w> в сарай перед надвигающимся дождем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapach siana",
                        "bela siana"
                    ],
                    "target_lang_definitions": {
                        "ru": "высушенная трава и другие растения, скошенные на лугу, используемые в качестве корма для животных"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сено",
                                "target_lang_sense_clarification": "скошенная и высушенная трава для корма скоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "330c71a5-90d1-371c-a921-270f4463ba6c",
                    "sense_definition": "potoczne określenie pieniędzy",
