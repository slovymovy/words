                        "examples": [
                            {
                                "example_id": "572403b6-4440-46b0-8437-8021cc1945c8",
                                "sense_id": "9c4e180b-a6d0-3775-a918-402941cb49fb",
                                "text": "Mais ces fous parfaits, qui veulent qu'on les croie aussi sages que des Thalès, ne méritent-ils pas bien qu'on leur donne le nom de morosophes, c'est à dire sages-fous ?"
                            },
                            {
                                "example_id": "ed896309-c6de-4492-9910-c54c29126f36",
                                "sense_id": "9c4e180b-a6d0-3775-a918-402941cb49fb",
                                "text": "Les morosophes apportent aux grandes questions des réponses aberrantes.\n* Parle-t-on Hollandais au paradis ?\n* Les atomes sont-ils des vaisseaux spatiaux ?\n* Le monde entre-t-il enfin dans sa phase Lilas ?"
                            }
                        ]
                    }
