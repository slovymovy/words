                "senses": [
                    {
                        "sense_id": "2e5dce61-612d-3302-9d8e-98333f1fd208",
                        "entry_id": "51dc05e8-6d74-3fc5-89c7-8f431680044b",
                        "glosses": [
                            "особая сфера перераспределительных отношений по поводу формирования и использования целевых фондов денежных средств для защиты имущественных интересов физических и юридических лиц и возмещения им материального ущерба при наступлении неблагоприятных явлений и событий, именуемых страховыми случаями."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a6fa3c-6166-4c3b-b3d5-6d217f1cd3dc",
                        "source_entry_id": "51dc05e8-6d74-3fc5-89c7-8f431680044b",
                        "source_sense_id": "2e5dce61-612d-3302-9d8e-98333f1fd208",
                        "target_lang_word": "insurance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50a85b03-b865-3f99-aa13-a5ba69b39dd3",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "A means of indemnity against a future occurrence of an uncertain event."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464b9c49-41a7-431a-9b3b-46e2242989ba",
                                                "sense_id": "50a85b03-b865-3f99-aa13-a5ba69b39dd3",
                                                "text": "The car was totalled, but fortunately I had insurance."
                                            },
                                            {
                                                "example_id": "17890a3c-041e-4606-95bd-eaf7d577b87e",
                                                "sense_id": "50a85b03-b865-3f99-aa13-a5ba69b39dd3",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7501e0e0-44d6-34b9-8702-530c664510ff",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "The business of providing insurance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731fb4fc-0c97-4c6a-b52f-ada3a7e7d4a6",
                                                "sense_id": "7501e0e0-44d6-34b9-8702-530c664510ff",
                                                "text": "After five years in banking, I switched to insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9829ea98-d7a4-3740-9faf-32712836f3f2",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "Any attempt to forestall an unfavorable event."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae667dd-35da-41df-b885-d4f1ab91c87f",
                                                "sense_id": "9829ea98-d7a4-3740-9faf-32712836f3f2",
                                                "text": "The sky was clear, but I took my umbrella for insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25bac244-2f4f-3fc8-b17c-7eb47f4aa86c",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "A bet made after the deal, which pays off if the dealer has blackjack."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8924d0e-26fc-4ad0-88d2-4195e75a5334",
                                                "sense_id": "25bac244-2f4f-3fc8-b17c-7eb47f4aa86c",
                                                "text": "I only take insurance if the count is right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7314be2a-128d-3bc8-8793-cc7d16fc3650",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "An insurance policy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e96308d7-141a-44af-a57d-57ad98070224",
                                                "sense_id": "7314be2a-128d-3bc8-8793-cc7d16fc3650",
                                                "text": "\"The children need to get back to some level of normalcy and their families can certainly use some respite to deal with things such as insurances, licences and other things they have lost,\" he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d07cffb9-f7c2-4885-8694-3ccc72a0f367",
                        "source_entry_id": "51dc05e8-6d74-3fc5-89c7-8f431680044b",
                        "source_sense_id": "2e5dce61-612d-3302-9d8e-98333f1fd208",
                        "target_lang_word": "Versicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d50b65-8579-31dd-99a6-cbd35e666e5a",
                                        "entry_id": "2588b34b-ae58-3487-946f-7c279a035984",
                                        "glosses": [
                                            "Vereinbarung, bei der eine Partei meist gegen ein Entgelt der anderen bei Eintritt bestimmter schädigender Ereignisse einen Ausgleich des Schadens zusagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa0559b-ff68-4173-8455-2c7830ed6ffe",
                                                "sense_id": "a4d50b65-8579-31dd-99a6-cbd35e666e5a",
                                                "text": "Ich habe eine Versicherung gegen Diebstahl abgeschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36dbdb76-eff9-3e9e-b1e5-c0bbc64cef02",
                                        "entry_id": "2588b34b-ae58-3487-946f-7c279a035984",
                                        "glosses": [
                                            "Unternehmen, das in Vereinbarungen meist gegen Entgelt anderen bei Eintritt bestimmter schädigender Ereignisse Ausgleich des Schadens zusagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e6d9dd-d326-4eed-8086-afbaaa5160d4",
                                                "sense_id": "36dbdb76-eff9-3e9e-b1e5-c0bbc64cef02",
                                                "text": "Meine Versicherung weigert sich, für den Schaden aufzukommen."
                                            },
                                            {
                                                "example_id": "27017fd4-19c8-457c-b960-82a86e53ebc4",
                                                "sense_id": "36dbdb76-eff9-3e9e-b1e5-c0bbc64cef02",
                                                "text": "„Céline hatte Cindy eine Versicherung verkauft.“"
                                            },
                                            {
                                                "example_id": "911f7010-a825-450e-a977-f81848e3e45f",
                                                "sense_id": "36dbdb76-eff9-3e9e-b1e5-c0bbc64cef02",
                                                "text": "„Heute sind die Schirme und ihre dreifachen Bremssysteme so ausgetüftelt, dass die Versicherungen das Snowkiten nicht mehr als Risikosport einstufen, sondern nur noch als Wagnis.“"
                                            },
                                            {
                                                "example_id": "36d5a016-1ae1-4870-892a-f3b644cad9f7",
                                                "sense_id": "36dbdb76-eff9-3e9e-b1e5-c0bbc64cef02",
                                                "text": "„Hartmut arbeitet bei einer Versicherung als Gebietsleiter für Schleswig-Holstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d1afb6a-73f3-3a3e-9861-573b6840a527",
                                        "entry_id": "2588b34b-ae58-3487-946f-7c279a035984",
                                        "glosses": [
                                            "nachdrückliche Bestätigung einer Person gegenüber, dass ein bestimmter Sachverhalt zutrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "897521fd-ed51-4e5e-b91b-78949ae4b813",
                                                "sense_id": "0d1afb6a-73f3-3a3e-9861-573b6840a527",
                                                "text": "Deinen Versicherungen traue ich nicht mehr."
                                            },
                                            {
                                                "example_id": "fa855d3c-25f6-4374-ad44-23c6b9cc11c3",
                                                "sense_id": "0d1afb6a-73f3-3a3e-9861-573b6840a527",
                                                "text": "„Meine unter Erröten hervorgebrachte Versicherung, ich benötigte dieses Kleidungsstück nur zum Skilaufen, blieb unbeachtet.“"
                                            },
                                            {
                                                "example_id": "cbd89f82-869a-4d39-82f0-4cb1c9fa2ee1",
                                                "sense_id": "0d1afb6a-73f3-3a3e-9861-573b6840a527",
                                                "text": "„Der Balken war nichts geringeres als der alte Galgen von Falaise, laut Versicherung des Tischlers, der ihn verkauft und diese Kenntnis von seinem Großvater hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
