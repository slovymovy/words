                "senses": [
                    {
                        "sense_id": "3bfb0bdf-a9d6-3ea2-842c-c0a2805d895c",
                        "entry_id": "449640fc-fb39-3215-920c-228e4679d195",
                        "glosses": [
                            "Silo für die Lagerung von Getreide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8623a44d-4ecf-44c8-8b73-fb17ce3b9cde",
                                "sense_id": "3bfb0bdf-a9d6-3ea2-842c-c0a2805d895c",
                                "text": "Der Getreidesilo ist mit einer großformatigen Werbeaufschrift versehen."
                            },
                            {
                                "example_id": "6b261efd-8f44-4946-a6f4-6f06074be642",
                                "sense_id": "3bfb0bdf-a9d6-3ea2-842c-c0a2805d895c",
                                "text": "„Der Bärtige lief nicht zum Bahnhof, sondern umrundete das Hafenbecken, vorbei am Kohlelagerplatz und den Getreidesilos.“"
                            },
                            {
                                "example_id": "4b932418-79be-49dd-8915-edb020aadae8",
                                "sense_id": "3bfb0bdf-a9d6-3ea2-842c-c0a2805d895c",
                                "text": "„Der Hof hat die modernsten Melkanlagen, mehrere Getreidesilos, eigene Biogasanlagen, Windkraft- und Solar-Energieversorgung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
