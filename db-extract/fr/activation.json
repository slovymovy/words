        "fr-extract.jsonl": [
            {
                "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                "word": "activation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c0faea3-07d8-4865-aef3-2f3ee7212468",
                        "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "tags": [
                            "plural"
                        ],
                        "form": "activations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b1e3a26-dcf5-31c7-bd1a-997cdb6504f7",
                        "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "glosses": [
                            "Action de rendre actif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22353a32-b2d8-4578-8c08-cb18ac2296dc",
                                "sense_id": "8b1e3a26-dcf5-31c7-bd1a-997cdb6504f7",
                                "text": "Si une molécule du réactif acquiert une énergie suffisante pour vaincre l'obstacle d'activation, il est possible qu'elle se coupe en deux."
                            },
                            {
                                "example_id": "1c26ae5d-5aa5-4525-959a-e2499ca64501",
                                "sense_id": "8b1e3a26-dcf5-31c7-bd1a-997cdb6504f7",
                                "text": "Markus Söder, le ministre-président de la Bavière, annonce l’activation du plan d’urgence dans les cliniques et les hôpitaux pour pouvoir accueillir les nombreux vaccinés ayant des problèmes cardiaques ou d’autres maladies comme le cancer."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9cb9886-dffa-33b2-b498-e68feb929f57",
                        "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "glosses": [
                            "Bombardement d’un matériau à l’aide de particules qui donne lieu à la production (par transmutation) d’atomes radioactifs."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6c84b9d5-502f-3391-ad0f-e394581fcf21",
                        "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "glosses": [
                            "Résultat de ce bombardement."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "20d26685-b2e0-4d63-a165-243f4be2cde0",
                                "sense_id": "6c84b9d5-502f-3391-ad0f-e394581fcf21",
                                "text": "La pièce, il l’a identifiée immédiatement. Un frein d’écrou. Il pense qu’il s’est détaché de la cuve, et après un séjour assez long au cœur du réacteur, a migré vers la boîte à eau lors de l’épreuve hydraulique. Très irradiant du fait de son activation. Ce que confirme l’expertise par le laboratoire de métallurgie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d224c6bc-d0bd-3187-9f45-4583c23e6c98",
                        "entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "glosses": [
                            "Transformation d’un composé en un produit plus réactif, généralement par une modification enzymatique, pouvant accroître sa toxicité ou sa biodisponibilité."
                        ],
                        "tags": [
                            "Toxicologie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5b15351-05f6-4815-8727-e85665fe0e89",
                        "source_entry_id": "8a2932ca-7299-3c49-b330-35a8ea0e331b",
                        "target_lang_word": "Aktivierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                        "entry_id": "a2c7b2d1-4ff1-387c-986d-547a5e41cdc2",
                                        "glosses": [
                                            "die Veranlassung von einer oder mehreren Personen, zu handeln; etwas zum Starten zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f20e7a-dbd1-4af5-bc6f-5f34354e35d6",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "Die Aktivierung der Bevölkerung gegen rechte, nationalistische und fremdenfeindliche Bewegungen ist wichtig."
                                            },
                                            {
                                                "example_id": "a6e955da-e67b-4892-9ff7-4e21471ae296",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "„Was wir gerade erleben, ist eine breite Aktivierung eines Teils der Bevölkerung, der sich früher nicht artikuliert hat. Pegida oder die zahlreichen Initiativen jetzt gegen Merkel - das ist ja etwas, was man so nicht erwartet hätte.“"
                                            },
                                            {
                                                "example_id": "30360a83-4559-4d88-a26e-1629b797fd3e",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "Auf der europäischen Leitmesse denkmal 2016 in Leipzig erhielt Wikimedia Deutschland e.V., Berlin, eine von zehn Goldmedaillen für die besondere Aktivierung des bürgerschaftlichen Engagements."
                                            },
                                            {
                                                "example_id": "7ca1566c-9006-4fef-b1c6-ecada6f5afda",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "„[Beim Mitgefühl] werden Gehirnareale aktiviert, die mit Belohnung und Zugehörigkeit assoziiert sind und deren Aktivierung sich positiv auf unseren Gesundheitszustand auswirken“, erklärt [die] Neurowissenschaftlerin [Tania] Singer."
                                            },
                                            {
                                                "example_id": "573c287d-11fe-4201-a2e9-450c7f62fb35",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "Das Üben auf einem Instrument beinhaltet die koordinierte Aktivierung zahlreicher Muskelgruppen mit hoher zeitlicher und räumlicher Präzision."
                                            },
                                            {
                                                "example_id": "b78c223a-4122-402f-9a5d-5a24f80762a9",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "Durch die Aktivierung des sympathischen Nervensystems und des Belohnungssystems war Musik in der Lage, den frühen modernen Menschen in ihrem harten Leben Momente des Glücks und des Trostes zu schenken."
                                            },
                                            {
                                                "example_id": "8fc1443d-aa53-4ced-8fe3-a52e33c812a2",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "„Die Produkte, die es hier [in der Apotheke gegen Erkältung] gibt, führen zu einer unspezifischen Aktivierung des Immunsystems - für sie gibt es keinerlei belastbare Wirksamkeitsbelege.“"
                                            },
                                            {
                                                "example_id": "5a7df027-f6b7-492c-9b9d-28c000566ea3",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "Seit der Aktivierung der [E-Mail-]Adresse [des Papstes] nach der Wahl trafen bis zum nachfolgenden Freitag bereits 56.191 E-Mails mit Glückwünschen aus der gesamten Welt ein."
                                            },
                                            {
                                                "example_id": "a3e1737c-dcf0-4962-86bd-b63ccf7d8171",
                                                "sense_id": "231295c6-9e84-37a1-b21f-bfcb384969f1",
                                                "text": "„Die Hartz-IV-Logik produziert das Gegenteil von dem, was sie leisten will: Sie erzeugt Passivität, wo sie Aktivierung vorgibt“, sagte der Arbeits- und Wirtschaftssoziologe Klaus Dörre von der Friedrich-Schiller-Universität Jena."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2beee6c-bb07-3e62-a458-ebb76d8fd458",
                                        "entry_id": "a2c7b2d1-4ff1-387c-986d-547a5e41cdc2",
                                        "glosses": [
                                            "nach Kauf (oder Eigenerstellung) eines Vermögensgegenstandes dessen Aufnahme in die Bilanz (auf der Aktivseite)"
                                        ],
                                        "tags": [
                                            "Rechnungswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "310b2aa3-bca4-409b-b891-95767393de05",
                                                "sense_id": "f2beee6c-bb07-3e62-a458-ebb76d8fd458",
                                                "text": "Ob eine Aktivierung nötig ist oder nicht erfolgt […] aus den handelsrechtlichen und steuerrechtlichen Vorschriften."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e424fd6b-3a55-32b8-9814-3ae79c7de661",
                                        "entry_id": "a2c7b2d1-4ff1-387c-986d-547a5e41cdc2",
                                        "glosses": [
                                            "Überführung in einen reaktionsbereiten Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d3d7cb-faa9-43d1-b917-b66ec8d99065",
                                                "sense_id": "e424fd6b-3a55-32b8-9814-3ae79c7de661",
                                                "text": "In vielen Fällen ist eine Aktivierung kleiner sehr reaktionsträger Moleküle, wie z. B. von Alkanen oder fluororganischen Substraten, an Übergangsmetall-Komplexen ein Schlüsselschritt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fb84e824-ec51-31b5-8640-4461813aa9f0",
                                        "entry_id": "a2c7b2d1-4ff1-387c-986d-547a5e41cdc2",
                                        "glosses": [
                                            "Zustandsänderung von ruhend zu aktiv"
                                        ],
                                        "tags": [
                                            "von Eizellen und Spermien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae53d4ce-99e9-420c-8d58-cb2f18673b7d",
                                                "sense_id": "fb84e824-ec51-31b5-8640-4461813aa9f0",
                                                "text": "Bisher haben Experimente mit Bullen- und Seeigelsperma gezeigt, dass die Aktivierung der Spermien in der Schwerelosigkeit schneller zu gehen scheint, aber dass die Schritte danach nur langsamer oder sogar gar nicht vonstatten gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "56eadb97-9880-31ac-96d7-386e18659741",
                                        "entry_id": "a2c7b2d1-4ff1-387c-986d-547a5e41cdc2",
                                        "glosses": [
                                            "Freischaltung einer Software (nach deren Installation); das Ermöglichen einzelner Features einer Software"
                                        ],
                                        "tags": [
                                            "Computer",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30492de-4a63-490c-96bf-563b9300acc9",
                                                "sense_id": "56eadb97-9880-31ac-96d7-386e18659741",
                                                "text": "Bei der Installation der Software geben sie den mitgelieferten Aktivierungscode ein. Danach kann die Aktivierung des Programms bei bestehender Online-Verbindung erfolgen."
                                            },
                                            {
                                                "example_id": "0fcd75b3-7692-4704-bc76-f6aae8969ca2",
                                                "sense_id": "56eadb97-9880-31ac-96d7-386e18659741",
                                                "text": "Für die Aktivierung von Syntaxhighlighting beim Editor Kate ist das \"XML Completion plugin\" eine große Hilfe."
                                            },
                                            {
                                                "example_id": "c9ecc7a2-8a8b-40b0-baf5-614af5a2d444",
                                                "sense_id": "56eadb97-9880-31ac-96d7-386e18659741",
                                                "text": "Die Aktivierung der Option setzt voraus, dass man dem Prozessorhersteller vertraut, keine Hintertüren in rdrand eingebaut zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
