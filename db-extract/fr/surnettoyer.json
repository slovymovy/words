                "senses": [
                    {
                        "sense_id": "9127c434-f23c-3392-80d6-b5a775be6d31",
                        "entry_id": "5f3da601-87dd-33d9-925a-c8b8b9a15e8b",
                        "glosses": [
                            "Nettoyer plus qu’il n’est nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c99ae1f-b3a2-4547-b68e-b7807401043a",
                                "sense_id": "9127c434-f23c-3392-80d6-b5a775be6d31",
                                "text": "Plus propre est la surface, plus prononcé est le contraste ; conséquemment on tend à surnettoyer avec le canon ionique."
                            },
                            {
                                "example_id": "96b939a5-726b-4fd4-bd25-2c1e706aaf50",
                                "sense_id": "9127c434-f23c-3392-80d6-b5a775be6d31",
                                "text": "Les personnes à la peau grasse ont aussi tendance à surnettoyer leur peau, ce qui ne fait qu’empirer la production de gras."
                            }
                        ]
                    }
