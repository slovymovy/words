                        "translation_id": "9605f520-ba83-483e-952d-cad4f7bd88ae",
                        "source_entry_id": "fa8d4bfb-5a8e-3995-ae2d-257871954536",
                        "source_sense_id": "4957ee67-5e8c-321f-b692-1f229431bd3b",
