                        "entry_id": "99b7b78e-367e-3402-ad6d-e46575f4f3e1",
                        "glosses": [
                            "Bateau de pêche utilisant de très longs cordages munis d’hameçons."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "40420cc2-fd12-4cbe-b476-5930182d688b",
                                "sense_id": "02147e6c-dc2e-3d3e-83cd-98e891702e18",
                                "text": "Un bateau partait à la pêche, un cordier, dont les paniers étaient rangés sur le pont."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
