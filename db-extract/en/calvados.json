                                    {
                                        "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                        "entry_id": "4298b730-98fd-3f09-b876-a83363e1141b",
                                        "glosses": [
                                            "Département normand portant le numéro 14."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5328da-b151-4a3a-a2c4-8eb5852b78dc",
                                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                                "text": "L’autopsie. Pourquoi faire ? Tous les poulets et pandores du Calvados ont déjà identifié le Vieux Marlou à son étalage de ratiches."
                                            },
                                            {
                                                "example_id": "d5aa44c8-f0c3-4150-b881-b1961db5418c",
                                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                                "text": "Il a seulement au fond de sa poche l’adresse d'un pépiniériste, dans le Calvados, à Torgeville, où un boulot l’attend."
                                            },
                                            {
                                                "example_id": "17cf3afa-dd8a-4a48-919c-37f30644cc77",
                                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                                "text": "Les îles Saint-Marcouf, ne l’oubliez pas, sont presque équidistantes du littoral de la Manche et de celui du Calvados, par le travers de la baie des Veys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
