                                "example_id": "8a0f0d14-1c28-4cc0-a0da-be66f937f05f",
                                "sense_id": "0bc38787-8f6c-3805-a38b-5944ad15a801",
                                "text": "L'équipement pour faire du slack est simple : Une sangle, 2 longes et 2 points d’attaches sont nécessaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "20443816-7697-3025-bd51-79373cb09112",
                        "entry_id": "1e035de7-2ac7-3a35-b918-7004f90f7988",
                        "glosses": [
                            "Pantalon lâche, peu serré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4f95b8-53fa-4f6b-8565-3d818d75664d",
                                "sense_id": "20443816-7697-3025-bd51-79373cb09112",
                                "text": "Sturmer était vêtu d’un slack gris, sorte de pyjama de nylon qu’il étrennait pour la circonstance."
                            },
                            {
                                "example_id": "a76ccbfd-3aca-444b-8166-c0e326ed2e97",
                                "sense_id": "20443816-7697-3025-bd51-79373cb09112",
                                "text": "Décidément, un jean, un slack ou un legging trempé dont il n’est pas question de retrousser le bas, c’est très inconfortable."
                            }
                        ]
                    }
                ],
