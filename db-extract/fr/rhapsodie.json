                "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                "word": "rhapsodie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a22a4359-545e-4fb2-b5d4-941fd4c51f4d",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "tags": [
                            "plural"
                        ],
                        "form": "rhapsodies"
                    },
                    {
                        "form_id": "df903e84-5374-4b19-8294-747e925f7a3b",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "tags": [],
                        "form": "rapsodie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "421bfd4b-e9f1-3c0d-8a12-6d9c1e87281f",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "glosses": [
                            "Chez les Grecs, morceaux détachés de l’Iliade et de l’Odyssée, que chantaient les rhapsodes."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "glosses": [
                            "Mauvais ramas, soit de vers, soit de prose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4edb59e7-a147-4791-93d3-c4adae522c5a",
                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                "text": "Je n’ai jamais vu pareille rhapsodie."
                            },
                            {
                                "example_id": "938f7b97-ba16-46d1-8f72-3fca690bbe20",
                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                "text": "Tout son discours n’était qu’une mauvaise rhapsodie."
                            },
                            {
                                "example_id": "63b5c9ec-0ce9-46f1-b548-ba98f23b3a1a",
                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                "text": "Uranie : Voulez-vous que l’on vous délace ?\nClimène : Mon Dieu, non. Ah !\nUranie : Quel est donc votre mal, et depuis quand vous a-t-il pris ?\nClimène : Il y a plus de trois heures, et je l’ai apporté du Palais-Royal.\nUranie : Comment ?\nClimène : Je viens de voir, pour mes péchés, cette méchante rapsodie de l’École des femmes. Je suis encore en défaillance du mal de cœur que cela m’a donné, et je pense que je n’en reviendrai de plus de quinze jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "82974b22-4148-33e3-af3a-ffa955402f3a",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "glosses": [
                            "Mauvais ramas de choses."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1085d807-ab46-4474-9d33-32f9ed404e45",
                                "sense_id": "82974b22-4148-33e3-af3a-ffa955402f3a",
                                "text": "Tout idéal congédié, la politique se réduirait à une rhapsodie de faits."
                            }
                        ]
                    },
                    {
                        "sense_id": "6383589d-1bb1-3e42-9c7b-43c7df0499d6",
                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "glosses": [
                            "Œuvre composée de plusieurs motifs présentés les uns après les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f624fb-6dd1-4cb5-884b-65f67caaa1b4",
                                "sense_id": "6383589d-1bb1-3e42-9c7b-43c7df0499d6",
                                "text": "Les Rhapsodies de Liszt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c55de97-0e88-45f0-9556-403a7ca2b2ca",
                        "source_entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                        "source_sense_id": "421bfd4b-e9f1-3c0d-8a12-6d9c1e87281f",
                        "source_sense_description": "antiquité",
                        "target_lang_word": "rhapsody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhapsody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a58567a-e873-33d2-8af8-17057766a5c1",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An epic poem, or part of one, suitable for uninterrupted recitation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eca1f65-7988-3f03-969e-f70d59278f09",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An exaggeratedly enthusiastic or exalted expression of feeling in speech or writing."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5299868-b0f3-41a7-a3bf-3dc5cde325d9",
                                                "sense_id": "4eca1f65-7988-3f03-969e-f70d59278f09",
                                                "text": "Of course here Mr. Pen went off into a rhapsody through which, as we have perfect command over our own feelings, we have no reason to follow the lad. Of course, love, truth, and eternity were produced: and words were tried but found impossible to plumb the tremendous depth of his affection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b579ffd1-83d9-3557-894f-ca50bd5e3be0",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "An instrumental composition of irregular form, often incorporating improvisation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "A random collection or medley; a miscellany; also, a confused string of stories, words, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd54c05-8cf8-4661-9301-62e6fa5ee20b",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "Such an act / That blurs the grace and blush of modesty; / Calls virtue hypocrite; takes off the rose / From the fair forehead of an innocent love / And sets a blister there; makes marriage vows / As false as dicers' oaths; O, such a deed / As from the body of contraction plucks / The very soul, and sweet religion makes / A rhapsody of words!"
                                            },
                                            {
                                                "example_id": "f10a1857-49a9-4578-9536-04ff02bc77b2",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "This concerneth not those mingle-mangles of many kinds of stuffe, or as the Grecians call them Rapsodies, that for such are published[…]."
                                            },
                                            {
                                                "example_id": "b480f902-2cd7-40e6-8a65-021246ad5603",
                                                "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                                                "text": "He, that makes no reflexions on what he reads, only loads his mind with a rhapsody of tales fit for the entertainment of others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11ac6da8-0fd0-34b7-901c-54ba7a68a58a",
                                        "entry_id": "1285cdb7-416f-3291-9076-61c117fabd30",
                                        "glosses": [
                                            "A literary composition consisting of miscellaneous works."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rhapsody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a031807c-6631-3a21-be17-e4d92e9cc2a6",
                                        "entry_id": "a8b36342-79ca-3d18-a1ef-172133ee1ddb",
                                        "glosses": [
                                            "Synonym of rhapsodize.",
                                            "To say (something) with exaggerated or rapturous enthusiasm."
                                        ],
