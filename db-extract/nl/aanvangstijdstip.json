                        "examples": [
                            {
                                "example_id": "d1368351-a083-4ae8-8641-d98cadbf9e8b",
                                "sense_id": "012cb418-caa7-34a8-a7b3-c772429c6ae8",
                                "text": "De duels zullen voornamelijk starten om 19.30 of 21.45 uur. Voor enkele duels staat de aftrap om 17.15 uur genoteerd, maar de spelersvakbond maakt bezwaar tegen dat aanvangstijdstip vanwege mogelijke tropische temperaturen."
                            },
                            {
                                "example_id": "82e779e4-c521-4c78-a21a-42aae6e05229",
                                "sense_id": "012cb418-caa7-34a8-a7b3-c772429c6ae8",
                                "text": "Door de wijzigingen is er op verzoek van ESPN ook geschoven met het aanvangstijdstip van drie andere duels: zaterdag 24 april begint Sparta- VVV om 18.45 uur en PSV-FC Groningen om 20.00 uur. Op zondag 25 april trappen FC Emmen en Heracles nu om 12.15 uur af."
                            }
