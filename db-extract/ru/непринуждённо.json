                        ]
                    },
                    {
                        "translation_id": "90807603-9448-43e4-8846-36503f5b1d86",
                        "source_entry_id": "b137baa3-b976-3021-b76c-ef1c51a280be",
                        "source_sense_id": "bac5bd40-7b37-3ef2-8b62-e85f40786f76",
                        "target_lang_word": "ungezwungen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungezwungen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                        "entry_id": "966c1798-dea1-331d-a2c3-51d1dade7630",
                                        "glosses": [
                                            "frei, ohne Hemmungen und Förmlichkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fbfc05-e22a-4935-9dc0-88fd123645b8",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "Bei den Wikipediatreffen geht es ganz ungezwungen zu."
                                            },
                                            {
                                                "example_id": "9fffe093-13d6-4618-9578-82398788fe94",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "Nach der Lesung können sie sich ungezwungen bei einem Tee oder Glas Wein mit dem Autor unterhalten."
                                            },
                                            {
                                                "example_id": "15e6f768-3c8e-4382-bbb7-36a4e300e8cc",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "Bei einem persönlichen Gespräch im Pfarrhaus können sie ihren Pfarrer ganz ungezwungen kennenlernen."
                                            },
                                            {
                                                "example_id": "0619420b-6b72-4e4b-9e41-4f70cefac1f0",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "Wir veranstalten jedes Jahr zu Weihnachten ein ungezwungenes Adventssingen und wir freuen uns über jeden, der mitmacht."
                                            },
                                            {
                                                "example_id": "43cebffb-eb39-4f73-9056-3e1b0109be5e",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„Einen ungezwungenen Ton schlägt an, wer eine andere Person gut kennt. Er spricht frei und offen wie mit einer Freundin oder einem Freund.“"
                                            },
                                            {
                                                "example_id": "e59c4f6a-e793-4449-8529-99f74b6ec536",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "[Ausbildungsmessen:] „In ungezwungener Atmosphäre können die Ausbildungssuchenden ihre persönlichen Vorstellungen mit der Praxis abgleichen.“"
                                            },
                                            {
                                                "example_id": "5706f110-0f26-4bc9-9591-ed85337e8552",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„Im Rahmen des Vorschulturnens sollen Familien mit verschiedenem kulturellem Hintergrund in ungezwungener Atmosphäre aufeinandertreffen.“"
                                            },
                                            {
                                                "example_id": "1db47ec4-5da1-4481-a7d9-1f598da45f9f",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„Interviewerin: »Warum machen sie denn eigentlich FKK-Urlaub?« Interviewte: »Ich finde das so herrlich ungezwungen und gesünder. […]«“"
                                            },
                                            {
                                                "example_id": "a43114f7-2110-4a4e-a2f5-818c9f856fc6",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„[…] Hot Pants haben einen großen Vorteil: Sie sind sexy, aber man kann damit Rad fahren, bequem sitzen, überhaupt sich ungezwungen bewegen, ohne das etwas hervor blitzt.“"
                                            },
                                            {
                                                "example_id": "10116257-5a6c-423c-a6e5-410f5a85d82d",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„Sie präsentieren sich und ihre Vorlieben oft sehr persönlich und ungezwungen im Internet. Sogenannte Influencer haben tausende von Followern […]“"
                                            },
                                            {
                                                "example_id": "21e091c4-95be-475e-9311-d4fd5f720102",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "[Beatles:] „[…] für Liebhaber ist der Filmschnipsel von unschätzbarem Wert – zeigt er doch die vielleicht berühmteste Musikband in einem ungezwungenen Moment: Wie sie in der Maske schäkern, lachen, Faxen machen.“"
                                            },
                                            {
                                                "example_id": "d2cf5fe8-b3f8-4948-842c-c36495a76748",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "[Königin Luise von Preußen:] „[…] die Königin [wird] als schön und anmutig, mit ungezwungenen Umgangsformen, die eher bürgerlich als aristokratisch waren, beschrieben […].“"
                                            },
                                            {
                                                "example_id": "79bcbeca-3e0a-4327-b682-fa9e04a8c79d",
                                                "sense_id": "5ef06b8f-6b19-3421-b685-c2eebbb5f50c",
                                                "text": "„Spaniens Thronfolger kommt als drittes Kind von König Juan Carlos und dessen Frau Sofia am 30. Januar 1968 in Madrid zur Welt. Seine Kindheit ist unbeschwert und ungezwungen. Von wenigen offiziellen Auftritten abgesehen, lebt und benimmt er sich wie jeder andere Junge seines Alters auch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c4b1e5-63f1-4e96-996a-27840e871c8f",
                        "source_entry_id": "b137baa3-b976-3021-b76c-ef1c51a280be",
                        "source_sense_id": "bac5bd40-7b37-3ef2-8b62-e85f40786f76",
                        "target_lang_word": "zwanglos",
