                        "sense_id": "d3a2079b-4c2a-3b29-8828-644d111f805c",
                        "entry_id": "767cc9ce-7e82-3483-85ec-6ccd33cce74a",
                        "glosses": [
                            "eine Bezeichnung für einen Kursachsen, da diesen nachgesagt wird, Kaffeeliebhaber zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4af9fcc-429e-4fcc-8424-45fa4ec661e3",
                                "sense_id": "d3a2079b-4c2a-3b29-8828-644d111f805c",
                                "text": "Auch der Begriff Kaffeesachse, der bei Criegern nicht erwähnt wird, hatte zumindest zunächst eine abwertende Bedeutung."
                            },
                            {
                                "example_id": "dca6cb78-18c9-4386-b0e1-dd301e1a4272",
                                "sense_id": "d3a2079b-4c2a-3b29-8828-644d111f805c",
                                "text": "Nicht viel anders verhält es sich mit dem Begriff der »Kaffeesachsen«. Angeblich trinken die Kursachsen viel mehr Kaffee als die anderen Deutschen, so daß sie den Namen Kaffeesachsen bekommen haben und für sich in Anspruch nehmen."
                            }
                        ],
