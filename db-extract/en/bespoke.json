{
    "word": "bespoke",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a81f5401-8f63-3d32-9590-1d8105b928d4",
                "word": "bespoke",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                        "entry_id": "a81f5401-8f63-3d32-9590-1d8105b928d4",
                        "glosses": [
                            "Made or done in a way adjusted to the needs of a specific person or group (e.g., customer, health care patient, do-it-yourselfer), and thus specialized and, in some cases, unique."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5898b6fc-854d-4550-b38d-87a068315a9c",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "Near-synonyms: custom-made, tailored, tailor-made, custom-built, purpose-built; see also Thesaurus:custom-made"
                            },
                            {
                                "example_id": "bf5f16eb-2810-44d9-bbc5-2dc1932aebda",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "Marc Valeric, a Beverly Hills milliner, sold 125 bespoke hats in two weeks to women desperate to dress properly for royal receptions."
                            },
                            {
                                "example_id": "74aa3007-fd42-4aee-8233-fd0008277386",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "Were Athenian pots bespoke, bearing images requested by Etruscans?"
                            },
                            {
                                "example_id": "a207b8a5-e869-4729-a1fa-8c4631f1f604",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "People gathered round, since it was something of an event, their MP, in his bespoke pinstripe and red tie, clutching an old Wellington boot and about to hurl it through the air."
                            },
                            {
                                "example_id": "a5d7f9b6-49f9-4b03-b4a4-5dd81cec894c",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "… others are attempting the more ambitious feat of engineering bespoke human organs from scratch."
                            },
                            {
                                "example_id": "aef10f92-ac52-4a5c-b6a5-7567ab78ed64",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "There are 436 escalators in the London Underground, and every one is totally bespoke."
                            },
                            {
                                "example_id": "2d57d099-6fc3-4cc3-ba09-b8466cca3fd2",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "You need to get a nice bespoked suit. \"Bespoke\" means i's custom-made to fit your specific dimensions and emphasize what's flattering about your shape."
                            },
                            {
                                "example_id": "73fd1f69-cf23-4e3f-be76-dd142ee05373",
                                "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                                "text": "[I]t becomes a game of parkour just to change a battery, and when you’re working mostly alone that gets frustrating really fast, and when you get frustrated you get impulsive, and those impulses lead to half measure solutions, and those half measure solutions accumulate into a whole network of bespoke inefficiencies that you just live with because the process of unravelling them feels just so... big."
                            }
                        ]
                    },
                    {
                        "sense_id": "af3b40c7-64c5-364f-99a6-24184ab0dec1",
                        "entry_id": "a81f5401-8f63-3d32-9590-1d8105b928d4",
                        "glosses": [
                            "Relating to someone who makes custom-made products, especially clothing items."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "529e1c3d-a00b-423d-989f-7f24af1b9167",
                                "sense_id": "af3b40c7-64c5-364f-99a6-24184ab0dec1",
                                "text": "a bespoke tailor"
                            }
                        ]
                    }
