                "senses": [
                    {
                        "sense_id": "a0b79d6c-0590-3895-8ebd-a7d5e60b1378",
                        "entry_id": "85ba2a10-d302-3f7b-bc06-4c37ca375a91",
                        "glosses": [
                            "Qui dissimule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813bc5ac-8a42-4a39-b952-5a3c55d1c8e7",
                                "sense_id": "a0b79d6c-0590-3895-8ebd-a7d5e60b1378",
                                "text": "Sincère ou non, cependant, lorsqu’il envie l’existence du sage, son silence dissimulateur le sert plus que ses propos qui sont rares."
                            },
                            {
                                "example_id": "4b30af67-3759-4e45-aa3b-1f4e50ae6eb5",
                                "sense_id": "a0b79d6c-0590-3895-8ebd-a7d5e60b1378",
                                "text": "La patronne sourit vaguement en concluant par ces mots. Ce n’était ni un sourire dissimulateur, ni un sourire mystérieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
