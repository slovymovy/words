                "senses": [
                    {
                        "sense_id": "c75a5697-3f54-3fc6-83ee-9110ff8f9d9e",
                        "entry_id": "6c167e4e-79c8-3510-90f6-316bad0c7379",
                        "glosses": [
                            "Coudre en formant une poche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673f67e8-1ea5-4c8f-9c31-b28d82b54853",
                                "sense_id": "c75a5697-3f54-3fc6-83ee-9110ff8f9d9e",
                                "text": "La structure fibreuse de la membrane périkystique imprime, d'une part, une rigidité à la poche marsupialisée, fait qui s'oppose partiellement au collapsus des parois et à la disparition de la cavité, et, d'autre part, la structure fibreuse des parois."
                            }
                        ]
                    },
                    {
                        "sense_id": "951dd4c0-2104-34e7-9879-c72fdb0f0d95",
                        "entry_id": "6c167e4e-79c8-3510-90f6-316bad0c7379",
                        "glosses": [
                            "Avoir un développement de l’embryon à l’extérieur du corps."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f4ed6369-85ee-4cc6-90ab-105766bc2a82",
                                "sense_id": "951dd4c0-2104-34e7-9879-c72fdb0f0d95",
                                "text": "Si la poule bouffe des cailloux & en engendre les coquilles où marsupialiser sa progéniture, le lapin, qui pourtant prolifère & ne songe qu’à piner & lapiner, bouffe sa merde."
                            }
                        ]
                    }
