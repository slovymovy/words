                            {
                                "example_id": "9da05709-6c9b-4b75-8e96-1aacdca37965",
                                "sense_id": "8fb3b878-dd2d-38b8-bcdf-9dab2780287a",
                                "text": "De creator van de tv-show, Tina Fey, kreeg heel – democratisch - Amerika plat met haar vileine persiflage van McCains running mate Sara Palin."
                            },
                            {
                                "example_id": "08f0f483-8b42-4d6b-9608-7b4cb4d95c30",
                                "sense_id": "8fb3b878-dd2d-38b8-bcdf-9dab2780287a",
                                "text": "Matena: \"Toonder was de creator, dus je stond altijd bij hem in het krijt. Het was moeilijk om je van die stijl los te maken. Toen ik 24 was ging ik voor mezelf beginnen, bij Pep en andere bladen. Het heeft me jaren gekost om de invloed van Toonder kwijt te raken. Dat is het gevaar als op jonge leeftijd in een bepaalde stijl gaat werken.\""
                            }
                        ]
