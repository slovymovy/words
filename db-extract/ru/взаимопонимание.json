                                    },
                                    {
                                        "sense_id": "275457bf-f84d-3b79-91cc-2cec3344023e",
                                        "entry_id": "36feb08c-e2b1-31c4-9b35-419728371ba7",
                                        "glosses": [
                                            "A situationship; a relationship where two people like each other and are mutually aware of it, but have yet to have an official romantic relationship"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0fca147-041a-48a6-92be-d77e55843b03",
                        "source_entry_id": "eb3a9b75-c6ce-3bb3-9f32-b6ea7c61f4aa",
                        "source_sense_id": "9332f586-7cb1-3346-9705-d25aa29d7a03",
                        "target_lang_word": "rapport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34d01079-55d3-3a67-b8dd-f9515d15ca9c",
                                        "entry_id": "9b6ded84-fc7c-3d56-8554-69a911adac60",
                                        "glosses": [
                                            "A relationship of mutual trust and respect; a close and harmonious relationship in which the people or groups concerned understand each other's feelings or ideas and communicate well."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3262185c-1857-4b54-aa66-7f06876d07fa",
                                                "sense_id": "34d01079-55d3-3a67-b8dd-f9515d15ca9c",
                                                "text": "He always tried to maintain a rapport with his customers."
                                            },
                                            {
                                                "example_id": "ffc7e90a-e814-4523-bbea-c289e1ff84b0",
                                                "sense_id": "34d01079-55d3-3a67-b8dd-f9515d15ca9c",
                                                "text": "Such a man would almost certainly be pouring out a constant stream of loving thought towards humanity, and this thought would be a real and potent shower of blessing, tending generally towards the spiritual helping of those upon whom it fell; and there is no doubt that the man who was earnestly thinking of or praying to that saint would come into rapport with him, and would therefore draw down upon himself a great deal of that force, though entirely without the knowledge of the saint from whom it came."
                                            },
                                            {
                                                "example_id": "e6f786f5-af99-43c9-b24d-ca8a480387b6",
                                                "sense_id": "34d01079-55d3-3a67-b8dd-f9515d15ca9c",
                                                "text": "\"You can't have less than nothing. They ignore them altogether. Some time ago I had a series of cases of telepathic rapport which I wished to lay before the Royal Society.\""
                                            },
                                            {
                                                "example_id": "a44ed15d-9e96-45ed-9eb9-fd8f33c70a9d",
                                                "sense_id": "34d01079-55d3-3a67-b8dd-f9515d15ca9c",
                                                "text": "She'd expected to sleep fitfully. Her bunk was in an alcove separated from the others physically by a server partition and sonically by an extra-loud electronic hum, which didn't surprise her since she'd only started attempting a chummier rapport with her troops in the year which hadn't happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f2142a-5e4c-3555-8ccd-07d6ad7b04a4",
                                        "entry_id": "9b6ded84-fc7c-3d56-8554-69a911adac60",
                                        "glosses": [
                                            "Relation; proportion; conformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa72eb67-9dfc-4c7e-8d88-bc9de6926770",
                                                "sense_id": "f0f2142a-5e4c-3555-8ccd-07d6ad7b04a4",
                                                "text": "'Tis obvious enough, what rapport there is, and muſt ever be, between the Thoughts and Words, the Conceptions and Languages of every Country, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
