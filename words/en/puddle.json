{
    "word_family": [
        "puddly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f16ba1c-88c9-3841-b5c1-4be6b0b9d9c0",
                    "sense_definition": "A small, shallow pool of water, often formed on the ground after rain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "water_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed jumping into every <w>puddle</w> they found on the sidewalk.",
                            "target_lang_translations": {
                                "cs": "Děti si užívaly skákání do každé <w>louže</w>, kterou na chodníku našly."
                            }
                        },
                        {
                            "text": "My shoes got wet because I stepped into a deep <w>puddle</w>.",
                            "target_lang_translations": {
                                "cs": "Boty mi promokly, protože jsem šlápl do hluboké <w>louže</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pool"
                    ],
                    "common_phrases": [
                        "rain puddle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá, mělká vodní plocha, často vznikající na zemi po dešti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "louže",
                                "target_lang_sense_clarification": "běžné označení pro nahromaděnou vodu na povrchu"
                            },
                            {
                                "target_lang_word": "kaluž",
                                "target_lang_sense_clarification": "často používané pro menší nebo špinavější nahromadění tekutiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a158ace1-699c-30ff-9a09-f230e40dddcf",
                    "sense_definition": "Water that is dirty, stagnant, or polluted.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "water_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animals refused to drink from the stagnant <w>puddle</w> of muddy water.",
                            "target_lang_translations": {
                                "cs": "Zvířata odmítla pít ze stojaté <w>kaluže</w> bahnité vody."
                            }
                        },
                        {
                            "text": "The heavy rain turned the stream into a foul <w>puddle</w> of waste.",
                            "target_lang_translations": {
                                "cs": "Silný déšť proměnil potok v odpornou <w>kaluž</w> odpadu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Voda, která je špinavá, stojatá nebo znečištěná."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "špinavá kaluž",
                                "target_lang_sense_clarification": "zdůrazňuje znečištění vody"
                            },
                            {
                                "target_lang_word": "stoka",
                                "target_lang_sense_clarification": "v přeneseném smyslu pro velmi znečištěné místo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a052b388-2f49-3735-a9ca-451e39c40ada",
                    "sense_definition": "The circular ripple or disturbance left in water after an oar or paddle is removed.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water_disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rower watched the <w>puddle</w> fade away behind the boat.",
                            "target_lang_translations": {
                                "cs": "Veslař sledoval, jak se <w>vír</w> za lodí rozplývá."
                            }
                        },
                        {
                            "text": "Each stroke of the oar left a clear <w>puddle</w> on the surface.",
                            "target_lang_translations": {
                                "cs": "Každý záběr vesla zanechal na hladině jasný <w>vír</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kruhové vlnění nebo narušení hladiny vody po veslu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vír",
                                "target_lang_sense_clarification": "kruhové narušení hladiny"
                            },
                            {
                                "target_lang_word": "čeření",
                                "target_lang_sense_clarification": "obecný pohyb hladiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ac2e0d1-09ee-382d-8c64-ff73783f2e06",
                    "sense_definition": "A mixture of clay and water used to make surfaces watertight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers used a layer of <w>puddle</w> to seal the base of the canal.",
                            "target_lang_translations": {
                                "cs": "Inženýři použili vrstvu <w>hněteného jílu</w> k utěsnění dna kanálu."
                            }
                        },
                        {
                            "text": "Traditional pond construction often relies on a thick lining of <w>puddle</w>.",
                            "target_lang_translations": {
                                "cs": "Tradiční stavba rybníků často spoléhá na silnou vrstvu <w>hněteného jílu</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Směs jílu a vody používaná k vytvoření nepropustných povrchů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jílová těsnicí vrstva",
                                "target_lang_sense_clarification": "technický popis materiálu"
                            },
                            {
                                "target_lang_word": "hnětený jíl",
                                "target_lang_sense_clarification": "materiál připravený mechanickým zpracováním"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5bfb9fd-00d6-371d-9fbe-2ad5b27ca99c",
                    "sense_definition": "To play or splash around in water or mud.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "play",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddlers love to <w>puddle</w> in the backyard after a heavy storm.",
                            "target_lang_translations": {
                                "cs": "Batolata se po silné bouřce ráda <w>cákají</w> na zahradě."
                            }
                        },
                        {
                            "text": "It is fun to <w>puddle</w> in the rain if you have your boots on.",
                            "target_lang_translations": {
                                "cs": "Je zábavné <w>cákat se</w> v dešti, pokud máte holínky."
                            }
                        }
                    ],
                    "synonyms": [
                        "splash"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrát si nebo cákat se ve vodě či blátě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cákat se",
                                "target_lang_sense_clarification": "hra ve vodě"
                            },
                            {
                                "target_lang_word": "brodit se",
                                "target_lang_sense_clarification": "pohyb v mělké vodě nebo blátě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6551be6e-0d07-3e92-9b07-4521b638a52d",
                    "sense_definition": "To make something dirty or muddy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pollution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain began to <w>puddle</w> the clear stream with dirt from the banks.",
                            "target_lang_translations": {
                                "cs": "Silný déšť začal <w>zakalovat</w> čistý potok hlínou z břehů."
                            }
                        },
                        {
                            "text": "Do not let the construction work <w>puddle</w> the local water supply.",
                            "target_lang_translations": {
                                "cs": "Nenechte stavební práce <w>zakalit</w> místní zásobování vodou."
                            }
                        }
                    ],
                    "synonyms": [
                        "pollute",
                        "muddy"
                    ],
                    "antonyms": [
                        "purify"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit něco špinavým nebo zabláceným."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zablátit",
                                "target_lang_sense_clarification": "znečištění blátem"
                            },
                            {
                                "target_lang_word": "zakalit",
                                "target_lang_sense_clarification": "znečištění vody nečistotami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c309465-e195-3082-88b7-4884ec4f1144",
                    "sense_definition": "To create a small pool of liquid on a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaking roof began to <w>puddle</w> on the kitchen floor.",
                            "target_lang_translations": {
                                "cs": "Z děravé střechy se začala na kuchyňské podlaze <w>tvořit louže</w>."
                            }
                        },
                        {
                            "text": "Spilled coffee started to <w>puddle</w> around the edge of the cup.",
                            "target_lang_translations": {
                                "cs": "Rozlitá káva se začala <w>rozlévat</w> kolem okraje šálku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit malou louži tekutiny na povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tvořit louže",
                                "target_lang_sense_clarification": "hromadění tekutiny"
                            },
                            {
                                "target_lang_word": "rozlévat se",
                                "target_lang_sense_clarification": "vytváření plochy tekutiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1129234-9e35-3675-9cf9-0bfd027d333d",
                    "sense_definition": "For insects like butterflies to gather on wet ground to absorb minerals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many butterflies <w>puddle</w> on the damp soil to collect necessary nutrients.",
                            "target_lang_translations": {
                                "cs": "Mnoho motýlů <w>pije z vlhké půdy</w>, aby získali potřebné živiny."
                            }
                        },
                        {
                            "text": "You can often see groups of butterflies <w>puddle</w> near the riverbank.",
                            "target_lang_translations": {
                                "cs": "Často můžete vidět skupiny motýlů, jak <w>pijí z vlhké půdy</w> u břehu řeky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hmyz (např. motýli) se shromažďuje na mokré zemi, aby získal minerály."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pít z vlhké půdy",
                                "target_lang_sense_clarification": "popis chování hmyzu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea88f527-46ff-3705-9de6-26aff0a23bed",
                    "sense_definition": "To refine molten metal by stirring it in a furnace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industrial_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workers used long rods to <w>puddle</w> the iron in the hot furnace.",
                            "target_lang_translations": {
                                "cs": "Dělníci používali dlouhé tyče k <w>pudlování</w> železa v horké peci."
                            }
                        },
                        {
                            "text": "The process to <w>puddle</w> iron was essential during the industrial revolution.",
                            "target_lang_translations": {
                                "cs": "Proces <w>pudlování</w> železa byl během průmyslové revoluce zásadní."
                            }
                        }
                    ],
                    "synonyms": [
                        "refine"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rafinovat roztavený kov mícháním v peci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pudlovat",
                                "target_lang_sense_clarification": "historický metalurgický proces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c118a3d-c3ba-3e1f-bfa9-aa731d4c4d24",
                    "sense_definition": "To line a structure with clay to prevent water leakage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>puddle</w> the canal to ensure it would hold water.",
                            "target_lang_translations": {
                                "cs": "Museli kanál <w>utěsnit jílem</w>, aby zajistili, že udrží vodu."
                            }
                        },
                        {
                            "text": "It is necessary to <w>puddle</w> the pond base with clay.",
                            "target_lang_translations": {
                                "cs": "Je nutné <w>utěsnit jílem</w> dno rybníka."
                            }
                        }
                    ],
                    "synonyms": [
                        "seal"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vystlat strukturu jílem, aby se zabránilo úniku vody."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "utěsnit jílem",
                                "target_lang_sense_clarification": "technický proces izolace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8488d399-5911-3de7-b385-dbf9ade1f92c",
                    "sense_definition": "To group ideas or information into categories.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers began to <w>puddle</w> their notes into distinct themes.",
                            "target_lang_translations": {
                                "cs": "Výzkumníci začali své poznámky <w>třídit</w> do odlišných témat."
                            }
                        },
                        {
                            "text": "It helps to <w>puddle</w> complex concepts before writing the final report.",
                            "target_lang_translations": {
                                "cs": "Před psaním závěrečné zprávy pomáhá <w>kategorizovat</w> složité koncepty."
                            }
                        }
                    ],
                    "synonyms": [
                        "categorize",
                        "group"
                    ],
                    "target_lang_definitions": {
                        "cs": "Seskupit nápady nebo informace do kategorií."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kategorizovat",
                                "target_lang_sense_clarification": "třídění informací"
                            },
                            {
                                "target_lang_word": "třídit",
                                "target_lang_sense_clarification": "organizace dat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8023c999-9ee1-3105-b54e-7f6bc8c6e097",
                    "sense_definition": "To make a material dense by working it while wet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers must <w>puddle</w> the clay thoroughly to make it waterproof.",
                            "target_lang_translations": {
                                "cs": "Dělníci musí jíl důkladně <w>hníst</w>, aby byl vodotěsný."
                            }
                        },
                        {
                            "text": "You should <w>puddle</w> the soil mixture until it becomes firm.",
                            "target_lang_translations": {
                                "cs": "Směs zeminy byste měli <w>zhutňovat</w>, dokud nebude pevná."
                            }
                        }
                    ],
                    "synonyms": [
                        "compact"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit materiál hustým jeho zpracováním za mokra."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hníst",
                                "target_lang_sense_clarification": "mechanické zpracování materiálu"
                            },
                            {
                                "target_lang_word": "zhutňovat",
                                "target_lang_sense_clarification": "zvyšování hustoty materiálu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}