                "senses": [
                    {
                        "sense_id": "4c1c49e8-53b0-3b55-8e0f-703bce5a7af1",
                        "entry_id": "db076bf6-2206-3884-9960-d32e8ba413a8",
                        "glosses": [
                            "indigene nordamerikanische Numic-Sprache (Shoshone-Sprache), die im Südwesten der USA gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6cdf82-746c-403b-aa08-1438882dd36e",
                                "sense_id": "4c1c49e8-53b0-3b55-8e0f-703bce5a7af1",
                                "text": "„Die Gespräche mit Cameahwait waren sehr zeitaufwendig, da keine direkte Übertragung von Shoshone in die Englische Sprache möglich war.“"
                            },
                            {
                                "example_id": "8c259c96-1426-4722-8a62-8ce58606981f",
                                "sense_id": "4c1c49e8-53b0-3b55-8e0f-703bce5a7af1",
                                "text": "„Shoshone ›ta‹ findet sich, di, abgeändert in Tesuque ›ta‹[.]“"
                            },
                            {
                                "example_id": "47415f36-4843-4793-a202-6719ab717c26",
                                "sense_id": "4c1c49e8-53b0-3b55-8e0f-703bce5a7af1",
                                "text": "„Einige Sprachen sind vorwiegend analytisch (z. B. Coos), viele agglutinierend (Sahaptin, Shoshone; Ketschua), andere flektierend (Takelma, Yokuts).“"
                            },
                            {
                                "example_id": "1484344f-25c7-4f71-8681-d32e601d3c72",
                                "sense_id": "4c1c49e8-53b0-3b55-8e0f-703bce5a7af1",
                                "text": "„Die Shoshone-Familie [Bedeutung 2] heißt jetzt Numic und umfasst Ute (2.000 Sprecher), Paiute (2.000 Sprecher), Shoshone (3.000 Sprecher) [Bedeutung 1] und Comanche[…]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f43c6d8-8926-39a3-b8d2-d1cc50e02933",
                        "entry_id": "db076bf6-2206-3884-9960-d32e8ba413a8",
                        "glosses": [
                            "Zweig innerhalb der Sprachfamilie der uto-aztekischen Sprachen (umfasst unter anderem die Sprachen Shoshone, Paiute, Ute und Comanche)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3502f39b-3e49-4d80-8e92-c0696aeea9d1",
                                "sense_id": "3f43c6d8-8926-39a3-b8d2-d1cc50e02933",
                                "text": "„Die Shoshone-Familie [Bedeutung 2] heißt jetzt Numic und umfasst Ute (2.000 Sprecher), Paiute (2.000 Sprecher), Shoshone (3.000 Sprecher) [Bedeutung 1] und Comanche[…]“"
                            },
                            {
                                "example_id": "191477df-62f9-4200-b6c3-f96ae270d3ea",
                                "sense_id": "3f43c6d8-8926-39a3-b8d2-d1cc50e02933",
                                "text": "„Die kalifornischen Indianer gehörten, wenn man von den zahlreichen kleinen und kleinsten Splittergruppen des äußersten Nordwestens absieht, drei Sprachfamilien an: dem Hoka, dem Pentui und dem Shoshone, einem uto-aztekischen Dialekt.“"
                            },
                            {
                                "example_id": "f7805d3b-2cb5-431d-b9cd-bde92ce7afee",
                                "sense_id": "3f43c6d8-8926-39a3-b8d2-d1cc50e02933",
                                "text": "„Nördliche Paiute[:] Indianer des Großen Beckens (Great Basin), deren Shoshone-Dialekt zur Uto-Aztekischen Sprachgruppe gehört.“"
                            },
                            {
                                "example_id": "865dd8a1-deda-48c0-a74f-9df354e99a4d",
                                "sense_id": "3f43c6d8-8926-39a3-b8d2-d1cc50e02933",
                                "text": "„Einen ähnlichen Fall liefert die Gruppe der Shoshone. Innerhalb dieser Sprachfamilie sind besondere Bezeichnungen für Vater und Mutter im […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
