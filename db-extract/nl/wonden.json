            {
                "entry_id": "faec1cce-75b3-33b0-a25e-df49fba3ee8f",
                "word": "wonden",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e6ce938-d576-325b-9ede-56f38f03452d",
                        "entry_id": "faec1cce-75b3-33b0-a25e-df49fba3ee8f",
                        "glosses": [
                            "een wond toebrengen, verwonden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f5539555-8603-4141-ba29-6f286f2592a9",
                                "sense_id": "5e6ce938-d576-325b-9ede-56f38f03452d",
                                "text": "Zeer nabij graasde een kudde buffels, waarvan wij er verscheidene wondden, doch geen enkele doodden."
                            }
                        ]
                    },
                    {
                        "sense_id": "8827d0ae-855c-3e7b-a8b7-bbf0d2aed60d",
                        "entry_id": "faec1cce-75b3-33b0-a25e-df49fba3ee8f",
                        "glosses": [
                            "emotioneel kwetsen"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b060b158-6c63-487a-b985-a64b7b87d8a6",
                                "sense_id": "8827d0ae-855c-3e7b-a8b7-bbf0d2aed60d",
                                "text": "Ik weigerde en daarmee wondde ik haar diep."
                            },
                            {
                                "example_id": "4e7a46f1-00d2-4fb9-8849-b964b0000c7a",
                                "sense_id": "8827d0ae-855c-3e7b-a8b7-bbf0d2aed60d",
                                "text": "Men wondt mij met de tong."
                            }
                        ]
