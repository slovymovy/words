                ],
                "senses": [
                    {
                        "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                        "entry_id": "0084c909-64bf-3a1d-837b-3523aa2f8886",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81c1099-cc02-4a04-a2fe-4b2f0c0ec1da",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Frau Sontag ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "41034d67-2103-41c6-a0f8-207283bbff11",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Herr Sontag wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "55a9005d-67b8-40a9-a67d-5ba016dc4a14",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Die Sontags fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4a1c4461-fc67-4b05-8a59-aa5e02a9eb26",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Der Sontag trägt nie die Schals, die die Sontag ihm strickt."
                            },
                            {
                                "example_id": "f81d6785-1b58-4452-aca1-608407151377",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sontag kommt, geht der Herr Sontag.“"
                            },
                            {
                                "example_id": "40a638c8-e239-44b2-a5b9-bfebe0666ccc",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Sontag kommt und geht."
                            },
                            {
                                "example_id": "02fe7232-32d6-4526-8272-e96721a1b62a",
                                "sense_id": "fe89fefa-2321-3d8d-a472-65c6a1cb4ff3",
                                "text": "Sontags kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
