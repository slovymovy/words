                "senses": [
                    {
                        "sense_id": "c0e88cee-9df8-3a1b-a0cd-b45c7c016be0",
                        "entry_id": "c0182f19-17d5-3cd8-965c-45e019f5f29d",
                        "glosses": [
                            "Ort, an dem Busse (normalerweise als öffentliches Verkehrsmittel) halten, damit Passagiere ein- und aussteigen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bbe0570-22f3-4b18-8a68-0fe172cf6ac0",
                                "sense_id": "c0e88cee-9df8-3a1b-a0cd-b45c7c016be0",
                                "text": "„Der Weg quert zweimal die Straße, bevor man den Bushalt östlich von Töll erreicht.“"
                            },
                            {
                                "example_id": "7b45cb9e-d6b0-4f19-89f5-1c3e8fa66c4f",
                                "sense_id": "c0e88cee-9df8-3a1b-a0cd-b45c7c016be0",
                                "text": "„Er begrüßte auch die Bushalts in Höhe der Mittelinsel, die Autofahrer zum Anhalten zwingen, als ‚zeitgemäß‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
