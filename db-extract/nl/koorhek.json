                    {
                        "sense_id": "a95b4102-bf67-3f72-a16a-afc849d2e6e0",
                        "entry_id": "9a9c9ea1-6d59-3fa9-8cb9-5e2e7bd3cdca",
                        "glosses": [
                            "hek dat staat tussen het koor en het schip van een kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566a6f80-46a2-4d97-86bc-66b4c7084775",
                                "sense_id": "a95b4102-bf67-3f72-a16a-afc849d2e6e0",
                                "text": "De Nieuwe Kerk in Amsterdam heeft een flinke opfrisbeurt gekregen voor de inhuldiging van koning Willem-Alexander. De garderobe en de winkel zijn verwijderd, het koorhek is gepoetst, het houtwerk is in de was gezet en alles is stofvrij gemaakt voor de ceremonie op 30 april."
                            },
                            {
                                "example_id": "b25781e9-2a6e-4e1b-89cd-f30c2f062752",
                                "sense_id": "a95b4102-bf67-3f72-a16a-afc849d2e6e0",
                                "text": "Premier Mark Rutte heeft donderdag de eerste acht medailles uitgereikt aan personen die een extra en actieve bijdrage hebben geleverd aan een goed verloop van de troonswisseling. Dat gebeurde in De Nieuwe Kerk in Amsterdam, achter het koorhek. In het andere deel van de kerk liepen mensen rond die het voor de inhuldiging versierde interieur wilden bekijken."
                            }
                        ]
                    }
