                        "entry_id": "6f5c910d-4092-3026-bba6-76dd119b321d",
                        "glosses": [
                            "Something excreted in that manner, especially urine or feces."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
