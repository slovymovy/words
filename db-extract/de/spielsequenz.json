                "senses": [
                    {
                        "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                        "entry_id": "f59f9cd1-a04b-3d5c-afcd-b24c04d08295",
                        "glosses": [
                            "Folge von einzelnen Spielen oder Spielabschnitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad00641e-ed2b-439d-988d-1c38585d4a10",
                                "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                                "text": "„Eine weitere Funktion der Spielanalyse kann darin bestehen, über die im Hauptteil dieses Buches gegebenen Hinweise hinaus Strukturen von Spielsequenzen herauszuarbeiten.“"
                            },
                            {
                                "example_id": "b8d5abfc-ea10-42a0-aef3-2f9f9193c599",
                                "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                                "text": "„Im ersten Schritt erfasste ich in einem offenen Beobachtungsprotokoll stichpunktartig alle Interaktionen und Handlungen eines Kindes während einer fünfminütigen Spielsequenz.“"
                            },
                            {
                                "example_id": "7fd4b94c-3fca-4426-a06c-3c773ba20be8",
                                "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                                "text": "„Diese können z.B. beim Schlafengehen zu ganzen Spielsequenzen mit Versteck- und Fangspielen sowie Vorlesegeschichten in immer gleichen Abläufen ausgebaut werden.“"
                            },
                            {
                                "example_id": "8b6f2f17-dd89-493c-b7a0-a3e38cdbac06",
                                "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                                "text": "„Im Fußball können sie einzelne Spielsequenzen wie etwa die Rückeroberung des Balles oder den Spielaufbau automatisch identifizieren.“"
                            },
                            {
                                "example_id": "10350bdf-89ed-4479-af82-46bbd885ff75",
                                "sense_id": "eb12bbe5-da51-3b3b-a22d-9165003769a6",
                                "text": "„In einer einzigen Spielsequenz kann man per Hechtsprung einem Ball ausweichen und seinerseits einen zu vorwitzigen Gegner abwerfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
