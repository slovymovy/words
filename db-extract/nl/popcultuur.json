                        "examples": [
                            {
                                "example_id": "668b9a49-72bd-474f-af04-7009775a70c6",
                                "sense_id": "60ef93e5-1e97-3461-9ef2-d957e89b7096",
                                "text": "Vijf eerstejaars studenten van de Academie voor Popcultuur zijn het geweld tegen treinconducteurs zat. Daarom richtten ze de Facebook-pagina #TreinRespect op. Het is eigenlijk heel simpel: schud de hand van een conducteur, maak daar een selfie van en post 'm online. Het doel: meer respect afdwingen voor conducteurs."
                            },
                            {
                                "example_id": "b22b9365-e1cb-4842-abf3-d2b5017a38b8",
                                "sense_id": "60ef93e5-1e97-3461-9ef2-d957e89b7096",
                                "text": "De grootste beurs voor liefhebbers van stripboeken, superhelden, fantasyseries en eigenlijk alles wat met popcultuur te maken heeft, begint vandaag in het Amerikaanse San Diego. Daar worden ook de nieuwe Star Wars- en Hunger Game-films gepresenteerd en kunnen fans vragen stellen aan de acteurs van onder andere Game Of Thrones en The Walking Dead. En er is nog veel meer te zien."
                            }
                        ]
                    }
