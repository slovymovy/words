        "fr-extract.jsonl": [
            {
                "entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                "word": "cheftaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e969fb7-7273-4525-a857-dc9123ab5075",
                        "entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "cheftaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                        "entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                        "glosses": [
                            "Jeune femme responsable d’une troupe de jeunes scouts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc3ced21-9166-48fb-81c8-dc88e87779c8",
                                "sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                                "text": "Une ancienne cheftaine d’éclaireuses, qui dissimulait une timidité de garçon sous des gestes brusques, dressa les listes, par ordre alphabétique."
                            },
                            {
                                "example_id": "36f050f9-0bf5-4d54-ba7c-0a3d60338bdf",
                                "sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                                "text": "Comme elle aimait marcher, qu’elle voulait tout voir de Paris et que ses jolies jambes avaient en leurs muscles des résistances insoupçonnées de cheftaine à lunettes, ils partaient le matin au petit bonheur des rues, droit devant eux."
                            },
                            {
                                "example_id": "9afb8b2a-87c0-406c-8131-f994ed7d72ef",
                                "sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                                "text": "Un mercredi, Florence rentrait à bicyclette, les genoux un peu griffés, les chaussettes pleines d’ajoncs, les souliers pleins de boue, de la forêt du Petit-Mûr, où la cheftaine Françoise Braneau avait organisé un jeu de piste."
                            },
                            {
                                "example_id": "cac92239-e51c-4993-9318-d448771b4182",
                                "sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                                "text": "Introduites officiellement dans ce mouvement masculin à partir de 1931, les cheftaines font, en effet, leur apparition en vue de permettre l’extension de la branche cadette du scoutisme, le louvetisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7dfdda0-d606-3736-9073-017eeb5513b9",
                        "entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                        "glosses": [
                            "Celle qui est à la tête d’un corps, d’une assemblée, etc., qui y a le premier rang et la principale autorité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7edae4-9849-44ad-9387-07b826ededb0",
                                "sense_id": "d7dfdda0-d606-3736-9073-017eeb5513b9",
                                "text": "Nous ne pouvons bouleverser l’échelle, dit la cheftaine. Mais il y a les primes de fin d’année. Elle continua de parcourir le C.V., stylo à la main, entourant un mot, soulignant une phrase."
                            },
                            {
                                "example_id": "02214618-4292-4d2a-ab06-5e5d333f80a1",
                                "sense_id": "d7dfdda0-d606-3736-9073-017eeb5513b9",
                                "text": "Ne dirigeant plus de village autonome, la cheftaine n’est pas reconnue au niveau de l’administration centrale du Cameroun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "559e7679-446c-47fe-a8a6-a3246012e77a",
                        "source_entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                        "source_sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                        "source_sense_description": "Responsable d’une troupe de jeunes scouts",
                        "target_lang_word": "chieftain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chieftain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                        "entry_id": "a16d0343-aa8b-30bf-977f-74b514249eac",
                                        "glosses": [
                                            "A leader of a clan or tribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e397467-a7cf-4f9d-bd88-041c88f686bf",
                                                "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                                "text": "VI. THE PUYUMA GROUP.\nThe tribes belonging to this group occupy the plains in Hinan and that neighbourhood, and call themselves \"Puyumas,\" but the Chinese call them the \"Hinan Savages\". The Puyumas formed a very powerful State some 300 years ago, and united under one single rule as many as seventy isolated tribes scattered over the land, stretching from Hakusekikwaku and Seikoko to Harogwai in the southern part of the island, and were at one time so powerful that the chieftain was called by foreigners \"The King of Hinan\"."
                                            },
                                            {
                                                "example_id": "2bf9bd5e-7c68-4afd-909d-6ee8eb1c8299",
                                                "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                                "text": "They were probably the work of individual craftsmen working to meet the chieftains' needs. Their place in the chronology of the big cemeteries is indicated by the less richly-decorated double-springed bronze brooches which are found here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615f59c7-1c78-38bb-b563-23579839f6d2",
                                        "entry_id": "a16d0343-aa8b-30bf-977f-74b514249eac",
                                        "glosses": [
                                            "A leader of a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44f10db-1e12-41a3-8f74-1c590a05e65e",
                                                "sense_id": "615f59c7-1c78-38bb-b563-23579839f6d2",
                                                "text": "The robber chieftain divided up the spoils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18d97af8-639b-4c76-92de-e210ebf0e7d5",
                        "source_entry_id": "baae687a-f735-362d-a4ba-865811320c8d",
                        "source_sense_id": "627b20a4-29fc-3ba6-a351-8af69dd8002e",
                        "source_sense_description": "Responsable d’une troupe de jeunes scouts",
                        "target_lang_word": "akela",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akela",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2842ea2a-d0c7-383b-b05e-373da3bcc0f4",
                                        "entry_id": "8ddbbf0c-83e1-3636-a48e-b0f57fb1ef06",
                                        "glosses": [
                                            "leider van een groep welpen bij de padvinderij"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07173915-fa44-4d77-996b-50a9534435eb",
                                                "sense_id": "2842ea2a-d0c7-383b-b05e-373da3bcc0f4",
                                                "text": "Die dag trouwde Hendrik Christiaan Gerard de Vries met Theuntje van der Wal - mijn ouders. Zij was zo te zien akela en hij hopman. Niemand kon vermoeden dat de erehaag van padvinders en verkenners betekende dat beiden later in hun leven spitsroeden zouden lopen."
                                            },
                                            {
                                                "example_id": "f670783b-1f0d-4fe4-92ff-11fe54ec92fd",
                                                "sense_id": "2842ea2a-d0c7-383b-b05e-373da3bcc0f4",
                                                "text": "'Laat mij maar, ik ben heel goed in spoorzoeken,' zegt ze als een gediplomeerd akela."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "35bbe6ad-4a4e-3742-97b4-2126dc8e34e7",
                "word": "cheftaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ddfa7a4-e583-4263-9d2c-dbde138ebb99",
                        "entry_id": "35bbe6ad-4a4e-3742-97b4-2126dc8e34e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "cheftaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fc39312-9ada-349b-9616-9de5f02f8f8f",
                        "entry_id": "35bbe6ad-4a4e-3742-97b4-2126dc8e34e7",
                        "glosses": [
                            "Capitaine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4bc406cd-4960-4abf-87a9-d7788b4c1b4c",
                                "sense_id": "7fc39312-9ada-349b-9616-9de5f02f8f8f",
                                "text": "Jacques de Delley d’Agnens, chevalier co-seigneur de Delley en Vaudois, cheftaine des six-vingts arbalestriers de la cour de Savoye et gentilhomme-échanson du duc Amédée VIII, qualités dans lesquelles il est inscrit sur les registres de la maison de ce prince."
                            },
                            {
                                "example_id": "665b1aec-3b1e-49c4-9e6b-b14ee49247d7",
                                "sense_id": "7fc39312-9ada-349b-9616-9de5f02f8f8f",
                                "text": "À ces mots, le groupe compact se desserra et s’éparpilla comme les grains de blé qui tombent d’un sac ouvert, puis entoura Alain, le cheftaine des Routiers, d’un double et triple cercle, comme les anneaux d’un serpent."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a90580f-f6c1-3217-86ac-fcd666c881d5",
                        "entry_id": "35bbe6ad-4a4e-3742-97b4-2126dc8e34e7",
                        "glosses": [
                            "Nonne qui avait la direction et la responsabilité de la salle d’un hôpital ou d’un hospice, où œuvraient plusieurs nonnes hospitalières."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "24ac279f-62f0-454c-aaaa-a9df5892958f",
                                "sense_id": "5a90580f-f6c1-3217-86ac-fcd666c881d5",
                                "text": "La sœur Dominique est cheftaine de cette salle : elle est fort estimée des personnes qui la connaissent. Comme elle est malade en ce moment, c’est la sœur Henri qui est cheftaine par intérim."
                            },
                            {
                                "example_id": "26f1b83a-e90a-4fb7-9739-76d18032048c",
                                "sense_id": "5a90580f-f6c1-3217-86ac-fcd666c881d5",
                                "text": "La sœur cheftaine de la salle m’a dit ce jour-là que cette jeune fille s’était depuis quelque temps adonnée avec fureur à la masturbation, qu’elle pratiquait par l’introduction de corps dans le vagin."
                            }
                        ]
                    }
                ],
