                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e865e4-803d-4279-af66-a01e19813abd",
                                "sense_id": "1f1332db-685c-3ff7-bfda-e160ec2e047b",
                                "text": "Только когда Петушок ― золотой гребешок прокукарекал полночь, а в домике Бараньей Шкурки труба закурилась, Зайка засопела носиком и завела далеко-далеко свои синие глазки: прямо на пруд… ловить рыбку."
                            }
                        ]
                    }
