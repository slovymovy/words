                "senses": [
                    {
                        "sense_id": "d896bfa1-45aa-3f7a-b387-be370da64182",
                        "entry_id": "481c4b11-7183-3e4b-8908-f6454754f60d",
                        "glosses": [
                            "Donner un caractère instable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8abcdd-9aa6-4bbd-acb8-17db49f48f49",
                                "sense_id": "d896bfa1-45aa-3f7a-b387-be370da64182",
                                "text": "Le mathématicien ne cherche pas à « endurer », à styliser son corps, ses gestes ou son âme sur un mode qui lui permettra de donner le minimum de prise aux épreuves susceptibles de l’instabiliser."
                            },
                            {
                                "example_id": "e7854653-6f27-47f5-8af6-3afd2aad8128",
                                "sense_id": "d896bfa1-45aa-3f7a-b387-be370da64182",
                                "text": "Du fait de ton état d’esprit qui te pousse au mal, on est en droit de penser, ô homme, que tu t’es instabilisé."
                            }
                        ]
                    }
