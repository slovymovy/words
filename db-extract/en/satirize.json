                "senses": [
                    {
                        "sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                        "entry_id": "a55ef810-45f5-33e7-adf3-5e5f38768f12",
                        "glosses": [
                            "To make a satire of; to mock."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee36af85-81c8-42ca-926e-a73a8ca0ab59",
                                "sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                                "text": "Classic writers are prone to satirize women lashingly, but Jonson's satire is different."
                            },
                            {
                                "example_id": "9e987fc4-4ea3-44e2-8b2e-6c77d985b31b",
                                "sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                                "text": "Nat Habib, the producer‐director at the Scarsdale theater, says that “Flahooley,” which satirizes big business, was in part a victim of the McCarthyism of the times."
                            },
                            {
                                "example_id": "e8b1a4c9-c870-4c55-aafc-9ce6be55a70d",
                                "sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                                "text": "It occasionally suffers from the pontification so deservedly satirized in rockumentaries like This Is Spinal Tap."
                            },
                            {
                                "example_id": "666489d5-8877-4e80-8913-d77324a8b594",
                                "sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                                "text": "But Reitman, who also coscripted the film (with Sheldon Turner) from a novel by Walter Kirn, isn't interested in merely satirizing the existence of guys like Bingham."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938e1b7a-0e21-4418-a26b-357635e89897",
                        "source_entry_id": "a55ef810-45f5-33e7-adf3-5e5f38768f12",
                        "source_sense_id": "83c7a63d-d59e-371e-bb25-40bf5a310daf",
                        "source_sense_description": "make a satire",
                        "target_lang_word": "satiriser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
