                                                "sense_id": "c198af31-0005-3ff7-bb2a-87911c9279e3",
                                                "text": "Der Vorarbeiter korrigiert geringfügige Fehler selbst."
                                            },
                                            {
                                                "example_id": "e3c4b3bf-39fc-43eb-b25c-453d5da22db0",
