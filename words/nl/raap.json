                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "slang/informal, mug"
                            },
                            {
                                "target_lang_word": "noggin",
                                "target_lang_sense_clarification": "slang for head"
                            },
                            {
                                "target_lang_word": "gob",
                                "target_lang_sense_clarification": "slang, mouth/face"
                            }
