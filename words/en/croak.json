{
    "word_family": [
        "croaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5418907-c06c-3649-ba30-e6f591ece959",
                    "sense_definition": "The characteristic low, harsh sound made by a frog or toad.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the loud <w>croak</w> of a frog near the pond at night.",
                            "target_lang_translations": {
                                "cs": "V noci jsme u rybníka slyšeli hlasité <w>kvákání</w> žáby."
                            }
                        },
                        {
                            "text": "The swamp was filled with the rhythmic <w>croak</w> of many toads.",
                            "target_lang_translations": {
                                "cs": "Močál byl naplněn rytmickým <w>kvákáním</w> mnoha ropuch."
                            }
                        }
                    ],
                    "synonyms": [
                        "ribbit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Charakteristický hluboký, drsný zvuk vydávaný žábou nebo ropuchou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvákání",
                                "target_lang_sense_clarification": "zvuk vydávaný žábami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d1c587-cc5a-37ed-8c88-7ad28ca0f003",
                    "sense_definition": "A faint, harsh sound produced in the throat, often due to illness or dryness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to speak, but only a dry <w>croak</w> came out of his throat.",
                            "target_lang_translations": {
                                "cs": "Pokusil se promluvit, ale z hrdla se mu vydralo jen suché <w>zachroptění</w>."
                            }
                        },
                        {
                            "text": "Her voice was reduced to a painful <w>croak</w> after the long concert.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém koncertu se její hlas změnil v bolestivé <w>chraptění</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Slabý, chraplavý zvuk vycházející z hrdla, často způsobený nemocí nebo vysušením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chraplavý zvuk",
                                "target_lang_sense_clarification": "zvuk při mluvení s nemocným hrdlem"
                            },
                            {
                                "target_lang_word": "zachroptění",
                                "target_lang_sense_clarification": "krátký, drsný zvuk v hrdle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c27760e0-0a1d-3817-8e78-11244546474f",
                    "sense_definition": "The harsh, guttural call made by certain birds like ravens or crows.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The raven let out a sudden <w>croak</w> from the top of the tree.",
                            "target_lang_translations": {
                                "cs": "Krkavec z vrcholu stromu náhle <w>zakrákal</w>."
                            }
                        },
                        {
                            "text": "I recognized the bird by its deep and repetitive <w>croak</w>.",
                            "target_lang_translations": {
                                "cs": "Ptáka jsem poznal podle jeho hlubokého a opakujícího se <w>krákání</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Drsné, hrdelní volání některých ptáků, jako jsou krkavci nebo vrány."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krákání",
                                "target_lang_sense_clarification": "zvuk vydávaný krkavcovitými ptáky"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74d0c1bb-75f7-3d2a-a636-69a530345f71",
                    "sense_definition": "To produce a low, harsh sound, typically as a frog or toad.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frogs began to <w>croak</w> as soon as the sun went down.",
                            "target_lang_translations": {
                                "cs": "Jakmile zapadlo slunce, žáby začaly <w>kvákat</w>."
                            }
                        },
                        {
                            "text": "Listen to the bullfrogs <w>croak</w> in the distance.",
                            "target_lang_translations": {
                                "cs": "Poslouchej, jak v dálce <w>kvákají</w> skokani."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat hluboký, drsný zvuk, typicky jako žába nebo ropucha."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kvákat",
                                "target_lang_sense_clarification": "vydávat zvuk charakteristický pro žáby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "188165d7-79ed-3b4a-b05b-edc3d3e2f6c9",
                    "sense_definition": "To speak in a low, hoarse, or strained voice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>croak</w> out a request for water.",
                            "target_lang_translations": {
                                "cs": "Podařilo se mu chraplavě <w>vychrčet</w> prosbu o vodu."
                            }
                        },
                        {
                            "text": "She could only <w>croak</w> a few words because of her sore throat.",
                            "target_lang_translations": {
                                "cs": "Kvůli bolavému hrdlu dokázala jen <w>zachraptět</w> pár slov."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvit hlubokým, chraplavým nebo namáhavým hlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chraptět",
                                "target_lang_sense_clarification": "mluvit s námahou nebo chraplavě"
                            },
                            {
                                "target_lang_word": "vychrčet",
                                "target_lang_sense_clarification": "vyslovit něco s námahou chraplavým hlasem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a9ececd-8263-3d62-8634-1bd6eba1757a",
                    "sense_definition": "To die.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old engine finally <w>croaked</w> after years of heavy use.",
                            "target_lang_translations": {
                                "cs": "Starý motor po letech těžkého provozu konečně <w>natáhl bačkory</w>."
                            }
                        },
                        {
                            "text": "He was afraid he would <w>croak</w> before he finished his work.",
                            "target_lang_translations": {
                                "cs": "Bál se, že <w>zařve</w>, než dokončí svou práci."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often disrespectful way to refer to death."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zemřít (slangově)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "natáhnout bačkory",
                                "target_lang_sense_clarification": "nespisovný, hovorový výraz pro smrt"
                            },
                            {
                                "target_lang_word": "zařvat",
                                "target_lang_sense_clarification": "velmi neformální, vulgární výraz pro smrt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "410c736b-634a-3d73-8c61-597c096edf99",
                    "sense_definition": "A family name of Irish origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Croaks</w> have lived in this village for many generations.",
                            "target_lang_translations": {
                                "cs": "Rodina Croakových žije v této vesnici po mnoho generací."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Croak</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal muže jménem pan Croak."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení irského původu."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        }
    ]
}