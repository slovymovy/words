                "senses": [
                    {
                        "sense_id": "792469fb-b3ac-3e19-81b3-34aa0d9818ff",
                        "entry_id": "a2e6bca8-39da-3b1f-96fe-615da5cf4f4e",
                        "glosses": [
                            "Se poser sur une comète, pour une sonde ou un vaisseau spatial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1405ab76-e0b0-48cc-b0cb-6f698f7972c9",
                                "sense_id": "792469fb-b3ac-3e19-81b3-34aa0d9818ff",
                                "text": "C’est le Mercredi 12 novembre qui marquera le \"premier pas\" de la race humaine sur une comète. Le robot explorateur Philaé vient d’acométir."
                            },
                            {
                                "example_id": "3a1a8d33-d242-41fe-8141-e031569ab987",
                                "sense_id": "792469fb-b3ac-3e19-81b3-34aa0d9818ff",
                                "text": "C’est pas con leur idée d’harponner^([sic]) \"en hauteur\" et de faire acométir toute la sonde. Par contre faut pas que le harpon foire, ils ont interêt^([sic]) à prévoir un spare :D"
                            },
                            {
                                "example_id": "cbaf7bbf-f910-4ca1-b8e1-fc8cf43c0d95",
                                "sense_id": "792469fb-b3ac-3e19-81b3-34aa0d9818ff",
                                "text": "En plus, c’est pas fini !! En fin de mission, ils vont tenter de faire acométir Rosetta !! Ça va être ouf ! On va avoir des images encore plus précises."
                            }
                        ]
                    }
