                                        "sense_id": "5950a9a8-a1ac-3715-a770-d612049ee6f5",
                                        "entry_id": "3fd1fd79-41ea-35b7-b5bd-567749d7835e",
                                        "glosses": [
                                            "Zusammenwirken verschiedener Medien, wie zum Beispiel Text, Video und Bild, die sich zu einem Werk vereinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6423304c-eac0-44fa-a4b5-669868f766db",
                                                "sense_id": "5950a9a8-a1ac-3715-a770-d612049ee6f5",
                                                "text": "Firmen, die im Bereich des Multimedia tätig sind, boomten in den 1990er Jahren."
