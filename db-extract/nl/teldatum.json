                    {
                        "sense_id": "14f77c74-f466-3f66-98a6-0222818426af",
                        "entry_id": "89ac2f43-88b6-34fe-9424-30edddd2564a",
                        "glosses": [
                            "datum waarop men bepaalt hoeveel leerlingen er op een school staan ingeschreven, zodat de overheid kan bepalen op hoeveel middelen een school recht heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82cd2107-be5f-42cd-9337-80a6abf14184",
                                "sense_id": "14f77c74-f466-3f66-98a6-0222818426af",
                                "text": "De ROC's mogen van de mbo- raad namelijk geen cursisten inschrijven. Die zouden, na de jaarlijkse teldatum van 1 oktober, dan namelijk in aanmerking komen voor een rijkstoelage. En dat wordt te duur."
                            },
                            {
                                "example_id": "cb565db7-d33c-45d0-9ed9-f93e3d34bd86",
                                "sense_id": "14f77c74-f466-3f66-98a6-0222818426af",
                                "text": "Basisschool Het Galjoen krijgt twee leslokalen extra. Dat gebeurt op basis van de prognose van het aantal leerlingen. Volgens de cijfers van de teldatum op 1 oktober 2008 heeft de school recht op die extra lokalen."
                            },
                            {
                                "example_id": "9cc0837d-1102-4edc-8a0b-aecb2531cd91",
                                "sense_id": "14f77c74-f466-3f66-98a6-0222818426af",
                                "text": "De officiële teldatum is 1 oktober. En er staan 24 leerlingen méér ingeschreven dan vorig jaar. Het grootste deel van de stijging is toe te schrijven aan vier van de negen reguliere openbare scholen. Want vooral de Anninkschool, 't Schöppert, de Wilbertschool en de Vockerschool doen het goed."
                            }
                        ]
                    }
