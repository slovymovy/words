                                "target_senses": [
                                    {
                                        "sense_id": "74e63099-9c7a-3e31-bd3f-b55fbc8a76ff",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "Genitiv: Grün oder Grüns, Plural: Grün oder Grüns"
                                        ],
                                        "tags": [],
