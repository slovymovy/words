                    "frequency": "Middle",
                    "semantic_group_id": "mechanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie steckte den Schlüssel ins Schloss und <w>drehte</w> ihn zweimal nach rechts <w>um</w>."
                        },
                        {
                            "text": "Man muss den Hebel vorsichtig <w>umdrehen</w>, um den Mechanismus nicht zu beschädigen."
                        }
                    ],
                    "synonyms": [
