                                "target_senses": [
                                    {
                                        "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                        "entry_id": "9ff6bcbe-51f5-3350-9432-be5439f5b4ae",
                                        "glosses": [
                                            "Ureinwohner Amerikas, männlich oder unbestimmten Geschlechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff4470d-a536-4179-b3de-f152ba383625",
                                                "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                                "text": "„Nicht, dass wir Amerikaner uns nach der Staatsgründung den überlebenden Indianern gegenüber besonders zuvorkommend verhalten hätten - doch unser Verbrechen war kein Genozid.“"
                                            },
                                            {
                                                "example_id": "65faa2d9-8d9d-4f3f-95ae-5143bfc97056",
                                                "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                                "text": "„Danach lud Waldrut den Indianer noch in ihre Wohnung auf einen Kaffee ein, und trotz großer Sprachschwierigkeiten verstanden sich die beiden bestens.“"
                                            },
                                            {
                                                "example_id": "3d09170f-85ac-41fb-a6e0-75603d6c82de",
                                                "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "6b08d1b6-c17a-48a1-b8ab-894b46f9fde2",
                                                "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                                "text": "„Die Indianer fühlten sich dadurch um ihre Kriegsbeute betrogen.“"
                                            },
                                            {
                                                "example_id": "a8b2b6d5-d071-40d5-9de8-5806f6848f82",
                                                "sense_id": "162f99cd-fee6-3d0b-8245-f37e3202309d",
                                                "text": "„Kolumbus war überzeugt, dass er an einer kleinen Insel vor der Küste Ostasiens angelangt war, und dass die Menschen, denen er am Strand begegnete, Inder waren (weshalb die Ureinwohner bis heute als »Indios« oder »Indianer« bezeichnet werden).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "028761b2-7413-4e81-8f97-3d1a5137f85e",
                        "source_entry_id": "58f4a79e-32ba-3ab1-8ac1-1dc22cc0bc4c",
                        "source_sense_id": "80bcfd4d-470b-3623-b7f2-3a7f37ff128f",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Inder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f90822b-85c0-3e5b-8b74-ba6e78b08507",
                                        "entry_id": "34968482-c5ec-3c9f-a056-b63c4d6999a0",
                                        "glosses": [
                                            "Staatsangehöriger, Staatsbürger, Bewohner von Indien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffa3f06-6929-4611-93e1-6acb6306b888",
                                                "sense_id": "8f90822b-85c0-3e5b-8b74-ba6e78b08507",
                                                "text": "So haben Angehörige unterschiedlicher Kulturkreise, z. B. ein Inder oder ein Araber, andere Vorstellungen von einem guten Klang."
                                            },
                                            {
                                                "example_id": "7a3a8138-b216-4365-ae5a-5228c3d1d6c8",
                                                "sense_id": "8f90822b-85c0-3e5b-8b74-ba6e78b08507",
                                                "text": "Diese ursprünglich für einige Jahre als Arbeiter angeworbenen Inder waren fast ausschließlich Tamilen aus Südindien."
                                            },
                                            {
                                                "example_id": "39a9b25a-fe5f-4b67-86d0-e2c56ec0795a",
                                                "sense_id": "8f90822b-85c0-3e5b-8b74-ba6e78b08507",
                                                "text": "„Kolumbus war überzeugt, dass er an einer kleinen Insel vor der Küste Ostasiens angelangt war, und dass die Menschen, denen er am Strand begegnete, Inder waren (weshalb die Ureinwohner bis heute als »Indios« oder »Indianer« bezeichnet werden).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2673f3f1-d47a-496c-8c95-12c3294b9bad",
                        "source_entry_id": "58f4a79e-32ba-3ab1-8ac1-1dc22cc0bc4c",
