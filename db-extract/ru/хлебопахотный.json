                                        "entry_id": "ca159e31-f94d-3655-8163-b14d9b86acad",
                                        "glosses": [
                                            "Able to be plowed or tilled, capable of growing crops (traditionally contrasted with pasturable lands such as heaths)."
                                        ],
                                        "tags": [
                                            "of land"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d55d62-aa05-4882-9e87-e1fd242e5642",
                                                "sense_id": "c9c9eae3-5b57-38cc-bfb3-741d03447bc6",
                                                "text": "And again, since no animal now stole, it was unnecessary to fence off pasture from arable land […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68231f7-752c-3f84-9cb6-ec79c361817e",
                                        "entry_id": "ca159e31-f94d-3655-8163-b14d9b86acad",
                                        "glosses": [
                                            "Under cultivation (within any quinquennial period) for the production of crops sown and harvested within the same agricultural year (contrasted with permanently-cropped lands such as orchards)."
                                        ],
                                        "tags": [
                                            "of land"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e55095-a813-336b-8b28-fcee51bbe3e7",
                                        "entry_id": "4cf3faa4-c64b-35e6-805c-b81f4d3bdea2",
                                        "glosses": [
                                            "Land that can be cropped (i.e., land that is arable); land that is being cropped (i.e., land that is in the cropping phase of a crop rotation, currently being cropped rather than used as pasture or fallow)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
