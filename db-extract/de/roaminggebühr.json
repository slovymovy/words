                "senses": [
                    {
                        "sense_id": "ae226dde-a034-3d6d-8499-be3077d089fc",
                        "entry_id": "153b7895-23c1-3083-9bae-2901997da42b",
                        "glosses": [
                            "Gebühr, die man für die Nutzung des Roamings entrichten muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9f85b4-e073-47d5-9922-9d6797b3880e",
                                "sense_id": "ae226dde-a034-3d6d-8499-be3077d089fc",
                                "text": "„Sie zeigte sich auch über die neue Linie der EU-Staaten überrascht, die bisher gegen Roaminggebühren auftraten.“"
                            },
                            {
                                "example_id": "3d530f2f-4b0e-4162-aea7-f4d5bb0cab79",
                                "sense_id": "ae226dde-a034-3d6d-8499-be3077d089fc",
                                "text": "„Und es gibt Anbieter, die bereits auf Roaminggebühren verzichten und europaweit den gleichen Preis berechnen wie in Deutschland.“"
                            },
                            {
                                "example_id": "da587f29-78b3-4469-9d9a-ae8af982d463",
                                "sense_id": "ae226dde-a034-3d6d-8499-be3077d089fc",
                                "text": "„In Arbeitskleidung auf einem Hocker im Fenster sitzend, wählte sie die Nummer der elterlichen Wohnung und verdrängte den Gedanken an die horrenden Roaminggebühren.“"
                            }
                        ],
