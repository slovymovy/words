                                "target_senses": [
                                    {
                                        "sense_id": "bfe49657-ca19-31ed-a681-83eefd255243",
                                        "entry_id": "4fbb753e-a715-3023-a9d0-00ea57f95a39",
                                        "glosses": [
                                            "The science of metals; their extraction from ores, purification and alloying, heat treatment, and working."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4392134d-f69e-4086-8831-c3f9418339e5",
                                                "sense_id": "bfe49657-ca19-31ed-a681-83eefd255243",
                                                "text": "Fowler was also interested in metallurgy and the use of new materials that could withstand greater stresses, something he expounded on when giving his presidential address to the new Institution of Mechanical Engineers in 1927."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7ddc50f-0137-46dd-8cf3-ea6007bb24f4",
                        "source_entry_id": "272a6971-1e18-3a9a-9c88-077b800ae576",
                        "source_sense_id": "d9009e9a-b58a-3649-b973-aeb71c28cba5",
                        "target_lang_word": "métallurgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métallurgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                        "entry_id": "779e13bf-8d07-3058-8b82-93731f5b073c",
                                        "glosses": [
                                            "Industrie qui a pour objet l’extraction et la purification des métaux, de leurs alliages, et leur emploi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b8a40a-66cb-44c9-896c-1f71045f0e9a",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "À une période où la métallurgie constitue une innovation majeure, les élites qui contrôlent les circuits d’approvisionnement et d’échanges maîtriseraient également tout le processus de thésaurisation volontaire des richesses, depuis la sélection intentionnelle et codifiée des objets jusqu’aux cérémonies et rituels d’enfouissement."
                                            },
                                            {
                                                "example_id": "da09eb08-5859-4461-8c0b-2cf02ddbe2f6",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "Comme son nom l’indique, cet ouvrage traite de la métallurgie du fer au point de vue théorique et au point de vue pratique."
                                            },
                                            {
                                                "example_id": "45132dab-9e0a-419b-a46d-26f57d3fa7a6",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "Le minerai de fer a donné naissance à l’une des principales et des plus anciennes industries des Ardennes, la métallurgie du fer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdecefa0-6c93-4126-9180-a408b8632c4a",
                        "source_entry_id": "272a6971-1e18-3a9a-9c88-077b800ae576",
                        "source_sense_id": "d9009e9a-b58a-3649-b973-aeb71c28cba5",
