                                        "examples": [
                                            {
                                                "example_id": "f4286f73-e8e2-4ca4-9097-ac9521222297",
                                                "sense_id": "85fb1af5-6018-3efd-943e-a7af08525a94",
                                                "text": "We are Harry Potter and William Wallace, the Na’vi and Han Solo. We’re escaping from Shawshank and blowing up the Death Star. We are fighting with the Harkonnens and challenging Thanos. Ukraine is hosting one of the great epics of this century."
                                            },
                                            {
