                    {
                        "sense_id": "044d1e11-b464-3320-ad57-d26a5d6db9ca",
                        "entry_id": "805e185c-5a88-3380-9e90-36f0a7fd4f6f",
                        "glosses": [
                            "is een besmettelijke ziekte van de bovenste luchtwegen bij paarden en andere paardachtigen, veroorzaakt door de bacterie Streptococcus equi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a639b57d-0f42-4ad8-9bec-4e9df25f104b",
                                "sense_id": "044d1e11-b464-3320-ad57-d26a5d6db9ca",
                                "text": "De droes komt wereldwijd bij paarden voor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37dcd710-eae3-43f1-97e9-78732d97739b",
