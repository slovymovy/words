                ],
                "senses": [
                    {
                        "sense_id": "1e0c024e-8ad1-3de2-b29c-a1afc4d7c9fd",
                        "entry_id": "7bddd5ca-ab9c-37a6-a2d9-a8e123b3e4bd",
                        "glosses": [
                            "ein besonderes Netz zum Fischfang"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0ea22ec6-bde0-4694-aad6-1b5dc9a7d8c4",
                                "sense_id": "1e0c024e-8ad1-3de2-b29c-a1afc4d7c9fd",
                                "text": "„Dieselben vier fischer hand das recht, das si all ein hochtracht haben söllend, die ze ingendem meigen grecht sin soll … Und was die fischer mit derselben tracht des ersten zugs fischen fachend, die söllend si schenken und geben einer äptissin.“"
                            },
                            {
                                "example_id": "8659bca6-5767-49a9-8b7a-dcb65ceba0ea",
                                "sense_id": "1e0c024e-8ad1-3de2-b29c-a1afc4d7c9fd",
                                "text": "„Demnach habend die Heginer [wer mit Hegenen Fischfang betreibt], so den Angel füeren, anzeigt und sich klagt … das die Schweb-, Meygen- oder Hochtracht von den Garneren im Früeling so nider zogen werdind, das sy ein große Anzal Rogen und Leich fachind und inn die Schiff züchind, das ein großer Schad syge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bfd548c9-266e-31a6-8869-9c83bc4c8d9d",
                        "entry_id": "7bddd5ca-ab9c-37a6-a2d9-a8e123b3e4bd",
                        "glosses": [
                            "ergiebigste Zeit der Bienenhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f373dd5e-6ddf-46f3-af10-0e507df27548",
                                "sense_id": "bfd548c9-266e-31a6-8869-9c83bc4c8d9d",
                                "text": "„Darum stellen wir als erste Forderung auf: Das Brutlager darf nach Beendigung der Hochtracht keine wesentliche Veränderungen erhalten.“"
                            },
                            {
                                "example_id": "fa3b3772-5e37-472f-a25f-36e2aa2a62ea",
                                "sense_id": "bfd548c9-266e-31a6-8869-9c83bc4c8d9d",
                                "text": "„Um die Völker vor dem Verhungern zu bewahren, mußten sie in einer Zeit, in der sonst Hochtracht ist, gefüttert werden.“"
                            },
                            {
                                "example_id": "c8e89cd9-2991-4474-b86b-586b9551136f",
                                "sense_id": "bfd548c9-266e-31a6-8869-9c83bc4c8d9d",
                                "text": "„Diese Magazine wurden der jeweilen Volksstärke durch Untersetzen angepaßt und standen zur Zeit der Hochtrachten bis zu sieben übereinander.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1fb1c12a-a780-3b51-b9be-4e3648a6e2d6",
                        "entry_id": "7bddd5ca-ab9c-37a6-a2d9-a8e123b3e4bd",
                        "glosses": [
                            "Haltung, die zeigt, dass man sich für etwas Besseres hält"
                        ],
                        "tags": [
                            "archaic",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d8545ae2-c650-4b09-98dd-a4b95de26914",
                                "sense_id": "1fb1c12a-a780-3b51-b9be-4e3648a6e2d6",
                                "text": "„Freylich gibt es dafür einen moralischen oder vielmehr einen unmoralischen Grund; weil die Eintracht aus der Welt gewichen, und die Zwietracht und Vieltracht sammt der Niedertracht und Hochtracht dafür eingezogen sind; jedoch Gründe werden in keiner Betrachtung verlangt, und so auch nicht in dieser vierzehnten.“"
                            },
                            {
                                "example_id": "48ac2a63-3439-43a0-9024-5b3f6e09f310",
                                "sense_id": "1fb1c12a-a780-3b51-b9be-4e3648a6e2d6",
                                "text": "„Die Hochtracht des Menschen besteht – in dem Schmucke seiner ganzen Menschenwürde dazustehn, und Nichts zu thun, noch über sich ergehen zu lassen, was dieselbe nur irgend verletzen oder beschmutzen könnte; die Niedertracht in der Ablegung oder Verwahrlosung dieses schönsten Schmuckes. Wer kann also bestreiten, daß es zur Zeit noch ganze Nationen giebt, die niederträchtig dasteh’n!“"
                            },
                            {
                                "example_id": "8490bad1-bfc4-4383-93a7-acfd1083eee4",
                                "sense_id": "1fb1c12a-a780-3b51-b9be-4e3648a6e2d6",
                                "text": "„Süßes, Bittres, Hochtracht oder Niedertracht füllen das Herz schillerischer Menschen bis an den Rand: bei der leisesten Erschütterung geht es über.“"
                            },
                            {
                                "example_id": "aa32b86b-059f-4e4d-953b-606a5071c318",
                                "sense_id": "1fb1c12a-a780-3b51-b9be-4e3648a6e2d6",
                                "text": "„Die Hochtracht eines Charakters erkennt man an der ihm entgegengebrachten Niedertracht seiner Feinde.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
