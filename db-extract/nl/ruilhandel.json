                        "sense_id": "f2d2719d-1df5-3e74-8ac3-84b139e8e067",
                        "entry_id": "4250765b-63ae-33cb-9178-3f7cf1a03542",
                        "glosses": [
                            "handel zonder geld of ander medium maar door het direct ruilen van goederen of diensten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3f3566-7ab8-400f-b479-d09be00cb68e",
                                "sense_id": "f2d2719d-1df5-3e74-8ac3-84b139e8e067",
                                "text": "Ruilhandel was voor de uitvinding van het geld de enige manier van handelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ad77733-046a-44a0-b867-cf9c31a6989e",
                        "source_entry_id": "4250765b-63ae-33cb-9178-3f7cf1a03542",
                        "source_sense_id": "f2d2719d-1df5-3e74-8ac3-84b139e8e067",
                        "target_lang_word": "Tauschhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tauschhandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3853529a-83de-35cd-9a96-1534687a9203",
                                        "entry_id": "290064fb-0a14-34d8-bddf-500627a98a1d",
                                        "glosses": [
                                            "Handel, bei dem Waren oder Dienstleistungen getauscht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3baa34-083c-49ce-a80b-363908d78c37",
                                                "sense_id": "3853529a-83de-35cd-9a96-1534687a9203",
                                                "text": "„Für die Errechnung von Gewinn und Verlust waren Pierre Marys Geschäftsbücher nicht weiter wichtig, weil die Diligent wie die meisten Kauffahrer im frühen 18. Jahrhundert vor allem Tauschhandel betrieben hatte.“"
                                            },
                                            {
                                                "example_id": "dd073d26-5486-4d4f-84f6-b1b50a651391",
                                                "sense_id": "3853529a-83de-35cd-9a96-1534687a9203",
                                                "text": "„Aus dem Tauschhandel entstand der schwarze Markt.“"
                                            },
                                            {
                                                "example_id": "811efaad-9ea1-4648-aa04-b7fb5d2a3678",
                                                "sense_id": "3853529a-83de-35cd-9a96-1534687a9203",
                                                "text": "„Der uralte Tauschhandel war auf menschliche Tugenden wie Vertrauen und Verlässlichkeit gegründet.“"
                                            },
                                            {
                                                "example_id": "76ae5031-d710-49f7-863b-829e3ed77652",
                                                "sense_id": "3853529a-83de-35cd-9a96-1534687a9203",
                                                "text": "„Der Kapitän, ebenfalls ein Bücherfreund, erfuhr von diesem Tauschhandel und setzte sich mit Eiríkur in Verbindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f32a646-53cf-316b-bc06-7bca8a2780c9",
                                        "entry_id": "290064fb-0a14-34d8-bddf-500627a98a1d",
                                        "glosses": [
                                            "aus einem Tausch bestehendes, einmaliges Geschäft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8add6c4a-19c7-4382-b8fe-ae6c242f1590",
                                                "sense_id": "6f32a646-53cf-316b-bc06-7bca8a2780c9",
                                                "text": "Bei diesem Tauschhandel haben wir leider den Kürzeren gezogen."
                                            },
                                            {
                                                "example_id": "99e81691-550c-4f8c-b1c4-a6d5fbe58554",
                                                "sense_id": "6f32a646-53cf-316b-bc06-7bca8a2780c9",
                                                "text": "„Wenn ein Mann heiraten wollte, musste er der Familie seiner künftigen Frau Rinder übergeben. Dies war kein Tauschhandel, wie es viele Europäer missverstanden, der Mann «bezahlte» nicht für seine Frau mit Rindern, sondern der Eheschluss und die Gegengabe der Rinder besiegelten ein Bündnis der Familien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45424ec3-f27e-42d2-87ad-9ea1517f0948",
                        "source_entry_id": "4250765b-63ae-33cb-9178-3f7cf1a03542",
                        "source_sense_id": "f2d2719d-1df5-3e74-8ac3-84b139e8e067",
                        "target_lang_word": "barter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                        "entry_id": "d841f8cf-d017-3f7b-9e25-1f96a53368a7",
                                        "glosses": [
                                            "An exchange of goods or services without the use of money."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800fc13d-1d25-4ec4-b72f-a84c0862980e",
                                                "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                                "text": "We had no money so we had to live by barter."
                                            },
                                            {
                                                "example_id": "84a05336-88e8-4cf4-b36b-1fb235ed3a65",
                                                "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                                "text": "Speculations in trade are not confined to the counter or to the counting-house. Lady Anne's fair hair and white teeth were as much objects of barter as any of the shawls or ribbons displayed in Bond Street. They were to be had in exchange for a suit of diamonds and an opera-box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44adc3d1-074d-30c6-8bad-dc99a2710b81",
                                        "entry_id": "d841f8cf-d017-3f7b-9e25-1f96a53368a7",
                                        "glosses": [
                                            "The goods or services used in such an exchange."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba930dd8-97b1-43d5-a51b-0528aac79a38",
                                                "sense_id": "44adc3d1-074d-30c6-8bad-dc99a2710b81",
                                                "text": "The man used his watch as barter to pay for his tab."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                        "entry_id": "d0d4484f-caa3-31b9-8962-f3b964f60324",
                                        "glosses": [
                                            "To exchange goods or services without involving money."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b5b0d7-978f-43f2-af3b-8b0f620bcf9c",
                                                "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                                "text": "She bartered a bonsai for one of the rare books in my library."
                                            },
                                            {
                                                "example_id": "21a4e1d6-d49c-473f-8d88-607dbf1b30ff",
                                                "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                                "text": "You may be able to barter for some of the items you need at the local market."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
