                                                "sense_id": "efa1ff55-e0fb-3d97-8de0-140a187d4441",
                                                "text": "Это была большая удача наших спортсменов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599cba2c-bc1d-3ab0-8f37-f76a9219860e",
                                        "entry_id": "57814a93-72d6-320a-a921-e7a0100f9501",
