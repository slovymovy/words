                "senses": [
                    {
                        "sense_id": "61eacbcf-2e1e-33fa-9e2d-1d4d968f399e",
                        "entry_id": "dd0d2e94-809a-3a00-bb70-785bb492687c",
                        "glosses": [
                            "Teilgebiet der Medizin beziehungsweise Biologie, welches menschliche, tierische und pflanzliche Gewebe auf mikroskopischer Ebene erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fffc73e-ffad-44a7-b960-5c8fa17980f2",
                                "sense_id": "61eacbcf-2e1e-33fa-9e2d-1d4d968f399e",
                                "text": "Histologie und Pathologie sind verwandte Disziplinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69ac2cdd-a560-30f0-b8f1-63a664b0e738",
                        "entry_id": "dd0d2e94-809a-3a00-bb70-785bb492687c",
                        "glosses": [
                            "bezogen auf eine Krankheit, einen medizinischen Fall, ein Organ; die histologische Untersuchung, der histologische Befund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d732628-3d96-46fd-9b9a-b2f60846ae7f",
                                "sense_id": "69ac2cdd-a560-30f0-b8f1-63a664b0e738",
                                "text": "Die Histologie der Leber hat nichts erbracht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "42b769b2-1602-33c1-a8c8-2fbd37b0aabc",
                        "entry_id": "dd0d2e94-809a-3a00-bb70-785bb492687c",
                        "glosses": [
                            "histologische Abteilung einer medizinischen Einrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9862f668-76e0-4b1c-ae29-eef8fa5b9d44",
                                "sense_id": "42b769b2-1602-33c1-a8c8-2fbd37b0aabc",
                                "text": "Die Proben bitte gleich an die Histologie schicken, vielleicht haben wir dann nächste Woche schon den Befund und können operieren."
                            }
                        ],
                        "sense_index_json": "\"3\""
