                "senses": [
                    {
                        "sense_id": "1fb0096a-0e4e-3618-a78d-0275cf91556d",
                        "entry_id": "5fb0b865-0261-39e8-9013-32b55a3cc970",
                        "glosses": [
                            "Donner un caractère namibien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54747bd-a4a0-4e4a-9e49-1b809fdc6e90",
                                "sense_id": "1fb0096a-0e4e-3618-a78d-0275cf91556d",
                                "text": "Depuis 1980, Pretoria tente de « namibianiser » la guerre, en imposant la conscription à tous les Namibiens, et en fondant les Forces territoriales du Sud-Ouest africain (SWATF)."
                            },
                            {
                                "example_id": "b0ba88f4-b954-4fae-a781-1e1f6cb1802a",
                                "sense_id": "1fb0096a-0e4e-3618-a78d-0275cf91556d",
                                "text": "Le souci de « namibianiser » l’industrie des reines de beauté, source de substantiels profits mais peu accessible aux budgets modestes des non-Blancs, a conduit le gouvernement namibien à organiser en 1995, à grand renfort de publicité, l’élection de « Miss Katutura », dont la couronne est allée à Esi Chase, la fille de l’ambassadeur de Namibie en Allemagne, actuellement présentatrice à la télévision namibienne."
                            }
                        ]
                    }
