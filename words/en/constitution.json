                            {
                                "target_lang_word": "комплекция",
                                "target_lang_sense_clarification": "особенности строения тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10f2f16-4420-3def-a8f6-83565af08820",
                    "sense_definition": "The way in which something is composed or structured; its physical makeup.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the chemical <w>constitution</w> of the soil on Mars.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают химический <w>состав</w> почвы на Марсе."
                            }
                        },
                        {
                            "text": "The physical <w>constitution</w> of the atmosphere changes as you move higher up.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>строение</w> атмосферы меняется по мере подъема вверх."
                            }
                        }
