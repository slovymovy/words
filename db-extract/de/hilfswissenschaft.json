                    {
                        "form_id": "7404c797-ee35-40ee-b6b6-e20c1ed034ad",
                        "entry_id": "e2249ca2-5182-394d-9b1a-efb916d37270",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hilfswissenschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcce59d8-7867-3cec-9f30-7ec1f324e789",
                        "entry_id": "e2249ca2-5182-394d-9b1a-efb916d37270",
                        "glosses": [
                            "wissenschaftliche Disziplin, deren Methoden und Ergebnisse von der Geschichtswissenschaft benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7894994-14e2-4a98-b265-abe2bfe232bf",
                                "sense_id": "fcce59d8-7867-3cec-9f30-7ec1f324e789",
                                "text": "„Die Urgeschichte […] bezeichnet die älteste Periode der Menschheitsgeschichte. […] Die Erforschung dieser Epoche ist Sache der Archäologie und ihrer Hilfswissenschaften.“"
                            },
                            {
                                "example_id": "9d60fdd9-7e4f-4aef-af52-e3dd500200e2",
                                "sense_id": "fcce59d8-7867-3cec-9f30-7ec1f324e789",
                                "text": "„Die Phonetik selbst, das hat man schon seit länngerer Zeit eingesehen, kann nicht mehr von einem »einfachen« Linguisten als Teil- oder Hilfswissenschaft so nebenbei wirklich beherrscht werden.“"
                            },
                            {
                                "example_id": "7e02e792-4f8a-496d-8140-7e1e2ebc9599",
                                "sense_id": "fcce59d8-7867-3cec-9f30-7ec1f324e789",
                                "text": "„Als Hilfswissenschaft der Ärzte begann die Naturwissenschaft mehr und mehr, sich selbständig zu entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
