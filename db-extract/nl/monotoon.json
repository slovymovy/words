                                        "sense_id": "f08d4bba-2173-38c8-b47e-bede99ac35db",
                                        "entry_id": "61ea60cf-f74c-3e91-a47f-7de3e624fb49",
                                        "glosses": [
                                            "Having an unvarying pitch or tone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8d9527-e122-4fb7-b470-bd9f25a4dc13",
                                                "sense_id": "f08d4bba-2173-38c8-b47e-bede99ac35db",
                                                "text": "\"But my daughter—but the Lady Eveline\"—said the Fleming, with some slight change in his monotonous voice, which seemed to express doubt and perplexity—\"You are cruel conquerors, and—\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a443ef33-cfeb-377c-8f05-a68fa0e1fae2",
                                        "entry_id": "61ea60cf-f74c-3e91-a47f-7de3e624fb49",
                                        "glosses": [
                                            "Tedious, repetitious, or lacking in variety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600462e0-f3b0-47db-8915-593694b03345",
                                                "sense_id": "a443ef33-cfeb-377c-8f05-a68fa0e1fae2",
                                                "text": "[L]istening for a moment, she heard the monotonous and heavy tread of the soldier echoing through the passage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
