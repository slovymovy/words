                "senses": [
                    {
                        "sense_id": "2bbe43ba-e030-3c20-bcc2-32f8d9543fca",
                        "entry_id": "f86e323d-1a3a-3a78-aa97-bb1f1f7679cc",
                        "glosses": [
                            "имеющий пустой колос, зерна в колосе; родившийся без зерна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c841a1bb-cdbf-4375-8574-c6985df444ac",
                                "sense_id": "2bbe43ba-e030-3c20-bcc2-32f8d9543fca",
                                "text": "Срезанная пшеница с шумом падала на полотно, стремительно исчезала в гудящей утробе молотилки и, измятая, пустоколосая, вылетала из нее в соломокопнитель."
                            },
                            {
                                "example_id": "5da38f17-68d9-47f8-9be7-80a97a48a0a1",
                                "sense_id": "2bbe43ba-e030-3c20-bcc2-32f8d9543fca",
                                "text": "Пустоколосые растения инфекционного происхождения имеют значительно меньшую высоту, чем здоровые, между тем вегетация у них прекращается почти одновременно."
                            }
                        ]
                    }
                ],
