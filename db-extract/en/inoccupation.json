                        "glosses": [
                            "Lack of occupation (being busy); lack of something to do."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6aedf383-8ea7-408d-b5e7-eff8ed5f314b",
                                "sense_id": "97d9008d-5f8d-3d84-a756-b7ad7faee101",
                                "text": "The whole strength of Evadne's mind was exerted to support the failing spirits of her husband. Loss of property, hopelessness as to his future prospects, the inoccupation to which poverty condemned him, combined to reduce him to a state bordering on insanity."
                            },
                            {
                                "example_id": "24af12d1-57ab-4877-889b-4032f4562b06",
                                "sense_id": "97d9008d-5f8d-3d84-a756-b7ad7faee101",
                                "text": "The hours dragged on in a dreary inoccupation. Towards dusk she sat down beside him and he laid his hand on hers. The touch startled her. He seemed to be calling her from far off. She looked at him helplessly and his smile went through her like a physical pang."
                            }
                        ]
                    }
