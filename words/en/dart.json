{
    "word_family": [
        "darting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66264e99-c1cb-370a-bdd1-9d9f0ef30d60",
                    "sense_definition": "A small object with a pointed tip used in the game of darts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weapon_or_projectile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threw the <w>dart</w> at the center of the board.",
                            "target_lang_translations": {
                                "fr": "Il a lancé la <w>fléchette</w> au centre de la cible."
                            }
                        },
                        {
                            "text": "She bought a new set of professional <w>darts</w> for the tournament.",
                            "target_lang_translations": {
                                "fr": "Elle a acheté un nouveau jeu de <w>fléchettes</w> professionnelles pour le tournoi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw a dart"
                    ],
                    "target_lang_definitions": {
                        "fr": "Petit projectile pointu utilisé dans le jeu de fléchettes."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fléchette",
                                "target_lang_sense_clarification": "Petit projectile utilisé pour le jeu de fléchettes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa21ca11-0d52-3ca4-ba3f-89787852dc27",
                    "sense_definition": "A sudden or fast movement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat made a quick <w>dart</w> for the open door.",
                            "target_lang_translations": {
                                "fr": "Le chat a fait un <w>élan</w> rapide vers la porte ouverte."
                            }
                        },
                        {
                            "text": "He made a sudden <w>dart</w> toward the finish line.",
                            "target_lang_translations": {
                                "fr": "Il a fait une <w>ruée</w> soudaine vers la ligne d'arrivée."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "rush"
                    ],
                    "common_phrases": [
                        "made a dart"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un mouvement soudain et rapide."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "élan",
                                "target_lang_sense_clarification": "Mouvement brusque vers l'avant."
                            },
                            {
                                "target_lang_word": "ruée",
                                "target_lang_sense_clarification": "Mouvement rapide et précipité."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d98f76fa-813c-3b9c-9bc1-04d4edebaaac",
                    "sense_definition": "A fold that is stitched on a garment to shape it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor added a <w>dart</w> to the dress to make it fit better.",
                            "target_lang_translations": {
                                "fr": "Le tailleur a ajouté une <w>pince</w> à la robe pour qu'elle soit mieux ajustée."
                            }
                        },
                        {
                            "text": "She stitched a small <w>dart</w> into the back of the jacket.",
                            "target_lang_translations": {
                                "fr": "Elle a cousu une petite <w>pince</w> dans le dos de la veste."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pli cousu sur un vêtement pour lui donner sa forme."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pince",
                                "target_lang_sense_clarification": "Pli cousu en couture pour ajuster un vêtement."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "019e0893-70a0-3ccb-a472-857b91e7f7a7",
                    "sense_definition": "A pointed missile weapon intended to be thrown by hand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon_or_projectile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient warrior held a <w>dart</w> ready to throw.",
                            "target_lang_translations": {
                                "fr": "L'ancien guerrier tenait un <w>dard</w> prêt à être lancé."
                            }
                        },
                        {
                            "text": "He threw the <w>dart</w> with great precision at the target.",
                            "target_lang_translations": {
                                "fr": "Il a lancé le <w>dard</w> avec une grande précision sur la cible."
                            }
                        }
                    ],
                    "synonyms": [
                        "javelin",
                        "spear"
                    ],
                    "target_lang_definitions": {
                        "fr": "Arme de jet pointue destinée à être lancée à la main."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dard",
                                "target_lang_sense_clarification": "Ancienne arme de jet pointue."
                            },
                            {
                                "target_lang_word": "javelot",
                                "target_lang_sense_clarification": "Arme de jet légère."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c741aa1-a1f8-3517-95b7-edc0e9b92548",
                    "sense_definition": "A cigarette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped outside to light up a <w>dart</w>.",
                            "target_lang_translations": {
                                "fr": "Il est sorti pour s'allumer une <w>clope</w>."
                            }
                        },
                        {
                            "text": "She finished her <w>dart</w> before heading back into the building.",
                            "target_lang_translations": {
                                "fr": "Elle a fini sa <w>clope</w> avant de retourner dans le bâtiment."
                            }
                        }
                    ],
                    "synonyms": [
                        "cigarette"
                    ],
                    "common_phrases": [
                        "light a dart"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in Australian and British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une cigarette."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "clope",
                                "target_lang_sense_clarification": "Terme familier pour une cigarette."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2728880-044b-360d-bc5d-945d43af3e12",
                    "sense_definition": "To move rapidly in a specific direction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fish <w>darted</w> under a large rock to hide.",
                            "target_lang_translations": {
                                "fr": "Le poisson s'est <w>élancé</w> sous un gros rocher pour se cacher."
                            }
                        },
                        {
                            "text": "The deer <w>darted</w> across the road when the car approached.",
                            "target_lang_translations": {
                                "fr": "Le cerf a <w>filé</w> à travers la route quand la voiture s'est approchée."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "scurry",
                        "shoot"
                    ],
                    "common_phrases": [
                        "darted across",
                        "darted under"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se déplacer rapidement dans une direction précise."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'élancer",
                                "target_lang_sense_clarification": "Partir brusquement et rapidement."
                            },
                            {
                                "target_lang_word": "filer",
                                "target_lang_sense_clarification": "Partir très vite."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b4a1e48-a35e-304e-845f-b2e50864185d",
                    "sense_definition": "To fly or pass swiftly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird <w>darted</w> through the trees.",
                            "target_lang_translations": {
                                "fr": "L'oiseau a <w>filé</w> à travers les arbres."
                            }
                        },
                        {
                            "text": "A shadow <w>darted</w> past the window.",
                            "target_lang_translations": {
                                "fr": "Une ombre a <w>filé</w> devant la fenêtre."
                            }
                        }
                    ],
                    "synonyms": [
                        "fly",
                        "zip"
                    ],
                    "target_lang_definitions": {
                        "fr": "Voler ou passer avec rapidité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "passer en flèche",
                                "target_lang_sense_clarification": "Passer très rapidement."
                            },
                            {
                                "target_lang_word": "filer",
                                "target_lang_sense_clarification": "Passer avec une grande vitesse."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "647cb3e6-5d01-327a-91b3-2ce78a78a1c0",
                    "sense_definition": "To send forth suddenly or rapidly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>darted</w> a quick look at her watch.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>lancé</w> un regard rapide à sa montre."
                            }
                        },
                        {
                            "text": "He <w>darted</w> a glance at his friend during the meeting.",
                            "target_lang_translations": {
                                "fr": "Il a <w>lancé</w> un coup d'œil à son ami pendant la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "shoot"
                    ],
                    "common_phrases": [
                        "darted a glance"
                    ],
                    "target_lang_definitions": {
                        "fr": "Envoyer ou diriger soudainement ou rapidement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "lancer",
                                "target_lang_sense_clarification": "Diriger un regard ou un objet rapidement."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bd26794-4bd1-3328-8a44-bbee7f6fae96",
                    "sense_definition": "To shoot with a dart, especially a tranquilizer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vet had to <w>dart</w> the lion to examine it safely.",
                            "target_lang_translations": {
                                "fr": "Le vétérinaire a dû <w>anesthésier</w> le lion pour l'examiner en toute sécurité."
                            }
                        },
                        {
                            "text": "They <w>darted</w> the animal so they could move it to the sanctuary.",
                            "target_lang_translations": {
                                "fr": "Ils ont <w>anesthésié</w> l'animal pour pouvoir le déplacer vers le refuge."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Tirer avec une fléchette, notamment pour tranquilliser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "anesthésier",
                                "target_lang_sense_clarification": "Endormir un animal à l'aide d'une fléchette."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a1e4005f-ccc4-33f7-b06f-b750696473e5",
                    "sense_definition": "A surname from Middle English.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named John <w>Darts</w>.",
                            "target_lang_translations": {
                                "fr": "L'auteur du livre s'appelle John <w>Darts</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Darts</w> will be joining us for the meeting tomorrow.",
                            "target_lang_translations": {
                                "fr": "M. <w>Darts</w> se joindra à nous pour la réunion de demain."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un nom de famille d'origine moyen-anglaise."
                    },
