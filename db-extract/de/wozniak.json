                ],
                "senses": [
                    {
                        "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                        "entry_id": "10d0fa2f-c3ca-3856-aaa9-4f3d30194dae",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7569a0-1ded-4da3-b663-80c5cacc0c2c",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Frau Wozniak ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f27ccc04-0fc8-4793-a46f-34cdf18340d2",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Herr Wozniak wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3f6d18aa-a366-4a4f-b04a-f42667ed3133",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Die Wozniaks fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "b5bb6071-12c4-4605-938e-d7077c036147",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Der Wozniak trägt nie die Pullover, die die Wozniak ihm strickt."
                            },
                            {
                                "example_id": "0b453da2-8e8d-4c95-9971-1b7ed48472b0",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wozniak kommt, geht der Herr Wozniak.“"
                            },
                            {
                                "example_id": "6928bf52-4abd-478d-abb7-197a3b5de98f",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Wozniak kommt und geht."
                            },
                            {
                                "example_id": "7badaad2-1765-481f-8f7a-72b7c9e4e726",
                                "sense_id": "a3019fb7-8f5d-3ec1-a92e-481c96c53fa4",
                                "text": "Wozniaks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
