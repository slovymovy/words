                        "sense_id": "be367294-7dc5-3906-a091-943b68a04458",
                        "entry_id": "155f1259-4bb8-3e46-84fd-c0a66bf3837b",
                        "glosses": [
                            "Brume épaisse, d’aspect jaune‑brunâtre à gris‑blanchâtre, résultant d’un mélange de brouillard, de fumée et de polluants atmosphériques. Il se forme le plus souvent au‑dessus des zones urbaines, mais peut également se propager dans les secteurs ruraux."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c6274248-25d9-448e-be44-767c10987c69",
                                "sense_id": "be367294-7dc5-3906-a091-943b68a04458",
                                "text": "Il est recommandé d'éviter l'exposition à la pollution et à certains irritants comme le fumard (smog), les gaz d'échappement des voitures, certains parfums, l'air froid, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d79fc780-5588-40f7-9067-c90e3b76e2cf",
                        "source_entry_id": "155f1259-4bb8-3e46-84fd-c0a66bf3837b",
                        "source_sense_id": "be367294-7dc5-3906-a091-943b68a04458",
                        "target_lang_word": "smog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                        "entry_id": "0177898d-70d5-3832-8961-e978ba883546",
                                        "glosses": [
                                            "A noxious mixture of particulates and gases that is the result of urban air pollution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474c21d9-2278-4acd-b839-e9ea5f2db1d7",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "A widow since 1967, she lives now in Honolulu because, she says, she can enjoy the Californialike climate without the smog."
                                            },
                                            {
                                                "example_id": "64bd860e-09c8-4e95-9377-2831f0343992",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "Everyone smoked so if the auditorium was full, the whole room would be filled with smoke in next to no time. It was like the legendary London smog of the 1950s in there sometimes. You took it in turn to “flash the ash” as it was called."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                        "entry_id": "e1e20b67-f4dd-3bc4-9a72-ecc39d68ad2b",
                                        "glosses": [
                                            "To get a smog check; to check a vehicle or have it checked for emissions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3d3f49-b7af-46b7-a68e-a1384035fe82",
                                                "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                                "text": "If the car is more than five years old, you'll have to have it smogged before you can register it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
