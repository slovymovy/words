                        ],
                        "examples": [
                            {
                                "example_id": "89ae7638-3cbf-4b18-a347-0d91e9478c37",
                                "sense_id": "cfb048b0-a0f1-3544-9b6d-22a1bb7109b4",
                                "text": "Je vous apporte de nouveaux honneurs, de nouvelles richesses, tête-dieu ! vous me recevez comme un maheutre qui tombe en un parti de manants !"
                            },
                            {
                                "example_id": "7837e662-c3f2-416a-bc94-d761017de821",
                                "sense_id": "cfb048b0-a0f1-3544-9b6d-22a1bb7109b4",
                                "text": "[…] on a appelé armures les guerriers armés de fer ; bassinet, l’homme coiffé de ce genre de casque ; espadon, le soldat pourvu de cette arme blanche ; hoqueton et maheutre, le soldat vêtu du hoqueton ou du maheutre […]."
                            }
                        ]
