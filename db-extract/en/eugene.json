                                                "sense_id": "68b4dcbe-f6a0-38e9-9ea5-f3d2c666f5d0",
                                                "text": "„Eugen wiegte zweifelnd den Kopf.“"
                                            },
                                            {
                                                "example_id": "96a0292e-dcfb-40bb-bac5-5898a71ad951",
                                                "sense_id": "68b4dcbe-f6a0-38e9-9ea5-f3d2c666f5d0",
                                                "text": "Prinz Eugen schlug 1717 die Türken vor Belgrad."
