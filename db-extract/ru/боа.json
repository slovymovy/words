                                                "sense_id": "41304182-4681-3bfc-85a2-4391f74dda71",
                                                "text": "Eine Boa kann bis zu 3,60 m lang werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f717c5b2-09ee-35db-9405-d384b7ce5097",
                                        "entry_id": "bdc99f30-d25c-3f42-bc80-031af67bb363",
                                        "glosses": [
                                            "schalartiges Kleidungsstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df0a960-4601-481d-87a1-f03792456b17",
                                                "sense_id": "f717c5b2-09ee-35db-9405-d384b7ce5097",
                                                "text": "Heute sieht man Boas oft als Accessoire in der Showbranche."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Boa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed38aef7-e3dd-33bc-b65d-651f847cb9ed",
                                        "entry_id": "c8140206-a22e-3d3b-a603-65fa30dd2aeb",
                                        "glosses": [
                                            "Gattungsname einer monotypischen Gattung der Boinae (Boaschlangen)"
                                        ],
                                        "tags": [
                                            "zoologisch-taxonomisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ee17af-56cb-48a0-8b34-d15a2d0863d5",
                                                "sense_id": "ed38aef7-e3dd-33bc-b65d-651f847cb9ed",
                                                "text": "Die Gattung Boa umfasst nur eine einzige Art, die berühmte Boa constrictor."
                                            }
