                "senses": [
                    {
                        "sense_id": "f0401926-641d-39ce-a8da-1f56ac351054",
                        "entry_id": "550e0915-65fb-3985-932e-65cdf2375ce6",
                        "glosses": [
                            "To render unholy; to profane; to desecrate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a59b75-608c-4ab8-bcf8-6592475fb935",
                                "sense_id": "f0401926-641d-39ce-a8da-1f56ac351054",
                                "text": "Nor can the unholiness of the priest dishallow the altar."
                            },
                            {
                                "example_id": "29b99cbf-aaec-4144-aa29-3ca21f91d0b2",
                                "sense_id": "f0401926-641d-39ce-a8da-1f56ac351054",
                                "text": "And so went back and seeing them yet in sleep\nSaid, \"Ye, that so dishallow the holy sleep,\nYour sleep is death\"[…]"
                            },
                            {
                                "example_id": "1585127e-f014-408d-8fa4-81ec6ceb08bb",
                                "sense_id": "f0401926-641d-39ce-a8da-1f56ac351054",
                                "text": "Every devout soul revolts from it as a dishallowing of most sacred things"
                            }
                        ]
                    }
                ],
