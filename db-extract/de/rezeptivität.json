                    {
                        "sense_id": "274143e4-66e3-3e71-a673-6a10f054a214",
                        "entry_id": "b5c7d6bd-599f-3ad8-9aa5-b5087b5f2cb6",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße empfängliches (rezeptives) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25811f54-65f9-4189-a7c6-641da210dcbb",
                                "sense_id": "274143e4-66e3-3e71-a673-6a10f054a214",
                                "text": "„Im Entstehen der menschlichen Erkenntnis beteiligen sich zwei Vermögen: das Vermögen der Rezeptivität (oder: Sinnlichkeit) und das Vermögen der Spontaneität (oder: Verstand).“"
                            },
                            {
                                "example_id": "8ffab51a-8bde-4317-80f6-03b4ad384575",
                                "sense_id": "274143e4-66e3-3e71-a673-6a10f054a214",
                                "text": "„Mit der Grundfigur der reinen Rezeptivität übernimmt Barth eine Transformation der Passivität in die Rezeptivität, bei der zu fragen ist, ob er sie als minimale Spontaneität oder als Anderes der Spontaneität versteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
