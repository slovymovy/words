                "senses": [
                    {
                        "sense_id": "1eecbec3-95bd-355b-a899-94b19218d055",
                        "entry_id": "91233a7e-59b9-32e1-806e-db4c3db2a590",
                        "glosses": [
                            "единица объёма в английской системе мер, равная 36,368 литра; используется для сыпучих товаров, в основном сельскохозяйственных, но не для жидкостей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b6285d-ebdc-4550-8df1-c79f8e96de92",
                                "sense_id": "1eecbec3-95bd-355b-a899-94b19218d055",
                                "text": "В результате из половины пека семян каждого сорта вышло около двух бушелей риса и два с половиной бушеля ячменя, конечно, по приблизительному подсчету, так как у меня не было мер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24083adb-c6b3-4e4a-b523-3b1ac4b04781",
                        "source_entry_id": "91233a7e-59b9-32e1-806e-db4c3db2a590",
                        "source_sense_id": "1eecbec3-95bd-355b-a899-94b19218d055",
                        "target_lang_word": "bushel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bushel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69c4703b-7dd2-3dc7-9748-c6b58b5083dd",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A dry measure, containing four pecks, eight gallons, or thirty-two quarts; equivalent in volume to approximately 0.0364 cubic meters (imperial bushel) or 0.0352 cubic meters (U.S. bushel)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4f9110-a5b0-4fe6-bb07-5ead1d6a8433",
                                                "sense_id": "69c4703b-7dd2-3dc7-9748-c6b58b5083dd",
                                                "text": "The quarter, bushel, and peck are nearly universal measures of corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0766cbac-6b22-33c8-bec4-3388863e32da",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A vessel of the capacity of a bushel, used in measuring; a bushel measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe216258-8ce2-4abc-a7c7-3fece32edc81",
                                                "sense_id": "0766cbac-6b22-33c8-bec4-3388863e32da",
                                                "text": "And he sayde unto them: is the candle lighted, to be put under a busshell, or under the borde: ys it not therfore lighted that it shulde be put on a candelsticke?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ee93e0-17c1-3daf-b312-27aa62a2cf09",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A quantity that fills a bushel measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2e5dda-aa73-4578-9c30-cb3024532001",
                                                "sense_id": "e4ee93e0-17c1-3daf-b312-27aa62a2cf09",
                                                "text": "a heap containing ten bushels of apples"
                                            }
                                        ]
                                    },
