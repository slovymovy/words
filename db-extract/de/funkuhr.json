                                "sense_id": "a3237328-ef21-30f7-aab7-4f08f45ce07c",
                                "text": "Ich habe eine Funkuhr, damit ich mich nicht selbst um ihre genaue Einstellung kümmern muss."
                            },
                            {
                                "example_id": "0720346f-7907-4eb5-b8b7-897ab6c5d847",
                                "sense_id": "a3237328-ef21-30f7-aab7-4f08f45ce07c",
                                "text": "„Besitzer sogenannter Funkuhren sind im Vorteil, weil die sich von ganz alleine umstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
