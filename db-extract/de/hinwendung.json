                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805eeaf3-54fb-4f16-9ca4-4bde85a2af6e",
                                "sense_id": "d5bfeb55-da70-307b-997c-b17ff2c61aaa",
                                "text": "„Diese Hinwendung zur fernen Vergangenheit des mittelalterlichen Reichs geschah in der Absicht, der eigenen Gegenwart ein Vorbild und eine Orientierung zur Erneuerung zu liefern.“"
                            },
                            {
                                "example_id": "d12594cc-0a10-4413-8701-09b6ebe26398",
                                "sense_id": "d5bfeb55-da70-307b-997c-b17ff2c61aaa",
                                "text": "„In seinem Bestseller „Rückkehr nach Reims“ beschreibt Eribon am Beispiel seiner eigenen Familie die Entfremdung des Proletariats von der politischen Linken und ihre Hinwendung zur extremen Rechten. Eine Entwicklung, die in allen Industrieländern zu beobachten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
