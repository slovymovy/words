                },
                {
                    "sense_id": "5f5470a6-0dd8-37d2-b5dd-adfbc93d4502",
                    "sense_definition": "Ce qui sert le bien commun et présente un intérêt manifeste pour l'ensemble de la collectivité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avantage_pratique",
                    "name_type": "no",
                    "examples": [
