                "senses": [
                    {
                        "sense_id": "e7a78cc0-5d0b-38b3-aa30-b3c9764c0915",
                        "entry_id": "168f024d-3b0b-3d46-a5c2-2272e5148068",
                        "glosses": [
                            "Donner un caractère pompier à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beee9286-a173-441d-9e59-f4ef1af573b0",
                                "sense_id": "e7a78cc0-5d0b-38b3-aa30-b3c9764c0915",
                                "text": "En clair, Georgios Kyriacos (son vrai nom) n’entendait pas se satisfaire de lustrer ses plus grands tubes, de les orchestraliser, pour ne pas dire de les ’pompiériser’."
                            },
                            {
                                "example_id": "adc3479f-4be4-4449-94f1-6104a47117b7",
                                "sense_id": "e7a78cc0-5d0b-38b3-aa30-b3c9764c0915",
                                "text": "Pompiériser ou amphigouriser ?\" That's the question\" comme disait l'Auvergnat agonisant."
                            }
                        ]
                    }
