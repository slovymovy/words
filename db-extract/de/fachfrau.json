                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "Someone who is an expert in, or devoted to, some specific branch of study or research."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "537ae54b-eea7-3459-8b07-5d405033cf72",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A player on a team who primarily employs one particular skill or takes one particular role."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A physician whose practice is limited to a particular branch of medicine or surgery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d99402-bcc3-46e4-a9bc-f831078a6abe",
                                                "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                                "text": "Dr. Robert Leroy Hutton, a retired specialist in internal medicine and a well‐known diagnostician, died yesterday here."
                                            },
                                            {
                                                "example_id": "b01f1924-dcec-4983-bdee-633403423333",
                                                "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                                "text": "Most Americans mistakenly believe that they must see specialists for almost every medical problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f3c39-6101-3f81-970b-b0c6c0666c91",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "Any of several non-commissioned ranks corresponding to that of corporal."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51fc3c97-a242-3bcd-bd7f-7732867da9c3",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "An organism that is specialized for a particular environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80f08a1-b554-4c30-8e07-ab187501d61a",
                                                "sense_id": "51fc3c97-a242-3bcd-bd7f-7732867da9c3",
                                                "text": "The tree Lepidothamnus laxifolius is a high alpine specialist found in high-altitude bog communities and in scrub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998e8ad7-ac69-3e46-a323-2fdca990e61f",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
