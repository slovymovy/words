                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb4544d-0ed9-44c5-9beb-eaf17860ba87",
                                                "sense_id": "47be54d0-fbc3-364f-945a-ea60124b91a1",
                                                "text": "C’est une erreur de prétendre que l’utile soit séparable de l’honnête."
                                            }
