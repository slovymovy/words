            "senses": [
                {
                    "sense_id": "60aedbf4-bd97-3ee8-b16a-26dea5abd879",
                    "sense_definition": "Iets, zoals water, kracht, hoop of inspiratie, ergens uit halen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extract_derive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kon veel troost <w>putten</w> uit de steun van haar vrienden.",
                            "target_lang_translations": {
                                "en": "She was able to <w>draw</w> much comfort from the support of her friends.",
                                "ru": "Она могла <w>черпать</w> много утешения в поддержке своих друзей.",
                                "de": "Sie konnte viel Trost aus der Unterstützung ihrer Freunde <w>schöpfen</w>."
                            }
                        },
                        {
                            "text": "Wij moeten water <w>putten</w> uit de bron omdat de kraan kapot is.",
                            "target_lang_translations": {
                                "en": "We have to <w>draw</w> water from the spring because the tap is broken.",
                                "ru": "Нам приходится <w>набирать</w> воду из источника, потому что кран сломан.",
                                "de": "Wir müssen Wasser aus der Quelle <w>schöpfen</w>, weil der Wasserhahn kaputt ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "halen",
                        "ontlenen",
                        "scheppen"
                    ],
                    "common_phrases": [
                        "moed putten uit",
                        "kracht putten uit",
                        "inspiratie putten uit",
                        "water putten"
                    ],
                    "target_lang_definitions": {
