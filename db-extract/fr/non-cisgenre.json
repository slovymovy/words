                                "target_senses": [
                                    {
                                        "sense_id": "c087f442-e749-36ad-9fa7-130ef302d8b0",
                                        "entry_id": "31889f4c-35e6-3662-8644-4c81f346ca93",
                                        "glosses": [
                                            "Not cisgender."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768f4e50-e63a-467e-89a7-14712fad5419",
                                                "sense_id": "c087f442-e749-36ad-9fa7-130ef302d8b0",
                                                "text": "Parsons found the biggest issue to be that “there was no space that said that it was welcoming specifically to non-cisgender people. Just having Penn Non-cis existing is already a space that I can be more comfortable in.”"
                                            },
                                            {
                                                "example_id": "50618f04-f3bf-4c09-838e-b66ee11ce681",
                                                "sense_id": "c087f442-e749-36ad-9fa7-130ef302d8b0",
                                                "text": "The majority of the world would declare themselves cisgender; however those of non-cisgender identity are, of course, an important and ever growing presence in society."
                                            },
                                            {
                                                "example_id": "0eb4de62-b9c1-46e2-8030-9cca4d6ccf32",
                                                "sense_id": "c087f442-e749-36ad-9fa7-130ef302d8b0",
                                                "text": "However, she also said that it is a matter of accessibility and safety for non-cisgender students at the university (cisgender is a term denoting a person whose biological sex and gender identity match)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
