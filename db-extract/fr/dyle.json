                "senses": [
                    {
                        "sense_id": "77d25413-bcb0-3d7f-ae65-441da2133883",
                        "entry_id": "172b807e-a12d-37df-b9ef-9c620d66d742",
                        "glosses": [
                            "Rivière de Belgique, affluent du Rupel, dans le bassin versant de l’Escaut."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "fef06ecb-de9c-4573-aa51-6d7e6c009956",
                                "sense_id": "77d25413-bcb0-3d7f-ae65-441da2133883",
                                "text": "[…] mais la lutte entre les Espagnols et les Flamands se rapproche des territoires que traverse la Dyle, et l’on enlève, une fois de plus, Marie-Marguerite de son monastère pour l’envoyer chez les chanoinesses de Nivelles."
                            },
                            {
                                "example_id": "a7cdc84a-ad38-4279-be09-8bb67ac5e284",
                                "sense_id": "77d25413-bcb0-3d7f-ae65-441da2133883",
                                "text": "Voitures et pièces d’artillerie embouteillaient la Grand-rue, se pressant pour franchir le pont de trois mètres sur la Dyle."
                            }
                        ]
                    },
                    {
                        "sense_id": "760a2db4-54a0-37f0-af61-49100348ec83",
                        "entry_id": "172b807e-a12d-37df-b9ef-9c620d66d742",
                        "glosses": [
                            "Ancien département français dont le chef-lieu était Bruxelles, ayant existé de 1795 à 1814."
                        ],
