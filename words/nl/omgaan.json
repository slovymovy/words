{
    "word_family": [
        "omgang",
        "omgaand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6e9637a-f4ad-38bf-890e-4951b678f613",
                    "sense_definition": "Sociaal contact onderhouden met iemand; tijd met iemand doorbrengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ga</w> graag met mijn vrienden <w>om</w> in het weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>общаться</w> с друзьями по выходным.",
                                "en": "I like to <w>hang out</w> with my friends on the weekend.",
                                "fr": "J'aime <w>fréquenter</w> mes amis le week-end."
                            }
                        },
                        {
                            "text": "Zij kunnen heel goed met elkaar <w>omgaan</w>.",
                            "target_lang_translations": {
                                "ru": "Они очень хорошо <w>ладят</w> друг с другом.",
                                "en": "They <w>get along</w> very well with each other.",
                                "fr": "Ils <w>s'entendent</w> très bien entre eux."
                            }
                        }
                    ],
                    "synonyms": [
                        "optrekken",
                        "contact hebben"
                    ],
                    "antonyms": [
                        "mijden"
                    ],
                    "common_phrases": [
                        "met iemand omgaan",
                        "vriendschappelijk omgaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать социальный контакт, проводить время с кем-то",
                        "en": "To maintain social contact or spend time with someone",
                        "fr": "Entretenir des relations sociales avec quelqu'un ou passer du temps avec lui."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общаться",
                                "target_lang_sense_clarification": "поддерживать отношения, контактировать"
                            },
                            {
                                "target_lang_word": "ладить",
                                "target_lang_sense_clarification": "быть в хороших отношениях"
                            },
                            {
                                "target_lang_word": "проводить время",
                                "target_lang_sense_clarification": "быть вместе с кем-то"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "associate with",
                                "target_lang_sense_clarification": "to spend time socially with someone"
                            },
                            {
                                "target_lang_word": "hang out with",
                                "target_lang_sense_clarification": "informal; to spend leisure time with friends"
                            },
                            {
                                "target_lang_word": "get along with",
                                "target_lang_sense_clarification": "to have a harmonious relationship"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fréquenter",
                                "target_lang_sense_clarification": "passer du temps avec quelqu'un régulièrement"
                            },
                            {
                                "target_lang_word": "s'entendre avec",
                                "target_lang_sense_clarification": "avoir de bonnes relations avec quelqu'un"
                            },
                            {
                                "target_lang_word": "passer du temps avec",
                                "target_lang_sense_clarification": "être en compagnie de quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edbcd8f2-6704-3096-88ad-00279321340a",
                    "sense_definition": "Weten hoe te handelen in een bepaalde situatie of met bepaalde emoties; iets kunnen gebruiken of bedienen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "handling_coping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moet leren <w>omgaan</w> met zijn agressie.",
                            "target_lang_translations": {
                                "ru": "Ему нужно научиться <w>справляться</w> со своей агрессией.",
                                "en": "He needs to learn to <w>deal</w> with his aggression.",
                                "fr": "Il doit apprendre à <w>gérer</w> son agressivité."
                            }
                        },
                        {
                            "text": "Kun jij goed <w>omgaan</w> met computers?",
                            "target_lang_translations": {
                                "ru": "Ты умеешь хорошо <w>обращаться</w> с компьютерами?",
                                "en": "Can you <w>handle</w> computers well?",
                                "fr": "Sais-tu bien <w>utiliser</w> les ordinateurs ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "hanteren",
                        "behandelen"
                    ],
                    "common_phrases": [
                        "omgaan met geld",
                        "leren omgaan met",
                        "omgaan met teleurstelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уметь действовать в определенной ситуации или управлять чем-либо",
                        "en": "To know how to handle a situation, emotion, or object",
                        "fr": "Savoir comment agir dans une situation donnée, gérer des émotions ou utiliser un objet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "пользоваться чем-либо или вести себя с кем-либо"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "совладать с эмоциями или ситуацией"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "deal with",
                                "target_lang_sense_clarification": "to take action to solve a problem or handle a situation"
                            },
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "to manage or control something effectively"
                            },
                            {
                                "target_lang_word": "cope with",
                                "target_lang_sense_clarification": "to manage difficult emotions or situations"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gérer",
                                "target_lang_sense_clarification": "faire face à une situation ou une émotion"
                            },
                            {
                                "target_lang_word": "savoir utiliser",
                                "target_lang_sense_clarification": "être capable de se servir d'un outil ou d'une machine"
                            },
                            {
                                "target_lang_word": "faire face à",
                                "target_lang_sense_clarification": "affronter ou traiter un problème"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1479b80-9d3d-3fee-baeb-cedda2c46946",
                    "sense_definition": "Een draai maken om een hoek of object heen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet hier de hoek <w>omgaan</w> en dan zie je het gebouw.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>завернуть</w> здесь за угол, и тогда ты увидишь здание.",
                                "en": "You have to <w>go around</w> the corner here and then you will see the building.",
                                "fr": "Tu dois <w>tourner</w> au coin ici et tu verras le bâtiment."
                            }
                        },
                        {
                            "text": "Toen we de bocht <w>omgingen</w>, zagen we de zee.",
                            "target_lang_translations": {
                                "ru": "Когда мы <w>обогнули</w> поворот, мы увидели море.",
                                "en": "When we <w>went around</w> the bend, we saw the sea.",
                                "fr": "Quand nous avons <w>contourné</w> le virage, nous avons vu la mer."
                            }
                        }
                    ],
                    "synonyms": [
                        "afslaan"
                    ],
                    "common_phrases": [
                        "de hoek omgaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворачивать за угол или огибать объект",
                        "en": "To turn or move around a corner or object",
                        "fr": "Tourner autour d'un coin ou d'un objet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заворачивать",
                                "target_lang_sense_clarification": "менять направление движения, уходя за угол"
                            },
                            {
                                "target_lang_word": "огибать",
                                "target_lang_sense_clarification": "двигаться по дуге вокруг чего-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go around",
                                "target_lang_sense_clarification": "to move in a curve around an object or corner"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "to change direction around a corner"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tourner",
                                "target_lang_sense_clarification": "changer de direction au coin d'une rue"
                            },
                            {
                                "target_lang_word": "contourner",
                                "target_lang_sense_clarification": "passer autour d'un obstacle ou d'un objet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "339d616d-75df-3d54-8ab4-d3fc81fd985c",
                    "sense_definition": "Het voorbijgaan van een periode of tijdstip",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_passing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakantie is veel te snel <w>omgegaan</w>.",
                            "target_lang_translations": {
                                "ru": "Отпуск <w>прошел</w> слишком быстро.",
                                "en": "The vacation <w>passed</w> much too quickly.",
                                "fr": "Les vacances ont <w>passé</w> beaucoup trop vite."
                            }
                        },
                        {
                            "text": "Laten we hopen dat de winter snel zal <w>omgaan</w>.",
                            "target_lang_translations": {
                                "ru": "Будем надеяться, что зима быстро <w>пройдет</w>.",
                                "en": "Let's hope that the winter will <w>pass</w> quickly.",
                                "fr": "Espérons que l'hiver <w>passera</w> vite."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorbijgaan",
                        "verstrijken",
                        "passeren"
                    ],
                    "common_phrases": [
                        "snel omgaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить (о периоде времени)",
                        "en": "To pass or elapse (of a period of time)",
                        "fr": "Le fait qu'une période de temps s'écoule."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "истекать, заканчиваться (о времени)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to go by (regarding time)"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "to elapse"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "passer",
                                "target_lang_sense_clarification": "s'écouler, en parlant du temps"
                            },
                            {
                                "target_lang_word": "s'écouler",
                                "target_lang_sense_clarification": "le temps qui passe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df49b3e3-68ba-3a3f-9ee3-0aa7dab37e44",
                    "sense_definition": "Een volledige ronde om iets of iemand heen maken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "encircling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De processie zal de kerk driemaal <w>omgaan</w>.",
                            "target_lang_translations": {
                                "ru": "Процессия трижды <w>обойдет</w> церковь.",
                                "en": "The procession will <w>circle</w> the church three times.",
                                "fr": "La procession va <w>faire</w> trois fois le tour de l'église."
                            }
                        },
                        {
                            "text": "In het oude verhaal moesten ze de stad zeven keer <w>omgaan</w>.",
                            "target_lang_translations": {
                                "ru": "В старой истории они должны были семь раз <w>обойти</w> город.",
                                "en": "In the old story they had to <w>go around</w> the city seven times.",
                                "fr": "Dans l'ancienne histoire, ils devaient <w>faire</w> sept fois le tour de la ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "omcirkelen",
                        "omringen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This inseparable form is rarely used in modern Dutch."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать полный круг вокруг чего-либо",
                        "en": "To make a complete circle around something",
                        "fr": "Faire un tour complet autour de quelque chose ou de quelqu'un."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обходить",
                                "target_lang_sense_clarification": "двигаться вокруг объекта"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "circle",
                                "target_lang_sense_clarification": "to move all the way around something"
                            },
                            {
                                "target_lang_word": "go around",
                                "target_lang_sense_clarification": "to encircle"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "faire le tour de",
                                "target_lang_sense_clarification": "encercler ou contourner complètement un lieu"
                            },
                            {
                                "target_lang_word": "encercler",
                                "target_lang_sense_clarification": "entourer quelque chose"
                            }
                        ]
                    }
                }
            ]
        }
