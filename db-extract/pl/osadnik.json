                        "sense_id": "366686f5-ea75-3847-97c2-39f7d8230731",
                        "entry_id": "4cab4852-00aa-3037-846c-7e7a9d4e731d",
                        "glosses": [
                            "osiedlający się na mało zaludnionych terenach; : taki, którego osiedlono na terenach mało zaludnionych"
                        ],
                        "tags": [
