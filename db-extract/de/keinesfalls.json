                                        "sense_id": "52f63ef8-2c30-395f-b71b-6c0b838367ea",
                                        "entry_id": "3e2dc8ed-4503-3aa6-8c6e-93070c1abcea",
                                        "glosses": [
                                            "Jamais, sans aucune acceptabilité ou possibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbe6f27-eb76-424e-b107-fe63d9907b7b",
                                                "sense_id": "52f63ef8-2c30-395f-b71b-6c0b838367ea",
                                                "text": "Ce n’est en aucune manière notre perspective."
                                            },
                                            {
                                                "example_id": "89695e73-5936-46af-8c45-d8241dbcbd64",
                                                "sense_id": "52f63ef8-2c30-395f-b71b-6c0b838367ea",
                                                "text": "– Seigneur Dieu, je vous en supplie, entendez-moi, depuis que je suis née je ne vous ai pas demandé grand-chose, je n’ai abusé en aucune manière de votre pouvoir, j’ai toujours été humble…"
                                            }
