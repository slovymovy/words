                "senses": [
                    {
                        "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                        "entry_id": "d185d222-6df9-3d9a-9c30-bffaf266a4bf",
                        "glosses": [
                            "Gerät, welches einen Autoreifen so umschließt, dass es ein Wegfahren verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0be58c-0b37-4b0d-9fe3-f11ac54ba5d5",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Sie beugte sich nach vorn und überprüfte noch einmal eine Radkralle von der Größe eines kleinen Fahrzeugs.“"
                            },
                            {
                                "example_id": "849cc962-4ce5-416c-9291-c093ddeecdf3",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Im Handschuhfach lagen nur die Betriebsanleitung für den Wagen und eine Radkralle.“"
                            },
                            {
                                "example_id": "3c95d8df-fecc-489d-ab52-f35d44a8a984",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Ich lief wieder zurück zu meinem Audi und sah, dass er keine Radkralle bekommen hatte.“"
                            },
                            {
                                "example_id": "5befa437-6fcc-4ccb-8938-7e46e578a3c1",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Ein Rad seines Porsches steckte in einer Radkralle, und ein zugehöriger Zettel klebte an der Frontscheibe.“"
                            },
                            {
                                "example_id": "5144972c-dc21-4c8b-a571-5bbb5327cd8a",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Wer seinen Wagen achtlos auf einer angrenzenden Fläche abstellt, wird mit einer Radkralle bedacht, was die Wirkung der verführerischen Sonderangebote mindern dürfte.“"
                            },
                            {
                                "example_id": "0ab6fa1d-39fe-411a-9e11-aa89c4df5d99",
                                "sense_id": "6911b830-6a84-3f3d-b306-6a5b28cddd54",
                                "text": "„Allerdings musste man bei einem geschickten Handwerker wie ihm auch damit rechnen, dass er die Radkralle im Handumdrehen entfernen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
