                "senses": [
                    {
                        "sense_id": "994c6bff-567d-3b3a-a852-e4301c7f5aa9",
                        "entry_id": "6000a15c-2967-3ecf-9ec3-c43bc47ef12d",
                        "glosses": [
                            "besonderer Rhythmus von Jazz und Tanzmusik"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c5202e8-ec08-33d3-986f-1880fbd1f283",
                        "entry_id": "6000a15c-2967-3ecf-9ec3-c43bc47ef12d",
                        "glosses": [
                            "Stilrichtung des Jazz vor allem der 1930er/1940er Jahre"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cb2b0186-a741-4a55-9b75-b61f29076e5b",
                                "sense_id": "7c5202e8-ec08-33d3-986f-1880fbd1f283",
                                "text": "„Für sie sind die Plattenaufnahmen vorerst nur ein Mittel, um bekannter zu werden und mehr Engagements in den Clubs zu bekommen, dort, wo der Swing entsteht und geschmiedet wird, im Feuer der sich verzehrenden Seelen.“"
                            },
                            {
                                "example_id": "030b8a82-fe98-4492-aa6d-a8cc279cf174",
                                "sense_id": "7c5202e8-ec08-33d3-986f-1880fbd1f283",
                                "text": "„Deutsche Combos spielten meist den populären Swing und bewegten sich häufig am Rande des Erlaubten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fb0b269b-0b4f-3773-a4c6-acbe3353e638",
                        "entry_id": "6000a15c-2967-3ecf-9ec3-c43bc47ef12d",
                        "glosses": [
                            "Tanzstil, der in den 1930ern in den USA populär war und der zu der Musikrichtung Swing getanzt wurde"
                        ],
                        "tags": [
