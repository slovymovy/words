{
    "word_family": [
        "chusta",
        "chustka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd7b6025-cc5e-3730-b233-8f981e2456b9",
                    "sense_definition": "niewielki kawałek miękkiej tkaniny lub papieru używany zwykle do wycierania nosa",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "higiena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy możesz podać mi <w>chusteczkę</w>?",
                            "target_lang_translations": {
                                "ru": "Можешь подать мне <w>носовой платок</w>?"
                            }
                        },
                        {
                            "text": "Wyjęła z torebki papierową <w>chusteczkę</w> i otarła łzy.",
                            "target_lang_translations": {
                                "ru": "Она достала из сумочки бумажный <w>платок</w> и вытерла слёзы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "papierowa chusteczka",
                        "wycierać nos chusteczką"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой кусок мягкой ткани или бумаги, используемый для вытирания носа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носовой платок",
                                "target_lang_sense_clarification": "стандартный предмет для гигиены носа"
                            },
                            {
                                "target_lang_word": "платок",
                                "target_lang_sense_clarification": "разговорный вариант, используемый в контексте гигиены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cef014de-60db-38c6-8d4a-31176185fc0c",
                    "sense_definition": "zdrobnienie od <w>chustka</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "odzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawiązała na głowie kolorową <w>chusteczkę</w> przed wyjściem na słońce.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на солнце она повязала на голову цветную <w>косынку</w>."
                            }
                        },
                        {
                            "text": "Włożyła do kieszeni jedwabną <w>chusteczkę</w> w kwiaty.",
                            "target_lang_translations": {
                                "ru": "Она положила в карман шёлковый <w>платочек</w> в цветочек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jedwabna chusteczka",
                        "kolorowa chusteczka"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное от слова «платок» (головной убор или аксессуар)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платочек",
                                "target_lang_sense_clarification": "уменьшительно-ласкательная форма или небольшой платок"
                            },
                            {
                                "target_lang_word": "косынка",
                                "target_lang_sense_clarification": "платок треугольной формы, повязываемый на голову"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43d3f557-219f-3a2e-9bf8-b783b01e7df9",
                    "sense_definition": "u saren jasna plama z tyłu ciała",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas ucieczki sarny wyraźnie widać było jej białą <w>chusteczkę</w>.",
                            "target_lang_translations": {
                                "ru": "Когда косуля убегала, было хорошо видно её белое <w>зеркало</w>."
                            }
                        },
                        {
                            "text": "Charakterystyczna <w>chusteczka</w> u sarny pomaga młodym podążać za matką w lesie.",
                            "target_lang_translations": {
                                "ru": "Характерное <w>зеркало</w> у косули помогает детёнышам следовать за матерью в лесу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "светлое пятно на задней части тела у оленей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зеркало",
                                "target_lang_sense_clarification": "термин в биологии для обозначения светлого пятна у оленевых"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}