                {
                    "sense_id": "5367ba2b-3d22-3f66-83bc-ec5603fa46f6",
                    "sense_definition": "Een vrouw, meestal gebruikt in ongunstige zin omdat zij vervelend of raar gevonden wordt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat <w>mens</w> werkt me echt op de zenuwen.",
                            "target_lang_translations": {
                                "ru": "Эта <w>баба</w> действует мне на нервы.",
                                "en": "That <w>woman</w> really gets on my nerves.",
                                "pl": "To <w>babsko</w> naprawdę działa mi na nerwy.",
                                "de": "Dieses <w>Mensch</w> geht mir wirklich auf die Nerven.",
                                "fr": "Cette <w>bonne femme</w> me tape vraiment sur les nerfs.",
                                "it": "Quella <w>donna</w> mi dà proprio sui nervi.",
                                "cs": "Ta <w>bába</w> mi fakt leze na nervy.",
                                "tr": "O <w>kadın</w> gerçekten sinirlerimi bozuyor.",
                                "es": "Esa <w>tía</w> de verdad me pone de los nervios."
                            }
                        },
                        {
                            "text": "Ach <w>mens</w>, doe toch eens normaal.",
                            "target_lang_translations": {
                                "ru": "Ой, <w>женщина</w>, веди себя нормально.",
                                "en": "Oh <w>woman</w>, just act normal.",
                                "pl": "Weź, <w>baba</w>, zachowuj się normalnie.",
                                "de": "Ach <w>Mensch</w>, verhalte dich doch mal normal.",
                                "fr": "Oh, <w>ma pauvre fille</w>, comporte-toi normalement.",
                                "it": "Ma dai, <w>donna</w>, comportati normalmente.",
                                "cs": "Ale <w>ženská</w>, chovej se už normálně.",
                                "tr": "Amann <w>kadın</w>, normal davran artık.",
                                "es": "Ay, <w>mujer</w>, compórtate con normalidad."
                            }
                        }
                    ],
