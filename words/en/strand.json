                            },
                            {
                                "target_lang_word": "unsur",
                                "target_lang_sense_clarification": "bir bütünün parçası"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "线索",
                                "target_lang_sense_clarification": "事情、叙述或真相中的一条脉络"
                            },
                            {
                                "target_lang_word": "主线",
