                        "entry_id": "81dec1be-095b-3a34-a548-90efde579a69",
                        "glosses": [
                            "waarvoor men geen enkel respect kan opbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431a3f4c-a8f1-4ada-82e5-8c096c90c4bc",
                                "sense_id": "6169fec0-c0bc-3d2a-9d68-43cb4be10787",
                                "text": "Zoiets verachtelijks heb ik nog nooit meegemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50aca65a-afc6-4bf7-ade7-2672d9785773",
                        "source_entry_id": "81dec1be-095b-3a34-a548-90efde579a69",
                        "source_sense_id": "6169fec0-c0bc-3d2a-9d68-43cb4be10787",
                        "source_sense_description": "waarvoor men geen enkel respect kan opbrengen",
                        "target_lang_word": "verächtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verächtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                        "entry_id": "d8173dfb-5597-37bb-aab0-2147a7e29052",
                                        "glosses": [
                                            "jemanden missachtend, verachtend; keinen Respekt einem anderen gegenüber zeigend; Verachtung hegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c398cd6-02a9-44b4-b113-4e9b979e0b10",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "Er machte dazu nur eine verächtliche Bemerkung."
                                            },
                                            {
                                                "example_id": "e9f89b78-b36d-45e5-a151-e7138f49a8fb",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Sollte der böse Geist zurückkehren, sollte er wieder verächtlich werden – verächtlich, wie er gewesen war?“"
                                            },
                                            {
                                                "example_id": "14b43f5f-27cd-40d7-8995-82ddab028299",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Die Schusterfrau, die Schlächtermeisterin, alle wandten sich verächtlich von ihm ab.“"
                                            },
                                            {
                                                "example_id": "687aa9ad-83b7-4ebe-9a64-db8da86ddb50",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Du hast Glück, dass deine Eltern dich nicht schon längst losgeworden sind«, sagte Fausta verächtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db5de91d-93cc-4d53-92c7-04e5b0c38f48",
                        "source_entry_id": "81dec1be-095b-3a34-a548-90efde579a69",
                        "source_sense_id": "6169fec0-c0bc-3d2a-9d68-43cb4be10787",
                        "source_sense_description": "waarvoor men geen enkel respect kan opbrengen",
                        "target_lang_word": "despreciable",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despreciable",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "aee8417a-b4f7-3a77-878d-b933d92539b6",
                                        "entry_id": "6267a1b1-6519-31bd-b980-f76598e428c5",
                                        "glosses": [
                                            "Digno de poca o ninguna estima."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735ec4ec-6e61-4fba-8c47-320a1082ace7",
                                                "sense_id": "aee8417a-b4f7-3a77-878d-b933d92539b6",
                                                "text": "En ella, que ha sufrido y ha sido endurecida por la vida, desde niña, cuando fue seducida por un amigo de su familia -el único personaje totalmente despreciable del libro, el abogado corrupto y oportunista político Viktor Komarovski-, esta caracterización esfumada nos parece una falla narrativa"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "645e72e6-f0c9-3823-9bc9-7c00104dc8f5",
                                        "entry_id": "6267a1b1-6519-31bd-b980-f76598e428c5",
                                        "glosses": [
                                            "Escaso, en poca cantidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1877ab4-3913-4c53-a7d1-7c03f1ba140e",
                                                "sense_id": "645e72e6-f0c9-3823-9bc9-7c00104dc8f5",
                                                "text": "De hecho una de las pocas soluciones exactas que conocemos de estas ecuaciones relativistas corresponde al caso de una masa inmensamente grande alrededor de la cual orbita otra tan diminuta que su influencia sobre la primera se considera despreciable"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
