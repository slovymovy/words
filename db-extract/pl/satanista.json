                            {
                                "example_id": "590129b2-1dc1-45f8-b40f-b2d96fb50f1b",
                                "sense_id": "eecb05da-2fa0-3ff5-b9e1-9fc948080ecf",
                                "text": "Gdyby więc odmówiono satanistom prawa do prowadzenia modlitwy, mogłoby to być uznane za dyskryminację"
                            },
                            {
                                "example_id": "cd8cc86f-35c5-4045-a2e0-1b0847f7fd26",
                                "sense_id": "eecb05da-2fa0-3ff5-b9e1-9fc948080ecf",
                                "text": "Przez chwilę było o niej głośno przed 20 laty, kiedy to padła ofiarą nieletnich satanistów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
