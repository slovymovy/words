                "senses": [
                    {
                        "sense_id": "9c5e5072-3ea3-3808-aa32-91e04b690668",
                        "entry_id": "f20af1f1-ec28-34d9-97a3-39305449d6eb",
                        "glosses": [
                            "Sombrer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be672b3-bf72-4821-bafb-7a7ee6f2e7f4",
                                "sense_id": "9c5e5072-3ea3-3808-aa32-91e04b690668",
                                "text": "Allais-je déjà resombrer dans mon néant habituel, vide au milieu de la guerre, faux rêve, cauchemar à demi endormi ?"
                            },
                            {
                                "example_id": "73ac713f-3775-4d0f-96cd-2938d69022b6",
                                "sense_id": "9c5e5072-3ea3-3808-aa32-91e04b690668",
                                "text": "Je vais resombrer dans la déprime."
                            },
                            {
                                "example_id": "5d4e0257-2ea9-49a6-a6fb-a4ec418f75f6",
                                "sense_id": "9c5e5072-3ea3-3808-aa32-91e04b690668",
                                "text": "De temps en temps, il sortait de son mutisme pour illustrer son geste : Monk Know, Monk Know, puis resombrait dans le silence."
                            }
                        ]
                    }
