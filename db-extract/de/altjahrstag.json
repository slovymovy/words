                "senses": [
                    {
                        "sense_id": "e5e5e743-def5-3d84-b2d2-fabdb30571a0",
                        "entry_id": "2892d393-d4e2-3d34-8385-15e8a98c85cf",
                        "glosses": [
                            "letzter Tag eines Jahres; Silvester"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5cc940a3-8796-4748-a387-9de9b145ff9e",
                                "sense_id": "e5e5e743-def5-3d84-b2d2-fabdb30571a0",
                                "text": "„Der Altjahrstag war angebrochen, im ganzen Haus roch es nach Gebackenem, ein bleigrauer Himmel hing über den Bergen.“"
                            },
                            {
                                "example_id": "e03d9806-23f5-4992-86ce-312116d88de5",
                                "sense_id": "e5e5e743-def5-3d84-b2d2-fabdb30571a0",
                                "text": "„In dieser Position schrieb er am Altjahrstag 1946 an Karl Barth, den er kurze Zeit zuvor in Basel besucht hatte, und legte ihm zwei Bitten vor.“"
                            },
                            {
                                "example_id": "6c07403a-337c-4a93-993f-5e5620be2fdd",
                                "sense_id": "e5e5e743-def5-3d84-b2d2-fabdb30571a0",
                                "text": "„Einige Tage vor dem Neujahr, muthmaßlich am Altjahrstag, habe dem Herrn Deci ebenfalls ein Lamm gemetzget und demselben das Fell abgekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
