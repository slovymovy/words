    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f881cb1d-abc1-3439-a83b-14c0de18374f",
                    "sense_definition": "Déplacer quelque chose vers le haut, hausser ou mettre plus haut.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_haut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève doit <w>lever</w> la main avant de poser sa question au professeur."
                        },
                        {
                            "text": "Elle a <w>levé</w> les yeux vers le ciel pour observer les oiseaux migrateurs."
                        }
                    ],
                    "synonyms": [
                        "élever",
                        "hausser"
                    ],
                    "antonyms": [
                        "baisser"
                    ],
                    "common_phrases": [
                        "lever la main",
                        "lever les yeux"
                    ]
                },
                {
                    "sense_id": "6ad8b048-1aee-3b61-be36-db52a83d3c24",
                    "sense_definition": "Sortir de son lit après le sommeil.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "se_lever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>lève</w> tous les matins à sept heures pour aller au travail."
                        },
                        {
                            "text": "Il préfère se <w>lever</w> tôt le week-end pour faire du sport."
                        }
                    ],
                    "antonyms": [
                        "se coucher"
                    ],
                    "common_phrases": [
                        "se lever tôt"
                    ]
                },
                {
                    "sense_id": "70b667f9-8f4f-39c7-98f1-022319f63e4f",
                    "sense_definition": "Quitter la position assise ou couchée pour se mettre debout.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "se_lever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs se sont <w>levés</w> pour applaudir la performance de l'artiste."
                        },
                        {
                            "text": "Il s'est <w>levé</w> rapidement de sa chaise dès l'arrivée du directeur."
                        }
                    ],
                    "antonyms": [
                        "s'asseoir",
                        "s'allonger"
                    ],
                    "common_phrases": [
                        "se lever de sa chaise"
                    ]
                },
                {
                    "sense_id": "35e57f37-8202-323b-941f-99fac08e864e",
                    "sense_definition": "Apparaître au-dessus de l'horizon, en parlant du soleil, de la lune ou d'un astre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "astres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En été, le soleil se <w>lève</w> très tôt sur la côte atlantique."
                        },
                        {
                            "text": "Nous avons attendu que la lune se <w>lève</w> au-dessus des collines."
                        }
                    ],
                    "antonyms": [
                        "se coucher"
                    ],
                    "common_phrases": [
                        "le soleil se lève"
                    ]
                },
                {
                    "sense_id": "fb5f1896-89f3-36f8-82a3-b8d8a0abdb36",
                    "sense_definition": "Faire disparaître, dissiper ou surmonter une difficulté, une hésitation ou un doute.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eliminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces nouvelles explications ont permis de <w>lever</w> tous les doutes sur le projet."
                        },
                        {
                            "text": "La direction espère <w>lever</w> les incertitudes des salariés dès la semaine prochaine."
                        }
                    ],
                    "common_phrases": [
                        "lever le doute"
                    ]
                },
                {
                    "sense_id": "4e050194-b1de-3816-b92b-77a4a68843d4",
                    "sense_definition": "Recueillir, collecter ou emprunter des capitaux auprès d'investisseurs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune pousse espère <w>lever</w> des fonds pour financer son développement international."
                        },
                        {
                            "text": "L'entreprise a <w>levé</w> dix millions d'euros lors de son dernier tour de table."
                        }
                    ],
                    "common_phrases": [
                        "lever des fonds"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12445598-6c30-3070-85d4-3db79d3c6981",
                    "sense_definition": "Moment ou fait d'apparaître à l'horizon pour un astre, ou fait de sortir du lit le matin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "moment_lever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous sommes partis marcher très tôt pour admirer le magnifique <w>lever</w> du soleil."
                        },
                        {
                            "text": "Au <w>lever</w>, elle boit toujours un grand verre d'eau avant son café."
                        }
                    ],
                    "antonyms": [
                        "coucher"
                    ],
                    "common_phrases": [
                        "lever du soleil",
                        "lever du jour"
                    ]
                },
                {
                    "sense_id": "60379164-2906-3559-a278-72fa7f202748",
                    "sense_definition": "Action de hisser ou d'ouvrir quelque chose, notamment le rideau au théâtre.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_haut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un silence attentif s'est installé dans la salle au <w>lever</w> du rideau."
                        },
                        {
                            "text": "La pièce a commencé immédiatement après le premier <w>lever</w> de rideau."
                        }
                    ],
                    "antonyms": [
                        "baisser"
                    ],
                    "common_phrases": [
                        "lever de rideau"
                    ]
                }
            ]
        }
    ]
