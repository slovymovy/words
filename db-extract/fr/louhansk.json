                                        "entry_id": "fb929f21-0769-3f09-9c50-a86df2323b4b",
                                        "glosses": [
                                            "An oblast in the Donbas region, in eastern Ukraine. Seat: Sievierodonetsk; former seat: Luhansk (prior to the Donbas War, where Russia occupied and set up puppet countries)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
