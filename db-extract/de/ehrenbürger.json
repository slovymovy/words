                "senses": [
                    {
                        "sense_id": "3e9848dd-e67d-34a8-9836-b6df29ca9c09",
                        "entry_id": "387f7db2-56b7-3d0a-b8cd-baab92f7565f",
                        "glosses": [
                            "von einer Stadt, Gemeinde oder Hochschule verliehene Auszeichnung zur Würdigung besonderer Leistungen einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c1d229-e526-40e4-ad83-f2b2efd32272",
                                "sense_id": "3e9848dd-e67d-34a8-9836-b6df29ca9c09",
                                "text": "„2011 wurde dem damals 85-jährigen der Titel des Ehrenbürgers der Stadt Ełk verliehen.“"
                            },
                            {
                                "example_id": "ff483732-886a-4434-8ef6-9cc1870571b4",
                                "sense_id": "3e9848dd-e67d-34a8-9836-b6df29ca9c09",
                                "text": "„Die Gemeinde Oberwerrn hat bis zum Ende ihrer Selbständigkeit insgesamt nur fünfmal die Würde des Ehrenbürgers an ausgewählte Oberwerrner Bürger übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1fb8e74d-dc15-34f8-86c0-2946497f4505",
                        "entry_id": "387f7db2-56b7-3d0a-b8cd-baab92f7565f",
                        "glosses": [
                            "Person, der [1] zuteilwurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f50180-0f27-43df-a8d5-c01b503018c6",
                                "sense_id": "1fb8e74d-dc15-34f8-86c0-2946497f4505",
                                "text": "„Rehhagel und seine Spieler wurden zu Ehrenbürger Athens ernannt.“"
                            },
                            {
                                "example_id": "37e8a8f2-93c6-4f36-a3e4-e3f599519e44",
                                "sense_id": "1fb8e74d-dc15-34f8-86c0-2946497f4505",
                                "text": "„Große Ehre für Philipp Lahm: Der ehemalige Kapitän der deutschen Fußball-Nationalmannschaft ist zum Ehrenbürger seiner Heimatstadt München gewählt worden.“"
                            },
                            {
                                "example_id": "50fc1bc6-5616-4bfd-a5b9-516e7d70b6de",
                                "sense_id": "1fb8e74d-dc15-34f8-86c0-2946497f4505",
                                "text": "„Am 5. Februar 1941 ist er anlässlich seines 80. Geburtstages zum Ehrenbürger von Franenthal ernannt sowie nochmals vom 28. Februar bis zum 5. April 1992 im Erkenbert-Museum seiner Vaterstadt mit einer Ausstellung geehrt worden.“"
                            },
                            {
                                "example_id": "518e0b11-f92a-480c-85ac-5cc9554d03b5",
                                "sense_id": "1fb8e74d-dc15-34f8-86c0-2946497f4505",
                                "text": "„Die Liste der Ehrenbürger wurde auf diejenigen Persönlichkeiten beschränkt, die sich um die Stadt und ihr Umland besonders verdient gemacht oder den Namen der Stadt Lindau weit über ihre Grenzen hinausgetragen haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
