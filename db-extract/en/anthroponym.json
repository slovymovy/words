                                    {
                                        "sense_id": "0ce7b373-9e53-30c9-b60b-a7255b05a2bc",
                                        "entry_id": "e9282aa9-fc0c-3c53-9838-fa9127f283f3",
                                        "glosses": [
                                            "Nom de personne désignant un être humain ou un ensemble d’êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fe4603-eaae-4ceb-a762-84ab8e4273a1",
                                                "sense_id": "0ce7b373-9e53-30c9-b60b-a7255b05a2bc",
                                                "text": "À première vue les anthroponymes ou noms de personnes de Normandie ne présentent rien de particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870fa99f-4153-369a-bcb4-2964771e6b59",
                                        "entry_id": "e9282aa9-fc0c-3c53-9838-fa9127f283f3",
                                        "glosses": [
                                            "Anthropotoponyme, c’est-à-dire un toponyme portant le nom d’une personne."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fedd61c2-84a7-4492-8618-5afb0ba78ee2",
                                                "sense_id": "870fa99f-4153-369a-bcb4-2964771e6b59",
                                                "text": "Les particularités de traitement de Washington sont probablement liées au fait qu’il est issu d’un anthroponyme, comme Israël, seul nom de pays à ne pas prendre l’article, et du reste aussi comme Vancouver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc4e690c-9d11-4b3c-ae78-0f521359aabe",
                        "source_entry_id": "a08bc0c4-49f5-33d5-8b0c-71371f5f704b",
                        "source_sense_id": "d9920acf-e69a-330e-b3c9-8e018f72570f",
                        "source_sense_description": "name of a person",
                        "target_lang_word": "Personenname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Personenname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                        "entry_id": "499b4043-5ae4-323a-b72f-1920557e7331",
                                        "glosses": [
                                            "Bezeichnung einer bestimmten (natürlichen) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf7494d-01aa-4698-be97-7ae99d5743b5",
                                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                                "text": "„Auf dem Gebiet der Anthroponyme dominieren mit großem Abstand die Untersuchungen zu den Personennamen und den Familiennamen.“"
                                            },
                                            {
                                                "example_id": "e9f7bb33-33ab-4b25-bd0d-bac94cdf9355",
                                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                                "text": "„In späteren Fassungen finden sich 1500 Ortsnamen und mehr als 3500 Personennamen.“"
                                            },
                                            {
                                                "example_id": "f2f21da9-896a-4c93-bb23-7669ac476bf1",
                                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                                "text": "„Die Zusammensetzung der Personennamen läßt auch ein Prinzip der germanischen Rufnamengebung erkennen.“"
                                            },
                                            {
                                                "example_id": "c0a9b04b-b6f6-4f73-af5d-1cb5b63c9ec3",
                                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                                "text": "„Eine Hervorhebung des Personennamens ist nicht zu empfehlen, wenn die Zusammensetzung zu einer Gattungsbezeichnung geworden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb60ea90-95bf-3282-b0a9-d227a5449163",
                                        "entry_id": "499b4043-5ae4-323a-b72f-1920557e7331",
                                        "glosses": [
                                            "der Teil von [1], der nicht die Familie oder einen Elternteil bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f66147d-d6d1-43ed-bfe8-0eda64e26cf9",
                                                "sense_id": "bb60ea90-95bf-3282-b0a9-d227a5449163",
                                                "text": "„JJ“ ist als Personenname nicht geeignet."
                                            }
