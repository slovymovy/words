                                "target_senses": [
                                    {
                                        "sense_id": "8d4241b5-46f6-387c-ab99-33bdcb9e2d74",
                                        "entry_id": "08925ec6-7691-3f70-bc26-e68ce80114c5",
                                        "glosses": [
                                            "ein geografisches Kartenwerk"
                                        ],
                                        "tags": [
                                            "standardsprachlich Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd09cdd-8348-4c74-b55a-069c57962cbf",
                                                "sense_id": "8d4241b5-46f6-387c-ab99-33bdcb9e2d74",
                                                "text": "Ich muss das mal im Atlas nachschauen."
                                            },
                                            {
                                                "example_id": "7ea2da07-fb79-4136-be6a-d829ffd246ec",
                                                "sense_id": "8d4241b5-46f6-387c-ab99-33bdcb9e2d74",
                                                "text": "„Weil ich nicht viele bunte Bücher hatte, spielte ich schließlich mit den Atlanten meiner Tante.“"
                                            },
                                            {
                                                "example_id": "f3b87b45-a26e-4af4-adf5-1bdb981fe361",
                                                "sense_id": "8d4241b5-46f6-387c-ab99-33bdcb9e2d74",
                                                "text": "„Auf den Büchergestellen standen Diktionäre, eine frühe, wohlbeleibte Ausgabe der Encyclopaedia Britannica, Who's Who, der Debrett und andere Nachschlagewerke, mehrere Reiseführer und Atlanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff6872d8-86c6-369e-89c2-fc67efc0dde0",
                                        "entry_id": "08925ec6-7691-3f70-bc26-e68ce80114c5",
                                        "glosses": [
                                            "grafisches Nachschlagewerk als eine Sammlung von Bildtafeln aus einem Wissensgebiet"
                                        ],
                                        "tags": [
                                            "standardsprachlich Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1625fa63-f28c-4344-bd68-daa5b8fe465e",
                                                "sense_id": "ff6872d8-86c6-369e-89c2-fc67efc0dde0",
                                                "text": "Atlas der Blütenpflanzen Deutschlands"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8c9bb777-ebb1-3c31-8037-29684d97fe48",
                                        "entry_id": "08925ec6-7691-3f70-bc26-e68ce80114c5",
                                        "glosses": [
                                            "der erste Halswirbel, welcher den Kopf trägt"
                                        ],
                                        "tags": [
                                            "nur Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41106b60-fed0-40ab-8de8-59077a60a58c",
                                                "sense_id": "8c9bb777-ebb1-3c31-8037-29684d97fe48",
                                                "text": "Die beide ersten Halswirbel heißen Atlas und Dreher."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e958f88e-b6fe-3571-9b00-9c12ea65f0ca",
                                        "entry_id": "08925ec6-7691-3f70-bc26-e68ce80114c5",
                                        "glosses": [
                                            "seltener Ausdruck für Atlant, eine architektonische Stütze in Form einer männlichen Person mit erhobenen Armen"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fc88d14-9874-48f5-a508-51829932604d",
                                                "sense_id": "e958f88e-b6fe-3571-9b00-9c12ea65f0ca",
                                                "text": "Der Atlas von diesem Gebäude gefällt mir nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1d2638b8-8941-3917-9fc1-ba2964c40c46",
                                        "entry_id": "08925ec6-7691-3f70-bc26-e68ce80114c5",
                                        "glosses": [
                                            "Gebirge in Nordwestafrika"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ebaaad-f597-4c69-8391-c94b3830ccf8",
                                                "sense_id": "1d2638b8-8941-3917-9fc1-ba2964c40c46",
                                                "text": "Der Atlas begünstigt die Wüstenbildung im Landesinneren von Marokko und Algerien."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
