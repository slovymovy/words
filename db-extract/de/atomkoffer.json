                "senses": [
                    {
                        "sense_id": "40ec1ca5-37c7-302e-91a1-4aba6ecac603",
                        "entry_id": "4934a3f1-63d5-36f7-b646-7fa0313f7d0d",
                        "glosses": [
                            "Koffer, in dem sich der Auslösemechanismus für den Einsatz von Atomwaffen befindet"
                        ],
                        "tags": [
                            "Waffentechnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4de7989b-1961-4333-8626-fda64ba81ade",
                                "sense_id": "40ec1ca5-37c7-302e-91a1-4aba6ecac603",
                                "text": "„Der Atomkoffer - das äußere Attribut der Kontrolle über die strategischen Atomwaffen Russlands - war sogar dann in unmittelbarer Nähe, als sich der Präsident auf den Pisten von St. Anton dem Skisport widmete.“"
                            },
                            {
                                "example_id": "a21125b6-49aa-4976-a642-deb9e38c6211",
                                "sense_id": "40ec1ca5-37c7-302e-91a1-4aba6ecac603",
                                "text": "„Der Atomkoffer wurde während der Eisenhower-Regierung erstmals in den USA eingeführt und infolge der Kubakrise weiterentwickelt, um zu gewährleisten, dass nur der durch die Verfassung legitimierte militärische Oberbefehlshaber […] einen Atomschlag befehlen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
