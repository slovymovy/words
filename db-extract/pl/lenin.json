                        "sense_id": "59b9e234-f204-3c5f-af36-639e643d4856",
                        "entry_id": "05cee318-9c4f-3de7-a62f-6454aa042b55",
                        "glosses": [
                            "pseudonim Władimira Iljicza Uljanowa, rosyjskiego polityka i radzieckiego przywódcy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ddec70-5570-4d91-83c0-41233436ff86",
                                "sense_id": "59b9e234-f204-3c5f-af36-639e643d4856",
                                "text": "Lenin był przywódcą i ideologiem rewolucji proletariackiej w Rosji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0b77818-57bb-4d1b-acfd-017b413aedbe",
                        "source_entry_id": "05cee318-9c4f-3de7-a62f-6454aa042b55",
                        "source_sense_id": "59b9e234-f204-3c5f-af36-639e643d4856",
                        "target_lang_word": "Ленин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ленин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb848cad-33fd-3a4b-bdcd-8d5ca6436235",
                                        "entry_id": "94904541-f628-3e1e-afd6-9aa83e9b1cb6",
                                        "glosses": [
                                            "основной псевдоним русского революционера, советского партийного и государственного деятеля Владимира Ильича Ульянова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3113fd27-7650-478d-8e18-318d64cb0135",
                                                "sense_id": "bb848cad-33fd-3a4b-bdcd-8d5ca6436235",
                                                "text": "Вопреки тому, что писалось в учебниках истории советских времён, даже «прозорливый» В. И. Ленин не мог разглядеть Февраля 1917-го: «Мы, старики .., до грядущей революции не доживём», — заявлял он в Цюрихе за два месяца до февральских событий…"
                                            },
                                            {
                                                "example_id": "1a6c8f7c-4b6e-4e6c-a9f8-7a3102dafe98",
                                                "sense_id": "bb848cad-33fd-3a4b-bdcd-8d5ca6436235",
                                                "text": "В. И. Ленин в марте 1921 г. на X съезде РКП (б) отмечал: «Мы переживаем время, когда перед нами встаёт серьёзная угроза: мелкобуржуазная контрреволюция, как я уже говорил, более опасна, чем Деникин»."
                                            },
                                            {
                                                "example_id": "293a7f09-6bce-4dbe-9757-5af7ed38b915",
                                                "sense_id": "bb848cad-33fd-3a4b-bdcd-8d5ca6436235",
                                                "text": "Захватив власть в ходе вооружённого переворота, страдающий нейросифилисом — см. публикации В. Новосёлова (отсюда — частые приступы садизма), руководитель немецкой резидентуры Ленин, объявил о введении диктатуры пролетариата, т. е. «власти опирающейся на прямое насилие, не ограниченной никакими законами и рамкам»."
                                            },
                                            {
                                                "example_id": "61a119ca-be2a-4f87-a5b3-f25482abd435",
                                                "sense_id": "bb848cad-33fd-3a4b-bdcd-8d5ca6436235",
                                                "text": "Когда Ленин умирал, // Сталину наказывал: // — Меньше хлеба им давай, // Мяса не показывай!"
                                            }
                                        ]
                                    }
                                ]
                            },
