                                            {
                                                "example_id": "18b3044a-3b33-4a3c-a3ee-5abeb6805846",
                                                "sense_id": "1af3797d-a1d8-3c1e-8c44-5e2b9894372e",
                                                "text": "Er is een zaadje in hem geplant, en ondanks zijn aanwezigheid weet ze dat hij stug volhoudt dat Jacob zijn dochter niet krijgt."
                                            },
                                            {
                                                "example_id": "a0571e13-3919-4929-bcde-ba5f2273de53",
                                                "sense_id": "1af3797d-a1d8-3c1e-8c44-5e2b9894372e",
                                                "text": "In Otto's ogen is Jacob van Loos net als Clara Sarragon: gevaarlijk, onsympathiek, van hetzelfde dure laken een pak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a0d459-04b7-3670-a38b-3a77c50f0b2f",
                                        "entry_id": "52fce2db-c9ea-3083-9ca5-d464e84593a4",
