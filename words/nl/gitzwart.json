            "senses": [
                {
                    "sense_id": "86005caa-ffc1-354a-b86d-5774070c7dbb",
                    "sense_definition": "Bijzonder donker van kleur, zo zwart als git.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nacht was <w>gitzwart</w> en er waren geen sterren te zien.",
                            "target_lang_translations": {
                                "en": "The night was <w>pitch-black</w> and no stars were to be seen."
                            }
                        },
                        {
                            "text": "Zij heeft een <w>gitzwarte</w> nacht waarin ze niets kon zien meegemaakt.",
                            "target_lang_translations": {
                                "en": "She experienced a <w>pitch-black</w> night in which she couldn't see a thing."
                            }
                        }
                    ],
                    "synonyms": [
                        "pikzwart"
                    ],
                    "common_phrases": [
                        "gitzwarte nacht",
                        "gitzwart haar"
                    ],
                    "target_lang_definitions": {
