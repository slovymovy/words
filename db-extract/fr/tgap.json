        "fr-extract.jsonl": [
            {
                "entry_id": "e60fa1fa-ac70-32d4-a105-07ab68e86d9a",
                "word": "TGAP",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3387cb5f-07f6-31d1-98fc-fb58511b1340",
                        "entry_id": "e60fa1fa-ac70-32d4-a105-07ab68e86d9a",
                        "glosses": [
                            "Taxe indirecte due par les utilisateurs ou les consommateurs sur des produits ou des services considérés comme susceptibles d’être polluants."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "7904883b-8eef-4447-ab9f-6b8e3c48b8a8",
                                "sense_id": "3387cb5f-07f6-31d1-98fc-fb58511b1340",
                                "text": "L’impact de la TGAP diffère entre les deux secteurs concernés, en terme d’anticipation de la mesure, d’acceptabilité de la part des industriels et de répercussion sur les prix. L'impact environnemental reste encore difficile à évaluer trois ans après la mise en application de la taxe."
                            },
                            {
                                "example_id": "bb6017bb-329a-4897-8dd9-ecbd21c236b6",
                                "sense_id": "3387cb5f-07f6-31d1-98fc-fb58511b1340",
                                "text": "La TGAP provoquera un renchérissement considérable du coût des produits transportés."
                            },
                            {
                                "example_id": "2e637d3b-eee4-4d85-9c93-0ac93ed29216",
                                "sense_id": "3387cb5f-07f6-31d1-98fc-fb58511b1340",
                                "text": "La TGAP entrée en vigueur le 1ᵉʳ janvier 1999 en France est un élément de la fiscalité censé prendre en compte les préoccupations écologiques."
                            },
                            {
                                "example_id": "646cabfe-8a88-4b6b-b2ee-8fe6d6fa27e4",
                                "sense_id": "3387cb5f-07f6-31d1-98fc-fb58511b1340",
                                "text": "Cette taxe n’est pas recouvrée sur la déclaration en douane : le montant mentionné sur le document administratif unique (DAU) (…) doit être reporté sur la déclaration annuelle de TGAP prévue par l’article 266 undecies du code des douanes."
                            }
                        ]
                    }
