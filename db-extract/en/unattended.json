                                "example_id": "a542a90a-799e-411d-865b-9c1abea46b41",
                                "sense_id": "42255c23-6246-33d8-a56e-c9e9b3be6917",
                                "text": "The meeting went largely unattended, since it took place on Christmas Eve."
                            },
                            {
                                "example_id": "5859e202-207a-498a-919e-a8cd07993100",
                                "sense_id": "42255c23-6246-33d8-a56e-c9e9b3be6917",
                                "text": "System administrators may schedule an unattended installation of the software."
                            },
                            {
                                "example_id": "50fefed2-3bc0-4c4c-987d-f0ab47e6261f",
                                "sense_id": "42255c23-6246-33d8-a56e-c9e9b3be6917",
                                "text": "Considerable excitement was caused on the L.M.S.R. Aberdeen line out of Perth recently when a shunting engine in Perth North goods yard, whose driver and fireman were absent, was accidentally set in motion by a shunter and set off unattended on to the main line."
                            }
                        ]
                    },
