                "forms": [],
                "senses": [
                    {
                        "sense_id": "72f78bb1-6965-3456-a555-ac6fe11573e0",
                        "entry_id": "6c0b181b-afd9-30c0-ad91-f5143d487a41",
                        "glosses": [
                            "technisches System, das es erlaubt Photonen zu registrieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271b4461-12fb-42fa-9c29-a885d7693183",
                                "sense_id": "72f78bb1-6965-3456-a555-ac6fe11573e0",
                                "text": "„Les principaux éléments d'un photomultiplicateur sont le tube à vide, la photocathode, les dynodes, et l'anode.“",
                                "translation": "Die wichtigsten Elemente eines Fotovervielfachers sind die Vakuumröhre, die Fotokatode, die Dynoden und die Anode."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17b907d1-f393-4760-935d-2a8b6fd916fe",
                        "source_entry_id": "6c0b181b-afd9-30c0-ad91-f5143d487a41",
                        "source_sense_id": "72f78bb1-6965-3456-a555-ac6fe11573e0",
                        "source_sense_description": "Elektronik: technisches System, das es erlaubt Photonen zu registrieren",
                        "target_lang_word": "Photomultiplier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "accbacce-a539-46cb-8f26-781110f7bf45",
                        "source_entry_id": "6c0b181b-afd9-30c0-ad91-f5143d487a41",
                        "source_sense_id": "72f78bb1-6965-3456-a555-ac6fe11573e0",
                        "source_sense_description": "Elektronik: technisches System, das es erlaubt Photonen zu registrieren",
                        "target_lang_word": "Fotovervielfacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotovervielfacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                        "entry_id": "891b7af4-a47b-34a2-93fd-36168786651b",
                                        "glosses": [
                                            "Elektronenröhre bestehend aus Fotokatode und Elektronenvervielfacher zum Nachweis und zur Messung schwacher Lichtsignale"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde1babf-aa93-4643-aece-b68c185c4221",
                                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                                "text": "„Die Lichtblitze werden dann von dem Fotovervielfacher erfaßt, der Spannungsimpulse erzeugt, deren Größe der Stärke der entsprechenden Lichtblitze proportional ist.“"
                                            },
                                            {
                                                "example_id": "474fea14-9797-449e-9ea1-c530460ade08",
                                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                                "text": "„Die Potentiale an den einzelnen Dynoden müssen vor der ersten Inbetriebnahme eines neuen Fotovervielfachers kontrolliert und eingestellt werden.“"
                                            },
                                            {
                                                "example_id": "56d78e2c-e52a-410f-815e-671bcb93cfd3",
                                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                                "text": "„Das Fenster eines Fotovervielfachers ist die für den Strahlungseintritt vorgesehene Fläche.“"
                                            },
                                            {
                                                "example_id": "43ce2495-76d0-42eb-b0bc-586d0c56d758",
                                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                                "text": "„Der Fotovervielfacher zeigt auch bei völliger Dunkelheit bereits einen Strom, den Dunkelstrom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
