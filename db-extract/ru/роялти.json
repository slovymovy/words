                                        "sense_id": "6bc7132e-84d9-3ae0-81f4-52d9bcc4b750",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "The rank, status, power or authority of a monarch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
