                "senses": [
                    {
                        "sense_id": "5db86d1e-249e-3394-aa48-94f4260c9fd0",
                        "entry_id": "a7fb8390-d726-32d7-aded-1ac25f15644f",
                        "glosses": [
                            "свойство или состояние по значению прилагательного безвестный; неизвестность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf0aee6-7584-4c12-9539-5ac36de8943b",
                                "sense_id": "5db86d1e-249e-3394-aa48-94f4260c9fd0",
                                "text": "Потом с досадой вспомнили гениальных художников, умерших в безвестности и нищете."
                            }
                        ]
                    },
                    {
                        "sense_id": "727b04a8-fd0e-34d6-8894-6c09f22d5c32",
                        "entry_id": "a7fb8390-d726-32d7-aded-1ac25f15644f",
                        "glosses": [
                            "устар. отсутствие вестей, сведений о ком-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfb92c0-aecb-4915-839c-00fce41417b0",
                                "sense_id": "727b04a8-fd0e-34d6-8894-6c09f22d5c32",
                                "text": "Сия любовь, хотя и бескорыстная, питается частыми сношениями венценосцев о делах купеческих: если гостей английских не будет в России, то королева и не услышит о царе; а долговременная безвестность не охладит ли взаимного дружества?"
                            }
                        ]
                    }
