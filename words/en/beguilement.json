                    "semantic_group_id": "charm_and_deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler soon succumbed to the gentle <w>beguilement</w> of the island's slow pace and scenic beauty.",
                            "target_lang_translations": {
                                "es": "El viajero pronto sucumbió al suave <w>encanto</w> del ritmo pausado y la belleza paisajística de la isla."
                            }
                        },
                        {
                            "text": "Despite her charming manner, he remained wary of any subtle <w>beguilement</w> designed to win his financial support.",
                            "target_lang_translations": {
                                "es": "A pesar de sus modales encantadores, él se mantuvo receloso de cualquier sutil <w>embaucamiento</w> diseñado para conseguir su apoyo financiero."
                            }
                        }
                    ],
