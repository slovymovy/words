                                        "entry_id": "bed5d34b-aa48-3b6c-b881-59819498abf7",
                                        "glosses": [
                                            "Antitransgender or antitranssexual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1d1213-93b0-4a07-810a-da4fdc677b64",
                                                "sense_id": "a7fd3e58-ee88-3bb3-9e38-97c60019a55d",
                                                "text": "Although I wanted to undermine the foundations on which such antitrans screeds were built, there were many alternative strategies I might have used."
                                            },
                                            {
                                                "example_id": "e6599bcc-67b5-45eb-ad96-dd991411f92c",
                                                "sense_id": "a7fd3e58-ee88-3bb3-9e38-97c60019a55d",
                                                "text": "This led Lee Brewster of Queens Liberation Front to denounce antitrans lesbian feminists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
