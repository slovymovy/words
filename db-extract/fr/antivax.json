                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e0390b7-5829-4043-a46d-34f970c7f967",
                        "entry_id": "25a37e98-2adf-330d-82d4-d855c6c1c1b5",
