                        "sense_id": "2becaded-a461-3e58-ac97-9c50c3308093",
                        "entry_id": "2158b55b-0ee6-3dd2-aa94-167a790fa14c",
                        "glosses": [
                            "Quantité dix fois plus grande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7d33f5-81f5-48d6-b7de-4478541127c4",
                                "sense_id": "2becaded-a461-3e58-ac97-9c50c3308093",
                                "text": "Il a gagné dans cette affaire le décuple de ce qu’il avait avancé."
                            },
                            {
                                "example_id": "3deda5bc-e7c7-41ae-abaf-9849e1bc9eeb",
                                "sense_id": "2becaded-a461-3e58-ac97-9c50c3308093",
                                "text": "Elles lui servent aussi, le cas échéant, de prêteuses qu’il repaye au décuple."
                            },
                            {
                                "example_id": "3d445a58-9f27-4c25-a2e1-891b716f634c",
                                "sense_id": "2becaded-a461-3e58-ac97-9c50c3308093",
                                "text": "M. Drieux qui aurait pu me vendre le chiot pour le décuple de son prix, je jubilais en intronisant la créature auprès de nos dieux lares."
                            }
                        ]
                    }
