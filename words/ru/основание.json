                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_base",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы решили поставить палатку у самого <w>основания</w> горы.",
                            "target_lang_translations": {
                                "en": "The tourists decided to pitch their tent at the very <w>base</w> of the mountain.",
                                "tr": "Turistler çadırı dağın hemen <w>eteğine</w> kurmaya karar verdiler."
                            }
                        },
                        {
                            "text": "Памятник стоит на массивном каменном <w>основании</w>.",
