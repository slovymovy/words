                                "target_senses": [
                                    {
                                        "sense_id": "3c3e4c1a-0ed4-34d5-9e21-bd3834b85584",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Ouvrière qui était chargée d’entretenir un feu, notamment pour le brayage du lin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36cdfae-a8f0-488a-9373-ae0ec17475a0",
                                                "sense_id": "3c3e4c1a-0ed4-34d5-9e21-bd3834b85584",
                                                "text": "Une grosse bûche posée à terre à l’entrée de la cheminée empêche le feu de s’étendre et protège la chauffeuse qui doit concentrer toute son attention sur le lin pour l’empêcher de s’enflammer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5808b6e4-8b15-3645-9aad-c11fa2ea6093",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Chaise basse pour s’asseoir auprès du feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490bdbbb-aef2-476d-8c8d-11766eae3833",
                                                "sense_id": "5808b6e4-8b15-3645-9aad-c11fa2ea6093",
                                                "text": "On voyait, envoyés sans doute par Valérie, un bon fauteuil-ganache à côté d’une chauffeuse, et une jolie commode en bois de rose avec sa glace bien encadrée en style Pompadour."
                                            },
                                            {
                                                "example_id": "627dc79e-fba1-467a-8a0f-aa8bcf085e2c",
                                                "sense_id": "5808b6e4-8b15-3645-9aad-c11fa2ea6093",
                                                "text": "Elle s’assit de nouveau dans le fauteuil ; lui, se mit à cheval sur une chauffeuse et tisonna le feu."
                                            },
                                            {
                                                "example_id": "07cfac5f-ce8d-45f0-a12c-ee56d7cee007",
                                                "sense_id": "5808b6e4-8b15-3645-9aad-c11fa2ea6093",
                                                "text": "Il enfila un peignoir, descendit dans le living-room et s’affala dans la chauffeuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19805809-4fa2-3e58-baca-9fba555686d3",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Celle qui conduit un véhicule motorisé."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3af0511e-6b96-458e-8629-3b7ef050909d",
                                                "sense_id": "19805809-4fa2-3e58-baca-9fba555686d3",
                                                "text": "Pour ces déplacements, l’amitié a rendu de fiers services », assure Françoise Hallais, qui était souvent la chauffeuse de ces expéditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b31b401-81c8-30d2-bb3e-eeb00b1b474e",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Celle qui conduit un véhicule motorisé à des fins professionnelles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e68d020-e389-48ff-9821-34678293e3ce",
                                                "sense_id": "5b31b401-81c8-30d2-bb3e-eeb00b1b474e",
                                                "text": "A 70 ans, cette ancienne chroniqueuse d’Interview Magazine (époque Warhol), ancienne chauffeuse de taxi new-yorkais, lesbienne la plus fabulous de la Grosse Pomme, dont les photos ont orné la chronique mondaine de magazines chic des années durant («I love parties !»), glandeuse professionnelle aimant essentiellement lire des milliers de bouquins et financer son train de vie avec des apparitions publiques où elle mitraille l’auditoire de punchlines râleuses, Fran, donc, a l’art de rebondir sur les mots et torpiller les tics contemporains."
                                            },
                                            {
                                                "example_id": "a34b53a6-16d0-47aa-ac46-46c768fb7bae",
                                                "sense_id": "5b31b401-81c8-30d2-bb3e-eeb00b1b474e",
                                                "text": "En milieu rural, les jeunes doivent composer le plus souvent avec les cars scolaires. Qu'ils ou elles soient scolarisés dans le public ou dans le privé, ils y passent des heures nombreuses et répétées, entre pairs, sous un regard adulte limité (celui du chauffeur ou de la chauffeuse de car)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4241570f-0d89-3d63-856c-fb2ce67e9a47",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Chauffeuse de maitre : une chauffeuse professionnelle privée."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b70a24c-c690-3df7-b524-514d6adf4a2a",
                                        "entry_id": "608a55db-816f-341d-9848-4e579ab747f4",
                                        "glosses": [
                                            "Femme considérée comme allumeuse, aguicheuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edc1075c-74b4-4a48-be76-dbcedaf0b008",
                        "source_entry_id": "453f9138-0984-32f3-ba48-e26ef3a73b14",
                        "source_sense_id": "e498409f-e95e-3c11-a5f3-1665bee56a63",
                        "target_lang_word": "chauffeure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauffeure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1009a50-7569-3bf7-9731-f8146d126d85",
                                        "entry_id": "db5c2a62-5437-358f-a802-901133745bb9",
                                        "glosses": [
                                            "Celle qui conduit un véhicule motorisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710b62bc-ec2e-44ef-9a04-00cb6edd8ba7",
                                                "sense_id": "f1009a50-7569-3bf7-9731-f8146d126d85",
                                                "text": "Avant d’entendre leurs récits, on se dit que oui. Mais on est vite face à d’autres impressions quand on écoute les principales concernées. « Il y a beaucoup de clichés qui restent présents dans la tête des gens… », s’amuse Nadia, 33 ans, chauffeure de bus à la Stib depuis trois ans et demi. « En ce qui me concerne – et c’est le cas de la plupart de mes collègues – je ne rencontre aucun problème lié au fait que je sois une femme. Ni avec mes collègues masculins, ni avec les usagers. Les gens se montrent plus attentifs, courtois et patients quand ils ont une femme conductrice face à eux. »"
                                            },
                                            {
                                                "example_id": "14ff1258-fe9b-461d-a0ca-6979d2b1968d",
                                                "sense_id": "f1009a50-7569-3bf7-9731-f8146d126d85",
                                                "text": "Un homme a été placé en garde à vue pour « enlèvement, séquestration et violences aggravées » à l’encontre d’une femme chauffeure de taxi, a annoncé lundi le parquet de Blois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df9b2588-d22a-43af-8c41-c91b0a71280a",
                        "source_entry_id": "453f9138-0984-32f3-ba48-e26ef3a73b14",
                        "source_sense_id": "e498409f-e95e-3c11-a5f3-1665bee56a63",
