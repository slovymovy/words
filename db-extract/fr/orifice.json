        "fr-extract.jsonl": [
            {
                "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                "word": "orifice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f2e2986-182a-4ca3-9ae8-f275aa35c9bd",
                        "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                        "tags": [
                            "plural"
                        ],
                        "form": "orifices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                        "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                        "glosses": [
                            "Ouverture qui forme l’entrée de certaines excavations naturelles ou artificielles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a12a46-ab90-4a29-ab7c-59f38fa5af0e",
                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                "text": "Les couches supérieures étant tout-à-fait meubles, il eût fallu un orifice très large à cette excavation pour que les éboulements ne la bouchassent pas en même temps qu'on la creusait."
                            },
                            {
                                "example_id": "40b1e9ec-0c1b-4e56-b509-dde00fb1f120",
                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                            },
                            {
                                "example_id": "5245eb66-28c8-4429-810a-0abb54b1a84f",
                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                "text": "Ce tunnel a son orifice inférieur à Modane, au nord, et l’orifice supérieur à Bardonnèche, au sud."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                        "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                        "glosses": [
                            "Ouverture plus ou moins étroite qui sert d’entrée ou d’issue à certains organes, à certains appareils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17619709-24f5-4112-9158-eb5af7efbb59",
                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                "text": "Les orifices de l’estomac."
                            },
                            {
                                "example_id": "d5be4df7-21f1-480c-ac09-10fa4cb0f4b7",
                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                "text": "L’orifice d’un tuyau."
                            },
                            {
                                "example_id": "0036f5ad-6e7b-4004-94a2-6107b11ce1c3",
                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                "text": "L’orifice d’une cornue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa81e21f-b61a-457e-80a6-3c200e2ca0a5",
                        "source_entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                        "target_lang_word": "Öffnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Öffnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "nicht verschlossener Bereich eines Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c59bf-67e4-4c13-998e-03c629325186",
                                                "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                                "text": "Das Kameragehäuse hat eine Öffnung, vor der die Linse sitzt."
                                            },
                                            {
                                                "example_id": "79021931-d399-41f2-9e8e-07fc718501e0",
                                                "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                                "text": "Wir zwängten uns durch die schmale Öffnung hindurch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "Vorgang, bei dem etwas zuvor Geschlossenes geöffnet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9af46e-7b31-400b-b674-bdb4ca7f9ee0",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "Die Opposition fordert die sofortige Öffnung der Geschäfte."
                                            },
                                            {
                                                "example_id": "74dff74a-a9d2-413f-aeba-743ab264711f",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "In Griechenland erwog man zum Montag die Öffnung der Banken."
                                            },
                                            {
                                                "example_id": "57b66464-2675-488d-9713-a830b2e87c40",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "China soll einer Öffnung seiner Märkte zustimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "Annäherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928ed838-ae5c-430e-a048-41a0aebf56c8",
                                                "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                                "text": "Russlands Öffnung nach Westen kam nicht unerwartet."
                                            },
                                            {
                                                "example_id": "41001c9d-51ea-4b8a-8a27-5c44c16a37d3",
                                                "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                                "text": "„Das Meer war Karthagos Element und die Flotte seine Lebensader. Der maritime Charakter der Stadt hatte ihre Öffnung nach allen Seiten hin begünstigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f4851d4-0a20-431d-9e9e-e553c56867f6",
                        "source_entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
