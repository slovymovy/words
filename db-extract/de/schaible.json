                ],
                "senses": [
                    {
                        "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                        "entry_id": "f74239cd-8898-3954-a399-18f2f5cbfe55",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9def5f11-3ec9-458d-ac54-ef0e0fb58080",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Frau Schaible ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1c1e7145-cf9c-4c01-a4ed-b53e3e7a19bc",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Herr Schaible wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "50802886-9e25-4018-8c58-6490bca8e98e",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Die Schaibles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "67fa8b00-6a08-4617-89d1-bdd34c870f0f",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Der Schaible trägt nie die Pullover, die die Schaible ihm strickt."
                            },
                            {
                                "example_id": "cfc6c60f-ef29-486f-90db-0ea6131dbea9",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaible kommt, geht der Herr Schaible.“"
                            },
                            {
                                "example_id": "161d1b8b-6f10-4d53-8d69-64bf11bff3bb",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Schaible kommt und geht."
                            },
                            {
                                "example_id": "6fce4e42-28bb-4313-91a6-567c8127836d",
                                "sense_id": "3bec6b05-70c3-35ab-b68b-331ca5c16a05",
                                "text": "Schaibles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
