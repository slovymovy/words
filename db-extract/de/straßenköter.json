                "senses": [
                    {
                        "sense_id": "9603e8e4-2e6c-3a6d-928e-622f1f06be50",
                        "entry_id": "094860c8-8b3b-39b1-accc-d70e020153fc",
                        "glosses": [
                            "unbeaufsichtigt herumstreunender Hund"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d51c730e-47bf-4b00-b39b-54f7bca17f62",
                                "sense_id": "9603e8e4-2e6c-3a6d-928e-622f1f06be50",
                                "text": "„Ich nahm dementsprechend unseren Straßenköter mit – zusammen mit einem halben Sovereign für den alten Tierhändler in Pinchin Lane, und marschierte los.“"
                            },
                            {
                                "example_id": "5c32cb4b-ab02-4990-9427-6024e01ccc2b",
                                "sense_id": "9603e8e4-2e6c-3a6d-928e-622f1f06be50",
                                "text": "„Wie ein Straßenköter ohne Rasse vermischt er sich wahllos.“"
                            },
                            {
                                "example_id": "89727a2e-97c5-4380-9773-fcefc1cd42d7",
                                "sense_id": "9603e8e4-2e6c-3a6d-928e-622f1f06be50",
                                "text": "„An der rechten Wange hatte er eine Narbe, die bis zum Auge hinaufreichte, und sein ganzer Körper war so drahtig und gespannt wie der eines Straßenköters.“"
                            },
                            {
                                "example_id": "c778c700-1fc0-4ef8-b35f-3c47995274c0",
                                "sense_id": "9603e8e4-2e6c-3a6d-928e-622f1f06be50",
                                "text": "„Dass diese heiße Zeit als ›Hundstage‹ bezeichnet wurde (und wird), hat jedoch nichts mit den armen Straßenkötern zu tun, wie manchmal behauptet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
