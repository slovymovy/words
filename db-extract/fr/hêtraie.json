                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cb2d96-10bd-41d4-ae2b-b4b6a2794ad0",
                                                "sense_id": "9609d219-add2-3888-9142-bb584d9d98b5",
                                                "text": "Staatsbosbeheer deed in augustus van dit jaar aangifte van vernieling en diefstal van tondelzwammen uit een beukenbos in Renkum."
                                            },
                                            {
                                                "example_id": "748b9eb0-056f-4dec-9bd0-ca560bea6158",
                                                "sense_id": "9609d219-add2-3888-9142-bb584d9d98b5",
                                                "text": "De stinzenflora, die natuurlijk bij zo'n geurig beukenbos hoort, is nu al knapperig groen. Ook de meidoorn en de hulst hebben deze herfst een rijke dracht aan bessen."
                                            }
                                        ]
