{
    "word_family": [
        "assign",
        "assignment",
        "reassignment",
        "assignable",
        "assignee",
        "assignor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29403439-4e1e-30c7-89c9-a96c00798803",
                    "sense_definition": "To assign again or anew, often to a different position, task, or location.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>reassign</w> the staff to different departments to improve efficiency.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>перевести</w> персонал в другие отделы для повышения эффективности."
                            }
                        },
                        {
                            "text": "The offending employees were <w>reassigned</w> after the incident to avoid further conflict.",
                            "target_lang_translations": {
                                "ru": "Провинившиеся сотрудники были <w>переведены</w> после инцидента, чтобы избежать дальнейших конфликтов."
                            }
                        }
                    ],
                    "synonyms": [
                        "reallocate",
                        "transfer",
                        "redeploy"
                    ],
                    "common_phrases": [
                        "reassign the staff",
                        "reassign a task",
                        "reassign to a role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначить заново или по-новому, часто на другую должность, задачу или место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перераспределить",
                                "target_lang_sense_clarification": "задачи или ресурсы"
                            },
                            {
                                "target_lang_word": "перевести",
                                "target_lang_sense_clarification": "сотрудника на другую должность или место"
                            },
                            {
                                "target_lang_word": "переназначить",
                                "target_lang_sense_clarification": "встречу или роль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64dbc65a-28b8-3680-be34-bc2382b80f46",
                    "sense_definition": "To transfer back something that was previously assigned to someone or something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court had to <w>reassign</w> the property rights to the original owner after the appeal.",
                            "target_lang_translations": {
                                "ru": "Суду пришлось <w>передать повторно</w> права собственности первоначальному владельцу после апелляции."
                            }
                        },
                        {
                            "text": "After the project failed, the company chose to <w>reassign</w> the budget to its primary division.",
                            "target_lang_translations": {
                                "ru": "После провала проекта компания решила <w>перераспределить</w> бюджет в пользу своего основного подразделения."
                            }
                        }
                    ],
                    "synonyms": [
                        "return",
                        "revert"
                    ],
                    "common_phrases": [
                        "reassign the rights",
                        "reassign the budget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать обратно то, что ранее было закреплено за кем-то или чем-то другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передать повторно",
                                "target_lang_sense_clarification": "права или активы"
                            },
                            {
                                "target_lang_word": "перераспределить",
                                "target_lang_sense_clarification": "бюджет или средства"
                            },
                            {
                                "target_lang_word": "вернуть",
                                "target_lang_sense_clarification": "в контексте возврата прав собственности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}