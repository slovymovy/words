    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d686754-5def-33ea-be3c-988bff97e456",
                    "sense_definition": "Het aanvoeren van goederen, stoffen of middelen naar een bepaalde plaats.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "supply_provision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>toevoer</w> van vers water werd direct hersteld.",
                            "target_lang_translations": {
                                "en": "The <w>supply</w> of fresh water was restored immediately."
                            }
                        },
                        {
                            "text": "Door een storing stopte de <w>toevoer</w> van elektriciteit naar de fabriek.",
                            "target_lang_translations": {
                                "en": "Due to a fault, the <w>supply</w> of electricity to the factory stopped."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvoer",
                        "levering",
                        "leverantie"
                    ],
                    "common_phrases": [
                        "toevoer van water",
                        "de toevoer stopzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "The supply or bringing in of goods, substances, or resources to a certain place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "supply",
                                "target_lang_sense_clarification": "of goods, water, electricity"
                            },
                            {
                                "target_lang_word": "inflow",
                                "target_lang_sense_clarification": "movement of resources or substances"
                            },
                            {
                                "target_lang_word": "intake",
                                "target_lang_sense_clarification": "act of taking in resources"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f6fb8d-6c8e-301e-b8da-8fb74e8b8091",
                    "sense_definition": "Het pad, de leiding of het kanaal waarlangs iets een bepaalde plek bereikt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supply_channel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daarmee raakte de <w>toevoer</w> van koelwater geblokkeerd.",
                            "target_lang_translations": {
                                "en": "As a result, the cooling water <w>inlet</w> became blocked."
                            }
                        },
                        {
                            "text": "Monteurs controleerden de <w>toevoer</w> van de gasleiding op lekkages.",
                            "target_lang_translations": {
                                "en": "Mechanics checked the gas pipe <w>feed</w> for leaks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de toevoer blokkeren"
                    ],
                    "target_lang_definitions": {
