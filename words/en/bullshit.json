                            },
                            {
                                "target_lang_word": "牛屎",
                                "target_lang_sense_clarification": "较口语、较粗俗的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cca9363f-29eb-3935-9f84-e5cc878cf0f0",
                    "sense_definition": "A card game in which players try to discard their hands first, following rules that encourage bluffing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "We stayed up late drinking beer and playing a game of <w>bullshit</w>.",
                            "target_lang_translations": {
                                "ru": "Мы засиделись допоздна, пили пиво и играли в <w>верю-не-верю</w>.",
                                "zh": "我们喝着啤酒打<w>吹牛</w>牌，一直玩到很晚。"
                            }
                        },
                        {
                            "text": "Do you know the rules for <w>bullshit</w>, or should I explain them?",
                            "target_lang_translations": {
                                "ru": "Ты знаешь правила игры в <w>верю-не-верю</w>, или мне объяснить их?",
                                "zh": "你知道<w>吹牛</w>这游戏的规则吗，还是要我给你讲讲？"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheat",
                        "I doubt it"
                    ],
                    "common_phrases": [
