                                        "sense_id": "cd609572-7f3f-3851-a8f8-89b063896be1",
                                        "entry_id": "47bb3aca-17fd-3a11-900f-3ebfb49e2379",
                                        "glosses": [
                                            "Donner une meilleure forme à un ouvrage de l’esprit, une loi, etc., qui contient de bonnes choses, mais qui a tout de même besoin de travail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab50b32-d951-4ccc-b1d8-c6f3e4d118ba",
                                                "sense_id": "cd609572-7f3f-3851-a8f8-89b063896be1",
                                                "text": "Il faut refondre, refondre entièrement ce discours, cet ouvrage."
                                            },
                                            {
                                                "example_id": "348a9a74-a08a-4aeb-8235-7efed02e561f",
                                                "sense_id": "cd609572-7f3f-3851-a8f8-89b063896be1",
                                                "text": "Il a entièrement refondu son poème."
                                            },
