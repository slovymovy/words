                "senses": [
                    {
                        "sense_id": "cd78e994-64c4-3abe-b1f0-1b18b36f3862",
                        "entry_id": "01383a47-7840-3fd6-b42a-8d69f5904646",
                        "glosses": [
                            "Beiname des Königs in Preußen Friedrich Wilhelm I."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a985e4-fa68-4878-933f-f0757744643b",
                                "sense_id": "cd78e994-64c4-3abe-b1f0-1b18b36f3862",
                                "text": "„Dieser Neubau war das Haus, das jetzt noch stand. Es hatte denselben nüchternen Charakter wie fast alles, was unter dem Soldatenkönig entstand, und war nichts weiter als ein einfaches Corps de logis, dessen zwei vorspringende, bis dicht an den Graben reichende Seitenflügel ein Hufeisen und innerhalb desselben einen kahlen Vorhof bildeten, auf dem, als einziges Schmuckstück, eine große blanke Glaskugel sich präsentierte.“"
                            },
                            {
                                "example_id": "dab61b3c-de0d-4ce4-993e-d2a16d4c20da",
                                "sense_id": "cd78e994-64c4-3abe-b1f0-1b18b36f3862",
                                "text": "„Schon unter Peter dem Großen und dem preußischen Soldatenkönig intensivierten sich die dynamischen Beziehungen der Romanows und der Hohenzollern, die sich später auch noch familiär verflochten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
