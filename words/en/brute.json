{
    "word_family": [
        "brutal",
        "brutality",
        "brutalize",
        "brutish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba1c9728-53c3-341f-8830-ac58121e5b55",
                    "sense_definition": "Relating to raw, unrefined physical power or force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy door was opened only through <w>brute</w> force.",
                            "target_lang_translations": {
                                "ru": "Тяжёлую дверь удалось открыть только с помощью <w>грубой</w> силы."
                            }
                        },
                        {
                            "text": "He relied on <w>brute</w> strength to lift the heavy stone.",
                            "target_lang_translations": {
                                "ru": "Чтобы поднять тяжёлый камень, он полагался на <w>грубую</w> физическую силу."
                            }
                        }
                    ],
                    "synonyms": [
                        "physical",
                        "raw"
                    ],
                    "common_phrases": [
                        "brute force",
                        "brute strength"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с грубой, необработанной физической силой или мощью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о силе, основанной на чистом физическом воздействии, без тонкости или техники"
                            },
                            {
                                "target_lang_word": "грубая сила",
                                "target_lang_sense_clarification": "в сочетаниях типа brute force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b53c8622-6e8f-3baf-b7e9-2f589fb84a72",
                    "sense_definition": "Cruel, violent, or lacking in human compassion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cruelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was known for his <w>brute</w> violence against the people.",
                            "target_lang_translations": {
                                "ru": "Диктатор был известен своим <w>жестоким</w> насилием по отношению к народу."
                            }
                        },
                        {
                            "text": "He showed a <w>brute</w> disregard for the feelings of others.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>грубое</w> пренебрежение к чувствам других."
                            }
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "savage",
                        "ferocious"
                    ],
                    "antonyms": [
                        "gentle",
                        "kind"
                    ],
                    "common_phrases": [
                        "brute violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестокий, агрессивный или лишённый человеческого сострадания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "жестокий, насильственный, бесчеловечный"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "грубый и лишённый сострадания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b98b5183-e9a7-3448-965a-4ff4064c30b5",
                    "sense_definition": "Lacking human intelligence or reasoning ability.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lacking_reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>brute</w> beast acted only on its basic instincts.",
                            "target_lang_translations": {
                                "ru": "Это <w>неразумное</w> животное действовало лишь на основе своих примитивных инстинктов."
                            }
                        },
                        {
                            "text": "Nature is often described as a <w>brute</w> force without moral judgment.",
                            "target_lang_translations": {
                                "ru": "Природу часто описывают как <w>слепую</w> силу, лишённую моральной оценки."
                            }
                        }
                    ],
                    "synonyms": [
                        "unreasoning",
                        "senseless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый человеческого разума или способности мыслить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "лишённый разума или способности рассуждать"
                            },
                            {
                                "target_lang_word": "неразумный",
                                "target_lang_sense_clarification": "не руководствующийся разумом"
                            },
                            {
                                "target_lang_word": "слепой",
                                "target_lang_sense_clarification": "о силе природы: слепой, без сознательного суждения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87a76929-5966-3055-99e8-5c5889e40265",
                    "sense_definition": "A person who is cruel, violent, or behaves like an unthinking animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cruelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was a hulking <w>brute</w> who enjoyed hurting others.",
                            "target_lang_translations": {
                                "ru": "Этот человек был здоровенным <w>скотом</w>, которому нравилось причинять другим боль."
                            }
                        },
                        {
                            "text": "Do not act like such a <w>brute</w> when you are angry.",
                            "target_lang_translations": {
                                "ru": "Не веди себя как такой <w>скот</w>, когда злишься."
                            }
                        }
                    ],
                    "synonyms": [
                        "bully",
                        "savage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который жесток, склонен к насилию или ведёт себя как бездумное животное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скотина",
                                "target_lang_sense_clarification": "жестокий, грубый человек; бранное слово"
                            },
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "человек, ведущий себя как зверь"
                            },
                            {
                                "target_lang_word": "скот",
                                "target_lang_sense_clarification": "очень грубый и жестокий человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22d30400-ee0d-3dda-9bd1-9ef8bcd654d6",
                    "sense_definition": "An animal, especially one considered to lack human intelligence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lacking_reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient philosopher argued that humans are distinct from mere <w>brutes</w>.",
                            "target_lang_translations": {
                                "ru": "Древний философ утверждал, что люди отличаются от простых <w>животных</w>."
                            }
                        },
                        {
                            "text": "He treated the <w>brutes</w> in the field with little care.",
                            "target_lang_translations": {
                                "ru": "Он почти не заботился о <w>животных</w> в поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "beast",
                        "animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Животное, особенно рассматриваемое как существо, лишённое человеческого разума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "животное",
                                "target_lang_sense_clarification": "животное, противопоставляемое человеку как разумному существу"
                            },
                            {
                                "target_lang_word": "тварь",
                                "target_lang_sense_clarification": "книжное или слегка устаревшее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "682e298e-bc9b-38f4-a903-7a7e17fd5989",
                    "sense_definition": "A very powerful type of spotlight used in film production.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighting crew set up two <w>brutes</w> to illuminate the large stage.",
                            "target_lang_translations": {
                                "ru": "Осветители установили два <w>мощных прожектора</w>, чтобы осветить большую сцену."
                            }
                        },
                        {
                            "text": "They needed several <w>brutes</w> to get the right lighting for the night scene.",
                            "target_lang_translations": {
                                "ru": "Им понадобилось несколько <w>мощных прожекторов</w>, чтобы добиться нужного освещения для ночной сцены."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень мощный прожектор, используемый в кинопроизводстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощный прожектор",
                                "target_lang_sense_clarification": "в кинопроизводстве: очень мощный осветительный прибор"
                            },
                            {
                                "target_lang_word": "брут",
                                "target_lang_sense_clarification": "технический термин в съёмочном освещении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc1c4d1c-8aea-3b51-8d56-3b38a3d84c3e",
                    "sense_definition": "To shape a diamond by grinding it against another diamond.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman began to <w>brute</w> the rough stone into a round shape.",
                            "target_lang_translations": {
                                "ru": "Мастер начал <w>обдирку</w> необработанного камня, придавая ему круглую форму."
                            }
                        },
                        {
                            "text": "It takes great skill to <w>brute</w> diamonds without damaging them.",
                            "target_lang_translations": {
                                "ru": "Чтобы <w>обдирать</w> алмазы, не повреждая их, требуется большое мастерство."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать алмазу форму, шлифуя или обтачивая его о другой алмаз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "в ювелирном деле: обрабатывать алмаз трением о другой алмаз"
                            },
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "технический термин для придания формы алмазу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}