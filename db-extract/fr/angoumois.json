                "senses": [
                    {
                        "sense_id": "8460a43d-1eae-31e4-8272-ecb12aa600d8",
                        "entry_id": "1d1bc10f-b292-3b36-88d8-da8e4b6a4d99",
                        "glosses": [
                            "Ancienne province française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0b227a-e606-4cce-a4e6-c76c2e086b5f",
                                "sense_id": "8460a43d-1eae-31e4-8272-ecb12aa600d8",
                                "text": "Il est donc revenu sur l’eau, notre ami Lucien, dit Nathan, qui se joignit au groupe, je le croyais retourné dans l’Angoumois pour le reste de ses jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d44dd7e-0e5b-369f-9cf7-946c632830fe",
                        "entry_id": "1d1bc10f-b292-3b36-88d8-da8e4b6a4d99",
                        "glosses": [
                            "Région d’Angoulême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656d6882-b760-418d-b29d-6fb53964a4d6",
                                "sense_id": "9d44dd7e-0e5b-369f-9cf7-946c632830fe",
                                "text": "Au bord de la Charente, Saint-Simon a gardé en mémoire son passé de village gabarier. Au sud, des collines lourdes aux terres blanches couvertes de vastes champs, de bosquets et des premiers vignobles forment les côtes de l’Angoumois."
                            }
                        ]
                    }
