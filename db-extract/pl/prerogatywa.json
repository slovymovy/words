        "pl-extract.jsonl": [
            {
                "entry_id": "5811d583-6e6f-3e30-914e-ca276a56002f",
                "word": "prerogatywa",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a8b05c1f-4bb0-3756-a882-dd4ad541262c",
                        "entry_id": "5811d583-6e6f-3e30-914e-ca276a56002f",
                        "glosses": [
                            "szczególne uprawnienie wynikające z piastowanego stanowiska"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b490c486-40ac-4397-8491-31c16065fc24",
                        "source_entry_id": "5811d583-6e6f-3e30-914e-ca276a56002f",
                        "source_sense_id": "a8b05c1f-4bb0-3756-a882-dd4ad541262c",
                        "target_lang_word": "prerogative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prerogative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6993f311-4975-34e8-8f0a-115e9dc12618",
                                        "entry_id": "ccf5c346-969a-3504-b8ea-a333302fa587",
                                        "glosses": [
                                            "An exclusive hereditary or official right or privilege."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aa1302b-7e1a-3e5e-ad86-7765335ddce7",
                                        "entry_id": "ccf5c346-969a-3504-b8ea-a333302fa587",
                                        "glosses": [
                                            "A right, or power that is exclusive to a monarch etc, especially such a power to make a decision or judgement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec0354f9-96c0-4223-a494-e86fc6d7666f",
                                                "sense_id": "9aa1302b-7e1a-3e5e-ad86-7765335ddce7",
                                                "text": "Despite being a constitutional monarchy, the British sovereign still retain many royal prerogatives."
                                            },
                                            {
                                                "example_id": "62b4fe49-7a82-4e40-ad98-4356958d50c0",
                                                "sense_id": "9aa1302b-7e1a-3e5e-ad86-7765335ddce7",
                                                "text": "The military fame of a subject was considered as an insolent invasion of the Imperial prerogative; and it became the duty, as well as interest, of every Roman general, to guard the frontiers intrusted to his care, without aspiring to conquests which might have proved no less fatal to himself than to the vanquished barbarians."
                                            },
                                            {
                                                "example_id": "b1793cfb-9233-4849-b287-3b9549a457db",
                                                "sense_id": "9aa1302b-7e1a-3e5e-ad86-7765335ddce7",
                                                "text": "Lord Avonleigh had decided on taking refuge in wounded dignity, when he was again addressed by the King. \"The castle holds another prisoner, to whom I intend extending the best prerogative of my crown—mercy. Will you order Robert Evelyn to be brought before me?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                        "entry_id": "ccf5c346-969a-3504-b8ea-a333302fa587",
                                        "glosses": [
                                            "A right, especially when due to one's position or role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4366efd-90d9-43bc-a0ba-1fd5d31b03ef",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "I hear my chair in the hall; and to keep Lord Marchmont waiting, when he has announced his intention of supping at home, far exceeds my prerogative; so good night, dearest, you will either see or hear from me to-morrow."
                                            },
                                            {
                                                "example_id": "4e873b64-8093-489d-9451-cc67e78e49da",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "\"Ah, that's your prerogative as an Intelligence officer, Jimmy. But it's been your prerogative for weeks, months, and nothing has happened, as I told you […]\""
                                            },
                                            {
                                                "example_id": "1f3c79ac-5cdf-45f3-9547-61e4f51dcb32",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "If you want to wear your hair a certain way, that's your prerogative. You don't have to check with all your friends to make sure it's okay."
                                            },
                                            {
                                                "example_id": "a28121cf-2367-43ec-9337-4558508c8f77",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "If you choose another approach — that's your prerogative. But the problem is that parents often don't realize they're making the choice […]"
                                            },
                                            {
                                                "example_id": "38e1d35f-616e-431e-a05a-2e789493f032",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "\"I know what is important to Sadiq [Khan, London Mayor], and I know how to explain things to him in a way that maximises our chances of getting the right thing. If he chooses not to take my advice, that is absolutely his prerogative. But he gave me the job, and I intend to pay him back by delivering what he needs.\""
                                            },
                                            {
                                                "example_id": "e581b236-2a2e-484f-ad52-a76d3fff9ade",
                                                "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                                                "text": "The problem is — like with the Harris border czar reference, which is still omitted from the czar article (and will almost certainly stay that way) — the consensus it achieves often lines up with the prerogatives of the Democratic Party and the media establishment that supports it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8b6559-4ca0-3480-9b61-c32efd051040",
                                        "entry_id": "ccf5c346-969a-3504-b8ea-a333302fa587",
                                        "glosses": [
                                            "A property, attribute or ability which gives one a superiority or advantage over others; an inherent advantage or privilege; a talent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prerogative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0169dab9-cd52-3f44-8d2a-b7cfead91962",
                                        "entry_id": "f9812252-8762-3edf-8254-f4b6b435f531",
                                        "glosses": [
                                            "Having a hereditary or official right or privilege."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "063939b9-868b-31fb-9c3c-b69111ac6a0f",
                                        "entry_id": "f9812252-8762-3edf-8254-f4b6b435f531",
                                        "glosses": [
                                            "Characterized by lawless state actions, as in a prerogative state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8a8888-9d60-4798-8039-48babde26009",
                                                "sense_id": "063939b9-868b-31fb-9c3c-b69111ac6a0f",
                                                "text": "Law-eroding prerogative developments cannot only be witnessed in hybrid regimes, but also in democratic states, which resort to reflections and practices of an ‘enemy criminal law’, and in the European Union’s recent crisis politics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02cb2d08-400c-492b-8fa2-6bd15cd8cbef",
                        "source_entry_id": "5811d583-6e6f-3e30-914e-ca276a56002f",
                        "source_sense_id": "a8b05c1f-4bb0-3756-a882-dd4ad541262c",
                        "target_lang_word": "prérogative",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prérogative",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                        "entry_id": "392fe76c-b433-3859-bc00-58d8c20a38fc",
                                        "glosses": [
                                            "Privilège, avantage attaché à une fonction ou à un état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554b710c-fee0-4d4a-86be-be27c2a73c1e",
                                                "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                                "text": "Le gouvernement est si bien exclu de toute participation à l’administration locale, qu’il n’a pas même la prérogative d’en nommer les divers fonctionnaires, […]."
                                            },
                                            {
                                                "example_id": "8d365f9c-09f7-4673-84c7-5e9847ed368a",
                                                "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                                "text": "Maîtresse absolue la haute bureaucratie ne voulait rien céder de ses prérogatives d’autorité. Je tenais, moi, ces prérogatives pour surannées."
                                            },
                                            {
                                                "example_id": "6f4439da-e8b0-4fb9-b730-d626f6ba04d0",
                                                "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                                "text": "Le policier a la prérogative de faire un contrôle d’identité."
                                            },
                                            {
                                                "example_id": "a1263665-485d-4311-8363-c4caf28f2de1",
                                                "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                                "text": "La raison et la parole sont les prérogatives de l’être humain."
                                            },
                                            {
                                                "example_id": "48da49aa-5c5b-455f-9971-ef619c29b519",
                                                "sense_id": "7b34c0c0-47f7-3174-ae8d-8d158f29b634",
                                                "text": "Savinet. — Ce sont là nos prérogatives, à nous autres, maris offensés ! Il faut bien que nous en ayons quelques-unes ! L’amant a le devoir de se laisser tuer, s’il tient à montrer qu’il sait vivre !… C’est ce qui me permet de vous dire, sans être fort aux armes, que je vous tuerai !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dfe984-038c-336c-a39f-f3d2ec8183f6",
                                        "entry_id": "392fe76c-b433-3859-bc00-58d8c20a38fc",
                                        "glosses": [
                                            "Pouvoir lié, de façon exclusive, à certaines fonctions ou à certaines dignités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c667a95-84bd-4680-9ff6-ca9fd62b1ac8",
                                                "sense_id": "e1dfe984-038c-336c-a39f-f3d2ec8183f6",
                                                "text": "Elles dissocient nettement les missions du maître d’ouvrage de celles du maître d’œuvre en faisant de l’élaboration du programme une prérogative strictement attribuée au premier."
                                            },
                                            {
                                                "example_id": "5ee09412-8555-4b19-b13d-35e7fc856d22",
                                                "sense_id": "e1dfe984-038c-336c-a39f-f3d2ec8183f6",
                                                "text": "… dans un contexte marqué par l’état d’urgence … les prérogatives et compétences de la « troisième force de sécurité » ont été progressivement renforcées."
                                            },
                                            {
                                                "example_id": "3f523515-e417-4725-a69c-1b1e6d273acd",
                                                "sense_id": "e1dfe984-038c-336c-a39f-f3d2ec8183f6",
                                                "text": "Le rôle et les prérogatives d’un maire sont en effet importants, relevant de champs d’action et de compétences multiples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153993f7-d5ee-4d1e-8741-e06b4a11801e",
                        "source_entry_id": "5811d583-6e6f-3e30-914e-ca276a56002f",
                        "source_sense_id": "a8b05c1f-4bb0-3756-a882-dd4ad541262c",
