                        "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                        "entry_id": "c411a5ca-103b-3b15-96e4-35d37adaf347",
                        "glosses": [
                            "To hang."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5028f505-f204-4c2a-b335-7c9f79af030f",
                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                "text": "'Squire Ketch rejoices as much to hear of a new Vox, as an old Sexton does to hear of a new Delight."
                            },
                            {
                                "example_id": "df040962-0ca6-493d-8262-8a305602833b",
                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                "text": "Well! If he has a mind to be Ketch'd, speed him say I."
                            },
                            {
                                "example_id": "d27685d5-f8ae-4819-aa64-e97179deb4a6",
                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                "text": "Ignorant of many of the secrets of ketchcraft."
                            },
                            {
                                "example_id": "f3a4a618-9fc8-4ee2-94a1-59e90d787803",
                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                "text": "1859, MATSELL Vocab. s.v. (Farmer),\nI'll ketch you; I'll hang you."
                            }
                        ]
                    }
                ],
