                            {
                                "target_word": "Citroën",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                        "entry_id": "099e5e9c-6095-3d2b-8858-4b98df3ccbf7",
                                        "glosses": [
                                            "Constructeur français d’automobiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c739cc6-bf12-4ab6-a323-40b19c14fd77",
                                                "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                                "text": "On aurait ainsi sacrifié dix mille morts par an pour ne pas désespérer Billancourt, Renault, Peugeot, Citroën et le CAC 40 ! J’entends bien ces cyniques raisons."
                                            },
                                            {
                                                "example_id": "beb4803c-caca-4fc6-b832-6dba9977ee73",
                                                "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                                "text": "Pour un gars chez qui tout est deuch du bouton de sonnette au pommeau de douche, il n’y a que les morceaux de sucre qui ne sont pas estampillés Citroën."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Citroën",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                        "entry_id": "5de0253a-1793-3a29-90ff-c80c3d8bff87",
                                        "glosses": [
                                            "Automobile vendue sous cette marque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32f8b1-244f-4f61-8e23-4891593f5f86",
                                                "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                                "text": "Les ressorts de la Citroën s'affaissèrent sous le poids d'Antoinette, et elle dut s'y prendre à trois fois avant de démarrer le moteur."
                                            },
                                            {
                                                "example_id": "f426345e-b061-4d78-a327-2fd0ce9372fd",
                                                "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                                "text": "On dirait qu’elle se rend à un rallye automobile, avec sa Citroën traction faux cabriolet dotée d’un moteur 4 cylindres à soupapes en tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
