                        "target_lang_word": "letter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "letter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee8bc91-b39f-3c12-b495-e48b07d2ba52",
                                        "entry_id": "d36127bf-6ab1-3101-be32-20a0c12731ec",
                                        "glosses": [
                                            "A symbol in an alphabet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401d8ed8-7fe5-43c1-ba0b-2b86f453175c",
                                                "sense_id": "2ee8bc91-b39f-3c12-b495-e48b07d2ba52",
                                                "text": "There are twenty-six letters in the English alphabet."
                                            },
                                            {
                                                "example_id": "7958da47-a006-4715-ab59-4b16f6863e81",
                                                "sense_id": "2ee8bc91-b39f-3c12-b495-e48b07d2ba52",
                                                "text": "And a superscription also was written ouer him in letters of Greeke, and Latin, & Hebrew, THIS IS THE KING OF THE IEWES."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                        "entry_id": "d36127bf-6ab1-3101-be32-20a0c12731ec",
                                        "glosses": [
                                            "A written or printed communication, generally longer and more formal than a note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957417e3-3094-4c8a-b65a-63373ace4a13",
                                                "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                                "text": "I wrote a letter to my sister about my life."
                                            },
                                            {
                                                "example_id": "846bdcaf-9045-4043-a51c-852a49917c5f",
                                                "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                                "text": "The style of letters ought to be free, easy, and natural."
                                            },
                                            {
                                                "example_id": "1050b293-961a-45e0-8b88-51a9a45a6302",
                                                "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                                "text": "The magician gave this to the young man and said to him,“ Go at such an hour of the night and stand before a pagan tomb and call the demons, and throw the letter into the air, and immediately they will come to you.” And the young man called the devils and threw the letter into the air, and the prince of darkness came,[…]"
                                            },
                                            {
                                                "example_id": "f18b1764-bea7-4e53-ab38-fef38750b82e",
                                                "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            },
                                            {
                                                "example_id": "5b91ff76-9ec2-4063-9eaa-7c38403fce4f",
                                                "sense_id": "eb7d8def-92d2-3fbe-9348-a517262ebaec",
                                                "text": "An indulgent playmate, Grannie would lay aside the long scratchy-looking letter she was writing (heavily crossed ‘to save notepaper’) and enter into the delightful pastime of ‘a chicken from Mr Whiteley's’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c9e323-8ebc-30de-86ee-ea1f057d8e51",
                                        "entry_id": "d36127bf-6ab1-3101-be32-20a0c12731ec",
                                        "glosses": [
                                            "The literal meaning of something, as distinguished from its intended and remoter meaning (the spirit)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dffdef-4e1c-44b9-8fb5-ccfbb6d2ea45",
                                                "sense_id": "29c9e323-8ebc-30de-86ee-ea1f057d8e51",
                                                "text": "In obedience to humane laws, we muſt obſerve the letter of the Law, where we can without doing violence to the reaſon of the Law and the intention of the Law-giver: but where they croſſe each other, the charity of the Law is to be preferred before its diſcipline, and the reaſon of it before the letter."
                                            },
                                            {
                                                "example_id": "bd624884-9fa7-4112-bb02-58eb574e7064",
                                                "sense_id": "29c9e323-8ebc-30de-86ee-ea1f057d8e51",
                                                "text": "I broke the letter of it to keep the sense."
                                            },
                                            {
                                                "example_id": "aa333089-6c84-48b8-80d9-ca034d4a242e",
                                                "sense_id": "29c9e323-8ebc-30de-86ee-ea1f057d8e51",
                                                "text": "Some MEPs from some countries may have pocketed £2m more than I have by observing the letter but not the spirit of the rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72aac0e-3f8a-37d9-b723-e05f2c153286",
                                        "entry_id": "d36127bf-6ab1-3101-be32-20a0c12731ec",
                                        "glosses": [
                                            "Literature."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a965d5-24b2-4077-b14b-a20bd1e0d6e5",
                                                "sense_id": "f72aac0e-3f8a-37d9-b723-e05f2c153286",
                                                "text": "Benjamin Franklin was multiskilled – a scientist, politician and a man of letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823435cd-4101-34a6-9889-afd4be12e0ad",
                                        "entry_id": "d36127bf-6ab1-3101-be32-20a0c12731ec",
                                        "glosses": [
                                            "A division unit of a piece of law marked by a letter of the alphabet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7029a52-073f-436e-b998-e38e642f552c",
                                                "sense_id": "823435cd-4101-34a6-9889-afd4be12e0ad",
                                                "text": "Letter (b) constitutes an exception to this provision."
                                            }
                                        ]
                                    },
                                    {
