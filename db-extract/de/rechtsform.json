                "senses": [
                    {
                        "sense_id": "45d63417-b7bc-37de-85f6-2e02a6c89915",
                        "entry_id": "e804862e-da33-348c-813e-5cfa5f796b7d",
                        "glosses": [
                            "rechtlich festgelegte Form für die Regelung von Rechtsangelegenheiten; die rechtliche Form, in der ein Unternehmen betrieben wird"
                        ],
                        "tags": [
                            "im engeren Sinne",
                            "die Rechtsform eines Unternehmens"
                        ],
                        "examples": [
                            {
                                "example_id": "8c440557-d6c1-4055-a31d-c33a20a9323e",
                                "sense_id": "45d63417-b7bc-37de-85f6-2e02a6c89915",
                                "text": "In der Grundherrschaft verband sich das Eigentum von Boden und Gütern mit vielfältig kombinierten Herrschaftsrechten gegenüber den Personen, die diese Güter in der Regel unter der Rechtsform der Leihe im Nutzungseigentum bewirtschafteten."
                            },
                            {
                                "example_id": "0b4986d7-3fd2-4f2c-8e86-f31ab5aa32ca",
                                "sense_id": "45d63417-b7bc-37de-85f6-2e02a6c89915",
                                "text": "Wenn man ein Unternehmen gründen möchte, sollte man natürlich über die persönliche Haftung nachdenken, und da kommt die Frage nach der Rechtsform ins Spiel."
                            },
                            {
                                "example_id": "a1dcbb49-4e7d-4db3-887a-159b5dad994b",
                                "sense_id": "45d63417-b7bc-37de-85f6-2e02a6c89915",
                                "text": "„Nach der Wende musste eine neue Rechtsform gefunden werden: eine GmbH.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e8cfaed-8348-471a-a16d-5fb0bbbbeeea",
                        "source_entry_id": "e804862e-da33-348c-813e-5cfa5f796b7d",
                        "source_sense_id": "45d63417-b7bc-37de-85f6-2e02a6c89915",
