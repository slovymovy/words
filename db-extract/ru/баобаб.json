                                "target_senses": [
                                    {
                                        "sense_id": "837d5d1c-70a3-3b42-bdee-9335b721a2e7",
                                        "entry_id": "be023905-8e56-328d-8336-8aff65bdc1e3",
                                        "glosses": [
                                            "rod stromů z čeledi slézovitých"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dbf8cac-a8dd-4361-80a9-39e26114f728",
                                                "sense_id": "837d5d1c-70a3-3b42-bdee-9335b721a2e7",
                                                "text": "Mys tento objevil r. 1443 Portugalec D. Fernandez, jenž podle baobabů (adansonií) pokrývajících zde bílou a červenou půdu, nazval jej Zeleným."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
