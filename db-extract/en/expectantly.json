                    {
                        "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                        "entry_id": "ddf8af82-11e8-3e62-a8d8-8335a195269c",
                        "glosses": [
                            "In an expectant manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe69473a-6afc-4234-a239-4d3e79f0a943",
                                "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                                "text": "The cat looked expectantly at the mouse."
                            },
                            {
                                "example_id": "de66a29a-73e4-44b7-a2df-5b38cc5c0cf3",
                                "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady.[…]She looked around expectantly, and recognizing Mrs. Cooke's maid[…]Miss Thorn greeted her with a smile which greatly prepossessed us in her favor."
                            },
                            {
                                "example_id": "3438bb5c-558c-43db-bc77-7387e1c4851a",
                                "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                                "text": "Professor Challenger was on his feet. His appearance and manner are peculiarly arresting, and as he raised his hand for order the whole audience settled down expectantly to give him a hearing."
                            },
                            {
                                "example_id": "2232473a-f702-424d-9e96-6d4134b68803",
                                "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                                "text": "So he went, uneconomically but expectantly, to the emergency room."
                            },
                            {
                                "example_id": "2368d499-48be-4e69-9b03-bb210926bff3",
                                "sense_id": "2a5964df-2f0a-39b8-8894-32edd5cb34c9",
                                "text": "Larissa felt “pulled” to Rachel, who was standing expectantly on Larissa’s doorstep."
                            }
                        ]
                    }
                ],
