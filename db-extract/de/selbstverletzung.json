                ],
                "senses": [
                    {
                        "sense_id": "8373b07e-6610-3e42-9130-b4ccede6ee07",
                        "entry_id": "d706ea68-7b11-3b2a-bb56-9eda7f6202be",
                        "glosses": [
                            "Verletzung, die dem eigenen Körper zugefügt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863fd4fe-60db-4cbe-961f-9182ac442e59",
                                "sense_id": "8373b07e-6610-3e42-9130-b4ccede6ee07",
                                "text": "„Doch nicht nur in Serien, auch über die sozialen Medien kommen Jugendliche immer häufiger mit problematischen Inhalten rund um Selbstverletzung und Suizid in Berührung.“"
                            },
                            {
                                "example_id": "df41e7ab-d9f3-43f5-8f15-92a577badf1a",
                                "sense_id": "8373b07e-6610-3e42-9130-b4ccede6ee07",
                                "text": "„Am weitesten verbreitet ist die Selbstverletzung bei Menschen mit ernster bis starker geistiger Unterentwicklung und Menschen mit Autismus, aber auch bei Kranken mit Fragile-X-Syndrom und Prader-Willi-Syndrom.“"
                            },
                            {
                                "example_id": "36cb0756-bd29-4bb5-a38c-dc38fe15fc9c",
                                "sense_id": "8373b07e-6610-3e42-9130-b4ccede6ee07",
                                "text": "„Verletzungen, die nicht bewusst herbeigeführt werden, aber indirekt aus dem eigenen Verhalten entstehen, z.B. Selbstverletzung nach Drogenkonsum, zählen nicht explizit zu den Selbstverletzungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
