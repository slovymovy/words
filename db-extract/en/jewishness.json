                                                "sense_id": "9223059e-a6b0-3cfc-abe3-7b0ba091f725",
                                                "text": "Musel v sobě zapřít veškeré své židovství, aby to dokázal udělat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d443cbc4-f60c-3708-9243-ef4e240d5a5d",
                                        "entry_id": "bb632cae-629b-3434-9bdc-0a895cf0945a",
                                        "glosses": [
                                            "náboženství židovského národa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2552e504-6ec3-4c43-a8ce-379955238c49",
                                                "sense_id": "d443cbc4-f60c-3708-9243-ef4e240d5a5d",
                                                "text": "Židovství jest kmen křesťanských ratolestí a větví, jakože bez Starého Zákona byl by nám Nový Zákon ne-li lží, jistě hádankou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14f2d9e3-03fd-4c8b-b8ba-4913a1b04a69",
                        "source_entry_id": "45320753-851f-3560-8c14-65cd7383b484",
