{
    "word_family": [
        "gappy",
        "gaping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a763c87-c1d2-3488-8cd9-5e443bfd1a01",
                    "sense_definition": "An empty space or opening in the middle of something or between two things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child squeezed through a small <w>gap</w> in the wooden fence.",
                            "target_lang_translations": {
                                "ru": "Ребенок протиснулся сквозь узкую <w>щель</w> в деревянном заборе.",
                                "zh": "那个孩子从木栅栏上的一个小<w>缝隙</w>里挤了过去。"
                            }
                        },
                        {
                            "text": "Please mind the <w>gap</w> between the train and the platform.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помните о <w>зазоре</w> между поездом и платформой.",
                                "zh": "请注意列车与站台之间的<w>空隙</w>。"
                            }
                        },
                        {
                            "text": "There is a wide <w>gap</w> between the two buildings.",
                            "target_lang_translations": {
                                "ru": "Между двумя зданиями есть широкий <w>промежуток</w>.",
                                "zh": "两栋楼之间有一大片<w>空当</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opening",
                        "space",
                        "hole",
                        "crack",
                        "break"
                    ],
                    "antonyms": [
                        "closure",
                        "solid"
                    ],
                    "common_phrases": [
                        "mind the gap",
                        "gap in the fence",
                        "gap between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустое пространство или отверстие посреди чего-либо или между двумя объектами.",
                        "zh": "某物中间或两物之间的空处、开口或裂缝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щель",
                                "target_lang_sense_clarification": "узкое отверстие"
                            },
                            {
                                "target_lang_word": "зазор",
                                "target_lang_sense_clarification": "пространство между деталями или объектами"
                            },
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "расстояние между объектами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缝隙",
                                "target_lang_sense_clarification": "狭窄的开口或裂缝"
                            },
                            {
                                "target_lang_word": "空隙",
                                "target_lang_sense_clarification": "两物之间的空间"
                            },
                            {
                                "target_lang_word": "空当",
                                "target_lang_sense_clarification": "较宽的空处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293a6b0f-ab5f-3a2a-9948-0eaab45f5ebc",
                    "sense_definition": "A distinct difference or disparity between two people, groups, or situations.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to close the <w>gap</w> between the rich and the poor.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается сократить <w>разрыв</w> между богатыми и бедными.",
                                "zh": "政府正努力缩小贫富之间的<w>差距</w>。"
                            }
                        },
                        {
                            "text": "There is a significant generation <w>gap</w> regarding the use of technology.",
                            "target_lang_translations": {
                                "ru": "Существует значительный <w>разрыв</w> поколений в использовании технологий.",
                                "zh": "在科技使用方面，存在明显的代际<w>鸿沟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disparity",
                        "difference",
                        "discrepancy",
                        "divide"
                    ],
                    "antonyms": [
                        "similarity",
                        "equality",
                        "parity"
                    ],
                    "common_phrases": [
                        "generation gap",
                        "bridge the gap",
                        "close the gap",
                        "gender pay gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчетливое различие или несоответствие между людьми, группами или ситуациями.",
                        "zh": "人与人、群体与群体或不同情况之间明显的差异或悬殊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "существенная разница или несоответствие"
                            },
                            {
                                "target_lang_word": "пропасть",
                                "target_lang_sense_clarification": "глубокое, непреодолимое различие (перен.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差距",
                                "target_lang_sense_clarification": "两者之间明显的不同或不平等"
                            },
                            {
                                "target_lang_word": "鸿沟",
                                "target_lang_sense_clarification": "较深、较难弥合的分隔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba602b0e-a128-3bb3-88de-3ede8f831087",
                    "sense_definition": "A period of time when something stops, or a missing part in a series or sequence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to take a <w>gap</w> year to travel before starting university.",
                            "target_lang_translations": {
                                "ru": "Она решила взять <w>год перерыва</w> для путешествий перед поступлением в университет.",
                                "zh": "她决定在上大学前休一个<w>间隔</w>年去旅行。"
                            }
                        },
                        {
                            "text": "I have a <w>gap</w> in my schedule next Tuesday afternoon.",
                            "target_lang_translations": {
                                "ru": "У меня есть <w>окно</w> в расписании в следующий вторник днем.",
                                "zh": "下周二下午我的日程里有一段<w>空档</w>。"
                            }
                        },
                        {
                            "text": "The historian tried to fill the <w>gap</w> in the records with local legends.",
                            "target_lang_translations": {
                                "ru": "Историк пытался заполнить <w>пробел</w> в записях местными легендами.",
                                "zh": "那位历史学家试图用当地传说来填补记录中的<w>空白</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "pause",
                        "hiatus",
                        "interim",
                        "interval",
                        "void"
                    ],
                    "antonyms": [
                        "continuity"
                    ],
                    "common_phrases": [
                        "gap year",
                        "stopgap",
                        "gap in knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, когда что-то прекращается, или отсутствующая часть в серии или последовательности.",
                        "zh": "某事暂停的一段时间，或系列、顺序中缺失的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "пауза во времени"
                            },
                            {
                                "target_lang_word": "пробел",
                                "target_lang_sense_clarification": "отсутствующая часть информации или записи"
                            },
                            {
                                "target_lang_word": "окно",
                                "target_lang_sense_clarification": "свободное время в расписании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间隔",
                                "target_lang_sense_clarification": "时间上的停顿或中断"
                            },
                            {
                                "target_lang_word": "空档",
                                "target_lang_sense_clarification": "时间表中的空闲时段"
                            },
                            {
                                "target_lang_word": "空白",
                                "target_lang_sense_clarification": "序列、记录或知识中缺失的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67ab4fa6-038b-33dc-b723-14cecb70e138",
                    "sense_definition": "A lack, deficit, or failure to meet a requirement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their sudden departure has left a serious <w>gap</w> in the workforce.",
                            "target_lang_translations": {
                                "ru": "Их внезапный уход оставил серьезную <w>брешь</w> в рабочей силе.",
                                "zh": "他们突然离开后，劳动力方面出现了严重的<w>缺口</w>。"
                            }
                        },
                        {
                            "text": "We need to identify the <w>gap</w> in the market and create a product for it.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить свободную <w>нишу</w> на рынке и создать для нее продукт.",
                                "zh": "我们需要找出市场上的<w>空白</w>，并为此开发一款产品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lack",
                        "deficit",
                        "shortfall",
                        "deficiency"
                    ],
                    "antonyms": [
                        "surplus",
                        "abundance"
                    ],
                    "common_phrases": [
                        "gap in the market",
                        "skills gap",
                        "fill the gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нехватка, дефицит или несоответствие требованиям.",
                        "zh": "缺乏、短缺，或未达到某种要求的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брешь",
                                "target_lang_sense_clarification": "уязвимое место, нехватка (в бюджете, обороне)"
                            },
                            {
                                "target_lang_word": "ниша",
                                "target_lang_sense_clarification": "свободное место на рынке"
                            },
                            {
                                "target_lang_word": "пробел",
                                "target_lang_sense_clarification": "недостаток навыков или знаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺口",
                                "target_lang_sense_clarification": "人数、资源、需求等方面的不足"
                            },
                            {
                                "target_lang_word": "空白",
                                "target_lang_sense_clarification": "市场上尚未被满足的部分"
                            },
                            {
                                "target_lang_word": "不足",
                                "target_lang_sense_clarification": "知识、技能等方面的不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be41c2bd-b1ef-3f9e-94a6-85c54f02163d",
                    "sense_definition": "A low pass or opening through a mountain range.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers found a narrow <w>gap</w> in the mountains that led to the valley.",
                            "target_lang_translations": {
                                "ru": "Исследователи нашли узкий <w>проход</w> в горах, ведущий в долину.",
                                "zh": "探险者们在群山中发现了一条通往山谷的狭窄<w>山口</w>。"
                            }
                        },
                        {
                            "text": "Wind rushed through the <w>gap</w> with tremendous force.",
                            "target_lang_translations": {
                                "ru": "Ветер с огромной силой мчался сквозь <w>ущелье</w>.",
                                "zh": "狂风以巨大的力量穿过那个<w>山口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "col",
                        "saddle"
                    ],
                    "common_phrases": [
                        "mountain gap",
                        "Cumberland Gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий проход или отверстие в горном хребте.",
                        "zh": "山脉中的低处通道或开口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевал",
                                "target_lang_sense_clarification": "место перехода через горный хребет"
                            },
                            {
                                "target_lang_word": "ущелье",
                                "target_lang_sense_clarification": "узкая горная долина"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "путь через препятствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山口",
                                "target_lang_sense_clarification": "山脉中较低、可通行的地方"
                            },
                            {
                                "target_lang_word": "通道",
                                "target_lang_sense_clarification": "穿过障碍物的通道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97016ae8-6e1c-3d0f-894b-47502ff1cf78",
                    "sense_definition": "The vagina.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian made a crude joke referencing her <w>gap</w>.",
                            "target_lang_translations": {
                                "ru": "Комик отпустил грубую шутку о ее <w>щели</w>.",
                                "zh": "那个喜剧演员开了个粗俗的玩笑，拿她的<w>阴道</w>说事。"
                            }
                        },
                        {
                            "text": "He used a vulgar slang term to describe her <w>gap</w>.",
                            "target_lang_translations": {
                                "ru": "Он использовал вульгарный сленговый термин для описания ее <w>щели</w>.",
                                "zh": "他用了一个下流的俚语来形容她的<w>阴道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vagina",
                        "slit",
                        "snatch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Влагалище (вульгарный сленг).",
                        "zh": "阴道；属粗俗俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щель",
                                "target_lang_sense_clarification": "вульгарное сленговое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴道",
                                "target_lang_sense_clarification": "粗俗俚语中指女性阴道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d68d6e2-2b1a-3d27-9209-93e8e31da93f",
                    "sense_definition": "To surpass or defeat an opponent by a considerable margin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional racer <w>gapped</w> the other cars on the final lap.",
                            "target_lang_translations": {
                                "ru": "Профессиональный гонщик <w>оторвался</w> от других машин на последнем круге.",
                                "zh": "那位职业赛车手在最后一圈把其他车远远<w>甩开</w>了。"
                            }
                        },
                        {
                            "text": "Our team got absolutely <w>gapped</w> in the tournament yesterday.",
                            "target_lang_translations": {
                                "ru": "Нашу команду вчера полностью <w>обошли</w> на турнире.",
                                "zh": "昨天比赛里，我们队被对手彻底<w>甩开</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outperform",
                        "beat",
                        "outstrip"
                    ],
                    "common_phrases": [
                        "get gapped"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming and racing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительно превзойти или победить соперника.",
                        "zh": "以相当大的优势超过或击败对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оторваться",
                                "target_lang_sense_clarification": "уйти далеко вперед от соперника"
                            },
                            {
                                "target_lang_word": "обойти",
                                "target_lang_sense_clarification": "превзойти по уровню или скорости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩开",
                                "target_lang_sense_clarification": "在比赛中把对手远远甩在后面"
                            },
                            {
                                "target_lang_word": "拉开差距",
                                "target_lang_sense_clarification": "明显领先对手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acd422ee-2c45-3025-b33b-df5bd2f61689",
                    "sense_definition": "To set or check the width of a specific opening, such as on a spark plug.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>gap</w> the spark plugs correctly for the engine to run smoothly.",
                            "target_lang_translations": {
                                "ru": "Вам нужно правильно <w>выставить зазор</w> на свечах зажигания для плавной работы двигателя.",
                                "zh": "你需要正确<w>调整间隙</w>火花塞，发动机才能运转平稳。"
                            }
                        },
                        {
                            "text": "He <w>gapped</w> the components according to the manual.",
                            "target_lang_translations": {
                                "ru": "Он <w>выставил зазор</w> между компонентами согласно инструкции.",
                                "zh": "他按照说明书给这些部件<w>调整了间隙</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gap the plugs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать или проверять ширину определенного отверстия, например, на свече зажигания.",
                        "zh": "设定或检查某个特定开口的宽度，如火花塞的间隙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставить зазор",
                                "target_lang_sense_clarification": "отрегулировать расстояние между контактами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调整间隙",
                                "target_lang_sense_clarification": "调到规定的间距"
                            },
                            {
                                "target_lang_word": "设定间隙",
                                "target_lang_sense_clarification": "技术语境中设定开口宽度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2ecf0a21-7467-3e98-b31b-1c03ab7993bc",
                    "sense_definition": "A town in southeastern France, the capital of the Hautes-Alpes department.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We stopped in <w>Gap</w> for lunch while driving through the Alps.",
                            "target_lang_translations": {
                                "ru": "Мы остановились в <w>Гапе</w> на обед, проезжая через Альпы.",
                                "zh": "我们开车穿过阿尔卑斯山时，在<w>加普</w>停下来吃了午饭。"
                            }
                        },
                        {
                            "text": "The Tour de France route often passes through the town of <w>Gap</w>.",
                            "target_lang_translations": {
                                "ru": "Маршрут Тур де Франс часто проходит через город <w>Гап</w>.",
                                "zh": "环法自行车赛的路线经常经过<w>加普</w>镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город на юго-востоке Франции, столица департамента Верхние Альпы.",
                        "zh": "加普，法国东南部的一座城市，是上阿尔卑斯省的省会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гап",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加普",
                                "target_lang_sense_clarification": "法国东南部城市名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1f39d4c-50a9-3b4c-8f04-3b31c8b2696e",
                    "sense_definition": "Great Ape Project (an international organization).",
