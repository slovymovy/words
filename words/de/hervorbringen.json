                    "frequency": "Low",
                    "semantic_group_id": "zeigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zauberer <w>brachte</w> überraschend ein weißes Kaninchen aus dem Hut <w>hervor</w>."
                        },
                        {
                            "text": "Nach langem Suchen hat sie endlich ihren alten Pass wieder <w>hervorgebracht</w>."
