                                        "entry_id": "3a5cd21b-3d44-32a0-978e-d57206702352",
                                        "glosses": [
                                            "A contraction of the foreskin (either as a stage of development or a pathological condition), which prevents it from being retracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc534af2-a4fe-4bf8-8829-d826bea6de43",
                                                "sense_id": "f1d4326f-6678-3ffd-bd8c-25c64c3441e0",
                                                "text": "’Twill end in a phimosis, replied Dr. Slop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
