                    {
                        "sense_id": "9920ef11-1aac-3dea-a9f3-906b2bed8653",
                        "entry_id": "1efcc2ea-b8b2-3122-ac41-4b5b3fcdc6ca",
                        "glosses": [
                            "État de ce qui est proéminent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762c3c9e-f1eb-4edd-8344-9795349e5a49",
                                "sense_id": "9920ef11-1aac-3dea-a9f3-906b2bed8653",
                                "text": "Mais la proéminence des veines du front, […], annonçaient évidemment que la tempête n’était qu’assoupie et se réveillerait facilement."
                            },
                            {
                                "example_id": "a4c36839-70c1-439b-8c54-c41c17742eff",
                                "sense_id": "9920ef11-1aac-3dea-a9f3-906b2bed8653",
                                "text": "La proéminence de l’arcade de l’œil, quoique très-élégamment coupée, obombre le regard et ajoute encore à cette mélancolie …."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ab94cf1-37f2-3853-959b-fb9eb3186fc5",
                        "entry_id": "1efcc2ea-b8b2-3122-ac41-4b5b3fcdc6ca",
                        "glosses": [
                            "Partie proéminente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e3a1987-2971-4a09-8c7a-5f143582af46",
                                "sense_id": "8ab94cf1-37f2-3853-959b-fb9eb3186fc5",
                                "text": "Les proéminences du crâne. - Des proéminences osseuses."
                            }
                        ]
                    }
                ],
