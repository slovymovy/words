                    {
                        "translation_id": "5ef81de9-22e0-467d-970a-7ea54d1e1158",
                        "source_entry_id": "93ab63ff-127c-31af-a61b-646df6311d0b",
                        "source_sense_id": "adfc286e-2b3b-3cef-8226-7c4a3052eafb",
