                ],
                "senses": [
                    {
                        "sense_id": "8aec6108-8cbd-39c1-a184-151208bfeaa4",
                        "entry_id": "fd5da029-580a-38e8-800f-d3c84e8adf6d",
                        "glosses": [
                            "Ce qui sert à l'identification."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "edd2521d-a4f7-4cf0-9dca-416acbfad414",
                                "sense_id": "8aec6108-8cbd-39c1-a184-151208bfeaa4",
                                "text": "Il y a lieu de fournir l'identité chimique du principal composant de la substance en indiquant au moins l’identificateur de produit ou un des autres moyens d'identification prévus à la sous-rubrique 1.1."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb22d89-8aff-3688-a485-b7a333893608",
                        "entry_id": "fd5da029-580a-38e8-800f-d3c84e8adf6d",
                        "glosses": [
                            "Mot de la programmation informatique reconnu par le compilateur ou l’interpréteur et qui permet, telle une étiquette, de désigner des concepts du langage de programmation : des variables, des types, des constantes, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b3035df-20b7-49e8-b0a5-1e66da2ae4f1",
                        "source_entry_id": "fd5da029-580a-38e8-800f-d3c84e8adf6d",
                        "source_sense_id": "8aec6108-8cbd-39c1-a184-151208bfeaa4",
                        "target_lang_word": "identifier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identifier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1762f0-bdc0-3da1-bec2-f50b70655514",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "Someone who identifies; a person who establishes the identity of someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b17322f-2091-4054-9879-513b207da974",
                                                "sense_id": "4f1762f0-bdc0-3da1-bec2-f50b70655514",
                                                "text": "The Identifier personally inspects each horse in each race by verifying the lip tattoo, body color, head and leg markings, scars, and chestnut (night eyes)."
                                            },
                                            {
                                                "example_id": "5fe90cc9-8891-4038-b47a-031fd753a872",
                                                "sense_id": "4f1762f0-bdc0-3da1-bec2-f50b70655514",
                                                "text": "The foal papers are documents recording the horse's registration; no horse can start in any race unless his papers are in the hands of the track's identifier."
                                            },
                                            {
                                                "example_id": "5c2a1801-22d0-432b-99c1-9a11a489a05a",
                                                "sense_id": "4f1762f0-bdc0-3da1-bec2-f50b70655514",
                                                "text": "Here, we would use the anonymous key technique to obtain a quantum identification protocol AKI of the challenge-response type in which the identifier cannot pretend to be the identifiee […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a30db7-b7a1-3668-9cfe-6f6ba722669b",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "Something that identifies or uniquely points to something or someone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df5216f-0bb8-4164-9bb4-d0278bef7655",
                                                "sense_id": "05a30db7-b7a1-3668-9cfe-6f6ba722669b",
                                                "text": "Prehistoric artists used hand-prints in cave paintings, perhaps as a 'signature'. They might be considered the earliest example of a biometric identifier."
                                            },
                                            {
                                                "example_id": "18dc58be-2f63-4c43-beb8-bfb8d5d4da81",
                                                "sense_id": "05a30db7-b7a1-3668-9cfe-6f6ba722669b",
                                                "text": "The source stated that the alleged victims wanted the paperwork released after the settlement, but with names and identifiers removed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f820ba3b-19dd-3fb5-8599-cada3889a8a6",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "One who identifies as a particular type or role; one who says and believes that they are a certain thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8bfb578-c8cd-4e1c-abd9-1f26a323254c",
                                                "sense_id": "f820ba3b-19dd-3fb5-8599-cada3889a8a6",
                                                "text": "While the DOJ and BOJS already calculate data by gender, trans identifiers are not included, it is solely by men and women"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6342bf-7404-3d39-b9c2-bc4535b89792",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "A guidebook that helps determine the specific class of an object (such as a mushroom, herb, fish, bird, drug, or mineral), or its individual identity (such as that of a star)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f744599d-53ea-37a2-8d76-445639c22550",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "A formal name used in source code to refer to a variable, function, procedure, package, etc. or in an operating system to refer to a process, user, group, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec73e3a4-46d5-306b-a342-8c1274bedb43",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "A code that distinguishes a particular element from all other elements in a document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "683abae1-68f4-3e9a-bb90-84aa5345b39a",
                                        "entry_id": "4b1b0277-970a-3f86-80a3-f02eceec3241",
                                        "glosses": [
                                            "A primary key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
