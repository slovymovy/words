                "senses": [
                    {
                        "sense_id": "51546c3f-9f1d-348d-b40f-e9dfb241abad",
                        "entry_id": "1876fa48-5227-3c22-8f20-1153b5c11657",
                        "glosses": [
                            "In a prudent manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46710938-99be-4db0-aacd-c2f150279a38",
                                "sense_id": "51546c3f-9f1d-348d-b40f-e9dfb241abad",
                                "text": "Which statement Louis prudently let slide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31470ad5-e56e-4d17-9322-efc9b1f51238",
                        "source_entry_id": "1876fa48-5227-3c22-8f20-1153b5c11657",
                        "source_sense_id": "51546c3f-9f1d-348d-b40f-e9dfb241abad",
                        "source_sense_description": "in a prudent manner",
                        "target_lang_word": "prudemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prudemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                        "entry_id": "d7591969-fe42-39f1-9e4a-b180190577f0",
                                        "glosses": [
                                            "Avec prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd25c964-f126-4eb3-9596-ff1655c17687",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Être prudemment barbare et exercer la tyrannie conséquemment signifie, selon ce politique abominable, exécuter tout d'un coup toutes les violences et tous les crimes que l'on juge utiles à ses intérêts."
                                            },
                                            {
                                                "example_id": "8f5fe4b5-865c-4cee-8f24-a675cc9b2595",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Un vague et déprimant malaise planait. Sous le porche des Réguliers, personne. Les trafiquants de drogue qui s'y postaient le soir s'étaient, prudemment, éclipsés."
                                            },
                                            {
                                                "example_id": "bf04b53a-e662-4c21-ab87-b3b395bf4432",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Évrard seul, dans un coin prudemment retiré, Se croyait à couvert de l’insulte sacré,"
                                            },
                                            {
                                                "example_id": "5dc59c91-7559-425c-b62f-7963b4eaf833",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "Ces sensibilités qui veulent choisir les misères, et qui, en nous rendant trop prudemment charitables, nous rendent pieusement cruels,"
                                            },
                                            {
                                                "example_id": "347f2d26-946b-4558-a3d3-16e68381cb09",
                                                "sense_id": "e7747012-b13d-3bec-a5b8-45f512af95b6",
                                                "text": "— Heureusement tous les cossons n'étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
