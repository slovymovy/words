{
    "word_family": [
        "pulver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5e8c592-476f-3359-9e46-d016bb50f166",
                    "sense_definition": "Iets geheel fijnmalen, vermalen of verbrijzelen tot poeder of stof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machine kan harde stenen binnen enkele seconden volledig <w>verpulveren</w>.",
                            "target_lang_translations": {
                                "pl": "Maszyna potrafi w kilka sekund całkowicie <w>sproszkować</w> twarde kamienie."
                            }
                        },
                        {
                            "text": "Hij <w>verpulverde</w> de gedroogde kruiden tussen zijn vingers voor de saus.",
                            "target_lang_translations": {
                                "pl": "<w>Rozsypał w palcach</w> suszone zioła do sosu."
                            }
                        }
                    ],
                    "synonyms": [
                        "vermalen",
                        "verbrijzelen",
                        "fijnmalen"
                    ],
                    "common_phrases": [
                        "volledig verpulveren",
                        "tot stof verpulveren"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozdrabniać, mleć lub kruszyć coś całkowicie na proszek lub pył."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sproszkować",
                                "target_lang_sense_clarification": "zetrzeć na proszek"
                            },
                            {
                                "target_lang_word": "rozetrzeć",
                                "target_lang_sense_clarification": "np. zioła w palcach lub moździerzu"
                            },
                            {
                                "target_lang_word": "pokruszyć",
                                "target_lang_sense_clarification": "rozbić na drobne kawałki lub pył"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b9458c5-0575-3009-8226-f6f1dd8b5131",
                    "sense_definition": "Van nature of door slijtage uiteenvallen tot poeder, stof of gruis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de ouderdom en droogte <w>verpulvert</w> het oude papier zodra je het aanraakt.",
                            "target_lang_translations": {
                                "pl": "Ze starości i suchości stary papier <w>obraca się w proch</w>, gdy tylko się go dotknie."
                            }
                        },
                        {
                            "text": "De zachte zandsteen is door de harde wind langzaam <w>verpulverd</w>.",
                            "target_lang_translations": {
                                "pl": "Miękki piaskowiec powoli <w>skruszał</w> z powodu silnego wiatru."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergaan",
                        "uiteenvallen",
                        "verbrokkelen"
                    ],
                    "common_phrases": [
                        "langzaam verpulveren"
                    ],
                    "target_lang_definitions": {
                        "pl": "Naturalnie lub wskutek zużycia rozpadać się w proch, pył lub gruz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obracać się w proch",
                                "target_lang_sense_clarification": "rozpadać się ze starości lub zniszczenia"
                            },
                            {
                                "target_lang_word": "rozsypywać się w pył",
                                "target_lang_sense_clarification": "ulegać zniszczeniu na drobne cząstki"
                            },
                            {
                                "target_lang_word": "kruszeć",
                                "target_lang_sense_clarification": "rozpadać się pod wpływem czasu i czynników zewnętrznych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461b3cfd-b447-3735-957d-256fc5ad7d5c",
                    "sense_definition": "Een tegenstander, record of idee verpletterend verslaan of vernietigen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge atleet wist tijdens de finale het oude wereldrecord compleet te <w>verpulveren</w>.",
                            "target_lang_translations": {
                                "pl": "Młody lekkoatleta w finale zdołał całkowicie <w>zmiażdżyć</w> stary rekord świata."
                            }
                        },
                        {
                            "text": "De regerende kampioen <w>verpulverde</w> zijn tegenstander in de eerste ronde van de wedstrijd.",
                            "target_lang_translations": {
                                "pl": "Obrońca tytułu <w>rozgromił</w> swojego przeciwnika już w pierwszej rundzie walki."
                            }
                        }
                    ],
                    "synonyms": [
                        "verpletteren",
                        "vermorzelen",
                        "verslaan"
                    ],
                    "common_phrases": [
                        "een record verpulveren",
                        "de tegenstander verpulveren"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zmiażdżyć lub zdecydowanie pokonać przeciwnika, pobić rekord bądź zniszczyć ideę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zmiażdżyć",
                                "target_lang_sense_clarification": "pokonać rywala z ogromną przewagą"
                            },
                            {
                                "target_lang_word": "rozgromić",
                                "target_lang_sense_clarification": "zdecydowanie zwyciężyć przeciwnika"
                            },
                            {
                                "target_lang_word": "pobić na głowę",
                                "target_lang_sense_clarification": "np. rekord lub rywala"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}