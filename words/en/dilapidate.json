    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "549f0afd-de08-3b51-ae8a-08202cb8d041",
                    "sense_definition": "To fall into partial ruin, decay, or disuse over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper maintenance, the old barn began to <w>dilapidate</w> through years of harsh weather."
                        },
                        {
                            "text": "The estate will rapidly <w>dilapidate</w> if the family continues to leave it unoccupied."
                        }
                    ],
                    "synonyms": [
                        "decay",
                        "deteriorate"
                    ],
                    "antonyms": [
                        "improve"
                    ],
                    "common_phrases": [
                        "dilapidate over time"
                    ]
                },
                {
                    "sense_id": "387c17d4-e12f-3fa0-840a-107501be2f62",
                    "sense_definition": "To cause a building or structure to fall into ruin or state of disrepair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The negligent tenant managed to <w>dilapidate</w> the cottage in less than two years."
                        },
                        {
                            "text": "Decades of severe storms threatened to <w>dilapidate</w> the ancient stone chapel."
                        }
                    ],
                    "synonyms": [
                        "ruin",
                        "damage"
                    ],
                    "antonyms": [
                        "repair",
                        "restore"
                    ]
                },
                {
