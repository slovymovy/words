                "senses": [
                    {
                        "sense_id": "4d0ef7b6-ffbc-31d5-9196-53f798c2b146",
                        "entry_id": "e47e87df-4e05-3439-a1fe-91139bf8e7fe",
                        "glosses": [
                            "zwierzę lub osoba charakteryzująca się antropofobią — awersją lub lękiem przed ludźmi i stronieniem od nich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbdd9f38-8532-4527-9772-b8a6d91b0118",
                                "sense_id": "4d0ef7b6-ffbc-31d5-9196-53f798c2b146",
                                "text": "Bóbr jest wybitnym antropofobem, wymierającym wraz ze wzrostem gęstości zaludnienia"
                            },
                            {
                                "example_id": "0f03a20d-a2fb-4799-b9fb-1e8409c9d236",
                                "sense_id": "4d0ef7b6-ffbc-31d5-9196-53f798c2b146",
                                "text": "I w ogóle nie jestem ani „człowiekolubem” czyli „antropofilem”, ani też ”człowiekonienawistnikiem” czyli „antropofobem” lub nawet ”człowiekożercą” czyli „antropofagiem”. Moimi sądami o sprawach ludzkich nie kieruje ani miłość, ani nienawiść"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
