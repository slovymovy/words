                                        "entry_id": "42839f18-0529-3c0d-b19a-b54a4ceb4c91",
                                        "glosses": [
                                            "Someone who regularly looks after another person, either as a job or often through family responsibilities."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8bdcca-68c3-48c6-8748-85d520087079",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "Have you thought of a job as a carer for disabled people?"
                                            },
                                            {
                                                "example_id": "2be5ca9c-bcdf-4d5b-8df9-d6af4930176e",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "They retired early to be a full-time carer for their partner."
                                            },
                                            {
                                                "example_id": "e72bede2-d4a4-41c3-8fbf-909952172b54",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "He said Robins had not been in trouble with the law before and had no previous convictions. Jail would have an adverse effect on her and her three children as she was the main carer."
                                            },
                                            {
                                                "example_id": "c397800a-5412-45e8-ac04-d49c2314058a",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "Her business was a one-woman outfit that offered accredited first-aid training courses for teachers, carers, sports coaches, antenatal classes, workplace groups, and the police; the classes ranged from basic defibrillator training to what was now called psychological first aid."
