                                "target_senses": [
                                    {
                                        "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                        "entry_id": "54d83f53-06c4-300a-acc4-505b00cd39d0",
                                        "glosses": [
                                            "An extendable monopod arm onto which a smartphone or camera can be mounted in order to take wide-angle photographs of oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bcc26e4-313e-4acf-b22b-627882049eb7",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "For example, photography shop Artworkfoto in Funan DigitaLife Mall sells about five selfie sticks every day."
                                            },
                                            {
                                                "example_id": "40a38b00-f583-4fea-8217-6946ec867739",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "We snapped another selfie (one of the guys, Royston out of our newly acquired Singapore Zopim office, introduced the Exchange to the selfie stick, and that photo is now legendary.)"
                                            },
                                            {
                                                "example_id": "ff798c72-60a8-48d9-bed7-a5099e2fb291",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "The needs of selfie takers feed into new product development such as a selfie stick that allows the ul-jang angle, a mirrorless DSLR camera with a 180-degree tilting LCD window, a motion-detecting shutter, and a camera with wireless internet for transferring images."
                                            }
                                        ]
                                    }
