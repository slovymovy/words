                "senses": [
                    {
                        "sense_id": "ce606fa0-86da-3852-bf4a-289c3076ea8f",
                        "entry_id": "2847c314-0f67-3b6c-9088-9c11471763a9",
                        "glosses": [
                            "niet prettig om mee om te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8775a868-8abc-49c5-905d-8e20ca579797",
                                "sense_id": "ce606fa0-86da-3852-bf4a-289c3076ea8f",
                                "text": "Hij is een vervelende onsympathieke man die met iedereen ruzie maakt."
                            },
                            {
                                "example_id": "1d9565a5-2ddf-457a-be0c-370118de5ee3",
                                "sense_id": "ce606fa0-86da-3852-bf4a-289c3076ea8f",
                                "text": "‘Op café ben je anders dan wanneer je voor de klas staat. Het is belangrijk om bepaalde aspecten van je persoonlijkheid te versterken als die relevant zijn voor je beroep. In het geval van de azijnpisser is dat misschien geduld en betrokkenheid. Maar het is zeker dat je er als leraar niet zo gemakkelijk van af komt als de razend onsympathieke maar geniale arts Dr. House.’"
                            },
                            {
                                "example_id": "2dddf794-be97-4cba-a4fb-b4b8b39eeef8",
                                "sense_id": "ce606fa0-86da-3852-bf4a-289c3076ea8f",
                                "text": "Dat is specifiek, en dat moet ook, zegt hij. Een politicus die het volk belangrijk vindt, is namelijk nog geen populist. Een politicus die openstaat voor gewone mensen ook niet. En 'een succesvolle politicus die jij misschien onsympathiek vindt', zoals de Duitse politicoloog Jan-Werner Müller in zijn essay Wat is populisme schrijft, al helemaal niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67f74c25-c242-4d4d-9cbc-71a6ab93b85b",
                        "source_entry_id": "2847c314-0f67-3b6c-9088-9c11471763a9",
                        "source_sense_id": "ce606fa0-86da-3852-bf4a-289c3076ea8f",
                        "target_lang_word": "nasty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74e73ce3-0e5b-3c0c-ae90-7d5c3846131c",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Dirty, filthy."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ddb0f8-6da5-44f8-8488-567d5c7d0af0",
                                                "sense_id": "74e73ce3-0e5b-3c0c-ae90-7d5c3846131c",
                                                "text": "In such condition, there is no place for Industry; because the fruit thereof is uncertain: and consequently no Culture of the Earth; no Navigation, nor use of the commodities that may be imported by Sea; no commodious Building; no Instruments of moving, and removing such things as require much force; no Knowledge of the face of the Earth; no account of Time; no Arts; no Letters; no Society; and which is worst of all, continuall feare, and danger of violent death; And the life of man, solitary, poore, nasty, brutish, and short."
                                            },
                                            {
                                                "example_id": "5e5cc316-a5bd-475d-8623-49caaf24bf8e",
                                                "sense_id": "74e73ce3-0e5b-3c0c-ae90-7d5c3846131c",
                                                "text": "I really don't have any friends at school Mama Mia. They talk about me all the time. They say my hair's nappy and my clothes are nasty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c93ed5-d192-3a48-bfc5-bdc6b76aa6f8",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Contemptible, unpleasant (of a person)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70819a2d-0971-4044-8ac9-aa15af422691",
                                                "sense_id": "31c93ed5-d192-3a48-bfc5-bdc6b76aa6f8",
                                                "text": "Jonathan kept staring at him, till I was afraid he would notice. I feared he might take it ill, he looked so fierce and nasty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ab2daa-21e7-3d38-bf99-ce52adf9de5e",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Objectionable, unpleasant (of a thing); repellent, offensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a601fa7-d779-4e81-afa2-6d0c17eac9e7",
                                                "sense_id": "96ab2daa-21e7-3d38-bf99-ce52adf9de5e",
                                                "text": "‘It's a nasty trade,’ said Mr. Limbkins, when Gamfield had again stated his wish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a02b04-c03a-3d2a-adad-ef2fc96263d9",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Indecent or offensive; obscene, lewd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72b8385-71f9-48c7-b46a-7f902d47e8df",
                                                "sense_id": "b6a02b04-c03a-3d2a-adad-ef2fc96263d9",
                                                "text": "He said to Mr. Tallboy he thought the headline was a bit hot. And Mr. Tallboy said he had a nasty mind."
                                            },
                                            {
                                                "example_id": "6b5c9641-a63c-409e-ad52-43e74f91c267",
                                                "sense_id": "b6a02b04-c03a-3d2a-adad-ef2fc96263d9",
                                                "text": "We want threesomes, blowjobs, and orgies. That's just the way it is. We want the good girl who's nasty in bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa17b66-417c-3cd0-8af2-e28849c9d1c0",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Spiteful, unkind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfd8755-f91d-4ee3-8924-d099a4e685c9",
                                                "sense_id": "1aa17b66-417c-3cd0-8af2-e28849c9d1c0",
                                                "text": "She had said: \"I love the block button on Twitter. I don't know how people expect to send a nasty comment and not get blocked.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa705900-12df-3212-9c4f-c842533e80f6",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Awkward, difficult to navigate; dangerous."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353ac201-5ce5-42df-b1b6-2b4417764a64",
                                                "sense_id": "fa705900-12df-3212-9c4f-c842533e80f6",
                                                "text": "There was a nasty period during the First World War when the family's allegiance was called into question - not least because one of the Schroders had been made a baron by the Kaiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c1d93f-76be-3876-8cd1-8496ba9a579f",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Grave or dangerous (of an accident, illness etc.)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48fcf66a-c0c7-4a31-9bc1-a7b4033416b6",
                                                "sense_id": "02c1d93f-76be-3876-8cd1-8496ba9a579f",
                                                "text": "Moving into the middle ages, William the Conqueror managed to rout the English and rule the country, then see off numerous plots and assassination attempts, before his horse did for him in a nasty fall, killing him at 60."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58bd67bd-3fa3-3ece-9e17-f5eaab699b2b",
                                        "entry_id": "b1efd3af-1c3a-314b-aff2-21f9d8b7d9e5",
                                        "glosses": [
                                            "Formidable, terrific; wicked."
                                        ],
