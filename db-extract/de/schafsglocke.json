                        "glosses": [
                            "Glocke, die einem Schaf um den Hals gebunden werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93967439-3b36-4def-9203-72954551a2ab",
                                "sense_id": "bf814dc3-4df6-38cd-afa4-ec1a4156b712",
                                "text": "„Das saftige Grün der Wiesen, das strahlende Gelb der Blumen, das leichte Klingeln der Schafsglocken erinnern mich, warum ich für eine Zukunft kämpfe.“"
                            },
                            {
                                "example_id": "754ab36e-6c16-42fe-b58b-0691ba825126",
                                "sense_id": "bf814dc3-4df6-38cd-afa4-ec1a4156b712",
                                "text": "„In der Ferne war das Bimmeln von Schafsglocken zu hören, es klang wie ein Warnsignal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
