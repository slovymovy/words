        "fr-extract.jsonl": [
            {
                "entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                "word": "explicitation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d9b6c5f7-8e1f-4f4e-9630-eaa3d26837cd",
                        "entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                        "tags": [
                            "plural"
                        ],
                        "form": "explicitations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25e2806a-476f-3125-9db4-38f96698fbdb",
                        "entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                        "glosses": [
                            "Fait d'identifier, décrire, expliquer, lister de façon la plus détaillée possible, les démarches utilisées pour accomplir une tâche, les représentations intuitives à propos d'un concept, des stratégies de résolution de problèmes, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd25220-5b39-446c-91f9-7e1a71ae662e",
                                "sense_id": "25e2806a-476f-3125-9db4-38f96698fbdb",
                                "text": "Elle s'occupe aussi de la formation des professeurs et des formateurs à l’analyse de pratique et aux techniques d’aide à l’explicitation."
                            }
                        ]
                    },
                    {
                        "sense_id": "62fd93b5-446a-3975-b64c-5597afcbd8a6",
                        "entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                        "glosses": [
                            "Fait de développer, d’énoncer de manière claire quelque chose d’implicite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c334960-252c-44d3-a1f2-5822de8db10f",
                                "sense_id": "62fd93b5-446a-3975-b64c-5597afcbd8a6",
                                "text": "L’explicitation de son discours, a permis aux auditeurs britanniques de comprendre ce qui paraissait évident aux auditeurs néo-zélandais auxquels il s’adressait en premier lieu."
                            },
                            {
                                "example_id": "44972a3b-e80d-4ab0-a401-0f4c1c747883",
                                "sense_id": "62fd93b5-446a-3975-b64c-5597afcbd8a6",
                                "text": "L’explicitation d’un sigle, c’est l’énonciation de sa forme développée."
                            },
                            {
                                "example_id": "82502e98-4c39-4d11-91e5-67cd5b66d1bd",
                                "sense_id": "62fd93b5-446a-3975-b64c-5597afcbd8a6",
                                "text": "L’explication nécessite souvent une explicitation préalable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac8cff46-f085-4b10-a830-287681cefeab",
                        "source_entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                        "source_sense_description": "Processus dont l’objectif est de rendre une chose explicite",
                        "target_lang_word": "explicitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                        "entry_id": "7118f7c6-117b-3e13-8392-bb1d6abf93c0",
                                        "glosses": [
                                            "The process or fact of becoming explicit or of causing to be explicit; that which makes something explicit."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "possibly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c786b0b3-1032-4c31-9ee4-7e5d724aa1a4",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "[N]ot only are the two factors of reality [i.e., objective and subjective] exposures or explicitations of each other, each being always the other's inside made outside, implicit made explicit, but also in our thought of them as incidents of one process or activity it can certainly be no more true that they influence each other or act causally on each other or \"interact,\" than that they are constantly realizing each other."
                                            },
                                            {
                                                "example_id": "5b05834c-6bb4-4682-a462-34b3da1555a0",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "The further attributes of matter—e.g. motion, space, time, substantiality, and reflection—appear merely as explicitations and concretizations of the fundamental thesis on the priority of matter over consciousness."
                                            },
                                            {
                                                "example_id": "cfbb14a6-d2f9-4db0-81bc-cf9c74506836",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "This article is primarily directed at a clarification and explicitation of objectives and of their implementation in laboratory work at the Dutch Open University."
                                            },
                                            {
                                                "example_id": "f45da745-1557-45c4-af2b-608699758ee7",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "Further, while Frege's judgment stroke has the merit of making this distinction fully explicit, and thereby available to do logical work, there are still, as Martin recognizes, real limits on explicitation here—at least within a Fregean context."
                                            },
                                            {
                                                "example_id": "947d0bbc-b81f-41d1-a751-0b65b87b72cc",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "The entire range of political theory for example is concerned with explicitation of this egalitarianism through the agency of the State."
                                            },
                                            {
                                                "example_id": "ce48ea39-faeb-4fbb-a5ba-efba1cf3880f",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "Beckett would have hated the fuss: too big, too noisy, too much explicitation; the City of the Plain welcoming back its prodigal son whose image (banners, pictures, books) was everywhere."
                                            },
                                            {
                                                "example_id": "a23a6714-ddcb-4a52-b810-69354196c38f",
                                                "sense_id": "a61df694-683c-3d4a-8b7a-bc2751c3f8af",
                                                "text": "Professional translators incorporate explicitations to explain the missing context by considering cultural differences between source and target audiences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51518365-301e-4225-ba2d-aa4436b07f23",
                        "source_entry_id": "c186c15f-5735-30ad-b5ce-65bf56477509",
                        "source_sense_description": "Fait de rendre explicite",
