                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e1dcf30-cce9-3548-857f-323bb961d804",
                        "entry_id": "a4fae589-0695-35fd-9840-716eb2da3475",
                        "glosses": [
                            "прийти позже, чем требуется, чем ожидалось"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0a032f-49cf-4e39-a272-f61e07c0de9f",
                                "sense_id": "7e1dcf30-cce9-3548-857f-323bb961d804",
                                "text": "Понимаешь, я немного проспал… и я боялся опоздать в школу."
                            }
                        ]
                    },
                    {
                        "sense_id": "d11d4157-7c3a-3e5b-87f2-2a08d676b823",
                        "entry_id": "a4fae589-0695-35fd-9840-716eb2da3475",
                        "glosses": [
                            "не сделать что-либо к определённому сроку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81486fd-bbc1-46f5-9053-d23579206165",
                                "sense_id": "d11d4157-7c3a-3e5b-87f2-2a08d676b823",
                                "text": "Значит, надо не опоздать, завтра же сделать заявку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bf7be58-1219-4414-8489-e114406c06f2",
                        "source_entry_id": "a4fae589-0695-35fd-9840-716eb2da3475",
                        "source_sense_description": "прийти позже, чем требуется, чем ожидалось",
                        "target_lang_word": "late",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "late",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c375de7-5711-3547-9146-487ec1964705",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Near the end of a period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42c5b03f-95bb-44a6-b553-49895f976c18",
                                                "sense_id": "4c375de7-5711-3547-9146-487ec1964705",
                                                "text": "The seedlings appeared to be coming along nicely until a late frost killed them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac03fee-98d1-32e9-8741-d3e3d03e45fe",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Specifically, near the end of the day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02602017-84c0-4e08-838f-140a592bc445",
                                                "sense_id": "7ac03fee-98d1-32e9-8741-d3e3d03e45fe",
                                                "text": "It was getting late and I was tired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f9b1f8c-858d-3eda-9b48-e190b0bc03e7",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Associated with the end of a period."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ee5d7b-36f5-4abd-a682-68a9f6861409",
                                                "sense_id": "8f9b1f8c-858d-3eda-9b48-e190b0bc03e7",
                                                "text": "Late Latin is less fully inflected than classical Latin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1511e89-e76e-30a0-9c54-4bf908cb9e1a",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Not arriving or occurring until after an expected time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187185b1-ba96-4239-b76f-a225aa926d91",
                                                "sense_id": "b1511e89-e76e-30a0-9c54-4bf908cb9e1a",
                                                "text": "The flowers were late in blooming because of the prolonged cold weather."
                                            },
                                            {
                                                "example_id": "5c04a405-6b78-46f0-80be-311bec760077",
                                                "sense_id": "b1511e89-e76e-30a0-9c54-4bf908cb9e1a",
                                                "text": "Panos was so late that he arrived at the meeting after Antonio, who had the excuse of being in hospital for most of the night."
                                            },
                                            {
                                                "example_id": "8bd645f2-0be5-42da-b790-5e170f232a38",
                                                "sense_id": "b1511e89-e76e-30a0-9c54-4bf908cb9e1a",
                                                "text": "The heavy snow made all the trains late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba216dd8-7cd7-37f0-a57e-b75ea55f183e",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Levied as a surcharge on a payment which has not arrived by a specified deadline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ce55dc-6ff8-48e0-8166-8bb127a1a8aa",
                                                "sense_id": "ba216dd8-7cd7-37f0-a57e-b75ea55f183e",
                                                "text": "The power company suspended late fees during the pandemic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96690343-884b-3548-b41c-5a57c2254db5",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Not having had an expected menstrual period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d7cfab3-41db-46e8-bd99-1a117b71e369",
                                                "sense_id": "96690343-884b-3548-b41c-5a57c2254db5",
                                                "text": "I'm late, honey. Could you buy a test?"
                                            },
                                            {
                                                "example_id": "4db66191-59ed-4c7f-bf38-5475d5d2aa29",
                                                "sense_id": "96690343-884b-3548-b41c-5a57c2254db5",
                                                "text": "I am very worried. I am never late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Deceased, dead: used particularly when speaking of the dead person's actions while alive. (Generally must be preceded by a possessive or an article, commonly \\\"the\\\"; see usage notes. Can itself only precede the person's name, never follow it.)"
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db120c11-6d5f-479c-aa2f-fd54517bd38c",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "“He is not my ‘late husband’. He is my husband,” she said, before discussing how the couple had managed to retain their independent identities while together."
                                            },
                                            {
                                                "example_id": "adfc87ce-1e93-43ab-856f-d1cc8b0816a5",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "Mark’s late wife, Gemma, was an educator as well. Russian literature."
                                            },
                                            {
                                                "example_id": "6093d3e3-438a-40f7-ba67-21bbc9e061a6",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "Her late husband had left her well provided for."
                                            },
                                            {
                                                "example_id": "9f7b4a3a-7db6-42aa-90bb-885a74a5b28f",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "Mary was entitled to the crown by her late father’s testament."
                                            },
                                            {
                                                "example_id": "633cf937-5c5d-4b8e-8da9-443a6277a67f",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            },
                                            {
                                                "example_id": "2da36916-f737-4fa1-be12-b59b93617724",
                                                "sense_id": "b072daea-4354-3a32-af97-5cdf7e216f6a",
                                                "text": "This parrot is no more! It has ceased to be! It's expired and gone to meet its maker! This is a late parrot! It's a stiff! Bereft of life, it rests in peace! If you hadn't nailed it to the perch it would be pushing up the daisies!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5978ed0-4441-3f3b-bce4-b8927d39bba1",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Existing or holding some position not long ago, but not now; departed, or gone out of office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56073e00-7b92-4f16-ae87-8537104e8809",
                                                "sense_id": "b5978ed0-4441-3f3b-bce4-b8927d39bba1",
                                                "text": "the late bishop of London"
                                            },
                                            {
                                                "example_id": "5aa0b8f7-4625-4510-a03a-fca4e48bddc4",
                                                "sense_id": "b5978ed0-4441-3f3b-bce4-b8927d39bba1",
                                                "text": "the late administration"
                                            },
                                            {
                                                "example_id": "acb7050f-6b48-450d-bad9-0f7d94b47a3e",
                                                "sense_id": "b5978ed0-4441-3f3b-bce4-b8927d39bba1",
                                                "text": "By Edvvard Reynoldes, late Preacher to the Honorable Society of Lincoln’s Inne: And now Rector of the Church of Braunſton in Northamptonſhire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "995d2954-9778-37ad-90a1-fcddbb61c367",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Recent — relative to the noun it modifies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb3e98a-8c9a-46ca-98af-8640d129e2d3",
                                                "sense_id": "995d2954-9778-37ad-90a1-fcddbb61c367",
                                                "text": "OLd Iohn of Gaunt, time-honoured Lancaſter,\nHaſt thou according to thy oath and band\nBrought hither Henry Herford thy bold ſon:\nHeere to make good yͤ boiſtrous late appeale,\nWhich then our leyſure would not let vs heare,\nAgainſt the Duke of Norfolke, Thomas Mowbray?"
                                            },
                                            {
                                                "example_id": "27afd7db-e40d-43c4-bef1-4baf43f2ae8a",
                                                "sense_id": "995d2954-9778-37ad-90a1-fcddbb61c367",
                                                "text": "Lancaster bore him—such a little town, / Such a great man. It doesn't see him often / Of late years, though he keeps the old homestead / And sends the children down there with their mother[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517724cf-773f-3b0f-a244-63f94f36dba3",
                                        "entry_id": "6c4efc54-cb66-3079-8e03-ac0df1c22e0b",
                                        "glosses": [
                                            "Of a star or class of stars, cooler than the sun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "late",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd86548-4727-3eea-814d-708fd98ec2c7",
                                        "entry_id": "05800580-bf52-3b0a-a177-8032aa49e764",
                                        "glosses": [
                                            "A shift (scheduled work period) that takes place late in the day or at night."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4658ec11-3f76-468f-ac87-17f834f87bd5",
                                                "sense_id": "9cd86548-4727-3eea-814d-708fd98ec2c7",
                                                "text": "At about 11 pm one night in Corporation Street my watch were on van patrol and Yellow Watch were on late as usual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "late",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b501dec4-78e7-3b8c-9368-91a4e7cd106c",
                                        "entry_id": "43e31ec1-5255-325c-9108-89b316e992a6",
                                        "glosses": [
                                            "After a deadline has passed, past a designated time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4ffe549-0376-4490-853e-7804340569b9",
                                                "sense_id": "b501dec4-78e7-3b8c-9368-91a4e7cd106c",
                                                "text": "We drove as fast as we could, but we still arrived late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f8f86e-c30e-3b6f-ac92-2fcb7bb28127",
                                        "entry_id": "43e31ec1-5255-325c-9108-89b316e992a6",
                                        "glosses": [
                                            "Formerly, especially in the context of service in a military unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da06e380-7071-4873-8243-82e682a5f36f",
                                                "sense_id": "c9f8f86e-c30e-3b6f-ac92-2fcb7bb28127",
                                                "text": "Colonel Easterwood, late of the 34th Carbines, was a guest at the dinner party."
                                            },
                                            {
                                                "example_id": "513d00b5-968c-4d78-8342-fabfdbc62d47",
                                                "sense_id": "c9f8f86e-c30e-3b6f-ac92-2fcb7bb28127",
                                                "text": "The Hendersons will all be there / Late of Pablo Fanque's Fair / What a scene!"
                                            },
                                            {
                                                "example_id": "47c83627-9694-45e6-a377-b41d8f990543",
                                                "sense_id": "c9f8f86e-c30e-3b6f-ac92-2fcb7bb28127",
                                                "text": "Linda Smith, late of 13 Oxford Street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "259913fb-b25b-3683-9324-d4876c2ee06b",
                                        "entry_id": "43e31ec1-5255-325c-9108-89b316e992a6",
                                        "glosses": [
                                            "Not long ago; just now, recently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7754af6c-d541-4b22-b6d2-979692768fd4",
                                                "sense_id": "259913fb-b25b-3683-9324-d4876c2ee06b",
                                                "text": "He ſhall doe this, or elſe I doe recant / The pardon that I late pronounced heere."
                                            },
                                            {
                                                "example_id": "0bcd9d81-0c2e-487f-b472-d3dcd805ac9e",
                                                "sense_id": "259913fb-b25b-3683-9324-d4876c2ee06b",
                                                "text": "Tears of the widower, when he sees\n⁠A late-lost form that sleep reveals,\n⁠And moves his doubtful arms, and feels\nHer place is empty, fall like these; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
