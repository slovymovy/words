                                                "sense_id": "0c77bbd5-8486-3fb3-8f15-66d87728d2e8",
                                                "text": "Ich habe heute früher Feierabend."
                                            },
                                            {
                                                "example_id": "afcc1df0-fa8c-43ba-90e7-743d1ac5a893",
                                                "sense_id": "0c77bbd5-8486-3fb3-8f15-66d87728d2e8",
                                                "text": "Peter kam um 12 Uhr. Maria kam früher und war schon um 10 Uhr da."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c70f15ba-98b2-3fbc-bfa5-dea9b44f35d5",
                                        "entry_id": "77c8825d-5570-3dea-9e87-58abd10cdf5b",
                                        "glosses": [
                                            "in der Vergangenheit liegend"
                                        ],
