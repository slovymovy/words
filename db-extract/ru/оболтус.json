                ],
                "senses": [
                    {
                        "sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                        "entry_id": "aa93da07-7178-3d1a-ba07-68f0e892f12e",
                        "glosses": [
                            "прост., пренебр. шутл. глупый, ленивый человек, бездельник"
                        ],
                        "tags": [
                            "или"
                        ],
                        "examples": [
                            {
                                "example_id": "30614586-5e4f-4fab-a55b-94a1869d113e",
                                "sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                                "text": "У меня до сих пор есть сильное подозрение, что Вера Акимовна все прекрасно понимала и она нам позволяла подмену, зная: уж троечку как-нибудь поставит нам, оболтусам тупым."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "584d2beb-765a-4d86-aebb-042321b2a10d",
                        "source_entry_id": "aa93da07-7178-3d1a-ba07-68f0e892f12e",
                        "source_sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                        "target_lang_word": "blockhead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blockhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "096abeb8-0f4b-3e87-a848-8812f2197684",
                                        "entry_id": "384a6bd8-8499-3df3-96a0-db2e16c46579",
                                        "glosses": [
                                            "A stupid person."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90ea7249-b69b-48e1-9eee-8de9902edde7",
                                                "sense_id": "096abeb8-0f4b-3e87-a848-8812f2197684",
                                                "text": "[S]o I think, blockheads, ſaid Manfred; what is it has ſcared you thus?"
                                            },
                                            {
                                                "example_id": "d256810d-ca5b-4e05-8499-63466f721c22",
                                                "sense_id": "096abeb8-0f4b-3e87-a848-8812f2197684",
                                                "text": "[…]like a conceited mechanic in a village ale-house, you would set down every one who differs from you as an ignorant blockhead[…]"
                                            },
                                            {
                                                "example_id": "01423ced-e688-438a-af31-de6348c24610",
                                                "sense_id": "096abeb8-0f4b-3e87-a848-8812f2197684",
                                                "text": "\"What a blockhead that Charlie Brown is!\""
                                            },
                                            {
                                                "example_id": "fab0ec9b-2d6d-478b-86ed-d46834640435",
                                                "sense_id": "096abeb8-0f4b-3e87-a848-8812f2197684",
                                                "text": "Not all of them, by no means anywhere close to all of them, just the most notable blockheads among them — three altogether, two freshmen and one sophomore, all of whom were among the first to be expelled the next day — masturbated into pairs of stolen panties[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "084ad503-20e4-3a4e-bf7f-5ffe26b18ab9",
                                        "entry_id": "384a6bd8-8499-3df3-96a0-db2e16c46579",
                                        "glosses": [
                                            "Short for human blockhead"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74eca086-665f-4b7c-bab2-c326a10bdb2a",
                                                "sense_id": "084ad503-20e4-3a4e-bf7f-5ffe26b18ab9",
                                                "text": "Waldo was sent that from an elderly blockhead named Fuzzy in Gibtown, Florida. That's the town to which most freaks retire."
                                            },
                                            {
                                                "example_id": "b073ad63-b1d1-4473-bdf7-a01136c56291",
                                                "sense_id": "084ad503-20e4-3a4e-bf7f-5ffe26b18ab9",
                                                "text": "He is a classic sideshow performer, entertaining crowds with feats such as sword swallowing, fire-eating, and chainsaw juggling. His specialty, however, is the human blockhead act, hammering six-inch nails up his nostrils."
                                            },
                                            {
                                                "example_id": "d1abcf0a-7b42-46f1-86ac-3c2c8f4838e1",
                                                "sense_id": "084ad503-20e4-3a4e-bf7f-5ffe26b18ab9",
                                                "text": "Burkhardt was a legendary figure in the sideshow world, a mentor and instructor to a new generation of blockheads and other working acts who now train in private classes at Coney Island USA's Sideshow School with Burkhardt's disciple Todd Robbins (Zigun 2006)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blockhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36583f27-d411-39d9-9cab-4726d4ab610c",
                                        "entry_id": "44c642b6-5e38-36c1-a381-dafba372ddcb",
                                        "glosses": [
                                            "To perform as a human blockhead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3beb613f-f295-4beb-ab0c-6b6f4ac2ff72",
                                                "sense_id": "36583f27-d411-39d9-9cab-4726d4ab610c",
                                                "text": "Like an old-time sideshow, the acts included lying on a bed of nails, blockheading and, of course, fire-eating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df8752c-dbea-3884-af0a-8a48caea546d",
                                        "entry_id": "44c642b6-5e38-36c1-a381-dafba372ddcb",
                                        "glosses": [
                                            "To behave in a stupid manner."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed07a030-218b-4906-9f54-8b23fb10deb6",
                                                "sense_id": "2df8752c-dbea-3884-af0a-8a48caea546d",
                                                "text": "Two years' blockading made fair Malta ours: A noble struggle! -- yet 't is thought (at Rading) That Britain's island shews superior pow'rs, To bear, and to survive, two years blockheading !"
                                            },
                                            {
                                                "example_id": "55673eda-e087-4665-9b7f-8d79a8e6724a",
                                                "sense_id": "2df8752c-dbea-3884-af0a-8a48caea546d",
                                                "text": "I have blockheading and boxing enough at Master Lovell's, I won't have it repeated here; and in a great passion, I threw the Virgil at his head, hit him in the face, and bruised his lip, and ran away."
                                            },
                                            {
                                                "example_id": "949c8adf-18ef-4c4f-b78d-0668ef34e0ad",
                                                "sense_id": "2df8752c-dbea-3884-af0a-8a48caea546d",
                                                "text": "The operation of blockheading is much the same as that of beheading, which Charles I underwent. In both the head is severed from the body. The body goes around without benefit of head. The victim becomes a Headless Horseman, or that more common figure a Headless Pedestrian. In our day the operation is often done not on an executioner's block but on Paradise Avenue in Suburbia Manor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65e50ffa-c3c9-4079-adea-428efbbc69e8",
                        "source_entry_id": "aa93da07-7178-3d1a-ba07-68f0e892f12e",
                        "source_sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                        "target_lang_word": "dunce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dunce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                        "entry_id": "3cd3baac-7d18-3eef-b6f3-7ed9f263d05e",
                                        "glosses": [
                                            "An unintelligent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0466390a-d851-4540-9179-117f9d9d281d",
                                                "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                                "text": "When a true genius appears in the world you may know him by this sign; that the dunces are all in confederacy against him."
                                            },
                                            {
                                                "example_id": "32bda1bc-54fe-4653-945a-f4d96500ee52",
                                                "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                                "text": "[...] Dunce, / Dotard, a-dozing at the very nonce, / After a life spent training for the sight!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bde6a3fb-b76c-46be-bfc5-022cb86185d8",
                        "source_entry_id": "aa93da07-7178-3d1a-ba07-68f0e892f12e",
                        "source_sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                        "target_lang_word": "booby",
