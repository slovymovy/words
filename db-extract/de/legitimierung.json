                                                "sense_id": "dfcf48b9-6096-31e4-a063-3a54f4d55bf3",
                                                "text": "I am not Sir Roberts sonne, / I haue disclaim'd Sir Robert and my land, / Legitimation, name, and all is gone […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b606ed04-9e92-3037-9379-76b4f525ffc5",
                                        "entry_id": "16e8176c-3422-319b-94e5-2a6caee959dc",
                                        "glosses": [
                                            "The act of establishing something as lawful; authorization."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb44272c-9196-42de-b941-20b2ebf0abdd",
                                                "sense_id": "b606ed04-9e92-3037-9379-76b4f525ffc5",
                                                "text": "Le Paige established a legitimation for the Parlement's authority which was part history, part romantic fiction, and part political wishful thinking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
