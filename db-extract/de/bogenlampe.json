                            {
                                "example_id": "980e3516-e5d9-4e0a-bf11-7697473cc26c",
                                "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
                                "text": "„[…], im Gegenzug brachte Lex den Herbstmeister mit einer Bogenlampe aus rund 25 Metern in Führung.“"
                            },
                            {
                                "example_id": "06a0814f-ebe7-48db-af02-c8fce89d4d45",
                                "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
                                "text": "[…] „Nach einer Bogenlampe von Pieringer an die Latte staubte Heuer zur erneuten Führung ab.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
