                    },
                    {
                        "translation_id": "fff5ffaa-3870-4074-91a1-a6dfac8a537c",
                        "source_entry_id": "2e8d3507-9628-3e0e-b0af-7d3fdeaa96c1",
                        "target_lang_word": "покров",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "покров",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "651843cf-14f9-37e9-8f76-76a8926dab82",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "верхний наружный слой, покрывающий что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e750f981-35aa-4497-8f54-bf52249e2f81",
                                                "sense_id": "651843cf-14f9-37e9-8f76-76a8926dab82",
                                                "text": "На всём лежал холодный матовый покров ещё падавшей, не освещённой солнцем росы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "анат. оболочка, покрывающая организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e330841a-fc49-4e1e-aad0-23757af5b860",
                                                "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                                "text": "Волосяной покров"
                                            },
                                            {
                                                "example_id": "e4fabef7-b4c3-4a10-8613-85369a07ca0f",
                                                "sense_id": "ac485588-e247-3f9d-a8f0-b2ea65adb72d",
                                                "text": "Для зрелой кожи выбирайте маску с лифтинговым действием, чтобы укрепить и поддержать кожный покров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd69cc6-350e-36ff-a227-2ccd59a66929",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. покровительство, защита"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce359f4-8a22-4079-bd34-ade0867975e2",
                                                "sense_id": "dcd69cc6-350e-36ff-a227-2ccd59a66929",
                                                "text": "Мальчишки разогнали псов, // Взяв барышню под свой покров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4501fb7b-febf-3e5b-9ae4-f8bfa1f3a7dc",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. то же, что покрывало"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b908561-d84f-467b-8171-d53df83ed6c8",
                                                "sense_id": "4501fb7b-febf-3e5b-9ae4-f8bfa1f3a7dc",
                                                "text": "Иудушка притворялся чуть живым, шаркал по коридору, заходил к «покойничку», умилялся, поправлял на гробе покров и шептался с становым приставом, который составлял описи и прикладывал печати."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4013c49b-c6e5-303e-b885-d62b95fe4b08",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "устар. большой платок, которым покрывают голову невесты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0be732-68f0-47c5-a5e6-7d653a56e54c",
                                                "sense_id": "4013c49b-c6e5-303e-b885-d62b95fe4b08",
                                                "text": "Покров богат — парчу вы рассмотрели? // У брата моего прошедшею весной // На гробе был точь-в-точь такой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                        "entry_id": "6bbea875-0787-3585-9457-9baca1f82edd",
                                        "glosses": [
                                            "то, что укрывает собою что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e886ae-6522-432a-9b87-af160fe5fe2f",
                                                "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                                "text": "Под покровом тайны"
                                            },
                                            {
                                                "example_id": "f285d48b-50de-4fce-9103-a289746fe123",
                                                "sense_id": "54c2630d-4549-33c8-a404-c61d8ad70026",
                                                "text": "Под покровом ночи"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
