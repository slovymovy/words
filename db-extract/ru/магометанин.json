                        ],
                        "form": "магомета́нах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                        "entry_id": "f71677dc-8da9-3877-ba3b-2e11e0016c05",
                        "glosses": [
                            "то же, что мусульманин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda274db-554d-40ce-b6db-1d70b2b770ba",
                                "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                                "text": "Вина как верующий магометанин он не пил, и каждый раз передавал свой кубок кому-либо из почётнейших гостей."
                            },
                            {
                                "example_id": "229c0c80-19fc-4100-8c0c-c3b8dad36e18",
                                "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                                "text": "Он подчеркнул, что для магометан всякая гробница священна, но гробница воина, сражавшегося за своё отечество, особо священна, какой бы веры ни был этот воин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef0740b2-855c-4bc9-90d5-eb200e87a5a0",
                        "source_entry_id": "f71677dc-8da9-3877-ba3b-2e11e0016c05",
                        "source_sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
