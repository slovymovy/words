{
    "word_family": [
        "debug",
        "debugger",
        "buggy",
        "bedbug",
        "litterbug",
        "shutterbug"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "542ed9d5-68ea-3fc6-aa34-e14b2255834b",
                    "sense_definition": "A small insect or similar creeping animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "living_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a huge <w>bug</w> crawling on the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "По полу на кухне ползает огромный <w>жук</w>.",
                                "tr": "Mutfak zemininde sürünen kocaman bir <w>böcek</w> var.",
                                "zh": "厨房地板上爬着一只巨大的<w>虫子</w>。"
                            }
                        },
                        {
                            "text": "We need to buy some <w>bug</w> spray before we go camping.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить спрей от <w>насекомых</w>, прежде чем мы отправимся в поход.",
                                "tr": "Kampa gitmeden önce <w>böcek</w> ilacı almamız gerekiyor.",
                                "zh": "去露营前我们需要买些杀<w>虫子</w>的喷雾。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bug spray",
                        "bed bug",
                        "lightning bug",
                        "big bug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое насекомое или жук.",
                        "tr": "Küçük bir böcek veya benzeri sürüngen hayvan.",
                        "zh": "一种小昆虫或类似的小动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насекомое",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "букашка",
                                "target_lang_sense_clarification": "разговорное, маленькое насекомое"
                            },
                            {
                                "target_lang_word": "жук",
                                "target_lang_sense_clarification": "часто используется в общем смысле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "böcek",
                                "target_lang_sense_clarification": "genel terim"
                            },
                            {
                                "target_lang_word": "haşere",
                                "target_lang_sense_clarification": "zararlı küçük hayvanlar için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昆虫",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "虫子",
                                "target_lang_sense_clarification": "口语，指小虫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadcd01f-0e99-36dd-b295-1b16b47b482b",
                    "sense_definition": "A mistake or fault in a computer program or system that prevents it from working correctly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology_fault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer worked late to fix a critical <w>bug</w> in the software.",
                            "target_lang_translations": {
                                "ru": "Разработчик работал допоздна, чтобы исправить критическую <w>ошибку</w> в программе.",
                                "tr": "Yazılımcı, yazılımdaki kritik bir <w>hatayı</w> düzeltmek için geç saatlere kadar çalıştı.",
                                "zh": "开发人员工作到很晚，以修复软件中一个严重的<w>程序错误</w>。"
                            }
                        },
                        {
                            "text": "This computer game is full of <w>bugs</w> that make it crash constantly.",
                            "target_lang_translations": {
                                "ru": "В этой компьютерной игре полно <w>багов</w>, из-за которых она постоянно вылетает.",
                                "tr": "Bu bilgisayar oyunu, sürekli çökmesine neden olan <w>hatalarla</w> dolu.",
                                "zh": "这款电脑游戏充满了导致它不断崩溃的<w>漏洞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "glitch",
                        "error",
                        "fault"
                    ],
                    "common_phrases": [
                        "software bug",
                        "fix a bug",
                        "computer bug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибка или сбой в компьютерной программе или системе.",
                        "tr": "Bir bilgisayar programında veya sisteminde düzgün çalışmasını engelleyen hata veya kusur.",
                        "zh": "计算机程序或系统中的错误或故障，导致其无法正常工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "в программе"
                            },
                            {
                                "target_lang_word": "баг",
                                "target_lang_sense_clarification": "компьютерный сленг"
                            },
                            {
                                "target_lang_word": "глюк",
                                "target_lang_sense_clarification": "сленг, сбой в работе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hata",
                                "target_lang_sense_clarification": "yazılımda genel terim"
                            },
                            {
                                "target_lang_word": "bug",
                                "target_lang_sense_clarification": "teknik terim olarak yaygın kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程序错误",
                                "target_lang_sense_clarification": "正式用语"
                            },
                            {
                                "target_lang_word": "漏洞",
                                "target_lang_sense_clarification": "指系统缺陷"
                            },
                            {
                                "target_lang_word": "程序缺陷",
                                "target_lang_sense_clarification": "技术用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f094f721-1975-3b4c-846d-930fd917c290",
                    "sense_definition": "A mild contagious illness, usually caused by a virus or bacteria.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Half the class is absent today because of a stomach <w>bug</w>.",
                            "target_lang_translations": {
                                "ru": "Половина класса сегодня отсутствует из-за желудочного <w>вируса</w>.",
                                "tr": "Mide <w>virüsü</w> nedeniyle bugün sınıfın yarısı yok.",
                                "zh": "今天班里有一半人因为肠胃<w>病毒</w>没来上课。"
                            }
                        },
                        {
                            "text": "I think I caught a <w>bug</w> from someone at the office.",
                            "target_lang_translations": {
                                "ru": "Кажется, я подхватил какой-то <w>вирус</w> от кого-то в офисе.",
                                "tr": "Sanırım ofisteki birinden bir <w>virüs</w> kaptım.",
                                "zh": "我想我是从办公室的某人那里<w>感染</w>了病毒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomach bug",
                        "flu bug",
                        "catch a bug"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in casual conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое инфекционное заболевание, обычно вызванное вирусом.",
                        "tr": "Genellikle virüs veya bakterilerin neden olduğu hafif, bulaşıcı bir hastalık.",
                        "zh": "一种轻微的传染性疾病，通常由病毒或细菌引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вирус",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "инфекция",
                                "target_lang_sense_clarification": "заболевание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "virüs",
                                "target_lang_sense_clarification": "hastalık anlamında"
                            },
                            {
                                "target_lang_word": "enfeksiyon",
                                "target_lang_sense_clarification": "tıbbi terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "病毒",
                                "target_lang_sense_clarification": "口语，指小病"
                            },
                            {
                                "target_lang_word": "感染",
                                "target_lang_sense_clarification": "指病原体入侵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67424d4f-7d68-37b5-a6b7-a99db3d701e9",
                    "sense_definition": "A small hidden electronic device used for secretly listening to conversations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spy_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy planted a <w>bug</w> under the diplomat's desk.",
                            "target_lang_translations": {
                                "ru": "Шпион установил <w>жучок</w> под столом дипломата.",
                                "tr": "Casus, diplomatın masasının altına bir <w>dinleme cihazı</w> yerleştirdi.",
                                "zh": "间谍在外交官的桌子下安装了一个<w>窃听器</w>。"
                            }
                        },
                        {
                            "text": "They swept the room for <w>bugs</w> before discussing the secret plan.",
                            "target_lang_translations": {
                                "ru": "Они проверили комнату на наличие <w>жучков</w> перед обсуждением секретного плана.",
                                "tr": "Gizli planı tartışmadan önce odayı <w>dinleme cihazlarına</w> karşı taradılar.",
                                "zh": "在讨论秘密计划之前，他们对房间进行了<w>窃听器</w>排查。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plant a bug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытое электронное устройство для подслушивания разговоров.",
                        "tr": "Konuşmaları gizlice dinlemek için kullanılan küçük, gizli elektronik cihaz.",
                        "zh": "用于秘密窃听谈话的小型隐藏电子设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жучок",
                                "target_lang_sense_clarification": "шпионское устройство"
                            },
                            {
                                "target_lang_word": "прослушка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "böcek",
                                "target_lang_sense_clarification": "dinleme cihazı için argo"
                            },
                            {
                                "target_lang_word": "dinleme cihazı",
                                "target_lang_sense_clarification": "resmi terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窃听器",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9044a81-2c47-3800-b4fa-ce2f458c5415",
                    "sense_definition": "A nickname for the Volkswagen Beetle car.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather used to drive an old yellow <w>Bug</w> in the sixties.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка ездил на старом желтом <w>Жуке</w> в шестидесятых.",
                                "tr": "Dedem altmışlı yıllarda eski sarı bir <w>vosvos</w> kullanırdı.",
                                "zh": "我祖父在六十年代曾开过一辆旧的黄色<w>甲壳虫</w>。"
                            }
                        },
                        {
                            "text": "She wants to buy a convertible <w>Bug</w> for her first car.",
                            "target_lang_translations": {
                                "ru": "Она хочет купить <w>Жук</w>-кабриолет в качестве своей первой машины.",
                                "tr": "İlk arabası olarak üstü açılır bir <w>vosvos</w> almak istiyor.",
                                "zh": "她想买一辆敞篷<w>甲壳虫</w>作为她的第一辆车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Beetle"
                    ],
                    "common_phrases": [
                        "VW Bug",
                        "punch buggy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "referring to the car model"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище автомобиля Volkswagen Beetle.",
                        "tr": "Volkswagen Beetle otomobili için kullanılan takma ad.",
                        "zh": "大众甲壳虫汽车的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Жук",
                                "target_lang_sense_clarification": "модель автомобиля"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "vosvos",
                                "target_lang_sense_clarification": "Türkiye'de Beetle için kullanılan yaygın isim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甲壳虫",
                                "target_lang_sense_clarification": "汽车型号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ba19c7-58dc-3172-a220-a2cee3d6862c",
                    "sense_definition": "A strong enthusiasm or obsession for a particular activity or hobby.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once you get the travel <w>bug</w>, you will never want to stay in one place.",
                            "target_lang_translations": {
                                "ru": "Как только вы заразитесь <w>страстью</w> к путешествиям, вы никогда не захотите сидеть на одном месте.",
                                "tr": "Seyahat <w>tutkusuna</w> bir kez kapıldığında, asla tek bir yerde kalmak istemeyeceksin.",
                                "zh": "一旦你对旅行产生了<w>热衷</w>，你就再也不想待在一个地方了。"
                            }
                        },
                        {
                            "text": "He caught the acting <w>bug</w> after performing in a school play.",
                            "target_lang_translations": {
                                "ru": "Он заразился <w>манией</w> актерства после выступления в школьном спектакле.",
                                "tr": "Okul oyununda rol aldıktan sonra oyunculuk <w>merakına</w> kapıldı.",
                                "zh": "在学校演出后，他便对表演产生了<w>迷</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel bug",
                        "bitten by the bug"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное увлечение или одержимость каким-либо занятием.",
                        "tr": "Belirli bir aktiviteye veya hobiye karşı duyulan güçlü bir heves veya tutku.",
                        "zh": "对某项活动或爱好产生的强烈热情或痴迷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "сильное увлечение"
                            },
                            {
                                "target_lang_word": "мания",
                                "target_lang_sense_clarification": "одержимость"
                            },
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "в переносном смысле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tutku",
                                "target_lang_sense_clarification": "güçlü ilgi"
                            },
                            {
                                "target_lang_word": "merak",
                                "target_lang_sense_clarification": "bir şeye karşı duyulan ilgi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热衷",
                                "target_lang_sense_clarification": "指强烈的兴趣"
                            },
                            {
                                "target_lang_word": "迷",
                                "target_lang_sense_clarification": "指沉迷于某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22df2e94-3e87-37ac-b303-bce59cd078c2",
                    "sense_definition": "To annoy or bother someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop <w>bugging</w> me while I am trying to work.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>доставать</w> меня, пока я пытаюсь работать.",
                                "tr": "Çalışmaya çalışırken lütfen beni <w>rahatsız etmeyi</w> bırak.",
                                "zh": "我工作时请不要<w>打扰</w>我。"
                            }
                        },
                        {
                            "text": "It really <w>bugs</w> me when people leave the lights on.",
                            "target_lang_translations": {
                                "ru": "Меня реально <w>бесит</w>, когда люди оставляют свет включенным.",
                                "tr": "İnsanların ışıkları açık bırakması beni gerçekten <w>kızdırıyor</w>.",
                                "zh": "人们离开时如果不关灯，真的很让我<w>烦</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop bugging me",
                        "bug someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать или надоедать кому-то.",
                        "tr": "Birini rahatsız etmek veya bunaltmak.",
                        "zh": "打扰或烦扰某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставать",
                                "target_lang_sense_clarification": "сленг, надоедать"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "докучать"
                            },
                            {
                                "target_lang_word": "бесить",
                                "target_lang_sense_clarification": "сильно раздражать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rahatsız etmek",
                                "target_lang_sense_clarification": "genel kullanım"
                            },
                            {
                                "target_lang_word": "kızdırmak",
                                "target_lang_sense_clarification": "sinirlendirmek"
                            },
                            {
                                "target_lang_word": "bunaltmak",
                                "target_lang_sense_clarification": "sürekli rahatsız etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打扰",
                                "target_lang_sense_clarification": "通用"
                            },
                            {
                                "target_lang_word": "烦",
                                "target_lang_sense_clarification": "口语，使人厌烦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d4bf3c-240e-33e5-8bbf-fd5f01eb0dd3",
                    "sense_definition": "To hide a microphone in a room or device to listen to conversations secretly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spy_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police decided to <w>bug</w> the suspect's phone to gather evidence.",
                            "target_lang_translations": {
                                "ru": "Полиция решила <w>поставить жучок</w> на телефон подозреваемого, чтобы собрать улики.",
                                "tr": "Polis, delil toplamak için şüphelinin telefonuna <w>dinleme cihazı</w> yerleştirmeye karar verdi.",
                                "zh": "警方决定在嫌疑人的手机上<w>安装窃听器</w>以收集证据。"
                            }
                        },
                        {
                            "text": "He was paranoid that his entire house had been <w>bugged</w>.",
                            "target_lang_translations": {
                                "ru": "У него была паранойя, что весь его дом <w>напичкан жучками</w>.",
                                "tr": "Tüm evinin <w>dinleme cihazlarıyla</w> donatıldığı konusunda paranoyaktı.",
                                "zh": "他总担心自己的整个房子都被<w>安装了窃听器</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bug a room",
                        "bug a phone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать скрытый микрофон для подслушивания.",
                        "tr": "Konuşmaları gizlice dinlemek için bir odaya veya cihaza mikrofon yerleştirmek.",
                        "zh": "在房间或设备中安装麦克风以秘密窃听谈话。"
                    },
                    "translations": {
                        "ru": [
                            {
