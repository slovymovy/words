                                                "sense_id": "80f4f3bb-e5ea-3dcc-b1f7-2064fe92e544",
                                                "text": "Students attended a seminar on climate change."
                                            },
                                            {
                                                "example_id": "be98b055-f276-406a-bdb7-8fab2684c556",
                                                "sense_id": "80f4f3bb-e5ea-3dcc-b1f7-2064fe92e544",
                                                "text": "She gave a guest lecture during the philosophy seminar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d92773-1a3a-3cca-adbe-338be387d770",
                                        "entry_id": "04f21e08-51ff-340a-a420-71e4f8bb89d9",
                                        "glosses": [
                                            "A meeting held for the exchange of useful information by members of a common business community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3080ce48-9f2b-4b46-acb4-278397cc214f",
                                                "sense_id": "a6d92773-1a3a-3cca-adbe-338be387d770",
                                                "text": "The company hosted a training seminar for new employees."
                                            }
                                        ]
                                    }
