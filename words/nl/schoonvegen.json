    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22421779-9f2b-3b94-ae82-70b773a7f721",
                    "sense_definition": "iets met een bezem, borstel of doek schoonmaken door het vuil weg te vegen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>veegde</w> de stoep voor het huis grondig <w>schoon</w> met een bezem.",
                            "target_lang_translations": {
                                "fr": "Il <w>a balayé</w> soigneusement le trottoir devant la maison avec un balai."
                            }
                        },
                        {
                            "text": "Kun je alsjeblieft de tafel even <w>schoonvegen</w> voordat we gaan eten?",
                            "target_lang_translations": {
                                "fr": "Peux-tu s'il te plaît <w>essuyer</w> la table avant qu'on mange ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "afvegen",
                        "reinigen",
                        "wegvegen"
                    ],
                    "common_phrases": [
                        "de stoep schoonvegen",
                        "de tafel schoonvegen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Nettoyer une surface à l'aide d'un balai, d'une brosse ou d'un chiffon en retirant la saleté."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "balayer",
                                "target_lang_sense_clarification": "avec un balai"
                            },
                            {
                                "target_lang_word": "essuyer",
                                "target_lang_sense_clarification": "avec un chiffon ou une éponge"
                            },
                            {
                                "target_lang_word": "nettoyer",
                                "target_lang_sense_clarification": "terme général"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "051412bc-9acf-3d7e-a99c-03a502aba0f5",
                    "sense_definition": "een groep mensen of publiek met dwang of geweld verwijderen uit een gebied",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ontruimen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie besloot het plein met geweld <w>schoon</w> te <w>vegen</w> na de rellen.",
                            "target_lang_translations": {
                                "fr": "La police a décidé d'<w>évacuer</w> la place par la force après les émeutes."
                            }
                        },
                        {
                            "text": "De mobiele eenheid <w>veegde</w> de hele straat in korte tijd <w>schoon</w>.",
                            "target_lang_translations": {
                                "fr": "Les forces anti-émeute <w>ont nettoyé</w> toute la rue en peu de temps."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de straat schoonvegen",
                        "het plein schoonvegen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Évacuer ou dégager une foule ou un groupe de personnes d'un lieu par la force ou la contrainte."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "évacuer",
                                "target_lang_sense_clarification": "dégager un lieu par la force"
                            },
                            {
                                "target_lang_word": "nettoyer",
                                "target_lang_sense_clarification": "au sens figuré, dégager un lieu de manifestants ou d'émeutiers"
                            },
                            {
                                "target_lang_word": "dégager",
                                "target_lang_sense_clarification": "libérer un espace occupé"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}