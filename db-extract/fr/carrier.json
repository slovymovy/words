                                "target_senses": [
                                    {
                                        "sense_id": "b439c38d-22c1-393b-9339-ed6945cbe7c6",
                                        "entry_id": "7a107594-02ef-3a6e-bc73-f6296a56cf34",
                                        "glosses": [
                                            "A man involved in quarrying (mining for stone)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98371970-20e3-4cf3-b70f-248f20143c45",
                                                "sense_id": "b439c38d-22c1-393b-9339-ed6945cbe7c6",
                                                "text": "Many of its cottages were built for quarrymen when local workings provided limestone for the great 19th-century ironworks at Nantyglo."
                                            },
                                            {
                                                "example_id": "8f395c9b-874e-4088-bf45-446399cec241",
                                                "sense_id": "b439c38d-22c1-393b-9339-ed6945cbe7c6",
                                                "text": "He then described how a quarryman had bought the mineral rights of an estate at Melkridge, on the route of the Roman Wall, for twenty-one years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
