                    "common_phrases": [
                        "actief burgerschap",
                        "goed burgerschap",
                        "democratisch burgerschap"
                    ],
                    "target_lang_definitions": {
                        "en": "The active involvement and responsibility of an individual within a society."
                    },
                    "translations": {
