                                    {
                                        "sense_id": "056332a2-f24d-3d28-8372-c42e0fd5b428",
                                        "entry_id": "8c6ee0b4-a072-3a68-a571-4922bcefe28c",
                                        "glosses": [
                                            "Out of date, old-fashioned, antiquated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92181c9f-96a0-43fe-b1fc-ee5dbcb33b04",
                                                "sense_id": "056332a2-f24d-3d28-8372-c42e0fd5b428",
                                                "text": "His outdated wordprocessing software could not read the files I sent."
                                            },
                                            {
                                                "example_id": "51fa47a7-7980-407f-976a-bb443abf87cf",
                                                "sense_id": "056332a2-f24d-3d28-8372-c42e0fd5b428",
                                                "text": "For example, by changing the use of existing rooms, removing or replacing unsightly features, clearing obstacles to easy circulation, rearranging direction signs and generally introducing as much order as possible, most outdated station buildings can be made reasonably efficient and attractive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994b37de-baad-32df-8f11-cf6849179faf",
                                        "entry_id": "8c6ee0b4-a072-3a68-a571-4922bcefe28c",
                                        "glosses": [
                                            "Out of date; not the latest; obsolete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a401c1-dd2e-467e-bb06-fa6fe8106eb4",
                                                "sense_id": "994b37de-baad-32df-8f11-cf6849179faf",
                                                "text": "Your version of the document is outdated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bef906bc-276c-49d2-bcf9-bf401e186919",
                        "source_entry_id": "fa1780d4-74b8-3a3f-b6fd-28692373116d",
                        "source_sense_id": "31280278-56e6-38d8-8177-d27bb343521e",
                        "target_lang_word": "outmoded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outmoded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa399827-6765-3d44-8d51-c507069701bb",
                                        "entry_id": "27f19f16-2b64-3942-aee8-74da782e9a47",
                                        "glosses": [
                                            "Unfashionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3449c46b-0d9e-4083-81c6-08bf1c735ef6",
                                                "sense_id": "aa399827-6765-3d44-8d51-c507069701bb",
                                                "text": "His pipe was as outmoded as his ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661b0cd2-712a-38bf-8b0d-e59b205ae23c",
                                        "entry_id": "27f19f16-2b64-3942-aee8-74da782e9a47",
                                        "glosses": [
                                            "Obsolete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2568c4-663a-413c-98c1-b24a6a287420",
                                                "sense_id": "661b0cd2-712a-38bf-8b0d-e59b205ae23c",
                                                "text": "His outmoded word processor was a heap of junk."
                                            },
                                            {
                                                "example_id": "92eef769-e3cb-4511-9c03-672e14fd3ae7",
                                                "sense_id": "661b0cd2-712a-38bf-8b0d-e59b205ae23c",
                                                "text": "His outmoded record player is now useless."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outmoded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "149f6d49-01c0-3acf-b4a4-390061614353",
                                        "entry_id": "a64115a7-db0d-34db-b35b-19e94c04d97f",
