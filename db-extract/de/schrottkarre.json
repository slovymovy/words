                                        "glosses": [
                                            "An old, neglected vehicle, usually a car, a freighter, or a truck."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffb376e-7e4b-43f9-8caa-fab6e345e869",
                                                "sense_id": "e554a825-490e-39f2-80a7-cdde892db144",
                                                "text": "That sagging old rustbucket is designed like a garbage scow!"
                                            }
