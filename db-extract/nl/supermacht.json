                    {
                        "sense_id": "dd6c90c4-ef23-3efc-8eb7-1bb04d421c75",
                        "entry_id": "13fc2c50-da86-3df9-bb76-cc36700df2f3",
                        "glosses": [
                            "een staat die zoveel macht heeft dat ze de wereldpolitiek beslissend kan beïnvloeden"
                        ],
                        "tags": [],
