    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                    "sense_definition": "het onvermogen om iets te doen of te veranderen, vaak gepaard gaand met frustratie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "powerlessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij schreeuwde luidkeels uit pure woede en <w>onmacht</w>.",
                            "target_lang_translations": {
                                "en": "She screamed loudly out of pure anger and <w>powerlessness</w>."
                            }
                        },
                        {
                            "text": "De burgers voelden een grote <w>onmacht</w> tegenover de nieuwe wetgeving.",
                            "target_lang_translations": {
                                "en": "The citizens felt a great <w>helplessness</w> regarding the new legislation."
                            }
                        }
                    ],
                    "synonyms": [
                        "machteloosheid"
                    ],
                    "antonyms": [
                        "macht"
                    ],
                    "common_phrases": [
                        "woede en onmacht",
                        "gevoel van onmacht"
                    ],
                    "target_lang_definitions": {
                        "en": "the inability to do or change something, often accompanied by frustration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "powerlessness",
                                "target_lang_sense_clarification": "the state of having no power or control"
                            },
                            {
                                "target_lang_word": "helplessness",
                                "target_lang_sense_clarification": "the feeling of being unable to help oneself or act"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "337d7627-0c90-3a29-abdf-a442358b7c99",
                    "sense_definition": "een toestand waarin men niet meer bij bewustzijn is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unconsciousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de harde klap tegen zijn hoofd viel de bokser in <w>onmacht</w>.",
                            "target_lang_translations": {
                                "en": "After the hard blow to his head, the boxer fell into <w>unconsciousness</w>."
                            }
                        },
                        {
                            "text": "Zij zakte in <w>onmacht</w> door de extreme hitte in de kamer.",
                            "target_lang_translations": {
                                "en": "She <w>fainted</w> due to the extreme heat in the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewusteloosheid",
                        "bezwijming"
                    ],
                    "common_phrases": [
                        "in onmacht vallen"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of being unconscious or losing consciousness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unconsciousness",
                                "target_lang_sense_clarification": "the state of being not awake or aware"
                            },
                            {
                                "target_lang_word": "faint",
                                "target_lang_sense_clarification": "a sudden loss of consciousness"
                            },
                            {
                                "target_lang_word": "swoon",
                                "target_lang_sense_clarification": "a literary term for a fainting fit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
