                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63cea1f2-f097-3c3f-ab0f-dbe33e599845",
                        "entry_id": "65786910-50c5-3133-86ed-7d74969439be",
                        "glosses": [
                            "Fabelwesen mit dem Vorderteil eines Pferdes und dem Hinterteil eines Fisches oder einer Seeschlange"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af9f7b6-3c9b-4f9b-bc7b-6f48c0fad22f",
                                "sense_id": "63cea1f2-f097-3c3f-ab0f-dbe33e599845",
                                "text": "Das Seepferd ist das Reittier verschiedener Meeresgötter."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3756f6d1-9ed5-3b0f-b553-3196c5173e16",
