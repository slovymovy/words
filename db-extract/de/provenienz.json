                        "form": "die Provenienzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                        "entry_id": "700b3aed-24f7-34ef-9559-b88351a73872",
                        "glosses": [
                            "Herkunft, Ursprung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c3fe0d-2496-4632-b960-42a012619a6a",
                                "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                                "text": "„Ich unterließ es absichtlich, die Provenienz der mitgeteilten Gesänge anzugeben. Bei der Freizügigkeit des heutigen Bauernburschen ist die ursprüngliche Herkunft seiner Lieder schwer nachweisbar.“"
                            },
                            {
                                "example_id": "39cce6a5-0a37-4141-b6b6-fb75d5be1744",
                                "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                                "text": "„Es wäre schier unmöglich, alle Handelsartikel pflanzlicher oder tierischer Provenienz aufzuzählen, die aus Asien oder Ägypten nach Europa importiert wurden.“"
                            },
                            {
                                "example_id": "4273b638-468f-4b2d-aedb-94f2c22b419b",
                                "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                                "text": "„Sie selber sagten mir ja, daß man bei Altertümern zuerst nach der Provenienz fragen müsse. Nun gut! die Provenienz ist hier für mich entscheidend und der Vorzug der Provenienz jener beiden Stücke vor allen andern Herrlichkeiten des Museums besteht für mich darin, daß sie von Fräulein Hermine Aweling herrühren.“"
                            },
                            {
                                "example_id": "ecc47a40-e6b2-4575-9740-01eba56ca061",
                                "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                                "text": "„Bei diesen Themen und diesem Plot könnte man annehmen, es handle sich um ein realistisches Drama nach der Art des Naturalismus oder um ein psychologisches und sozialkritisches Stück des ausgehenden 19. Jahrhunderts Schnitzler'scher Provenienz.“"
                            },
                            {
                                "example_id": "0597c732-73c6-4456-9dd1-20fdd35a4672",
                                "sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                                "text": "Ein Teppich bester Provenienz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2d7db0f-ce53-4173-88e4-4acd4ec9d443",
                        "source_entry_id": "700b3aed-24f7-34ef-9559-b88351a73872",
                        "source_sense_id": "5078795f-ae15-38c9-9f3e-679ce9c46633",
                        "target_lang_word": "provenance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provenance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a01e508-e4b2-36de-b7d5-683af69b6dee",
                                        "entry_id": "8adef6db-8c71-3131-a82e-506ff4cf59ae",
                                        "glosses": [
                                            "Place or source of origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b093dd4-2e6c-4758-a919-6d8490ec598f",
                                                "sense_id": "9a01e508-e4b2-36de-b7d5-683af69b6dee",
                                                "text": "Many supermarkets display the provenance of their food products."
                                            },
                                            {
                                                "example_id": "80387186-9675-4342-921a-f5221c69ecb0",
                                                "sense_id": "9a01e508-e4b2-36de-b7d5-683af69b6dee",
                                                "text": "Within this melee of intersections between English and Cantonese, the students, being themselves bilingually fluent, were able to navigate with perfect ease in communicative contexts where the provenance of a certain term or expression matters little."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13c09f70-966e-34b6-bc14-fcdaaa172409",
                                        "entry_id": "8adef6db-8c71-3131-a82e-506ff4cf59ae",
                                        "glosses": [
                                            "The place and time of origin of some artifact or other object. See Usage notes below."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336d6237-9b6d-4d96-8b2b-6cce3667ae50",
                                                "sense_id": "13c09f70-966e-34b6-bc14-fcdaaa172409",
                                                "text": "This spear is of Viking provenance."
                                            },
                                            {
                                                "example_id": "c4c7da9e-c038-4dda-a72b-a5308c42b705",
                                                "sense_id": "13c09f70-966e-34b6-bc14-fcdaaa172409",
                                                "text": "Further support for the Shansi provenance came in 1965, when a bronze quadruped with identical ornamentation and of approximately the same size as the Freer example was unearthed in tomb 126, at Fen-shui-ling, Ch'ang-chih, Shansi Province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e70e0d1-0270-3e0c-842a-17b41a21c12d",
                                        "entry_id": "8adef6db-8c71-3131-a82e-506ff4cf59ae",
                                        "glosses": [
                                            "The history of ownership of a work of art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f114b54b-eb88-4b6e-90a4-5c1c1d25cb1e",
                                                "sense_id": "8e70e0d1-0270-3e0c-842a-17b41a21c12d",
                                                "text": "The picture is of royal provenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ceb63d-1ab9-346a-bae9-34a2902b933d",
                                        "entry_id": "8adef6db-8c71-3131-a82e-506ff4cf59ae",
                                        "glosses": [
                                            "The copy history of a piece of data, or the intermediate pieces of data used to compute a final data element, as in a database record or web site (data provenance)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5410bd95-2f1e-3c5c-8800-91a413e1e793",
