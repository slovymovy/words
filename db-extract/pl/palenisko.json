                    },
                    {
                        "sense_id": "3e435774-bc1f-32e8-8f92-9f034ef79145",
                        "entry_id": "645be6f8-790e-3f6d-9289-614d059ac7e4",
                        "glosses": [
                            "burner (part of a machine in which fuel is burned)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "ac9c8a7c-15eb-489a-bb21-2f13303104a4",
                                "sense_id": "3e435774-bc1f-32e8-8f92-9f034ef79145",
                                "text": "Angielski „cardiff”, kawałek sztucznego węgla z ładunkiem wybuchowym, wrzucony do węglarki, rozsadził palenisko parowozu.",
                                "translation": "An English 'cardiff', a piece of fake coal with an explosive payload, thrown into the coal box, blew up the steam locomotive's burner.",
                                "english": "An English 'cardiff', a piece of fake coal with an explosive payload, thrown into the coal box, blew up the steam locomotive's burner."
                            },
                            {
                                "example_id": "478bcce3-3bed-4660-aa1e-f3900ae2763c",
                                "sense_id": "3e435774-bc1f-32e8-8f92-9f034ef79145",
                                "text": "Sprawdzali m[iędzy] in[nymi] palenisko w piecu, bo zaszło podejrzenie, że noworodek został spalony.",
                                "translation": "They checked, among other places, the furnace's burner, because a suspicion had developed that the newborn had been burned up.",
                                "english": "They checked, among other places, the furnace's burner, because a suspicion had developed that the newborn had been burned up."
                            }
                        ]
                    }
