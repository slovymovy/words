            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46e2cfaf-ff89-3b4e-b398-e0936608f064",
                    "sense_definition": "Tirer vengeance pour une personne offensée, ou exercer des représailles contre l'auteur d'un tort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vengeance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune chevalier a promis de <w>venger</w> son frère après cette attaque injuste."
                        },
                        {
                            "text": "Il refuse la violence mais cherche toujours un moyen légal de se <w>venger</w> de ses rivaux."
                        }
                    ],
                    "antonyms": [
                        "pardonner"
                    ],
                    "common_phrases": [
                        "se venger de",
                        "venger un ami"
                    ]
                },
                {
                    "sense_id": "934393ae-b58f-376a-8ccf-deebd770dfd7",
                    "sense_definition": "Obtenir réparation violente ou morale pour un crime, un préjudice ou une injustice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vengeance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats voulaient à tout prix <w>venger</w> la mort de leur vaillant capitaine."
                        },
                        {
                            "text": "Cet homme a consacré dix ans de sa vie à <w>venger</w> un crime odieux."
                        }
                    ],
                    "synonyms": [
                        "châtier",
                        "punir"
                    ],
                    "common_phrases": [
                        "venger la mort de",
                        "venger un affront"
                    ]
                },
                {
                    "sense_id": "8919326d-ee3e-37ca-b6db-f62101b7666d",
                    "sense_definition": "Laver l'outrage fait à une valeur morale ou à une entité que l'on respecte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vengeance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diplomate a prononcé un discours passionné pour <w>venger</w> l'honneur de sa patrie."
                        },
                        {
                            "text": "Cette biographie historique permet enfin de <w>venger</w> la mémoire du poète calomnié."
                        }
                    ],
                    "synonyms": [
                        "réhabiliter"
                    ],
                    "common_phrases": [
