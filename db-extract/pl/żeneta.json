                                    {
                                        "sense_id": "e28daf94-5506-3a77-a0bc-3a855bf25464",
                                        "entry_id": "48bf2772-0422-32f4-8b5b-34c9685537ab",
                                        "glosses": [
                                            "A group of genetically identical individuals (plants, fungi, bacteria etc.) that have grown in a given location, all originating from asexual reproduction of a single ancestor; a group of ramets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "genet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9efff583-443a-3594-8e2f-b8b9cef3f13a",
                                        "entry_id": "34bc46d3-b53d-3522-830d-8ce3f25da8d3",
                                        "glosses": [
                                            "A small-sized, well-proportioned, Spanish horse; a jennet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1635314-45c7-445b-a0a5-c828e44535b0",
                                                "sense_id": "9efff583-443a-3594-8e2f-b8b9cef3f13a",
                                                "text": "Because we come to do you service and you think we are ruffians, you’ll have your daughter covered with a Barbary horse. You’ll have your nephews neigh to you. You’ll have coursers for cousins and gennets for germans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a3f53b-18cd-44a6-8e60-a0899117f7fd",
                        "source_entry_id": "3eaa246b-872b-332c-b3ed-9769d29cdc37",
                        "source_sense_id": "f33981e6-8585-342c-9cce-5a19c6d10362",
                        "target_lang_word": "genette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebfbf35b-4d39-315f-bd5a-9c7b9e6af715",
                                        "entry_id": "b938c874-d18f-39a8-b628-fba632fc0b62",
                                        "glosses": [
                                            "Espèce de viverridé proche des civettes, surtout d’Afrique, et dont la peau s’emploie en fourrures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6da769a-23f2-4c4f-ae95-4377251e36e7",
                                                "sense_id": "ebfbf35b-4d39-315f-bd5a-9c7b9e6af715",
                                                "text": "La genette qui est un animal de l'Espagne, de l'Asie mineure, etc. et qui ne se trouve que dans l'Ancien continent, ne doit pas être indiquée par le nom de coati, qui est américain, comme on le trouve dans M. Klein."
                                            },
                                            {
                                                "example_id": "43143f56-6b26-4391-881b-6425b7b16021",
                                                "sense_id": "ebfbf35b-4d39-315f-bd5a-9c7b9e6af715",
                                                "text": "Il y en a [des femmes] de hautes avec des jambes de course et des têtes de genettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2fdc7c2-132e-3a6b-89a3-ff5233b906f8",
                                        "entry_id": "b938c874-d18f-39a8-b628-fba632fc0b62",
                                        "glosses": [
                                            "Sorte de mors dont la gourmette a la forme d’un anneau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66f88b47-90ca-4339-968a-ee378ffafa6c",
                                                "sense_id": "c2fdc7c2-132e-3a6b-89a3-ff5233b906f8",
                                                "text": "Monter à la genette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afef3861-f909-31d7-ae28-6472745354d9",
                                        "entry_id": "b938c874-d18f-39a8-b628-fba632fc0b62",
                                        "glosses": [
                                            "Ordre militaire fondé par Charles-Martel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1f2babb-7179-302a-bd93-cdd1c3bf3051",
                                        "entry_id": "b938c874-d18f-39a8-b628-fba632fc0b62",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Elle est souvent confondue avec la martre (si présentée sans ses tâches) et utilisée pour construire des armes parlantes."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64687f9-755d-452c-baf9-7c1b86727506",
                                                "sense_id": "e1f2babb-7179-302a-bd93-cdd1c3bf3051",
                                                "text": "D’agent, à une tour d’azur surmontée d’une genette courante au naturel, qui est de la commune de La Gineta en Espagne (armes parlantes) → voir illustration « armoiries avec une genette »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
