                "translations": [
                    {
                        "translation_id": "63fad1bc-70da-44cf-afd6-0ea1f2365861",
                        "source_entry_id": "b5a76e18-470f-3703-a45c-cd2d7d0fd428",
                        "source_sense_description": "trick-taking card game",
                        "target_lang_word": "Skat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d4aabbf-c6e8-3800-9713-cc032eb40ce2",
                                        "entry_id": "62625834-8876-3bdb-8687-d55d0afb03f9",
                                        "glosses": [
                                            "Kartenspiel für drei Personen, bei dem in jeder Runde ein Spieler bestimmt wird, der gegen die beiden anderen spielt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b80aae7-bcce-46f6-aa70-d8e119aa3d49",
                                                "sense_id": "1d4aabbf-c6e8-3800-9713-cc032eb40ce2",
                                                "text": "In der Kneipe wird oft eine Runde Skat gespielt."
                                            },
                                            {
                                                "example_id": "f68f84a5-40ee-4428-88bd-e5a8fd952669",
                                                "sense_id": "1d4aabbf-c6e8-3800-9713-cc032eb40ce2",
                                                "text": "Skat kann man auch zu viert spielen, der Geber setzt dann aus."
                                            },
                                            {
                                                "example_id": "1bdeb304-ed8b-41f9-ab9a-6d512c4b190b",
                                                "sense_id": "1d4aabbf-c6e8-3800-9713-cc032eb40ce2",
                                                "text": "„Er brachte ihm Skat, Jass, Tarock und Poker bei; – Skat für Emigranten; Jass für die Schweiz; Tarock für Österreich; und Poker für alle anderen Fälle.“"
                                            },
                                            {
                                                "example_id": "b4e31c30-58df-41f8-bcfd-0fb896cdfe5d",
                                                "sense_id": "1d4aabbf-c6e8-3800-9713-cc032eb40ce2",
                                                "text": "„Die Vermieterin, Frau Sattler, möchte zu gern mehr über ihn erfahren, das Dienstmädchen fragt, ob er abends mit den Mitmietern Skat zu spielen gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ecd2ff8-8e12-30ef-800b-6001e31c4596",
                                        "entry_id": "62625834-8876-3bdb-8687-d55d0afb03f9",
                                        "glosses": [
                                            "die zwei Karten, die beim Skat^([1]) verdeckt liegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804f9e27-b71b-49e5-98ed-d0c6b2fb0375",
                                                "sense_id": "8ecd2ff8-8e12-30ef-800b-6001e31c4596",
                                                "text": "Peter hatte Glück, im Skat lagen zwei Buben."
                                            },
                                            {
                                                "example_id": "f102c6e4-44a3-4eb2-8e9a-6e5e56bcf4d3",
                                                "sense_id": "8ecd2ff8-8e12-30ef-800b-6001e31c4596",
                                                "text": "Wenn man „Hand“ spielt, erhält man mehr Punkte, man darf aber nicht den Skat aufnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
