                                "sense_id": "dc73a00b-ef9b-319c-a75c-bf420fd0591e",
                                "text": "Sa doctrine sur le principe vital ou la force harmonisatrice des corps organisés est bien justement nommée hippocratique."
                            },
                            {
                                "example_id": "0ddf35d3-0923-47fd-b8f1-63b12ae551ab",
                                "sense_id": "dc73a00b-ef9b-319c-a75c-bf420fd0591e",
                                "text": "Pour advenir, les occasions d'expérience exigent l'existence d'un unisson qui requiert, lui, un principe harmonisateur distinct du canevas mondain."
                            }
                        ]
                    }
