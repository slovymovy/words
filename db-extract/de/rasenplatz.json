                ],
                "senses": [
                    {
                        "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                        "entry_id": "15295107-ef47-334b-8284-eb76e4ee2c1b",
                        "glosses": [
                            "größere Fläche mit Gras/Rasen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e7ec4c4-e4fb-4c58-8eec-6000331d36d9",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Auf dem anderen Rasenplatz lag Lisa auf ihrem Liegestuhl, Madame Bonnechose saß neben ihr und strickte an einem roten Kinderstrumpf.“"
                            },
                            {
                                "example_id": "0f0cf4d1-9bc6-4e70-ab3b-90740e2cb986",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Die Morgensonne hing warm über Bäumen und Rasenplätzen.“"
                            },
                            {
                                "example_id": "5365841a-9ab9-4e9b-b826-2954eac8ac29",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Die gepflegten Rasenplätze glichen grünen Samtteppichen, die von Blumenbeeten in allen Farben umgeben waren.“"
                            },
                            {
                                "example_id": "eb3f0300-75a4-445e-b886-5167477fd254",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Um die Rasenplätze, vorn, sah man Fasanen, wohlgemästete Rebhühner und schnellfüßige Wasserhühner, die in ungestörter Ruhe rings umher sich Futter suchten.“"
                            },
                            {
                                "example_id": "160da57e-8216-465b-939c-77d9264b339b",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Gepflegte Rasenplätze mit leuchtenden Blumenbeeten, hohe Bäume und schimmernde Gewächshäuser machten in dieser Umgebung einen größern Eindruck als das massive vornehme Landhaus selbst.“"
                            },
                            {
                                "example_id": "e8adc096-8b55-479e-9822-d957494ce23c",
                                "sense_id": "2f979391-78a1-33c2-ad4c-a2a9504114b7",
                                "text": "„Zur Seite dehnte sich der geräumige Hof aus mit den Wirtschaftsgebäuden; vor dem Hause war ein großer Rasenplatz und ein paar mächtige Linden beschatteten das Haus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ab88982-0b9c-318e-b85f-6dabce566452",
                        "entry_id": "15295107-ef47-334b-8284-eb76e4ee2c1b",
                        "glosses": [
                            "größere Fläche mit Gras/Rasen, die für einen Sport (beispielsweise Fußball, Tennis, Springreiten) präpariert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29005d5b-af5b-4e1e-b066-e028c2bf8053",
                                "sense_id": "8ab88982-0b9c-318e-b85f-6dabce566452",
                                "text": "„Die Rasenplätze der Fußballer wurden abends gewässert, damit der Rasen bei der anhaltenden Hitze nicht verbrannte.“"
                            },
                            {
                                "example_id": "0e161e44-fbdb-4b14-961f-09e9c214b941",
                                "sense_id": "8ab88982-0b9c-318e-b85f-6dabce566452",
                                "text": "„Einen Kraftsportraum und einen Tischtennisraum gab es auch, außerdem konnten wir auf einem benachbarten Rasenplatz Fußball spielen.“"
                            },
                            {
                                "example_id": "d522e0bf-9793-4ad9-8edf-5d70611e2053",
                                "sense_id": "8ab88982-0b9c-318e-b85f-6dabce566452",
                                "text": "„Wenn Bruno von der Spüle aufblickte, konnte er den Swimmingpool sehen sowie einen Teil des Rasenplatzes, auf dem Tennis gespielt wurde; […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
