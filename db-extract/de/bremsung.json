                ],
                "senses": [
                    {
                        "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                        "entry_id": "85c8a914-2a6d-3ce0-874d-a2f6317f68c1",
                        "glosses": [
                            "Vorgang, die Geschwindigkeit von etwas (zum Beispiel eines Fahrzeuges oder einer bestimmten Entwicklung) zu verringern, vermindern, verlangsamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0611b02-0f29-4508-bbf9-3b6185375e01",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Der Porsche fährt eine Strecke von maximal hundert Meter geradeaus mit zwei Lenkmanövern oder einer Bremsung.“"
                            },
                            {
                                "example_id": "e396c01c-c6a4-46c9-b0ca-e38db96a9927",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Die Daten vom Arbeitsmarkt, wo im Januar erstmals seit Sommer 2003 per Saldo Stellen abgebaut wurden, deuten ebenfalls auf eine starke Bremsung.“"
                            },
                            {
                                "example_id": "d3cb1a7f-9eb4-4b5a-9753-11af3b2416a2",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Was die Anleihenmärkte fürchten ist eine deutliche Bremsung des Wachstums durch die Inflation.“"
                            },
                            {
                                "example_id": "c32c3086-cc5b-4d31-8b92-21701e752077",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Trotz Bremsung habe der Güterzug die Platten überrollt.“"
                            },
                            {
                                "example_id": "7f60d76f-1055-418a-a494-5e335c625f96",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Als er erkannte, dass der alte Mann in einem Baustellenbereich trotz roter Ampel die Straße überquerte, war es für eine Bremsung bereits zu spät.“"
                            },
                            {
                                "example_id": "510d106c-4c90-4f6c-8a10-ec8b0cd0dabd",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Da der Zug ruhig und ohne Bremsung weiter gefahren sei, sei er nicht besorgt gewesen, sagte der Zugbegleiter.“"
                            },
                            {
                                "example_id": "c9d6a1ff-a226-4952-8993-4c64f4d5ecdf",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Eine Bremsung nutzte wenig, denn der Bremsweg des Zuges bei dieser Geschwindigkeit beträgt 300 Meter.“"
                            },
                            {
                                "example_id": "03ca9458-70f5-4317-9df0-ca140b1766f3",
                                "sense_id": "f74d6c95-c022-352b-b6f2-bd43587651aa",
                                "text": "„Zu unglaubwürdig erschien der Richterin die Geschichte des Busfahrers, der zufolge ein vorbeihuschendes Tier ihn zu der scharfen Bremsung zwang, bei der drei Fahrgäste zu Boden fielen und Verletzungen erlitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
