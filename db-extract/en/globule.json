                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c4498d2-dc29-4589-a23b-5d5638fbc83f",
                        "source_entry_id": "6b1669c3-7a94-39fc-aa1e-e7d56afa36fe",
                        "source_sense_id": "f284e9c1-dd86-359a-a39d-f18ffaa93e0c",
                        "source_sense_description": "a small round particle of substance; a drop",
                        "target_lang_word": "ша́рик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ша́рик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "уменьш. к шар; маленький шар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdc5d9f-9414-484b-b53e-762fb398cd17",
                                                "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                                "text": "Он схватил обоих своих юных друзей и стал, ко всеобщему удивлению, жонглировать ими, словно это были не хорошо упитанные тринадцатилетние мальчики, а пластмассовые шарики комнатного бильярда."
                                            },
                                            {
                                                "example_id": "ae81f89a-e859-4869-8389-625625bfdd71",
                                                "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                                "text": "Я закрыл чемодан. Внутри гулко перекатывались шарики нафталина. Вещи пёстрой грудой лежали на кухонном столе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ea2448-a1c3-3b48-b02d-2b723781f0eb",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "биол., устар. частица вещества крови"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63bd867c-2efd-4f0d-ba83-1468dd1c3ea3",
                                                "sense_id": "76ea2448-a1c3-3b48-b02d-2b723781f0eb",
                                                "text": "Необходимый организму кислород доставляют красные кровяные шарики, которые захватывают его в лёгких при вдыхании."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "жарг., мн. ч. умственные способности, мозги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d724d21-d417-476e-bea0-39340348d0cf",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "— Ша́рик у тебя работает — вижу! — непохоже на себя заявил Пухов."
                                            },
                                            {
                                                "example_id": "a6e9c2ad-977c-4bdb-93a0-34d02fb18b32",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "Шарики у него в голове хорошо крутятся."
                                            },
                                            {
                                                "example_id": "8d428f55-7e61-49ec-a93f-e433a8b7fff7",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "Не то что я, грешник, — подскочу к столу на три-четыре часа, покатаю в голове какие-то там шарики, и выскочит диалог, а то и сценка, что Бог подаст."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c67cbdd-a543-4558-958e-d3af7d49e989",
                        "source_entry_id": "6b1669c3-7a94-39fc-aa1e-e7d56afa36fe",
                        "source_sense_id": "f284e9c1-dd86-359a-a39d-f18ffaa93e0c",
                        "source_sense_description": "a small round particle of substance; a drop",
                        "target_lang_word": "крупи́нка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крупи́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b3800d38-cc3f-3f57-ba47-ed46af5ce336",
                                        "entry_id": "9c8a1ae6-6d57-3d76-b6ff-bfcd11d66abd",
                                        "glosses": [
                                            "отдельное зерно крупы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b83865e-c544-439e-8fe9-d330e168765b",
                                                "sense_id": "b3800d38-cc3f-3f57-ba47-ed46af5ce336",
                                                "text": "Площадь базара стала подобна котлу, — люди кружились на ней, точно крупинки гречи в закипающей воде."
                                            },
                                            {
                                                "example_id": "0ea8e4b7-60c2-4fad-8ca9-5c5f7563f540",
                                                "sense_id": "b3800d38-cc3f-3f57-ba47-ed46af5ce336",
                                                "text": "Вся поверхность свежей могилы была щедро усыпана крупинками риса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564694b2-0200-33fa-8f0a-87940b73239e",
                                        "entry_id": "9c8a1ae6-6d57-3d76-b6ff-bfcd11d66abd",
                                        "glosses": [
                                            "мельчайшая частица чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa48fdb-6fe9-4b27-a1f7-4ea509c93716",
                                                "sense_id": "564694b2-0200-33fa-8f0a-87940b73239e",
                                                "text": "Помню чувство, с которым я, лежа, гляжу сквозь красные колючие стволы шиповника на чёрную, засохшую крупинками землю и на просвечивающее ярко-голубое зеркало пруда."
                                            },
                                            {
                                                "example_id": "5a147dca-c9e8-4bc5-8b8c-bca22309ba9c",
                                                "sense_id": "564694b2-0200-33fa-8f0a-87940b73239e",
                                                "text": "Красоткин опять слазил в сумку и вынул из неё маленький пузырёк, в котором действительно было насыпано несколько настоящего пороха, а в свёрнутой бумажке оказалось несколько крупинок дроби."
                                            },
                                            {
                                                "example_id": "bd658af1-86d4-40bd-8dc6-3304187c887a",
                                                "sense_id": "564694b2-0200-33fa-8f0a-87940b73239e",
                                                "text": "Попадались ещё прослойки белой вязкой глины с крупинками кварца, носившей название «кавардака»."
                                            },
                                            {
                                                "example_id": "4898eb1f-9bde-45d9-bac0-47742471372e",
                                                "sense_id": "564694b2-0200-33fa-8f0a-87940b73239e",
                                                "text": "Необыкновенно радовался он однажды, когда я рассказал ему, что наш сельский дьякон до крупинки съел как-то, на именинах моего отца, фунта два икры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fdcc459-43c0-3dd6-b819-dee461942036",
                                        "entry_id": "9c8a1ae6-6d57-3d76-b6ff-bfcd11d66abd",
                                        "glosses": [
                                            "перен. очень малое количество чего-либо; крупица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851810ba-6a41-44ea-9c2a-590f71a72f32",
                                                "sense_id": "6fdcc459-43c0-3dd6-b819-dee461942036",
                                                "text": "К сожалению, даже крупинку новых подробностей найти сейчас невозможно."
                                            },
                                            {
                                                "example_id": "4f868ed0-d821-41c7-8189-7241db8f5820",
                                                "sense_id": "6fdcc459-43c0-3dd6-b819-dee461942036",
                                                "text": "Елена утверждала, что неудачка вышла из-за дешёвой щедрости, что никому не принесла она ни крупинки восторга."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
