                    {
                        "sense_id": "bc489ce1-fc0e-3e9e-81b1-2c0f21e49836",
                        "entry_id": "1cb82127-ae6f-3be5-a939-60bb16af827d",
                        "glosses": [
                            "De petite taille."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "80473216-8d33-4606-a3bf-d84b1d99adca",
                                "sense_id": "bc489ce1-fc0e-3e9e-81b1-2c0f21e49836",
                                "text": "Je montais en tige comme une asperge. À sept ans, j’étais presque aussi haut que papa et maman, qui sont plutôt rase-mottes, l’un comme l’autre, c’est vrai."
                            }
                        ]
                    }
                ],
