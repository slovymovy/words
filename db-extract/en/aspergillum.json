                                    {
                                        "sense_id": "2d7b4ce1-f175-305a-bab4-1a1c799b2a9e",
                                        "entry_id": "ae4693bf-9e0c-3971-bfb6-210639fca0a8",
                                        "glosses": [
                                            "Wedel, mit dem Weihwasser versprengt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14805a24-27e6-4410-9837-f4c476510f5e",
                                                "sense_id": "2d7b4ce1-f175-305a-bab4-1a1c799b2a9e",
                                                "text": "Als er dann nach der Messe mit dem Weihwasserwedel das Schiff hinunterschritt und das wenige Werktagsvolk segnete, da spritzte er einen vollen Schwung des geweihten Wassers in der Richtung, wo steil und hoch mit rasch bewegten Beterlippen der ungeheure Corneli stand. (Heinrich Federer, Papst und Kaiser im Dorf, Kapitel 1, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "af567231-08e7-4201-9b61-e41d6608dda1",
                                                "sense_id": "2d7b4ce1-f175-305a-bab4-1a1c799b2a9e",
                                                "text": "Auf dem Nachttisch, hinter dem Kessel ohne Weihwasser, in dem zwecklos als überflüssiger Weihwasserwedel ein trockener Buchsbaumzweig lag, brannten zwei Wachskerzen. (Maurice Renard, Der Doktor Lerne, Der Tod und die Maske, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "e06a4691-9564-4c4b-9f76-283a121b663d",
                                                "sense_id": "2d7b4ce1-f175-305a-bab4-1a1c799b2a9e",
                                                "text": "Ihm gegenüber tritt aus der vorderen, rechten Türe im selben Augenblicke Abel mit dem Weihwasserwedel in der Hand. (Josef Ruederer, Die Morgenröte, 5. Akt, z.n. Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
