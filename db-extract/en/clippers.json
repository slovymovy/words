                        ],
                        "examples": [
                            {
                                "example_id": "54f196b3-c35b-4ea3-bc7f-082f36e08143",
                                "sense_id": "18d1a6e0-e395-3aa5-820e-08764d40c4b4",
                                "text": "TAI: One time I was using some clippers to trim downstairs and I totally caught my labia."
                            }
                        ]
                    }
                ],
