                "senses": [
                    {
                        "sense_id": "6cacfa58-1048-3930-b030-7844e0771d37",
                        "entry_id": "f7cff77b-f82e-3248-a2e4-db9d6e029a15",
                        "glosses": [
                            "Politikerin, die Mitglied einer Regierung oder einer Regierungspartei ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171bcc69-fdbc-49a9-a101-efd60f0ce4ce",
                                "sense_id": "6cacfa58-1048-3930-b030-7844e0771d37",
                                "text": "„Dass diese Idee just von einer Regierungspolitikerin kommt, die seit Jahren behauptet, für ein Informationsfreiheitsgesetz zu kämpfen, wirkt, als würde man den Kampf für mehr Kinderbetreuungsmöglichkeiten mit der Forderung eines Verbots von Nachmittagskindergärten verbinden.“"
                            },
                            {
                                "example_id": "0f7a375b-2afe-414d-937e-04395cc4b166",
                                "sense_id": "6cacfa58-1048-3930-b030-7844e0771d37",
                                "text": "„Nachdem Marek eine Regierungspolitikerin und keine scharfe Oppositionspolitikerin ist, würde in diesem Fall ein Statthalter bestimmt werden, der die Wiener VP in Mareks Abwesenheit führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
