                "senses": [
                    {
                        "sense_id": "3764a3a5-f180-341e-a42c-b2c0f3da7f40",
                        "entry_id": "36ea8b51-f092-36a4-ae54-acf5bd0efe16",
                        "glosses": [
                            "Ausstrahlung von Fernsehsignalen, bei denen zumindest die Bilddaten, meist aber auch die Tondaten analog übertragen werden"
                        ],
                        "tags": [
                            "Fernsehtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "e0d37f80-e26c-4060-91b1-94e8f80eac5f",
                                "sense_id": "3764a3a5-f180-341e-a42c-b2c0f3da7f40",
                                "text": "„Denn dieser könnte mit seiner BSkyB-d-Box den gesamten Zugang zum Fernsehen im Königreich kontrollieren, wenn 2006 das Analogfernsehen abgeschaltet wird und er bis dahin die digitale Konkurrenz in die Pleite getrieben hat.“"
                            },
                            {
                                "example_id": "9cc02293-5902-4522-ac81-2bb39bbe10da",
                                "sense_id": "3764a3a5-f180-341e-a42c-b2c0f3da7f40",
                                "text": "„Das ZDF könne mit hochauflösendem Fernsehen erst starten, wenn die Übertragungskosten fürs Analogfernsehen wegfallen, was 2010 der Fall sein könnte, wenn die analogen TV-Sender auf das digitale Antennenfernsehen DVB-T umgeschaltet sind.“"
                            }
                        ],
