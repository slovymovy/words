                            {
                                "example_id": "c4f51fb1-c180-4516-a6de-6fa13f4becb3",
                                "sense_id": "f02f55ce-ff8b-3808-a604-034411a4bfd2",
                                "text": "Il est donc parfaitement plausible que, conformément à la légende, Wellington, comme beaucoup d'autres belligérants, ait porté sa Breguet sur le champ de bataille de Waterloo, le 18 juin 1815."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47a6dc77-d75a-475c-a09d-b290a2eb01a0",
