            {
                "entry_id": "b77a4b3f-e817-3714-ab4f-1c3169b3a5aa",
                "word": "prospère",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d115369-40d9-44ab-9641-b0e3948f9b45",
                        "entry_id": "b77a4b3f-e817-3714-ab4f-1c3169b3a5aa",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "prospères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa718a41-1f8e-3343-bc71-fd8705458361",
                        "entry_id": "b77a4b3f-e817-3714-ab4f-1c3169b3a5aa",
                        "glosses": [
                            "Qui est dans une période de réussite, de succès."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "3ac97c91-2c5a-4ede-9351-e25521996fee",
                                "sense_id": "fa718a41-1f8e-3343-bc71-fd8705458361",
                                "text": "Ils allaient haricotant les restes du Grand-I-Vert, ceux des châteaux ; car, à eux deux, dans les années les plus occupées, les plus prospères, ils n’avaient jamais pu fabriquer en moyenne trois cents soixante brasses de corde."
                            },
                            {
                                "example_id": "b105e685-569b-4715-80e6-9c755b98a3ba",
                                "sense_id": "fa718a41-1f8e-3343-bc71-fd8705458361",
                                "text": "Les destins lui ont été prospères."
                            },
                            {
                                "example_id": "15efe0b0-2d61-49d9-b643-f1c46507e8d9",
                                "sense_id": "fa718a41-1f8e-3343-bc71-fd8705458361",
                                "text": "Avoir la fortune prospère."
                            },
                            {
                                "example_id": "e186234a-6474-432d-90e6-749157a8e9b9",
                                "sense_id": "fa718a41-1f8e-3343-bc71-fd8705458361",
                                "text": "Toutes choses lui ont été prospères."
                            }
                        ]
                    },
                    {
                        "sense_id": "0effe573-d626-3e59-861f-3d92145be5d7",
                        "entry_id": "b77a4b3f-e817-3714-ab4f-1c3169b3a5aa",
                        "glosses": [
                            "Qui est heureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b157b6c-ca66-4800-845a-59fb54e5ebae",
                                "sense_id": "0effe573-d626-3e59-861f-3d92145be5d7",
                                "text": "L’élève du cheval de trait et du mulet est aujourd’hui une industrie très-prospère et surtout très-rémunératrice ; […]."
                            },
                            {
                                "example_id": "35d1975d-7820-4fdc-9066-f8059f88701d",
                                "sense_id": "0effe573-d626-3e59-861f-3d92145be5d7",
                                "text": "Néanmoins, tant que l'industrie du tissage à la main fut prospère dans ces campagnes, c'est-à-dire jusqu'à 1872, le chômage agricole de l'hiver fut allégrement supporté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7d1e85f-e6b2-42bd-88e0-7a1ffb0e323e",
                        "source_entry_id": "b77a4b3f-e817-3714-ab4f-1c3169b3a5aa",
                        "target_lang_word": "prosperous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosperous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba457562-5082-3ccc-9e1c-6b348b5e264c",
                                        "entry_id": "d3dc6a89-360e-3012-9e2d-b47faa2204f3",
                                        "glosses": [
                                            "Characterized by success."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09077c22-dcce-4612-8708-994aa5053778",
                                                "sense_id": "ba457562-5082-3ccc-9e1c-6b348b5e264c",
                                                "text": "Trading Babe Ruth was far more prosperous for the Yankees than for the Red Sox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0624d6bc-9fed-39c2-b594-8f25995807eb",
                                        "entry_id": "d3dc6a89-360e-3012-9e2d-b47faa2204f3",
                                        "glosses": [
                                            "Well off; affluent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92154fad-9132-4c4c-bff4-376f0b7849c5",
                                                "sense_id": "0624d6bc-9fed-39c2-b594-8f25995807eb",
                                                "text": "He was raised in a very prosperous household."
                                            },
                                            {
                                                "example_id": "a513fea6-6134-43b0-8776-977c63e718b5",
                                                "sense_id": "0624d6bc-9fed-39c2-b594-8f25995807eb",
                                                "text": "He wondered how many people were destitute that same night even in his own prosperous country, how many homes were shanties, how many husbands were drunk and wives socked, and how many children were bullied, abused or abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ac4a51-9a4f-30f0-ac8d-54d061ecfe4b",
                                        "entry_id": "d3dc6a89-360e-3012-9e2d-b47faa2204f3",
                                        "glosses": [
                                            "Favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffbae02-550e-4065-bf36-71ac319493bd",
                                                "sense_id": "81ac4a51-9a4f-30f0-ac8d-54d061ecfe4b",
                                                "text": "He chose a prosperous lottery number that evening."
                                            },
                                            {
                                                "example_id": "33144b2e-1590-4982-acb2-0964b1c5ab25",
                                                "sense_id": "81ac4a51-9a4f-30f0-ac8d-54d061ecfe4b",
                                                "text": "So draw him home to those that mourn\n⁠In vain; a favourable speed\n⁠Ruffle thy mirror’d mast, and lead\nThro’ prosperous floods his holy urn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
