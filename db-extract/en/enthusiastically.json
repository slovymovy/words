                                    {
                                        "sense_id": "c9bd5e01-6802-37b1-a5f3-fb1f2748842a",
                                        "entry_id": "37c9e080-996b-3288-aa38-b5aed0a360b4",
                                        "glosses": [
                                            "von überschwänglicher Leidenschaft und Begeisterung getragen/motiviert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261bc03b-2310-4c2d-80c7-c076bcdf2739",
                                                "sense_id": "c9bd5e01-6802-37b1-a5f3-fb1f2748842a",
                                                "text": "Der enthusiastische Empfang überwältigte ihn."
                                            },
                                            {
                                                "example_id": "97804854-0aa1-435b-a842-f0b3c6e3578d",
                                                "sense_id": "c9bd5e01-6802-37b1-a5f3-fb1f2748842a",
                                                "text": "Die enthusiastischen Fans warfen während des Konzerts Unterwäsche auf die Bühne."
                                            },
                                            {
                                                "example_id": "b79dc67d-703b-4787-966e-f9183f007086",
                                                "sense_id": "c9bd5e01-6802-37b1-a5f3-fb1f2748842a",
                                                "text": "„Im mit Säulen und Gemälden ausgeschmückten, sehr engen Pressesaal des State Department wird Westerwelle von Kerry mit fast schon enthusiastischen Worten begrüßt.“"
                                            },
                                            {
                                                "example_id": "51504903-f37e-45b0-9ee4-77fded55aba8",
                                                "sense_id": "c9bd5e01-6802-37b1-a5f3-fb1f2748842a",
                                                "text": "„Am Freitagmorgen besprach sich Juschtschenko ein weiteres Mal mit Ministerpräsident Janukowitsch und der Oppositionsführerin Julia Timoschenko, die nach einer längeren Periode der Entfremdung den Staatschef wieder unterstützt und zu den enthusiastischsten Befürwortern einer vorzeitigen Wahl zählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
