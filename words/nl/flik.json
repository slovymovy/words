                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Blijf met je gore <w>flikken</w> van mijn spullen af!",
                            "target_lang_translations": {
                                "ru": "Убери свои грязные <w>лапы</w> от моих вещей!"
                            }
                        },
                        {
                            "text": "Hij hield zijn <w>flikken</w> niet thuis tijdens het feest.",
                            "target_lang_translations": {
                                "ru": "Он распускал свои <w>лапы</w> на вечеринке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "zeer informeel en grof"
                        }
