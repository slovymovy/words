        "ru-extract.jsonl": [
            {
                "entry_id": "3432f961-e546-3eee-9e31-7c45a904faa8",
                "word": "смешно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5f3048d-48a4-314e-a7b4-2359ed5d5e09",
                        "entry_id": "3432f961-e546-3eee-9e31-7c45a904faa8",
                        "glosses": [
                            "наречие к смешной; вызывая смех, веселье"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "615268f4-4856-4785-8171-db75ce7392aa",
                                "sense_id": "e5f3048d-48a4-314e-a7b4-2359ed5d5e09",
                                "text": "Женя засунула в рот все ягоды, смешно скривилась, но зачмокала от удовольствия."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e0615c5-0f72-3304-9b2f-d420e3695566",
                        "entry_id": "3432f961-e546-3eee-9e31-7c45a904faa8",
                        "glosses": [
                            "предик. о желании смеяться, испытываемом кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf5f5d8-8da2-46bf-9ae7-37d70a15099b",
                                "sense_id": "3e0615c5-0f72-3304-9b2f-d420e3695566",
                                "text": "Да, мне было смешно, я смеялась вместе со всеми."
                            }
                        ]
                    },
                    {
                        "sense_id": "63910af2-da08-39b0-b5df-bbf1fe8f6a41",
                        "entry_id": "3432f961-e546-3eee-9e31-7c45a904faa8",
                        "glosses": [
                            "перен., нелепо, странно"
                        ],
                        "tags": [
                            "безл., в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "65a3a419-d382-4ca7-83a2-05ad7ba04dd5",
                                "sense_id": "63910af2-da08-39b0-b5df-bbf1fe8f6a41",
                                "text": "Он понимал, что смешно обижаться на подобные вещи, но он был обижен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9d6452f-5ed1-491e-ba05-08a7b2c49ba9",
                        "source_entry_id": "3432f961-e546-3eee-9e31-7c45a904faa8",
                        "source_sense_description": "вызывая смех",
                        "target_lang_word": "comically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comically",
