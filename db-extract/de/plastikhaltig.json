                    },
                    {
                        "form_id": "0d1955fb-16cc-4307-aab6-177f37cc7708",
                        "entry_id": "d0294b02-a22a-3ecf-9f07-45c1a72a3eb1",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind plastikhaltig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1069567d-454d-37ec-83cf-52de168138da",
                        "entry_id": "d0294b02-a22a-3ecf-9f07-45c1a72a3eb1",
                        "glosses": [
                            "Plastik/Kunststoff enthaltend, aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9882db5d-976c-459a-8586-36f453da9e05",
                                "sense_id": "1069567d-454d-37ec-83cf-52de168138da",
                                "text": "„Er wirtschaftete konventionell, nutzte aber weder Gewächshäuser aus Kunststoff noch Folien und andere plastikhaltige Hilfsmittel.“"
                            },
                            {
                                "example_id": "b2b8f0af-c693-429d-a957-3ef86c44d460",
                                "sense_id": "1069567d-454d-37ec-83cf-52de168138da",
                                "text": "„An diesen gelben Säcken wird alle ein bis zwei Wochen sichtbar, welche Massen an plastikhaltigem Müll täglich produziert werden.“"
                            },
                            {
                                "example_id": "b746602b-fcdc-45c5-8ac0-62cf087d2ae6",
                                "sense_id": "1069567d-454d-37ec-83cf-52de168138da",
                                "text": "„Dabei empfiehlt es sich auch, direkt Alternativen zu plastikhaltigen Alltagsartikeln wie Brotdosen, Rucksäcken und Kleidung aufzuzeigen.“"
                            },
                            {
                                "example_id": "7066d4f5-7638-4a1b-9ce6-0653c42fc854",
