                "senses": [
                    {
                        "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                        "entry_id": "1fca48d1-a45f-35e5-a56c-5384455d315c",
                        "glosses": [
                            "Malerei von alltäglichen Szenen zur Darstellung von bestimmten Lebensformen oder Umgebungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "103af1f7-c8bc-472f-8503-9834e2a36d34",
                                "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                                "text": "„Schon die niederlandische Genremalerei war starker von narrativen Konventionen gepragt, als es die spatere Rezeption im Sinne des Realismus nahelegte.“"
                            },
                            {
                                "example_id": "c5de5f94-5e5a-431e-bf37-9b294f0f1bd2",
                                "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                                "text": "„Erst seit den vierziger Jahren bewegte sich seine Kunst wieder in einer Richtung, wie sie der Förderung der Genremalerei günstig war.“"
                            },
                            {
                                "example_id": "d5cce7bd-4b16-4b16-a346-d1859b7b0067",
                                "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                                "text": "„Es sind Alltagsszenen und Charakterporträts: Renoir versetzt Sujets der Genremalerei auf die große Bühne, die in der klassischen Tradition für die erhabensten Gegenstände reserviert war.“"
                            },
                            {
                                "example_id": "c19083d4-49cb-4cc1-b17f-134643bc4027",
                                "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                                "text": "„Seine Bordellszenen waren mit Spuren und Symbolen gespickt wie die flämische Genremalerei des siebzehnten Jahrhunderts – und genauso lesbar.“"
                            },
                            {
                                "example_id": "8f981932-e9f7-4e45-a312-4de330f5036c",
                                "sense_id": "bef99c6f-ed96-39c2-9f47-f8c0e8953882",
                                "text": "„Was sehen wir, wenn wir holländische Genremalerei des siebzehnten Jahrhunderts betrachten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
