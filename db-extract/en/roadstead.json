    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e09024f9-798f-3cd6-a704-aeafd4726317",
                "word": "roadstead",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "20415bc2-da12-4e22-a298-8f122d367402",
                        "entry_id": "e09024f9-798f-3cd6-a704-aeafd4726317",
                        "tags": [
                            "plural"
                        ],
