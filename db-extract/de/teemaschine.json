                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b78291-2ec0-48bc-b645-f5fa2c646e7c",
                                "sense_id": "e0b4de68-7691-31f0-a3ec-99946e32e655",
                                "text": "„Nicht umsonst nehmen die Eingeborenen sogar auf die Eisenbahn ihre Teemaschinen mit und pantschen den lieben langen Tag mit ihrer Teetrinkerei herum.“"
                            },
                            {
                                "example_id": "2d8fdf70-12f7-4a11-99ba-87e5e092c276",
                                "sense_id": "e0b4de68-7691-31f0-a3ec-99946e32e655",
                                "text": "„Einer trug eine große, hoch aufgebaute Teemaschine, was zweifellos bedeutete, daß Engländer oder Holländer angekommen sein mußten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
