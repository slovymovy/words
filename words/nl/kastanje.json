                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft prachtige <w>kastanje</w> lokken die schitteren in de zon.  ",
                            "target_lang_translations": {
                                "en": "She has beautiful <w>chestnut</w> locks that shine in the sun."
                            }
