                    {
                        "translation_id": "830b6605-fee5-4488-a5d9-8f8fb8a20ef7",
                        "source_entry_id": "b55d142c-ee46-3c72-84bc-626407b0b2ac",
                        "source_sense_id": "73cc3f6c-2dd8-3599-ae2e-67ca02213ca6",
