                "translations": [
                    {
                        "translation_id": "f47bb4e8-eb00-466f-ad56-c8b437837472",
                        "source_entry_id": "f9cc357c-cb3e-3353-b977-b4a0c701e8ea",
                        "source_sense_id": "c59ee38d-09e0-3c5c-9be9-489fdd28773e",
