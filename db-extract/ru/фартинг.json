                ],
                "senses": [
                    {
                        "sense_id": "b62701ba-19df-36f0-85e9-c340f1997376",
                        "entry_id": "3fd6ad2e-0259-3ee3-80fe-5fa41b933951",
                        "glosses": [
                            "британская монета достоинством в четверть пенни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22fe89c2-8b81-4452-a1c2-aea4ece5c1f9",
                                "sense_id": "b62701ba-19df-36f0-85e9-c340f1997376",
                                "text": "Господа сенаторы хотят мира на Востоке во что бы то ни стало, пускай и добиваются мира своими средствами. Мы во всяком случае не пожертвовали для этого ни одним фартингом из вашей казны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ae86451-201f-426a-b2ba-c97a2b3787dc",
                        "source_entry_id": "3fd6ad2e-0259-3ee3-80fe-5fa41b933951",
                        "source_sense_id": "b62701ba-19df-36f0-85e9-c340f1997376",
                        "target_lang_word": "farthing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farthing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a0160e-ed10-34bf-a210-6a9dbc8cea54",
                                        "entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                                        "glosses": [
                                            "Former British unit of currency worth one-quarter of an old penny; or a coin representing this."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f0b985a-3ef0-4282-9eb9-d04fbba04e43",
                                                "sense_id": "a5a0160e-ed10-34bf-a210-6a9dbc8cea54",
                                                "text": "\"Nay, Heaven forbid, indeed,\" quoth Robin, \"that I should take from such as thee, jolly fellow! Not so much as one farthing would I take from thee, for I love a fair Saxon face like thine right well—more especially when it cometh from Locksley Town, and most especially when the man that owneth it is to marry a bonny lass on Thursday next. But come, tell me for what price thou wilt sell me all of thy meat and thy horse and cart.\""
                                            },
                                            {
                                                "example_id": "a75bc3d5-e425-42ad-bc79-29f71755d3ef",
                                                "sense_id": "a5a0160e-ed10-34bf-a210-6a9dbc8cea54",
                                                "text": "We must keep them to the fact that the duty is one and three quarter farthings, or nearly a half-penny in the pound and no more, and any one who tries to work it out any other way is not acting fairly in the matter."
                                            },
                                            {
                                                "example_id": "3b333bf2-f0ab-4b81-b3a8-d1892802e343",
                                                "sense_id": "a5a0160e-ed10-34bf-a210-6a9dbc8cea54",
                                                "text": "I had never defrauded a man of a farthing, nor called him knave behind his back. But now the last rag that covered my nakedness had been torn from me. I was branded a blackleg, card-sharper, and murderer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd4180ea-e224-38bb-be66-a53213cf6a46",
                                        "entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                                        "glosses": [
                                            "A very small quantity or value; the least possible amount."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c33600-ce54-4878-932c-ec8216870c03",
                                                "sense_id": "bd4180ea-e224-38bb-be66-a53213cf6a46",
                                                "text": "That period of infatuation was not unrelieved by a certain amount of self-introspection on my part. I kept account of every farthing I spent, and my expenses were carefully calculated. Every little item such as omnibus fares or postage or a couple of coppers spent on newspapers, would be entered, and the balance struck every evening before going to bed. That habit has stayed with me ever since, and I know that as a result, though I have had to handle public funds amounting to lakhs, I have succeeded in exercising strict economy in their disbursement, and instead of outstanding debts have had invariably a surplus balance in respect of all the movements I have led."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e5f2fd-d4d2-3297-938a-f6959d43e781",
                                        "entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                                        "glosses": [
                                            "A division of land."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb9b47a-3582-4ce3-b3f1-1cb040887635",
                        "source_entry_id": "3fd6ad2e-0259-3ee3-80fe-5fa41b933951",
