                "senses": [
                    {
                        "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                        "entry_id": "2b112f2d-b71f-38a5-ae37-6baea4c376c5",
                        "glosses": [
                            "Pénis, membre viril."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7f856831-61dc-408d-8961-8a9117cbc77a",
                                "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                                "text": "La pucelle tendit sa main et celui-ci tout aussitôt la prit et lui a fait —pas de meilleur morceau— empoigner son vit."
                            },
                            {
                                "example_id": "3c2af194-7fde-4868-b36c-417df35e308f",
                                "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                                "text": "Je bande trop dans ma culotte,\nJe sors mon vit qui décalotte\nSon champignon."
                            },
                            {
                                "example_id": "39a23153-5743-4b09-981c-78800a7f4be0",
                                "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                                "text": "Mony se débarrassa rapidement de ses vêtements, puis le vit en l’air, bien bandant, il se précipita sur les deux gougnottes en essayant de les séparer."
                            },
                            {
                                "example_id": "4efee82b-2c40-40f4-a9ea-d9fd17b7b33d",
                                "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                                "text": "Monsieur l’curé, il monte en chaire\nSon grand vicaire le suit\nSon grand vi– papa\nSon grand vi– maman\nSon grand vicaire le suit."
                            },
                            {
                                "example_id": "b2893922-9d98-466a-92a6-6d797a7ee85f",
                                "sense_id": "cf7e3f78-39e4-3fcb-adfc-1c0b0c55e06c",
                                "text": "Quand la vieillesse triste et caduque\nVous foutra son pied sur la nuque,\nQuand votre vit à jamais désossé,\nSur vos roustons pendra flasque et glacé\nAllez crier à la face du prêtre\nCe vieux refrain de Bicêtre…"
                            }
                        ]
                    }
                ],
