                        "examples": [
                            {
                                "example_id": "9153c69e-6a79-401f-b77c-f8341bd7187c",
                                "sense_id": "2f56dbcf-b2e4-3b67-889c-7c720139bc7e",
                                "text": "Le grand requin blanc ou la baudroie ont une mâchoire protrusible. Ils peuvent l’étendre vers l’avant pour capturer leurs proies."
                            },
                            {
                                "example_id": "9ab4be7c-26f9-49ce-a7bd-6f8eebb1ff9d",
                                "sense_id": "2f56dbcf-b2e4-3b67-889c-7c720139bc7e",
                                "text": "La bouche est protrusible, avec de nombreuses dents minces sur les maxillaires, le vomer, et les palatins."
                            },
                            {
                                "example_id": "dc051fc5-7d69-47be-96fe-eaf89f2760fe",
                                "sense_id": "2f56dbcf-b2e4-3b67-889c-7c720139bc7e",
                                "text": "Le proboscis (cône buccal), court, est protrusible et rétractile ; sa base forme un cadre elliptique de chitine dont le bord postérieur est occupé par le labrum ; […]"
                            }
                        ]
