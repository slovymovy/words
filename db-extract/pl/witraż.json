                                        "glosses": [
                                            "Panneau de verres assemblés par compartiments, enchâssés dans des cadres de plomb et qui le plus souvent forment une décoration ou représentent un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012aa887-5509-4fb5-b6b7-013d2c3c636f",
                                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                                "text": "C’était une retraite obscure et religieuse où le jour ne pénétrait qu’à travers les vitraux coloriés et où tout disposait l’âme à la prière."
                                            },
                                            {
                                                "example_id": "779454a8-0f4a-4ce9-8c83-d43a2d1a8aff",
                                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                                "text": "Les vitraux de plomb disjoints laissaient tomber les verres octogones des croisées qui semblaient éborgnées."
                                            }
                                        ]
                                    }
                                ]
                            }
