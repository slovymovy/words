                        "source_sense_id": "da067f8b-e15f-3b5d-a0b9-da18399ed117",
                        "source_sense_description": "kleines, individuelles, oft luxuriös ausgestattetes Hotel",
                        "target_lang_word": "boetiekhotel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boetiekhotel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a9732d49-bfe6-3b2a-91bc-0642cd3aaf52",
                                        "entry_id": "9a529cf2-8fad-3d1a-935a-f1402bf170e5",
                                        "glosses": [
                                            "een populaire term voor een hotel dat een luxueuze, eigenzinnige maar ook intieme sfeer heeft en vaak niet behoort tot een hotelketen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd1fca2-f733-432a-b8a9-19cbca1ef4cd",
                                                "sense_id": "a9732d49-bfe6-3b2a-91bc-0642cd3aaf52",
                                                "text": "\"Als je op Airbnb staat, zou je je ook bij de Kamer van Koophandel moeten melden. Eigenlijk vinden we: als je commercieel slapen, eten en recreatie aanbiedt, heb je je ook te houden aan de wet- en regelgeving die geldt voor ondernemers. Want een klein boetiekhotel met twee kamers of een huiskamerrestaurant moet zich ook aan deze regels houden.\""
                                            },
                                            {
                                                "example_id": "16ddeae6-f5dd-49bf-a0e4-16d09ae44cac",
                                                "sense_id": "a9732d49-bfe6-3b2a-91bc-0642cd3aaf52",
                                                "text": "Eind jaren 80 begon het toerisme echt te groeien en daarmee zijn bedrijf. Nu heeft hij een guesthouse met 21 kamers, een restaurant aan het befaamde witte strand en sinds kort ook een boetiekhotel met nog eens 22 kamers. Dat runt hij met zeventig man personeel."
                                            },
                                            {
                                                "example_id": "949ef02a-bd6e-4393-9a31-0b4b58d93726",
                                                "sense_id": "a9732d49-bfe6-3b2a-91bc-0642cd3aaf52",
                                                "text": "Hij had nog enige twijfels. Maar de kogel is door de kerk. Frank Hendriks is gestopt bij de Twentse Bierbrouwerij Proeflokaal. Hij stort zich, samen met zijn zoon Simon, helemaal op grand café & boetiekhotel De Verééniging."
                                            }
                                        ]
                                    }
                                ]
                            }
