{
    "word_family": [
        "clannish",
        "clansman",
        "clanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac0d1e47-b45e-3a95-9635-d9c8db65217a",
                    "sense_definition": "A group of people all descended from a common ancestor, often sharing a specific name and culture.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "kinship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>clan</w> gathered every year to honor their ancestors.",
                            "target_lang_translations": {
                                "ru": "Древний <w>род</w> собирался каждый год, чтобы почтить своих предков.",
                                "zh": "这个古老的<w>氏族</w>每年都会聚在一起祭奠祖先。"
                            }
                        },
                        {
                            "text": "Marriage between members of the same <w>clan</w> was strictly forbidden in their culture.",
                            "target_lang_translations": {
                                "ru": "Браки между членами одного <w>клана</w> были строго запрещены в их культуре.",
                                "zh": "在他们的文化中，严禁同一<w>氏族</w>的成员通婚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tribe",
                        "lineage",
                        "kin"
                    ],
                    "common_phrases": [
                        "clan leader",
                        "rival clans",
                        "clan member"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, происходящих от общего предка, часто объединенная общим именем и культурой.",
                        "zh": "由共同祖先繁衍而成的群体，通常共享特定的名称和文化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "антропологическое понятие"
                            },
                            {
                                "target_lang_word": "клан",
                                "target_lang_sense_clarification": "родовая община"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氏族",
                                "target_lang_sense_clarification": "人类学概念，指有共同祖先的群体"
                            },
                            {
                                "target_lang_word": "宗族",
                                "target_lang_sense_clarification": "指同姓的家族群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2a3d6c-015c-3326-bf58-718ceef4582d",
                    "sense_definition": "A traditional social group of families in the Scottish Highlands having a common hereditary chieftain.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "kinship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clan</w> marched through the valley wearing their traditional tartans.",
                            "target_lang_translations": {
                                "ru": "<w>Клан</w> маршировал по долине в своих традиционных тартанах.",
                                "zh": "该<w>氏族</w>身着传统格子呢服饰穿过山谷。"
                            }
                        },
                        {
                            "text": "Historically, the <w>clan</w> chief held significant power over his people.",
                            "target_lang_translations": {
                                "ru": "Исторически вождь <w>клана</w> обладал значительной властью над своим народом.",
                                "zh": "历史上，<w>氏族</w>首领对族人拥有巨大的权力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Scottish clan",
                        "clan chief",
                        "clan tartan"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная социальная группа семей в горах Шотландии, имеющая общего наследственного вождя.",
                        "zh": "苏格兰高地的一种传统社会群体，拥有共同的世袭首领。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клан",
                                "target_lang_sense_clarification": "шотландский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氏族",
                                "target_lang_sense_clarification": "指苏格兰高地的传统社会组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a0675f8-0e18-371c-ae1a-22a5edb041aa",
                    "sense_definition": "A group of players who habitually play on the same team in multiplayer games.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He joined a <w>clan</w> to participate in the national tournament.",
                            "target_lang_translations": {
                                "ru": "Он вступил в <w>клан</w>, чтобы принять участие в национальном турнире.",
                                "zh": "他加入了一个<w>战队</w>以参加全国锦标赛。"
                            }
                        },
                        {
                            "text": "Our <w>clan</w> practices strategy together every Friday night.",
                            "target_lang_translations": {
                                "ru": "Наш <w>клан</w> отрабатывает стратегию вместе каждый вечер пятницы.",
                                "zh": "我们的<w>战队</w>每周五晚上都会一起练习战术。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guild",
                        "team"
                    ],
                    "common_phrases": [
                        "join a clan",
                        "gaming clan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа игроков, которые постоянно играют в одной команде в многопользовательских играх.",
                        "zh": "在多人游戏中习惯于在同一团队中进行游戏的玩家群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клан",
                                "target_lang_sense_clarification": "в видеоиграх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战队",
                                "target_lang_sense_clarification": "电子竞技或游戏中的团队"
                            },
                            {
                                "target_lang_word": "公会",
                                "target_lang_sense_clarification": "大型多人在线游戏中的玩家组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2f703e3-7dce-372a-a4bd-4657eefce79e",
                    "sense_definition": "A large family group or a close-knit group of people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "kinship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We invited the whole <w>clan</w> to the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили весь <w>клан</w> на свадебный банкет.",
                                "zh": "我们邀请了整个<w>家族</w>参加婚宴。"
                            }
                        },
                        {
                            "text": "My aunt brought her entire <w>clan</w> to the picnic.",
                            "target_lang_translations": {
                                "ru": "Моя тетя привела весь свой <w>клан</w> на пикник.",
                                "zh": "我阿姨带着她那一大家子<w>亲戚</w>来参加野餐了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "family",
                        "circle"
                    ],
                    "common_phrases": [
                        "the whole clan",
                        "family clan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая семья или сплоченная группа людей.",
                        "zh": "一个大家庭或关系紧密的群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клан",
                                "target_lang_sense_clarification": "большая семья или группировка"
                            },
                            {
                                "target_lang_word": "родня",
                                "target_lang_sense_clarification": "разг. родственники"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家族",
                                "target_lang_sense_clarification": "指大家庭"
                            },
                            {
                                "target_lang_word": "亲戚",
                                "target_lang_sense_clarification": "指亲属群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1ef193a-b17b-3880-b6b1-88af6620830e",
                    "sense_definition": "A colony of badgers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>clan</w> of badgers has established a sett in the nearby woods.",
                            "target_lang_translations": {
                                "ru": "<w>Колония</w> барсуков обосновалась в норе в соседнем лесу.",
                                "zh": "一<w>群</w>獾在附近的树林里安了家。"
                            }
                        },
                        {
                            "text": "The <w>clan</w> defends its territory against intruders from other groups.",
                            "target_lang_translations": {
                                "ru": "<w>Колония</w> защищает свою территорию от чужаков из других групп.",
                                "zh": "这<w>群</w>獾会保护自己的领地，抵御来自其他群体的入侵者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cete",
                        "colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колония барсуков.",
                        "zh": "一群獾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "животных"
                            },
                            {
                                "target_lang_word": "семья",
                                "target_lang_sense_clarification": "группа животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群",
                                "target_lang_sense_clarification": "用于动物的量词或群体称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}