                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3e90ee15-218f-4fca-9b97-3084542457fe",
                        "entry_id": "b8421a5a-8b43-39bf-8ec1-9fdc14b87915",
                        "tags": [
                            "plural"
                        ],
                        "form": "egg-crates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95c96811-2e7f-3684-b5a9-61a0e44fa5fa",
                        "entry_id": "b8421a5a-8b43-39bf-8ec1-9fdc14b87915",
                        "glosses": [
                            "Alternative form of egg crate."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "802ea183-ce61-4c5e-a586-f22eac35e68e",
                                "sense_id": "95c96811-2e7f-3684-b5a9-61a0e44fa5fa",
                                "text": "Often used with the studio is the egg-crate, which minimizes side spill and does make the beam a bit more controllable."
                            },
                            {
                                "example_id": "b127ec0e-67cf-42ea-a26d-c9ce52b1613b",
                                "sense_id": "95c96811-2e7f-3684-b5a9-61a0e44fa5fa",
                                "text": "Pa strings the lights while Janet takes the ornaments one by one from the cardboard egg-crates."
                            },
                            {
                                "example_id": "ba99105c-613f-45fb-a97b-d3c7d8be7588",
                                "sense_id": "95c96811-2e7f-3684-b5a9-61a0e44fa5fa",
                                "text": "There was no fuel cladding, no zirconium egg-crates holding the fuel in a rigid matrix, no steam in the reactor vessel to float away with fission products into the atmosphere, and, of course, there was no danger of the fuel melting."
                            },
                            {
                                "example_id": "c698599c-f4b0-4e48-965a-2eb008d5bb30",
                                "sense_id": "95c96811-2e7f-3684-b5a9-61a0e44fa5fa",
                                "text": "New virtual learning environments (VLEs) such as Eluminate (now Blackboard Collaborate) are virtual egg-crates."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                "word": "egg-crate",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d3cb1ab8-a19f-455a-8815-92c6f8e67c4e",
