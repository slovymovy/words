                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'études de droit, elle a été admise au <w>barreau</w> de Paris."
                        },
                        {
                            "text": "Les membres du <w>barreau</w> se sont réunis pour élire leur nouveau bâtonnier."
                        }
                    ],
                    "synonyms": [
