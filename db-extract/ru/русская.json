                                "target_senses": [
                                    {
                                        "sense_id": "0369d74f-ca80-3c74-825b-8ea3e466da51",
                                        "entry_id": "b1707fb2-c84a-3580-beb5-d75de133fb57",
                                        "glosses": [
                                            "Personne de nationalité russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1f53e4-3059-46d3-91bd-b7993761d663",
                                                "sense_id": "0369d74f-ca80-3c74-825b-8ea3e466da51",
                                                "text": "Les Russes sont tellement imitateurs, que toutes les maladies de la civilisation se répercutent chez eux."
                                            },
                                            {
                                                "example_id": "5f9b3a0c-f15a-4304-b941-18785c33314a",
                                                "sense_id": "0369d74f-ca80-3c74-825b-8ea3e466da51",
                                                "text": "D’ailleurs mes parents adoraient la Russie, il est impossible de ne pas aimer la Russie et les Russes."
                                            },
                                            {
                                                "example_id": "e38bcecf-0af0-42ca-999d-06526fd2bbee",
                                                "sense_id": "0369d74f-ca80-3c74-825b-8ea3e466da51",
                                                "text": "Mais l'avance des Russes ne fait pas du tout rigoler Isabelle, elle sait bien que quand ils seront ici, ils ratiboiseront d'abord les palaces et après, tous les pleins aux as qui marinent dedans. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f29be8e3-49b1-3337-b931-354ff1cbae9f",
                                        "entry_id": "b1707fb2-c84a-3580-beb5-d75de133fb57",
                                        "glosses": [
                                            "Personne de citoyenneté russe, habitant de la Russie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
