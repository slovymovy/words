                "translations": [
                    {
                        "translation_id": "8044971c-5d66-4c26-bb78-780c9696bceb",
                        "source_entry_id": "318bcb2e-058d-32b1-9b32-59c7ab8fe98f",
                        "source_sense_id": "8189718f-600a-37c5-8d01-524296606afd",
                        "target_lang_word": "Archivarin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archivarin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b14c9c1-f671-37eb-8a36-7831eba39983",
                                        "entry_id": "d1d3b4a7-2f84-35f2-a7b5-443c542c6229",
                                        "glosses": [
                                            "Mitarbeiterin eines Archivs, die meist speziell für diese Arbeit ausgebildet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99652c45-4cfc-4f3a-9ebd-321e7a6e500d",
                                                "sense_id": "6b14c9c1-f671-37eb-8a36-7831eba39983",
                                                "text": "„Einen sensationellen Fund hat die Archivarin Christina Möller in der tschechischen Hauptstadt gemacht: Sie entdeckte an die 1200 bislang verloren geglaubte Briefe, Fotos und Manuskripte aus dem Nachlass von Heinrich Mann im Prager Literaturarchiv.“"
                                            },
                                            {
                                                "example_id": "b6180ca9-0945-4030-8d61-c80418121db6",
                                                "sense_id": "6b14c9c1-f671-37eb-8a36-7831eba39983",
                                                "text": "„Einer Archivarin des Vatikans sind 700 Jahre alte Prozessakten in die Hände gefallen, die das Ende des Templerordens beleuchten.“"
                                            },
                                            {
                                                "example_id": "8b7ead4e-0b62-4a20-97c9-863b6e88fff8",
                                                "sense_id": "6b14c9c1-f671-37eb-8a36-7831eba39983",
                                                "text": "„Die Irritation der Irene Kowaliska, die als Archivarin im Berliner Ullstein Verlag arbeitete, wuchs von Begegnung zu Begegnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
