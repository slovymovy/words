                ],
                "senses": [
                    {
                        "sense_id": "821fac2a-538c-311a-9773-d419d2b5898b",
                        "entry_id": "a553045e-3c4c-3621-bff4-8cc2d3746325",
                        "glosses": [
                            "спец. страд. прич. прош. вр. от йодировать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "f136a5ea-5542-4aa7-90f3-c4733c32107d",
                                "sense_id": "821fac2a-538c-311a-9773-d419d2b5898b",
                                "text": "Во всех случаях соль была йодирована стабильным йодатом калия."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b4c9fd4-44da-3724-ba46-b412421cf150",
                        "entry_id": "a553045e-3c4c-3621-bff4-8cc2d3746325",
                        "glosses": [
                            "статив. содержащий иод; подвергшийся введению или действию иода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f178dc1-8a84-474d-a0c3-7789b2ac3ac7",
                                "sense_id": "0b4c9fd4-44da-3724-ba46-b412421cf150",
                                "text": "Сейчас появились разнообразные йодированные продукты, такие как мука, хлеб, различные водоросли и даже яйца."
                            },
                            {
                                "example_id": "f31f9c44-53f7-41a9-a1ee-6073258074a1",
                                "sense_id": "0b4c9fd4-44da-3724-ba46-b412421cf150",
                                "text": "Появились и другие способы получения светописного изображения: ньепсотипия, использующая светочувствительный слой с альбумином, мокро-коллодионный способ, при котором йодированный коллодий очувствлялся раствором азотнокислого серебра и экспонировался в камере во влажном состоянии, и некоторые другие способы."
                            }
                        ]
                    }
