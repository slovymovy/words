                "senses": [
                    {
                        "sense_id": "65b38ff4-9d43-3689-990a-2e42cdb71071",
                        "entry_id": "2de9c0bf-5854-3d6b-8ee2-5d0a6fe7502d",
                        "glosses": [
                            "geleidelijk, geruisloos verdwijnen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "fc53b657-5916-44c1-9933-6f1cf68b865d",
                                "sense_id": "65b38ff4-9d43-3689-990a-2e42cdb71071",
                                "text": "Berustend in de gave kroop ik, viel ik en huilde,\nMijn beklemming vergleed, de dagen doordragen"
                            },
                            {
                                "example_id": "499b9252-6347-404a-8d3b-2d479d68ce61",
                                "sense_id": "65b38ff4-9d43-3689-990a-2e42cdb71071",
                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                            }
                        ]
                    }
