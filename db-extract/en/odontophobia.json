                    {
                        "sense_id": "aefd5713-087e-3bae-ab51-a79ae8f91376",
                        "entry_id": "bf5de543-7ec7-3e3d-aad2-fce301c64eb5",
                        "glosses": [
                            "An irrational fear of dentistry."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "46f804fa-27e6-456b-8607-36bc3dfcc259",
                                "sense_id": "aefd5713-087e-3bae-ab51-a79ae8f91376",
                                "text": "Odontophobia, or the fear of dental work, seems equally plausible, as does pentheraphobia - fear of the mother-in-law."
                            },
                            {
                                "example_id": "0078a8f9-086a-4597-a7d9-d40a3fa4af3e",
                                "sense_id": "aefd5713-087e-3bae-ab51-a79ae8f91376",
                                "text": "In fact, in dentistry, there is often a widespread condition of odontophobia among patients."
                            },
                            {
                                "example_id": "1ab57b18-5c6a-49df-87ae-6eefc18df598",
                                "sense_id": "aefd5713-087e-3bae-ab51-a79ae8f91376",
                                "text": "People with dentophobia, also called odontophobia, have a fear of dentists. Someone with dentophobia may have extreme anxiety at the thought of going to the dentist or while in the dentist’s office."
                            }
                        ]
                    }
                ],
