                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e417d55f-fafe-3942-b826-4cbbbfb48469",
                                        "entry_id": "afbfd30d-8e98-38eb-84ee-f742151552ed",
                                        "glosses": [
                                            "A fairy chess piece that can move to any adjacent square, that, when captured, the capturing piece is also eliminated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e387737e-fb10-46e4-9aea-22bfe011fa2c",
                                                "sense_id": "e417d55f-fafe-3942-b826-4cbbbfb48469",
                                                "text": "The courtesan moves like a mann, but whatever piece captures her is also removed from the board (unless it’s a king)."
                                            }
                                        ]
                                    }
                                ]
