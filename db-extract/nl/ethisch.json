                ],
                "senses": [
                    {
                        "sense_id": "3f050a55-689c-3a10-a2e0-aeb32435c453",
                        "entry_id": "8d4122fb-1ea6-37a1-9362-4a1b52f5e0a1",
                        "glosses": [
                            "tot de ethiek behorend of daarop betrekking hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afdae46d-9204-41d4-a8dc-335cec2bb7bf",
                                "sense_id": "3f050a55-689c-3a10-a2e0-aeb32435c453",
                                "text": "Het is niet ethisch om het vel van dieren als kledingstuk te gebruiken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6cd3a1f-5e1d-4b2d-a770-7f1af91f133f",
                        "source_entry_id": "8d4122fb-1ea6-37a1-9362-4a1b52f5e0a1",
                        "source_sense_id": "3f050a55-689c-3a10-a2e0-aeb32435c453",
                        "target_lang_word": "ethisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                        "entry_id": "4fa12420-40f5-3149-8d62-c14a21fdfc89",
                                        "glosses": [
                                            "auf die Ethik bezogen, die Ethik betreffend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f650677-141e-4aa1-88f2-43ee471c90c1",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "Die Gesetzesvorlage versucht, ethische Ansprüche zu verwirklichen."
                                            },
                                            {
                                                "example_id": "5a225c91-f2ed-45db-99d4-cd576cb8ce6b",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "„Es gibt keine ethische Rechtfertigung für die Mittel, deren sie sich bedient.“"
                                            },
                                            {
                                                "example_id": "2e030c88-3be5-49c8-be69-6345242759a4",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "„Die gesellschaftlichen Rahmenbedingungen, die ethische Substanz einer Gemeinschaft und die Existenz oder Nichtexistenz einer Wagniserziehung tragen einen wesentlichen Verantwortungsanteil daran, in welche Wertrichtung sich die Wagnistendenzen bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                        "entry_id": "4fa12420-40f5-3149-8d62-c14a21fdfc89",
                                        "glosses": [
                                            "gemäß der Ethik sich verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b95740-bf13-443b-801a-c99e08c5cbf7",
                                                "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                                "text": "Die Vorfälle waren ethisch gesehen unverzeihlich."
                                            },
                                            {
                                                "example_id": "d69d2ade-584d-4514-b1fe-99ffc3fb5fe0",
                                                "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                                "text": "„Man kann nicht nicht beeinflussen. Daher ist die Frage, wie Beeinflussung und Manipulation zu vermeiden wären, absurd; übrig bleibt nur die uns somit nie erlassene Entscheidung darüber, wie dieses Grundgesetz menschlicher Kommunikation verantwortlich und in der humansten, ethischsten und wirkungsvollsten Weise anzuwenden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef28e33-6281-4550-99eb-487804518222",
                        "source_entry_id": "8d4122fb-1ea6-37a1-9362-4a1b52f5e0a1",
                        "source_sense_id": "3f050a55-689c-3a10-a2e0-aeb32435c453",
                        "target_lang_word": "ethical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd54492-97ea-309e-9520-1440e4058485",
                                        "entry_id": "59a9efd4-d5ee-3bb8-a1e8-e395ada95196",
                                        "glosses": [
                                            "Of or relating to the study of ethics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f838f925-6346-4362-816c-9122544f730d",
                                                "sense_id": "4dd54492-97ea-309e-9520-1440e4058485",
                                                "text": "The philosopher Kant is particularly known for his ethical writings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5225e8e-d244-35ad-b90f-9bfe0d749097",
                                        "entry_id": "59a9efd4-d5ee-3bb8-a1e8-e395ada95196",
                                        "glosses": [
                                            "Of or relating to the accepted principles of right and wrong, especially those of some organization or profession."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73fd5cdb-10ac-40a8-9842-b25e2f4a0c1f",
                                                "sense_id": "c5225e8e-d244-35ad-b90f-9bfe0d749097",
                                                "text": "All employees must familiarize themselves with our ethical guidelines."
                                            },
                                            {
                                                "example_id": "4083797c-ea17-49be-b529-326260eddcab",
                                                "sense_id": "c5225e8e-d244-35ad-b90f-9bfe0d749097",
                                                "text": "An angry dispute between an animal welfare charity and its former employee will be the first case in Britain to decide whether ethical veganism is a “philosophical belief” that should be afforded the same protections as religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2110b963-b393-3eb6-9e88-ae02229e4e62",
                                        "entry_id": "59a9efd4-d5ee-3bb8-a1e8-e395ada95196",
                                        "glosses": [
                                            "Morally approvable; good."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b03689b7-b498-40ba-970e-e40b14ea19c4",
                                                "sense_id": "2110b963-b393-3eb6-9e88-ae02229e4e62",
                                                "text": "We are trying to decide what the most ethical course of action would be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8629803-b4f4-3c74-952d-3faba5b5a539",
                                        "entry_id": "59a9efd4-d5ee-3bb8-a1e8-e395ada95196",
                                        "glosses": [
                                            "Only dispensed on the prescription of a physician."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63aad51c-6297-46a7-901b-7a9aad2753b6",
                                                "sense_id": "e8629803-b4f4-3c74-952d-3faba5b5a539",
                                                "text": "In most jurisdictions, morphine is classified as an ethical drug."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ethical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a5dbb14-7772-3d5c-84f1-74914116c366",
                                        "entry_id": "6b158d80-a3c2-3172-a00f-75c9eb876502",
                                        "glosses": [
                                            "An ethical drug, one only dispensed on the prescription of a physician."
                                        ],
                                        "tags": [],
