                "senses": [
                    {
                        "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                        "entry_id": "8a648c99-8554-3ee9-8c80-e07fd28b9295",
                        "glosses": [
                            "Übung, die zur körperlichen Leistungsfähigkeit und Gesundheit beiträgt, indem sie Beweglichkeit, Kraft, Ausdauer, Koordination oder Gleichgewicht trainiert"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "0814da58-3f46-451c-b787-a57b3ce5cf48",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Eine beliebte Fitnessübung für das Bizeps-Training sind die Scott Curls.“"
                            },
                            {
                                "example_id": "69dc2a40-c6e3-4f2a-8875-c5f5d9370b6b",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Auch andere Muskelgruppen wie Bauch, Gesäß und Rücken werden bei diesen Fitnessübungen aktiviert.“"
                            },
                            {
                                "example_id": "2e6e7620-ca51-44e1-a028-7fedd3c8f1d0",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Nach den üblichen Fitnessübungen gab es ein kleines Handballspiel auf vier Tore – um die Köpfe frei zu bekommen und um ein wenig Spaß ins Training einzubauen.“"
                            },
                            {
                                "example_id": "2f31ead3-e94c-4c09-b96d-56df89cdfcd5",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Das Team stellte sich im großen Kreis auf und absolvierte 20 Minuten lang diverse Fitnessübungen im scharfen Bundeswehr-Feldwebel-Ton.“"
                            },
                            {
                                "example_id": "a8c75234-1ebb-4774-ad0c-566f51ee1027",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Im Folgenden lernst du Körperposition und Bewegungsausführung dieser Fitnessübung näher kennen.“"
                            },
                            {
                                "example_id": "e2e792e9-af76-4c7e-b917-f2c684f36f96",
                                "sense_id": "072e07ab-4313-30dd-a7f7-90b2bf7ade91",
                                "text": "„Die Fitnessübung Multipresse Hip Thrust beansprucht vorrangig den großen Gesäßmuskel (musculus gluteus maximus), Beinbizeps (musculus biceps femoris), Plattsehnenmuskel (musculus semimembranosus) und Halbsehnenmuskel (musculus semitendinosus).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
