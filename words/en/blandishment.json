    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2ef6aa7-fb56-3c47-bc6b-296d519be7a8",
                    "sense_definition": "A flattering or pleasing action or speech intended to coax, entice, or persuade someone (frequently used in the plural).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to yield to the sweet <w>blandishments</w> of the salesperson."
                        },
                        {
                            "text": "Despite her charming <w>blandishments</w>, she could not convince the committee to approve the proposal."
                        }
                    ],
                    "synonyms": [
                        "cajolery",
                        "flattery",
                        "sycophancy",
                        "adulation"
                    ],
                    "common_phrases": [
                        "resist the blandishments"
                    ]
                },
                {
                    "sense_id": "1cb227f8-057c-3134-b21c-746d32dbab32",
                    "sense_definition": "An alluring or attractive quality or temptation, especially one that entices someone toward a particular choice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "True leaders must learn to resist the <w>blandishments</w> of power and prestige."
                        },
                        {
                            "text": "He remained unimpressed by the materialistic <w>blandishments</w> of life in the capital."
                        }
                    ],
                    "common_phrases": [
                        "blandishments of power"
                    ]
                }
            ]
        }
    ]
