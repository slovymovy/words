                {
                    "sense_id": "c2ff8121-8e9c-332f-bc9a-8ac9ebe25404",
                    "sense_definition": "Tribunal de la conscience ou jugement intime d'une personne, employé quasi exclusivement dans l'expression « for intérieur ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En son <w>for</w> intérieur, il savait pertinemment qu'il avait commis une grave erreur."
                        },
                        {
                            "text": "Elle gardait le silence mais ressentait un profond soulagement au fond de son <w>for</w> intérieur."
                        }
                    ],
                    "synonyms": [
                        "conscience",
                        "cœur"
                    ],
                    "common_phrases": [
                        "for intérieur",
                        "en son for intérieur",
                        "dans son for intérieur"
                    ]
                },
                {
                    "sense_id": "7eb71ac9-a310-3306-bfb9-ae48cde389b4",
                    "sense_definition": "Juridiction ou tribunal territorialement compétent pour instruire et juger un litige.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux entreprises ont désigné ce tribunal comme le <w>for</w> compétent en cas de litige commercial."
                        },
                        {
                            "text": "La convention détermine précisément le <w>for</w> devant lequel les parties devront régler leur différend."
                        }
                    ],
                    "synonyms": [
                        "tribunal",
                        "juridiction"
                    ],
                    "common_phrases": [
                        "élection de for"
                    ]
                }
            ]
        }
