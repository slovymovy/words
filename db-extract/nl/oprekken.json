                "senses": [
                    {
                        "sense_id": "ea1dab23-c177-380a-a914-d28b721d2d37",
                        "entry_id": "2f78735f-c143-3820-999f-e0e612147da3",
                        "glosses": [
                            "iets door rekken groter maken of uitbreiden met name ook figuurlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1267dce9-3cf1-4253-9c22-723d09557a31",
                                "sense_id": "ea1dab23-c177-380a-a914-d28b721d2d37",
                                "text": "„Het maximum aantal vliegbewegingen op Schiphol is een politieke afspraak en heeft niets met de werkelijke situatie te maken. Wij verwachten dat de luchthaven dit zal oprekken naar 550.000 bewegingen”, zegt O’Leary."
                            },
                            {
                                "example_id": "d8bc327d-860b-45ae-86d3-7442359c807e",
                                "sense_id": "ea1dab23-c177-380a-a914-d28b721d2d37",
                                "text": "De bank zal niet terugkeren in de volledige markt van zakelijke kredietverleningen, benadrukt de zegsman: „Maar het ligt in de lijn der verwachting dat wij na deze test doorgaan met kredietverlening aan het kleinbedrijf, waarbij wij het bedrag mogelijk oprekken. De €250.000 die MKB-Nederland noemt, is geen gekke suggestie.”"
                            }
                        ]
                    }
