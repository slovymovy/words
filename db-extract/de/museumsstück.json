                                "target_senses": [
                                    {
                                        "sense_id": "994f379f-ec2f-3717-b8c8-3aa13eee3e32",
                                        "entry_id": "efc2427d-38e0-35f4-8448-bc051d25aca6",
                                        "glosses": [
                                            "An item worthy of being kept by a museum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c07584-17bd-431d-8312-b86ef0fc73de",
                                                "sense_id": "994f379f-ec2f-3717-b8c8-3aa13eee3e32",
                                                "text": "These excursions proved popular, and it is, perhaps, not too much to hope that British Railways will revive the idea, and use museum pieces to stage exhibitions of trains of bygone days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a04606-f360-3ea7-a940-1c8ed42c48db",
                                        "entry_id": "efc2427d-38e0-35f4-8448-bc051d25aca6",
                                        "glosses": [
                                            "A very old item, especially an obsolete piece of technology."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d7c94a-b8b0-41e2-9de8-7359212a6767",
                                                "sense_id": "17a04606-f360-3ea7-a940-1c8ed42c48db",
                                                "text": "Jim's car is a real museum piece."
                                            },
                                            {
                                                "example_id": "4399c501-108c-42e8-a1bf-e6efb7a33df0",
                                                "sense_id": "17a04606-f360-3ea7-a940-1c8ed42c48db",
                                                "text": "A Sinclair Spectrum computer is now just a museum piece."
                                            }
                                        ]
                                    }
                                ]
                            }
