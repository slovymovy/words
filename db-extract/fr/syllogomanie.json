                        "entry_id": "bfd6e96b-f2d8-3cef-903c-4fd78fa305d8",
                        "glosses": [
                            "Collectionnite aiguë ; tendance excessive à l’accumulation d’objets hétéroclites et inutiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01c0359c-66ad-4186-ae8b-20a3a1153716",
                                "sense_id": "b71bef5b-630c-3c45-8e56-89d4b222ecc5",
                                "text": "« La » syllogomanie. C’est l’accumulation chez soi de trucs, de machins, de vieilleries. Les collections de détritus. Le bazar, quoi ! Le taudis !"
                            }
                        ]
                    }
                ],
