                        "examples": [
                            {
                                "example_id": "c598fefb-2e75-4683-b2e9-129caed450af",
                                "sense_id": "d94798b8-cd94-3b97-bfb7-57d599c2e03e",
                                "text": "Riek Sombekke is geboren in Denekamp en heeft op een korte periode na altijd in Dinkelland gewoond. Tot haar 104-de jaar heeft ze zelfstandig gewoond, met zorghulp. Het laatste levensjaar bracht ze door in zorgcentrum Gerardus Majella in Denekamp."
                            },
                            {
                                "example_id": "d70f175a-0469-4816-95fc-fbacdd191f5a",
                                "sense_id": "d94798b8-cd94-3b97-bfb7-57d599c2e03e",
                                "text": "Oddo benadrukt dat de zorg aan de mensen in de getroffen afdeling steeds is geleverd. „Een compliment waard voor onze medewerkers, de zorghulp is niet in het gedrang geweest, ondanks de moeilijke omstandigheden waarin ze moesten werken.”"
                            }
                        ]
