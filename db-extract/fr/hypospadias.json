                                    {
                                        "sense_id": "aef55f9c-226b-3e40-98e1-f444635db284",
                                        "entry_id": "d23a05f4-016e-349a-b943-ad7c77908765",
                                        "glosses": [
                                            "A congenital condition in males in which the opening of the urethra is on the underside of the penis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b107c7a-d8dd-422d-ade0-3e542c27334b",
                                                "sense_id": "aef55f9c-226b-3e40-98e1-f444635db284",
                                                "text": "This condition, hypospadias, may be examined ad stuporem in the hundreds of photographs of Hugh Hampton Young's pioneering text, Genital Abnormalities, Hermaphroditism, and Related Adrenal Diseases (1937)."
                                            },
                                            {
                                                "example_id": "53fa3178-58db-4b7c-a81f-27fda7463eb0",
                                                "sense_id": "aef55f9c-226b-3e40-98e1-f444635db284",
                                                "text": "At the same time, they corrected Jack’s hypospadias, a condition that meant his urethra opened at the base of his penis, moving it further up so he could pee more like a boy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
