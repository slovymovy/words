                        "glosses": [
                            "badanie przez prokuraturę, policję i uprawnione osoby, czy i w jakich okolicznościach popełnione zostało przestępstwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "366547f9-a8cb-411f-b528-4813700bb6ff",
                                "sense_id": "a148462b-0f0a-3432-b018-c4e6bc910ffc",
                                "text": "Prokuratura wszczęła śledztwo przeciwko byłemu politykowi."
