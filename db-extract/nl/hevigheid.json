                    {
                        "sense_id": "09bc495c-a903-332a-b264-c9686902202d",
                        "entry_id": "40b6180f-4d7c-3765-817e-afc618e2f3db",
                        "glosses": [
                            "met heel veel energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f59eca9-3ad3-47d9-a34a-26efe38448b2",
                                "sense_id": "09bc495c-a903-332a-b264-c9686902202d",
                                "text": "Het onweer barstte in alle hevigheid los."
                            },
                            {
                                "example_id": "0111b1a6-6d56-4ce7-ab53-5f15c401fd74",
                                "sense_id": "09bc495c-a903-332a-b264-c9686902202d",
                                "text": "Nietzsches Umwertung aller Werte (de herwaardering van alle waarden na de spreekwoordelijke moord op God) is nog in volle hevigheid bezig. Sommigen proberen God te reanimeren, anderen zijn allang weer verder gegaan. De strijd tussen mensen is een waardenstrijd. We kunnen niets doen behalve praten met elkaar, in de hoop eruit te komen óf elkaar in onze waarde te laten. Mijn frustratie zit hem in het feit dat dat gesprek kennelijk zo lastig is."
                            }
                        ]
                    }
                ],
