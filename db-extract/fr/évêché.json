        "fr-extract.jsonl": [
            {
                "entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                "word": "évêché",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9feb507e-0341-4f6e-b7b8-7b64cf94340e",
                        "entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "tags": [
                            "plural"
                        ],
                        "form": "évêchés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54c6a9b0-b2cc-3fdf-a06c-fc6442f3fff6",
                        "entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "glosses": [
                            "Institution ecclésiale rassemblant un évêque, un siège (une église cathédrale), un peuple chrétien et un diocèse (territoire soumis à l’autorité spirituelle de l'évêque d'un même lieu)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b4a9f5-6de4-4e02-b246-8c1ba2cb3f15",
                                "sense_id": "54c6a9b0-b2cc-3fdf-a06c-fc6442f3fff6",
                                "text": "Rambervillers dépendait du temporel de l'évêché de Metz, et les évêques en étaient suzerains; […]."
                            },
                            {
                                "example_id": "6609bd07-6f7f-4c98-ac87-cdf1f956ff63",
                                "sense_id": "54c6a9b0-b2cc-3fdf-a06c-fc6442f3fff6",
                                "text": "Dans les seuls évêchés de Dol, Saint-Malo et Saint-Brieuc, quatorze feudataires dont les revenus nobles propres allaient de 1500 à 40 livres monnaie appartenaient à la maison du vicomte de Rohan."
                            }
                        ]
                    },
                    {
                        "sense_id": "48ebaff6-ef5a-3a91-b7f5-3281286a0958",
                        "entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "glosses": [
                            "La ville où a été érigé un siège épiscopal, c’est-à-dire où réside un évêque."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "efcbaba7-0c2b-4df4-a2e6-b0fdc99c3a0f",
                                "sense_id": "48ebaff6-ef5a-3a91-b7f5-3281286a0958",
                                "text": "Orléans est un évêché, est évêché."
                            },
                            {
                                "example_id": "318c749d-300c-496e-83ec-5b6c72cdd590",
                                "sense_id": "48ebaff6-ef5a-3a91-b7f5-3281286a0958",
                                "text": "On érigea telle ville en évêché."
                            }
                        ]
                    },
                    {
                        "sense_id": "74668329-6052-3c52-ab80-c024152faa18",
                        "entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "glosses": [
                            "Demeure de l’évêque ou bâtiment où réside son administration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb9e607-dadb-4bcd-af7b-035cdba9ba3a",
                                "sense_id": "74668329-6052-3c52-ab80-c024152faa18",
                                "text": "Il est logé à l’évêché."
                            },
                            {
                                "example_id": "b2e05554-3a57-48ad-a52f-6480e1d04143",
                                "sense_id": "74668329-6052-3c52-ab80-c024152faa18",
                                "text": "Cette réunion se tient à l’évêché."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec204fb7-14c9-43e5-ac34-410f761a17bd",
                        "source_entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "target_lang_word": "Bistum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bistum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304e9784-34df-3f9c-8f54-e275a7193573",
                                        "entry_id": "aec3e17a-730e-3abf-99fe-505cc4625163",
                                        "glosses": [
                                            "Amtsbezirk eines Bischofs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd926e6f-aa33-4d2b-8a5f-49f159994a97",
                                                "sense_id": "304e9784-34df-3f9c-8f54-e275a7193573",
                                                "text": "Der Bischof hat sein eigenes Bistum."
                                            },
                                            {
                                                "example_id": "5aecb9c7-948e-454a-a9ba-2502af20d9af",
                                                "sense_id": "304e9784-34df-3f9c-8f54-e275a7193573",
                                                "text": "„Am 1. Oktober 948 wurde auf dem Reichstage in Magdeburg das Bistum Havelberg als Suffraganbistum zunächst der Diözese Mainz, seit 968 des neu geschaffenen Erzbistums Magdeburg begründet.“"
                                            },
                                            {
                                                "example_id": "2c903cb5-7662-48d9-be8d-f1cfb2c69b87",
                                                "sense_id": "304e9784-34df-3f9c-8f54-e275a7193573",
                                                "text": "Laut einem Medienbericht überlegt der Vatikan, das Bistum Limburg nach der Verschwendungs-Affäre um Tebartz-van Elst aufzulösen. Ein Sprecher des Bistums nannte das „reine Spekulation“."
                                            },
                                            {
                                                "example_id": "d0f7728f-1214-42c3-bc86-e1a51394bb0b",
                                                "sense_id": "304e9784-34df-3f9c-8f54-e275a7193573",
                                                "text": "„Zur Regierungszeit Ludwigs des Frommen wurde auch zum ersten Mal die königliche Münzhoheit durchbrochen, indem Bistümer und Abteien das Münzrecht oftmals zusammen mit Zoll- und Marktrecht erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39b1286f-7102-4794-a29b-81a9bbbf6367",
                        "source_entry_id": "0a0a5723-df3d-3755-86d4-8043f3539cff",
                        "target_lang_word": "bishopric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bishopric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ca70d3-8ab8-3aed-882a-03b8d17ae7db",
                                        "entry_id": "4db40234-65bd-3bdb-abc9-51b5b55a5b2a",
                                        "glosses": [
                                            "A diocese or region of a church which a bishop governs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ae318f-7fb6-4b0c-8758-b4fae0d7a22f",
                                                "sense_id": "f7ca70d3-8ab8-3aed-882a-03b8d17ae7db",
                                                "text": "Later that year, he was appointed to the bishopric of Lindesmeere."
                                            },
                                            {
                                                "example_id": "8d2bf419-8ac6-4433-bdee-5e7bfaefc959",
                                                "sense_id": "f7ca70d3-8ab8-3aed-882a-03b8d17ae7db",
                                                "text": "Iohn Fiſher Biſhop of Rocheſter, when the King [Henry VII of England] would have tranſlated him from that poore Biſhopricke to a better, he refuſed, saying: He would not forſake his poore little olde wife, with whom he had ſo long lived."
                                            },
                                            {
                                                "example_id": "8036b836-76a3-44b0-8abb-b6f911a7080a",
                                                "sense_id": "f7ca70d3-8ab8-3aed-882a-03b8d17ae7db",
                                                "text": "Wiltshire actually comes from Wiltonshire, for Wilton was once a county town, royal residence and bishopric - a place of significance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf7841a-ae1a-3cde-b67f-e1e21c498f9b",
                                        "entry_id": "4db40234-65bd-3bdb-abc9-51b5b55a5b2a",
                                        "glosses": [
                                            "The office or function of a bishop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
