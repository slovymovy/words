            "senses": [
                {
                    "sense_id": "e286804b-316a-36ca-a493-c9b9c20b65f5",
                    "sense_definition": "A person who lives in a colony or comes from a country controlled by another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>colonials</w> were often treated as second-class citizens by the ruling empire.",
                            "target_lang_translations": {
                                "ru": "К <w>жителям колоний</w> правящая империя часто относилась как к гражданам второго сорта.",
                                "zh": "统治帝国经常将<w>殖民地居民</w>视为二等公民。"
                            }
                        },
                        {
                            "text": "Many <w>colonials</w> returned to Europe after the country gained independence.",
                            "target_lang_translations": {
