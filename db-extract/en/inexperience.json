                        "glosses": [
                            "A lack of experience."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1689da99-abfb-4562-a062-3ea8645ed34f",
                                "sense_id": "35d516b1-8b78-39f7-a3b7-1a7bb7d86d33",
                                "text": "I failed to get the job due to inexperience."
                            }
                        ]
                    }
