                "translations": [
                    {
                        "translation_id": "44e7bcfc-78d7-48e7-b194-3d66f65c5873",
                        "source_entry_id": "89af76ed-b87a-3076-a82c-ce6cf23a4120",
                        "source_sense_id": "793ad20a-3b83-37f4-a8b3-92e5e4402a01",
                        "source_sense_description": "beharrlich, eindringlich",
                        "target_lang_word": "beharrlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beharrlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                        "entry_id": "7bb60b0e-cb7f-35ee-9f63-7fb33c1c9888",
                                        "glosses": [
                                            "mit Ausdauer um etwas bemüht oder an etwas festhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69bf6e76-0de5-4fad-8537-9092a1960011",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Der mutmaßliche Täter schweigt beharrlich."
                                            },
                                            {
                                                "example_id": "20e62fb0-7ad5-484c-a0b4-d0d59a40b026",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Seid beharrlich im Gebet und wacht in ihm mit Danksagung."
                                            },
                                            {
                                                "example_id": "8d46dbab-38d6-461d-b93d-dcdb379aaea2",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46237b0d-2799-4e12-b3fc-ef9ad538c7f0",
                        "source_entry_id": "89af76ed-b87a-3076-a82c-ce6cf23a4120",
                        "source_sense_id": "793ad20a-3b83-37f4-a8b3-92e5e4402a01",
                        "source_sense_description": "beharrlich, eindringlich",
                        "target_lang_word": "eindringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindringlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                        "entry_id": "245c86e5-8000-3e6a-aa58-0ca2d79d6ca6",
                                        "glosses": [
                                            "mit großem Ernst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322209d8-365b-4920-9a66-b9846e875e40",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Mit eindringlichen Worten erzählte die alte Dame von der Flucht aus dem Krisengebiet."
                                            },
                                            {
                                                "example_id": "20bef733-12e3-47a7-bd65-8eef44a76589",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Die Behörden warnen eindringlich davor Drogen unbekannter Herkunft zu konsumieren, da die Gefahr einer Vergiftung besteht."
                                            },
                                            {
                                                "example_id": "1f5f00be-ad1c-4264-891b-cebcd0741cf6",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Im Jahr 168 v.Chr. erlosch die makedonische Monarchie. Den Schlussakt aber setzte die Zerstörung Korinths im Jahr 146 v.Chr., die parallel zur Zerstörung Karthagos stattfand und den ungehemmten Anspruch Roms auf die Weltherrschaft in Ost und West eindringlich dokumentierte.“"
                                            },
                                            {
                                                "example_id": "cf75af93-f82c-4d60-831c-5acfb5c47061",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„\"Ein Jahr voller Klimakatastrophen und eindringlichen Warnungen der besten Wissenschaftler weltweit hätten zu viel mehr führen sollen\", so Greenpeace-Chefin Jennifer Morgan.“"
                                            },
                                            {
                                                "example_id": "1b01376c-8cd7-42ff-a604-0e31de6f6a16",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Eindringlich wies Lennart Meri auf die Gefahr der russischen Großmachtfantasien hin – und verurteilte die vorherrschende westliche Appeasement-Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
