                        "target_lang_word": "pektin",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "34c73b97-027c-4f19-9572-06c7e872f404",
                        "source_entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                        "source_sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
