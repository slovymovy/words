                    {
                        "sense_id": "19ca29b2-c870-302a-bfa2-e595e1ce58d9",
                        "entry_id": "6d679be6-b567-3bd2-a67a-dd95cc3213c2",
                        "glosses": [
                            "taaluiting die een daad verricht of een toestand creëert door het feit dat deze wordt uitgesproken onder passende of conventionele omstandigheden, bijv. Ik bied, ik verontschuldig me, ik beloof..."
                        ],
