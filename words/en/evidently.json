{
    "word_family": [
        "evidence",
        "evident"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6bed29c5-6338-34e7-ae4a-afd6ec1a0a6c",
                    "sense_definition": "Used to say that something is clearly seen, understood, or inferred from available facts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>evidently</w> upset by the news, although she tried hard not to cry.",
                            "target_lang_translations": {
                                "zh": "尽管她极力忍住不哭，但这消息<w>显然</w>让她非常难过。"
                            }
                        },
                        {
                            "text": "He has <w>evidently</w> forgotten about our meeting, because he is not answering his phone.",
                            "target_lang_translations": {
                                "zh": "他一直不接电话，<w>看来</w>是把我们的会议给忘了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obviously",
                        "clearly",
                        "plainly"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于表明根据已知事实或证据，某事显而易见、容易理解或可以推断出；显然地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "根据事实推断出的显而易见"
                            },
                            {
                                "target_lang_word": "明显",
                                "target_lang_sense_clarification": "清楚明白，容易看出"
                            },
                            {
                                "target_lang_word": "看来",
                                "target_lang_sense_clarification": "依情况推测，似乎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55209347-7b03-35fc-a1f4-cdde84e4547f",
                    "sense_definition": "In a manner that is clearly visible, plain, or distinct to the sight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The details of the ancient inscription were <w>evidently</w> displayed beneath the bright museum light.",
                            "target_lang_translations": {
                                "zh": "在博物馆明亮的灯光下，古老碑铭的细节被<w>清晰地</w>展现了出来。"
                            }
                        },
                        {
                            "text": "The path forward was <w>evidently</w> marked with white paint along the trees.",
                            "target_lang_translations": {
                                "zh": "前方的路径沿着树木用白漆做了<w>明显地</w>标记。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conspicuously",
                        "markedly",
                        "vividly"
                    ],
                    "target_lang_definitions": {
                        "zh": "以肉眼清晰可见、明确醒目的方式呈现；显眼地、清晰地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清晰地",
                                "target_lang_sense_clarification": "视觉上清清楚楚地"
                            },
                            {
                                "target_lang_word": "明显地",
                                "target_lang_sense_clarification": "显眼、容易被看到地"
                            },
                            {
                                "target_lang_word": "醒目地",
                                "target_lang_sense_clarification": "引人注目、显而易见地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}