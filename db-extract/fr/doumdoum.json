                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258093bd-63cd-4dbe-b8fe-b736dc9ad6bf",
                                "sense_id": "5ed915f4-f61f-3ee3-88be-3f8e6953195e",
                                "text": "Chacun(e) muni(e) d'un doumdoum et de 2 baguettes, on frappe en rythme et on danse ensemble."
                            },
                            {
                                "example_id": "0b48ff44-af6a-469e-9adb-12efbf7b4d12",
                                "sense_id": "5ed915f4-f61f-3ee3-88be-3f8e6953195e",
                                "text": "Avec l’aide de Cheick Tidiane Seck, elle s’est entourée de grands musiciens maliens, auxquels elle a demandé de jouer des instruments traditionnels, comme la kora, le bolon ou le fameux doumdoum."
                            }
                        ]
