                    "frequency": "VeryLow",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker opened the lecture with a quick <w>capitulation</w> of the key discoveries."
                        },
                        {
                            "text": "Each chapter concluded with a neat <w>capitulation</w> of the fundamental concepts discussed."
                        }
                    ],
                    "synonyms": [
