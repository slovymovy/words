                            {
                                "example_id": "912d2690-9bfd-4005-894e-a26a11751900",
                                "sense_id": "aa4b048d-a4a3-3b58-9148-1ebb81f520eb",
                                "text": "De lachende meisjes hadden veel plezier."
                            },
                            {
                                "example_id": "ae374099-5f85-4c80-abba-2b42e923257a",
                                "sense_id": "aa4b048d-a4a3-3b58-9148-1ebb81f520eb",
                                "text": "De schoenen slingeren nog steeds over de vloer, de afwas staat nog op het aanrecht, de foto van een vrolijk lachend gezin hangt nog aan de muur."
                            },
                            {
                                "example_id": "5aa2ac16-5a7f-436a-8ef8-0919f0dac1c8",
                                "sense_id": "aa4b048d-a4a3-3b58-9148-1ebb81f520eb",
                                "text": "' Ik kijk in haar lachende gezicht, en even doet alles een klein beetje minder pijn."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "51ba2288-1c0a-310b-906c-da22647ae498",
