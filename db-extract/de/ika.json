                    },
                    {
                        "sense_id": "156fd16d-6c82-3e63-b86a-cec9dc103f67",
                        "entry_id": "7161d404-5b45-30c4-a7d4-dd28f4fd8fba",
                        "glosses": [
                            "Internationale Kochkunst-Ausstellung (früher Frankfurt, dann Berlin, jetzt Erfurt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc8fb93-0960-41b4-bd9d-78a8936fd996",
                                "sense_id": "156fd16d-6c82-3e63-b86a-cec9dc103f67",
                                "text": "„Erwähnt seien die »Patent- und Musterschutz-Ausstellung« des Jahres 1881 und die bahnbrechende »Elektro-technische Ausstellung« von 1891 unter Leitung von Oskar von Miller, die »Internationale Kochkunst-Ausstellung (IKA)«, die erstmalig 1900 stattfand, und die »Internationale Luftfahrt-Ausstellung (ILA)« von 1909.“"
                            },
                            {
                                "example_id": "75071fba-f78b-4687-b388-78f8d71a598d",
                                "sense_id": "156fd16d-6c82-3e63-b86a-cec9dc103f67",
                                "text": "„Wie die Qualität der gastronomischen Leistungen beurteilt werden kann, zeigen die bei der »Olympiade der Köche« auf der IKA (Internationale Kochkunst Ausstellung) verwendeten Bewertungskriterien […]“"
                            },
                            {
                                "example_id": "4f26fc68-1da0-4b21-ac76-5f970fc87538",
                                "sense_id": "156fd16d-6c82-3e63-b86a-cec9dc103f67",
                                "text": "„IKA - Internationale Kochkunst-Ausstellung, die als eine der traditionsreichsten Frankfurts einen internationalen Wettbewerb der Kochkunst zum Mittelpunkt hat und verbunden ist mit einer Fachschau für das Hotel- und Gaststättengewerbe (etwa 450 Aussteller).“"
                            },
                            {
                                "example_id": "eed053af-2ae2-4ecb-9b23-ede433dad72d",
                                "sense_id": "156fd16d-6c82-3e63-b86a-cec9dc103f67",
                                "text": "„Wir sind sehr froh, daß er — gerade vor 2 Wochen bei der Internationalen Kochkunst-Ausstellung (IKA) in Frankfurt/Main, die Goldmedaille erhielt für seine Werksverpflegung, die sowohl vollwertig als schmackhaft, und »künstlerisch wertvoll« war […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
