                    }
                },
                {
                    "sense_id": "57054030-c8ab-3c9f-96e1-1e165ec56aef",
                    "sense_definition": "The way in which words and phrases are actually used in a particular language or community.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictionary provides many examples of modern English <w>usage</w> to help students learn.",
                            "target_lang_translations": {
                                "ru": "Словарь приводит множество примеров современного английского <w>употребления</w>, чтобы помочь студентам в обучении."
                            }
                        },
                        {
                            "text": "In descriptive linguistics, word senses are established by common <w>usage</w> rather than strict rules.",
                            "target_lang_translations": {
                                "ru": "В дескриптивной лингвистике значения слов устанавливаются общим <w>словоупотреблением</w>, а не строгими правилами."
                            }
                        }
                    ],
                    "synonyms": [
                        "parlance",
                        "phraseology",
                        "style"
                    ],
                    "common_phrases": [
                        "common usage",
                        "modern usage",
                        "language usage",
                        "standard usage"
                    ],
                    "target_lang_definitions": {
