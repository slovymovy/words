                ],
                "senses": [
                    {
                        "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                        "entry_id": "ce2b54f6-16ef-3ec9-a83e-b5c546fae49b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff7fb54-55df-48c9-9013-cf422a75ee99",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Frau Kuschel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7bee35ee-0604-4118-8619-7ada8d93a47c",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Herr Kuschel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cacda2d2-ddaf-4795-a9dc-b464d038cc89",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Die Kuschels fliegen heute nach Stuttgart."
                            },
                            {
                                "example_id": "38e45b82-8c75-43c1-9519-bfaa36f7e41d",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Der Kuschel trägt nie die Pullover, die die Kuschel ihm strickt."
                            },
                            {
                                "example_id": "a9492372-2869-4488-9f29-e764584919a8",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuschel kommt, geht der Herr Kuschel.“"
                            },
                            {
                                "example_id": "bcca8d60-125f-4b0c-8a0a-6273787c3968",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Kuschel kommt und geht."
                            },
                            {
                                "example_id": "5b2803fc-89bb-4c7e-bffc-f2b64dafff67",
                                "sense_id": "8103042b-9968-3f35-becd-e4611f71eadf",
                                "text": "Kuschels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
