                                "target_senses": [
                                    {
                                        "sense_id": "62cc7ae9-2a5f-333c-a3b5-13f9451f529a",
                                        "entry_id": "46a292bc-f418-3d8d-a41f-51b193638b3a",
                                        "glosses": [
                                            "Abnormal; irregular; misshapen."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec2a2caf-1f0e-41d0-9684-6f0f8ae24b7f",
                                                "sense_id": "62cc7ae9-2a5f-333c-a3b5-13f9451f529a",
                                                "text": "Sir Toby Matthews was a character equally , if not of a more abnormous cast , than his suspected coadjutor"
                                            },
                                            {
                                                "example_id": "4c00cddb-3ee4-40d5-992f-9f76d8f96ed4",
                                                "sense_id": "62cc7ae9-2a5f-333c-a3b5-13f9451f529a",
                                                "text": "No branch , except in the abnormous cases , is given off from the common carotid between its origin and bifurcation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1a84595-e820-4533-b69a-0d62350e5981",
                        "source_entry_id": "683780fa-582a-3e81-9f1b-1883bd35d32d",
                        "source_sense_id": "96193833-92e9-39e0-9b18-700a4dc35cc9",
