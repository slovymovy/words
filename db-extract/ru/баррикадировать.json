                                    {
                                        "sense_id": "18696f64-e082-35cb-8474-cc5c93a8fffe",
                                        "entry_id": "33d05fbb-1a18-3f94-ae2a-31c7234e0902",
                                        "glosses": [
                                            "Fermer, obstruer par une barricade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77cdf828-b147-4b0f-9f57-df7eb9306a9c",
                                                "sense_id": "18696f64-e082-35cb-8474-cc5c93a8fffe",
                                                "text": "L'ours tomba en arrière, frappé à mort sans doute, et la porte, refermée, put être barricadée solidement."
                                            },
                                            {
                                                "example_id": "1e3d291b-072c-4760-ad71-0a7af4f9dc4b",
                                                "sense_id": "18696f64-e082-35cb-8474-cc5c93a8fffe",
                                                "text": "Bagneux était à nous. Il s'agissait de le garder. On se mit à l’œuvre. On crénela les murs, on barricada les rues, et deux batteries s'établirent sur la place même, prêtes à balayer les issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4971ea8-df76-3536-b69b-1b5b8ed22e12",
                                        "entry_id": "33d05fbb-1a18-3f94-ae2a-31c7234e0902",
                                        "glosses": [
                                            "Opposer au devant de soi tout ce que l’on peut pour faire obstacle à l’ennemi, pour se mettre à couvert, pour se défendre."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415d8ba9-079a-4617-a032-af226a64017d",
                                                "sense_id": "a4971ea8-df76-3536-b69b-1b5b8ed22e12",
                                                "text": "Celles-ci, nouvelles amazones, placèrent des sentinelles sur le clocher et se barricadèrent dans le chœur de l'église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f860e5-01d1-3e7d-999e-cd8ca9354472",
                                        "entry_id": "33d05fbb-1a18-3f94-ae2a-31c7234e0902",
                                        "glosses": [
                                            "S’enfermer pour ne voir personne."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94e050c-170b-49b2-acc0-361adb694b09",
                                                "sense_id": "29f860e5-01d1-3e7d-999e-cd8ca9354472",
                                                "text": "Il se barricade tout le jour dans son cabinet."
                                            }
                                        ]
                                    }
