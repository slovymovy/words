                ],
                "senses": [
                    {
                        "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                        "entry_id": "4cfcace6-0e9c-3113-b905-8f12de7f31bd",
                        "glosses": [
                            "zugeführte, impulsstarke Luftströmung die sich mit der vorhanden Raumluft nicht vermengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6de03e-e96d-46cc-8090-398fe489facf",
                                "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                                "text": "„Bei der Kurzschlusslüftung führt der Luftvolumenstrom am Raum vorbei und ist deswegen nicht wirksam als Methode für den Luftwechsel.“"
                            },
                            {
                                "example_id": "7c0dc784-d707-422a-95e7-5867fc64f6f5",
                                "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                                "text": "„Die Lüftungseffizienz wird dabei stark von der vorgegebenen Luftführung beeinflusst – beispielsweise ist ein Vorbeiströmen der Außenluft, auch Kurzschlusslüftung genannt, ineffizient, während eine Verdrängungsströmung, welche die vorhandene Raumluft bestmöglich ersetzt, die wirksamste Methode darstellt.“"
                            },
                            {
                                "example_id": "fa137fdb-0b04-420a-a593-ba0414619e17",
                                "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                                "text": "„Das nennt sich Kurzschlusslüftung und führt nur dazu, dass das Gebäude auskühlt.“"
                            },
                            {
                                "example_id": "a2444cda-d73e-4359-a3be-2eca979a90b1",
                                "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                                "text": "„Falsch ist eine nur geklappte Fensteröffnung, dies entspricht einer Kurzschlusslüftung, die nur das Gebäude auskühlt.“"
                            },
                            {
                                "example_id": "8e1fec18-f58d-469e-bc9d-328dd6104f38",
                                "sense_id": "f47f24f3-c6ba-3f3c-8b70-0145cc961dc1",
                                "text": "„Diese sogenannte Kurzschlusslüftung wird vermieden, wenn sich Fenster und Außenluftansaugstellen nicht in der Nähe von Fortluftaustrittsstellen befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
