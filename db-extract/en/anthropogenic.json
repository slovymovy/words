                                "target_senses": [
                                    {
                                        "sense_id": "d93b284e-1aa0-3a52-8e41-09ac8a589b5f",
                                        "entry_id": "e7cb140d-b237-37c5-b493-d1861ab68abf",
                                        "glosses": [
                                            "durch den Menschen oder durch menschliches Handeln verursacht oder entstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301f74cd-3519-4eb5-80cc-67caab489f59",
                                                "sense_id": "d93b284e-1aa0-3a52-8e41-09ac8a589b5f",
                                                "text": "„Als anthropogene Klimasignale werden dabei diejenigen Varianz- bzw. Trendanteile der anthropogenen Klimabeeinflussung, die sich bestimmten Ursachen zuordnen lassen, bezeichnet.“"
                                            },
                                            {
                                                "example_id": "e2d23aa0-fdc8-4ee9-8623-fdf806685582",
                                                "sense_id": "d93b284e-1aa0-3a52-8e41-09ac8a589b5f",
                                                "text": "Anlagebedingt kommt es durch die Neuanlage von Wegen, Spielflächen, Freizeitmöglichkeiten und Ausstellungsflächen zu einer deutlich anthropogeneren Prägung des UG [Untersuchungsgebietes]."
                                            },
                                            {
                                                "example_id": "b1a65446-91b1-4655-8394-712be38a1cdc",
                                                "sense_id": "d93b284e-1aa0-3a52-8e41-09ac8a589b5f",
                                                "text": "Die künftige technische Umwelt wird nach Ansicht des Autors immer mehr anthropogenere Züge durch die menschlichen Gestaltungsaktivitäten annehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
