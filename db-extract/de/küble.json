                ],
                "senses": [
                    {
                        "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                        "entry_id": "a0b6e9d9-1a37-3497-806c-e23cda583901",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e0b384-29bd-4067-b589-620369741c95",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Frau Küble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "17fc86bd-a050-4eb7-bfe8-af7049c6a30f",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Herr Küble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ab46e3a8-bef9-4b63-9127-d0ffce1f3274",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Die Kübles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "de35bca8-e054-480c-bdf9-07da126f2d12",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Der Küble trägt nie die Schals, die die Küble ihm strickt."
                            },
                            {
                                "example_id": "e8362e5d-ef01-4bc4-9d56-17b99f8fba1f",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Küble kommt, geht der Herr Küble.“"
                            },
                            {
                                "example_id": "d57bde32-0be8-4979-8f74-5cf30f0b1cba",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Küble kommt und geht."
                            },
                            {
                                "example_id": "5b6f6776-de69-4300-93ad-37936578970e",
                                "sense_id": "921235eb-dd19-3c64-89c9-1bc3562f77e2",
                                "text": "Kübles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
