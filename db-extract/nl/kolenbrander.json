                        "source_sense_id": "577824c7-a1cf-3f1e-a746-d3c9b4dec300",
                        "source_sense_description": "iemand die houtskool maakt door onder uitsluiting van zuurstof hout te verhitten",
                        "target_lang_word": "Kohlemeiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlemeiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                        "entry_id": "950d88e0-3b3d-3a96-98c5-ddffa0b47a51",
                                        "glosses": [
                                            "Kraftwerk, das Energie produziert durch Verfeuerung von Braun- oder Steinkohle"
                                        ],
                                        "tags": [
                                            "Energie",
                                            "Umwelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b77c28-2768-4f61-8b67-572742cb4013",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[…] „Kohlemeiler stoßen besonders viel CO2 aus:“ […]."
                                            },
                                            {
                                                "example_id": "4f615970-a2ae-4fc3-8431-a9a5ee0a544d",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[2015:] „Tatsächlich entstehen derzeit in den Provinzen Limpopo und Mpumalanga zwei gigantische neue Kohlemeiler.“"
                                            },
                                            {
                                                "example_id": "b52130d1-be45-47a6-8a38-8e581c42558a",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[2020, Polen:] „Im ganzen Land sind zehn neue Kohlemeiler geplant, wovon sich fünf bereits im Bau befinden.“"
                                            },
                                            {
                                                "example_id": "d4431f10-37d6-4245-84ee-6fa9c02023b8",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[2022:] „34 Länder wollen neue Kohlemeiler errichten, allen voran China.“"
                                            },
                                            {
                                                "example_id": "d2987945-cdf1-48d1-b81a-0ca5e0ff7f8b",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "\"»Nur wenn klimaschädliche Kohlemeiler gut geplant vom Netz gehen, wird das Klimaziel erreicht.«\""
                                            },
                                            {
                                                "example_id": "118ba42e-3368-4a16-90d9-a52896be131b",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[2022: Das Kohlekraftwerk in Saint-Avold nahe der Grenze zum Saarland] „war Ende März vom Netz gegangen, bis auf ein weiteres Reservekraftwerk war es der letzte Kohlemeiler in Frankreich.“"
                                            },
                                            {
                                                "example_id": "44fb3dca-89d3-4e23-a32c-c13c75d8a476",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "„»Bis spätestens 2035 muss der letzte Kohlemeiler vom Netz«, sagt der Klimapolitiker Lorenz Gösta Beutin im Bundestag.“"
                                            },
                                            {
                                                "example_id": "38856cac-3eb7-4079-867a-df0802c3b7b7",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "„Obwohl Trump das Gegenteil versprach, gingen auch in seiner Amtszeit viele Kohlemeiler vom Netz.“"
                                            },
                                            {
                                                "example_id": "f7e1bf78-b5eb-4b4a-ab5a-11438da3f515",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "„Es gilt damit als sicher, dass die Kohlemeiler deutlich früher abgeschaltet werden müssen als 2038, was die Regierung bisher als spätestes Datum festgelegt hatte.“"
                                            },
                                            {
                                                "example_id": "fd9360ec-8ad0-49fb-97e7-c5422ee10d75",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "[Schlagzeile:] „Blockade am Kohlemeiler in Jänschwalde – Haftstrafe ohne Bewährung für Kohlegegner bleibt unverändert“"
                                            },
                                            {
                                                "example_id": "781f69e5-3c6b-4e5d-bea5-8a0fcd285fa9",
                                                "sense_id": "abbf5175-239e-30d1-8f67-023233f8b986",
                                                "text": "„Die Niederlande zum Beispiel beschlossen Ende 2019 den Kohleausstieg bis 2030. »Das schmälert die Gewinne aus unserem erst 2015 eröffneten Kohlemeiler in Rotterdam«, sagt jetzt das deutsche Unternehmen Uniper und droht, die Niederlande auf 850 Millionen Euro Schadenersatz zu verklagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                        "entry_id": "950d88e0-3b3d-3a96-98c5-ddffa0b47a51",
                                        "glosses": [
                                            "mit Erde abgedeckter Holzhaufen, in dem Holz zu Holzkohle verschwelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c7d71f-2a4e-4a99-9b86-5c0759ff3f54",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Jedes Jahr wird ein Kohlemeiler zur Holzkohlegewinnung aufgesetzt.“"
                                            },
                                            {
                                                "example_id": "abb0dd48-a451-4477-adc4-bb316870fc69",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„An einer Wegbiege oberhalb des Dorfs steht er, der Kohlemeiler des neugegründeten Köhlervereins.“"
                                            },
                                            {
                                                "example_id": "d6d21e3f-4fd4-44ad-a8cc-8fc3b39db35e",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "[…] „am Freitag zündet Köhlerin Doris Wicki den Kohlemeiler an.“"
                                            },
                                            {
                                                "example_id": "3630ea21-5a31-4289-8214-ab93b9265101",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„In dieser Zeit steht Doris Wicki im Dauereinsatz, alle zwei Stunden muss sie den Kohlemeiler kontrollieren.“"
                                            },
                                            {
                                                "example_id": "09f6676b-7f70-4c1a-b4a1-b8c00f804426",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Als die Freunde durch das afrikanische Land reisten, sahen sie überall Kohlemeiler stehen und kamen mit den Menschen ins Gespräch. Sie sahen, wie sie Holz aus naturnahen Wäldern zu den Kohlemeilern schleppten, um dort Kohle für Europa herzustellen.“"
                                            },
                                            {
                                                "example_id": "3207ecda-5ab5-41ec-a605-6fbf1f8a33c5",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Die für die Eisenerzgewinnung notwendige Holzkohle wurde vor Ort mit zahlreichen Kohlemeilern erzeugt.“"
                                            },
                                            {
                                                "example_id": "2fd83f94-b8f7-4500-8824-6577c691bc2c",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„In Boppard lebt eine alte Tradition wieder auf: Im Stadtwald wird ein Kohlemeiler errichtet. Darin verschwelt Holz zu Holzkohle. Nach vier Tagen wird der Meiler gelöscht und geöffnet.“"
                                            },
                                            {
                                                "example_id": "a252d948-4c0d-4a93-92b0-25702d8bfc30",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Für eine Besiedlung sprechen zudem mehrere Kohlemeiler, deren Überreste auf das Mittelalter zurückgeführt wurden.“"
                                            },
                                            {
                                                "example_id": "8639513c-c609-40b4-ad44-c0042dd728a4",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Ein weiterer Standortvorteil im Tscherniheimer Graben war der ständig wehende Nordwest-Wind, der den starken Rauch der Glasöfen, Kohlemeiler und Aschensiedereien verzog und eine höhere Betriebstemperatur der Öfen ermöglichte.“"
                                            },
                                            {
                                                "example_id": "960b5e50-6639-4d34-b60a-889106b11344",
                                                "sense_id": "b3fcc395-82c1-35cb-8123-d9766dc48352",
                                                "text": "„Die Wälder haben sich von der Glasproduktion wieder erholt und im Drachslis, einem Hof am Seeblibach, sind seit 1977 wieder regelmässig Köhler am Werk, die grosse Mengen (ca. 100 Tonnen pro Jahr) traditionell mit Kohlemeilern Holzkohle herstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
