                        "sense_id": "fa00190d-6828-3972-9ba6-001e8434441b",
                        "entry_id": "7f6bb832-7a8d-3f03-88f9-88987eb76e63",
                        "glosses": [
                            "een klank geproduceerd met een verlaagde velum in de mond, waardoor lucht tijdens het vormen van de klank ongestoord door de neus kan ontsnappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca96eaad-ed8e-4a2f-9dec-d238554343fd",
                                "sense_id": "fa00190d-6828-3972-9ba6-001e8434441b",
                                "text": "In veel talen kan een klinker voor een neusklank genasaliseerd worden, waarna de neusklank vaak zelfs verdwijnt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a79b9459-1465-47e6-9ec7-fe30e71d017e",
                        "source_entry_id": "7f6bb832-7a8d-3f03-88f9-88987eb76e63",
                        "source_sense_id": "fa00190d-6828-3972-9ba6-001e8434441b",
                        "source_sense_description": "een medeklinker die geproduceerd wordt met een gedeeltelijke obstructie ergens in het spraakkanaal",
                        "target_lang_word": "Nasallaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nasallaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efc48859-b6ef-36e4-a05a-5504f3274998",
                                        "entry_id": "1f66d8cf-870f-3a53-a443-de151ef9fa33",
                                        "glosses": [
                                            "nasaler Konsonant oder Vokal, bei dem der Luftstrom ganz oder teilweise über den Nasenraum entweicht"
                                        ],
                                        "tags": [
                                            "speziell Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe5561db-3c8e-401e-8193-37329c2f6869",
                                                "sense_id": "efc48859-b6ef-36e4-a05a-5504f3274998",
                                                "text": "„Die beiden Nasallaute »ą« und »ę« sind dafür verantwortlich, dass man Polnisch, wenn man es auf eine Entfernung von drei bis vier Metern hört, klanglich leicht mit Französisch verwechseln kann.“"
                                            },
                                            {
                                                "example_id": "670bf65a-8ce7-4da0-b287-1436129f9ef4",
                                                "sense_id": "efc48859-b6ef-36e4-a05a-5504f3274998",
                                                "text": "„Die übrigen betroffenen Konsonanten verteilen sich auf vier weitere Frikative, drei Plosive und einen Nasallaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5382b411-d179-4540-9928-9c111ed5c839",
                        "source_entry_id": "7f6bb832-7a8d-3f03-88f9-88987eb76e63",
                        "source_sense_id": "fa00190d-6828-3972-9ba6-001e8434441b",
                        "source_sense_description": "een medeklinker die geproduceerd wordt met een gedeeltelijke obstructie ergens in het spraakkanaal",
