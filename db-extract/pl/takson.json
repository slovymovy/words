                        "entry_id": "fc5ef493-53a8-3c92-8d57-307b1dace94a",
                        "glosses": [
                            "jednostka w systematyce biologicznej grupująca organizmy o określonym zestawie cech np.: pies domowy, róża, głowonogi"
