                "senses": [
                    {
                        "sense_id": "2e2085c7-5743-31ae-b16f-4b501623313e",
                        "entry_id": "23da81c8-51c3-3125-860d-a8383bedf2cc",
                        "glosses": [
                            "eine Stadt in Niedersachsen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11586019-5e42-4012-9404-8d90a13cdd41",
                                "sense_id": "2e2085c7-5743-31ae-b16f-4b501623313e",
                                "text": "In Wolfenbüttel war Gotthold Ephraim Lessing ab 1770 Bibliothekar in der Herzog August Bibliothek."
                            },
                            {
                                "example_id": "e020643b-d8d6-4d78-920e-b8ae7bb6d210",
                                "sense_id": "2e2085c7-5743-31ae-b16f-4b501623313e",
                                "text": "„Die vermuteten Ursprünge Wolfenbüttels sind ungefähr im 10. Jahrhundert zu finden, als sich ein Siedler namens Wulferus (Wulferi) an einer Furt in den sumpfigen Okerauen niedergelassen haben soll.“"
                            },
                            {
                                "example_id": "59c04a5f-5699-4a79-a6c8-00b4273dc06a",
                                "sense_id": "2e2085c7-5743-31ae-b16f-4b501623313e",
                                "text": "„Aus Wolfenbüttel brachte ich viel Material über die Ilias und die Odyssee mit, das man bei keinem Scholiasten findet und selbst dem großen Pope unbekannt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
