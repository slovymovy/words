                                        "sense_id": "f3970760-3177-3bf4-97e7-64e34cce4f43",
                                        "entry_id": "672c354d-c285-3d96-b54c-97f122257595",
                                        "glosses": [
                                            "Paraguay betreffend, aus Paraguay kommend, zu Paraguay gehörig"
