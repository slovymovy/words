                            {
                                "example_id": "26115926-b68a-4d7e-8916-4d3763fb4867",
                                "sense_id": "c7ec6ef6-8f4c-3f77-8ce4-6aeafd898598",
                                "text": "Na następnych drzwiach zobaczył czternastkę."
                            }
