                "senses": [
                    {
                        "sense_id": "c137ebbc-83ab-3c02-a8c5-ae2281fa903e",
                        "entry_id": "ffa55bd0-92b5-3e56-a2fe-9abf27a6bf1f",
                        "glosses": [
                            "een uurwerk dat aangeeft hoe lang het nog duurt tot een bepaald moment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d12d6d-4cab-4d53-8603-2783ba461101",
                                "sense_id": "c137ebbc-83ab-3c02-a8c5-ae2281fa903e",
                                "text": "'Donderdag, 10 januari 2013, 9.01', twittert de zanger. Even later verscheen er een link naar 'Justin Timberlake Countdown'. In een filmpje geeft de zanger toe dat hij klaar is voor iets nieuws. Daarna verschijnt er een aftelklok."
                            },
                            {
                                "example_id": "c0d698d2-eb46-466f-9b60-20f70bed7a83",
                                "sense_id": "c137ebbc-83ab-3c02-a8c5-ae2281fa903e",
                                "text": "De heropening van het Rijks is pas over twee dagen, maar de aftelklok is alvast verwijderd. Het weghalen van van de klok kan op de openingsdag zelf namelijk gevaar opleveren voor de bezoekers. Dat vertelt een woordvoerder van de Rijksgebouwendienst tegen AT5."
                            },
                            {
                                "example_id": "88315d91-bff6-4f4f-bdad-3288797e7551",
                                "sense_id": "c137ebbc-83ab-3c02-a8c5-ae2281fa903e",
                                "text": "Een op de vijf reizigers ergert zich aan de slechte informatie bij vertragingen. Aftelklokken en pushberichten met gegevens over alternatieve routes moeten die irritatie weg gaan nemen."
                            }
                        ]
                    }
                ],
