                        "cross_references": [
                            {
                                "target_word": "powwow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77651156-cef8-3118-9454-ef9f5f4f0a24",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A ritual conducted by a Native American shaman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "592b84d3-5ccb-3990-bf69-eeb7acf2912d",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A Native American shaman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c596e0f2-6264-3304-9aa3-c553d1fd1280",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A Native American council or meeting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dc47093-b30d-3c85-b6e4-8f1a5a29bb3e",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A short, private conference."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af4fa47-dacd-4689-90ed-374f65497ba7",
                                                "sense_id": "4dc47093-b30d-3c85-b6e4-8f1a5a29bb3e",
                                                "text": "While the powwow was going on the big woman came back again. She was consider'ble rumpled and scratched up, but there was fire in her eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a239907-30db-360b-b16b-6c7460f45d61",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A large gathering during which Indigenous songs and dances are showcased for an audience, essentially a recital or concert. Often also doubles as a fundraiser, or can be held in conjunction with a non-indigenous fair or exhibition in order to attract a large crowd, as at the Calgary Stampede and K-Days."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75093301-b8dd-475c-a90a-407e66298885",
                                                "sense_id": "6a239907-30db-360b-b16b-6c7460f45d61",
                                                "text": "On the way out, Octavio handed me a flyer for the powwow that listed the prize money in each dance category."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3654cb97-ad4e-312d-9ff9-9086aa27b00a",
                                        "entry_id": "e7ba3635-9251-3f79-b351-386a6be6646c",
                                        "glosses": [
                                            "A tradition of folk magic practiced by the Pennsylvania Dutch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "powwow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4edf353a-bb7e-3bf5-8244-02e8249aa0a6",
                                        "entry_id": "828f2727-de8d-39d8-96e8-2334159fb6bc",
                                        "glosses": [
                                            "To hold a meeting; to gather together in council."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e6bfd2-2e72-4ce7-8ea8-7a07a9fa5a7b",
                                                "sense_id": "4edf353a-bb7e-3bf5-8244-02e8249aa0a6",
                                                "text": "[The] Indians saw everything that happened and powwowed all night, needing more than anything else the presence of Tecumseh. The most aggressive element was the Winnebagos, who insisted on attacking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fde601f-5a14-37a9-a723-703fa290d171",
                                        "entry_id": "828f2727-de8d-39d8-96e8-2334159fb6bc",
                                        "glosses": [
                                            "To conduct a ritual in which magic is used."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "298f4506-e14a-4650-a50f-eb30e5baf5b4",
                                                "sense_id": "2fde601f-5a14-37a9-a723-703fa290d171",
                                                "text": "Maybe no one— except possibly Leah— powwowed anymore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92ba7de-4fc9-36c4-80df-e474accdb75f",
                                        "entry_id": "828f2727-de8d-39d8-96e8-2334159fb6bc",
                                        "glosses": [
                                            "To hold a private conference."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "offensive",
                                            "often"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
