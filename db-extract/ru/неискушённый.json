                                        "entry_id": "81330b89-0514-3b03-a859-f3f2ae1c3a60",
                                        "glosses": [
                                            "One who is ignorant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
