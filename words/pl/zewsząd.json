{
    "word_family": [
        "wszędzie",
        "znikąd"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a24337d1-3ff9-3f8c-989a-441681e9511e",
                    "sense_definition": "Z każdego miejsca, ze wszystkich stron; określa kierunek do środka z wielu punktów wokół.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy piosenkarka wyszła na scenę, <w>zewsząd</w> rozległy się oklaski.",
                            "target_lang_translations": {
                                "ru": "Когда певица вышла на сцену, <w>отовсюду</w> раздались аплодисменты.",
                                "en": "When the singer came onto the stage, applause broke out <w>from all sides</w>."
                            }
                        },
                        {
                            "text": "Podczas spaceru po lesie śpiew ptaków dobiegał nas <w>zewsząd</w>.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки по лесу пение птиц доносилось до нас <w>отовсюду</w>.",
                                "en": "During our walk in the forest, the birdsong reached us <w>from everywhere</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ze wszech stron",
                        "ze wszystkich stron"
                    ],
                    "antonyms": [
                        "znikąd"
                    ],
                    "common_phrases": [
                        "atakować zewsząd",
                        "otoczony zewsząd",
                        "napływać zewsząd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Со всех сторон, из разных мест; обозначает направление к центру из множества точек вокруг.",
                        "en": "From every place or all sides; indicating motion or arrival toward the center from multiple points around."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отовсюду",
                                "target_lang_sense_clarification": "из каждого места"
                            },
                            {
                                "target_lang_word": "со всех сторон",
                                "target_lang_sense_clarification": "кругом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "from all sides",
                                "target_lang_sense_clarification": "from every direction"
                            },
                            {
                                "target_lang_word": "from everywhere",
                                "target_lang_sense_clarification": "from all places"
                            },
                            {
                                "target_lang_word": "from all directions",
                                "target_lang_sense_clarification": "coming inward from around"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1a03cff-69bd-3d52-aa3e-224f97185328",
                    "sense_definition": "Biorąc pod uwagę wszystkie aspekty; całkowicie, w pełni.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego postawa w tej trudnej sytuacji była <w>zewsząd</w> godna pochwały.",
                            "target_lang_translations": {
                                "ru": "Его поведение в этой трудной ситуации было <w>во всех отношениях</w> достойно похвалы.",
                                "en": "His attitude in this difficult situation was <w>in every respect</w> praiseworthy."
                            }
                        },
                        {
                            "text": "To był <w>zewsząd</w> udany projekt, który przyniósł firmie wiele korzyści.",
                            "target_lang_translations": {
                                "ru": "Это был <w>во всех отношениях</w> удачный проект, который принёс фирме много выгоды.",
                                "en": "It was an <w>altogether</w> successful project that brought many benefits to the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "pod każdym względem"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "użycie książkowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимая во внимание все аспекты; полностью, во всех отношениях.",
                        "en": "Taking all aspects into consideration; completely, thoroughly, in every respect."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "во всех отношениях",
                                "target_lang_sense_clarification": "с любой точки зрения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "in every respect",
