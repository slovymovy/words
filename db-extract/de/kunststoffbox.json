                "senses": [
                    {
                        "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                        "entry_id": "848a8667-cb25-3d89-9cb5-67c6315cdc61",
                        "glosses": [
                            "eine dicht schließende Schachtel, eine Kiste, ein Karton aus Polymer mit Deckel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec540f6d-0f95-4b23-88ba-576eb069eb9f",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„Die Kunststoffboxen können gestapelt werden, wenn man sie um 90 Grad dreht, kann man sie ineinander schachteln. Bezeichnung: „Drehstapelboxen“."
                            },
                            {
                                "example_id": "72433402-e281-4a02-aa99-07aa8ac3a8e8",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„In der Variante als Faltbox mit Deckel schützt die Kunststoffbox Ihre Waren vor Staub, Schmutz und Beschädigung.“"
                            },
                            {
                                "example_id": "9aa8e1fd-88b0-45a1-8d22-1d0004050713",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„Eine gute Kunststoffbox kann allerdings auch einiges kosten und macht im Laufe ihres Küchenlebens einiges mit.“"
                            },
                            {
                                "example_id": "ff6caefb-ff90-493e-992e-16aa4947b827",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„Die Kunststoffbox aus der Serie \"Cube\" ist raumsparend , massiv und geräumig.“"
                            },
                            {
                                "example_id": "89d3f62a-20a9-4527-8ccc-04501bcb36ae",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„Sehr praktische Kunststoffboxen, ideal für den Transport oder zum ausstellen von entsprechend kleinen Terrarientieren auf Börsen / Messen. Vorsicht, alle Dosen ohne Lüftungslöcher!!“"
                            },
                            {
                                "example_id": "0599f2fc-fcdd-4d9c-8417-fe41bcfd198c",
                                "sense_id": "c98d8e8d-9316-3343-91bf-788fbeb9113f",
                                "text": "„Die im Shop erhältlichen Kunststoffboxen sind alle mit einem Trageriemen und einer Gummidichtung ausgestattet. Diese sorgt dafür, dass die Kunststoffbox wasserdicht bleibt und zum Beispiel Kartenmaterial oder andere Dokumente trocken bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
