                                            {
                                                "example_id": "bb71b558-0c26-4eae-b991-3d689b62b4eb",
                                                "sense_id": "448aecf5-5e05-30fe-bd9b-16d9f09f69b0",
                                                "text": "[COVID-19-Pandemie:] „Es wirkt heute fast bestürzend, wie fröhlich und unbedacht da Menschen singen, sechs Kandidaten auf der Bühne, aber auch das ganze Publikum, in einem geschlossenen Raum, ohne Sicherheitsabstand, wissen die nicht, was Aerosole sind?“"
                                            },
                                            {
                                                "example_id": "e897e728-64ba-43ae-900d-b0466b9a65e5",
                                                "sense_id": "448aecf5-5e05-30fe-bd9b-16d9f09f69b0",
                                                "text": "„Unmittelbar vor der Pause beging der schon zuvor verwarnte Gelson Fernandes ein zweites unbedachtes Foulspiel – und wurde zu Recht mit Gelb-Rot des Feldes verwiesen.“"
                                            },
                                            {
                                                "example_id": "5665df31-d2b0-4247-82ef-c0a3bb77b152",
                                                "sense_id": "448aecf5-5e05-30fe-bd9b-16d9f09f69b0",
                                                "text": "„Alle Arbeit soll auf das Niveau des trägsten, langsamsten und unbedachtesten Arbeiters heruntergedrückt werden, nach dessen Leistung sich der gleiche Lohn für alle bemißt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
