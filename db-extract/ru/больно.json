        "ru-extract.jsonl": [
            {
                "entry_id": "8071ff49-c44a-33c2-a459-9c298511de73",
                "word": "больно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d02b4155-419a-3643-83a5-0b55cbf1cfac",
                        "entry_id": "8071ff49-c44a-33c2-a459-9c298511de73",
                        "glosses": [
                            "причиняя боль"
                        ],
                        "tags": [
                            "нареч."
                        ],
                        "examples": [
                            {
                                "example_id": "17f6aefe-1ab5-4bb4-8c9e-5062ed06f6e5",
                                "sense_id": "d02b4155-419a-3643-83a5-0b55cbf1cfac",
                                "text": "Я ушибла о кровать руку довольно больно; но испуг был сильнее боли, и я даже не поморщилась."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bd2ffa4-58b1-3bf8-83fc-c4beda8c8b0f",
                        "entry_id": "8071ff49-c44a-33c2-a459-9c298511de73",
                        "glosses": [
                            "безл. предик. об ощущении боли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06214ee3-6293-4e47-95ad-c1760cbd5c77",
                                "sense_id": "7bd2ffa4-58b1-3bf8-83fc-c4beda8c8b0f",
                                "text": "Если вам больно ходить, то мы снесём вас в кресле."
                            }
                        ]
                    },
                    {
                        "sense_id": "53e7acf5-5c22-3d89-bae3-2da289e3d94d",
                        "entry_id": "8071ff49-c44a-33c2-a459-9c298511de73",
                        "glosses": [
                            "перен. обидно, горько, тяжело"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74cba90-dd8f-415c-9898-7c2b70c14353",
                                "sense_id": "53e7acf5-5c22-3d89-bae3-2da289e3d94d",
                                "text": "Его больно кольнула, кольнула в самое сердце, неделикатность сына."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a614e2c-ea73-3ee7-96e3-44f23b6da2ba",
                        "entry_id": "8071ff49-c44a-33c2-a459-9c298511de73",
                        "glosses": [
                            "безл. предик., перен. обидно, тяжело на душе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2586d702-0dbc-4576-ab63-4ad1c25654f9",
                                "sense_id": "1a614e2c-ea73-3ee7-96e3-44f23b6da2ba",
                                "text": "Только то больно, что не злодеев казнили, а всё верных слуг государевых."
                            },
                            {
                                "example_id": "097297ac-16a3-4cd5-9ef1-302e4a6218f1",
                                "sense_id": "1a614e2c-ea73-3ee7-96e3-44f23b6da2ba",
                                "text": "Больно сознавать, что их с нами уже нет."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "cfc9e276-2248-4d77-8ee6-6dec6459e702",
