{
    "word_family": [
        "appear",
        "appearance",
        "apparently",
        "apparition"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "899e336a-3608-337a-896a-d17deb1e96c8",
                    "sense_definition": "Easy to see or understand; clearly revealed to the mind.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It became <w>apparent</w> that she was not going to change her mind about the trip.",
                            "target_lang_translations": {
                                "ru": "Стало <w>очевидно</w>, что она не собирается менять свое решение насчет поездки.",
                                "tr": "Gezi hakkındaki fikrini değiştirmeyeceği <w>aşikar</w> hale geldi."
                            }
                        },
                        {
                            "text": "For no <w>apparent</w> reason, the lights in the hallway suddenly went out.",
                            "target_lang_translations": {
                                "ru": "Без всякой <w>видимой</w> причины свет в коридоре внезапно погас.",
                                "tr": "Hiçbir <w>belirgin</w> neden yokken koridordaki ışıklar aniden söndü."
                            }
                        }
                    ],
                    "synonyms": [
                        "obvious",
                        "clear",
                        "evident",
                        "plain",
                        "manifest",
                        "distinct",
                        "indubitable",
                        "transparent"
                    ],
                    "antonyms": [
                        "ambiguous",
                        "obscure"
                    ],
                    "common_phrases": [
                        "become apparent",
                        "immediately apparent",
                        "for no apparent reason",
                        "painfully apparent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий для понимания или восприятия; ясно осознаваемый.",
                        "tr": "Görülmesi veya anlaşılması kolay; açıkça ortada olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очеви́дный",
                                "target_lang_sense_clarification": "не вызывающий сомнений, ясный"
                            },
                            {
                                "target_lang_word": "я́вный",
                                "target_lang_sense_clarification": "открытый, нескрываемый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşikar",
                                "target_lang_sense_clarification": "açık ve net olan"
                            },
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "kolayca fark edilen"
                            },
                            {
                                "target_lang_word": "ortada",
                                "target_lang_sense_clarification": "herkesçe anlaşılan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                    "sense_definition": "Seeming to be real or true, but possibly different from reality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his <w>apparent</w> indifference, he was actually very concerned about the outcome.",
                            "target_lang_translations": {
                                "ru": "Несмотря на его <w>кажущееся</w> безразличие, на самом деле он был очень обеспокоен исходом дела.",
                                "tr": "<w>Görünürdeki</w> ilgisizliğine rağmen, aslında sonuç konusunda çok endişeliydi."
                            }
                        },
                        {
                            "text": "The <w>apparent</w> simplicity of the task made us underestimate how long it would take.",
                            "target_lang_translations": {
                                "ru": "<w>Кажущаяся</w> простота задачи заставила нас недооценить, сколько времени она займет.",
                                "tr": "Görevin <w>görünüşteki</w> basitliği, ne kadar süreceğini küçümsememize neden oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "superficial",
                        "illusory"
                    ],
                    "common_phrases": [
                        "apparent contradiction",
                        "apparent lack of",
                        "apparent motion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся настоящим или истинным, но, возможно, отличающийся от реальности.",
                        "tr": "Gerçek veya doğru gibi görünen ancak gerçekte farklı olabilecek olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ка́жущийся",
                                "target_lang_sense_clarification": "производящий впечатление, но не обязательно верный"
                            },
                            {
                                "target_lang_word": "мни́мый",
                                "target_lang_sense_clarification": "воображаемый, ложный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "görünürdeki",
                                "target_lang_sense_clarification": "dışarıdan bakıldığında öyle duran"
                            },
                            {
                                "target_lang_word": "görünüşte",
                                "target_lang_sense_clarification": "yüzeyde öyle görünen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a078ec8-5623-395f-bf9c-ef020d3150c5",
                    "sense_definition": "Capable of being seen physically; open to view.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the fog lifted, the mountain peak became <w>apparent</w> to the climbers.",
                            "target_lang_translations": {
                                "ru": "Когда туман рассеялся, вершина горы стала <w>видна</w> альпинистам.",
                                "tr": "Sis kalktıkça, dağın zirvesi dağcılar için <w>görünür</w> hale geldi."
                            }
                        },
                        {
                            "text": "The stars are <w>apparent</w> to the naked eye on a clear night.",
                            "target_lang_translations": {
                                "ru": "Звезды <w>видны</w> невооруженным глазом в ясную ночь.",
                                "tr": "Açık bir gecede yıldızlar cıplak gözle <w>görülebilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "visible",
                        "exposed",
                        "unconcealed",
                        "bare",
                        "displayed"
                    ],
                    "antonyms": [
                        "invisible",
                        "hidden",
                        "latent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage typically prefers 'visible' for physical sight"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доступный для физического наблюдения; открытый для взгляда.",
                        "tr": "Fiziksel olarak görülebilen; gözle seçilebilen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ви́димый",
                                "target_lang_sense_clarification": "доступный для зрения"
                            },
                            {
                                "target_lang_word": "заме́тный",
                                "target_lang_sense_clarification": "тот, который можно заметить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "görülebilir",
                                "target_lang_sense_clarification": "gözle fark edilebilen"
                            },
                            {
                                "target_lang_word": "görünür",
                                "target_lang_sense_clarification": "seçilebilen, göz önünde olan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}