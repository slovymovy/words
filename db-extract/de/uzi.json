                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76292e2-3f1f-4cf1-92c9-a5ef0e515450",
                                                "sense_id": "87a6284b-9f8f-3dd8-b312-c4aa1761e58f",
                                                "text": "Terrorists seem to fire the Uzi with total disregard for ammunition consumption, rattling through dozens of rounds without the need to reload."
                                            },
                                            {
                                                "example_id": "a394a3ab-21fc-4e9e-8b66-003db4d14c2c",
                                                "sense_id": "87a6284b-9f8f-3dd8-b312-c4aa1761e58f",
                                                "text": "“Yo, you need to take that off before the cops see you and wonder wassup with it,” Chico said. Junnie removed his mask slowly, but continued looking straight ahead as if in a daze. He was still holding on tight to his Uzi."
                                            }
                                        ]
                                    }
                                ]
                            }
