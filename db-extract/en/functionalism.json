                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d5396e6b-2ed1-387e-8c96-423c8c0b7e1b",
                        "entry_id": "2adc37b8-2a64-348e-bf24-77ba4b0a5d97",
                        "glosses": [
                            "The idea that social and cultural cohesion are a function of the interdependence and interactions of the institutions of a society."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
