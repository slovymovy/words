                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wasserbau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Schleuse</w> im Deich verhindert, dass das Hochwasser in das Landesinnere strömt."
                        },
                        {
                            "text": "Wegen starker Regenfälle musste die <w>Schleuse</w> geöffnet werden, um den See zu entlasten."
