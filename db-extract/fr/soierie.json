        "fr-extract.jsonl": [
            {
                "entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                "word": "soierie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "13fd4092-7ae8-4c94-898d-4d794160ef0a",
                        "entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                        "tags": [
                            "plural"
                        ],
                        "form": "soieries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5bbfe5c-b9a6-33e9-bb89-f0551feda6e0",
                        "entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                        "glosses": [
                            "Toutes sortes de marchandises de soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b6f88ff-8dc3-4ec8-8f4e-7bf8d74727b7",
                                "sense_id": "d5bbfe5c-b9a6-33e9-bb89-f0551feda6e0",
                                "text": "La beauté de sa fille était le seul capital que conservât le père de Nazira, Hag Aly, marchand de soieries, que plusieurs faillites avaient ruiné."
                            },
                            {
                                "example_id": "54803d58-3d4c-45b2-b0dc-92a64cb6a9d1",
                                "sense_id": "d5bbfe5c-b9a6-33e9-bb89-f0551feda6e0",
                                "text": "[…] ; il acheta pour deux cent mille francs de terrains, de maisons, et lança vers New-York un navire chargé de soieries françaises achetées à bas prix à Lyon."
                            },
                            {
                                "example_id": "200c9afc-48c1-457e-b911-3ce8863dff9f",
                                "sense_id": "d5bbfe5c-b9a6-33e9-bb89-f0551feda6e0",
                                "text": "A la même occasion je fus témoin de la réception d'une délégation de la communauté israélite de Settat. Arrivée à une distance respectueuse des tentes de Si Ahmed, elle se prosterna très bas et déposa son offrande de soieries, après quoi elle fut congédiée d'un geste hautain, sans une parole."
                            }
                        ]
                    },
                    {
                        "sense_id": "544ec94c-dc6c-3e8d-a12f-bc954e24d8fe",
                        "entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                        "glosses": [
                            "Fabrique de soie, manière de préparer la soie et lieu où on la prépare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf2c189-3fbe-43a2-89bf-3a3d6f2fffd1",
                                "sense_id": "544ec94c-dc6c-3e8d-a12f-bc954e24d8fe",
                                "text": "Établir une soierie."
                            }
                        ]
                    },
                    {
                        "sense_id": "30a716eb-d26c-3ddf-9400-4336a7d8dba1",
                        "entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                        "glosses": [
                            "Fabrication et le commerce de la soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9e7207-99fa-49a4-b5d7-e5ed738d30d6",
                                "sense_id": "30a716eb-d26c-3ddf-9400-4336a7d8dba1",
                                "text": "Être dans la soierie. - Le rayon de la soierie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7477565a-a08c-4f90-b4bb-7ac330d062b0",
                        "source_entry_id": "3c669b78-7af8-3016-bb99-f5725906eab5",
                        "source_sense_id": "d5bbfe5c-b9a6-33e9-bb89-f0551feda6e0",
                        "source_sense_description": "Toutes sortes de tissus en soie",
                        "target_lang_word": "Seidenstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seidenstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b076188-8c24-3177-a640-0193f907407c",
                                        "entry_id": "d4ae4f11-5e28-3f15-a1cf-0b425efd2750",
                                        "glosses": [
                                            "Stoff aus Seide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a29796-9eab-4d56-9354-bfdb3dadc758",
                                                "sense_id": "1b076188-8c24-3177-a640-0193f907407c",
                                                "text": "„Er hatte Seidenstoffe für tausend Unzen Silber verkauft und weilte in einem Gasthause.“"
                                            },
                                            {
                                                "example_id": "1c630bc9-101d-485a-8f8d-c079c49f6b30",
                                                "sense_id": "1b076188-8c24-3177-a640-0193f907407c",
                                                "text": "„Er erklärte mir anschaulich, daß man damit ein Vermögen verdienen könne, da die Seidenstoffe makellos, die Farben erlesen und unsere Zeichner denen von ganz Asien überlegen seien.“"
                                            },
                                            {
                                                "example_id": "6e977dcb-bef8-4005-a778-4f850da00447",
                                                "sense_id": "1b076188-8c24-3177-a640-0193f907407c",
                                                "text": "„Vorsichtig lehnte ich mich an sie, so behutsam ich konnte, damit der Seidenstoff nicht zerdrückt würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
