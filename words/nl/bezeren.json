                    "frequency": "Middle",
                    "semantic_group_id": "lichamelijke_pijn_of_letsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je die tere plantjes niet <w>bezeert</w>.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>hurt</w> those delicate little plants."
                            }
                        },
                        {
                            "text": "Tijdens het sporten <w>bezeerde</w> hij zijn enkel.",
                            "target_lang_translations": {
                                "en": "He <w>injured</w> his ankle while playing sports."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijn doen"
                    ],
                    "common_phrases": [
                        "iemand bezeren",
                        "een knie bezeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause pain or physical injury to someone, something, or a body part"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "cause physical pain or minor injury to someone or something"
                            },
                            {
                                "target_lang_word": "injure",
                                "target_lang_sense_clarification": "cause a physical injury, especially a more definite or noticeable one"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c919e43f-524e-38d1-8a04-93db79b0f4c9",
                    "sense_definition": "zich pijn doen of gewond raken",
