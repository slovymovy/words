            "senses": [
                {
                    "sense_id": "cb791b36-b076-310a-ae6d-16d460199a0c",
                    "sense_definition": "einen Wert, Betrag oder eine Menge in Zahlen angeben oder schätzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wertangabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experten <w>beziffern</w> den entstandenen Sachschaden auf mehrere Millionen Euro."
                        },
                        {
                            "text": "Die Behörden <w>bezifferten</w> die Zahl der Teilnehmer auf über zehntausend Menschen."
                        }
                    ],
                    "synonyms": [
                        "quantifizieren",
                        "schätzen",
                        "taxieren",
                        "einschätzen"
                    ],
                    "antonyms": [
                        "beschreiben",
                        "qualifizieren"
                    ],
                    "common_phrases": [
                        "die Kosten beziffern",
                        "einen Schaden beziffern",
                        "auf Euro beziffern"
                    ]
                },
                {
                    "sense_id": "2febbba6-9623-37e5-901b-b9478e290a3d",
                    "sense_definition": "sich auf eine bestimmte Summe oder Menge belaufen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wertangabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die gesamten Verluste des Unternehmens <w>beziffern</w> sich auf zehn Millionen Dollar."
                        },
                        {
                            "text": "Nach offiziellen Schätzungen <w>bezifferte</w> sich die Entschädigung auf eine enorme Summe."
                        }
                    ],
                    "synonyms": [
                        "ausmachen",
                        "belaufen",
                        "betragen"
                    ],
                    "common_phrases": [
