                    {
                        "translation_id": "503b56dd-b6b5-4715-86d6-c4047a80e863",
                        "source_entry_id": "43660c8b-d695-3001-a6ff-cfa677e6eec4",
                        "source_sense_id": "a411225b-a2af-3d23-822a-aea1681c8563",
                        "target_lang_word": "Primatologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Primatologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f47b9876-67bf-3e41-b68f-d9be43101897",
                                        "entry_id": "82caa15a-6c9b-3d51-b64e-1270bd6291cd",
                                        "glosses": [
                                            "Forschung an und die Erforschung der Primaten oder Herrentiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4c829c-3756-4417-a200-d245fa2d61e6",
                                                "sense_id": "f47b9876-67bf-3e41-b68f-d9be43101897",
                                                "text": "„Mit dem Menschen selbst beschäftigt sich die Anthropologie – mit seinen engsten und etwas weiter entfernten Verwandten die Primatologie.“"
                                            },
                                            {
                                                "example_id": "216ca00b-9cf7-40f8-b840-cf687ba60e93",
                                                "sense_id": "f47b9876-67bf-3e41-b68f-d9be43101897",
                                                "text": "„Die zweite in der Phalanx der drei starken Frauen der Primatologie war Dian Fossey.“"
                                            },
                                            {
                                                "example_id": "d0e8a809-3176-4e1e-afad-b818152083e1",
                                                "sense_id": "f47b9876-67bf-3e41-b68f-d9be43101897",
                                                "text": "„Kritiker wenden ein, dass de Waals Forschung auf Zoo und Labor beschränkt ist, wo Verhalten verformt ist. De Waal kontert, dass manifeste Unterschiede zwischen Schimpansen und Bonobos gerade in Gefangenschaft offenbar werden. Denn dort leben sie unter gleichen Bedingungen, während ihr Verhalten im Freiland zahlreichen Einflüssen unterliegt. Diese Problematik ist zentral in der Primatologie, da soziale und ökologische Flexibilität ein herausragendes Merkmal von Affen und Menschenaffen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
