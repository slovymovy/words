                "translations": [
                    {
                        "translation_id": "fc978348-93a6-4615-83d2-67ffc6fa8bb1",
                        "source_entry_id": "81e04b80-aea5-3940-b6ab-92af24c3d01c",
                        "source_sense_id": "fcf63c4f-ae7f-3dcd-acc9-4deae991556a",
                        "source_sense_description": "iemand die bier maakt om te verhandelen",
                        "target_lang_word": "Brauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34626c34-1990-3054-80ba-cbdbda9ab9a4",
                                        "entry_id": "3a928ec2-8748-39be-9541-1caeb0e7f21e",
                                        "glosses": [
                                            "Person, die in einem Brauvorgang Bier herstellt"
                                        ],
                                        "tags": [
                                            "Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292c1462-e6c1-486e-81da-04d452a94e08",
                                                "sense_id": "34626c34-1990-3054-80ba-cbdbda9ab9a4",
                                                "text": "„Mit Malz bezeichnet der Brauer gekeimte, enzymatisch aufgeschlossene und dann getrocknete Gerstenkörner.“"
                                            },
                                            {
                                                "example_id": "92cae9b8-a7bb-4f97-a031-5349da664512",
                                                "sense_id": "34626c34-1990-3054-80ba-cbdbda9ab9a4",
                                                "text": "„Nach erfolgreich abgelegter Lehrabschlußprüfung im Lehrberuf Destillateur kann eine Zusatzprüfung im Lehrberuf Brauer und Mälzer abgelegt werden.“"
                                            },
                                            {
                                                "example_id": "b5e34954-03ad-4b94-bea4-0ed63b86e4d7",
                                                "sense_id": "34626c34-1990-3054-80ba-cbdbda9ab9a4",
                                                "text": "„Ich blicke aufs Papier, lese das von Gott, den Antworten und der Unsicherheit, wo man den Teufel platzieren sollte, und sehe Skúlis Vater Jón den Brauer im Ort überreden, ihm eine Flasche zu geben, seine Hand sei wieder in Ordnung, er werde bald wieder anheuern und könne die Flasche dann bezahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                        "entry_id": "4b8d634f-150f-3cff-ba21-15824addc274",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d474e3-ed6b-4490-9a54-5cc1dc8f3446",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Die Brauers kommen heute vom Lac de Joux."
                                            },
                                            {
                                                "example_id": "73bf67c2-54e7-430b-8483-a172d3009f9b",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Der Brauer trägt nie die Schals, die die Brauer ihm strickt."
                                            },
                                            {
                                                "example_id": "c95a9c62-a331-412f-9331-9eedee6df5d9",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brauer kommt, geht der Herr Brauer.“"
                                            },
                                            {
                                                "example_id": "7493f4d1-5d9f-4cff-8f1f-f5eb75b62920",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Brauer kommt und geht."
                                            },
                                            {
                                                "example_id": "94ba52c8-243a-4a7e-8c00-6556c4bd15d3",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Brauers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "99045b02-17f4-4501-ab0d-23d774135ef4",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "An verregneten Herbsttagen ist Familie Brauers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "e17c86e5-7946-42b7-b9be-b33ccd9d1991",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Brauer das Schmücken von Weihnachtsbäumen."
                                            },
                                            {
                                                "example_id": "043f68fd-7bf5-4d98-8e83-b395b0d9b601",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Frau Brauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "87c25746-dab4-4831-9ab0-51e7eef9e261",
                                                "sense_id": "9dc75a56-85a9-31e1-85a4-796ebd9cd397",
                                                "text": "Herr Brauer wollte uns kein Interview geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48ca05c9-3e37-4db3-8c83-8133b53e7d1e",
                        "source_entry_id": "81e04b80-aea5-3940-b6ab-92af24c3d01c",
                        "source_sense_id": "fcf63c4f-ae7f-3dcd-acc9-4deae991556a",
