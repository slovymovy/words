                            {
                                "example_id": "19673e02-12ee-4790-b14e-65a903af1ce7",
                                "sense_id": "2e1a12c4-a4b1-33bb-8fde-ec2fea0fec00",
                                "text": "„Allmählich schwiegen jedoch auch diese, und die Natur schien mit den armen Schwarzen ihre Feierstunde zu halten.“"
                            },
                            {
                                "example_id": "51bf2464-9576-4c48-aaf3-3e98669fe8bc",
                                "sense_id": "2e1a12c4-a4b1-33bb-8fde-ec2fea0fec00",
                                "text": "„Die Lehrerin hatte ihr gesagt, sie werde bei der Feierstunde neben dem Präsidenten sitzen, weil sie die beste Schülerin der beiden ersten Klassen sei.“"
                            }
                        ],
