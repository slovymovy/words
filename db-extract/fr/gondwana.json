                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77480c10-1db2-31e6-9f18-fe4a9895f4c7",
                                        "entry_id": "df2d3183-dde2-36e8-8ce9-c164561bab74",
                                        "glosses": [
                                            "A southern supercontinent, formed before Pangaea between 600 and 530 million years ago, that included most of the landmasses which make up today's continents of the Southern Hemisphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d04d1eb-b1fc-4ec0-99e1-214e3d9b1319",
                                                "sense_id": "77480c10-1db2-31e6-9f18-fe4a9895f4c7",
                                                "text": "At that time, the Gondwana supercontinent was located at the southern part of the Southern Hemisphere, developed amphibolite metamorphism and formed the united crystalline basement at about 510 Ma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
