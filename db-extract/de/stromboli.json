                                    {
                                        "sense_id": "fc376a04-0f5c-3177-a4f0-d1e186bb5069",
                                        "entry_id": "57062133-e5cd-3f4f-9deb-27ba00000035",
                                        "glosses": [
                                            "Volcan italien, il constitue à lui seul l’île du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5325dbc0-2977-4c46-a3df-d9912abac838",
                                                "sense_id": "fc376a04-0f5c-3177-a4f0-d1e186bb5069",
                                                "text": "Une lueur avait rougi le ciel au-dessus du Stromboli, et le navire s’était engagé dans le détroit, entre Messine aux maisons dorées comme des fruits et Reggia plus discrète et plus effacée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d874297e-c4fe-33f8-ad4a-d2102327875a",
                                        "entry_id": "57062133-e5cd-3f4f-9deb-27ba00000035",
                                        "glosses": [
                                            "Île volcanique d’Italie située dans les îles Éoliennes, au nord de la Sicile, dans la mer Tyrrhénienne."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32301095-1fb1-4b3f-8b1e-e793051d86ef",
                                                "sense_id": "d874297e-c4fe-33f8-ad4a-d2102327875a",
                                                "text": "Minicroisières aux îles Éoliennes, départ de Milazzo et débarquement à Vulcano, Lipari, Stromboli, Filicudi, Alicudi, Panarea, Salina."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
