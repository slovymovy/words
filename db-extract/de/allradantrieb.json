                    {
                        "translation_id": "723285ff-d08a-450a-87a7-553d3ad9ef31",
                        "source_entry_id": "94f289f4-7d9c-3e76-a863-2edc66e8ecd8",
                        "source_sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                        "source_sense_description": "Art eines Antriebs, bei der alle Räder aktiv den Wagen fortbewegen",
                        "target_lang_word": "4x4",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "4x4",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                        "entry_id": "6cf6eb26-140e-36d5-b4c6-72772144e1d4",
                                        "glosses": [
                                            "Véhicule tout-terrain dont les quatre roues sont motrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209f633e-1988-4a58-92f3-49b9e51d58b0",
                                                "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                                "text": "— J’y ai pensé. Bonne chance, amigo ! Et à la prochaine, ajouta-t-il tandis que les frères Knight s’engouffraient dans le 4x4 sans plus attendre."
                                            },
                                            {
                                                "example_id": "ef943c4e-4d4c-4fb3-ab5a-3b5333109bb2",
                                                "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                                "text": "Pour accéder à l’eau, ils n’hésitent pas à traverser ses champs emblavés avec leur 4x4."
                                            },
                                            {
                                                "example_id": "e64c6f8f-98f2-4e73-93ec-f404de9eff79",
                                                "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                                "text": "Selon des sources concordantes, ce soutien a valu à Kebzabo des millions de FCFA et une 4x4 Land cruiser tout terrain de première classe qui lui avait été livrée dans la nuit à domicile."
                                            },
                                            {
                                                "example_id": "95ae1137-67db-4bc6-a96e-070f250753ce",
                                                "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                                "text": "Aujourd’hui, les gynécologues portent des grosses montres et s’achètent des 4x4 pour aller skier."
                                            },
                                            {
                                                "example_id": "63bdf80a-b57a-4908-a34d-00ebe8ac55ce",
                                                "sense_id": "ffe279b8-64f7-34a9-a8f1-ef3807711096",
                                                "text": "Et brusquement, je tourne à gauche… Le 4x4 part en glissade et s’arrête au milieu d'une petite place toute choupinou…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
