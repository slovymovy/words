                    {
                        "translation_id": "d595a8e9-4ae7-4a0b-bb24-00c7b2a64dc4",
                        "source_entry_id": "9260068f-416f-3558-9a7a-589eeb73416e",
                        "target_lang_word": "эсперантист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эсперантист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4bca620e-7349-3c6b-b4ab-8e1cd9a5f2f6",
                                        "entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                                        "glosses": [
                                            "тот, кто говорит на эсперанто или иначе использует этот язык"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b4192a-df05-4aa0-b5a6-4ede726cfc77",
                                                "sense_id": "4bca620e-7349-3c6b-b4ab-8e1cd9a5f2f6",
                                                "text": "Два лета подряд мы с ними дружили, а потом они перестали ездить в Глинково — был арестован их отец, энтузиаст-эсперантист. 〈…〉 Сперва в газетах писали, что в эпоху коммунизма будут разговаривать на столь удобном международном языке, а потом всех эсперантистов за переписку с заграницей пересажали и, обвинив в шпионаже, сослали в разные трущобы. Общество эсперантистов было закрыто."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                        "entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                                        "glosses": [
                                            "специалист в области эсперанто"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb64b869-0f0a-4f3b-91b4-82983d28b872",
                                                "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                                "text": "Лекция эсперантиста из Калифорнии[.] «Лекция о Калифорнии» Д. Э. Парриша привлекла вчера в Политехнический музей довольно много публики."
                                            },
                                            {
                                                "example_id": "6cc9d127-260b-4e4a-b534-3307969708cd",
                                                "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                                "text": "Эсперантист г. Парриш, представитель Калифорнии, выехал вчера из Одессы на Балканский полуостров."
                                            },
