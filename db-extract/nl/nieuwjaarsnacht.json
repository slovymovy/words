                        "examples": [
                            {
                                "example_id": "888fe928-caeb-434e-97f5-af5366abe096",
                                "sense_id": "7245f449-dbc2-3cba-b048-b4e08dd399e9",
                                "text": "Het gerechtshof in Leeuwarden heeft maandag Rhowan P. uit Kloosterburen veroordeeld tot een celstraf van twaalf jaar en tbs met dwangverpleging. De rechter is ervan overtuigd dat hij in de nieuwjaarsnacht van 2016 Jesse van Wieren om het leven heeft gebracht."
                            },
                            {
                                "example_id": "cceed441-7d42-48ae-be1c-f4fdf8c6c073",
                                "sense_id": "7245f449-dbc2-3cba-b048-b4e08dd399e9",
                                "text": "Dat zegt de politie, die donderdag camerabeelden waarop de man te zien is toonde in het AT5-programma Bureau 020. De man had in de nieuwjaarsnacht rond 04.00 uur een steen van straat geraapt."
                            }
                        ]
