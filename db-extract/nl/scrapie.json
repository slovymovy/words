                        "glosses": [
                            "hersenziekte veroorzaakt door prionen bij schapen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1005305-f224-4964-8fbf-46fe388467bb",
                                "sense_id": "6f7a6d41-af3a-3cc4-bbab-8fa22f5a9713",
                                "text": "Hoe de dieren de ziekte hebben opgelopen is niet bekend. CWD is een besmettelijke ziekte die het zenuwstelsel en hersenen aantast, vergelijkbaar met gekkekoeienziekte BSE en scrapie bij schapen. Genezing is niet mogelijk, de dieren sterven. Op de mens is CWD volgens deskundigen nog niet overgedragen."
                            },
                            {
                                "example_id": "327fd713-7b05-4e3d-92dc-084829a4cde8",
                                "sense_id": "6f7a6d41-af3a-3cc4-bbab-8fa22f5a9713",
                                "text": "Scrapie of schuurziekte is een dodelijke ziekte die het zenuwstelsel bij schapen en geiten aantast. De ziekte is verwant met hersenziektes zoals BSE en de ziekte van Creutzfeldt-Jakob."
                            }
                        ]
                    }
