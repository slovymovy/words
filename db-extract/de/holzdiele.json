                "senses": [
                    {
                        "sense_id": "68e017e6-3874-3793-bc6b-0b83eb72db68",
                        "entry_id": "04dde61a-3aa2-3d23-ab94-356f68774f79",
                        "glosses": [
                            "langes, schmales Holzbrett, das als Fußbodenbelag oder als Verschalungselement verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f1a24c-7ca8-45f8-ab49-711b898e8168",
                                "sense_id": "68e017e6-3874-3793-bc6b-0b83eb72db68",
                                "text": "„Nike lag mit geschlossenen Augen auf dem Rücken, Kostas wischte ihr eine Träne von der Wange, stand auf und verließ vorsichtig den Raum, weil jeder Schritt auf den Holzdielen ein Geräusch verursachte, das im Lärm der Musik aber nur er selber wahrnahm.“"
                            },
                            {
                                "example_id": "f0e3e4b9-0e8d-4963-abac-6cd47fded443",
                                "sense_id": "68e017e6-3874-3793-bc6b-0b83eb72db68",
                                "text": "„Die Holzdielen sind herausgerissen, aber in der Turnhalle, die zugleich Aula war, hängen noch die Basketballkörbe an der Wand.“"
                            },
                            {
                                "example_id": "77595d15-7ba8-4ba6-be89-a85ac58ae1ca",
                                "sense_id": "68e017e6-3874-3793-bc6b-0b83eb72db68",
                                "text": "„Die Mahlzeiten waren einfach und vorzüglich, und der Speiseraum und die Weinstube mit ihren Holzdielen waren gut beheizt und freundlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
