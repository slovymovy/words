                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bb7bcae-4c54-35b4-a88a-719c001ac015",
                        "entry_id": "9b3f8a7c-0cae-3507-bd85-150d9961346a",
                        "glosses": [
                            "физиол. непроизвольно с резким звуком выдохнуть воздух носом при раздражении носоглотки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8af2a7c-2b12-4d73-aceb-522123ea430f",
                                "sense_id": "2bb7bcae-4c54-35b4-a88a-719c001ac015",
                                "text": "Тут мне что-то попало в нос, я громко чихнул и спрыгнул на землю."
                            }
                        ]
                    },
                    {
                        "sense_id": "e89cd633-a3ae-3e75-bd5b-0ab2cac52e76",
                        "entry_id": "9b3f8a7c-0cae-3507-bd85-150d9961346a",
                        "glosses": [
                            "перен. издать глухой резкий звук"
                        ],
                        "tags": [
                            "о моторе и т. п.",
                            "часто свидетельствует о неисправности"
                        ],
                        "examples": [
                            {
                                "example_id": "fc9d6a95-c19f-4157-aa07-b3600aa6fc91",
                                "sense_id": "e89cd633-a3ae-3e75-bd5b-0ab2cac52e76",
                                "text": "На крутом пригорке автомобиль чихнул и встал."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca8a041-6280-4877-9974-2da72148e0e2",
                        "source_entry_id": "9b3f8a7c-0cae-3507-bd85-150d9961346a",
                        "source_sense_description": "непроизвольно с резким звуком выдохнуть воздух носом при раздражении носоглотки",
                        "target_lang_word": "sneeze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd73396-e523-3104-a961-9aeb16270f4b",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel air as a reflex induced by an irritation in the nose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e507dd-52a7-4002-a91d-5816579dc332",
                                                "sense_id": "1bd73396-e523-3104-a961-9aeb16270f4b",
                                                "text": "To avoid passing on your illness, you should sneeze into your sleeve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0486bcfd-0b8d-3338-84c1-44d10f3d8cb1",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel air as if the nose were irritated."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel or displace (air, snot, etc) from the nose or mouth by the process above."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d6d4d2-3e17-4de0-8b0b-9a7655b9a5e2",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "Lily shook her head violently and sneezed a large blue-bottle fly from where that insect had perched itself on the tip of her nose."
                                            },
                                            {
                                                "example_id": "17199625-131f-41b9-a4bd-590c6990b7c1",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "When I crossed the road, I sneezed a big achoo! My nose started to feel itchy."
                                            },
                                            {
                                                "example_id": "136b966a-e22f-4beb-8d5d-6c03dc887b1e",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "I sneezed a big sneeze. It was so big I hit my nose on the sidewalk. Bow-ow. There was a smell in my snout that I wanted to get rid of. And it wasn't Muffet's rotten soup odor, either. That was actually kind of delicious."
                                            },
                                            {
                                                "example_id": "b60a29bc-4465-455f-b9bf-f916c83ccc6c",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "“Okay,”he said, and sneezed a large drop of pinkish goop. “But you better have a lot to eat! I'll race you upstairs!” Wilmer shook his head. Sherman's hyper energy level seemed to have increased, and that was saying a lot."
                                            },
                                            {
                                                "example_id": "a4e7d82c-ec41-4a68-8792-4b6e432e78d4",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "Toothless sneezed a large amount of dragon snot right in Hiccup's face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5904bf2c-9f4c-3974-b188-26d4c07ef267",
                                        "entry_id": "a25a3129-a0c9-3740-8884-f031e6c2dfcc",
                                        "glosses": [
                                            "An act of sneezing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e097424-02ac-4795-a427-4c237289faad",
                                                "sense_id": "5904bf2c-9f4c-3974-b188-26d4c07ef267",
                                                "text": "Jared's hay fever gives him terrible sneezes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
