                    ]
                },
                {
                    "sense_id": "6f1ccac8-5c60-3826-9537-b6bb7adf1118",
                    "sense_definition": "Stimuler un cheval au moyen de légères aides lorsqu'il se montre inattentif ou ralentit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier utilise doucement ses jambes pour <w>avertir</w> le cheval distrait avant l'obstacle."
                        },
                        {
                            "text": "Il faut parfois <w>avertir</w> la monture pour lui redonner de l'élan dans le virage."
