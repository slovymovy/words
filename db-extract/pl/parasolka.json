                "senses": [
                    {
                        "sense_id": "56ae7a4a-1f55-3ce7-b0dc-fc1aa8e1a8f5",
                        "entry_id": "51f6af0b-4ef3-3feb-88c7-996a9a184539",
                        "glosses": [
                            "mały, rozkładany parasol dla kobiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f7c347d-f19a-41fd-b691-a6600539dd6a",
                                "sense_id": "56ae7a4a-1f55-3ce7-b0dc-fc1aa8e1a8f5",
                                "text": "Nie wzięłam parasolki i zaskoczył mnie deszcz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "018d8085-d22f-4e7b-9b69-7a7d99a122cf",
                        "source_entry_id": "51f6af0b-4ef3-3feb-88c7-996a9a184539",
                        "source_sense_id": "56ae7a4a-1f55-3ce7-b0dc-fc1aa8e1a8f5",
                        "target_lang_word": "umbrella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umbrella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "A cloth-covered frame used for protection against rain or sun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4956dfef-3459-4f8b-854c-b209de6138c0",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "Quick, grab that umbrella before you get rained on!"
                                            },
                                            {
                                                "example_id": "3b29080d-9c4e-47a8-890a-643e160fb792",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            },
                                            {
                                                "example_id": "53f1ac8d-27c8-4aed-b7d7-3f735a15de97",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "When the [lost property] office first opened, the most frequently lost items were umbrellas. Every white-collar professional carried one, but despite, or because of, that they were easily forgotten about. […] In the 1930s, a quarter of a million umbrellas a year came into the office. Now it's more like 10,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8d1f8a-1d0e-39eb-b6cf-4944aa79cf52",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "Anything that provides similar protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248d0215-4a67-4c25-aa56-35930714bc72",
                                                "sense_id": "bf8d1f8a-1d0e-39eb-b6cf-4944aa79cf52",
                                                "text": "The fighters provide a defensive air umbrella over the battle group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51ac241-858c-361a-af88-897d14cdb3a9",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "Anything that provides similar overarching coverage of a range of concepts, purposes, groups, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b470fed1-2edc-4562-a4a1-9c71765dab34",
                                                "sense_id": "d51ac241-858c-361a-af88-897d14cdb3a9",
                                                "text": "The test facility was established under the umbrella of the company's quality program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b89d348-f691-3c7d-bd7e-bac4bdfdfd41",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "A strategy in which five players in the offensive zone form an umbrella-shaped formation around the opposition's goal net."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a09ed56-baf9-37a4-b116-4d11034ea402",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "The main body of a jellyfish, excluding the tentacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfce3152-e733-4d34-8921-40a066190565",
                                                "sense_id": "7a09ed56-baf9-37a4-b116-4d11034ea402",
                                                "text": "Jellyfish are composed of more than 90% water and most of their umbrella mass is made up of gelatinous material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fff016f-c91f-329a-ba92-b7e8d34a5f8d",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "An umbrella-shaped reflector with a white or silvery inner surface, used to diffuse a nearby light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d3b3fc-bac2-4975-9fb8-6f354e43e430",
                                                "sense_id": "7fff016f-c91f-329a-ba92-b7e8d34a5f8d",
                                                "text": "Using umbrellas for shooting a wedding party is ok, but not necessary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "umbrella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To cover or protect, as if by an umbrella."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3be040c-2aba-4697-8f5a-451a31eff421",
                                                "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                                "text": "Experts with saws and ladders came and lopped off the lower branches. This sent the tree's growth rushing violently to her head in a lush overhanging which umbrellaed the House of All Sorts."
                                            },
                                            {
                                                "example_id": "f5cadffb-c169-4089-8d7c-9ed076fb43a7",
                                                "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                                "text": "Huge pine and eucalyptus umbrellaed the grounds, airconditioning the morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf2f4091-c2a7-3d84-820f-cc894b06a6c0",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To form the dome shape of an open umbrella."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d6612f6-32b9-4ed6-af7e-cbd47bd8da45",
                                                "sense_id": "cf2f4091-c2a7-3d84-820f-cc894b06a6c0",
                                                "text": "Bright yellow gowns fit them tightly and umbrellaed from their waist to just below the knees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013e0061-8a86-3557-9fdc-65b9507b8c19",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To move like a jellyfish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f77de98-dac5-4341-94f5-47cc7aae5927",
                                                "sense_id": "013e0061-8a86-3557-9fdc-65b9507b8c19",
                                                "text": "The light catches the filigreed tendrils and graceful motion of the jellies, their orange bodies umbrella-ing along like fairy parasols come to life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
