                ],
                "senses": [
                    {
                        "sense_id": "2f1f0fdd-3eb0-30a7-8e36-6942ac272218",
                        "entry_id": "5e02e73c-6721-3882-91a4-8a8ae539d478",
                        "glosses": [
                            "Se lamenter, se plaindre par des jérémiades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105a625a-0e20-49cd-82db-fa2265271b7f",
                                "sense_id": "2f1f0fdd-3eb0-30a7-8e36-6942ac272218",
                                "text": "Julia, vrai fagot d’épines, était insaisissable ; au seul mot de mariage, elle se dressait sur ses ergots, crispait les doigts, roulait des yeux furibonds, jérémiait, tempêtait."
                            },
                            {
                                "example_id": "8ee3f918-14c7-4ab6-9726-8b21b6ff8316",
                                "sense_id": "2f1f0fdd-3eb0-30a7-8e36-6942ac272218",
                                "text": "Elle jérémiait sur les difficultés de vivre, et par dessus tout, pleurait sur le marasme des affaires, supputant le manque à gagner que lui occasionnait la grève."
                            },
                            {
                                "example_id": "cf5e48ce-48fe-44d9-abec-894ff9a6cc73",
                                "sense_id": "2f1f0fdd-3eb0-30a7-8e36-6942ac272218",
                                "text": "Elle se voyait déjà à la veillée funèbre, jérémiant dans le concert des matrones."
                            },
                            {
                                "example_id": "b5a83efc-43c3-4305-b4c1-4a7affe2eb9c",
                                "sense_id": "2f1f0fdd-3eb0-30a7-8e36-6942ac272218",
                                "text": "Et vous avez bonne mine si vous jérémiez sur la mort du roman."
                            }
                        ]
                    }
                ],
