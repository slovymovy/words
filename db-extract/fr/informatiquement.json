                    {
                        "translation_id": "c10232b1-cf45-4fe4-8e5a-83e9edc966d5",
                        "source_entry_id": "1d3e3156-28cb-37fb-928f-dd6156995dc1",
                        "source_sense_id": "8fb5c739-57be-39df-87e3-5d6d8ce900a4",
                        "source_sense_description": "EDV: informatisch, per Computer, mithilfe eines Computers/von Computern",
                        "target_lang_word": "per",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "per",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83375736-c16f-3397-a590-a956cd5aa322",
                                        "entry_id": "e90a7650-dd86-37e9-8b60-9040373e0f8f",
                                        "glosses": [
                                            "mittels"
                                        ],
                                        "tags": [
                                            "das Mittel einer Tätigkeit beschreibend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7273904-1de6-4536-857c-0599ad3a1d7e",
                                                "sense_id": "83375736-c16f-3397-a590-a956cd5aa322",
                                                "text": "Peter versandte den Brief per Post."
                                            },
                                            {
                                                "example_id": "8b714cb1-74ba-4461-ba5f-97083a84c484",
                                                "sense_id": "83375736-c16f-3397-a590-a956cd5aa322",
                                                "text": "„Auch der Q8 ist ein Crossover, er wird vornehmlich elektrisch und per Plug-in-Hybrid angetrieben, Debüt wahrscheinlich nicht vor 2018.“"
                                            },
                                            {
                                                "example_id": "9253a684-b6ef-4b9c-937f-9fa4cdad9318",
                                                "sense_id": "83375736-c16f-3397-a590-a956cd5aa322",
                                                "text": "„Per Google-Buchsuche lassen sich mittlerweile viele alte Bücher für das Wiktionary nutzbar machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebc78f89-b904-3673-9f63-67eb7777b7ee",
                                        "entry_id": "e90a7650-dd86-37e9-8b60-9040373e0f8f",
                                        "glosses": [
                                            "bezogen auf"
                                        ],
                                        "tags": [
                                            "in Verhältnisangaben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acbc6bfd-6515-40ef-99ec-9dc7c3479c17",
                                                "sense_id": "ebc78f89-b904-3673-9f63-67eb7777b7ee",
                                                "text": "Heute hat es fast zwanzig Liter per Quadratmeter geregnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ed1700a-5ea2-4c74-b55b-3d93341ab2aa",
                        "source_entry_id": "1d3e3156-28cb-37fb-928f-dd6156995dc1",
                        "source_sense_id": "8fb5c739-57be-39df-87e3-5d6d8ce900a4",
                        "source_sense_description": "EDV: informatisch, per Computer, mithilfe eines Computers/von Computern",
                        "target_lang_word": "Computer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Computer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                        "entry_id": "f6396955-02c9-3592-85ce-467f9ec39b6e",
                                        "glosses": [
                                            "elektronisches, programmierbares Gerät zur Eingabe, Verarbeitung und Ausgabe von Daten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed509b19-9a9e-49f9-ac6b-a16532c56ac7",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "Computer gibt es in allen Größen: Vom Supercomputer, größer als ein Haus, der das Klima vorhersagt, bis zum Fahrradcomputer, der in die Hosentasche passt."
                                            },
                                            {
                                                "example_id": "45a98429-a45c-434e-888e-8f8dfc286591",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "Mit dem Computer lassen sich Berechnungen in Sekunden durchführen, für die Adam Riese Jahrzehnte gebraucht hätte."
                                            },
                                            {
                                                "example_id": "0f5116bc-afca-4866-997d-6f14f2af6acb",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "Dieser Computer ist nicht leistungsfähig genug für neue Computerspiele."
                                            },
                                            {
                                                "example_id": "70cc9cc0-53bc-4228-a55f-4e998b1c2843",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "Eine häufige Anwendung des Computers ist das Surfen im Internet."
                                            },
                                            {
                                                "example_id": "5cc4f22c-bb5d-40d2-a159-ff9e180c97c0",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "Wer am Computer sitzt vergisst schnell die Zeit."
                                            },
                                            {
                                                "example_id": "6338d44c-39d8-443e-8d2c-d2ec51e8dfb8",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "„Es tat gut, den kleinen Computer in der Hand zu halten.“"
                                            },
                                            {
                                                "example_id": "b420200d-36e3-4f8e-a20d-3fbfd29d9f91",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "„Ich frage Leute auf der Straße, in der U-Bahn, im Büro, alle woll'n Computer haben, keiner weiß genau wieso.“"
                                            },
                                            {
                                                "example_id": "28b24a2e-926b-44a5-8df1-78ca60c3b893",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "„Das liegt nicht etwa daran, dass die Wissenschaftler nicht schlau genug sind, die Modelle zu ungenau oder die Computer zu langsam, sondern an der Chaostheorie.“"
                                            },
                                            {
                                                "example_id": "7a3fd9a0-43f3-4dc9-8b38-8f60c195f7a0",
                                                "sense_id": "060aeb66-edb5-3d23-bf0e-208172ee4458",
                                                "text": "„Wenn ich es richtig sehe, ist die interaktive Kommunikation mittels Computer im Begriff, sich zu der neuen Form der Tradierung von Erzählinhalten zu entwickeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
