                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33331217-ee7d-474a-9d38-c5f1d34290b6",
                                                "sense_id": "13a4798d-5a02-3a29-a987-8ce9d2f60b2e",
                                                "text": "He wanted to throw away the cup, but he couldn't find a trash can."
                                            },
                                            {
                                                "example_id": "427bc299-145f-4fcc-8762-213d41592d64",
                                                "sense_id": "13a4798d-5a02-3a29-a987-8ce9d2f60b2e",
                                                "text": "Don't throw the newspaper away, it goes in the recycle bin!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae05069-9bb5-38c4-bcb9-2a6d785188de",
                                        "entry_id": "a361ce17-9f7c-336e-8b1c-4868446e4080",
                                        "glosses": [
                                            "To waste, to squander."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28bd0741-eb7e-4285-84ab-de037ded81e1",
                                                "sense_id": "8ae05069-9bb5-38c4-bcb9-2a6d785188de",
                                                "text": "Voting for a third-party candidate sometimes feels like throwing your vote away."
                                            },
                                            {
                                                "example_id": "e0cd7bfa-1c90-4185-9c5c-c3977dc3c5c5",
                                                "sense_id": "8ae05069-9bb5-38c4-bcb9-2a6d785188de",
                                                "text": "The team threw away its chance at the semifinals."
                                            },
                                            {
                                                "example_id": "ca6da134-3eec-4f1e-976d-f1093ac3f166",
                                                "sense_id": "8ae05069-9bb5-38c4-bcb9-2a6d785188de",
                                                "text": "Mama, life has just begun. / But now I've gone and thrown it all away."
                                            },
                                            {
                                                "example_id": "38282ff5-c7cb-42a9-abbb-f8612225a1c1",
                                                "sense_id": "8ae05069-9bb5-38c4-bcb9-2a6d785188de",
                                                "text": "Chelsea threw away two points when substitute Salomon Kalou gifted Valencia a penalty five minutes from time with a needless handball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "451eff61-79ea-3953-95d6-8ad977a4e884",
                                        "entry_id": "a361ce17-9f7c-336e-8b1c-4868446e4080",
                                        "glosses": [
                                            "To intentionally throw an incomplete pass."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef1da0e7-da06-3de9-adcc-ba3775dc1086",
                                        "entry_id": "a361ce17-9f7c-336e-8b1c-4868446e4080",
                                        "glosses": [
                                            "To give lightly, in an offhand manner."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87f5155c-85d0-47ed-99b1-398e86b9cf80",
                                                "sense_id": "ef1da0e7-da06-3de9-adcc-ba3775dc1086",
                                                "text": "As Gilly plays sitcom wife, reading aloud from a book while Sam tries to read his own across the table, she throws away a line about someone named Maynard once having annulled the marriage of someone named Prince Raggar and remarrying him in the same ceremony in Dorne."
                                            }
                                        ]
                                    }
                                ]
                            }
