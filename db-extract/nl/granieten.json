                        "examples": [
                            {
                                "example_id": "4df374cd-2a95-43d5-a9b5-2a87814393f6",
                                "sense_id": "b21dc5ca-863e-3bad-bfbe-c4f0e596e41f",
                                "text": "Sanguis Iovis, sangue di Iove, sangiovese, zo zal het woord vergleden zijn van het Latijn naar het Italiaans. Bloed van Jupiter betekent het, en het is de naam van de blauwe druif van Toscane. Ik verwacht dan knoertige, granieten wijn, arrogant en hormonaal."
