                    "sense_id": "25260549-a989-3abf-9e39-42e2aeb30dd0",
                    "sense_definition": "Приносящий несчастье, беду; губительный.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Злая</w> судьба разлучила друзей на долгие годы.",
                            "target_lang_translations": {
