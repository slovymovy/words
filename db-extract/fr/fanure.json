                        "glosses": [
                            "État de ce qui est fané."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b360f160-5573-4c9f-8d71-fa415582fc0f",
                                "sense_id": "7855add7-de7f-3e67-9b25-e286f97277b5",
                                "text": "C'était un petit journaliste, blondin et poupin, assez joli garçon, mais dont la figure présentait cette fanure particulière aux garçons de restaurants de nuit […]"
                            },
                            {
                                "example_id": "07e68b65-0f38-4850-aab3-196476b6bf5f",
                                "sense_id": "7855add7-de7f-3e67-9b25-e286f97277b5",
                                "text": "Il y eut un silence, tout verjeté du parfum emmêlé et multiple des gerbes dont, aux quatre coins du salon se prolongeait la discrète et silencieuse fanure."
                            },
                            {
                                "example_id": "cf140927-54fa-456a-a6f8-a946bad063d1",
                                "sense_id": "7855add7-de7f-3e67-9b25-e286f97277b5",
                                "text": "Elle n'étais plus que la fanure de sa beauté d'antan, mais n'avait rien perdu de son mordant."
                            }
                        ]
                    }
                ],
