                        "form": "die Küchentüren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                        "entry_id": "a28343da-98d8-3610-aa28-4b59b37fc891",
                        "glosses": [
                            "Ein- und Ausgangstür der Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d9c8a36-6152-4c89-9e50-4efd0e280bb8",
                                "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                                "text": "„Die Küchentür stand offen, und die Zettel waren weg.“"
                            },
                            {
                                "example_id": "406e0cdb-331a-4e42-97cb-0a70239da456",
                                "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                                "text": "„Als ich wieder hinunterkam, stand Mrs. McNally vor der Küchentür und blickte verdrossen auf den Parnassus.“"
                            },
                            {
                                "example_id": "b72cbad4-1d3f-4e7e-964f-cc05eedd9953",
                                "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                                "text": "„Die Küchentür war mit einem dicken Wandteppich verhangen.“"
                            },
                            {
                                "example_id": "54f31526-3713-49b4-a9e8-371072073a4c",
                                "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                                "text": "„Die Küchentür, die in den Garten führte, war überdies unverschlossen.“"
                            },
                            {
                                "example_id": "ae2c5129-192c-4f90-99c7-0ea29dbc351d",
                                "sense_id": "8559197f-7e20-39c5-8306-315f9fc1d1a9",
                                "text": "„An der Küchentür angelangt, blieb er abermals stehen und lauschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
