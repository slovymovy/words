                        "target_lang_word": "Handlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b09f58c2-4146-33a1-9668-9e58eb347767",
                                        "entry_id": "8f3a6622-6805-3093-8f2a-412a1891d95c",
                                        "glosses": [
                                            "menschliches Tun, Handeln, (bewusst ausgeführte) Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be920180-3a05-4e67-87da-a1c03eb6b5e8",
                                                "sense_id": "b09f58c2-4146-33a1-9668-9e58eb347767",
                                                "text": "Sie hat sich zu einer unüberlegten Handlung hinreißen lassen."
                                            },
                                            {
                                                "example_id": "546ab59e-dc27-42aa-8e76-892cdbe1f3ee",
                                                "sense_id": "b09f58c2-4146-33a1-9668-9e58eb347767",
                                                "text": "Jetzt ist schnelle Handlung gefragt."
                                            },
                                            {
                                                "example_id": "4706e518-69ac-49fa-9d32-8cafb678f4d4",
                                                "sense_id": "b09f58c2-4146-33a1-9668-9e58eb347767",
                                                "text": "Mit seiner vorschnellen Handlung hat er alle anderen gefährdet."
                                            },
                                            {
                                                "example_id": "a2564496-e83f-46a7-a0eb-dbfe0c5a666b",
                                                "sense_id": "b09f58c2-4146-33a1-9668-9e58eb347767",
                                                "text": "Diese eigenmächtige Handlung wird sie dir nie verzeihen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56b3bf2b-a0d2-3991-b75e-0cd5bf20dc7f",
                                        "entry_id": "8f3a6622-6805-3093-8f2a-412a1891d95c",
                                        "glosses": [
                                            "Geschehen in einer Geschichte, deren Inhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74819d16-6f9b-49e1-8e83-c36fc15776fa",
                                                "sense_id": "56b3bf2b-a0d2-3991-b75e-0cd5bf20dc7f",
                                                "text": "Die Handlung des Films ist ziemlich simpel."
                                            },
                                            {
                                                "example_id": "3d458572-9b2a-43e3-a52f-7fe0c2067758",
                                                "sense_id": "56b3bf2b-a0d2-3991-b75e-0cd5bf20dc7f",
                                                "text": "Die Handlung spielt im Italien des 18. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "3757bb5f-56d5-455f-b74a-ad6fa187125d",
                                                "sense_id": "56b3bf2b-a0d2-3991-b75e-0cd5bf20dc7f",
                                                "text": "„Er verschlankt die Handlung auf das für seine Zwecke nötige Minimum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cef37f4b-90d2-3f5a-a551-3515e7029c7f",
                                        "entry_id": "8f3a6622-6805-3093-8f2a-412a1891d95c",
                                        "glosses": [
                                            "Geschäft/Laden"
                                        ],
                                        "tags": [
                                            "oft als zweiter Bestandteil eines Determinativkompositums"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269a2350-57b8-4ff6-a5f6-74cb6a679838",
                                                "sense_id": "cef37f4b-90d2-3f5a-a551-3515e7029c7f",
                                                "text": "Dieser Wellensittich ist aus der zoologischen Handlung am Marktplatz."
                                            },
                                            {
                                                "example_id": "1691c03e-f28f-4090-9fc6-48af82dc4194",
                                                "sense_id": "cef37f4b-90d2-3f5a-a551-3515e7029c7f",
                                                "text": "Es hat eine neue Buchhandlung am Stadtrand eröffnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "26614ccd-654a-336a-81d0-d6c7ebf9fa6a",
                                        "entry_id": "8f3a6622-6805-3093-8f2a-412a1891d95c",
                                        "glosses": [
                                            "jedes von einem Willen gesteuerte menschliche Verhalten"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e3fa9a-f8ff-4004-a23d-f3dc15f9931c",
                                                "sense_id": "26614ccd-654a-336a-81d0-d6c7ebf9fa6a",
                                                "text": "Hier liegt eine strafbare Handlung vor."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
