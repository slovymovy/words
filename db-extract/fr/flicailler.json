                ],
                "senses": [
                    {
                        "sense_id": "822b828d-e64d-3901-9504-f92f3b57ef97",
                        "entry_id": "850bb775-bfd0-39bf-a10b-d99f361f4fdb",
                        "glosses": [
                            "Avoir une attitude de flic."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd4d90f-8894-47b1-9365-e1ef55f31fa8",
                                "sense_id": "822b828d-e64d-3901-9504-f92f3b57ef97",
                                "text": "Si les Russes, par exemple, n'avaient pas l'habitude de se flicailler entre eux, ils seraient aussi moins soupçonneux envers le touriste."
                            },
                            {
                                "example_id": "bd699df0-4e83-4c28-a570-46ac33ae8d3d",
                                "sense_id": "822b828d-e64d-3901-9504-f92f3b57ef97",
                                "text": "Les flics flicaillent et la racaille racaille."
                            },
                            {
                                "example_id": "e778c37b-0b04-45fe-b90a-9e436ee26d62",
                                "sense_id": "822b828d-e64d-3901-9504-f92f3b57ef97",
                                "text": "Les précaires vont se faire flicailler partout et par n'importe qui, super l'ambiance au début du 2e millénaire!"
                            },
                            {
                                "example_id": "08eb7326-86af-4fe4-b417-c159cb66f70b",
                                "sense_id": "822b828d-e64d-3901-9504-f92f3b57ef97",
                                "text": "Il a besoin de flicailler pour exister."
                            }
                        ]
                    }
