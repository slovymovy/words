                "senses": [
                    {
                        "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                        "entry_id": "293d9475-e8c8-3cee-a4d8-30c16e3c9f15",
                        "glosses": [
                            "Relatif à la vue ou à la vision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b04e70-5838-452b-a738-1e8fcd069a3b",
                                "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                                "text": "Il a été prouvé que la privation de sommeil entraîne une baisse de la résistance aux distractibilités visuelle et auditive (Harrison et Horne, 2000b)."
                            },
                            {
                                "example_id": "3cc8d835-e61e-4ae0-9229-1d332ab10f1c",
                                "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                                "text": "L’impact visuel est nettement plus fort que prévu, regrette la maire [DVD], Michèle Quellard."
                            }
                        ]
                    },
                    {
                        "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                        "entry_id": "293d9475-e8c8-3cee-a4d8-30c16e3c9f15",
                        "glosses": [
                            "De vue, de vision."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "f85171f8-49ba-4e86-b19f-7c599a1911aa",
                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                "text": "Axe visuel, Ligne droite qui, passant par le centre de la cornée transparente, va aboutir au fond de l’œil."
                            },
                            {
                                "example_id": "fdfbd177-6ac1-46e9-8ad9-c5a03dbe86ea",
                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                "text": "Angle visuel : Angle que forment entre eux les rayons extrêmes envoyés vers l’œil par un corps."
                            },
                            {
                                "example_id": "e28aae43-2263-4b54-ae9e-2ae81bc72163",
                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                "text": "Horizon visuel : Étendue embrassée par le regard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ea0ccae-70fb-450b-8167-94ea1b8cf29c",
                        "source_entry_id": "293d9475-e8c8-3cee-a4d8-30c16e3c9f15",
                        "source_sense_description": "De vue",
                        "target_lang_word": "visuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                        "entry_id": "d6c89767-8107-3b22-9a0e-770349014750",
                                        "glosses": [
                                            "alle Vorgänge die optische Wahrnehmung betreffend, Synonym zu optisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f20943f-bc65-47a6-b39c-7d1e78cb0312",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Visuelle Reize werden im Gehirn über mehrere Stufen hinweg aufbereitet."
                                            },
                                            {
                                                "example_id": "00e2b7d7-4637-4450-9f01-5696e05ecebd",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Rein visuell war es ein Erlebnis, aber mit der Musik kann ich persönlich nicht so viel anfangen."
                                            },
                                            {
                                                "example_id": "b8348eb1-cb34-4a60-b7a8-713f1b03250a",
                                                "sense_id": "567cde46-c012-35fc-9fe8-d2d459944a04",
                                                "text": "Wie funktioniert eigentlich die visuelle Wahrnehmung? Wieso können wir sehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                        "entry_id": "d6c89767-8107-3b22-9a0e-770349014750",
                                        "glosses": [
                                            "das Sehen oder den Gesichtssinn betreffend, über das Sehen aufgenommen, vermittelt, empfunden, gelernt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a9ad91-e980-472b-a867-e97c81d090e7",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Er ist ein visueller Lerntyp."
                                            },
                                            {
                                                "example_id": "43670527-f28a-4c06-bfef-582f09066a6a",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Es gibt eine gute visuelle Lernmethode zu dem Thema."
                                            },
                                            {
                                                "example_id": "aefea0f7-410d-4980-b706-5380b4ca1100",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Die visuellen Informationen, die auf einen einströmen, sind atemberaubend."
                                            },
                                            {
                                                "example_id": "dec8f831-fbbf-44f9-adce-3682f301129f",
                                                "sense_id": "eee233f8-ec8a-3f3c-9e2e-9e451caafb91",
                                                "text": "Ein Teilgebiet der Kommunikationswissenschaften ist die visuelle Kommunikation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
