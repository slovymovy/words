                                        "sense_id": "d81c9a48-3e68-3549-be0f-e32d2bb63b50",
                                        "entry_id": "20315443-430d-3dc0-a244-5fb12efe9414",
                                        "glosses": [
                                            "gleichbleibende Struktur, die einer sich wiederholenden Sache zu Grunde liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5f26c8-3405-4f6d-b3ce-b5355a0cabff",
                                                "sense_id": "d81c9a48-3e68-3549-be0f-e32d2bb63b50",
                                                "text": "Die Vorhänge haben ein sehr schönes Muster."
                                            },
                                            {
                                                "example_id": "53babdfc-3913-4448-be11-e6818cdcba8e",
                                                "sense_id": "d81c9a48-3e68-3549-be0f-e32d2bb63b50",
                                                "text": "„Die Sonne war untergegangen, und die kahlen Äste der Bäume malten düstere, komplizierte Muster an den violetten Himmel, wie in einer Szene von Poe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34d6dd4c-17a3-33f7-9999-c7873a7511fe",
                                        "entry_id": "20315443-430d-3dc0-a244-5fb12efe9414",
                                        "glosses": [
                                            "ein Handlungsablauf oder eine Denk-, Gestaltungs- oder Verhaltensweise, die zur gleichförmigen Wiederholung (Reproduktion) bestimmt ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "538c872b-ffd4-4d55-8259-93758cccdde9",
                                                "sense_id": "34d6dd4c-17a3-33f7-9999-c7873a7511fe",
                                                "text": "Die Auseinandersetzungen laufen immer nach dem gleichen Muster ab."
                                            },
                                            {
                                                "example_id": "ade652ad-66d1-40d4-b1ec-e8055503c31e",
                                                "sense_id": "34d6dd4c-17a3-33f7-9999-c7873a7511fe",
                                                "text": "„Die folgende Chronik schildert einen Modellfall, der immer wieder nach ganz ähnlichen Mustern abläuft.“"
                                            },
                                            {
                                                "example_id": "3aca31ce-b6d7-40bd-898d-23f70479c246",
                                                "sense_id": "34d6dd4c-17a3-33f7-9999-c7873a7511fe",
                                                "text": "„Dieser Brief wurde als Muster vaterländischer und geistlicher Wortkunst gerühmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e313b21c-b8ef-3d57-91d9-277870c72d54",
                                        "entry_id": "20315443-430d-3dc0-a244-5fb12efe9414",
                                        "glosses": [
                                            "Warenprobe; Stück oder Darstellung, die dem angebotenen Produkt gleich ist; die dem Kunden einen realistischen Eindruck vom Produkt vermitteln soll"
                                        ],
