{
    "word_family": [
        "abandon",
        "abandonnement",
        "abandonnique"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa69c72c-eac3-3e3b-bbfe-2507a7cdf278",
                    "sense_definition": "Quitter définitivement une personne, un animal ou un lieu sans intention d'y revenir ou de s'en occuper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quitter_delaisser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est interdit par la loi d'<w>abandonner</w> un animal domestique dans la forêt."
                        },
                        {
                            "text": "Le marin a refusé d'<w>abandonner</w> le navire en danger malgré la tempête."
                        }
                    ],
                    "synonyms": [
                        "laisser"
                    ],
                    "antonyms": [
                        "garder",
                        "recueillir"
                    ],
                    "common_phrases": [
                        "abandonner un animal",
                        "abandonner sa famille",
                        "abandonner le navire"
                    ]
                },
                {
                    "sense_id": "bdf9c43d-fae4-3465-a692-1a110248378c",
                    "sense_definition": "Renoncer à poursuivre une action, une compétition ou un projet avant son terme.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "renoncer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué après dix kilomètres de course, le coureur a décidé d'<w>abandonner</w> l'épreuve."
                        },
                        {
                            "text": "Ne baisse pas les bras maintenant, il ne faut jamais <w>abandonner</w> ton rêve."
                        }
                    ],
                    "synonyms": [
                        "laisser tomber",
                        "renoncer",
                        "déclarer forfait"
                    ],
                    "antonyms": [
                        "continuer",
                        "persévérer",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "abandonner la partie",
                        "abandonner la course",
                        "abandonner un projet"
                    ]
                },
                {
                    "sense_id": "e35f859a-80a8-3cc1-bb1c-c48e9f63642d",
                    "sense_definition": "Venir à manquer ou faire défaut, en parlant des forces physiques, du courage ou des facultés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "defaillir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue marche en montagne, mes jambes et mes forces m'<w>abandonnent</w> complètement."
                        },
                        {
                            "text": "Au moment de prendre la parole en public, tout son courage l'<w>abandonna</w> subitement."
                        }
                    ],
                    "common_phrases": [
                        "les forces m'abandonnent",
                        "le courage l'abandonne"
                    ]
                },
                {
                    "sense_id": "61ee3afa-6e5e-3db7-bcce-7ed85f89cb00",
                    "sense_definition": "Céder la propriété d'un bien, renoncer à un droit ou livrer quelqu'un au pouvoir d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceder_livrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a dû <w>abandonner</w> tous ses biens pour payer ses lourdes dettes."
                        },
                        {
                            "text": "Dans le traité de paix, la nation a accepté d'<w>abandonner</w> cette province disputée."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "conserver",
                        "revendiquer"
                    ],
                    "common_phrases": [
                        "abandonner ses droits",
                        "abandonner ses biens"
                    ]
                },
                {
                    "sense_id": "5568c566-340a-3eed-b1b7-fc7a8032fb3a",
                    "sense_definition": "Se laisser aller entièrement à une émotion, à une sensation ou au repos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "se_laisser_aller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Épuisé par cette dure journée, il s'<w>abandonna</w> enfin à un sommeil très profond."
                        },
                        {
                            "text": "Elle ferma les yeux pour s'<w>abandonner</w> à la beauté de cette douce mélodie."
                        }
                    ],
                    "synonyms": [
                        "lâcher prise"
                    ],
                    "antonyms": [
                        "résister",
                        "se retenir"
                    ],
                    "common_phrases": [
                        "s'abandonner au sommeil",
                        "s'abandonner au désespoir"
                    ]
                }
            ]
        }
    ]
}