                    {
                        "sense_id": "1df766f8-9e6c-3ff2-95b2-181a9e8313ad",
                        "entry_id": "12ebc1a8-d4d8-36c9-8d7f-a7c4a5bacbc5",
                        "glosses": [
                            "das Auftreten von Eiter im Urin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e06fb8c-24a6-4adb-97d4-c867d8e21239",
                                "sense_id": "1df766f8-9e6c-3ff2-95b2-181a9e8313ad",
                                "text": "„Findet man bei der Untersuchung einer Urinprobe Leukozyten, aber der Nachweis von Bakterien misslingt, liegt eine sterile Pyurie vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bec0105-7c44-4af8-aa3f-e9e2fc0f699e",
                        "source_entry_id": "12ebc1a8-d4d8-36c9-8d7f-a7c4a5bacbc5",
                        "source_sense_id": "1df766f8-9e6c-3ff2-95b2-181a9e8313ad",
                        "source_sense_description": "Medizin: das Auftreten von Eiter im Urin",
                        "target_lang_word": "pyuria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyuria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06e4afa5-3b7e-3cc2-b52b-518581b1ac52",
                                        "entry_id": "063589e8-6f8b-33fd-801b-1cfc1a0bdb16",
                                        "glosses": [
                                            "The presence of pus in the urine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1dc77ed-4c80-426b-b8ef-8418d89f6743",
                                                "sense_id": "06e4afa5-3b7e-3cc2-b52b-518581b1ac52",
                                                "text": "Pyuria may result from suppuration in any part of the urinary system, or from an abscess opening into the urinary tract."
                                            },
                                            {
                                                "example_id": "0957f6d6-9c35-4e85-8af9-1d81630e572a",
                                                "sense_id": "06e4afa5-3b7e-3cc2-b52b-518581b1ac52",
                                                "text": "The Sternheimer-Malbin stain is useful in diagnosis of pyelonephritis, and of even more help in differential diagnosis of the pyurias."
                                            },
                                            {
                                                "example_id": "5b5bf615-1542-4b72-b84b-c49c4c816394",
                                                "sense_id": "06e4afa5-3b7e-3cc2-b52b-518581b1ac52",
                                                "text": "2003, Rabih O. Darouiche, Chapter 15: Infection and Spinal Cord Injury, in Vernon W. Lin, Diana D. Cardenas, Frederick Frost, Nancy C. Cutter, Robert Waters, Spinal Cord Medicine: Principles and Practice, page 202,\nThe nonspecificity of the finding of pyuria, like bacteriuria, can also hamper the diagnosis of UTI. Pyuria reflects an inflammation of the uromucosal lining and may signal the transition from bladder colonization to symptomatic UTI. However, pyuria can also be caused bt a variety of noninfectious conditions […] ."
                                            },
                                            {
                                                "example_id": "9de02567-f5f9-40b5-93bb-e75d51c5cfa1",
                                                "sense_id": "06e4afa5-3b7e-3cc2-b52b-518581b1ac52",
                                                "text": "2006, Vicki Figen, Chapter 31: Dysuria and Pyuria, in Peter Manu, Raymond E. Suarez, Barbara J. Barnett (editors), Handbook of Medicine in Psychiatry, page 287,\nPyuria is the presence of white blood cells (WBCs) in the urine. Pyuria alone does not indicate a urinary tract infection (UTI)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
