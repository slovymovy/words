                        "glosses": [
                            "Cellule biconcave où se fait la fragmentation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a6f54a-6a93-4fc8-a344-4a0a7f94f03f",
                                "sense_id": "05cea1c1-11d9-33e7-b4ea-24694b1cb181",
                                "text": "C’est une propagule possédant une cellule supplémentaire séparée par une cellule « nécridie » qui n’a pas encore fonctionné."
                            },
                            {
                                "example_id": "06757501-f64b-4bec-9863-0ccba1fa47be",
                                "sense_id": "05cea1c1-11d9-33e7-b4ea-24694b1cb181",
                                "text": "Chez les formes filamenteuses, les trichomes se brisent, soit à partir des hétérocystes, soit à partir de cellules spécialisées appelées nécridies (cellules en cours de dégradation), […]"
                            },
                            {
                                "example_id": "f8e00cee-e121-4721-8064-e9af06c40096",
                                "sense_id": "05cea1c1-11d9-33e7-b4ea-24694b1cb181",
                                "text": "Certains filaments présentent des cellules doublement concaves, ressemblant aux nécridies de certaines Cyanophycées."
                            }
                        ]
