                                        "glosses": [
                                            "periodo di transizione tra l'infanzia e l'età adulta, in cui si acquisisce la capacità riproduttiva della seconda ma sopravvivono alcune caratteristiche psicofisiche della prima"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd60e34-7f9e-44d4-a9bb-f400cf7f8da5",
                                                "sense_id": "6a142539-9ecd-38e8-af72-7615cdaa3311",
                                                "text": "una delle caratteristiche della specie umana é quella di avere infanzia e adolescenza prolungate"
                                            },
                                            {
                                                "example_id": "a68e519f-9971-4d3d-a995-ae169072fcce",
                                                "sense_id": "6a142539-9ecd-38e8-af72-7615cdaa3311",
                                                "text": "l'adolescenza corrisponde in genere al secondo decennio di vita"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
