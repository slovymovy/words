{
    "word_family": [
        "anticipation",
        "anticipateur",
        "anticipatif",
        "anticipatoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d62b3ed-11ac-3a24-a19a-b97658a519e9",
                    "sense_definition": "Prévoir un événement futur ou le comportement d'autrui et agir en conséquence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien de but a parfaitement <w>anticipé</w> le tir de l'attaquant adverse."
                        },
                        {
                            "text": "Pour mener à bien ce projet, nous devons <w>anticiper</w> les besoins des utilisateurs."
                        }
                    ],
                    "synonyms": [
                        "prévoir",
                        "pressentir"
                    ],
                    "common_phrases": [
                        "anticiper les besoins",
                        "anticiper les risques"
                    ]
                },
                {
                    "sense_id": "952a9059-7cc4-30a6-b454-3e17d7b31768",
                    "sense_definition": "Accomplir un acte avant l'échéance ou la date normalement prévue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison d'un imprévu, il a dû <w>anticiper</w> son départ de quelques jours."
                        },
                        {
                            "text": "L'acheteur a préféré <w>anticiper</w> un paiement afin de bénéficier d'une remise financière."
                        }
                    ],
                    "synonyms": [
                        "avancer",
                        "devancer"
                    ],
                    "antonyms": [
                        "différer",
                        "retarder",
                        "repousser"
                    ],
                    "common_phrases": [
                        "anticiper un paiement",
                        "anticiper son départ"
                    ]
                },
                {
                    "sense_id": "4c172d6d-f5eb-32d0-b491-a0f78b92fb00",
                    "sense_definition": "Empiéter sur le temps, le domaine ou les prérogatives d'autrui, ou aborder prématurément un sujet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne veux pas <w>anticiper</w> sur les événements avant de connaître tous les détails."
                        },
                        {
                            "text": "Ce conférencier a tendance à <w>anticiper</w> sur la suite de son exposé théorique."
                        }
                    ],
                    "synonyms": [
                        "empiéter"
                    ],
                    "common_phrases": [
                        "anticiper sur l'avenir",
                        "anticiper sur la suite"
                    ]
                }
            ]
        }
    ]
}