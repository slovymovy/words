                "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                "word": "stickiness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d7ba90b4-9fc7-4de1-8b9c-e0c1335ff591",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "tags": [
                            "plural"
                        ],
                        "form": "stickinesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a1534c9-a5ae-3713-89b3-a549a7851d1b",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "The property of sticking or adhering; adhesion."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e81924e3-ac9b-469a-84d8-eccbec2fcfcd",
                                "sense_id": "5a1534c9-a5ae-3713-89b3-a549a7851d1b",
                                "text": "[…] The flesh [of the mistletoe berry] is sticky, and forms strings and ribbons between my thumb and forefinger. For the mistletoe, this viscous goop – and by the way, viscous comes to English from viscum – is crucial. The stickiness means that, after eating the berries, birds often regurgitate the seeds and then wipe their bills on twigs – leading to the seeds' getting glued to the tree, where they can germinate and begin the cycle anew."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeb03251-0b15-39e9-ab9d-01161b4ef2e8",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "Warmth and humidity, as on a muggy day."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9c11eeaa-bbbc-3ce5-9d38-7f4df9cb3928",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "Of prices or wages: the tendency to stay the same despite changes in the economy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2e505dc0-d5d2-3d9d-885f-667f6737eca7",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "The presence of unique attributes that make a product indisposable and valuable to its owner."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a9baacc9-b880-4092-b5ba-97fd5fa869ff",
                                "sense_id": "2e505dc0-d5d2-3d9d-885f-667f6737eca7",
                                "text": "The stickiness of a cellphone might be measured by its ability to tell correct time, locate its user, and allow its user to remain connected regardless of location."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f992db4-8d83-30da-9f98-99e1a691da18",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "A research measure that captures the extent to which viewers wish to spend more time looking at or reading a print advertisement."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "11042153-a9ef-49e3-8067-5b106e22965c",
                                "sense_id": "4f992db4-8d83-30da-9f98-99e1a691da18",
                                "text": "The low stickiness rating helped explain why our ad’s brand linkage rating was so low: people were turned off by the blurriness of the main photo."
                            }
                        ]
                    },
                    {
                        "sense_id": "3902b2c3-1de6-32a4-b34f-ece78f5aef0b",
                        "entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "glosses": [
                            "An overemotional attachment to others; clinging in interpersonal relations; difficulty with ending conversations."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6faccf7a-7bdf-4277-b893-aff073139a35",
                        "source_entry_id": "efd548d1-e6ef-3e54-bb5b-5353d37bb6a4",
                        "source_sense_description": "property of sticking or adhering",
                        "target_lang_word": "adhérence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adhérence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60aa9ee4-32b6-3bb6-b62c-a6c313cd4c55",
                                        "entry_id": "fa64887c-2f79-3f90-9e50-66c7a166f710",
                                        "glosses": [
                                            "Union d’une chose qui tient à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f3629a-f7b2-4722-b32f-c49f48b72157",
                                                "sense_id": "60aa9ee4-32b6-3bb6-b62c-a6c313cd4c55",
                                                "text": "L’adhérence de la roue sur le rail, qui agit le long du plan incliné en sens contraire du mouvement de translation, et produit la rotation de la roue en s’opposant à ce qu’elle puisse glisser sans tourner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae573d5-5bcf-349d-9dda-8223170c32a0",
                                        "entry_id": "fa64887c-2f79-3f90-9e50-66c7a166f710",
                                        "glosses": [
                                            "Union accidentelle ou morbide de deux parties qui sont séparées à l’état normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7710a6e-802d-460e-aaa8-5cdbf98fd324",
                                                "sense_id": "eae573d5-5bcf-349d-9dda-8223170c32a0",
                                                "text": "Depuis une tentative d'assassinat au couteau en septembre 2018, M. Bolsonaro a subi de nombreuses opérations à l'abdomen en raison d'adhérences et a été soigné pour le même problème en juillet 2021, dans l'établissement où il se trouvait de nouveau lundi."
                                            },
                                            {
                                                "example_id": "6d8a3472-ce17-43ce-9a5b-10f185a346e4",
                                                "sense_id": "eae573d5-5bcf-349d-9dda-8223170c32a0",
                                                "text": "Il y avait adhérence du poumon aux côtes."
                                            },
                                            {
                                                "example_id": "c2ea3c5e-5332-43ad-8cfb-cf4b78f38f82",
                                                "sense_id": "eae573d5-5bcf-349d-9dda-8223170c32a0",
                                                "text": "Il lui est resté des adhérences qui le font souffrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fca088-0337-3f73-b2c2-18baaf305e3d",
                                        "entry_id": "fa64887c-2f79-3f90-9e50-66c7a166f710",
                                        "glosses": [
                                            "Adhérence d’une partie : plus petit fermé contenant cette partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82438d79-2b52-483b-8561-9c2005f8dac7",
                                                "sense_id": "04fca088-0337-3f73-b2c2-18baaf305e3d",
                                                "text": "Dans un espace métrique, l’adhérence d’une partie A contient exactement tous les points de X qui sont limites d’une suite d'éléments dans A."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52641898-a0f8-3bb7-8d96-b9b1e47b95e9",
                                        "entry_id": "fa64887c-2f79-3f90-9e50-66c7a166f710",
                                        "glosses": [
                                            "Liaison du sol avec les roues permettant à un véhicule d’avancer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8916f3bb-9e82-31a4-9191-a3dceafea1cf",
                                        "entry_id": "fa64887c-2f79-3f90-9e50-66c7a166f710",
                                        "glosses": [
                                            "Fort attachement (à un parti, un sentiment, une croyance, ...)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
