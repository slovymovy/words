                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypokoristikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "646bb040-d25f-3acc-af03-0cf685e13cd9",
                                        "entry_id": "41de63ba-914b-3c45-8132-a95e86aced3d",
                                        "glosses": [
                                            "Wort oder Ausdruck mit zärtlicher Bedeutungskomponente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a66322-ed38-44a4-b8f8-396abfd09c71",
                                                "sense_id": "646bb040-d25f-3acc-af03-0cf685e13cd9",
                                                "text": "„Schätzchen“, „Mäuschen“ oder „Berti“ sind Beispiele für Hypokoristika."
                                            },
                                            {
                                                "example_id": "0ccc5c46-b2d6-4e20-81e9-9a4ca95d2e40",
                                                "sense_id": "646bb040-d25f-3acc-af03-0cf685e13cd9",
                                                "text": "„Mit den Diminutiven verwandt sind die Kosewörter oder Hypokoristika, die allerdings meist als Namen gelten und deshalb hier weniger einschlägig sind.“"
                                            },
                                            {
                                                "example_id": "3d669acf-9ed9-4427-a4da-e0513840d5f8",
                                                "sense_id": "646bb040-d25f-3acc-af03-0cf685e13cd9",
                                                "text": "„Ein Kosename, in der Namenforschung auch als Hypokoristikum bezeichnet, wird oft formal mit einem Kurznamen beziehungsweise einer Kurzform gleichgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
