                "senses": [
                    {
                        "sense_id": "37c223d5-e971-3e08-9d71-86a399bb9b64",
                        "entry_id": "7f6a8049-e558-3a76-882f-4240d28a4bf6",
                        "glosses": [
                            "ungelenke(s), unbeholfene(s), schlecht lesbare(s) Schreiben/Schrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe3759e-bddd-453e-962c-261012780f50",
                                "sense_id": "37c223d5-e971-3e08-9d71-86a399bb9b64",
                                "text": "„Neben Kritzeleien finden sich Schreibübungen aus schulischem Kontext, Vorüberlegungen zu einer Handschrift, deren Seitengestaltung anscheinend zuerst auf Schiefer geplant wurde, der Entwurf eines Kaufvertrags, ein Bibelzitat (Zweck bisher ungeklärt) und Namenslisten.“"
                            },
                            {
                                "example_id": "31786d0e-f013-489c-b52d-9c7b9b184cc9",
                                "sense_id": "37c223d5-e971-3e08-9d71-86a399bb9b64",
                                "text": "„Wenige Tage später kam er wieder zu Shakespeare and Company, die Seiten bedeckt mit Kritzeleien und ganze Absätze durchgestrichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc683e19-dc0b-4d3f-af83-3574a2c9c4ff",
                        "source_entry_id": "7f6a8049-e558-3a76-882f-4240d28a4bf6",
                        "source_sense_id": "37c223d5-e971-3e08-9d71-86a399bb9b64",
                        "source_sense_description": "ungelenke(s), unbeholfene(s), schlecht lesbare(s) Schreiben/Schrift",
                        "target_lang_word": "griffonnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griffonnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                        "entry_id": "8bf20e6f-9ac6-37e0-9a64-1d5917454df0",
                                        "glosses": [
                                            "Écriture si mal formée qu’il est presque impossible de la lire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c9cd13-7301-497a-be5f-30f2b372d9eb",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "Je ne saurais lire ce griffonnage."
                                            },
                                            {
                                                "example_id": "a017f950-c669-45d2-b46f-263f83767860",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "Vivez tranquille sur la foi de ma parole, elle vaut mieux que les griffonnages de tous les notaires de Paris."
                                            },
                                            {
                                                "example_id": "7c79ed33-7cd9-42ac-ad74-fedbd463cc73",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "En son absence, le marchand de fer avait voulu tenir ses livres lui-même et il en était résulté un si beau griffonnage, un tel gâchis du doit et avoir qu’il fallait maintenant un mois de grand travail pour remettre les choses en état."
                                            },
                                            {
                                                "example_id": "13fe65e7-ac95-4c0f-b742-9bf024f1b61c",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "Qu’il est bête de couvrir quatre pages d’un griffonnage inutile, quand trois mots suffisaient à remplir sa lettre : « Je vais revenir. »"
                                            },
                                            {
                                                "example_id": "f9339856-c9bc-4a3b-ae60-5cc2e99d3549",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "Joanny regardait bien en face sa version grecque, et il ne la reconnaissait plus. Comment avait-il pu se passionner pour ce griffonnage ?"
                                            },
                                            {
                                                "example_id": "9bc79d2b-571f-4ef9-83c4-00c09c6444dc",
                                                "sense_id": "e2a91ce6-0cbb-3978-915e-8d9ba6390fc4",
                                                "text": "Dans les marges, j’ai découvert des griffonnages indéchiffrables, signes morts d’une petite illumination qui fut vivante et dansante aux environs de ma naissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edeba962-0d7d-3afd-8914-a553abc4e18a",
                                        "entry_id": "8bf20e6f-9ac6-37e0-9a64-1d5917454df0",
                                        "glosses": [
                                            "Action de griffonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8b9294-b87c-4ddf-b6fc-77bb145ba155",
                                                "sense_id": "edeba962-0d7d-3afd-8914-a553abc4e18a",
                                                "text": "En plus des “Angleterre” griffonnés, j’écrivais des phrases très vite sur des serviettes en papier blanches. Cette action (le griffonnage) ainsi que mon costume (le chapeau de paille noir) revenaient à être armée d’un AK-47 […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
