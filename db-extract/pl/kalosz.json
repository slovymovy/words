                    {
                        "translation_id": "e0c70334-fcaf-4788-98bd-e66daa72083d",
                        "source_entry_id": "de588ad6-4453-34fb-aa34-58cf7daf0317",
                        "source_sense_id": "ee6820cc-0b34-3148-9ecc-0795e77b7456",
                        "target_lang_word": "Gummistiefel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gummistiefel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                        "entry_id": "10212278-8617-3286-99f3-d2c901e9eb5f",
                                        "glosses": [
                                            "wasserdichte Stiefel, die aus Gummi gefertigt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3de1271-f042-4fdc-b5a9-b4840c7bf649",
                                                "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                                "text": "Da nach den sintflutartigen Regenfällen das Wasser im Keller knöchelhoch stand, trug der Hausbesitzer Gummistiefel, als er durch die Räume watete."
                                            },
                                            {
                                                "example_id": "7af7d16c-d1a8-4f7f-ad1f-14be550da3a1",
                                                "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                                "text": "„Also tauschte er seine Schuhe gegen Gummistiefel aus und ging tiefer in den Wald hinein.“"
                                            },
                                            {
                                                "example_id": "11dde227-e078-4b79-853b-7d085968b3ae",
                                                "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                                "text": "„Ich hatte schon am Vortag Gummistiefel gekauft.“"
                                            },
                                            {
                                                "example_id": "7410a48b-aca8-4f0e-b123-e6a629c23d33",
                                                "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                                "text": "„Der Pastor wurde übrigens aufgrund eines merkwürdigen Indizes endgültig der Tötung seiner Ehefrau überführt: Er hatte die Gummistiefel, in denen er seine Frau am Waldesrand umgebracht hatte, im Geländewagen vergessen.“"
                                            },
                                            {
                                                "example_id": "2fb13a3a-a7c7-4acf-8501-181e7877162b",
                                                "sense_id": "3d0e9da4-853b-3261-810b-4084f8d6b41d",
                                                "text": "„Während er die Säcke zur Kartoffelkiste in den Keller schafft, bringt sie Eimer und Spatengabel in den Schuppen, hängt die Strickjacke und den Gartenkittel an den Haken und tauscht die Gummistiefel gegen die Pantoffeln ein.“"
                                            }
