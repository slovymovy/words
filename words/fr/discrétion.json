                    "frequency": "High",
                    "semantic_group_id": "retenue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière est entrée dans la chambre avec <w>discrétion</w> pour ne pas réveiller le patient."
                        },
                        {
                            "text": "Nous apprécions la grande <w>discrétion</w> de nos voisins qui ne font jamais de bruit."
                        }
                    ],
                    "synonyms": [
