                "senses": [
                    {
                        "sense_id": "be40c412-9416-30ae-bc96-30cf0daa0c60",
                        "entry_id": "a62dd354-e83c-3627-a294-9ede8454525b",
                        "glosses": [
                            "Avoir un léger frémissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d20ae4d-cb28-4a16-80c5-13b1a6fe6581",
                                "sense_id": "be40c412-9416-30ae-bc96-30cf0daa0c60",
                                "text": "L'alizé friselise au ponche d'ananas !"
                            },
                            {
                                "example_id": "f2af80a8-752f-416c-be74-bfb8d7cb3b97",
                                "sense_id": "be40c412-9416-30ae-bc96-30cf0daa0c60",
                                "text": "Vous saisissez un brin d'herbe, le regardez longuement; alors la petite musique de joie friselise en vous."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9b5ec8-6d14-3716-86c4-4f281f244417",
                        "entry_id": "a62dd354-e83c-3627-a294-9ede8454525b",
                        "glosses": [
                            "Provoquer un léger frémissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea20d8e2-a258-4baf-b05d-39d0baf3a0de",
                                "sense_id": "ef9b5ec8-6d14-3716-86c4-4f281f244417",
                                "text": "L'école où des billes friselisent au fond des poches, et qui s'ouvre et qui se ferme au son oyeux ou triste de la cloche."
                            }
                        ]
                    }
