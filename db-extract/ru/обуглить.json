                        "form_id": "e0486685-3afd-4ac7-a957-2d2cece333b1",
                        "entry_id": "5a169550-bdcc-33c9-9596-8ef34ddd70a3",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обу́гливши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "494e8ca9-c6f9-36a4-ad19-ccefaaba3605",
                        "entry_id": "5a169550-bdcc-33c9-9596-8ef34ddd70a3",
                        "glosses": [
                            "обжечь, образовав уголь по поверхности чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39105c55-c0e0-4245-8958-3f4a05a72c2f",
                                "sense_id": "494e8ca9-c6f9-36a4-ad19-ccefaaba3605",
                                "text": "Вот что: мы не ошибались, когда нам казалось, что у чудовища войны остался один только глаз и что нужно только обуглить бревно, отточить его и общими силами ослепить войну, а пока прятаться в руне овец."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "076c5dfe-667e-40a8-ad86-77857de9d492",
                        "source_entry_id": "5a169550-bdcc-33c9-9596-8ef34ddd70a3",
                        "source_sense_id": "494e8ca9-c6f9-36a4-ad19-ccefaaba3605",
                        "target_lang_word": "carboniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carboniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "680706a5-ff95-37b2-9c3c-45e39e1a567f",
                                        "entry_id": "fa6adf3b-10c8-3c3a-a8e1-e15ab332ad9d",
                                        "glosses": [
                                            "Réduire en charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7044ed34-3610-426b-b423-5fb8209d3d48",
                                                "sense_id": "680706a5-ff95-37b2-9c3c-45e39e1a567f",
                                                "text": "On traverse fréquemment des régions incendiées où les fûts carbonisés portent encore, comme de grosses houppes de tabac, leur ancien feuillage."
                                            },
                                            {
                                                "example_id": "74c81854-5ebf-4ca4-82d1-76767ee8f19c",
                                                "sense_id": "680706a5-ff95-37b2-9c3c-45e39e1a567f",
                                                "text": "— Sur le poêle, récemment allumé, dans une casserole, un morceau de viande achevait de se carboniser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ec618f8-dd30-304c-b178-5a5799adad59",
                                        "entry_id": "fa6adf3b-10c8-3c3a-a8e1-e15ab332ad9d",
                                        "glosses": [
                                            "Réduire à rien, détruire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40e422b9-ed4a-3da6-b4f8-281bdedc8e5f",
                                        "entry_id": "fa6adf3b-10c8-3c3a-a8e1-e15ab332ad9d",
                                        "glosses": [
                                            "Décrédibiliser, Discréditer."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91971af8-9a63-4b3b-a665-aa7de00bd1d9",
                                                "sense_id": "40e422b9-ed4a-3da6-b4f8-281bdedc8e5f",
                                                "text": "Du moment que personne ne demande qui a frappé, l'patron leur aura « filé le duce » et nous sommes cuits, brûlés, grillés, carbonisés. Autant s'tirer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c340416e-ded7-4b17-9ce9-8952c57f592f",
                        "source_entry_id": "5a169550-bdcc-33c9-9596-8ef34ddd70a3",
                        "source_sense_id": "494e8ca9-c6f9-36a4-ad19-ccefaaba3605",
                        "target_lang_word": "calciner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calciner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a855b34-c3a4-30b8-9eb6-7442067b5e8f",
                                        "entry_id": "26c8defd-ce2f-3b9a-b1a7-40bcd0898c8c",
                                        "glosses": [
                                            "Transformer du carbonate calcaire en chaux vive à l’aide d’une forte chaleur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c84b97ce-d21f-3a6b-a0b3-4740edbba751",
                                        "entry_id": "26c8defd-ce2f-3b9a-b1a7-40bcd0898c8c",
                                        "glosses": [
                                            "Soumettre des matières solides quelconques à l’action du feu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfe66e7-829b-4afd-9ef8-7ec0f3386036",
                                                "sense_id": "c84b97ce-d21f-3a6b-a0b3-4740edbba751",
                                                "text": "Calciner le salpêtre, le vitriol, les métaux, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                        "entry_id": "26c8defd-ce2f-3b9a-b1a7-40bcd0898c8c",
                                        "glosses": [
                                            "Faire éprouver une violente action du feu à quelque chose."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc56ccc-b169-47d8-b4c5-d086e933420e",
                                                "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                                "text": "Sur les décombres calcinés des grandes métropoles, s’édifient d’innombrables cabanes provisoires."
                                            },
                                            {
                                                "example_id": "32bb64d6-2d24-4ac1-883d-a91f2f35cc5f",
                                                "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                                "text": "Cette muraille a été calcinée par les flammes."
                                            },
                                            {
                                                "example_id": "4c795dca-21be-4f70-a27f-cf332cbe1aee",
                                                "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                                "text": "Cette pierre s’est calcinée dans le feu."
                                            },
                                            {
                                                "example_id": "d85314fe-ddca-403f-9f81-ff3bdd9596d9",
                                                "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                                "text": "Ils ont retrouvé des corps humains calcinés après l’incendie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9ed611-ae41-3e60-b9df-2e29dd26901d",
                                        "entry_id": "26c8defd-ce2f-3b9a-b1a7-40bcd0898c8c",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "779f59c7-2438-49ca-9f16-0d28bd7138fc",
                                                "sense_id": "7c9ed611-ae41-3e60-b9df-2e29dd26901d",
                                                "text": "Ma mère, au feu des fourneaux, calcinait ses belles mains blanches que j’aimais tant à embrasser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
