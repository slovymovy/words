                "senses": [
                    {
                        "sense_id": "7ecb3871-c886-3761-8c54-86d437cf6215",
                        "entry_id": "f04a5a0e-86d7-3081-93a3-c14d48fe0d76",
                        "glosses": [
                            "Antrieb (zum Beispiel bei Raketen), der durch Rückstoß erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1074ea63-0178-4636-8be9-a89f133cbbd1",
                                "sense_id": "7ecb3871-c886-3761-8c54-86d437cf6215",
                                "text": "„Gedacht waren sie dafür, vergleichsweise kurze Strecken unter ihrem Reaktionsantrieb zurückzulegen oder die kleinen, ebenfalls unbemannten Schleppfahrzeuge zu nutzen, die gemeinhin zur Standardausstattung gehörten.“"
                            },
                            {
                                "example_id": "9de1d7fd-396e-4935-9090-8791f7862965",
                                "sense_id": "7ecb3871-c886-3761-8c54-86d437cf6215",
                                "text": "„Es gab keinerlei Antriebsfeuer oder sonstige Emissionen als Indiz dafür, dass sie sich mit einem Reaktionsantrieb fortbewegt hätten.“"
                            },
                            {
                                "example_id": "f114a6e6-98fc-4d0e-8756-0f13f07ffce0",
                                "sense_id": "7ecb3871-c886-3761-8c54-86d437cf6215",
                                "text": "„Ferner hat die französische Marine ein größeres Schiff mit derartigen Reaktionsantrieben versuchen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
