                        "zh": "指示计算机或程序执行特定操作的指令。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "computing instruction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "命令",
                                "target_lang_sense_clarification": "计算机指令"
                            },
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "计算机操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "761ddf7e-fa23-34c8-96cc-10070a2b9b39",
                    "sense_definition": "Руководство, управление кем-либо или чем-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генерал принял <w>команду</w> над армией в трудный момент.",
                            "target_lang_translations": {
                                "en": "The general took <w>command</w> of the army at a difficult moment.",
                                "zh": "将军在危难时刻接管了军队的<w>指挥</w>权。"
                            }
                        },
                        {
                            "text": "Полк находился под <w>командой</w> опытного полковника.",
                            "target_lang_translations": {
                                "en": "The regiment was under the <w>command</w> of an experienced colonel.",
                                "zh": "该团由一位经验丰富的上校<w>指挥</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руководство",
                        "начальствование"
                    ],
                    "common_phrases": [
                        "принять команду",
                        "под командой"
                    ],
                    "target_lang_definitions": {
                        "en": "Leadership, control over someone or something.",
                        "zh": "对某人或某事的领导、控制或指挥权。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "authority or control"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指挥",
                                "target_lang_sense_clarification": "领导或控制"
                            },
                            {
                                "target_lang_word": "统率",
                                "target_lang_sense_clarification": "军事领导"
                            }
                        ]
                    }
                }
            ]
        }
    ]
