                "senses": [
                    {
                        "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                        "entry_id": "6c20ad3f-ce97-398a-a477-8be663be3d20",
                        "glosses": [
                            "Buch über das Thema Laufen; Buch, das sich an Läufer richtet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f159c0f6-cb18-4780-96a2-c402210855b5",
                                "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                                "text": "„Sina Schielke brachte ein Laufbuch für Frauen heraus, war Fernsehgast bei der Anke-Engelke-Show und hatte vereinzelte Fotoshootings.“"
                            },
                            {
                                "example_id": "50a6888a-7661-4c8d-a25f-ee6dc052f959",
                                "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                                "text": "„Mittlerweile denke ich, dass ein gutes Laufbuch zigmal besser als mehrere Jahrgänge von den Zeitschriften für Spaß am Laufen sorgen kann, ob man es nun wettkampf-, gesundheits- oder spaßorientiert betreibt.“"
                            },
                            {
                                "example_id": "184be5bf-21c2-43b2-b253-833da639ccb0",
                                "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                                "text": "„Von 0 auf 5 km - das Laufbuch zum Kurs“"
                            },
                            {
                                "example_id": "4bdacb5f-4917-4028-ada9-84d9bca26302",
                                "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                                "text": "„Das erste Mal, dass ich ein Laufbuch von Anfang bis Ende durchgelesen und es nicht nach einiger Zeit gelangweilt, genervt oder auch gefrustet zur Seite gelegt habe. Markus“"
                            },
                            {
                                "example_id": "9029c1f8-77a2-4b58-a247-ae68e38fa655",
                                "sense_id": "654c0113-5d5b-3257-a1cb-511b3369e32c",
                                "text": "„Einen detaillierten Trainingsplan für einen Marathon habe ich noch nie befolgt und auch spezielle Laufbücher zum Thema Marathon noch nie zur Hand genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
