{
    "word": "systemic",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                "word": "systemic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aaa755d5-c32e-3d3a-8fb1-5cf9232eaffe",
                        "entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                        "glosses": [
                            "Embedded within and spread throughout and affecting a whole system, group, body, economy, market, or society."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6038467-3129-43fc-8ceb-e9b651450533",
                                "sense_id": "aaa755d5-c32e-3d3a-8fb1-5cf9232eaffe",
                                "text": "We can learn from the incidents found it the project database - looking at them and understanding what happened and what might have been done differently. We can see past errors, including systemic issues that required attention at managerial levels."
                            }
                        ]
                    },
                    {
                        "sense_id": "e763da3d-8efc-3adf-85d9-a0826f61bec6",
                        "entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                        "glosses": [
                            "Pertaining to an entire organism."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac944bca-5b6a-4ab6-b288-d956f5f90136",
                                "sense_id": "e763da3d-8efc-3adf-85d9-a0826f61bec6",
                                "text": "Iberdomide, a cereblon modulator promoting degradation of the transcription factors Ikaros and Aiolos, which affect leukocyte development and autoimmunity, is being evaluated for the treatment of systemic lupus erythematosus (SLE)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39d22a2b-6304-4acd-b76c-8a04a3c3b954",
                        "source_entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                        "source_sense_description": "relating to a system",
                        "target_lang_word": "systémový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systémový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1585f5-3610-307c-b659-faa78c559aee",
                                        "entry_id": "35a4bf66-e4c3-3cd8-9814-1be351f5f31b",
                                        "glosses": [
                                            "vztahující se k systému"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4f5874e-4d63-4ea5-a2f6-293fb33a7a95",
                        "source_entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                        "source_sense_description": "relating to a system",
                        "target_lang_word": "systémique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systémique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e612ebe7-6d38-36fb-ae28-74d53b31210d",
                                        "entry_id": "9a79b746-6d9e-3cf8-b7fa-50ad4ae9cc8b",
                                        "glosses": [
                                            "Relatif à un système."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc172f5-b32d-4ae8-b985-0b707305f240",
                                                "sense_id": "e612ebe7-6d38-36fb-ae28-74d53b31210d",
                                                "text": "L’endocrinologie et l’immunologie par exemple insistent sur une approche systémique : l'accent n'est pas mis sur l’agent causal des maladies, mais sur les capacités du corps à répondre à ces agents, ce que les médecins français appellent le « terrain »."
                                            },
                                            {
                                                "example_id": "bf867cb5-6429-4f82-9761-6a837ab51734",
                                                "sense_id": "e612ebe7-6d38-36fb-ae28-74d53b31210d",
                                                "text": "À la dérégulation la plus brutale imposée par les politiques néo-libérales à l’œuvre dans la plupart des pays anglo-saxons, s’ajoute une crise financière systémique qui s’attaque directement aux budgets des États."
                                            },
                                            {
                                                "example_id": "59936f34-7130-4b16-9de5-b2496a103c06",
                                                "sense_id": "e612ebe7-6d38-36fb-ae28-74d53b31210d",
                                                "text": "Pourrions-nous penser que le racisme systémique existe au Québec, tout en pensant que l’intégration des communautés noires au Québec n’est pas un échec, et que blâmer exclusivement les institutions québécoises pour les déboires des peuples autochtones est fondamentalement injuste ?"
                                            },
                                            {
                                                "example_id": "7420b2c1-b519-427b-883d-361063022593",
                                                "sense_id": "e612ebe7-6d38-36fb-ae28-74d53b31210d",
                                                "text": "Il faut que la Physique systèmique attende à élever des édifices, que la Physique expérimentale soit en état de lui fournir des matériaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da240606-c49a-3dac-9a97-c0043eac244e",
                                        "entry_id": "9a79b746-6d9e-3cf8-b7fa-50ad4ae9cc8b",
                                        "glosses": [
                                            "Qualifie un produit phytosanitaire qui est absorbé par la plante, véhiculé par la sève, et s’attaque aux parasites par l’intérieur de la plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74af992b-faa4-4a1d-983c-3ff40948ab31",
                                                "sense_id": "da240606-c49a-3dac-9a97-c0043eac244e",
                                                "text": "Les fongicides ou bactéricides systémiques dont il vient d’être question ont constitué, à partir de 1960, une nouvelle génération (la seconde) de produits phytosanitaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "systémique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b13e122-9d54-3bed-9855-240f82c2a79d",
                                        "entry_id": "2840322a-b44f-32e0-b631-f0a8d1ae1a8e",
                                        "glosses": [
                                            "Produit phytosanitaire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba4a39e5-d063-4ebe-86ec-7595e2906053",
                                                "sense_id": "3b13e122-9d54-3bed-9855-240f82c2a79d",
                                                "text": "Il faut alors recourir à un systémique qui, en pénétrant la plante et en étant véhiculé par la sève, empoisonnera le puceron trop gourmand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "systémique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30c4ecc1-d895-32ce-86f5-2bfe9fad561d",
                                        "entry_id": "4fb4d8a3-e3ec-3591-811e-72c53b374114",
                                        "glosses": [
                                            "Méthode de recherche économique basée sur l’étude par système."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ac1bd1-6362-4682-96fe-0e7ea681b502",
                                                "sense_id": "30c4ecc1-d895-32ce-86f5-2bfe9fad561d",
                                                "text": "L’engouement pour la systémique et la rupture avec les modèles linéaires fit naître quantité de gourous renversant des pyramides, aplatissant les triangles et dessinant force boîtes reliées par une multitude de flèches à double sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8322aa86-bafc-4807-ae4e-40ac8ca2e200",
                        "source_entry_id": "0a0e5080-60cf-354c-9520-6793713e68f9",
                        "source_sense_description": "relating to a system",
                        "target_lang_word": "systemisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systemisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01dee27a-8a23-3719-834c-104bb559415c",
                                        "entry_id": "5bfc123f-67a6-306b-9fc9-183d5f2202ff",
                                        "glosses": [
                                            "auf ein Gesamtsystem bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108ee687-a938-4b45-8c5e-b2890c022713",
                                                "sense_id": "01dee27a-8a23-3719-834c-104bb559415c",
                                                "text": "„Jeder systemische Ansatz zeichnet sich dadurch aus, dass man sich nicht auf den Problemträger konzentriert, sondern ein ganzes System in den Blick nimmt.“"
                                            },
                                            {
                                                "example_id": "41a9bee2-c8c0-4513-9918-348ccd14bcb8",
                                                "sense_id": "01dee27a-8a23-3719-834c-104bb559415c",
                                                "text": "„Die zuvor aufgegebene Gestaltungsrolle wurde den nationalen Regierungen wieder aufgezwungen, nachdem klar wurde, dass die sprichwörtlichen Selbstheilungskräfte der Märkte eine systemische Krise nicht verhindern konnten.“"
                                            },
                                            {
                                                "example_id": "c0e09e8b-cef2-468f-86a2-c4e2d0e3199e",
                                                "sense_id": "01dee27a-8a23-3719-834c-104bb559415c",
                                                "text": "„Das Scheitern der Bewegung hatte nicht nur politische, sondern auch systemische Gründe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87c626c2-61f3-3eea-9081-dfa9000547ab",
                                        "entry_id": "5bfc123f-67a6-306b-9fc9-183d5f2202ff",
                                        "glosses": [
                                            "einen Organismus oder mehrere Organe ganzheitlich betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d732a8f-268f-4335-b905-0ecda425eed6",
                                                "sense_id": "87c626c2-61f3-3eea-9081-dfa9000547ab",
                                                "text": "„Systemische Therapie ist ein eigenständiges psychotherapeutisches Verfahren mit einem reichhaltigen Repertoire an Methoden und Anwendungsbereichen.“"
                                            },
                                            {
                                                "example_id": "97c2330d-f636-40fc-99e8-5bb2f680a56c",
                                                "sense_id": "87c626c2-61f3-3eea-9081-dfa9000547ab",
                                                "text": "„Systemische Therapie und Beratung stellen weder eine unmittelbar wissenschaftsgeleitete Anwendung systemtheoretischer Konzepte noch einen rein handwerklichen Satz von Techniken dar. Zwischen beides treten die Person des systemisch Arbeitenden sowie der Kontext, in dem systemisch gearbeitet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
