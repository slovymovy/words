                "senses": [
                    {
                        "sense_id": "d9f5145d-f88f-31e2-af1e-3e96a0bd0f7c",
                        "entry_id": "fbcd62de-ba74-39f6-b6b6-47b649bac81a",
                        "glosses": [
                            "Übertragung eines fremdsprachigen Ausdrucks ins Deutsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f95f31a-4b43-4441-b771-9be1dfe615ba",
                                "sense_id": "d9f5145d-f88f-31e2-af1e-3e96a0bd0f7c",
                                "text": "„Sie haben unserer Sprache manche treffliche Verdeutschung geschenkt.“"
                            },
                            {
                                "example_id": "03859ab6-3b13-414e-b322-d27095e2ac65",
                                "sense_id": "d9f5145d-f88f-31e2-af1e-3e96a0bd0f7c",
                                "text": "„Die Ausweitung des Wortschatzes ist abzulesen an der Übernahme aus Fachwortschätzen, der Entlehnung aus anderen Sprachen sowie der Verdeutschung fremdsprachiger Wörter.“"
                            },
                            {
                                "example_id": "9785dcc2-dad6-4901-aca0-e24c81966873",
                                "sense_id": "d9f5145d-f88f-31e2-af1e-3e96a0bd0f7c",
                                "text": "„Englische Wörter scheinen hingegen heute in großer Zahl direkt bis in die Mundarten übernommen zu werden; in Deutschland eingeführte Verdeutschungen werden kaum rezipiert.“"
                            },
                            {
                                "example_id": "c80aadbf-cf42-4f0b-80bf-c745d3efd1dc",
                                "sense_id": "d9f5145d-f88f-31e2-af1e-3e96a0bd0f7c",
                                "text": "„Schon im 17. Jahrhundert hatte sie mit vielen Versuchen zur Verdeutschung von Fremdwörtern ihren ersten Höhepunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
