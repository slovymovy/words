                ],
                "senses": [
                    {
                        "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                        "entry_id": "a61f8210-2915-3be2-a8e1-c078e07c751d",
                        "glosses": [
                            "Raum für textiles Werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e571154d-e45e-4810-b115-1f68688dd8af",
                                "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                                "text": "„Sogar ein Strickzimmer mit einem Regal für naturbelassene Wolle hat die begeisterte Hobbystrickerin einrichten lassen.“"
                            },
                            {
                                "example_id": "0d4348a7-d75a-4e36-a6e8-a44d4185388a",
                                "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                                "text": "„Im Strickzimmer liegt viel Wolle herum.“"
                            },
                            {
                                "example_id": "958fcfa4-3f4d-49fb-8085-ac8b85a6bf71",
                                "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                                "text": "„Bevor man das eigentliche \"Strickzimmer\", das El Dorado der Wollsocken, Schals und Pullunder, der Topflappen und kleinen Figürchen, die man auch aus Wolle stricken kann, betritt, empfängt einen schon das wunderbare Aroma von frisch gebrühtem Kaffee.“"
                            },
                            {
                                "example_id": "e9466773-c7d2-4a44-a7cc-a4dd70cb384c",
                                "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                                "text": "„Ein Wohn- und ein Strickzimmer vermitteln die historische Alltagskultur.“"
                            },
                            {
                                "example_id": "df07600d-55a6-41c5-b0d3-0bd79634aba1",
                                "sense_id": "ca73e456-8f03-3aa2-931a-fec8a280ba4d",
                                "text": "„Eingebaut wird unmittelbar nach dem Eingang ein Fahrstuhl, mit dem das Strickzimmer auf der ersten Ebene und der Bürgersaal auf der zweiten barrierefrei erreicht werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4370e753-6d48-3fc2-a3dd-79b9d921dd55",
                        "entry_id": "a61f8210-2915-3be2-a8e1-c078e07c751d",
                        "glosses": [
                            "Toilette, in der ein hoch über der Kloschüssel angebrachter Spülkasten mit einem Strick betätigt wird"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c4e23f16-4eb5-468d-870d-4a7c4b605633",
                                "sense_id": "4370e753-6d48-3fc2-a3dd-79b9d921dd55",
                                "text": "„Das Strickzimmer ist samt seiner zum Kartoffelwaschen denaturierten Kloschüssel vom heutigen Zivilisationslevel weit entfernt.“"
                            },
                            {
                                "example_id": "90f9ef1e-a773-4e60-bd8d-0219bd0d7a42",
                                "sense_id": "4370e753-6d48-3fc2-a3dd-79b9d921dd55",
                                "text": "„Auf dem Hof befanden sich zwei Strickzimmer. Das waren unsere Klo's.“"
                            },
                            {
                                "example_id": "8599d1a7-fb65-42e6-8166-ed95b4014b65",
                                "sense_id": "4370e753-6d48-3fc2-a3dd-79b9d921dd55",
                                "text": "„Weil die Toilettenspülung mit einem Strick betätigt wurde, ist die Toilette hie und da nach dem Krieg als Strickzimmer bezeichnet worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
