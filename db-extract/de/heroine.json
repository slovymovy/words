                        ],
                        "form": "die Heroine"
                    },
                    {
                        "form_id": "6cd53df0-09db-49c5-b993-c5520971fc18",
                        "entry_id": "48ce232a-25b5-3568-8b8e-a894def8de05",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Heroinen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1bc3bf7-b84f-39d3-9521-f2da278bc74d",
                        "entry_id": "48ce232a-25b5-3568-8b8e-a894def8de05",
                        "glosses": [
                            "Darstellerin einer Heldinnenrolle"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "b530a724-3245-4a1d-b435-372bbec2188d",
                                "sense_id": "a1bc3bf7-b84f-39d3-9521-f2da278bc74d",
                                "text": "„Gerade ihr Fach, das der ‚Heroine‘, verleitete zur gestischen Schablone und zum rhetorischen Bombast, Untugenden, denen ihre Vorgängerinnen in Braunschweig gehuldigt hatten.“"
                            },
                            {
                                "example_id": "25b7c8e6-7acc-40d0-93bf-d600dc7fbd3b",
                                "sense_id": "a1bc3bf7-b84f-39d3-9521-f2da278bc74d",
                                "text": "„Die Rezeptionsgeschichte des griechischen Dramas und seiner Heroinen stellt selbst ein umfangreiches Thema dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0637e91d-7ed1-3567-93a8-b5d0c5978263",
                        "entry_id": "48ce232a-25b5-3568-8b8e-a894def8de05",
                        "glosses": [
                            "Heldin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266dd6c7-fbca-4578-9619-e16a030a97d0",
                                "sense_id": "0637e91d-7ed1-3567-93a8-b5d0c5978263",
                                "text": "„So wurde Theseus König, und seitdem heißt jenes Meer, über dem die Gestalt der Göttin und Heroine Ariadne schwebt, das Ägäische.“"
                            },
                            {
                                "example_id": "36b13197-aa11-4bb1-b8ff-0df7eb611b28",
                                "sense_id": "0637e91d-7ed1-3567-93a8-b5d0c5978263",
                                "text": "„Aus griechischen Quellen kennen wir diese Männer und Frauen als Heroen und Heroinen, die nach der Sage in vorgeschichtlicher Zeit in Böotien zu Hause waren.“"
                            },
                            {
                                "example_id": "823aa650-be5e-4927-bda3-e10b2cf9441d",
                                "sense_id": "0637e91d-7ed1-3567-93a8-b5d0c5978263",
                                "text": "„Entzückt über diese List, ging ich mit meinen beiden Heroinen wieder hinüber, und wir vollbrachten Wunder.“"
                            },
                            {
                                "example_id": "88141303-be43-4abe-89da-e9a24e3c2533",
                                "sense_id": "0637e91d-7ed1-3567-93a8-b5d0c5978263",
                                "text": "„Sie las abends nicht mehr, sondern vertrieb sich die Langeweile durch heftiges Stochern im Kaminfeuer des Salons, wobei sie hin und wieder aufseufzte wie eine weltmüde Ibsensche Heroine.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
