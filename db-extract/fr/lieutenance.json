                "senses": [
                    {
                        "sense_id": "6e1d603c-82fd-3234-bd82-d52868f51278",
                        "entry_id": "f0c592a7-7901-3547-b33f-cec67a531b12",
                        "glosses": [
                            "Charge, office, emploi, grade de lieutenant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "86e3fd06-2077-4f36-ba88-9739d1d1f3db",
                                "sense_id": "6e1d603c-82fd-3234-bd82-d52868f51278",
                                "text": "On a regardé comme un des actes les plus violens du ministère de Castelreagh, d’avoir dépouillé lord Fitz-William de la lieutenance du Yorkshire, pour le punir de son opposition aux vues du gouvernement."
                            },
                            {
                                "example_id": "b895541e-a6de-4f26-8fac-3a660ace33ed",
                                "sense_id": "6e1d603c-82fd-3234-bd82-d52868f51278",
                                "text": "Il fit grande caresse au mari d’Angélique, et lui dit qu’en attendant une compagnie, il lui donnerait une lieutenance, – et qu’il allait mettre mademoiselle de Longueval dans la carrosse de sa sœur, qui était mariée au premier capitaine de son régiment."
                            },
                            {
                                "example_id": "40ca2829-0e1a-4592-9dc8-46c52c2fd31b",
                                "sense_id": "6e1d603c-82fd-3234-bd82-d52868f51278",
                                "text": "Le duc d’Orléans […] se décida à accepter d’abord la lieutenance générale du royaume, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a112f1f-f2ab-3bd9-836f-7202ced541fb",
