            "pos": "noun",
            "senses": [
                {
                    "sense_id": "041595af-e1d4-32eb-9dce-49fa5b321951",
                    "sense_definition": "een resultaat of gevolg van een eerdere handeling of gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet altijd goed nadenken over de mogelijke <w>consequentie</w> van je daden.",
                            "target_lang_translations": {
                                "en": "You should always think carefully about the possible <w>consequence</w> of your actions."
                            }
                        },
                        {
                            "text": "Het verlies van zijn baan was een directe <w>consequentie</w> van de economische crisis.",
                            "target_lang_translations": {
                                "en": "The loss of his job was a direct <w>consequence</w> of the economic crisis."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevolg",
                        "resultaat",
                        "nasleep"
                    ],
                    "antonyms": [
                        "oorzaak",
                        "aanleiding"
                    ],
                    "common_phrases": [
                        "mogelijke consequentie",
                        "directe consequentie",
                        "ernstige consequenties"
                    ],
                    "target_lang_definitions": {
                        "en": "a result or effect of a previous action or event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consequence",
                                "target_lang_sense_clarification": "a result of an action, often negative"
                            },
                            {
                                "target_lang_word": "result",
                                "target_lang_sense_clarification": "the outcome of an event or action"
                            },
                            {
                                "target_lang_word": "aftermath",
                                "target_lang_sense_clarification": "the consequences of a significant unpleasant event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                    "sense_definition": "iets dat logischerwijs voortvloeit uit een bepaalde situatie of besluit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het betalen van meer belasting is een logische <w>consequentie</w> van een hoger salaris.",
                            "target_lang_translations": {
                                "en": "Paying more tax is a logical <w>consequence</w> of a higher salary."
                            }
                        },
                        {
                            "text": "Als je kiest voor deze studie, heeft dat de <w>consequentie</w> dat je veel moet lezen.",
                            "target_lang_translations": {
                                "en": "If you choose this study, it has the <w>implication</w> that you have to read a lot."
                            }
                        }
                    ],
                    "synonyms": [
                        "implicatie",
                        "gevolgtrekking"
                    ],
                    "common_phrases": [
                        "logische consequentie",
                        "consequenties aanvaarden"
                    ],
                    "target_lang_definitions": {
                        "en": "something that follows logically from a particular situation or decision"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "implication",
                                "target_lang_sense_clarification": "a likely consequence of something"
                            },
                            {
                                "target_lang_word": "consequence",
                                "target_lang_sense_clarification": "a logical effect or result"
                            },
                            {
                                "target_lang_word": "inference",
                                "target_lang_sense_clarification": "a conclusion reached on the basis of evidence"
                            }
                        ]
                    }
                }
            ]
