                        "examples": [
                            {
                                "example_id": "e0ed128b-463b-4339-ae22-e55e8ea9c2ff",
                                "sense_id": "7166e855-e445-3939-a071-570378a7bd58",
                                "text": "Ces demoiselles sont en nanzouk ou en organdi, avec des capotes fleuries à brides bleues ou roses ; ces messieurs arborent des pantalons clairs."
                            },
                            {
                                "example_id": "e1de22f9-58f7-4245-857b-6774de6b882f",
                                "sense_id": "7166e855-e445-3939-a071-570378a7bd58",
                                "text": "Quant au nanzouk, il servit à faire des brassières pour les bébés qui, dans la famille ou le voisinage, naquirent hardiment en pleine guerre, ni plus ni moins inquiets que les autres du sort qui les attendait."
                            },
                            {
                                "example_id": "ba9aeac3-328e-4f20-90db-3f3b03e09d3d",
                                "sense_id": "7166e855-e445-3939-a071-570378a7bd58",
                                "text": "En jupon de nanzouk blanc, en corset-brassière de coutil blanc, Minne se regarde dans la glace"
                            }
                        ]
                    }
                ],
