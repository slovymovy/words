                        "form_id": "cd02109d-9fc4-486f-9479-681709ca1f63",
                        "entry_id": "f009ddca-da2a-3874-8991-d9b24baa8a68",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unacknowledged"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "858c35ed-3ac6-34f2-8cc6-45adc0f38ee1",
                        "entry_id": "f009ddca-da2a-3874-8991-d9b24baa8a68",
                        "glosses": [
                            "Not acknowledged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9801f59-04ef-4024-aefc-d192ab678d21",
                                "sense_id": "858c35ed-3ac6-34f2-8cc6-45adc0f38ee1",
                                "text": "[T]he use of both acknowledged and unacknowledged (silent) translations of non-English sources makes it difficult for users to determine if a certain term genuinely appeared in an English-language text."
                            },
                            {
                                "example_id": "f3aa7b04-a5f7-4864-8a93-497b51508d00",
                                "sense_id": "858c35ed-3ac6-34f2-8cc6-45adc0f38ee1",
                                "text": "Many young people are also reevaluating what once constituted cringe, attributing use of the term to unacknowledged bigotry more than just a rejection of sincerity. Some niche communities, such as furries, anime fans, and fetish groups, who were once mocked on social media, have since amassed cultural power that has launched them into the mainstream."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25990124-fcad-4a76-8d7c-ae1908e38389",
                        "source_entry_id": "f009ddca-da2a-3874-8991-d9b24baa8a68",
                        "source_sense_id": "858c35ed-3ac6-34f2-8cc6-45adc0f38ee1",
                        "source_sense_description": "not acknowledged",
                        "target_lang_word": "inavoué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inavoué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a757925-04cc-39a9-a110-9eeecf832c7f",
                                        "entry_id": "c5d4a022-652f-3fb9-92fd-9d477a1badf0",
                                        "glosses": [
                                            "Qui n’est pas avoué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed9ad79-ef12-4af2-a53a-1356a40ac31a",
                                                "sense_id": "6a757925-04cc-39a9-a110-9eeecf832c7f",
                                                "text": "Avec cet extrait s'écroulent tous les rêves inavoués de l'infaillibilité du Dictionnaire, et s'illustrent toutes les difficultés des gens qui travaillent en révision."
                                            },
                                            {
                                                "example_id": "e56e1dd8-61d4-40d0-86e8-09e1ae5fd368",
                                                "sense_id": "6a757925-04cc-39a9-a110-9eeecf832c7f",
                                                "text": "Le but inavoué est de décourager les chantiers particuliers afin d'orienter les matériaux disponibles vers les secteurs prioritaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
