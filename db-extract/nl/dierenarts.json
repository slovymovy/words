                                    {
                                        "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                        "entry_id": "2d96e877-f8da-3c66-856d-ff210bde0c0b",
                                        "glosses": [
                                            "Arzt, der nach staatlicher Approbation Tiere medizinisch behandelt und betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a6bba2d-b4d1-430c-9691-245b9c2f7e16",
                                                "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                                "text": "Mein Hund wurde beim Tierarzt gegen Tollwut geimpft."
                                            },
                                            {
                                                "example_id": "121bef34-32c5-4ce0-9e11-8c14fb763e16",
                                                "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                                "text": "„Dafür hatte ihnen beiden der tote Tierarzt Wilhelm zu viel Herzeleid angetan.“"
                                            },
                                            {
                                                "example_id": "f1d28710-bd44-4bd6-a242-359c64fba2f9",
                                                "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                                "text": "„Ein Tierarzt stellte fest, dass der Koala unverletzt war, lediglich das Fell war an einigen Stellen versengt worden.“"
                                            },
                                            {
                                                "example_id": "fbbd99db-4482-4fe9-a29b-67e419cb1b46",
                                                "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                                "text": "„Dies ist nach den Studien eines Tierarztes die beschämende Folge der Unrast unserer Zeit.“"
                                            },
                                            {
                                                "example_id": "9f1ccfeb-e4c0-4548-99b1-ef78c27eb005",
                                                "sense_id": "0763d4ea-0a38-3541-b5ac-0c730b65eafc",
                                                "text": "„Vermutlich verließ meine Großmutter geschäftig das Haus, um mit Juttas Vater, dem Tierarzt von Götzlack, das weitere Vorgehen zu besprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
