{
    "word_family": [
        "пловец",
        "плавание",
        "плавник",
        "поплавок",
        "плавки",
        "мореплаватель",
        "сплав",
        "заплыв"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e80dcb5-ae2c-3853-9c93-69e525ad61b6",
                    "sense_definition": "Держаться на поверхности воды или передвигаться в ней (о людях, животных и предметах).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы часто ездим на море и <w>плаваем</w> там целый день.",
                            "target_lang_translations": {
                                "en": "In summer we often go to the sea and <w>swim</w> there all day.",
                                "nl": "In de zomer gaan we vaak naar de zee en <w>zwemmen</w> daar de hele dag."
                            }
                        },
                        {
                            "text": "В тарелке с супом <w>плавали</w> крупные куски картофеля.",
                            "target_lang_translations": {
                                "en": "Large chunks of potato were <w>floating</w> in the bowl of soup.",
                                "nl": "In het bord soep <w>dreven</w> grote stukken aardappel."
                            }
                        }
                    ],
                    "synonyms": [
                        "купаться"
                    ],
                    "antonyms": [
                        "тонуть",
                        "идти ко дну"
                    ],
                    "common_phrases": [
                        "уметь плавать",
                        "быстро плавать",
                        "плавать в реке",
                        "плавать на спине"
                    ],
                    "target_lang_definitions": {
                        "en": "To stay on the water surface or move through it (about people, animals, and objects).",
                        "nl": "Zich op het wateroppervlak bevinden of zich erdoorheen verplaatsen (over mensen, dieren en voorwerpen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swim",
                                "target_lang_sense_clarification": "active movement in water"
                            },
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "stay on the surface"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zwemmen",
                                "target_lang_sense_clarification": "actieve beweging in water door mensen of dieren"
                            },
                            {
                                "target_lang_word": "drijven",
                                "target_lang_sense_clarification": "op het wateroppervlak blijven zonder actieve beweging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f87c0a2f-43a0-3d68-b5ce-a57060fa3081",
                    "sense_definition": "Заниматься плаванием как видом спорта или физическим упражнением.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат профессионально <w>плавает</w> и участвует в соревнованиях.",
                            "target_lang_translations": {
                                "en": "My brother <w>swims</w> professionally and participates in competitions.",
                                "nl": "Mijn broer <w>zwemt</w> professioneel en doet mee aan wedstrijden."
                            }
                        },
                        {
                            "text": "Врач посоветовал мне <w>плавать</w> в бассейне два раза в неделю.",
                            "target_lang_translations": {
                                "en": "The doctor advised me to <w>swim</w> in the pool twice a week.",
                                "nl": "De dokter adviseerde me om twee keer per week in het zwembad te <w>zwemmen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "любить плавать",
                        "ходить плавать",
                        "научиться плавать"
                    ],
                    "target_lang_definitions": {
                        "en": "To practice swimming as a sport or physical exercise.",
                        "nl": "Zwemmen beoefenen als sport of fysieke oefening."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swim",
                                "target_lang_sense_clarification": "sport or exercise"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zwemmen",
                                "target_lang_sense_clarification": "als sport of lichaamsbeweging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0900cf8a-8a22-33e9-81f4-81019e3f2dcd",
                    "sense_definition": "Совершать рейсы, путешествовать или передвигаться по воде (о судах и моряках).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот старый капитан <w>плавал</w> на торговых судах по всему миру.",
                            "target_lang_translations": {
                                "en": "This old captain <w>sailed</w> on merchant ships all over the world.",
                                "nl": "Deze oude kapitein heeft op koopvaardijschepen over de hele wereld <w>gevaren</w>."
                            }
                        },
                        {
                            "text": "Огромный белый паром <w>плавает</w> между островами каждый день.",
                            "target_lang_translations": {
                                "en": "A huge white ferry <w>sails</w> between the islands every day.",
                                "nl": "Een enorme witte veerboot <w>vaart</w> elke dag tussen de eilanden."
                            }
                        }
                    ],
                    "synonyms": [
                        "ходить"
                    ],
                    "common_phrases": [
                        "плавать на корабле",
                        "плавать в море",
                        "долго плавать"
                    ],
                    "target_lang_definitions": {
                        "en": "To make voyages, travel, or move across water (about ships and sailors).",
                        "nl": "Reizen maken of zich over water verplaatsen (over schepen en zeelieden)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sail",
                                "target_lang_sense_clarification": "travel by ship"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "varen",
                                "target_lang_sense_clarification": "zich per schip verplaatsen"
                            },
                            {
                                "target_lang_word": "bevaren",
                                "target_lang_sense_clarification": "een bepaald water of route bevaren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2bcddd0-d04a-3770-a264-83b7535dfb34",
                    "sense_definition": "Плавно и свободно перемещаться в воздухе.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В голубом небе медленно <w>плавали</w> лёгкие белые облака.",
                            "target_lang_translations": {
                                "en": "Light white clouds were slowly <w>floating</w> in the blue sky.",
                                "nl": "In de blauwe lucht <w>dreven</w> langzaam lichte witte wolken."
                            }
                        },
                        {
                            "text": "Густой сигаретный дым <w>плавал</w> под потолком комнаты.",
                            "target_lang_translations": {
                                "en": "Thick cigarette smoke <w>floated</w> under the ceiling of the room.",
                                "nl": "Dikke sigarettenrook <w>dreef</w> onder het plafond van de kamer."
                            }
                        }
                    ],
                    "synonyms": [
                        "парить"
                    ],
                    "common_phrases": [
                        "облака плавают",
                        "плавать в воздухе"
                    ],
                    "target_lang_definitions": {
                        "en": "To move smoothly and freely in the air.",
                        "nl": "Soepel en vrij door de lucht bewegen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "move gently in air"
                            },
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "move aimlessly"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "drijven",
                                "target_lang_sense_clarification": "langzaam door de lucht bewegen"
                            },
                            {
                                "target_lang_word": "zweven",
                                "target_lang_sense_clarification": "vrij in de lucht hangen of bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3455d0de-ab5c-311f-a90f-310e5dade1f5",
                    "sense_definition": "Постоянно меняться или колебаться (о ценах, курсе валют, графике).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fluctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Курс доллара постоянно <w>плавает</w>, поэтому сложно планировать бюджет.",
                            "target_lang_translations": {
                                "en": "The dollar exchange rate constantly <w>fluctuates</w>, so it is difficult to plan a budget.",
                                "nl": "De dollarkoers <w>schommelt</w> voortdurend, dus het is lastig om het budget te plannen."
                            }
                        },
                        {
                            "text": "У нас на работе <w>плавает</w> график, и я прихожу в разное время.",
                            "target_lang_translations": {
                                "en": "We have a <w>floating</w> schedule at work, and I arrive at different times.",
                                "nl": "We hebben op het werk een <w>variabel</w> rooster, en ik kom op verschillende tijden."
                            }
                        }
                    ],
                    "synonyms": [
                        "колебаться",
                        "меняться",
                        "изменяться"
                    ],
                    "antonyms": [
                        "сохраняться"
                    ],
                    "common_phrases": [
                        "цены плавают",
                        "курс плавает",
                        "график плавает"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To constantly change or fluctuate (about prices, exchange rates, schedules).",
                        "nl": "Voortdurend veranderen of schommelen (over prijzen, wisselkoersen, roosters)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fluctuate",
                                "target_lang_sense_clarification": "change continually"
                            },
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "currency or schedule"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schommelen",
                                "target_lang_sense_clarification": "fluctueren van waarden"
                            },
                            {
                                "target_lang_word": "variabel",
                                "target_lang_sense_clarification": "niet vaststaand (bijv. rooster)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec45d0e-b2f3-3327-9c02-ce635069e482",
                    "sense_definition": "Плохо знать материал, отвечать неуверенно, путаться (обычно на экзамене).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент не подготовился к экзамену и сразу начал <w>плавать</w>.",
                            "target_lang_translations": {
                                "en": "The student hadn't prepared for the exam and immediately started to <w>flounder</w>.",
                                "nl": "De student had zich niet voorbereid op het examen en begon meteen te <w>stuntelen</w>."
                            }
                        },
                        {
                            "text": "Я чувствую, что <w>плаваю</w> в этой теме и не могу дать точный ответ.",
                            "target_lang_translations": {
                                "en": "I feel that I <w>am out of my depth</w> in this topic and cannot give an exact answer.",
                                "nl": "Ik voel dat ik <w>niet goed thuis ben</w> in dit onderwerp en geen precies antwoord kan geven."
                            }
                        }
                    ],
                    "synonyms": [
                        "путаться"
                    ],
                    "antonyms": [
                        "знать",
                        "разбираться",
                        "понимать",
                        "соображать"
                    ],
                    "common_phrases": [
                        "плавать на экзамене",
                        "плавать в вопросе",
                        "откровенно плавать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To know the material poorly, answer uncertainly, or get confused (usually at an exam).",
                        "nl": "De stof slecht kennen, onzeker antwoorden of in de war raken (meestal tijdens een examen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flounder",
                                "target_lang_sense_clarification": "struggle to answer"
                            },
                            {
                                "target_lang_word": "struggle",
                                "target_lang_sense_clarification": "have difficulty"
                            },
                            {
                                "target_lang_word": "be at sea",
                                "target_lang_sense_clarification": "be confused"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stuntelen",
                                "target_lang_sense_clarification": "onhandig of onzeker antwoorden"
                            },
                            {
                                "target_lang_word": "niet uit zijn woorden komen",
                                "target_lang_sense_clarification": "moeite hebben met antwoorden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}