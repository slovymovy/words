                            },
                            {
                                "target_lang_word": "剧烈",
                                "target_lang_sense_clarification": "形容反应或变化的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7fd918a-9397-3aae-b5e7-54d277592e3f",
                    "sense_definition": "Injustice, wrong.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brief summary does <w>violence</w> to the author's complex argument.",
                            "target_lang_translations": {
                                "ru": "Это краткое изложение грубо <w>искажает</w> сложный аргумент автора.",
                                "zh": "这份简短的摘要严重<w>歪曲</w>了作者复杂的论点。"
                            }
                        },
                        {
                            "text": "Translating poetry often does <w>violence</w> to the original rhythm.",
                            "target_lang_translations": {
                                "ru": "Перевод поэзии часто <w>нарушает</w> оригинальный ритм.",
                                "zh": "翻译诗歌往往会<w>破坏</w>其原有的韵律。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do violence to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искажение смысла, несправедливость или грубое нарушение.",
                        "zh": "对事实、原意或原则的严重歪曲、破坏或不公正对待。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "смысла или фактов"
                            },
                            {
                                "target_lang_word": "надругательство",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "歪曲",
                                "target_lang_sense_clarification": "指对原意或事实的严重扭曲"
                            },
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "指对原则或完整性的损害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
