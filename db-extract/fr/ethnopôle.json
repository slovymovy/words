                        "glosses": [
                            "Centre culturel dédié au patrimoine culturel."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "e648cf95-6c14-4690-a46e-db20b4edc5e1",
                                "sense_id": "1169a665-a70c-301d-8181-923636a09dad",
                                "text": "Les premières recherches en ethnologie du patrimoine, à la suite d’un séminaire de l’ethnopôle Garae en 1997, ont porté sur l’ethnologie des monuments historiques, notamment à partir de l’exemple de la cité de Carcasonne."
                            },
                            {
                                "example_id": "3fec64b9-5a30-4542-b598-8f9988af366a",
                                "sense_id": "1169a665-a70c-301d-8181-923636a09dad",
                                "text": "Afin de contribuer à la constitution d’un réseau et à l’émergence d’un ethnopôle interrégional consacré au patrimoine maritime et lagunaire de la Méditerranée français, de semblables rencontres s’étaient déjà tenues depuis 1990."
                            }
                        ]
                    }
