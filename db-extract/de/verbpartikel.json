                "senses": [
                    {
                        "sense_id": "2c1d4892-d10d-3f44-b241-f237b5188785",
                        "entry_id": "4400fefd-e2cf-3321-967c-856a212b7eb0",
                        "glosses": [
                            "erster abtrennbarer Wortteil eines Verbs, der (zum Beispiel im Hauptsatz) getrennt vom Verbstamm im Satz steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f909608-de79-43bb-8673-f4a97e7521eb",
                                "sense_id": "2c1d4892-d10d-3f44-b241-f237b5188785",
                                "text": "„Präfixe und Verbpartikeln lassen sich als Bestandteile von Stämmen in der Regel identifizieren, Suffixe aber durchaus nicht immer.“"
                            },
                            {
                                "example_id": "e0279c18-1d30-4f92-bf91-6aa2dfb118ee",
                                "sense_id": "2c1d4892-d10d-3f44-b241-f237b5188785",
                                "text": "„Präfixe und Partikeln: Wegen der oft ähnlichen syntaktisch-semantischen Funktion werden zu den Präfixen oft auch die trennbaren Verbpartikeln […] gerechnet, die auch Paraverbien/Praeverbien/präfixartige Bestimmungsglieder/Präfixoide/Verbzusätze genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
