                "senses": [
                    {
                        "sense_id": "d68a9e75-5881-36d6-96e8-7e5c975eb5df",
                        "entry_id": "01703bb8-46d8-3ed6-aa03-cdda32329f9d",
                        "glosses": [
                            "to try to find out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7977a1-771b-4cd4-a376-4339aa54d535",
                                "sense_id": "d68a9e75-5881-36d6-96e8-7e5c975eb5df",
                                "text": "В лю́дях того́ вре́мени (всё-таки в лу́чших) бы́ло в вы́сшей сте́пени ра́звито чу́вство неудовлетворённости окружа́ющей средо́й, но в э́том чу́встве замеча́лось так мно́го сму́тного и беспредме́тного, что мысль, не бу́дучи в состоя́нии определённо наме́тить для себя́ я́сные исхо́дные пу́нкты, не могла́ не то́лько прийти́ к каки́м-либо разреше́ниям, но да́же не чу́вствовала потре́бности и дои́скиваться их.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
                    }
                ],
