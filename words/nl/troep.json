                {
                    "sense_id": "5ab4a64b-0dc1-30db-94bf-32a222020ed8",
                    "sense_definition": "Een militaire eenheid of een verzameling soldaten (vaak in het meervoud gebruikt).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collection_beings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De generaal stuurde zijn <w>troepen</w> naar de grens om het land te verdedigen.",
                            "target_lang_translations": {
                                "ru": "Генерал отправил свои <w>войска</w> к границе для защиты страны.",
                                "en": "The general sent his <w>troops</w> to the border to defend the country.",
                                "pl": "Generał wysłał swoje <w>wojska</w> na granicę, aby bronić kraju.",
                                "de": "Der General schickte seine <w>Truppen</w> an die Grenze, um das Land zu verteidigen.",
                                "fr": "Le général a envoyé ses <w>troupes</w> à la frontière pour défendre le pays.",
                                "it": "Il generale ha inviato le sue <w>truppe</w> al confine per difendere il paese.",
                                "cs": "Generál poslal svá <w>vojska</w> k hranicím, aby bránila zemi.",
                                "tr": "General, ülkeyi savunmak için <w>birliklerini</w> sınıra gönderdi.",
                                "es": "El general envió a sus <w>tropas</w> a la frontera para defender el país.",
                                "zh": "将军派他的<w>部队</w>前往边境保卫国家。"
                            }
                        },
                        {
                            "text": "De vijandelijke <w>troepen</w> trokken zich na twee weken terug.",
                            "target_lang_translations": {
                                "ru": "Вражеские <w>войска</w> отступили через две недели.",
                                "en": "The enemy <w>troops</w> withdrew after two weeks.",
                                "pl": "Wrogie <w>wojska</w> wycofały się po dwóch tygodniach.",
                                "de": "Die feindlichen <w>Truppen</w> zogen sich nach zwei Wochen zurück.",
                                "fr": "Les <w>troupes</w> ennemies se sont retirées après deux semaines.",
                                "it": "Le <w>truppe</w> nemiche si sono ritirate dopo due settimane.",
                                "cs": "Nepřátelská <w>vojska</w> se po dvou týdnech stáhla.",
