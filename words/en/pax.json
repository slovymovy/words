        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4b925849-df66-3b26-a660-a979b9036e09",
                    "sense_definition": "Used as a call for a truce or pause in children's games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Pax</w>!\" shouted the boy when he twisted his ankle during tag.",
                            "target_lang_translations": {
