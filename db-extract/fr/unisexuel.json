                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60fc02dd-b80a-38d1-892b-8bc04ff7dc02",
                                        "entry_id": "6673c87f-4fee-3f64-a6d5-9890a3613541",
                                        "glosses": [
                                            "lediglich ein Geschlecht femininer oder maskuliner Art aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3e310d-61e4-4630-af25-04c0ef2ec5b0",
                                                "sense_id": "60fc02dd-b80a-38d1-892b-8bc04ff7dc02",
                                                "text": "„Die eher unscheinbaren Palmblüten sind staminokarpellat oder eingeschlechtig (ein- oder zweihäusig verteilt) und werden in der Regel vom Wind (Anemogamie), gelegentlich aber auch von Insekten (Entomogamie) bestäubt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
