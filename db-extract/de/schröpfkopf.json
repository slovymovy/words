                    {
                        "translation_id": "932b1596-a993-464d-8546-f0481012decc",
                        "source_entry_id": "d505b91b-fb75-378c-a61c-1d7c62be6e64",
                        "source_sense_id": "28908596-cecb-3578-92fc-2adf2b64130d",
                        "source_sense_description": "Medizin: Saugglocke zum örtlichen Ansaugen von Blut in die Haut über erkrankten Organen (Hämospasie)",
                        "target_lang_word": "ventouse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                        "entry_id": "2e4f44ff-db8b-31b3-a09c-bf511fb484d1",
                                        "glosses": [
                                            "Sorte de petite cloche de verre, qu’on applique sur la peau et dans l’intérieur de laquelle on raréfie l’air au moyen de la chaleur ou par un procédé mécanique, afin de soulever la peau et de produire une révulsion locale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093e04d1-18f3-43a4-906f-5a93f62546ab",
                                                "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                                "text": "Dans les maladies où il faut sur-le-champ une évacuation sanguine avec forte dérivation et prompte révulsion , les ventouses scarifiées souvent l'emportent sur les sangsues : […]."
                                            },
                                            {
                                                "example_id": "9fa50d63-2a8b-4af8-9ad3-4e569dec35b4",
                                                "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                                "text": "On me posait des ventouses, mon frère tendait la lampe à essence (nous n’avions pas de table où la placer) et ma mère y enflammait les flocons d’ouate."
                                            },
                                            {
                                                "example_id": "70e9958f-b4cc-46d4-ba83-7fe4471a87f2",
                                                "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                                "text": "Moins l'habit et la cornette, c'est une sœur de la charité qui pose des ventouses, des cataplasmes, applique des sinapismes, masse les rhumatisants, ensevelit les morts."
                                            },
                                            {
                                                "example_id": "eb57d30d-1a81-463e-a17b-70ba24f5bf3f",
                                                "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                                "text": "Ventouse sèche, celle qu’on applique sans faire ensuite de scarification."
                                            },
                                            {
                                                "example_id": "7e3d94ae-e2e6-4297-b869-d0c1373536ff",
                                                "sense_id": "8b58a278-f1a0-328d-813e-43e636078814",
                                                "text": "Ventouse scarifiée, celle qu’on applique en scarifiant ensuite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16254b16-5335-383f-b3fe-ca3bef67fcc1",
                                        "entry_id": "2e4f44ff-db8b-31b3-a09c-bf511fb484d1",
                                        "glosses": [
                                            "Organes dont quelques animaux aquatiques sont pourvus, et à l’aide desquels ils s’attachent aux différents corps, ou sucent, en faisant le vide."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4797e075-f085-4490-abde-2189d036e325",
                                                "sense_id": "16254b16-5335-383f-b3fe-ca3bef67fcc1",
                                                "text": "La sangsue a des ventouses."
                                            },
                                            {
                                                "example_id": "da3db956-045f-41e7-a705-435796a5a22e",
                                                "sense_id": "16254b16-5335-383f-b3fe-ca3bef67fcc1",
                                                "text": "Le ténia dit armé a des ventouses."
                                            },
                                            {
                                                "example_id": "4c44dc83-be0d-4d6b-9cdb-7798b04abfd0",
                                                "sense_id": "16254b16-5335-383f-b3fe-ca3bef67fcc1",
                                                "text": "il y a cinquante pustules par antenne, et toute la bête en a quatre cents. Ces pustules sont des ventouses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e86b0be-34b0-329d-afd4-ed9e800e75e3",
                                        "entry_id": "2e4f44ff-db8b-31b3-a09c-bf511fb484d1",
                                        "glosses": [
                                            "Dont la forme évoque une ventouse."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c99260c6-0467-4d3a-ba56-539c8835d678",
                                                "sense_id": "4e86b0be-34b0-329d-afd4-ed9e800e75e3",
                                                "text": "La femme étalait une hideur provocante. Je la voyais passer un seau à la main, les oreilles décollées, le front fuyant, le nez écrasé, la bouche avancée en ventouse, au sommet du crâne une torsade de cheveux jaunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a7b63b-5f61-366a-a7f4-add5608e9233",
                                        "entry_id": "2e4f44ff-db8b-31b3-a09c-bf511fb484d1",
                                        "glosses": [
                                            "Coupelle élastique et hermétique, que la pression atmosphérique permet de faire adhérer à des surfaces planes et lisses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0adffbd-3243-39cf-b794-521e70ad8141",
                                        "entry_id": "2e4f44ff-db8b-31b3-a09c-bf511fb484d1",
                                        "glosses": [
                                            "Un outil à main dont le manche tient à son extrémité une membrane en forme de cloche, conçu pour déboucher le drain d’une cuvette, que l’on actionne en tirant sur l’outil dont l’embout recouvre la bouche du drain immergée dans le liquide, pour créer une dépression et ainsi faire reculer l’obstacle de son logement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa561ab1-e553-4a98-b67d-8f42266b895a",
                                                "sense_id": "d0adffbd-3243-39cf-b794-521e70ad8141",
                                                "text": "La ventouse permet de déboucher les WC sans utiliser de produit coûteux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ventouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70f51e87-1051-34d7-8b06-5e12efd81aba",
                                        "entry_id": "d09c941e-5c74-3a04-bd24-9e50f71c1aaa",
                                        "glosses": [
                                            "Ouverture, pratiquée dans un conduit, dans une fosse, etc., pour donner passage à l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41780e8b-b416-4d7f-b12f-2c6d0c874849",
