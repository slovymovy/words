{
    "word_family": [
        "filamentous",
        "filamentary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84ce7cbb-4f5a-3213-8c82-6bc1bebbe664",
                    "sense_definition": "A fine, thin thread or wire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thread_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spider spun a delicate <w>filament</w> of silk to catch its prey.",
                            "target_lang_translations": {
                                "ru": "Паук сплел тонкую шелковую <w>нить</w>, чтобы поймать свою добычу."
                            }
                        },
                        {
                            "text": "She carefully examined the thin <w>filament</w> under the microscope.",
                            "target_lang_translations": {
                                "ru": "Она внимательно изучила тонкое <w>волокно</w> под микроскопом."
                            }
                        }
                    ],
                    "synonyms": [
                        "thread",
                        "strand",
                        "fiber"
                    ],
                    "common_phrases": [
                        "thin filament",
                        "delicate filament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая нить, волокно или проволока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "тонкий протяженный объект"
                            },
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "тонкая непряденая нить"
                            },
                            {
                                "target_lang_word": "волосок",
                                "target_lang_sense_clarification": "очень тонкая нить или проволока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfcbeca7-1ef9-3c74-9f0b-4b87be2809d1",
                    "sense_definition": "A thin wire in an incandescent light bulb or thermionic valve that heats up and glows to produce light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electrical_component",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The light bulb burned out because the tungsten <w>filament</w> snapped.",
                            "target_lang_translations": {
                                "ru": "Лампочка перегорела, потому что вольфрамовая <w>нить накала</w> оборвалась."
                            }
                        },
                        {
                            "text": "You can see the glowing <w>filament</w> inside the vintage glass bulb.",
                            "target_lang_translations": {
                                "ru": "Внутри винтажной стеклянной колбы виден светящийся <w>волосок</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tungsten filament",
                        "bulb filament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая металлическая проволока в лампе накаливания или вакуумной трубке, которая нагревается и светится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить накала",
                                "target_lang_sense_clarification": "в электрической лампе"
                            },
                            {
                                "target_lang_word": "нить накаливания",
                                "target_lang_sense_clarification": "в электрической лампе"
                            },
                            {
                                "target_lang_word": "волосок",
                                "target_lang_sense_clarification": "тонкая проволока в лампе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87265456-9d12-3f54-a16a-55597ec6949f",
                    "sense_definition": "A continuous plastic thread used as the raw material in 3D printing, typically wound on a spool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manufacturing_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new spool of PLA <w>filament</w> for his 3D printer.",
                            "target_lang_translations": {
                                "ru": "Он купил новую катушку PLA-<w>пластика</w> для своего 3D-принтера."
                            }
                        },
                        {
                            "text": "Make sure the <w>filament</w> is feeding smoothly into the extruder.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>филамент</w> плавно подается в экструдер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "printer filament",
                        "plastic filament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывная пластиковая нить, используемая в качестве расходного материала для 3D-печати."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "филамент",
                                "target_lang_sense_clarification": "пластик для 3D-принтера"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "пластиковая нить для 3D-печати"
                            },
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "синтетический материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "600f1b7d-d38d-39e8-9b81-e056b9fb7487",
                    "sense_definition": "The slender stalk of a flower stamen that supports the pollen-bearing anther.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In botany class, we learned that the stamen consists of an anther and a <w>filament</w>.",
                            "target_lang_translations": {
                                "ru": "На уроке ботаники мы узнали, что тычинка состоит из пыльника и <w>тычиночной нити</w>."
                            }
                        },
                        {
                            "text": "The long <w>filament</w> of the lily flower holds the pollen high up.",
                            "target_lang_translations": {
                                "ru": "Длинная <w>тычиночная нить</w> цветка лилии удерживает пыльцу высоко."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stamen filament"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая ножка тычинки цветка, поддерживающая пыльник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычиночная нить",
                                "target_lang_sense_clarification": "в ботанике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0302cba9-948b-399e-8e29-edb91c97fbd5",
                    "sense_definition": "A massive, thread-like structure in space, such as a stream of gas on the sun or a vast chain of galaxies.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers observed a massive solar <w>filament</w> erupting from the sun's surface.",
                            "target_lang_translations": {
                                "ru": "Астрономы наблюдали, как массивный солнечный <w>протуберанец</w> вырвался с поверхности Солнца."
                            }
                        },
                        {
                            "text": "Our galaxy belongs to a vast cosmic <w>filament</w> stretching across millions of light-years.",
                            "target_lang_translations": {
                                "ru": "Наша галактика принадлежит к огромному космическому <w>волокну</w>, простирающемуся на миллионы световых лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solar filament",
                        "galaxy filament"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific astronomical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Массивная нитевидная структура в космосе, например, поток газа на Солнце или цепочка галактик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "филамент",
                                "target_lang_sense_clarification": "космический или солнечный протуберанец/нить"
                            },
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "космическая нитевидная структура"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "солнечная или галактическая нить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}