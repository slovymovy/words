            {
                "entry_id": "11fbf505-ff5c-3572-82b9-0c871afa67f3",
                "word": "tolérablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                        "entry_id": "11fbf505-ff5c-3572-82b9-0c871afa67f3",
                        "glosses": [
                            "D’une manière tolérable, supportable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b064a2ff-a72b-4d07-9c38-f80936a5d4f1",
                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                "text": "Un homme qui avait quelque sens et qui raisonnait tolérablement sur d’autres sujets."
                            },
                            {
                                "example_id": "2094dc42-9c18-4224-b657-93519d7412b8",
                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                "text": "Êtes-vous tolérablement ici ? Veuillez vous rappeler que vous êtes chez les barbares. Il ne faut pas être difficile en Samogitie."
                            },
                            {
                                "example_id": "af215707-a0cb-47c5-874e-d3884cc2009f",
                                "sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                                "text": "S’ils [les architectes] construisent un Musée, pensez qu’ils n’oublieront qu’une chose, c’est d’éclairer tolérablement les tableaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c3796d6-c478-4233-88a1-bd6d55b92fe4",
                        "source_entry_id": "11fbf505-ff5c-3572-82b9-0c871afa67f3",
                        "source_sense_id": "b5b05959-7f83-3301-8a9f-d364ef9605c9",
                        "target_lang_word": "tolerably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tolerably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb5d3414-e241-337b-81f9-7f09d37eeeb1",
                                        "entry_id": "674df672-7891-3b25-a3af-e0c9f2afd34e",
                                        "glosses": [
                                            "In a tolerable manner; to an extent that can be tolerated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3c7ad6-5505-409a-b707-fd7d640e38ea",
                                                "sense_id": "fb5d3414-e241-337b-81f9-7f09d37eeeb1",
                                                "text": "I don't like the music, but it's tolerably quiet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff2f48f-9d10-3053-8c5d-5329f2004b36",
                                        "entry_id": "674df672-7891-3b25-a3af-e0c9f2afd34e",
                                        "glosses": [
                                            "Reasonably; acceptably; somewhat."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0840322-053e-46a6-ab78-06e9dac5a237",
                                                "sense_id": "aff2f48f-9d10-3053-8c5d-5329f2004b36",
                                                "text": "With a small knife or larding pin, cut holes in the beef, to receive the bacon thus prepared; place the lardings tolerably thick and even; rub the beef over with the remainder of the seasoning […]"
                                            },
                                            {
                                                "example_id": "f2554651-1ab8-43fa-ac95-dffa12f80b83",
                                                "sense_id": "aff2f48f-9d10-3053-8c5d-5329f2004b36",
                                                "text": "At least, he may claim that we should bring to him a tolerably patient and receptive mind, not a repelling, refusive mind; in a word, that we should treat him with decency, if we profess to attend to him at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
