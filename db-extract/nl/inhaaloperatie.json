                        "examples": [
                            {
                                "example_id": "76b03bae-7b94-41b5-beaa-1722d0c8c9ef",
                                "sense_id": "8d1fefc8-4275-30ee-8e90-430f7a9d5e53",
                                "text": "Het Isala-ziekenhuis in Zwolle heeft twintig patiënten die op de wachtlijst stonden voor een inhaaloperatie zaterdag afgebeld. Vanwege de toestroom van covid-patiënten in combinatie met een toename van acute zorg en verloskunde, kon hun afspraak niet doorgaan. Dat bevestigt een woordvoerder van het ziekenhuis na berichtgeving van de Stentor."
                            }
