    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5a2124d9-a968-3635-8f02-108e35b242b7",
                "word": "soreness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1f1e7595-3199-4abc-86fa-564e7f5c15ff",
                        "entry_id": "5a2124d9-a968-3635-8f02-108e35b242b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "sorenesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7aab15ba-7645-32a9-aa8c-5a5d9210d8e0",
                        "entry_id": "5a2124d9-a968-3635-8f02-108e35b242b7",
                        "glosses": [
                            "The property, state, or condition of being sore; painfulness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "158b6da8-75ad-42a3-9d1f-f64e7b72ee82",
                                "sense_id": "7aab15ba-7645-32a9-aa8c-5a5d9210d8e0",
                                "text": "The salve made the soreness go away, but with the aches gone I suddenly noticed my other pains."
                            },
                            {
                                "example_id": "72c9feaf-0cb0-418f-bdd1-fbba9e181308",
                                "sense_id": "7aab15ba-7645-32a9-aa8c-5a5d9210d8e0",
                                "text": "Juvenile rheumatoid arthritis (JRA), often referred to by doctors today as juvenile idiopathic arthritis (JIA), is a type of arthritis that causes joint inflammation and stiffness for more than six weeks in a child aged 16 or younger. It affects approximately 50,000 children in the United States. Inflammation causes redness, swelling, warmth, and soreness in the joints, although many children with JRA do not complain of joint pain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b2dd4d4-82d0-4cc6-86ce-1a4352ca0d34",
                        "source_entry_id": "5a2124d9-a968-3635-8f02-108e35b242b7",
                        "source_sense_id": "7aab15ba-7645-32a9-aa8c-5a5d9210d8e0",
                        "source_sense_description": "being sore",
                        "target_lang_word": "Schmerz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmerz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                        "entry_id": "596f5f34-b33c-3600-ba03-175ea94811f6",
                                        "glosses": [
                                            "unangenehme Sinneswahrnehmung, die aufgrund einer äußeren Verletzung auftritt (physiologischer Schmerz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8c86ea-fea5-4185-bf66-7ea58f0a0c90",
                                                "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                                "text": "Der Täter fügte seinem Opfer mit einem Stock erhebliche Schmerzen zu."
                                            },
                                            {
                                                "example_id": "97dfd7f0-0d5b-4f84-ba8a-fb149ebb4c5c",
                                                "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                                "text": "„Aber der Schmerz wurde immer stärker.“"
                                            },
                                            {
                                                "example_id": "24cb7a8e-7ed1-417f-93c8-47a82637244c",
                                                "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                                "text": "„Sie hatte häufig Kopfweh, war müde und lustlos, bekam heftige Schmerzen im Rücken, in Fingern, Händen, Muskeln und Gelenken, die sich sehr oft wiederholten.“"
                                            },
                                            {
                                                "example_id": "efafea8c-726e-4777-817e-cc826cef4c24",
                                                "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                                "text": "„Nachsichtig und geduldig klärte er sie auf, daß sie eben noch ›ungebrochene Melone‹ sei, daß bei ihr zunächst ein gewisses Verschlußhäutchen durchstoßen werden müsse, daß das naturgemäß mit Schmerz und Blutung verbunden sei, und daß sie erst nach zehnmaligem Probieren wirklich Genuß und Behagen spüren werde.“"
                                            },
                                            {
                                                "example_id": "65a68169-9595-4d2d-aeda-1ba4b6c64d24",
                                                "sense_id": "677c963f-ff3e-3483-bb4c-056a533c154c",
                                                "text": "„Die Schmerzen im Arm wurden immer quälender.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91a5e60b-e2ad-3b4b-9311-288e384ef756",
                                        "entry_id": "596f5f34-b33c-3600-ba03-175ea94811f6",
                                        "glosses": [
                                            "unangenehme Sinneswahrnehmung, die aufgrund einer seelischen Verletzung auftritt (psychischer Schmerz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699213dc-0c0b-4521-9860-bc33f211aa29",
                                                "sense_id": "91a5e60b-e2ad-3b4b-9311-288e384ef756",
                                                "text": "Durch unablässiges Piesacken erfuhr sie starke seelische Schmerzen."
                                            },
                                            {
                                                "example_id": "4c424b23-0c8c-4851-8717-83eb2da24d81",
                                                "sense_id": "91a5e60b-e2ad-3b4b-9311-288e384ef756",
                                                "text": "„Der Schmerz in ihrer Seele hätte sie umgebracht, wäre nicht ein Teil davon in ihre Brüste geflossen.“"
                                            },
                                            {
                                                "example_id": "d8f52171-e666-4113-b6fc-c0ff7408bdef",
                                                "sense_id": "91a5e60b-e2ad-3b4b-9311-288e384ef756",
                                                "text": "„Ein Gefühl von Wehmut und Freude, von bangem Schmerze und froher Sehnsucht trieb ihn vorwärts zum Lande seiner Kindheit, seiner Mannbarkeit, dem er den Rücken zu wenden gezwungen worden war, das ihn verstoßen hatte.“"
                                            },
                                            {
                                                "example_id": "1b364b9b-aa85-4f19-840f-b27fb194a441",
                                                "sense_id": "91a5e60b-e2ad-3b4b-9311-288e384ef756",
                                                "text": "„Der alte Mann preßte seine Hände vor die Stirn und sank in stummem Schmerz auf sein Lager zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
