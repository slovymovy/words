                ],
                "senses": [
                    {
                        "sense_id": "aef09ec7-4a0e-3032-9a31-4c9a2352da84",
                        "entry_id": "43ad9d69-0e6b-3100-b4d0-04763d0b373d",
                        "glosses": [
                            "Roche métamorphique composée de mica et de quartz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85a8a46-17a8-4002-8909-3eede653cb17",
                                "sense_id": "aef09ec7-4a0e-3032-9a31-4c9a2352da84",
                                "text": "Lorsque dans un terrain siliceux avec un sous-sol de micaschiste qui ne produit presque rien, on élève une race de petits chevaux, que faut-il faire pour leur donner plus de taille, des formes plus régulières […]."
                            },
                            {
                                "example_id": "ca6cad94-9bcd-4ffc-9173-79726cee3679",
                                "sense_id": "aef09ec7-4a0e-3032-9a31-4c9a2352da84",
                                "text": "Ces roches, de séquence paramétamorphique, de couleur sombre, sont essentiellement représentées par des micaschistes, des phyllades, des quartzophyllades et des quartzites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59542f77-8699-41da-8bdb-e820abf91bad",
                        "source_entry_id": "43ad9d69-0e6b-3100-b4d0-04763d0b373d",
                        "source_sense_id": "aef09ec7-4a0e-3032-9a31-4c9a2352da84",
                        "target_lang_word": "Glimmerschiefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glimmerschiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                        "entry_id": "6ef6e919-1740-3e9e-a836-4c4fc67d1afc",
                                        "glosses": [
                                            "metamorphes Gestein mit schiefriger Struktur und Glimmer und Quarz als den wesentlichen Bestandteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d718eccb-6636-4aac-8f34-6e9da406aa81",
                                                "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                                "text": "„Geringerer Gehalt an Feldspat bei gleichzeitiger Zunahme des Glimmers und der schieferigen Struktur zeichnet die Glimmerschiefer aus.“"
                                            },
                                            {
                                                "example_id": "ff472742-7a91-45e6-9dca-cb1424f13168",
                                                "sense_id": "07fafebd-9a65-3db7-9a3a-01aeff68a719",
                                                "text": "„Der Turmalin, der in Prismen von oft makroskopischer Sichtbarkeit in allen Glimmerschiefern auftritt, ist ein sehr kompliziert zusammengesetztes Tonerde‑Borsäuresilikat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
