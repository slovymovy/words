                    {
                        "sense_id": "756b62e3-884b-326c-9188-b42638fc0e0d",
                        "entry_id": "90e09896-0a35-33f7-ba21-1c6f65d31249",
                        "glosses": [
                            "Joueur de cornemuse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8ac1f0fa-9031-47d7-829d-101de68d304a",
                                "sense_id": "756b62e3-884b-326c-9188-b42638fc0e0d",
                                "text": "[…] il resta impitoyable et féroce et faillit même faire arriver à son maître une sale histoire pour avoir déchiré, en même temps que les bandes molletières, un peu de la viande d’un gentilhomme cornemuseux […]"
                            },
                            {
                                "example_id": "cb09c47f-64fc-47e4-a6f4-26ce7f7a8544",
                                "sense_id": "756b62e3-884b-326c-9188-b42638fc0e0d",
                                "text": "Eh bien, lui dis-je, c’est quelque cornemuseux qui revient d’une noce du côté de la Berthenoux ? — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 42)"
                            }
                        ]
                    }
                ],
