                        "entry_id": "a6d6a75c-5ffb-31d5-b285-1163d9ab957a",
                        "glosses": [
                            "Turning sour; readily becoming tart or acid; slightly sour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb593c21-8bad-47dd-8a73-c163f3778961",
                                "sense_id": "021b933b-4f7b-3754-afda-fecca5102b4a",
                                "text": "The fluid was a pale yellow , thick , creamy - looking substance , of uniform consistency . It had a disagreeable acescent odour, something resembling that of putrecsent milk."
                            },
                            {
                                "example_id": "7bd5c255-6aad-4b21-ad87-70c386a694b6",
                                "sense_id": "021b933b-4f7b-3754-afda-fecca5102b4a",
                                "text": "All kinds of malt liquor contain […] alcohol or spirit. They are of course weaker than wines, and in general more liable to become flat and acescent from this circumstance […]"
                            }
                        ]
                    }
                ],
