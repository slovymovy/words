                ],
                "senses": [
                    {
                        "sense_id": "fca5b3a2-9553-33e9-ac1a-d39c143c65e8",
                        "entry_id": "976b209c-2f59-3ff2-b820-f8f331efb741",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße vornehmes Verhalten zeigt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6b8c45-4441-4490-b9fc-ccbdbae095ef",
                                "sense_id": "fca5b3a2-9553-33e9-ac1a-d39c143c65e8",
                                "text": "„Ich liebe namlich eine gewisse Notabilität des Geistes und hege einen gründlichen Abscheu gegen jede Plebejität in jeder wissenschaftlichen Sphäre und besonders auch in politischen Dingen.“ (1847)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df36659e-d925-302c-8fdc-2f54c3b27962",
                        "entry_id": "976b209c-2f59-3ff2-b820-f8f331efb741",
                        "glosses": [
                            "bekannte, berühmte, vornehme, respektable Person/Persönlichkeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "343766a0-4cbf-428b-a762-8d8e11ca6b99",
                                "sense_id": "df36659e-d925-302c-8fdc-2f54c3b27962",
                                "text": "„Sie werfen mir ferner vor, ich habe eine „politische Notabilität sein wollen.“ Wenn ich recht verstehe, so ist Derjenige eine politische Notabilität, der öffentlich dafür gilt, daß er in irgend einem Fache des Staatswesens Wichtiges leiste.“ (1841)"
                            },
                            {
                                "example_id": "f8c92541-9149-4d6c-91ce-b4b426ae14c5",
                                "sense_id": "df36659e-d925-302c-8fdc-2f54c3b27962",
                                "text": "„Will man überhaupt Heine nur freundlich und wohlgefällig abgespiegelt sehen, so muß man sich an die Notabilitäten der Franzosen, unter denen er fünfzehn Jahre gelebt, wenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
