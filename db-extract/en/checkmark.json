                            {
                                "example_id": "8081ccb8-065b-4477-915e-196e07894188",
                                "sense_id": "53b8c8e5-2525-3c22-bf70-75e2dbe09757",
                                "text": "Put a checkmark in the box corresponding to the correct answer."
                            },
                            {
                                "example_id": "64744e76-07f1-42b6-b911-89a5788d89d4",
                                "sense_id": "53b8c8e5-2525-3c22-bf70-75e2dbe09757",
                                "text": "But when records of bad decisions find their way into the spotlight, it is seemingly impossible to keep the pitchfork-wielding blue checkmarks at bay."
                            },
                            {
                                "example_id": "b25d5df2-21cc-4663-a86c-da5a549fbeb1",
                                "sense_id": "53b8c8e5-2525-3c22-bf70-75e2dbe09757",
                                "text": "While economists generally say that a W remains entirely possible, they aren’t willing to make it their most-likely forecast because it hinges on two total unknowns: whether there is another spike in infections, and whether states will shut down again if that happens. Analysts who venture a guess increasingly favor a nonletter shape as their base-case: the checkmark."
                            }
                        ]
                    }
