                                "target_senses": [
                                    {
                                        "sense_id": "e8c37808-7680-3e9a-82e1-828f68b49c92",
                                        "entry_id": "2d5e9b2f-c1d6-3441-be04-9146acd1d6f3",
                                        "glosses": [
                                            "piacevolezza e cortesia nel parlare e nel trattare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5654c8e5-a66e-4200-b233-e4949eedcf88",
                                                "sense_id": "e8c37808-7680-3e9a-82e1-828f68b49c92",
                                                "text": "La sua affabilità è proverbiale"
