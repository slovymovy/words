                    "sense_definition": "Faire retrouver à quelqu'un un sentiment, un état ou une faculté qu'il avait perdus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rétablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bonne nouvelle a réussi à lui <w>redonner</w> espoir après une période sombre.",
                            "target_lang_translations": {
                                "en": "This good news managed to <w>revive</w> their hope after a dark period.",
                                "ru": "Эта хорошая новость сумела <w>вернуть</w> ему надежду после тяжёлого периода.",
                                "de": "Diese gute Nachricht hat ihm nach einer düsteren Zeit die Hoffnung <w>wiedergegeben</w>.",
                                "es": "Esta buena noticia le <w>devolvió</w> la esperanza tras una época oscura.",
                                "zh": "这个好消息在他度过一段黑暗时期之后，又<w>唤回</w>了他的希望。"
                            }
                        },
                        {
                            "text": "Cette petite promenade matinale lui a enfin <w>redonné</w> le sourire.",
                            "target_lang_translations": {
                                "en": "This short morning walk finally <w>brought</w> their smile <w>back</w>.",
                                "ru": "Эта короткая утренняя прогулка наконец <w>вернула</w> ему улыбку.",
                                "de": "Dieser kurze Morgenspaziergang hat ihm endlich wieder das Lächeln <w>zurückgegeben</w>.",
                                "es": "Este pequeño paseo matutino por fin le <w>devolvió</w> la sonrisa.",
                                "zh": "这次短暂的清晨散步终于又<w>唤回</w>了他的笑容。"
                            }
                        }
