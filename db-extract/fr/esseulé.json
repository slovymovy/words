                        "entry_id": "a5c84cb2-5172-327c-89a0-34d1079fcc69",
                        "glosses": [
                            "Personne qui se retrouve seule, délaissée, mise à l’écart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8a23d3-5670-4cf8-a2a5-443e779e2902",
                                "sense_id": "81bca4b3-c9ea-3466-be45-4ee77e91dd43",
                                "text": "La paix ! Ce n’est pas en vivant en reclus que tu la trouveras, la paix. Car tu es un reclus, pas un ermite. Un esseulé, pas un solitaire."
                            }
                        ]
                    }
