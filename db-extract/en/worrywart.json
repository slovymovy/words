                        "entry_id": "12a49044-cbc1-3012-a899-5ff5edfd8030",
                        "glosses": [
                            "A person who worries excessively, especially about unimportant matters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86445946-1a1c-45fe-ba24-c75662556f1b",
                                "sense_id": "14a409c5-39c2-3449-8406-d4241f15cee3",
                                "text": "It doesn't mean you're a worrywart, a nervous wreck or in need of heavy medication."
                            },
                            {
                                "example_id": "7c798aff-f553-462e-8b5e-00b28312063e",
                                "sense_id": "14a409c5-39c2-3449-8406-d4241f15cee3",
                                "text": "On vacation, I'm a worrywart for fretting about third-degree burns and puncture wounds."
                            },
                            {
                                "example_id": "50379fb3-3de7-4e95-b33f-98023d653a37",
                                "sense_id": "14a409c5-39c2-3449-8406-d4241f15cee3",
                                "text": "When Biden takes the presidential oath in January, many will write articles scolding those who expressed concern about a coup as worrywarts, or as people misusing terminology."
                            }
                        ]
                    }
                ],
