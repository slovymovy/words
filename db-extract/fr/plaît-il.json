                    {
                        "translation_id": "35bcb1d8-e7c6-4c04-81bd-ed682782ed80",
                        "source_entry_id": "0bf07a20-1057-3203-8202-643972701650",
                        "source_sense_id": "9dfa33b6-2ab7-3107-8228-e5b9607399f0",
                        "target_lang_word": "I beg your pardon",
