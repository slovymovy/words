                "senses": [
                    {
                        "sense_id": "b46cb0d7-65ff-3547-805c-0e1a81c408ce",
                        "entry_id": "5fb633d5-c7c1-36a1-b408-890c3c2e7d2b",
                        "glosses": [
                            "Faire perdre son caractère complotiste ou lié aux complots à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68812055-18af-45da-ba5c-31bf8df1874b",
                                "sense_id": "b46cb0d7-65ff-3547-805c-0e1a81c408ce",
                                "text": "Rajeunir, dépoussiérer, \"décomploter\" le système en reprenant la main sur l'institution municipale par les citoyens, pour les citoyens..."
                            },
                            {
                                "example_id": "f65e49d3-fe13-4059-a1b6-1dbf8fbad16e",
                                "sense_id": "b46cb0d7-65ff-3547-805c-0e1a81c408ce",
                                "text": "Je dévoile, j'accuse, je décomplote les complots !"
                            },
                            {
                                "example_id": "f68eadb0-94b4-4a06-b397-b569a90c89d3",
                                "sense_id": "b46cb0d7-65ff-3547-805c-0e1a81c408ce",
                                "text": "Puis Chadli a décomploté Boumediène, Boudiaf a été victime d'un complot, Zeroual a démissionné en criant au complot et Bouteflika a comploté contre tous les complots."
                            },
                            {
                                "example_id": "dc225538-0622-4365-ba2c-063a4fd79e54",
                                "sense_id": "b46cb0d7-65ff-3547-805c-0e1a81c408ce",
                                "text": "Pour te \"décomploter\" tu trouveras des explications dans divers articles parus dans la presse."
                            }
                        ]
                    }
