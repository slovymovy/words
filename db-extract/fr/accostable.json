                "senses": [
                    {
                        "sense_id": "0d54aaba-83b5-33c2-ac32-1deaa41d1cbf",
                        "entry_id": "b6012607-7bc6-33c4-9c8a-9b10fa9295d0",
                        "glosses": [
                            "Qui est d’un abord facile, en parlant d’une personne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4f33e151-ffcc-4079-a27e-d7e797c899f3",
                                "sense_id": "0d54aaba-83b5-33c2-ac32-1deaa41d1cbf",
                                "text": "Maximilien estoit le plus accostable des hommes ; & le Serrurier avoit eu moins de peine à l’aborder, & à l’entretenir du projet qu’il avoit formé, qu’à le convaincre qu’il pust réüssir …."
                            },
                            {
                                "example_id": "cb7ed00b-8c01-4e65-8c61-2c8352408325",
                                "sense_id": "0d54aaba-83b5-33c2-ac32-1deaa41d1cbf",
                                "text": "Trajan étant censuré par ses confidents, de quoi il rendait, à leur avis, la majesté impériale trop accostable : « Oui-dà, dit-il, ne dois-je pas être tel empereur à l’endroit des particuliers, que je désirerais rencontrer un empereur, si j’étais particulier moi-même »"
                            }
                        ]
                    },
                    {
                        "sense_id": "28d22626-bf1e-350f-8505-661a3a0a3bd7",
                        "entry_id": "b6012607-7bc6-33c4-9c8a-9b10fa9295d0",
                        "glosses": [
                            "Qui est facile à accoster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790fd99c-2cfa-4ebb-8a04-2e9f5792134b",
                                "sense_id": "28d22626-bf1e-350f-8505-661a3a0a3bd7",
                                "text": "Seul hic, l'île n'est pas accostable en cas de forte houle."
                            },
                            {
                                "example_id": "fef01062-ee75-493e-aa8d-74ad116b03b2",
                                "sense_id": "28d22626-bf1e-350f-8505-661a3a0a3bd7",
                                "text": "La fiche de présentation de ce port en fait le plus important du pays : « l’infrastructure dont les travaux ont commencé en 2016 comptera un port militaire à quai accostable des deux bords, une base navale, un port de pêche d’une capacité de sept quais de débarquement, un chantier naval d’une capacité de 70 navires par an, un quai de commerce pouvant recevoir plusieurs bateaux de 180 mètres de long et un pont de débarquement pour la pêche artisanale. »"
                            }
                        ]
                    }
