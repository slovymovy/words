                                "example_id": "7a4f99cc-c95d-489b-8753-47f10406f5a1",
                                "sense_id": "823503c6-4b76-301a-be84-7bd208acc1f2",
                                "text": "„Bodenbearbeitung und Pestizideinsatz reduzieren die Anzahl in Ackerböden sehr stark.“"
