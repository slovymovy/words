                "senses": [
                    {
                        "sense_id": "b3e9e321-d5d8-3105-8ea6-d91c842a5b74",
                        "entry_id": "899059dd-3676-3770-9f70-c0f2abcc235c",
                        "glosses": [
                            "Donner un caractère indigène à ; traiter comme un indigène."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d59ac16-ae76-4f10-82a9-b90adecc2961",
                                "sense_id": "b3e9e321-d5d8-3105-8ea6-d91c842a5b74",
                                "text": "Il s'agit moins d’indigéniser le lien social et l’institution de celui-ci que de débuter un processus de délégation de pouvoir."
                            },
                            {
                                "example_id": "fdfd68f5-5f9e-4a2a-a1a6-4fc5e1ed21eb",
                                "sense_id": "b3e9e321-d5d8-3105-8ea6-d91c842a5b74",
                                "text": "Les uns et les autres sont souvent parasités par les préjugés de leurs extrêmes, qui semblent s’être donné le mot tantôt pour « indigéniser » tantôt pour « raciser » la question sociale."
                            }
                        ]
                    },
                    {
                        "sense_id": "122570b7-80dc-3f1a-ad14-c3de5cecb731",
                        "entry_id": "899059dd-3676-3770-9f70-c0f2abcc235c",
                        "glosses": [
                            "Devenir indigène, prendre un caractère indigène."
                        ],
