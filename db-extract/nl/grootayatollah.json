                        "examples": [
                            {
                                "example_id": "8760a705-99a8-4746-b0f6-e13eecb8ed58",
                                "sense_id": "e3da4d86-0798-309c-ac3e-e80ed2049b34",
                                "text": "In Irak keren steeds meer mensen zich van Maliki af, ook al won zijn partij de verkiezingen in het voorjaar. De hoogste sjiitische geestelijke in het land, grootayatollah Sistani, riep Maliki onlangs op af te treden. Ook partijen van zijn eigen coalitie hebben zich tegen hem gekeerd en steunen Abadi. Volgens velen staat Maliki een verzoening in Irak in de weg."
                            },
                            {
                                "example_id": "3f7857e1-4286-4319-b990-6c1e1c1a92e9",
                                "sense_id": "e3da4d86-0798-309c-ac3e-e80ed2049b34",
                                "text": "Op straat vielen er inmiddels doden, maar er volgde geen enkele zichtbare reactie van politie, justitie of vanuit de politiek. Religieuze leiders verschenen wel op het toneel. De grootayatollah Al-Sistani, een gematigde sjiiet, riep op om het moorden te stoppen. Hij noemde het zelfs een \"terroristische daad\". Hij legde zijn volgelingen uit dat het om jeugd met problemen gaat. Hij wees eigen richting van zijn volgers af."
                            }
                        ]
                    }
