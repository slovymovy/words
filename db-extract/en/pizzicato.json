                                "target_senses": [
                                    {
                                        "sense_id": "c9916d23-60ab-3733-807c-2799c5c0f80c",
                                        "entry_id": "b65c0127-403d-3a8f-a564-00aa4c537e85",
                                        "glosses": [
                                            "Il se dit des passages que l’on exécute en pinçant les cordes d’un instrument dont on joue ordinairement avec un archet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ce8465b-bf9c-4dab-ae8f-6547833213dc",
                                                "sense_id": "c9916d23-60ab-3733-807c-2799c5c0f80c",
                                                "text": "L’emploi du pizzicato est annoncé à la fin du trio."
                                            },
                                            {
                                                "example_id": "48c95d1f-119f-4373-8b7a-0069d79db500",
                                                "sense_id": "c9916d23-60ab-3733-807c-2799c5c0f80c",
                                                "text": "Au centre, il y a bien sûr Vivaldi. Mais aussi des pièces contemporaines en dialogue avec l’époque baroque. C’est le cas de Caroline Shaw, dont Limestone & Felt utilise des pizzicatos rappelant le théorbe."
                                            },
                                            {
                                                "example_id": "6de5fc23-d7b2-4595-9386-efb560c7f3d0",
                                                "sense_id": "c9916d23-60ab-3733-807c-2799c5c0f80c",
                                                "text": "Le célèbre pizzicato du ballet de Sylvia."
                                            },
                                            {
                                                "example_id": "ad8b4fa1-7b35-456e-9070-3215fa4e3d01",
                                                "sense_id": "c9916d23-60ab-3733-807c-2799c5c0f80c",
                                                "text": "Le pizzicato du danger résonnait autour d’eux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pizzicato",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cab440e-d0e4-3f08-90b5-5aab7f18c241",
                                        "entry_id": "e694a716-6b34-3ede-addf-cd2fec0692b4",
                                        "glosses": [
                                            "Manière de jouer un pizzicato."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f1352f-d280-4778-bac1-d406c92f7ee5",
                                                "sense_id": "6cab440e-d0e4-3f08-90b5-5aab7f18c241",
                                                "text": "Les basses joueront pizzicato."
                                            },
                                            {
                                                "example_id": "cf1fb357-b5ef-48af-84c8-ab8c8093ec03",
                                                "sense_id": "6cab440e-d0e4-3f08-90b5-5aab7f18c241",
                                                "text": "Chaque fois que quelque chose d'amusant était sur le point de se produire, le compositeur nous envoyait un coup de coude en faisant jouer les cordes pizzicato. (Dans les années 1950 et 1960, un basson se serait chargé du coup de coude.)"
                                            }
                                        ]
                                    }
                                ]
                            }
