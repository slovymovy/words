                                "sense_id": "d5a7f6f8-189d-356e-8e6b-eaea7e8b4a02",
                                "text": "Nasza przychodnia zapewnia opiekę ambulatoryjną."
                            },
                            {
                                "example_id": "bf055be3-3f7b-4c70-9a2d-78e6421485f4",
                                "sense_id": "d5a7f6f8-189d-356e-8e6b-eaea7e8b4a02",
                                "text": "W tym uzdrowisku jest trzynaście lecznic, w tym jeden szpital, trzy przychodnie i dziewięć sanatoriów."
                            }
                        ],
