                    },
                    {
                        "translation_id": "30f0b150-21c9-4f45-90ea-0eada45f1680",
                        "source_entry_id": "299e2ab7-c4b4-33a7-bd3a-2c65158df46f",
                        "source_sense_id": "2c06e0eb-1141-35f5-85fa-96ad3b7187d9",
                        "source_sense_description": "instrument",
                        "target_lang_word": "théodolite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théodolite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b46497dd-6dca-3d4a-8206-b2e3fcca8072",
                                        "entry_id": "f7ca5e4c-d078-3153-ae9a-10f9cfe700b6",
                                        "glosses": [
                                            "Instrument de mesure des angles dans les deux plans horizontal et vertical afin de déterminer une direction et particulièrement de mesurer l’azimut et la hauteur apparente d’un astre ; ou faire de la triangulation sur un terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b392e23-e58b-4cf5-b5ff-75dd895800d9",
                                                "sense_id": "b46497dd-6dca-3d4a-8206-b2e3fcca8072",
                                                "text": "Ces triangles s’obtiennent en visant au moyen d’instruments précis, le théodolite ou le cercle répétiteur, des signaux naturels ou artificiels, tels que clochers, tours, réverbères, poteaux."
                                            },
                                            {
                                                "example_id": "bc2c2345-d11c-4db3-9db2-24e2585c31eb",
                                                "sense_id": "b46497dd-6dca-3d4a-8206-b2e3fcca8072",
                                                "text": "[…] ; on apprenait à mesurer le vent aux diverses altitudes en observant un ballon au moyen d’un théodolite ; on calculait les tables qui permettaient une interprétation rapide, et en même temps d’autres tables de correction pour le tir de l’artillerie."
                                            },
                                            {
                                                "example_id": "b16202bd-f70f-4a61-98ca-2f0fe152aef4",
                                                "sense_id": "b46497dd-6dca-3d4a-8206-b2e3fcca8072",
                                                "text": "Sur la petite table qui lui servait de bureau, des cartes étaient étalées, anciennes et colorées, des cartes qui n'avaient rien à voir avec notre contrée et qui présentaient des reliefs et des tracés de rivières totalement inconnus. Près d'elles, il y avait aussi une grosse boussole en cuivre, une longue-vue, un compas, et un autre instrument de mesure qui ressemblait à un théodolite, mais d'une taille minuscule, ainsi que son petit carnet noir, fermé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba6ae292-c3b2-4775-8a50-a5e961a27a75",
