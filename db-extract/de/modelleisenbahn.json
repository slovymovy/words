                    {
                        "sense_id": "afef41a3-144d-3e7c-87f5-dc03caeca595",
                        "entry_id": "581ca6e3-6ec3-3af7-bd34-db4bdf4fc653",
                        "glosses": [
                            "eine maßstäblich verkleinerte Nachbildung einer Eisenbahn"
