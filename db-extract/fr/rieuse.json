                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cce1d18-4cae-47ef-8a2c-e881d6df648d",
                                "sense_id": "25a60480-8e25-31be-9786-c4b62ce36854",
                                "text": "L’autre famille du rez-de-chaussée, les Vincent, sont épiciers. Madame Vincent est une rieuse."
                            },
                            {
                                "example_id": "2647d27e-ed7c-4f9e-9a7b-79ac7a1fc2d6",
                                "sense_id": "25a60480-8e25-31be-9786-c4b62ce36854",
                                "text": "La rieuse, qui s’appelait Jeanne et était la fille d’un riche fermier de l’endroit, avouait que son choix était fait depuis longtemps."
                            }
                        ]
                    }
