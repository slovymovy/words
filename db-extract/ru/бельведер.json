                                        "glosses": [
                                            "ein Prunkbau, der einen schönen Ausblick ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe2ee7c-1c15-4b7d-be4a-c7dc7c958cfa",
                                                "sense_id": "2044652c-62c2-30a8-bcd1-2786d209415d",
                                                "text": "Das Wiener Belvedere bietet einen einmaligen Blick auf das Zentrum der Stadt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54941a12-bf57-4d68-966c-7de23a0b6ce3",
                        "source_entry_id": "bbcad47f-d284-34be-ad59-4a3ed0ea93f4",
                        "target_lang_word": "belvédère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belvédère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07275e19-8047-3396-9728-196481465703",
                                        "entry_id": "2ef8d6e4-433c-38ab-818a-6358e27ebc6c",
                                        "glosses": [
                                            "Espèce de pavillon, de tour ou de terrasse construite au haut d’un édifice ou sur quelque élévation et d’où l’on voit au loin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "943e80d8-641c-480d-9fc0-212c3e0c75be",
                                                "sense_id": "07275e19-8047-3396-9728-196481465703",
                                                "text": "Du haut de son belvédère, l’ogre contemplait cet immense abattage."
                                            },
                                            {
                                                "example_id": "fa2957c8-7971-4a44-afae-3c73f411af67",
                                                "sense_id": "07275e19-8047-3396-9728-196481465703",
                                                "text": "Le 29 avril, j’ai installé un second poste d’ozonoscopie à la rampe de notre belvédère, à 20 mètres au-dessus du poste établi dans l’abri des thermomètres qui servent aux observations météorologiques."
                                            },
                                            {
                                                "example_id": "ab9a1f36-fb5b-418e-923c-d05ecda5dc6c",
                                                "sense_id": "07275e19-8047-3396-9728-196481465703",
                                                "text": "Aussi les paysagistes sont-ils présents pour apporter la touche finale à la route par la végétalisation des talus et des belvédères, assurant ainsi la cicatrisation des emprises routières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06cd1fb9-902a-3255-9796-c203bad09f71",
                                        "entry_id": "2ef8d6e4-433c-38ab-818a-6358e27ebc6c",
                                        "glosses": [
                                            "Linaire commune, belle-à-voir."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
