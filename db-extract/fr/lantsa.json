                        "entry_id": "b5b7d8b9-b232-3961-bef7-2cc3d3d5f106",
                        "glosses": [
                            "Écriture alphasyllabaire brahmique utilisée pour écrire le newari au Népal et dans les monastères bouddhistes en Asie (Chine, Inde, Japon, Mongolie, Népal, Tibet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713b8c64-9061-4062-b439-bbf096486c52",
                                "sense_id": "9a63609a-c76b-3efa-a67a-4f6081c63965",
                                "text": "Le lantsa est systématiquement utilisé dans les architectures religieuses, que ce soit sur les poutres, les architraves ou en frise."
                            },
                            {
                                "example_id": "d6fe2073-41a1-4e00-8210-b0e1aba841a4",
                                "sense_id": "9a63609a-c76b-3efa-a67a-4f6081c63965",
                                "text": "La plus répandue est le lantsa ou ranja (lan cha ou rañca)."
                            }
                        ]
                    }
                ],
