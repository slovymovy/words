                        ],
                        "examples": [
                            {
                                "example_id": "c99a2b79-34c8-4213-b146-ed3539f0d302",
                                "sense_id": "5d51eef3-9e5e-3b9d-b28c-42249b576bde",
                                "text": "Toutes ces rombières, les bonnes mamans, qui ne sentent leurs chattes que quand elles accouchent, ça leur ferait plaisir fou, elles qui ont toujours refusé de faire la différence entre vouloir être un pornstar et se faire violer."
                            }
                        ]
                    }
