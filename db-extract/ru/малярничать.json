                "senses": [
                    {
                        "sense_id": "f9369f05-faa7-3d35-bcea-b2f725af03b0",
                        "entry_id": "822e03e9-87f1-397a-90de-8a878839d6c1",
                        "glosses": [
                            "разг. работать маляром, выполнять малярные работы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86edbcfd-8719-415d-bc06-bce5cca544b4",
                                "sense_id": "f9369f05-faa7-3d35-bcea-b2f725af03b0",
                                "text": "С малых лет в работу втянутый. Сезоны с отцом малярничал. Две зимы в приходской голыми пятками сверкал."
                            },
                            {
                                "example_id": "8ced1315-fc41-4dbd-a257-059130518a1a",
                                "sense_id": "f9369f05-faa7-3d35-bcea-b2f725af03b0",
                                "text": "Александр был городским жителем, склонным к кабинетным занятиям, но тут молодому диакону пришлось плотничать, малярничать, вставлять стёкла."
                            }
                        ]
                    }
