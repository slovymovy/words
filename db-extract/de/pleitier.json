                "senses": [
                    {
                        "sense_id": "baba24fe-36c8-322b-a899-43c9751150d4",
                        "entry_id": "4ca93a86-0499-3735-9afb-6aaaad41811e",
                        "glosses": [
                            "jemand, der zahlungsunfähig geworden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661295be-8a13-4da3-9320-b43886196265",
                                "sense_id": "baba24fe-36c8-322b-a899-43c9751150d4",
                                "text": "„Als reicher Linsen-Unternehmer ließe es sich bestimmt gut aushalten in Bellingham, Washington, nicht aber als Pleitier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51f34550-dc6c-33cd-9455-0f172b03353e",
                        "entry_id": "4ca93a86-0499-3735-9afb-6aaaad41811e",
                        "glosses": [
                            "jemand, der zahlungsunfähig geworden ist",
                            "aus eigenem Versagen oder wegen widriger Umstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5436cd64-7351-4153-bb17-33cd0feddba6",
                                "sense_id": "51f34550-dc6c-33cd-9455-0f172b03353e",
                                "text": "Unser Blick auf die Kaste der Unternehmer beschränkt sich allzu häufig auf die Erfolgreichen, auf die Mächtigen, die wir beneiden und manchmal auch bewundern. Aber Pleitiers und scheiternde Unternehmer gehören ebenfalls zum Kapitalismus."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "a3b3d5d3-74f6-38ae-9152-da804ddc4db8",
                        "entry_id": "4ca93a86-0499-3735-9afb-6aaaad41811e",
                        "glosses": [
                            "jemand, der zahlungsunfähig geworden ist",
                            "mit betrügerischer Absicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1adb8122-476d-43eb-98e3-0ca2009978ab",
                                "sense_id": "a3b3d5d3-74f6-38ae-9152-da804ddc4db8",
                                "text": "Das mögen sie ruhig tun, auch höhnen und spotten. Die ideologischen \"Pleitiers\" des Kasinokapitalismus, die ohne Skrupel das Geld anderer verzockten, haben beides verdient."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
                ],
