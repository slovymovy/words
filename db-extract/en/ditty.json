                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "030a805f-bc26-4932-a7f0-b507325cad06",
                        "source_entry_id": "a44124f3-7876-3406-98ce-89b63748e0f0",
                        "source_sense_description": "a short verse or tune",
                        "target_lang_word": "Ständchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ständchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                                        "glosses": [
                                            "kleiner Stand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26b6d10-939b-4859-985c-17dbc7bfa95e",
                                                "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                                                "text": "Jeden Samstag verkauft sie an einem Ständchen auf dem Wochenmarkt ihre selbstgemachten Marmeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                                        "glosses": [
                                            "kleines Musikstück, das jemandem zu Ehren auf einer Feier oder vor seinem Haus gespielt oder gesungen wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0faff0f0-95e9-4b5a-8558-f35f7d4fd565",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "Zu Opas 80. Geburtstag haben wir ihn im Krankenhaus mit einem Ständchen überrascht."
                                            },
                                            {
                                                "example_id": "88d51d6c-ec6c-4d26-b050-f785feb5d8aa",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Zwar geschah es an diesem Neujahrstag sozusagen vor der falschen Verwandtschaft, der Verwandtschaft mütterlicherseits, doch ich holte das missglückte Ständchen zum Geburtstag des falschen Großvaters in Rüpprich nun in Dondorf nach.“"
                                            },
                                            {
                                                "example_id": "a5775f18-a09c-49b2-b4c2-108f9e0bc276",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Sie glaubt, das Ständchen gelte ihr.“"
                                            },
                                            {
                                                "example_id": "d32a935a-a513-4d50-b96a-acd4659dfdc9",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Ich schlummere süß und werde mit Blockflötentönen geweckt – Heinrike spielt ein Ständchen vor der Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07e08352-ab64-4349-9983-1a84972973f6",
                        "source_entry_id": "a44124f3-7876-3406-98ce-89b63748e0f0",
                        "source_sense_description": "a short verse or tune",
                        "target_lang_word": "пе́сенка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пе́сенка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e479eb84-a39c-3af9-a3bb-7d71fb0f46bc",
                                        "entry_id": "c6d4912c-4ba9-3316-ad6e-2f4e0068c894",
                                        "glosses": [
                                            "разг. уменьш. к песня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cae9b99c-850c-44f1-95d9-98533b58c6d2",
                                                "sense_id": "e479eb84-a39c-3af9-a3bb-7d71fb0f46bc",
                                                "text": "❬…❭ «Я на подвиг тебя провожала, над страною гремела гроза…» — сегодня мы скажем, что это из времён Второй мировой, но это всего лишь песенка Дженни к фильму «Остров сокровищ», вышедшему в 1938 году. ❬…❭"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98e76ca-49a4-3989-a256-f9e2c7811e9c",
                                        "entry_id": "c6d4912c-4ba9-3316-ad6e-2f4e0068c894",
                                        "glosses": [
                                            "разг. ласк. к песня"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "354ee681-4d9c-36d3-b0df-384345374f93",
                                        "entry_id": "c6d4912c-4ba9-3316-ad6e-2f4e0068c894",
                                        "glosses": [
                                            "прост. частушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e5353b-7215-486f-bdce-f5213b3b6cc1",
                                                "sense_id": "354ee681-4d9c-36d3-b0df-384345374f93",
                                                "text": "Мимо милкиных окошек // Втихомолку не пройду! // То ей стукну, то ей брякну, // То ей песенку спою!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f28f48-6993-4f05-a7c0-7c324b067166",
                        "source_entry_id": "a44124f3-7876-3406-98ce-89b63748e0f0",
                        "source_sense_description": "a short verse or tune",
                        "target_lang_word": "моти́в",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "моти́в",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "20ba7297-a302-3250-b67b-d0c7a4ea1edf",
                                        "entry_id": "7a01ee38-185a-32ce-961f-f28e5d1190d5",
                                        "glosses": [
                                            "разг. напев, мелодия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fb26ab-df4e-4015-9ca4-cf7708b4be9e",
                                                "sense_id": "20ba7297-a302-3250-b67b-d0c7a4ea1edf",
                                                "text": "Плясовой мотив."
                                            },
                                            {
                                                "example_id": "5678061d-4895-4077-bf2d-17ecb3105aac",
                                                "sense_id": "20ba7297-a302-3250-b67b-d0c7a4ea1edf",
                                                "text": "Веселый мотив."
                                            },
                                            {
                                                "example_id": "beff49af-1234-4ddf-a71a-28240555e701",
                                                "sense_id": "20ba7297-a302-3250-b67b-d0c7a4ea1edf",
                                                "text": "И он начал увязывать и складывать небольшие пожитки наши, насвистывая мотив из «Калифа Багдадского»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef1c25ae-1913-3249-822a-6e6b0200d642",
                                        "entry_id": "7a01ee38-185a-32ce-961f-f28e5d1190d5",
                                        "glosses": [
                                            "муз. ритмическая единица мелодии"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ae4e42-e090-3109-b626-a9a7c253ad31",
                                        "entry_id": "7a01ee38-185a-32ce-961f-f28e5d1190d5",
                                        "glosses": [
                                            "филол. простейшая единица сюжета; тема, сюжет произведения искусства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4692a256-1094-401d-a1a7-72886045727a",
                                                "sense_id": "d4ae4e42-e090-3109-b626-a9a7c253ad31",
                                                "text": "Мотив борьбы с чудовищем в мифах и сказках."
                                            },
                                            {
                                                "example_id": "09b299ba-3bb5-4b52-ac18-99c8ec8aa253",
                                                "sense_id": "d4ae4e42-e090-3109-b626-a9a7c253ad31",
                                                "text": "Осенние мотивы в картинах Левитана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c1d3a6b-e116-3b2f-aad5-e0a64b57a1d0",
                                        "entry_id": "7a01ee38-185a-32ce-961f-f28e5d1190d5",
                                        "glosses": [
                                            "книжн. повод, побуждение к какому-либо действию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc84842-ea4f-4bc9-a17c-d72d2c2855f2",
                                                "sense_id": "2c1d3a6b-e116-3b2f-aad5-e0a64b57a1d0",
                                                "text": "По мотивам личного характера."
                                            },
                                            {
                                                "example_id": "37beee21-12f4-4a42-94f7-bb6231ba8bd7",
                                                "sense_id": "2c1d3a6b-e116-3b2f-aad5-e0a64b57a1d0",
                                                "text": "Какими мотивами вы руководствовались?"
                                            },
                                            {
                                                "example_id": "21124c9e-11bb-4951-863e-a329a5061839",
                                                "sense_id": "2c1d3a6b-e116-3b2f-aad5-e0a64b57a1d0",
                                                "text": "В обоих случаях очень существенно, что владение собственностью в добавление к оплате создаёт дополнительный мотив для работников, чтобы способствовать достижению успеха."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d7141f-4833-3930-a874-9d4d868fb209",
                                        "entry_id": "7a01ee38-185a-32ce-961f-f28e5d1190d5",
                                        "glosses": [
                                            "книжн. довод в пользу чего-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416ae500-aa0b-47ea-ad03-65e149c87948",
                                                "sense_id": "71d7141f-4833-3930-a874-9d4d868fb209",
                                                "text": "Привести мотивы в пользу своего предложения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
