                "senses": [
                    {
                        "sense_id": "2318728c-5f2c-3ca3-8f83-47bbdd5dd10f",
                        "entry_id": "f21392c6-f7fb-3cb8-b4b8-89d2debe4cf1",
                        "glosses": [
                            "leichtes, wasserdichtes Stück Oberbekleidung für schlechtes Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8443b912-75e7-470c-aad6-4c8451a24477",
                                "sense_id": "2318728c-5f2c-3ca3-8f83-47bbdd5dd10f",
                                "text": "„Wie ein grauer Schleier legte sich der sanfte Nieselregen über meine rote Regenjacke.“"
                            },
                            {
                                "example_id": "87b1a99d-be4c-419d-b9af-70baf489a92b",
                                "sense_id": "2318728c-5f2c-3ca3-8f83-47bbdd5dd10f",
                                "text": "„Wir ziehen die Regenjacken an, schlüpfen in festes Schuhwerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48ef2be9-cd88-490a-a2ee-6c0ab1e22795",
