                        "examples": [
                            {
                                "example_id": "b174a017-8da3-45ed-98c8-0e87e1715afd",
                                "sense_id": "295734e4-77c5-3e42-bacb-cc2b298f0f5b",
                                "text": "Gordy, who looks sort of like a bear cub, only not cute, is a very huggy person."
                            },
                            {
                                "example_id": "44163d63-4bc8-42a2-a866-ec6a3dac63a7",
                                "sense_id": "295734e4-77c5-3e42-bacb-cc2b298f0f5b",
                                "text": "I wasn't typically a huggy person, but I knew better than to argue with anyone in Bones's genetic line."
                            },
                            {
                                "example_id": "c7c66ceb-d5f9-4563-b893-22b748b1a547",
                                "sense_id": "295734e4-77c5-3e42-bacb-cc2b298f0f5b",
                                "text": "Sonia is an affectionate but not very huggy woman."
