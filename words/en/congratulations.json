            "senses": [
                {
                    "sense_id": "f5008b2d-413b-34f6-b110-e072fe03aada",
                    "sense_definition": "Used to express praise, approval, or pleasure at someone's success or good fortune.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warm <w>congratulations</w> on your newborn boy!",
                            "target_lang_translations": {
                                "ru": "Сердечные <w>поздравления</w> с рождением сына!",
                                "zh": "热烈<w>祝贺</w>你喜得贵子！"
                            }
                        },
                        {
                            "text": "<w>Congratulations</w> on passing your driving test!",
                            "target_lang_translations": {
                                "ru": "<w>Поздравляю</w> со сдачей экзамена на вождение!",
                                "zh": "<w>恭喜</w>你通过了驾照考试！"
                            }
                        }
                    ],
                    "synonyms": [
                        "well done",
                        "congrats"
                    ],
                    "common_phrases": [
