                                                "example_id": "64e8ed04-bd5e-4e6c-b86c-c04b3fe3285e",
                                                "sense_id": "c3995821-c5fd-30cc-8ba1-8394a7d0baea",
                                                "text": "Un attaché au cabinet d’un ministre."
                                            },
