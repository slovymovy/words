                        "glosses": [
                            "een water dat rond een polder loopt"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "28eabbab-a0c6-4553-8755-c86b8dfc9bad",
                                "sense_id": "34dbafd4-9512-3fdd-b41a-a8bcfc63bff3",
                                "text": "Hoe hoog het waterpeil precies zal komen valt volgens W&Z moeilijk te voorspellen, maar een evenaring of overschrijding van het peil van de Sinterklaasstorm van 6 december 2013 is “niet uitgesloten”. Vooral op de Schelde in Antwerpen en op de Ringvaart in Melle worden hoge waterstanden verwacht."
                            },
                            {
                                "example_id": "003aaa33-a3cd-414e-b5b7-4c35f33bca33",
                                "sense_id": "34dbafd4-9512-3fdd-b41a-a8bcfc63bff3",
                                "text": "Overigens, bij de dijkdoorbraak wordt ook rekening gehouden met mens en natuur. Zo is de polder al grotendeels onder water gezet om te voorkomen dat bijvoorbeeld de Ringvaart Haarlemmermeer ineens leegstroomt."
                            }
                        ]
                    }
