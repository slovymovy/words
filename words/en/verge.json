{
    "word_family": [
        "verger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c3d529f-1446-3a11-b071-dccb97297d0e",
                    "sense_definition": "An extreme limit or point beyond which something specific is about to happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "limit_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was on the <w>verge</w> of calling you when you finally arrived.",
                            "target_lang_translations": {
                                "ru": "Я был на <w>грани</w> того, чтобы позвонить тебе, когда ты наконец приехал.",
                                "de": "Ich war <w>kurz davor</w>, dich anzurufen, als du endlich ankamst."
                            }
                        },
                        {
                            "text": "The exhausted runners were on the <w>verge</w> of collapsing after the marathon.",
                            "target_lang_translations": {
                                "ru": "Измученные бегуны были на <w>грани</w> обморока после марафона.",
                                "de": "Die erschöpften Läufer waren nach dem Marathon <w>am Rande</w> des Zusammenbruchs."
                            }
                        }
                    ],
                    "synonyms": [
                        "brink",
                        "threshold",
                        "edge",
                        "point"
                    ],
                    "common_phrases": [
                        "on the verge of",
                        "to the verge of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайний предел или точка, за которой должно произойти что-то конкретное.",
                        "de": "Ein äußerster Grenzpunkt, an dem ein Ereignis unmittelbar bevorsteht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грань",
                                "target_lang_sense_clarification": "предел, часто используется в выражении «на грани»"
                            },
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "предел, критическая точка"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Rand",
                                "target_lang_sense_clarification": "im Sinne von 'am Rande von etwas stehen'"
                            },
                            {
                                "target_lang_word": "kurz vor",
                                "target_lang_sense_clarification": "als adverbiale Bestimmung für einen Zustand unmittelbar vor dem Eintritt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31da6e3b-1ce6-3717-8dbd-fe6e98454ff3",
                    "sense_definition": "The grassy area between the footpath and the street, or a strip of land bordering a road.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "road_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pulled the car over onto the grass <w>verge</w> to check the map.",
                            "target_lang_translations": {
                                "ru": "Мы съехали на травянистую <w>обочину</w>, чтобы свериться с картой.",
                                "de": "Wir fuhren auf den <w>Grünstreifen</w>, um auf die Karte zu schauen."
                            }
                        },
                        {
                            "text": "Wildflowers were growing in abundance along the <w>verge</w> of the highway.",
                            "target_lang_translations": {
                                "ru": "Вдоль <w>обочины</w> шоссе в изобилии росли полевые цветы.",
                                "de": "Entlang des <w>Banketts</w> der Autobahn wuchsen in Hülle und Fülle Wildblumen."
                            }
                        }
                    ],
                    "synonyms": [
                        "roadside",
                        "shoulder",
                        "berm",
                        "nature strip"
                    ],
                    "common_phrases": [
                        "grass verge",
                        "road verge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Травянистый участок между тротуаром и проезжей частью или полоса земли вдоль дороги.",
                        "de": "Die Grasfläche zwischen Gehweg und Straße oder ein unbefestigter Streifen entlang einer Fahrbahn."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обочина",
                                "target_lang_sense_clarification": "край дороги"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Grünstreifen",
                                "target_lang_sense_clarification": "speziell für die begrünte Fläche entlang einer Straße"
                            },
                            {
                                "target_lang_word": "Bankett",
                                "target_lang_sense_clarification": "der unbefestigte Seitenstreifen einer Straße"
                            },
                            {
                                "target_lang_word": "Seitenstreifen",
                                "target_lang_sense_clarification": "allgemeiner Begriff für den Randbereich neben der Fahrbahn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa76cc84-99f9-3546-b684-f944468f2106",
                    "sense_definition": "A physical edge, border, or boundary of an area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "limit_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stood at the <w>verge</w> of the dark forest, afraid to enter.",
                            "target_lang_translations": {
                                "ru": "Они стояли на <w>краю</w> темного леса, боясь войти.",
                                "de": "Sie standen am <w>Rand</w> des dunklen Waldes und fürchteten sich hineinzugehen."
                            }
                        },
                        {
                            "text": "The sun slowly sank below the <w>verge</w> of the horizon.",
                            "target_lang_translations": {
                                "ru": "Солнце медленно садилось за <w>край</w> горизонта.",
                                "de": "Die Sonne sank langsam unter den <w>Rand</w> des Horizonts."
                            }
                        }
                    ],
                    "synonyms": [
                        "edge",
                        "border",
                        "margin",
                        "rim"
                    ],
                    "antonyms": [
                        "center",
                        "middle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often replaced by 'edge' or 'border' in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический край, граница или предел территории.",
                        "de": "Die physische Kante, Grenze oder Begrenzung eines Gebiets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "физическая граница объекта"
                            },
                            {
                                "target_lang_word": "граница",
                                "target_lang_sense_clarification": "разделительная линия"
                            },
                            {
                                "target_lang_word": "рубеж",
                                "target_lang_sense_clarification": "граница, предел (часто в возвышенном или военном контексте)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Rand",
                                "target_lang_sense_clarification": "allgemeine physische Begrenzung"
                            },
                            {
                                "target_lang_word": "Grenze",
                                "target_lang_sense_clarification": "trennende Linie oder Zone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee32bd48-3e72-3ea6-9806-3cb3ddbf9581",
                    "sense_definition": "A rod or staff carried as a symbol of office or authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "symbolic_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ceremonial <w>verge</w> was carried at the front of the procession.",
                            "target_lang_translations": {
                                "ru": "Церемониальный <w>жезл</w> несли во главе процессии.",
                                "de": "Der zeremonielle <w>Amtsstab</w> wurde an der Spitze der Prozession getragen."
                            }
                        },
                        {
                            "text": "He held the silver <w>verge</w> as a sign of his ecclesiastical office.",
                            "target_lang_translations": {
                                "ru": "Он держал серебряный <w>жезл</w> как знак своей церковной должности.",
                                "de": "Er hielt den silbernen <w>Amtsstab</w> als Zeichen seines kirchlichen Amtes."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod",
                        "staff",
                        "wand"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or ecclesiastical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жезл или посох, носимый как символ должности или власти.",
                        "de": "Ein Stab oder Zepter, das als Symbol für ein Amt oder Autorität getragen wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "символ власти или должности"
                            },
                            {
                                "target_lang_word": "посох",
                                "target_lang_sense_clarification": "длинная трость, символ служения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Amtsstab",
                                "target_lang_sense_clarification": "Symbol für ein offizielles Amt"
                            },
                            {
                                "target_lang_word": "Zepter",
                                "target_lang_sense_clarification": "als Herrschaftssymbol"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e36f7145-95b0-3793-a101-1aaf8cc896b0",
                    "sense_definition": "To be or come very close to a particular state, quality, or feeling.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "approach_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His behavior in the meeting <w>verges</w> on being rude.",
                            "target_lang_translations": {
                                "ru": "Его поведение на собрании <w>граничит</w> с грубостью.",
                                "de": "Sein Verhalten bei dem Treffen <w>grenzt</w> an Unhöflichkeit."
                            }
                        },
                        {
                            "text": "The plot of the movie <w>verges</w> on the ridiculous.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма <w>граничит</w> с нелепостью.",
                                "de": "Die Handlung des Films <w>grenzt</w> ans Lächerliche."
                            }
                        }
                    ],
                    "synonyms": [
                        "border on",
                        "approach"
                    ],
                    "common_phrases": [
                        "verge on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть или подходить очень близко к определенному состоянию, качеству или чувству.",
                        "de": "Sehr nahe an einem bestimmten Zustand, einer Eigenschaft oder einem Gefühl sein."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граничить",
                                "target_lang_sense_clarification": "иметь общую границу, быть очень похожим на что-то (с предлогом «с»)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "grenzen an",
                                "target_lang_sense_clarification": "in Verbindung mit einem Zustand (z.B. 'grenzt an Wahnsinn')"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "15408310-1991-3d61-9069-54813777a80b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Verge</w> has lived in this town for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Вердж</w> живет в этом городе уже более сорока лет.",
                                "de": "Herr <w>Verge</w> lebt schon seit über vierzig Jahren in dieser Stadt."
                            }
                        },
                        {
                            "text": "We are looking for the records of a family named <w>Verge</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье по фамилии <w>Вердж</w>.",
                                "de": "Wir suchen nach den Unterlagen einer Familie namens <w>Verge</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вердж",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verge",
                                "target_lang_sense_clarification": "Eigenname, bleibt in der Regel unverändert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}