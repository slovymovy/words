                        "translation_id": "37558346-24f0-49d0-a37b-1b8a4e8ab70c",
                        "source_entry_id": "6a2919a8-8679-3554-ac0a-08484b661257",
                        "source_sense_id": "5d7b4cc7-079e-3036-bf44-fc1e9704336a",
