                                            {
                                                "example_id": "d2a0ad5c-eedc-4fbf-aac3-fa9711eda680",
                                                "sense_id": "0f13fb99-9fde-3fe3-b25c-83da61b84fc1",
                                                "text": "...these three little creeping vines put forth their hands with joy, and spread over rock and hillock and twisted tree-root and mouldering log, in cloaks and scarves and wreaths of tiny evergreen, glossy leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e20184-5cc3-37ae-a959-24209df97088",
                                        "entry_id": "78844744-330c-3350-ae04-8a389f965273",
                                        "glosses": [
                                            "Continually fresh or self-renewing.",
                                            "Being a clause which causes an automatic renewal of a contract unless action is taken."
                                        ],
                                        "tags": [
                                            "figuratively",
