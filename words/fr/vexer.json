                {
                    "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                    "sense_definition": "Tourmenter, opprimer ou persécuter quelqu'un par abus de pouvoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opprimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'intendant impitoyable <w>vexait</w> sans cesse les villageois par des taxes injustes.",
                            "target_lang_translations": {
                                "en": "The ruthless steward constantly <w>oppressed</w> the villagers with unjust taxes.",
                                "ru": "Безжалостный управляющий постоянно <w>притеснял</w> жителей деревни несправедливыми налогами.",
                                "nl": "De meedogenloze rentmeester <w>onderdrukte</w> de dorpelingen voortdurend met onrechtvaardige belastingen.",
                                "de": "Der unbarmherzige Verwalter <w>unterdrückte</w> die Dorfbewohner ständig mit ungerechten Steuern.",
                                "pl": "Bezlitosny zarządca bez przerwy <w>uciskał</w> mieszkańców wsi niesprawiedliwymi podatkami.",
                                "it": "L'amministratore spietato <w>vessava</w> continuamente gli abitanti del villaggio con tasse ingiuste.",
                                "cs": "Nelítostný správce neustále <w>utlačoval</w> vesničany nespravedlivými daněmi.",
                                "tr": "Acımasız kâhya, köylüleri haksız vergilerle durmadan <w>eziyordu</w>.",
                                "es": "El despiadado intendente <w>oprimía</w> sin cesar a los aldeanos con impuestos injustos.",
                                "zh": "残酷无情的管家不断用不公正的赋税<w>压迫</w>村民。"
                            }
                        },
                        {
                            "text": "Le souverain cruel continua de <w>vexer</w> ses sujets jusqu'à provoquer une grande révolte.",
                            "target_lang_translations": {
                                "en": "The cruel sovereign kept <w>oppressing</w> his subjects until it sparked a great revolt.",
                                "ru": "Жестокий правитель продолжал <w>притеснять</w> своих подданных, пока не вызвал большое восстание.",
                                "nl": "De wrede vorst bleef zijn onderdanen <w>onderdrukken</w> totdat dit een grote opstand uitlokte.",
                                "de": "Der grausame Herrscher fuhr fort, seine Untertanen zu <w>unterdrücken</w>, bis er einen großen Aufstand auslöste.",
                                "pl": "Okrutny władca nadal <w>uciskał</w> swoich poddanych, aż wywołał wielki bunt.",
                                "it": "Il sovrano crudele continuò a <w>opprimere</w> i sudditi fino a provocare una grande rivolta.",
                                "cs": "Krutý panovník dál <w>utlačoval</w> své poddané, až vyvolal velké povstání.",
                                "tr": "Zalim hükümdar, büyük bir isyana yol açana kadar tebaasına <w>zulmetmeye</w> devam etti.",
                                "es": "El cruel soberano siguió <w>oprimiendo</w> a sus súbditos hasta provocar una gran revuelta.",
                                "zh": "残暴的君主继续<w>欺压</w>臣民，直到引发了一场大规模的起义。"
                            }
                        }
