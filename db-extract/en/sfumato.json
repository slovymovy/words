                                    {
                                        "sense_id": "dede918f-a801-3588-b6a6-bc209c398744",
                                        "entry_id": "daf0de93-9989-3752-b3c0-f08fc5584d12",
                                        "glosses": [
                                            "Technique de peinture consistant en la superposition de plusieurs couches de peinture extrêmement fines et translucides, destinées à rendre un arrière-plan évanescent, donnant ainsi de la profondeur de champ."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75454c98-6530-4dbd-8457-e1f192073890",
                                                "sense_id": "dede918f-a801-3588-b6a6-bc209c398744",
                                                "text": "Dévoiler la Joconde ? C'est l'objectif lascif d'une équipe scientifique, associée au Louvre pour percer le mystère du sfumato, qui a fait la célébrité de Léonard de Vinci."
                                            }
                                        ]
                                    }
