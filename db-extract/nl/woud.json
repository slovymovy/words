                    {
                        "sense_id": "60bc4f4f-c692-328b-84ad-26e202eaea47",
                        "entry_id": "38548a72-00f2-327f-b1fd-32b124174a4b",
                        "glosses": [
                            "groot bos [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28a3915-7de8-47d8-926a-237ce5372f70",
                                "sense_id": "60bc4f4f-c692-328b-84ad-26e202eaea47",
