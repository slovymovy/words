                        "examples": [
                            {
                                "example_id": "d2c2c8de-98c7-49ec-9e34-80d5ff1e488e",
                                "sense_id": "e786877d-b833-304b-b59e-fb140fbf44cf",
                                "text": "It is a case of pseudandry when a woman adopts a man's name; for instance, Amantine Lucile Aurore Dupin, afterward Dudevant, signed herself George Sand, […]"
                            },
                            {
                                "example_id": "6ff8c53f-f41f-4425-bfc1-e0c7ff404877",
                                "sense_id": "e786877d-b833-304b-b59e-fb140fbf44cf",
                                "text": "[…] and ends with Michael Strange, an example of pseudandry, or the use by a woman of a masculine pen name […]"
                            },
                            {
                                "example_id": "8af717ac-ad71-432b-ba00-dd44d4963c82",
                                "sense_id": "e786877d-b833-304b-b59e-fb140fbf44cf",
                                "text": "A reprinting from the New Yorker Staats-Zeitung of a list of 279 examples of pseudandry (use of masculine name by a woman as a pseudonym) of chiefly German female writers."
