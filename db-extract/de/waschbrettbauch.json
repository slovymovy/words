                "senses": [
                    {
                        "sense_id": "49098684-fc5d-3e98-bd88-17a77b3810eb",
                        "entry_id": "ae00aa56-231b-34d5-a0e8-b01f3313497e",
                        "glosses": [
                            "ein flacher, durchtrainierter und muskulöser Bauch"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cc942a36-c9c4-475a-8c12-9dc5a14ab451",
                                "sense_id": "49098684-fc5d-3e98-bd88-17a77b3810eb",
                                "text": "Ein Mann mit Waschbrettbauch sieht lecker aus."
                            },
                            {
                                "example_id": "7acfad75-0892-415c-b05e-cb6d515dc660",
                                "sense_id": "49098684-fc5d-3e98-bd88-17a77b3810eb",
                                "text": "Einige Männer trainieren sehr hart für ihren Waschbrettbauch."
                            },
                            {
                                "example_id": "1d520fb0-35cb-4784-b18c-041b9c4c3f55",
                                "sense_id": "49098684-fc5d-3e98-bd88-17a77b3810eb",
                                "text": "„Der neueste Trend sind Muskelimplantate: Den kräftigen Oberschenkel oder den Waschbrettbauch trainiert man sich nicht mehr mühsam an, eine Operation tut es für immer mehr Brasilianer auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d6ebd86-ccd1-4688-9cd0-2e5fc4da9830",
