                "senses": [
                    {
                        "sense_id": "8e29824e-5761-35a6-9b09-6bbba2cee615",
                        "entry_id": "97a662e0-04d0-3ae7-9aed-83901ae4a237",
                        "glosses": [
                            "Ansteckung mit Krankheitssymptome auslösenden Pilzen die dadurch ausgelöste Erkrankung"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "f144eebf-e31b-4a1b-933a-737b5d83fe2a",
                                "sense_id": "8e29824e-5761-35a6-9b09-6bbba2cee615",
                                "text": "„Zu den Dermatomykosen gehören zum einen Pilzinfektionen der Hautanhangsgebilde (z.B. Nagelpilz) und der behaarten Kopfhaut (Kopfpilz oder Tinea capitis). Zum anderen die Pilzinfektionen der freien Haut, die oft einfach \"Hautpilz\" genannt werden.“"
                            },
                            {
                                "example_id": "beb84727-eaa4-400f-a830-7bc8a5aa50bd",
                                "sense_id": "8e29824e-5761-35a6-9b09-6bbba2cee615",
                                "text": "„Der Baum sondert bei Verwundungen eine zähe Flüssigkeit, das Harz, ab, das die Wunde verschließt und damit eine Pilzinfektion verhindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
