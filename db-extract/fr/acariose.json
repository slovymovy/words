                        "sense_id": "b3c936dc-b00e-319b-a147-00c99095a47d",
                        "entry_id": "d4c04944-2f2b-3c49-95c7-ed659e98d099",
                        "glosses": [
                            "Maladie causée par les acariens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb59c6b-da95-4018-ab0b-c05727b6a5da",
                                "sense_id": "b3c936dc-b00e-319b-a147-00c99095a47d",
                                "text": "Quant au lysol, nous avons déjà noté, à plusieurs reprises, ses remarquables propriétés insecticides, en particulier dans nos études sur l’acariose."
                            },
                            {
                                "example_id": "dd1dc747-b100-493d-be47-328d9ebbb65e",
                                "sense_id": "b3c936dc-b00e-319b-a147-00c99095a47d",
                                "text": "Un signe caractéristique de l'acariose est la présence à la fin de l'hiver de nombreuses ailes sur le plancher de la ruche."
                            },
                            {
                                "example_id": "77656925-e3ac-4e75-b1bf-cbb9a04ef7f6",
                                "sense_id": "b3c936dc-b00e-319b-a147-00c99095a47d",
                                "text": "L’acariose est provoquée par un acarien (Acarapis woodi) qui se nourrit de l’hémolymphe de l’abeille et se localise dans les trachées thoraciques empêchant l’abeille de voler."
                            }
                        ]
                    }
