                                    {
                                        "sense_id": "418eb0e8-da0b-328d-bbc3-df441b6d9d8c",
                                        "entry_id": "36902384-1b74-36f9-b8f8-6630b29853a7",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a86bed-25c7-42c4-8661-c10a072bcbd1",
                                                "sense_id": "418eb0e8-da0b-328d-bbc3-df441b6d9d8c",
                                                "text": "Alric Paon, à la tête d’un réseau d’une quinzaine de poissonneries et points de vente en Loire-Atlantique, observe également cette augmentation soudaine du tarif du bulot : « Les habitués nous posent des questions, forcément. On explique le contexte et on tire sur nos marges. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Paon",
