                ],
                "senses": [
                    {
                        "sense_id": "76a7ee67-28f6-3001-b2cb-d360aaa3db90",
                        "entry_id": "4288cb86-b9ca-3fd1-aa53-37f1aa1968b8",
                        "glosses": [
                            "ein kleines (unerzogenes, freches) Kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bcf9795-1e74-4dbb-ae6b-8cb0cdb85b82",
                                "sense_id": "76a7ee67-28f6-3001-b2cb-d360aaa3db90",
                                "text": "Die kleine Rotznase hat mir in den Arm gebissen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d716e01b-3745-30eb-8fc9-32377fb6f387",
                        "entry_id": "4288cb86-b9ca-3fd1-aa53-37f1aa1968b8",
                        "glosses": [
                            "eine mit Nasenschleim triefende Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bad4465-50f1-46bf-b597-6c6b6bd82b86",
                                "sense_id": "d716e01b-3745-30eb-8fc9-32377fb6f387",
                                "text": "Ihh! Jetzt schmiert er seine Rotznase am Pullover ab."
                            },
                            {
                                "example_id": "495715e0-8d16-4f74-afbe-f7bbc66542d6",
                                "sense_id": "d716e01b-3745-30eb-8fc9-32377fb6f387",
                                "text": "„Viele Kinder mit großen Rotznasen spielten an den Ecken, und Lastautos fuhren rasch vorbei und verschwanden durch die hohen, breiten Tore, hinter denen wieder hohe, schwarze Häuser standen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "198823bc-450d-4fef-887e-1353ae13a034",
                        "source_entry_id": "4288cb86-b9ca-3fd1-aa53-37f1aa1968b8",
                        "source_sense_id": "76a7ee67-28f6-3001-b2cb-d360aaa3db90",
                        "source_sense_description": "ein kleines (unerzogenes, freches) Kind",
                        "target_lang_word": "morveux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5d1706-2fb5-3e2a-a9ba-7cb461a6c40d",
                                        "entry_id": "b5aa588a-ed8e-3c5b-87eb-23775cab733b",
                                        "glosses": [
                                            "Qui a la morve au nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2d5a10-c784-44e0-ba24-cc54f1b0cac8",
                                                "sense_id": "ca5d1706-2fb5-3e2a-a9ba-7cb461a6c40d",
                                                "text": "Les petits voleurs restaient, les uns debout, les autres accotés contre le lit ou la huche, tous morveux et sales, bien portants d’ailleurs, grugeant leurs prunes sans rien dire, mais regardant l’étranger d’un œil sournois et narquois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                        "entry_id": "b5aa588a-ed8e-3c5b-87eb-23775cab733b",
                                        "glosses": [
                                            "Qui est atteint de la maladie appelée la morve."
                                        ],
                                        "tags": [
                                            "Hippologie",
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfe5608-260d-4b3f-8baf-3f996a3db77c",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Ne donnez au cheval morveux que du son mouillé ; faites lui faire un exercice modéré, […] ."
                                            },
                                            {
                                                "example_id": "dab563f0-82b1-44b3-aa1f-a0df2c1cb35b",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Le maquignon de bas étage […] ne craint pas de vendre un cheval morveux après avoir essayé de cacher le jetage en introduisant une éponge dans un naseau, et avoir pratiqué l’églandage."
                                            },
                                            {
                                                "example_id": "052fe620-9b64-40e7-85a9-aeb946e86e2b",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Il avait aussi découvert un arrière-grand-oncle du vicaire général de l’archevêché, un sieur de Goulet, ou plus exactement, comme il signait lui-même, un Goulet-Trocard, qui, fournisseur aux armées, avait été condamné aux travaux forcés, en 1812, pour avoir livré, au lieu de bœuf, la viande de chevaux morveux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                        "entry_id": "dba622e4-36f4-33a0-b197-f6bda92d0594",
                                        "glosses": [
                                            "Enfant."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec27cbf-9857-43f3-b68f-20e66d0c0943",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "Pour ces morveux-là, un type de vingt-six ans, c'est un vieux; je fis un sourire à la petite gosse blonde […]."
                                            },
                                            {
                                                "example_id": "c9c63286-42ee-48bf-8454-64b046c9eb57",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "Amène-toi morveux : on est grands, merde aux gniards."
                                            },
                                            {
                                                "example_id": "6477c89c-349e-4bc3-af93-93318f8089c9",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "– Toi, ta gueule, morveux ! jeta l’aîné. Bon, tout le monde est au courant que c’est la mobilisation générale, et que les conscrits de la classe 53 sont concernés. Je crois que ça va chier avec les Russes, si j’ai bien compris. Un bled avec un nom à coucher dehors..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc3a2bd-8ebe-32fa-92f1-928be6d78934",
                                        "entry_id": "dba622e4-36f4-33a0-b197-f6bda92d0594",
                                        "glosses": [
                                            "Prétentieux, qui se met en avant, se fait valoir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6022a0-9131-42c6-9c5a-ba7ed0d6e49b",
                                                "sense_id": "3cc3a2bd-8ebe-32fa-92f1-928be6d78934",
                                                "text": "Un méchant morveux, qui fait la leçon à tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc71641c-fcda-45d5-85f3-a69fe5522ee9",
                        "source_entry_id": "4288cb86-b9ca-3fd1-aa53-37f1aa1968b8",
                        "source_sense_id": "76a7ee67-28f6-3001-b2cb-d360aaa3db90",
                        "source_sense_description": "ein kleines (unerzogenes, freches) Kind",
                        "target_lang_word": "morveuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morveuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0443842b-2307-3f41-b69c-9481ad443f34",
                                        "entry_id": "a78f571e-8a77-3e4a-9618-4f9138d29bfe",
                                        "glosses": [
                                            "Petite fille."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e64a9e-1a50-453e-8d0f-991f41c4f69c",
                                                "sense_id": "0443842b-2307-3f41-b69c-9481ad443f34",
                                                "text": "Morveuse! File dans ta chambre!"
                                            },
                                            {
                                                "example_id": "1f4c7ad6-e786-49cd-af6c-52af9a978c2a",
                                                "sense_id": "0443842b-2307-3f41-b69c-9481ad443f34",
                                                "text": "Des problèmes ! une morveuse !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3183cace-df88-3993-843e-1b0bc2ffb94f",
                                        "entry_id": "a78f571e-8a77-3e4a-9618-4f9138d29bfe",
                                        "glosses": [
                                            "Prétentieuse, qui se met en avant, se fait valoir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e90bcb0-565a-4bec-b8d6-49884f1e4a42",
                                                "sense_id": "3183cace-df88-3993-843e-1b0bc2ffb94f",
                                                "text": "Elle lui fit face en baissant la tête, qu’elle secouait et lançait en avant, criant plus fort qu’elle ne souffrirait pas plus longtemps d’être commandée par une morveuse, oui, une morveuse."
                                            },
                                            {
                                                "example_id": "d11744d2-0896-4227-b578-2fad25240714",
                                                "sense_id": "3183cace-df88-3993-843e-1b0bc2ffb94f",
                                                "text": "Moi, si je ne m’étais pas marié, je serais officier mécanicien… J’avais commencé l’école, et tout… Je rencontre une morveuse et crac !…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morveuse",
