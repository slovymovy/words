                        "entry_id": "aad5f89b-95ce-3497-9797-0fbce2c36c07",
                        "glosses": [
                            "compensatie voor gemaakte kosten of geleden schade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a59c9a-3087-4c36-8a5c-0d2f1ca2045f",
                                "sense_id": "81ba15f8-ce68-31d5-baa4-aac98751d225",
                                "text": "We bieden een vergoeding aan voor het ongemak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5d35392-dd77-4973-b149-d1787e10b8f1",
                        "source_entry_id": "aad5f89b-95ce-3497-9797-0fbce2c36c07",
                        "source_sense_id": "81ba15f8-ce68-31d5-baa4-aac98751d225",
                        "source_sense_description": "compensatie voor gemaakte kosten of geleden schade",
                        "target_lang_word": "Vergütung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergütung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Geldsumme, mit der etwas vergütet wird; zum Beispiel Geld als Gegenleistung für eine Arbeit, Ware, Entschädigung oder ein Nutzungsrecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d28abb-22e6-40cf-a04b-371055dd8c45",
                                                "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                                "text": "Eine Vergütung gilt als stillschweigend vereinbart, wenn die Dienstleistung den Umständen nach nur gegen eine Vergütung zu erwarten ist."
                                            },
                                            {
                                                "example_id": "12b1987b-85e3-426b-a92b-c7efb443f030",
                                                "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                                "text": "Wieso sollte ich ohne eine Vergütung arbeiten wollen? Ich möchte Geld sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0307f37-e2d2-3382-b3b8-73b09b8f3f44",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Schutzschicht eines Werkstoffs, zum Beispiel bei Glas, Holz oder Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d326df-0d9b-4930-9b9a-087cc4689d71",
                                                "sense_id": "b0307f37-e2d2-3382-b3b8-73b09b8f3f44",
                                                "text": "Die Vergütung optischer Linsen durch Aufdampfen dünner Schichten im Hochvakuum ist noch nicht so lange bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e73f702-08fc-308c-88ee-a802e13bfffe",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Vergütungsvorgang; das Vergüten; das Vergütetwerden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b66c4e-5b22-4681-af19-8ccf909efa88",
                                                "sense_id": "1e73f702-08fc-308c-88ee-a802e13bfffe",
                                                "text": "Die Vergütung wird in der Lohn- und Gehaltsabteilung abgewickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d0374d0-b5bb-4040-9673-570df0910ba4",
                        "source_entry_id": "aad5f89b-95ce-3497-9797-0fbce2c36c07",
                        "source_sense_id": "81ba15f8-ce68-31d5-baa4-aac98751d225",
                        "source_sense_description": "compensatie voor gemaakte kosten of geleden schade",
                        "target_lang_word": "Entgelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entgelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                        "entry_id": "a1e1dfed-2b57-3b74-a193-aa7439f8ddb0",
                                        "glosses": [
                                            "die in einem Vertrag vereinbarte Gegenleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a149cd1c-57bf-431c-b6d2-2699b67726b7",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "Das vereinbarte Entgelt wird mit Leistungserbringung fällig."
                                            },
                                            {
                                                "example_id": "af2e1fca-195f-49af-b0c8-39339e5482ba",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "Das Entgelt ist nicht das Geld am Ende eines Monats; sondern eine Entlohnung für die entgeltliche Leistung oder auch produktive Tätigkeit am Tag, die gezahlt wird."
                                            },
                                            {
                                                "example_id": "173ccd57-ad53-4bb2-8cb9-b967b6899967",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "„Er übernahm gegen ein kleines Entgelt die Aufgaben eines Küsters, bereitete die Kirche für die Gottesdienste vor, kümmerte sich um die Kerzen und den Blumenschmuck, räumte die Wege im Kirchhof und läutete die Glocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
