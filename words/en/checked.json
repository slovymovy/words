                        {
                            "text": "Ejective sounds are a common type of <w>checked</w> consonant.",
                            "target_lang_translations": {
                                "ru": "Абруптивные звуки — это распространенный тип <w>глоттализованных</w> согласных."
                            }
                        }
                    ],
                    "synonyms": [
                        "glottalized"
                    ],
                    "antonyms": [
                        "carry-on"
                    ],
                    "common_phrases": [
                        "checked consonant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "phonetics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О согласном звуке: произносимый с сужением голосовой щели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоттализованный",
