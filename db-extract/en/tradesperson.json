                        "sense_id": "ffca8b02-e3b9-3580-87aa-a88d29fe757f",
                        "entry_id": "5cc0a802-95c5-37a1-965f-b8689f392433",
                        "glosses": [
                            "A skilled manual worker."
                        ],
                        "tags": [],
