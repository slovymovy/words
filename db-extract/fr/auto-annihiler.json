                "senses": [
                    {
                        "sense_id": "097aa536-c59f-327e-9de6-cdce260f0b01",
                        "entry_id": "9731537e-27d5-3c55-beac-3cc2a13512c3",
                        "glosses": [
                            "Annihiler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad7da96-5293-4956-b91b-ab1468d796b5",
                                "sense_id": "097aa536-c59f-327e-9de6-cdce260f0b01",
                                "text": "À la longue, particules et antiparticules auraient dû finir par complètement s'auto-annihiler."
                            },
                            {
                                "example_id": "faca45ba-5f4f-4be5-8a0f-7df79b47e059",
                                "sense_id": "097aa536-c59f-327e-9de6-cdce260f0b01",
                                "text": "Mais du coup les deux derniers concepts que je viens d'énoncer pourraient s'auto-annihiler."
                            },
                            {
                                "example_id": "13457d9b-8719-4624-bebf-002212bb71aa",
                                "sense_id": "097aa536-c59f-327e-9de6-cdce260f0b01",
                                "text": "Une ville peut-elle auto-annihiler le bruit qu'elle génère ?"
                            }
                        ]
                    }
