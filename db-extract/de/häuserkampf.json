                ],
                "senses": [
                    {
                        "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                        "entry_id": "ee3edc76-7917-318d-bc60-1ba0a4a9241e",
                        "glosses": [
                            "Auseinandersetzung feindlicher Truppen (innerhalb eines eng bebauten Gebietes) um Häuser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071fe1be-52b4-4df2-851e-6c7ebc2fa64a",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "Häuserkampf ist oft mit großen Verlusten verbunden."
                            },
                            {
                                "example_id": "3228ebd8-2f46-4f5b-9327-0bd8147f5f43",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Während der Häuserkämpfe in Dobrinja hatten die Serben Wohnblocks vermint.“"
                            },
                            {
                                "example_id": "55293dea-2531-4d64-b57e-cf214aed4d4a",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Unter anderem wurden US-Truppen in Camp Doha von MPRI für den Häuserkampf im Irak ausgebildet.“"
                            },
                            {
                                "example_id": "b1a1ddad-5040-45fb-b4e8-f4bfa67fc9d4",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Im Oktober hatte sich die Schlacht in einen Häuserkampf verwandelt, der in den Gerippen von Gebäuden, den Ruinen von Fabriken und Getreidesilos geführt wurde.“"
                            },
                            {
                                "example_id": "6bdc0fb4-0da1-4423-a005-8222736cf68c",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Die Spezialausbildung in Häuserkampf und Kommunikationstechniken besorgen 100 Offiziere aus 14 EU-Staaten, wie Belgien, Malta und Ungarn.“"
                            },
                            {
                                "example_id": "91809a7f-330a-4663-8949-f97b950d7856",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„In erbitterten Häuserkämpfen wehrten sie sich gegen die Einnahme der letzten von Regierungsgegnern gehaltenen Stadt im Westen Libyens.“"
                            },
                            {
                                "example_id": "41c092a5-8885-4fe7-9f22-8a0e2df72ed9",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Der Krieg des Landes ist in Misurata zum Häuserkampf geworden.“"
                            },
                            {
                                "example_id": "c4549d6b-2471-41f1-9bdf-80f5f79d99f4",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„Damit ist klar, dass es sich bei einer möglichen Intervention um Einsätze in dicht besiedeltem Gebiet, militärisch ausgedrückt um Orts- und Häuserkampf, handelt.“"
                            },
                            {
                                "example_id": "0864dea0-1613-463a-86f1-04775fbdb437",
                                "sense_id": "2e68406b-647d-345e-af84-9b024d1efec3",
                                "text": "„So, wie es Augenzeugen beschreiben, versank das Viertel zeitweise im blutigen Chaos, als schwere Häuserkämpfe zwischen marodierenden Soldaten und Guerillakämpfern ausbrachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "611f86a9-a165-35dc-ba4d-887f7ebe1eb4",
                        "entry_id": "ee3edc76-7917-318d-bc60-1ba0a4a9241e",
                        "glosses": [
                            "auf Straßen und Plätzen ausgetragener Kampf, insbesondere um besetzte Häuser"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b9831ed0-0578-47b7-b740-f5901ca003f5",
                                "sense_id": "611f86a9-a165-35dc-ba4d-887f7ebe1eb4",
                                "text": "„Diese meldete bis Einbruch der Dunkelheit fast 90 Fest- und Ingewahrsamnahmen nach regelrechten Straßen- und Häuserkämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
