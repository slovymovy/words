                        "examples": [
                            {
                                "example_id": "9f358622-46c0-4fb1-a935-65ad2c2beeb5",
                                "sense_id": "e62b5ad5-d9c9-3f85-b13b-9a396d645e67",
                                "text": "Ich welchen Chatrooms bist du gerade?"
                            },
                            {
                                "example_id": "c1a9ee75-f426-452f-bac6-16e1cbf01cdb",
                                "sense_id": "e62b5ad5-d9c9-3f85-b13b-9a396d645e67",
                                "text": "„Im Chatroom waren dem teils deutsch, teils englisch angerührten Gequassel dennoch einige Fakten abzulesen.“"
                            },
                            {
                                "example_id": "b1d20148-744a-4635-810a-0717c1db94cb",
                                "sense_id": "e62b5ad5-d9c9-3f85-b13b-9a396d645e67",
                                "text": "„Seit einigen Jahren entwickelt sich unter den Internet- und Handynutzern eine neue Art von sprachlicher Kommunikation: in Chatrooms und per SMS.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
