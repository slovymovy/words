{
    "word_family": [
        "declaration",
        "declarative",
        "declaratory",
        "declarer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ed4b54e-cab7-37ed-9ec3-1c84c33b4e5d",
                    "sense_definition": "Simple past and past participle of <w>declare</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister <w>declared</w> a state of emergency following the disaster.",
                            "target_lang_translations": {
                                "ru": "Премьер-министр <w>объявил</w> чрезвычайное положение после катастрофы.",
                                "zh": "灾难发生后，首相<w>宣布</w>进入紧急状态。"
                            }
                        },
                        {
                            "text": "They <w>declared</w> war on the neighboring country after negotiations failed.",
                            "target_lang_translations": {
                                "ru": "Они <w>объявили</w> войну соседней стране после провала переговоров.",
                                "zh": "谈判破裂后，他们对邻国<w>宣战</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "declared war",
                        "declared independence",
                        "declared bankruptcy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола declare (объявлять, заявлять).",
                        "zh": "动词 declare（宣布、声明、申报）的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявил",
                                "target_lang_sense_clarification": "официально сообщить о чем-либо"
                            },
                            {
                                "target_lang_word": "заявил",
                                "target_lang_sense_clarification": "утвердительно высказаться"
                            },
                            {
                                "target_lang_word": "провозгласил",
                                "target_lang_sense_clarification": "торжественно объявить (например, независимость)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宣布",
                                "target_lang_sense_clarification": "正式向公众表明或通告"
                            },
                            {
                                "target_lang_word": "声明",
                                "target_lang_sense_clarification": "公开表明态度或立场"
                            },
                            {
                                "target_lang_word": "申报",
                                "target_lang_sense_clarification": "向官方或海关等机构报告"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "961b8b84-cad0-3046-acdc-b175c3713cc2",
                    "sense_definition": "Openly stated, admitted, or recognized by the public.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>declared</w> enemy of the current political regime.",
                            "target_lang_translations": {
                                "ru": "Он — <w>открытый</w> враг нынешнего политического режима.",
                                "zh": "他是当今政权的<w>公开</w>敌人。"
                            }
                        },
                        {
                            "text": "You must write the <w>declared</w> value of the item on the shipping label.",
                            "target_lang_translations": {
                                "ru": "Вы должны указать <w>объявленную</w> ценность товара на транспортной этикетке.",
                                "zh": "你必须在运单上填写该物品的<w>申报</w>价值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "avowed",
                        "professed",
                        "stated",
                        "acknowledged"
                    ],
                    "antonyms": [
                        "undeclared",
                        "secret",
                        "unannounced"
                    ],
                    "common_phrases": [
                        "declared value",
                        "declared enemy",
                        "declared candidate",
                        "declared goal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыто заявленный, признанный или объявленный публично.",
                        "zh": "公开表明的，公认的，申报的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявленный",
                                "target_lang_sense_clarification": "о ценности или официальном статусе"
                            },
                            {
                                "target_lang_word": "заявленный",
                                "target_lang_sense_clarification": "о целях или намерениях"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "явный, не скрываемый (например, враг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公开的",
                                "target_lang_sense_clarification": "不加掩饰的、公然的"
                            },
                            {
                                "target_lang_word": "申报的",
                                "target_lang_sense_clarification": "向官方登记或注明的（如价值）"
                            },
                            {
                                "target_lang_word": "公然的",
                                "target_lang_sense_clarification": "毫不隐讳的（如敌人）"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}