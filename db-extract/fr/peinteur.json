                        "glosses": [
                            "Artiste réalisant des motifs décoratifs sur un objet de vaisselle généralement en porcelaine ou en céramique, etc. à partir d’un modèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e820eacd-3560-45d6-9633-9054da221aa0",
                                "sense_id": "33316df9-e948-39c0-949e-b975bc38f692",
                                "text": "Il s’agit là d’une œuvre destinée à l’édition, c’est-à-dire à la reproduction par les peinteuses et peinteurs des ateliers des manufactures ; ce service n’est pas de la main même d’Yvonne Jean-Haffen mais créée à partir de son modèle."
                            },
                            {
                                "example_id": "cb4b459e-3f43-4a0f-af3c-f37b34d52416",
                                "sense_id": "33316df9-e948-39c0-949e-b975bc38f692",
                                "text": "Mikeal Jestin se dit « peinteur » en hommage aux artisans qui peignaient les faïences de Quimper."
                            }
                        ]
                    }
