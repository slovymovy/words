                                "target_senses": [
                                    {
                                        "sense_id": "4dabae97-7089-3a20-9d69-89a4a86b0358",
                                        "entry_id": "dc331c37-3fd2-36c7-a9f5-e1593f9dc88a",
                                        "glosses": [
                                            "Of, belonging or relating to music, or to its performance or notation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcdeff21-febe-4fbb-b638-e17faf0babd2",
                                                "sense_id": "4dabae97-7089-3a20-9d69-89a4a86b0358",
                                                "text": "musical proportion"
                                            },
                                            {
                                                "example_id": "fae2410f-41cb-410f-b025-b4095f9306f6",
                                                "sense_id": "4dabae97-7089-3a20-9d69-89a4a86b0358",
                                                "text": "musical instruments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8910bde0-6b1b-3399-b8d9-2fd09d0730ae",
                                        "entry_id": "dc331c37-3fd2-36c7-a9f5-e1593f9dc88a",
                                        "glosses": [
                                            "Pleasing to the ear; sounding agreeably; having the qualities of music; melodious; harmonious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e8b90c-615c-4d99-89c1-8525c95532c7",
                                                "sense_id": "8910bde0-6b1b-3399-b8d9-2fd09d0730ae",
                                                "text": "She had a musical voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d64e398-3974-37c7-b3aa-9d0000753075",
                                        "entry_id": "dc331c37-3fd2-36c7-a9f5-e1593f9dc88a",
                                        "glosses": [
                                            "Fond of music; discriminating with regard to music; gifted or skilled in music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c892d01b-2e78-4856-8385-102d4e90c917",
                                                "sense_id": "5d64e398-3974-37c7-b3aa-9d0000753075",
                                                "text": "having a musical ear"
                                            },
                                            {
                                                "example_id": "e6074cac-7c49-444b-80b1-9164496224af",
                                                "sense_id": "5d64e398-3974-37c7-b3aa-9d0000753075",
                                                "text": "The child is musical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                        "entry_id": "dc331c37-3fd2-36c7-a9f5-e1593f9dc88a",
                                        "glosses": [
                                            "Pertaining to a class of games in which players move while music plays, but have to take a fixed position when it stops; by extension, any situation where people repeatedly change positions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674c12c9-9cf5-4979-a55c-f6e379725f9c",
                                                "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                                "text": "Musical beds is the faculty sport around here."
                                            },
                                            {
                                                "example_id": "2c40a42e-f57b-4ef4-9b2d-a6f3942f3f83",
                                                "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                                "text": "Musical seats upon an airplane is not a game I recommend."
                                            },
                                            {
                                                "example_id": "3f5cf01f-0453-4a3d-a23c-a4d973c92956",
                                                "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                                "text": "“Sounds like y'all are playing musical houses. How did you convince your mama to move to Austin?”"
                                            },
                                            {
                                                "example_id": "8523557d-1ebe-46e1-8c55-b974df04aa4b",
                                                "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                                "text": "Parties were splitting, forming, merging, and dissolving in such rapid succession that the game of musical chairs seemed to describe what was going on better than any known theory of political science."
                                            },
                                            {
                                                "example_id": "288a8c64-2b96-46c1-a018-578940dd5d08",
                                                "sense_id": "48fadb65-7c97-3e68-a6a9-7affa18374d7",
                                                "text": "Among my small circle of college friends, and even more so among the volunteers here, couples are so often changing places, people playing musical lovers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "musical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e203e1e-4a7e-3eb7-bc92-61a9901146db",
                                        "entry_id": "0a0197bd-53a7-3228-928a-385de7a699fc",
                                        "glosses": [
                                            "A stage performance, show or film that involves singing, dancing and musical numbers performed by the cast as well as acting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdc9ff7-80d5-4f49-b68b-79471f79520b",
                                                "sense_id": "2e203e1e-4a7e-3eb7-bc92-61a9901146db",
                                                "text": "It is unthinkable for a straight play to enjoy a life span like those of the blockbuster musicals or to earn such astronomical grosses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2711a5-2995-3501-b098-d8386e5594cc",
                                        "entry_id": "0a0197bd-53a7-3228-928a-385de7a699fc",
                                        "glosses": [
                                            "A meeting or a party for a musical entertainment; a musicale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
