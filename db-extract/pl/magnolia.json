                    },
                    {
                        "translation_id": "c3066d1c-77a9-4ace-8523-a748300474da",
                        "source_entry_id": "96771fbc-6a06-3d1e-8779-40c1029eb3c8",
                        "source_sense_id": "86d6fe6c-2902-3b8d-b267-a865a77e202e",
                        "target_lang_word": "magnolia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnolia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                        "entry_id": "43c41749-c10b-34d9-8d4a-05dfcce00deb",
                                        "glosses": [
                                            "Arbre d’Amérique et d’Asie, se distinguant par ses larges feuilles et ses fleurs d’une blancheur éclatante, du genre Magnolia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22730df9-00d5-44e6-81b7-ae4f6547212c",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "Il y a le pin d’Italie à écorce rouge avec son majestueux parasol ; il y a un cèdre âgé de deux cents ans, des saules pleureurs, un sapin du Nord, un hêtre qui le dépasse ; puis, en avant de la tourelle principale, les arbustes les plus singuliers, un if taillé qui rappelle quelque ancien jardin français détruit, des magnolias et des hortensias ; enfin, c’est les Invalides des héros de l’horticulture, tour à tour à la mode et oubliés, comme tous les héros."
                                            },
                                            {
                                                "example_id": "9e8dd59e-3886-4abd-86e4-f30caadf91fa",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "Une lune chaude d’août, grandissante, balançait mollement l’ombre du magnolia sur le parquet et le lit blanc répandait une lumière bleue."
                                            },
                                            {
                                                "example_id": "a9f9f462-2415-4b03-96e1-a2e1926461e2",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "Des gisements célèbres du Groenland ont été étudiés par Heer. On y trouvait Noisetiers, Magnolias, Liquidambars, Vignes, Platanes, et des Conifères comme les Cyprès chauves."
                                            },
                                            {
                                                "example_id": "725e6777-973c-4bc2-ba6a-5b405b427b67",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "De sa place, Joseph voyait le long chemin pavé de brique rose qui menait à l’entrée principale de l’Université et, plus près de lui, un grand magnolia dont les feuilles noires se découpaient avec force sur un ciel d’un bleu éclatant."
                                            },
                                            {
                                                "example_id": "90e30c51-d2fe-4e82-9a07-c76bdfd66ee0",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "De l’extrémité nord du parc, les magnolias versent leur odeur qui va de dune en dune jusqu’à rien."
                                            },
                                            {
                                                "example_id": "6bff7960-6b51-4c58-b094-b0621dcf83c8",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "Quand il faisait beau, j’allais après le dîner faire un tour dans le parc ; je respirais, sous la Voie lactée, l’odeur pathétique des magnolias, tout en guettant les étoiles filantes."
                                            },
                                            {
                                                "example_id": "e3e40c93-7dca-43be-9967-26fcb17f5ae3",
                                                "sense_id": "6c725dff-5d54-326e-9c8a-8ad2cf16ea8c",
                                                "text": "Des magnolias par centaines, Des magnolias comme autrefois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
