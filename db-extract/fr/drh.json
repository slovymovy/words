                "senses": [
                    {
                        "sense_id": "4363bdf5-d585-3738-9006-1fde3413167b",
                        "entry_id": "ee5a3aab-e67d-3838-9e93-6875e9e0d8b6",
                        "glosses": [
                            "Directeur des ressources humaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be16fe3-817a-4113-8b35-7e65c0f1f5cc",
                                "sense_id": "4363bdf5-d585-3738-9006-1fde3413167b",
                                "text": "Il est facile d’imaginer que le DRH est la cause de tous les maux en entreprise. Pour certains salariés, harcelés ou pas, c’est la personne qui détient toutes les clés du recrutement, de la promotion et des affectations."
                            },
                            {
                                "example_id": "ac63a1ff-18e7-4a4d-9d4e-18a803b1938b",
                                "sense_id": "4363bdf5-d585-3738-9006-1fde3413167b",
                                "text": "Quand Franck Binoche a fondé Triethic, cet ancien DRH a souhaité être en adéquation avec ses convictions."
                            }
                        ]
