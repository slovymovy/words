                                                "sense_id": "53c543f9-1e27-3d8b-a970-9b82ace6e6d6",
                                                "text": "„Noch dazu musste Cook den schmeichelhaften, aber zeitraubenden Verpflichtungen nachkommen, die seiner wachsenden Berühmtheit geschuldet waren.“"
                                            },
                                            {
                                                "example_id": "728433dd-8567-4360-871b-4e8a45b9ed71",
                                                "sense_id": "53c543f9-1e27-3d8b-a970-9b82ace6e6d6",
                                                "text": "Die Arbeit war sehr zeitraubend."
                                            },
                                            {
                                                "example_id": "9a3da080-b7a1-4be4-bfa7-f402a4974791",
                                                "sense_id": "53c543f9-1e27-3d8b-a970-9b82ace6e6d6",
                                                "text": "Die Durchführung des Tests war zeitraubender, als wir es erwartet hatten."
                                            },
                                            {
                                                "example_id": "56c08ec3-9523-4a13-904f-f60f9e87412e",
                                                "sense_id": "53c543f9-1e27-3d8b-a970-9b82ace6e6d6",
                                                "text": "Am zeitraubendsten war die Auswertung der Umfrage."
                                            }
