                                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                                        "glosses": [
                                            "In a manner that endures pain and hardship without outwardly showing suffering or expressing complaint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b503d150-87fe-4a55-a967-4f6cd6bceb2c",
                                                "sense_id": "babfaea2-0c03-35f3-b966-409d3622f01c",
                                                "text": "Frank Connor look the news stoically and, except for a sudden and nearly unnoticed grimace, with no outward show of emotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d646d0f5-45ae-342f-8bb0-8d961ae2d328",
                                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                                        "glosses": [
                                            "In an unfeeling manner that inwardly is unaffected by pain or distress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79288a3e-30cd-4710-a8ed-6af613aed016",
                                                "sense_id": "d646d0f5-45ae-342f-8bb0-8d961ae2d328",
                                                "text": "Regardless of how involved Carl outwardly appears, inside he holds himself stoically detached."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87c9902d-ce51-3ab4-8707-d48e5f0642cc",
                                        "entry_id": "5b3d04fb-bc98-3f28-a717-df4f91142793",
                                        "glosses": [
                                            "In a manner consistent with the philosophy of stoicism."
