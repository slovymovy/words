                        ],
                        "form": "пятако́м"
                    },
                    {
                        "form_id": "5d7d9505-87b1-4b22-967c-7cd90e674d9b",
                        "entry_id": "995b838f-344c-3f66-bce8-6c84dbf51f8d",
                        "tags": [
                            "plural",
