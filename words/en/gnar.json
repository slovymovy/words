    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "baa21542-ce2c-34dc-aa01-60738f82691b",
                    "sense_definition": "Challenging terrain, snow, or rough waves in board sports such as surfing or snowboarding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every winter, hundreds of skiers travel here to shred the <w>gnar</w>.",
                            "target_lang_translations": {
                                "es": "Cada invierno, cientos de esquiadores viajan hasta aquí para <w>destrozar las pistas más extremas</w>."
                            }
                        },
                        {
                            "text": "We woke up at dawn to hit the <w>gnar</w> before the beaches became crowded.",
                            "target_lang_translations": {
                                "es": "Nos despertamos al amanecer para pillar las <w>olas más salvajes</w> antes de que las playas se llenaran de gente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shred the gnar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Terreno difícil, nieve profunda o terreno/olas extremas en deportes de tabla como el surf o el snowboard."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "terreno extremo",
                                "target_lang_sense_clarification": "en snowboard o esquí"
                            },
                            {
                                "target_lang_word": "olas extremas",
                                "target_lang_sense_clarification": "en surf"
                            },
                            {
                                "target_lang_word": "gnar",
                                "target_lang_sense_clarification": "anglicismo en jerga de deportes extremos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a98a5723-b2e9-33d0-bcab-5c281d703c41",
                    "sense_definition": "Dangerous, difficult, or extreme, often in the context of extreme sports.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That steep mountain descent was totally <w>gnar</w>.",
                            "target_lang_translations": {
                                "es": "Ese descenso empinado de montaña fue totalmente <w>extremo</w>."
                            }
                        },
                        {
                            "text": "The waves today are looking pretty <w>gnar</w> for novice surfers.",
                            "target_lang_translations": {
                                "es": "Las olas de hoy se ven bastante <w>salvajes</w> para surfistas novatos."
                            }
                        }
                    ],
                    "synonyms": [
                        "gnarly"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Peligroso, difícil o extremo, especialmente en el contexto de deportes de acción o extremos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "extremo",
                                "target_lang_sense_clarification": "muy desafiante o peligroso"
                            },
                            {
                                "target_lang_word": "salvaje",
                                "target_lang_sense_clarification": "descontrolado o intenso"
                            },
                            {
                                "target_lang_word": "brutal",
                                "target_lang_sense_clarification": "muy duro o impresionante"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4402152a-650a-3076-b71c-cf4307ae82dc",
                    "sense_definition": "To snarl or growl angrily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vicious dog began to <w>gnar</w> as the stranger approached the gate.",
                            "target_lang_translations": {
                                "es": "El perro feroz comenzó a <w>gruñir</w> cuando el desconocido se acercó a la puerta."
                            }
                        },
                        {
                            "text": "He would pace the room and <w>gnar</w> at anyone who dared interrupt him.",
                            "target_lang_translations": {
                                "es": "Se paseaba por la habitación y le <w>gruñía</w> a cualquiera que se atreviera a interrumpirlo."
                            }
                        }
                    ],
                    "synonyms": [
                        "growl",
                        "snarl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Gruñir con agresividad o mostrar los dientes en tono amenazante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "gruñir",
                                "target_lang_sense_clarification": "emitir sonidos agresivos"
                            },
                            {
                                "target_lang_word": "regañar",
                                "target_lang_sense_clarification": "mostrar los dientes de forma amenazante"
                            }
                        ]
                    }
                }
            ]
        }
    ]
