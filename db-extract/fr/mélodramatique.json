                                "target_senses": [
                                    {
                                        "sense_id": "dd2dce56-6808-33cb-bf98-292e617716fa",
                                        "entry_id": "2c79a662-622d-3de3-9f17-aa92255ba768",
                                        "glosses": [
                                            "Of or pertaining to melodrama; like or suitable to a melodrama; unnatural in situation or action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4d88559-fb29-3bba-890a-d33c7f471111",
                                        "entry_id": "2c79a662-622d-3de3-9f17-aa92255ba768",
                                        "glosses": [
                                            "Exaggeratedly emotional or sentimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f628a22f-6b22-40f6-91bc-32f49e3bd1f6",
                                                "sense_id": "a4d88559-fb29-3bba-890a-d33c7f471111",
                                                "text": "She wrote him a melodramatic letter, threatening to kill herself."
                                            },
                                            {
                                                "example_id": "6be63d0f-d7df-487d-99d9-aa1890710eb6",
                                                "sense_id": "a4d88559-fb29-3bba-890a-d33c7f471111",
                                                "text": "Dearest Eloise,— There is one little and perhaps insignificant French cake, which I feel certain would soon become a favourite in the cottage, more particularly amongst its juvenile inhabitants. It is the famed galette, the melodramatic food of the gamins, galopins, mechanics, and semi-artists of France."
                                            },
                                            {
                                                "example_id": "be942643-6d53-4a89-a965-24478062f2a1",
                                                "sense_id": "a4d88559-fb29-3bba-890a-d33c7f471111",
                                                "text": "In it, the officer insisted he did not depart from NCND and gave a melodramatic account of my \"long pauses\" as I said I needed the story, before I eventually became cooperative and said I had \"seen the light\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
