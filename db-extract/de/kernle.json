                ],
                "senses": [
                    {
                        "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                        "entry_id": "7b288fa0-1cf7-36cc-a2ea-b9adf024163e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f6e0c1-86a4-4e2d-a96f-a73895264dd7",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Frau Kernle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "701b2a91-9d85-4b36-a66f-fdde7c55d36a",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Herr Kernle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "24542fa2-8128-43bd-89fe-ad3a10dab2b5",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Die Kernles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0dfcbbad-1721-4a8c-aa08-1ce7553b67a7",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Der Kernle trägt nie die Pullover, die die Kernle ihm strickt."
                            },
                            {
                                "example_id": "92847e5c-310d-448a-a70e-54e2283b45aa",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kernle kommt, geht der Herr Kernle.“"
                            },
                            {
                                "example_id": "a510a0e4-b128-44f3-80ad-beca34016b26",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Kernle kommt und geht."
                            },
                            {
                                "example_id": "a1052881-64a7-4b6f-82c3-df3e9a6144cd",
                                "sense_id": "5b4405d8-6bab-3d7e-98b5-584ba45930da",
                                "text": "Kernles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
