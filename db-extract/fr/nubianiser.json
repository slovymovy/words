                "senses": [
                    {
                        "sense_id": "93143f3c-73fc-3ef2-a52f-e21ca86127a8",
                        "entry_id": "e16e0057-8c60-37f8-a5b1-a3e7db5b7883",
                        "glosses": [
                            "Donner un caractère nubien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757f3704-4e9b-4626-9079-c06769e7703e",
                                "sense_id": "93143f3c-73fc-3ef2-a52f-e21ca86127a8",
                                "text": "En d’autres termes, « nubianiser » ne signifie pas effacer les différences mais les intégrer au niveau local dans un système global, où les contradictions sont en quelque sorte neutralisées."
                            },
                            {
                                "example_id": "5776b830-c448-498a-b174-87b022ed7462",
                                "sense_id": "93143f3c-73fc-3ef2-a52f-e21ca86127a8",
                                "text": "Les Fedidja, installés de part et d'autre de la frontière actuelle, étaient entourés de groupes arabes nubianisés, et des Kunuz dans les régions les plus excentrées au nord et au sud de l'ancienne Nubie."
                            }
                        ]
                    }
