                "senses": [
                    {
                        "sense_id": "40619a1a-a56d-3cbc-8485-0db9c3fae48c",
                        "entry_id": "a700d156-28b4-37f7-9880-366eeaa4270a",
                        "glosses": [
                            "iets dat als geneesmiddel gebruikt wordt zonder dat daarvoor wetenschappelijk bewijs is en dat zonder recept gekocht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6de4ddf0-c6f9-457c-94cc-817e2beeead1",
                                "sense_id": "40619a1a-a56d-3cbc-8485-0db9c3fae48c",
                                "text": "“In mijn puberteit ben ik wel op dieet geweest. Ik ben opgegroeid tussen volle vrouwen, dus als kind was ik er nooit mee bezig. Maar ik zat op ballet en als ballerina hoor je er slank uit te zien. Ik schrapte de koolhydraten en greep naar huismiddeltjes, zoals citroensap met kaneel. Ik verloor wel wat kilo’s, maar werd niet echt slank.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f9beabaf-8b0a-3c41-b366-9f6cb9a246c8",
                        "entry_id": "a700d156-28b4-37f7-9880-366eeaa4270a",
                        "glosses": [
                            "eenvoudig middeltje dat men gebruikt voor het oplossen van een huishoudelijk probleem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "defa3fbb-7e1b-4a79-a1ea-a86aa674cb85",
                                "sense_id": "f9beabaf-8b0a-3c41-b366-9f6cb9a246c8",
                                "text": "Kun je het beste vertrouwen op de kracht van een hogedrukspuit, vertrouwt u op ouderwetse huismiddeltjes, koopt u in de bootshop een speciaal bootpoetsmiddel of gebruikt u hetzelfde als voor de auto? Of laat u de boot vies worden of juist regelmatig schoonmaken door een professional."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6443c32e-1656-4dcf-9874-3ede942c956d",
                        "source_entry_id": "a700d156-28b4-37f7-9880-366eeaa4270a",
                        "source_sense_id": "40619a1a-a56d-3cbc-8485-0db9c3fae48c",
                        "source_sense_description": "iets dat men zonder bewijs als geneesmiddel gebruikt",
                        "target_lang_word": "Hausmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                        "entry_id": "6f5a9999-13f9-3505-99cc-e96a8dfa569d",
                                        "glosses": [
                                            "Heilmittel oder Heilverfahren, das durch den Volksmund oder Ratgeber weitergegeben wird und nicht notwendigerweise wissenschaftlich untersucht wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5868b6cb-56fd-4c7d-8022-c427874fc1b2",
                                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                                "text": "„Streichen Sie auf Verbrennungen keine Cremen oder Hausmittel wie etwa Mehl oder Melkfett.“"
                                            },
                                            {
                                                "example_id": "73f51e0e-970d-4a45-867d-5d154b5c3acd",
                                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                                "text": "Omas Hausmittel haben mir schon öfters geholfen."
                                            },
                                            {
                                                "example_id": "5e6a1d57-8c60-48c1-b65d-7bf1c579e7b2",
                                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                                "text": "„Doch es gab ja dieses alte Hausmittel, das Auge mit Wasser aus einer Pfütze mit still stehendem Wasser auszuwaschen, und das tat er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a89961-05e2-4adf-8316-ac155d4cbb95",
                        "source_entry_id": "a700d156-28b4-37f7-9880-366eeaa4270a",
