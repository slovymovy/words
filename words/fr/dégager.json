                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le défenseur central a préféré <w>dégager</w> en touche pour éviter de concéder un but."
                        },
                        {
                            "text": "Le gardien <w>dégage</w> loin devant vers ses attaquants en fin de partie."
                        }
                    ],
                    "common_phrases": [
                        "dégager en touche",
                        "dégager le ballon"
                    ]
                },
                {
                    "sense_id": "8332e656-405c-3e62-be28-4c93ab1fc112",
                    "sense_definition": "Faire ressortir, déduire ou faire apparaître clairement un élément à partir d'une analyse ou d'une observation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
