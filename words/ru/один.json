                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Бог <w>Один</w> пожертвовал своим глазом ради мудрости.",
                            "target_lang_translations": {
