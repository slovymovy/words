                                "target_senses": [
                                    {
                                        "sense_id": "31b48c30-fd7a-3637-9a82-a3111be46857",
                                        "entry_id": "57632da0-bf2e-33ac-aca9-c36a3c1abe2c",
                                        "glosses": [
                                            "Something assumed without proof as being self-evident or generally accepted, especially when used as a basis for an argument. Sometimes distinguished from axioms as being relevant to a particular science or context, rather than universally true, and following from other axioms rather than being an absolute assumption."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8317c9a-3743-3087-9b3b-a72ee594a74f",
                                        "entry_id": "57632da0-bf2e-33ac-aca9-c36a3c1abe2c",
                                        "glosses": [
                                            "A fundamental element; a basic principle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3149a3b1-4254-38ae-9849-51d792a5a3f5",
                                        "entry_id": "57632da0-bf2e-33ac-aca9-c36a3c1abe2c",
                                        "glosses": [
                                            "An axiom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c8589f2-fe93-3f7f-9b35-50d39982d577",
                                        "entry_id": "57632da0-bf2e-33ac-aca9-c36a3c1abe2c",
                                        "glosses": [
                                            "A requirement; a prerequisite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "postulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8281ccf-c292-36ee-b246-dc818c7463cf",
                                        "entry_id": "239dca61-ecde-3ae6-b03b-847bff96c64a",
                                        "glosses": [
                                            "To assume as a truthful or accurate premise or axiom, especially as a basis of an argument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1cd8ba-fb69-4c42-80ab-41563115bb67",
                                                "sense_id": "a8281ccf-c292-36ee-b246-dc818c7463cf",
                                                "text": "1883, Benedictus de Spinoza, translated by R. H. M. Elwes, Ethics, Part 3, Prop. XXII,\nBut this pleasure or pain is postulated to come to us accompanied by the idea of an external cause; […]"
                                            },
                                            {
                                                "example_id": "bbdc0e7e-476b-41c8-9f4f-4d10f6d861d2",
                                                "sense_id": "a8281ccf-c292-36ee-b246-dc818c7463cf",
                                                "text": "[T]he attempt to arrive at a physical explanation of existence led the Ionian thinkers to postulate various primal elements or simply the infinite τὸ ἀπειρον."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a86ea1f-224d-3abe-83b5-7c39b0b2097e",
                                        "entry_id": "239dca61-ecde-3ae6-b03b-847bff96c64a",
                                        "glosses": [
                                            "To appoint or request one's appointment to an ecclesiastical office."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b065f8da-c163-4ad0-a88f-344cb8cb33f2",
                                                "sense_id": "3a86ea1f-224d-3abe-83b5-7c39b0b2097e",
                                                "text": "[A]lthough Douglas was postulated to it [the Abbacy of Arbroath], and signed letters and papers under this designation his nomination […] was never completed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c89fff4-4ef4-3063-b07e-49b78d997fc1",
                                        "entry_id": "239dca61-ecde-3ae6-b03b-847bff96c64a",
                                        "glosses": [
                                            "To request, demand or claim for oneself."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "postulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7bdc9d-2459-3283-ba00-3cf250a9d9bc",
                                        "entry_id": "346cc872-d3f4-3fa7-b60f-e7fffc15ca97",
                                        "glosses": [
                                            "Postulated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96aecda-dfc3-4f26-bfac-68c34fd51fc0",
                                                "sense_id": "4b7bdc9d-2459-3283-ba00-3cf250a9d9bc",
                                                "text": "postulate Illation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "960c1318-f7cf-48c8-8d6e-45d47b6fa333",
                        "source_entry_id": "8fd7e9e9-dbd5-3eda-a987-90a2672065db",
                        "source_sense_id": "28ff2097-8c2c-3be1-846d-8f6139c87616",
                        "source_sense_description": "утверждение, принимаемое без доказательств",
                        "target_lang_word": "Postulat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postulat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13f54805-3211-3784-b245-b8da86748b42",
                                        "entry_id": "0258cb88-759c-3ddf-a867-c951f29c8ddf",
                                        "glosses": [
                                            "eine Forderung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71735eb4-a6f2-32e1-af50-d0c26daa7428",
                                        "entry_id": "0258cb88-759c-3ddf-a867-c951f29c8ddf",
                                        "glosses": [
                                            "eine nicht streng beweisbare, aber zur Erklärung eines Tatbestandes geforderte Annahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f584cef-4af3-4f26-aeb4-ee82fba2d68f",
                                                "sense_id": "71735eb4-a6f2-32e1-af50-d0c26daa7428",
                                                "text": "„Nach Kant sind in der Philosophie das Dasein Gottes, die Unsterblichkeit der Seele und die Willensfreiheit notwendige Postulate.“"
                                            },
                                            {
                                                "example_id": "bcc86bcd-062a-433d-8286-f7c519c3bcf0",
                                                "sense_id": "71735eb4-a6f2-32e1-af50-d0c26daa7428",
                                                "text": "„Die Spracherwerbsforschung hat sich aber noch vielerorts an die Postulate und Metasprache der Chomsky-Schule gehalten, was nicht selten zur Folge hatte, daß derselbe theoretische Rahmen mit jeweils passenden Beispielen aus verchiedenen Sprachen ausgefüllt wurde.“"
                                            },
                                            {
                                                "example_id": "8f3ecc1c-1fb8-44cd-b120-401411224d74",
                                                "sense_id": "71735eb4-a6f2-32e1-af50-d0c26daa7428",
                                                "text": "„Dem folgenden Abschnitt ist es vorbehalten zu prüfen, ob auch umgekehrt ethische Postulate aus der Wissenschaft abgeleitet werden können.“"
                                            },
                                            {
                                                "example_id": "0cc3c642-046e-4baf-ad46-b482f4953797",
                                                "sense_id": "71735eb4-a6f2-32e1-af50-d0c26daa7428",
                                                "text": "„Nach dem Postulat der Freiheit, das unmittelbar aus dem moralischen Gesetz folgt, und dem weiteren Postulat der Unsterblichkeit der Seele ist es das Postulat der Existenz eines Gottes, das gemäß der Einteilung der metaphysischen Ideen in Psychologie, Kosmologie und Theologie den Umkreis und Inhalt der intelligiblen Welt vollendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5de49c53-eae0-370f-b70a-a6df4538a147",
                                        "entry_id": "0258cb88-759c-3ddf-a867-c951f29c8ddf",
                                        "glosses": [
                                            "die erste Probezeit nach Eintritt in einen Orden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786da6ea-643f-4736-86f0-c7fbcacc5572",
                                                "sense_id": "5de49c53-eae0-370f-b70a-a6df4538a147",
                                                "text": "„Nach dem Postulat verließ sie den Orden wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0a313827-da8e-3fd5-914d-708f1573427a",
                                        "entry_id": "0258cb88-759c-3ddf-a867-c951f29c8ddf",
                                        "glosses": [
                                            "schriftlich eingereichte Anregung im Bundesparlament, einem Kantons- oder einem Gemeindeparlament zu Händen der Regierung"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1eff95-ebb7-4b38-be89-72d560909f4e",
                                                "sense_id": "0a313827-da8e-3fd5-914d-708f1573427a",
                                                "text": "„Dr. Cadrari hat im Bündner Grossen Rat ein Postulat eingereicht, das den wintersicheren Ausbau der Lukmanierstrasse fordert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60bb487b-f804-45ee-857c-aff79a5ebfaa",
                        "source_entry_id": "8fd7e9e9-dbd5-3eda-a987-90a2672065db",
                        "source_sense_id": "28ff2097-8c2c-3be1-846d-8f6139c87616",
                        "source_sense_description": "утверждение, принимаемое без доказательств",
                        "target_lang_word": "Forderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                        "entry_id": "824cf083-c4a4-3e79-aeeb-d27ccb14a8f7",
                                        "glosses": [
                                            "dringender Wunsch, Begehren, Verlangen, insbesondere auch ein finanzieller Anspruch an einen Dritten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e1452b-d9cc-4158-b8fe-8170afb28452",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "Der Forderung nach höheren Zinsen wurde von der Bank natürlich nicht stattgegeben."
                                            },
                                            {
                                                "example_id": "7c971d3a-b74d-4f26-aa1b-893b88972936",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "Forderungen bucht man per Soll."
                                            },
                                            {
                                                "example_id": "50d2c8aa-9032-41c9-bb45-0b2e6b8f30f4",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "„Wenn man derzeit von Forderungen liest, auch den Fachhochschulen das Promotionsrecht einzuräumen, kann man sich die Ergebnisse vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                        "entry_id": "824cf083-c4a4-3e79-aeeb-d27ccb14a8f7",
                                        "glosses": [
                                            "das zum Duell Aufrufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131b0655-02f3-4483-92e1-20b0da87398e",
                                                "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                                "text": "Die Forderung auf Pistolen schockierte den Grafen."
                                            },
                                            {
                                                "example_id": "83126dde-050f-4de8-a61c-a14ffd19f965",
                                                "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                                "text": "Eigentlich hat man kein Recht, eine Forderung abzulehnen, aber man kann sich aus der Affäre ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b36c8fdd-2bb4-3399-893e-99e126a4ef61",
                                        "entry_id": "824cf083-c4a4-3e79-aeeb-d27ccb14a8f7",
