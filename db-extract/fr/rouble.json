                                "target_senses": [
                                    {
                                        "sense_id": "9cec666c-a821-3181-bc90-eace336c2355",
                                        "entry_id": "a76ef298-dc6e-30ef-bc08-a50a32372b30",
                                        "glosses": [
                                            "waluta Rosji i niektórych krajów dawniej wchodzących w skład ZSRR, wcześniej używana w Cesarstwie Rosyjskim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73fadb1-55a2-4087-a2f0-c93dd8bca3ff",
                                                "sense_id": "9cec666c-a821-3181-bc90-eace336c2355",
                                                "text": "Ilu rublom odpowiada jeden dolar?"
                                            },
                                            {
                                                "example_id": "15b905fb-e41b-41ab-a244-860170f42b46",
                                                "sense_id": "9cec666c-a821-3181-bc90-eace336c2355",
                                                "text": "Oddać w banku osiemset rubli, aha… Do Lublina wysłać trzy albumy, tuzin portmonetek… Właśnie!… Do Wiednia przekaz na tysiąc dwieście guldenów… Z kolei odebrać transport… Zmonitować rymarza za nieodesłanie walizek… Bagatela!… Napisać list do Stasia… Bagatela…"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1407ebc1-04ab-4247-9905-64d1f4ccfc38",
                        "source_entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                        "source_sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
                        "target_lang_word": "рубль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рубль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1d1d21-d283-387e-bb68-110bfde8ad07",
                                        "entry_id": "dd1885d2-ee07-3b8c-813d-6adebfc61abf",
                                        "glosses": [
                                            "денежная единица СССР, России и некоторых других стран"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d6b245-73df-415f-a368-0c996bfbe913",
                                                "sense_id": "5d1d1d21-d283-387e-bb68-110bfde8ad07",
                                                "text": "Рубль состоит из 100 копеек."
                                            },
                                            {
                                                "example_id": "e84124d1-edc5-489d-838b-a39c65d19201",
                                                "sense_id": "5d1d1d21-d283-387e-bb68-110bfde8ad07",
                                                "text": "А пристав у них был Павел Скрябин; дано ему государево жалованье сто рублёв денег."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc2d22c-844b-3b54-a962-4f5cb21ef12f",
                                        "entry_id": "dd1885d2-ee07-3b8c-813d-6adebfc61abf",
                                        "glosses": [
                                            "некоторая сумма денег"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1402b4c4-2027-4c3c-a9cb-276a1b83cf04",
                                                "sense_id": "fbc2d22c-844b-3b54-a962-4f5cb21ef12f",
                                                "text": "А всё потому, что наш гражданин по-прежнему не ощущает, что он содержит своё государство. А это значит не только платить налоги, но и иметь право спросить: где мой рубль?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40485f44-f227-3573-b91a-b72b3dc6ad77",
                                        "entry_id": "dd1885d2-ee07-3b8c-813d-6adebfc61abf",
                                        "glosses": [
                                            "разг. тысяча рублей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "505a4906-8ef2-43d7-9774-16ab81bc52f4",
                                                "sense_id": "40485f44-f227-3573-b91a-b72b3dc6ad77",
                                                "text": "Слышал, за УАЗик нынче дают 50 рублей?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae46b2b-6cbb-364a-a8d6-134769b82142",
                                        "entry_id": "dd1885d2-ee07-3b8c-813d-6adebfc61abf",
                                        "glosses": [
                                            "разг. курс рубля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1325edb-16b5-468e-bb3a-afd9d1a114bc",
                                                "sense_id": "bae46b2b-6cbb-364a-a8d6-134769b82142",
                                                "text": "А поскольку после девальвации рубль упал в четыре раза, то рублевая выручка наших компаний увеличилась в восемь раз."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
