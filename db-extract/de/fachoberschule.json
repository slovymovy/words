                "senses": [
                    {
                        "sense_id": "46580eaf-ef2a-34ba-b9dc-b8cee9bbc59e",
                        "entry_id": "d3a3db10-af3b-340d-bd0b-a36e19584ecb",
                        "glosses": [
                            "École secondaire orientée vers certaines matières, menant à un diplôme permettant l’admission dans un établissement d’enseignement supérieur au cursus technique ou artistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df55b7a0-c948-4728-a582-140baefee3d4",
                                "sense_id": "46580eaf-ef2a-34ba-b9dc-b8cee9bbc59e",
                                "text": "Das Konzept der Fachoberschule wurde im Jahr 1969 infolge von Studentenprotesten in den 1960er Jahren, die in der 68er-Bewegung gipfelten, außer in Baden-Württemberg bundesweit neu beschlossen.",
                                "translation": "Le concept de l’école supérieure orientée métiers fut décidé en 1969 à l’échelle fédérale, à l’exception du land du Bade-Wurtemberg, à la suite de protestations étudiantes dans les années 1960 qui culminèrent dans le mouvement de 1968."
                            }
                        ]
                    }
                ],
