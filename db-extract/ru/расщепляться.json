                                    },
                                    {
                                        "sense_id": "41597d0c-8a55-3b53-aea8-829cc04bd6ae",
                                        "entry_id": "cfa7acc7-b67e-3977-9baf-f35374f7a22c",
                                        "glosses": [
                                            "Écarter les jambes de manière à porter en avant un pied loin de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cd145d-320a-46ce-86d7-b0aac098b34d",
                                                "sense_id": "41597d0c-8a55-3b53-aea8-829cc04bd6ae",
                                                "text": "Fendez-vous !"
                                            },
                                            {
                                                "example_id": "3abb9a8b-af13-494f-90ac-d0d4abab56c5",
                                                "sense_id": "41597d0c-8a55-3b53-aea8-829cc04bd6ae",
                                                "text": "— Rompez toujours, ne vous fendez jamais, je ne pourrai vous tuer.\nIl disait ces mots de très bonne foi ; il parlait en maître d’armes."
                                            },
                                            {
                                                "example_id": "9a42cfb2-fe2c-4954-a9e8-42af02890df2",
                                                "sense_id": "41597d0c-8a55-3b53-aea8-829cc04bd6ae",
                                                "text": "Mais il pensa tout à coup à l’attitude qu’on prend quand on se fend pour donner un coup de pointe dans les règles, le bras droit tendu, la tête effacée contre l’épaule droite, le bras gauche allongé contre la cuisse, l’épaule gauche effacée."
                                            }
                                        ]
                                    }
                                ]
                            }
