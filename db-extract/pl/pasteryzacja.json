                                        "glosses": [
                                            "ein Verfahren, bei dem Lebensmittel erhitzt werden, um gefährliche Mikroorganismen unschädlich zu machen"
                                        ],
                                        "tags": [
                                            "Lebensmittelchemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec126fe8-601d-4f81-bb24-c81dc088fb39",
                                                "sense_id": "25d23451-a165-3643-bb11-130bfe8775f7",
                                                "text": "Die Pasteurisierung von Milchprodukten ist notwendig, damit schädliche Bakterien abgetötet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6bd1167-e3b3-480c-8a81-96ab6b6d9a9b",
                        "source_entry_id": "2385e223-701e-371b-9c02-81c9f3d7ff4a",
