{
    "word_family": [
        "erratically",
        "erraticism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                    "sense_definition": "Unsteady, random; prone to unexpected changes; not consistent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpredictable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student showed <w>erratic</w> progress throughout the semester.",
                            "target_lang_translations": {
                                "zh": "这名学生整个学期的进步都非常<w>不稳定</w>。"
                            }
                        },
                        {
                            "text": "His <w>erratic</w> behavior made it difficult to predict his next move.",
                            "target_lang_translations": {
                                "zh": "他那<w>反复无常</w>的行为让人很难预测他下一步会做什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mercurial"
                    ],
                    "antonyms": [
                        "consistent"
                    ],
                    "common_phrases": [
                        "erratic behavior",
                        "erratic performance"
                    ],
                    "target_lang_definitions": {
                        "zh": "不稳定的，随机的；容易发生意想不到的变化；不连贯的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不稳定",
                                "target_lang_sense_clarification": "指状态或表现缺乏稳定性。"
                            },
                            {
                                "target_lang_word": "反复无常",
                                "target_lang_sense_clarification": "指行为或情绪变化多端，难以预测。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e712705-6764-39b3-b0b1-8a4e436d810c",
                    "sense_definition": "Deviating from normal opinions or actions; eccentric; odd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unpredictable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist was known for his <w>erratic</w> lifestyle and strange habits.",
                            "target_lang_translations": {
                                "zh": "这位艺术家以其<w>古怪</w>的生活方式和奇怪的习惯而闻名。"
                            }
                        },
                        {
                            "text": "She was criticized for her <w>erratic</w> conduct during the formal meeting.",
                            "target_lang_translations": {
                                "zh": "她因在正式会议期间的<w>离经叛道</w>的表现而受到批评。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "erratic conduct"
                    ],
                    "target_lang_definitions": {
                        "zh": "偏离正常观点或行为的；古怪的；离奇的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "古怪",
                                "target_lang_sense_clarification": "指行为方式异于常人。"
                            },
                            {
                                "target_lang_word": "离经叛道",
                                "target_lang_sense_clarification": "指行为偏离常规或传统。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                    "sense_definition": "A rock moved from one location to another, usually by a glacier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large boulder in the field is a glacial <w>erratic</w>.",
                            "target_lang_translations": {
                                "zh": "田野里的那块巨石是一块冰川<w>漂砾</w>。"
                            }
                        },
                        {
                            "text": "Geologists studied the <w>erratic</w> to determine the path of the ancient glacier.",
                            "target_lang_translations": {
                                "zh": "地质学家研究了这块<w>漂砾</w>以确定古冰川的路径。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dropstone"
                    ],
                    "common_phrases": [
                        "glacial erratic"
                    ],
                    "target_lang_definitions": {
                        "zh": "由冰川等力量从他处搬运而来的漂砾。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漂砾",
                                "target_lang_sense_clarification": "地质学术语，指冰川搬运的巨大岩石。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4e732f7-ba71-3732-abd1-5409ff6e5fae",
                    "sense_definition": "Anything that has erratic characteristics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine was considered an <w>erratic</w> in the otherwise stable production line.",
                            "target_lang_translations": {
                                "zh": "在原本稳定的生产线上，这台机器被视为一个<w>异常事物</w>。"
                            }
                        },
                        {
                            "text": "Identifying every <w>erratic</w> in the data set is crucial for accurate analysis.",
                            "target_lang_translations": {
                                "zh": "识别数据集中每一个<w>异常值</w>对于准确分析至关重要。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "具有不稳定或异常特征的事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "异常事物",
                                "target_lang_sense_clarification": "指在整体系统中表现出不规律特征的个体。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}