                        "entry_id": "7d85a7ac-98eb-30ad-b001-2f323c8f967d",
                        "glosses": [
                            "Pâtisson (légume) de taille nettement plus petite que les pâtissons ordinaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fc638a-a4c5-4caa-8109-6b5b3b9c8524",
                                "sense_id": "f05dfac7-b514-3637-b09a-552930ddf2a2",
                                "text": "Soucoupe volante mimi, le mini-pâtisson d’été s’enfile en brochette, badigeonné d’une marinade à l’huile d’olive, vinaigre balsamique, purée de tomates séchées, poivre de Sarawak, ail et persil hachés."
                            },
                            {
                                "example_id": "54f7c469-ee8a-44dd-b7ad-69cb236c683e",
                                "sense_id": "f05dfac7-b514-3637-b09a-552930ddf2a2",
                                "text": "La gamme de la coopérative compte une soixantaine de référence, du mini-romanesco en passant par le mini-poivron et le mini-pâtisson."
                            },
                            {
                                "example_id": "f326a4b5-3a80-4de1-b6e1-877b85967308",
                                "sense_id": "f05dfac7-b514-3637-b09a-552930ddf2a2",
                                "text": "Artiste en cuisine, il vous suffit d’un coup de pinceau crémeux pour habiller de simples mini-pâtissons."
                            }
                        ]
                    }
