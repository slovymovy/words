                "senses": [
                    {
                        "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                        "entry_id": "4a0436b8-18cf-35a0-8d6f-d23fbf4f7d23",
                        "glosses": [
                            "durch ein Messer hervorgerufene Verletzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d952a367-69c8-4557-a189-f585cf3bf5a5",
                                "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                                "text": "„Ein US-Tourist hat versucht, konservierte Körperteile aus Thailand mit der Post nach Hause zu schicken – darunter ein Kinderkopf, ein Babyfuß und ein Herz mit einer Messerwunde.“"
                            },
                            {
                                "example_id": "d688b4f2-d85a-4f36-8bb2-2d8cb2293353",
                                "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                                "text": "„Das blutende Opfer kommt mit Messerwunden in eine Klinik, ihm wird in einer Not-OP das Leben gerettet.“"
                            },
                            {
                                "example_id": "1ed8459d-d245-40bc-b7c5-3843c1d44fb3",
                                "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                                "text": "„Die Polizeigewerkschaft forderte zudem, dass die Krankenhäuser jede Messerwunde der Polizei mitteilen.“"
                            },
                            {
                                "example_id": "95b73302-be9f-42df-b8dd-175ec32766bc",
                                "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                                "text": "„Die Chirurgen im Hafenkrankenhaus sind Spezialisten für Messerwunden.“"
                            },
                            {
                                "example_id": "7870f138-2c59-4b1e-856d-6596e2da74de",
                                "sense_id": "d73df7ca-cfd0-3457-989d-b2ad8beada4c",
                                "text": "„Im Fall einer Messerwunde handelt es sich um glatte Wundränder, die sehr gut verheilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
