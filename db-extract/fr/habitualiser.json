                "senses": [
                    {
                        "sense_id": "ba38eb2a-4d04-341b-a163-b13029bee807",
                        "entry_id": "cfa8b12b-bb85-3388-884a-a9337396d9bb",
                        "glosses": [
                            "Donner un caractère habituel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12625e24-b783-44c2-974b-d0a660e659fe",
                                "sense_id": "ba38eb2a-4d04-341b-a163-b13029bee807",
                                "text": "La fonction de l’image religieuse consiste donc à habitualiser une forme de vie en mobilisant en sa faveur l’énergie des affects."
                            },
                            {
                                "example_id": "d7a2940f-7ac3-4d57-951c-4ac8a698fa09",
                                "sense_id": "ba38eb2a-4d04-341b-a163-b13029bee807",
                                "text": "Et s’il est des situations-limites, comme celle des transmissions radio, où le contrôle réciproque de la conversation est codifié (« Allô », « Untel à Untel », « Terminé », etc.), on sait que ces codes ne tardent pas à être intégrés à leur tour sur le mode « passif », comme dit Husserl, c’est-à-dire qu’ils se laissent habitualiser."
                            }
                        ]
                    }
                ],
