                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrekcja przeoczyła <w>stulecie</w> szkoły i nie zorganizowała żadnej uroczystości.",
                            "target_lang_translations": {
                                "ru": "Дирекция пропустила <w>столетие</w> школы и не организовала никакого торжества.",
                                "en": "The administration overlooked the school's <w>centenary</w> and did not organize any celebration.",
                                "nl": "De directie zag het <w>eeuwfeest</w> van de school over het hoofd en organiseerde geen enkele viering.",
                                "de": "Die Schulleitung übersah das <w>hundertjährige Jubiläum</w> der Schule und organisierte keinerlei Feier.",
                                "fr": "La direction a manqué le <w>centenaire</w> de l'école et n'a organisé aucune cérémonie.",
                                "it": "La direzione ha trascurato il <w>centenario</w> della scuola e non ha organizzato alcuna celebrazione.",
                                "cs": "Vedení přehlédlo <w>sté výročí</w> školy a nezorganizovalo žádnou oslavu.",
                                "tr": "Yönetim, okulun <w>yüzüncü yılını</w> gözden kaçırdı ve hiçbir kutlama düzenlemedi.",
                                "es": "La dirección pasó por alto el <w>centenario</w> de la escuela y no organizó ninguna celebración.",
                                "zh": "管理层忽略了学校建校<w>百周年</w>，没有组织任何庆祝活动。"
                            }
                        },
                        {
                            "text": "Na <w>stulecie</w> odzyskania niepodległości zaplanowano wielką paradę wojskową.",
                            "target_lang_translations": {
                                "ru": "На <w>столетие</w> восстановления независимости запланирован большой военный парад.",
                                "en": "A large military parade was planned for the <w>centenary</w> of regaining independence.",
                                "nl": "Voor de <w>eeuwherdenking</w> van het herwinnen van de onafhankelijkheid was er een grote militaire parade gepland.",
                                "de": "Zum <w>hundertsten Jahrestag</w> der Wiedererlangung der Unabhängigkeit wurde eine große Militärparade geplant.",
                                "fr": "Pour le <w>centenaire</w> du recouvrement de l'indépendance, un grand défilé militaire a été prévu.",
                                "it": "Per il <w>centenario</w> del ripristino dell'indipendenza è stata programmata una grande parata militare.",
                                "cs": "Ke <w>stému výročí</w> znovuzískání nezávislosti byla naplánována velká vojenská přehlídka.",
                                "tr": "Bağımsızlığın yeniden kazanılmasının <w>yüzüncü yılı</w> için büyük bir askeri geçit töreni planlandı.",
                                "es": "Para el <w>centenario</w> de la recuperación de la independencia, se planeó un gran desfile militar.",
                                "zh": "为庆祝恢复独立<w>百年纪念</w>，计划举行一场盛大的阅兵式。"
                            }
                        }
