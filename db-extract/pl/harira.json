                                        "entry_id": "658fcbf8-cddf-3f88-ae3e-fcfaf82df36c",
                                        "glosses": [
                                            "A thickened, tomato-based North African soup, popular during Ramadan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862665a1-e78a-4968-90dd-f5ff9e720333",
                                                "sense_id": "99cf1d17-8458-3672-882e-de9120178bdf",
                                                "text": "Like most hariras, this Berber version is finished off with a thickening agent to develop the proper velvety texture."
                                            },
                                            {
                                                "example_id": "bfb271ff-7155-412f-9bba-285d6078e59a",
                                                "sense_id": "99cf1d17-8458-3672-882e-de9120178bdf",
                                                "text": "Every family makes its own version of harira. [...] The only must-have is yeast. This is traditional for harira, giving it some oomph [...]. I've since seen harira recipes with lamb, with chicken, with eggs."
                                            }
                                        ]
                                    }
