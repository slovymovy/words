                    {
                        "sense_id": "60104b62-5bdb-3b76-b522-786aaf9b1239",
                        "entry_id": "fd685566-f5a5-3f8d-b323-46f944e00117",
                        "glosses": [
                            "Abîmer ou salir."
                        ],
                        "tags": [
                            "Lyon"
                        ],
                        "examples": [
                            {
                                "example_id": "cd4051c0-354f-4487-a9f7-31cc99974468",
                                "sense_id": "60104b62-5bdb-3b76-b522-786aaf9b1239",
                                "text": "Allez, chenapans ! n'avez-vous pas assez de place, assez d'allées, assez d'arbres ? N'avez-vous pas assez de fleurs à marpailler ?"
                            },
                            {
                                "example_id": "cc3029fd-6e35-4740-af0d-c410019729e4",
                                "sense_id": "60104b62-5bdb-3b76-b522-786aaf9b1239",
                                "text": "Je vais te marpailler le portrait, et te mettre une branlée, à te faire petafiner."
                            }
                        ]
                    }
