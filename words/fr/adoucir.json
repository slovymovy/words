                            {
                                "target_lang_word": "sweeten",
                                "target_lang_sense_clarification": "food, drinks, or sauces"
                            },
                            {
                                "target_lang_word": "mellow",
                                "target_lang_sense_clarification": "bitterness in coffee or wine"
                            }
                        ],
                        "ru": [
