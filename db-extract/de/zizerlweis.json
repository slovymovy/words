                        "examples": [
                            {
                                "example_id": "ea9ba810-1683-4080-988d-a9a901b0e58b",
                                "sense_id": "67582ccc-c94c-3a59-8068-33281c92468b",
                                "text": "„Schulexperten forderten indessen rasche Schritte statt »zizerlweiser« Veränderungen.“"
                            },
                            {
                                "example_id": "fc803974-4f0c-42f2-b153-00bb72bbf187",
                                "sense_id": "67582ccc-c94c-3a59-8068-33281c92468b",
                                "text": "„Ich will das jetzt gar nicht weiter auswalzen, wie sich der Herr Minister Lacina in der Folge dann gewunden hat, wie er dieses Treffen dementiert hat, wie er offentsichtliche [sic!] Gedächtnislücken gehabt hat, wie er dann zizerlweis das eine und das andere zugegeben hat, bis er sich auf die Formel zurückgezogen hat: Jetzt sage ich überhaupt nichts mehr!“"
                            },
                            {
                                "example_id": "d0fc8069-8b57-4f01-811f-804ab48aa843",
                                "sense_id": "67582ccc-c94c-3a59-8068-33281c92468b",
                                "text": "„Nach Marins Vorstellungen könnte die Harmonisierung für alle gelten und das sofort: »Es muss alle treffen, aber zizerlweise.«“"
                            },
                            {
                                "example_id": "84041c19-d405-4e12-9228-f6b8ca84a49a",
                                "sense_id": "67582ccc-c94c-3a59-8068-33281c92468b",
                                "text": "„Das mussten in den letzten Tagen Personen schmerzlich erkennen, die sich um einen Ausweg aus diesem Dilemma bemühten, indem sie das Rauschen von Party zu Party mutig als Ursache juveniler Zeugungsunlust anprangerten, beziehungsweise mit zizerlweiser Zuwanderung drohten, sollte die innere Einkehr bei Party-Abstinenz keine staatsbürgerlichen Früchte tragen.“"
                            },
                            {
                                "example_id": "feeacba6-f16e-48bf-b800-79780885341c",
                                "sense_id": "67582ccc-c94c-3a59-8068-33281c92468b",
                                "text": "„Nach langen Jahren der zizerlweisen punktuellen Maßnahmen bekommt das Weltmuseum Wien jetzt mehr als nur ein Face-Lifting um 27,5 Mio. € …“"
                            }
                        ],
