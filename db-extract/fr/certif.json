                        "entry_id": "c421c568-92fd-3314-a059-8105e0ed304a",
                        "glosses": [
                            "Certificat d’études (diplôme français)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "193569ba-1474-4a0e-bdc9-97a1a2be14a9",
                                "sense_id": "de270cdc-009b-39b8-9524-daa05c9c3733",
                                "text": "Au certif, j’ai eu 97 points sur 100…"
                            },
                            {
                                "example_id": "e1527cdf-7ad6-40a7-b55d-01ba50e99381",
                                "sense_id": "de270cdc-009b-39b8-9524-daa05c9c3733",
                                "text": "Il s’était couché, fier d’avoir tenu tête aux polytechniciens sur des questions d’histoire et de géo, lui dont les seuls diplômes se résumaient au certif et au prix de solfège de l’école de musique fourassienne."
                            },
                            {
                                "example_id": "700fc613-a421-4f6f-ad82-e2b1be5119f2",
                                "sense_id": "de270cdc-009b-39b8-9524-daa05c9c3733",
                                "text": "Personne ne m’a jamais demandé pour quoi j’étais tombé, on formait une bonne équipe, et au final on a tous obtenu le certif."
                            }
                        ]
                    }
