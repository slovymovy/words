                "senses": [
                    {
                        "sense_id": "c37485ac-b05a-3fb2-b5aa-d3c0afc90e02",
                        "entry_id": "372a8110-14e0-3a59-a8f0-53fe5a51898a",
                        "glosses": [
                            "Excessivement explicite, violent ou sans inhibition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d9d320-75cf-4f81-ab83-6a32afe4716d",
                                "sense_id": "c37485ac-b05a-3fb2-b5aa-d3c0afc90e02",
                                "text": "Dans cet environnement périurbain hardcore, les bâtiments de la DRAF donnaient une étrange impression de désuétude, et à vrai dire aussi de négligence et d’abandon."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea602cd0-6db3-3a4d-a6bf-ea31a8251b54",
                        "entry_id": "372a8110-14e0-3a59-a8f0-53fe5a51898a",
                        "glosses": [
                            "Relatif au hardcore, genre musical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3d7942-11c1-4d83-b850-09871042a284",
                                "sense_id": "ea602cd0-6db3-3a4d-a6bf-ea31a8251b54",
                                "text": "En tournée avec Born To Rave, des soirées organisées par le label Audiogenic dans toute la France, le pilier de la scène hardcore française Radium a répondu à quelques unes de nos questions."
                            }
                        ]
                    }
                ],
