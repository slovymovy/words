{
    "word_family": [
        "hang"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
                    "sense_definition": "Having a guilty, ashamed, or sneaking appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student walked into the office with a <w>hangdog</w> expression after being caught cheating.",
                            "target_lang_translations": {
                                "cs": "Student vešel do kanceláře s <w>provinilým</w> výrazem poté, co byl přistižen při podvádění."
                            }
                        },
                        {
                            "text": "He gave a <w>hangdog</w> look when he realized he had forgotten his promise to help.",
                            "target_lang_translations": {
                                "cs": "Nahodil <w>zkroušený</w> pohled, když si uvědomil, že zapomněl na svůj slib pomoci."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hangdog look",
                        "hangdog expression"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající provinilý, zahanbený nebo ustrašený výraz."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "provinilý",
                                "target_lang_sense_clarification": "vyjadřující pocit viny"
                            },
                            {
                                "target_lang_word": "zahanbený",
                                "target_lang_sense_clarification": "vypadající jako někdo, kdo se stydí"
                            },
                            {
                                "target_lang_word": "zkroušený",
                                "target_lang_sense_clarification": "působící sklesle a provinile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e951c6c0-4805-35bb-b43c-fed1c1127387",
                    "sense_definition": "To move or loiter in a sneaking or ashamed manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defeated team <w>hangdogged</w> their way off the field after the final whistle.",
                            "target_lang_translations": {
                                "cs": "Poražený tým se po závěrečném hvizdu <w>zahanbeně plížil</w> z hřiště."
                            }
                        },
                        {
                            "text": "He was <w>hangdogging</w> around the entrance, clearly afraid to face the consequences of his actions.",
                            "target_lang_translations": {
                                "cs": "Zahanbeně se <w>potloukal</w> kolem vchodu, zjevně se bál čelit následkům svého jednání."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se nebo se potloukat zahanbeným či ustrašeným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plížit se",
                                "target_lang_sense_clarification": "pohybovat se nenápadně a nejistě"
                            },
                            {
                                "target_lang_word": "potloukat se",
                                "target_lang_sense_clarification": "pohybovat se bez cíle, často s pocitem viny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7353b2dc-220c-319a-baa1-79aed7ecb1d8",
                    "sense_definition": "A person who is considered base or degraded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain was described as a miserable <w>hangdog</w> who had no respect for others.",
                            "target_lang_translations": {
                                "cs": "Padouch byl popsán jako ubohý <w>podlec</w>, který neměl k ostatním žádnou úctu."
                            }
                        },
                        {
                            "text": "Only a total <w>hangdog</w> would betray his friends for such a small reward.",
                            "target_lang_translations": {
                                "cs": "Jen naprostý <w>bídák</w> by zradil své přátele za tak malou odměnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneak"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba považovaná za nízkou, opovrženíhodnou nebo degradovanou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podlec",
                                "target_lang_sense_clarification": "člověk bez charakteru"
                            },
                            {
                                "target_lang_word": "bídák",
                                "target_lang_sense_clarification": "člověk nízké morální úrovně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}