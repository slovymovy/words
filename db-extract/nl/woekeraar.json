                "senses": [
                    {
                        "sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "glosses": [
                            "iemand die woeker drijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4e9a16-f34d-4ef0-8d06-4e9fb88d9928",
                                "sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                                "text": "Een woekeraar is iemand die geld uitleent aan een ander en daarvoor een abnormale, onredelijk hoge rente terugvraagt."
                            },
                            {
                                "example_id": "18c87a3b-c8cc-4cfa-b71a-45945bbb6553",
                                "sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                                "text": "Als woekeraar moest je bereid zijn mensen een pak slaag te geven als ze niet binnen twee dagen betaalden."
                            }
                        ]
                    },
                    {
                        "sense_id": "37e0e0a7-f7a6-332e-9d9e-0bc2c32ef097",
                        "entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "glosses": [
                            "iemand die met zijn talenten woekert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96120a8-4293-42dd-a22a-1386dfe5f8d5",
                                "sense_id": "37e0e0a7-f7a6-332e-9d9e-0bc2c32ef097",
                                "text": "Ja, ik ben momenteel een echte woekeraar, zowel met mijn tijd als met de beschikbare ruimte in de boot."
                            }
                        ]
                    },
                    {
                        "sense_id": "12f9aa06-9d15-3680-b7a0-45d34d9f45db",
                        "entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "glosses": [
                            "een plant die woekert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281f125b-45b4-488b-9bb0-dd7976a7fca6",
                                "sense_id": "12f9aa06-9d15-3680-b7a0-45d34d9f45db",
                                "text": "Vaak is een gekregen plant een onverbeterlijke woekeraar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ff056aa-5b5f-406b-8555-ff659ee5214b",
                        "source_entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "source_sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "source_sense_description": "iemand die woeker drijft",
                        "target_lang_word": "Wucherer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wucherer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "981ddcf0-4c97-3009-8cd0-365ce8333351",
                                        "entry_id": "7c9c5575-d7f9-308a-90fe-e7504a6b7067",
                                        "glosses": [
                                            "Person oder Institution, der vorgeworfen wird, für eine Leistung (oft: Geldverleih) zu hohe Gegenleistungen zu verlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c8b6d23-41f4-444b-8fcb-6fa329bdee54",
                                                "sense_id": "981ddcf0-4c97-3009-8cd0-365ce8333351",
                                                "text": "„Shakespeare hat in seinem »Kaufmann von Venedig« eine literarische Vorlage für das Zerrbild vom blutsaugenden jüdischen Wucherer geliefert: Der alte Geldverleiher Shylock verlangt für ein Pfanddarlehen das Recht, dem Kaufmann Antonio, wenn das Geld nicht zurückgezahlt wird, ein Pfund Fleisch aus dem Leib zu schneiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f547094-5e86-4e60-a25b-cec1549396be",
                        "source_entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "source_sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "source_sense_description": "iemand die woeker drijft",
                        "target_lang_word": "Halsabschneider",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halsabschneider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                        "entry_id": "a5b8cb07-ef7b-3624-95e1-fdf4143f1479",
                                        "glosses": [
                                            "jemand, der andere auf besonders gewissenlose Weise übervorteilt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1017ce35-0d93-46a8-afba-c95016bbd3e6",
                                                "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                                "text": "Privat ist er ja ein netter Kerl, aber wenn es ums Geschäft geht, wird Hugo zum Halsabschneider."
                                            },
                                            {
                                                "example_id": "532110bc-4d54-4228-b517-48b3d83e2b05",
                                                "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                                "text": "Da diese Meinung mir durchaus einleuchtete, hielten wir eine flüsternde Beratung ab und beschlossen, uns auf dem nächsten Bahnhof einfach aus dem Staube zu machen, um diesem Halsabschneider zu entgehen."
                                            },
                                            {
                                                "example_id": "1d5097c9-0e1f-4ee7-999a-2b6c9ba1690a",
                                                "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                                "text": "„Der Kamin mußte wieder eingerissen werden, und dann hatten die Halsabschneider uns noch vierzig Kubikmeter Erdaushub zuviel berechnet.“"
                                            },
                                            {
                                                "example_id": "210c6d39-6a3f-4fc7-aeeb-51e9b26acfc1",
                                                "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                                "text": "„Diese Halsabschneider wollen für die Reparatur meines Autos 500 Euro haben\", schimpft jemand."
                                            },
                                            {
                                                "example_id": "2ff9bd10-49ec-473b-a639-b9af3edbd140",
                                                "sense_id": "64ed20eb-e981-351e-97c4-7b8aaeee6651",
                                                "text": "„Der Halsabschneider war ohne einen Soldo von Venedig abgefahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a62cb7a-e471-4624-bc18-78c8901b558f",
                        "source_entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "source_sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "source_sense_description": "iemand die woeker drijft",
                        "target_lang_word": "Kredithai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kredithai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                        "entry_id": "26e930de-c80c-366f-bc0f-07e4541f0b10",
                                        "glosses": [
                                            "Geldgeber, der Schuldnern Geld zu besonders nachteiligen Kreditbedingungen, das sind meist extrem hohe Zinsen, anbietet"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5aa19e-d805-4bf5-a15f-fe99664ff915",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„Rosalindas Vater ist bei dem Kredithai Elías verschuldet.“"
                                            },
                                            {
                                                "example_id": "a8401920-c9b1-4ac5-b076-7cd4351035c3",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "Ich war so überschuldet, dass mir eine normale Bank keinen Kredit gegeben hätte. Nur die Kredithaie haben mir noch Geld geliehen."
                                            },
                                            {
                                                "example_id": "2fa1cb1b-ec42-4317-8a14-ae5e5b232199",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„Der Fernsehsender ZDF berichtet in seiner Fernsehsendung WISO (Wirtschaft + Soziales) über Kredithaie, die Kunden Sofortkredite von Internetanbietern ohne Schufaabfrage anbieten.“"
                                            },
                                            {
                                                "example_id": "1deca84c-83c1-4b6f-9043-723e89a4f715",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "Wer in Namibias Townships ein Geschäft eröffnen will, muss sich oft bei Kredithaien Geld leihen."
                                            },
                                            {
                                                "example_id": "0fd59444-d85e-4f1e-b629-cff46186bd35",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„In Ländern, in denen lokale Kredithaie bis zu 20 Prozent Zinsen am Tag verlangen, entfalten die kleinen Kredite [die sogenannten Mikrokredite zwischen 50 Euro und 1.500 Euro] große Wirkung.“"
                                            },
                                            {
                                                "example_id": "b2cd1e60-5e53-4dfd-92f2-c70167d2ccf6",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„Geldverleiher Rahul Kunchikarwe […] will so schnell wie möglich raus aus [dem Slum] Dharavi. Er gibt jenen Menschen Kredit, die von Banken niemals Geld bekommen würden; Illegal und ohne Lizenz. Der Kredithai nennt sich Mikrokredit-Unternehmer.“"
                                            },
                                            {
                                                "example_id": "fef20857-6c58-4ec6-809f-cebccf827e02",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„Jan Richter hat sich seinen sehnlichsten Traum erfüllt: einen Jazzclub in Köln-Nippes. Doch das ‚Cool Moon‘ steht vor der Pleite, der Kredithai sitzt Jan schon im Nacken.“"
                                            },
                                            {
                                                "example_id": "e9a2d9ab-6334-4198-8890-d25e705bc4d2",
                                                "sense_id": "39c5a884-c60a-3099-9866-bfa327a3ba97",
                                                "text": "„Mads und Harry ermitteln […] inkognito gegen den Kredithai Jensen. Zunächst sind sie erfolgreich. Aber um Jensen dingfest zu machen, fehlt ihnen ein handfester Beweis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "909e679d-c35f-47b9-a6cb-c4fed9221ec5",
                        "source_entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "source_sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "source_sense_description": "iemand die woeker drijft",
                        "target_lang_word": "usurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                        "entry_id": "27ea4a4e-a2d7-3205-9fea-b005abd33233",
                                        "glosses": [
                                            "A person who loans money to others and charges interest, particularly at an exorbitant, exploitative, or illegal rate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941156a4-d14c-41dd-8bb7-1e2db1e2411d",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "Vſurers, you are none of theſe cryers vnto God, but thoſe that hourely vnto God are most cryde out againſt. God hath cryde out vnto you by his Preachers, GOD hath cride out vnto you by the poore ; Pryſoners on their death-beds haue cride out of you : and when they haue had but one houre to interceſſionate for their ſoules, and ſue out the pardon of their numberleſſe ſins, the whole of that howre (ſauing one minute, when in two words they cryde for mercy,) haue they ſpent, in crying for vengeance againſt you."
                                            },
                                            {
                                                "example_id": "5159f338-37e7-434c-8414-92ee7716776b",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "Profitless usurer, why dost thou use\nSo great a sum of sums, yet canst not live?"
                                            },
                                            {
                                                "example_id": "04b722fd-0ef8-4bee-b827-e5b39b5324a6",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "\"You can go to the Carpetbag usurers if you want money.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61741b13-1abc-45e1-8aae-31295f08cae5",
                        "source_entry_id": "52dd4461-b1a0-388e-8d70-172f39052505",
                        "source_sense_id": "b039cd04-187e-3a0c-98d0-b66dc0538784",
                        "source_sense_description": "iemand die woeker drijft",
                        "target_lang_word": "usurier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                        "entry_id": "95fc904b-2e2a-3b0e-9047-c038084c10bd",
                                        "glosses": [
                                            "Prêteur qui prête à un taux d’intérêt trop élevé, un taux usuraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7508e23-ca19-4cb5-b100-e66f8fb53b0d",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "[…], j’aurais juré que tes pensées se fussent portées sur les sacs d’argent du vieil usurier plutôt que sur les yeux noirs de sa fille."
                                            },
                                            {
                                                "example_id": "6beb70f1-b2ac-4a5a-a6e8-1f6609b44c19",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "Dans vingt ans, […], une héritière d’un million, ce sera rare comme le désintéressement chez un usurier."
                                            },
                                            {
                                                "example_id": "36910c90-9828-4a07-bf96-39017ba69e9f",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "Il s’agissait de dix mille francs de lettres de change souscrites au profit d’un usurier nommé Samanon, et qui probablement avait donné deux ou trois mille francs au baron d’Ervy."
                                            },
                                            {
                                                "example_id": "b48d9b92-0e27-4dfb-96ae-6efe63dbbea5",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "Si je prends un plaisir quel qu’il soit, je suppute les chances que j’ai d’être mis en demeure, dans un avenir très proche, de le payer, et au centuple encore ! car le sort n’est qu’un usurier."
                                            },
                                            {
                                                "example_id": "4f36b03c-e321-4bc5-a400-6c8fcebf7233",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "On ne s'improvise pas usurier, il faut parvenir d'abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain."
                                            },
                                            {
                                                "example_id": "5381f50a-3257-4829-9f0c-3e3f80f4b6f8",
                                                "sense_id": "1dfed799-a661-34ec-b42d-f4654699ab76",
                                                "text": "Claude Riendeau, lui, est un ex-flic devenu voleur à main armée, usurier, trafiquant de coke et « détaillant » d’armes, comme il aime dire pudiquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7668cf42-fa7a-387b-b967-7cf4c067b026",
                                        "entry_id": "95fc904b-2e2a-3b0e-9047-c038084c10bd",
                                        "glosses": [
                                            "Personne qui accroit sa fortune en profitant des malheurs ou des nécessités."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
