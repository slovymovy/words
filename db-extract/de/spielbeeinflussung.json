                "senses": [
                    {
                        "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                        "entry_id": "11771ec4-af04-3e27-b0c2-ac60f5819add",
                        "glosses": [
                            "wirkungsvoller Eingriff in ein Spielgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77129480-5a4a-42bb-a3c0-c4041bda83bf",
                                "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                                "text": "„Die Unterscheidung nach direkter und indirekter Spielbeeinflussung von Smilanski (1968) ist dagegen zum einen allgemeiner, zum anderen spezifischer angelegt.“"
                            },
                            {
                                "example_id": "df13bd20-17b8-42ae-8433-80155c787965",
                                "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                                "text": "„Der Deutsche Fußball-Bund ermittelt gegen die Spieler Matthias Örüm und Sahr Senesie vom Fußball-Regionalligisten TSG Hoffenheim wegen des Verdachts der Spielbeeinflussung.“"
                            },
                            {
                                "example_id": "2b42772a-ff6c-41e4-ab98-5acd7eb04dcf",
                                "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                                "text": "„Nach SID-Informationen teilten sie ihrem Präsidenten lediglich mit, dass nach derzeitigem Sachstand verdächtigen Spielern eine konkrete Manipulation nicht zu beweisen sein werde - nicht, dass es keine Hinweise auf tatsächliche Spielbeeinflussung gebe.“"
                            },
                            {
                                "example_id": "2a1a6e89-c314-4f67-ad1d-420c72676d7e",
                                "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                                "text": "„Dass es aber immer wieder neue Wege der Spielbeeinflussung geben wird, musste ich am heutigen Montag am eigenen Leib erfahren.“"
                            },
                            {
                                "example_id": "ed70d467-8526-4cc2-9528-b68ca65fe8c9",
                                "sense_id": "8b6a6a3f-5fb9-3ee6-8c0e-bea3d143368c",
                                "text": "„Wer jedoch eine unbefugte Spielbeeinflussung unternimmt, wird durch den neu geschaffenen § 6a Spielmanipulation im Rahmen eines unsportlichen Verhaltens bestraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
