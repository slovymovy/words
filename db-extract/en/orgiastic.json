                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                                        "glosses": [
                                            "związany z orgią (grupową zabawą seksualną)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70ed6fb-5604-453d-af4c-e6a79fef667b",
                                                "sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                                                "text": "Z mojego doświadczenia terapeutycznego wynika jednak, że seks ludyczny, seks orgiastyczny, to nie jest seks docelowy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "55118600-8a88-3191-9b07-6ad0dea71cce",
                                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                                        "glosses": [
                                            "związany z orgią (głośną, pijacką, narkotykową zabawą)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1234234-574d-4b4f-b1bf-74f91c5bcd89",
                                                "sense_id": "55118600-8a88-3191-9b07-6ad0dea71cce",
                                                "text": "Będzie to zwykła, uporczywa praca i zabawa - nie jakaś szaleńcza, orgiastyczna, lecz zwyczajna, wpleciona w rytm zajęć…"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "d52db1a8-8f3a-3f08-bdf3-2478595bf65a",
                                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                                        "glosses": [
                                            "związany z orgią (przesadzoną, rozbuchaną różnorodnością)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963b709b-10e9-4bb0-ba73-f5d0c9464713",
                                                "sense_id": "d52db1a8-8f3a-3f08-bdf3-2478595bf65a",
                                                "text": "Lecz nie ma na tych mapach rąbanisk zadyszanych gwarem owadów, malińców, w które lepiej nie wchodzić, tyle tam pierwotnej bujności, żmijowisk kwiatów podobnych do zwierząt, kwietników, gdzie przyroda daje w skrócie orgiastyczny obraz swych praw, okrucieństw i cudów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "1c98d1a1-a520-346a-88ae-cc80fc208b6c",
                                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                                        "glosses": [
                                            "związany z orgią (przesadzonym zachowaniem)"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f0ee8a-88be-4382-8ca0-46d450fed32f",
                                                "sense_id": "1c98d1a1-a520-346a-88ae-cc80fc208b6c",
                                                "text": "Piekielny galop zaskoczył paryżan swoją żywiołowością, jak na tamte czasy był wręcz orgiastyczny"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "216e9ecf-f21b-38a7-8b85-fce2093cf78e",
                                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                                        "glosses": [
                                            "związany z orgią (ekstatycznymi obrzędami ku czci bogów, w szczególności Dionizosa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "becd54f9-faa0-42f3-bc3a-12076be522b0",
                                                "sense_id": "216e9ecf-f21b-38a7-8b85-fce2093cf78e",
                                                "text": "Wprowadził w Rzymie kult orgiastyczny bożka syryjskiego Elagabala, którego był kapłanem"
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
