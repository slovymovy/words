                "senses": [
                    {
                        "sense_id": "b0f2d183-7c70-3490-bad7-03625ff4c958",
                        "entry_id": "41c39bfa-1051-3e38-abe4-bae182f04033",
                        "glosses": [
                            "Embrouiller, emmêler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8278975d-e843-4d02-a948-2fc6eedc2651",
                                "sense_id": "b0f2d183-7c70-3490-bad7-03625ff4c958",
                                "text": "Je garantis qu’à Sciences-Po nous nous rendions en bande voir Aron faire passer les examens, terroriser les jeunes filles, empatouiller les candidats dans des dialectiques perverses auxquelles, par miracle, j’avais su moi-même résister."
                            },
                            {
                                "example_id": "dea5fe54-c506-42e1-87fd-bade427f4f9c",
                                "sense_id": "b0f2d183-7c70-3490-bad7-03625ff4c958",
                                "text": "Je saute sur l’occasion et je dois le dire, le plus maladroitement du monde, je m’embrouille, m’empatouille, patauge, bref, je commence une phrase interminable et explicative, truffée de « qui… dont… »"
                            }
                        ]
                    }
