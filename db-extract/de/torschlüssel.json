                "senses": [
                    {
                        "sense_id": "ef4e3444-8b78-38ec-a9d1-f4111ee8fc78",
                        "entry_id": "93d57ecf-4483-3f99-9fe2-3f329007b36d",
                        "glosses": [
                            "Gegenstand zum Schließen und Öffnen eines Schlosses, das sich an einer großen, schweren Tür (Tor) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efda712e-2f04-46fa-9e34-7289d228ff79",
                                "sense_id": "ef4e3444-8b78-38ec-a9d1-f4111ee8fc78",
                                "text": "„Ein Kostenangebot, das ich heimlich einholte, belief sich für alle Schlüssel auf 112 Mark, davon kostete allein der antike Torschlüssel 84.“"
                            },
                            {
                                "example_id": "db36ea2c-f756-437b-9e27-e5f64488aef4",
                                "sense_id": "ef4e3444-8b78-38ec-a9d1-f4111ee8fc78",
                                "text": "„Hat jeder Vorstand solche Torschlüssel, und wer noch außer dem Vorstand, - also Assistenten, Diener?“"
                            },
                            {
                                "example_id": "282a62ec-280a-4770-8ad0-c81ada382a2e",
                                "sense_id": "ef4e3444-8b78-38ec-a9d1-f4111ee8fc78",
                                "text": "„In früherer Zeit befanden sich die Torschlüssel in den Händen des Amtsbürgermeisters, der sie jeden Abend zum Sperren hergab und am Morgen wieder in Empfang nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
