                "senses": [
                    {
                        "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                        "entry_id": "9e00e1e3-4c4a-34f0-911c-41806a22f15b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a893f7-4300-44bd-a713-3fe73c75ffbb",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Frau Priess ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5414ad49-c79c-44d3-9e1b-9e5d73b36b09",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Herr Priess wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e94c9e0e-98d7-4bf7-be1c-2b998d8e209a",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Die Priess kommen heute aus Franken."
                            },
                            {
                                "example_id": "6695f9ef-3aae-45bc-a60f-fa1b552b682e",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Der Priess trägt nie die Schals, die die Priess ihm strickt."
                            },
                            {
                                "example_id": "f226d683-a725-4a54-9259-7c690ad8e192",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Priess kommt, geht der Herr Priess.“"
                            },
                            {
                                "example_id": "106451e9-efd0-4cee-b862-7c55100160fc",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Priess kommt und geht."
                            },
                            {
                                "example_id": "9036588b-c8e8-4ba0-892c-be4e01a609f8",
                                "sense_id": "861798e3-b5d3-3976-a914-0b637d88830e",
                                "text": "Priessens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
