                    {
                        "sense_id": "c35e057d-dd78-3681-8518-ec7ee407e80f",
                        "entry_id": "9e281036-aa92-3e95-b8f0-696a0bde788b",
                        "glosses": [
                            "Schauspieler (heute besonders in einer Komödie)"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ba2190-4785-4ac4-bfed-09dea3a5ae8f",
                                "sense_id": "c35e057d-dd78-3681-8518-ec7ee407e80f",
                                "text": "„Gegen Abend verließ ich Otranto mit zwanzig Komödianten und sechs großen Kisten, die alles enthielten, was sie für die Aufführung ihrer Possen brauchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
