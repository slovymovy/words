                ],
                "senses": [
                    {
                        "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                        "entry_id": "9ae0c9bc-503a-3370-9d1c-15957cb50067",
                        "glosses": [
                            "Verweis mit sprachlichen Ausdrücken auf Personen, Zeit oder Ort der Gesprächssituation oder auf eine andere Stelle im gleichen Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a67cbb-eeb3-4a86-afd2-7084ae8204b9",
                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                "text": "Wörter wie \"hier\", \"dort\", \"da\" dienen der Deixis, in diesem Fall der Lokaldeixis."
                            },
                            {
                                "example_id": "1efa35f8-55bf-479a-9f05-adc57983cbc5",
                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                "text": "Orientierungspunkt für die Deixis ist die Ich-Jetzt-Hier-Origo."
                            },
                            {
                                "example_id": "691a1e87-fa05-4d1b-a57e-226a5102161b",
                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                "text": "„Deixis gilt als Bindeglied zwischen Semantik und Pragmatik,insofern als die Referenz deiktischer Ausdrücke nur aus der jeweils pragmatisch situierten Sprechsituation heraus ermittelbar ist.“"
                            },
                            {
                                "example_id": "651c8186-7fbb-45e6-b16e-27df5fae6f09",
                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                "text": "„Die Begleitung oder den Einsatz der Zeigegeste nennt man die deiktische Funktion oder Deixis.“"
                            },
                            {
                                "example_id": "464dd115-1bc4-4bfa-80a7-96b37e3e8106",
                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                "text": "„Für die Identifikation der Sprechsituation ist die Deixis von Bedeutung (Personal-Deixis, Temporal-Deixis, Lokal-Deixis).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a9e1aa-c8c6-47cb-9423-2a3bd960f1ae",
                        "source_entry_id": "9ae0c9bc-503a-3370-9d1c-15957cb50067",
                        "source_sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                        "source_sense_description": "Verweis mit sprachlichen Ausdrücken auf Personen, Zeit oder Ort der Gesprächssituation",
                        "target_lang_word": "deixis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deixis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                                        "entry_id": "620b937b-1327-358f-bce9-5415ccf4bee4",
                                        "glosses": [
                                            "The use of a word, such as a pronoun, to refer to something that must be identified from the wider context; a word used in such a way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6faed22-5efe-4900-8c25-ee4ad13cad43",
                                                "sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                                                "text": "Deixis allows for economy of speech but introduces ambiguity when that speech is recorded."
                                            },
                                            {
                                                "example_id": "ec97c9c2-0647-4f03-a5dd-bb60776a6964",
                                                "sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                                                "text": "Deixis is a technical term (from Greek) for one of the most basic things we do with utterances. It means 'pointing' via language. Any linguistic form used to accomplish this 'pointing' is called a deictic expression. When you notice a strange object and ask, 'What's that?', you are using a deictic expression ('that') to indicate something in the immediate context. Deictic expressions are also sometimes called indexicals. They are among the first forms to be spoken by very young children and […]"
                                            },
                                            {
                                                "example_id": "77827d8b-bd2a-40bd-ab27-9b24c48d9863",
                                                "sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                                                "text": "For those who treat language as a generative system for objectively describing the world, deixis is a big black fly in the ointment. Deixis introduces subjective, attentional, intentional and, of course, context-dependent properties into natural languages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60392b99-c70e-4571-806d-b4323805aec1",
                        "source_entry_id": "9ae0c9bc-503a-3370-9d1c-15957cb50067",
