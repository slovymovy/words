                "senses": [
                    {
                        "sense_id": "3af3b752-a8e1-33d6-a862-adf25a77ef76",
                        "entry_id": "57f08f21-eba3-3819-abaf-944e1b365018",
                        "glosses": [
                            "to live, to remain alive, to survive (until), to live to see"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2195dacc-cae1-4508-a0fc-edddec35efb4",
                                "sense_id": "3af3b752-a8e1-33d6-a862-adf25a77ef76",
                                "text": "он не доживёт до весны́",
                                "translation": "he won't live until spring; he won't see the spring",
                                "english": "he won't live until spring; he won't see the spring"
                            },
                            {
                                "example_id": "a4311422-975b-442a-b9f1-a791e2b6a8a9",
                                "sense_id": "3af3b752-a8e1-33d6-a862-adf25a77ef76",
                                "text": "е́сли я доживу́ (до э́того)",
                                "translation": "if I live that long",
                                "english": "if I live that long"
                            },
                            {
                                "example_id": "712f353e-7abd-493c-b113-7a1221f32736",
                                "sense_id": "3af3b752-a8e1-33d6-a862-adf25a77ef76",
                                "text": "дожи́ть до глубо́кой ста́рости",
                                "translation": "to reach a great age",
                                "english": "to reach a great age"
                            },
                            {
                                "example_id": "0ae62756-d19f-4574-a453-4bdb5587158d",
                                "sense_id": "3af3b752-a8e1-33d6-a862-adf25a77ef76",
                                "text": "дожи́ть до седы́х воло́с",
                                "translation": "to grow old and grey",
                                "english": "to grow old and grey"
                            }
                        ]
                    },
                    {
                        "sense_id": "22f5d69b-fb06-3ba3-9853-326906864456",
                        "entry_id": "57f08f21-eba3-3819-abaf-944e1b365018",
                        "glosses": [
                            "to find oneself in a disgraceful condition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54656e0e-eef4-4ad9-9b33-a2b2fbfebbcd",
                                "sense_id": "22f5d69b-fb06-3ba3-9853-326906864456",
                                "text": "до чего́ он дожил!",
                                "translation": "what has he come to!",
                                "english": "what has he come to!"
                            }
                        ]
                    },
                    {
                        "sense_id": "05e0a5e3-8239-3c5c-9b3a-361982956e8e",
