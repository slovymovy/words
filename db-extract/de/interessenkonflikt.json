                ],
                "senses": [
                    {
                        "sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                        "entry_id": "65240001-ab8d-34a2-95ef-201c104252f5",
                        "glosses": [
                            "ein Konflikt verschiedener Interessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2484c63e-ebc8-46b1-84af-63ff41d718c8",
                                "sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                                "text": "Jeder, der zwei Herren dient, kommt früher oder später in einen Interessenkonflikt."
                            },
                            {
                                "example_id": "c3ede343-3c25-47c1-8d99-bfc1bd08a04b",
                                "sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                                "text": "Der Interessenkonflikt um Wasser und Land zwischen sesshaften Bauern und streifenden Nomaden trat oft in der Geschichte auf."
                            },
                            {
                                "example_id": "6d9b327a-0ad1-4b57-8737-dbc7c816492c",
                                "sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                                "text": "„Die wichtigste Regel für Wikipedia-Autorinnen und Autoren ist: Schreibe keine Artikel über Personen oder Dinge, die dich persönlich betreffen. So versuchen wir, Interessenkonflikte zu vermeiden.“"
                            },
                            {
                                "example_id": "da056ad5-c4f9-4769-a192-3765b480b1e6",
                                "sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                                "text": "„Bei Söldnern aus der Fremde, die keine familiären Bindungen im Land haben und keinen Interessenkonflikten ausgesetzt sind, hängt die Loyalität an guter Behandlung und vor allem an der Höhe des pünktlich ausgezahlten Solds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d90c380d-fe04-48f6-b50e-56547ac20b5e",
                        "source_entry_id": "65240001-ab8d-34a2-95ef-201c104252f5",
                        "source_sense_id": "ed41b11b-44b1-3029-8409-70e3d2dedc33",
                        "source_sense_description": "ein Konflikt verschiedener Interessen",
                        "target_lang_word": "conflict of interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conflict of interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec23b84-e997-3003-965b-70506ed02b99",
                                        "entry_id": "02b65b08-5d94-34ff-b3c9-9280e1dee259",
                                        "glosses": [
                                            "A situation in which an individual or legal entity in a position of trust (such as an attorney, investment advisor, broker, politician, executive, director, scientist or physician) has competing professional or personal interests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29fa5adf-b42e-4d27-9c3b-f8f8a036ce78",
                                                "sense_id": "fec23b84-e997-3003-965b-70506ed02b99",
                                                "text": "Grassley continues to probe Abedin’s potential conflicts of interest when she was getting four different paychecks at once. “We know she set up dinners for Secretary Clinton and her private-sector employers and e-mailed private-sector employees from government accounts,” he says."
                                            },
                                            {
                                                "example_id": "497627c4-ef2b-4cc9-915e-f099a26735cf",
                                                "sense_id": "fec23b84-e997-3003-965b-70506ed02b99",
                                                "text": "Rishi Sunak is facing questions over a potential conflict of interest after it emerged a childcare firm part owned by his wife is to benefit from major changes in the budget."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77df2270-ef5c-31ef-92e8-f4f8420a0871",
                                        "entry_id": "02b65b08-5d94-34ff-b3c9-9280e1dee259",
                                        "glosses": [
                                            "The competing interest itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
