                "senses": [
                    {
                        "sense_id": "34e9ee5d-6992-3c78-9765-2e89d21f330d",
                        "entry_id": "5e6459a0-f441-377c-ad81-d6a0821f8805",
                        "glosses": [
                            "Monasterium des Dominikanerordens; von Dominikanern betriebenes Kloster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80fe893c-5c0a-4e6e-8aeb-50385a7b6e2d",
                                "sense_id": "34e9ee5d-6992-3c78-9765-2e89d21f330d",
                                "text": "„Das Spektrum reicht vom Tresorraum der Länderbank von Otto Wagner über Sakralbauten wie das Dominikanerkloster, die Kapelle in der Rossauer Kaserne oder die Wotruba-Kirche bis zur \"Notgalerie\" in der Seestadt Aspern, eine ehemalige Holzkirche, die nun als Galerie fungiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b9c340c-9879-436b-b048-6b62e2244f22",
                        "source_entry_id": "5e6459a0-f441-377c-ad81-d6a0821f8805",
                        "source_sense_id": "34e9ee5d-6992-3c78-9765-2e89d21f330d",
                        "source_sense_description": "Religion: Monasterium des Dominikanerordens; von Dominikanern betriebenes Kloster",
                        "target_lang_word": "dominicanenklooster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dominicanenklooster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "00d03966-a601-3c31-bb24-679aa0dc3055",
                                        "entry_id": "01e796c7-5573-3cc5-a677-f218aab3aa56",
                                        "glosses": [
                                            "instelling voor dominicaner monniken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9251df-334f-4285-b891-a26444686648",
                                                "sense_id": "00d03966-a601-3c31-bb24-679aa0dc3055",
                                                "text": "In het leven van Michael-Dominique Magielse is niet een specifiek moment aan te wijzen waarop hij dacht: nu weet ik het. Of zoals hij het zelf zegt: \"Er waren geen engelen met trompetten die in mijn oor hebben getoeterd.\" Toch zet de 48-jarige Magielse vandaag een stap die zijn leven verandert. Hij treedt officieel in bij de broeders van het dominicanenklooster in Rotterdam."
                                            },
                                            {
                                                "example_id": "2fac1d33-9db2-4057-922a-087882a76b79",
                                                "sense_id": "00d03966-a601-3c31-bb24-679aa0dc3055",
                                                "text": "Het Predikherenklooster, met bijhorende kerk, kent zijn oorsprong in het midden van de 17de eeuw en werd in 1980 beschermd omwille van de artistieke waarde. Het gaat om een voormalig dominicanenklooster waarvan de bewoners eind 18de eeuw verjaagd werden door de Fransen. Nadien deed het complex dienst als militair hospitaal en krijgsarsenaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
