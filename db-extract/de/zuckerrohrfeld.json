                "senses": [
                    {
                        "sense_id": "2842b118-88c3-35f2-add0-9567cfa59152",
                        "entry_id": "e68519c0-4f63-3289-8d66-c185ff0cdee4",
                        "glosses": [
                            "Feld, auf dem Zuckerrohr angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd1aaa3-7b70-4c9b-b566-b3ca930fddf5",
                                "sense_id": "2842b118-88c3-35f2-add0-9567cfa59152",
                                "text": "„Er überquerte die Eisenbahngleise, landete zwischen den Gewächsen auf der anderen Seite, wischte sich im Gehen die Nase mit dem Ärmel ab und warf einen Blick in die Runde; dann marschierte er an einer hohen, mit Geißblatt bewachsenen Böschung entlang, schritt über ein Zuckerrohrfeld und erreichte schließlich den Rand eines Ackers; im Lehm zeichneten sich seine früheren Fußspuren ab, sie ließen sich im Dunkel verfolgen, und kurz darauf huschte seine schattenlose Gestalt über einen Hintergrund aus Sumach und Sassafras.“"
                            },
                            {
                                "example_id": "4b2d6bea-c619-46b8-954c-a3438d5a8ac9",
                                "sense_id": "2842b118-88c3-35f2-add0-9567cfa59152",
                                "text": "„Im Bus, an einer heiligen Tempelquelle, auf dem Hubschrauberlandeplatz auf dem Gipfel eines Berges oder in einem Zuckerrohrfeld - überall gaben die Leute bereitwillig Auskunft über ihr Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
