                        "glosses": [
                            "nauka o wodzie występującej w przyrodzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54eedc7-8799-438a-be2d-3b3b4a6b1fb8",
                                "sense_id": "d74abb17-0111-3106-a8af-afb0747640c9",
                                "text": "W hydrologii izobata oznacza często głębokość do dna zbiornika wód powierzchniowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d5fa87e-ce6c-4e7c-afe5-537d1e141341",
                        "source_entry_id": "c1ec6683-ea96-349a-810f-8ed47fa447d4",
                        "source_sense_id": "d74abb17-0111-3106-a8af-afb0747640c9",
                        "target_lang_word": "hydrology",
