                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c3fd1f-602c-402c-a0e5-4512c78aea4a",
                                "sense_id": "307735be-2fcc-38a4-b24b-576da1e5a976",
                                "text": "Unlasting passion, soon outworn conceit,\nWhereon I built, and on so dureless trust!"
                            },
                            {
                                "example_id": "1150f2e3-fe94-44d4-9c26-8932250e7fb3",
                                "sense_id": "307735be-2fcc-38a4-b24b-576da1e5a976",
                                "text": "Gleaming shell of an outworn lie; fable of Right divine—\nYou gained your crowns by heritage, but Blood was the price of mine."
                            },
                            {
                                "example_id": "8a99a406-e0ec-4bf2-ab6e-6a01d1448cb8",
                                "sense_id": "307735be-2fcc-38a4-b24b-576da1e5a976",
                                "text": "Side by side with the dieselisation of C.I.E., the replacement of outworn carriages by modern steel stock was initiated."
                            }
                        ]
                    },
                    {
                        "sense_id": "e65695b3-8ad7-31d8-926b-b00fcd637836",
                        "entry_id": "bc334c8c-5f6a-3ae8-852d-5db67591147c",
                        "glosses": [
