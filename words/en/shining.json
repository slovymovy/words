{
    "word_family": [
        "shine",
        "shiny",
        "shiner",
        "sunshine",
        "outshine"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0541fa02-d6f5-309f-aece-17aa5d04d419",
                    "sense_definition": "Present participle of <w>shine</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun is <w>shining</w> brightly in the sky.",
                            "target_lang_translations": {
                                "ru": "Солнце ярко <w>светит</w> в небе.",
                                "zh": "太阳在天空中明亮地<w>照耀</w>着。"
                            }
                        },
                        {
                            "text": "She is <w>shining</w> her shoes before the meeting.",
                            "target_lang_translations": {
                                "ru": "Она <w>натирает до блеска</w> свои туфли перед встречей.",
                                "zh": "她在开会前把鞋子<w>擦亮</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола shine (светить, сиять; чистить).",
                        "zh": "动词 shine 的现在分词形式，表示发光或擦亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "излучающий сияние"
                            },
                            {
                                "target_lang_word": "светящий",
                                "target_lang_sense_clarification": "излучающий свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发光",
                                "target_lang_sense_clarification": "指物体自身发出光芒"
                            },
                            {
                                "target_lang_word": "擦亮",
                                "target_lang_sense_clarification": "指通过擦拭使物体表面变得光亮"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "399f3dcb-67c4-3bbc-ad6b-82747e1be9ff",
                    "sense_definition": "Giving out or reflecting bright light.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see a <w>shining</w> light coming from the house.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>сияющий</w> свет, исходящий из дома.",
                                "zh": "我们可以看到从屋里传出的一道<w>明亮</w>的光。"
                            }
                        },
                        {
                            "text": "The <w>shining</w> sun warmed the cold earth.",
                            "target_lang_translations": {
                                "ru": "<w>Сияющее</w> солнце согрело холодную землю.",
                                "zh": "<w>闪耀</w>的太阳温暖了寒冷的大地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bright",
                        "glowing",
                        "radiant",
                        "luminous",
                        "beaming"
                    ],
                    "antonyms": [
                        "dark"
                    ],
                    "common_phrases": [
                        "shining light",
                        "shining star",
                        "shining sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испускающий или отражающий яркий свет.",
                        "zh": "发出或反射出明亮的光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "яркий, лучистый"
                            },
                            {
                                "target_lang_word": "сверкающий",
                                "target_lang_sense_clarification": "ярко блестящий, искрящийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明亮的",
                                "target_lang_sense_clarification": "形容光线充足或物体发光"
                            },
                            {
                                "target_lang_word": "闪耀的",
                                "target_lang_sense_clarification": "形容光芒闪烁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                    "sense_definition": "Very smooth and bright because of reflecting light.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight rode a horse and wore <w>shining</w> armor.",
                            "target_lang_translations": {
                                "ru": "Рыцарь ехал на лошади и был одет в <w>блестящие</w> доспехи.",
                                "zh": "骑士骑着马，穿着<w>锃亮</w>的盔甲。"
                            }
                        },
                        {
                            "text": "She has beautiful <w>shining</w> hair that looks very healthy.",
                            "target_lang_translations": {
                                "ru": "У нее красивые <w>блестящие</w> волосы, которые выглядят очень здоровыми.",
                                "zh": "她有一头漂亮的<w>有光泽</w>的头发，看起来非常健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shiny",
                        "polished",
                        "gleaming",
                        "glossy",
                        "lustrous",
                        "bright",
                        "glowing"
                    ],
                    "common_phrases": [
                        "shining armor",
                        "shining eyes",
                        "shining surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень гладкий и яркий, отражающий свет.",
                        "zh": "因反射光线而显得非常光滑和明亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "имеющий блеск, глянцевый"
                            },
                            {
                                "target_lang_word": "сверкающий",
                                "target_lang_sense_clarification": "отражающий свет бликами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有光泽的",
                                "target_lang_sense_clarification": "形容表面光滑且反光"
                            },
                            {
                                "target_lang_word": "锃亮的",
                                "target_lang_sense_clarification": "形容金属等表面非常光亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                    "sense_definition": "Excellent and serving as a very good example.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_merit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>shining</w> example of what hard work can achieve.",
                            "target_lang_translations": {
                                "ru": "Он — <w>блестящий</w> пример того, чего можно достичь упорным трудом.",
                                "zh": "他是努力工作能取得成就的<w>杰出</w>榜样。"
                            }
                        },
                        {
                            "text": "The project was a <w>shining</w> success for the entire team.",
                            "target_lang_translations": {
                                "ru": "Этот проект стал <w>блестящим</w> успехом для всей команды.",
                                "zh": "这个项目对整个团队来说是一次<w>光辉</w>的成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliant",
                        "outstanding",
                        "exemplary"
                    ],
                    "common_phrases": [
                        "shining example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходный, служащий отличным примером.",
                        "zh": "卓越的，作为极好榜样的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "выдающийся, великолепный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰出的",
                                "target_lang_sense_clarification": "形容成就或表现非常优秀"
                            },
                            {
                                "target_lang_word": "光辉的",
                                "target_lang_sense_clarification": "形容成就显著或具有典范意义"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abedbcb5-3fe2-31e4-9a7c-52d78f0ecb31",
                    "sense_definition": "A bright emission of light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>shining</w> of the flashlight revealed the hidden path.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>свет</w> фонарика осветил скрытую тропу.",
                                "zh": "手电筒突然发出的<w>光芒</w>照亮了隐藏的小路。"
                            }
                        },
                        {
                            "text": "He admired the <w>shining</w> of the moon on the calm lake.",
                            "target_lang_translations": {
                                "ru": "Он любовался <w>сиянием</w> луны на спокойном озере.",
                                "zh": "他欣赏着月亮在平静湖面上的<w>闪耀</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gleam",
                        "glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркое излучение света.",
                        "zh": "明亮的光线发射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "яркий свет, излучение"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "яркое отражение света"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光芒",
                                "target_lang_sense_clarification": "指发出的光线"
                            },
                            {
                                "target_lang_word": "闪耀",
                                "target_lang_sense_clarification": "指光线的闪烁或光辉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}