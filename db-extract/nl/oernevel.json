                "senses": [
                    {
                        "sense_id": "12529be5-b2a8-339b-a0e1-8cbe28ae6c12",
                        "entry_id": "42780422-d078-379f-a5ee-e4da6a6b0bca",
                        "glosses": [
                            "gaswolk waaruit zonnestelsels ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44718173-ca87-4d15-9956-3ff79826769b",
                                "sense_id": "12529be5-b2a8-339b-a0e1-8cbe28ae6c12",
                                "text": "Ongeveer 4,6 miljard jaar geleden ontstonden uit een oernevel onze zon en zijn planeten."
                            },
                            {
                                "example_id": "dd6301da-a170-43ad-92f2-ead7e88080df",
                                "sense_id": "12529be5-b2a8-339b-a0e1-8cbe28ae6c12",
                                "text": "Astronomen denken dat zulke Jupiterachtige begeleiders moeten zijn ontstaan in een koele omgeving, dus op vrij grote afstand van hun moederster, en pas later door het een of andere proces naar de ster toe zijn gekomen: door wrijving met materie in de overgebleven oernevel of door de uitwisseling van energie met andere planeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ee4bffd-51fd-3efb-a058-290de7c645e3",
                        "entry_id": "42780422-d078-379f-a5ee-e4da6a6b0bca",
                        "glosses": [
                            "vormeloze ijle toestand waaruit het heelal is ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc63a73c-aa4e-4dc8-8239-b512e771a188",
                                "sense_id": "8ee4bffd-51fd-3efb-a058-290de7c645e3",
                                "text": "De verschillende lagen in het gebergte gaan als de bladen van het gedenkboek der schepping open en onthullen, hoe de oernevel van de chaos eertijds tot een kosmos moet zijn omgevormd."
                            }
                        ]
                    },
