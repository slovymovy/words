                                        "glosses": [
                                            "In a vile manner, evilly, despicably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41970431-ba73-490c-8b97-e9c2aacc536d",
                                                "sense_id": "f89f725d-6846-3214-8b75-6d9e933fafa2",
                                                "text": "We broke off diplomatic relations with Russia\nUkraine is defending itself and will not give up its freedom, no matter what Moscow thinks[...]\nRussia vilely and suicidally attacked our state in the morning\nJust like fascist Germany did during the Second World War"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca06a1d6-c283-346c-824a-95574a12b8cd",
                                        "entry_id": "a2591bb6-d5d1-3347-a5cf-163802f032a2",
                                        "glosses": [
                                            "Terribly, awfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245a854b-46bd-418d-9db0-c2aaafec5ffe",
                                                "sense_id": "ca06a1d6-c283-346c-824a-95574a12b8cd",
                                                "text": "The chauffeur must, as it seemed to me, have been a novice or else have lost his nerve in this disturbance, for he drove vilely on the way to the station."
                                            }
                                        ]
                                    }
                                ]
                            }
