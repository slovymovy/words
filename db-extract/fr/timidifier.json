                "senses": [
                    {
                        "sense_id": "a2ff722e-dbab-3b2e-b4ad-ee7cfd0f1e6d",
                        "entry_id": "f35bdb6e-fb85-3a4d-8cd6-8a6ef8c2785b",
                        "glosses": [
                            "Rendre timide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb96438-bce4-4b9d-9607-70bcea4519c4",
                                "sense_id": "a2ff722e-dbab-3b2e-b4ad-ee7cfd0f1e6d",
                                "text": "J’ai été timidifié par mes parents."
                            },
                            {
                                "example_id": "f5d2b1c0-bf57-4ee3-96cc-ae30ce8f5064",
                                "sense_id": "a2ff722e-dbab-3b2e-b4ad-ee7cfd0f1e6d",
                                "text": "Ben le diable, le sabre de samouraï, ça me timidifie"
                            },
                            {
                                "example_id": "1a4350fd-a85a-408e-bcd1-e3b51f6286fb",
                                "sense_id": "a2ff722e-dbab-3b2e-b4ad-ee7cfd0f1e6d",
                                "text": "Et il ne faut pas se gêner, se timidifier pour écrire un peu en lambeaux, déchiqueté, déchiré, comme si la braise en vous sortirait enfin."
                            }
                        ]
                    }
                ],
