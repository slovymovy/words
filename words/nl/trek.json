                            },
                            {
                                "target_lang_word": "сквозняк",
                                "target_lang_sense_clarification": "поток воздуха в помещении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zug",
                                "target_lang_sense_clarification": "Luftstrom im Schornstein oder Ofen"
