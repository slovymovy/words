                "senses": [
                    {
                        "sense_id": "ade45505-ae48-35cd-88ae-a00fcb067503",
                        "entry_id": "d3e5b54f-7f66-35b2-ba68-ae948d8861a5",
                        "glosses": [
                            "gesamtes, mehr oder weniger beanspruchtes System der Nerven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2617102-635a-42f6-8b49-6aa3a8a58ec7",
                                "sense_id": "ade45505-ae48-35cd-88ae-a00fcb067503",
                                "text": "„So kam es, dass der Schriftsetzer mit dem ruinierten Nervenkostüm dem allerletzten Vers des allerletzten Kapitels der schwedischen Bibel noch etwas hinzufügte, bevor das Ganze in Druck ging.“"
                            },
                            {
                                "example_id": "fd562951-9e3e-4367-8895-c0c3342acaf1",
                                "sense_id": "ade45505-ae48-35cd-88ae-a00fcb067503",
                                "text": "„Ohnehin hatte ihre Nervosität beständig zugenommen, und nun schien ein Strang ihres angespannten Nervenkostüms mit einem Ruck gerissen zu sein.“"
                            },
                            {
                                "example_id": "298824df-b42c-4645-bd0b-bec541cf0925",
                                "sense_id": "ade45505-ae48-35cd-88ae-a00fcb067503",
                                "text": "„Mein Nervenkostüm ist nicht mehr das solideste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
