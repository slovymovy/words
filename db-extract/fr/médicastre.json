                                                "sense_id": "c9210f85-2407-33ee-827c-bd6f7220d886",
                                                "text": "Did you hear that duck make a quack?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "168e99f4-a1f6-346b-b4ae-adf276571f86",
                                        "entry_id": "79c6851d-9124-3b20-a69d-da7714345091",
                                        "glosses": [
                                            "To make a noise like a duck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f1d58d-21bc-4d65-823e-650b51a53dbd",
                                                "sense_id": "168e99f4-a1f6-346b-b4ae-adf276571f86",
                                                "text": "The more breadcrumbs I threw on the ground, the more they quacked."
                                            },
                                            {
                                                "example_id": "5b5ba3b2-9be0-4b5b-88b9-fc1ce3a81fa0",
                                                "sense_id": "168e99f4-a1f6-346b-b4ae-adf276571f86",
                                                "text": "Do you hear the ducks quack?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9177e66f-9596-310e-a31a-12fd354cffcd",
                                        "entry_id": "79c6851d-9124-3b20-a69d-da7714345091",
                                        "glosses": [
                                            "Of a queen bee: to make a high-pitched sound during certain stages of development."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quack",
