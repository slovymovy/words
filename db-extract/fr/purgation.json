                                    }
                                ]
                            },
                            {
                                "target_word": "purge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec5fc00-cc6a-354d-9830-913c3648ca0e",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "An act or instance of purging."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29fa6de7-28d6-3215-914d-aaeb98d41517",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "An evacuation of the bowels or the stomach; a defecation or vomiting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edd391ac-439b-3f45-b53f-5944e9f6f24b",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "Something which or someone who purges; especially, a medicine that evacuates the intestines; a cathartic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f9e573-a6a2-421f-a088-eb835f2e621d",
                                                "sense_id": "edd391ac-439b-3f45-b53f-5944e9f6f24b",
                                                "text": "he prescribes a Purge or a Vomit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "A forcible removal of people, for example, from political activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215bf5f8-7875-40ce-b9b5-ad534c2df81d",
                                                "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                                                "text": "Stalin liked to ensure that his purges were not reversible."
                                            },
                                            {
                                                "example_id": "92461650-e450-4f88-8a88-8d7dc0746840",
                                                "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                                                "text": "One of the few surviving Bolsheviks with real power, Mikoyan had been brought to Moscow by Stalin in 1926, had escaped innumerable purges, and had demonstrated an uncanny ability to survive and to associate himself with the right faction at the right time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d71a16-05c2-3096-9eec-e0871a6a9d77",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "An act or instance of the cleansing of pipes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce6f212-08fe-3789-b96e-cce08867f1b1",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "A red or reddish liquid that seeps out from raw muscular meat consisting mostly of water and protein; \\\"meat juice\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
