                                "target_senses": [
                                    {
                                        "sense_id": "239de365-59b4-3504-9239-d6f68dee632b",
                                        "entry_id": "53b4325f-70f3-3869-88dd-4fa36f2c8dce",
                                        "glosses": [
                                            "taki, który zachodzi pomiędzy gatunkami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb7ea47-f948-456e-842f-bf9a66376196",
                                                "sense_id": "239de365-59b4-3504-9239-d6f68dee632b",
                                                "text": "Do tego rodzaju wymierania, będącego wynikiem konkurencji międzygatunkowej i realizacją postępu w ewolucji, dodać należy wymieranie powodowane przez losowe zmiany środowiska lub geologiczną ewolucję masywów kontynentalnych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "147d395e-242f-4e25-b580-ebe3e3380c0a",
                        "source_entry_id": "81e15220-223b-3e79-a05d-c15c371fc4cb",
                        "source_sense_id": "69f93cf7-35d5-3264-b397-e434d035e317",
                        "target_lang_word": "interspécifique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interspécifique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f38cb415-6372-3e88-b3be-688636b97ea7",
                                        "entry_id": "0e4c855a-efc5-3f96-9fef-af3c61f4ee61",
                                        "glosses": [
                                            "Qualifie les liaisons, les relations, les croisements, etc. entre deux ou plusieurs espèces vivantes différentes."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338f988c-34dc-48c6-9373-3a637b97989e",
                                                "sense_id": "f38cb415-6372-3e88-b3be-688636b97ea7",
                                                "text": "En 1994, Jones réalise une avancée décisive en obtenant des hybrides interspécifiques fertiles et stables. Après sélection, les variétés ainsi obtenues seront dénommées « Nerica » (New Rice for Africa)."
                                            },
                                            {
                                                "example_id": "b1d49e91-61cb-4c6f-9c73-69a1b57da1ba",
                                                "sense_id": "f38cb415-6372-3e88-b3be-688636b97ea7",
                                                "text": "À noter que le chameau de Bactriane peut s’accoupler au dromadaire et donner naissance à un hybride interspécifique appelé turkoman et réputé pour ses capacités de bât. — (Cirad/Gret/MAE, Mémento de l’Agronome, 1 692 p., page 1468, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                                            },
                                            {
                                                "example_id": "be322ed7-ac85-478b-83fa-177264b708f3",
                                                "sense_id": "f38cb415-6372-3e88-b3be-688636b97ea7",
                                                "text": "Le clonage a permis l'usage des hybrides interspécifiques, la production des graines hybrides “en open” n'étant pas toujours possible, mais toujours aléatoire et/ou difficile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
