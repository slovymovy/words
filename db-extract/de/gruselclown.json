                "senses": [
                    {
                        "sense_id": "1d4dc831-c396-3057-95c4-f1b31d7293bf",
                        "entry_id": "07fb5a58-e830-3889-aa1e-c59569743282",
                        "glosses": [
                            "Person, die sich mit einem abschreckenden Clownskostüm bekleidet, um andere zu erschrecken oder zu bedrohen/überfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d776f06-4d4b-4913-bf37-d821e9aac926",
                                "sense_id": "1d4dc831-c396-3057-95c4-f1b31d7293bf",
                                "text": "„Hinter jeder Hausecke, jedem Auto könnte ein Gruselclown lauern und seine Opfer im besten Fall erschrecken, in schlimmeren Fällen bedrohen oder überfallen.“"
                            },
                            {
                                "example_id": "75d31e74-a54c-446b-8003-504d18e51778",
                                "sense_id": "1d4dc831-c396-3057-95c4-f1b31d7293bf",
                                "text": "„Und täglich grüßt der Gruselclown: Diesmal versuchte ein Maskierter eine Münsteranerin auf der Metzer Straße zu schocken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
