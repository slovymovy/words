{
    "word_family": [
        "топ"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad873d98-c0e1-34cc-8223-d8bb71bb893f",
                    "sense_definition": "Предмет обсуждения или тема в интернет-сообществе.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "internet_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор создал новый <w>топик</w> на форуме, чтобы обсудить последние новости.",
                            "target_lang_translations": {
                                "cs": "Autor vytvořil nové <w>téma</w> na fóru, aby probral poslední novinky."
                            }
                        },
                        {
                            "text": "В этом <w>топике</w> обсуждают только технические вопросы программирования.",
                            "target_lang_translations": {
                                "cs": "V tomto <w>vlákně</w> se diskutují pouze technické otázky programování."
                            }
                        }
                    ],
                    "synonyms": [
                        "тема"
                    ],
                    "common_phrases": [
                        "создать топик",
                        "закрыть топик"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "компьютерный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Předmět diskuse nebo téma v internetové komunitě či na fóru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "téma",
                                "target_lang_sense_clarification": "obecný výraz pro předmět diskuse"
                            },
                            {
                                "target_lang_word": "vlákno",
                                "target_lang_sense_clarification": "internetový slang pro diskusní vlákno na fóru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9541aa5f-ce1a-3e55-b8e4-c294c5fddd65",
                    "sense_definition": "Открытая короткая маечка, предмет летнего женского гардероба.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она надела легкий летний <w>топик</w> и джинсовые шорты.",
                            "target_lang_translations": {
                                "cs": "Oblékla si lehký letní <w>top</w> a džínové šortky."
                            }
                        },
                        {
                            "text": "В магазине было много ярких <w>топиков</w> для жаркой погоды.",
                            "target_lang_translations": {
                                "cs": "V obchodě bylo mnoho pestrých <w>tílek</w> do horkého počasí."
                            }
                        }
                    ],
                    "synonyms": [
                        "топ"
                    ],
                    "common_phrases": [
                        "летний топик"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátké dámské tílko nebo top, součást letního oblečení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "obecné označení pro dámský vršek"
                            },
                            {
                                "target_lang_word": "tílko",
                                "target_lang_sense_clarification": "lehký letní oděv bez rukávů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f123bca-3795-3033-931c-a2f4ba1d1422",
                    "sense_definition": "Маршрутное такси, микроавтобус.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жители города часто жалуются на переполненные <w>топики</w> в часы пик.",
                            "target_lang_translations": {
                                "cs": "Obyvatelé města si často stěžují na přeplněné <w>maršrutky</w> v dopravní špičce."
                            }
                        },
                        {
                            "text": "Старый <w>топик</w> медленно ехал по узкой улице к центру города.",
                            "target_lang_translations": {
                                "cs": "Starý <w>mikrobus</w> pomalu projížděl úzkou ulicí směrem do centra města."
                            }
                        }
                    ],
                    "synonyms": [
                        "маршрутка",
                        "маршрутное такси",
                        "тэшка"
                    ],
                    "common_phrases": [
                        "ехать на топике"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "используется в Севастополе"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Regionální označení pro mikrobus nebo sdílené taxi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "maršrutka",
                                "target_lang_sense_clarification": "přejaté označení pro tento typ dopravy"
                            },
                            {
                                "target_lang_word": "mikrobus",
                                "target_lang_sense_clarification": "typ vozidla používaný jako hromadná doprava"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}