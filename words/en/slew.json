{
    "word_family": [
        "slay",
        "slayer",
        "slaying"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e30684e4-c6ab-39b9-8361-0586f371affb",
                    "sense_definition": "The simple past tense of <w>slay</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slay-past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave knight <w>slew</w> the dragon and saved the entire kingdom from destruction.",
                            "target_lang_translations": {
                                "ru": "Храбрый рыцарь <w>сразил</w> дракона и спас всё королевство от гибели."
                            }
                        },
                        {
                            "text": "In the ancient myth, the hero <w>slew</w> his enemies with a single blow of his sword.",
                            "target_lang_translations": {
                                "ru": "В древнем мифе герой <w>убил</w> своих врагов одним ударом меча."
                            }
                        }
                    ],
                    "synonyms": [
                        "killed",
                        "murdered",
                        "slaughtered"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола slay (убивать, сражать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убил",
                                "target_lang_sense_clarification": "лишил жизни"
                            },
                            {
                                "target_lang_word": "сразил",
                                "target_lang_sense_clarification": "победил в бою"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9b957b5-8285-3037-967c-89703d79fddd",
                    "sense_definition": "A large number or amount of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>slew</w> of papers and notebooks strewn all over her desk.",
                            "target_lang_translations": {
                                "ru": "У неё на столе разбросана целая <w>куча</w> бумаг и тетрадей."
                            }
                        },
                        {
                            "text": "The company released a whole <w>slew</w> of new products just before the holiday season.",
                            "target_lang_translations": {
                                "ru": "Компания выпустила целую <w>массу</w> новых продуктов как раз перед праздничным сезоном."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundance",
                        "lot",
                        "multitude",
                        "heap",
                        "mass"
                    ],
                    "antonyms": [
                        "handful",
                        "paucity",
                        "scarcity"
                    ],
                    "common_phrases": [
                        "whole slew",
                        "slew of reasons",
                        "slew of documents"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или множество чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масса",
                                "target_lang_sense_clarification": "большое количество"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разг., очень много"
                            },
                            {
                                "target_lang_word": "множество",
                                "target_lang_sense_clarification": "значительное число"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b9bb87f-9bfb-3627-8877-9786620c4d6f",
                    "sense_definition": "A crowd or a large number of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>slew</w> of fans waited outside the stadium for hours to see the band.",
                            "target_lang_translations": {
                                "ru": "<w>Толпа</w> фанатов часами ждала у стадиона, чтобы увидеть группу."
                            }
                        },
                        {
                            "text": "The protest attracted a <w>slew</w> of people from all over the country.",
                            "target_lang_translations": {
                                "ru": "Протест привлек <w>множество</w> людей со всей страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd",
                        "throng",
                        "horde",
                        "legion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толпа или большое скопление людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "скопление людей"
                            },
                            {
                                "target_lang_word": "уйма",
                                "target_lang_sense_clarification": "разг., о большом количестве людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e58caf30-a945-3302-ac5c-1173cce9654c",
                    "sense_definition": "A wet, swampy place or a river inlet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prairie round about is wet, especially at the borders of the great reedy <w>slews</w>.",
                            "target_lang_translations": {
                                "ru": "Прерия вокруг влажная, особенно по краям больших заросших камышом <w>заводей</w>."
                            }
                        },
                        {
                            "text": "We had to navigate the boat carefully through the narrow <w>slew</w> to reach the lake.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось осторожно вести лодку через узкую <w>протоку</w>, чтобы добраться до озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "slough",
                        "swamp",
                        "marsh"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Влажное, болотистое место или заводь реки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заводь",
                                "target_lang_sense_clarification": "небольшой залив"
                            },
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "топкое место"
                            },
                            {
                                "target_lang_word": "протока",
                                "target_lang_sense_clarification": "узкий водный путь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47d82fd2-9983-3cc2-b9de-ddd1d3b2c084",
                    "sense_definition": "To rotate or turn something, such as a camera or a gun, about its axis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operator <w>slewed</w> the crane around to pick up the heavy shipping container.",
                            "target_lang_translations": {
                                "ru": "Оператор <w>развернул</w> кран, чтобы поднять тяжелый грузовой контейнер."
                            }
                        },
                        {
                            "text": "The gunners <w>slewed</w> their directors onto the lights and opened fire immediately.",
                            "target_lang_translations": {
                                "ru": "Артиллеристы <w>навели</w> свои приборы на огни и немедленно открыли огонь."
                            }
                        }
                    ],
                    "synonyms": [
                        "pivot",
                        "rotate",
                        "swivel"
                    ],
                    "common_phrases": [
                        "slew around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворачивать или вращать что-либо (например, камеру или орудие) вокруг своей оси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворачивать",
                                "target_lang_sense_clarification": "менять направление"
                            },
                            {
                                "target_lang_word": "разворачивать",
                                "target_lang_sense_clarification": "вращать вокруг оси"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233dcd83-5f2b-32a4-bcfa-477a184d3daa",
                    "sense_definition": "To skid or slide uncontrollably, especially of a vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>slewed</w> across the icy road and ended up in a ditch.",
                            "target_lang_translations": {
                                "ru": "Машину <w>занесло</w> на обледенелой дороге, и она оказалась в кювете."
                            }
                        },
                        {
                            "text": "The bus <w>slewed</w> sideways when the driver slammed on the brakes.",
                            "target_lang_translations": {
                                "ru": "Автобус <w>развернуло</w> боком, когда водитель резко ударил по тормозам."
                            }
                        }
                    ],
                    "synonyms": [
                        "skid",
                        "veer",
                        "slide"
                    ],
                    "common_phrases": [
                        "slew sideways"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неконтролируемо скользить или заноситься (особенно о транспортном средстве)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заносить",
                                "target_lang_sense_clarification": "о скольжении автомобиля"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "двигаться боком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f708b2-186a-34f3-aecf-7036d41dc35d",
                    "sense_definition": "To make a public mockery of someone through insult or wit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian <w>slewed</w> the politician during his late-night monologue.",
                            "target_lang_translations": {
                                "ru": "Комик <w>высмеял</w> политика во время своего ночного монолога."
                            }
                        },
                        {
                            "text": "He was <w>slewed</w> by his peers for his ridiculous fashion choices.",
                            "target_lang_translations": {
                                "ru": "Сверстники <w>подняли его на смех</w> за нелепый выбор одежды."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock",
                        "roast",
                        "insult"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично высмеивать кого-либо, используя оскорбления или остроумие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "делать предметом насмешек"
                            },
                            {
                                "target_lang_word": "разносить",
                                "target_lang_sense_clarification": "жестко критиковать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}