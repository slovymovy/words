                        "cross_references": [
                            {
                                "target_word": "polymorphism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b43e23be-e594-3078-8494-fe963e925e13",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "The ability to assume different forms or shapes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "099ee4e1-796e-3f15-bb0c-37c971333c1e",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "The coexistence, in the same locality, of two or more distinct forms independent of sex, not connected by intermediate gradations, but produced from common parents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48bc4ef5-ca1a-34f8-b2cf-44fd983dd4f5",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "A feature pertaining to the dynamic treatment of data elements based on their type, allowing for a method to have several definitions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7bea604-4d0e-3ae0-bec2-75327746e0fc",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "The property of certain typed formal systems of allowing for the use of type variables and binders/quantifiers over those type variables; likewise, the property of certain expressions (within such typed formal systems) of making use of at least one such typed variable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f133a82b-3dc9-3f6a-bb65-2d0c02fc7b7e",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "The ability of a solid material to exist in more than one form or crystal structure; pleomorphism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c0ca988-75f0-3a1e-ac86-084281b5601c",
                                        "entry_id": "30cc1f86-c88d-341f-a96a-a24efb97d0b1",
                                        "glosses": [
                                            "The regular existence of two or more different genotypes within a given species or population; also, variability of amino acid sequences within a gene's protein."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b8c0c4-8bf3-4c63-915b-80152ce43e78",
                                                "sense_id": "1c0ca988-75f0-3a1e-ac86-084281b5601c",
                                                "text": "Since 1990 they have found an entirely new role: they promise understanding of how and why our genes are all so different. They hold the key to human polymorphism."
                                            },
                                            {
                                                "example_id": "c77ddfca-3ce4-4739-9d34-ac7f0f52b6b5",
                                                "sense_id": "1c0ca988-75f0-3a1e-ac86-084281b5601c",
                                                "text": "Some polymorphisms can be quite stable – so stable that they span the change from an ancestral to a descendant species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
