                            }
                        },
                        {
                            "text": "She was skilled at <w>bargaining</w> with local merchants at the street market.",
                            "target_lang_translations": {
                                "nl": "Ze was bekwaam in het <w>afdingen</w> bij lokale kooplieden op de straatmarkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "negotiating",
                        "haggling"
                    ],
                    "common_phrases": [
                        "bargaining for a better price",
                        "bargaining with vendors"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord en zelfstandig gebruikt werkwoord van bargain; onderhandelen of afdingen over een prijs of voorwaarde"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderhandelen",
                                "target_lang_sense_clarification": "algemeen overleggen om tot overeenstemming te komen"
                            },
                            {
                                "target_lang_word": "afdingen",
                                "target_lang_sense_clarification": "proberen de prijs omlaag te krijgen"
                            },
                            {
