                        "form": "entre-lire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8435858b-9653-33ad-a1d1-0af13024efbb",
                        "entry_id": "31ee2f79-006d-30a1-ad1e-ed6e5f60d31d",
                        "glosses": [
                            "Lire très vite, lire à peine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38c6da3e-7e2a-4976-a491-758e277d7df3",
                                "sense_id": "8435858b-9653-33ad-a1d1-0af13024efbb",
                                "text": "Ce fut, pour ainsi dire, le texte officiel des lettres, celui qui demeurait toujours près de Mme Récamier, et qu’elle ne laissait lire, ou entrelire, qu’à de rares initiés."
                            },
                            {
                                "example_id": "5f284d97-e105-43e8-9396-266a0baa9a6a",
                                "sense_id": "8435858b-9653-33ad-a1d1-0af13024efbb",
                                "text": "Il en prendrait des prémices à entrelire Bouveresse, par exemple, ou à surprendre des propos de chapelle s’il passait de l’une à l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "def77207-3ea4-3f0b-aac3-0620dabb8ca9",
                        "entry_id": "31ee2f79-006d-30a1-ad1e-ed6e5f60d31d",
                        "glosses": [
                            "Se lire mutuellement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "aa571b24-1d9d-4a00-b7f3-c41153029684",
                                "sense_id": "def77207-3ea4-3f0b-aac3-0620dabb8ca9",
                                "text": "Le principal attrait de l’Académie des orateurs, c’était qu’à de certains jours on s’y réunissait, pour s’entrelire des discours sur toute sorte de sujets."
                            }
                        ]
                    }
                ],
