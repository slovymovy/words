    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e14bc1d-a18c-304b-a534-33d0d62eb576",
                    "sense_definition": "A person who translates spoken language or sign language between people who do not share the same language.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "language_translation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foreign visitor needed an <w>interpreter</w> to understand the court proceedings."
                        },
                        {
                            "text": "She worked as a professional <w>interpreter</w> for international business meetings."
                        }
                    ],
                    "synonyms": [
                        "translator"
                    ],
                    "common_phrases": [
                        "language interpreter"
                    ]
                },
                {
                    "sense_id": "5b2bcaae-269b-3f36-89a4-49d60beeaf24",
                    "sense_definition": "A person who explains the meaning or significance of something, such as a guide at a museum or historical site.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum <w>interpreter</w> explained the history behind the ancient artifacts."
                        },
                        {
                            "text": "Our <w>interpreter</w> provided fascinating details about the local culture during the tour."
                        }
                    ],
                    "synonyms": [
                        "guide",
                        "cicerone",
                        "docent"
                    ],
                    "common_phrases": [
                        "museum interpreter"
                    ]
                },
                {
                    "sense_id": "8948cfb6-d9bd-3d52-b003-6ee1e8d9e6d6",
                    "sense_definition": "A performer who presents a piece of art, music, or literature in their own unique style.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is considered one of the finest <w>interpreter</w>s of modern jazz piano."
                        },
                        {
                            "text": "The actor is a brilliant <w>interpreter</w> of Shakespearean roles."
                        }
                    ]
                },
                {
                    "sense_id": "dc8a62eb-7b0b-372f-a086-9b1527a8b09b",
                    "sense_definition": "A computer program that executes instructions written in a programming language line by line.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Python <w>interpreter</w> runs the code directly without needing a separate compilation step."
                        },
                        {
                            "text": "Errors are often caught immediately by the <w>interpreter</w> during the execution process."
                        }
                    ],
                    "synonyms": [
                        "decoder"
                    ],
                    "common_phrases": [
                        "code interpreter"
                    ]
                },
                {
                    "sense_id": "2d0f553e-61bf-3fc9-bcfe-003160b7a3e9",
                    "sense_definition": "Something that reveals, clarifies, or explains the meaning of a situation or concept.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "revealer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Art is often seen as an <w>interpreter</w> of the human condition."
