                "word": "enroulement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad44c591-c9a9-4e3b-83c1-bf4944fe895f",
                        "entry_id": "6d26d8b0-aa06-3717-8492-b0ae8cd667d1",
                        "tags": [
