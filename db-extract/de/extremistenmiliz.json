                "senses": [
                    {
                        "sense_id": "97b1c287-d807-3cb3-9b20-d44c33fec1e7",
                        "entry_id": "c33778fa-b1da-3f4f-b67f-038904237d45",
                        "glosses": [
                            "Miliz, deren Anhänger meist Extremisten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9950cd08-2073-43d4-828e-29879f5033d1",
                                "sense_id": "97b1c287-d807-3cb3-9b20-d44c33fec1e7",
                                "text": "„Vor der Extremistenmiliz sind bislang rund 140.000 Kurden in die Türkei geflohen. In der Nacht wurden den amerikanischen Streitkräfte zufolge auch zwölf kleinere Raffinerien im Osten Syriens bombardiert. Bei den Angriffen starben nach Angaben der oppositionellen syrischen Beobachtungsgruppe 14 IS-Kämpfer.“"
                            },
                            {
                                "example_id": "c1a3082d-822b-40c7-be09-31f015622ae1",
                                "sense_id": "97b1c287-d807-3cb3-9b20-d44c33fec1e7",
                                "text": "„Die Amerikaner bereiten ihren Plan zur Bekämpfung der Extremistenmiliz \"Islamischer Staat\" intensiv vor. In der Nacht auf Donnerstag will US-Präsident Barack Obama seinen Plan zu Bekämpfung der Terrororganisation vorstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
