                ],
                "translations": [
                    {
                        "translation_id": "2b54e207-8f72-485e-9c0a-0adabb72b99b",
                        "source_entry_id": "f162b4dd-cbba-3317-97cd-630fe2a02a55",
                        "source_sense_description": "female knight",
                        "target_lang_word": "chevalière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevalière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba91226b-6e91-33fd-9c5d-3fbc76f44199",
                                        "entry_id": "8a5ee308-2df6-3819-9754-c4daf157990c",
                                        "glosses": [
                                            "Celle qui avait reçu l’ordre de la chevalerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f260c0-c54b-4d36-9977-7329a70c49a4",
                                                "sense_id": "ba91226b-6e91-33fd-9c5d-3fbc76f44199",
                                                "text": "Chevaleresse ou chevalière, les mots existent au Moyen Âge, en latin comme dans les langues d’oïl et d’oc, non seulement pour désigner la femme d’un chevalier, mais aussi la cavalière, celle qui combat à cheval, ou encore la dame qui appartient à un ordre de chevalerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                        "entry_id": "8a5ee308-2df6-3819-9754-c4daf157990c",
                                        "glosses": [
                                            "Femme portant le grade de chevalier dans certains ordres religieux, militaires ou civils."
                                        ],
                                        "tags": [
                                            "À notre époque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a276fc5-1543-4193-bbb1-42986caa21f7",
                                                "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                                "text": "Les chevalières de la Légion d’honneur"
                                            },
                                            {
                                                "example_id": "817810f6-dbb5-436f-a068-bcafaec8153c",
                                                "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                                "text": "Comme les femmes n’occupent chez nous aucune position officielle ni dans la magistrature, ni dans le clergé, ni dans l’armée, le nombre des services rendus à l’État par les petites et les grandes dames est nécessairement fort restreint. On serait obligé d’accorder des brevets de chevalières, d’officières ou de commandeuses aux mères de famille qui ont le plus d’enfants, et aux jeunes filles qui en ont eu le moins."
                                            },
                                            {
                                                "example_id": "e830ddb4-1016-45c1-8baa-a0adcfb630e8",
                                                "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                                "text": "C’est en 1887 que Mᵐᵉ Furtado-Heine a été décorée de la Légion d’honneur. A cette-là, la Légion ne comptait ou n’avait compté que très peu de chevalières en dehors des religieuses. […] Mˡˡᵉ Rosa Bonheur reste aujourd’hui la seule officière."
                                            },
                                            {
                                                "example_id": "26289854-b8e9-497a-92de-11e1495bc3b3",
                                                "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                                "text": "Veiler (Véronique, Marie-Thérèse, Claude), lieutenante-colonelle. Chevalière du 18 janvier 2001."
                                            },
                                            {
                                                "example_id": "74fd2e64-93b7-423f-999c-544bc2055a5d",
                                                "sense_id": "d03ac1ca-5ba5-3b5b-8514-e3c708214aec",
                                                "text": "Officière de l’Ordre du Canada et chevalière de l’Ordre national du Québec, Andrée Lachapelle a participé au début de la télévision québécoise dans les années 1950."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7edbe895-bf66-35ef-87b4-cc4fab35516d",
                                        "entry_id": "8a5ee308-2df6-3819-9754-c4daf157990c",
                                        "glosses": [
                                            "Épouse d’un chevalier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ef9274-52be-4fbb-94e7-677b972760bb",
                                                "sense_id": "7edbe895-bf66-35ef-87b4-cc4fab35516d",
                                                "text": "Dira-t-on aujourd’hui Monsieur l’Écuyer, Madame l’Écuyère, Monsieur le Chevalier, Madame la Chevalière ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevalière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                        "entry_id": "71081cca-f93d-3899-92fd-cd05f5e783dd",
                                        "glosses": [
                                            "Anneau large et épais, le plus souvent en or, orné d’un chaton de même métal, sur lequel sont gravées des initiales ou des armoiries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b89d3ca-55eb-4432-a48b-a210fa6ffe8f",
                                                "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                                "text": "Elle portait seulement à l’annulaire gauche une chevalière en camée, sertie de deux griffes de lion."
                                            },
                                            {
                                                "example_id": "ed24c0df-8d61-4931-9b29-cbe9a79a74b5",
                                                "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                                "text": "Cependant, il se tortillait sur la banquette et, de sa lourde main ornée d’une chevalière et d’un assez joli brillant, promenait le cul de son verre sur le marbre de la table […]"
                                            },
                                            {
                                                "example_id": "7ff1dbb7-f04e-4fad-a7ee-936ff120f453",
                                                "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                                "text": "En fait de bestialité ils avaient des montres et des chevalières en or, et puis de gros carnets de chèques."
                                            },
                                            {
                                                "example_id": "f16e7670-68e8-40ee-892a-a0c839a8e784",
                                                "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                                "text": "Il portait une chevalière sur le chaton de laquelle étaient gravées des armoiries."
                                            },
                                            {
                                                "example_id": "abdeaac0-3ad8-43a9-8641-60c1d2d3da2e",
                                                "sense_id": "35cd77d7-b4cb-3090-9a00-306d9eec811f",
                                                "text": "Surtout qu’il en porte souvent une autre au petit doigt de la main droite, un genre de chevalière plutôt mastoc, qui n’arrête pas de se retourner quand il improvise et qu’il tripote distraitement lorsqu’il est embarrassé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chevalière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b09bd37-3a42-3c35-8e6f-7fc58de30ff6",
                                        "entry_id": "52ec4d55-e91c-3508-b18c-368d7eefc27a",
                                        "glosses": [
                                            "Féminin singulier de chevalier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d87cf2-0755-44d9-b853-0bdf38bdd2df",
                                                "sense_id": "6b09bd37-3a42-3c35-8e6f-7fc58de30ff6",
                                                "text": "Avoir une âme chevalière."
                                            },
                                            {
                                                "example_id": "f0b2bf13-bbb9-4906-bd0f-3c2bddc33342",
                                                "sense_id": "6b09bd37-3a42-3c35-8e6f-7fc58de30ff6",
                                                "text": "cette race de grâce, cette race de sainteté si particulière, si chevalière, si généreuse, si libérale, si française."
                                            },
                                            {
                                                "example_id": "5e1a84b1-50f5-4ac9-b725-c0be2cc1840b",
                                                "sense_id": "6b09bd37-3a42-3c35-8e6f-7fc58de30ff6",
                                                "text": "Au fond, Gringoire, comme M. Despréaux, était « très peu voluptueux ». Il n’était pas de cette espèce chevalière et mousquetaire qui prend les jeunes filles d’assaut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa9629fe-0f02-492c-a212-a39bfe15c3c8",
                        "source_entry_id": "f162b4dd-cbba-3317-97cd-630fe2a02a55",
                        "source_sense_description": "female knight",
                        "target_lang_word": "chevaleresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevaleresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fcd6a67-c68f-3b04-83ad-3d961a264129",
                                        "entry_id": "85562487-dddf-3f9b-948e-f2c8e345629d",
                                        "glosses": [
                                            "Celle qui avait reçu l’ordre de la chevalerie."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47461bf5-9c13-4ffd-993f-5741a4fb8b48",
                                                "sense_id": "4fcd6a67-c68f-3b04-83ad-3d961a264129",
                                                "text": "puis, ayant fait passer sur une nef particulière, et qui était connue pour sa marche rapide, toutes les comtesses, baronnesses, chevaleresses et bourgeoises de Londres qui allaient rejoindre la reine à Gand, il leur donna une garde de trois cents hommes d’armes et de cinq cents archers"
                                            },
                                            {
                                                "example_id": "9a89e813-5636-4875-9940-129e63e4de3a",
                                                "sense_id": "4fcd6a67-c68f-3b04-83ad-3d961a264129",
                                                "text": "Sophie Cassagnes-Brouquet, dans son ouvrage Chevaleresses, redonne vie à d’autres guerrières aussi réelles que Jeanne d’Arc. Bien que ses collègues historiens lui aient assuré qu’il n’en existait pas, l’historienne exhume des textes prouvant le contraire, qu’elle découvre aussi bien en France qu’ailleurs en Europe : « La plupart sont d’origine aristocratique ; certaines appartiennent au peuple, mais c’est plus rare. On trouve des jeunes filles, des femmes mariées, des veuves…En général, elles sont placées dans une situation où elles doivent se prendre en charge. Le mari est prisonnier ou mort. Elles deviennent le chef et prennent les armes. Ce sont bien des chevaleresses. Certaines se voient même dédier des traités militaires comme la reine Marguerite d’Anjou en Angleterre et elle s’en servira, car elle sera mise dans la position de commander une armée. » Certaines accompagnent aussi les hommes de la famille en croisade au Proche-Orient, et s’il faut défendre la Terre sainte, elles n’hésitent pas à se battre."
                                            },
                                            {
                                                "example_id": "cd9e63cf-69b8-4246-b8d8-fbba20d57496",
                                                "sense_id": "4fcd6a67-c68f-3b04-83ad-3d961a264129",
                                                "text": "Guerrières, combattantes, preuses, chevaleresses ont, depuis le Moyen Âge, nourri nos imaginaires littéraire et iconographique. Certaines de ces femmes ont bien existé, intégrant parfois des ordres combattants, des bataillons de croisés…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b4c4734-1332-348a-b3fd-d510cda18f82",
                                        "entry_id": "85562487-dddf-3f9b-948e-f2c8e345629d",
                                        "glosses": [
                                            "Épouse d’un chevalier."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chevaleresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9fa77ac-ffcd-3bda-b890-cfab2a8eb64f",
                                        "entry_id": "505ae1c2-0064-3f5b-9db8-b7746e09fcb9",
                                        "glosses": [
