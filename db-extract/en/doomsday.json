                    {
                        "translation_id": "d5e39fc3-501c-4b86-a27a-1e7ba098964f",
                        "source_entry_id": "d5b3deda-e4ff-36d7-afe5-721ada4f4bf1",
                        "source_sense_description": "day when God is expected to judge the world",
                        "target_lang_word": "коне́ц све́та",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коне́ц све́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fad34ae1-8dff-3823-9a29-95b2ea37ecb2",
                                        "entry_id": "1f4abbdc-41d5-3026-ad6c-cfe3b3ea9cce",
                                        "glosses": [
                                            "спрогнозированная либо воображаемая угроза прекращения существования всех людей, цивилизаций, всего человечества, Земли, или даже Вселенной целиком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775a529a-74f9-4dda-898d-35c00a3c125d",
                                                "sense_id": "fad34ae1-8dff-3823-9a29-95b2ea37ecb2",
                                                "text": "То ли это какой-то вселенский шабаш, то ли завтра ― конец света."
                                            },
                                            {
                                                "example_id": "b215f14a-b5f5-453c-94f1-495bd416df9d",
                                                "sense_id": "fad34ae1-8dff-3823-9a29-95b2ea37ecb2",
                                                "text": "Его эти фельетоны возмущали, но в то же время он раздражался против своих друзей евреев, относившихся к этим писулькам так, словно пришёл конец света."
                                            },
                                            {
                                                "example_id": "5a34598a-0bdb-410e-a221-0370087c888d",
                                                "sense_id": "fad34ae1-8dff-3823-9a29-95b2ea37ecb2",
                                                "text": "Возможно, это произойдёт после конца света, когда на Земле останется вдвое меньше людей."
                                            },
                                            {
                                                "example_id": "462d01ec-b808-4caf-9292-716e54ad6129",
                                                "sense_id": "fad34ae1-8dff-3823-9a29-95b2ea37ecb2",
                                                "text": "Похоже, панические настроения некоторой части наших сограждан, ожидающих конца света в связи с пуском андронного коллайдера в Церне, немного приутихли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56ead09a-5044-356c-b3a3-3131614cf0e7",
                                        "entry_id": "1f4abbdc-41d5-3026-ad6c-cfe3b3ea9cce",
                                        "glosses": [
                                            "перен."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb3ba92-d556-4de4-a12f-66121bb9aaea",
                                                "sense_id": "56ead09a-5044-356c-b3a3-3131614cf0e7",
                                                "text": "Но, в конце концов, присутствие мышей ещё не конец света."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
