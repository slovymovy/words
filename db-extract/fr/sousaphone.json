                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619e5649-9f1d-4662-a2bd-7c5cc65d6d51",
                                "sense_id": "13cc6c8b-de57-30ad-8202-1146bb48aafc",
                                "text": "La capitale nationale s’apprête à vibrer au son des cornemuses, des sousaphones et des balalaïkas alors que des centaines de musiciens provenant de six pays débarqueront en ville dans le cadre du 13ᵉ Festival international de musiques militaires de Québec (FIMMQ)."
                            },
                            {
                                "example_id": "743ca4ae-5b88-43c0-9a2f-d6ad9542fb4e",
                                "sense_id": "13cc6c8b-de57-30ad-8202-1146bb48aafc",
                                "text": "En Amérique, tout est vif, criard : oui, leurs paysages, leurs humeurs, leurs sousaphones et leurs gratte-ciel, leurs steaks si épais, leurs pommes de la taille des pamplemousses, le caquetage aux mâchoires d’acier de leurs usines et de leurs taxis."
                            }
                        ]
                    }
