                                "example_id": "9686521f-a65b-4ad8-95e6-c731fdfd215f",
                                "sense_id": "da249c99-a3ad-3cf5-9900-68371dbe6c05",
                                "text": "[S]he cursed him with the bitterest imprecations, and raved like a Bedlamite at the door, which she attempted to burst open."
                            },
                            {
                                "example_id": "23e2a677-620a-4ac9-a23a-314049b9c7bc",
                                "sense_id": "da249c99-a3ad-3cf5-9900-68371dbe6c05",
                                "text": "Upon coming to the edge of the outer surf, the man at the stern of our boat, steering with a long oar, began to stamp his feet and roar like a bedlamite […] ."
                            },
                            {
                                "example_id": "c873f73f-3355-4b79-bff9-48a95fff0db2",
                                "sense_id": "da249c99-a3ad-3cf5-9900-68371dbe6c05",
                                "text": "Bradly stood listening to the old woman's squalling, resenting its note of febrile violence; its bedlamite insolence of old age."
                            }
                        ]
                    }
