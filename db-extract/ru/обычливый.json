                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e93ff4c-705e-4f57-a09b-9f06fcef298a",
                        "source_entry_id": "46ecdfb5-fb86-33a8-bcff-f2def7bee0c1",
                        "source_sense_id": "5453ea3c-6bcd-3f64-af1c-6f76f1c032c4",
                        "target_lang_word": "well-behaved",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-behaved",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24f1d1d6-4ae1-3f26-b9be-a2302831a436",
                                        "entry_id": "2c3b2ce5-15a8-32e3-8e76-8f7d04c536cb",
                                        "glosses": [
                                            "Having good manners and acting properly; conforming to standards of good behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f02bca6-4ffb-4f48-80b9-e0a768166209",
                                                "sense_id": "24f1d1d6-4ae1-3f26-b9be-a2302831a436",
                                                "text": "The boy is well-behaved and is seldom naughty."
                                            },
                                            {
                                                "example_id": "fea9bc35-1aaf-4f71-b0fd-f4b674a4ac35",
                                                "sense_id": "24f1d1d6-4ae1-3f26-b9be-a2302831a436",
                                                "text": "How bright were the fire-irons; how clean the Dutch riles round the old-fashioned fire-place, how well-behaved even the cat."
                                            },
                                            {
                                                "example_id": "6ebe93dd-2c52-4e40-9524-76237151e888",
                                                "sense_id": "24f1d1d6-4ae1-3f26-b9be-a2302831a436",
                                                "text": "Remember that well-behaved software always keeps its hands off the computer's hardware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2aeffe-b5d7-350b-9017-2e23c68b4f71",
                                        "entry_id": "2c3b2ce5-15a8-32e3-8e76-8f7d04c536cb",
                                        "glosses": [
                                            "Having intuitive, easy to handle properties, especially: having a finite derivative of all orders at all points, and having no discontinuities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
