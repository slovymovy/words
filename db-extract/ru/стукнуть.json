                                "sense_id": "81c948a3-8c33-381b-8296-ad75ce6ffca7",
                                "text": "ско́лько тебе́ сту́кнуло?",
                                "translation": "how old are you (now)?",
                                "english": "how old are you (now)?"
                            },
                            {
                                "example_id": "73815696-156b-4587-83ef-8f93adcad194",
                                "sense_id": "81c948a3-8c33-381b-8296-ad75ce6ffca7",
                                "text": "Игорю Никола́еву сего́дня сту́кнуло 50!",
                                "translation": "Igor Nikolayev turned 50 today!",
                                "english": "Igor Nikolayev turned 50 today!"
                            },
                            {
                                "example_id": "aabb9841-56cb-4eb4-ab0f-badabe77cb61",
                                "sense_id": "81c948a3-8c33-381b-8296-ad75ce6ffca7",
                                "text": "ему́ что́-то в го́лову сту́кнуло",
                                "translation": "he got some crazy (new) idea (also used when someone starts behaving strangely)",
                                "english": "he got some crazy (new) idea (also used when someone starts behaving strangely)"
                            }
