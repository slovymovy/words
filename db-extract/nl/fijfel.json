                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4291a3-b18d-4420-a37e-b5942a1413ab",
                                                "sense_id": "63e43559-102f-35d0-bc7e-f103432eeb5e",
                                                "text": "Der Pfeifer ist weithin zu hören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pfeifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                        "entry_id": "b43d5954-4af9-38f4-b042-b474b50e6282",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e70b5a-e45b-49b0-b1b4-6fed91ba9216",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Frau Pfeifer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9db323ef-17da-4ac9-be91-40a04e5a0c82",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Herr Pfeifer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9fb8f3a1-8486-4308-8cc3-0b2f4bc6009a",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Die Pfeifers kommen heute aus Düsseldorf."
                                            },
                                            {
                                                "example_id": "4b703eda-9896-432f-89d6-456e4b652c44",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Der Pfeifer trägt nie die Schals, die die Pfeifer ihm strickt."
                                            },
                                            {
                                                "example_id": "926fc4b8-d32f-4c96-abc8-bb5fbe0f6212",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfeifer kommt, geht der Herr Pfeifer.“"
                                            },
                                            {
                                                "example_id": "adf58c5c-b360-480b-9b00-350ad15b2a28",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Pfeifer kommt und geht."
                                            },
                                            {
                                                "example_id": "4f55988a-475d-44b5-aa93-7802252eba27",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "Pfeifers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "2d4cd820-11b7-4eac-9e2b-c95d48c493c9",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "An verregneten Herbsttagen ist Familie Pfeifers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "ade3a4be-2cfa-41a6-8a88-32d9ec781ac8",
                                                "sense_id": "305f6ae0-33a9-31dd-8154-8b389d125c97",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Pfeifer das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
