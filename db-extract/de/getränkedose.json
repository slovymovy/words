                                    },
                                    {
                                        "sense_id": "e4b5618e-b64c-3fb5-8aed-e77b8609ffc4",
                                        "entry_id": "56eae89f-6a0d-35a0-9485-01f924537840",
                                        "glosses": [
                                            "Autre nom de la sarcelle d’hiver, (Anas crecca)."
                                        ],
                                        "tags": [],
