                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нас",
                                "target_lang_sense_clarification": "уточнение группы"
                            },
                            {
                                "target_lang_word": "мы",
                                "target_lang_sense_clarification": "уточнение группы"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nosotros los",
                                "target_lang_sense_clarification": "masculino o mixto antes de sustantivo"
                            },
                            {
                                "target_lang_word": "nosotras las",
                                "target_lang_sense_clarification": "femenino antes de sustantivo"
                            }
                        ]
                    }
                },
