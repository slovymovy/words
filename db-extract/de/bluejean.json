                "senses": [
                    {
                        "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                        "entry_id": "7ce31667-2ea7-3206-bbaf-630c0a1ca217",
                        "glosses": [
                            "Freizeithose aus blauem Baumwollstoff mit Nieten"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca9dc35-601c-4d20-b639-e4de135f8f52",
                                "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                                "text": "„So sorgte der ORF-Sportreporter Sigi Bergmann vor einigen Jahren für großes Aufsehen, als er sich live in der Sendung sein Insulin durch die Bluejean applizierte.“"
                            },
                            {
                                "example_id": "fd5b83b8-bf8f-4550-8922-eea4292cc2ad",
                                "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                                "text": "„Es ist bekanntlich gar nicht leicht, eine Bluejean überhaupt zu kriegen.“"
                            },
                            {
                                "example_id": "589da387-638e-41a7-9850-08e656f0208e",
                                "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                                "text": "„Ich hatte nämlich meine Hose ausgezogen, um eine Bluejean, die sie mir zum Probieren hingehalten hatte, anzuziehen.“"
                            },
                            {
                                "example_id": "78bcd931-94c6-45b1-9428-303ad063f10a",
                                "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                                "text": "„Auf jeden Fall hat der Freddie eine ganz neue weiße Bluejean angehabt und der Weg zum Hasenstall war naturgemäß ein bisschen dreckig, jetzt war die Bluejean nachher nicht mehr sonderlich weiß und das hat ihm gar nicht getaugt.“"
                            },
                            {
                                "example_id": "8b67bd92-2f4e-40b6-a1ec-eb0fe06a0192",
                                "sense_id": "472dbc5c-a044-3684-af31-343138849052",
                                "text": "„Maria kam pünktlich und leichten Schrittes in Bluejean, einer hellen Jacke und mit rotem Halstuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
