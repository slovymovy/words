                ],
                "senses": [
                    {
                        "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                        "entry_id": "e0eb8c3a-be1b-3dc8-ab89-ce642373afc3",
                        "glosses": [
                            "Mal user d’une chose ; en faire un mauvais usage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2adefbbd-3e2b-45b7-bd3c-50f633137736",
                                "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                                "text": "Ce contempteur de la ruse ment. Ce flétrisseur de la lâcheté use et mésuse de petits papiers. Pouah !"
                            },
                            {
                                "example_id": "92e68edf-fd78-4b29-afdb-44a0a06b3f0b",
                                "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                                "text": "Cet engagement essentiel qu’on est en droit d’exiger de l’écrivain, celui qui découle de la nature même de son art : ne pas mésuser du langage et faire par conséquent en sorte que sa parole, de quelque manière qu’il s’y prenne pour la transcrire sur le papier, soit toujours vérité."
                            },
                            {
                                "example_id": "9f133e92-dde6-41f0-bce7-0162e3ec9afe",
                                "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                                "text": "Je m’ôtais les moyens de plaire pour oublier que jes avais eus et que j’en avais mésusé."
                            },
                            {
                                "example_id": "f4099ce5-16e8-44d0-a639-f5ce0efabbb9",
                                "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                                "text": "Victor Hugo est un dangereux révolutionnaire qui mésuse de l’hospitalité belge."
                            },
                            {
                                "example_id": "9bd3e2d8-4d54-490d-8aaa-d458fad3236a",
                                "sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                                "text": "Enfin, qu’une Sabine Pallières mésuse de la ponctuation est un blasphème d’autant plus grave que dans le même temps, des poètes merveilleux nés dans des caravanes puantes ou des cités poubelles ont pour elle cette sainte révérence qui est due à la Beauté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "902bd06b-634d-4a98-a2a7-fdd081dab5ab",
                        "source_entry_id": "e0eb8c3a-be1b-3dc8-ab89-ce642373afc3",
                        "source_sense_id": "b268ee56-dd6d-325f-9604-477291f65745",
                        "target_lang_word": "misuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b40133-e6c5-3e4e-b5d4-063778442d7d",
                                        "entry_id": "6db55e93-d788-338c-830e-e7cc9c2a8972",
                                        "glosses": [
                                            "An incorrect, improper or unlawful use of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8e174cd-62a1-499e-95a0-ef1d7e8fb715",
                                                "sense_id": "c6b40133-e6c5-3e4e-b5d4-063778442d7d",
                                                "text": "The Queen may be celebrating her jubilee but the Queen's English Society, which has railed against the misuse and deterioration of the English language, is to fold."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09edaf93-af1f-3998-84e7-dbe2d2a344e9",
                                        "entry_id": "6cd6a31b-518c-3da8-8e9c-a3cb1335c949",
                                        "glosses": [
                                            "To use (something) incorrectly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58fec574-188b-3340-8313-c3495fff7620",
                                        "entry_id": "6cd6a31b-518c-3da8-8e9c-a3cb1335c949",
                                        "glosses": [
                                            "To abuse or mistreat (something or someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14aa1806-ae79-3819-915b-f0ab03d7b707",
                                        "entry_id": "6cd6a31b-518c-3da8-8e9c-a3cb1335c949",
                                        "glosses": [
                                            "To rape (a woman); later more generally, to sexually abuse (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53792344-74f8-4188-8382-3c6c494b5532",
                                                "sense_id": "14aa1806-ae79-3819-915b-f0ab03d7b707",
                                                "text": "“If that is true she would be the first case I have ever heard of, as most female captives are misused by the entire tribe.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c34eec-9f46-3605-8374-0a8a9eb0c00b",
                                        "entry_id": "6cd6a31b-518c-3da8-8e9c-a3cb1335c949",
                                        "glosses": [
                                            "To abuse verbally, to insult."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1302f454-2d05-4352-8c9e-c4e5168f4fd5",
                                                "sense_id": "37c34eec-9f46-3605-8374-0a8a9eb0c00b",
                                                "text": "Socrates was brought upon the stage by Aristophanes, and misused to his face: but he laughed, as if it concerned him not […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
