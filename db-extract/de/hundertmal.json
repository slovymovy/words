        "de-extract.jsonl": [
            {
                "entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                "word": "hundertmal",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af0b6d82-c995-343f-aa38-ee1a8b7717ac",
                        "entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                        "glosses": [
                            "hundert Male"
                        ],
                        "tags": [
                            "bestimmtes Wiederholungszahlwort (Angabe",
                            "wie oft etwas wiederkehrt)"
                        ],
                        "examples": [
                            {
                                "example_id": "7bcd86a2-0ec1-4438-b20b-242c759f717f",
                                "sense_id": "af0b6d82-c995-343f-aa38-ee1a8b7717ac",
                                "text": "„Wird eine Werbung hundertmal angezeigt und dabei einmal angeklickt, beträgt die Klickrate 1 %.“"
                            },
                            {
                                "example_id": "bd5b533b-3299-432f-beeb-cb15479e1be0",
                                "sense_id": "af0b6d82-c995-343f-aa38-ee1a8b7717ac",
                                "text": "„Bemerkenswert ist dabei, dass Ouagadougou eine deutlich über hundertmal höhere Einwohnerzahl hat als Loudun, und zwischen Ouagadougou und Leuze (seit 1977 Leuze-en-Hainaut, 13.205 Einwohner) ebenfalls eine Städtepartnerschaft besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d8568a4-6f3e-3b9c-9666-54b62c35ad90",
                        "entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                        "glosses": [
                            "häufige, viele Male"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c9fcf19c-0b3c-4d78-9ac5-f30f9e461c2d",
                                "sense_id": "9d8568a4-6f3e-3b9c-9666-54b62c35ad90",
                                "text": "„Im Interview sprudelt der geborene Londoner mehrsprachig furios vor sich hin. Hundertmal wechselt er seine Sitzposition wie eine gestochene Tarantel - mitsamt Sessel!“"
                            },
                            {
                                "example_id": "74096b80-4a30-4520-a437-9ec0897f27ef",
                                "sense_id": "9d8568a4-6f3e-3b9c-9666-54b62c35ad90",
                                "text": "„Die Krone ist absolut, ihre Autorität ist an kein Gesetz gebunden, und wenn sie hundertmal alle Gesetze umstoße, ihre Willkür ist das alleinige, das höchste Gesetz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d88ebe39-07ff-3a38-8be8-66a12a0fa272",
                        "entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                        "glosses": [
                            "noch so sehr"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "48efa38f-33f6-4382-9b08-5f6546643270",
                                "sense_id": "d88ebe39-07ff-3a38-8be8-66a12a0fa272",
                                "text": "Raucher kann man hundertmal vor den Gefahren ihres fraglichen Vergnügens warnen, dennoch rauchen sie weiter."
                            },
                            {
                                "example_id": "af353e99-8432-42c7-83c4-533f99c497f1",
                                "sense_id": "d88ebe39-07ff-3a38-8be8-66a12a0fa272",
                                "text": "Man kann es den Leuten hundertmal erklären, aber sie verstehen es nicht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c50ddd84-694d-456f-bb0a-3f7815217f60",
                        "source_entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                        "source_sense_id": "af0b6d82-c995-343f-aa38-ee1a8b7717ac",
                        "source_sense_description": "bestimmtes Wiederholungszahlwort (Angabe, wie oft etwas wiederkehrt): hundert Male",
                        "target_lang_word": "a hundred times",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "69d5434c-1d71-4fc3-89f4-523841d8ec1f",
                        "source_entry_id": "463e522b-2c49-3ea4-8dd0-f242d35389ff",
                        "source_sense_id": "af0b6d82-c995-343f-aa38-ee1a8b7717ac",
                        "source_sense_description": "bestimmtes Wiederholungszahlwort (Angabe, wie oft etwas wiederkehrt): hundert Male",
                        "target_lang_word": "cent fois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cent fois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                        "entry_id": "cde27a2c-eb46-3470-b5c9-eeccf55a0b60",
                                        "glosses": [
                                            "Fort souvent."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365e9619-642d-4692-ba92-4d8da4f00e67",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "J'ignore comment j'eus assez de force pour résister à cette cruelle agonie; je reçus cent fois la mort, et mon ame, déchirée par la douleur, éprouva, pendant ces funestes momens, les tourmens d'une horrible anxiété."
                                            },
                                            {
                                                "example_id": "3e6bcc5a-9b57-4c8c-8d0b-4ad93dc13543",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "Elle m’a dit plus de cent fois, et je vous le redirai autant de fois, qu’elle aimerait mieux se jeter dans le puits que de se laisser seulement embrasser par un coureur de filles comme vous."
                                            },
                                            {
                                                "example_id": "1272e800-2408-46a1-b698-67b6a5fb6d70",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "Les apostrophes injurieuses, les interpellations violentes des réactionnaires, interrompirent cent fois les discours des orateurs des gauches."
                                            },
                                            {
                                                "example_id": "4c45d026-e5c3-4c6b-b486-8dcca9b5ea5f",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "Cent fois, Marcel rumina cette double question et cent fois il se buta à une impossibilité."
                                            },
                                            {
                                                "example_id": "634c1cb1-cbcd-4f9d-8f81-41bd442be39d",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "Le sommeil fut long, très long à venir ; encore lorsqu’il finit par fermer ses paupières, fut-il si agité qu’elle se réveilla cent fois."
                                            },
                                            {
                                                "example_id": "4a55e745-4986-409f-97a6-b93b5258059f",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "Je me suis répété cent fois – et encore au moment où j’écris ces lignes – qu’à 24 heures près, mon existence aurait pu suivre un cours tout différent de celui qu’elle a pris."
                                            },
                                            {
                                                "example_id": "025690da-6c42-41ee-9595-08dad8453766",
                                                "sense_id": "9386e8ad-e12d-3c93-ab54-9ee39b8c85b3",
                                                "text": "— La gadji lui menait la vie dure. Et les petites gadjis aussi. C'est ce qui arrive quand tu te laisses mener par le bout du nez, je le lui ai dit cent fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6867d9-7d47-349f-9364-44ab8666f7b3",
                                        "entry_id": "cde27a2c-eb46-3470-b5c9-eeccf55a0b60",
                                        "glosses": [
                                            "Beaucoup."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96f52eaf-7480-429b-94b7-9fbb1dd2f879",
                                                "sense_id": "ba6867d9-7d47-349f-9364-44ab8666f7b3",
                                                "text": "Nous étions tous possédés d’une inquiétude lente qui nous faisait languir. Personne ne s’ennuyait, mais cette sensation poignante était cent fois pire que l’ennui. Il paraissait d’avance que cette nuit n’aurait pas de fin."
                                            },
                                            {
                                                "example_id": "b1ebd6b6-c042-4261-a2a6-8b7ea2ff9d5c",
                                                "sense_id": "ba6867d9-7d47-349f-9364-44ab8666f7b3",
                                                "text": "La moindre photographie nous apprend cent fois plus sur le Parthénon qu'un volume consacré à vanter les merveilles de ce monument ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
