                                "target_senses": [
                                    {
                                        "sense_id": "c55ac2d9-56db-3334-a1f8-8eda3874c5bf",
                                        "entry_id": "ef5a21fb-4449-3f22-a609-56bc531a370a",
                                        "glosses": [
                                            "odgłos uderzających o ziemię kopyt biegnącego zwierzęcia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a0994ae-3d05-4f8b-86c8-0a3245f4888e",
                                                "sense_id": "c55ac2d9-56db-3334-a1f8-8eda3874c5bf",
                                                "text": "Stanęliśmy i przez chwilę zaległa taka cisza, że słychać było tętent siwej klaczy dopędzającego nas adiutanta."
                                            },
                                            {
                                                "example_id": "e8ae522e-6bb1-4c77-b08a-8e58018a654e",
                                                "sense_id": "c55ac2d9-56db-3334-a1f8-8eda3874c5bf",
                                                "text": "Na przodzie orszaku smyczki dotąd w powietrzu sterczące na struny opadły; z dźwiękami skrzypiec i basetli wygrywających marsza zmieszał się turkot kół i tętent koni."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
