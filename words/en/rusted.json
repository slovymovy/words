    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "acd1980c-9ef8-3d71-a709-d099b0390b33",
                    "sense_definition": "Covered with rust or corroded due to oxidation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bicycle was <w>rusted</w> and no longer safe to ride.",
                            "target_lang_translations": {
                                "cs": "Staré kolo bylo <w>zrezivělé</w> a už nebylo bezpečné na něm jezdit."
                            }
                        },
                        {
                            "text": "He found a <w>rusted</w> key buried in the garden soil.",
                            "target_lang_translations": {
                                "cs": "Našel <w>zrezivělý</w> klíč zakopaný v zahradní půdě."
                            }
                        }
                    ],
                    "synonyms": [
                        "corroded",
                        "oxidized"
                    ],
                    "common_phrases": [
                        "rusted metal",
                        "rusted iron"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrytý rzí nebo zkorodovaný v důsledku oxidace."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zrezivělý",
                                "target_lang_sense_clarification": "běžný výraz pro předměty pokryté rzí"
                            },
                            {
                                "target_lang_word": "zrezlý",
                                "target_lang_sense_clarification": "hovorovější varianta pro zrezivělý"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29d92968-0c8f-324c-baa4-b5ee5e4659a8",
                    "sense_definition": "Simple past and past participle of <w>rust</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The iron gate had <w>rusted</w> completely after years of rain.",
                            "target_lang_translations": {
                                "cs": "Železná brána po letech dešťů úplně <w>zrezivěla</w>."
                            }
                        },
                        {
                            "text": "The damp weather <w>rusted</w> the tools left outside.",
                            "target_lang_translations": {
                                "cs": "Vlhké počasí způsobilo, že nářadí ponechané venku <w>zrezivělo</w>."
                            }
                        }
                    ],
