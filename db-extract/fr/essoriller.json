                "senses": [
                    {
                        "sense_id": "2c6d0d30-bff8-3d53-a090-3553c4a33e48",
                        "entry_id": "5a6f831b-aaca-398a-b24f-9811ca039347",
                        "glosses": [
                            "Couper les oreilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d310b9-86b8-428a-a79c-8dde74d17ef2",
                                "sense_id": "2c6d0d30-bff8-3d53-a090-3553c4a33e48",
                                "text": "Essoriller un chien."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d2dfdb3-ba81-3908-ac37-91dfa035cb4b",
                        "entry_id": "5a6f831b-aaca-398a-b24f-9811ca039347",
                        "glosses": [
                            "Mutiler en coupant les oreilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b032b70e-4386-44d2-b0cd-7c09ef503fd6",
                                "sense_id": "0d2dfdb3-ba81-3908-ac37-91dfa035cb4b",
                                "text": "Antigone, fils d’Aristobule II, qui était devenu roi et grand prêtre des Juifs, fait essoriller son oncle Hyrcan II afin de le rendre définitivement inapte aux fonctions sacerdotales pour lesquelles la Loi exigeait l’intégrité physique."
                            },
                            {
                                "example_id": "bc28b3c0-cf84-4ce8-9007-b4e0b489425b",
                                "sense_id": "0d2dfdb3-ba81-3908-ac37-91dfa035cb4b",
                                "text": "Que Montfleury s’en aille,\nOu bien je l’essorille et le désentripaille !"
                            },
                            {
                                "example_id": "d33783fb-e92d-4ab9-81a0-37f54e0c912b",
                                "sense_id": "0d2dfdb3-ba81-3908-ac37-91dfa035cb4b",
                                "text": "— Vertusguoy, ventreguoy, sacripant, sacredieu, au meurtre, à mort, à l’aide, cocu, coquin, coquard, catin, crottin, cafard, crapaud, croquant, carcan, je t’essorillerai, je te boyauderai, je t’en baillerai de vertes, des mûres et des blettes, je te talerai le derrière, attrape, face à clystère !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "51ddd758-8100-30e1-b044-4300b7ed571b",
                        "entry_id": "5a6f831b-aaca-398a-b24f-9811ca039347",
                        "glosses": [
                            "Couper les cheveux très courts."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "80efdd8e-5683-4e33-ad98-7327ba39e63e",
                                "sense_id": "51ddd758-8100-30e1-b044-4300b7ed571b",
                                "text": "Qui vous a ainsi essorillé ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8b80d4b-78a8-3611-a41a-9da0517f8e97",
                        "entry_id": "5a6f831b-aaca-398a-b24f-9811ca039347",
                        "glosses": [
                            "Casser les oreilles."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": []
                    }
