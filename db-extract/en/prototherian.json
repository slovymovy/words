                        "entry_id": "5faf9a47-6b27-3fde-a546-0982d82796ef",
                        "glosses": [
                            "Any of the egg-laying mammals of the subclass Prototheria; a monotreme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2355d8-687c-43e9-a70d-952f55f3a96a",
                                "sense_id": "103a126b-a17e-344e-a61a-767b3e195659",
                                "text": "Monotremes (prototherians), which include the duck-billed platypus, and short- and long-beaked echidnas, have a cloaca—a single opening for the fecal, urinary, and reproductive tracts."
                            }
                        ]
                    }
                ],
