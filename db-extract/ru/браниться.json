                ],
                "senses": [
                    {
                        "sense_id": "eaa28540-4f74-3b20-a204-59e9239f6c71",
                        "entry_id": "79e3f1cf-d5aa-3369-b293-68c218fbc22c",
                        "glosses": [
                            "резко выражать своё недовольство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5155cf-f651-4666-8b8e-9de8258a570f",
                                "sense_id": "eaa28540-4f74-3b20-a204-59e9239f6c71",
                                "text": "Это еще только перемолвочка — милые бранятся только тешатся; а то бывают какие страшные ссоры между (выражаясь маленько мужицким слогом) закадышными друзьями!.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "148ba08d-7333-491e-acd6-b78482494221",
                        "source_entry_id": "79e3f1cf-d5aa-3369-b293-68c218fbc22c",
                        "source_sense_id": "eaa28540-4f74-3b20-a204-59e9239f6c71",
                        "target_lang_word": "bicker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c0864f-d76e-3d75-bce9-dc69b49e3275",
                                        "entry_id": "70b5e74a-abb3-3dae-8bc7-bd2532c7c62a",
                                        "glosses": [
                                            "To quarrel in a tiresome, insulting manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0682e38c-22f6-4f39-8ae6-ab9120aaafdc",
                                                "sense_id": "b6c0864f-d76e-3d75-bce9-dc69b49e3275",
                                                "text": "They bickered about dinner every evening."
                                            },
                                            {
                                                "example_id": "ffc83fe0-b067-4f7c-afeb-ea78c834934b",
                                                "sense_id": "b6c0864f-d76e-3d75-bce9-dc69b49e3275",
                                                "text": "petty things about which men cark and bicker"
                                            },
                                            {
                                                "example_id": "5c616164-fe63-4b73-a00b-168df590d7a8",
                                                "sense_id": "b6c0864f-d76e-3d75-bce9-dc69b49e3275",
                                                "text": "Travelling with their granny, who seems more interested in her crossword puzzle than them, they bicker and fight in a futile bid to get her attention. Oh, the joys of travelling during the school holidays!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e54adef3-bbd8-3c12-812f-40d209ce81fd",
                                        "entry_id": "70b5e74a-abb3-3dae-8bc7-bd2532c7c62a",
                                        "glosses": [
                                            "To brawl or move tremulously, quiver, shimmer (of a water stream, light, flame, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed8c07f-fca0-4355-9f45-c7819d921a45",
                                                "sense_id": "e54adef3-bbd8-3c12-812f-40d209ce81fd",
                                                "text": "Mean time unnumber'd glittering Streamlets play'd, / And hurled every-where their Waters ſheen; / That, as they bicker'd through the ſunny Glade, / Though reſtleſs ſtill themſelves, a lulling Murmur made."
                                            },
                                            {
                                                "example_id": "884bec38-779d-4a92-820e-9bfef6b90bb6",
                                                "sense_id": "e54adef3-bbd8-3c12-812f-40d209ce81fd",
                                                "text": "I come from haunts of coot and hern, / I make a sudden sally, / And sparkle out among the fern, / To bicker down a valley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf3762b-3d40-335c-9313-5c1fefe55aad",
                                        "entry_id": "70b5e74a-abb3-3dae-8bc7-bd2532c7c62a",
                                        "glosses": [
                                            "To patter."
                                        ],
                                        "tags": [
                                            "of rain"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "062fc190-8fd3-3b7e-ad55-8131e3712154",
