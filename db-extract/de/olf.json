                    {
                        "sense_id": "32e9cc61-d706-35e3-8250-47c48211d42a",
                        "entry_id": "1605da2e-d8f7-32f4-8d24-687db0ab8de0",
                        "glosses": [
                            "Maßeinheit zur Bewertung der Stärke einer Geruchsquelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e024404-73d3-4a30-991c-3262f0259467",
                                "sense_id": "32e9cc61-d706-35e3-8250-47c48211d42a",
                                "text": "Mit der Maßeinheit olf wird die Verunreinigungslast angegeben, die von verschiedenen Quellen der olfaktorischen Luftverunreinigung ausgeht."
                            },
                            {
                                "example_id": "da4b53cb-9a27-4006-8c40-f060eed333d8",
                                "sense_id": "32e9cc61-d706-35e3-8250-47c48211d42a",
                                "text": "Er führte zwei neue Einheiten, olf und decipol, ein, um festzustellen, wie die Menschen die Luft empfinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
