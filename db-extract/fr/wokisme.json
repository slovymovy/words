                                "target_senses": [
                                    {
                                        "sense_id": "d1717642-dabd-3f4a-9aea-1e68160b0b59",
                                        "entry_id": "b391b04b-0cfe-35ba-a93f-c7da0c4261c0",
                                        "glosses": [
                                            "starke (auch übertriebene) Aufmerksamkeit betreffend Diskriminierung und entsprechender politischer Einsatz"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab28f232-5a02-481d-ae52-e3b4de28a7b6",
                                                "sense_id": "d1717642-dabd-3f4a-9aea-1e68160b0b59",
                                                "text": "„Ein Gespenst geht seit ein paar Jahren um in der westlichen Welt, das Gespenst des Wokismus.“"
                                            },
                                            {
                                                "example_id": "a3e3038b-ab0f-4173-9724-195d586e7cd5",
                                                "sense_id": "d1717642-dabd-3f4a-9aea-1e68160b0b59",
                                                "text": "„Ist Marine Le Pens Erfolg dem Wokismus zuzuschreiben?“"
                                            },
                                            {
                                                "example_id": "130aacdd-b31c-4d1a-a73e-89521ad8e5a1",
                                                "sense_id": "d1717642-dabd-3f4a-9aea-1e68160b0b59",
                                                "text": "„Es sind Leute, die den Wokismus auf eine Spitze getrieben haben, in der es absolut verboten ist, überhaupt noch etwas Kritisches zu der Religion des Islam zu sagen.“"
                                            },
                                            {
                                                "example_id": "3534e6a6-4937-4168-97f5-fbdbec0f5486",
                                                "sense_id": "d1717642-dabd-3f4a-9aea-1e68160b0b59",
                                                "text": "„Die Ideologie des ›Wokismus‹ schleift diese Bastion – ausgerechnet in Amerika, dem gelehrigsten Kind der Aufklärung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "593ebccb-6cfe-46d8-a701-b00019d3e17a",
