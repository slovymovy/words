                    {
                        "translation_id": "3f35c2a7-99c9-4b71-bede-47002edc6645",
                        "source_entry_id": "51d4ad4d-7cf4-3dbe-89e4-563731b1a1bb",
                        "source_sense_description": "bird of prey's nest",
                        "target_lang_word": "aire",
