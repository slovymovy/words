    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb81eaca-49ef-3346-b6f3-f4447e221125",
                    "sense_definition": "Приспособление в виде зажима или шпильки для удерживания и украшения волос.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Девочка закрепила непослушную прядь волос красивой металлической <w>заколкой</w>.",
                            "target_lang_translations": {
                                "nl": "Het meisje zette een weerbarstige haarlok vast met een mooie metalen <w>haarspeld</w>."
                            }
                        },
                        {
                            "text": "Она купила яркую <w>заколку</w> для волос к новому праздничному платью.",
                            "target_lang_translations": {
                                "nl": "Ze kocht een felgekleurde <w>haarklem</w> bij haar nieuwe feestjurk."
                            }
                        }
                    ],
                    "synonyms": [
                        "шпилька",
                        "невидимка",
                        "краб"
                    ],
                    "common_phrases": [
                        "заколка для волос",
                        "красивая заколка"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een voorwerp in de vorm van een klem of speld om het haar bijeen te houden of te versieren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "de haarspeld",
                                "target_lang_sense_clarification": "speld voor het haar"
                            },
                            {
                                "target_lang_word": "de haarklem",
                                "target_lang_sense_clarification": "klem om het haar vast te zetten"
                            },
                            {
                                "target_lang_word": "het haarclipje",
                                "target_lang_sense_clarification": "kleine clip voor het haar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bf67f49-7f2a-3227-a63b-2ff01da656cd",
                    "sense_definition": "Зажим или булавка для скрепления деталей одежды или галстука.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Серебряная <w>заколка</w> на его галстуке элегантно блестела на свету.",
                            "target_lang_translations": {
                                "nl": "De zilveren <w>dasspeld</w> op zijn stropdas glansde elegant in het licht."
                            }
                        },
                        {
                            "text": "Он аккуратно закрепил галстук специальной <w>заколкой</w> перед выходом на сцену.",
                            "target_lang_translations": {
                                "nl": "Hij maakte zijn stropdas netjes vast met een speciale <w>dasklem</w> voordat hij het podium op ging."
                            }
                        }
                    ],
                    "synonyms": [
                        "зажим",
                        "булавка"
                    ],
                    "common_phrases": [
                        "заколка для галстука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "В значении зажима для галстука слово чаще используется в разговорной речи."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een klem of speld voor het vastmaken van kleding of een stropdas."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "de dasspeld",
                                "target_lang_sense_clarification": "speld of klem voor een stropdas"
                            },
                            {
                                "target_lang_word": "de dasklem",
                                "target_lang_sense_clarification": "klem voor een stropdas"
                            },
                            {
                                "target_lang_word": "de sierspeld",
                                "target_lang_sense_clarification": "decoratieve speld op kleding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}