                "senses": [
                    {
                        "sense_id": "b367ba8d-1285-3c34-bc29-94dc7d4f901f",
                        "entry_id": "fe065cd4-a73c-39cd-b77c-bccd3d9ec6ce",
                        "glosses": [
                            "Dénombrer plus qu’il n’y a réellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f516f57-6ced-4340-8741-f12f0763f0a5",
                                "sense_id": "b367ba8d-1285-3c34-bc29-94dc7d4f901f",
                                "text": "Cela amènerait à surdénombrer les non-membres car les possibilités qu'ils soient sélectionnés dans l'échantillon sont multiples."
                            },
                            {
                                "example_id": "213af40b-7ebe-4750-993b-4dffc12b5ccb",
                                "sense_id": "b367ba8d-1285-3c34-bc29-94dc7d4f901f",
                                "text": "Cette méthode avait tendance à sous-dénombrer le nombre d'accusations dans une cause, à surdénombrer le nombre de causes et à sous-estimer le temps nécessaire pour traiter une cause au moyen des tribunaux puisque les accusations ne sont pas nécessairement toutes réglées le même jour."
                            }
                        ]
                    }
