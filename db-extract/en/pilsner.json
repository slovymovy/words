                                "sense_id": "3ae709a5-b4eb-3fbf-8054-1c9e1f7ce7da",
                                "text": "I am an optimist at bottom, with a superficial coating of pessimism, which thaws near a piano, a pretty girl, or a glass of Pilsner."
                            },
                            {
                                "example_id": "715167b5-cf89-461b-a2c7-51d36d93fbbd",
                                "sense_id": "3ae709a5-b4eb-3fbf-8054-1c9e1f7ce7da",
                                "text": "We drink Pilsners as we walk, and Denton doesn’t try to hide his when Chicken George drives by."
                            },
                            {
                                "example_id": "33ce4463-5733-456e-a365-024d37682944",
                                "sense_id": "3ae709a5-b4eb-3fbf-8054-1c9e1f7ce7da",
                                "text": "She would have liked to eat Mary’s Friday meatballs and maybe even drink a Pilsner or three with Silje."
                            }
                        ]
                    }
