                    {
                        "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                        "entry_id": "fd2f2b17-0617-3b06-a50e-111c5a7f4eb1",
                        "glosses": [
                            "enkelvoud verleden tijd van drinken"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "016d9f1a-d0e6-4462-a7d5-293a9955b815",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Ik dronk."
                            },
                            {
                                "example_id": "8e44aed2-f917-4744-b899-d2c50dea2604",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Jij dronk."
                            },
                            {
                                "example_id": "dc7531bd-e7f0-4b5f-b0ee-ac9dc0f11a24",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Hij, zij, het dronk."
                            },
                            {
                                "example_id": "07243571-f28c-4008-b58f-b2df237a6dd9",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Ik dronk weinig en hield al helemaal niet van sterkedrank."
                            },
                            {
                                "example_id": "beca3f4b-f107-4048-a2c4-2106260d8263",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Ik dronk mijn thee op."
                            },
                            {
                                "example_id": "c9c5e70e-8829-46e3-93a7-1b1ad68a122e",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "De stem van de vrouw was als een oergeluid dat weer tot leven was gekomen, en Olive stond op en dronk een vijfde glas bubbels - o nee, dit was geen champagne, dit was een of andere sterkedrank, vuurwater dat haar ingewanden in brand zette."
                            },
                            {
                                "example_id": "8e03de5a-6def-49f4-a190-6249347b6309",
                                "sense_id": "af62747c-0693-3c13-a2f8-dcbd6a7589a8",
                                "text": "Ik dronk koffie aan de haven van Oude-Tonge en liep door het oude centrum en rond de kerk."
                            }
                        ]
                    }
                ],
