                                        "entry_id": "6b896d45-7522-3f90-babd-7493c84db5c7",
                                        "glosses": [
                                            "The female monarch (ruler) of an empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fecf12-346f-4e1f-9feb-c4bdb48cae3c",
                                                "sense_id": "09778735-d006-3fc3-a6b1-a0e0b0f12b8b",
                                                "text": "Sit downe by her: adorned with my Crowne,\nAs if thou wert the Empreſſe of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0353978f-660e-3705-bc4d-977f7610b001",
                                        "entry_id": "6b896d45-7522-3f90-babd-7493c84db5c7",
                                        "glosses": [
                                            "The wife or widow of an emperor or equated ruler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da775f12-2e86-4450-89dd-e24c510054f6",
                                                "sense_id": "0353978f-660e-3705-bc4d-977f7610b001",
                                                "text": "Empress, imperial regent, and even emperor herself (r. 797–802), Irene was an important and powerful figure at the Byzantine court in the late eighth and early ninth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73443501-5b6c-3c20-a28d-5b4e5b026da8",
