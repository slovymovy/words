                "senses": [
                    {
                        "sense_id": "efbcbf0a-1d40-3b6b-8d17-20c9e07c828a",
                        "entry_id": "58dfb8c3-5e63-3f92-a626-18457933b6c8",
                        "glosses": [
                            "Occurrence de jumeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7000fc24-30f9-468b-9b23-a873b589d0a6",
                                "sense_id": "efbcbf0a-1d40-3b6b-8d17-20c9e07c828a",
                                "text": "Heisenberg n’est pas sans ressembler à Fermi. Entre ces deux-là on pourrait presque parler de gémellité : tous deux nés en 1901, exceptionnellement doués en mathématiques, hautement passionnés par la physique et excellents montagnards."
                            },
                            {
                                "example_id": "14a23839-7dd3-449e-a2b9-f2f0e5134473",
                                "sense_id": "efbcbf0a-1d40-3b6b-8d17-20c9e07c828a",
                                "text": "Élisabeth a mal vécu la gémellité. Elle doit prendre conscience qu’elle est entière, qu’elle est un être humain à part entière."
                            },
                            {
                                "example_id": "898a0903-2994-4a88-b57b-b0dbf0641a04",
                                "sense_id": "efbcbf0a-1d40-3b6b-8d17-20c9e07c828a",
                                "text": "Elle voit ce couple comme un corps à deux têtes, et cherche donc à former un duo qui puisse raconter la fusion et la gémellité."
                            },
                            {
                                "example_id": "4f6b44a5-244e-45b5-8267-b123032f083c",
                                "sense_id": "efbcbf0a-1d40-3b6b-8d17-20c9e07c828a",
                                "text": "Notez que si l'on tire le fil de la gémellité, on réalise que comme Cade et son double, le film coexiste de manière étonnante avec une œuvre jumelle."
                            }
                        ]
                    }
