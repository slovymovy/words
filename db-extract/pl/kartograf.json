                    {
                        "translation_id": "3580b9e0-03a3-46dd-a6f8-3ad19026a77c",
                        "source_entry_id": "85c852b6-60dd-39ae-92fb-6202ff33a292",
                        "source_sense_id": "0c4fb05b-63a8-3126-9e4e-7fedf8c573eb",
                        "target_lang_word": "Kartograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d10f37d5-04e0-3af3-903a-1dd1e18ae944",
                                        "entry_id": "c073e9da-0d0e-3c96-8b01-ede940553c6a",
                                        "glosses": [
                                            "jemand, der Landkarten und Pläne zeichnet und/oder bearbeitet"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e40d9d-dab8-4dbf-9d08-c243c79da711",
                                                "sense_id": "d10f37d5-04e0-3af3-903a-1dd1e18ae944",
                                                "text": "„Eigentlich war Hamid für die Navigation zuständig, aber ich bemerkte, dass der Kartograf in Jacques seine offensichtliche Inkompetenz nicht länger mitansehen konnte.“"
                                            },
                                            {
                                                "example_id": "315ec6a1-45ce-4d61-93e5-3f89d8f60f57",
                                                "sense_id": "d10f37d5-04e0-3af3-903a-1dd1e18ae944",
                                                "text": "„Als Sohn eines protestantischen Kartenhändlers und Neffe des Kartografen von Ludwig XIV. ist Jean-Baptiste Tavernier bereits als Kind neugierig auf die Welt.“"
                                            },
                                            {
                                                "example_id": "311da0fb-23ab-4abe-a714-036bcdaa967d",
                                                "sense_id": "d10f37d5-04e0-3af3-903a-1dd1e18ae944",
                                                "text": "„Ich habe einmal eine Geschichte gehört, ein Märchen eigentlich, in der ein chinesischer Kaiser seinen Kartografen den Auftrag gab, eine möglichst detailgetreue Karte seines Kaiserreichs anzufertigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a49b3ff5-ead6-4962-83a1-9e4bb8ba73a8",
                        "source_entry_id": "85c852b6-60dd-39ae-92fb-6202ff33a292",
                        "source_sense_id": "0c4fb05b-63a8-3126-9e4e-7fedf8c573eb",
                        "target_lang_word": "Kartograph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartograph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "031e5d7d-1041-353c-85a2-bd1aaa2cf82b",
                                        "entry_id": "d4663df1-6074-3ccc-83c7-49044d728cf6",
                                        "glosses": [
                                            "jemand, der Landkarten und Pläne zeichnet und/oder bearbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77311e4c-8756-46bd-ab66-8b15f0961664",
                                                "sense_id": "031e5d7d-1041-353c-85a2-bd1aaa2cf82b",
                                                "text": "„Der deutsche Kartograph Martin Waldseemüller (um 1475–um 1521) nannte den neuen Kontinent 1507 auf einer seiner Karten »America« und ehrte damit Amerigo Vespucci, den er für den Entdecker der Neuen Welt hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
