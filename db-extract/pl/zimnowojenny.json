                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d06b7b8-143d-4684-a2a2-c52db5c1d205",
                                "sense_id": "bdd3a91f-e496-3a15-9100-3e7c3684dd8f",
                                "text": "Zdarzały się oczywiście okresy odprężenia zimnowojennego."
