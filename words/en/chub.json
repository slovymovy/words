    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2b1da4f-528f-3d81-ab53-d7a55053e639",
                    "sense_definition": "A type of freshwater fish belonging to the carp family.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler spent the entire afternoon by the river hoping to catch a large <w>chub</w>.",
                            "target_lang_translations": {
                                "fr": "Le pêcheur a passé tout l'après-midi au bord de la rivière dans l'espoir d'attraper un gros <w>chevesne</w>."
                            }
                        },
                        {
                            "text": "Many species of <w>chub</w> are popular among recreational fishermen in European rivers.",
                            "target_lang_translations": {
                                "fr": "De nombreuses espèces de <w>chevesnes</w> sont populaires auprès des pêcheurs de loisir dans les rivières européennes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Poisson d'eau douce de la famille des cyprinidés."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chevesne",
                                "target_lang_sense_clarification": "nom commun pour ce poisson"
                            }
                        ]
                    }
                }
            ]
        },
        {
