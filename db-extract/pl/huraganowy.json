                                    {
                                        "sense_id": "7f019d99-7f50-3405-9ceb-c7140387a9c8",
                                        "entry_id": "bd277bb5-1cb3-3170-95e4-7c3b4c2f5183",
                                        "glosses": [
                                            "mit äußerst hohen Windgeschwindigkeiten, die denen eines Orkans nahekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd32265-8e0d-4a03-9ef9-518f4bfd9b8f",
                                                "sense_id": "7f019d99-7f50-3405-9ceb-c7140387a9c8",
                                                "text": "„Vor allem an den Küsten und in den Mittelgebirgen sowie in den Alpen sollte es orkanartig wehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99cd02d9-6896-37ef-87dd-069eee5f0eeb",
                                        "entry_id": "bd277bb5-1cb3-3170-95e4-7c3b4c2f5183",
                                        "glosses": [
                                            "sehr stark, mit viel Kraft, mit viel Enthusiasmus"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "757bcf38-245c-4a9f-b23f-ef5937716f02",
                                                "sense_id": "99cd02d9-6896-37ef-87dd-069eee5f0eeb",
                                                "text": "„Die Hamburger klatschten orkanartig, trampelten und riefen sich heiser, am meisten nach dem Darsteller des \"Zauberers\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
