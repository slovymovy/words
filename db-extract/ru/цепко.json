                "senses": [
                    {
                        "sense_id": "11b7e011-ddd1-350a-b843-b3f992343ee9",
                        "entry_id": "24464305-f340-3b8d-a65e-d00bd16e5229",
                        "glosses": [
                            "наречие к цепкий; крепко, не отпуская"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "0e0d3cc3-fbf1-4ec4-ab2c-c5898f0f6177",
                                "sense_id": "11b7e011-ddd1-350a-b843-b3f992343ee9",
                                "text": "Вдруг чья-то холодная рука цепко схватила мою руку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee39382a-dbb6-41f9-b837-ef6b9e666acb",
                        "source_entry_id": "24464305-f340-3b8d-a65e-d00bd16e5229",
                        "source_sense_id": "11b7e011-ddd1-350a-b843-b3f992343ee9",
                        "target_lang_word": "firmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "In a firm or definite or strong manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e91e9d-304a-4fbf-88fe-0acefd77e1cf",
                                                "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                                "text": "She corrected him firmly but gently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Securely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46849664-bfc4-4be4-af8f-602b744cba26",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Tie the rope firmly to the post."
                                            },
                                            {
                                                "example_id": "b40f2ecb-4ba9-4b6d-9282-c0a0ae1b9d40",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9b1f9270-ea84-438c-987f-e614989333a1",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Definitively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929ac0a1-6140-4b1c-b26b-a42debd1d9c4",
                                                "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79edd459-b3c2-4604-b6a9-9bcacbb58a2a",
                        "source_entry_id": "24464305-f340-3b8d-a65e-d00bd16e5229",
                        "source_sense_id": "11b7e011-ddd1-350a-b843-b3f992343ee9",
                        "target_lang_word": "tenaciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenaciously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bffce9-5211-313c-9d72-dec21d106918",
                                        "entry_id": "6ee43017-9902-3e9b-8e62-019718313410",
                                        "glosses": [
                                            "In a tenacious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3e99afb-98c9-4e8a-abfc-13bc86e7bbbe",
                                                "sense_id": "b2bffce9-5211-313c-9d72-dec21d106918",
                                                "text": "He continued tenaciously, doggedly continuing over all obstacles."
                                            },
                                            {
                                                "example_id": "439458ec-44f6-4ac3-92d2-94de959f2dda",
                                                "sense_id": "b2bffce9-5211-313c-9d72-dec21d106918",
                                                "text": "[…] tens of thousands of other foot passengers have been slipping and sliding since the day broke (if this day ever broke), adding new deposits to the crust upon crust of mud, sticking at those points tenaciously to the pavement, and accumulating at compound interest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
