                "senses": [
                    {
                        "sense_id": "be760598-329d-391c-900f-df8c58ca3d37",
                        "entry_id": "59228ee7-37a7-3691-ba70-8c70d7513e7b",
                        "glosses": [
                            "Hauptstadt der Republik Burjatien in Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1649a1-72dc-4d67-9c16-5d41f63a42f3",
                                "sense_id": "be760598-329d-391c-900f-df8c58ca3d37",
                                "text": "„Ulan-Ude, die Hauptstadt der Republik Burjatien, ist so groß wie Bochum, wurde 1666 gegründet und ist damit eine der wenigen alten Städte entlang der Transsibirischen Eisenbahn.“"
                            },
                            {
                                "example_id": "b3f7cf36-cb8a-480e-8fc8-650ebb5b9e6e",
                                "sense_id": "be760598-329d-391c-900f-df8c58ca3d37",
                                "text": "„In Ulan-Ude wünschen sich zwar viele eine Wiederherstellung der burjat-mongolischen Republik, die Stalin 1937 in drei Teile zerschlagen hatte. Doch nur innerhalb der russischen Föderation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
