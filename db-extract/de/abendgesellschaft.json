                "senses": [
                    {
                        "sense_id": "245472e3-41ef-3908-bd15-ebf4e137122a",
                        "entry_id": "c4d23ad9-c859-3ead-bf5a-d1367e606947",
                        "glosses": [
                            "Veranstaltung gesellschaftlichen und/oder kulturellen Charakters am Abend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c69ff7-d9da-4fad-8a95-9e8fb975348e",
                                "sense_id": "245472e3-41ef-3908-bd15-ebf4e137122a",
                                "text": "„An Abendgesellschaften fand sie keinen Gefallen mehr.“"
                            },
                            {
                                "example_id": "879520b9-af51-42c1-95a5-6146c0cc96bd",
                                "sense_id": "245472e3-41ef-3908-bd15-ebf4e137122a",
                                "text": "„Er träumt davon wahrscheinlich auf seinen nächtlichen Spaziergängen, wenn er von einer Abendgesellschaft kommt und sich mit seinem ruckweisen hüpfenden Schritt in der schlafenden Stadt ergeht.“"
                            },
                            {
                                "example_id": "149add4c-9e5f-43b0-939d-c79ae864a102",
                                "sense_id": "245472e3-41ef-3908-bd15-ebf4e137122a",
                                "text": "„Er gewährte mir Zutritt zu seinen Abendgesellschaften, die, wie ich schon berichtet habe, aus verlebten Frauen und geistreichen Männern bestanden.“"
                            },
                            {
                                "example_id": "13240df8-d223-42e4-aeb2-7ae686d7e3a7",
                                "sense_id": "245472e3-41ef-3908-bd15-ebf4e137122a",
                                "text": "„Er besuchte keine Abendgesellschaften mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
