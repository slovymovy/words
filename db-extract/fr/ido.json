            {
                "entry_id": "1cdf2177-0f7e-38b8-81cc-59b254ec548c",
                "word": "Ido",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "321ffdd2-f97c-31f3-821c-b7adc8463d65",
                        "entry_id": "1cdf2177-0f7e-38b8-81cc-59b254ec548c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b30cf5-b776-4f24-abea-93861d4c8358",
                                "sense_id": "321ffdd2-f97c-31f3-821c-b7adc8463d65",
                                "text": "« Je choisis de m’intéresser aux classes sociales modestes, à ces individus enfermés dans cette gravité-là », estime le réalisateur Cédric Ido, originaire de Stains (Seine-Saint-Denis)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0625208-6cbe-3780-be34-14c4bb04ada1",
                "word": "ido",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7cab95a-5935-3609-ab8f-818910c0aa3d",
                        "entry_id": "a0625208-6cbe-3780-be34-14c4bb04ada1",
                        "glosses": [
                            "Langue à visée internationale, construite à partir de l’espéranto et inspirée d’une autre langue artificielle, l’idiom neutral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf00330-9ceb-49b6-a07a-11677c2d7d35",
                                "sense_id": "d7cab95a-5935-3609-ab8f-818910c0aa3d",
                                "text": "Inventeurs du mouvement perpétuel, explorateurs de bacilles inconnus, hommes-oiseaux ou hommes-poissons, fanatiques d’ido ou d’ortograf fonétik. alchimistes, pacifistes, utopistes, accourez tous! Déjà les demandes pleuvent, […]."
                            },
                            {
                                "example_id": "be5c9322-ee18-4c38-b51a-47832048b8de",
                                "sense_id": "d7cab95a-5935-3609-ab8f-818910c0aa3d",
                                "text": "L’ido a été créé par un comité incluant le Professeur Otto Jespersen, linguiste danois, et le Professeur Louis Couturat, mathématicien et philosophe français."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c9c5dca-a7f6-46a3-8b91-dcbd9ea0d597",
                        "source_entry_id": "a0625208-6cbe-3780-be34-14c4bb04ada1",
                        "source_sense_id": "d7cab95a-5935-3609-ab8f-818910c0aa3d",
                        "target_lang_word": "Ido",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ido",
