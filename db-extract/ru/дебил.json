                                        "sense_id": "a1e2b05e-3d53-3a54-87b6-48538f723003",
                                        "entry_id": "d02f6797-4311-3b53-9257-3fb27a474795",
                                        "glosses": [
                                            "osoba upośledzona umysłowo w stopniu lekkim"
