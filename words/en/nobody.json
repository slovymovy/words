{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ea47474b-66c3-3350-8236-754462b4ad08",
                    "sense_definition": "Not any person; no one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I knocked on the door, but <w>nobody</w> answered.",
                            "target_lang_translations": {
                                "ru": "Я постучал в дверь, но <w>никто</w> не ответил.",
                                "zh": "我敲了敲门，但<w>没有人</w>应答。"
                            }
                        },
                        {
                            "text": "<w>Nobody</w> knows the answer to that difficult question.",
                            "target_lang_translations": {
                                "ru": "<w>Никто</w> не знает ответа на этот сложный вопрос.",
                                "zh": "<w>没有人</w>知道那个难题的答案。"
                            }
                        },
                        {
                            "text": "There was <w>nobody</w> else in the room when I arrived.",
                            "target_lang_translations": {
                                "ru": "Когда я пришёл, в комнате больше <w>никого</w> не было.",
                                "zh": "我到达时，房间里没有<w>其他人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no one"
                    ],
                    "antonyms": [
                        "somebody",
                        "someone",
                        "everybody",
                        "everyone"
                    ],
                    "common_phrases": [
                        "nobody else",
                        "nobody knows",
                        "nobody cares"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один человек; никто.",
                        "zh": "没有任何人；无人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никто",
                                "target_lang_sense_clarification": "отрицательное местоимение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没有人",
                                "target_lang_sense_clarification": "指代没有任何人"
                            },
                            {
                                "target_lang_word": "无人",
                                "target_lang_sense_clarification": "书面语，指代没有任何人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "677bd015-d6d2-3e38-bc54-5cb75f9f8e11",
                    "sense_definition": "A person who is not important, famous, or influential.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>nobody</w> compared to the famous actors at the party.",
                            "target_lang_translations": {
                                "ru": "По сравнению с известными актёрами на вечеринке он чувствовал себя <w>ничтожеством</w>.",
                                "zh": "与聚会上的那些著名演员相比，他觉得自己只是个<w>无名小卒</w>。"
                            }
                        },
                        {
                            "text": "She worked hard to go from being a <w>nobody</w> to a star.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, чтобы из <w>никого</w> превратиться в звезду.",
                                "zh": "她努力工作，从一个<w>无名小卒</w>变成了明星。"
                            }
                        }
                    ],
                    "synonyms": [
                        "small fry",
                        "small potatoes"
                    ],
                    "antonyms": [
                        "somebody"
                    ],
                    "common_phrases": [
                        "be a nobody",
                        "just a nobody",
                        "total nobody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не имеющий веса в обществе, известности или влияния.",
                        "zh": "指在社会上没有地位、名气或影响力的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничтожество",
                                "target_lang_sense_clarification": "незначительный человек"
                            },
                            {
                                "target_lang_word": "пустое место",
                                "target_lang_sense_clarification": "идиома: незначительный человек"
                            },
                            {
                                "target_lang_word": "никто",
                                "target_lang_sense_clarification": "в значении существительного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无名小卒",
                                "target_lang_sense_clarification": "指没有名气或地位的人"
                            },
                            {
                                "target_lang_word": "小人物",
                                "target_lang_sense_clarification": "指地位卑微或不重要的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}