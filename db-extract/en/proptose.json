                "senses": [
                    {
                        "sense_id": "920c2cda-a060-3191-af83-9fc9170c5e05",
                        "entry_id": "938f6666-0d90-3573-9283-edf6c1114d0b",
                        "glosses": [
                            "To displace (an eye) in its socket; to cause exophthalmus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444be324-6638-459c-842a-2873f0aa9512",
                                "sense_id": "920c2cda-a060-3191-af83-9fc9170c5e05",
                                "text": "Because of the usual dorsal approach, the lateral and medial rectus muscles are secured by sutures, and with traction, can proptose the globe forward."
                            },
                            {
                                "example_id": "f51c6124-59eb-4a37-ba25-09ca6c48f4ec",
                                "sense_id": "920c2cda-a060-3191-af83-9fc9170c5e05",
                                "text": "When performing forced ductions for possible rectus muscle restriction, proptose the eye to stretch the rectus muscles."
                            },
                            {
                                "example_id": "45f44d26-52c6-4fff-829a-871072c29793",
                                "sense_id": "920c2cda-a060-3191-af83-9fc9170c5e05",
                                "text": "Davies had worn a diaphragm in it for years, which had caused irritation and produced bad nose bleeds; his right eyeball was proptosed (displaced in its socket)."
                            }
                        ]
                    }
