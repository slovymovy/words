                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12bd22c-bd02-46c0-bcfa-c293d17a710b",
                                                "sense_id": "5396e560-bf29-36db-b397-d4eb3a6dc29e",
                                                "text": "Ik voelde me klein en uiterst kwetsbaar."
                                            },
                                            {
                                                "example_id": "9df80b86-6e8f-4563-801c-f310fcb799c7",
                                                "sense_id": "5396e560-bf29-36db-b397-d4eb3a6dc29e",
                                                "text": "Iets compleet anders dan ik gewend was, waar ik ontzag voor had en waar ik mijn uiterste best voor moest doen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uiterst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8339cf9a-71be-34c4-9fbf-c5f839641bf4",
                                        "entry_id": "8b9ba57f-7ab3-385a-927e-8e7cf0650837",
                                        "glosses": [
                                            "in extreme mate, in de allerhoogste mate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e317f92-1202-4dff-8d0f-004d02745525",
                                                "sense_id": "8339cf9a-71be-34c4-9fbf-c5f839641bf4",
                                                "text": "Het islamitische Haga Lyceum probeerde de publicatie van het uiterst kritische inspectierapport voor de zomer al te voorkomen, maar ook toen ving de school bot."
                                            },
                                            {
                                                "example_id": "6960fe6b-0f19-4fd1-978b-6a83d0fc6db0",
                                                "sense_id": "8339cf9a-71be-34c4-9fbf-c5f839641bf4",
                                                "text": "De Franse levensstijl blijft een uiterst aantrekkelijk concept waaraan goed wordt verdiend, zoals Michel Houellebecq constateerde in zijn laatste roman De kaart en het gebied: luxe, elegantie, goed eten en drinken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9cea13f-7472-43b9-a047-d833598a5fef",
