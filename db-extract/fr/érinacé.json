                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c4f74d-443b-41b0-ae39-0aa0976d6516",
                                "sense_id": "38513246-a292-3f23-b4bb-7fdbaf8f59a9",
                                "text": "Le hérisson africain à ventre blanc ou Atelerix albiventris … comme son cousin européen, fait partie de la famille des érinacés, est insectivore et vit la nuit."
                            },
                            {
                                "example_id": "4845b56b-5514-4be5-8569-b58669387e5b",
                                "sense_id": "38513246-a292-3f23-b4bb-7fdbaf8f59a9",
                                "text": "En France, la détention des érinacés demeure interdite."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b74cb38-6dfa-3906-bed4-58ae37c76b73",
                        "entry_id": "7f592b00-1162-3f49-8e47-c06385688a1b",
                        "glosses": [
                            "Champignon comestible membre de la famille des Érinacés, désormais appelés Hydnes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d01fa043-c068-4dbd-9709-22d2568259f2",
                                "sense_id": "4b74cb38-6dfa-3906-bed4-58ae37c76b73",
                                "text": "Le genre des hydnés ou érinacés, Hydnum, Linn. Géner. 1211. Ce sont des champignons à chapeau pédiculé, horizontal, hérissé en dessous."
                            }
                        ]
