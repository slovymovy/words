                "translations": [
                    {
                        "translation_id": "3f00b877-2dff-4106-869a-be17ab7e2607",
                        "source_entry_id": "3c56fb0f-7772-3d25-a113-3b5982234b3d",
                        "source_sense_id": "a6012fbd-c145-3e71-b5a2-d524daedb6da",
                        "target_lang_word": "écartement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écartement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9eaadc34-8f17-3799-b966-615415ad38f3",
                                        "entry_id": "0a374273-8e08-34df-be57-e074dbee14e0",
                                        "glosses": [
                                            "Action d’écarter, de s’écarter, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a51847-86fb-4fc8-98a5-0f56c66cb9a7",
                                                "sense_id": "9eaadc34-8f17-3799-b966-615415ad38f3",
                                                "text": "L’écartement des jambes."
                                            },
                                            {
                                                "example_id": "6208f6fc-ef18-4672-94fa-da79d56be50d",
                                                "sense_id": "9eaadc34-8f17-3799-b966-615415ad38f3",
                                                "text": "L’écartement de deux lignes."
                                            },
                                            {
                                                "example_id": "4001aa25-25c0-4ee4-b3ce-422d61b098f0",
                                                "sense_id": "9eaadc34-8f17-3799-b966-615415ad38f3",
                                                "text": "Il sortit de nouveau, alla vers les communs où Dussol, le mètre à la main, accroupi, mesurait l’écartement des roues d’un tilbury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b43c11-b9d3-3a61-8694-ddbd1e78b3f1",
                                        "entry_id": "0a374273-8e08-34df-be57-e074dbee14e0",
                                        "glosses": [
                                            "Action d’écarter, de s’écarter, ou résultat de cette action.",
                                            "L'écartement des rails ou des roues d'un train ferroviaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3614518f-44d8-4758-8d29-f439ea4b503a",
                                                "sense_id": "12b43c11-b9d3-3a61-8694-ddbd1e78b3f1",
                                                "text": "Le principal problème viendrait de la capacité de ce train à faire varier automatiquement l’ écartement de ses roues pour s’adapter aux trois écartements des voies ferrées que l'on trouve dans le pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb7e0a5c-2bd5-39e2-8b08-7d5d54473515",
                                        "entry_id": "0a374273-8e08-34df-be57-e074dbee14e0",
                                        "glosses": [
                                            "Disjonction, séparation de choses qui doivent être jointes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dfab7ad-3d2e-43d7-bb58-d789e3c16ca2",
                                                "sense_id": "cb7e0a5c-2bd5-39e2-8b08-7d5d54473515",
                                                "text": "Il y a eu de l’écartement dans ce mur."
                                            },
                                            {
                                                "example_id": "f77623e4-585a-48e8-b31f-f5bf66d0a9cc",
                                                "sense_id": "cb7e0a5c-2bd5-39e2-8b08-7d5d54473515",
                                                "text": "Dans l’écartement de deux vallons, la rase campagne développait sa verte étendue sillonnée en balafres noires par les lignes capricieuses des haies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cce95a75-18f9-493e-ac0c-36b0162f098a",
                        "source_entry_id": "3c56fb0f-7772-3d25-a113-3b5982234b3d",
                        "source_sense_id": "a6012fbd-c145-3e71-b5a2-d524daedb6da",
                        "target_lang_word": "éloignement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éloignement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fba4a54-7c73-3bc4-84cd-83d1c7aa8724",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Action par laquelle on éloigne, on s’éloigne ; ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e3aeff4-bf99-4e68-b66a-ea1dcd502634",
                                                "sense_id": "7fba4a54-7c73-3bc4-84cd-83d1c7aa8724",
                                                "text": "Ce commerçant a rétabli ses affaires par l’éloignement du caissier qui le trompait."
                                            },
                                            {
                                                "example_id": "abbba766-a061-4a89-b83b-ec180a67cd28",
                                                "sense_id": "7fba4a54-7c73-3bc4-84cd-83d1c7aa8724",
                                                "text": "Vivre dans la retraite, dans l’éloignement du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d23bb5-e6da-3f18-b3f1-8d683a7e3c79",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Absence."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05aa801-9ca4-4c31-8264-8bc6a195c5f6",
                                                "sense_id": "44d23bb5-e6da-3f18-b3f1-8d683a7e3c79",
                                                "text": "Depuis son éloignement de Paris. — Son éloignement n’a pas duré."
                                            },
                                            {
                                                "example_id": "41ee012c-e0c1-4ad7-be7b-55ea00d5ca35",
                                                "sense_id": "44d23bb5-e6da-3f18-b3f1-8d683a7e3c79",
                                                "text": "Je ne me console point de son éloignement. Nous souffrons de l’éloignement de ceux qui nous sont chers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Distance, soit de lieu, soit de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc41235-bfc8-4c20-ad97-7c2f17e9ba47",
                                                "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                                                "text": "La première zone, je la situe dans la montagne : là, jusqu'à présent, l'éloignement, la difficulté des communications, le retard de ce qu'on appelle le progrès et, il faut le dire loyalement, une persistance plus grande du sentiment religieux ont perpétué les mœurs de bon vieux temps."
                                            },
                                            {
                                                "example_id": "84191fa8-3659-43fc-a090-a2baaaf0f36d",
                                                "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                                                "text": "L’éloignement de nos demeures nous empêche de nous voir souvent."
                                            },
                                            {
                                                "example_id": "1a97270c-a834-4ca3-9710-811f659809df",
                                                "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                                                "text": "Il faut regarder cette statue, cette perspective dans un certain éloignement."
                                            },
                                            {
                                                "example_id": "1cd2a062-1eb6-42e5-a609-8f6fc84fed03",
                                                "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                                                "text": "L’éloignement des temps rend incertaines les causes de ce grand événement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a5d81a-034c-35ca-be0b-8d5196b34c67",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Ce qui borne la vue à une distance fort lointaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d6ca1f-e858-4118-b726-a86f0f9f48cb",
                                                "sense_id": "d1a5d81a-034c-35ca-be0b-8d5196b34c67",
                                                "text": "La vue est admirable en ce lieu-là : on y voit des coteaux, des prairies, la rivière qui serpente, et Paris en éloignement."
                                            },
                                            {
                                                "example_id": "a4cc0fc4-9cb7-4ed8-9ec5-63fd9543375d",
                                                "sense_id": "d1a5d81a-034c-35ca-be0b-8d5196b34c67",
                                                "text": "On admire cette forêt dans l’éloignement."
                                            },
                                            {
                                                "example_id": "33218db7-1c75-42d8-91cb-5c1d68745cea",
                                                "sense_id": "d1a5d81a-034c-35ca-be0b-8d5196b34c67",
                                                "text": "La sœur de Maffio passe dans l’éloignement."
                                            },
                                            {
                                                "example_id": "fd039586-9647-437e-81d7-3ced655dbc5e",
                                                "sense_id": "d1a5d81a-034c-35ca-be0b-8d5196b34c67",
                                                "text": "Guillaume ne retourna pas au pré. Il monta à sa chambre, et, penché sur le balcon qui domine une si effrayante profondeur, il se livra aux plus sombres rêveries, tandis que les rires des faneuses et le cri des bouviers se perdaient dans l’éloignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6119b9e8-36c5-3e86-b45e-4a82b2b69ecb",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Les derniers plans d’un tableau, d'une photographie."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45899bb4-34db-4aaa-a123-593502a5f340",
                                                "sense_id": "6119b9e8-36c5-3e86-b45e-4a82b2b69ecb",
                                                "text": "Dans l’éloignement on voit des personnages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0928a857-b0fb-3119-abd7-01a3233bcc60",
                                        "entry_id": "c597c38a-fd36-3730-8acd-3d685278b582",
                                        "glosses": [
                                            "Antipathie qui porte à s’éloigner de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f58a2836-1dcd-4a8f-824d-4227b86c2f02",
                                                "sense_id": "0928a857-b0fb-3119-abd7-01a3233bcc60",
                                                "text": "Il a de l’éloignement pour cet homme-là."
                                            }
                                        ]
                                    }
                                ]
                            }
