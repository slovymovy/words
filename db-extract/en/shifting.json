    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c3f70d6c-7a63-3319-ae44-386727b33462",
                "word": "shifting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "53904d8c-f399-4b35-9baf-0819593bcb93",
                        "entry_id": "c3f70d6c-7a63-3319-ae44-386727b33462",
                        "tags": [
                            "plural"
                        ],
                        "form": "shiftings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9bbe809-f674-3b34-96cc-b4c717244ad9",
                        "entry_id": "c3f70d6c-7a63-3319-ae44-386727b33462",
                        "glosses": [
                            "A shift or change; a shifting movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1b492e-a53a-4122-a1e9-957734942a8d",
                                "sense_id": "a9bbe809-f674-3b34-96cc-b4c717244ad9",
                                "text": "I remember the last time I saw Macbeth played, the discrepancy I felt at the changes of garment which he varied, the shiftings and reshiftings, like a Romish priest at mass."
                            },
                            {
                                "example_id": "f218cc22-67a1-4225-a6c3-d2d74d13a030",
                                "sense_id": "a9bbe809-f674-3b34-96cc-b4c717244ad9",
                                "text": "But shiftings and readjustments ensued, as they are sure to do with a walking-party. Cope presently found himself scuffling through the thin grass and the briery thickets alongside the young business-man."
                            },
                            {
                                "example_id": "d7f3dfc9-1d9d-400f-996a-86d970a5ac79",
                                "sense_id": "a9bbe809-f674-3b34-96cc-b4c717244ad9",
                                "text": "Then everyone moved at the same time — slight shiftings of the hands and feet, furtive easings of position."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa3300eb-578f-31c5-a79b-2086c753826b",
                        "entry_id": "c3f70d6c-7a63-3319-ae44-386727b33462",
                        "glosses": [
                            "The phenomenon by which two or more constituents appearing on the same side of their common head exchange positions to obtain non-canonical order."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
