    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "645ff1fe-428d-3681-882d-40b47e939f04",
                    "sense_definition": "Een grote groep mensen die bij elkaar horen of samen optrekken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een grote <w>schare</w> supporters voor de deur te wachten op de spelers.",
                            "target_lang_translations": {
                                "en": "There was a large <w>crowd</w> of supporters waiting at the door for the players."
                            }
                        },
                        {
                            "text": "De beroemde zanger werd omringd door een trouwe <w>schare</w> fans.",
                            "target_lang_translations": {
                                "en": "The famous singer was surrounded by a loyal <w>host</w> of fans."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaar",
                        "drom",
                        "menigte"
                    ],
                    "common_phrases": [
                        "een grote schare"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Formeel of literair taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A large group of people who belong together or move together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crowd",
                                "target_lang_sense_clarification": "a large number of people gathered together"
                            },
                            {
                                "target_lang_word": "host",
                                "target_lang_sense_clarification": "a great number of people or things"
                            },
                            {
                                "target_lang_word": "multitude",
                                "target_lang_sense_clarification": "a large gathering of people, formal"
                            },
                            {
                                "target_lang_word": "throng",
                                "target_lang_sense_clarification": "a densely packed crowd of people"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c40ffabe-ac95-3df6-8390-e51be6cb1467",
                    "sense_definition": "Een verzameling van gelovigen of mensen die aanwezig zijn bij een godsdienstige bijeenkomst.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De priester sprak de verzamelde <w>schare</w> toe tijdens de zondagsdienst.",
                            "target_lang_translations": {
                                "en": "The priest addressed the gathered <w>congregation</w> during the Sunday service."
                            }
                        },
                        {
                            "text": "Een devote <w>schare</w> kwam samen in de kathedraal voor het avondgebed.",
                            "target_lang_translations": {
                                "en": "A devout <w>flock</w> gathered in the cathedral for evening prayer."
                            }
                        }
                    ],
                    "synonyms": [
                        "menigte"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A gathering of believers or people present at a religious service."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flock",
                                "target_lang_sense_clarification": "a congregation of believers"
                            },
                            {
                                "target_lang_word": "congregation",
                                "target_lang_sense_clarification": "a group of people assembled for religious worship"
                            },
                            {
                                "target_lang_word": "multitude",
                                "target_lang_sense_clarification": "a large gathering of people in a solemn context"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "921a7631-4f1a-3e05-9b5d-9c9c47659968",
                    "sense_definition": "De aanvoegende wijs van het werkwoord <w>scharen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is het vaandel waarachter men zich <w>schare</w>.",
                            "target_lang_translations": {
                                "en": "This is the banner behind which people <w>should rally</w>."
                            }
                        },
                        {
                            "text": "Men <w>schare</w> zich in rijen van drie alvorens te vertrekken.",
                            "target_lang_translations": {
                                "en": "Let people <w>line up</w> in rows of three before departing."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Aanvoegende wijs (conjunctief) is verouderd in het modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The subjunctive mood of the verb 'scharen' (to gather, line up, or rally)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "subjunctive form: let them gather or rally"
                            },
                            {
                                "target_lang_word": "rally",
                                "target_lang_sense_clarification": "subjunctive form: let them rally behind"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}