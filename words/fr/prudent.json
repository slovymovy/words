                        "téméraire"
                    ],
                    "common_phrases": [
                        "rester prudent"
                    ]
                },
                {
                    "sense_id": "26ccf740-963e-3747-bc36-a75105104aeb",
                    "sense_definition": "Qui manifeste de la réserve, de la modération et le souci d'éviter les risques, en parlant d'un acte ou d'une attitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a adopté une démarche <w>prudente</w> avant d'investir son argent."
                        },
                        {
                            "text": "Elle a gardé un silence <w>prudent</w> pour ne pas aggraver la dispute."
                        }
                    ],
                    "synonyms": [
                        "avisé",
                        "mesuré",
                        "retenu"
                    ],
                    "antonyms": [
                        "imprudent"
                    ],
                    "common_phrases": [
                        "décision prudente",
                        "conduite prudente",
                        "silence prudent"
                    ]
                }
            ]
        },
        {
