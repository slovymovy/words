                "entry_id": "1e499dba-e7f9-39f2-9bbf-04c188900712",
                "word": "protectionism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f9e9535-29fa-456a-ba6f-a6f657207ad0",
