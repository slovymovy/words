                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                        "entry_id": "e21124a3-6b2d-3f58-8177-310aa81dde72",
                        "glosses": [
                            "Ausruf der Verwunderung oder der (überlegenen) Ablehnung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "706a4fbe-9188-4777-aad8-8f8c1731f75e",
                                "sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                                "text": "Hoho, das hätte ich jetzt aber nicht vermutet!"
                            },
                            {
                                "example_id": "83743f60-8d0d-47dc-acf0-553e7aaf9d3b",
                                "sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                                "text": "Hoho, diese Behauptung müsst ihr aber noch beweisen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3ae0830-1465-40aa-a997-732929a6de73",
                        "source_entry_id": "e21124a3-6b2d-3f58-8177-310aa81dde72",
                        "source_sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                        "target_lang_word": "oho",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                        "entry_id": "aa469502-2030-381b-b727-ece02b838320",
                                        "glosses": [
                                            "Expressing surprise or gloating realisation; aha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9da0b2-6384-495d-af58-875aa6f01065",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"There is Kate, taking no heed of anybody; sensible old darling — she goes at her tea and cake — Oho! she has not touched them!\""
                                            },
                                            {
                                                "example_id": "d5cab04f-a913-4038-8081-77c3eaa3abae",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho, my boy, that's the woman who keeps you here! Mrs. Neff hinted at it, but I wouldn't believe it till I had it from you.\""
                                            },
                                            {
                                                "example_id": "6ac204d8-d4b8-477b-a061-e775d954ff70",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho,\" he said, \"a vile thing to say. It is. I am losing check upon my tongue, it is running free like a riderless horse. And I don't give a damn. I can say at last what I wanted for years to say, years of being politic and demure. No longer.\""
                                            },
                                            {
                                                "example_id": "2bc46f57-cf3a-4c69-b7cd-38e90c69dc2e",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho! Now I see where he's going with this, Frank thinks. Would have seen it earlier if I hadn't been so tired.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc5a9d32-1ea1-45a2-bf8c-d1f14530c063",
                        "source_entry_id": "e21124a3-6b2d-3f58-8177-310aa81dde72",
                        "source_sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                        "target_lang_word": "wow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "An indication of excitement, surprise, astonishment, or pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7b373b-1978-4e8f-85c0-6215bed54376",
                                                "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                                "text": "Wow, I sure was surprised!"
                                            },
                                            {
                                                "example_id": "a96a0863-4d6e-4538-b634-ed482a2e49fd",
                                                "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                                "text": "Out on thir wanderand spiritis, wow! thow cryis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139fcae6-9079-3a45-a299-716fb6261a8d",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "An expression of amazement, awe, or admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6687b4-d443-4d7f-b6ed-0c57f210142e",
                                                "sense_id": "139fcae6-9079-3a45-a299-716fb6261a8d",
                                                "text": "Wow! How do they do that?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db161641-d54f-37ad-9b0f-64ef23537c46",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "Used sarcastically to express disapproval of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15710177-5206-4a15-8809-41a8d3db2997",
                                                "sense_id": "db161641-d54f-37ad-9b0f-64ef23537c46",
                                                "text": "Wow… good job using all of our supplies on the first day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                        "entry_id": "47cf5d82-501a-3430-9d11-37d3fd3a07d0",
                                        "glosses": [
                                            "To amaze or awe."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772c566d-b465-4127-b018-c2866b52b614",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "He really wowed the audience."
                                            },
                                            {
                                                "example_id": "d1b0cc25-c10e-44bb-bf41-27176b3f0eb0",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "If all of us can remember how great it felt to be wowed, why don't we make it a habit to do it more often for others? People remember you when you wow them, so to differentiate yourself with your clients and customers, think of doing something that would make them remember you."
                                            },
                                            {
                                                "example_id": "012f63a9-5d23-44b8-9f59-510354055885",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "We have the worst of both worlds: the royal family gives us nothing, and we in turn legitimise it, give it meaning and audience and pay, through subsidies and tax exemptions, for its ability to wow us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                        "entry_id": "35dcada5-2923-367d-8d7f-59a226d85ab5",
                                        "glosses": [
                                            "Anything exceptionally surprising, unbelievable, outstanding, etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2e4c4a-5cf3-4e5e-af67-5fc570dcd298",
                                                "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                                "text": "‘And say, Jimmy, wait till you see me in my new outfit...It’s a wow, kid.’"
                                            },
                                            {
                                                "example_id": "4aea2ab9-12b1-49c2-84fe-8981d3fe2fb5",
                                                "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                                "text": "‘Jesus suffering fuck,’ said Adrian. ‘It’s not half a thought.’\n‘Face it, it’s a wow.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                        "entry_id": "35dcada5-2923-367d-8d7f-59a226d85ab5",
                                        "glosses": [
                                            "An utterance of \\\"wow\\\"."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8238a368-d336-426b-bc56-f79a01e32054",
                                                "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                                "text": "On this trip, we talked with fellow cruisers about their travels and boats, and many were curious about the Beneteau Swift Trawler. Gow graciously gave tours, during which we heard many wows, oohs and aahs."
                                            },
                                            {
                                                "example_id": "426825f3-5964-48a1-9162-34d7e7277494",
                                                "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                                "text": "One woman took a seat nearer the front for a closer look at my maps. Several people exhaled loudly. I heard a wow now and then."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d702502-7dba-3e98-b792-8c3de7e909a8",
                                        "entry_id": "16fcde9e-aac7-3df0-958b-25eec4c377fb",
                                        "glosses": [
                                            "A relatively slow form of flutter (pitch variation) which can affect both gramophone records and tape recorders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c886c2-5abf-4d68-9353-3f64693ac364",
                                                "sense_id": "8d702502-7dba-3e98-b792-8c3de7e909a8",
                                                "text": "Sound films have to be loaded so that the sound is 5 seconds before the sound drum so a wow does not result when the film is punched up on the air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e4ae5e6-9c84-46c0-ab73-d7b69e84f5ee",
                        "source_entry_id": "e21124a3-6b2d-3f58-8177-310aa81dde72",
                        "source_sense_id": "0b088a75-4a95-3ac3-8ca5-c3d62af8d6bb",
                        "target_lang_word": "meh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4efcc1dc-9ff2-3f46-8869-74c887eace20",
                                        "entry_id": "9cd3ff8a-e794-3ffd-95ef-a88c089c63a9",
                                        "glosses": [
                                            "Mediocre; lackluster; unexceptional; uninspiring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72e4e38-9f93-44cc-9506-75438e3450cc",
                                                "sense_id": "4efcc1dc-9ff2-3f46-8869-74c887eace20",
                                                "text": "They redeemed themselves with this show. The first song or two was meh, but they were on fire after that."
                                            },
                                            {
                                                "example_id": "8977a879-f3fa-4f77-886b-48275e9e20ac",
                                                "sense_id": "4efcc1dc-9ff2-3f46-8869-74c887eace20",
                                                "text": "The voice is excellent as always, but the overall effect was meh until the end, where he became a little bit awesome."
                                            },
                                            {
                                                "example_id": "2881457f-2449-4c7a-94a1-067987fe37b7",
                                                "sense_id": "4efcc1dc-9ff2-3f46-8869-74c887eace20",
                                                "text": "Nothing that was supposed to be big and exciting came off as such and the rest was meh at best."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f94e7d81-cf8e-3919-b763-4092c61847a1",
                                        "entry_id": "9cd3ff8a-e794-3ffd-95ef-a88c089c63a9",
                                        "glosses": [
                                            "Apathetic; unenthusiastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb7e484-c1ba-4f21-9e2f-f75d620a5247",
                                                "sense_id": "f94e7d81-cf8e-3919-b763-4092c61847a1",
                                                "text": "Both shows left me feeling, meh."
                                            },
                                            {
                                                "example_id": "f8de421e-adad-44cb-b5a5-3b1f73c6aee7",
                                                "sense_id": "f94e7d81-cf8e-3919-b763-4092c61847a1",
                                                "text": "I’m a huge Clay fan, love Ruben’s voice, and have become quite a fan of Kelly’s, as well. Fantasia just leaves me feeling meh."
                                            },
                                            {
                                                "example_id": "a10652ed-31cb-4564-b323-2967ae884742",
                                                "sense_id": "f94e7d81-cf8e-3919-b763-4092c61847a1",
                                                "text": "I liked it but I wasn’t feeling it for some reason that day, again, I was feeling meh toward video games in general."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4711b24-30b4-330a-9f85-4497f0f66608",
                                        "entry_id": "2a8407de-30fa-37f3-bb3f-82ff55bf692d",
                                        "glosses": [
                                            "Expressing indifference or lack of enthusiasm."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eeee190-a344-42a8-936f-03b82f4b8bf1",
                                                "sense_id": "b4711b24-30b4-330a-9f85-4497f0f66608",
                                                "text": "“What do you want for dinner?” — “Meh. I’m not really hungry.”"
                                            },
                                            {
                                                "example_id": "39744032-d14a-4c36-be68-8920ed795b0f",
                                                "sense_id": "b4711b24-30b4-330a-9f85-4497f0f66608",
                                                "text": "“That film was awesome!” — “Meh. I’ve seen better.”"
                                            },
                                            {
                                                "example_id": "fd6b5bb9-c772-41ad-817f-fade7ae7a4e0",
                                                "sense_id": "b4711b24-30b4-330a-9f85-4497f0f66608",
                                                "text": "Marge: [weaving on a loom] “Hi Bart, I’m weaving on a loom!”\nBart: “Meh”."
                                            },
                                            {
                                                "example_id": "703fe93d-e6a9-4a6a-bd51-7793a5e42c2a",
                                                "sense_id": "b4711b24-30b4-330a-9f85-4497f0f66608",
                                                "text": "Scientists say that while the public may think of the moon as a problem solved and a bit retro – the place astronauts visited a half-dozen times way back before Watergate and then abandoned with a giant \"meh\" from mankind – in fact, lunar studies is a vibrant enterprise that is yielding a wealth of surprises."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35cb9e87-99df-37af-84b9-28c484cf1b1b",
                                        "entry_id": "5a46f09e-3d5f-35f8-a3ff-e5ec111d5c8d",
                                        "glosses": [
                                            "A judgement marked by indifference; lack of impression."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "meh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                        "entry_id": "e430c161-cc6b-3ba2-84e8-163055779bd4",
                                        "glosses": [
                                            "Final question particle expressing skepticism."
                                        ],
                                        "tags": [
                                            "Manglish",
                                            "Singlish",
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2a4f60-3466-4365-9426-835768859347",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "Really meh?",
                                                "translation": "Really? I don’t think so.",
                                                "english": "Really? I don’t think so."
                                            },
                                            {
                                                "example_id": "a4e1c037-758a-4210-969c-c7398c488c86",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "This one your one meh?",
                                                "translation": "Is this really yours?",
                                                "english": "Is this really yours?"
                                            },
                                            {
                                                "example_id": "4321155d-20e4-430e-8bfd-3e58fbb43918",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "You got send [e-mail] meh? I never receive leh."
                                            },
                                            {
                                                "example_id": "5930afc8-7b8d-4c5e-a9e3-85a94c9f8fb2",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "“Nice meh?” I would think sourly."
                                            },
                                            {
                                                "example_id": "76b6a440-72a2-4f06-a396-f68567552de3",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "\"Huh? At this hour? Really meh?\" He couldn't believe his own ears."
                                            },
                                            {
                                                "example_id": "fbdf3e16-69cf-4b0e-a194-5cd5a522ad36",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "Not pain, meh. When you have eczema and do tattoos?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6b48c5-4393-34ca-8cb2-4cf9b228b1e6",
                                        "entry_id": "13ef4bf2-04b3-3c76-9ceb-debf5bfa80c8",
                                        "glosses": [
                                            "A bleating sound, as that of a sheep or goat."
                                        ],
