                            {
                                "example_id": "42ec7210-a5d0-4f80-8ef4-9817a24f9d0b",
                                "sense_id": "107bae6e-b73b-38fe-a41c-649ba08432f8",
                                "text": "Freudenstadt liegt in Deutschlands Südwesten."
                            },
                            {
                                "example_id": "fe02f6e0-5175-4501-b7fc-316e9b79afe8",
                                "sense_id": "107bae6e-b73b-38fe-a41c-649ba08432f8",
                                "text": "„In nicht einmal fünf Jahren, zwischen 1949 und 1954, bauten die Bürger ihre Stadt wieder auf, und es scheint, als ob alles wieder so sei wie vor 400 Jahren, als Freudenstadt entstand.“"
