{
    "word_family": [
        "debatable",
        "debater",
        "undebatable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                    "sense_definition": "A formal discussion on a particular topic in a public meeting or legislative assembly, in which opposing arguments are put forward and which usually ends with a vote.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidates will participate in a televised <w>debate</w> next week.",
                            "target_lang_translations": {
                                "ru": "Кандидаты примут участие в телевизионных <w>дебатах</w> на следующей неделе.",
                                "tr": "Adaylar önümüzdeki hafta televizyonda yayınlanacak bir <w>münazaraya</w> katılacaklar.",
                                "zh": "候选人下周将参加一场电视<w>辩论</w>。"
                            }
                        },
                        {
                            "text": "After a long parliamentary <w>debate</w>, the committee voted to table the motion.",
                            "target_lang_translations": {
                                "ru": "После долгих парламентских <w>прений</w> комитет проголосовал за то, чтобы отложить рассмотрение предложения.",
                                "tr": "Uzun bir parlamento <w>müzakeresinin</w> ardından komite, önergenin ertelenmesi yönünde oy kullandı.",
                                "zh": "经过长时间的议会<w>辩论</w>，委员会投票决定搁置该动议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "parliamentary debate",
                        "televised debate",
                        "heated debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное обсуждение определенной темы на публичном собрании или в законодательном органе, в ходе которого выдвигаются противоположные аргументы и которое обычно заканчивается голосованием.",
                        "tr": "Kamusal bir toplantıda veya yasama meclisinde, karşıt görüşlerin sunulduğu ve genellikle oylamayla sona eren resmi tartışma.",
                        "zh": "在公共会议或立法机构中，针对特定议题进行的正式讨论，通常会提出对立的观点并以投票结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дебаты",
                                "target_lang_sense_clarification": "официальное обсуждение"
                            },
                            {
                                "target_lang_word": "прения",
                                "target_lang_sense_clarification": "публичный спор или судебные выступления"
                            },
                            {
                                "target_lang_word": "дискуссия",
                                "target_lang_sense_clarification": "публичное обсуждение спорного вопроса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "münazara",
                                "target_lang_sense_clarification": "kurallı ve resmi tartışma"
                            },
                            {
                                "target_lang_word": "müzakere",
                                "target_lang_sense_clarification": "yasama veya resmi kurul tartışması"
                            },
                            {
                                "target_lang_word": "oturum",
                                "target_lang_sense_clarification": "meclis veya kamuoyu tartışması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辩论",
                                "target_lang_sense_clarification": "正式的公开讨论"
                            },
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "针对议题的正式商议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                    "sense_definition": "An informal but spirited discussion of opposing views between individuals or groups.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a bit of a <w>debate</w> over who should pay for the damaged fence.",
                            "target_lang_translations": {
                                "ru": "Возник небольшой <w>спор</w> о том, кто должен платить за поврежденный забор.",
                                "tr": "Hasar gören çitin parasını kimin ödemesi gerektiği konusunda küçük bir <w>tartışma</w> yaşandı.",
                                "zh": "关于谁该为损坏的栅栏买单，大家产生了一点<w>争论</w>。"
                            }
                        },
                        {
                            "text": "The <w>debate</w> over the age of the universe has lasted for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Дискуссия</w> о возрасте Вселенной длится веками.",
                                "tr": "Evrenin yaşına ilişkin <w>tartışma</w> yüzyıllardır devam ediyor.",
                                "zh": "关于宇宙年龄的<w>争论</w>已经持续了几个世纪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "internal debate",
                        "lively debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное, но оживленное обсуждение противоположных взглядов между отдельными лицами или группами.",
                        "tr": "Bireyler veya gruplar arasında karşıt görüşlerin gayriresmi ancak canlı bir şekilde tartışılması.",
                        "zh": "个人或团体之间针对对立观点进行的非正式但激烈的讨论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "словесное состязание"
                            },
                            {
                                "target_lang_word": "дискуссия",
                                "target_lang_sense_clarification": "обмен мнениями"
                            },
                            {
                                "target_lang_word": "обсуждение",
                                "target_lang_sense_clarification": "рассмотрение вопроса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tartışma",
                                "target_lang_sense_clarification": "fikir alışverişi veya çekişme"
                            },
                            {
                                "target_lang_word": "münakaşa",
                                "target_lang_sense_clarification": "canlı fikir ayrılığı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争论",
                                "target_lang_sense_clarification": "针对不同意见的激烈交流"
                            },
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "交换意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                    "sense_definition": "General discussion or controversy concerning a specific subject.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The origin of the virus is still a matter of intense scientific <w>debate</w>.",
                            "target_lang_translations": {
                                "ru": "Происхождение вируса до сих пор является предметом острых научных <w>дискуссий</w>.",
                                "tr": "Virüsün kökeni hâlâ yoğun bilimsel <w>tartışmaların</w> konusudur.",
                                "zh": "病毒的起源仍然是科学界激烈<w>争议</w>的话题。"
                            }
                        },
                        {
                            "text": "There has been considerable <w>debate</w> concerning exactly how to format these articles.",
                            "target_lang_translations": {
                                "ru": "Велось немало <w>споров</w> относительно того, как именно следует форматировать эти статьи.",
                                "tr": "Bu makalelerin tam olarak nasıl biçimlendirileceği konusunda epey <w>tartışma</w> yaşandı.",
                                "zh": "关于这些文章究竟该如何排版，存在着相当大的<w>争议</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "matter of debate",
                        "under debate",
                        "public debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее обсуждение или полемика по конкретному вопросу.",
                        "tr": "Belirli bir konu hakkında genel tartışma veya kamuoyu fikir ayrılığı.",
                        "zh": "关于特定主题的普遍讨论或争议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискуссия",
                                "target_lang_sense_clarification": "научная или общественная"
                            },
                            {
                                "target_lang_word": "полемика",
                                "target_lang_sense_clarification": "острый спор при выяснении вопросов"
                            },
                            {
                                "target_lang_word": "дебаты",
                                "target_lang_sense_clarification": "широкое обсуждение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tartışma",
                                "target_lang_sense_clarification": "genel veya bilimsel konu tartışması"
                            },
                            {
                                "target_lang_word": "polemik",
                                "target_lang_sense_clarification": "kamuoyundaki anlaşmazlık"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争议",
                                "target_lang_sense_clarification": "关于某事的普遍分歧"
                            },
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "针对某议题的广泛探讨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eccd06d-09d6-3dbd-8c22-52e2632c933f",
                    "sense_definition": "A type of literary composition in the form of a discussion or disputation, common in medieval poetry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar specialized in the medieval Latin <w>debate</w> as a poetic form.",
                            "target_lang_translations": {
                                "ru": "Ученый специализировался на средневековом латинском <w>прении</w> как поэтической форме.",
                                "tr": "Bilim insanı, bir şiir biçimi olarak Orta Çağ Latince <w>münazarası</w> üzerine uzmanlaştı.",
                                "zh": "这位学者专门研究作为一种诗歌形式的中世纪拉丁语<w>辩论诗</w>。"
                            }
                        },
                        {
                            "text": "Many European traditions feature the <w>debate</w> between the soul and the body.",
                            "target_lang_translations": {
                                "ru": "Во многих европейских традициях встречается <w>диспут</w> между душой и телом.",
                                "tr": "Birçok Avrupa geleneği ruh ile beden arasındaki <w>atışmayı</w> konu alır.",
                                "zh": "许多欧洲文学传统中都有灵魂与肉体之间的<w>辩论诗</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "literary debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип литературного произведения в форме дискуссии или диспута, распространенный в средневековой поэзии.",
                        "tr": "Orta Çağ şiirinde yaygın olan, tartışma veya atışma biçimindeki edebi eser türü.",
                        "zh": "一种以讨论或辩驳形式呈现的文学作品类型，常见于中世纪诗歌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диспут",
                                "target_lang_sense_clarification": "литературная или ученая форма спора"
                            },
                            {
                                "target_lang_word": "прение",
                                "target_lang_sense_clarification": "жанр средневековой литературы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "münazara",
                                "target_lang_sense_clarification": "edebi atışma türü"
                            },
                            {
                                "target_lang_word": "disput",
                                "target_lang_sense_clarification": "akademik veya edebi tartışma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辩论诗",
                                "target_lang_sense_clarification": "中世纪文学体裁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "825e5560-a37e-31fb-a29d-aa5c5193bc5b",
                    "sense_definition": "Conflict, strife, or discord between parties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient chronicles speak of a time of great <w>debate</w> and civil unrest.",
                            "target_lang_translations": {
                                "ru": "Древние хроники говорят о временах великих <w>раздоров</w> и гражданских беспорядков.",
                                "tr": "Kadim kronikler büyük bir <w>çekişme</w> ve sivil huzursuzluk döneminden bahseder.",
                                "zh": "古代编年史记载了一个充满巨大<w>纷争</w>和内乱的时代。"
                            }
                        },
                        {
                            "text": "The king sought to end the <w>debate</w> between the warring factions.",
                            "target_lang_translations": {
                                "ru": "Король стремился положить конец <w>распре</w> между враждующими группировками.",
                                "tr": "Kral, savaşan gruplar arasındaki <w>nifakı</w> sona erdirmeye çalıştı.",
                                "zh": "国王试图结束交战派系之间的<w>争执</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конфликт, борьба или раздор между сторонами.",
                        "tr": "Taraflar arasındaki anlaşmazlık, çekişme veya ihtilaf.",
                        "zh": "各方之间的冲突、争斗或不和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "отсутствие согласия, вражда"
                            },
                            {
                                "target_lang_word": "распря",
                                "target_lang_sense_clarification": "серьезное разногласие, борьба"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nifak",
                                "target_lang_sense_clarification": "anlaşmazlık, bozuşma"
                            },
                            {
                                "target_lang_word": "çekişme",
                                "target_lang_sense_clarification": "ihtilaf, anlaşmazlık"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纷争",
                                "target_lang_sense_clarification": "严重的意见不合或冲突"
                            },
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "各方之间的不和"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                    "sense_definition": "To argue about a subject, especially in a formal manner or public arena.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "to_discuss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politicians will <w>debate</w> the new tax law in the House of Commons.",
                            "target_lang_translations": {
                                "ru": "Политики будут <w>обсуждать</w> новый налоговый закон в Палате общин.",
                                "tr": "Siyasiler Avam Kamarası'nda yeni vergi yasasını <w>tartışacaklar</w>.",
                                "zh": "政客们将在下议院<w>辩论</w>新的税法。"
                            }
                        },
                        {
                            "text": "It is important to <w>debate</w> the issue thoroughly before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Важно тщательно <w>обсудить</w> этот вопрос, прежде чем принимать окончательное решение.",
                                "tr": "Nihai bir karar vermeden önce konuyu enine boyuna <w>tartışmak</w> önemlidir.",
                                "zh": "在做出最终决定前，彻底<w>讨论</w>这个问题很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contend"
                    ],
                    "common_phrases": [
                        "debate the issue",
                        "debate the merits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аргументированно обсуждать тему, особенно в официальной манере или на публичной арене.",
                        "tr": "Bir konuyu özellikle resmi bir ortamda veya kamusal alanda mantıklı argümanlarla tartışmak.",
                        "zh": "针对某一主题进行论证，尤指以正式方式或在公共场合进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискутировать",
                                "target_lang_sense_clarification": "вести официальный спор"
                            },
                            {
                                "target_lang_word": "дебатировать",
                                "target_lang_sense_clarification": "участвовать в прениях"
                            },
                            {
                                "target_lang_word": "обсуждать",
                                "target_lang_sense_clarification": "рассматривать вопрос"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tartışmak",
                                "target_lang_sense_clarification": "bir konuyu karşılıklı ele almak"
                            },
                            {
                                "target_lang_word": "müzakere etmek",
                                "target_lang_sense_clarification": "resmi olarak görüşmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辩论",
                                "target_lang_sense_clarification": "正式地争论"
                            },
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "商讨议题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                    "sense_definition": "To consider or think over different options in one's own mind before making a decision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_think",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am still <w>debating</w> whether to accept the job offer or stay here.",
                            "target_lang_translations": {
                                "ru": "Я все еще <w>раздумываю</w>, принять ли предложение о работе или остаться здесь.",
                                "tr": "Hâlâ iş teklifini kabul edip etmemeyi <w>düşünüp taşınıyorum</w>.",
                                "zh": "我还在<w>考虑</w>是接受这份工作邀请还是留在这里。"
                            }
                        },
                        {
                            "text": "He was <w>debating</w> where he would spend his summer holiday this year.",
                            "target_lang_translations": {
                                "ru": "Он <w>размышлял</w> о том, где проведет свой летний отпуск в этом году.",
                                "tr": "Bu yıl yaz tatilini nerede geçireceğini kendi kendine <w>tartıyordu</w>.",
                                "zh": "他正在<w>考虑</w>今年暑假去哪里度假。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "debate whether to",
                        "debate with oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать или обдумывать различные варианты в уме перед принятием решения.",
                        "tr": "Bir karar vermeden önce kendi zihninde farklı seçenekleri değerlendirmek veya düşünmek.",
                        "zh": "在做出决定前，在心中考虑或权衡不同的选择。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздумывать",
                                "target_lang_sense_clarification": "взвешивать варианты"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "не решаться на что-то"
                            },
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "мысленно обсуждать с собой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kendi kendine tartışmak",
                                "target_lang_sense_clarification": "zihninde tartmak"
                            },
                            {
                                "target_lang_word": "bocalama yaşamak",
                                "target_lang_sense_clarification": "kararsız kalıp düşünmek"
                            },
                            {
                                "target_lang_word": "düşünüp taşınmak",
                                "target_lang_sense_clarification": "seçenekleri değerlendirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考虑",
                                "target_lang_sense_clarification": "权衡利弊"
                            },
                            {
                                "target_lang_word": "犹豫",
                                "target_lang_sense_clarification": "拿不定主意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                    "sense_definition": "To strive or compete for something; to engage in a struggle to achieve a goal.",
