                                        "sense_id": "7626113a-5112-35d0-975e-33aa704b3bbf",
                                        "entry_id": "0395a9b2-6af9-35d9-aefa-a0da90f76e3b",
                                        "glosses": [
                                            "A victory by a wide margin in an election."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c98783-c60f-478d-b597-a662fe728d20",
                                                "sense_id": "7626113a-5112-35d0-975e-33aa704b3bbf",
                                                "text": "Nixon capitalized on this changing tide of voting behaviour, and hence won a landslide victory in the 1972 election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
