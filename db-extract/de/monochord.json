                "senses": [
                    {
                        "sense_id": "690e67dd-1c73-3965-8135-4cdb18905fa2",
                        "entry_id": "6982a02f-d577-3620-9bb3-9fd860ef9f4e",
                        "glosses": [
                            "einsaitiges, aus der griechischen Antike stammendes Musikinstrument, das die zahlhaften Zusammenhänge zwischen Tonhöhe und Saitenlänge über einen verschiebbaren Steg verdeutlicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771b32a1-dca9-46e4-b41e-7d1a55515952",
                                "sense_id": "690e67dd-1c73-3965-8135-4cdb18905fa2",
                                "text": "„Möglicherweise haben die Pythagoreer ihren Einfall bei Experimenten am Monochord gewonnen.“"
                            },
                            {
                                "example_id": "9d47c526-8ad6-480f-bc66-fe38c62c8f09",
                                "sense_id": "690e67dd-1c73-3965-8135-4cdb18905fa2",
                                "text": "„Ein Musikinstrument, mit dem die Pythagoräer nicht nur Musik machten, sondern das sie auch für Experimente benutzten, war das Monochord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
