                                ]
                            },
                            {
                                "target_word": "fédéral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df6ed816-e47f-3836-8984-0e34ba77135b",
                                        "entry_id": "d6ade93e-6694-3c62-b8b0-7d96bfbca609",
                                        "glosses": [
                                            "Gouvernement fédéral."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "note": "S'oppose généralement à le provincial ou à les provinces",
                                        "examples": [
                                            {
                                                "example_id": "6861b7b6-da6d-451c-88fe-29b2bf762611",
                                                "sense_id": "df6ed816-e47f-3836-8984-0e34ba77135b",
                                                "text": "Payer tant d'impôts au fédéral et tant au provincial."
                                            },
                                            {
                                                "example_id": "aaf4dafc-f84b-40e7-9885-abe679901804",
                                                "sense_id": "df6ed816-e47f-3836-8984-0e34ba77135b",
                                                "text": "Le fédéral devrait en outre, selon cette étude, se doter d'une politique qui établirait formellement le droit à un accès à une eau potable de qualité, et ce, selon des normes minimales imposées à l'ensemble du pays."
                                            },
                                            {
                                                "example_id": "e290fb11-a890-410f-8b35-2596cf0f918e",
                                                "sense_id": "df6ed816-e47f-3836-8984-0e34ba77135b",
                                                "text": "Ce sous-financement s'est poursuivi avec l'arrivée des libéraux au Québec et des conservateurs au fédéral'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43a79f29-4ac2-3c98-a339-4eb2787503dc",
                                        "entry_id": "d6ade93e-6694-3c62-b8b0-7d96bfbca609",
                                        "glosses": [
                                            "Membres d’un organisme fédéral des États-Unis d’Amérique (FBI, CIA, etc.)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afd1cb53-5e34-4d0b-859f-aca6974ee14e",
                                                "sense_id": "43a79f29-4ac2-3c98-a339-4eb2787503dc",
                                                "text": "Les fédéraux sont déjà venus voir s’ils peuvent intervenir, on peut pas les tenir à l’écart."
                                            }
                                        ]
                                    }
                                ]
                            }
