                        "translation_id": "d3ede52e-d5be-454e-b88e-c9544b06113b",
                        "source_entry_id": "3e6a6316-6214-397b-9c54-c10f814dedf0",
                        "source_sense_description": "the theory of the \"greatest happiness for the greatest number of people\"",
