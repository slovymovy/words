                "entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                "word": "однозначно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed729844-f970-3c7e-9243-d5edf634ab29",
                        "entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "glosses": [
                            "наречие к однозначный; без вариантов; допуская лишь один смысл, одно толкование"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd518b5-4154-48f0-a687-34c28c7cf214",
                                "sense_id": "ed729844-f970-3c7e-9243-d5edf634ab29",
                                "text": "Я и не вникал тогда в суть проблемы, а мыслил просто и однозначно: я актер, не знающий, кроме русского, ни одного языка, и единственно возможное для меня место полноценной работы ― Россия."
                            }
                        ]
                    },
                    {
                        "sense_id": "eec9fafa-b1db-3df6-bec5-29fee0d5be91",
                        "entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "glosses": [
                            "не допускает вариантов, является полностью определённым, точно"
                        ],
                        "tags": [
                            "в знач. вводного слова"
                        ],
                        "examples": [
                            {
                                "example_id": "29a211de-dbef-4871-a23a-fc78e57f26c7",
                                "sense_id": "eec9fafa-b1db-3df6-bec5-29fee0d5be91",
                                "text": "Стало быть, однозначно, штурм ― это кровь, убитые и раненые, это война."
                            }
                        ]
                    },
                    {
                        "sense_id": "c23b3e58-62f0-30fd-9438-f200372c7c27",
                        "entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "glosses": [
                            "да, несомненно"
                        ],
                        "tags": [
                            "в знач. утвердительной частицы"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c551dba0-ffa7-4ec1-9a4e-67e41b4be3c8",
                        "source_entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "source_sense_description": "наречие",
                        "target_lang_word": "definitely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "definitely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "Without question and beyond doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17663ba8-eeae-4fe3-9e67-4374926ada7f",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "Joe definitely doesn't know how to drive a tractor."
                                            },
                                            {
                                                "example_id": "35bac096-e678-43d3-8b69-e38e3bbec1d9",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "She said she wasn't coming, definitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "In a definite manner; decisively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8183e1b2-41c5-49da-ad93-89cff4ff9f2a",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "It was really impossible on board that ship to get away definitely from Almayer"
                                            },
                                            {
                                                "example_id": "64f95043-a2cb-43a6-811e-598be8b23344",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And the Nose definitely turned away."
                                            },
                                            {
                                                "example_id": "b77493ff-1187-43e1-8a19-bdf51e9f198f",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And these Elders were men of good standing in that community, and they swore definitely before the counsel that this lady committed this impropriety, and there was nobody to gainsay that, except the lady herself, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e31ecfd-e9ec-4634-b901-f0452ef34cff",
                        "source_entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "source_sense_description": "наречие",
                        "target_lang_word": "unambiguously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unambiguously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                        "entry_id": "caee5e1a-b368-3da5-8834-eb03dfe56f36",
                                        "glosses": [
                                            "In a manner that is not ambiguous; leaving no doubt; clearly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db344b50-f643-48b8-b4e6-899928dcecf0",
                                                "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                                "text": "She told him unambiguously to leave, yet he failed to leave."
                                            },
                                            {
                                                "example_id": "d29594e3-6005-483c-a3e2-cbf1cabc796c",
                                                "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                                "text": "The break with tradition that Francis, who has died aged 88 after suffering from double pneumonia, represented even managed to trump the shock value of the resignation of Benedict, who was the first pope for 600 years to take that option rather than die in office. Immediately, Bergoglio signalled unambiguously that he intended to be a different kind of pope, one for the 21st century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abaaff97-27ce-48cc-8a38-d2fe1935f0bf",
                        "source_entry_id": "80113da9-b588-35b2-8b8a-7c09293cd4ff",
                        "source_sense_description": "наречие",
                        "target_lang_word": "unequivocally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unequivocally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                        "entry_id": "dff512b6-20c5-3a47-a736-0fce82a8b63f",
                                        "glosses": [
                                            "In a way that leaves no doubt; in an unequivocal or unambiguous manner, unquestionably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91553daf-def3-4819-88b9-eb8c21af4d0c",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "They strove to make their product unequivocally the best in the industry."
                                            },
                                            {
                                                "example_id": "0b354b68-5bbb-4321-a36f-5775e32df931",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "'Surely, in hindsight, you realise she was an unsuitable wife for you,' he stated unequivocally.\n'Don't go there, Dad,' Luc warned, hard ruthless steel in his own eyes. 'You've lost one son. You're very close to losing another.'"
                                            },
                                            {
                                                "example_id": "b96527f6-c8b1-4e22-b98d-31c92c34fea8",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "The millettioid group involves the unequivocally sustained millettioid and phaseoloid clades including numerous vital crop species, for example, the cultivated soybean […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e380a67-0220-478e-a794-713e18be5e94",
