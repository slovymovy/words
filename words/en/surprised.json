            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4a0a4f6-75d8-3e94-8319-fbfd2cd48bd0",
                    "sense_definition": "Caused to feel surprise, amazement or wonder, or showing an emotion due to an unexpected event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>surprised</w> to see him at the party.",
                            "target_lang_translations": {
                                "ru": "Она была <w>удивлена</w>, увидев его на вечеринке.",
                                "nl": "Ze was <w>verbaasd</w> om hem op het feest te zien.",
                                "pl": "Była <w>zaskoczona</w>, widząc go na przyjęciu.",
                                "de": "Sie war <w>überrascht</w>, ihn auf der Party zu sehen."
                            }
                        },
                        {
                            "text": "We were pleasantly <w>surprised</w> by the quality of the food.",
                            "target_lang_translations": {
                                "ru": "Мы были приятно <w>удивлены</w> качеством еды.",
                                "nl": "We waren aangenaam <w>verrast</w> door de kwaliteit van het eten.",
                                "pl": "Byliśmy mile <w>zaskoczeni</w> jakością jedzenia.",
                                "de": "Wir waren von der Qualität des Essens angenehm <w>überrascht</w>."
                            }
                        },
                        {
                            "text": "I was <w>surprised</w> by how helpful he was.",
                            "target_lang_translations": {
                                "ru": "Я был <w>удивлён</w> тем, насколько он оказался полезен.",
                                "nl": "Ik was <w>verbaasd</w> over hoe behulpzaam hij was.",
                                "pl": "Byłem <w>zdziwiony</w> tym, jak bardzo był pomocny.",
                                "de": "Ich war <w>überrascht</w>, wie hilfsbereit er war."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "startled",
                        "amazed",
                        "shocked"
                    ],
                    "antonyms": [
                        "unsurprised"
                    ],
                    "common_phrases": [
                        "pleasantly surprised",
                        "look surprised",
                        "genuinely surprised"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий удивление или изумление из-за неожиданного события.",
                        "nl": "Het gevoel van verbazing of verwondering ervaren door een onverwachte gebeurtenis.",
                        "pl": "Odczuwający zdziwienie lub zaskoczenie z powodu nieoczekiwanego wydarzenia.",
                        "de": "Jemand, der aufgrund eines unerwarteten Ereignisses Erstaunen oder Verwunderung empfindet."
                    },
                    "translations": {
