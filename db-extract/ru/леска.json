                    }
                ],
                "senses": [
                    {
                        "sense_id": "90448358-3fbd-37ca-b3db-29ea275aca18",
                        "entry_id": "bf90e3e8-162b-3eec-8157-01444ad24786",
                        "glosses": [
                            "длинная прочная нить, обычно применяемая для ловли рыбы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1292ef04-8b9a-45ea-a70e-216a1c2cb36e",
                                "sense_id": "90448358-3fbd-37ca-b3db-29ea275aca18",
                                "text": "Грябов вскочил и поднял удилище. Леска натянулась…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3386cd5-0f5f-3412-b83e-09953dd5828f",
                        "entry_id": "bf90e3e8-162b-3eec-8157-01444ad24786",
                        "glosses": [
                            "пластиковая нить, используемая в триммерах (ручных газонокосилках)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824c917c-53b9-4ee6-a53c-49c55e5e9eb6",
                                "sense_id": "e3386cd5-0f5f-3412-b83e-09953dd5828f",
                                "text": "В некоторых моделях предусмотрена замена бобины с леской на насадку с пластмассовыми или металлическими ножами, и тогда бывший триммер превращается в кусторез и сучкорез."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e1c80c0-5f51-431b-9700-e288c4e915e6",
                        "source_entry_id": "bf90e3e8-162b-3eec-8157-01444ad24786",
                        "source_sense_description": "длинная прочная нить",
                        "target_lang_word": "fishing line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fishing line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7051f8-071a-3593-b0c0-b236a40d0ceb",
                                        "entry_id": "4fcaa6c0-d5e4-39ee-9230-995fbbb3706a",
                                        "glosses": [
                                            "A cord or line where the hook or lure is attached."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51b3c996-120d-479e-a2f9-d56fd353984e",
                        "source_entry_id": "bf90e3e8-162b-3eec-8157-01444ad24786",
                        "source_sense_description": "длинная прочная нить",
                        "target_lang_word": "Angelschnur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angelschnur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9a1ba5-ac93-312d-907f-921acf49b59f",
                                        "entry_id": "b1880aee-b3e8-3e88-8f74-5f346511d1c3",
                                        "glosses": [
                                            "Bezeichnet eine Schnur oder eine Leine, die zumeist mit einem Gerät für den Fischfang verbunden ist und an dessen anderem Ende ein Haken für einen Köder befestigt ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d23ce71e-55a9-44f0-bb0e-c7853b5f8ca6",
                                                "sense_id": "5c9a1ba5-ac93-312d-907f-921acf49b59f",
                                                "text": "Das Meer glänzt blau, der Schwimmer an der Angelschnur dümpelt, und der Angler ist versunken in Natur und Meditation."
                                            },
                                            {
                                                "example_id": "bdcb2851-50a8-40db-92b9-70a0bcb817b4",
                                                "sense_id": "5c9a1ba5-ac93-312d-907f-921acf49b59f",
                                                "text": "Man stößt mit dem Netz einer wunderschön gezeichneten Riesenspinne zusammen und spielt tief beeindruckt mit den Fäden, die so stark sind, dass man sie als Angelschnur verwenden könnte - sagt Sam."
                                            },
                                            {
                                                "example_id": "b623cd3b-0c81-4b72-b636-a78fddea13d4",
                                                "sense_id": "5c9a1ba5-ac93-312d-907f-921acf49b59f",
                                                "text": "„Laut schmatzend schnappte er nach dem Köder, schnell rissen wir an der Angelschnur, und schon bohrte sich der Haken in sein Maul.“"
                                            },
                                            {
                                                "example_id": "fee1485a-f0ca-4689-8e36-d03ac857daac",
                                                "sense_id": "5c9a1ba5-ac93-312d-907f-921acf49b59f",
                                                "text": "„Längs der einen Wand besteht eine Theke ungefähr zur Hälfte aus gläsernen Schaukästen, in denen Haken und Angelschnüre und verschiedene patentierte Geräte liegen, die beim Fischfang garantiert helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
