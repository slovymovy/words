{
    "word_family": [
        "appoint",
        "appointee",
        "reappoint",
        "reappointment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                    "sense_definition": "An arrangement to meet someone at a particular time and place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to make an <w>appointment</w> with the dentist for next week.",
                            "target_lang_translations": {
                                "ru": "Мне нужно записаться на <w>приём</w> к стоматологу на следующую неделю.",
                                "tr": "Gelecek hafta için diş hekiminden bir <w>randevu</w> almam gerekiyor.",
                                "zh": "我下周需要和牙医<w>预约</w>。",
                                "es": "Necesito pedir una <w>cita</w> con el dentista para la próxima semana."
                            }
                        },
                        {
                            "text": "She was late for her <w>appointment</w> because of the heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Она опоздала на <w>встречу</w> из-за сильных пробок.",
                                "tr": "Yoğun trafik nedeniyle <w>randevusuna</w> geç kaldı.",
                                "zh": "因为交通拥堵，她没能准时赶上<w>约定</w>。",
                                "es": "Llegó tarde a su <w>cita</w> debido al tráfico intenso."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an appointment",
                        "doctor's appointment",
                        "by appointment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Договорённость о встрече с кем-либо в определённое время и в определённом месте.",
                        "tr": "Belirli bir zamanda ve yerde biriyle buluşmak için yapılan anlaşma.",
                        "zh": "指在特定时间和地点与某人会面的安排。",
                        "es": "Un acuerdo para reunirse con alguien en un momento y lugar determinados."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "заранее согласованная"
                            },
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "к врачу, специалисту"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "посещение врача или должностного лица"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "randevu",
                                "target_lang_sense_clarification": "bir kişiyle veya uzmanla buluşma"
                            },
                            {
                                "target_lang_word": "görüşme",
                                "target_lang_sense_clarification": "resmi veya iş amaçlı buluşma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预约",
                                "target_lang_sense_clarification": "指与医生、专家或机构的预定会面"
                            },
                            {
                                "target_lang_word": "约定",
                                "target_lang_sense_clarification": "指双方商定好的会面"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cita",
                                "target_lang_sense_clarification": "reunión acordada previamente, especialmente con un profesional"
                            },
                            {
                                "target_lang_word": "compromiso",
                                "target_lang_sense_clarification": "evento o reunión de asistencia obligatoria"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6542c61e-0796-3de4-91f2-3b34703ba05e",
                    "sense_definition": "The act of officially choosing a person for a job or position of responsibility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>appointment</w> as chairman was announced at the meeting yesterday.",
                            "target_lang_translations": {
                                "ru": "О его <w>назначении</w> председателем было объявлено на вчерашнем собрании.",
                                "tr": "Başkan olarak <w>atandığı</w> dünkü toplantıda duyuruldu.",
                                "zh": "他在昨天的会议上被宣布<w>任命</w>为董事长。",
                                "es": "Su <w>nombramiento</w> como presidente fue anunciado en la reunión de ayer."
                            }
                        },
                        {
                            "text": "The committee is responsible for the <w>appointment</w> of new staff members.",
                            "target_lang_translations": {
                                "ru": "Комитет отвечает за <w>назначение</w> новых сотрудников.",
                                "tr": "Komite, yeni personelin <w>atanmasından</w> sorumludur.",
                                "zh": "委员会负责新员工的<w>委任</w>工作。",
                                "es": "El comité es responsable del <w>nombramiento</w> de nuevos miembros del personal."
                            }
                        }
                    ],
                    "synonyms": [
                        "designation"
                    ],
                    "antonyms": [
                        "dismissal"
                    ],
                    "common_phrases": [
                        "letter of appointment",
                        "announce the appointment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт официального выбора или утверждения человека на должность.",
                        "tr": "Bir kişiyi bir işe veya göreve resmi olarak seçme veya atama eylemi.",
                        "zh": "正式选定某人担任某项工作或职务的行为。",
                        "es": "El acto de elegir oficialmente a una persona para un trabajo o puesto de responsabilidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначение",
                                "target_lang_sense_clarification": "на должность"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "в должности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "atama",
                                "target_lang_sense_clarification": "bir göreve getirme"
                            },
                            {
                                "target_lang_word": "tayin",
                                "target_lang_sense_clarification": "resmi görevlendirme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任命",
                                "target_lang_sense_clarification": "指委派某人担任职务"
                            },
                            {
                                "target_lang_word": "委任",
                                "target_lang_sense_clarification": "指正式授予某人职位"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nombramiento",
                                "target_lang_sense_clarification": "acción de designar a alguien para un cargo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "234080d2-0f6b-3f02-a3c8-554dcf127b5c",
                    "sense_definition": "A job or position of responsibility to which someone is chosen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "employment_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She holds a teaching <w>appointment</w> at the local university.",
                            "target_lang_translations": {
                                "ru": "Она занимает преподавательскую <w>должность</w> в местном университете.",
                                "tr": "Yerel üniversitede öğretim <w>görevinde</w> bulunuyor.",
                                "zh": "她在当地大学担任教职<w>职位</w>。",
                                "es": "Ella ocupa un <w>cargo</w> docente en la universidad local."
                            }
                        },
                        {
                            "text": "He decided to resign from his <w>appointment</w> after two years of service.",
                            "target_lang_translations": {
                                "ru": "Он решил уйти со своей <w>должности</w> после двух лет службы.",
                                "tr": "İki yıllık hizmetten sonra <w>görevinden</w> istifa etmeye karar verdi.",
                                "zh": "工作两年后，他决定辞去自己的<w>职务</w>。",
                                "es": "Decidió renunciar a su <w>cargo</w> después de dos años de servicio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold an appointment",
                        "take up an appointment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работа или ответственная должность, на которую выбран человек.",
                        "tr": "Bir kişinin seçildiği iş veya sorumluluk mevkii.",
                        "zh": "某人被选定担任的工作或责任职位。",
                        "es": "Un trabajo o puesto de responsabilidad para el que se elige a alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "должность",
                                "target_lang_sense_clarification": "пост, место работы"
                            },
                            {
                                "target_lang_word": "пост",
                                "target_lang_sense_clarification": "ответственная должность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "görev",
                                "target_lang_sense_clarification": "üstlenilen iş veya sorumluluk"
                            },
                            {
                                "target_lang_word": "makam",
                                "target_lang_sense_clarification": "yüksek veya resmi mevki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "职位",
                                "target_lang_sense_clarification": "指工作岗位或职务"
                            },
                            {
                                "target_lang_word": "职务",
                                "target_lang_sense_clarification": "指承担的责任和工作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cargo",
                                "target_lang_sense_clarification": "puesto de responsabilidad o empleo"
                            },
                            {
                                "target_lang_word": "puesto",
                                "target_lang_sense_clarification": "empleo o posición laboral"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                    "sense_definition": "Equipment, furniture, or furnishings, usually of a house or room.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room had elegant <w>appointments</w> and a beautiful view of the city.",
                            "target_lang_translations": {
                                "ru": "В номере отеля было элегантное <w>убранство</w> и прекрасный вид на город.",
                                "tr": "Otel odası şık bir <w>döşemeye</w> ve güzel bir şehir manzarasına sahipti.",
                                "zh": "酒店房间有着优雅的<w>陈设</w>，还能欣赏到美丽的城市景观。",
                                "es": "La habitación del hotel tenía un <w>mobiliario</w> elegante y una hermosa vista de la ciudad."
                            }
                        },
                        {
                            "text": "We admired the luxurious <w>appointments</w> of the historic cabin.",
                            "target_lang_translations": {
                                "ru": "Мы восхищались роскошной <w>обстановкой</w> исторического домика.",
                                "tr": "Tarihi kulübenin lüks <w>tefrişatına</w> hayran kaldık.",
                                "zh": "我们赞叹于这座历史悠久的小屋那奢华的<w>装潢</w>。",
                                "es": "Admiramos la lujosa <w>decoración</w> de la cabaña histórica."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luxurious appointments"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборудование, мебель или предметы обстановки, обычно в доме или комнате.",
                        "tr": "Bir ev veya odadaki mobilya, donanım veya döşeme gibi eşyalar.",
                        "zh": "通常指房屋或房间内的设备、家具或陈设。",
                        "es": "Equipo, mobiliario o decoración, generalmente de una casa o habitación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убранство",
                                "target_lang_sense_clarification": "интерьер, отделка"
                            },
                            {
                                "target_lang_word": "обстановка",
                                "target_lang_sense_clarification": "мебель и предметы интерьера"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "döşeme",
                                "target_lang_sense_clarification": "iç mekan düzenlemesi"
                            },
                            {
                                "target_lang_word": "tefrişat",
                                "target_lang_sense_clarification": "bir yerin mobilya ve eşyalarla donatılması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陈设",
                                "target_lang_sense_clarification": "指室内摆设的家具和装饰品"
                            },
                            {
                                "target_lang_word": "装潢",
                                "target_lang_sense_clarification": "指室内的装修和布置"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mobiliario",
                                "target_lang_sense_clarification": "conjunto de muebles de una estancia"
                            },
                            {
                                "target_lang_word": "decoración",
                                "target_lang_sense_clarification": "elementos que adornan un espacio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                    "sense_definition": "A decree, direction, or established order.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lived their lives strictly according to divine <w>appointment</w>.",
                            "target_lang_translations": {
                                "ru": "Они жили строго в соответствии с божественным <w>предписанием</w>.",
                                "tr": "Hayatlarını tamamen ilahi <w>takdire</w> uygun şekilde yaşadılar.",
                                "zh": "他们的一生都严格遵循着神圣的<w>天命</w>。",
                                "es": "Vivieron sus vidas estrictamente de acuerdo con el <w>designio</w> divino."
                            }
                        },
                        {
                            "text": "He submitted to the <w>appointment</w> of fate without complaint.",
                            "target_lang_translations": {
                                "ru": "Он безропотно покорился <w>предначертанию</w> судьбы.",
                                "tr": "Kaderin <w>buyruğuna</w> şikayet etmeden boyun eğdi.",
                                "zh": "他毫无怨言地服从了命运的<w>旨意</w>。",
                                "es": "Se sometió al <w>designio</w> del destino sin quejarse."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Указ, предписание или установленный свыше порядок.",
                        "tr": "Bir karar, yönlendirme veya belirlenmiş düzen.",
                        "zh": "法令、指示或既定的秩序，常用于文学或宗教语境。",
                        "es": "Un decreto, dirección u orden establecida, a menudo en un contexto literario o religioso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "указ, веление"
                            },
                            {
                                "target_lang_word": "предначертание",
                                "target_lang_sense_clarification": "судьбы, рока"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "buyruk",
                                "target_lang_sense_clarification": "emir veya talimat"
                            },
                            {
                                "target_lang_word": "takdir",
                                "target_lang_sense_clarification": "kader veya ilahi irade"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天命",
                                "target_lang_sense_clarification": "指命运的安排或神圣的旨意"
                            },
                            {
                                "target_lang_word": "旨意",
                                "target_lang_sense_clarification": "指上级的命令或神圣的意图"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "designio",
                                "target_lang_sense_clarification": "intención o plan, a menudo atribuido al destino"
                            },
                            {
                                "target_lang_word": "precepto",
                                "target_lang_sense_clarification": "orden o mandato establecido"
                            }
                        ]
                    }
                }
            ]
        }
