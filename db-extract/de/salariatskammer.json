                "senses": [
                    {
                        "sense_id": "e04d031b-13f6-3099-bc5b-9131892deae6",
                        "entry_id": "333b1be0-2c62-3246-ba62-890d6c70f6fa",
                        "glosses": [
                            "Berufskammer, die die Interessen der Arbeitnehmerschaft vertritt"
                        ],
                        "tags": [
                            "luxemburgisch"
                        ],
                        "examples": [
                            {
                                "example_id": "91dcd44a-526c-42b2-98cf-e2b9b840ee7c",
                                "sense_id": "e04d031b-13f6-3099-bc5b-9131892deae6",
                                "text": "„Außerdem erfuhr man aus dem Mund vom Präsidenten der Salariatskammer, Jean-Claude Reding, dass die Vorbehalte der Gewerkschaften gegenüber dem Rifkin-Prozess ausgeräumt seien.“"
                            },
                            {
                                "example_id": "95134914-5aa5-44db-b923-cde7eea1b6f4",
                                "sense_id": "e04d031b-13f6-3099-bc5b-9131892deae6",
                                "text": "„Von der Öffentlichkeit fast unbemerkt wurde am Donnerstag auf einem Aktionstag in der Salariatskammer CSL der Grundstein für ein Bündnis zwischen Gewerkschaftsfront und Zivilgesellschaft gelegt.“"
                            },
                            {
                                "example_id": "d9e37f45-b675-4a6e-bff5-da615b4b1950",
                                "sense_id": "e04d031b-13f6-3099-bc5b-9131892deae6",
                                "text": "„In der Salariatskammer ist der LCGB mit 17 Sitzen vertreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
