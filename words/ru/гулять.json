                                "nl": "Bij mooi weer houden we ervan om in het stadspark te <w>wandelen</w>.",
                                "pl": "Przy ładnej pogodzie lubimy <w>spacerować</w> w miejskim parku."
                            }
                        },
                        {
                            "text": "По вечерам соседи выходят <w>гулять</w> со своими собаками.",
                            "target_lang_translations": {
                                "en": "In the evenings, neighbors go out to <w>walk</w> their dogs.",
                                "nl": "’s Avonds gaan de buren <w>wandelen</w> met hun honden.",
                                "pl": "Wieczorami sąsiedzi wychodzą <w>na spacer</w> ze swoimi psami."
                            }
                        }
                    ],
                    "synonyms": [
                        "прогуливаться"
                    ],
                    "common_phrases": [
                        "пойти гулять",
                        "гулять с собакой",
                        "гулять в парке",
                        "гулять пешком"
