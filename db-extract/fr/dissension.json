        "fr-extract.jsonl": [
            {
                "entry_id": "2e4337bf-68e3-38f9-9ca1-99f8032eab72",
                "word": "dissension",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77e2d24b-e46e-4a22-853b-bb27f70a1a97",
                        "entry_id": "2e4337bf-68e3-38f9-9ca1-99f8032eab72",
                        "tags": [
                            "plural"
                        ],
                        "form": "dissensions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                        "entry_id": "2e4337bf-68e3-38f9-9ca1-99f8032eab72",
                        "glosses": [
                            "Dissentiment violent, mais passager, d’opinions, de sentiments, d’intérêts entre deux ou plusieurs personnes."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e51e4575-7fe4-4290-bf02-0fdc8d2938ba",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "Sorcière ou non, il vaut mieux que cette misérable fille meure que de voir Bois-Guilbert perdu pour l’ordre des templiers, ou l’ordre divisé par des dissensions intestines."
                            },
                            {
                                "example_id": "9f25accd-b39d-4909-ac0e-2749d762823c",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "Ce fut pendant son généralat que le jansénisme commença à prendre racine dans cette congrégation, et à y occasionner quelques dissensions intérieures."
                            },
                            {
                                "example_id": "2f95bf74-0f76-4516-a073-a14f6e70f5ff",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "C'est-à-dire : nᵒ 1 Sauf les empoisonnements par adultère, tous les autres uxoricides déterminés par l’adultère et les dissensions domestiques sont diminués après le rétablissement du divorce."
                            },
                            {
                                "example_id": "57e59b0c-2e53-4d36-9aa8-c76b15fd9ee5",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "Nous sommes ici peu de Français, il semble qu'au lieu de provoquer de telles dissensions parmi nous, nous devrions nous entendre…"
                            },
                            {
                                "example_id": "bc577392-51fd-42a7-bca0-7382e896922c",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "Notre esprit d'envie, de méfiance et de dissensions nous empêchera, longtemps encore je le crains, de nous mettre d'accord."
                            },
                            {
                                "example_id": "9c647d71-e59b-416e-a4f4-93c7868967fc",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "La milice qui avait tenté de délivrer Moscou se dispersa à la suite de dissensions intestines."
                            },
                            {
                                "example_id": "6a75bb88-d371-4bc0-9528-5594708739bb",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "Certains amis de papa soutenaient contre lui qu’il fallait tenir l’Angleterre et non l’Allemagne pour notre ennemie héréditaire ; mais leurs dissensions n’allaient pas plus loin."
                            },
                            {
                                "example_id": "aa9cc7ad-3c56-4013-ab5d-1e7d67269106",
                                "sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
                                "text": "En Iran, des influences religieuses préislamiques provoquèrent la dissension théologique et le messianisme révolutionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "618881fc-a20b-474b-9a7e-5f54a6f2f53e",
                        "source_entry_id": "2e4337bf-68e3-38f9-9ca1-99f8032eab72",
                        "source_sense_id": "f227e9c0-1a4b-3293-9c00-1d6fcb3eff8f",
