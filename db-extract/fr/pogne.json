        "fr-extract.jsonl": [
            {
                "entry_id": "7755a7e1-b8ef-372e-bfa8-edb9469f8098",
                "word": "pogne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4558f427-cd12-4f4d-bf14-461bd09a21ce",
                        "entry_id": "7755a7e1-b8ef-372e-bfa8-edb9469f8098",
                        "tags": [
                            "plural"
                        ],
                        "form": "pognes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "962729e9-b2b2-3a00-a95a-33951db7a593",
                        "entry_id": "7755a7e1-b8ef-372e-bfa8-edb9469f8098",
                        "glosses": [
                            "Poing."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "66a21700-6071-4da2-95bb-91e518fc8c02",
                                "sense_id": "962729e9-b2b2-3a00-a95a-33951db7a593",
                                "text": "Il le tenait, serré, dans sa pogne."
                            },
                            {
                                "example_id": "fba1902f-fb9b-4594-85a0-00eeb1024e65",
                                "sense_id": "962729e9-b2b2-3a00-a95a-33951db7a593",
                                "text": "Le bonhomme saignait du nez, après avoir pris un coup de pogne en pleine face..."
                            }
                        ]
                    },
                    {
                        "sense_id": "171f57c7-ede3-341d-9453-6ea19e02c065",
                        "entry_id": "7755a7e1-b8ef-372e-bfa8-edb9469f8098",
                        "glosses": [
                            "Main."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8d10663c-98fa-4ecb-8142-986a8d5167b2",
                                "sense_id": "171f57c7-ede3-341d-9453-6ea19e02c065",
                                "text": "Tu as le journal sous la pogne ?"
                            },
                            {
                                "example_id": "46196e74-2fe7-475c-919f-d50b5befdf75",
                                "sense_id": "171f57c7-ede3-341d-9453-6ea19e02c065",
                                "text": "— Allez on met les adjas. Donne ta paluche.\n— Ma quoi ?\n— Tes crayons. Tes torcheculs. Oh, ta pogne, quoi."
                            },
                            {
                                "example_id": "49dcc345-702d-4a9b-99de-4dc53581c882",
                                "sense_id": "171f57c7-ede3-341d-9453-6ea19e02c065",
                                "text": "Son sort entre mes mains, qu’elle m’avait lancé… C’est autre chose que son sort, que j’aurais aimé avoir entre les pognes."
                            },
                            {
                                "example_id": "dc35ec03-d32c-4053-9266-bfc864adcc1d",
                                "sense_id": "171f57c7-ede3-341d-9453-6ea19e02c065",
                                "text": "— Je dois combien ?\n— Douze euros-yens.\n— Douze ?! Eh bien, dites donc, il y en a qui gagnent bien leur vie… Ça vous serre la pogne et ça a gagné douze euros."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d21613b-74c3-30ee-9aa7-5724d74ed1c6",
                        "entry_id": "7755a7e1-b8ef-372e-bfa8-edb9469f8098",
                        "glosses": [
                            "Poigne."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3f2bb8d6-b3c9-4ef9-a74a-9ab1cead8af5",
                                "sense_id": "6d21613b-74c3-30ee-9aa7-5724d74ed1c6",
                                "text": "Quant à Gabin, il a plus l'air de descendre de la Courtille que du Golgotha, mais il s'en lave les pognes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
