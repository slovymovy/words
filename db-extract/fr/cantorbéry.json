                        "sense_id": "3c4858e2-8ff8-3822-b025-2bbac94d9278",
                        "entry_id": "e0185173-8f63-3b7f-aae7-56c5a8d77a83",
                        "glosses": [
                            "Ville, district et cité d’Angleterre situé dans le comté du Kent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0697ef-d85f-4d27-b319-e33f3b4bbd76",
                                "sense_id": "3c4858e2-8ff8-3822-b025-2bbac94d9278",
                                "text": "Le Cilicien fut envoyé de Rome à Cantorbéry, sous la tutelle d’un guide africain."
                            },
                            {
                                "example_id": "ea4cb0a4-976a-47c8-acc1-f05015a9efe1",
                                "sense_id": "3c4858e2-8ff8-3822-b025-2bbac94d9278",
                                "text": "À 11 h 30, l’archevêque de Cantorbéry, précédé du porte-croix et suivi du doyen de Westminster, se rend à la porte Est pour recevoir le cercueil."
                            },
                            {
                                "example_id": "446be61f-0d10-4f90-9fb4-95c5cd991878",
                                "sense_id": "3c4858e2-8ff8-3822-b025-2bbac94d9278",
                                "text": "D'autre part, Henri II entre en conflit ouvert avec Thomas Becket, son ancien chancelier, consacré archevêque de Cantorbéry en 1162."
                            }
                        ]
                    }
