                "senses": [
                    {
                        "sense_id": "16609873-c890-34e4-9a89-be55b9c70055",
                        "entry_id": "128253fc-f42d-31e5-847f-6228edec45a6",
                        "glosses": [
                            "gas bestaande uit N₂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ae6184-245c-4b38-867d-1dff33ef325e",
                                "sense_id": "16609873-c890-34e4-9a89-be55b9c70055",
                                "text": "Mike Jetten is hoogleraar microbiologie aan de Radboud Universiteit Nijmegen. Hij toonde aan dat bepaalde bacteriën energie halen uit chemische reacties die voorheen als onmogelijk waren bestempeld. Zo zet de anammox-bacterie zonder zuurstof het schadelijke ammonium samen met nitriet om in stikstofgas en water. De helft van alle stikstof in de atmosfeer wordt op deze manier gemaakt."
                            },
                            {
                                "example_id": "92632755-cc6e-4f83-bcba-65c849826b23",
                                "sense_id": "16609873-c890-34e4-9a89-be55b9c70055",
                                "text": "Het is niet duidelijk hoe het ongeluk heeft kunnen gebeuren. Mogelijk is er stikstofgas vrijgekomen; dat wordt in sommige kerncentrales gebruikt om oxidatie van de brandstofkernen tegen te gaan."
                            }
                        ]
                    }
