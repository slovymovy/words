                        "cross_references": [
                            {
                                "target_word": "antiferromagnetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43cee8ab-c208-355e-af1a-e6ab42c5b134",
                                        "entry_id": "c8791c8d-c112-361e-a27b-f5d1ade1278d",
                                        "glosses": [
                                            "unterhalb einer bestimmten Temperatur und ohne ein äußeres Magnetfeld keine magnetische Polarisation aufweisend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577bd8bb-18d3-4562-a21b-be696ef963ed",
                                                "sense_id": "43cee8ab-c208-355e-af1a-e6ab42c5b134",
                                                "text": "„Antiferromagnetische Strukturen […] lassen sich sehr viel dichter nebeneinander platzieren, da sie äußerlich magnetisch neutral sind – der Schlüssel für den neuen Nanospeicher.“"
                                            }
