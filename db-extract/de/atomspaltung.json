                "senses": [
                    {
                        "sense_id": "ac90feb1-fe92-3add-890a-b68f2709e4f6",
                        "entry_id": "1a9c05c8-fb7c-360d-8e7d-fdeeaafe13fb",
                        "glosses": [
                            "Zerteilung eines Atomkernes unter Freisetzung von Energie"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "ed5faac7-3879-436f-a2e8-83e2eecc8d57",
                                "sense_id": "ac90feb1-fe92-3add-890a-b68f2709e4f6",
                                "text": "„Genau besehen, sind Solarkraftwerke gewöhnliche Dampfkraftwerke – mit dem einen Unterschied, dass die für die Dampferzeugung nötige Hitze nicht durch Verbrennung von Kohle, Gas oder Öl erzeugt wird oder durch Atomspaltung, sondern durch die Bündelung von Sonnenstrahlung.“"
                            },
                            {
                                "example_id": "5368cf4f-d651-47ee-8006-c3b602b0b2be",
                                "sense_id": "ac90feb1-fe92-3add-890a-b68f2709e4f6",
                                "text": "„Wie damals in der Pariser Ausstellung waren die wissenschaftlichen Methoden der Atomspaltung auf Körper und Gefühle übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
