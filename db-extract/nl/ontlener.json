                "senses": [
                    {
                        "sense_id": "08a33dbe-0559-3318-aff4-16d1801de2d1",
                        "entry_id": "ad09eeb5-6d53-375c-8a32-1b0cb7226d9f",
                        "glosses": [
                            "iemand die geld ontvangt als lening; iemand die iets te leen krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c465a30b-73ca-4358-83cc-28cb6c05971f",
                                "sense_id": "08a33dbe-0559-3318-aff4-16d1801de2d1",
                                "text": "Voor mij als Hollander is het feit dat ontlener en lener synoniemen zijn, zeer verwarrend."
                            },
                            {
                                "example_id": "108953db-5894-46d6-936a-8e37c879d973",
                                "sense_id": "08a33dbe-0559-3318-aff4-16d1801de2d1",
                                "text": "Karel Van Eetvelt van de bankenfederatie Febelfin nuanceert de oplopende risico's. Volgens hem kan niet iedereen 80 procent of meer ontlenen voor de aankoop van een woning. De terugbetalingscapaciteit van de ontleners is belangrijk. Van Eetvelt wijst er op dat het aantal woonkredieten die voor problemen zorgen, historisch laag is."
                            },
                            {
                                "example_id": "a6696b7d-c71a-4ff4-9fb5-a33ab15f8519",
                                "sense_id": "08a33dbe-0559-3318-aff4-16d1801de2d1",
                                "text": "‘Het is een geweldig initiatief’, zegt Marijke Bosschaerts uit Hasselt, die samen met haar zoontje Amauryc Coenen naar Diepenbeek afzakte en zo de allereerste ontlener is. ‘Het aanbod is divers. Hier gaan we heel zeker een fietsje vinden dat Amauryc kan gebruiken. Ik hoop alleen dat de tweewieler van zijn keuze ook in de autokoffer past.’"
                            }
                        ]
                    }
