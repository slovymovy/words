                "senses": [
                    {
                        "sense_id": "3cbfb5fd-4ff3-3e46-8fb6-d3497b771c7a",
                        "entry_id": "bf35064a-abf7-3e62-95e7-c99f8d963bbd",
                        "glosses": [
                            "Faire perdre son caractère ému ou émotionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe63403c-22f9-4968-943e-4acad7b3c1c9",
                                "sense_id": "3cbfb5fd-4ff3-3e46-8fb6-d3497b771c7a",
                                "text": "Cette reprise réflexive permet de réduire l’affect spontané qui naît dans l’interaction. Comme un consultant le disait joliment, « ça désémotionne le monde »."
                            },
                            {
                                "example_id": "80eece2d-52d3-462b-97aa-8164acbfe0b2",
                                "sense_id": "3cbfb5fd-4ff3-3e46-8fb6-d3497b771c7a",
                                "text": "\"François Hollande parle avec une parole politique et la parole politique c’est une parole 'désémotionnée'\", a déclaré à l’AFP Anne Mansouret, vice-présidente PS du conseil général de l'Eure."
                            },
                            {
                                "example_id": "cfb446f7-f9b7-4f2d-868a-e3d35c71210a",
                                "sense_id": "3cbfb5fd-4ff3-3e46-8fb6-d3497b771c7a",
                                "text": "À un regard interrogatif de la comtesse Kromatyr : « Je me désémotionne », répond la charmante enfant."
                            }
                        ]
                    }
                ],
