                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cfff5f3-3a8a-3fee-9eee-1db40cf4de69",
                        "entry_id": "e83dcec0-10e3-3337-a213-be9705bc4858",
                        "glosses": [
                            "Spieler oder Anhänger eines Sportvereins mit dem Namensbestandteil ‚Borussia‘"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8a6e18-2b19-4493-90e2-6ab29e8501d4",
                                "sense_id": "3cfff5f3-3a8a-3fee-9eee-1db40cf4de69",
                                "text": "„Der Borusse kam als letzter deutscher Einwechselspieler für den Dortmunder Mario Götze in die Partie und absolvierte damit erstmals ein A-Länderspiel.“"
                            },
                            {
                                "example_id": "eadb5887-1efa-4aed-b856-495c80d86709",
                                "sense_id": "3cfff5f3-3a8a-3fee-9eee-1db40cf4de69",
                                "text": "„Kaum ein aktiver Fußballprofi ist wohl gleichzeitig auch so sehr Fan wie der Ur-Borusse.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "95bb16bb-447e-321e-947d-37f0784202cd",
                        "entry_id": "e83dcec0-10e3-3337-a213-be9705bc4858",
                        "glosses": [
                            "Mitglied einer Studentenverbindung mit dem Namensbestandteil ‚Borussia‘"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f208a5-4feb-4cf6-86b5-0bd1844af92b",
                                "sense_id": "95bb16bb-447e-321e-947d-37f0784202cd",
                                "text": "„[…] im Hause des bayerischen Gesandten Lerchenfeld, der wie der Kaiser und Herbert Bismarck «Bonner Borusse» war […]“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
