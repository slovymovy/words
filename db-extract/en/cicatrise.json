                                        "sense_id": "b222a0c4-ddda-3b96-9556-a9d8310625cc",
                                        "entry_id": "7d381061-0a33-3432-9dad-67ca7fc72187",
                                        "glosses": [
                                            "заживать, образуя рубец (о ранах, язвах и т.п.)"
