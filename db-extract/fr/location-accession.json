                        "glosses": [
                            "Mécanisme permettant de louer un logement avec la possibilité, prévue dès le départ, de décider de l’acheter par la suite en tenant compte des loyers déjà versés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722bf3e6-81d2-46ee-bc23-b48e98eeec23",
                                "sense_id": "1d3acace-7633-3f8e-a327-2c50aed5d0ec",
                                "text": "La « location-accession », ou « accession progressive », permet de louer son bien avant de l’acheter."
                            },
                            {
                                "example_id": "c74720a7-20c8-461e-b575-2a400ae30505",
                                "sense_id": "1d3acace-7633-3f8e-a327-2c50aed5d0ec",
                                "text": "Le mécanisme de la location-accession permet à des ménages d’acquérir un logement (avec ou sans apport personnel) pour l’occuper à titre de résidence principale."
                            },
                            {
                                "example_id": "f81abba5-1331-4b53-9bc1-a1c17f8a3fb0",
                                "sense_id": "1d3acace-7633-3f8e-a327-2c50aed5d0ec",
                                "text": "La location-accession permet à un locataire d’acquérir progressivement un logement, qui à terme peut déboucher sur une option d’achat ou non."
                            }
                        ]
                    }
