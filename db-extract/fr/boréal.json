                        "sense_id": "29810b40-d822-3b2f-8064-f66246ac0883",
                        "entry_id": "1a0147f8-beab-3af9-8948-d5904ee9053f",
                        "glosses": [
                            "Qui est ou qui se montre du côté du pôle Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5731e0f5-a985-4c51-9c63-9a9e65a5a275",
                                "sense_id": "29810b40-d822-3b2f-8064-f66246ac0883",
                                "text": "La calotte glaciaire de l’Europe s’est réfugiée en Scandinavie avec son cortège de plantes boréales."
                            },
                            {
                                "example_id": "a6c5e229-6a62-4dc4-acd1-b7cf72730087",
                                "sense_id": "29810b40-d822-3b2f-8064-f66246ac0883",
                                "text": "Ajoutons que la présence de Crépis paludosa donne à notre association sous-vosgienne un certain caractère boréal."
                            },
                            {
                                "example_id": "06812c61-0dcd-413c-8e4f-c67c596b1805",
                                "sense_id": "29810b40-d822-3b2f-8064-f66246ac0883",
                                "text": "Étant donné la position actuelle de Mars dans le cycle de précession orbitale, les hivers austraux sont plus longs que les hivers boréaux."
                            }
                        ]
                    },
