{
    "word_family": [
        "floodlight",
        "floodwater",
        "floodgate",
        "floodplain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                    "sense_definition": "An overflow of a large amount of water beyond its normal limits, especially over what is normally dry land.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_overflow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain caused a severe <w>flood</w> in the valley.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь вызвал сильное <w>наводнение</w> в долине.",
                                "zh": "大雨导致山谷中发生了严重的<w>洪水</w>。"
                            }
                        },
                        {
                            "text": "Many people lost their homes during the disastrous <w>flood</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди потеряли свои дома во время разрушительного <w>наводнения</w>.",
                                "zh": "许多人在那场灾难性的<w>洪水</w>中失去了家园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deluge",
                        "overflow",
                        "inundation"
                    ],
                    "common_phrases": [
                        "flash flood",
                        "in flood",
                        "flood warning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выход большого количества воды из берегов, затопление суши.",
                        "zh": "大量水流溢出正常范围，淹没通常干燥的陆地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводне́ние",
                                "target_lang_sense_clarification": "стихийное бедствие"
                            },
                            {
                                "target_lang_word": "пото́п",
                                "target_lang_sense_clarification": "разговорное или катастрофическое"
                            },
                            {
                                "target_lang_word": "па́водок",
                                "target_lang_sense_clarification": "сезонное поднятие уровня воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洪水",
                                "target_lang_sense_clarification": "自然灾害"
                            },
                            {
                                "target_lang_word": "水灾",
                                "target_lang_sense_clarification": "灾害性事件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cbfb86-7382-3830-a684-2cd002c905cc",
                    "sense_definition": "A large number or quantity of things appearing or happening suddenly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "large_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We received a <w>flood</w> of complaints after the policy change.",
                            "target_lang_translations": {
                                "ru": "Мы получили <w>поток</w> жалоб после изменения политики.",
                                "zh": "政策变更后，我们收到了<w>潮水般</w>的投诉。"
                            }
                        },
                        {
                            "text": "She felt a sudden <w>flood</w> of relief when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>прилив</w> облегчения, когда услышала новости.",
                                "zh": "听到这个消息时，她感到一阵<w>涌现</w>的宽慰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deluge"
                    ],
                    "common_phrases": [
                        "flood of tears",
                        "flood of complaints",
                        "flood of relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество чего-либо, появляющееся или происходящее внезапно.",
                        "zh": "突然出现或发生的大量事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пото́к",
                                "target_lang_sense_clarification": "непрерывное движение множества"
                            },
                            {
                                "target_lang_word": "наплы́в",
                                "target_lang_sense_clarification": "внезапное появление множества людей или вещей"
                            },
                            {
                                "target_lang_word": "прили́в",
                                "target_lang_sense_clarification": "о чувствах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌现",
                                "target_lang_sense_clarification": "大量出现"
                            },
                            {
                                "target_lang_word": "潮水般",
                                "target_lang_sense_clarification": "形容数量巨大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0979bb17-ce21-39c2-bf9f-e097804e88e0",
                    "sense_definition": "The incoming or rising tide.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship will be able to sail on the <w>flood</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль сможет плыть по <w>приливу</w>.",
                                "zh": "船可以趁着<w>涨潮</w>航行。"
                            }
                        },
                        {
                            "text": "We waited for the <w>flood</w> to lift the boat off the sandbank.",
                            "target_lang_translations": {
                                "ru": "Мы ждали <w>прилива</w>, чтобы снять лодку с отмели.",
                                "zh": "我们等待<w>涨潮</w>将船从沙洲上托起。"
                            }
                        }
                    ],
                    "antonyms": [
                        "drain"
                    ],
                    "common_phrases": [
                        "flood tide",
                        "ebb and flood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилив; поднимающийся уровень воды в море или реке.",
                        "zh": "海水上涨的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прили́в",
                                "target_lang_sense_clarification": "поднятие уровня воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涨潮",
                                "target_lang_sense_clarification": "水位上升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9df510aa-c76b-317e-a2c2-b96e342a3ad2",
                    "sense_definition": "A floodlight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They turned on the <w>floods</w> to illuminate the stadium.",
                            "target_lang_translations": {
                                "ru": "Они включили <w>прожекторы</w>, чтобы осветить стадион.",
                                "zh": "他们打开了<w>泛光灯</w>来照亮体育场。"
                            }
                        },
                        {
                            "text": "The actor stepped out from the shadows into the glare of the <w>floods</w>.",
                            "target_lang_translations": {
                                "ru": "Актёр вышел из тени в яркий свет <w>прожекторов</w>.",
                                "zh": "演员从阴影中走出，步入<w>探照灯</w>的强光中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for floodlight"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прожектор; мощная лампа заливающего света.",
                        "zh": "一种强力照明灯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проже́ктор",
                                "target_lang_sense_clarification": "осветительный прибор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泛光灯",
                                "target_lang_sense_clarification": "照明设备"
                            },
                            {
                                "target_lang_word": "探照灯",
                                "target_lang_sense_clarification": "强光照明"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc4c8225-6114-379b-bd20-1bf94582adf9",
                    "sense_definition": "To cover or become covered with water, especially in a way that causes problems.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_overflow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river <w>flooded</w> the town after the storm.",
                            "target_lang_translations": {
                                "ru": "Река <w>затопила</w> город после шторма.",
                                "zh": "暴风雨过后，河水<w>淹没</w>了城镇。"
                            }
                        },
                        {
                            "text": "Our basement <w>flooded</w> with rainwater during the night.",
                            "target_lang_translations": {
                                "ru": "Наш подвал <w>затопило</w> дождевой водой ночью.",
                                "zh": "夜里，雨水<w>淹没</w>了我们的地下室。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inundate",
                        "swamp",
                        "deluge",
                        "submerge",
                        "overflow"
                    ],
                    "antonyms": [
                        "drain"
                    ],
                    "common_phrases": [
                        "flood the engine",
                        "river flooded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затапливать; покрывать водой (особенно о стихийном бедствии).",
                        "zh": "被水覆盖，通常指造成破坏的淹没。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затопи́ть",
                                "target_lang_sense_clarification": "покрыть водой"
                            },
                            {
                                "target_lang_word": "вы́йти из берего́в",
                                "target_lang_sense_clarification": "о реке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淹没",
                                "target_lang_sense_clarification": "被水覆盖"
                            },
                            {
                                "target_lang_word": "泛滥",
                                "target_lang_sense_clarification": "河水溢出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec4cfa6b-4c4e-3c9a-adb1-8835be216bc5",
                    "sense_definition": "To arrive or overwhelm in large numbers or quantities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "large_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cheap imports have <w>flooded</w> the market in recent years.",
                            "target_lang_translations": {
                                "ru": "Дешёвый импорт <w>наводнил</w> рынок в последние годы.",
                                "zh": "近年来，廉价进口商品<w>充斥</w>了市场。"
                            }
                        },
                        {
                            "text": "Donations <w>flooded</w> in to help the victims of the disaster.",
                            "target_lang_translations": {
                                "ru": "Пожертвования <w>хлынули</w> потоком, чтобы помочь жертвам катастрофы.",
                                "zh": "捐款<w>涌入</w>，以帮助灾民。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overfill",
                        "inundate",
                        "swamp",
                        "deluge"
                    ],
                    "common_phrases": [
                        "flood the market",
                        "flood in",
                        "flood with requests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наводнять; заполнять собой в огромном количестве.",
                        "zh": "大量涌入或充斥某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводни́ть",
                                "target_lang_sense_clarification": "заполнить рынок или пространство"
                            },
                            {
                                "target_lang_word": "хлы́нуть",
                                "target_lang_sense_clarification": "поступать потоком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充斥",
                                "target_lang_sense_clarification": "充满"
                            },
                            {
                                "target_lang_word": "涌入",
                                "target_lang_sense_clarification": "大量进入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ef1551e-148c-378d-8c8b-0d427003127c",
                    "sense_definition": "To fill or cover something completely, often with light or sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fill_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morning sunlight <w>flooded</w> the bedroom when she opened the curtains.",
                            "target_lang_translations": {
                                "ru": "Утренний солнечный свет <w>залил</w> спальню, когда она открыла шторы.",
                                "zh": "她拉开窗帘时，晨光<w>洒满</w>了卧室。"
                            }
                        },
                        {
                            "text": "The stage was <w>flooded</w> with blue light for the final scene.",
                            "target_lang_translations": {
                                "ru": "Сцена была <w>залита</w> синим светом для финальной сцены.",
                                "zh": "最后一幕时，舞台被蓝光<w>充盈</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flood with light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заливать; наполнять пространство (светом, звуком).",
                        "zh": "完全充满或覆盖某空间（常指光线或声音）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зали́ть",
                                "target_lang_sense_clarification": "осветить или наполнить"
                            },
                            {
                                "target_lang_word": "озари́ть",
                                "target_lang_sense_clarification": "осветить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洒满",
                                "target_lang_sense_clarification": "光线覆盖"
                            },
                            {
                                "target_lang_word": "充盈",
                                "target_lang_sense_clarification": "充满空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b37bb6b-0d57-3b37-8f42-99b2483d21a1",
                    "sense_definition": "To send a large volume of messages or data rapidly, disrupting communication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hacker <w>flooded</w> the server with useless requests.",
                            "target_lang_translations": {
                                "ru": "Хакер <w>завалил</w> сервер бесполезными запросами.",
                                "zh": "黑客用无用的请求<w>轰炸</w>了服务器。"
                            }
                        },
                        {
                            "text": "Please do not <w>flood</w> the chat room with repetitive messages.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>флудите</w> в чате повторяющимися сообщениями.",
                                "zh": "请不要在聊天室里<w>刷屏</w>发送重复信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spam"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet/technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Флудить; отправлять массовые сообщения, мешая общению или работе сети.",
                        "zh": "快速发送大量信息或数据，干扰通信。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флуди́ть",
                                "target_lang_sense_clarification": "сленг, писать бессмысленные сообщения"
                            },
                            {
                                "target_lang_word": "зава́ливать",
                                "target_lang_sense_clarification": "перегружать запросами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刷屏",
                                "target_lang_sense_clarification": "网络用语"
                            },
                            {
                                "target_lang_word": "轰炸",
                                "target_lang_sense_clarification": "大量发送信息"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "26bd9bad-95d5-35a3-aba0-1cdd23edd166",
                    "sense_definition": "The great deluge described in the Book of Genesis in the Hebrew Bible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Noah built a large ark to survive the <w>Flood</w>.",
                            "target_lang_translations": {
                                "ru": "Ной построил большой ковчег, чтобы пережить <w>Потоп</w>.",
                                "zh": "诺亚建造了一艘大方舟以度过<w>大洪水</w>。"
                            }
                        },
                        {
                            "text": "Many ancient cultures have myths about a great <w>Flood</w>.",
                            "target_lang_translations": {
                                "ru": "У многих древних культур есть мифы о великом <w>Потопе</w>.",
                                "zh": "许多古老文化中都有关于<w>大洪水</w>的神话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Deluge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всемирный потоп (библейское событие).",
                        "zh": "《圣经》中记载的毁灭世界的洪水。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пото́п",
                                "target_lang_sense_clarification": "библейское событие"
                            },
                            {
                                "target_lang_word": "Всеми́рный пото́п",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大洪水",
                                "target_lang_sense_clarification": "宗教典故"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e6a4d10-80cd-3562-86a1-03aba8fb7524",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Floods</w> has lived in this neighborhood for fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фладс</w> живёт в этом районе пятьдесят лет.",
                                "zh": "<w>弗拉兹</w>先生在这个社区住了五十年了。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Floods</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У меня приём у доктора <w>Фладса</w> завтра утром.",
                                "zh": "我明天早上和<w>弗拉兹</w>医生有预约。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фладс",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弗拉兹",
                                "target_lang_sense_clarification": "音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}