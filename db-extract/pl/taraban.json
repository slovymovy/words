                "senses": [
                    {
                        "sense_id": "a5a3c0c3-add9-3a6c-86b9-32bac05cc25d",
                        "entry_id": "170fa379-babc-3276-8412-368ea7cfcad1",
                        "glosses": [
                            "walcowaty bęben używany przez wojsko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742c1b97-601b-449d-8953-c050c1934134",
                                "sense_id": "a5a3c0c3-add9-3a6c-86b9-32bac05cc25d",
                                "text": "Zaś co pewien czas maszerowały przez Rynek bojowe kolumny wojsk, wychodzących w pole przy grzmiącej muzyce trąb, piszczałek, suchym warkocie tarabanów i wrzasku pauprów i pospólstwa, wieszającego się po bokach."
                            },
                            {
                                "example_id": "3c564363-92ce-4313-b354-85e498d5cb48",
                                "sense_id": "a5a3c0c3-add9-3a6c-86b9-32bac05cc25d",
                                "text": "Już tam ociec do swej Basi mówi zapłakany: „słuchaj jeno, pono nasi biją w tarabany."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
