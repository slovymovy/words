        "fr-extract.jsonl": [
            {
                "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                "word": "camail",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c21ef0ee-d7e5-4356-855c-eb50efe11463",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "tags": [
                            "plural"
                        ],
                        "form": "camails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "117fe45a-565a-3553-9c6f-47abb3acabaa",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Sorte de petit manteau qui couvre depuis les épaules jusqu’à la ceinture et que les évêques et autres ecclésiastiques privilégiés portent par-dessus le rochet dans les cérémonies. → voir mosette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f45e42e-fa00-4b0b-b48b-d2bc722cd285",
                                "sense_id": "117fe45a-565a-3553-9c6f-47abb3acabaa",
                                "text": "Il portait négligemment sur ses épaules courbées un long camail de velours rouge, et sa robe traînait sur ses pieds."
                            },
                            {
                                "example_id": "d84e64c9-00b0-4688-a92e-f067498902b6",
                                "sense_id": "117fe45a-565a-3553-9c6f-47abb3acabaa",
                                "text": "Il marmotta des oraisons tant que dura la nuit, sans décroiser un moment ses bras de son camail de soie violette, sans obliquer un regard vers moi, sa postérité, […]"
                            },
                            {
                                "example_id": "ee5f68ae-4d99-495f-80c2-98e88ce280ec",
                                "sense_id": "117fe45a-565a-3553-9c6f-47abb3acabaa",
                                "text": "Mollement drapé d’un camail de nuées grises, le crépuscule déroulait ses brumeuses tentures sur la pourpre fondante d’un soleil couchant."
                            },
                            {
                                "example_id": "b98997ff-b40a-4955-82bc-f21074f05071",
                                "sense_id": "117fe45a-565a-3553-9c6f-47abb3acabaa",
                                "text": "Elle avait bien changé, Mme Rezeau, depuis l'époque des précepteurs en camail et de la confession familiale."
                            }
                        ]
                    },
                    {
                        "sense_id": "a18e4434-f36d-3dc6-bc7a-e9d21608c72d",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Collet avec capuchon que le clergé porte en hiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af06968-39e3-4428-9e52-6aa934ab3307",
                                "sense_id": "a18e4434-f36d-3dc6-bc7a-e9d21608c72d",
                                "text": "Le dos rond sous le camail, il me précède dans le couloir qui fait communiquer la cure et la sacristie."
                            }
                        ]
                    },
                    {
                        "sense_id": "db4bc5ad-2fe5-319f-95a2-ac4bf17027ea",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Camail d’armure : pièce d’armement protégeant le cou et le haut des épaules. Le terme camail est souvent utilisé à tort pour désigner la coiffe de maille qui protège également la tête."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "38d28f5a-aa9b-3d77-a577-9cadc892c604",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Lambrequin, décoration de casque ^([2])."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f023d180-f6f7-3abb-8043-b02e2ab74c38",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Longues plumes du cou et de la poitrine, chez le coq."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2488133-7951-4865-99d5-da8604d64dda",
                                "sense_id": "f023d180-f6f7-3abb-8043-b02e2ab74c38",
                                "text": "Si le Coq de Java diffère des autres Coqs par sa crête et par son fanon sous-mandibulaire, le Coq de Sonnerat ne s'en écarte pas moins par une singularité très curieuse des plumes de son camail."
                            },
                            {
                                "example_id": "39964d88-1c78-4ec7-b490-065b8e26c6a7",
                                "sense_id": "f023d180-f6f7-3abb-8043-b02e2ab74c38",
                                "text": "Tenez, il me suffit d’un coup d’œil au coq de Barye qui parade chez moi, fier de son camail, sur la table où je prends mon café, pour me retrouver place d’Aligre où, vers 1920, le dimanche matin, les marchands de choux-fleurs cédaient la place aux brocanteurs"
                            }
                        ]
                    },
                    {
                        "sense_id": "22880fac-19f1-3b95-b04a-7bd7763e34b2",
                        "entry_id": "5657c6f0-4492-3308-b655-a5536bd57cbc",
                        "glosses": [
                            "Espèce de tangara de Guyane ^([2])."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": []
                    }
