                    {
                        "sense_id": "50db4466-8972-3752-83d1-abb93497668a",
                        "entry_id": "46dc8cda-16e1-3fb7-aa29-5c94a4a0a989",
                        "glosses": [
                            "de regentijd in tropische gebieden met een droge tijd en een regentijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdde025e-dd77-4a7d-af30-43c5634ab033",
                                "sense_id": "50db4466-8972-3752-83d1-abb93497668a",
                                "text": "Het uitblijven van de moesson luidt een tijd van schaarste in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14af72ae-ffde-4441-bf30-682d05c95e44",
                        "source_entry_id": "46dc8cda-16e1-3fb7-aa29-5c94a4a0a989",
                        "source_sense_id": "50db4466-8972-3752-83d1-abb93497668a",
                        "source_sense_description": "de regentijd in tropische gebieden met een droge tijd en een regentijd",
                        "target_lang_word": "Monsun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monsun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                        "entry_id": "357430a6-1448-3fd3-8810-872f6a14243d",
                                        "glosses": [
                                            "immer wiederkehrendes, feuchtes (im Sommer) bzw. trockenes (im Winter) Windsystem, das starken Einfluss auf das Klima der Subtropen (Rossbreiten) hat, weniger in den Tropen (am Äquator), weil hier der jahreszeitliche Temperaturunterschied zu gering ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871e9740-d0f3-4bdb-899e-a3444f1bece4",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Viele Monsune haben eine starke wirtschaftliche Bedeutung für einzelne Länder."
                                            },
                                            {
                                                "example_id": "5cf8b5ab-de76-4a47-8e1d-f1361026fe7f",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Monsune ändern nur alle halben Jahre ihre Richtung."
                                            },
                                            {
                                                "example_id": "89837fc7-1cfd-47ea-a4c1-d2be83a7748e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Nachdem der Monsun immer wieder Flutwellen in die Bucht getrieben hatte, musste ein Teil Victorias versetzt werden.“"
                                            },
                                            {
                                                "example_id": "bdd6f029-2db7-4d34-b83d-d7786339b18e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Er musste dabei den Stand der Ernte unter den Bedingungen des Monsuns beurteilen, die einmal besser, einmal schlechter sein konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cad96b46-d3bd-4381-8a74-738b78e26aa7",
                        "source_entry_id": "46dc8cda-16e1-3fb7-aa29-5c94a4a0a989",
