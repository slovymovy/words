                "senses": [
                    {
                        "sense_id": "f8ad7e7f-a030-31a3-a233-2bb7d0ebcf07",
                        "entry_id": "5c12fb65-3803-3148-843c-9be00d7dd671",
                        "glosses": [
                            "церк., разг. то же, что заговенье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9655917-5140-49d3-9be7-2678fa2a22c5",
                                "sense_id": "f8ad7e7f-a030-31a3-a233-2bb7d0ebcf07",
                                "text": "Возвратясь домой, я нашёл хозяев моих, празднующих заговены."
                            },
                            {
                                "example_id": "7c55ab44-5e0d-46ad-89ef-c6330d58a21b",
                                "sense_id": "f8ad7e7f-a030-31a3-a233-2bb7d0ebcf07",
                                "text": "Говядина и баранина 20 коп. фунт продолжалась цене до заговен."
                            },
                            {
                                "example_id": "cacc33ed-213e-4818-ab7f-f3d0882f48fc",
                                "sense_id": "f8ad7e7f-a030-31a3-a233-2bb7d0ebcf07",
                                "text": "Михайловых наместников выгнали; тверских гостей, случившихся в Торжке, ограбили, некоторых убили и принялись деятельно укреплять город, — это случилось перед заговенами на Петров пост, в 1372 году."
                            }
                        ]
                    }
