                                        "entry_id": "02b1227b-8599-3a6d-8c3a-eb1293f6409b",
                                        "glosses": [
                                            "(nom UICPA) Hydrocarbure insaturé de formule semi-développée CH₂ = _(CH)2, le plus simple des alcènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9b904e-cf68-4dfb-ab9b-5a1c24371ed0",
                                                "sense_id": "503c33a9-4dad-31ff-86b2-585b06857261",
                                                "text": "On préfère cependant utiliser le groupe éthène par référence au monomère qui a permis de synthétiser ce polymère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
