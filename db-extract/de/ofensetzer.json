                        "sense_id": "7bf02532-1482-3414-8907-6adfe790a234",
                        "entry_id": "ff527e75-f5d7-307b-bfd2-ae47be8f35ce",
                        "glosses": [
                            "Handwerker, der einen Heizofen bauen, installieren und warten kann"
                        ],
                        "tags": [
                            "Berufsbild"
                        ],
                        "examples": [
                            {
                                "example_id": "877c813a-c9ba-44f1-a613-2c3537f67ae1",
                                "sense_id": "7bf02532-1482-3414-8907-6adfe790a234",
                                "text": "„Handwerker, wie zum Beispiel Ofensetzer, besaßen spezielle Dreirad-Gefährte für ihre Utensilien.“"
                            },
                            {
                                "example_id": "348ccd8f-428a-445a-b211-afd61ae4f520",
                                "sense_id": "7bf02532-1482-3414-8907-6adfe790a234",
                                "text": "„Der umgangssprachlich noch verwendete Name ›Hafnerzell‹ (Hafner: süddeutsch und österreichisch für Töpfer oder Ofensetzer) verweist auf die Bedeutung, die Obernzell im Mittelalter hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
