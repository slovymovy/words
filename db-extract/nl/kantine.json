                    {
                        "translation_id": "29941aa9-7bd7-49e6-a20e-e2900653bed9",
                        "source_entry_id": "b2439ed0-63d4-34c8-9767-0d43e9db97d4",
                        "source_sense_id": "1bc4ec20-b2af-3da6-aecc-d87832ce9128",
