                ],
                "senses": [
                    {
                        "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                        "entry_id": "270cdfc6-ca5c-343d-9b90-6c96bc27d193",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7b6c88-0c1d-4ef7-80c8-7c27e330806e",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Frau Dallmayr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9e3b987f-baf2-45e5-a8ed-6b89a9ce3279",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Herr Dallmayr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "84468ccb-42fa-4af8-9fa3-f97e13730276",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Die Dallmayrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f5f08adc-ff59-4c9c-88d3-097fa7792bca",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Der Dallmayr trägt nie die Schals, die die Dallmayr ihm strickt."
                            },
                            {
                                "example_id": "ea401285-1e6a-46d6-9de8-f6d0566b170a",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dallmayr kommt, geht der Herr Dallmayr.“"
                            },
                            {
                                "example_id": "e0259b0e-5177-487d-b0ac-e06878a84c50",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Dallmayr kommt und geht."
                            },
                            {
                                "example_id": "54805219-5da7-46d2-a54b-e9c60e8715df",
                                "sense_id": "0f73955e-c9c3-3d02-b009-5d065f6ff3c6",
                                "text": "Dallmayrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
