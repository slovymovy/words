                    "sense_definition": "das Einzahlen oder Verwahren von Wertgegenständen, Geldern oder Dokumenten; Vorgang des Hinterlegens; Substantivierung des Verbs <w>hinterlegen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aufbewahrung",
                    "name_type": "no",
                    "examples": [
