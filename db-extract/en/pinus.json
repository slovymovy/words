                        "glosses": [
                            "Any member of the genus Pinus; a pine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef53fede-bcf6-40c1-aefd-82b4bbe04bbd",
                                "sense_id": "5ce584c9-f387-3695-9ce4-b3028e597433",
                                "text": "I have been invited to see the garden of Baron Zanoli, situated on the high road from Monza to Milan, in which I am told there are fine exotic trees and shrubs, and especially a rich collection of pinuses."
                            },
                            {
                                "example_id": "ecd8633b-298b-4b89-b792-e7b75fb6d49b",
                                "sense_id": "5ce584c9-f387-3695-9ce4-b3028e597433",
                                "text": "As the generality of pinuses grow by nature into magnificent and gigantic forest-trees, they should, I think, be planted in our parks as well as in our flower-gardens, shrubberies, and lawns."
                            }
                        ]
                    }
