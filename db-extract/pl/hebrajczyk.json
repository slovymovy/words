                                                "example_id": "4d27ad09-fd8d-4d5e-9369-52caa68ccb9d",
                                                "sense_id": "f5e5a2e2-61b8-30cd-a3d9-9f2a71c0a1da",
                                                "text": "nel corso della storia alcuni ebrei hanno vissuto in solitudine"
                                            },
                                            {
                                                "example_id": "1a711930-c26e-4b6b-8638-439a6c75c74c",
                                                "sense_id": "f5e5a2e2-61b8-30cd-a3d9-9f2a71c0a1da",
                                                "text": "\"Il dubbio di essere ebrei si risolve con l'essere ebrei quindi, dato che sono ebreo, perché continuare a domandarmi chi sono?\""
                                            },
                                            {
                                                "example_id": "5f20be54-18c8-4b9c-939d-4ab87a79a017",
                                                "sense_id": "f5e5a2e2-61b8-30cd-a3d9-9f2a71c0a1da",
                                                "text": "a proposito dell’assassinio, incluso quello in battaglia, ogni ebreo ne osserva il divieto assoluto infatti l’ebreo appunto è addirittura molto vigile per la mitzvah dello shabbat la cui trasgressione è certamente meno grave"
                                            },
                                            {
                                                "example_id": "4276275d-6c60-4f95-beb4-84bdde5df6d9",
                                                "sense_id": "f5e5a2e2-61b8-30cd-a3d9-9f2a71c0a1da",
                                                "text": "essere ebreo di nascita"
                                            },
                                            {
                                                "example_id": "178e7197-fca0-481a-9652-6b2002a6b1e2",
                                                "sense_id": "f5e5a2e2-61b8-30cd-a3d9-9f2a71c0a1da",
                                                "text": "L’etica inflessibile dell’ebreo Shylock, che non conosce mediazione né perdono, punta il dito sulla parzialità della legge veneziana che risulta troppo elastica nelle sue sentenze e assai poco affidabile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38eda67b-3577-3c72-8a0b-187ffe8d7929",
                                        "entry_id": "71ecce90-29a3-3e5d-8d16-7c3c47f0384f",
                                        "glosses": [
                                            "chi non appartiene alla propria etnia"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
