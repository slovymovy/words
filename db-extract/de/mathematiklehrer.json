                ],
                "senses": [
                    {
                        "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                        "entry_id": "b555b074-ecc0-3242-ad65-84a4307fc727",
                        "glosses": [
                            "ein Lehrer, der Mathematik unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5eb6fa6-60a3-4c4c-8879-fbff917ec610",
                                "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                                "text": "„Der Mathematiklehrer, ein Deutscher, erklärte uns den Stundenplan: zwei Stunden Bio, zwei Stunden Englisch, zwei Stunden Geschichte, zwei Stunden Französisch und zum Abschluss eine Stunde Mathe.“"
                            },
                            {
                                "example_id": "d3045d6e-7abe-4840-b76f-b5835b529123",
                                "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                                "text": "Um sich die Reise zu finanzieren, arbeitet er als Mathematiklehrer an einer Nachhilfeschule."
                            },
                            {
                                "example_id": "58dec05f-c84c-4d37-b09a-b28e74c01c83",
                                "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                                "text": "„Nicht nur der Mathematiklehrer hatte von dieser Vergangenheit genug.“"
                            },
                            {
                                "example_id": "639a53c2-17fd-456a-86c4-5755509ca109",
                                "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                                "text": "„Ich blätterte weiter zur nächsten, die mit einem rotzenden Mathematiklehrer begann.“"
                            },
                            {
                                "example_id": "cefc8e05-882c-4d7d-b3cf-6aeabed1384f",
                                "sense_id": "296b45af-8681-36a4-ab52-e4b8e2d4e35b",
                                "text": "„Otto Busch pomovierte in Philosophie, Hermann Busch wurde Mathematiklehrer an einem Gymnasium in Celle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
