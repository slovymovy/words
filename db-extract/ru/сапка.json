                        "examples": [
                            {
                                "example_id": "d6080081-d520-4133-a795-f4db86275d62",
                                "sense_id": "52a36bdd-47d2-33b1-8468-2210b8ab86bc",
                                "text": "Надо острой лопатой или сапкой вырывать куски корневищ из их сплетения и выдергивать каким-либо инструментом с зубьями."
                            },
                            {
                                "example_id": "9ce4ae0b-e566-4f9c-b677-bc3259c5be09",
                                "sense_id": "52a36bdd-47d2-33b1-8468-2210b8ab86bc",
                                "text": "Илья быстро отступил и крепко сжал в руках огородную сапку."
                            }
                        ]
                    }
                ],
