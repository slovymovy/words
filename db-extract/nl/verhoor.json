                "senses": [
                    {
                        "sense_id": "a323c4ae-8251-3d83-9b30-8f0e97b22fd1",
                        "entry_id": "e01a827a-8556-3f30-90f5-4be532f48108",
                        "glosses": [
                            "een indringende ondervraging van een gevangene of verdachte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6226f34-1f0b-424a-8b2a-a0109bd3c5be",
                                "sense_id": "a323c4ae-8251-3d83-9b30-8f0e97b22fd1",
                                "text": "In het verhoor kreeg de politie weinig van hem los."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d65e2a4-f523-467d-aded-7a37be12c2a2",
                        "source_entry_id": "e01a827a-8556-3f30-90f5-4be532f48108",
                        "source_sense_id": "a323c4ae-8251-3d83-9b30-8f0e97b22fd1",
                        "source_sense_description": "een indringende ondervraging van een gevangene of verdachte",
                        "target_lang_word": "Verhör",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                        "entry_id": "3dc8aa15-7f93-36f5-a4fe-c8f68d52cb1d",
                                        "glosses": [
                                            "militärische, polizeiliche oder gerichtliche Befragung, Vernehmung, Einvernahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ede747f-d2b0-457c-aa52-b6fbde1c45f2",
                                                "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                                "text": "Beim Verhör gab er an, sich an nichts mehr zu erinnern."
                                            },
                                            {
                                                "example_id": "6ff70cf3-df7e-42db-8cb5-ac8d243e423b",
                                                "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                                "text": "„Sollten wir im schlimmsten Fall als Überlebende des gesunkenen Bootes in Gefangenschaft geraten, so würden wir selbst die geschicktesten Fangfragen bei Verhören nicht beantworten können.“"
                                            },
                                            {
                                                "example_id": "e1a3c0fa-5436-43b5-bb1e-a65739788ab4",
                                                "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                                "text": "„Er zeichnet das Verhör mit einer Videokamera auf.“"
                                            },
                                            {
                                                "example_id": "96d53268-a642-49a7-88cc-5d18c49a27f6",
                                                "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                                "text": "„Das Verhör an diesem Vormittag hatte sich ganz anders entwickelt, als der Polizeichef es gewöhnt war.“"
                                            },
                                            {
                                                "example_id": "b866a1ff-c276-4d83-aa70-e8d47764da8f",
                                                "sense_id": "afc75e88-b5a4-3f55-adfd-7d8e31b63f85",
                                                "text": "„Das Verhör dauerte nicht lange oder, besser, es fand gar nicht statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13ea9c8d-bd83-4cea-af88-e52ec4607391",
                        "source_entry_id": "e01a827a-8556-3f30-90f5-4be532f48108",
                        "source_sense_id": "a323c4ae-8251-3d83-9b30-8f0e97b22fd1",
                        "source_sense_description": "een indringende ondervraging van een gevangene of verdachte",
                        "target_lang_word": "Vernehmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernehmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                        "entry_id": "d062aaf6-fe0a-3c3c-a1a8-8dfe82c9933f",
                                        "glosses": [
                                            "Befragung einer Person zu einem bestimmten Sachverhalt durch eine Behörde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5474a133-8fb6-45b2-b910-a0a28343c206",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Die anderen beiden polizeibekannten Frauen im Alter von 17 und 19 Jahren wurden ebenfalls vorübergehend festgenommen und kamen nach der Vernehmung wieder auf freien Fuß.“"
                                            },
                                            {
                                                "example_id": "a39fe5a8-0d67-46f7-9cd8-985a828dda3e",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Ein Mann war auf offener See über Bord gefallen und ertrunken, und obwohl mein damaliger Kapitän völlig unschuldig daran war, erinnere ich mich, daß die Vernehmung dennoch für ihn eine unangenehme Angelegenheit war.“"
                                            },
                                            {
                                                "example_id": "d33c2f1e-cb00-46e3-8f87-216a1d3ac065",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Die Vernehmungen durch die Polizei waren bald vorüber, die Anklageschrift lag vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "183f3010-50e3-36c6-97af-b914ded3d7ff",
                                        "entry_id": "d062aaf6-fe0a-3c3c-a1a8-8dfe82c9933f",
                                        "glosses": [
                                            "das Auffassen/die Erfassung von etwas mit dem Geist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acdc094-1234-4cef-a5af-41dda964afbe",
                                                "sense_id": "183f3010-50e3-36c6-97af-b914ded3d7ff",
                                                "text": "Nach der Vernehmung all ihrer schweren Schicksalsschläge beschloss ich, ihr zu helfen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b44def6-68ff-48b6-813b-473a5a899a22",
                        "source_entry_id": "e01a827a-8556-3f30-90f5-4be532f48108",
                        "source_sense_id": "a323c4ae-8251-3d83-9b30-8f0e97b22fd1",
