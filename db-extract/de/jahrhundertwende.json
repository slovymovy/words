                        "examples": [
                            {
                                "example_id": "c659147f-7543-4db4-87e4-bdc54372b03d",
                                "sense_id": "27dd8026-5c7a-3507-b066-bddbffcb868e",
                                "text": "Mein erster Weg führte mich von der Blumenstraße, in der wir im zweiten Stock eines um die Jahrhundertwende gebauten, wuchtigen Hauses wohnten, in die Bahnhofstraße.",
                                "translation": "Мой первый после болезни путь вел меня с Блюменштрассе, где мы жили на третьем этаже массивного, построенного на рубеже веков дома, на Банхофштрассе."
                            }
                        ]
