                        "examples": [
                            {
                                "example_id": "ee72f1e6-abde-4f42-839e-209196a7417f",
                                "sense_id": "81ba0b1a-3610-3794-ba54-f112a2d72329",
                                "text": "„Auf Grund von genauen Untersuchungen beträgt z. B. bei der üblichen, käuflichen Hagebuttenmarmelade der Vitamingchalt nach einjähriger Lagerung nur noch 25% des ursprünglichen Gehaltes.“"
                            },
                            {
                                "example_id": "304e69ba-6fda-4a0c-bba7-fa6c8dd42545",
                                "sense_id": "81ba0b1a-3610-3794-ba54-f112a2d72329",
                                "text": "„…die Besucher hatten die Qual der Wahl zum günstigen Preis: ’So billig gibt’s selten ein Vesper’, konstatierte eine Frau. Vieles gab’s auch zum Mitnehmen, von den Hagebuttenmarmeladen bis zum Bordeaux-Wein.“"
                            }
                        ],
