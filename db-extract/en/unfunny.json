                    {
                        "translation_id": "677b2115-ae55-46f7-b5c4-c9081d1fccb1",
                        "source_entry_id": "5c8e2cd7-e901-36da-a15a-dc0fbb267097",
                        "source_sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
