{
    "word_family": [
        "adjectival",
        "adjectivally",
        "adjectivize",
        "adjectify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97c5e355-7ca1-31a4-b828-c1e49c8b4f94",
                    "sense_definition": "A word that modifies a noun or noun phrase or describes a noun’s referent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The words big and heavy are English <w>adjectives</w>.",
                            "target_lang_translations": {
                                "zh": "“Big”和“heavy”这两个词是英语<w>形容词</w>。"
                            }
                        },
                        {
                            "text": "You should use a descriptive <w>adjective</w> to make your writing more interesting.",
                            "target_lang_translations": {
                                "zh": "你应该使用描述性的<w>形容词</w>来让你的文章更有趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "describing word",
                        "description word"
                    ],
                    "common_phrases": [
                        "descriptive adjective",
                        "possessive adjective",
                        "comparative adjective"
                    ],
                    "target_lang_definitions": {
                        "zh": "修饰名词或名词短语，或描述名词所指对象的词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "形容词",
                                "target_lang_sense_clarification": "语法术语，指修饰名词的词类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0382b970-9d10-3a80-bc9b-032c1ea302e6",
                    "sense_definition": "A person or thing that is dependent on or an accessory to something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dependency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this philosophical framework, the individual is treated as a mere <w>adjective</w> to the state.",
                            "target_lang_translations": {
                                "zh": "在这个哲学框架中，个人被视为国家的一个单纯的<w>附属物</w>。"
                            }
                        },
                        {
                            "text": "The small company functioned as an <w>adjective</w> to the larger corporation.",
                            "target_lang_translations": {
                                "zh": "这家小公司充当了大型企业的<w>附属物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dependent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern contexts outside of philosophy"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指依附于他物或作为他物附属品的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "附属物",
                                "target_lang_sense_clarification": "指依附于主体的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58816f2f-761a-34cf-b2ea-768ef111ea0a",
                    "sense_definition": "Pertaining to or functioning as an <w>adjective</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word has an <w>adjective</w> function in this specific sentence structure.",
                            "target_lang_translations": {
                                "zh": "在这个特定的句子结构中，该词具有<w>形容词性</w>的功能。"
                            }
                        },
                        {
                            "text": "He analyzed the <w>adjective</w> use of the noun in the phrase.",
                            "target_lang_translations": {
                                "zh": "他分析了这个短语中名词的<w>形容词性</w>用法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adjectival"
                    ],
                    "common_phrases": [
                        "adjective phrase",
                        "adjective clause"
                    ],
                    "target_lang_definitions": {
                        "zh": "与形容词有关的，或具有形容词功能的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "形容词性的",
                                "target_lang_sense_clarification": "指具有形容词特征或功能的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb33df92-a10c-3f3d-b2ba-1d9d660fb90c",
                    "sense_definition": "Relating to the methods of enforcement and rules of procedure rather than substantive law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer focused on <w>adjective</w> law to find a procedural error in the case.",
                            "target_lang_translations": {
                                "zh": "律师专注于<w>程序法</w>，以找出案件中的程序性错误。"
                            }
                        },
                        {
                            "text": "The whole English law consists of both substantive and <w>adjective</w> rules.",
                            "target_lang_translations": {
                                "zh": "整个英国法律由实体规则和<w>程序</w>规则组成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "procedural"
                    ],
                    "antonyms": [
                        "substantive"
                    ],
                    "common_phrases": [
                        "adjective law"
                    ],
                    "target_lang_definitions": {
                        "zh": "指与法律执行方法和程序规则有关，而非实体法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "程序性的",
                                "target_lang_sense_clarification": "法律术语，指与诉讼程序相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "215746c6-200c-3d29-8dae-aaeb3f03438c",
                    "sense_definition": "Incapable of independent function; existing only as an attribute of something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dependency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his theology, the creator is not seen as separate but as <w>adjective</w> to the universe.",
                            "target_lang_translations": {
                                "zh": "在他的神学中，造物主并非被视为独立的，而是宇宙的<w>依附性</w>存在。"
                            }
                        },
                        {
                            "text": "The quality of mercy is <w>adjective</w> to the character of a true leader.",
                            "target_lang_translations": {
                                "zh": "仁慈的品质是真正领导者性格的<w>依附性</w>特征。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dependent",
                        "derivative"
                    ],
                    "antonyms": [
                        "substantive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in formal or philosophical writing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "无法独立存在，仅作为他物属性而存在。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "依附性的",
                                "target_lang_sense_clarification": "指不能独立存在，必须依附于他物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043f69b3-f3d1-3f87-970d-0e6fffbc506d",
                    "sense_definition": "Requiring the use of a mordant to be fixed to a fabric during the dyeing process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist explained that <w>adjective</w> dyes require a chemical agent to bond with the fibers.",
                            "target_lang_translations": {
                                "zh": "化学家解释说，<w>媒染</w>染料需要化学试剂才能与纤维结合。"
                            }
                        },
                        {
                            "text": "Unlike substantive dyes, an <w>adjective</w> color will wash out without a proper mordant.",
                            "target_lang_translations": {
                                "zh": "与直接染料不同，如果没有合适的媒染剂，<w>媒染</w>色料会被洗掉。"
                            }
                        }
                    ],
                    "antonyms": [
                        "substantive"
                    ],
                    "common_phrases": [
                        "adjective dye"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in chemistry and dyeing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在染色过程中需要媒染剂才能固定在纤维上的染料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "媒染的",
                                "target_lang_sense_clarification": "化学与纺织术语，指需要媒染剂的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f09ec53-c481-3855-aa73-b008990789cd",
                    "sense_definition": "To convert a word into an <w>adjective</w> or use it as one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author likes to <w>adjective</w> nouns to create unique descriptions in his poetry.",
                            "target_lang_translations": {
                                "zh": "这位作者喜欢将名词<w>形容词化</w>，以在他的诗歌中创造独特的描述。"
                            }
                        },
                        {
                            "text": "In English, we often <w>adjective</w> our own substantives by adding specific suffixes.",
                            "target_lang_translations": {
                                "zh": "在英语中，我们经常通过添加特定的后缀来将名词<w>形容词化</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adjectivize",
                        "adjectify"
                    ],
                    "target_lang_definitions": {
                        "zh": "将一个词转化为形容词或将其用作形容词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "形容词化",
                                "target_lang_sense_clarification": "语言学动词，指使某词具有形容词功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2be98b2-a3d4-3788-a402-ed70d232a5c5",
                    "sense_definition": "To describe or characterize something by using an <w>adjective</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>adjective</w> the beauty of the landscape without sounding cliché.",
                            "target_lang_translations": {
                                "zh": "很难用<w>形容词</w>来描述这片风景的美，而不显得陈词滥调。"
                            }
                        },
                        {
                            "text": "The critic chose to <w>adjective</w> the performance as transcendent.",
                            "target_lang_translations": {
                                "zh": "评论家选择用“超凡”这个<w>形容词</w>来评价这场演出。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用形容词来描述或刻画某事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用形容词描述",
                                "target_lang_sense_clarification": "指通过形容词进行修饰或评价"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}