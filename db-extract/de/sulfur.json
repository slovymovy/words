                        "form": "dem Sulfur"
                    },
                    {
                        "form_id": "674d6863-2c4f-49e7-a262-893a7f13eb32",
                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Sulfur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60c0ec2e-7f56-35e8-8008-9ba1dcfb66b0",
                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                        "glosses": [
                            "chemisches Element mit der Ordnungszahl 16, das zu den Nichtmetallen gehört; Schwefel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1863119-9f2b-434f-9de5-7115ee4c76ea",
                                "sense_id": "60c0ec2e-7f56-35e8-8008-9ba1dcfb66b0",
                                "text": "„Das Element Sulfur ist gewöhnlich aus Achtringen S8 aufgebaut und heißt dann systematisch Octasulfur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                        "glosses": [
                            "philosophisches Prinzip (neben Sal und Mercurius), das das Spezifische und Einzigartige eines Geschöpfes vermittelt"
                        ],
                        "tags": [
                            "Naturheilkunde",
                            "Spagyrik"
                        ],
                        "examples": [
                            {
                                "example_id": "9ed8f233-4fc5-4e74-a7c0-663da13de37d",
                                "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                                "text": "Paracelsus ordnete die Prinzipien Sulfur und Mercurius und fügt ihnen als drittes Prinzip Sal hinzu. Diese Dreiheit bestimmt dann die Form der Alchemie, aus der sich schrittweise die neuzeitliche Chemie entwickeln sollte."
                            },
                            {
                                "example_id": "eaf6b3b8-ed51-4526-8d00-f427b5855625",
                                "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                                "text": "„Sal steht für das materialistische Prinzip, Sulfur für das beseelte (feinstoffliche) und Mercurius für das belebende Prinzip, das ständig zwischen Sal und Sulfur verbindet und vermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                        "glosses": [
                            "auf dem Element Schwefel basierendes homöopathisches Mittel"
                        ],
                        "tags": [
                            "Naturheilkunde",
                            "Homöopathie"
                        ],
                        "examples": [
                            {
                                "example_id": "2183edbc-ca83-4212-825d-319c4f8afc1e",
                                "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                                "text": "„Sulfur ist eines der am häufigsten verordneten Mittel der klassischen Homöopathie. Es basiert auf dem Element Schwefel. Sulfur soll bei einem breiten Spektrum an akuten und chronischen Krankheiten helfen. Besonders bei Problemen der Haut, Atemwegserkrankungen und Verdauungsstörungen soll man mit Sulfur oft Behandlungserfolge erzielen.“"
                            },
                            {
                                "example_id": "3a1f9aac-73ed-415b-95a8-e47f8301f30c",
                                "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                                "text": "„Täglich 2mal 5 Globuli von Sulfur D12 im Mund zergehen lassen. Anmerkung: Sulfur gilt als das größte Lebermittelfunktionsmittel der Homöopathie und sollte immer wieder 2 Wochen lang als Zwischenmittel gegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
