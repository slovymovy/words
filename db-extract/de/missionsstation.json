                "senses": [
                    {
                        "sense_id": "dc800a65-c7b4-32b5-8285-5e314e272288",
                        "entry_id": "7121360a-0af5-387b-8697-e0b11a4fa479",
                        "glosses": [
                            "Niederlassung/Siedlung, vor allem mit dem Ziel, christlich zu missionieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8068bf7-fa00-46d1-994b-6503a979d25a",
                                "sense_id": "dc800a65-c7b4-32b5-8285-5e314e272288",
                                "text": "„Als der Lehrer in der Missionsstation einen Satz auf die Tafel schreibt und vier Fehler dabei macht, korrigiert ihn der Junge – und wird dafür von der Schule verwiesen.“"
                            },
                            {
                                "example_id": "dd643ec4-b8dc-4297-bb83-7ecefa051433",
                                "sense_id": "dc800a65-c7b4-32b5-8285-5e314e272288",
                                "text": "„Und sie stellten fest, dass die Missionsstationen, die Kontakt mit Einheimischen suchten, erschreckend hohe Sterberaten verzeichnet hatten .“"
                            },
                            {
                                "example_id": "d2c212f5-4cf5-40b6-85ba-f79c3ae3b39c",
                                "sense_id": "dc800a65-c7b4-32b5-8285-5e314e272288",
                                "text": "„Der Ort wurde nach einem traditionellen Oberhaupt benannt, der vor dem Ersten Weltkrieg zum Christentum konvertierte und die Jesuiten einlud, dort eine Missionsstation zu gründen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
