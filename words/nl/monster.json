                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Mijn oom woont al jaren in het dorp <w>Monster</w> aan de kust.",
                            "target_lang_translations": {
                                "en": "My uncle has lived in the village of <w>Monster</w> on the coast for years."
                            }
                        },
                        {
                            "text": "We fietsten door <w>Monster</w> tijdens onze tocht door het Westland.",
                            "target_lang_translations": {
                                "en": "We cycled through <w>Monster</w> during our trip through the Westland."
                            }
