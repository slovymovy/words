        "fr-extract.jsonl": [
            {
                "entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                "word": "fondrière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c9c95590-8303-47dd-8330-9a6ce06cb3b9",
                        "entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "fondrières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                        "entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "glosses": [
                            "Excavation bourbeuse dans un chemin défoncé par la pluie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b90eed8-2e5b-42a2-b19d-63c912f844e4",
                                "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                                "text": "Le sol spongieux tremblait autour de nous, et à chaque instant nous étions près d’être engloutis dans des fondrières."
                            },
                            {
                                "example_id": "f17a1e51-0b48-430d-a143-1dffd1fbeb7e",
                                "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                                "text": "Le reste n’est que bocages et fondrières où les Médoquins têtus ont ouvert de minuscules vignes et champs de maïs plantés en rizières."
                            },
                            {
                                "example_id": "c0ad622f-70fd-43b8-89d0-bed9583fd10c",
                                "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                                "text": "La vieille route est une fondrière que sauf le « piéton », porteur de la gazette ou de lettres, nul étranger n’emprunte plus…"
                            },
                            {
                                "example_id": "90134aca-4a5a-48f5-a77b-aea65d32d89b",
                                "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                                "text": "Je l’ai vu, de mes yeux vu, accroupi dans une fondrière aussi grise qu’une pierre de cimetière."
                            },
                            {
                                "example_id": "3b8cf497-f150-4f89-83e6-0bbf6cb60801",
                                "sense_id": "ff26999c-eb4d-33ac-a5d6-ef3e22bf5d7f",
                                "text": "Se coller aux arbres ne servait à rien, nos bottes s’enfonçaient dans l’eau et la boue, le sol trempé était couvert de feuilles pourries qui cachaient des fondrières."
                            }
                        ]
                    },
                    {
                        "sense_id": "53eafdbc-676e-3ba4-aa03-0661250ec753",
                        "entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "glosses": [
                            "Dépression peu profonde, formées sous l’action des glaciers, et inondées de façon permanente ou saisonnière caractérisant une vaste zone du nord des prairies de l’Amérique du Nord."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f1522aa1-d7cb-3243-ac36-32b76c0e75b9",
                        "entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "glosses": [
                            "Exploitation minière à ciel ouvert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7717522b-9b8c-4477-8e32-20787c78e1d0",
                                "sense_id": "f1522aa1-d7cb-3243-ac36-32b76c0e75b9",
                                "text": "Le minerai de cette fondrière est souvent pyriteux et contient, dans sa masse, de la galène disséminée en petits fragments."
                            },
                            {
                                "example_id": "a6e7dcb6-5286-4705-9c18-27f2b8a88377",
                                "sense_id": "f1522aa1-d7cb-3243-ac36-32b76c0e75b9",
                                "text": "Au début, les mines furent exploitées à ciel ouvert, on creusait au fur et à mesure une immense fondrière au fond de laquelle les nègres et les blancs travaillaient fiévreusement à extraire la terre diamantifère qui était remontée sur le sol au moyen de câbles d'acier […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4aaecb31-66e3-490b-9ce9-b394c774d6ea",
                        "source_entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "target_lang_word": "Schlamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                        "entry_id": "b40d3b57-650e-3580-b1ed-ea635fb6b0c2",
                                        "glosses": [
                                            "mit Wasser vermischte Erde, Morast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03cfa672-f375-4312-91ff-2a040e0124ae",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "Nach dem Regenguss mussten wir durch Schlamm waten."
                                            },
                                            {
                                                "example_id": "803edb1d-3447-4c9f-b1c6-c2ceed87cbe0",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Er brach frühmorgens auf, kehrte abends wieder, ohne Kopfbedeckung, die Jacke zerrissen und die Hosen mit Schlamm beschmutzt.“"
                                            },
                                            {
                                                "example_id": "93c5bbf1-3be7-407f-9d26-8f04ad4946b8",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Der Schlamm patschte unter den Stiefeln.“"
                                            },
                                            {
                                                "example_id": "e17470cd-b54e-472e-a8ab-870ad287c5b2",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„In der Regenzeit spritzt mir der Schlamm auf der unbefestigten Straße, die zu unserem Haus führt, bis an die Waden.“"
                                            },
                                            {
                                                "example_id": "8c6d9c34-0565-4ea7-a7a1-d4679ee561ca",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Die Pferde wateten im Schlamm, sie hatten Mühe, die Kanonen zu bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1fb169e-2ea2-3313-8e17-ebac490267cc",
                                        "entry_id": "b40d3b57-650e-3580-b1ed-ea635fb6b0c2",
                                        "glosses": [
                                            "feine Ablagerungen am Boden von Gewässern oder in Geräten, durch die Flüssigkeiten fließen; Schlick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec71d529-5f41-4646-8239-c7d86dd5c5a1",
                                                "sense_id": "a1fb169e-2ea2-3313-8e17-ebac490267cc",
                                                "text": "Das Fischernetz wühlte eine Menge Schlamm auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a49906d-faa1-4021-af99-9926b7e7ee72",
                        "source_entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "target_lang_word": "Sumpfloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c29c276d-277f-41a4-8109-d51674408b7b",
                        "source_entry_id": "058dc728-a37e-38e2-bb22-d29a7e2b14fd",
                        "target_lang_word": "pothole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pothole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A shallow pit or other edged depression in a road's surface, especially when caused by erosion by weather or traffic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0922244c-cef6-4987-98f4-b880e9d6b7be",
                                                "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                                "text": "I was so tired that potholes, fumes and noise aside, I slept regardless, my head rag-dolling from side to side."
                                            },
                                            {
                                                "example_id": "a9cd7cf9-a252-4689-b993-d4b93559c902",
                                                "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                                "text": "Labour's Shadow Transport Secretary Louise Haigh said: \"There is a cost-of-living crisis, and the Prime Minister blew nearly £1m of public money on an utterly infeasible vanity project. That's enough to fill 18,000 potholes. This shows the Tories' sheer disrespect for public money.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcbfe24-4e2d-396d-8a50-00af306e5e92",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A pit formed in the bed of a turbulent stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc596488-8351-4ea1-90e4-57233b681b8d",
                                                "sense_id": "9fcbfe24-4e2d-396d-8a50-00af306e5e92",
                                                "text": "2002, May-June, Grand River Conservation Authority (Canada) Newsletter\nThe earliest ideas on the creation of potholes are that they were associated with \"moulins de glacier\" (glacier mills) formed where surface streams on glaciers and ice sheets fall into holes in the ice. Water entering these surficial holes was believed to impact on the bedrock beneath creating a large pothole. The \"Moulin Hypothesis\", first suggested in 1874, continued to be accepted by many authors until the 1950s. However, commencing in the 1930s, other authors have suggested dissatisfaction with the moulin hypothesis, largely on the grounds that it failed to explain how ice could remain stable long enough for the \"giant\" potholes to form and why many potholes (like those at Rockwood) were present in large numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17705f5c-c7cf-3a86-9b76-6c6af99aa8ec",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A vertical cave system, often found in limestone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "597c3dea-dcbf-3fd4-9cb9-82ea64b79d0a",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A pit resulting from unauthorized excavation by treasure-hunters or vandals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5402d14-44b9-3a82-a75e-f31a3fdfbd94",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A shallow hole dug for the purpose of prospecting for opal or gold."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
