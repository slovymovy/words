                "senses": [
                    {
                        "sense_id": "394a86d0-0cbb-33ba-ab0a-fb335c96478a",
                        "entry_id": "52eeefc7-85bb-36fa-a9e1-160a9e104d22",
                        "glosses": [
                            "Heizung, die mit Fernwärme von einer zentralen Stelle (Kraftwerk) über Rohrleitungen versorgt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f12482c-0561-486f-af5d-d838881c7fee",
                                "sense_id": "394a86d0-0cbb-33ba-ab0a-fb335c96478a",
                                "text": "„Ich habe eine direkte Fernheizung mit einer Umwälzpumpe und keinen Wärmtauscher für die Heizung.“"
                            },
                            {
                                "example_id": "5d31d680-f52f-4ccb-9963-0b5b9ab35617",
                                "sense_id": "394a86d0-0cbb-33ba-ab0a-fb335c96478a",
                                "text": "„Ein besonders angenehmer Nebeneffekt der Fernheizung ist auch, dass man keinerlei Brennstoffe anschaffen und lagern muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
