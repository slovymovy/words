                "senses": [
                    {
                        "sense_id": "e4234bf6-1d86-3686-8b01-84c52848bd1c",
                        "entry_id": "06c4098b-4a46-3fc5-8f2f-de6fa08935e1",
                        "glosses": [
                            "Herstellung von lüftungstechnischen Komponenten und Lüftungstechnischen Anlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1406920-1376-4341-b049-ab0d271bdc6b",
                                "sense_id": "e4234bf6-1d86-3686-8b01-84c52848bd1c",
                                "text": "„Die kontrollierte Wohnungslüftung ist ein Bestandteil der Niedrigenergiebauweise und der Lüftungsbau ist mittlerweile ein fester Bestandteil in dem Bereich Neubau.“"
                            },
                            {
                                "example_id": "3795579a-3cd3-43b6-8045-87941c662227",
                                "sense_id": "e4234bf6-1d86-3686-8b01-84c52848bd1c",
                                "text": "„Unser Unternehmen plant und realisiert seit über 60 Jahren Maschinen und Anlagen im Bereich der Oberflächen-Technik und im Lüftungsbau.“"
                            },
                            {
                                "example_id": "56778cde-ae15-4bb5-a73d-996baf18ea4c",
                                "sense_id": "e4234bf6-1d86-3686-8b01-84c52848bd1c",
                                "text": "„Unsere Formteile für den Lüftungsbau bietet Ihnen eine große Auswahl an vordefinierten und sorgfältig ausgewählten Formstücken.“"
                            },
                            {
                                "example_id": "4916829c-8c10-4e2d-9df5-36a057e3d2cf",
                                "sense_id": "e4234bf6-1d86-3686-8b01-84c52848bd1c",
                                "text": "„Der Lüftungsbau wurde 1982 eingestellt, jetzt wurden alle Aktivitäten auf den Maschinenbau konzentriert.“"
                            }
                        ],
