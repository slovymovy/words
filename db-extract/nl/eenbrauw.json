                                    {
                                        "sense_id": "124afd39-ea79-3aa2-bb42-8ed10307b5dc",
                                        "entry_id": "25ec351b-b7f0-3805-b131-4c81684b5878",
                                        "glosses": [
                                            "durchgehende Augenbraue, die durch das Zusammenwachsen der beiden Brauen entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8490f4a-5d89-410d-89a1-2f958c9f279b",
                                                "sense_id": "124afd39-ea79-3aa2-bb42-8ed10307b5dc",
                                                "text": "„Bob zog eine Hälfte seiner Monobraue hoch.“"
                                            },
                                            {
                                                "example_id": "8ddb8fc5-3448-420f-b7a3-8467e76a68e6",
                                                "sense_id": "124afd39-ea79-3aa2-bb42-8ed10307b5dc",
                                                "text": "„Justyna funkelt erst ihn böse an und dann mich, wobei ihre Monobraue einen düsteren Schatten über die dunklen Augen wirft.“"
                                            },
                                            {
                                                "example_id": "22da2a8d-aa7c-44ce-a3a9-d9febcd4fb6a",
                                                "sense_id": "124afd39-ea79-3aa2-bb42-8ed10307b5dc",
                                                "text": "„Vater knickte seine imposante Monobraue missfällig in der Mitte und legte die Stirn in Sorgenrunzeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
