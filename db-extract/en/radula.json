                ],
                "senses": [
                    {
                        "sense_id": "b141e221-3529-3346-b457-27ef46f8a4b9",
                        "entry_id": "d1965061-16a6-3ebf-a72c-76ca27eb3223",
                        "glosses": [
                            "The rasping tongue of snails and all other mollusks except bivalves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8bc7b3-0d65-4261-8b7a-dc5369abc916",
                                "sense_id": "b141e221-3529-3346-b457-27ef46f8a4b9",
                                "text": "The radula end containing the first 5–10 rows of teeth showed evidence of wear from rasping over rock surfaces during feeding and was removed using dissection."
                            },
                            {
                                "example_id": "4b7ddcda-5068-4d9e-a66f-0e139d09ed46",
                                "sense_id": "b141e221-3529-3346-b457-27ef46f8a4b9",
                                "text": "What Kruta found in the ammonoid fossils was an unfoldable radula covered with delicate, comblike teeth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "760c1ef5-3ef9-40c1-b663-422c0a700274",
                        "source_entry_id": "d1965061-16a6-3ebf-a72c-76ca27eb3223",
                        "source_sense_id": "b141e221-3529-3346-b457-27ef46f8a4b9",
                        "source_sense_description": "the rasping tongue of snails and most other molluscs",
                        "target_lang_word": "ра́дула",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ра́дула",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2b689973-8d28-3dba-a544-e841397f26ee",
