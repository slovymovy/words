                "senses": [
                    {
                        "sense_id": "acb1dd41-02a4-36fa-a0e6-09ab81117a46",
                        "entry_id": "789ad3d0-3b2a-3149-96b4-a69f8137cedc",
                        "glosses": [
                            "Miliz, gebildet aus den wehrfähigen Bewohnern einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d051dc-363c-4dcb-ad9a-e4f0e8e6650c",
                                "sense_id": "acb1dd41-02a4-36fa-a0e6-09ab81117a46",
                                "text": "„Anders als in Gent und in Ypern ließ sich die zur Belagerung des englischen Calais entsandte [Brügger] Stadtmiliz bei der Rückkunft am 2. August 1436 nicht entwaffnen, sondern blieb bis zum 12. des Monats als bewaffneter Haufen vor der Stadt liegen.“"
                            },
                            {
                                "example_id": "189d663f-f388-4a21-988b-946ff56c5427",
                                "sense_id": "acb1dd41-02a4-36fa-a0e6-09ab81117a46",
                                "text": "„‚[…] Bauern, Stadtmilizen und einfache Männer haben die viel besser bewaffneten französischen Ritter [bei der Golden Sporen Schlacht {sic!}] geschlagen, und das, weil sie beseelt waren vom Drang nach Recht und Freiheit.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
