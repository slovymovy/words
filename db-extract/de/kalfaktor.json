                    {
                        "sense_id": "29e76125-c9d7-3758-a192-d83b94b7f1e5",
                        "entry_id": "6b249f4d-e0d7-3acc-a191-7f1eab50f9ad",
                        "glosses": [
                            "Hilfskraft, die einfache Arbeiten verrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a33ba4e-03f4-4cd8-b8e3-c556c295fba0",
                                "sense_id": "29e76125-c9d7-3758-a192-d83b94b7f1e5",
                                "text": "„Der Kalfaktor ist bestimmt, die Reinigung und Heizung des Wachtlokals zu besorgen und Trinkwasser und Lebensmittel für die Wachtmannschaft herbeizuholen.“ (1867)"
                            },
                            {
                                "example_id": "5c4c0a1e-83a0-4094-b64d-ed8d292b2320",
                                "sense_id": "29e76125-c9d7-3758-a192-d83b94b7f1e5",
                                "text": "Um das zu erledigen, gibt es den Kalfaktor."
                            },
                            {
                                "example_id": "b1a30d2f-9b66-440e-a5f7-4bd0689df7e6",
                                "sense_id": "29e76125-c9d7-3758-a192-d83b94b7f1e5",
                                "text": "Wozu haben wir denn den Kalfaktor?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6597ff95-176d-32ad-a7c2-913ff0b65a1a",
