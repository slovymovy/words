                                        "entry_id": "cf8e5613-030b-30bd-9197-6ac243fd0c64",
                                        "glosses": [
                                            "由破傷風芽孢桿菌侵入破損的皮膚或黏膜而導致的致命性疾病，會引起痙攣、發熱、頭痛等症狀"
                                        ],
