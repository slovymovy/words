                "senses": [
                    {
                        "sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "glosses": [
                            "jednostka podziału administracyjnego wyższego szczebla w Rosji i krajach okupowanych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ada87ce-7e5f-4544-b9aa-d560a53c8c02",
                                "sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                                "text": "Na czele guberni stał gubernator mianowany przez cara."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7cfc4c4-fbdd-4425-9b91-4e6977bf41e2",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "target_lang_word": "governorate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "governorate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b307e4-7bdf-3998-a9af-14e8ac0aa066",
                                        "entry_id": "369aa553-323e-3d5b-9e84-08a11a6429a7",
                                        "glosses": [
                                            "The territory governed by a governor; a province."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3abc0d6f-a787-45b9-bcdb-9fa36e2bb69f",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "target_lang_word": "guberniya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guberniya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b3df4d-7aa5-3fe7-bbc8-09bcc338ff2a",
                                        "entry_id": "c67f7bb8-8799-3c66-aeff-22f48de16293",
                                        "glosses": [
                                            "A major administrative subdivision of the Russian Empire; a governorate or province."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecabe2b5-e3fb-4eec-9f72-2a39efee5303",
                                                "sense_id": "49b3df4d-7aa5-3fe7-bbc8-09bcc338ff2a",
                                                "text": "Milyukov’s density figure for the southeastern portion of Peter’s realm, referred to in his text as “the Kazan’ and Astrakhan’ gubernii” of that time, appears to be erroneous. It corresponds to the enumerated number of males in these two old gubernii, but the Nizhegorod Guberniya had been formed from parts of these gubernii during Peter’s reign and its area is definitely included in this region by Milyukov."
                                            },
                                            {
                                                "example_id": "09ac37de-233a-45af-9ebb-3854aba2f60e",
                                                "sense_id": "49b3df4d-7aa5-3fe7-bbc8-09bcc338ff2a",
                                                "text": "In the 1896–1900 period fertility and mortality were still moderately high, although significantly lower than in the Russian gubernii, in Kovno Guberniya, which occupied much of present-day Lithuania."
                                            },
                                            {
                                                "example_id": "a0fc6619-e827-46b0-b052-50aa4e532468",
                                                "sense_id": "49b3df4d-7aa5-3fe7-bbc8-09bcc338ff2a",
                                                "text": "According to official figures, in 1910 the proportion of new inhabitants acquiring land in Tobolsk and Tomsk gubernii who wished to resettle in other regions was between 5 and 6 per cent, and in Yeniseisk guberniya, 12.6 per cent."
                                            },
                                            {
                                                "example_id": "0cb773c4-4415-4304-83bf-1e56d0ee59b2",
                                                "sense_id": "49b3df4d-7aa5-3fe7-bbc8-09bcc338ff2a",
                                                "text": "Modern Lithuania consists of the Kovno guberniya, and half of Vilno and half of Suwalki (Polish) gubernii."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5600cf1c-bf79-47dc-bd07-3e62726c3cc4",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "target_lang_word": "gubernia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gubernia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3945952f-0d44-303c-908a-1ffc030385a4",
                                        "entry_id": "180a58a8-c479-3477-bda1-8e7c9cdf79a4",
                                        "glosses": [
                                            "Alternative form of guberniya."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12c7d36-bf82-45eb-8db5-1e4c31817870",
                                                "sense_id": "3945952f-0d44-303c-908a-1ffc030385a4",
                                                "text": "Soviet Russian troops entered Kharkiv on 7 (20) December 1917; on 12 December they also attacked from the north across Chernihiv gubernia. By mid-February 1918, the gubernii of Kharkiv, Chernihiv, Poltava and Katerynoslav were under complete Bolshevik control; […]"
                                            },
                                            {
                                                "example_id": "7dc37b4e-1738-4e41-b2a8-4e2a7dacc053",
                                                "sense_id": "3945952f-0d44-303c-908a-1ffc030385a4",
                                                "text": "In the gubernii, governors served as the highest administrative authority and together with their executive organs supervised the work of provincial-level departments."
                                            },
                                            {
                                                "example_id": "fece9767-e63f-4093-a62c-9c3d0249e56a",
                                                "sense_id": "3945952f-0d44-303c-908a-1ffc030385a4",
                                                "text": "Even before the administrative reform (1775), new gubernii were being created as territories were added or consolidated on the borderlands. Activity was prodigious in 1764. Siberia’s sole, huge gubernia at Tobolsk was divided to create a gubernia at Irkutsk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gubernia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feb5365a-927f-3850-b7d3-0ec1be7f50b9",
                                        "entry_id": "c177775f-a5eb-34d4-afed-fcae97dac5f5",
                                        "glosses": [
                                            "plural of gubernium"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b7305bf-b68b-4621-b39f-e8c17022c18b",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "target_lang_word": "goubernia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goubernia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7acf23d6-c1ca-3a34-aabd-dbe4ab99a027",
                                        "entry_id": "b14d20f7-807f-3c3b-aeaa-15ec74315eae",
                                        "glosses": [
                                            "Charge d’un gouverneur et province administrée par ce dernier dans l’ancien Empire russe (1721-1917)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff626542-81b4-408d-9a12-23e894671c4e",
                                                "sense_id": "7acf23d6-c1ca-3a34-aabd-dbe4ab99a027",
                                                "text": "D’après les données statistiques reçues de source officielle, la nouvelle récolte dans le goubernia de Nikolaiew est fort loin de satisfaire les besoins de la population en nourriture, semences et fourrages pour le bétail et présente un manque de 8.789.000 pouds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff45c1e4-e90a-4701-9657-36e66f5523e4",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
                        "target_lang_word": "Gubernia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ff93c684-0847-44ef-b7c6-f99395661542",
                        "source_entry_id": "a9859598-e874-3a00-a848-fa4cae4c6cba",
                        "source_sense_id": "28f939f2-74f0-345e-9730-9a1d6218b9d3",
