                        "examples": [
                            {
                                "example_id": "46698f0e-5204-47b5-ab71-bb7d16289943",
                                "sense_id": "1ad2e134-d715-339c-bf33-597e9c88d2f2",
                                "text": "„Er dachte wieder an die Bierwerbung.“"
                            },
                            {
                                "example_id": "970a6b1a-d5bb-429a-badc-b9c69c2ff673",
                                "sense_id": "1ad2e134-d715-339c-bf33-597e9c88d2f2",
                                "text": "„Vom Friedhofseingang am höchsten Punkt des Hügels sieht man einen Großteil der Skyline Baltimores: das Trade Center, das Gebäude der USF&G-Versicherung, das Hochhaus der Maryland Bank. Die steinernen Türme von Mobtown, wie Baltimore oft genannt wird, die Harbor City, das Land des guten Lebens, wie es in der Bierwerbung so schön heißt, und der einzige Ort, an dem es sich zu leben lohnt, wie die Einheimischen gerne sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
