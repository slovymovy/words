                        "sense_id": "3c2a1c5b-ddb8-360c-ae87-b9345cba97a9",
                        "entry_id": "fadb5325-657b-3026-b035-5e00f7051354",
                        "glosses": [
                            "zonder dat er ook maar iets anders bij zit om het te verdunnen"
