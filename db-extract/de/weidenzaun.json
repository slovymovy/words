                                "example_id": "f8e61ec4-6ac1-4a15-a841-a893a7c136d8",
                                "sense_id": "97998723-fcad-31d8-9ad6-b6c9f228f7c7",
                                "text": "„Eine blaue Socke hing in einem nahen Weidenzaun, noch immer ist unklar, wem sie gehörte.“"
                            }
