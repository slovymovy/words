                ],
                "translations": [
                    {
                        "translation_id": "a5849c53-308b-49f4-8963-1054fbda7b7e",
                        "source_entry_id": "b3c33f59-286c-39b1-a9bd-e5626d863200",
                        "source_sense_id": "c3b53a12-471a-34ff-8151-63e9c1fcfee1",
                        "target_lang_word": "Wehrmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wehrmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31ae05a9-e10b-3f46-af35-18c62a423d01",
                                        "entry_id": "2f7ccf3a-c4bd-35c6-8a1f-ed5abd9e0b72",
                                        "glosses": [
                                            "Gesamtheit aller Streitkräfte"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df4a7f2-50e7-4bce-9b2c-7c7426c897e8",
                                                "sense_id": "31ae05a9-e10b-3f46-af35-18c62a423d01",
                                                "text": "Bei Waterloo wurde die Napoleonische Wehrmacht besiegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                        "entry_id": "2f7ccf3a-c4bd-35c6-8a1f-ed5abd9e0b72",
                                        "glosses": [
                                            "Gesamtheit aller Streitkräfte im Deutschen Reich ab 1935 (die Reichswehr wurde in Wehrmacht umbenannt) bis zur Gesamtkapitulation 1945 bzw. 1946 der offiziellen Auflösung (kein Plural)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a274205-8967-4945-b63f-7c64672c34db",
                                                "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                                "text": "„Bis Mitte 1941 wurde der noch auf Europa beschränkte Konflikt von der Wehrmacht vorwiegend als Eroberungskrieg geführt.“"
                                            },
                                            {
                                                "example_id": "88629fd4-3004-4764-baf2-9875aecbf444",
                                                "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                                "text": "„Ich hatte einen polnischen Großvater, der auf den Namen Tarkowski hörte und während des Zweiten Weltkrieges Zwangsarbeiter in Deutschland war; ich habe einen deutschen Großvater, der Botta hieß und zur selben Zeit für die Wehrmacht an der Ostfront kämpfte.“"
                                            },
                                            {
                                                "example_id": "bf539ec8-96d4-432e-ba53-1244300a1061",
                                                "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                                "text": "„Die deutsche Wehrmacht hat mit aller Kraft versucht, die Stadt zu halten.“"
                                            },
                                            {
                                                "example_id": "51222d57-24a8-4fa3-9a33-cea333976711",
                                                "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                                "text": "„In den Jahren 1939/1940 errichtete die deutsche Wehrmacht an dieser Stelle eine Artilleriekaserne, die nach Fertigstellung in ein Lazarett umgewandelt wurde.“"
                                            },
                                            {
                                                "example_id": "f5772a9d-987c-4749-a50a-bcec2af6b465",
                                                "sense_id": "cfefe099-1c44-3a20-8230-0fac7ff32d84",
                                                "text": "„1938 wurde die Spanische Reitschule der deutschen Wehrmacht eingegliedert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87b79f13-3fa5-4f7f-93d2-ebef40a08b04",
                        "source_entry_id": "b3c33f59-286c-39b1-a9bd-e5626d863200",
                        "source_sense_id": "c3b53a12-471a-34ff-8151-63e9c1fcfee1",
                        "target_lang_word": "army",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "army",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab68b2b-e9e1-4a84-99c5-4078db97f7e8",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "An army never can be commanded or controlled by civilians."
                                            },
                                            {
                                                "example_id": "51a6749c-e3f9-470a-8c41-f224df6c3f8f",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "The army was sent in to quell the uprising."
                                            },
                                            {
                                                "example_id": "19c28783-bbf8-48ab-b2a4-5ab2c14ed225",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "This taut, soldierly, professional story is something of a stranger among American novels about war making. Angry civilians have writ ten most of the best fiction on the subject, from “Three Soldiers” through “Catch‐22,” to make the point (with a good deal of literary overkill) that wars are mass insanity and that armies are madhouses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788b475b-f6b1-354b-99cb-269bbb3271c3",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations.",
                                            "Used absolutely for that entire branch of the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee373808-9281-4fe8-a670-35bed4f729b8",
                                                "sense_id": "788b475b-f6b1-354b-99cb-269bbb3271c3",
                                                "text": "The army received a bigger share of this year's budget increase than the navy or air force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985d988e-d99d-39be-b4a6-74fe457de1f6",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations.",
                                            "Within a vast military, a very large tactical contingent (e.g. a number of divisions)."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139361a7-cc6d-4578-8bdd-fe1aa8ec3762",
                                                "sense_id": "985d988e-d99d-39be-b4a6-74fe457de1f6",
                                                "text": "The Fourth Army suffered such losses that its remainders were merged into the Second Army, also deployed on the Western front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5e14e3-46b3-3a47-b4e2-5f452237365c",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "The governmental agency in charge of a state's army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083a6792-4619-49d4-bc22-2166a170a1cd",
                                                "sense_id": "ec5e14e3-46b3-3a47-b4e2-5f452237365c",
                                                "text": "The army opposed the legislature's involvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large group of people working toward the same purpose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434d7327-5f8d-48a2-a6dc-b310177a5d32",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "It took an army of accountants to uncover the fraud."
                                            },
                                            {
                                                "example_id": "ae549a28-2e20-47a3-a40a-bc01bbf2f8e8",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "On sunny days the beaches draw armies of tourists of all kinds."
                                            },
                                            {
                                                "example_id": "8d140a33-631a-4ad1-8a51-e8e1c9a42683",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "Mr. Tenev, 33, is now in the hot seat again after Robinhood abruptly curtailed its customers’ trading last week amid a frenzy in stocks such as GameStop, which were driven sky high by an army of online investors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74180c5-d23d-34b9-a3cb-58c360799080",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large group of social animals working toward the same purpose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a360a72-c85a-49d3-aa8a-b1e3a7438ae8",
                                                "sense_id": "f74180c5-d23d-34b9-a3cb-58c360799080",
                                                "text": "Our house is being attacked by an army of ants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f94cb81-b2c9-3151-be29-666f692a6b8a",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "Any multitude."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6ef3da-68f3-4df4-a8d0-e2674eb2cc1c",
                                                "sense_id": "2f94cb81-b2c9-3151-be29-666f692a6b8a",
                                                "text": "There was an army of construction cranes working on building the skyscraper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "The military as a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ffa4567-e5a2-4ae2-bfa1-6d9a212458b3",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "The People's Liberation Army Navy of China."
                                            },
                                            {
                                                "example_id": "92d79fb6-5d0a-4f21-a980-bc3b011de71e",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "The Yugoslav Army consisted of the War Navy, Ground Forces, and Air Force."
                                            },
                                            {
                                                "example_id": "f7a8df7b-76a3-4491-8a31-d0acd38541ca",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "Iran's army consists of the Navy, Ground Forces, and Air Force."
                                            }
                                        ]
