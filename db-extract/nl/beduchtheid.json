                                        "glosses": [
                                            "Sentimiento de sospecha o preocupación de que ocurra algún suceso adverso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a01c41-bb65-4157-97cf-7611a2f7704d",
                                                "sense_id": "b62de254-adf3-3372-9d31-0389cb7d6905",
                                                "text": "Tengo miedo de perder tu amistad."
                                            }
