                                        "glosses": [
                                            "Petit raisin sec, de la variété Vitis vinifera apyrena, noir, doux, sans pépin et au goût intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a8ebc2-afbd-4eba-bf06-57c733f3b411",
                                                "sense_id": "14aa0601-f30c-37e6-8c3d-f78132a6f34a",
                                                "text": "Deux jours plus tard, il commanda du cabillaud aux raisins de Corinthe, et ne put même pas y goûter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
