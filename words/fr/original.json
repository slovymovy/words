    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a88364d-97b8-3644-9ad8-0ac8704fa41b",
                    "sense_definition": "Nouveau, personnel et qui ne ressemble à rien de déjà fait.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nouveaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune créateur a présenté un projet très <w>original</w> pour l'exposition annuelle."
                        },
                        {
                            "text": "Elle trouve toujours une idée <w>originale</w> pour décorer le salon lors des fêtes."
                        }
                    ],
                    "synonyms": [
                        "inattendu",
                        "surprenant"
                    ],
                    "antonyms": [
                        "banal",
                        "déjà vu"
                    ],
                    "common_phrases": [
                        "idée originale",
                        "style original"
                    ]
                },
                {
                    "sense_id": "6c36f2dd-0366-3864-bf68-651fa63daa20",
                    "sense_definition": "Qui émane directement de l'auteur ou de la source, par opposition à une copie ou une reproduction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "authenticite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez fournir le document <w>original</w> pour compléter votre dossier administratif."
                        },
                        {
                            "text": "Le musée conserve la partition <w>originale</w> rédigée par le célèbre compositeur."
                        }
                    ],
                    "antonyms": [
                        "copié",
                        "reproduit"
                    ],
                    "common_phrases": [
                        "texte original",
                        "version originale"
                    ]
                },
                {
                    "sense_id": "c7cfd9c3-4c97-3f26-8600-73c088cca51f",
                    "sense_definition": "Qui se distingue par des manières ou des comportements singuliers, bizarres ou excentriques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "singularite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre voisin est un homme assez <w>original</w> qui porte toujours des chapeaux colorés."
                        },
                        {
                            "text": "Ce personnage <w>original</w> amuse beaucoup les enfants grâce à ses histoires insolites."
                        }
                    ],
                    "synonyms": [
                        "farfelu"
                    ],
                    "antonyms": [
                        "banal"
                    ],
                    "common_phrases": [
                        "personnage original"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26a8e92f-e376-362b-ba01-d337b2392940",
                    "sense_definition": "Document ou objet authentique qui sert ou peut servir de modèle pour des reproductions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "authenticite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardez précieusement l'<w>original</w> chez vous et envoyez une photocopie par courrier."
                        },
                        {
                            "text": "Le tableau exposé dans la galerie est bien l'<w>original</w> et non une simple imitation."
                        }
                    ],
                    "synonyms": [
                        "autographe"
                    ],
                    "common_phrases": [
                        "conserver les originaux",
                        "comparer aux originaux"
                    ]
                },
                {
                    "sense_id": "2a3fd2e8-bb61-32dc-9b18-65ef2ea3d3f8",
                    "sense_definition": "Personne dont le comportement ou la façon de vivre sort de l'ordinaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "singularite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux professeur passe pour un <w>original</w> à cause de ses habitudes étranges."
                        },
                        {
                            "text": "Ne faites pas attention à ses remarques bizarres, c'est un <w>original</w> très sympathique."
                        }
                    ],
                    "synonyms": [
                        "drôle d'oiseau"
                    ],
                    "common_phrases": [
                        "un vrai original",
                        "un grand original"
                    ]
                }
            ]
        }
    ]
}