                "senses": [
                    {
                        "sense_id": "7ddb53a9-ced6-3c45-b793-4fe0806ecac0",
                        "entry_id": "44fc6a7e-88bc-36f1-8d7b-093b8134a59d",
                        "glosses": [
                            "Person, die mit der Durchsetzung gleicher Rechte von Frauen und Männern betreut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020add08-bd7b-4144-9989-270836f902f5",
                                "sense_id": "7ddb53a9-ced6-3c45-b793-4fe0806ecac0",
                                "text": "„Ein Gesetz, das im Thüringer Landtag diskutiert wird, soll ermöglichen, dass auch Männer den \"Job\" eines Gleichstellungsbeauftragten ebenfalls ausüben können.“"
                            },
                            {
                                "example_id": "bb4e6541-d1e1-4fe1-8c10-3126a365033f",
                                "sense_id": "7ddb53a9-ced6-3c45-b793-4fe0806ecac0",
                                "text": "„Ich habe gehört, dass sich die Gleichstellungsbeauftragten mehrerer deutscher Städte in einen neuen Kampf gestürzt haben: Die Ampelmännchen sollen durch Ampelfrauen ersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
