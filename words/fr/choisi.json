                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>choisi</w> un dessert à la fraise pour terminer mon repas.",
