                                "target_senses": [
                                    {
                                        "sense_id": "ae4af231-5ae6-31d9-994f-96f33316f7b6",
                                        "entry_id": "cd644eb9-6550-353a-bec7-55d46ccdf4c0",
                                        "glosses": [
                                            "Système dans lequel on fait dériver des sensations tous les faits psychiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147711b0-7f78-4bc5-83c6-d505c277d9fa",
                                                "sense_id": "ae4af231-5ae6-31d9-994f-96f33316f7b6",
                                                "text": "Le sensualisme de Condillac."
                                            },
                                            {
                                                "example_id": "370c89f1-e425-4428-902b-7a8e91d5ec19",
                                                "sense_id": "ae4af231-5ae6-31d9-994f-96f33316f7b6",
                                                "text": "C’est notre défaut, à nous autres Hollandais. Tu es jeune, que cela te serve de leçon ; — le sensualisme est l’ennemi des grandes choses !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "135ac8c4-8a18-4ad5-a129-4c5b3cdb1b6a",
                        "source_entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
                        "source_sense_description": "doctrine: everything reduces to transformed sensation",
                        "target_lang_word": "sensualismo",
