                        "glosses": [
                            "Danser la contredanse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9caf555-5b08-4bba-b968-26073284d725",
                                "sense_id": "c19c8680-1553-3702-b240-4905aab144af",
                                "text": "Daignez tourner la clef : la bestiole va aussitôt se mettre à contredanser."
                            },
                            {
                                "example_id": "a628904c-492d-4a87-afda-ad55e0866d9d",
                                "sense_id": "c19c8680-1553-3702-b240-4905aab144af",
                                "text": "Puis je la retrouvais les autres soirs ; et au bout de sept ou huit soirées passées, presque tout entières, à contredanser et à polker avec elle, elle m’accordait très facilement le rendez-vous que je lui demandais."
                            }
                        ]
                    }
