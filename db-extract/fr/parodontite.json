                                        "entry_id": "e7e88d32-25bf-3a31-99ea-d99d74bc53ea",
                                        "glosses": [
                                            "een ontsteking van het tandvlees; ontsteking van de weefsels rondom de tand"
                                        ],
                                        "tags": [],
