                        "tags": [
                            "plural"
                        ],
                        "form": "portents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ad704da-f4e2-382d-b7ad-daf7300f73a3",
                        "entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "glosses": [
                            "Something that portends an event about to occur, especially an unfortunate or evil event; an omen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648ff9f3-1209-4b30-959a-107944485f90",
                                "sense_id": "3ad704da-f4e2-382d-b7ad-daf7300f73a3",
                                "text": "It was a portent of things to come."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d229105-54a7-339f-8e90-add653f03af3",
                        "entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "glosses": [
                            "A portending; significance"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956fa17d-7760-4f81-a4aa-e3d54cacec1a",
                                "sense_id": "6d229105-54a7-339f-8e90-add653f03af3",
                                "text": "a howl of dire portent"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d4a8413-ec73-3214-814a-bd320e4d5c1e",
                        "entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "glosses": [
                            "Something regarded as portentous; a marvel; prodigy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4e9488b-6261-488d-9e4b-f93db69eaa58",
                        "source_entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "source_sense_description": "omen",
                        "target_lang_word": "voorteken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorteken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "een min of meer vaag signaal dat aan een gebeurtenis voorafgaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea48fdcc-f8ce-497f-a80b-dc0c3bd04790",
                                                "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                                "text": "De ratten verlaten het schip, dat is een ongunstig voorteken."
                                            },
                                            {
                                                "example_id": "a16b8385-9da2-4165-b732-bf1b70d1f5e6",
                                                "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                                "text": "Maar wij hebben steeds meer energie gestoken in het rationeel doorgronden van natuurlijke gebeurtenissen: er zijn geen voortekenen of openbaringen meer, geen vloeken of profetieën; onze toekomst zal niet in godshuizen maar in laboratoria worden ontsluierd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b899cc-497d-3c9f-901c-fe53c617aa59",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "het voor een getal genoteerde plus- of minteken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8a694f-b97f-4788-8a17-a726aeee8c10",
                                                "sense_id": "b4b899cc-497d-3c9f-901c-fe53c617aa59",
                                                "text": "Negatieve getallen worden genoteerd met het voorteken “-”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08236f5-abd6-3b05-b85f-90833a6626d8",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "een symbool op of tussen de lijnen van een notenbalk dat aangeeft dat vanaf dat punt, de toonhoogte hoger (kruis) of lager (mol) moet zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7f51e9-2af2-41fc-9ff1-978587eac336",
                                                "sense_id": "a08236f5-abd6-3b05-b85f-90833a6626d8",
                                                "text": "Zonder verdere aanwijzingen blijft het voorteken van kracht tot de maatstreep."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voorteken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbc2683-ba1a-39dc-8fe6-ade78b4e15fd",
                                        "entry_id": "0895fff5-9014-3d0a-8492-4008418e6af9",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van voortekenen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bc12d0-547f-4566-8192-2e5b4ee5eee6",
                                                "sense_id": "ecbc2683-ba1a-39dc-8fe6-ade78b4e15fd",
                                                "text": "... dat ik voorteken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c67de7-d282-40d5-a10e-77045a7b5604",
                        "source_entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "source_sense_description": "omen",
                        "target_lang_word": "voorspook",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorspook",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "79a726e7-a5e4-3b0e-ad37-42cb89420890",
                                        "entry_id": "a672d5e3-c312-3981-b4df-9acdde33cb7c",
                                        "glosses": [
                                            "voorspelling, voorteken"
                                        ],
                                        "tags": [],
