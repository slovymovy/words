                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f8d52d-7191-4ce2-a348-ef8e214f8a08",
                                                "sense_id": "72b99be7-9503-3a51-a705-3043c8eb8a16",
                                                "text": "Na podlaze byl by mohl hráti na vrhcáby, tak pravidelně se dle povah a obliby obyvatelů špinavá pole s umytými střídala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310690c1-7a78-3d90-abb7-063ba92f0bd6",
                                        "entry_id": "3ca159ba-caab-3bc1-a0ee-04ce975fb4dc",
