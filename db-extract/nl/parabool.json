                "senses": [
                    {
                        "sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "glosses": [
                            "kegelsnede waarbij het snijvlak parallel loopt met een lijn die aan de kegel raakt en tevens het toppunt snijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cab366e-dd23-4f32-9479-ace3d5ae476c",
                                "sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                                "text": "Als er geen wrijving was en de aarde plat was, dan zou de baan van een kogel een perfecte parabool beschrijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "018249ca-4304-3999-8dc6-ab33b962935c",
                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "glosses": [
                            "de paraboloïde reflector met een zeer sterke richtwerking vooral toegepast voor geluid, warmte, licht en bij antennes voor de hogere zend- en ontvangfrequenties van het radiospectrum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a6fee1-311f-40ab-a47d-77e180e64dd3",
                                "sense_id": "018249ca-4304-3999-8dc6-ab33b962935c",
                                "text": "Een schotelantenne heeft doorgangs een parabool als reflector."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ffbe559-0981-3852-8dfb-6f3e8be3d309",
                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "glosses": [
                            "naam van de antenne met een parabool als reflector"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281a653a-940d-4f15-b682-ed5e1cb87a4d",
                                "sense_id": "7ffbe559-0981-3852-8dfb-6f3e8be3d309",
                                "text": "Een radiotelescoop voor ruimteonderzoek met een enorme parabool."
                            }
                        ]
                    },
                    {
                        "sense_id": "67801840-e41b-368e-b760-c34bee31660c",
                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "glosses": [
                            "een bewoording waarbij iets doelbewust zwakker of onbeduidender wordt voorgesteld dan het in werkelijkheid is"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "25d69e68-b3b0-49c8-ae5b-16be957277d7",
                                "sense_id": "67801840-e41b-368e-b760-c34bee31660c",
                                "text": "Als jij het Concertgebouworkest \"een aardig strijkje\" noemt, dan is dat een parabool, je weet wel beter!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "335e0960-de0a-4d5b-94a5-6c1320bece3b",
                        "source_entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "source_sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                        "source_sense_description": "kegelsnede waarbij het snijvlak parallel loopt met een lijn die aan de kegel raakt en tevens het toppunt snijdt.",
                        "target_lang_word": "Parabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52d73dd2-7c5f-3068-a3d1-9b5d8ab7ab8f",
                                        "entry_id": "115edcca-1b50-383a-a27f-f0cb119cf25a",
                                        "glosses": [
                                            "Menge aller Punkte einer Ebene, die von einem festgelegtem Punkt F (Brennpunkt) und einer festgelegten Leitgeraden l den gleichen Abstand besitzen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81480c92-310f-4185-95c1-78c8b0f97d13",
                                                "sense_id": "52d73dd2-7c5f-3068-a3d1-9b5d8ab7ab8f",
                                                "text": "Eine Parabel entsteht unter anderem durch den Schnitt eines Kegels mit einer Ebene, die parallel zu einer Erzeugenden des Kegels ist."
                                            },
                                            {
                                                "example_id": "9065b46e-5b0d-4a99-b034-e21a6c53f471",
                                                "sense_id": "52d73dd2-7c5f-3068-a3d1-9b5d8ab7ab8f",
                                                "text": "„Der Speer beschreibt eine schöne Parabel und sticht in den Boden.“"
                                            },
                                            {
                                                "example_id": "c83e9515-f011-49d6-8beb-97533ab6c8b9",
                                                "sense_id": "52d73dd2-7c5f-3068-a3d1-9b5d8ab7ab8f",
                                                "text": "„Der Gedanke, daß die Parabel als mathematische Form den Bahnen von geworfenen Körpern zugrunde liegt, gibt ihm entscheidende Anregung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                        "entry_id": "115edcca-1b50-383a-a27f-f0cb119cf25a",
                                        "glosses": [
                                            "ein zu einer Erzählung ausgeweitetes Gleichnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99aa5cb6-43b2-443a-8c80-4e966bcbfb82",
                                                "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                                "text": "Eine besonders bekannte Parabel ist die sogenannte Ringparabel in Lessings „Nathan der Weise“."
                                            },
                                            {
                                                "example_id": "47dc347c-3cf4-4427-8adf-be2085cf5d95",
                                                "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                                "text": "„Sie will anhalten und auf Toilette, und zwar jetzt, einfach zehn Minuten über gar nichts nachdenken und niemanden um sich haben müssen, der ihr mit schlauen Sprüchen und belehrenden Parabeln kommt.“"
                                            },
                                            {
                                                "example_id": "d24e5e57-997f-4c99-9648-1630b448ed98",
                                                "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                                "text": "„Die Lebensgeschichte von Münchhausen ist eine frühe Parabel auf Ruhm, Lüge, Medien und Imageprobleme.“"
                                            },
                                            {
                                                "example_id": "2eaf4310-7c67-4581-840e-e2fe7e31c014",
                                                "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                                "text": "„In seiner Predigt griff der Pfarrer die Parabel von der Rückkehr des verlorenen Sohnes auf - die ich auch selbst bereits zu Hilfe genommen habe - und erklärte, weshalb Narcisse nicht mit diesem zu vergleichen sei.“"
                                            },
                                            {
                                                "example_id": "ca6b407c-6acf-4469-915e-e9ccd070d2f8",
                                                "sense_id": "ab2344c1-c760-3bee-a985-27d26faf8c36",
                                                "text": "„Er kam jetzt schnell zum Ende seiner Parabel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5df3ac56-c85b-4b92-8bf7-9d5cf6809612",
                        "source_entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "source_sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                        "source_sense_description": "kegelsnede waarbij het snijvlak parallel loopt met een lijn die aan de kegel raakt en tevens het toppunt snijdt.",
                        "target_lang_word": "parabola",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parabola",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab58b9d-2846-3c4b-9886-b52c2748f4fd",
                                        "entry_id": "fb20a000-6f45-3884-9bb8-2bfa71edc9b3",
                                        "glosses": [
                                            "The conic section formed by the intersection of a cone with a plane parallel to a tangent plane to the cone; the locus of points equidistant from a fixed point (the focus) and line (the directrix)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a92f43-b1d2-4b51-9fcf-e7a44fbf93b8",
                                                "sense_id": "fab58b9d-2846-3c4b-9886-b52c2748f4fd",
                                                "text": "And it saves his life. As he's buzzing down a curving, narrow canal, a narrow green parabola appears hanging across the water in front of him, suddenly rising out of the water and snapping into a perfectly straight line at neck level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25966dd-de24-36ae-96bf-38d7599937dc",
                                        "entry_id": "fb20a000-6f45-3884-9bb8-2bfa71edc9b3",
                                        "glosses": [
                                            "Synonym of parable."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a61c7328-cef8-48ae-9707-c4ff0c37f4a6",
                        "source_entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                        "source_sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                        "source_sense_description": "kegelsnede waarbij het snijvlak parallel loopt met een lijn die aan de kegel raakt en tevens het toppunt snijdt.",
                        "target_lang_word": "parabole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parabole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbf0de09-678d-3186-88d3-28276c74b744",
                                        "entry_id": "2db94efb-5e01-3027-be21-a475527cb6bc",
                                        "glosses": [
                                            "Allégorie qui abrite une idée morale."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "note": "Il n’est guère usité qu’en parlant des allégories employées dans les textes chrétiens",
                                        "examples": [
                                            {
                                                "example_id": "ffa2b7b3-fc1b-4e34-9f7d-0e6a82067add",
                                                "sense_id": "fbf0de09-678d-3186-88d3-28276c74b744",
                                                "text": "Il truffait ses sermons de paraboles modernes, d'images progressistes, magnifiés par sa verve naturelle et mordante et appuyés par un langage coloré qui choquèrent plus d'une grenouille de bénitier et d'une punaise de sacristie, mais que voulez-vous, il faut s'adapter ou périr, et le père Benoît La Poudrière n'avait aucune intention de baisser les bras face aux temps modernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb81340d-9004-3e5a-bc35-81a76ccf9eed",
                                        "entry_id": "2db94efb-5e01-3027-be21-a475527cb6bc",
                                        "glosses": [
                                            "Récit allégorique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1656443f-759b-3737-bc81-ef0f01e5aa09",
                                        "entry_id": "2db94efb-5e01-3027-be21-a475527cb6bc",
                                        "glosses": [
                                            "Comparaison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34549e7f-d306-38f4-97d0-a3abf0ec37bf",
                                        "entry_id": "2db94efb-5e01-3027-be21-a475527cb6bc",
                                        "glosses": [
                                            "Ligne courbe qui résulte de la section d’un cône quand il est coupé par un plan parallèle à une de ses génératrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772f0a19-0c63-46d6-8e8c-54dbefe2933a",
                                                "sense_id": "34549e7f-d306-38f4-97d0-a3abf0ec37bf",
                                                "text": "Les paraboles sont souvent utilisées en économie."
                                            },
                                            {
                                                "example_id": "f4702d41-2914-420d-8972-a3dbe2f30fba",
                                                "sense_id": "34549e7f-d306-38f4-97d0-a3abf0ec37bf",
                                                "text": "[…] et la nuit n’était troublée que par les brusques paraboles des fusées éclairantes qui montaient aux deux côtés du marécage et, parvenues au sommet de leur courbe, ouvraient leurs cônes blancs et s’épanchaient doucement comme des lys renversés."
                                            },
                                            {
                                                "example_id": "deac700c-67d8-4f35-ba52-ce654e08e272",
                                                "sense_id": "34549e7f-d306-38f4-97d0-a3abf0ec37bf",
                                                "text": "Toute vie signifie, fût-ce celle d'un insecte, et le sentiment de son importance, énorme en tout cas pour celui qui l'a vécue, ou du moins de son unique singularité, augmente au lieu de diminuer quand on a vu la parabole boucler sa boucle, ou, dans des cas plus rares, l’hyperbole enflammée décrire sa courbe et passer sous l'horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d86089d-ef96-3924-a5e7-7dfd10cb166d",
                                        "entry_id": "2db94efb-5e01-3027-be21-a475527cb6bc",
                                        "glosses": [
                                            "Antenne parabolique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1155af58-126a-4677-81f3-1006d0324a94",
                                                "sense_id": "2d86089d-ef96-3924-a5e7-7dfd10cb166d",
                                                "text": "Dans les paraboles utilisées pour la réception de la télévision par satellite, la source est directement reliée à un élément de récepteur, la tête (LNB), qui est en fait un convertisseur de fréquence à faible bruit."
                                            }
                                        ]
                                    }
                                ]
                            },
