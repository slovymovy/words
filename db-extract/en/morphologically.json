    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "06fd36ef-1a0b-3a97-ad50-df2664b3e0d5",
                "word": "morphologically",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71fc54b6-05ad-358e-a7d8-e867c4f294e0",
                        "entry_id": "06fd36ef-1a0b-3a97-ad50-df2664b3e0d5",
                        "glosses": [
                            "With regard to morphology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a052f03-403a-4009-8a2f-310ef5264c9c",
                                "sense_id": "71fc54b6-05ad-358e-a7d8-e867c4f294e0",
                                "text": "Although Roellobryon is morphologically similar to Rhodobryum and Rosulabryum, recent molecular studies suggest that it is closer to Mniaceae than Bryaceae."
                            },
                            {
                                "example_id": "220d6020-547d-4b57-9da1-7e1dfbac4aaa",
                                "sense_id": "71fc54b6-05ad-358e-a7d8-e867c4f294e0",
                                "text": "In a typical lexicalist approach (e.g. Koontz-Garboden 2006), the unmarked lexeme is taken as lexically listed, even if its meaning (as it often does) includes templatic entailments, and the derivational morphology is taken to operate on the underived form to yield the derived form. This is the case not only morphologically, but also semantically."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df682971-fff9-459e-92a4-6c5ce02553f2",
                        "source_entry_id": "06fd36ef-1a0b-3a97-ad50-df2664b3e0d5",
                        "source_sense_id": "71fc54b6-05ad-358e-a7d8-e867c4f294e0",
                        "source_sense_description": "with regard to morphology",
                        "target_lang_word": "morphologiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morphologiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73f82436-cc98-37a0-8b46-c99ed018390f",
                                        "entry_id": "b6d08ab2-09d4-3f9d-b297-1f2c79876ea9",
                                        "glosses": [
                                            "D’une manière morphologique ; relativement à la morphologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6fb216-e2da-4322-8c48-c165495dd884",
                                                "sense_id": "73f82436-cc98-37a0-8b46-c99ed018390f",
                                                "text": "Par la suite, il peut même se désétymologiser, comme un mot formé morphologiquement et s’éloigner de son mot productif."
                                            },
                                            {
                                                "example_id": "1c37f93a-1abd-4fe5-b042-fe74c268788f",
                                                "sense_id": "73f82436-cc98-37a0-8b46-c99ed018390f",
                                                "text": "L’appareil digestif se présente sous forme d'un long tube plus ou moins contourné, le tube digestif, qui s'étend de la bouche à l'anus (…). Il se divise en 5 segments principaux morphologiquement et histologiquement différenciés, et fonctionnellement spécialisés : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "984af32e-2149-4a36-b44a-8217b23fd7cc",
                        "source_entry_id": "06fd36ef-1a0b-3a97-ad50-df2664b3e0d5",
                        "source_sense_id": "71fc54b6-05ad-358e-a7d8-e867c4f294e0",
                        "source_sense_description": "with regard to morphology",
                        "target_lang_word": "morphologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morphologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                        "entry_id": "a1f0309a-6794-3221-97f0-382033c3ec86",
                                        "glosses": [
                                            "die Morphologie (Lehre von den Morphemen und Wörtern) betreffend; den Regeln der Morphologie entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c679a894-0698-4f42-b5da-2439c99a114f",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "Die morphologische Analyse von Wörtern ist Voraussetzung für die Entwicklung von grammatischen Regeln in Flexion, Komparation und Wortbildung."
                                            },
                                            {
                                                "example_id": "e661105b-e665-4f91-bd37-d64d015061d0",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "„Wir stoßen außer den genannten orthographischen und phonetischen noch auf morphologische, semantische und syntaktische Probleme vielfältigster Art, die einer genauen Wortdefinition entgegenstehen.“"
                                            },
                                            {
                                                "example_id": "5cab624e-3133-47aa-aa8a-2e487e68d65d",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "„Erwähnenswerte Ableitungen und Zusammensetzungen werden im Text morphologisch eingeordnet.“"
                                            },
                                            {
                                                "example_id": "89e0d65c-96fa-46be-8c92-9e886d0f152f",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "„Auf der morphologischen, grammatischen und orthographischen Ebene ist die Einheitlichkeit der deutschen Standardsprache stets voll gewahrt geblieben…“"
                                            },
                                            {
                                                "example_id": "23708dfc-c68a-4dc5-bb20-5897514a8b44",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "„Die dabei ins Feld geführten Minimalpaare basieren jedoch auf unterschiedlichen morphologischen Strukturen (…).“"
                                            },
                                            {
                                                "example_id": "2287293c-b51a-465c-8f26-39fc5325969c",
                                                "sense_id": "e61d771c-f3be-328f-b712-f80e7df1a506",
                                                "text": "„Die bisher genannten Eigenschaften machen ein Wort aufgrund von phonologischen, graphematischen oder morphologischen Merkmalen zum Anglizismus, aber Busses Begriff reicht weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
