                    "sense_id": "0fc7f35c-db27-358e-88d4-2756e611b071",
                    "sense_definition": "Happening all the time or repeatedly without stopping.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technology in this field is <w>constantly</w> evolving and improving.",
                            "target_lang_translations": {
                                "ru": "Технологии в этой области <w>постоянно</w> развиваются и совершенствуются.",
                                "tr": "Bu alandaki teknoloji <w>sürekli</w> gelişiyor ve ilerliyor.",
                                "zh": "该领域的科技正在<w>不断</w>演进和完善。",
                                "nl": "De technologie op dit gebied is <w>voortdurend</w> in ontwikkeling en verbetert steeds.",
                                "pl": "Technologia w tej dziedzinie <w>nieustannie</w> ewoluuje i się rozwija.",
                                "de": "Die Technologie in diesem Bereich entwickelt und verbessert sich <w>ständig</w>.",
                                "fr": "La technologie dans ce domaine évolue et s'améliore <w>constamment</w>.",
                                "it": "La tecnologia in questo campo è in <w>costante</w> evoluzione e miglioramento.",
                                "cs": "Technologie v tomto oboru se <w>neustále</w> vyvíjí a zlepšuje.",
                                "es": "La tecnología en este campo está <w>constantemente</w> evolucionando y mejorando.",
                                "ja": "この分野の技術は<w>絶えず</w>進化し、向上しています。",
                                "pt": "A tecnologia neste domínio está <w>constantemente</w> a evoluir e a melhorar."
                            }
                        },
                        {
                            "text": "She is <w>constantly</w> checking her phone for new messages.",
                            "target_lang_translations": {
                                "ru": "Она <w>постоянно</w> проверяет свой телефон в ожидании новых сообщений.",
                                "tr": "O, yeni mesajlar için <w>durmadan</w> telefonunu kontrol ediyor.",
                                "zh": "她<w>总是</w>不停地查看手机是否有新消息。",
                                "nl": "Ze controleert <w>constant</w> haar telefoon op nieuwe berichten.",
                                "pl": "Ona <w>ciągle</w> sprawdza telefon, czekając na nowe wiadomości.",
                                "de": "Sie schaut <w>dauernd</w> auf ihr Handy, um nach neuen Nachrichten zu sehen.",
                                "fr": "Elle vérifie <w>sans cesse</w> son téléphone pour voir si elle a de nouveaux messages.",
                                "it": "Controlla <w>continuamente</w> il telefono in cerca di nuovi messaggi.",
                                "cs": "<w>Pořád</w> kontroluje telefon, jestli nemá nové zprávy.",
                                "es": "Ella está revisando su teléfono <w>a todas horas</w> en busca de nuevos mensajes.",
                                "ja": "彼女は新着メッセージがないか、<w>しょっちゅう</w>携帯電話を確認しています。",
                                "pt": "Ela está <w>constantemente</w> a verificar o telemóvel à procura de novas mensagens."
                            }
                        }
                    ],
