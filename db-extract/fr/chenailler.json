                ],
                "senses": [
                    {
                        "sense_id": "07f2e101-6656-36ee-9f33-a9de4e742746",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Mener une vie précaire et misérable ; littéralement, mener une vie de chien, se donner beaucoup de mal sans obtenir aucun résultat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cff09c80-9324-36c3-971d-8d7679247b1e",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Gronder, engueuler, proprement crier comme un chien. — (Lazăr Șăineanu, Le Langage parisien au XIXᵉ siècle, 1920)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9f34b2db-d462-3305-aedf-ac2b1099240d",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Secouer, tracasser une porte ou une serrure pour l’ouvrir."
                        ],
                        "tags": [
                            "Genève"
                        ],
                        "examples": [
                            {
                                "example_id": "2fa3e941-b5bb-4cc9-ad3f-a89288e92d7f",
                                "sense_id": "9f34b2db-d462-3305-aedf-ac2b1099240d",
                                "text": "Qu’avez-vous tant à chenailler à cette porte ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "375afad1-4cfd-3a11-9f61-f242c5157b55",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Creuser une rigole, raviner, tailler une pièce de bois en chéneau, y faire une rainure."
                        ],
                        "tags": [
                            "Suisse romande"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "074d6ec6-3365-3993-8efb-c4a02058dccb",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Électriser (quelqu'un)."
                        ],
                        "tags": [
                            "Fribourg"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c43e87e-92e3-33e4-a86f-682923e890c6",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Suivre un chenal."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "61a702c0-71ab-4649-b81e-1fc07bc304f6",
                                "sense_id": "1c43e87e-92e3-33e4-a86f-682923e890c6",
                                "text": "II est ouvert au seul vent de Nord-Est, dont il ne peut même recevoir aucun dommage, son entrée étant toute semée de récifs, qui rompent l impétuosité des vagues de la mer, & entre lesquels il faut chenailler avec beaucoup de précaution pour entrer sans toucher."
                            },
                            {
                                "example_id": "3817cceb-3d38-40d0-a9c9-6ad754ed1b57",
                                "sense_id": "1c43e87e-92e3-33e4-a86f-682923e890c6",
                                "text": "Nous ne pensions déjà plus aux misères endurées dans les rapides et dans les petites rivières, où nous avions si souvent exercé notre patience, soit pour éviter les écueils, soit pour chenailler comme disent les canotiers, lorsque l’eau était peu profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f654ef-1e82-33aa-9714-8dc05e3333e0",
                        "entry_id": "46a4e71a-2796-322d-9e98-d7c4c3c0f4a4",
                        "glosses": [
                            "Battre à coups de fouet ou de bâton, comme on fouette ou bat les chiens, donner une volée de coups."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
