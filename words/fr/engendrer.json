{
    "word_family": [
        "engendrement",
        "inengendré"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7413d54d-1e70-3815-b4da-79b8bcc4c0e7",
                    "sense_definition": "Causer, susciter ou être la source directe de l'apparition de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "causalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette crise économique risque d'<w>engendrer</w> des tensions sociales importantes dans tout le pays."
                        },
                        {
                            "text": "Le manque de communication claire <w>engendre</w> souvent des malentendus inutiles au travail."
                        }
                    ],
                    "synonyms": [
                        "causer",
                        "provoquer",
                        "susciter",
                        "entraîner"
                    ],
                    "antonyms": [
                        "empêcher",
                        "supprimer"
                    ],
                    "common_phrases": [
                        "engendrer des coûts",
                        "engendrer des conflits",
                        "engendrer la méfiance"
                    ]
                },
                {
                    "sense_id": "9716ca44-4573-31cd-baeb-8a31385c3a07",
                    "sense_definition": "Donner la vie à un être de la même espèce par la procréation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques étudient les conditions nécessaires pour que ces animaux puissent <w>engendrer</w> en captivité."
                        },
                        {
                            "text": "Il a toujours refusé d'<w>engendrer</w> des enfants par crainte de leur transmettre sa maladie héréditaire."
                        }
                    ],
                    "synonyms": [
                        "procréer",
                        "concevoir"
                    ],
                    "common_phrases": [
                        "engendrer des enfants",
                        "engendrer une descendance"
                    ]
                },
                {
                    "sense_id": "4076b61a-56df-3dbd-969b-61abd4b71068",
                    "sense_definition": "Décrire ou former une surface ou un solide par le mouvement continu d'une ligne ou d'une figure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rotation d'un rectangle autour de l'un de ses côtés <w>engendre</w> un cylindre droit."
                        },
                        {
                            "text": "Une droite en mouvement régulier dans l'espace peut <w>engendrer</w> une surface conique."
                        }
                    ],
                    "synonyms": [
                        "générer"
                    ],
                    "common_phrases": [
                        "engendrer une surface",
                        "engendrer un solide"
                    ]
                },
                {
                    "sense_id": "0c76ec53-f38e-3c10-8fef-060f5eda764a",
                    "sense_definition": "Reproduire sa propre divinité dans une autre personne consubstantielle, au sein de la théologie chrétienne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la théologie chrétienne, le Père <w>engendre</w> le Fils de toute éternité."
                        },
                        {
                            "text": "Le dogme trinitaire affirme que le Verbe est <w>engendré</w> et non pas créé."
                        }
                    ]
                }
            ]
        }
    ]
}