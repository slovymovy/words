                "senses": [
                    {
                        "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                        "entry_id": "ef093de1-ac30-3489-85de-ff976ae7f38d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e2216c-df0a-42c7-b935-65c7a2c9edd5",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Frau Theissen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "84389328-699a-4994-a2dd-02b98b44f4d4",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Herr Theissen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a98cb50c-82a6-444f-b4bd-a2188638a9b7",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Die Theissens fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "5bafc000-1590-49e6-8bac-d0bc291e153d",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Der Theissen trägt nie die Pullover, die die Theissen ihm strickt."
                            },
                            {
                                "example_id": "2f44a2aa-12d9-43c7-83fa-45390d36347f",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Theissen kommt, geht der Herr Theissen.“"
                            },
                            {
                                "example_id": "3093528c-d6f6-42e2-a609-35224aacb457",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Theissen kommt und geht."
                            },
                            {
                                "example_id": "17ebb926-7373-4d53-9a23-265dbe2010d2",
                                "sense_id": "8feaf322-7112-3d28-a0e3-fb475ecc5841",
                                "text": "Theissens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
