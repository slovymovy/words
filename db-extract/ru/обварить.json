                "translations": [
                    {
                        "translation_id": "29d40325-d97a-42df-9c38-32f77e3e2a8d",
                        "source_entry_id": "064d0df0-ab14-32d7-98b3-b810c7c39eef",
                        "source_sense_description": "облить, обдать кипятком",
                        "target_lang_word": "échauder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échauder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26d9fd64-a41e-3b1a-aa52-72eead996065",
                                        "entry_id": "8ba6df28-2d52-3273-a0e0-70c21036221f",
                                        "glosses": [
                                            "Passer un objet à l’eau chaude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0277bf68-917a-425a-8416-39c9dc469ed8",
                                                "sense_id": "26d9fd64-a41e-3b1a-aa52-72eead996065",
                                                "text": "Échauder un pot de terre, une théière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8331c69d-903d-3a19-b645-4edda9658d5f",
                                        "entry_id": "8ba6df28-2d52-3273-a0e0-70c21036221f",
                                        "glosses": [
                                            "Passer un objet à l’eau chaude.",
                                            "Arroser (ou faire tremper) un aliment dans de l’eau bouillante pour souvent l’éplucher plus facilement, l’émonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899c47f3-ab6a-41a1-893e-19ad821595fb",
                                                "sense_id": "8331c69d-903d-3a19-b645-4edda9658d5f",
                                                "text": "Pour ôter la peau de la tomate ou de l’amande, il faut l’échauder."
                                            },
                                            {
                                                "example_id": "0fbd3a8b-633f-4c78-acf2-fc98f05c7159",
                                                "sense_id": "8331c69d-903d-3a19-b645-4edda9658d5f",
                                                "text": "On peut échauder une volaille pour la plumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                        "entry_id": "8ba6df28-2d52-3273-a0e0-70c21036221f",
                                        "glosses": [
                                            "Brûler par l’action d’un liquide bouillant, ébouillanter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb93607f-fc93-4c20-9408-54f7b9f27bf8",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "De l’huile bouillante m’est tombée sur la jambe et me l’a tout échaudée."
                                            },
                                            {
                                                "example_id": "d30a0f1f-5baa-4a55-b22e-8215c380906a",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "Elle s’est échaudée, en voulant retirer la marmite du feu."
                                            },
                                            {
                                                "example_id": "92082ec0-c3c2-4d55-b4e9-eb30c5eb0b4d",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "Comme le supplicieur d’Orléans qui faisait bouillir les faux-monnayeurs et repoussait de la pique ceux qui venaient surnager, Ambroise Paré faisait échauder vivants deux petits chiens dans l’huile de lys."
                                            },
                                            {
                                                "example_id": "9f8fd7ab-bfb0-450f-9a7e-85f6d75fb9aa",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "“T’es pas fou, non ? Un peu plus, tu m’échaudais la main !”"
                                            },
                                            {
                                                "example_id": "099647bf-2c28-473c-8877-541c365977db",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "Le chevreau s’en approcha et recula très vite après s’être échaudé le museau et avoir aspiré une âcre odeur de fumée qui le fit tousser."
                                            },
                                            {
                                                "example_id": "75829c4a-eddf-4cc1-83b2-6c0f068481e1",
                                                "sense_id": "2139900f-b273-3b09-b6a6-e3e66a32aeed",
                                                "text": "(...), il faut donc tuer le ver dans le cocon. La méthode habituelle, c’est de l’échauder, ce qui permet de faire fondre la séricine (la colle qui maintient le fil en forme de cocon), ainsi que de produire une petite friandise bouillie à l’intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62af0428-8929-3665-abb1-692efcdc2962",
                                        "entry_id": "8ba6df28-2d52-3273-a0e0-70c21036221f",
                                        "glosses": [
                                            "Rendre méfiant à cause d'une déception, d’un accident."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc97f807-3c38-49d9-8a51-9c64abe35f4e",
                                                "sense_id": "62af0428-8929-3665-abb1-692efcdc2962",
                                                "text": "Sans doute également Thelonius avait-il été échaudé par son passage chez Prestige, et devenait particulièrement sensible à tout ce qui, chez un producteur, lui rappelait l’idée d’un profit qui se fait sur son dos."
                                            },
                                            {
                                                "example_id": "1bb4839f-b8f8-46ef-956c-1c8961cfe680",
                                                "sense_id": "62af0428-8929-3665-abb1-692efcdc2962",
                                                "text": "La défense de Trump reposait sur la thèse d’une manifestation spontanée d’honnêtes citoyens où se seraient glissés quelques partisans échaudés et des « antifas » déguisés en trumpistes."
                                            },
                                            {
                                                "example_id": "1daad63b-e8d9-48ab-86d9-4d0f37bc0fd2",
                                                "sense_id": "62af0428-8929-3665-abb1-692efcdc2962",
                                                "text": "Chat échaudé craint l’eau froide."
                                            },
                                            {
                                                "example_id": "29426ba7-8e4f-4177-95c5-ade32f13572c",
                                                "sense_id": "62af0428-8929-3665-abb1-692efcdc2962",
                                                "text": "Il ne s’engagera plus dans de pareilles affaires, il y a été échaudé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "échauder",
                                "target_lang_code": "fr",
