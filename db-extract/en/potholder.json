                        "source_sense_id": "867cfada-1265-3b7a-b374-1752d377a961",
                        "source_sense_description": "insulated pad for handling hot cooking utensils",
                        "target_lang_word": "manique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8735c76-8517-3014-a478-00a13e12a243",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Gant ou demi-gant que certains ouvriers, ou sportifs se mettent à la main, pour la protéger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d7fdcae-2a6f-3607-93b7-ba9c8d651a4f",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Gant ou pièce d’étoffe épaisse utilisé en cuisine pour manipuler les casseroles et plats brûlants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0480515c-07ac-41ff-abfa-cd76f6711aa0",
                                                "sense_id": "2d7fdcae-2a6f-3607-93b7-ba9c8d651a4f",
                                                "text": "Et il m’enverrait des maniques ou des dessous-de-plat ou je ne sais quel grotesque ustensile brodé, sur lequel on verrait sa maison, et une belle grange fraîchement peinte, avec la petite silhouette d’un solide jeune garçon, mon garçon à moi, en train de passer le rouleau. — (Daniel Nayeri, Coco et Cloclo, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 322)"
                                            },
                                            {
                                                "example_id": "2277c908-80c6-4616-86d6-adfbcde99729",
                                                "sense_id": "2d7fdcae-2a6f-3607-93b7-ba9c8d651a4f",
                                                "text": "Les maniques avec lesquelles elle empoignait les casseroles en fonte étaient imprégnées de graisse, sans doute parce qu’elles avaient un anneau en bois qu’on s’interdisait de mettre à la machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14eb78b7-9404-3d98-a80e-9b406604d5c7",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Manche dont s’aident les ouvriers."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76955971-6efd-3579-9e7c-7efcd5fe748e",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Longue et large manche de vêtement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db3cae4-e23e-4e37-bf7f-d942bfab8747",
                                                "sense_id": "76955971-6efd-3579-9e7c-7efcd5fe748e",
                                                "text": "Il était maintenant allongé, les coudes appuyés sur le lit du canal, le visage collé à la surface de l’eau, ses amples maniques flottant comme des voiles naufragées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16962eee-6edc-37d4-b95b-76b55dea1b2b",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Pièce d’armure couvrant la main et l’avant-bras."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d53a5be-9f44-3f76-8b2b-083b69f07069",
                                        "entry_id": "890c3223-27ac-35b7-9599-2c3e7d88d4fd",
                                        "glosses": [
                                            "Autre orthographe de manicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dbbbedf-a9ad-4b27-ba08-0e334835416e",
                        "source_entry_id": "0e62aece-a737-372d-a531-be70ad6cae14",
                        "source_sense_id": "867cfada-1265-3b7a-b374-1752d377a961",
