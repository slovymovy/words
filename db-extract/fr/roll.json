                ],
                "senses": [
                    {
                        "sense_id": "2a1dba64-2b21-3cf5-9577-d48dcf330abd",
                        "entry_id": "8d81a276-5b1d-3386-899a-c1fa78e0f633",
                        "glosses": [
                            "Chariot à quatre roulettes fermé par des grilles servant à transporter des marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0481fb08-11c1-4bb7-ba98-f62deef987a2",
                                "sense_id": "2a1dba64-2b21-3cf5-9577-d48dcf330abd",
                                "text": "Un roll est un casier sur roulettes permettant de livrer divers types de produits."
                            },
                            {
                                "example_id": "ea5c2ce6-a149-4d27-8f4f-74ab31cc1dcc",
                                "sense_id": "2a1dba64-2b21-3cf5-9577-d48dcf330abd",
                                "text": "Un film plastique est tendu sur un ensemble de marchandises (le plus souvent sur palette ou dans un roll) puis exposé à une source de chaleur. L’action de la chaleur fait se rétracter le film, ce qui permet de solidariser les marchandises entre-elles."
                            }
                        ]
                    },
                    {
                        "sense_id": "a949d62f-22b9-31a8-9742-785e3354f5b9",
                        "entry_id": "8d81a276-5b1d-3386-899a-c1fa78e0f633",
                        "glosses": [
                            "Support, bobine nue, destinée à recevoir du fil. Ce nom est aussi celui de la bobine pleine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07453e5a-8df5-47a1-abf8-e4e810ccd5e5",
                                "sense_id": "a949d62f-22b9-31a8-9742-785e3354f5b9",
                                "text": "Pendant qu’une bobine s’enroule sur ce qu’on appelle un roll, le rollseur place la suivante et noue les bouts."
                            },
                            {
                                "example_id": "873c9c52-870a-423b-a8ea-72d94127891b",
                                "sense_id": "a949d62f-22b9-31a8-9742-785e3354f5b9",
                                "text": "À partir des bobines obtenues sur les métiers à filer on obtient sur des machines dites rollseuses, les « rolls », des bobines de cinq kilos de fil qui serviront à confectionner la chaîne. L’ouvrière qui travaille sur ce poste porte le même nom de rollseuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f092919-8efb-3422-95e8-8f4528efe3f0",
                        "entry_id": "8d81a276-5b1d-3386-899a-c1fa78e0f633",
                        "glosses": [
                            "Dans le domaine de l’emballage nom donné à un gros rouleau destiner à emballer (rouleau de papier, de film étirable, etc.)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
