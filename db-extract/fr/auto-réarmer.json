                        "glosses": [
                            "Se réarmer automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e4a9f9-e471-4501-a27f-f52eb31f1f56",
                                "sense_id": "e03db005-cfac-358a-88bc-0066c31b07a8",
                                "text": "L’indicateur d’alarme sur le détecteur peut être programmé par l’intermédiaire de cavalier ^([sic]) à l’intérieur de celui-ci pour mémoriser ou pour s’auto-réarmer."
                            },
                            {
                                "example_id": "4aa16508-94f8-43a8-be8c-26cff3496cab",
                                "sense_id": "e03db005-cfac-358a-88bc-0066c31b07a8",
                                "text": "Le SVD (Snayperskaya Vintovka Dragunova) ou plus communément appelé Dragunov, fut créé en réponse à la demande soviétique, dans les années 50, d’un fusil de sniper capable de s’auto-réarmer (ou semi-automatique si vous préférez)."
                            },
                            {
                                "example_id": "54d189c1-95a3-49cb-a71e-164b51a30c44",
                                "sense_id": "e03db005-cfac-358a-88bc-0066c31b07a8",
                                "text": "On peut imaginer à partir de ça un piège qui ne peut être désamorcé que pendant un temps limité car pouvant s’auto-réarmer."
                            }
                        ]
                    }
