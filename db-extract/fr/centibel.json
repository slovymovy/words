                        "glosses": [
                            "Unité de mesure de grandeurs logarithmiques du Système international (SI), valant 10⁻² bel, et dont le symbole est cB."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ddb93445-7255-41fe-9e0c-aed4b415aaf4",
                                "sense_id": "b6fd5bdf-f284-33eb-86cb-8ed70e155b1e",
                                "text": "Le centibel exprime les rapports entre grandeurs de même espèce : cent centibels signifient un rapport dont le logarithme décimal est l’unité (100 cB → 10:1) ; un centibel signifie un rapport dont le logarithme décimal vaut 0,01 (1 cB → 10^(0,01):1 ≈ 1,0233:1)."
                            }
                        ]
                    }
