                    "sense_definition": "Initialism of National Association of Broadcasters",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>NAB</w> represents the interests of radio and television stations across the country.",
                            "target_lang_translations": {
                                "cs": "Organizace <w>NAB</w> zastupuje zájmy rozhlasových a televizních stanic v celé zemi."
                            }
                        },
                        {
                            "text": "Industry leaders gathered at the annual <w>NAB</w> conference to discuss new broadcasting technologies.",
                            "target_lang_translations": {
                                "cs": "Lídři v oboru se sešli na výroční konferenci <w>NAB</w>, aby diskutovali o nových vysílacích technologiích."
                            }
                        }
                    ],
                    "target_lang_definitions": {
