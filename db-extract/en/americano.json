        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bd08cbda-9220-3cc8-9ea0-bc40ac702302",
                "word": "americano",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "46053f47-20c5-4040-81d6-a916d023a02b",
                        "entry_id": "bd08cbda-9220-3cc8-9ea0-bc40ac702302",
                        "tags": [
                            "plural"
                        ],
                        "form": "americanos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96dcd246-b224-3c09-a1bc-d22d802b2ddc",
                        "entry_id": "bd08cbda-9220-3cc8-9ea0-bc40ac702302",
                        "glosses": [
                            "A drink made of espresso coffee diluted with hot water."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ade7152d-cc97-4d03-b110-bc7b5a1bdc19",
                                "sense_id": "96dcd246-b224-3c09-a1bc-d22d802b2ddc",
                                "text": "“No, the coffee. Do you want a cup of Americano?” I groaned. Welcome to Europe. “Can't I just get a cup of regular coffee? A little cream, a little sugar?” […] “An Americano is a shot of espresso with hot water added.” “I don't know why they call it Americano. No one in America drinks espresso and hot water.”"
                            },
                            {
                                "example_id": "e784139a-696d-48f5-b264-ca16d7a20a4a",
                                "sense_id": "96dcd246-b224-3c09-a1bc-d22d802b2ddc",
                                "text": "And he drank americano. That was interesting. Was he lactose intolerant or did he simply prefer his coffee black?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3b109dbc-903e-3fd4-a4f2-b9cd827ee860",
                        "entry_id": "bd08cbda-9220-3cc8-9ea0-bc40ac702302",
                        "glosses": [
                            "A cocktail made with Campari, sweet vermouth, and club soda."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a144e5ee-096b-49c7-b006-2c504ab691ac",
                                "sense_id": "3b109dbc-903e-3fd4-a4f2-b9cd827ee860",
                                "text": "The waiters wore striped waistcoats and green baize aprons. Bond ordered an Americano and examined the sprinkling of overdressed customers, mostly from Paris he guessed, who sat talking with focus and vivacity, creating that theatrically clubbable atmosphere of l'heure de l'aperitif."
                            },
                            {
                                "example_id": "e62547cb-a2d2-4c30-8cab-0319d3be3b45",
                                "sense_id": "3b109dbc-903e-3fd4-a4f2-b9cd827ee860",
                                "text": "An Americano is made of Campari, sweet vermouth, and soda water over ice in a highball glass. […] The drink was so popular among Americans visiting Italy at the turn of the last century that it was named after them."
                            }
                        ]
                    }
                ],
                "translations": [
