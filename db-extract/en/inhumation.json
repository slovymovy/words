                "senses": [
                    {
                        "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                        "glosses": [
                            "The act of burial."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebb48398-2645-4913-bfec-fedabc8b4bf1",
                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                "text": "\"Cremation versus Inhumation\" was the subject considered at the meeting of the Nineteenth Century Club at the residence of Mr. Courtlandt Palmer, No. 117 East One Hundred and Seventeenth-street, last evening."
                            },
                            {
                                "example_id": "412ff7ba-44bc-49c0-83fb-801ce7e467a6",
                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                "text": "Stampolidis's team has unearthed three types of Iron Age burials at Orthi Petra . . . dating from the ninth to the seventh century B.C.: pithos (large ceramic jar) burials, cremations, and basic inhumations."
                            }
                        ]
                    },
                    {
                        "sense_id": "d83e7b0b-58f9-3509-bafc-d3f1defaadb2",
                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                        "glosses": [
                            "The act of burying vessels in warm earth in order to expose their contents to a steady moderate heat; the state of being thus exposed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "81d5c293-4708-3a47-904b-1f4c62eb4281",
                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                        "glosses": [
                            "Arenation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54f2843a-54fe-4670-a7d5-2a096704d51c",
                        "source_entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                        "source_sense_description": "The act of burial",
                        "target_lang_word": "inhumation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhumation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                                        "entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                                        "glosses": [
                                            "Action d’inhumer."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "note": "Il se dit surtout dans la langue administrative",
                                        "examples": [
                                            {
                                                "example_id": "51cc1342-fde5-4da1-8c65-fab63be931d3",
                                                "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                                                "text": "Dans la même tombe, les deux modes de sépulture sont représentés, l’inhumation et la crémation."
                                            },
                                            {
                                                "example_id": "d46689a7-2868-4e52-b8aa-b7afd28c3f69",
                                                "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                                                "text": "Le terrain consacré à l’inhumation des morts est cinq fois plus étendu que l’espace nécessaire pour y déposer le nombre présumé des morts qui peuvent y être enterrés chaque année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
