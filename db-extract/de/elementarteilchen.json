                                    {
                                        "sense_id": "b5462002-492b-3503-92bd-88828bbc40e5",
                                        "entry_id": "a9a4fd34-0ddb-317b-bb5f-cd1baa2bd6ba",
                                        "glosses": [
                                            "A fundamental particle; any of the subatomic particles that do not consist of other, smaller particles; the gauge bosons, leptons and quarks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66dcb112-c8b1-460c-8b2e-4dae0523ea75",
                                                "sense_id": "b5462002-492b-3503-92bd-88828bbc40e5",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
