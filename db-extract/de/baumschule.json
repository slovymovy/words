                ],
                "senses": [
                    {
                        "sense_id": "a6d427e1-330f-3a1c-bf25-bc19d633b4cc",
                        "entry_id": "5ae86747-5284-362d-9970-2e25bae8b52c",
                        "glosses": [
                            "Gartenbaubetrieb, der sich auf die Anzucht von Bäumen und Sträuchern spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d2f66c-2bd9-4eda-b4b1-9dc693196c90",
                                "sense_id": "a6d427e1-330f-3a1c-bf25-bc19d633b4cc",
                                "text": "In einer Baumschule kann man mehrere Jahre alte Eichen kaufen und in den eigenen Garten pflanzen."
                            },
                            {
                                "example_id": "2fbcf538-e165-44b8-845d-b21c77db30b0",
                                "sense_id": "a6d427e1-330f-3a1c-bf25-bc19d633b4cc",
                                "text": "„Sie schafften sich zu dem Pritschenwagen einen Ford Kombi an, mit dem Henni die Blumenläden belieferte, während Georg sich um die Baumschule und die Auftragsarbeiten von Privatkunden und Firmen kümmerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23cbb112-5a23-431c-b610-65fb879219da",
                        "source_entry_id": "5ae86747-5284-362d-9970-2e25bae8b52c",
                        "source_sense_id": "a6d427e1-330f-3a1c-bf25-bc19d633b4cc",
                        "source_sense_description": "Gartenbaubetrieb, in dem Bäume und Sträucher gezüchtet werden",
                        "target_lang_word": "tree nursery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0157aaf3-0794-44e8-a0ac-4cc3627a6501",
                        "source_entry_id": "5ae86747-5284-362d-9970-2e25bae8b52c",
                        "source_sense_id": "a6d427e1-330f-3a1c-bf25-bc19d633b4cc",
                        "source_sense_description": "Gartenbaubetrieb, in dem Bäume und Sträucher gezüchtet werden",
                        "target_lang_word": "pépinière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pépinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "294a209a-51df-3a1b-9499-2735d7dae0ef",
                                        "entry_id": "72175638-dde4-3889-9315-a00ac8982b47",
                                        "glosses": [
                                            "Terrain où l’on fait des semis rangés sur une ou plusieurs lignes et qu’on élève jusqu’à ce qu’ils puissent être transplantés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9583e2-75cd-4cd9-9dba-29b6480e2e41",
                                                "sense_id": "294a209a-51df-3a1b-9499-2735d7dae0ef",
                                                "text": "Dans les autres pays on forme les cafeteries en semant la cerise en pépinière ou mieux à demeure, si le quartier est pluvieux."
                                            },
                                            {
                                                "example_id": "241cfe2a-df93-402a-a764-b04c9d91a0a1",
                                                "sense_id": "294a209a-51df-3a1b-9499-2735d7dae0ef",
                                                "text": "Une demi-douzaine de chevaux pâturaient dans des prairies entourées de robustes acacias pris dans les vastes pépinières de l’île Kanguroo."
                                            },
                                            {
                                                "example_id": "f3f399b8-4786-47b8-b5e7-62c9e6ea4473",
                                                "sense_id": "294a209a-51df-3a1b-9499-2735d7dae0ef",
                                                "text": "Le grand avantage du D.D. dans les cultures maraîchères semble être que l’on peut traiter à des doses élevées qui permettent d’obtenir des pépinières bien désinfectées, ce qui empêche une infestation des planches saines par transplantation de plantules déjà infectées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48476e18-6bff-3195-833d-a129d7730000",
                                        "entry_id": "72175638-dde4-3889-9315-a00ac8982b47",
                                        "glosses": [
                                            "Terrain où l’on fait des semis rangés sur une ou plusieurs lignes et qu’on élève jusqu’à ce qu’ils puissent être transplantés.",
                                            "Les végétaux eux-mêmes ^([1])."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                        "entry_id": "72175638-dde4-3889-9315-a00ac8982b47",
                                        "glosses": [
                                            "Lieu où grandissent des individus, où se forment des jeunes gens, où se développent des entreprises, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9702a544-67a2-40a1-8437-1ce1b60d2d87",
                                                "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                                "text": "Les séminaires sont des pépinières pour l’état ecclésiastique."
                                            },
                                            {
                                                "example_id": "4f5ef4cd-d976-4307-a742-effa42834a87",
                                                "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                                "text": "Le Conservatoire est une pépinière de comédiens et de musiciens."
                                            },
                                            {
                                                "example_id": "e38d0d31-79fe-4d50-93ca-022be6e11e05",
                                                "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                                "text": "On admettra qu’une nation vit par le nombre de ses nationaux plutôt que par l’équilibre de ses coutumes : c’est une pépinière, ce n’est pas un édifice."
                                            },
                                            {
                                                "example_id": "9babbe68-a17c-462a-b0d3-f363f15cfe72",
                                                "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                                "text": "Trois jours de privation de vacances sanctionnèrent sa « désastreuse conduite » ; en revanche, il obtenait la deuxième place au classement d’études, derrière le Brestois Braval, bûcheur d’une rare endurance, doué pour le travail manuel, discipliné, sinon servile, bien qu’il eût choisi l’École de Tulle, « cette pépinière de brebis galeuses »."
                                            },
                                            {
                                                "example_id": "c92cfe15-81bc-415a-b96f-36ace04218f2",
                                                "sense_id": "98a0e23f-4d2d-3d44-ae54-367d8e7b4687",
                                                "text": "Outre les infrastructures matérielles classiques, on observe un gonflement de la demande pour de nouveaux types d’investissement destinés à développer la société de l’information, notamment par la mise en place d’une autoroute de l’information, la création de pépinières d’entreprises, de centres d’accès, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5de23f5-e9f4-394c-bc63-09e2dc1823e2",
                                        "entry_id": "72175638-dde4-3889-9315-a00ac8982b47",
                                        "glosses": [
                                            "Trognon d'un fruit, c'est à dire l'endroit où se trouvent les pépins."
                                        ],
                                        "tags": [
                                            "Ouest"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
