                        "target_lang_word": "Brustwarze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brustwarze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                        "entry_id": "b69f060c-98ec-31e7-88ad-528826eb1714",
                                        "glosses": [
                                            "kreisförmige Erhebung auf der Brust, die sich in Form und Farbe von der umgebenden Haut abhebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6780d7-6c98-42a3-8a67-2245fb3ee694",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Flüssigkeitsabsonderungen aus der Brustwarze, auch Galaktorrhoe genannt, können verschiedene Ursachen haben.“"
                                            },
                                            {
                                                "example_id": "010a34a5-d366-477f-bd77-063042a0c260",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Die jeweils zwei männlichen und weiblichen Brustwarzen befinden sich in der Mitte der Brust.“"
                                            },
                                            {
                                                "example_id": "d3599c0f-341f-4d7e-b9b5-3e070862d4ed",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Sie berührte mit der Handfläche seinen Oberkörper, streichelte ihn und zwirbelte leicht seine Brustwarze.“"
                                            },
                                            {
                                                "example_id": "f232eb7a-e849-4d79-8aaf-2a500dfbae98",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Ich strich mit den Fingern durch ihr Haar, liebkoste ihre Ohrmuscheln, ihren Nacken, ergriff ihre Titten und massierte sie sanft, wobei ich bei den Brustwarzen verweilte, bis sie straff herausstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7afea342-78ab-45d7-b594-73bdc119918b",
                        "source_entry_id": "46a19cd4-687e-33d6-91c9-fa50a39a8331",
                        "source_sense_id": "0d1c5423-668a-3ddf-99db-d5702d6543d6",
                        "source_sense_description": "tepel van een zoogdier",
                        "target_lang_word": "Zitze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                        "entry_id": "6b53f215-76e8-3f1e-8085-a9ad72b84bdb",
                                        "glosses": [
                                            "zum Säugen dienendes Organ bei weiblichen Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb191fd-2e94-470d-9f07-608a23ecf548",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "Das Junge bleibt an der Seite der Mutter, bis es eine Zitze gefunden hat."
                                            },
                                            {
                                                "example_id": "ebb0cd9b-3a30-455e-9bb2-244c5d5f6ca2",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "„Oder ich sollte sie an die Zitzen ihrer Mütter legen, wenn sie zu schwach waren.“"
                                            },
                                            {
                                                "example_id": "4243bf43-daf6-4f79-8e74-64ca07dfd5e3",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "„Sie lachte leise, ihr Atem materialisierte sich ins stoßende Bibbern, ihre Zitzen berührten meine Schulter, sie hielt über mir in jener Beugehaltung, die einer braucht, will er gekrümmt dem andern ins Gesicht blicken, vielleicht daß es Spuren zu entdecken gäbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
