                "senses": [
                    {
                        "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                        "entry_id": "8880c5b8-fa36-30fd-b39a-c23d03e86552",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e09ea710-fe3c-41e6-a12a-907fa754b3aa",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Frau Opel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7246d879-109a-4a3d-9274-d020a2105cc4",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Herr Opel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "529e1f88-aaea-440b-85da-2958222947fa",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Die Opels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c58d1841-25e1-49bc-9c88-9801d2a97473",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Der Opel trägt nie die Schals, die die Opel ihm strickt."
                            },
                            {
                                "example_id": "59a71e83-c46e-47ed-b826-64515843a558",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Opel kommt, geht der Herr Opel.“"
                            },
                            {
                                "example_id": "54ca7eba-8907-4a9c-95f7-84738c52d9c0",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Opel kommt und geht."
                            },
                            {
                                "example_id": "99a19b7b-65fc-497a-ac14-a2ef686d87ae",
                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                "text": "Opels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
