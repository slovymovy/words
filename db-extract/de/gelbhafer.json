                ],
                "senses": [
                    {
                        "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                        "entry_id": "b859ee4a-1b44-3362-83b6-2e75868773bd",
                        "glosses": [
                            "bestimmte Hafersorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fbdf32b-717a-48a8-b22c-4a4be53ad765",
                                "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                                "text": "„Gelbhafer ist Hafer von gelber oder gelblicher Farbe.“"
                            },
                            {
                                "example_id": "929b70c9-5b3a-4805-b43b-69c456593b75",
                                "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                                "text": "„Der Gelbhafer ist hervorgegangen aus einer Kreuzung zwischen Leutewitzer Gelbhafer als Muttersorte und Kirsches Pfiffelbacher Weißhafer als Vatersorte des Jahres 1906 mit nachfolgender jährlich fortgesetzter Individualauslese.“"
                            },
                            {
                                "example_id": "e93ab67d-e6d7-4b00-b2dd-8d6bb4a72b0d",
                                "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                                "text": "„In Gegenden mit erfahrungsgemäß starker Fritfliegengefahr verdient jedenfalls der Gelbhafer wegen seiner geringen Anfälligkeit durch die Fritfliege den Vorzug vor allen übrigen Hafersorten.“"
                            },
                            {
                                "example_id": "b995b0df-6504-403e-a0df-a957f78ac7c2",
                                "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                                "text": "„Eine sichere Unterscheidung von Weißhafer und Gelbhafer ist nur mit Hilfe einer Ultraviolett - Bestrahlung möglich, die Spelzen des Weißhafers fluoreszieren d. h. sie leuchten mehr oder weniger deutlich hell bis grünlichweiß , während dieser Leuchteffekt beim Gelbhaferkorn fehlt.“"
                            },
                            {
                                "example_id": "7e866ce4-8109-4925-b656-54ff734e4121",
                                "sense_id": "8c36f72b-6a5a-3871-bebc-8f413eaea495",
                                "text": "„Sehr auffallend ist übrigens auch noch die Tatsache, daß der Gelbhafer durch die Mangangabe in der Gartenerde eine erheblich höhere Körnerzahl zu: erzielen vermocht hat […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
