                                "target_senses": [
                                    {
                                        "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                                        "entry_id": "68dbecfe-cfbc-3366-b7b1-fa33eda614bc",
                                        "glosses": [
                                            "The fear of fear; the fear of developing a phobia."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71ee852-6026-409b-a1f5-645a72a46491",
                                                "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                                                "text": "When Franklin Delano Roosevelt said, \"The only thing we have to fear is fear itself,\" he was describing phobophobia -- the fear of being afraid."
                                            },
                                            {
                                                "example_id": "fe3d5276-4ead-463a-aefd-684c2ab192c8",
                                                "sense_id": "525d6460-065f-3ecf-b3cf-949b91b63a65",
                                                "text": "In particular, the rulemakers – here judges who craft free speech doctrine – may themselves display a pathological fear of succumbing to pathological fear, a kind of phobophobia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
