                "senses": [
                    {
                        "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                        "entry_id": "a7d2dba8-616b-38d9-93fb-4d9a5bcdfe88",
                        "glosses": [
                            "Wörterbuch, in dem die Frequenz, die Häufigkeit, mit der Wörter in einem Textkorpus vorkommen, angegeben wird"
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "68797e91-4683-4623-bcb7-5c2e75a00746",
                                "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                                "text": "In einem Frequenzwörterbuch kann man nachschlagen, welche Wörter besonders häufig oder besonders selten verwendet werden."
                            },
                            {
                                "example_id": "d1ea3ff0-0108-43b3-a8e8-913b872e6a28",
                                "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                                "text": "„Die übrigen Frequenzwörterbücher der deutschen Sprache, die bisher erschienen sind, bauen alle auf heterogenen Materialsammlungen auf.“"
                            },
                            {
                                "example_id": "8ef000f3-3dc0-48df-8b3c-9da0211fe61b",
                                "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                                "text": "In Jahr 2010 wurde das Frequenzwörterbuch von Prof. Đorđe Kostić im Rektorat der Universität Belgrad vorgestellt, das 11 Millionen Wörter der serbischen Sprache enthält."
                            },
                            {
                                "example_id": "790b831d-244b-4d04-b6e4-c998ffe1d09a",
                                "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                                "text": "„Offenbar wurden hier erstmals in der Geschichte der Frequenzwörterbücher überhaupt Computer eingesetzt (…).“"
                            },
                            {
                                "example_id": "8b31cc25-d1c9-4ee3-b215-42ed1e2a9e0f",
                                "sense_id": "bcefebeb-e115-353d-bb58-1366cb6bde7d",
                                "text": "„Die Erstellung dieses Frequenzwörterbuches war methodologisch sicherlich durchdacht…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
