                "senses": [
                    {
                        "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                        "entry_id": "1cbdabd4-e5e7-3a5f-995c-de134df1f28a",
                        "glosses": [
                            "sichergestellte Luftzirkulation in einem Raum oder einem technischen System, bei Gefahrensituation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548b772c-597b-42b8-a11c-16b3d577d43c",
                                "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                                "text": "„Mit einer Notlüftung wird das Überleben der Tiere bei Strom- oder Betriebsausfall gewährleistet.“"
                            },
                            {
                                "example_id": "b7988af7-cfb7-4d47-9d32-dca467e6a2db",
                                "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                                "text": "„Sie kann mit „ja“ beantwortet werden, wenn in diesen Ställen eine funktionierende Alarmanlage und zu öffnende oder selbstöffnende Fenster oder Tore bzw. spezielle Öffnungen (z.B. mit Magnetschaltern) oder eine andere funktionierende Notlüftung vorhanden sind.“"
                            },
                            {
                                "example_id": "54fba1ba-2ff1-4666-bf7e-3731f1fd1c4b",
                                "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                                "text": "„Bei Stromausfall ermöglicht eine Notlüftung manuelles Öffnen der Bremse.“"
                            },
                            {
                                "example_id": "de76817d-c542-44e7-8b5e-ceedafd8623e",
                                "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                                "text": "„Im Vordergrund gut sichtbar sind der elektro-hydraulische Bremsdrücker sowie der Pneumatikzylinder für die Notlüftung der Bremsen.“"
                            },
                            {
                                "example_id": "8a2afa3f-cbbe-4e95-af92-e29d45229444",
                                "sense_id": "2360f67d-9d47-3c24-bd71-663057bca3b7",
                                "text": "„Die Notlüftung ist explosionsgeschützt entsprechend Zone 1 auszuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
