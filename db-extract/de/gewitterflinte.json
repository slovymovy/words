                "senses": [
                    {
                        "sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                        "entry_id": "247d6141-dda0-34b6-b052-86f14301b086",
                        "glosses": [
                            "Regenschirm"
                        ],
                        "tags": [
                            "berlinerisch"
                        ],
                        "examples": [
                            {
                                "example_id": "71735f67-711e-4df6-bf97-1f851fd0639a",
                                "sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                                "text": "Als ich noch rausging, da schien die Sonne. Dumm nur, dass ich den Wetterprognosen nicht traute und keine Gewitterflinte mitnahm — die hätte ich dringend gebraucht, weil mich ein Regenschauer überzog."
                            },
                            {
                                "example_id": "c855d759-8ff8-44f8-baf1-73b39bbb978b",
                                "sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                                "text": "Mutvoll stach er sich mit seiner Gewitterflinte durch den Sturm, und kam noch rechtzeitig bei sich zu Hause an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "567b2799-4957-4fa6-9158-61a54f74193c",
                        "source_entry_id": "247d6141-dda0-34b6-b052-86f14301b086",
                        "source_sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                        "source_sense_description": "berlinerisch: Regenschirm",
                        "target_lang_word": "umbrella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umbrella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "A cloth-covered frame used for protection against rain or sun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4956dfef-3459-4f8b-854c-b209de6138c0",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "Quick, grab that umbrella before you get rained on!"
                                            },
                                            {
                                                "example_id": "3b29080d-9c4e-47a8-890a-643e160fb792",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            },
                                            {
                                                "example_id": "53f1ac8d-27c8-4aed-b7d7-3f735a15de97",
                                                "sense_id": "55e16c13-e9d9-3063-86f1-24b011042661",
                                                "text": "When the [lost property] office first opened, the most frequently lost items were umbrellas. Every white-collar professional carried one, but despite, or because of, that they were easily forgotten about. […] In the 1930s, a quarter of a million umbrellas a year came into the office. Now it's more like 10,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8d1f8a-1d0e-39eb-b6cf-4944aa79cf52",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "Anything that provides similar protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248d0215-4a67-4c25-aa56-35930714bc72",
                                                "sense_id": "bf8d1f8a-1d0e-39eb-b6cf-4944aa79cf52",
                                                "text": "The fighters provide a defensive air umbrella over the battle group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51ac241-858c-361a-af88-897d14cdb3a9",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "Anything that provides similar overarching coverage of a range of concepts, purposes, groups, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b470fed1-2edc-4562-a4a1-9c71765dab34",
                                                "sense_id": "d51ac241-858c-361a-af88-897d14cdb3a9",
                                                "text": "The test facility was established under the umbrella of the company's quality program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b89d348-f691-3c7d-bd7e-bac4bdfdfd41",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "A strategy in which five players in the offensive zone form an umbrella-shaped formation around the opposition's goal net."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a09ed56-baf9-37a4-b116-4d11034ea402",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "The main body of a jellyfish, excluding the tentacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfce3152-e733-4d34-8921-40a066190565",
                                                "sense_id": "7a09ed56-baf9-37a4-b116-4d11034ea402",
                                                "text": "Jellyfish are composed of more than 90% water and most of their umbrella mass is made up of gelatinous material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fff016f-c91f-329a-ba92-b7e8d34a5f8d",
                                        "entry_id": "3f228a0e-39cd-3a55-aa2d-68a5a3b54b90",
                                        "glosses": [
                                            "An umbrella-shaped reflector with a white or silvery inner surface, used to diffuse a nearby light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d3b3fc-bac2-4975-9fb8-6f354e43e430",
                                                "sense_id": "7fff016f-c91f-329a-ba92-b7e8d34a5f8d",
                                                "text": "Using umbrellas for shooting a wedding party is ok, but not necessary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "umbrella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To cover or protect, as if by an umbrella."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3be040c-2aba-4697-8f5a-451a31eff421",
                                                "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                                "text": "Experts with saws and ladders came and lopped off the lower branches. This sent the tree's growth rushing violently to her head in a lush overhanging which umbrellaed the House of All Sorts."
                                            },
                                            {
                                                "example_id": "f5cadffb-c169-4089-8d7c-9ed076fb43a7",
                                                "sense_id": "8006d482-162f-3c80-9ce2-f1e56fa86d58",
                                                "text": "Huge pine and eucalyptus umbrellaed the grounds, airconditioning the morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf2f4091-c2a7-3d84-820f-cc894b06a6c0",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To form the dome shape of an open umbrella."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d6612f6-32b9-4ed6-af7e-cbd47bd8da45",
                                                "sense_id": "cf2f4091-c2a7-3d84-820f-cc894b06a6c0",
                                                "text": "Bright yellow gowns fit them tightly and umbrellaed from their waist to just below the knees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013e0061-8a86-3557-9fdc-65b9507b8c19",
                                        "entry_id": "634349da-ba9b-36f0-ae6b-74b39140540c",
                                        "glosses": [
                                            "To move like a jellyfish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f77de98-dac5-4341-94f5-47cc7aae5927",
                                                "sense_id": "013e0061-8a86-3557-9fdc-65b9507b8c19",
                                                "text": "The light catches the filigreed tendrils and graceful motion of the jellies, their orange bodies umbrella-ing along like fairy parasols come to life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2bf3d5-8071-4084-85f1-3c13349553ce",
                        "source_entry_id": "247d6141-dda0-34b6-b052-86f14301b086",
                        "source_sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                        "source_sense_description": "berlinerisch: Regenschirm",
                        "target_lang_word": "brolly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                        "entry_id": "5838043c-5376-3124-8e89-2da9b5e3c046",
                                        "glosses": [
                                            "Alternative form of brelly."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c7fd19-cd8b-4871-910a-68e2f670f1c5",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "It's going to rain today – you'd better take your brolly."
                                            },
                                            {
                                                "example_id": "ee238ed0-a97f-4bc0-be8e-815891dcd26a",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "“The young lady’s hi,” he said suddenly, holding out the umbrella, “is fixed on this here. I am well aware that it is not for the lowest of the low to carry a gentleman’s brolly, and I ask your ladyship’s pardon for the liberty. I come by it accidental-like, and should be glad of a reasonable offer from any gentleman in want of a honest article.”"
                                            },
                                            {
                                                "example_id": "18161e2d-4865-4f1b-a06c-3f9479d79afd",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "The only brolly that's in sight / Is the mini one that's in my drink / JD, coke and lime / This is how I want to spend my time"
                                            },
                                            {
                                                "example_id": "1f5b9e3f-9398-489e-90e6-ebabbf916e66",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "Look! The Gnome Girl believed the letter you sent and brought the magic brolly! […] Now, we just wait for the Wretch to eat her and we can finally grab it!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14a35866-aa8b-4357-979c-713131051317",
                        "source_entry_id": "247d6141-dda0-34b6-b052-86f14301b086",
                        "source_sense_id": "5dc742ff-0816-3d8a-9c5e-7c5d047be56f",
                        "source_sense_description": "berlinerisch: Regenschirm",
                        "target_lang_word": "parapluie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parapluie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                        "entry_id": "df5b5545-3cb1-39f2-ad35-e28d026e44a3",
                                        "glosses": [
                                            "Abri portatif d’étoffe légère monté sur des baleines, remplacées aujourd’hui par des tiges de métal flexible, et qu’on déploie pour se protéger de la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f8c823-2d72-4439-853d-3639538c76b5",
                                                "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                                "text": "Le parapluie était vraiment confortable pour deux personnes. Sur son dôme de coton distendu, un peu déteint, avec des rayons vert pâle à l’endroit des plis entre les baleines, la pluie tombait avec un bruit mou. Nous étions séparés par la grosse boule du manche."
                                            },
                                            {
                                                "example_id": "fdc2381d-0d5e-47ba-971f-b6d9246de353",
                                                "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                                "text": "Au moment précis où les mouchards accostaient les fugitifs et tendaient la main pour les saisir, Mme Hyde braqua sur eux le volumineux parapluie qu'elle tenait à la main et l'ouvrit subitement; tandis que la surprise clouait sur place les deux hommes, occupés à se dépêtrer de l'énorme dôme de cotonnade bombée, Hyde, à l'abri de ce bouclier improvisé, battait en retraite, jouait des jambes et s'enfonçait en courant dans une rue déserte."
                                            },
                                            {
                                                "example_id": "b4bac1d5-244c-4cb0-96ee-cf9128909c73",
                                                "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                                "text": "D’abord on la prenait pour une simple bruine, un vague crachin que balayerait le premier coup de vent puis, au bout de quelques mètres, on se sentait pénétré d’une humidité froide et collante qui faisait regretter d’avoir renoncé au parapluie."
                                            },
                                            {
                                                "example_id": "cb201381-f4cb-4ee8-a73c-11bda9a5a5ca",
                                                "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                                "text": "La psychanalyse en fut pour ses frais qui vit dans l’accouplement inconfortable de la machine à coudre et du parapluie, sur une table de dissection, un coupable fantasme fornicatoire."
                                            },
                                            {
                                                "example_id": "e611082b-15b2-4b47-81f1-03884170edee",
                                                "sense_id": "77c80345-7bcb-387e-83da-1ba165f001e8",
                                                "text": "Place Saint-Denis, une drache l’accueillit à sa descente. Bien protégés, les passants réfugiés en dessous des auvents transformés pour la cause en abris provisoires, contemplaient le garçon qui accélérait sa marche en maugréant du fait qu'il n’avait, pour une fois, pas emporté de parapluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1de5a2-a6ed-3395-9420-85f2459ec64c",
                                        "entry_id": "df5b5545-3cb1-39f2-ad35-e28d026e44a3",
                                        "glosses": [
                                            "Engin qui servait à la descente et à la remontée des mineurs."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b1ab19-5a44-34ba-8333-9b826efa6dd4",
                                        "entry_id": "df5b5545-3cb1-39f2-ad35-e28d026e44a3",
                                        "glosses": [
                                            "Outil destiné à crocheter les serrures, constitué d’une ébauche de clé, d’où dépassent un certain nombre de tiges coulissantes, destinées à simuler la combinaison de la clé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "761fca27-4e22-3df5-8163-aaf238d494b3",
                                        "entry_id": "df5b5545-3cb1-39f2-ad35-e28d026e44a3",
                                        "glosses": [
                                            "Ce qui permet d’abriter quelqu’un dans une affaire, de le faire échapper aux ennuis."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a8f78fb-acb8-432c-9348-4f0c13f2f774",
                                                "sense_id": "761fca27-4e22-3df5-8163-aaf238d494b3",
                                                "text": "Il va porter plainte. Je ne ferai rien pour le dissuader. Et je te prêterai plus mon parapluie."
                                            },
                                            {
                                                "example_id": "ff343260-70b9-4852-b925-4763b6803cc7",
                                                "sense_id": "761fca27-4e22-3df5-8163-aaf238d494b3",
                                                "text": "Fait intéressant, à niveau socio-éducatif égal, le risque est estimé plus grand par les fonctionnaires (souci d’ouvrir un parapluie au-dessus de leur tête et crainte des réactions médiatiques) et les femmes."
                                            },
                                            {
                                                "example_id": "3e2c8648-6ff6-438f-8668-089b63000692",
                                                "sense_id": "761fca27-4e22-3df5-8163-aaf238d494b3",
                                                "text": "Une institutrice dénonce la lâcheté de son inspecteur, qui passe son temps à « ouvrir le parapluie », qui est incapable d’éteindre les petites querelles, d’arbitrer les conflits entre parents et enseignants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
