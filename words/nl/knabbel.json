{
    "word_family": [
        "knabbelen",
        "geknabbel",
        "knabbelaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fbc2f71-cf2a-3562-be0c-b858b3fbc480",
                    "sense_definition": "een kleine snack of lekkernij om op te eten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou jij nog wat lekkere <w>knabbels</w> voor het feestje van vanavond willen halen?",
                            "target_lang_translations": {
                                "en": "Would you like to get some tasty <w>snacks</w> for the party tonight?"
                            }
                        },
                        {
                            "text": "Tijdens de film hebben we genoten van verschillende hartige <w>knabbels</w>.",
                            "target_lang_translations": {
                                "en": "During the movie, we enjoyed various savory <w>nibbles</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "versnapering",
                        "snack",
                        "tussendoortje"
                    ],
                    "common_phrases": [
                        "hartige knabbels",
                        "lekkere knabbels"
                    ],
                    "target_lang_definitions": {
                        "en": "a small snack or treat to eat"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snack",
                                "target_lang_sense_clarification": "a small amount of food"
                            },
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "a small piece of food to eat"
                            },
                            {
                                "target_lang_word": "treat",
                                "target_lang_sense_clarification": "something special to eat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51146dd8-3a0e-3980-ae37-f778f96d0ed7",
                    "sense_definition": "een kleine beet of het resultaat van een korte hap",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "beet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muis liet een kleine <w>knabbel</w> achter in het stukje kaas op tafel.",
                            "target_lang_translations": {
                                "en": "The mouse left a small <w>nibble</w> in the piece of cheese on the table."
                            }
                        },
                        {
                            "text": "Ik nam een voorzichtige <w>knabbel</w> van het onbekende koekje om het te proeven.",
                            "target_lang_translations": {
                                "en": "I took a cautious <w>nibble</w> of the unknown cookie to taste it."
                            }
                        }
                    ],
                    "synonyms": [
                        "beetje",
                        "hapje",
                        "beet"
                    ],
                    "target_lang_definitions": {
                        "en": "a small bite or the result of a short bite"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "a very small bite"
                            },
                            {
                                "target_lang_word": "bite",
                                "target_lang_sense_clarification": "a small piece taken with the teeth"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a54733c-8890-3270-9ced-958801d98ee5",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>knabbelen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knabbel</w> graag op een wortel terwijl ik aan het werk ben.",
                            "target_lang_translations": {
                                "en": "I like to <w>nibble</w> on a carrot while I am working."
                            }
                        },
                        {
                            "text": "Als ik zenuwachtig ben, <w>knabbel</w> ik vaak onbewust op mijn pen.",
                            "target_lang_translations": {
                                "en": "When I am nervous, I often unconsciously <w>gnaw</w> on my pen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to nibble'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "to eat in small bites (I nibble)"
                            },
                            {
                                "target_lang_word": "gnaw",
                                "target_lang_sense_clarification": "to bite persistently (I gnaw)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9bba1c0-b954-3f3a-8780-e5f58d2bf719",
                    "sense_definition": "gebiedende wijs van <w>knabbelen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Knabbel</w> niet zo luidruchtig op die nootjes als de baby slaapt!",
                            "target_lang_translations": {
                                "en": "Don't <w>nibble</w> so loudly on those nuts while the baby is sleeping!"
                            }
                        },
                        {
                            "text": "<w>Knabbel</w> rustig aan je eten zodat je niet stikt.",
                            "target_lang_translations": {
                                "en": "<w>Nibble</w> quietly on your food so you don't choke."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'to nibble'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "command to eat in small bites"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74edb74d-7ca1-31f9-859d-d621508cd028",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>knabbelen</w> in inversie",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>knabbel</w> je de hele tijd op die droge biscuitjes?",
                            "target_lang_translations": {
                                "en": "Why do you <w>nibble</w> on those dry biscuits all the time?"
                            }
                        },
                        {
                            "text": "<w>Knabbel</w> je altijd op je nagels als je een spannende film kijkt?",
                            "target_lang_translations": {
                                "en": "Do you always <w>bite</w> your nails when you watch an exciting movie?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second person singular present tense of 'to nibble' in inversion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "to eat in small bites (do you nibble)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}