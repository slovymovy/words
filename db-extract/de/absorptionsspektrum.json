                ],
                "senses": [
                    {
                        "sense_id": "1ee3aa0a-d4c1-3066-bc0f-598322ee259b",
                        "entry_id": "003b10fa-5340-3834-931c-4357f9809afd",
                        "glosses": [
                            "elektromagnetisches Spektrum mit dunklen Lücken (Absorptionslinien), die angeben, welche Wellenlängen des Spektrums in einem Stoff aufgenommen (absorbiert) werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99595678-1a9b-4406-92ec-3652741015ca",
                                "sense_id": "1ee3aa0a-d4c1-3066-bc0f-598322ee259b",
                                "text": "„Das Absorptionsspektrum künstlicher Kristalle weicht immer ein wenig von dem echter Edelsteine ab.“"
                            },
                            {
                                "example_id": "f1340a74-8915-44b7-934b-bf450e90692f",
                                "sense_id": "1ee3aa0a-d4c1-3066-bc0f-598322ee259b",
                                "text": "„Will man ein Absorptionsspektrum exakt auswerten, so muß man für jede Wellenlänge des durchfallenden Lichtes die Extinktion bestimmen.“"
                            },
                            {
                                "example_id": "ef28e191-94ea-4d29-bd1c-38baf16db5ec",
                                "sense_id": "1ee3aa0a-d4c1-3066-bc0f-598322ee259b",
                                "text": "„Zum Nachweis und zur Bestimmung von Vitamin B12 in reinen oder konzentrierten Präparaten kann das Absorptionsspektrum herangezogen werden.“"
                            },
                            {
                                "example_id": "c7505ea0-139c-44a6-945e-90fb8f648021",
                                "sense_id": "1ee3aa0a-d4c1-3066-bc0f-598322ee259b",
                                "text": "„Dies zeigt die Abweichung des Wirkungsspektrums vom Absorptionsspektrum im Spektralbereich unterhalb 520 nm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
