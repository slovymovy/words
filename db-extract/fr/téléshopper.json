                        "glosses": [
                            "Téléacheter."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "010ad5e0-e2d5-4fc6-befb-ab5a2cebee73",
                                "sense_id": "39a63bd2-6d73-3c27-8666-76b9c18bf305",
                                "text": "Les femmes au foyer, gobeuses d’infomercial (informations commerciales) téléshoppaient. De jour comme de nuit, les chaînes de télévision offraient à boire et à manger, au sens propre comme au figuré."
                            },
                            {
                                "example_id": "58192dcf-5650-4da1-b094-3f8b013e9e73",
                                "sense_id": "39a63bd2-6d73-3c27-8666-76b9c18bf305",
                                "text": "Vanessa était une caricature de la pom-pom girl qui épouse le capitaine de l'équipe de football américain et qui accouche. Et qui téléshoppe. Et qui accouche. Et qui twitte."
                            }
                        ]
                    }
