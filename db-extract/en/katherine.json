        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7cb86f12-3a9e-3c1d-aead-d3f830e12438",
                "word": "Katherine",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9dd73d5-a697-3699-8866-4dfbf37a3c61",
                        "entry_id": "7cb86f12-3a9e-3c1d-aead-d3f830e12438",
                        "glosses": [
                            "A female given name from Ancient Greek, a popular spelling variant of Catherine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327157ae-413b-4f48-bde0-0db3555085ce",
                                "sense_id": "f9dd73d5-a697-3699-8866-4dfbf37a3c61",
                                "text": "SAVAGE (HENRY) - - - His aim was to appear great in little things, and the gravity with which he discusses the origin, derivation, &c of the name Katherine, whether it should be spelt with a K or a C, at which time the letter k was introduced, and the double l in Balliol, is truly wonderful. - - - By his wife, Lady Mary Sandys, he left issue Henry, Edwin, John, Katherine, and Thomas"
                            },
                            {
                                "example_id": "4e19fb56-a859-42c2-b1cb-b49e13a3c87f",
                                "sense_id": "f9dd73d5-a697-3699-8866-4dfbf37a3c61",
                                "text": "During her childhood she was a romanticized Katherine, dressed by her misty-eyed, fussy mother in dresses that looked like ruffled pillowcases. By high school she'd shed the frills and emerged as a bouncy, round-faced Kathy - - - At university she was Kath, blunt and no-bullshit in her Take-Back-the-Night jeans and checked shirt - - - When she ran away to England, she sliced herself down to Kat. It was economical, street-feline, and pointed as a nail."
                            },
                            {
                                "example_id": "0b647290-a8a7-4f55-967d-32762010f5a6",
                                "sense_id": "f9dd73d5-a697-3699-8866-4dfbf37a3c61",
                                "text": "The county’s top prosecutor, Katherine Fernandez Rundle, accused Artiles at a news conference on Thursday afternoon of paying an old friend almost $45,000 to mount a fake candidacy intended to illegally sway the election."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b4dfacd-d56e-3cb0-9e04-706c01001665",
                        "entry_id": "7cb86f12-3a9e-3c1d-aead-d3f830e12438",
                        "glosses": [
                            "A town and local government area (the Town of Katherine) in the Northern Territory, Australia."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "949a8b4c-c273-3a44-a683-f4da8876e864",
