                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8bea56-7157-4601-a170-f1210480da65",
                                "sense_id": "b92b95cb-0fec-3552-88db-fba304373714",
                                "text": "Het bekerduel tussen eerstedivisieclub Paris FC en Olympique Lyonnais in het Franse bekertoernooi is in de rust, bij een stand van 1-1, stilgelegd na supportersrellen. Op de tribunes werd vuurwerk afgestoken, fans gingen met elkaar op de vuist en betraden in groten getale het veld."
                            },
                            {
                                "example_id": "a0673f6c-1f0f-4ced-8d03-4bc31b9180fa",
                                "sense_id": "b92b95cb-0fec-3552-88db-fba304373714",
                                "text": "Eljero Elia kan na veertien jaar weer wedstrijden gaan spelen voor ADO Den Haag. De 34-jarige aanvaller trainde al twee maanden mee bij de eerstedivisieclub waar hij in 2004 zijn profcarrière begon. Nu heeft hij er ook een contract getekend."
                            },
                            {
                                "example_id": "cfb60548-d865-4679-a9ca-19d0eca111b6",
                                "sense_id": "b92b95cb-0fec-3552-88db-fba304373714",
                                "text": "De Limburgse eerstedivisieclub heeft het contract met hoofdtrainer Jurgen Streppel verlengd tot en met de zomer van 2024. Roda JC heeft Adrie Bogers binnengehaald als assistent-trainer."
                            }
                        ]
                    }
