                        "form": "appréhendables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebf06e18-95eb-3f1d-8713-40194f8abc69",
                        "entry_id": "46ec6d79-d692-3a99-8cde-e704dacf0787",
                        "glosses": [
                            "Qui peut être appréhendé, qui peut être compris."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "61059992-02d6-4e6e-9fef-cb3f1f8570d1",
                                "sense_id": "ebf06e18-95eb-3f1d-8713-40194f8abc69",
                                "text": "« Malgré les circonvolutions qui n’ont pour but que de rendre difficilement appréhendable le coût véritable de “l’impôt Hollande”, son projet ne résiste pas à l’analyse », annonce Nathalie Kosciusko-Morizet dans un communiqué."
                            },
                            {
                                "example_id": "18d001bc-a6d2-4409-b078-b3f74972953e",
                                "sense_id": "ebf06e18-95eb-3f1d-8713-40194f8abc69",
                                "text": "Mais cette réalité est difficilement appréhendable, car il y a d’un côté les chiffres officiels qui dépendent des plaintes déposées par les commerces, et de l’autre, la manière de fonctionner de chaque enseigne face à ce phénomène."
                            },
                            {
                                "example_id": "b71e7211-9667-46fe-a6c9-8e3298fc7501",
                                "sense_id": "ebf06e18-95eb-3f1d-8713-40194f8abc69",
                                "text": "Le réchauffement climatique lié aux gaz à effet de serre intervient aussi comme un modulateur, qui affecte les autres phénomènes météorologiques, qui ne sont appréhendables que de manière statistique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a2815b-6d61-401f-8cc0-00add34ff5e5",
                        "source_entry_id": "46ec6d79-d692-3a99-8cde-e704dacf0787",
                        "source_sense_id": "ebf06e18-95eb-3f1d-8713-40194f8abc69",
                        "target_lang_word": "nachvollziehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachvollziehbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                        "entry_id": "96cc8068-e12a-35de-b3c2-b6b27d791d07",
                                        "glosses": [
                                            "so, dass man die Gründe oder den Werdegang verstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1d026b-0952-48bb-8689-ebcee6853da7",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "Die Aufgabe ist sehr leicht nachvollziehbar."
                                            },
                                            {
                                                "example_id": "6069f216-3b7e-4ec3-aed0-b04aaa114143",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "Sein Verhalten war nicht in Ordnung, aber nachvollziehbar."
                                            },
                                            {
                                                "example_id": "1de608af-6f16-49e9-9d35-abe48987774e",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "„Die Vulkanier sind zudem, in schönem Widerspruch zu ihrem Namen, berühmt für ihren extrem rationalen Charakter, für ihr dogmatisches Beharren auf Faktenevidenz und logisch nachvollziehbaren Entscheidungswegen.“"
                                            },
                                            {
                                                "example_id": "64052349-888d-400d-bf00-b1def87d7501",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "„So nachvollziehbar Huizinga die spielfeindlichen Einflüsse industrieller Marktförmigkeit auf Kunst und Literatur auch aufdeckt, verbirgt sich in seiner Argumentation doch ein innerer Widerspruch: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
