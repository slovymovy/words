                                        "entry_id": "e14c85a0-4aa7-3ef5-a318-3113fd259f67",
                                        "glosses": [
                                            "insaccato preparato solitamente con carne di maiale macinata mista a spezie, lasciato infine a stagionare"
                                        ],
                                        "tags": [
