                "senses": [
                    {
                        "sense_id": "92c33498-b4b4-3db3-b903-fbe73adeb987",
                        "entry_id": "0d0ba3fe-794a-344d-97b9-25679cbbb9b5",
                        "glosses": [
                            "Libérer d’une inféodation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d9d213-a186-4694-be72-5273c930a78a",
                                "sense_id": "92c33498-b4b4-3db3-b903-fbe73adeb987",
                                "text": "Le Marquis de Carabas et la Marquise de Pretintailles, deux petits pamphlets à double but, l'un de dérider la bourgeoisie, l'autre de désinféoder le paysan, sont restés des proverbes de gaieté et de comique dans l'oreille du peuple."
                            },
                            {
                                "example_id": "def83375-21de-4dc8-a999-8c17c7d2b1af",
                                "sense_id": "92c33498-b4b4-3db3-b903-fbe73adeb987",
                                "text": "Fille directe du propriétarisme, engendrée par un principe qui a toujours figuré les bas instincts de l'homme, elle n'a jamais pu se désinféoder de l'élément matériel qui la créa."
                            }
                        ]
                    }
                ],
