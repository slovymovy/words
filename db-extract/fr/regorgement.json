                                "sense_id": "43a91906-06f0-31b0-b2a3-4505b18240f0",
                                "text": "Le regorgement de la rivière a inondé la prairie."
                            },
                            {
                                "example_id": "105caaeb-4c32-4bd1-9083-d36eb62c334c",
                                "sense_id": "43a91906-06f0-31b0-b2a3-4505b18240f0",
                                "text": "Le regorgement de la bile."
                            },
