                "senses": [
                    {
                        "sense_id": "bce17b53-ab1f-35b2-83bf-5cd942cc8bf9",
                        "entry_id": "874b985b-4384-3a3e-abb9-055110e8d22b",
                        "glosses": [
                            "Bande de terre que la charrue ne peut atteindre au pied des rangs de ceps, et que l’herbe peut donc envahir."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "627773a9-a399-4272-9749-2634711e7da2",
                                "sense_id": "bce17b53-ab1f-35b2-83bf-5cd942cc8bf9",
                                "text": "« Avec le développement des chartes de production raisonnée du vignoble, de plus en plus de viticulteurs procèdent à l´entretien mécanique du cavaillon, délaissant le désherbage chimique sur le rang », indique Christophe Gaviglio, de l´ITV de Montpellier."
                            },
                            {
                                "example_id": "c95175c6-bf05-4448-9f36-d52949757a74",
                                "sense_id": "bce17b53-ab1f-35b2-83bf-5cd942cc8bf9",
                                "text": "Les quatre outils ont réussi, à vitesse modérée, à nettoyer efficacement le cavaillon, en s'accommodant plutôt bien de la présence d'herbes hautes et sèches sous le rang."
                            }
                        ]
                    },
                    {
                        "sense_id": "1602f47c-8c8e-306a-ad44-7108dc1734ea",
                        "entry_id": "874b985b-4384-3a3e-abb9-055110e8d22b",
                        "glosses": [
                            "Variété de melon, à la chair orangée et parfumée, que l'on cultive dans le Midi de la France, en particulier dans la région de Cavaillon."
                        ],
