                    {
                        "translation_id": "28059b83-e78c-4a1e-8853-467270d05ba4",
                        "source_entry_id": "eaa74a3a-80e1-3a3a-85f4-413baea1b477",
                        "source_sense_id": "5072ed33-beed-370e-accb-e922e9822b86",
                        "target_lang_word": "blink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "022743df-f1e8-3e19-a7ff-5d432e20b3e8",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce4169d-ac61-48d2-8d30-274d519b3f6b",
                                                "sense_id": "022743df-f1e8-3e19-a7ff-5d432e20b3e8",
                                                "text": "The loser in the staring game is the person who blinks first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae97cbe-e16b-3bd9-9c89-8294d71fddb5",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To close and reopen one's eyes to remove (something) from on or around the eyes."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bb444c-2766-40ab-a899-3cc9070f7dbe",
                                                "sense_id": "eae97cbe-e16b-3bd9-9c89-8294d71fddb5",
                                                "text": "She blinked her tears away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3d924a-a142-3c9c-82a7-43dcef74a1e9",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To wink; to twinkle with, or as with, the eye."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc71104b-aae4-424e-bac1-2e7d4d81abe8",
                                                "sense_id": "1d3d924a-a142-3c9c-82a7-43dcef74a1e9",
                                                "text": "One eye was blinking, and one leg was lame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb77954-e2bf-3c62-8f58-6efdb0d69c90",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To see with the eyes half shut, or indistinctly and with frequent winking, as a person with weak eyes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f783af-b375-4b84-8675-fbfffc5d44ae",
                                                "sense_id": "0eb77954-e2bf-3c62-8f58-6efdb0d69c90",
                                                "text": "Show me thy chink, to blink through with mine eyne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To shine, especially with intermittent light; to twinkle; to flicker; to glimmer, as a lamp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bcc4b87-c52f-47ac-85e5-ed5008bf00c8",
                                                "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                                "text": "The dew was falling fast, the stars began to blink."
                                            },
                                            {
                                                "example_id": "ba67cdcc-3cf7-481b-8fbe-cee71706da64",
                                                "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                                "text": "The sun blinked fair on pool and stream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca048a7-7ada-3954-9578-c8a37e580a1d",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To glance."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3211107e-5d0b-4bd3-84dd-0850f51f8a85",
                                                "sense_id": "3ca048a7-7ada-3954-9578-c8a37e580a1d",
                                                "text": "Now exile is over, I'll fly to the north,\nThe home of my childhood, the place of my birth;\nO the transports of gladness that over me reign,\nTo blink upon canny Newcastle again!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf572b39-68d8-3d53-a641-c3a3b6c9656a",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To flash on and off at regular intervals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d9aedd-0156-4f7f-be36-16e4ce552ed5",
                                                "sense_id": "bf572b39-68d8-3d53-a641-c3a3b6c9656a",
                                                "text": "The blinking text on the screen was distracting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83039952-cb74-3c5f-b7a3-d2bcb7b17f15",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To flash on and off at regular intervals.",
                                            "To flash headlights on a car at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
