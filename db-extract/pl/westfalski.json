                    {
                        "translation_id": "5129a08e-104f-4fb6-947c-84049e891530",
                        "source_entry_id": "08fab7e3-e8a4-3d03-a631-58b819256228",
                        "source_sense_id": "c2d57cbf-2a3f-3ef4-85dc-f0d7937e96e0",
                        "target_lang_word": "westphalien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westphalien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f72710f6-0a8e-39f1-ae58-a4279e5bfeca",
                                        "entry_id": "cc2a23ab-818a-3971-9200-8ef80075dff7",
                                        "glosses": [
                                            "Relatif à la Westphalie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d8a469-fe17-3ce2-913b-6293c1e53759",
                                        "entry_id": "cc2a23ab-818a-3971-9200-8ef80075dff7",
                                        "glosses": [
                                            "Relatif au Westphalien, étage du Carbonifère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ad4447d-7c60-48be-91b5-09db58b1203f",
                                                "sense_id": "b8d8a469-fe17-3ce2-913b-6293c1e53759",
                                                "text": "Voilà 300 millions d’années, cette feuille de Linopteris subbrogniarti, aujourd’hui transformée en schiste, claquait au vent de l’époque «westphalienne», en plein carbonifère chaud et humide […]"
                                            },
                                            {
                                                "example_id": "cda26f39-6477-413a-9aa4-11220e8db3b5",
                                                "sense_id": "b8d8a469-fe17-3ce2-913b-6293c1e53759",
                                                "text": "Les modifications que la flore a subies pendant la période houillère permettent, bien qu’elles se soient opérées graduellement, de distinguer dans cette période deux époques principales, l’époque westphalienne, qui fait suite à celle du Culm, et l’époque stéphanienne, à laquelle, avec de faibles modifications de la flore, succède directement l’époque permienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c04c465d-98d8-30be-8a9f-40e5db7de19b",
                                        "entry_id": "cc2a23ab-818a-3971-9200-8ef80075dff7",
                                        "glosses": [
                                            "Relatif aux traités de Westphalie qui, signés en 1648 en Westphalie, mirent fin à la guerre de Trente Ans et marquèrent les relations internationales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d4a8b4-c9cd-4915-9a67-5455c06d41b6",
                                                "sense_id": "c04c465d-98d8-30be-8a9f-40e5db7de19b",
                                                "text": "On ne peut donc pas sérieusement penser lutter contre la Chine comme à l’époque westphalienne on luttait contre une puissance rivale jugée menaçante."
                                            }
                                        ]
                                    }
                                ]
                            },
