{
    "word_family": [
        "esquire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31d14ec8-815e-37bd-b82e-cd256cfbeb41",
                    "sense_definition": "A friendly or informal term of address used for a man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excuse me, <w>squire</w>, could you tell me the way to the train station?",
                            "target_lang_translations": {
                                "nl": "Neem me niet kwalijk, <w>vriend</w>, kunt u mij de weg naar het treinstation wijzen?"
                            }
                        },
                        {
                            "text": "What can I get for you today, <w>squire</w>?",
                            "target_lang_translations": {
                                "nl": "Wat kan ik vandaag voor u betekenen, <w>vriend</w>?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een informele, vriendelijke manier om een man aan te spreken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vriend",
                                "target_lang_sense_clarification": "Informeel aanspreekvorm voor een man."
                            },
                            {
                                "target_lang_word": "man",
                                "target_lang_sense_clarification": "Algemene informele aanspreekvorm."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f5e9c6c-f71b-3567-beae-34c04fc9abe4",
                    "sense_definition": "A young man who served a knight as an attendant and shield-bearer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>squire</w> polished his master's armor before the tournament began.",
                            "target_lang_translations": {
                                "nl": "De jonge <w>schildknaap</w> poetste het harnas van zijn meester voordat het toernooi begon."
                            }
                        },
                        {
                            "text": "Every knight relied on his <w>squire</w> to maintain his weapons and horses.",
                            "target_lang_translations": {
                                "nl": "Elke ridder vertrouwde op zijn <w>schildknaap</w> voor het onderhoud van zijn wapens en paarden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to medieval history."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een jonge man die een ridder diende als assistent en schilddrager."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schildknaap",
                                "target_lang_sense_clarification": "Historische rol van een assistent van een ridder."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b29277c-2527-3211-a981-dc22d8cdc388",
                    "sense_definition": "A man of high social standing who owns a large country estate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>squire</w> was responsible for managing the village lands.",
                            "target_lang_translations": {
                                "nl": "De lokale <w>landheer</w> was verantwoordelijk voor het beheer van de dorpsgronden."
                            }
                        },
                        {
                            "text": "Life in the village revolved around the manor house of the <w>squire</w>.",
                            "target_lang_translations": {
                                "nl": "Het leven in het dorp draaide om het landhuis van de <w>landheer</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to early modern English society."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een man van hoge sociale stand die een groot landgoed bezit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "landheer",
                                "target_lang_sense_clarification": "Eigenaar van een groot landgoed."
                            },
                            {
                                "target_lang_word": "jonkheer",
                                "target_lang_sense_clarification": "Adellijke titel of aanduiding voor een lid van de adel."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                    "sense_definition": "To accompany or escort a woman in public.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "escort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was proud to <w>squire</w> the lady to the evening gala.",
                            "target_lang_translations": {
                                "nl": "Hij was er trots op de dame te <w>begeleiden</w> naar het avondgala."
                            }
                        },
                        {
                            "text": "It was considered polite for a gentleman to <w>squire</w> his partner to the dance.",
                            "target_lang_translations": {
                                "nl": "Het werd als beleefd beschouwd voor een heer om zijn partner te <w>begeleiden</w> naar het dansfeest."
                            }
                        }
                    ],
                    "synonyms": [
                        "escort"
                    ],
                    "common_phrases": [
                        "squire the lady"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to traditional social etiquette."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vrouw in het openbaar begeleiden of escorteren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "begeleiden",
                                "target_lang_sense_clarification": "Iemand vergezellen naar een sociale gelegenheid."
                            },
                            {
                                "target_lang_word": "escorteren",
                                "target_lang_sense_clarification": "Formele term voor het vergezellen van iemand."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e3eec687-58c0-301f-890b-d04662c59cb7",
                    "sense_definition": "A family name derived from the historical occupation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named Mr. <w>Squire</w>.",
                            "target_lang_translations": {
                                "nl": "De auteur van het boek heet meneer <w>Squire</w>."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Squire</w> have ancestors from England.",
                            "target_lang_translations": {
                                "nl": "Veel mensen met de achternaam <w>Squire</w> hebben voorouders uit Engeland."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een achternaam afgeleid van de historische bezigheid."
                    },
                    "translations": {
                        "nl": []
                    }
                }
            ]
        }
    ]
}