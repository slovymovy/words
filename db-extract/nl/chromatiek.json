                                "example_id": "bf9ae64d-2f55-4f8a-99fe-74901642d5e2",
                                "sense_id": "40380c11-bd09-32a9-b52b-c1fa600c5301",
                                "text": "Bij het hoofdstuk chromatiek las ik over het verband tussen kleuren en frequenties van elektromagnetische golven."
                            }
