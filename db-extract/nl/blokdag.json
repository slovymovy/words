                    {
                        "sense_id": "79676189-d582-306f-8bfa-fac584786e93",
                        "entry_id": "418b2b0f-7caf-3746-b0ea-7541d1b3c041",
                        "glosses": [
                            "een dag dat een student heel hard aan het studeren is als voorbereiding op een examen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0877a861-6b81-45c9-b4be-feaee2e3a9ec",
                                "sense_id": "79676189-d582-306f-8bfa-fac584786e93",
                                "text": "Ik zit op kot in Antwerpen, maar ga altijd thuis blokken. En daar is maar één reden voor: het eten van mijn moeder. Ik ben een echte Bourgondiër en vind eten zalig. Maaltijden zijn de hoogtepunten van mijn blokdagen."
                            },
                            {
                                "example_id": "b7ca438f-848e-4607-b3c1-510208574939",
                                "sense_id": "79676189-d582-306f-8bfa-fac584786e93",
                                "text": "Mijn blokdag begint rond twaalf uur 'smiddags. Ik eet wat, check mijn mail en kruip achter mijn bureau. Ik kom daar alleen vandaan om te eten."
                            },
                            {
                                "example_id": "8f7114d8-c794-4b7d-b043-ad4dc76d1fd7",
                                "sense_id": "79676189-d582-306f-8bfa-fac584786e93",
                                "text": "\"Meer dan vijftig studenten hebben gisteren gestudeerd in het stadion van Oud Heverlee Leuven. Zo werd de eerste blokdag een succes.\""
                            }
                        ]
                    }
