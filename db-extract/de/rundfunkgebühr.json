                "senses": [
                    {
                        "sense_id": "bd852ce1-099b-38d8-a626-65a9bcd275f3",
                        "entry_id": "e9f0f9e5-2bab-39b5-9223-3fc170b5dafc",
                        "glosses": [
                            "Beitrag, den man für die Nutzung des öffentlich-rechtlichen Rundfunks entrichten muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3184ace-be57-4248-9896-7f8d1965982a",
                                "sense_id": "bd852ce1-099b-38d8-a626-65a9bcd275f3",
                                "text": "„Die Länder können die Rundfunkgebühr nicht selbst festsetzen oder diese für alle Zeit bei 17.98 Euro festschreiben.“"
                            },
                            {
                                "example_id": "6897304a-c552-4c54-aa2a-7040d16ad911",
                                "sense_id": "bd852ce1-099b-38d8-a626-65a9bcd275f3",
                                "text": "In der Schweiz ist die Initiative über die Abschaffung der Rundfunkgebühren gescheitert."
                            },
                            {
                                "example_id": "fe5459c8-da7d-4b3c-8792-3ab4ba37e630",
                                "sense_id": "bd852ce1-099b-38d8-a626-65a9bcd275f3",
                                "text": "„Viele Menschen sind sich gar nicht bewusst, dass die Rundfunkgebühren in Wirklichkeit eine versteckte Steuer sind: Sie werden per Gesetz erhoben und durch staatlich eingesetzte Bürokraten verwaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
