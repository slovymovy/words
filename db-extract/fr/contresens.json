        "fr-extract.jsonl": [
            {
                "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                "word": "contresens",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34bdb687-8f25-4fa7-9cde-494b11db2b2f",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "tags": [],
                        "form": "contre-sens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1150fb5-1694-315f-975f-3a631092bed9",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "glosses": [
                            "Sens contraire au sens naturel d’une proposition, d’une phrase, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119a0508-92f7-4f7f-acc8-060e8d48f6b7",
                                "sense_id": "e1150fb5-1694-315f-975f-3a631092bed9",
                                "text": "Vous interprétez mal ce que je dis vous prenez le contresens de mes paroles."
                            },
                            {
                                "example_id": "2a6f0e81-4ff8-4dc2-9a27-e4d728f98789",
                                "sense_id": "e1150fb5-1694-315f-975f-3a631092bed9",
                                "text": "J’ai souvent trouvé du reste que les mélancolies des printemps dépassent celles des automnes, sans doute parce qu’elles sont un contresens, une déception sur la seule chose du monde qui devrait au moins ne jamais nous manquer."
                            },
                            {
                                "example_id": "18fc8cfe-c692-424a-a551-e25a02f45b72",
                                "sense_id": "e1150fb5-1694-315f-975f-3a631092bed9",
                                "text": "Mais ces deux noms, et un certain dialogue Lamartine-Musset, ont créé une équivoque, donné même l’occasion d’un contresens."
                            }
                        ]
                    },
                    {
                        "sense_id": "018d2da2-fdb0-3b16-b871-45eebdca77be",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "glosses": [
                            "Tout sens différent du sens véritable d’un texte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4c2986-3ad8-4f81-a933-449c5d8aa9ac",
                                "sense_id": "018d2da2-fdb0-3b16-b871-45eebdca77be",
                                "text": "Autrefois j’aimais rester assis à ma table, préparer une leçon sur La Fontaine, débusquer les contresens d’une version."
                            },
                            {
                                "example_id": "0d6edb7a-6f9d-4916-80fb-8644614bd83e",
                                "sense_id": "018d2da2-fdb0-3b16-b871-45eebdca77be",
                                "text": "Cette traduction est pleine de contresens."
                            },
                            {
                                "example_id": "31c55574-89a1-4771-b5e2-d3143c4b1bf7",
                                "sense_id": "018d2da2-fdb0-3b16-b871-45eebdca77be",
                                "text": "Ce lycéen a fait un contresens, plusieurs contresens dans sa version."
                            }
                        ]
                    },
                    {
                        "sense_id": "b870b4b1-bcf6-3b46-ab7b-773253490e13",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "glosses": [
                            "Toute manière de lire, de prononcer, de déclamer, etc., qui ne s’accorde pas avec le sens des paroles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90026ec5-c2ff-4095-9ffa-bc6aa268babf",
                                "sense_id": "b870b4b1-bcf6-3b46-ab7b-773253490e13",
                                "text": "Cette musique forme un véritable contresens avec les paroles."
                            },
                            {
                                "example_id": "49bf73db-b32d-4241-bea2-187c4b9233cb",
                                "sense_id": "b870b4b1-bcf6-3b46-ab7b-773253490e13",
                                "text": "Sa manière de lire est un perpétuel contresens."
                            },
                            {
                                "example_id": "e408f371-9f9c-4bc8-8efb-aea66792cdf3",
                                "sense_id": "b870b4b1-bcf6-3b46-ab7b-773253490e13",
                                "text": "Cet acteur fait sans cesse des contresens."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "glosses": [
                            "Dans le code de la route français, ainsi que dans la législation belge, le sens opposé au sens de circulation des véhicules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b05286-f5fa-4a34-8327-154d02765387",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "Roulant à contresens et à très grande vitesse sur une dizaine de kilomètres, il avait percuté de plein fouet une voiture qui arrivait en face au niveau de la commune de La Jonquera, 700 mètres après la frontière."
                            },
                            {
                                "example_id": "e50202e1-5456-4176-ab6f-99b371ea160a",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "il revient sur les principes du code de la route pour appuyer la logique des contresens cyclables: « Les sens uniques, créés soit pour faciliter, soit pour dissuader le trafic motorisé sur certains axes, ne doivent en règle générale concerner ni les piétons ni les cyclistes»"
                            },
                            {
                                "example_id": "d056f047-87cd-4540-b1d7-74ebd0f84755",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "L’étude de D. Alrutz et al. (2002), menée dans 15 villes allemandes, a montré que la plupart des accidents avec un cycliste circulant dans le contresens avaient lieu avec des piétons, ceux-ci omettant de vérifier si un cycliste arrive dans le sens contraire."
                            },
                            {
                                "example_id": "7aefbf17-c4ac-491d-b114-d151e5df6041",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "En zone 30, le contresens cyclable est la règle : \"Si la largeur de la voie le permet, dans les rues à sens unique, les vélos arrivent à contresens des voitures. Cela permet de ralentir l'automobiliste, qui comprend qu'il n'est pas le seul usager de la route.\""
                            },
                            {
                                "example_id": "7e5169ac-0737-4100-ad0d-8afac57a0bbd",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "J’ai constaté, comme beaucoup, qu’elle comporte une voie de stationnement, de circulation, un contresens cyclable et deux trottoirs dans un espace assez étroit."
                            },
                            {
                                "example_id": "ee3e0b9a-ecd2-46c9-8502-67248da0e661",
                                "sense_id": "6f2e5248-49d4-3ed1-bd90-c74896d6f500",
                                "text": "Beaucoup de cyclistes ont cru que les zones 30 autorisaient automatiquement le contrsens vélo."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcfa2b9b-6f40-312e-be1c-76a4dcfe4072",
                        "entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "glosses": [
                            "En parlant d’étoffes, du linge et d’autres choses, sens contraire à celui où ils doivent être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a12bc12-e98c-4841-9072-a01f2ea4d2ce",
                                "sense_id": "bcfa2b9b-6f40-312e-be1c-76a4dcfe4072",
                                "text": "En faisant ce manteau, on a pris le contresens de l’étoffe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bd8077e-5e2a-44ca-b748-40edbcd78218",
                        "source_entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "target_lang_word": "Widersinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widersinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba72f50a-6807-3996-9b25-f4dffe246a15",
                                        "entry_id": "f424cf08-03fc-3337-97f9-b46666a20a7d",
                                        "glosses": [
                                            "etwas, das für den menschlichen Verstand keinen nachvollziehbaren Gehalt (Sinn) ergibt; Unsinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbba6f63-dce5-4bcb-8864-522e44c98487",
                                                "sense_id": "ba72f50a-6807-3996-9b25-f4dffe246a15",
                                                "text": "„Sollte es denn niemanden in der Regierung dieses reichen Landes geben, niemanden unter den Mächtigen dieser in christlicher Nächstenliebe erzogenen Nation, der diesen himmelschreienden Widersinn erkennt und ihm ein Ende setzt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24936f80-c53c-495e-905f-de60315c4109",
                        "source_entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "target_lang_word": "misinterpretation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misinterpretation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3d54e4-707c-3a8f-8bc6-106e74f60235",
                                        "entry_id": "35fe891c-b765-3ddb-b416-434ced59a34c",
                                        "glosses": [
                                            "An instance of misinterpreting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2a2c17-870c-468e-8f61-f7ee796d15a2",
                                                "sense_id": "ba3d54e4-707c-3a8f-8bc6-106e74f60235",
                                                "text": "Charmed as was De Brooke at the outward effects of his Rosilia's sensibility, yet at the same time pained at the situation of his child, conscious that she attracted all eyes upon her, and fearful also of the misinterpretation of affectation or weakness given to it by her ladyship, he looked at his sister, who, comprehending his wishes, lent her kind interference, and conducted Rosilia from the apartment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d66721ff-a69b-4af1-a52c-ad3f434c11b0",
                        "source_entry_id": "62dc93f1-3211-3873-a588-de0d3a5dd532",
                        "target_lang_word": "mistranslation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistranslation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14cf2038-ec11-305c-aa73-04b896418983",
                                        "entry_id": "4fb953f9-1f4e-3838-b030-47e2773e5bcc",
                                        "glosses": [
                                            "An incorrect translation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b0dfc06-7114-4344-a7fa-2ab72c4123f0",
                                                "sense_id": "14cf2038-ec11-305c-aa73-04b896418983",
                                                "text": "MORE mischief has been done to the cause of truth by mistranslations of, and consequent miscomments on the holy scripture, than is at first thought imagined or perceived."
                                            },
                                            {
                                                "example_id": "e861c454-7ef1-42c1-8ba4-05e7baa54d3f",
                                                "sense_id": "14cf2038-ec11-305c-aa73-04b896418983",
                                                "text": "The second stage in the process by which African cultural realities are often mistransformed through mistranslation by ethnographers is associated with the urgent demand for 'theories' to assist the ethnographer in organising his field data and in presenting the conclusions derived from the data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baafbe17-d8f8-32c3-ab93-9ebf1ca029bd",
                                        "entry_id": "4fb953f9-1f4e-3838-b030-47e2773e5bcc",
