                "senses": [
                    {
                        "sense_id": "fffaabad-6f3e-3047-a79f-7abcb10f619c",
                        "entry_id": "5e50a515-1ede-30c9-98a5-a9bc9f9a92e3",
                        "glosses": [
                            "eine Frau, die Aphorismen verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a319cf8f-fc87-45e4-9758-eefeb45673db",
                                "sense_id": "fffaabad-6f3e-3047-a79f-7abcb10f619c",
                                "text": "„Irgendwann geht es mehr darum, ob die Sprüche gut oder schlecht sind, als darum, ob von einem Aphoristiker oder einer Aphoristikerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4979df73-c6b4-4b46-80dd-18a09701bd6f",
                        "source_entry_id": "5e50a515-1ede-30c9-98a5-a9bc9f9a92e3",
                        "source_sense_id": "fffaabad-6f3e-3047-a79f-7abcb10f619c",
                        "source_sense_description": "Literatur: eine Frau, die Aphorismen verfasst",
                        "target_lang_word": "aphorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                                        "entry_id": "49afe978-d716-3a43-9962-f55b2161151a",
                                        "glosses": [
                                            "A person who creates or recites aphorisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b1fcc-a9b6-4767-b6c2-8a2bcc8d369d",
                                                "sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                                                "text": "Leaving the reader to study the details of the discussion in Dr. Ballantyne's aphorisms of the Nyāya (Part Second, pp. 77 ff.), I will pass over most of the Sūtras, and merely quote the principal conclusions of the Nyāya aphorist."
                                            },
                                            {
                                                "example_id": "d378ea17-c922-433f-876f-b6882ae97f8c",
                                                "sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                                                "text": "In the examination of the revisions which these texts underwent, we have stolen a rare glance into the interior of the workshop of the aphorist."
                                            },
                                            {
                                                "example_id": "ca7c902e-4c80-4219-9899-2c5c802cbe30",
                                                "sense_id": "05e40930-b929-3ad9-a7f1-5c6d7f8cd9f5",
                                                "text": "[Juhani Siljo]'s natural form of expression was the aphorism; he is one of the best aphorists of his time and in Finnish literature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
