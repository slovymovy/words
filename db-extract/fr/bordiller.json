                "senses": [
                    {
                        "sense_id": "3831d248-7f3e-386f-9b4d-9e79169470a3",
                        "entry_id": "88b58865-4cac-3afe-ae92-8ab8c50b0286",
                        "glosses": [
                            "Approcher de près (ou de trop près, en débordant)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4601482-c879-4ad0-9f05-2978042491e8",
                                "sense_id": "3831d248-7f3e-386f-9b4d-9e79169470a3",
                                "text": "Ils savaient « guinguander », ou « bordiller », c’est-à-dire braconner en débordant les limites."
                            },
                            {
                                "example_id": "85e4848e-7fb9-47fe-be30-7b21510c193b",
                                "sense_id": "3831d248-7f3e-386f-9b4d-9e79169470a3",
                                "text": "Je possède une Argo en 300 Wm, je dois bordiller les 250 cartouches de tirés avec et je n’ai jamais eu de problèmes"
                            },
                            {
                                "example_id": "17a024d4-6c5f-4792-9908-32839a63d091",
                                "sense_id": "3831d248-7f3e-386f-9b4d-9e79169470a3",
                                "text": "Un 6bar risque de ne servir qu’une fois (si ton groupe coule tu dois bordiller les 7 bar sauf si il est HS)."
                            },
                            {
                                "example_id": "4d5c6edc-e5a7-41a2-a009-aec979f372bb",
                                "sense_id": "3831d248-7f3e-386f-9b4d-9e79169470a3",
                                "text": "Bordiller, v. act. Se dit des animaux qui en passant attrapent une goulée dans le champ du voisin."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1acc18a-dc87-36e7-bfbd-8cdabe1dfd9c",
                        "entry_id": "88b58865-4cac-3afe-ae92-8ab8c50b0286",
                        "glosses": [
                            "Papillonner."
