                "senses": [
                    {
                        "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                        "entry_id": "e68ec74a-ce69-3604-b6fa-5a13b947c750",
                        "glosses": [
                            "Person, die bei einer offiziellen Marathonmeisterschaft den ersten Platz belegt hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f3c0c035-0668-4ff2-a2b5-c58d3ed84482",
                                "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                                "text": "„Im September wurde er zum dritten Mal Deutscher Marathonmeister, und am 14. Oktober folgte mit 20.237 Metern ein DLV-Rekord im Stundenlauf (auch die 20.000-Meter-Zwischenzeit von 59:20,2 min war bundesdeutscher Rekord).“"
                            },
                            {
                                "example_id": "f0d41287-c36d-4192-8f17-e10a5db3d69a",
                                "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                                "text": "„Dabei freut sich der amtierende Deutsche Marathonmeister, Hendrik Pfeiffer in diesem Jahr zum ersten Mal die Pace für die schnellsten Läufer zu machen‚, heißt es in der Mitteilung weiter.“"
                            },
                            {
                                "example_id": "6e85d6ed-90b9-47cf-bf22-da4556291c22",
                                "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                                "text": "„Neben der üblichen Marathon Pfalzmeisterschaft, werden dieses Jahr auch die Saarländer ihren Marathonmeister in Kandel ermitteln.“"
                            },
                            {
                                "example_id": "f4186ce2-99e5-4b8f-8f68-0118a366bb85",
                                "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                                "text": "„Den Hauptlauf über 6000 m gewann der ehemalige deutsche Marathonmeister Tobias Schreindl (DJK-LG Passau) vor seinen Vereinskameraden Stephan Fruhmann und Jonas Storch.“"
                            },
                            {
                                "example_id": "4bce07c4-ac22-4724-95bc-298a62e8ba59",
                                "sense_id": "cb4edf4d-7a1d-3e5c-96c9-4ef1cc12b741",
                                "text": "„Hier duellierten sich der amtierende Bayerische Marathonmeister Mario Wernsdörfer aus Bamberg und Martin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
