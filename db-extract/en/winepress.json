                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83df0e96-e80a-4d35-8f1a-4bbbc301bfaa",
                                                "sense_id": "0f9c86b7-c577-3a4c-b38e-43cc756c351a",
                                                "text": "Ihre Liebe begann beim Fest in der Weinkelter."
                                            }
