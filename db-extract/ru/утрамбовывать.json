                        ]
                    },
                    {
                        "translation_id": "fd044036-ea7a-44af-b25f-cb835575336e",
                        "source_entry_id": "3fc829c0-c936-3c04-9f6f-3eb72e85ed1c",
                        "source_sense_id": "bb629a4f-11c1-382c-bfe6-d77dbb3cfafe",
                        "target_lang_word": "tamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "522b6f57-b21d-345f-a3a4-fb2baa79e406",
                                        "entry_id": "086a4f59-4c78-3342-8fdd-4a91adf5c6d4",
                                        "glosses": [
                                            "To plug up with clay, earth, dry sand, sod, or other material, as a hole bored in a rock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcdec399-36ab-3211-8955-6ca15c4b9140",
                                        "entry_id": "086a4f59-4c78-3342-8fdd-4a91adf5c6d4",
                                        "glosses": [
                                            "To drive in or pack down by frequent gentle strokes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d2faa1-483e-4262-802b-fd09428c3267",
                                                "sense_id": "fcdec399-36ab-3211-8955-6ca15c4b9140",
                                                "text": "Tamp earth so as to make a smooth place."
                                            },
                                            {
                                                "example_id": "a1919de2-c6a4-4df8-b7ef-1a11d3de1502",
                                                "sense_id": "fcdec399-36ab-3211-8955-6ca15c4b9140",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4802fba-e37a-3a89-9365-54d84aee5988",
                                        "entry_id": "6a35d252-4d1c-35c5-8dac-f5ea13ceccde",
                                        "glosses": [
                                            "To reduce the intensity of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "838df31a-572f-45b0-a77e-f2a821c483aa",
                                                "sense_id": "f4802fba-e37a-3a89-9365-54d84aee5988",
                                                "text": "A single thought tamped her outrage: the chance that Meredith wasn't alone in her suspicions."
                                            },
                                            {
                                                "example_id": "86fea212-3da4-473f-aaee-a31cd7c6cacb",
                                                "sense_id": "f4802fba-e37a-3a89-9365-54d84aee5988",
                                                "text": "Whatever doubts she struggled with, they hadn't tamped her hunger for him."
                                            },
                                            {
                                                "example_id": "4c8c3fd8-220d-47be-a6cc-995b2a9015ce",
                                                "sense_id": "f4802fba-e37a-3a89-9365-54d84aee5988",
                                                "text": "A small bit of relief tamped her initial trepidation."
                                            },
                                            {
                                                "example_id": "5c842183-57bb-4159-96a8-da778a12ca9e",
                                                "sense_id": "f4802fba-e37a-3a89-9365-54d84aee5988",
                                                "text": "Lucy bit the inside of her cheek and tamped her anger down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
