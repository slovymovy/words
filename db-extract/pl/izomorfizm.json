                                            {
                                                "example_id": "04a324c2-e863-4674-8ac1-ec8f26929018",
                                                "sense_id": "b6233519-5d3b-30f9-9c4e-fded733a17e8",
                                                "text": "The postulated isomorphism between words and things constitutes the characterizing feature of all philosophically based universal languages."
                                            }
