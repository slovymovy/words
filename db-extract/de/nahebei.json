                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                        "entry_id": "937a6458-be96-339d-9313-88dd9b0224f0",
                                        "glosses": [
                                            "À peu près, peu s’en faut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3d5720-1bde-452a-87aa-6b40ccaedb66",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "Il bascula, se rattrapa au bord du banc et pensa : « Le mot le plus atroce : presque. Ma devise : trop tard. L'expression la plus vaine : à l'aide! Victor, ou est ta victoire? »"
                                            },
                                            {
                                                "example_id": "9583d321-f2c4-41aa-bee4-2665bf81fa53",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "Mes tempes battent ; toute ma chair va à cette femme presque nue et charmante dans le matin et dans le transparent vêtement qui enferme la douce odeur d’elle…"
                                            },
                                            {
                                                "example_id": "ea14c63b-2191-412b-8906-bbfeb09b7341",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "Je continue à me nourrir presque uniquement de biscuits."
                                            },
                                            {
                                                "example_id": "58f42e63-12db-4a01-8f51-20c71ce35183",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "Comme aux très anciennes bâtisses, l’auvent du toit dévale presque jusqu’au sol, en guise de hangar."
                                            },
                                            {
                                                "example_id": "e07f20a9-601d-458c-8c28-ec3a80140487",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "[…] ; le système monétaire et le système du crédit reposent sur une vaine tradition de la valeur de l’or et offrent une instabilité presque fantastique."
                                            },
                                            {
                                                "example_id": "76dd3821-eb39-43c3-b96b-1ac753c74e4b",
                                                "sense_id": "f9d21d7e-d4ec-3c91-8de1-29cf3fb2a70d",
                                                "text": "Après avoir été très élevé pendant la grande crise de 1929, le chômage américain a presque complètement disparu durant la guerre de 1940. Ce n’est que vers 1947 que celui-ci réapparaît."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b3f1d9-7891-3d07-a94e-afaf882a4524",
                                        "entry_id": "937a6458-be96-339d-9313-88dd9b0224f0",
                                        "glosses": [
                                            "Excepté un ensemble négligeable."
                                        ],
                                        "tags": [
                                            "Avec un mot de totalité"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
