                        "glosses": [
                            "przedstawianie rzeczywistości na wzór snu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f406d9-0c54-4c64-8fee-f7556e4bb29d",
                                "sense_id": "5353a4be-f035-3dfe-bd3b-e7b71cd0945d",
                                "text": "Oniryzm w sztuce XX w. jest związany m.in. z psychologią Freuda, w której silnie podkreślana jest rola podświadomości, ujawniającej się w marzeniach sennych"
                            }
                        ],
