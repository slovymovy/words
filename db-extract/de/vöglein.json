                                    {
                                        "sense_id": "1cb25edf-638e-3e87-83e7-09a5efb0e59a",
                                        "entry_id": "4f9920b5-c429-3a83-bae0-128984bbaee0",
                                        "glosses": [
                                            "Resembling or characteristic of a bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "724017e6-2402-43f6-a743-ecc936d29a28",
                                                "sense_id": "1cb25edf-638e-3e87-83e7-09a5efb0e59a",
                                                "text": "He was a brisk and birdy little man with a chirping, cheerful voice; and, although he was almost ninety, he always seemed to be in good health and was still immensely active."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f958e2-3f0c-3263-a9e9-275664f8148a",
                                        "entry_id": "4f9920b5-c429-3a83-bae0-128984bbaee0",
                                        "glosses": [
                                            "Excited due to having encountered a bird or its scent."
                                        ],
                                        "tags": [
                                            "of a gun dog"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a60cb82c-c231-4f88-bafe-9f08f550edd6",
                                                "sense_id": "86f958e2-3f0c-3263-a9e9-275664f8148a",
                                                "text": "I think your dog is getting birdy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae12f3d2-ae1f-3d36-9ca3-69b7d5936043",
                                        "entry_id": "4f9920b5-c429-3a83-bae0-128984bbaee0",
                                        "glosses": [
                                            "Alternative form of bird (“easy to pass”)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "alt-of",
                                            "alternative",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65c20243-6a17-44ee-9c84-0a4eee54d504",
                                                "sense_id": "ae12f3d2-ae1f-3d36-9ca3-69b7d5936043",
                                                "text": "HSP3U: Intro to anthropology, sociology, psychology. I took it in gr 10 elearning summer, so i had a final exam and final culminating. I ended w a 96%. Def possible to get above 90, just work hard. Perfect if you need an intro to soc science. A birdy course and vry interesting."
                                            }
                                        ]
                                    }
                                ]
