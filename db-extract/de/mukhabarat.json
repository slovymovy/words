                "senses": [
                    {
                        "sense_id": "22b38451-bd94-3004-b807-f91d178a6afa",
                        "entry_id": "a412a7bd-f4ad-3f86-a8cf-0cb5f7f2b126",
                        "glosses": [
                            "Geheimdienst, Geheimpolizei"
                        ],
                        "tags": [
                            "Naher Osten"
                        ],
                        "examples": [
                            {
                                "example_id": "6664f6d5-4996-4bf5-8c7d-58fe1553901c",
                                "sense_id": "22b38451-bd94-3004-b807-f91d178a6afa",
                                "text": "„Junge Jordanier versuchten gern zu erraten, wer in der Bar, in der sie gerade saßen, zum Mukhabarat gehörte.“"
                            },
                            {
                                "example_id": "2cbaac84-9581-4e84-bc13-f693096f5511",
                                "sense_id": "22b38451-bd94-3004-b807-f91d178a6afa",
                                "text": "„Selbstverständlich wurde Drexler nach seiner Ankunft vom berüchtigten syrischen Geheimdienst Mukhabarat genauestens unter die Lupe genommen; er bestand alle Prüfungen und begann sofort mit seiner Arbeit für Shakira und Ahmed, führte gemeinsam mit dem Mukhabarat Operationen durch, die die Auslandsvermögen der Herrscherfamilie sichern halfen.“"
                            },
                            {
                                "example_id": "fcbced2c-0626-470b-947d-533dc02aefce",
                                "sense_id": "22b38451-bd94-3004-b807-f91d178a6afa",
                                "text": "„Der ägyptische Nachrichtendienst, der Mukhabarat, hat Angst vor ihm.“"
                            },
                            {
                                "example_id": "413c8a1e-951f-486c-b0ad-735ab1350ebd",
                                "sense_id": "22b38451-bd94-3004-b807-f91d178a6afa",
                                "text": "„Dank Adrians Unterstützung hatte er sogar die Berichte eines englischen Agenten gelesen, den der SIS im Jahr 2000 in den irakischen Mukhabarat eingeschleust hatte und der berichtete, Saddam habe Osama bin Ladens Vorschlag abgelehnt, mit ihm gemeinsame Sache gegen die Amerikaner zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
