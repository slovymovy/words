                "senses": [
                    {
                        "sense_id": "c1920b15-d8e8-362d-87b2-05cc4c66d25d",
                        "entry_id": "65479fc7-e427-352c-a078-be009f70f328",
                        "glosses": [
                            "Stoff der siebten Hauptgruppe des Periodensystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11073e70-7c65-4b04-9b2c-1f84c84c3133",
                                "sense_id": "c1920b15-d8e8-362d-87b2-05cc4c66d25d",
                                "text": "Die Elemente Fluor, Chlor, Brom und Iod sind Salzbildner."
                            },
                            {
                                "example_id": "f4109131-13b9-4513-ba25-3ea316a65d4f",
                                "sense_id": "c1920b15-d8e8-362d-87b2-05cc4c66d25d",
                                "text": "„Diese Hydroxylgruppen übernehmen aber gleichzeitig die Rolle der Salzbildner: sie sind es, welche die Verwandtschaft zur Faser vermitteln.“"
                            },
                            {
                                "example_id": "5bc27707-8a47-4905-94dd-d6130e478bcf",
                                "sense_id": "c1920b15-d8e8-362d-87b2-05cc4c66d25d",
                                "text": "„Wie in den Sauerstoffsalzen tritt der Salzbildner gepaart mit einem der Haloïdsalze als Anion auf, und das am meisten basische Metall giebt das Kation ab.“"
                            },
                            {
                                "example_id": "bf9c159c-8bbc-4b55-bb62-7777708364a8",
                                "sense_id": "c1920b15-d8e8-362d-87b2-05cc4c66d25d",
                                "text": "„Allerdings entsteht manchmal die Schwierigkeit zu entscheiden, ob die Menge des anderen mit einem dieser Salzbildner in einer Molekel verbundenen Elements 1, 2, 3 oder n Atome beträgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
