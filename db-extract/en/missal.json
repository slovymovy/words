                                        "entry_id": "0bbf0a15-4f26-3c17-9718-b88abe4759d5",
                                        "glosses": [
                                            "wichtigstes liturgisches Buch für die Messfeier, in welchem vor allem die Gebete und Handlungsanweisungen für den Priester stehen"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3196ecd2-2dc9-421e-86ef-e5bfe3130898",
                                                "sense_id": "2e63a10d-5e44-35fb-a96b-49ba030d0ca4",
                                                "text": "In der vorkonziliaren Liturgie wurde das Messbuch während der Messe von der einen zur anderen Altarseite gelegt."
                                            },
                                            {
                                                "example_id": "5335a21a-1727-408c-b41d-9bcf43d93e67",
                                                "sense_id": "2e63a10d-5e44-35fb-a96b-49ba030d0ca4",
                                                "text": "Die maßgebliche Ausgabe des Messbuchs ist lateinisch und wird in zahlreiche Sprachen übersetzt."
                                            },
                                            {
                                                "example_id": "0c90ee5c-d1d6-4501-a7db-7ede1610fb26",
                                                "sense_id": "2e63a10d-5e44-35fb-a96b-49ba030d0ca4",
                                                "text": "„Mit Blick auf den spätestens seit den ausgehenden achtziger Jahren des 15. Jahrhunderts immer wieder von tiefen Krisen geschüttelten europäischen Buchmarkt barg der Druck von Messbüchern ein relativ geringes verlegerisches Risiko, da der Absatz meist durch den Ortsbischof garantiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
