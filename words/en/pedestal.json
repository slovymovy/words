{
    "word_family": [
        "pedestalled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78a29114-591e-3853-bc19-5337cfcd728f",
                    "sense_definition": "The base or foot of a column, statue, vase, or lamp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "base",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bronze statue stood proudly on a marble <w>pedestal</w> in the center of the park.",
                            "target_lang_translations": {
                                "de": "Die Bronzestatue stand stolz auf einem marmornen <w>Sockel</w> in der Mitte des Parks."
                            }
                        },
                        {
                            "text": "The heavy <w>pedestal</w> base ensures the lamp does not tip over easily.",
                            "target_lang_translations": {
                                "de": "Der schwere <w>Standfuß</w> sorgt dafür, dass die Lampe nicht so leicht umkippt."
                            }
                        }
                    ],
                    "synonyms": [
                        "base",
                        "stand",
                        "plinth"
                    ],
                    "common_phrases": [
                        "statue pedestal",
                        "lamp pedestal"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Sockel oder Fuß einer Säule, Statue, Vase oder Lampe."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sockel",
                                "target_lang_sense_clarification": "tragender Unterbau, z. B. für Statuen oder Säulen"
                            },
                            {
                                "target_lang_word": "Podest",
                                "target_lang_sense_clarification": "erhöhte Plattform oder Unterlage"
                            },
                            {
                                "target_lang_word": "Postament",
                                "target_lang_sense_clarification": "architektonischer Sockel für Bildwerke"
                            },
                            {
                                "target_lang_word": "Standfuß",
                                "target_lang_sense_clarification": "Fuß bzw. Basis von Gegenständen wie Lampen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed25060b-69ee-3840-bce0-290bced7bf33",
                    "sense_definition": "A position of high honor or reverence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has put his mother on a <w>pedestal</w> and refuses to see her flaws.",
                            "target_lang_translations": {
                                "de": "Er hat seine Mutter auf ein <w>Podest</w> gestellt und weigert sich, ihre Fehler zu sehen."
                            }
                        },
                        {
                            "text": "The public often places celebrities on a <w>pedestal</w> until they inevitably make a mistake.",
                            "target_lang_translations": {
                                "de": "Die Öffentlichkeit stellt Prominente oft auf ein <w>Podest</w>, bis sie unweigerlich einen Fehler machen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "put on a pedestal"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Position großer Ehre, Verehrung oder Bewunderung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Podest",
                                "target_lang_sense_clarification": "im übertragenen Sinne, oft bei 'auf ein Podest stellen'"
                            },
                            {
                                "target_lang_word": "Sockel",
                                "target_lang_sense_clarification": "übertragene Bedeutung für überhöhte Verehrung"
                            },
                            {
                                "target_lang_word": "Piedestal",
                                "target_lang_sense_clarification": "gehoben, bildungssprachlich für eine erhabene Position"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a80f8e2-b61c-35d3-996e-f93048c5a654",
                    "sense_definition": "To set or support on or as if on a pedestal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "base",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect decided to <w>pedestal</w> the sculpture to make it more visible to visitors.",
                            "target_lang_translations": {
                                "de": "Der Architekt entschied sich dafür, die Skulptur <w>auf einen Sockel zu stellen</w>, damit sie für Besucher besser sichtbar ist."
                            }
                        },
                        {
                            "text": "They <w>pedestaled</w> the ancient artifact to protect it from damage.",
                            "target_lang_translations": {
                                "de": "Sie <w>platzierten</w> das antike Artefakt <w>auf einem Sockel</w>, um es vor Schäden zu schützen."
                            }
                        }
                    ],
                    "synonyms": [
                        "mount",
                        "base"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf einen Sockel stellen oder wie auf einem Sockel lagern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auf einen Sockel stellen",
                                "target_lang_sense_clarification": "physisch oder bildlich erhöhen"
                            },
                            {
                                "target_lang_word": "aufbocken",
                                "target_lang_sense_clarification": "auf ein Gestell oder Stützen heben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}