{
    "word_family": [
        "coself"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d5814f9-d269-39b5-bd7d-04c5165763d2",
                    "sense_definition": "An abbreviation of the word <w>company</w>, used to indicate a business organization or firm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "company_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father works for a large shipping <w>co</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Мой отец работает в крупной судоходной <w>компании</w> в городе.",
                                "zh": "我父亲在城里的一家大型航运<w>公司</w>工作。"
                            }
                        },
                        {
                            "text": "The sign above the shop entrance read 'Smith & <w>Co</w>'.",
                            "target_lang_translations": {
                                "ru": "На вывеске над входом в магазин было написано «Смит и <w>Ко</w>».",
                                "zh": "商店入口上方的招牌上写着“史密斯<w>公司</w>”。"
                            }
                        }
                    ],
                    "synonyms": [
                        "firm",
                        "business",
                        "company"
                    ],
                    "common_phrases": [
                        "and co"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"company\" (компания), используемое для обозначения коммерческой организации или фирмы.",
                        "zh": "单词 company 的缩写，指公司或企业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "организация"
                            },
                            {
                                "target_lang_word": "Ко",
                                "target_lang_sense_clarification": "в названиях фирм (напр., Смит и Ко)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司",
                                "target_lang_sense_clarification": "商业组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c69ddfd-23a8-3cba-8449-dc577bc908d3",
                    "sense_definition": "An initialism for <w>commanding</w> <w>officer</w>, the officer in charge of a military unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "officer_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier requested permission to speak directly with his <w>CO</w>.",
                            "target_lang_translations": {
                                "ru": "Солдат попросил разрешения поговорить напрямую со своим <w>командиром</w>.",
                                "zh": "这名士兵请求允许直接与他的<w>指挥官</w>谈话。"
                            }
                        },
                        {
                            "text": "As the new <w>CO</w>, she implemented stricter training schedules for the troops.",
                            "target_lang_translations": {
                                "ru": "Как новый <w>командир</w>, она ввела более строгие графики тренировок для войск.",
                                "zh": "作为新任<w>指挥官</w>，她为部队推行了更严格的训练日程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commander"
                    ],
                    "antonyms": [
                        "subordinate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"commanding officer\" (командующий офицер), офицер, возглавляющий воинское подразделение.",
                        "zh": "commanding officer 的首字母缩略词，指部队指挥官或长官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "командир",
                                "target_lang_sense_clarification": "военный начальник"
                            },
                            {
                                "target_lang_word": "командующий офицер",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指挥官",
                                "target_lang_sense_clarification": "军队长官"
                            },
                            {
                                "target_lang_word": "长官",
                                "target_lang_sense_clarification": "部队长官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a514fe0-6afc-331c-ac14-92fd8a5cf08d",
                    "sense_definition": "An abbreviation of <w>county</w>, used in writing to refer to a specific administrative region.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "county_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was born in a small village in <w>Co</w> Cork, Ireland.",
                            "target_lang_translations": {
                                "ru": "Он родился в маленькой деревне в <w>графстве</w> Корк, Ирландия.",
                                "zh": "他出生于爱尔兰科克<w>郡</w>的一个小村庄。"
                            }
                        },
                        {
                            "text": "The official letter was addressed to a resident of <w>Co</w> Durham.",
                            "target_lang_translations": {
                                "ru": "Официальное письмо было адресовано жителю <w>графства</w> Дарем.",
                                "zh": "这封正式信函寄给了达勒姆<w>郡</w>的一位居民。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"county\" (графство), используемое на письме для обозначения определенного административного региона.",
                        "zh": "county 的缩写，书面语中用指县或郡等行政区划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "графство",
                                "target_lang_sense_clarification": "административная единица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "郡",
                                "target_lang_sense_clarification": "英国、爱尔兰等的行政区划"
                            },
                            {
                                "target_lang_word": "县",
                                "target_lang_sense_clarification": "行政区划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e213682d-c15d-35b4-8328-480c56de60e2",
                    "sense_definition": "An initialism for <w>corrections</w> <w>officer</w>, a guard responsible for supervising inmates in a prison.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "officer_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>CO</w> monitored the inmates closely during their recreation time.",
                            "target_lang_translations": {
                                "ru": "<w>Надзиратель</w> внимательно следил за заключенными во время их отдыха.",
                                "zh": "在囚犯的放风时间内，<w>狱警</w>严密监视着他们。"
                            }
                        },
                        {
                            "text": "Being a <w>CO</w> requires patience and strict adherence to safety protocols.",
                            "target_lang_translations": {
                                "ru": "Работа <w>тюремным охранником</w> требует терпения и строгого соблюдения протоколов безопасности.",
                                "zh": "成为一名<w>狱警</w>需要耐心并严格遵守安全规程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prison guard",
                        "warden"
                    ],
                    "antonyms": [
                        "prisoner",
                        "inmate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"corrections officer\" (сотрудник исправительного учреждения), охранник, ответственный за надзор за заключенными в тюрьме.",
                        "zh": "corrections officer 的首字母缩略词，指在监狱监督囚犯的狱警。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надзиратель",
                                "target_lang_sense_clarification": "тюремный охранник"
                            },
                            {
                                "target_lang_word": "сотрудник исправительного учреждения",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狱警",
                                "target_lang_sense_clarification": "监狱看守人员"
                            },
                            {
                                "target_lang_word": "管教人员",
                                "target_lang_sense_clarification": "惩教官员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddb2c62e-48df-3555-b8b1-177e4b86a09f",
                    "sense_definition": "An initialism for <w>conscientious</w> <w>objector</w>, someone who refuses to serve in the military for moral or religious reasons.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "objector_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the war, he registered as a <w>CO</w> because of his pacifist beliefs.",
                            "target_lang_translations": {
                                "ru": "Во время войны он зарегистрировался как <w>отказник по идейным соображениям</w> из-за своих пацифистских убеждений.",
                                "zh": "战争期间，出于和平主义信仰，他登记成为一名<w>良心拒服兵役者</w>。"
                            }
                        },
                        {
                            "text": "Many people did not understand the motives of a <w>CO</w> at that time.",
                            "target_lang_translations": {
                                "ru": "Многие люди в то время не понимали мотивов <w>отказников</w>.",
                                "zh": "那时很多人不理解一名<w>良心拒服兵役者</w>的动机。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"conscientious objector\" (отказник по соображениям совести), человек, отказывающийся служить в армии по моральным или религиозным причинам.",
                        "zh": "conscientious objector 的首字母缩略词，指因道德或宗教原因拒绝服兵役者（良心拒服兵役者）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказник по идейным соображениям",
                                "target_lang_sense_clarification": "статус"
                            },
                            {
                                "target_lang_word": "альтернативщик",
                                "target_lang_sense_clarification": "разг., проходящий альтернативную службу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "良心拒服兵役者",
                                "target_lang_sense_clarification": "因良心或信仰拒服兵役的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "744f3433-5202-3267-92df-60283c50a7dc",
                    "sense_definition": "The abbreviation for <w>Colorado</w>, a state in the western United States.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Our summer road trip ended in the mountains near Denver, <w>CO</w>.",
                            "target_lang_translations": {
                                "ru": "Наше летнее автопутешествие закончилось в горах недалеко от Денвера, штат <w>Колорадо</w>.",
                                "zh": "我们的夏季公路旅行在<w>科罗拉多州</w>丹佛附近的山区结束。"
                            }
                        },
                        {
                            "text": "Please send the application form to the address in Boulder, <w>CO</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отправьте анкету по адресу в Боулдере, <w>Колорадо</w>.",
                                "zh": "请将申请表寄往<w>科罗拉多州</w>博尔德的地址。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура штата Колорадо на западе США.",
                        "zh": "美国西部科罗拉多州（Colorado）的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Колорадо",
                                "target_lang_sense_clarification": "штат США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科罗拉多州",
                                "target_lang_sense_clarification": "美国地名缩写"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "3cd60904-1528-37e1-8cc8-ae42901c8e0a",
                    "sense_definition": "A gender-neutral personal pronoun used to refer to a person without specifying gender.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If a member arrives late, <w>co</w> must sign in at the front desk.",
                            "target_lang_translations": {
                                "ru": "Если участник опаздывает, <w>он</w> должен зарегистрироваться на стойке регистрации.",
                                "zh": "如果有成员迟到，<w>TA</w>必须在前台签到。"
                            }
                        },
                        {
                            "text": "I asked the author about the book, and <w>co</w> explained the main theme.",
                            "target_lang_translations": {
                                "ru": "Я спросил автора о книге, и <w>тот</w> объяснил главную тему.",
                                "zh": "我向作者询问了这本书，<w>TA</w>解释了主题思想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "they"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "neologism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гендерно-нейтральное личное местоимение, используемое для обозначения человека без указания его пола.",
                        "zh": "一种性别中立的人称代词，用于指代某人而不表明其性别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "он/она",
                                "target_lang_sense_clarification": "функциональный перевод"
                            },
                            {
                                "target_lang_word": "тот",
                                "target_lang_sense_clarification": "указательное местоимение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该人",
                                "target_lang_sense_clarification": "性别中立指称"
                            },
                            {
                                "target_lang_word": "TA",
                                "target_lang_sense_clarification": "网络及日常中立人称代词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64edd7b3-d60d-33ca-bdd5-11c98cb5f6e9",
                    "sense_definition": "An abbreviation for <w>cast</w> <w>on</w>, used in knitting instructions to indicate starting a new piece.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To begin the scarf, <w>co</w> twenty stitches on the needle.",
                            "target_lang_translations": {
                                "ru": "Чтобы начать шарф, <w>наберите</w> двадцать петель на спицу.",
                                "zh": "开始织围巾时，在针上<w>起针</w>二十针。"
                            }
                        },
                        {
                            "text": "The pattern says to <w>co</w> loosely so the edge is stretchy.",
                            "target_lang_translations": {
                                "ru": "В схеме сказано <w>набирать петли</w> свободно, чтобы край тянулся.",
                                "zh": "编织图样要求松一点<w>起针</w>，好让边缘具有弹性。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "knitting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"cast on\" (набор петель), используемое в инструкциях по вязанию для обозначения начала нового изделия.",
                        "zh": "cast on 的缩写，编织术语，指起针以开始编织一件新物件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набрать петли",
                                "target_lang_sense_clarification": "вязание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起针",
                                "target_lang_sense_clarification": "编织术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}