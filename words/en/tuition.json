{
    "word_family": [
        "tutor",
        "tutorial",
        "tutelage",
        "tutoress"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e0ab8d1-a7e5-3aca-9144-b501f52c1de7",
                    "sense_definition": "A sum of money paid for instruction at a school, college, or university.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "education costs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to increase <w>tuition</w> by five percent for the next academic year.",
                            "target_lang_translations": {
                                "ru": "Университет решил повысить <w>плату за обучение</w> на пять процентов на следующий учебный год."
                            }
                        },
                        {
                            "text": "Many students rely on loans to cover their <w>tuition</w> fees and living expenses.",
                            "target_lang_translations": {
                                "ru": "Многие студенты полагаются на кредиты, чтобы покрыть <w>расходы на обучение</w> и расходы на проживание."
                            }
                        }
                    ],
                    "synonyms": [
                        "tuition fees"
                    ],
                    "common_phrases": [
                        "pay tuition",
                        "college tuition",
                        "university tuition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, выплачиваемая за обучение в школе, колледже или университете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плата за обучение",
                                "target_lang_sense_clarification": "денежный взнос"
                            },
                            {
                                "target_lang_word": "стоимость обучения",
                                "target_lang_sense_clarification": "цена образовательных услуг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9335abd9-13d7-3d9d-88ed-ed827afe88ce",
                    "sense_definition": "The act of teaching or the instruction provided by a teacher or tutor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school provides excellent <w>tuition</w> in mathematics and the sciences.",
                            "target_lang_translations": {
                                "ru": "Школа обеспечивает отличное <w>обучение</w> математике и естественным наукам."
                            }
                        },
                        {
                            "text": "She received private <w>tuition</w> to help her prepare for the entrance exam.",
                            "target_lang_translations": {
                                "ru": "Она брала частные <w>уроки</w>, чтобы подготовиться к вступительному экзамену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "private tuition",
                        "individual tuition",
                        "receive tuition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс преподавания или наставления, предоставляемые учителем или репетитором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучение",
                                "target_lang_sense_clarification": "процесс передачи знаний"
                            },
                            {
                                "target_lang_word": "преподавание",
                                "target_lang_sense_clarification": "деятельность учителя"
                            },
                            {
                                "target_lang_word": "занятия",
                                "target_lang_sense_clarification": "учебные уроки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e075ab4-9885-3403-9cf1-0801796e96ba",
                    "sense_definition": "Paid private classes or tutoring taken outside of the formal education system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many parents send their children to <w>tuition</w> classes after school to improve their grades.",
                            "target_lang_translations": {
                                "ru": "Многие родители отправляют своих детей на дополнительные <w>занятия</w> после школы, чтобы улучшить их оценки."
                            }
                        },
                        {
                            "text": "The demand for extra <w>tuition</w> has grown significantly in recent years.",
                            "target_lang_translations": {
                                "ru": "Спрос на дополнительные <w>уроки</w> значительно вырос в последние годы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tuition classes",
                        "extra tuition",
                        "after-school tuition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Платные частные уроки или репетиторство вне формальной системы образования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетиторство",
                                "target_lang_sense_clarification": "частные уроки"
                            },
                            {
                                "target_lang_word": "дополнительные занятия",
                                "target_lang_sense_clarification": "внешкольное обучение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e015c8d4-1839-3731-b6ba-798062fa9526",
                    "sense_definition": "The state of being under care or guardianship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guardianship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the character commits his friend to the <w>tuition</w> of God.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе герой вверяет своего друга <w>попечению</w> Бога."
                            }
                        },
                        {
                            "text": "The orphan was placed under the <w>tuition</w> of a distant relative.",
                            "target_lang_translations": {
                                "ru": "Сирота был передан под <w>опеку</w> дальнего родственника."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean guardianship"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения под опекой или попечительством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "архаичное, опека"
                            },
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "надзор и забота"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}