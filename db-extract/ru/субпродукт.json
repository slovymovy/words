                    {
                        "translation_id": "55fb35d1-59d8-4dac-9fdb-c7ee945f74c3",
                        "source_entry_id": "815fab9e-fc72-3ed9-8b86-12fb0822cd8c",
                        "source_sense_id": "9ffe6d1f-092b-3260-81c2-145346d6e121",
