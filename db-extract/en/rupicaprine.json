        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a41193f3-07de-3d26-8f13-fdc743a21f74",
                "word": "rupicaprine",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "947f9713-5bbb-3fb8-9a55-ee564a2c2cd7",
                        "entry_id": "a41193f3-07de-3d26-8f13-fdc743a21f74",
                        "glosses": [
                            "Relating to, or resembling, the chamois, or other extinct mammals of the genus Rupicapra."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd1b624-0588-483f-94c3-c5fa662a9138",
                                "sense_id": "947f9713-5bbb-3fb8-9a55-ee564a2c2cd7",
                                "text": "They are also sometimes called the Rupicaprine antelopes from the scientific name of the chamois (Rupicapra)."
                            },
                            {
                                "example_id": "d9039eb5-ac47-4bfe-b31d-0ec230fba503",
                                "sense_id": "947f9713-5bbb-3fb8-9a55-ee564a2c2cd7",
                                "text": "Conspicuous among the new arrivals is the mountain goat (Oreamnos), the first member of the rupicaprine division of the antelope family to be recorded in North America."
                            },
                            {
                                "example_id": "294cc78b-1d01-4bc6-a13d-fad50cd50cd7",
                                "sense_id": "947f9713-5bbb-3fb8-9a55-ee564a2c2cd7",
                                "text": "Among the ungulate world, the entries were much more limited, restricted, in fact, to the first elk of the species Libralces gallicus (from the site of Sene`ze, France), sometimes included in the genus Cervalces; the rupicaprine bovid Gallogoral Gallogoral meneghini; and one species of the ovibovine bovid Praeovibos (whose oldest record comes from the latest Pliocene beds of Almenara I and Barranco Conejos, Spain)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d5b78313-5603-339f-bb58-0340060d37fc",
                "word": "rupicaprine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dd9a0946-7c12-43de-8830-654453731344",
                        "entry_id": "d5b78313-5603-339f-bb58-0340060d37fc",
                        "tags": [
                            "plural"
