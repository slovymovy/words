            {
                "entry_id": "2874e22a-b9e7-3304-af4c-c065146437a6",
                "word": "inélastique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc3bb11b-b8c4-4a92-9665-e3cfacb5acef",
                        "entry_id": "2874e22a-b9e7-3304-af4c-c065146437a6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inélastiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86e461b7-85ff-37cf-a0b0-2bd5e6dcc3b7",
                        "entry_id": "2874e22a-b9e7-3304-af4c-c065146437a6",
                        "glosses": [
                            "Qui est dépourvu d’élasticité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48b5cee-1065-4037-8274-50bd33976e97",
                                "sense_id": "86e461b7-85ff-37cf-a0b0-2bd5e6dcc3b7",
                                "text": "La dépense globale augmente en même temps que les prix : la demande est inélastique."
                            }
                        ]
                    },
                    {
                        "sense_id": "26d6acdc-c18b-353a-a708-ba5479d06bd9",
                        "entry_id": "2874e22a-b9e7-3304-af4c-c065146437a6",
                        "glosses": [
                            "Qualifie une collision dans laquelle l’énergie cinétique des corps qui entrent en collision est totalement ou en partie convertie en énergie interne dans au moins un des corps."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "83b007b1-82ab-4dbf-9e00-60012c42081f",
                                "sense_id": "26d6acdc-c18b-353a-a708-ba5479d06bd9",
                                "text": "Deuxièmement, au moment où il traverse l’échantillon, un électron du faisceau peut subir des chocs inélastiques avec des électrons composant l’échantillon."
                            },
                            {
                                "example_id": "330f40b8-e088-4f12-acff-49a4b251b784",
                                "sense_id": "26d6acdc-c18b-353a-a708-ba5479d06bd9",
                                "text": "Les collisions inélastiques dans le plan équatorial ont aussi pour effet d’accélérer la croissance des planétoïdes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "486615b9-3297-4839-8432-55c8e9481faa",
                        "source_entry_id": "2874e22a-b9e7-3304-af4c-c065146437a6",
                        "target_lang_word": "inelastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inelastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                        "entry_id": "95eed094-f773-375a-be99-76d0aed519fc",
                                        "glosses": [
                                            "Lacking elasticity; inflexible, unyielding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8fb3fb-3fe8-4668-b5e5-fb3794d06bfe",
                                                "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                                "text": "He spoke languidly, and only those few words, like a watch with an inelastic spring, that just ticks a moment or two and stops again."
                                            },
                                            {
                                                "example_id": "3d9d670a-c356-439b-a279-d6ac70e89a04",
                                                "sense_id": "75885b43-a302-305e-a1ca-10ce4d3445f0",
                                                "text": "I cannot believe that Christ himself intended that his religion should be so inelastic, so hard and fast, so cruel as you imply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                        "entry_id": "95eed094-f773-375a-be99-76d0aed519fc",
                                        "glosses": [
                                            "Insensitive to changes in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546b7534-993f-4d17-925e-047fb4142c1d",
                                                "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                                "text": "perfectly inelastic supply"
                                            },
                                            {
                                                "example_id": "8c22650d-536a-46f3-ae5b-7bbd6c2e80d2",
                                                "sense_id": "7c73d3c8-e1be-3d65-9e3b-363512db3b62",
                                                "text": "A different approach is needed now, as there is more discretionary travel which, unlike the use of season tickets, does not have inelastic demand characteristics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b3ffdd-1d26-318e-b674-d8c6af826e37",
                                        "entry_id": "95eed094-f773-375a-be99-76d0aed519fc",
                                        "glosses": [
                                            "Resistant to swings during elections; predictable."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
