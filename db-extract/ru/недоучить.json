                        "examples": [
                            {
                                "example_id": "2782233d-0961-4996-99dd-e9cdf95eb130",
                                "sense_id": "f18dc903-d1c6-364f-b0e7-933bb6bb55eb",
                                "text": "А́нна Фёдоровна заме́тила ма́тушке, что неду́рно бы бы́ло, е́сли бы и я ста́ла учи́ться, зате́м что в пансио́не меня́ недоучи́ли.",
                                "translation": "Anna Fyodorovna observed to mother that it would not be amiss if I were to have lessons, since my education had not been finished at the boarding-school…",
                                "english": "Anna Fyodorovna observed to mother that it would not be amiss if I were to have lessons, since my education had not been finished at the boarding-school…"
                            }
                        ]
                    }
