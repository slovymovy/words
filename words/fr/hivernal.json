                    "sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                    "sense_definition": "Relatif à l'hiver ; qui a lieu ou se produit pendant cette saison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "saison_hiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant la saison <w>hivernale</w>, les routes de montagne sont souvent fermées à cause de la neige."
                        },
                        {
                            "text": "La loi impose une trêve <w>hivernale</w> afin d'éviter les expulsions durant les mois froids."
                        }
                    ],
                    "antonyms": [
                        "estival"
                    ],
                    "common_phrases": [
                        "saison hivernale",
                        "trêve hivernale"
                    ]
                },
                {
                    "sense_id": "a8a0a078-e39a-3f13-9a41-9a36ca497dfb",
                    "sense_definition": "Qui évoque ou rappelle l'hiver, notamment par son froid ou sa rudesse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saison_hiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un vent particulièrement <w>hivernal</w> souffle sur toute la vallée depuis ce matin."
                        },
                        {
                            "text": "Le ciel gris et la brume créent une atmosphère <w>hivernale</w> dans tout le village."
                        }
                    ],
                    "antonyms": [
