                                "target_senses": [
                                    {
                                        "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                        "entry_id": "26bbce7e-ced8-352e-a7ad-1cca67aabc55",
                                        "glosses": [
                                            "The origin, start, or point at which something comes into being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f07717b5-08ce-4011-8824-634ff1244bbe",
                                                "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                                "text": "Some point to the creation of Magna Carta as the genesis of English common law."
                                            },
                                            {
                                                "example_id": "1175eb0a-b152-4cc0-90bf-2a6ce7de152c",
                                                "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                                "text": "The genesis of the Chinese bronze mirror can be traced far back into the Chou dynasty. Some pieces that may possibly date from the eighth century b.c., but certainly predate the year 655 b.c., were unearthed in 1956–1957 at Shang-ts’ung-ling near San-men-hsia in western Honan Province."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cff5f122-5dae-4735-a01f-78e81bcbfb66",
                        "source_entry_id": "9152a26f-3b59-3585-adff-ad26f0369476",
                        "source_sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                        "source_sense_description": "die Entstehung, Entwicklung, Herkunft",
                        "target_lang_word": "genèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0505c011-6fb4-32c8-a16e-919eda2832f4",
                                        "entry_id": "e4c76cfa-764f-34f6-b810-8fe5079e63e6",
                                        "glosses": [
                                            "Production, développement, croissance, début."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f4f698-a48b-4fff-8597-387262ce43fb",
                                                "sense_id": "0505c011-6fb4-32c8-a16e-919eda2832f4",
                                                "text": "De toute manière, Marseille, en tant que ville, a un splendide avenir ; de grandes choses s’y préparent, un aspect cosmopolite de la civilisation y est en genèse."
                                            },
                                            {
                                                "example_id": "2419d085-c981-48d6-9d28-b27e5d23c9b8",
                                                "sense_id": "0505c011-6fb4-32c8-a16e-919eda2832f4",
                                                "text": "Ce sont donc les lunettes d’Argand que nous emprunterons pour suivre, à cinquante millions d’années de distance, la genèse des Alpes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16442e3-a224-3cd1-97b8-9e2a9b9a3ac6",
                                        "entry_id": "e4c76cfa-764f-34f6-b810-8fe5079e63e6",
                                        "glosses": [
                                            "Création, production des œuvres de l’esprit humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6dabd5-95bf-44bf-bb3b-fc90046ee1fc",
                                                "sense_id": "b16442e3-a224-3cd1-97b8-9e2a9b9a3ac6",
                                                "text": "La genèse d’un livre, d’une œuvre d’art."
                                            },
                                            {
                                                "example_id": "2d9eeb28-e219-4c86-b00c-a9b10eb63cc2",
                                                "sense_id": "b16442e3-a224-3cd1-97b8-9e2a9b9a3ac6",
                                                "text": "La genèse d’une doctrine, d’une théorie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
