                "senses": [
                    {
                        "sense_id": "a122c65a-71a6-3f7f-b565-56d1712557b9",
                        "entry_id": "cfef8c29-dc9a-3fd1-9e6c-e09519677304",
                        "glosses": [
                            "Se nourrir au sein, à la mamelle, de."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f529b8ce-350e-4a2a-9550-08be8d72f5a9",
                                "sense_id": "a122c65a-71a6-3f7f-b565-56d1712557b9",
                                "text": "Vous vous rendez compte comme ils peigneraient, claudiqueraient, sueraient, maugréeraient, perdraient le contact, les amoindris, les bougreux, les frileux ; tous ceux dont le cerveau sonne pas libre, ceux qui mamellent de la France, ceux qui s'astreignent à contraindre et ceux qui sont contraints d'astreindre ?"
                            },
                            {
                                "example_id": "a33309ae-3019-4ee0-a5f9-d30cdd6677b9",
                                "sense_id": "a122c65a-71a6-3f7f-b565-56d1712557b9",
                                "text": "Je te vois « mamellant » la Police Montée…"
                            },
                            {
                                "example_id": "bac058a1-e7b6-4ad0-9fbf-3419274a0a33",
                                "sense_id": "a122c65a-71a6-3f7f-b565-56d1712557b9",
                                "text": "Le bateau était fou, à en prendre la frousse, un vieillard mamellait une trop maigre rousse au pubis chargé d'une incroyable mousse."
                            },
                            {
                                "example_id": "4041f98b-27d9-4d65-bf2c-8d184f9176be",
                                "sense_id": "a122c65a-71a6-3f7f-b565-56d1712557b9",
                                "text": "Ceux qui mamellent de la France."
                            }
                        ]
                    }
                ],
