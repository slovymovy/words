                ],
                "senses": [
                    {
                        "sense_id": "4b466bbe-18c7-3859-9252-0df95aadac46",
                        "entry_id": "c9560b50-7183-3138-8b01-d46d7d0bef0d",
                        "glosses": [
                            "Science pluridisciplinaire pour l’étude de la physiologie du système nerveux, allant du niveau moléculaire jusqu’aux réseaux neuronaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928ccd2d-a8c5-46e3-8dc4-87d862f1cee2",
                                "sense_id": "4b466bbe-18c7-3859-9252-0df95aadac46",
                                "text": "Une deuxième raison, en partie corollaire de la première, résulte des développements de la neurophysiologie, branche de la biologie qui étudie le fonctionnement du système nerveux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55c3a9b8-ecb2-46ca-99f3-74b8fa27f648",
                        "source_entry_id": "c9560b50-7183-3138-8b01-d46d7d0bef0d",
                        "source_sense_id": "4b466bbe-18c7-3859-9252-0df95aadac46",
                        "target_lang_word": "Neurophysiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurophysiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "267fcb87-3e17-3829-b5be-23c795170ab5",
                                        "entry_id": "0bfc7731-c140-3954-aa10-6ab9c6d432bc",
                                        "glosses": [
                                            "zur Physiologie gehörendes Gebiet, das sich mit der Aktivität des Nervensystems auseinandersetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4914d565-5bd5-466a-9554-86fbbb6e18f2",
                                                "sense_id": "267fcb87-3e17-3829-b5be-23c795170ab5",
                                                "text": "„Die moderne Biologe umfasst Fächer wie Genetik, Molekularbiologie, Immunologie, Zellbiologie, Neurophysiologie, Humanbiologie, Biochemie, Mikrobiologie, Biotechnologie, Entwicklungsphysiologie, Ökologie etc.“"
                                            },
                                            {
                                                "example_id": "53d6a6b9-dbd3-4cc5-8812-09a383bc2bf8",
                                                "sense_id": "267fcb87-3e17-3829-b5be-23c795170ab5",
                                                "text": "„Die Erforschung der Wahrnehmung, bei der Erkenntnistheorie, Psychologie, Ethologie, Neurophysiologie und der Bereich der künstlichen Intelligenz eng miteinander verflochten sind, bildet den Kern der gegenwärtigen Kognitionsforschung […]“"
                                            },
                                            {
                                                "example_id": "f4376d19-d077-4638-91a0-8e529538ca65",
                                                "sense_id": "267fcb87-3e17-3829-b5be-23c795170ab5",
                                                "text": "„Die großen Fortschritte der Neurophysiologie und der Behandlungsmethodik der Sprachstörungen haben zweifelsohne neue Impulse für die Untersuchung des Verhältnisses zwischen Sprache und Denken gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e454f1d-3203-4f9b-9064-b99ef2fb0465",
                        "source_entry_id": "c9560b50-7183-3138-8b01-d46d7d0bef0d",
