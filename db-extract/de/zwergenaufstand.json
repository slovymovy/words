                "senses": [
                    {
                        "sense_id": "9b293f26-bdb5-3e87-b639-90d74d02aed4",
                        "entry_id": "303c33b1-fb8e-331f-b468-5777fd4dfec7",
                        "glosses": [
                            "überflüssige oder nicht erfolgversprechende Aufregung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36df0f1-ba21-4144-a343-4c1350886084",
                                "sense_id": "9b293f26-bdb5-3e87-b639-90d74d02aed4",
                                "text": "„Fehlen diese Machtmittel, dann gleichen Anweisungen eher einem Zwergenaufstand.“"
                            },
                            {
                                "example_id": "c7eb003a-dac0-4948-b6e5-8676fbe1c013",
                                "sense_id": "9b293f26-bdb5-3e87-b639-90d74d02aed4",
                                "text": "„Doch nun beginnt vor Dir der Zwergenaufstand.“"
                            },
                            {
                                "example_id": "3f2ddfd5-4feb-47f5-be23-337cafbcb836",
                                "sense_id": "9b293f26-bdb5-3e87-b639-90d74d02aed4",
                                "text": "„Nach dem übertriebenen, völlig unnötigen Zwergenaufstand ihres blonden Riesen hatte Heide sich allerdings fest vorgenommen, heute gegen das morgendliche Ritual zu verstoßen.“"
                            },
                            {
                                "example_id": "4f9a4eb6-099f-4fc1-ac22-6123dee41708",
                                "sense_id": "9b293f26-bdb5-3e87-b639-90d74d02aed4",
                                "text": "„Er drehte sich um und schlenderte mit seiner Reisetasche aus Krokoleder weiter, bevor doch noch ein Zwergenaufstand ausbrach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
