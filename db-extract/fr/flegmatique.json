                            "feminine"
                        ],
                        "form": "flegmatiques"
                    },
                    {
                        "form_id": "9b3b28ff-cc04-44ed-8511-a2eadf28c355",
                        "entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                        "tags": [],
                        "form": "phlegmatique"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                        "entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                        "glosses": [
                            "Qui se départ rarement de son calme, qui s’émeut difficilement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d27d659f-a419-471d-a084-1048a84c0d33",
                                "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                                "text": "[…] il est peu réconfortant pour un voyageur, si flegmatique qu’il soit, d’apprendre qu’à l’endroit même où il est, le pied glissa à un autre, et que cet autre s’est tué."
                            },
                            {
                                "example_id": "e1bfe96d-41cc-40ef-a54c-405a32eb0960",
                                "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                                "text": "Le speaker psalmodiait les nouvelles de la nuit avec cette distinction flegmatique qui entretiendrait encore longtemps l’illusion de la grandeur britannique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0574f043-8c1f-3b47-a590-b82f4874f2b6",
                        "entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                        "glosses": [
                            "Lymphatique."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89b97e1e-e30e-44a9-8b5f-17fe5d727595",
                        "source_entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                        "target_lang_word": "phlegmatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phlegmatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b44d431-79a4-3965-8eab-a90ddf3405a2",
                                        "entry_id": "39890fee-653a-366c-a9cd-f632b01af1d0",
                                        "glosses": [
                                            "kaum zu erregen; nur schwer zu einer Handlung motivierbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6313b9e7-4fd3-4e72-a270-aa894bb8d1a9",
                                                "sense_id": "4b44d431-79a4-3965-8eab-a90ddf3405a2",
                                                "text": "Den Jungen können wir im Betrieb nicht brauchen, er ist zu phlegmatisch."
                                            },
                                            {
                                                "example_id": "408c3bbe-5ab9-4570-83a7-5ad160b4f060",
                                                "sense_id": "4b44d431-79a4-3965-8eab-a90ddf3405a2",
                                                "text": "„Ich konnte mir zunächst nicht vorstellen, daß der ernste, phlegmatische und wortkarge Mann, Hans Bielke mit Namen, ein Jäger sein sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3e4ab19-1bda-4fe8-9823-aef38d663681",
                        "source_entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                        "target_lang_word": "phlegmatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phlegmatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5433056d-bd18-372b-b81a-a15f9f832b60",
                                        "entry_id": "4acce5c8-1dec-30b8-b8e6-dcb7fee842b4",
                                        "glosses": [
                                            "Not easily excited to action or passion; calm; sluggish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bf90b2-44a2-40b9-bfe9-2b8842413dca",
                                                "sense_id": "5433056d-bd18-372b-b81a-a15f9f832b60",
                                                "text": "Calm and phlegmatic, with a clear eye, Mr. Fogg seemed a perfect type of that English composure which Angelica Kauffmann has so skilfully represented on canvas."
                                            },
                                            {
                                                "example_id": "70df4bf8-bcba-4290-9514-bd82e29daef8",
                                                "sense_id": "5433056d-bd18-372b-b81a-a15f9f832b60",
                                                "text": "2013, A.O. Scott, “How It Looks to Think: Watch Her,” Rev. of Hannah Arendt, dir. by Margarethe von Trotta, New York Times 29 May 2013: C1. Print.\nTheir friendship (immortalized in a splendid volume of letters that has clearly served as one of Ms. von Trotta's sources) is a fascinating study in cultural and temperamental contrast, an impulsive and witty American paired with a steady, phlegmatic German."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8866c521-7f6a-34e4-ac79-a2d971b94b6d",
                                        "entry_id": "4acce5c8-1dec-30b8-b8e6-dcb7fee842b4",
                                        "glosses": [
                                            "Generating, causing, or full of phlegm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72253a7-bf14-452d-8536-0ab7401eac9a",
                                                "sense_id": "8866c521-7f6a-34e4-ac79-a2d971b94b6d",
                                                "text": "cold and phlegmatic bodies"
                                            },
                                            {
                                                "example_id": "46f6f98c-d3f5-4f29-b153-0b136e564aee",
                                                "sense_id": "8866c521-7f6a-34e4-ac79-a2d971b94b6d",
                                                "text": "Near-synonyms: phlegmish, phlegmy"
                                            },
                                            {
                                                "example_id": "89b68203-b648-4cdf-84c8-9a092675a0e6",
                                                "sense_id": "8866c521-7f6a-34e4-ac79-a2d971b94b6d",
                                                "text": "phlegmatic humors"
                                            },
                                            {
                                                "example_id": "0eaff2dc-c18f-4eb2-bf42-8716d3e74477",
                                                "sense_id": "8866c521-7f6a-34e4-ac79-a2d971b94b6d",
                                                "text": "a phlegmatic constitution"
                                            }
                                        ]
                                    }
