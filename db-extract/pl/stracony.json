                                        "examples": [
                                            {
                                                "example_id": "cf9491cf-69b8-4b76-856d-765785a0dd62",
                                                "sense_id": "233bda9f-fb86-34a4-9b7d-4a1e758ab622",
                                                "text": "Deep beneath the ocean, the Titanic was lost to the world."
                                            }
                                        ]
                                    },
