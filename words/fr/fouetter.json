                    "frequency": "Low",
                    "semantic_group_id": "stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bonne douche froide le matin aide toujours à <w>fouetter</w> le sang et à bien démarrer."
