                    {
                        "translation_id": "3f14c80f-c6d7-4f62-b237-99b3803f9b61",
                        "source_entry_id": "b3a3b010-708e-38fe-8fd7-324800882773",
                        "source_sense_id": "99849e0d-4411-350d-80b6-83d220d6bfb2",
