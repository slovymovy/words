                "translations": [
                    {
                        "translation_id": "a8950556-137c-4a22-a127-137567992a27",
                        "source_entry_id": "5749c338-014c-3f69-b479-c609bd092e51",
                        "source_sense_id": "3f288d67-9236-356f-9c3a-511ebc77f36f",
