                                        "sense_id": "5bce36bd-a5e6-3b2b-b3b4-b44929a4e45d",
                                        "entry_id": "0d2b840c-99e1-3b42-9721-a045f43b2a25",
                                        "glosses": [
                                            "een tak van de wiskunde waarin het nemen van beslissingen centraal staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d7bbfa-8b66-4396-abfa-e2752f7331d2",
                                                "sense_id": "5bce36bd-a5e6-3b2b-b3b4-b44929a4e45d",
                                                "text": "De leraar is extreem geïnteresseerd in schaken, speltheorie en met name het Nash-evenwicht in het licht van de internationale politiek."
                                            },
                                            {
                                                "example_id": "538e9058-a0c3-4cca-87c8-1a5c84dc910f",
                                                "sense_id": "5bce36bd-a5e6-3b2b-b3b4-b44929a4e45d",
                                                "text": "Het levensverhaal van Nash werd in 2001 verfilmd in het Oscar-winnende A Beautiful Mind, maar ook zonder de film maakte de wiskundige een onuitwisbare indruk volgens Dijkgraaf: \"Ik denk dat hij bij een handjevol wiskundige geniën van de twintigste eeuw hoort. Nash heeft, behalve de speltheorie, dingen gedaan in de meetkunde en met differentiaalvergelijkingen die totaal uit het niets kwamen.\""
                                            }
