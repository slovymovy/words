                                                "sense_id": "80b6ccce-298a-3802-984a-86391e8c81b8",
                                                "text": "Yvonne always wondered why Ernest had singled her out of the group of giggling girls she hung around with."
                                            },
                                            {
                                                "example_id": "b4e0169f-c967-4a1a-be3e-fbe09c9bd798",
                                                "sense_id": "80b6ccce-298a-3802-984a-86391e8c81b8",
                                                "text": "For quotations using this term, see Citations:single out."
                                            },
