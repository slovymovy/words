                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teasing</w> of her curls took nearly an hour with the fine-tooth comb.",
                            "target_lang_translations": {
                                "ru": "<w>Начесывание</w> её кудрей заняло почти час с помощью гребня с частыми зубьями."
                            }
                        },
                        {
                            "text": "She finished the <w>teasing</w> and sprayed her hair to keep it in place.",
                            "target_lang_translations": {
                                "ru": "Она закончила <w>начесывание</w> и сбрызнула волосы лаком, чтобы зафиксировать прическу."
                            }
                        }
                    ],
                    "synonyms": [
                        "comb-out"
