                ],
                "senses": [
                    {
                        "sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                        "entry_id": "02bd7850-8a43-3cd7-a95d-83a6b60c3a1c",
                        "glosses": [
                            "An anadromus and semelparous salmon, Oncorhynchus kisutch, found in the coastal regions of the northern Pacific Ocean, used as a symbol by several Native American tribes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de209a51-687d-46e8-b4d6-fd881137e35f",
                                "sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                                "text": "1996, Committee on Protection and Management of Pacific Northwest Anadromous Salmonids, National Research Council, Upstream: Salmon and Society in the Pacific Northwest, page 105,\nOverall, OCN coho constitute the largest aggregate of coho populations in the United States outside Alaska."
                            },
                            {
                                "example_id": "0052169e-61e3-4287-86c4-d9b0140ecae7",
                                "sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                                "text": "Since 1965, an index live-count method has been used to annually estimate the number of coho salmon in the escapement to the Skagit River."
                            },
                            {
                                "example_id": "5549806f-bbbc-48a4-9d20-0b8b80f15ba5",
                                "sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                                "text": "2000, US Department of Agriculture, Forest Service Sitka Ranger District, Alaska Department of Fish and Game, Redoubt Lake Cabin, Baranof Island: Fish and Wildlife Opportunities, unnumbered page,\nRedoubt Lake has good populations of both coho and sockeye salmon and minor runs of pink salmon and a few chum salmon. The sockeye run peaks during early July, and the coho run begins in August."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1df87be-84cd-4e4c-a445-1fa6813db765",
                        "source_entry_id": "02bd7850-8a43-3cd7-a95d-83a6b60c3a1c",
                        "source_sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                        "source_sense_description": "Oncorhynchus kisutch",
                        "target_lang_word": "Silberlachs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "92bd6caa-d078-4b3a-af5a-2bea886f19b2",
                        "source_entry_id": "02bd7850-8a43-3cd7-a95d-83a6b60c3a1c",
                        "source_sense_id": "6f676325-66f4-3466-9b39-1ff5d9590265",
                        "source_sense_description": "Oncorhynchus kisutch",
                        "target_lang_word": "ки́жуч",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ки́жуч",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c927874-e80a-3e8e-acb1-8842c052741f",
                                        "entry_id": "d124e968-7b1a-38af-8e2c-2ec155ef1293",
                                        "glosses": [
                                            "ихтиол. крупная рыба семейства лососёвых, с ярко-серебристым цветом чешуи (лат. Oncorhynchus kisutch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3fd0c1-492c-4323-b2a8-96acc884a7f2",
                                                "sense_id": "8c927874-e80a-3e8e-acb1-8842c052741f",
                                                "text": "Как именно взрослый лосось и его ближайшие «родственники» — нерка, горбуша, чавыча, кета, кижуч — находят в безбрежном океане путь в ту единственную речку своего рождения, до сих пор остаётся загадкой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a850d2f1-7122-37ef-8236-fd49c476eb9e",
                                        "entry_id": "d124e968-7b1a-38af-8e2c-2ec155ef1293",
                                        "glosses": [
                                            "кулин. мясо такой рыбы, употребляемое в пищу; также кушанье из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8942a8-a01c-4e0f-8639-2cd24cbc07db",
                                                "sense_id": "a850d2f1-7122-37ef-8236-fd49c476eb9e",
                                                "text": "В нём [шалаше] не было ни одного человека, но висело много вяленой рыбы кижуч; подле разведён был огонь, а в реке против шалаша находился для рыбной ловли закол."
                                            },
                                            {
                                                "example_id": "d58b0e55-0cd2-443b-b803-30fc91dc5c9d",
                                                "sense_id": "a850d2f1-7122-37ef-8236-fd49c476eb9e",
                                                "text": "Я остановился у рыбной витрины: форель без головы, кижуч с головой, лимонема, нототения (тушка), путассу, гренадер, минтай индивидуальной заморозки…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
