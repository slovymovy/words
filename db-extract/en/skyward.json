                                            {
                                                "example_id": "561297ed-f1ef-4acb-b32c-aa54fe1df103",
                                                "sense_id": "38d75d01-0fec-33a0-843a-b9800c45d8f3",
                                                "text": "José Garrido (céleste palichon et argent) a bien décoré sa faena au 2ᵉ Fuente Ymbro."
                                            },
                                            {
                                                "example_id": "4e811044-0ca1-45c9-9b1f-6a7f0830c780",
                                                "sense_id": "38d75d01-0fec-33a0-843a-b9800c45d8f3",
                                                "text": "Vêtu de céleste & or : 1 oreille – 1 oreille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
