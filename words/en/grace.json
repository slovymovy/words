{
    "word_family": [
        "graceful",
        "graceless",
        "gracious",
        "disgrace",
        "ungracious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5a1b05e-d94b-35bf-8b3f-b6248dbbdd5f",
                    "sense_definition": "Elegant movement; elegance of movement; balance or poise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "elegance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional dancer moved across the stage with incredible <w>grace</w> and strength.",
                            "target_lang_translations": {
                                "ru": "Профессиональный танцор двигался по сцене с невероятной <w>грацией</w> и силой."
                            }
                        },
                        {
                            "text": "She has a natural <w>grace</w> that makes every movement look effortless and beautiful.",
                            "target_lang_translations": {
                                "ru": "У неё природное <w>изящество</w>, благодаря которому каждое движение кажется легким и красивым."
                            }
                        }
                    ],
                    "synonyms": [
                        "gracefulness"
                    ],
                    "antonyms": [
                        "clumsiness",
                        "awkwardness"
                    ],
                    "common_phrases": [
                        "move with grace",
                        "natural grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элегантность движений; изящество, равновесие или самообладание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грация",
                                "target_lang_sense_clarification": "изящество в движениях"
                            },
                            {
                                "target_lang_word": "изящество",
                                "target_lang_sense_clarification": "красота и соразмерность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fa640ea-ab26-345b-b3c1-e3eeb2be4332",
                    "sense_definition": "Charming, pleasing qualities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elegance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Princess brought <w>grace</w> to an otherwise dull and boring party.",
                            "target_lang_translations": {
                                "ru": "Принцесса привнесла <w>обаяние</w> в эту в остальном унылую и скучную вечеринку."
                            }
                        },
                        {
                            "text": "His writing is full of those <w>graces</w> which a flowery imagination diffuses over literature.",
                            "target_lang_translations": {
                                "ru": "Его слог полон тех <w>красот</w>, которые цветистое воображение привносит в литературу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social graces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обаятельные, приятные качества или манеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезность",
                                "target_lang_sense_clarification": "приятное качество"
                            },
                            {
                                "target_lang_word": "манеры",
                                "target_lang_sense_clarification": "социальные навыки"
                            },
                            {
                                "target_lang_word": "обаяние",
                                "target_lang_sense_clarification": "привлекательность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6eda19b-28b3-34d4-b9c0-b6ac22ab624e",
                    "sense_definition": "A short prayer of thanks before or after a meal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered around the table to say <w>grace</w> before starting their dinner.",
                            "target_lang_translations": {
                                "ru": "Семья собралась за столом, чтобы прочитать <w>молитву</w> перед началом ужина."
                            }
                        },
                        {
                            "text": "It has become less common in modern times to say <w>grace</w> before having a meal.",
                            "target_lang_translations": {
                                "ru": "В наше время стало менее привычным произносить <w>благодарность</w> перед едой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "say grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая благодарственная молитва до или после еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молитва",
                                "target_lang_sense_clarification": "перед едой"
                            },
                            {
                                "target_lang_word": "благодарность",
                                "target_lang_sense_clarification": "за трапезу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9113e4c5-2b44-34da-b474-4f34c95556f1",
                    "sense_definition": "An allowance of extra time granted to a debtor or someone with an obligation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_allowance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank gave him a three-day <w>grace</w> period to pay the overdue bill.",
                            "target_lang_translations": {
                                "ru": "Банк предоставил ему трехдневную <w>отсрочку</w> для оплаты просроченного счета."
                            }
                        },
                        {
                            "text": "The repayment of the student loan starts after a six-month <w>grace</w> following graduation.",
                            "target_lang_translations": {
                                "ru": "Погашение студенческого кредита начинается после шестимесячного <w>льготного периода</w> после окончания учебы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grace period",
                        "days of grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительное время, предоставленное должнику для выполнения обязательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсрочка",
                                "target_lang_sense_clarification": "перенос срока"
                            },
                            {
                                "target_lang_word": "льготный период",
                                "target_lang_sense_clarification": "время без штрафов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "057cea0e-70ec-3124-8fa7-bf0f5bd0681f",
                    "sense_definition": "Free and undeserved favour, especially of God; divine assistance for resisting sin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher spoke about the saving <w>grace</w> of God during the Sunday service.",
                            "target_lang_translations": {
                                "ru": "Проповедник говорил о спасительной <w>благодати</w> Божьей во время воскресной службы."
                            }
                        },
                        {
                            "text": "By the <w>grace</w> of God, they managed to survive the terrible storm.",
                            "target_lang_translations": {
                                "ru": "Божьей <w>милостью</w> им удалось выжить в страшном шторме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saving grace",
                        "state of grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безвозмездная и незаслуженная милость, особенно Божья; божественная помощь в противостоянии греху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благодать",
                                "target_lang_sense_clarification": "божественный дар"
                            },
                            {
                                "target_lang_word": "милость",
                                "target_lang_sense_clarification": "божье благоволение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67e8b078-6f98-3ac6-8f33-98e0e4f41dfa",
                    "sense_definition": "Mercy, pardon, or forgiveness shown toward someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner begged for <w>grace</w> from the king before the sentence was carried out.",
                            "target_lang_translations": {
                                "ru": "Заключенный молил короля о <w>помиловании</w> перед приведением приговора в исполнение."
                            }
                        },
                        {
                            "text": "He showed <w>grace</w> to his enemies by choosing to forgive their past actions.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>милосердие</w> к своим врагам, решив простить их прошлые поступки."
                            }
                        }
                    ],
                    "synonyms": [
                        "mense"
                    ],
                    "antonyms": [
                        "cruelty",
                        "vengeance"
                    ],
                    "common_phrases": [
                        "act of grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Милосердие, помилование или прощение, проявленное к кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милосердие",
                                "target_lang_sense_clarification": "сострадание"
                            },
                            {
                                "target_lang_word": "помилование",
                                "target_lang_sense_clarification": "отмена наказания"
                            },
                            {
                                "target_lang_word": "прощение",
                                "target_lang_sense_clarification": "отказ от обиды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0416a02c-7ad0-330c-8856-f6eded2bd9a2",
                    "sense_definition": "A musical ornament, such as a <w>grace</w> note, added to a melody.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer added a subtle <w>grace</w> note to the beginning of the flute solo.",
                            "target_lang_translations": {
                                "ru": "Композитор добавил едва заметный <w>форшлаг</w> в начало соло на флейте."
                            }
                        },
                        {
                            "text": "The trill is a common <w>grace</w> used to embellish the closing notes of the piece.",
                            "target_lang_translations": {
                                "ru": "Трель — это обычное <w>украшение</w>, используемое для придания красоты заключительным нотам произведения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grace note"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное украшение, например, форшлаг, добавляемое к мелодии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелизм",
                                "target_lang_sense_clarification": "музыкальное украшение"
                            },
                            {
                                "target_lang_word": "форшлаг",
                                "target_lang_sense_clarification": "короткая нота-украшение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "abca7f07-7cf8-3a5e-9f8c-c459b99c2221",
                    "sense_definition": "To adorn, decorate, or honor a place or event with one's presence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor decided to <w>grace</w> the charity gala with his presence.",
                            "target_lang_translations": {
                                "ru": "Знаменитый актер решил <w>почтить</w> благотворительный вечер своим присутствием."
                            }
                        },
                        {
                            "text": "A beautiful portrait of the founder <w>graced</w> the wall of the main hallway.",
                            "target_lang_translations": {
                                "ru": "Прекрасный портрет основателя <w>украшал</w> стену главного коридора."
                            }
                        }
                    ],
                    "synonyms": [
                        "mense"
                    ],
                    "antonyms": [
                        "disgrace",
                        "deface"
                    ],
                    "common_phrases": [
                        "grace with presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или удостаивать место или событие своим присутствием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почтить",
                                "target_lang_sense_clarification": "своим присутствием"
                            },
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "делать лучше"
                            },
                            {
                                "target_lang_word": "удостоить",
                                "target_lang_sense_clarification": "оказать честь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad488bf-b04b-3d32-af49-aff89f18d043",
                    "sense_definition": "To dignify or raise by an act of favour; to honour someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monarch chose to <w>grace</w> the loyal soldier with a new title.",
                            "target_lang_translations": {
                                "ru": "Монарх решил <w>удостоить</w> верного солдата новым титулом."
                            }
                        },
                        {
                            "text": "He could <w>grace</w> or disgrace anyone he wished within the royal court.",
                            "target_lang_translations": {
                                "ru": "Он мог <w>возвысить</w> или обесчестить любого, кого пожелал бы, при королевском дворе."
                            }
                        }
                    ],
                    "antonyms": [
                        "disgrace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвышать или облагораживать актом благосклонности; оказывать честь кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоить",
                                "target_lang_sense_clarification": "оказать высокую честь"
                            },
                            {
                                "target_lang_word": "облагородить",
                                "target_lang_sense_clarification": "сделать достойнее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abe0ad31-1da8-35af-8125-64f8ff272879",
                    "sense_definition": "To add musical ornaments, such as grace notes or cadenzas, to a piece of music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performer chose to <w>grace</w> the melody with several complex trills.",
                            "target_lang_translations": {
                                "ru": "Исполнитель решил <w>украсить</w> мелодию несколькими сложными трелями."
                            }
                        },
                        {
                            "text": "Certain notes are more conveniently <w>graced</w> by using specific finger patterns on the instrument.",
                            "target_lang_translations": {
                                "ru": "Некоторые ноты удобнее <w>орнаментировать</w>, используя определенную аппликатуру на инструменте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять музыкальные украшения, такие как форшлаги или каденции, в музыкальное произведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "мелодию"
                            },
                            {
                                "target_lang_word": "орнаментировать",
                                "target_lang_sense_clarification": "музыкальную партию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "99fc78e4-a211-3c4b-8d30-91c0a7fd46bb",
                    "sense_definition": "A female given name from English.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My grandmother's name was <w>Grace</w>, which she always thought was very poetic.",
                            "target_lang_translations": {
                                "ru": "Мою бабушку звали <w>Грейс</w>, и она всегда считала это имя очень поэтичным."
                            }
                        },
                        {
                            "text": "They named their daughter <w>Grace</w> because they wanted a classic and elegant name.",
                            "target_lang_translations": {
                                "ru": "Они назвали дочь <w>Грейс</w>, потому что хотели классическое и элегантное имя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя английского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грейс",
                                "target_lang_sense_clarification": "имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95488e43-486a-3ea3-9e47-0f893c56039e",
                    "sense_definition": "A surname.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named William <w>Grace</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Уильям <w>Грейс</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Grace</w> has been working at the law firm for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Грейс</w> работает в юридической фирме уже более двадцати лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грейс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007d596e-2679-3690-a2c2-12dda368cafa",
                    "sense_definition": "The name of several places in the United States, such as a city in Idaho.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small city of <w>Grace</w> is located in Caribou County, Idaho.",
                            "target_lang_translations": {
                                "ru": "Небольшой город <w>Грейс</w> расположен в округе Карибу, штат Айдахо."
                            }
                        },
                        {
                            "text": "He grew up in a tiny community called <w>Grace</w> in the state of Mississippi.",
                            "target_lang_translations": {
                                "ru": "Он вырос в крошечном поселении под названием <w>Грейс</w> в штате Миссисипи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких населенных пунктов в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грейс",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b41c746-432d-3d0c-bf82-8cd97ab50b20",
                    "sense_definition": "Acronym of Gravity Recovery and Climate Experiment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Data from <w>GRACE</w> helped scientists track the melting of ice sheets in Antarctica.",
                            "target_lang_translations": {
                                "ru": "Данные проекта <w>GRACE</w> помогли ученым отследить таяние ледяных щитов в Антарктиде."
                            }
                        },
                        {
                            "text": "The <w>GRACE</w> mission provided critical information about the Earth's gravity field.",
                            "target_lang_translations": {
                                "ru": "Миссия <w>GRACE</w> предоставила критически важную информацию о гравитационном поле Земли."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для эксперимента по изучению гравитационного поля и климата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "GRACE",
                                "target_lang_sense_clarification": "научный проект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}