                "senses": [
                    {
                        "sense_id": "671b3be1-2478-3a2e-b335-6b7d01669fd2",
                        "entry_id": "c15e93b5-d215-33b4-a92f-ec5479b1e3b8",
                        "glosses": [
                            "пренебр. немец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63650b1-b56f-4783-8352-c172c20f0059",
                                "sense_id": "671b3be1-2478-3a2e-b335-6b7d01669fd2",
                                "text": "Пока есть один враг — немцы. Гансы и фрицы. — А что, ребята, сокрушим гадов?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2396ea9b-cbf6-4de6-bf24-5a627be912a0",
                        "source_entry_id": "c15e93b5-d215-33b4-a92f-ec5479b1e3b8",
                        "source_sense_id": "671b3be1-2478-3a2e-b335-6b7d01669fd2",
                        "target_lang_word": "kraut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kraut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c79c10a3-75bf-3e0b-ab1f-abab551c34a0",
                                        "entry_id": "56c0eada-2c54-3ff8-a9c5-bf71d7d987cd",
                                        "glosses": [
                                            "Clipping of sauerkraut."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08deaf25-9431-42a5-b21c-12a494574299",
                                                "sense_id": "c79c10a3-75bf-3e0b-ab1f-abab551c34a0",
                                                "text": "The bacon fat and the browned ribs and the boiling kraut smelled good."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kraut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                        "entry_id": "3e80430b-dfba-3e4a-b50e-151416d6285a",
                                        "glosses": [
                                            "To make (into) sauerkraut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31306a18-d662-45d5-81f4-37f13366a490",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "I find more money in krauting Cabbage myself and marketing the kraut, as […]"
                                            },
                                            {
                                                "example_id": "c9a729dd-b3a6-4dd9-aa12-c1a896e6434d",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "The same applies to the brining of cucumbers […] and krauting cabbage."
                                            },
                                            {
                                                "example_id": "fb5a2d53-6013-4e0e-ace4-e5ff4ac9e9fd",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "They krauted cabbage, picked saskatoons and dried them for the winter. The whole family contributed to the welfare of the home for there was no room for a drone in their midst."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kraut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d1711e-557a-3bce-906b-38dfb3dd3932",
                                        "entry_id": "561877e5-519d-369a-8870-39b3bfcb0016",
                                        "glosses": [
                                            "Alternative letter-case form of Kraut (“German person”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9bb5ef4-aeda-4aaa-84d4-1e0d7ba4ff5d",
                        "source_entry_id": "c15e93b5-d215-33b4-a92f-ec5479b1e3b8",
                        "source_sense_id": "671b3be1-2478-3a2e-b335-6b7d01669fd2",
                        "target_lang_word": "chleuh",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chleuh",
