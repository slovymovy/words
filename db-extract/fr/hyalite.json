                        "entry_id": "6d05ab44-92fb-3475-9256-b8da8e28d0e7",
                        "glosses": [
                            "Verre noir, initialement fabriqué en bohème."
                        ],
                        "tags": [
                            "Verrerie"
                        ],
                        "examples": [
                            {
                                "example_id": "59743dee-2910-42a3-8032-de562fe09070",
                                "sense_id": "b546c328-50c0-3b60-b368-8d4860579ce6",
                                "text": "Depuis 1820, on fabrique, en Bohème, une variété de verre, de couleur noire, très dur et d'un grand éclat, qui peut remplacer la porcelaine dans la plupart de ses applications. Ce verre est désigné sous le nom de hyalite."
                            }
                        ]
