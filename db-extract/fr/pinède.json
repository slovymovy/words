                                "target_senses": [
                                    {
                                        "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                        "entry_id": "b193d753-8e7f-3b9a-9164-ad8150dcee0f",
                                        "glosses": [
                                            "The wood of a pine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3614ef-8759-420b-b3ef-3d117aac682f",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "pinewood furniture"
                                            },
                                            {
                                                "example_id": "12709677-570b-4b9a-bc97-5d65b85ebe72",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "pinewood derby"
                                            },
                                            {
                                                "example_id": "2646368a-19cb-4b87-9226-709ebf591e87",
                                                "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                                                "text": "On the floor in dry parts of the cave, the researchers found two hearths. They also picked up charcoal from crevices and ledges, which they believe are from pinewood torches that the Stone Age visitors carried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "150127c7-e6e6-3c2f-995b-95cc5769e587",
                                        "entry_id": "b193d753-8e7f-3b9a-9164-ad8150dcee0f",
                                        "glosses": [
                                            "A forest or grove of pine trees, either natural or as a plantation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911d5ab5-c1e7-46d7-9803-ae7ad213694f",
                                                "sense_id": "150127c7-e6e6-3c2f-995b-95cc5769e587",
                                                "text": "Near-synonyms: pinery, pinetum; pineland"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0760a19a-fe93-45c5-a186-0a41f32ccc4a",
                        "source_entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "source_sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                        "target_lang_word": "pinery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb63d43-2783-3b52-b07c-59bf0b5ae52c",
                                        "entry_id": "89b86dde-8a23-3951-ae40-b72683828ebc",
                                        "glosses": [
                                            "A hothouse or (tropical) area used as a plantation for the cultivation of pineapple plants (genus Ananas) and production of their homonymous fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66620c99-b9a0-4a51-a379-2a8c89e1b3ef",
                                                "sense_id": "dbb63d43-2783-3b52-b07c-59bf0b5ae52c",
                                                "text": "The record weight for pinery-grown pineapples was an astonishing fourteen pounds, twelve ounces—a weight that no imported pineapple could achieve. Pineapples fit neatly into the national crazes for natural things in England,[…]"
                                            },
                                            {
                                                "example_id": "264c2e57-21ab-4763-b693-b3dfbd8d3b4c",
                                                "sense_id": "dbb63d43-2783-3b52-b07c-59bf0b5ae52c",
                                                "text": "while Margam was exceptional in the scale of its orangery, it was not alone […] There was, for example, a peach house at Stradey Castle, a melon house and vinery at Nanteos, while Middleton Hall had both a peach house and a pinery. Pineapples were particularly prized because of their flavour and spectacular appearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2df685-a160-30ae-9cac-c1a6d7fe39bc",
                                        "entry_id": "89b86dde-8a23-3951-ae40-b72683828ebc",
                                        "glosses": [
                                            "A pinewood, pinetum, forest or grove where pine trees are grown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa764e2c-dd8b-486a-adee-275fcf8a5fd2",
                                                "sense_id": "1e2df685-a160-30ae-9cac-c1a6d7fe39bc",
                                                "text": "Early in the Moon of Popping Trees they [High Back Bone, Yellow Eagle, and Crazy Horse] began tantalizing the woodcutters in the pinery and the soldiers guarding the wagons which brought wood to Fort Phil Kearny. [Red Cloud's War, 1866]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b354de2-aeaa-4f93-b8d9-942b178085e3",
                        "source_entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "source_sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
