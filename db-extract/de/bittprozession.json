                    {
                        "sense_id": "214e9bc8-4cd7-3719-a4c0-0a80185ad297",
                        "entry_id": "43d42eaf-654f-3d4c-9f90-5537b8deb20f",
                        "glosses": [
                            "Prozession, in der gemeinsam um Anliegen der Gläubigen gebeten wird oft in Form einer Flurprozession durchgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335cfcf3-e665-447a-a41e-36d3ac996358",
                                "sense_id": "214e9bc8-4cd7-3719-a4c0-0a80185ad297",
                                "text": "Hervorgegangen sind diese Bittprozessionen, Rogationes genannt, aus heidnischen Flurumgängen zwischen Aussaat und Ernte (,Ambar- valia\") im südgallischen Raum."
                            },
                            {
                                "example_id": "163abd08-74fb-49fb-aee1-86648fa697c4",
                                "sense_id": "214e9bc8-4cd7-3719-a4c0-0a80185ad297",
                                "text": "[Dürre in Südfrankreich 2023:] „Ende März besannen sich verzweifelte Katholiken im südfranzösischen Perpignan auf ein seit der Revolution vergessenes Ritual: eine Bittprozession um Wasser mit der Statue des Heiligen Galderic. Doch der blieb untätig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
