                    ],
                    "common_phrases": [
                        "warme sloffen"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of slipper; comfortable indoor footwear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slippers",
                                "target_lang_sense_clarification": "indoor footwear"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84c2af03-d208-3847-b0ba-8932de1c8caa",
                    "sense_definition": "zich slepend en schuifelend voortbewegen zonder de voeten goed op te tillen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vermoeide man bleef langzaam door de gang <w>sloffen</w> na een lange nachtdienst.",
                            "target_lang_translations": {
                                "en": "The exhausted man kept slowly <w>shuffling</w> down the hallway after a long night shift."
                            }
                        },
                        {
                            "text": "Hij <w>slofte</w> naar de keuken om een glas koud water in te schenken.",
                            "target_lang_translations": {
                                "en": "He <w>shuffled</w> to the kitchen to pour a glass of cold water."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuifelen",
                        "slepen"
                    ],
                    "common_phrases": [
                        "door het huis sloffen"
                    ],
                    "target_lang_definitions": {
                        "en": "to walk slowly and draggingly without lifting one's feet properly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to shuffle",
                                "target_lang_sense_clarification": "walk dragging the feet"
                            },
                            {
                                "target_lang_word": "to scuff",
                                "target_lang_sense_clarification": "drag feet while walking"
                            },
                            {
                                "target_lang_word": "to pad",
                                "target_lang_sense_clarification": "walk softly or lazily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e18f25-7252-3821-bcf8-60a968a273bc",
                    "sense_definition": "ongewoon veel geluk of meeval hebben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft echt ontzettend <w>gesloft</w> met die goedkope huurwoning in het stadscentrum.",
                            "target_lang_translations": {
                                "en": "She really <w>lucked out</w> with that cheap rental apartment in the city center."
                            }
                        },
                        {
                            "text": "We hebben flink <w>gesloft</w> dat het droog bleef tijdens de fietstocht door de heuvels.",
                            "target_lang_translations": {
                                "en": "We were really <w>in luck</w> that it stayed dry during the bike ride through the hills."
                            }
                        }
                    ],
                    "synonyms": [
                        "boffen"
                    ],
                    "common_phrases": [
                        "enorm sloffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele uitdrukking voor geluk hebben"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be unusually lucky or have good fortune"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to luck out",
                                "target_lang_sense_clarification": "informal, be very lucky"
                            },
                            {
                                "target_lang_word": "to strike lucky",
                                "target_lang_sense_clarification": "have good fortune"
                            },
                            {
                                "target_lang_word": "to be in luck",
                                "target_lang_sense_clarification": "experience a fortunate break"
                            }
                        ]
                    }
                }
            ]
        }
    ]
