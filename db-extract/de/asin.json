                "senses": [
                    {
                        "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                        "entry_id": "868d67ba-226d-380e-834a-d3400425506c",
                        "glosses": [
                            "Vertreterin eines Göttergeschlechts, das in Asgard wohnt"
                        ],
                        "tags": [
                            "germanische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6d91ff22-f616-4393-a8ee-622fb0b96d19",
                                "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                                "text": "„Unter den Göttinnen, die sich wenig voneinander unterscheiden, nehmen die Asin Frigg, Odhinns Frau, und die Vanin Freya, ‚die Frau‘, die Schwester des Freyr und Gattin [Tochter] des Meergottes Njördr, den höchsten Rang ein.“"
                            },
                            {
                                "example_id": "215babf3-871b-4a10-8c51-56556ed60a1a",
                                "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                                "text": "„Die Unsicherheit, die besonders später sich bei der Zuweisung zu Asinnen, Walküren, Riesinnen zeigt, beweist das Alter dieser Namen.“"
                            },
                            {
                                "example_id": "2f4a73fb-b089-4abc-b2c4-c0492411bc3a",
                                "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                                "text": "„Daß die anderen Götter Odinn dienen wie Kinder ihrem Vater, daß die Asinnen nicht minder heilig und ihre Macht nicht geringer ist als die der Asen (cap. 20), würde schwer zu beweisen sein […]“"
                            },
                            {
                                "example_id": "28976ade-5d40-4716-a130-3687ecb53911",
                                "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                                "text": "„Denselben Namen (Abundantia) hat die Asin Fulla […]“"
                            },
                            {
                                "example_id": "b6232ec4-465e-4149-a094-4adad20a0bd8",
                                "sense_id": "b750d285-3e84-3e08-b596-5255cf48d220",
                                "text": "„Von den übrigen noch mehr zurücktretenden Asinnen wird Eir nur im Allgemeinen in den Dienst der Götter gestellt […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
