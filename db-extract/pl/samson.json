                "senses": [
                    {
                        "sense_id": "263b3e6b-3d28-388f-b111-024fca26ca06",
                        "entry_id": "06456336-ba9f-3bd9-a16e-ec25630ae391",
                        "glosses": [
                            "osoba samotna, stroniąca od innych"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "1786d6ff-5bfa-477d-a6f3-678990b490c8",
                                "sense_id": "263b3e6b-3d28-388f-b111-024fca26ca06",
                                "text": "Muzyka grała, tańcowały wszystkie, bawiły się, to cóż, jak ten samson miała stać w kącie, młoda przecież, zdrowa i zabawy jej potrzeba"
                            },
                            {
                                "example_id": "64645fce-4c7d-43a5-b5e2-2a290419199b",
                                "sense_id": "263b3e6b-3d28-388f-b111-024fca26ca06",
                                "text": "Żył odtąd prawdziwie jak ten samson, ani się do człowieka nie odezwał, ani do sąsiada nie wyszedł."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
