                                        "examples": [
                                            {
                                                "example_id": "ae57b92a-d0e6-4412-8e3b-aa4b2e46cbb4",
                                                "sense_id": "a56c2b1b-0c66-3e0d-b0df-6d74457a504e",
                                                "text": "Die Abkühlung am Abend bringt im Sommer oft eine willkommene Erholung."
                                            },
                                            {
                                                "example_id": "0c63a22c-6224-4001-8c58-1d9f35487687",
                                                "sense_id": "a56c2b1b-0c66-3e0d-b0df-6d74457a504e",
                                                "text": "„Wenn Salze gelöst werden, sind oft Temperaturänderungen zu beobachten. So löst sich Kaliumchlorid unter Abkühlung, Lithiumchlorid dagegen unter Erwärmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2bf2eeb1-3208-31db-9d53-3819fe7082ea",
                                        "entry_id": "a463c5da-63f5-3421-8ad2-4bc9a5284fdf",
                                        "glosses": [
