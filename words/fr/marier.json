    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70b71abf-a995-30df-a35f-fd56997cea59",
                    "sense_definition": "S'unir à une personne par les liens légaux ou sacrés du mariage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "union_matrimoniale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de se <w>marier</w> l'été prochain dans le village de leurs parents."
                        },
                        {
                            "text": "Mon frère se <w>marie</w> samedi après-midi avec sa compagne devant toute notre famille réunie."
                        }
                    ],
                    "synonyms": [
                        "se dire oui"
                    ],
                    "common_phrases": [
                        "se marier avec",
                        "se marier civilement",
                        "se marier à l'église"
                    ]
                },
                {
                    "sense_id": "3b748d1c-6e35-34b7-abe2-508f57c5c660",
                    "sense_definition": "Unir deux personnes par le lien conjugal en tant qu'autorité civile ou religieuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "union_matrimoniale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire de notre commune a <w>marié</w> les deux jeunes époux hier matin."
                        },
                        {
                            "text": "C'est un prêtre proche de la famille qui les a <w>mariés</w> dans l'église du village."
                        }
                    ]
                },
                {
                    "sense_id": "4990597b-95e3-3262-9f5c-31f991d2fc34",
                    "sense_definition": "Assortir ou combiner harmonieusement des éléments variés comme des saveurs, des couleurs ou des textures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combinaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef talentueux sait parfaitement <w>marier</w> les saveurs sucrées et salées dans ses plats."
                        },
                        {
                            "text": "L'architecte d'intérieur a choisi de <w>marier</w> le bleu profond avec des touches dorées très élégantes."
                        }
                    ],
                    "common_phrases": [
                        "marier les couleurs",
                        "marier les saveurs"
                    ]
                },
                {
                    "sense_id": "24e07618-f6c3-326d-b825-f51b33535890",
                    "sense_definition": "Donner un enfant en mariage ou arranger l'union légale de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "union_matrimoniale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette comédie classique, le bourgeois cherche à <w>marier</w> sa fille à un médecin fortuné."
                        },
                        {
                            "text": "Les souverains d'Europe s'efforçaient jadis de <w>marier</w> leurs héritiers pour consolider leurs traités de paix."
                        }
                    ],
                    "common_phrases": [
                        "marier sa fille",
                        "marier son fils"
                    ]
                }
            ]
        }
    ]
