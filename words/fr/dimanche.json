                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a revêtu ses plus beaux <w>dimanches</w> pour aller au banquet."
                        },
                        {
                            "text": "Les enfants portaient leurs <w>dimanches</w> pour la fête du village."
                        }
                    ],
                    "common_phrases": [
