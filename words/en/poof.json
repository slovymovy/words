                    "frequency": "VeryLow",
                    "semantic_group_id": "flatulence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>poofed</w> under the table while everyone was having dinner."
                        },
                        {
                            "text": "Did someone just <w>poof</w> in the quiet library?"
                        }
                    ],
                    "synonyms": [
                        "fart"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or childish term for passing gas"
                        }
                    ]
                }
            ]
        },
        {
