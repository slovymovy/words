                "senses": [
                    {
                        "sense_id": "d9c0e371-8f38-36e1-a2d2-5a95bdf99467",
                        "entry_id": "19fbac3e-64c6-3a34-b308-6e3ae753d97a",
                        "glosses": [
                            "S’analgésier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb7ab87-1778-446e-93ed-f24c6506ea80",
                                "sense_id": "d9c0e371-8f38-36e1-a2d2-5a95bdf99467",
                                "text": "La PCEA, à l'image de la PCA. est toutefois adaptée aux patients qui peuvent s'auto-analgésier et qui comprennent les principes de cette technique."
                            },
                            {
                                "example_id": "d55c338e-574f-4ed8-9997-ff7e6824b31a",
                                "sense_id": "d9c0e371-8f38-36e1-a2d2-5a95bdf99467",
                                "text": "Laisser à tout âge la possibilité de crier en négociant par contre l'immobilité (transaction possible dès 2 ans et demi) ; en hurlant, l'enfant « se défoule » et peut même ainsi s'auto-analgésier: « Tu as le droit de pleurer même si tu es grand et courageux. »"
                            }
                        ]
                    }
