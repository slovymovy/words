            {
                "entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                "word": "khanate",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "38f49f06-6779-4af8-9c4e-3a7321b2ef6c",
                        "entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                        "tags": [
                            "plural"
                        ],
                        "form": "khanates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                        "entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                        "glosses": [
                            "The polity ruled by a khan, comprising one or more tribes or clans; a state or dominion ruled by this polity; its territory."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6353fc5-c59c-4d12-9c72-3dab4f781657",
                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                "text": "By the middle of the nineteenth century Central Asia was rarely out of the headlines, as one by one the ancient caravan towns and khanates of the former Silk Road fell to Russian arms."
                            },
                            {
                                "example_id": "2200d210-d1d4-4648-83f1-b0f5a839ed46",
                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                "text": "Sviatoslav had his own imperial ambitions, which led him to take an aggressive interest in the Christian khanate of Bulgaria."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b34ad50-e992-4f55-be99-7c26f3886b7b",
                        "source_entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                        "source_sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                        "source_sense_description": "place ruled by a khan",
                        "target_lang_word": "chanát",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanát",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "00b49ec2-d2db-34e2-92c0-126553f3b9c5",
                                        "entry_id": "d91e5842-ff94-3acb-bd38-5c36a41ece07",
                                        "glosses": [
                                            "území, na kterém vládne chán"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074d4344-736a-417a-848f-03f35d243583",
                                                "sense_id": "00b49ec2-d2db-34e2-92c0-126553f3b9c5",
                                                "text": "V roce 1475 se Krymský chanát stal oficiálně vazalem Osmanské říše."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d136f9-9443-4dbc-9500-296972b06a74",
                        "source_entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                        "source_sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                        "source_sense_description": "place ruled by a khan",
                        "target_lang_word": "kanaat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanaat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                                        "glosses": [
                                            "gebied dat wordt bestuurd door een Mongoolse of Turkse heerser met de titel \\\"kan\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76a698f-1fa5-4a53-88ff-d46dbc7d95aa",
                                                "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                                                "text": "Het huidige Kalmukkië beslaat nog slechts een klein stukje van het machtige Kalmukse kanaat dat de veroveraars in de laagvlakte vestigden, maar dat aan het eind van de zeventiende eeuw alweer werd ontmanteld."
                                            },
                                            {
                                                "example_id": "a3fb8f6d-c5e5-4f83-ab45-eba8ec1bb41b",
                                                "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                                                "text": "Het eerste strekt zich van Astrakan tot de grenzen van het Kanaat Talijschin uit, en bezit, buiten Astrakan, zes goede losplaatsen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a12caf-e7f0-3c69-a1fe-5f94e5b49c33",
                                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                                        "glosses": [
                                            "aanduiding voor het bewind van een Mongoolse of Turkse heerser met de titel \\\"kan\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2b262a-623e-4f26-8e1b-8134dbe2082b",
                                                "sense_id": "b4a12caf-e7f0-3c69-a1fe-5f94e5b49c33",
                                                "text": "Op zijn hoogtepunt beheerste het kanaat van de Krim het overgrote deel van de noordkant van de Zwarte Zee en de hele kust van de Zee van Azov met de monding van de Don."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                                        "glosses": [
                                            "ondergrondse licht dalende tunnel waardoor grondwater uit een heuvel naar een lager gelegen woningen kan stromen"
                                        ],
                                        "tags": [
                                            "Midden-Oosten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97b1f963-7c7a-4e34-90e9-a39ff4590b47",
                                                "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                                                "text": "Het kanaat verzorgt drinkwater en water voor huishoudelijk gebruik; irrigatie water is gebruikt voor vijgebomen, kleine moestuinen en de verbouw van gerst voor bijvoeden van lammeren."
                                            },
                                            {
                                                "example_id": "90cf611d-d205-4cc7-921b-22edc526ced3",
                                                "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                                                "text": "Een kanaat is een duurzaam systeem van grondwateronttrekking; het neemt niet meer water uit de grond dan door de regen wordt toe- gevoerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f272b8-7f32-4c59-9cbc-c44f9cbf2bc7",
                        "source_entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
