                                                "sense_id": "0bc95a40-8fd5-375e-a489-3eb1cafa28e1",
                                                "text": "De moed zakte in zijn schoenen toen hij die wankele brug zag."
                                            },
                                            {
                                                "example_id": "fcdb1d63-bc53-485a-abaa-f2c17a9ccded",
                                                "sense_id": "0bc95a40-8fd5-375e-a489-3eb1cafa28e1",
                                                "text": "Nu begint de moed weg te zakken, en ze durft niet bij de vrouw binnen te vallen."
                                            },
                                            {
                                                "example_id": "7424cc33-ce2b-477a-acb8-b8e088ba74ea",
                                                "sense_id": "0bc95a40-8fd5-375e-a489-3eb1cafa28e1",
                                                "text": "Ze dreigt de moed te verliezen."
                                            }
                                        ]
                                    },
