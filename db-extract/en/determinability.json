                        "glosses": [
                            "The quality of being determinable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "36da99f0-3def-4242-9a0f-b25f6385c9be",
                                "sense_id": "56454d30-81ad-3276-bdb1-21f021ece81f",
                                "text": "One of the wisest of uninspired men has not hesitated to declare the dog a great mystery, on account of this dawning of a moral nature unaccompanied by any the least evidence of reason, in whichever of the two senses we interpret the word—whether as the practical reason, that is, the power of proposing an ultimate end, the determinability of the Will by ideas; or as the sciential reason, that is, the faculty of concluding universal and necessary truths from particular and contingent appearances."
                            },
                            {
                                "example_id": "1d226d20-20bc-449f-9eae-49909de5624e",
                                "sense_id": "56454d30-81ad-3276-bdb1-21f021ece81f",
                                "text": "This absolute determinability of our mind by abstractions [pg 057] is one of the cardinal facts in our human constitution. Polarizing and magnetizing us as they do, we turn towards them and from them, we seek them, hold them, hate them, bless them, just as if they were so many concrete beings."
                            }
                        ]
                    }
