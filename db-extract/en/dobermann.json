                        ]
                    },
                    {
                        "translation_id": "b639112b-e5ba-431d-80b5-ae687eb11abb",
                        "source_entry_id": "96085114-702f-3d8f-a2af-6b926fddfe3b",
                        "source_sense_id": "93e4101c-e407-3939-8e58-917c17eee233",
                        "source_sense_description": "large dog originating in Germany",
                        "target_lang_word": "Dobermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dobermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                        "entry_id": "19f12bea-a684-3ab6-a3fa-c30771c1f8a0",
                                        "glosses": [
                                            "deutsche Hunderasse, die eine Kreuzung aus Pinscher und Schäferhund ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5f5807-b42a-4dee-8db5-ace898c90a4f",
                                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                                "text": "Der Dobermann ist bei der Polizei als Schutzhund sehr beliebt."
                                            },
                                            {
                                                "example_id": "d02e716b-f42b-4ff1-b211-7b718f061ca8",
                                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                                "text": "„Der Dobermann starrte mich an.“"
                                            },
                                            {
                                                "example_id": "1995e0a3-0ace-427a-9a88-edd45bb57844",
                                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                                "text": "„Die Russen suchten nach dem größten Dobermann und nach dem schlimmsten Rottweiler in der Welt und kreuzten sie mit dem bösartigsten sibirischen Wolf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dobermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                        "entry_id": "e5fe29b0-2d1d-32b4-afc7-d7a977f48263",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2f3584-d771-4932-8c2a-eeb498d8154b",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Dobermann das Schmücken von Weihnachtsbäumen."
                                            },
                                            {
                                                "example_id": "03e65c03-5d6e-4a59-8052-7f6b0b0ca764",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Frau Dobermann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "198ce5b2-bb37-4701-9606-3276cef9b9f9",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Herr Dobermann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "94980f7f-0e35-4dea-bdb1-c55f7d8f6ecf",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Die Dobermanns kommen heute aus dem Saaletal."
                                            },
                                            {
                                                "example_id": "d851588f-786d-4aa2-883b-bff654026855",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Der Dobermann trägt nie die Schals, die die Dobermann ihm strickt."
                                            },
                                            {
                                                "example_id": "1ec40dfb-e8f3-497f-adb6-1c5cf49bd94a",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dobermann kommt, geht der Herr Dobermann.“"
                                            },
                                            {
                                                "example_id": "88202da7-4fad-46fc-9e93-087442a010e6",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Dobermann kommt und geht."
                                            },
                                            {
                                                "example_id": "8310b86f-d8e6-472b-b076-9373d0761132",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "Dobermanns kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "c00a313d-c482-45eb-845b-8dd75d573d6d",
                                                "sense_id": "cf53615a-4f89-3b87-acaf-6f9ccc017bf1",
                                                "text": "An verregneten Herbsttagen ist Familie Dobermanns liebste Beschäftigung das Bemalen von Hühnereiern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
