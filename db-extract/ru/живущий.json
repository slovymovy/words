                "senses": [
                    {
                        "sense_id": "e1704142-5ef2-3a7d-842a-b6491e60577e",
                        "entry_id": "35f83152-5c05-3bbd-bd8e-ff31df57d115",
                        "glosses": [
                            "то же, что проживающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1d9862-74bf-49e0-96ae-8106b8633e98",
                                "sense_id": "e1704142-5ef2-3a7d-842a-b6491e60577e",
                                "text": "Каждому человеку, живущему на земле, дана судьба или предначертанность всех событий, которые он переживёт, а также всех возможных деяний, которые он сможет совершить."
                            }
                        ]
                    },
                    {
                        "sense_id": "89ce1ab5-6c24-3229-b833-5eb15662b345",
                        "entry_id": "35f83152-5c05-3bbd-bd8e-ff31df57d115",
                        "glosses": [
                            "то же, что живой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b94c7d9f-0a72-49c4-813c-448478c4e6b9",
                        "source_entry_id": "35f83152-5c05-3bbd-bd8e-ff31df57d115",
