    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e32f6225-0870-3eef-8614-603f6cfbe4d0",
                    "sense_definition": "het binnenste deel van vruchten zoals appels en peren waarin de pitten zitten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vruchten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het <w>klokhuis</w> van een appel bevinden zich de pitten.",
                            "target_lang_translations": {
                                "en": "The seeds are located in the <w>core</w> of an apple."
                            }
                        },
                        {
                            "text": "Gooi je het <w>klokhuis</w> van je peer in de prullenbak?",
                            "target_lang_translations": {
                                "en": "Are you throwing the <w>core</w> of your pear in the trash can?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "klokhuis van een appel",
                        "klokhuis van een peer"
                    ],
                    "target_lang_definitions": {
                        "en": "the inner part of fruits such as apples and pears that contains the seeds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "core",
                                "target_lang_sense_clarification": "of a fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33ccc98b-02f4-3a25-b207-cbfe85c971b8",
                    "sense_definition": "een losstaand of aangebouwd bouwwerk waarin luidklokken hangen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tegen de westgevel van de zijbeuk bevindt zich een houten <w>klokhuis</w>.",
                            "target_lang_translations": {
                                "en": "Against the west facade of the side aisle is a wooden <w>bell tower</w>."
                            }
                        },
                        {
                            "text": "Het oude dorp heeft een historisch <w>klokhuis</w> dat nog steeds in gebruik is.",
                            "target_lang_translations": {
                                "en": "The old village has a historical <w>belfry</w> that is still in use."
                            }
                        }
                    ],
                    "synonyms": [
                        "klokkentoren",
                        "klokkenstoel"
                    ],
                    "common_phrases": [
                        "houten klokhuis",
                        "vrijstaand klokhuis"
                    ],
                    "target_lang_definitions": {
                        "en": "a detached or attached structure in which bells are hung"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bell tower",
                                "target_lang_sense_clarification": "structure for bells"
                            },
                            {
                                "target_lang_word": "belfry",
                                "target_lang_sense_clarification": "part of a tower for bells"
                            },
                            {
                                "target_lang_word": "bell cage",
                                "target_lang_sense_clarification": "wooden frame for bells"
                            }
                        ]
                    }
                }
            ]
        }
    ]
