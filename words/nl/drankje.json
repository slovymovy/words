                {
                    "sense_id": "19203fc8-d419-3ec2-bb7a-1ff49b8ba3a6",
                    "sense_definition": "Een vloeibaar middel met een geneeskrachtige of magische werking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tovenaar brouwde een geheimzinnig <w>drankje</w> in zijn grote ketel.",
                            "target_lang_translations": {
                                "en": "The wizard brewed a mysterious <w>potion</w> in his large cauldron.",
                                "ru": "Волшебник варил таинственное <w>зелье</w> в своем большом котле.",
                                "fr": "Le sorcier préparait une <w>potion</w> mystérieuse dans son grand chaudron."
                            }
                        },
                        {
                            "text": "Je moet dit vieze <w>drankje</w> helemaal opdrinken als je snel beter wilt worden.",
                            "target_lang_translations": {
                                "en": "You have to drink up this nasty <w>draught</w> if you want to get better quickly.",
                                "ru": "Ты должен выпить эту противную <w>микстуру</w> до дна, если хочешь быстро поправиться.",
                                "fr": "Tu dois boire cette mauvaise <w>potion</w> jusqu'au bout si tu veux guérir vite."
                            }
                        }
                    ],
                    "synonyms": [
