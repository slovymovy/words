                    {
                        "sense_id": "4d76d41d-0342-3e66-a5d8-04ab635a6497",
                        "entry_id": "d8a26a45-c354-3f4d-a5ea-577b3d352a69",
                        "glosses": [
                            "am Fluss Terek gelegene Hauptstadt der Republik Nordossetien[-Alanien] in Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6f2ead-a69d-440e-b9a8-93b0994fa67b",
                                "sense_id": "4d76d41d-0342-3e66-a5d8-04ab635a6497",
                                "text": "„Kriege, Handel, Völkerwanderungen: Es ist eine bewegte Geschichte, die über Jahrtausende Georgien formt, den multiethnisch geprägten Staat an der Nahtstelle zwischen Europa und Asien. Der Georgischen Heerstraße, die Tiflis mit der südrussischen Agrarmetropole Wladikawkas verbindet, kam dabei herausragende Bedeutung zu, war sie doch für Jahrhunderte der einzige Handelsweg durch den Hohen Kaukasus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9ab0184-06c6-48ac-a091-29ddfa4e0640",
                        "source_entry_id": "d8a26a45-c354-3f4d-a5ea-577b3d352a69",
                        "source_sense_id": "4d76d41d-0342-3e66-a5d8-04ab635a6497",
                        "target_lang_word": "Владикавказ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Владикавказ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd3640e-09d8-3002-8333-9976af85077b",
                                        "entry_id": "392e96d8-7943-39ab-8dc3-2e7f8b86b5f0",
                                        "glosses": [
                                            "город на юге России, в центральной части Северного Кавказа, столица Республики Северная Осетия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8ae384-d81b-4284-8cfd-70d1673326d5",
                                                "sense_id": "0cd3640e-09d8-3002-8333-9976af85077b",
                                                "text": "Она собралась и поехала через всю страну во Владикавказ, оттуда добралась до штаба части."
                                            },
                                            {
                                                "example_id": "e3fb5d4d-8c39-4fea-9faf-64a572f44e55",
                                                "sense_id": "0cd3640e-09d8-3002-8333-9976af85077b",
                                                "text": "Расставшись с Максимом Максимычем, я живо проскакал Терекское и Дарьяльское ущелья, завтракал в Казбеке, чай пил в Ларсе, а к ужину поспел в Владикавказ."
                                            },
                                            {
                                                "example_id": "be14c21d-9396-4dbe-a38f-1e2fb58ab58d",
                                                "sense_id": "0cd3640e-09d8-3002-8333-9976af85077b",
                                                "text": "Мы достигли Владикавказа, прежнего Кап-кая, преддверия гор."
                                            },
                                            {
                                                "example_id": "cf52de5f-402e-4cb5-80e4-6f9a98361c39",
                                                "sense_id": "0cd3640e-09d8-3002-8333-9976af85077b",
                                                "text": "Под Владикавказом, вырвавшись на долину, он, кажется, рад вольному раздолью: ходит по ней широкими кругами, разбрасывая похищенные в горах валуны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
