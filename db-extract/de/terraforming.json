                                        "entry_id": "966f78e7-d3f3-3ccf-b6c4-76bd484f9f80",
                                        "glosses": [
                                            "Ensemble des opérations à mettre en œuvre pour rendre une planète habitable par l’être humain."
                                        ],
                                        "tags": [
                                            "Astrobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e817ca1-aed3-4a60-a582-1f2ede5e600b",
                                                "sense_id": "1622d3aa-1893-3e80-b03c-fc0a0832c877",
                                                "text": "Le terraformage de la planète Mars."
                                            },
                                            {
                                                "example_id": "368a3e22-ff9e-407c-9624-af8afde5fae8",
                                                "sense_id": "1622d3aa-1893-3e80-b03c-fc0a0832c877",
                                                "text": "Le terraformage de la planète Azuria par XerFoxe"
