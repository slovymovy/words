                "senses": [
                    {
                        "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                        "entry_id": "3256aa1b-8207-3d01-b847-5f83cb9e4553",
                        "glosses": [
                            "jemand, der etwas ansagt, ankündigt, zum Beispiel in den Medien (Rundfunk, Fernsehen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06b3529-7a1b-467e-bb92-95d0797074f3",
                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                "text": "„Die Musik untermalte noch immer die Stimme des Ansagers.“"
                            },
                            {
                                "example_id": "25426b68-8018-4bf2-938c-6b5f51c31c42",
                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                "text": "„Ich unterbrach mein Spiel, als ich drinnen die Stimme des Ansagers hörte.“"
                            },
                            {
                                "example_id": "a2ccbdec-3776-4c6b-9d6f-b4a440285ddd",
                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                "text": "„Die Ansager meldeten mit Genugtuung die Zahl der im Kriege Getöteten.“"
                            },
                            {
                                "example_id": "086a93fe-12a5-4de6-899f-84b491abb484",
                                "sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                                "text": "„Die Deutschen hatten eine Artillerie, die auf alle wichtigen Punkte der Stadt eingeschossen war, und sobald der Ansager eine Sendung anzusagen begann, eröffneten die Batterien das Feuer auf das Rundfunkgebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8051e7a-06d6-4d5e-a2ef-65cf22b35c24",
                        "source_entry_id": "3256aa1b-8207-3d01-b847-5f83cb9e4553",
                        "source_sense_id": "dea0124a-938a-3afb-a18f-7bd42c1cecbf",
                        "source_sense_description": "jemand, der etwas ansagt, ankündigt",
                        "target_lang_word": "announcer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                        "entry_id": "446d08f8-7506-31ec-a3b8-f8aeb41f3058",
                                        "glosses": [
                                            "One who makes announcements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e150d7-0d3e-44a7-8949-3ad3500f4983",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "radio announcer"
                                            },
                                            {
                                                "example_id": "c153baa4-96cd-4e9e-a96f-cf89d00d822d",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Even TV announcers at the last Winter Olympics were spotted with a swoosh on their jackets."
                                            },
                                            {
                                                "example_id": "511d5df9-6300-41a6-af6d-ddf49132aa94",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Perlman devised a format inspired by the seminal mockumentary Spinal Tap, where the spot started with an ESPN announcer speaking to camera in a serious, straight voice, framing the story as “real” documentary."
                                            },
                                            {
                                                "example_id": "3dec8bff-9084-41aa-81fc-150a1477eff8",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "There were passing moments when it threatened to be a difficult night and, with the game goalless at half-time, the stadium announcer sounded almost apologetic when he relayed the news that Ukraine, kicking off an hour earlier, had gone to the top of the group by beating Poland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
