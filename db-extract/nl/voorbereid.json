                                "sense_id": "1be8d8a5-d686-345c-ba59-79cfdf59795e",
                                "text": "We waren niet goed voorbereid op deze omstandigheden."
                            },
                            {
                                "example_id": "f3c98309-81d0-4068-b98d-290b3a515294",
                                "sense_id": "1be8d8a5-d686-345c-ba59-79cfdf59795e",
                                "text": "Algauw liepen ze achter elkaar door de schuifdeuren terug naar de eetzaal, waar Sverre in het geheim het ophangen van de schilderijen had voorbereid."
                            }
                        ]
                    }
