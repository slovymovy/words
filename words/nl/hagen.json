                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51ba19f3-6ac4-3933-9bf2-bade038fe07c",
                    "sense_definition": "iemand bevallen of aangenaam zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plezier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zou mij zeer <w>hagen</w> als u vanavond bij ons komt dineren.",
                            "target_lang_translations": {
                                "en": "It would <w>please</w> me greatly if you would come to dine with us tonight."
                            }
                        },
                        {
                            "text": "Zijn brutale gedrag kon de leraar totaal niet <w>hagen</w>.",
                            "target_lang_translations": {
                                "en": "His insolent behavior did not <w>suit</w> the teacher at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "behagen",
                        "bevallen",
                        "zinnen"
                    ],
                    "antonyms": [
                        "mishagen"
                    ],
                    "common_phrases": [
                        "niet hagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "voornamelijk in literaire of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to please someone or be agreeable to them (formal or literary)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please",
                                "target_lang_sense_clarification": "to give pleasure or satisfaction"
                            },
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "to be convenient or acceptable to"
                            },
                            {
                                "target_lang_word": "gratify",
                                "target_lang_sense_clarification": "to indulge or satisfy a desire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac6954c7-96df-3308-b5f9-8975d1975830",
                    "sense_definition": "een terrein of tuin met een haag omringen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tuin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer besloot zijn weiland te <w>hagen</w> om het vee binnen te houden.",
                            "target_lang_translations": {
                                "en": "The farmer decided to <w>hedge in</w> his pasture to keep the livestock inside."
                            }
                        },
                        {
                            "text": "Men wilde het landgoed volledig <w>hagen</w> met meidoornstruiken.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>enclose</w> the estate entirely with hawthorn bushes."
                            }
                        }
                    ],
                    "synonyms": [
                        "omheinen",
                        "omhagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "weinig gebruikt in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to enclose a piece of land or garden with a hedge"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hedge in",
