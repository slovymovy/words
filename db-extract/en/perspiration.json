                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a869e94d-68a3-49e6-922a-9cbf2bb4e6bd",
                                "sense_id": "f67b4131-f63f-3593-ab5e-9346a473e7fe",
                                "text": "Genius is 1 per cent. inspiration and 99 per cent. perspiration."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a65c18b-07da-3cdc-a545-2b48f0c55084",
                        "entry_id": "19cb3f4e-b5e6-3b45-b6cb-b4c8c9eb162a",
                        "glosses": [
