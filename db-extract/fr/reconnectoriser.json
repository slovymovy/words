                "senses": [
                    {
                        "sense_id": "b061810f-ab40-3936-892e-ea5af603d266",
                        "entry_id": "5b851cfa-ecfe-36b9-86d1-9413307d0903",
                        "glosses": [
                            "Connectoriser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8644ce-3d13-4f2a-89eb-09c5797a22c4",
                                "sense_id": "b061810f-ab40-3936-892e-ea5af603d266",
                                "text": "J’essaie actuellement de bidouiller le truc, couper tout ça et reconnectoriser, mais pour être sûr, il me faudrait les tensions appliquées aux différents endroits de la connexion: en haut et en bas."
                            },
                            {
                                "example_id": "0a0ec8ba-231a-40d6-9a2a-7100fc669e76",
                                "sense_id": "b061810f-ab40-3936-892e-ea5af603d266",
                                "text": "La solution définitive envisagée est de reconnectoriser les fibres optiques à la température finale du laboratoire, de manière à éviter l’effet de dilatation différentielle, ou bien de retirer le pincement des fibres à leur entrée dans la boîte MONA."
                            }
                        ]
                    }
