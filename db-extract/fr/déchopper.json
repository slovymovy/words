                "senses": [
                    {
                        "sense_id": "17887e0c-3bf2-3f88-a329-676711946176",
                        "entry_id": "730c6fcb-a3f6-39aa-a340-d23b30a6e7e5",
                        "glosses": [
                            "Se défendre contre un adversaire qui choppe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633e2834-1af3-4815-ab4d-50eb80c04f73",
                                "sense_id": "17887e0c-3bf2-3f88-a329-676711946176",
                                "text": "Je n'arrive pas à déchopper, même quand je m'attends à la choppe, que je suis prêt et que j'appuie ça ne déchoppe pas toujours."
                            },
                            {
                                "example_id": "c21107de-66e2-4090-a726-f8f88ce46102",
                                "sense_id": "17887e0c-3bf2-3f88-a329-676711946176",
                                "text": "Sérieusement, en online il y a beaucoup moins de temps pour déchopper, ou plutôt, avec le lag, ça comprend moins vite que tu déchoppes, rendant le timing presque comme une choppe verte."
                            },
                            {
                                "example_id": "5cd868cf-c5a5-4abb-8574-8e89b36a291d",
                                "sense_id": "17887e0c-3bf2-3f88-a329-676711946176",
                                "text": "C'est possible de déchopper en ligne?"
                            }
                        ]
                    }
