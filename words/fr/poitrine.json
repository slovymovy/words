                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a posé son stéthoscope directement sur ma <w>poitrine</w> pour écouter mes poumons."
                        },
                        {
                            "text": "Après une longue course, l'athlète ressentait une vive douleur dans la <w>poitrine</w>."
                        }
                    ],
                    "synonyms": [
                        "thorax",
                        "torse",
                        "buste"
                    ],
                    "common_phrases": [
