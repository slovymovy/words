                        "glosses": [
                            "Behörde, die mit der Verwaltung einer Kolonie/von Kolonien befasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a01226-5a7f-4a33-8398-2fe481d74227",
                                "sense_id": "9088210e-3aba-30cf-9e16-6f91e1c3791c",
                                "text": "„Auf dem Lande verteilten die Kolonialbehörden die besten Böden an Portugiesen.“"
                            },
                            {
                                "example_id": "621cc340-7b76-49ce-9e9f-d1cfc5b0c795",
                                "sense_id": "9088210e-3aba-30cf-9e16-6f91e1c3791c",
                                "text": "„1954 nehmen die Kolonialbehörden den 29-Jährigen ins »Register der zivilisierten einheimischen Bevölkerung« auf.“"
                            },
                            {
                                "example_id": "f506c14a-d0d1-4015-a495-69e02a050490",
                                "sense_id": "9088210e-3aba-30cf-9e16-6f91e1c3791c",
                                "text": "„Ärzte boten sich da als die natürlichen Verbündeten der Kolonialbehörden an.“"
                            }
                        ],
