                ],
                "translations": [
                    {
                        "translation_id": "781dc6d0-54ee-4d32-a24e-a6bef018b5e1",
                        "source_entry_id": "7a8b8fe3-0e5c-3ded-b9c0-effe685b9c61",
                        "source_sense_id": "5948006b-4ab7-3a86-a943-64964a74f4ef",
                        "source_sense_description": "een denkbeeldige cirkel die op een hemellichaam het noordelijk van het zuidelijk halfrond scheidt",
                        "target_lang_word": "Äquator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äquator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                        "entry_id": "2a3a2253-c4d2-3fd9-bfdc-70ee960896b4",
                                        "glosses": [
                                            "größter Breitengrad der Erde und anderer Gestirne; teilt die Erde in eine Nord- und Südhalbkugel, seine Länge beträgt 40.076,6 km und sein Durchmesser 12.756 km; er quert Afrika, die Malediven, den Indischen Ozean, Indonesien, Mikronesien, den Pazifik, Südamerika und den Atlantik"
                                        ],
                                        "tags": [
                                            "Geowissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2c00122-3abc-4c5b-8253-d70c366dbd04",
                                                "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                                "text": "Der Staat Ecuador liegt am Äquator, dafür steht auch sein Name."
                                            },
                                            {
                                                "example_id": "e9d7251e-d8a6-48a2-9d99-ba7999811d5b",
                                                "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                                "text": "„Mit den Missionaren brach sich die Überzeugung Bahn, dass man sich tatsächlich bis weit über den Äquator hinaus in Richtung Süden zu wenden habe, um in der Frage der Nilquellen fündig zu werden.“"
                                            },
                                            {
                                                "example_id": "361172b0-00b4-4d6f-9920-17a354f70d1a",
                                                "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme.“"
                                            },
                                            {
                                                "example_id": "59ad236c-b533-4edc-830a-a05c86bc3206",
                                                "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                                "text": "„Weiter vom Äquator entfernt, ist die Biosphäre dünner besiedelt.“"
                                            },
                                            {
                                                "example_id": "f8464ec2-485b-4ea5-994e-4810e9a51f16",
                                                "sense_id": "6589e316-50f5-3e18-b712-c31e2ff3cec0",
                                                "text": "„Dass es Sterne gibt, deren Äquatoren so gross sind wie die Umlaufbahn der Erde um die Sonne, das raubt ihr den Schlaf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb31596b-aaa6-3dd6-b081-23d0b447c7d7",
                                        "entry_id": "2a3a2253-c4d2-3fd9-bfdc-70ee960896b4",
                                        "glosses": [
                                            "gedachter Großkreis am Sternenhimmel, der in der Ebene des Erdäquators liegt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f12951e4-9699-3103-8b1d-ff7cab0ccaa1",
                                        "entry_id": "2a3a2253-c4d2-3fd9-bfdc-70ee960896b4",
                                        "glosses": [
                                            "gedachter Großkreis, gebildet aus der Schnittlinie der gedachten Himmelskugel mit der Symmetrieebene der Milchstraße"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "398abfbd-6e68-3945-891c-0f00491a8c8b",
                                        "entry_id": "2a3a2253-c4d2-3fd9-bfdc-70ee960896b4",
                                        "glosses": [
                                            "Großkreis auf einer Kugeloberfläche, dessen Schnittebene die Kugel hälftig teilt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
