                                        "sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                                        "entry_id": "8973b931-d9af-3b2e-84d5-a58d1e95ec8e",
                                        "glosses": [
                                            "grünliches Mineral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0965d1c-743c-4358-a2af-bf435c4116cd",
                                                "sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                                                "text": "„In jeden Fall baute man auch in Europa, im Bergwerk von Rudna Glava in Serbien, um diese Zeit bereits in Schächten Malachit und Azurit ab, was möglicherweise in den ersten Jahrhunderten hauptsächlich zu Schmuck und Farbpigmenten verarbeitet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49d15f63-ba56-4b0c-b1dc-f535ce9b1223",
                        "source_entry_id": "cbbd2aea-594e-34b9-9d37-a4be3e893c57",
                        "source_sense_id": "c6edd718-a6db-3456-ad18-be0a3f2b4858",
                        "target_lang_word": "малахит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "малахит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "05a8e9a5-75bd-34bc-bad3-0a7aaf24c779",
                                        "entry_id": "eb5b7069-1a9b-3942-8d29-6b95733070b8",
                                        "glosses": [
                                            "минер. мелкокристаллический водный карбонат меди, хрупкий минерал ярко-зелёного цвета со стеклянным блеском, используемый для поделок, как покрытие колонн или как сырьё для получения красок зелёного цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cadde76-291d-408b-b782-6f6dfa0838d6",
                                                "sense_id": "05a8e9a5-75bd-34bc-bad3-0a7aaf24c779",
                                                "text": "На другой день стал Степан работать, а малахит так и отлетает, да еще королёк с витком попадать стали, а у того ― у племянника-то ― скажи на милость, ничего доброго нет, все обальчик да обманка идёт."
                                            },
                                            {
                                                "example_id": "5318f0fa-ddd0-4323-8b06-697181f20d23",
                                                "sense_id": "05a8e9a5-75bd-34bc-bad3-0a7aaf24c779",
                                                "text": "Котора руда железная, которое ― просто галька. Ну, и малахит есть. Та плитка, которую Яшка сперва ухватил и за пазуху спрятал, тоже малахитовая оказалась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
