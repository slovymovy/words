                    }
                ],
                "senses": [
                    {
                        "sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                        "entry_id": "3a247440-a4f8-3535-8d1d-4cec69873952",
                        "glosses": [
                            "eine tausendstel Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e435e4-7743-4914-a097-675910b7471c",
                                "sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                                "text": "„Ich denke eine Millisekunde zu lange nach.“"
                            },
                            {
                                "example_id": "b9537319-caa1-451c-9857-53fd06ae3d78",
                                "sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                                "text": "Tausend Millisekunden entsprechen einer Sekunde."
                            },
                            {
                                "example_id": "022421e5-375d-4923-b37d-ecdb470f73eb",
                                "sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                                "text": "„Sieben Millisekunden haben über 800 Millionen Dollar entschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f333a1a0-ca87-4244-b68e-5659eaa84ae4",
                        "source_entry_id": "3a247440-a4f8-3535-8d1d-4cec69873952",
                        "source_sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                        "source_sense_description": "eine tausendstel Sekunde",
                        "target_lang_word": "millisecond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millisecond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                        "entry_id": "75317c96-7c7d-3416-8a67-d3c87aa43b3a",
                                        "glosses": [
                                            "An SI unit of time equal to 10⁻³ seconds. Symbol: ms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40b1043-4188-4119-a994-c1b9406cb5c1",
                                                "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                                "text": "Holonyms: centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "448101f2-4377-451e-94e1-51a6e316be9c",
                                                "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond"
                                            },
                                            {
                                                "example_id": "aa9987bc-0f24-49b8-8bd5-f474d8927224",
                                                "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                                "text": "The suggestion that pulsars were rotating neutron stars was put forth independently by Thomas Gold and Franco Pacini in 1968, and was soon proven beyond reasonable doubt by the discovery of a pulsar with a very short (33-millisecond) pulse period in the Crab nebula.ᵂ"
                                            },
                                            {
                                                "example_id": "8753811e-1a85-4db6-8782-0364b6d539ad",
                                                "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            },
                                            {
                                                "example_id": "ce6e52aa-4a50-427a-bbf8-d275008aed70",
                                                "sense_id": "5254e9eb-8fa1-3e29-a432-e1f78a9a32ff",
                                                "text": "The internal NES clock must accurately measure down to milliseconds for its games to work properly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45abd832-2dc1-4aab-8403-f03a4e59fb59",
                        "source_entry_id": "3a247440-a4f8-3535-8d1d-4cec69873952",
                        "source_sense_id": "d43bcbf5-48d0-39da-b3e9-e69f33f33b3b",
                        "source_sense_description": "eine tausendstel Sekunde",
                        "target_lang_word": "milliseconde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milliseconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "515991d8-433c-37ac-afd5-4d94c6f169d0",
                                        "entry_id": "8a3ab533-7000-3812-93dc-399143333206",
                                        "glosses": [
                                            "Unité de mesure de temps du Système international (SI), valant 10⁻³ seconde, et dont le symbole est ms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444b6d6b-8e6f-424b-813f-671fd6ce6ce2",
                                                "sense_id": "515991d8-433c-37ac-afd5-4d94c6f169d0",
                                                "text": "Il y a mille millisecondes dans une seconde."
                                            },
                                            {
                                                "example_id": "e15aafdb-e504-43da-ac66-9962c9f5896f",
                                                "sense_id": "515991d8-433c-37ac-afd5-4d94c6f169d0",
                                                "text": "Cette technique permet de conserver toute la précision de la résolution temporelle de l’EEG en suivant l’activité cérébrale milliseconde par milliseconde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "milliseconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f829746a-71f7-3340-b79b-6af8046b2ed2",
                                        "entry_id": "8ecc7e96-2d89-3b3a-ad3f-f8ea5a3e64b8",
                                        "glosses": [
                                            "Dont la période ou la précision est de l’ordre de la milliseconde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8d3ff3-8fb6-4497-8c47-bf0d367f1cef",
                                                "sense_id": "f829746a-71f7-3340-b79b-6af8046b2ed2",
                                                "text": "Les pulsars millisecondes ont été réactivés par de la matière extérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
