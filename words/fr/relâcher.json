{
    "word_family": [
        "relâche",
        "relâchement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b97a705-33d0-318f-91f6-8fd9d6dfbebb",
                    "sense_definition": "Rendre la liberté à une personne retenue, capturée ou emprisonnée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faute de preuves suffisantes, la police a décidé de <w>relâcher</w> le suspect hier soir."
                        },
                        {
                            "text": "Les ravisseurs ont promis de <w>relâcher</w> les otages dès le début des négociations."
                        }
                    ],
                    "synonyms": [
                        "libérer"
                    ],
                    "antonyms": [
                        "arrêter",
                        "capturer",
                        "emprisonner"
                    ],
                    "common_phrases": [
                        "relâcher un prisonnier",
                        "relâcher un otage"
                    ]
                },
                {
                    "sense_id": "cda6b471-dba6-3fec-8721-74a5c3ffe756",
                    "sense_definition": "Rendre moins tendu, desserrer un lien, une corde ou des muscles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detente_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>relâcher</w> un peu la corde pour ne pas casser la branche."
                        },
                        {
                            "text": "Pendant cet exercice de respiration, essayez de bien <w>relâcher</w> les muscles du cou."
                        }
                    ],
                    "synonyms": [
                        "desserrer",
                        "détendre"
                    ],
                    "antonyms": [
                        "serrer",
                        "tendre"
                    ],
                    "common_phrases": [
                        "relâcher la pression",
                        "relâcher les muscles"
                    ]
                },
                {
                    "sense_id": "be068974-53ae-3333-a382-bdad69f48fba",
                    "sense_definition": "Diminuer l'intensité, la rigueur ou la vigilance apportée à une tâche ou une règle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous ne devons surtout pas <w>relâcher</w> nos efforts à l'approche des examens finaux."
                        },
                        {
                            "text": "Les gardes ont fait l'erreur de <w>relâcher</w> la surveillance pendant la pause du midi."
                        }
                    ],
                    "synonyms": [
                        "diminuer",
                        "faiblir"
                    ],
                    "antonyms": [
                        "intensifier",
                        "redoubler"
                    ],
                    "common_phrases": [
                        "relâcher ses efforts",
                        "relâcher la vigilance",
                        "relâcher la discipline"
                    ]
                },
                {
                    "sense_id": "00e4af5d-a29b-3871-b65d-96a6a2400cf0",
                    "sense_definition": "En parlant d'un navire, faire escale ou s'arrêter temporairement dans un port.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voilier a dû <w>relâcher</w> dans un port voisin à cause de la violente tempête."
                        },
                        {
                            "text": "Après plusieurs semaines en mer, l'équipage a enfin pu <w>relâcher</w> pour réparer la coque."
                        }
                    ],
                    "synonyms": [
                        "faire escale"
                    ],
                    "common_phrases": [
                        "relâcher dans un port"
                    ]
                }
            ]
        }
    ]
}