                    },
                    {
                        "translation_id": "98b9d147-8ca1-4223-a72f-a771d6e95981",
                        "source_entry_id": "54e44b02-0474-3ba4-a062-ab86258865ab",
                        "source_sense_id": "8c5d7551-8606-3fb2-a366-e98f33ab2310",
                        "source_sense_description": "sehr dummer Mensch; Beleidigung/Titulierung",
                        "target_lang_word": "dork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91813b5c-795a-39ea-b2e2-32f21ed8fdf9",
                                        "entry_id": "fa30becb-8a86-3788-86f0-63132b5f0d66",
                                        "glosses": [
                                            "A quirky, silly or stupid, socially inept person, or one who is out of touch with contemporary trends and typically has unfashionable hobbies. (Overlaps conceptually with nerd and geek, but does not imply the same level of intelligence.)"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4865d1fa-12ed-4a1f-aed9-52b21eba462e",
                                                "sense_id": "91813b5c-795a-39ea-b2e2-32f21ed8fdf9",
                                                "text": "I entitled the piece \"Dorky\", dork being slang for a person who does not belong to popular groups, usually an outsider, an odd person, sometimes inept, other times cranky."
                                            },
                                            {
                                                "example_id": "d0f461fb-ad0b-475d-9b83-bff2cdce59b9",
                                                "sense_id": "91813b5c-795a-39ea-b2e2-32f21ed8fdf9",
                                                "text": "I didn’t have any clothes and I had short hair and looked like a dork. Girls wouldn’t go out with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b089df8d-1774-32d2-a5b1-3ffed9112ac8",
                                        "entry_id": "fa30becb-8a86-3788-86f0-63132b5f0d66",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4671821c-3b7e-4c32-a428-738aafd22d12",
                                                "sense_id": "b089df8d-1774-32d2-a5b1-3ffed9112ac8",
                                                "text": "As a matter of fact, this slob was full of information today. He told me why we Jews have different dorks."
                                            },
                                            {
                                                "example_id": "970e69cf-735a-4694-acba-90238420a235",
                                                "sense_id": "b089df8d-1774-32d2-a5b1-3ffed9112ac8",
                                                "text": "\"You’re dead, Trashmouth,\" Vince “Boogers” Taliendo told him, pulling his jock up over a dork roughly the size and shape of an anemic peanut."
                                            },
                                            {
                                                "example_id": "2693c0a9-2b27-43ff-a5cd-9d227fa684f7",
                                                "sense_id": "b089df8d-1774-32d2-a5b1-3ffed9112ac8",
                                                "text": "\"There's that dork whose wife cut off his dork.\" And when people ask him for an autograph he writes, \"Best of luck to Betsy. Signed, the guy whose wife cut off his penis.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a29c994-3fe8-3827-a319-75a50dde4763",
                                        "entry_id": "d7c98996-e50f-3db3-a2b8-fbf5f90f3f3b",
                                        "glosses": [
                                            "To act or behave in the manner of a dork."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdec844f-7a92-3ebf-99c9-39403ec9d18e",
                                        "entry_id": "d7c98996-e50f-3db3-a2b8-fbf5f90f3f3b",
                                        "glosses": [
                                            "To act or behave in an awkward or clumsy manner."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e65457-aedc-4e43-96e0-4bb67b6cfc86",
                                                "sense_id": "fdec844f-7a92-3ebf-99c9-39403ec9d18e",
                                                "text": "I spent all weekend dorking with the router settings with no luck, though I could get any one out of my 5 PCs on the net when connected directly to the modem."
                                            }
                                        ]
                                    }
                                ]
                            },
