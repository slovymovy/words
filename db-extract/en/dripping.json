                    {
                        "sense_id": "edea48c5-0dd5-3ba7-971f-98df88be6111",
                        "entry_id": "27780472-8a0b-35a5-9a42-a4a02c52f7eb",
                        "glosses": [
                            "very wet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796b7233-5bf3-429a-aef7-a7458d7bee7b",
                                "sense_id": "edea48c5-0dd5-3ba7-971f-98df88be6111",
                                "text": "I am sure that the whole scene, with its dripping bamboo forest, every tree festooned with fern, orchid and creeper, filled him with disgust—all so different from the deserts and oases of his lost Bokhara."
                            }
                        ]
                    }
