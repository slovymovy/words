                    "target_lang_definitions": {
                        "en": "to meet, fulfill, or live up to specific expectations, requirements, or wishes",
                        "ru": "отвечать определённым ожиданиям, требованиям или желаниям; удовлетворять им",
                        "nl": "voldoen aan bepaalde verwachtingen, eisen of wensen",
                        "pl": "spełniać określone oczekiwania, wymagania lub życzenia",
                        "fr": "Être à la hauteur de certaines attentes, exigences ou souhaits, ou y satisfaire",
                        "it": "essere all'altezza di determinate aspettative, requisiti o desideri; soddisfarli",
                        "cs": "vyhovovat určitým očekáváním, požadavkům nebo přáním, splňovat je",
                        "tr": "Belirli beklentileri, gereksinimleri veya istekleri karşılamak; bunlara uygun olmak",
                        "es": "cumplir o satisfacer determinadas expectativas, exigencias o deseos",
                        "zh": "符合或满足特定的期望、要求或愿望"
