                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98af97ab-5260-44db-b2d2-66a95dcbf8c3",
                                "sense_id": "1f6cafbb-5b67-3bcb-bdbe-97e5c7457ec9",
                                "text": "Er sammelt seit zehn Jahren die deutschen Gedenkmünzen."
                            },
                            {
                                "example_id": "f431b873-98f4-4e6b-8e22-c4ac3892969e",
                                "sense_id": "1f6cafbb-5b67-3bcb-bdbe-97e5c7457ec9",
                                "text": "„Sie wurden auf Gedenkmünzen und Medaillen geprägt, gern mit Melanchthon auf der Hinterseite, auf Holztäfelchen gepinselt und in großformatige Bilder gemalt.“"
                            }
                        ],
