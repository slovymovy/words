    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c87f9230-b104-3c7b-8ecd-247ef0f1e716",
                    "sense_definition": "Iets in contact brengen met de buitenlucht om het te verfrissen of te drogen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verfrissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet de kamer even <w>luchten</w> na het koken.",
                            "target_lang_translations": {
                                "en": "I need to <w>air out</w> the room for a bit after cooking.",
                                "ru": "Мне нужно немного <w>проветрить</w> комнату после готовки."
                            }
                        },
                        {
                            "text": "Zet het raam open om de lakens goed te <w>luchten</w>.",
                            "target_lang_translations": {
                                "en": "Open the window to <w>air</w> the sheets properly.",
                                "ru": "Открой окно, чтобы хорошенько <w>проветрить</w> простыни."
                            }
                        }
                    ],
                    "synonyms": [
                        "ventileren",
                        "spuien"
                    ],
                    "common_phrases": [
                        "de kamer luchten",
                        "het beddengoed luchten"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something into contact with the outside air to refresh or dry it.",
                        "ru": "Проветривать или сушить что-либо на свежем воздухе."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "air out",
                                "target_lang_sense_clarification": "to refresh a room or object"
                            },
                            {
                                "target_lang_word": "ventilate",
                                "target_lang_sense_clarification": "to allow fresh air into a space"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проветривать",
                                "target_lang_sense_clarification": "впускать свежий воздух в помещение или освежать вещь"
                            },
                            {
                                "target_lang_word": "выветривать",
                                "target_lang_sense_clarification": "удалять запахи с помощью воздуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc408f94-802b-3239-a359-ba037d0b6d55",
                    "sense_definition": "Je gevoelens of zorgen uitspreken om jezelf te ontlasten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilde eindelijk haar hart <w>luchten</w> bij haar beste vriendin.",
                            "target_lang_translations": {
                                "en": "She finally wanted to <w>pour out</w> her heart to her best friend.",
                                "ru": "Она наконец-то захотела <w>излить душу</w> своей лучшей подруге."
                            }
                        },
                        {
                            "text": "Het helpt vaak om je gemoed te <w>luchten</w> als je gestrest bent.",
                            "target_lang_translations": {
                                "en": "It often helps to <w>vent</w> your feelings when you are stressed.",
                                "ru": "Часто помогает <w>выговориться</w>, когда ты в стрессе."
                            }
                        }
                    ],
                    "synonyms": [
                        "uiten",
                        "uitspreken",
                        "ontboezemen"
                    ],
                    "antonyms": [
                        "opkroppen"
                    ],
                    "common_phrases": [
                        "je hart luchten",
                        "je gemoed luchten"
                    ],
                    "target_lang_definitions": {
                        "en": "To express your feelings or worries to relieve yourself.",
                        "ru": "Выражать свои чувства или заботы, чтобы облегчить душу."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vent",
                                "target_lang_sense_clarification": "to express strong emotions"
                            },
                            {
                                "target_lang_word": "pour out",
                                "target_lang_sense_clarification": "to share feelings freely"
                            },
                            {
                                "target_lang_word": "unburden",
                                "target_lang_sense_clarification": "to relieve oneself of worries"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "изливать душу",
                                "target_lang_sense_clarification": "делиться сокровенными чувствами"
                            },
                            {
                                "target_lang_word": "выговариваться",
                                "target_lang_sense_clarification": "облегчать душу разговором"
                            },
                            {
                                "target_lang_word": "давать волю чувствам",
                                "target_lang_sense_clarification": "выражать накопившиеся эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "123f8431-c63d-396a-b02e-7504bb83e7c6",
                    "sense_definition": "Iemand (zoals een gevangene) de gelegenheid geven om buiten in de frisse lucht te zijn.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verfrissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangenen worden elke middag een uur lang <w>gelucht</w> op de binnenplaats.",
                            "target_lang_translations": {
                                "en": "The prisoners are <w>taken out for air</w> in the courtyard for an hour every afternoon.",
                                "ru": "Каждый день после обеда заключенных на час <w>выводят на прогулку</w> во внутренний дворик."
                            }
                        },
                        {
                            "text": "Het is wettelijk verplicht om gedetineerden dagelijks te <w>luchten</w>.",
                            "target_lang_translations": {
                                "en": "It is a legal requirement to <w>air</w> detainees daily.",
                                "ru": "По закону требуется ежедневно <w>выводить</w> задержанных на свежий воздух."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gevangenen luchten"
                    ],
                    "target_lang_definitions": {
                        "en": "To give someone (such as a prisoner) the opportunity to be outside in the fresh air.",
                        "ru": "Предоставлять кому-либо (например, заключенному) возможность побыть на свежем воздухе."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "air",
                                "target_lang_sense_clarification": "to take someone outside for fresh air"
                            },
                            {
                                "target_lang_word": "exercise",
                                "target_lang_sense_clarification": "outdoor time for detainees"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выводить на прогулку",
                                "target_lang_sense_clarification": "выводить заключенных на свежий воздух"
                            },
                            {
                                "target_lang_word": "выгуливать",
                                "target_lang_sense_clarification": "иронично или разговорно о выводе людей на воздух"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aab422a4-0999-3711-a940-06c52f705f3b",
                    "sense_definition": "Iemand of iets kunnen verdragen of tolereren (meestal in negatieve zin gebruikt).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tolereren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan die man niet <w>luchten</w> of zien vanwege zijn gedrag.",
                            "target_lang_translations": {
                                "en": "I can't <w>stand</w> the sight of that man because of his behavior.",
                                "ru": "Я этого человека <w>видеть не могу</w> из-за его поведения."
                            }
                        },
                        {
                            "text": "Sinds die ruzie kan zij haar buurvrouw niet meer <w>luchten</w>.",
                            "target_lang_translations": {
                                "en": "Since that argument, she can no longer <w>stomach</w> her neighbor.",
                                "ru": "После той ссоры она больше не может <w>терпеть</w> свою соседку."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdragen",
                        "uitstaan",
                        "tolereren"
                    ],
                    "common_phrases": [
                        "niet kunnen luchten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in de uitdrukking 'niet kunnen luchten of zien'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be able to bear or tolerate someone or something (usually used in a negative sense).",
                        "ru": "Быть в состоянии выносить или терпеть кого-либо или что-либо (обычно используется в отрицательном смысле)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "to tolerate someone"
                            },
                            {
                                "target_lang_word": "stomach",
                                "target_lang_sense_clarification": "to endure someone's presence"
                            },
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to tolerate"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "терпеть чье-либо присутствие"
                            },
                            {
                                "target_lang_word": "видеть не хотеть",
                                "target_lang_sense_clarification": "испытывать сильную неприязнь к кому-либо"
                            },
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "выносить кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "401669d5-1608-3941-9f54-7b7250649d1b",
                    "sense_definition": "Licht verspreiden of verlichten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fakkels <w>luchtten</w> de donkere gangen van het oude kasteel.",
                            "target_lang_translations": {
                                "en": "The torches <w>lit up</w> the dark corridors of the old castle.",
                                "ru": "Факелы <w>освещали</w> темные коридоры старого замка."
                            }
                        },
                        {
                            "text": "In de verte <w>luchtte</w> een klein lampje de duisternis.",
                            "target_lang_translations": {
                                "en": "In the distance, a small lamp <w>illuminated</w> the darkness.",
                                "ru": "Вдали маленький огонек <w>рассеивал</w> темноту."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlichten",
                        "beschijnen"
                    ],
                    "antonyms": [
                        "verduisteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis is verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spread light or illuminate.",
                        "ru": "Распространять свет или освещать (устаревшее значение)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "light up",
                                "target_lang_sense_clarification": "to illuminate"
                            },
                            {
                                "target_lang_word": "illuminate",
                                "target_lang_sense_clarification": "to provide light"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "делать светлым, озарять"
                            },
                            {
                                "target_lang_word": "озарять",
                                "target_lang_sense_clarification": "наполнять светом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76f07b6d-021d-3712-8627-d39df3070ee1",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>lucht</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Nederland zie je vaak prachtige grijze <w>luchten</w> boven de zee.",
                            "target_lang_translations": {
                                "en": "In the Netherlands, you often see beautiful grey <w>skies</w> above the sea.",
                                "ru": "В Нидерландах над морем часто можно увидеть красивое серое <w>небо</w>."
                            }
                        },
                        {
                            "text": "De schilder was beroemd om zijn weidse landschappen met hoge <w>luchten</w>.",
                            "target_lang_translations": {
                                "en": "The painter was famous for his vast landscapes with high <w>skies</w>.",
                                "ru": "Художник был знаменит своими просторными пейзажами с высокими <w>небесами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoge luchten",
                        "dreigende luchten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pluralis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'lucht' (air/sky).",
                        "ru": "Множественное число существительного 'lucht' (небо, небеса)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skies",
                                "target_lang_sense_clarification": "plural of sky"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "небеса",
                                "target_lang_sense_clarification": "множественное число от небо"
                            },
                            {
                                "target_lang_word": "облака",
                                "target_lang_sense_clarification": "в контексте живописного неба"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}