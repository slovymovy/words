                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "cae79bd9-6249-46c4-9d72-3044ad623195",
                                "sense_id": "e2c0f31e-9424-3c3a-b398-d8470cd383ef",
                                "text": "Die Wirtschaftsstelle für Rundfunkapparatefabriken (Wirufa), die in den beiden vorerwähnten Verträgen von den Vertragsfabriken ermächtigt worden ist, [...], will die Firma E. AG. R. in G., die den Einzelhandel mit Rundfunkgeräten seit dem Jahre 1926 betreibt, nicht in die Liste der anerkannten Einzelhändler aufnehmen und hat beantragt, ihr die Einwilligung zu erteilen, daß die Firma E. AG. R. von der Belieferung als Einzelhändlerin mit Rundfunkapparaten und Lautsprechern ausgeschlossen wird."
                            }
                        ]
                    }
                ],
