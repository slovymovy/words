                "senses": [
                    {
                        "sense_id": "a2e2c1cb-2b2a-3c2d-897f-193ea6e4dd5e",
                        "entry_id": "bb6ac462-eea7-3703-a5f7-f4b687972e28",
                        "glosses": [
                            "Utilisé en majestatif (mode marquant la majesté de l'interlocuteur), en parlant d’un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7ba617-c89a-46b1-8aa9-54d97d069dc3",
                                "sense_id": "a2e2c1cb-2b2a-3c2d-897f-193ea6e4dd5e",
                                "text": "Le « nous » royal est un pronom majestatif."
                            },
                            {
                                "example_id": "af08e69b-c938-4c8b-a496-d5c5ddd37b56",
                                "sense_id": "a2e2c1cb-2b2a-3c2d-897f-193ea6e4dd5e",
                                "text": "— Vous provoquiez une incertitude. Nous n’aimons pas l’incertitude.\n— Nous, nous ! C’est un nous majestatif ?\n— Je parle au nom des scientifiques de la basilique."
                            }
                        ]
                    },
                    {
                        "sense_id": "595f878a-37d8-34fd-828b-87fe94da6947",
                        "entry_id": "bb6ac462-eea7-3703-a5f7-f4b687972e28",
                        "glosses": [
                            "De majesté, en parlant d’une mesure de syllabe en poétique ou en rhétorique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1179f5-ebb9-40ce-8558-c412ec30dcdc",
                                "sense_id": "595f878a-37d8-34fd-828b-87fe94da6947",
                                "text": "On rappellera, à ce titre, qu’un terme comme \"éternité\", pris dans une mesure majestative, intervient d’ordinaire chez des orateurs religieux, Bossuet par exemple."
                            }
                        ]
                    }
