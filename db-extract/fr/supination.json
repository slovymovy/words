        "fr-extract.jsonl": [
            {
                "entry_id": "d09b03b2-63e9-3fc6-87f5-bc2b47bf2c27",
                "word": "supination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3f6dc80-e32a-42b6-a9a6-abfa28eb09e6",
                        "entry_id": "d09b03b2-63e9-3fc6-87f5-bc2b47bf2c27",
                        "tags": [
                            "plural"
                        ],
                        "form": "supinations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36b020fc-2baa-347d-8ff2-7f0dd271b61c",
                        "entry_id": "d09b03b2-63e9-3fc6-87f5-bc2b47bf2c27",
                        "glosses": [
                            "Position d’une personne couchée sur le dos, dont les bras et les jambes reposent à plat."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f17fc251-c4ad-3c43-aaa9-207ed75ed83b",
                        "entry_id": "d09b03b2-63e9-3fc6-87f5-bc2b47bf2c27",
                        "glosses": [
                            "Mouvement que les muscles supinateurs font exécuter à l’avant-bras et à la main de manière que la paume se trouve en dessus, ou au pied de sorte que la plante regarde vers l’extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d451628-3c4e-4cab-b7de-6a681e25a1d4",
                                "sense_id": "f17fc251-c4ad-3c43-aaa9-207ed75ed83b",
                                "text": "Mes mains sont faites pour porter, justement, pour soulever, pour emporter. Des deux positions classiques – supination et pronation – seule la supination leur convient. C’est même leur position habituelle, paumes ouvertes vers le ciel, doigts joints et tendus à plats."
                            },
                            {
                                "example_id": "330036dc-8d65-4592-9ea8-60db16018b10",
                                "sense_id": "f17fc251-c4ad-3c43-aaa9-207ed75ed83b",
                                "text": "Renseignement pris, cet avant-bras se trouvait en supination, retenu au montant du lit par une sangle et perforé par une grosse aiguille de perfusion qu’un large sparadrap translucide maintenait."
                            },
                            {
                                "example_id": "abf114fd-71f6-430b-8a80-756dfab597f0",
                                "sense_id": "f17fc251-c4ad-3c43-aaa9-207ed75ed83b",
                                "text": "D’un autre côté, une forte pression sur l’avant-bras peut endolorer les parties, les priver pour le moment de la pronation et de la supination, quoiqu’il n'y ait pas fracture."
                            }
                        ]
                    }
                ],
