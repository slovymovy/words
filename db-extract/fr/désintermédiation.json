        "fr-extract.jsonl": [
            {
                "entry_id": "be363b16-b49b-3eaf-9178-7224b3345ece",
                "word": "désintermédiation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d040bd2-3067-40aa-92e8-bcacf816afd6",
                        "entry_id": "be363b16-b49b-3eaf-9178-7224b3345ece",
                        "tags": [
                            "plural"
                        ],
                        "form": "désintermédiations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34d696a8-44e8-3a22-9ec6-307c328688b0",
                        "entry_id": "be363b16-b49b-3eaf-9178-7224b3345ece",
                        "glosses": [
                            "L’enlèvement de fonds d’une banque ou d’un autre établissement financier pour l’achat direct d’instruments financiers."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "fba5017c-695f-4e0c-9bf5-ca6472e34487",
                                "sense_id": "34d696a8-44e8-3a22-9ec6-307c328688b0",
                                "text": "Grâce à la désintermédiation, le financement des investissements par les banques a fortement diminué ces dernières années."
                            },
                            {
                                "example_id": "d41f6d05-8d61-429d-b146-ebb04ee94b38",
                                "sense_id": "34d696a8-44e8-3a22-9ec6-307c328688b0",
                                "text": "Quoi qu’il en soit, on a du mal à croire Eric Schmidt, le P-DG de Google, quand il assure ne pas vouloir faire de l’ombre aux agences de publicité. La menace de la désintermédiation plane au contraire sur elles : tout se passe comme si Google voulait tenir tous les bouts de la chaîne, traiter directement avec les annonceurs – c’est cela la désintermédiation – et ainsi enlever une grande partie de leur raison d’être et de leur métier aux agences de publicité."
                            }
                        ]
                    },
                    {
                        "sense_id": "18b4d73b-0d25-379b-86be-89b1c0aa33e1",
                        "entry_id": "be363b16-b49b-3eaf-9178-7224b3345ece",
                        "glosses": [
                            "L’omission des parties intermédiaires d’une transaction commerciale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25462e42-3c33-4ec3-9624-6aad3a4cd1fe",
                                "sense_id": "18b4d73b-0d25-379b-86be-89b1c0aa33e1",
                                "text": "L’argent qu’on gagne par la désintermédiation du processus peut servir à mieux récompenser les agriculteurs africains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c98fa859-b751-40a9-98ed-08ae43b4a23c",
                        "source_entry_id": "be363b16-b49b-3eaf-9178-7224b3345ece",
                        "target_lang_word": "disintermediation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disintermediation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3794fd-2c1c-3736-94ff-eb385553b84a",
                                        "entry_id": "7f34f554-2239-3396-ae48-0d357dc841fc",
                                        "glosses": [
                                            "The removal of funds from a financial institution such as a bank for direct purchase of financial instruments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "212e0d62-e6bc-4d8b-a814-8c5ffda8c55f",
                                                "sense_id": "3c3794fd-2c1c-3736-94ff-eb385553b84a",
                                                "text": "Any disintermediation crisis, such as has occurred three times since 1966, causes mortgage money to dry up and slow down new housing construction which the country desperately needs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                        "entry_id": "7f34f554-2239-3396-ae48-0d357dc841fc",
                                        "glosses": [
                                            "The removal of an intermediary from a commercial transaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6cbff80-84b1-4582-8989-3a1d288e943e",
                                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                                "text": "The news industry is undergoing a massive disintermediation due to the ubiquitous low-cost communication made possible by the internet."
                                            },
                                            {
                                                "example_id": "fdb1d8f4-66c7-4b40-9aac-faaf31a268a2",
                                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                                "text": "New-media thinkers, with their appetite for disintermediation and creative destruction, implicitly endorse and advance this transformation."
                                            },
                                            {
                                                "example_id": "cc024190-6a4e-4d0b-9798-21d519ab8941",
                                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                                "text": "The logic of disintermediation seems self-evident: By putting factories directly in contact with stores, by helping customers order directly from manufacturers, by letting riders coordinate with drivers, you cut out a needless source of waste and inefficiency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
