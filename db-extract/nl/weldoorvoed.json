                "senses": [
                    {
                        "sense_id": "a337785f-e318-389c-bf08-801b88b76a2c",
                        "entry_id": "288d8f0e-934c-3220-b2ed-3ba242d059fc",
                        "glosses": [
                            "goed te eten hebben gehad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df512b81-8100-4547-b27a-38c5c669037b",
                                "sense_id": "a337785f-e318-389c-bf08-801b88b76a2c",
                                "text": "Hun 64-jarige voorman Armin Capaul zegt dat de werkelijkheid totaal verschilt van het ideaalplaatje van een vredig Alpenlandschap met grazige weiden en weldoorvoed, gelukzalig vee. Tegenwoordig worden bij negen van de tien Zwitserse kalfjes en geitjes de hoorns verwijderd om in de megastallen de kans op letsel te verkleinen."
                            }
                        ]
                    },
                    {
                        "sense_id": "29410135-d4f3-3922-a68a-d380c38a086f",
                        "entry_id": "288d8f0e-934c-3220-b2ed-3ba242d059fc",
                        "glosses": [
                            "te dik zijn"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "4ea38d5f-d645-4daa-b54b-14f5579605d9",
                                "sense_id": "29410135-d4f3-3922-a68a-d380c38a086f",
                                "text": "Gisteren nog. Deed iemand een dringende oproep op Twitter. Of de eigenaar van een kip van het formaat kalkoen zich terstond wilde melden. De weldoorvoede vogel barricadeerde de deur en intimideerde de kater des huizes, waardoor deze zijn dagelijkse gang naar buiten niet meer durfde te maken."
                            }
                        ]
                    }
                ],
