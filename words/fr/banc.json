{
    "word_family": [
        "banquette",
        "bancal",
        "banquise"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9670d3ce-fbe4-30cf-bd53-24673e0460a4",
                    "sense_definition": "Long siège pour plusieurs personnes, situé dans un lieu public ou une pièce.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous reposons sur un <w>banc</w> dans le parc après une longue promenade."
                        },
                        {
                            "text": "Deux personnes âgées discutent tranquillement sur le <w>banc</w> en bois devant la fontaine."
                        }
                    ],
                    "common_phrases": [
                        "banc public",
                        "s'asseoir sur un banc"
                    ]
                },
                {
                    "sense_id": "c550de8b-5178-3212-bcc4-0752ffcb410b",
                    "sense_definition": "Groupe important d'animaux marins, en particulier de poissons, qui nagent ensemble.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "faune_marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plongeur a observé un immense <w>banc</w> de poissons tropicaux près du récif."
                        },
                        {
                            "text": "Les pêcheurs suivent ce <w>banc</w> de sardines depuis le lever du jour."
                        }
                    ],
                    "common_phrases": [
                        "banc de poissons",
                        "banc de sardines"
                    ]
                },
                {
                    "sense_id": "e4e18179-fbbd-3f6b-b5b2-39d477123c36",
                    "sense_definition": "Amas de sable ou de roches accumulé au fond de l'eau, formant un haut-fond.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit voilier s'est retrouvé coincé sur un <w>banc</w> de sable à marée basse."
                        },
                        {
                            "text": "Les oiseaux marins aiment se poser sur ce grand <w>banc</w> au milieu du fleuve."
                        }
                    ],
                    "synonyms": [
                        "haut-fond"
                    ],
                    "common_phrases": [
                        "banc de sable"
                    ]
                },
                {
                    "sense_id": "df27705a-2f43-3f00-9220-817e91391086",
                    "sense_definition": "Masse dense et étendue de brouillard, de brume ou de nuages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les automobilistes ont ralenti à cause d'un épais <w>banc</w> de brouillard sur l'autoroute."
                        },
                        {
                            "text": "L'avion a soudainement traversé un large <w>banc</w> de nuages avant d'atterrir."
                        }
                    ],
                    "synonyms": [
                        "nappe"
                    ],
                    "common_phrases": [
                        "banc de brouillard",
                        "banc de brume"
                    ]
                },
                {
                    "sense_id": "ef068997-1f3b-368c-a26d-0f08271e6516",
                    "sense_definition": "Siège où s'assoient les remplaçants lors d'un match de sport, ou l'ensemble de ces joueurs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune attaquant a commencé le match sur le <w>banc</w> avant d'entrer en jeu."
                        },
                        {
                            "text": "L'entraîneur observe le jeu avec attention depuis le <w>banc</w> de touche."
                        }
                    ],
                    "common_phrases": [
                        "banc de touche",
                        "banc des remplaçants"
                    ]
                },
                {
                    "sense_id": "07ab7397-b4d4-35de-9782-217b94eeb4e5",
                    "sense_definition": "Siège d'écolier, utilisé figurativement au pluriel pour désigner la scolarité ou les études.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux amis d'enfance se sont rencontrés pour la première fois sur les <w>bancs</w> de l'école."
                        },
                        {
                            "text": "Après plusieurs années d'expérience professionnelle, il a choisi de retourner sur les <w>bancs</w> de l'université."
                        }
                    ],
                    "common_phrases": [
                        "bancs de l'école"
                    ]
                },
                {
                    "sense_id": "6e33dd42-9155-373a-93c3-7630ba48f3e8",
                    "sense_definition": "Siège occupé par un parlementaire dans une assemblée politique, ou groupe politique associé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des applaudissements nourris ont résonné sur les <w>bancs</w> de la majorité après ce discours."
                        },
                        {
                            "text": "Le ministre a répondu aux questions critiques venues des <w>bancs</w> de l'opposition."
                        }
                    ],
                    "common_phrases": [
                        "bancs de l'Assemblée",
                        "bancs de l'opposition"
                    ]
                },
                {
                    "sense_id": "8418d295-a476-3318-9ac2-d025d6a490a3",
                    "sense_definition": "Support ou table d'atelier aménagé pour effectuer des opérations techniques ou des tests.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs ont testé le nouveau moteur d'avion sur un <w>banc</w> d'essai sophistiqué."
                        },
                        {
                            "text": "Le mécanicien a démonté la pièce défectueuse directement sur son <w>banc</w> d'atelier."
                        }
                    ],
                    "common_phrases": [
                        "banc d'essai"
                    ]
                }
            ]
        }
    ]
}