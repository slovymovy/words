{
    "word_family": [
        "clotting",
        "clotted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2102306-9097-3320-abc8-d2b69b020b0e",
                    "sense_definition": "A solidified mass of blood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solidified_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor was worried about a blood <w>clot</w> forming in the patient's leg.",
                            "target_lang_translations": {
                                "zh": "医生担心病人的腿部会形成<w>血块</w>。",
                                "fr": "Le médecin s'inquiétait de la formation d'un <w>caillot</w> de sang dans la jambe du patient."
                            }
                        },
                        {
                            "text": "A small <w>clot</w> can block blood flow to the heart or brain.",
                            "target_lang_translations": {
                                "zh": "一小块<w>血栓</w>就可能阻断通往心脏或大脑的血液流动。",
                                "fr": "Un petit <w>caillot</w> peut bloquer la circulation sanguine vers le cœur ou le cerveau."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrombus"
                    ],
                    "common_phrases": [
                        "blood clot"
                    ],
                    "target_lang_definitions": {
                        "zh": "血液凝结成的块状物。",
                        "fr": "Masse solide formée par la coagulation du sang."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "血块",
                                "target_lang_sense_clarification": "指血液在血管内或伤口处形成的凝块。"
                            },
                            {
                                "target_lang_word": "血栓",
                                "target_lang_sense_clarification": "医学术语，指在血管内形成的血块。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "caillot",
                                "target_lang_sense_clarification": "masse de sang coagulé"
                            },
                            {
                                "target_lang_word": "thrombus",
                                "target_lang_sense_clarification": "terme médical désignant un caillot sanguin formé dans les vaisseaux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5438aeb2-7a6b-3317-88bc-4cccd39ce58e",
                    "sense_definition": "A solidified mass of any liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solidified_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The milk had turned into a thick <w>clot</w> after sitting in the sun.",
                            "target_lang_translations": {
                                "zh": "牛奶在阳光下放置后变成了浓稠的<w>凝块</w>。",
                                "fr": "Le lait s'était transformé en un <w>caillot</w> épais après être resté au soleil."
                            }
                        },
                        {
                            "text": "The sauce formed a <w>clot</w> because it was cooked at too high a temperature.",
                            "target_lang_translations": {
                                "zh": "酱汁因为烹饪温度过高而形成了<w>结块</w>。",
                                "fr": "La sauce a formé un <w>grumeau</w> parce qu'elle a été cuite à une température trop élevée."
                            }
                        }
                    ],
                    "synonyms": [
                        "lump",
                        "mass"
                    ],
                    "target_lang_definitions": {
                        "zh": "液体凝结成的块状物。",
                        "fr": "Masse solide formée par l'épaississement ou la coagulation d'un liquide quelconque."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凝块",
                                "target_lang_sense_clarification": "泛指液体变稠或凝固后形成的块状物。"
                            },
                            {
                                "target_lang_word": "结块",
                                "target_lang_sense_clarification": "指物质因受热或变质而形成的块状。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "grumeau",
                                "target_lang_sense_clarification": "petite masse solide formée dans un liquide ou une sauce"
                            },
                            {
                                "target_lang_word": "caillot",
                                "target_lang_sense_clarification": "masse formée par un liquide coagulé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc29e7fb-7f7c-3a32-bc67-56af56b58596",
                    "sense_definition": "A foolish or silly person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>clot</w> and just listen to what I am saying.",
                            "target_lang_translations": {
                                "zh": "别像个<w>笨蛋</w>一样，听我说。",
                                "fr": "Ne sois pas un tel <w>imbécile</w> et écoute simplement ce que je dis."
                            }
                        },
                        {
                            "text": "He acted like a total <w>clot</w> during the entire meeting.",
                            "target_lang_translations": {
                                "zh": "他在整个会议期间表现得像个十足的<w>傻瓜</w>。",
                                "fr": "Il s'est comporté comme un parfait <w>idiot</w> pendant toute la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "愚蠢或笨拙的人。",
                        "fr": "Personne stupide ou sotte."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "指人愚蠢或行为笨拙。"
                            },
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指人愚笨或做事糊涂。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "imbécile",
                                "target_lang_sense_clarification": "personne manquant d'intelligence ou de bon sens"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "personne stupide ou maladroite"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "124d44fa-8989-3b25-b507-2dcf848ed741",
                    "sense_definition": "To change from a liquid to a thickened or solid state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solidify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blood began to <w>clot</w> almost immediately after the injury occurred.",
                            "target_lang_translations": {
                                "zh": "受伤后，血液几乎立即开始<w>凝结</w>。",
                                "fr": "Le sang a commencé à <w>coaguler</w> presque immédiatement après la blessure."
                            }
                        },
                        {
                            "text": "Certain medical conditions make it harder for blood to <w>clot</w> properly.",
                            "target_lang_translations": {
                                "zh": "某些疾病会导致血液难以正常<w>凝固</w>。",
                                "fr": "Certaines affections médicales empêchent le sang de <w>coaguler</w> correctement."
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulate"
                    ],
                    "target_lang_definitions": {
                        "zh": "液体变稠或凝固。",
                        "fr": "Passer de l'état liquide à un état épais ou solide."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凝结",
                                "target_lang_sense_clarification": "指液体变成固体或半固体状态。"
                            },
                            {
                                "target_lang_word": "凝固",
                                "target_lang_sense_clarification": "指血液或液体由液态变为固态。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "coaguler",
                                "target_lang_sense_clarification": "se figer ou s'épaissir, en parlant du sang ou d'un liquide"
                            },
                            {
                                "target_lang_word": "cailler",
                                "target_lang_sense_clarification": "se solidifier, particulièrement pour le lait"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed84ba4-5507-3923-9be2-335f4338d8ed",
                    "sense_definition": "To cause a liquid to become a thickened or solid mass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solidify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold temperature helped to <w>clot</w> the mixture into a firm shape.",
                            "target_lang_translations": {
                                "zh": "低温有助于使混合物<w>凝结</w>成坚固的形状。",
                                "fr": "La basse température a aidé à <w>faire figer</w> le mélange en une forme ferme."
                            }
                        },
                        {
                            "text": "Adding the enzyme will <w>clot</w> the milk to make cheese.",
                            "target_lang_translations": {
                                "zh": "加入酶可以使牛奶<w>凝固</w>以制作奶酪。",
                                "fr": "Ajouter l'enzyme permettra de <w>faire cailler</w> le lait pour fabriquer du fromage."
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulate",
                        "thicken"
                    ],
                    "target_lang_definitions": {
                        "zh": "使液体变稠或凝固。",
                        "fr": "Faire passer un liquide à un état épais ou solide."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使凝结",
                                "target_lang_sense_clarification": "促使液体发生凝固过程。"
                            },
                            {
                                "target_lang_word": "使凝固",
                                "target_lang_sense_clarification": "导致液体变成块状。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "faire coaguler",
                                "target_lang_sense_clarification": "provoquer la coagulation d'un liquide"
                            },
                            {
                                "target_lang_word": "cailler",
                                "target_lang_sense_clarification": "faire prendre en masse, notamment pour le lait"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}