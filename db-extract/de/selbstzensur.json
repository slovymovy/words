                        "entry_id": "3aa4f685-0175-3cbc-bc54-79fa85139d43",
                        "glosses": [
                            "Maßnahme einer Person oder Institution, die die eigenen Handlungen oder Texte von allem freihält/freimacht, das Anstoß erregen oder Sanktionen hervorrufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad86a2a9-4f02-40ea-b5dd-9d2656c43035",
                                "sense_id": "614f305d-6568-348b-b94b-1cbb32de68c4",
                                "text": "„Was mit der »Walpurgisnacht« geschah, ist nun ein sehr klarer Fall von Selbstzensur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
