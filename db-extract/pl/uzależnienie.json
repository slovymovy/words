                                                "sense_id": "f67f7ba8-646c-364b-ab91-ee587e11c597",
                                                "text": "Die Sucht nach Spiel trieb ihn in das Kasino."
                                            },
                                            {
                                                "example_id": "c6547a4f-f320-46aa-8cbf-e0c688bff69f",
                                                "sense_id": "f67f7ba8-646c-364b-ab91-ee587e11c597",
                                                "text": "„Seine Menschen folgen ihrer Natur durch alle Süchte und Sehnsüchte, durch alle Lüste und Wollüste.“"
                                            }
                                        ],
