                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66efde8e-059c-4dd1-ba51-dd5efeaa0cdd",
                                "sense_id": "7c097f1e-7864-3e12-8c2d-f2405c5a8a80",
                                "text": "Une seule fois, le 28 octobre 1917, le lourd et lent monitor anglais Erebus reçoit un canot-torpille en pleine coque et... garde le sourire."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b0c07fd-391d-3106-abad-9dcc3f1a9aef",
                        "entry_id": "0695ed46-ac21-3494-b420-7dc27f2231c2",
                        "glosses": [
