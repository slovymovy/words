                        ],
                        "examples": [
                            {
                                "example_id": "71142079-c317-4b76-b96e-de2a10d0bf13",
                                "sense_id": "f1e4bdce-1849-3c36-a003-5f61f6374cd6",
                                "text": "He strung the angelot; / Made rhymes thereto; […]"
                            },
                            {
                                "example_id": "3d107784-b8fb-4621-9363-ee458737ebf3",
                                "sense_id": "f1e4bdce-1849-3c36-a003-5f61f6374cd6",
                                "text": "A man who allows wild passion to arise within, himself burns his heart, then after burning adds the wind that thereto which ignites the fire again, or not, as the case may be."
                            }
                        ]
                    }
                ],
                "translations": [
