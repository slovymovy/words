                ],
                "senses": [
                    {
                        "sense_id": "b66a08c0-194a-3a5a-a322-72855424f2c2",
                        "entry_id": "314a183f-c1ba-3e19-86d6-28a426b53129",
                        "glosses": [
                            "smeersel of poeder waarmee men de huid witter maakt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "742c8d8e-ecc0-462b-9f56-0365b5b51dfd",
                                "sense_id": "b66a08c0-194a-3a5a-a322-72855424f2c2",
                                "text": "In die \"De Cultu Feminarum\" geeft Tertullianus er de vrouwen van langs op een manier die niet voor de poes is. Hij gaat tekeer tegen het blanket, tegen het opmaken van het haar en zo meer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf33579-ad15-3dac-a89c-f0da0f6e32cc",
                        "entry_id": "314a183f-c1ba-3e19-86d6-28a426b53129",
                        "glosses": [
                            "uiterlijke aanpassing om iets te verbergen"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2e058e88-ebf3-4aff-ac69-fc5911a167ae",
                                "sense_id": "bbf33579-ad15-3dac-a89c-f0da0f6e32cc",
                                "text": "⧖ Wat vind de weetzugt, die in velerhande Boeken\nDe zuyvre waarheyd der aloudheyd op wil zoeken,\nZig vaak bedrogen! daar zy in verliefde lust,\nEen snood verdigtzel al te eerbiedig streeld en kust.\nWat wonder! een blanket van schijngebeurlijkheden,\nEen stoet van Naam, en tijd, en yders landschaps Zeden,\nGeçierdt met schildery, om ’t zinlijkst toegepast,\n’t Eenvuldige geloof van menig heeft verrast."
                            }
                        ]
                    }
                ],
