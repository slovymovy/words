                        ]
                    },
                    {
                        "translation_id": "6b69d55f-6cfe-4356-abdf-2907ab775f6d",
                        "source_entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "source_sense_id": "db2c54b9-a3eb-390c-8b9d-3ecb0b9682d5",
                        "source_sense_description": "Équitation",
                        "target_lang_word": "Volte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "349b280e-5652-3c29-8563-893edf2299ac",
                                        "entry_id": "309925fc-3c6e-3bfa-b540-bd6a93baf92b",
                                        "glosses": [
                                            "Figur im Dressurreiten, bei der das Pferd einen engen Kreis läuft"
                                        ],
                                        "tags": [
                                            "Reiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5dfaa1c-5c74-4035-a503-d73dd89a2897",
                                                "sense_id": "349b280e-5652-3c29-8563-893edf2299ac",
                                                "text": "„Die Volte oder der Cirkel ist eine fortgesetzte Wendung auf die eine oder die andere Hand, und die Führung und Hülfen hierbei snd ganz dem einer Wendung analog, die hier, vorzüglich in einer weiten Volte, nur sehr gemäßigt geschieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84df3a06-882c-3abf-a693-8b0eb908e41b",
                                        "entry_id": "309925fc-3c6e-3bfa-b540-bd6a93baf92b",
                                        "glosses": [
                                            "ausweichende Bewegung vom Gegner weg"
                                        ],
                                        "tags": [
                                            "Fechten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb04bc92-849e-43ba-91d6-6e9ae153e9b4",
                                                "sense_id": "84df3a06-882c-3abf-a693-8b0eb908e41b",
                                                "text": "„Voltieren und Vorschreiten kann im Contrafechten oft auf die glückliche Weise mit einander verbunden werden und zwar dann, wenn der Gegner durch die Volte eine längere Mensur zu gewinnen sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f28f97f-ca18-3f1a-8c4f-893147ac1872",
                                        "entry_id": "309925fc-3c6e-3bfa-b540-bd6a93baf92b",
                                        "glosses": [
                                            "das vom Publikum unbemerkte Abheben eines Kartenstapels"
                                        ],
                                        "tags": [
                                            "Zauberkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c38cd3-2bd4-4c1c-80cf-aff822c7a360",
                                                "sense_id": "2f28f97f-ca18-3f1a-8c4f-893147ac1872",
                                                "text": "„Die Volte ist wohl der wichtigste, aber auch einer der schwierigsten Handgriffe des Kartenkünstlers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f7909acd-62ea-35b5-9f47-3a42bbd0cb1b",
                                        "entry_id": "309925fc-3c6e-3bfa-b540-bd6a93baf92b",
                                        "glosses": [
                                            "kreisförmiger, in Abschnitte eingeteilter Landeanflug mit Gleitschirmen oder Hängegleitern"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29aa4aa3-e930-4851-b3de-63c749bcf4a2",
                                                "sense_id": "f7909acd-62ea-35b5-9f47-3a42bbd0cb1b",
                                                "text": "„Bei starkem Wind ist das Wichtigste sich nicht ins Lee abdrängen zu lassen. Hinter einem Hindernis ist es mindestens bis zu einer Strecke, die das 10fache der Hindernishöhe beträgt, noch turbulent! Um den richtigen Platz auszusuchen muss man frühzeitig mit der Planung beginnen. Es wird keine klassische Volte geflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                        "entry_id": "309925fc-3c6e-3bfa-b540-bd6a93baf92b",
                                        "glosses": [
                                            "geschickte Handlung oder Wende, mit der ein bestimmtes Ziel erreicht werden soll"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c48455e-6a3f-4c56-9cb3-e0e8ecee7dec",
                                                "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                                "text": "„Die Verhandlungen über einen deutschen Friedensvertrag, die im letzten Jahre stattfanden, die ständigen Volten, Finten und Tricks, die dabei von sowjetrussischer Seite angewandt worden sind, lassen jedenfalls nicht erwarten, daß globale Verhandlungen schneller zu einem Resultat kommen werden.“"
                                            },
                                            {
                                                "example_id": "4e05fbef-11aa-4abd-91ee-5e14b7983560",
                                                "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                                "text": "„Schon bald wird sich zeigen, ob nicht Chruschtschows Roosevelt-Telegramm nur eine Volte war, mit der Sowjetrußlands Ministerpräsident neue und weniger von U-2-Affären belastete Verhandlungen einleiten will.“"
                                            },
                                            {
                                                "example_id": "466be996-0682-4c98-92e6-3f4169a6cad4",
                                                "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                                "text": "„Auch die Präsidenten in Mittelasien, zuvor allesamt in Personalunion Parteichefs, haben nach der niedergeschlagenen Kreml-Verschwörung eine atemberaubende persönliche Volte vollzogen, die KP verboten, deren Ideologie annulliert, ihren Besitz verstaatlicht und statt dessen die Symbole wie die Forderungen ihrer jeweiligen Nationalbewegungen übernommen.“"
                                            },
                                            {
                                                "example_id": "56fa126e-1d1a-4197-b8af-2d6f8dabcfcb",
                                                "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                                "text": "„Auch wenn Gratschow nach einer überaschenden Volte plötzlich ‚ohne Bedingungen‘ die ‚Partnerschaft für den Frieden‘ akzeptiert, möchte Moskau ‚gleicher‘ sein als die Osteuropäer, und dahinter verbirgt sich der alte Anspruch auf eine verbriefte Großmachtsrolle.“"
                                            },
                                            {
                                                "example_id": "75340e4f-4bab-4b37-b955-971957f05c1f",
                                                "sense_id": "090d90a5-8998-302a-bf18-2a501c19a6fa",
                                                "text": "„Und dort wächst die Angst vor neuen Volten aus Washington.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
