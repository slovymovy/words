                },
                {
                    "sense_id": "f3e211b7-8b2a-3fc7-8126-92f5c91a7f44",
                    "sense_definition": "Группа людей, друзей или знакомых, которые проводят время вместе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера у нас собралась весёлая <компания> для празднования дня рождения.",
                            "target_lang_translations": {
                                "en": "Yesterday a cheerful <w>group</w> gathered at our place to celebrate a birthday.",
                                "zh": "昨天我们聚在一起，有一群快乐的<w>伙伴</w>为生日庆祝。"
                            }
                        },
                        {
                            "text": "Он всегда был душой <компании> и рассказывал смешные истории.",
                            "target_lang_translations": {
                                "en": "He was always the life of the <w>party</w> and told funny stories.",
                                "zh": "他总是大家聚会时的开心果，经常讲些有趣的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "группа",
                        "общество",
                        "круг"
                    ],
                    "antonyms": [
                        "одиночка"
                    ],
                    "common_phrases": [
