    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b89393e6-6a01-380f-89ae-dc5808d262c1",
                    "sense_definition": "Having the appearance of being dishonest, criminal, or unreliable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>shifty</w> character in a seedy bar, and I checked my wallet was still there after talking to him."
                        },
                        {
                            "text": "I do not trust that <w>shifty</w> salesman because he keeps avoiding my direct questions."
                        }
                    ],
                    "synonyms": [
                        "deceitful",
                        "dishonest",
                        "untrustworthy"
                    ],
                    "antonyms": [
                        "honest",
                        "trustworthy"
                    ],
                    "common_phrases": [
                        "shifty character"
                    ]
                },
                {
                    "sense_id": "e3867421-9ece-366b-950b-f13ce4028a68",
                    "sense_definition": "Moving from one object to another; not looking directly and steadily at the person with whom one is speaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dishonest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His quick, <w>shifty</w> eyes turned from the manager to the safe and then to the door."
                        },
                        {
                            "text": "The witness had <w>shifty</w> eyes and refused to look at the judge during the trial."
                        }
                    ],
                    "synonyms": [
                        "evasive"
                    ],
                    "common_phrases": [
                        "shifty eyes"
                    ]
                },
                {
                    "sense_id": "53c632a7-a109-30e7-a29d-ce25e6acbd87",
                    "sense_definition": "Subject to frequent changes in direction or position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unstable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers struggled to walk across the <w>shifty</w> sand dunes in the desert."
                        },
                        {
                            "text": "The boat struggled to stay steady on the <w>shifty</w> and unpredictable currents of the river."
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "shifting"
                    ],
                    "antonyms": [
                        "stable",
                        "steady"
                    ]
                },
                {
                    "sense_id": "5832c751-2e2f-3c4f-a9b6-1344ecf67229",
                    "sense_definition": "Resourceful; full of, or ready with, clever tricks or expedients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>shifty</w> survivor who could always find a way to solve any problem."
                        },
                        {
                            "text": "The <w>shifty</w> inventor managed to fix the broken machine using only basic household tools."
                        }
                    ],
                    "synonyms": [
                        "resourceful",
                        "clever"
                    ]
                }
            ]
        }
