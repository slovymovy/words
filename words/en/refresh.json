{
    "word_family": [
        "refresher",
        "refreshment",
        "refreshing",
        "refreshed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c7cd8a4-6c80-3df1-8a69-4050c36bca01",
                    "sense_definition": "To make someone or something feel full of energy or new again.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "revitalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick nap in the afternoon always helps to <w>refresh</w> my mind for the evening.",
                            "target_lang_translations": {
                                "ru": "Короткий дневной сон всегда помогает <w>освежить</w> мысли перед вечером."
                            }
                        },
                        {
                            "text": "The cool water will <w>refresh</w> your skin after a long day in the hot sun.",
                            "target_lang_translations": {
                                "ru": "Прохладная вода <w>освежит</w> вашу кожу после долгого дня на жарком солнце."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejuvenate",
                        "revitalize",
                        "renew"
                    ],
                    "antonyms": [
                        "tire",
                        "weary",
                        "exhaust"
                    ],
                    "common_phrases": [
                        "refresh your mind",
                        "refresh your memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придать кому-либо или чему-либо сил, энергии или вернуть ощущение новизны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освежать",
                                "target_lang_sense_clarification": "укреплять силы, устранять чувство утомления"
                            },
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "восстанавливать прежнюю силу или вид"
                            },
                            {
                                "target_lang_word": "взбодрить",
                                "target_lang_sense_clarification": "придать бодрости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6957288-360b-3fe4-9189-f75161aabd5c",
                    "sense_definition": "To reload a computer screen or webpage to show the most recent information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the video does not start playing, please try to <w>refresh</w> the page.",
                            "target_lang_translations": {
                                "ru": "Если видео не начинает воспроизводиться, попробуйте <w>обновить</w> страницу."
                            }
                        },
                        {
                            "text": "You should <w>refresh</w> your browser to see the latest updates on the news site.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>обновить</w> браузер, чтобы увидеть последние новости на сайте."
                            }
                        }
                    ],
                    "synonyms": [
                        "reload",
                        "update"
                    ],
                    "common_phrases": [
                        "refresh the page",
                        "refresh your browser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перезагрузить экран компьютера или веб-страницу для отображения самой актуальной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "перезагружать страницу или документ"
                            },
                            {
                                "target_lang_word": "перезагружать",
                                "target_lang_sense_clarification": "повторно загружать данные"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4fd3b53-668b-3d2b-912d-f835ef38c80b",
                    "sense_definition": "To have some food or drink in order to regain energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revitalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers stopped at a small roadside inn to <w>refresh</w> themselves with some cold ale.",
                            "target_lang_translations": {
                                "ru": "Путешественники остановились в небольшом придорожном трактире, чтобы <w>подкрепиться</w> холодным элем."
                            }
                        },
                        {
                            "text": "After the long hike, we needed to <w>refresh</w> with a light snack and some water.",
                            "target_lang_translations": {
                                "ru": "После долгого похода нам нужно было <w>подкрепиться</w> легким перекусом и водой."
                            }
                        }
                    ],
                    "synonyms": [
                        "replenish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перекусить или выпить что-нибудь, чтобы восстановить силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкрепиться",
                                "target_lang_sense_clarification": "поесть для восстановления сил"
                            },
                            {
                                "target_lang_word": "освежиться",
                                "target_lang_sense_clarification": "выпить прохладительный напиток или умыться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdca9024-963e-3c1f-aa6c-b51721de1e7d",
                    "sense_definition": "To perform the periodic energizing required to maintain computer memory or display luminance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system must <w>refresh</w> the dynamic RAM at regular intervals to prevent data loss.",
                            "target_lang_translations": {
                                "ru": "Система должна <w>обновлять</w> динамическую оперативную память через регулярные интервалы, чтобы предотвратить потерю данных."
                            }
                        },
                        {
                            "text": "The hardware is designed to <w>refresh</w> the display pixels many times per second.",
                            "target_lang_translations": {
                                "ru": "Оборудование спроектировано так, чтобы <w>обновлять</w> пиксели дисплея много раз в секунду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять периодическую подачу энергии, необходимую для поддержания памяти компьютера или яркости дисплея."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регенерировать",
                                "target_lang_sense_clarification": "поддерживать заряд в динамической памяти"
                            },
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "технический процесс перезаписи данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30d51c3a-42b1-3acc-bf59-0f2efc5fd3c9",
                    "sense_definition": "An instance of updating a display or webpage to show the latest data.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A simple <w>refresh</w> of the browser window fixed the loading error.",
                            "target_lang_translations": {
                                "ru": "Простое <w>обновление</w> окна браузера исправило ошибку загрузки."
                            }
                        },
                        {
                            "text": "The app requires a manual <w>refresh</w> to display the new messages.",
                            "target_lang_translations": {
                                "ru": "Приложение требует ручного <w>обновления</w> для отображения новых сообщений."
                            }
                        }
                    ],
                    "synonyms": [
                        "update",
                        "reload"
                    ],
                    "common_phrases": [
                        "page refresh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай обновления дисплея или веб-страницы для отображения последних данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "действие по обновлению страницы"
                            },
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "повторная загрузка контента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06c0c792-df3a-3b62-852a-a2a1f63d7730",
                    "sense_definition": "The act or process of modernizing or improving the appearance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revitalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's brand identity needed a <w>refresh</w> to appeal to younger customers.",
                            "target_lang_translations": {
                                "ru": "Фирменному стилю компании требовалось <w>обновление</w>, чтобы привлечь более молодых клиентов."
                            }
                        },
                        {
                            "text": "We decided that the living room needed a quick <w>refresh</w> with some new paint.",
                            "target_lang_translations": {
                                "ru": "Мы решили, что гостиной не помешало бы быстрое <w>обновление</w> с помощью новой краски."
                            }
                        }
                    ],
                    "synonyms": [
                        "makeover",
                        "renovation",
                        "update"
                    ],
                    "common_phrases": [
                        "brand refresh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс модернизации или улучшения внешнего вида чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "улучшение внешнего вида или бренда"
                            },
                            {
                                "target_lang_word": "освежение",
                                "target_lang_sense_clarification": "придание более свежего вида"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecbc301e-f733-3f6c-83da-94473511960f",
                    "sense_definition": "The periodic energizing needed to maintain computer memory or screen brightness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monitor has a high <w>refresh</w> rate which makes the motion look very smooth.",
                            "target_lang_translations": {
                                "ru": "У монитора высокая частота <w>обновления</w>, что делает движения очень плавными."
                            }
                        },
                        {
                            "text": "Data integrity depends on the constant <w>refresh</w> of the memory cells.",
                            "target_lang_translations": {
                                "ru": "Целостность данных зависит от постоянного <w>обновления</w> ячеек памяти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refresh rate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Периодическая подача энергии, необходимая для поддержания памяти компьютера или яркости экрана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "технический параметр частоты экрана"
                            },
                            {
                                "target_lang_word": "регенерация",
                                "target_lang_sense_clarification": "поддержание состояния ячеек памяти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}