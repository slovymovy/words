                        "examples": [
                            {
                                "example_id": "c845e640-71d0-4e4d-a178-9ee80de37ccb",
                                "sense_id": "63d77167-ec11-32dc-ac0d-22ee821dad2f",
                                "text": "De dappere soldaten vochten op het slagveld voor hun land.",
                                "translation": "The brave soldiers fought on the battlefield for their country.",
                                "english": "The brave soldiers fought on the battlefield for their country."
                            },
                            {
                                "example_id": "b6039a8f-4968-4c4f-80cc-a9342a78fc81",
                                "sense_id": "63d77167-ec11-32dc-ac0d-22ee821dad2f",
                                "text": "Na de veldslag lag het slagveld bezaaid met gesneuvelde soldaten.",
                                "translation": "After the battle, the battlefield was littered with fallen soldiers.",
                                "english": "After the battle, the battlefield was littered with fallen soldiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "30060027-5acc-31f3-95ff-aa93799c15bd",
                        "entry_id": "1156dd53-d193-38c2-8936-9b1c05354a1d",
