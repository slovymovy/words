                        "examples": [
                            {
                                "example_id": "ee9b200b-bfd4-4f6b-a1bd-101cbedd810e",
                                "sense_id": "bcbaaf49-8d69-39d6-979f-6c1ba26c029c",
                                "text": "Теперь осталося оженить Ипполитушку, и мое дело кончено, ― говорила она сама с собой."
                            },
                            {
                                "example_id": "146884d1-481d-4900-83bf-0c37520132f9",
                                "sense_id": "bcbaaf49-8d69-39d6-979f-6c1ba26c029c",
                                "text": "Младшего брата давно оженили, ― говорила Варвара, ― а ты всё без пары, словно петух на базаре."
                            }
                        ]
                    }
