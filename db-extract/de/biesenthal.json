                ],
                "senses": [
                    {
                        "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                        "entry_id": "18839d68-8f75-3836-8d31-afbf7369ca49",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2e4f92-2311-4a1a-adc3-6178011825a3",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Frau Biesenthal ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7a277038-307a-4192-99f5-e7331450c20e",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Herr Biesenthal wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4a224b24-ff02-44b1-bff8-ccf3027880f8",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Die Biesenthals fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4d000292-9bc0-47bc-b207-1ccd17f9eec2",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Der Biesenthal trägt nie die Schals, die die Biesenthal ihm strickt."
                            },
                            {
                                "example_id": "25ccfc69-b979-432b-b479-260dcd809f94",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Biesenthal kommt, geht der Herr Biesenthal.“"
                            },
                            {
                                "example_id": "b1eb375a-ae6b-49e4-a531-b10b39f61775",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Biesenthal kommt und geht."
                            },
                            {
                                "example_id": "f0d0c062-8a95-43b7-9032-894dfe5b9337",
                                "sense_id": "a95e018f-2f44-381f-a30e-8a4ff8432d8f",
                                "text": "Biesenthals kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
