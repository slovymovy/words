                "senses": [
                    {
                        "sense_id": "a5e84b3c-e359-3214-a54e-9516a8ca5eac",
                        "entry_id": "9c081186-b699-37f0-a949-4e75cd2abe04",
                        "glosses": [
                            "leitende, führende Person oder Personengruppe einer Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40fe23f-f166-46c0-9347-8953f22f1dd7",
                                "sense_id": "a5e84b3c-e359-3214-a54e-9516a8ca5eac",
                                "text": "„Er wuchs enorm schnell in seinem Glauben an Gott und übernahm immer mehr Verantwortung in der Leiterschaft.“"
                            },
                            {
                                "example_id": "ec4b1ff0-5b39-453d-b6a5-a4f580d1df15",
                                "sense_id": "a5e84b3c-e359-3214-a54e-9516a8ca5eac",
                                "text": "„Ihre bewundernswerte, authentische und jahrelange Beziehung zu Jesus sowie ihre treue Leiterschaft im ICF bewegen seit über 25 Jahren viele Menschen.“"
                            },
                            {
                                "example_id": "7e905257-4d11-4679-847b-5fbb67fc0efa",
                                "sense_id": "a5e84b3c-e359-3214-a54e-9516a8ca5eac",
                                "text": "„Aber Nehemia enthält bedeutende Lektionen über eine göttliche Leiterschaft.“"
                            },
                            {
                                "example_id": "83948801-257e-4d45-aea5-083a721e5f02",
                                "sense_id": "a5e84b3c-e359-3214-a54e-9516a8ca5eac",
                                "text": "„Wir sollen uns von solchen Lehren und Leiterschaften zurückziehen, die nicht konform mit dem Wort Gottes gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
