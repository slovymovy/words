    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c8002d9b-c58a-328f-92d2-1b22b19a86fd",
                "word": "woodshed",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cd1a5ddf-15e0-4df3-b50f-d74187da227c",
                        "entry_id": "c8002d9b-c58a-328f-92d2-1b22b19a86fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "woodsheds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cdd96b01-15e3-3937-a1e6-3c21e3afe435",
                        "entry_id": "c8002d9b-c58a-328f-92d2-1b22b19a86fd",
                        "glosses": [
                            "An enclosed, roofed structure, often an outbuilding, used primarily to store firewood."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9443ef01-d919-370c-b841-22c672df90f6",
                        "entry_id": "c8002d9b-c58a-328f-92d2-1b22b19a86fd",
                        "glosses": [
                            "A place where punishments or reprimands are administered."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1f7ec218-2b26-4d59-bfd8-4931339e9abb",
                                "sense_id": "9443ef01-d919-370c-b841-22c672df90f6",
                                "text": "The State Department is incensed, and if this conference fails it will be the woodshed for three Central American presidents."
                            },
                            {
                                "example_id": "29a5aa43-e08f-4cf3-bc7c-85d8667abcc4",
                                "sense_id": "9443ef01-d919-370c-b841-22c672df90f6",
                                "text": "Were you ever taken to the woodshed? Did anyone say, “Stop disagreeing with the president”?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b3f5ab4-5e2d-4d0b-86b9-e7b0ff760c12",
                        "source_entry_id": "c8002d9b-c58a-328f-92d2-1b22b19a86fd",
                        "source_sense_description": "enclosed structure for storing firewood",
                        "target_lang_word": "bûcher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bûcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6e54bf-2ca8-3b58-b2bd-d8033c2a2b9f",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Tas de bois que l’on brûle pour se chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3447f19a-e71f-488e-a7de-884d6f7f85a6",
                                                "sense_id": "fb6e54bf-2ca8-3b58-b2bd-d8033c2a2b9f",
                                                "text": "De là, le tortueux sarment gagnait le mur, s’y attachait, courait le long de la maison et finissait sur un bûcher où le bois était rangé avec autant d’exactitude que peuvent l’être les livres d’un bibliophile."
                                            },
                                            {
                                                "example_id": "0576ad55-5b33-4ee6-8b20-bcc00ab4b5de",
                                                "sense_id": "fb6e54bf-2ca8-3b58-b2bd-d8033c2a2b9f",
                                                "text": "Il pleuvait fin et il faisait froid. Nous brûlions des pins entiers en de grands bûchers, autour desquels chacun épluchait son linge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a7d490-bc54-34ea-b89f-fd7f377483e5",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Lieu où l’on range le bois à brûler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de37a64f-e92c-4408-b56c-153f48e6fb62",
                                                "sense_id": "b9a7d490-bc54-34ea-b89f-fd7f377483e5",
                                                "text": "Un bûcher, une remise, une écurie attenaient à la cuisine et faisaient un retour d’équerre."
                                            },
                                            {
                                                "example_id": "2d3ac30f-e011-42cd-9a20-5ce12e87d83d",
                                                "sense_id": "b9a7d490-bc54-34ea-b89f-fd7f377483e5",
                                                "text": "Celui-ci, serré de près, se réfugia dans la niche du bûcher, la tête du taureau l’y suivit et le cloua sans doute contre la muraille, car j’entendis un hurlement terrible, suivi d’un craquement d’os, et presque aussitôt un ruisseau de sang serpenta sur le pavé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd17f360-096c-3782-8fea-0ed4a5df99b0",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Amas de bois sur lequel on mettait anciennement les cadavres pour les brûler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8bc4688-b3d3-43df-b5fe-4d092bf4df21",
                                                "sense_id": "cd17f360-096c-3782-8fea-0ed4a5df99b0",
                                                "text": "Mais avant de mettre le feu au bûcher, ou avait grand soin de déposer dessus, avec le corps du mort, un compte exact de ses affaires, afin qu’il pût s’en servir dans l’autre vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89bdc61e-1db9-3b2c-ab11-3c30e322ab98",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Amas de bois sur lequel on plaçait ceux qui avaient été condamnés au supplice du feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c9cf7b-8faf-4856-9199-e1097691e12e",
                                                "sense_id": "89bdc61e-1db9-3b2c-ab11-3c30e322ab98",
                                                "text": "Aucune classe d’hommes n’alimenta de plus de victimes les bûchers du moyen âge. Les Vaudois d’Arras eurent leurs martyrs, comme ceux de Lyon."
                                            },
                                            {
                                                "example_id": "afe2cac7-74c7-40e0-8fbe-db8068c2e38f",
                                                "sense_id": "89bdc61e-1db9-3b2c-ab11-3c30e322ab98",
                                                "text": "L’Église romaine des bûchers, des massacres pieux, des guerres de religion, ose nous demander la liberté, que son Syllabus aujourd’hui nous refuse encore."
                                            },
                                            {
                                                "example_id": "0a5fd9b6-f4f2-4c72-94b5-0be4fecbf928",
                                                "sense_id": "89bdc61e-1db9-3b2c-ab11-3c30e322ab98",
                                                "text": "Le jour de l’exécution arrivé, l’on conduisit la vieille Barbara, au milieu d’une foule immense, à la place du Marché, et on la fit monter sur le bûcher dressé à cet effet."
                                            },
                                            {
                                                "example_id": "407cac42-07d1-4e38-a85b-6ebe9ee79d60",
                                                "sense_id": "89bdc61e-1db9-3b2c-ab11-3c30e322ab98",
                                                "text": "Les malheurs vulgaires émouvaient peu cette âme qui voulait éteindre les bûchers de ces martyrs souvent ignorés de leur vivant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c12eedd2-6bfd-38ea-816b-cb057afe23a5",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Amas de bois pour faire un feu de joie."
                                        ],
                                        "tags": [
                                            "Parfois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdefa3e3-2c93-4187-b2fd-dfd1104d482d",
                                                "sense_id": "c12eedd2-6bfd-38ea-816b-cb057afe23a5",
                                                "text": "Le soir, on dressait dans la ville et sur les rives de la Moselle des bures, sortes de bûchers dont le bois avait été recueilli de maison en maison par les jeunes gens de la ville. Le soir où on les flambait, chaque bure était transformée en « autel de l’Hyménée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a32e506-8e71-3203-9be2-2bf21d850f10",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Les flammes de l’Enfer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1b4246-e8d1-497c-8c4d-c7e7530f4998",
                                                "sense_id": "2a32e506-8e71-3203-9be2-2bf21d850f10",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5640181b-0215-3087-b43f-eea60f018b9a",
                                        "entry_id": "76e54cf0-973e-31ac-a714-b9ff95302903",
                                        "glosses": [
                                            "Surface de forêt ayant été bûchée."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bûcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f8a720-aded-325d-93a7-a8f0f707e0df",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Travailler à faire des bûches. Dégrossir à coups de hache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80945a3a-e86e-45b8-adfd-2eef3716acc2",
                                                "sense_id": "a6f8a720-aded-325d-93a7-a8f0f707e0df",
                                                "text": "Esdras et Légaré prirent leur hache et bûchèrent pendant trois jours ; puis les troncs furent mis en tas, pour attendre qu’une nouvelle chute de neige permît de les charger sur le grand traîneau à bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1049576b-73b6-31c9-b91f-393f44f7f32b",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Battre, rosser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd2c224-0cac-4e2a-b9ff-5f3dcb505ce6",
                                                "sense_id": "1049576b-73b6-31c9-b91f-393f44f7f32b",
                                                "text": "Il s’est fait bûcher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4d9b4e-1418-3898-841e-98950265f07c",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Enlever à un bloc ou une surface de pierre ce qui fait saillie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9450df71-14ea-470c-869f-a8fcba9bd3e9",
                                                "sense_id": "4c4d9b4e-1418-3898-841e-98950265f07c",
                                                "text": "Il fut arrêté, sous la Terreur, pour n’avoir pas fait bûcher ses armoiries au fronton de son château."
                                            },
                                            {
                                                "example_id": "b1985049-b305-4db4-bd28-39fc33ae91c4",
                                                "sense_id": "4c4d9b4e-1418-3898-841e-98950265f07c",
                                                "text": "Sculptures bûchées à la Révolution, à grands coups de marteau, pioche ou d’herminette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da20bf96-40f7-30e0-9067-e179a5e8dcfb",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Détruire une pièce qu’on veut remplacer par une meilleure."
                                        ],
                                        "tags": [
                                            "Charpenterie de marine"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03c52116-ccb4-39ed-8101-d20052a5ac22",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Réduire l'épaisseur d'une pièce de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa534cc-2c68-4a7d-b226-f51dac88b673",
                                                "sense_id": "03c52116-ccb4-39ed-8101-d20052a5ac22",
                                                "text": "Mais, monsieur, M. le comte votre prédécesseur, dans l’intérêt du pouvoir, il bûchait son fauteuil avec son canif pour faire croire qu’il travaillait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3396f4ac-f8e4-3248-b916-3c4d68154f88",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "ou Travailler dur, avec acharnement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cdb4f62-cfd8-4aea-be1f-ce497388cb54",
                                                "sense_id": "3396f4ac-f8e4-3248-b916-3c4d68154f88",
                                                "text": "Je suis bien malheureux, mais j’ai toujours à cœur le reproche sanglant de mon père, et je me dis que je dois expier ma faute, en courbant la tête sous les coups et en bûchant pour que sa situation universitaire déjà compromise ne souffre pas encore de ma paresse !"
                                            },
                                            {
                                                "example_id": "7575d230-504d-4dff-b710-ca70d0199adb",
                                                "sense_id": "3396f4ac-f8e4-3248-b916-3c4d68154f88",
                                                "text": "Pourquoi ne ferions nous pas bûcher davantage nos citoyens afin de pouvoir dorloter nos citoyennes ? Cela serait profondément naturel et juste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff075b80-0eb6-3751-a739-a4cd9f917b54",
                                        "entry_id": "91360edb-1517-314f-a56d-7213f59a81ec",
                                        "glosses": [
                                            "Se battre."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd008afc-483d-400c-a589-a6281dae03fe",
                                                "sense_id": "ff075b80-0eb6-3751-a739-a4cd9f917b54",
                                                "text": "On se bûchera ! fit observer Soudry, c’est selon. Si le préfet et le général, qui sont ses amis envoient un escadron de cavalerie, les paysans ne bûcheront rien… On peut à la rigueur avoir raison des gendarmes de Soulanges ; mais essayez donc de résister à une charge de cavalerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dfdec25-182d-4e57-90d8-49704eac1f82",
