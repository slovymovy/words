                        "glosses": [
                            "der Vorgang, wenn sich eine Insektenlarve entpuppt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c354fc1-f28c-4bf1-a6d6-9008a1fedd6c",
                                "sense_id": "1c6e99a3-0023-3b3b-8edc-7deff23f4ffd",
                                "text": "Für die Raupe fängt mit der Entpuppung zum Schmetterling das Leben erst richtig an."
                            },
                            {
                                "example_id": "c036ca85-b5d7-4f92-a4e7-f696205e7599",
                                "sense_id": "1c6e99a3-0023-3b3b-8edc-7deff23f4ffd",
                                "text": "„Denn Raupen sind Meister der Tarnung. Auf Blättern werden sie giftgrün und auf Rinden dezent braun. Wunderschön anzusehen ist ihre Entpuppung oder der Hochzeitsflug zweier Schmetterlinge.“"
                            }
                        ],
