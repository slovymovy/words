        "fr-extract.jsonl": [
            {
                "entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                "word": "colonnette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9709a2ca-d25b-4032-b469-fa27f65990cc",
                        "entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "colonnettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                        "entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                        "glosses": [
                            "Petite colonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7eec09e-7c62-4b0f-9530-63d753c6413e",
                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                "text": "Parvenu sur la galerie des colonnettes, il souffla un moment, et jura contre l’interminable escalier par je ne sais combien de millions de charretées de diables."
                            },
                            {
                                "example_id": "154ee4ad-40a7-462a-9fc3-a574dcce394d",
                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                "text": "La salle des Ambassadeurs, dont les magnifiques portes subsistent dans toute leur intégrité, est peut-être plus belle et plus riche que celle de Grenade ; malheureusement l’on a eu l’idée de profiter de l’intervalle des colonnettes qui soutiennent le plafond pour y loger une suite de portraits des rois d’Espagne depuis les temps les plus reculés de la monarchie jusqu’à nos jours."
                            },
                            {
                                "example_id": "f2f062a4-ba2c-41d9-92cd-36abe65b5202",
                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                "text": "À droite, le mur peu élevé qui fermait la cour portait scellés des débris précieux de frises, des fûts rompus de colonnettes."
                            },
                            {
                                "example_id": "3bb7bb87-7a2f-4289-9bc1-6d45c6a3aba4",
                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                "text": "Et c'était là, dans une petite maison blanche à terrasse et à colonnettes, qu'ils l'avaient laissée deux mois après, …."
                            },
                            {
                                "example_id": "b888fc49-d89f-46f9-bdfa-20f3d387ab44",
                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                "text": "À l'intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e5a6e18-1e7f-4d5c-a3e3-0324cf4143cb",
                        "source_entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                        "source_sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                        "target_lang_word": "kleine Säule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4816f7ee-a11a-4866-b64b-cc54e12f1bd2",
                        "source_entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                        "source_sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                        "target_lang_word": "Säulchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d7c41949-9570-4140-8b90-670519c34055",
                        "source_entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                        "source_sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                        "target_lang_word": "Dienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "das Arbeitsverhältnis, die regelmäßige bezahlte Arbeit, die Amtspflichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1198544-a77c-4908-9774-a1a6faec5fbf",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "Sein Dienst geht von acht bis siebzehn Uhr."
                                            },
                                            {
                                                "example_id": "895fbaea-f4f8-4f00-bd3d-04c7350a10f9",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„An diesem Gründonnerstag hatte er noch Dienst, danach begannen seine Osterferien.“"
                                            },
                                            {
                                                "example_id": "6cc9be34-cf49-45ae-9e6c-fb980ee8bb67",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Mit anderen Fahndern wurde er vor vier Jahren aus dem Dienst geworfen - nachdem er intern gegen einen zu laxen Umgang mit Steuersünden protestiert hatte.“"
                                            },
                                            {
                                                "example_id": "24aebdb4-8116-40f4-a934-c26b4bd61805",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Denn je weiter die Digitalisierung voranschreitet, desto weniger wird die Wirtschaft auf die Dienste von Mittelsmännern angewiesen sein.“"
                                            },
                                            {
                                                "example_id": "be039f03-dc83-4958-8fe1-c6d756bd2274",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Ein Lohndiener erschien denn auch, um ihr seine Dienste zur Verfügung zu stellen, und um die sechste Stunde hielt eine mittelelegante Mietchaise vor dem Gasthause, da sich das von Berlin her benutzte Gefährt, nach seiner halbtägigen Anstrengung im Sommersand, als durchaus ruhebedürftig herausgestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08210a3e-70bf-3f94-b7e8-9f1979528939",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "das Dienen, für etwas Gutes, für die Allgemeinheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbcd7a1-be86-41b8-9c26-d6de81e77785",
                                                "sense_id": "08210a3e-70bf-3f94-b7e8-9f1979528939",
                                                "text": "Mit ihrer Hilfe im Altersheim, leistete sie Dienst am Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "abceda7e-6b7a-3037-901d-b7d07d2d0cce",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "der Betrieb, das Funktionieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d352269-dc37-4b6e-9242-f16f815cde6f",
                                                "sense_id": "abceda7e-6b7a-3037-901d-b7d07d2d0cce",
                                                "text": "Heute wurde ein neues Flugzeug in Dienst gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "die Hilfe, der Beistand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52547e4a-0243-48ad-a4cf-6d666f9583ac",
                                                "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                                "text": "Obwohl das Fahrrad schon 20 Jahre alt ist, leistet es immer noch gute Dienste."
                                            },
                                            {
                                                "example_id": "03d1cd98-1dd5-4659-b492-8c67576a3c5d",
                                                "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                                "text": "„Als ich noch in England mein Bike vorbereitete, hatte ich die Dienste von David Lambeth in Anspruch genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a9ca2ece-a9b3-346a-bffd-129e30324411",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "eine Organisation, Behörde oder ein Unternehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aefbc77-ab7b-4676-a32c-11d816ec6a4a",
                                                "sense_id": "a9ca2ece-a9b3-346a-bffd-129e30324411",
                                                "text": "Da muss man am besten so einen Dienst anrufen, jemanden, der Schlüssel nachmachen kann oder Türen aufbrechen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b7ce1dee-d57b-3756-bbf1-a9953959baba",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "eine Gruppe von Personen, die für dieselbe Sache tätig sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7446a0ed-83c5-45d9-9508-16e1779bb7d1",
                                                "sense_id": "b7ce1dee-d57b-3756-bbf1-a9953959baba",
                                                "text": "Bei uns im Dienst wechseln wir uns mit der Schichten an Feiertagen ab."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "76688b96-87b3-31ef-859c-6327ec1fac52",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "dünne Säule eines Bündel- oder Wandpfeilers"
                                        ],
                                        "tags": [
                                            "Baukunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30460787-2346-4676-ac35-d308e6aa73cb",
                                                "sense_id": "76688b96-87b3-31ef-859c-6327ec1fac52",
                                                "text": "Einen dicht von Diensten umstandenen Pfeiler nennt man auch einen Bündelpfeiler."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "Programm, das ohne Benutzeroberfläche läuft"
                                        ],
                                        "tags": [
                                            "Computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25abbf08-51af-4b2e-a7b0-a3257aa87ae8",
                                                "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                                "text": "Natürlich bekommst du keine Verbindung, da der Dienst des Servers auf dem Host-Rechner nicht gestartet ist."
                                            },
                                            {
                                                "example_id": "0f59dac0-6467-46dd-8843-e114113f6d99",
                                                "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                                "text": "„Debian-Entwickler planen eine soziale Plattform, die mehrere Dienste zur besseren Vernetzung der Debian-Gemeinschaft unterhalten will. Erste Dienste sollen noch 2020 zugänglich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
