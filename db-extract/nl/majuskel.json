                "senses": [
                    {
                        "sense_id": "2e58e78f-7174-32e9-aac9-36250ad27b94",
                        "entry_id": "05d95f97-be45-3747-b728-bfc75d640388",
                        "glosses": [
                            "letter met een rechtopstaande vorm zonder stokken die naar boven of staarten die naar onder uitsteken\\nOorspronkelijk een van de schriftsoorten waarin handschriften konden worden geschreven, tegenwoordig vooral gebruikt als hoofdletter aan het begin van namen of zinnen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32342dce-98f9-4533-9460-9ae5781da258",
                                "sense_id": "2e58e78f-7174-32e9-aac9-36250ad27b94",
                                "text": "⧖De boven-opschriften schynen ouder te zyn dan de beneden-opschriften, vooral op grond van de daerin voorkomende grieksche majuskel C, die althans aen berigtgever dezes in middeleeuwsche latynsche opschriften nog niet na de XIVe eeuw voorgekomen is."
                            },
                            {
                                "example_id": "dfe748c3-bbf2-4a12-981d-b182c4ae62ba",
                                "sense_id": "2e58e78f-7174-32e9-aac9-36250ad27b94",
                                "text": "Een minuskel werd één keer - en wel bij een plaatsaanduiding - een majuskel: de dam (vs. 135) - de Dam."
                            },
                            {
                                "example_id": "768dc6ff-7b49-43f6-83fb-5907eabf7e57",
                                "sense_id": "2e58e78f-7174-32e9-aac9-36250ad27b94",
                                "text": "Duidelijk is in ieder geval dat dit Grieks een Aramees koloriet heeft, terwijl tevens vast staat dat dit bijzonder kleine werkje (de pagina's hebben een omvang van 3,5 bij 4,5 cm, met daarop meestal 23 regels in Griekse majuskels!) een meesterstuk is van de hoogontwikkelde manichese schrijf- en boekkunst."
                            }
                        ]
                    }
