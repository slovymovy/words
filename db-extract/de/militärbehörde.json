                ],
                "senses": [
                    {
                        "sense_id": "40a3b1c8-ade7-3520-8986-7619515c8947",
                        "entry_id": "6110b8ab-f967-36d7-bc72-64baf2335c7f",
                        "glosses": [
                            "Behörde in Verantwortung des Militärs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346c6128-da7c-40c2-820a-2a7384dd5851",
                                "sense_id": "40a3b1c8-ade7-3520-8986-7619515c8947",
                                "text": "„Die Verluste stiegen weiter rapide, doch auch diese Tatsache versuchten die Militärbehörden gegenüber der Öffentlichkeit zu verschleiern.“"
                            },
                            {
                                "example_id": "0ed4023f-5d32-4f91-85ed-d2d64ed9c84b",
                                "sense_id": "40a3b1c8-ade7-3520-8986-7619515c8947",
                                "text": "„Der Rest lief von einer Militärbehörde zur anderen und konnte selbst mit Geld und guten Worten nicht erreichen, daß man ihn in die Armee aufnahm.“"
                            },
                            {
                                "example_id": "4e176ce6-d51a-4814-bb77-5396be88e969",
                                "sense_id": "40a3b1c8-ade7-3520-8986-7619515c8947",
                                "text": "„Vergewaltigung blieb ihnen erspart – nicht aber die Maschinerie der russischen Militärbehörden, die nun zu mahlen begann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
