                ],
                "senses": [
                    {
                        "sense_id": "069e33d8-e84e-3787-9e3f-a9241c4921d0",
                        "entry_id": "5327c367-91bd-3a5d-b025-b0901bfbaf12",
                        "glosses": [
                            "Hostile à Adolf Hitler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7b3433-2084-46d4-a0ea-cc45ed7d7d9c",
                                "sense_id": "069e33d8-e84e-3787-9e3f-a9241c4921d0",
                                "text": "La « drôle de guerre » menée par la bourgeoisie française plus soucieuse de répression anticommuniste et de menées antisoviétiques que de lutte antihitlérienne oblitère pour le plus grand nombre le sens de la guerre."
                            },
                            {
                                "example_id": "1bcdafac-9c78-4d6b-9582-9a475729b586",
                                "sense_id": "069e33d8-e84e-3787-9e3f-a9241c4921d0",
                                "text": "Les communistes furieusement antihitlériens ont cessé de l’être pour devenir antibritanniques puis sont redevenus antihitlériens à partir de juin 1941."
                            },
                            {
                                "example_id": "0ddf5c2f-0c07-4c9e-8034-5320e38fc731",
                                "sense_id": "069e33d8-e84e-3787-9e3f-a9241c4921d0",
                                "text": "Mais tous les membres de la coalition des forces antihitlériennes du pays étaient d’accord à ce qu’une ferme riposte soit donnée à tout essai des troupes allemandes d’empêcher la Roumanie de sortir de la guerre hitlérienne."
                            }
                        ]
                    }
                ],
