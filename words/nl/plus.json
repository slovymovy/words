                                "ru": "Цена составляет сто евро <w>плюс</w> стоимость доставки."
                            }
                        },
                        {
                            "text": "Je krijgt een basissalaris <w>plus</w> een maandelijkse bonus.",
                            "target_lang_translations": {
                                "en": "You receive a base salary <w>plus</w> a monthly bonus.",
                                "ru": "Вы получаете базовую зарплату <w>плюс</w> ежемесячный бонус."
                            }
                        }
                    ],
                    "synonyms": [
                        "en"
                    ],
                    "antonyms": [
                        "minus"
                    ],
                    "common_phrases": [
                        "plus de kosten"
                    ],
                    "target_lang_definitions": {
