                        "examples": [
                            {
                                "example_id": "0515b413-4d69-4d89-ae53-0bbfc0670aac",
                                "sense_id": "4b6b3208-8fd2-3d27-bb89-071793683d56",
                                "text": "Il parlait amicalement aux vieux singes, qui, d’honneur, me parurent l’écouter avec une certaine attention."
                            },
                            {
                                "example_id": "315d9ae9-52bb-42f4-97f1-6a8432eb4a83",
                                "sense_id": "4b6b3208-8fd2-3d27-bb89-071793683d56",
                                "text": "C’est d’un rococo admirable ; bravo, bravo, d’honneur, une plaisanterie fort spirituelle !"
                            },
                            {
                                "example_id": "dc6ea666-2e51-4916-9d18-db3c60a7f083",
                                "sense_id": "4b6b3208-8fd2-3d27-bb89-071793683d56",
                                "text": "« Dites donc, père Hutfer, vous lui avez fait la leçon, pas vrai ? dirent quelques personnes en riant.\n— Non, d’honneur, répondit Hutfer ; je ne m’y attendais seulement pas."
                            },
                            {
                                "example_id": "57057eb2-b1c5-47d8-9c7c-3edd95efe8b0",
                                "sense_id": "4b6b3208-8fd2-3d27-bb89-071793683d56",
                                "text": "— Il fait bien chaud, messieurs. D’honneur, c’est intolérable !…"
                            }
                        ]
                    }
