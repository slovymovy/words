                "senses": [
                    {
                        "sense_id": "3fcc9908-e813-36ee-a945-a9ccadda122e",
                        "entry_id": "d2dc9af7-502a-3a51-82b9-a9f99063d618",
                        "glosses": [
                            "Ne plus savoir, oublier."
                        ],
                        "tags": [
                            "Non standard"
                        ],
                        "examples": [
                            {
                                "example_id": "fd71205c-3d6c-4887-afc8-b1756f4ef90c",
                                "sense_id": "3fcc9908-e813-36ee-a945-a9ccadda122e",
                                "text": "« Nous savons, dit Jakobson, mais nous ne voyons pas ». En obligeant le lecteur à décrypter pas à pas, vous l'amenez à désavoir pour voir."
                            },
                            {
                                "example_id": "72a36513-7fe3-4ce1-95e2-ce539feb0c1a",
                                "sense_id": "3fcc9908-e813-36ee-a945-a9ccadda122e",
                                "text": "Il a aidé l'autre à désavoir, à relativiser l'absolu, à désapprendre ce qu'il croyait savoir, y compris sur lui-même."
                            }
                        ]
                    }
