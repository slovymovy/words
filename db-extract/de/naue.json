                        "form": "die Naues"
                    },
                    {
                        "form_id": "d8819eb7-5a0c-4f53-b488-9d1bea9a3eab",
                        "entry_id": "d6eff9b9-0b8d-3a05-b328-ac7a6b93cc7c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Naue"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                        "entry_id": "d6eff9b9-0b8d-3a05-b328-ac7a6b93cc7c",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea95cea-2aac-4edc-9de6-f9e21e9f9ddf",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Frau Naue ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a8c6e0a0-568a-45c5-8774-1d2de906311a",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Herr Naue wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fc82b75a-a4ae-46ee-896d-a81a3c3dbddc",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Die Naues kommen heute aus London."
                            },
                            {
                                "example_id": "9b7cf331-38c7-4448-9113-12672fc3cd4c",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Der Naue trägt nie die Schals, die die Naue ihm strickt."
                            },
                            {
                                "example_id": "81c126c6-8423-446f-ae45-d625ef29de3f",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Naue kommt, geht der Herr Naue.“"
                            },
                            {
                                "example_id": "9c319a00-dc51-4268-8adb-76b27846854f",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Naue kommt und geht."
                            },
                            {
                                "example_id": "3ba78652-8a51-4cf7-9386-746504a95a22",
                                "sense_id": "c2fae07d-f99d-389c-89d1-9dcab8cf259c",
                                "text": "Naues kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
