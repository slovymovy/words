                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c4f98e-7f66-4ebf-a00d-bd88a397a8c0",
                                "sense_id": "ffc7fd11-ba0a-35ce-a27f-7a3ff9fa7153",
                                "text": "Шеф ненавидит громкие слова и очень тонко чувствует фальшь, но сейчас он сам сфальшивил и поэтому злится."
                            }
                        ]
                    },
                    {
                        "sense_id": "57cde012-443c-3050-a494-75acc93f4bad",
                        "entry_id": "91f696ef-174c-3687-9de8-17e3e001ec7a",
                        "glosses": [
                            "ошибиться в ноте при пении, игре на музыкальном инструменте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2636077-323b-400a-aa89-84ee9b52d321",
                                "sense_id": "57cde012-443c-3050-a494-75acc93f4bad",
                                "text": "Потом Саша утверждал, что отец взорвался потому, что тенор сфальшивил и вместо ля-бемоль взял си."
                            }
                        ]
                    }
