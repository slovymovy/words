                    "frequency": "VeryLow",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leek wel een <w>poos</w> te duren voordat het resultaat bekend werd gemaakt.",
