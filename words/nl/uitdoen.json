                                "target_lang_sense_clarification": "appliances or lights"
                            },
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "lights or fire"
                            },
                            {
                                "target_lang_word": "extinguish",
                                "target_lang_sense_clarification": "fire or light"
                            }
                        ]
                    }
                }
            ]
