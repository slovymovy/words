                "senses": [
                    {
                        "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                        "entry_id": "4679c34c-2342-3e2a-97ee-3f7e2b656fed",
                        "glosses": [
                            "käuflich zu erwerbende Rabattkarte der Deutschen Bahn AG, die mit einem Passbild des Kunden versehen wird und dazu berechtigt, bestimmte Fahrkarten zu einem vergünstigten Preis zu erwerben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "873b453d-c41b-4b2e-a6b9-156c5cdccf71",
                                "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                                "text": "Eugen überlegt, ob sich für ihn eine Bahncard lohnt."
                            },
                            {
                                "example_id": "f94ce209-b6d0-4655-aa6c-5b66f0d209bf",
                                "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                                "text": "Als sie ihre Fahrkarte am Automaten kaufen wollte, bemerkte Julia, dass sie ihre Bahncard nicht dabeihatte."
                            },
                            {
                                "example_id": "ec8c1aa5-071b-4467-82ef-d011a8a25de7",
                                "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                                "text": "Der Fahrkartenkontrolleur fragte den Fahrgast, ob dieser eine Bahncard habe."
                            },
                            {
                                "example_id": "813dfe07-ad44-4012-b8a6-1e84bdd1fb5b",
                                "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                                "text": "Als überzeugter Bahnfahrer hat Hermann seit Jahren die Bahncard 100."
                            },
                            {
                                "example_id": "db2bdc95-3f01-492a-babb-3e61cdb7a2a2",
                                "sense_id": "a2252961-c740-3dc0-a3c7-7886837e1107",
                                "text": "„Derzeit sind rund 3,1 Millionen Karten im Umlauf. Allein im ersten Quartal wurden 918 000 neue Bahncards verkauft, 30 Prozent mehr als in den ersten drei Monaten 2004.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
