                    {
                        "translation_id": "addf9d68-2457-4d00-94dc-6960bd2261e9",
                        "source_entry_id": "df2f71c3-9b7c-36dd-86e2-e61ec66cf0b0",
                        "source_sense_id": "213c20b3-59fb-3c8b-adeb-dfb7df0f9f1d",
                        "target_lang_word": "Thermometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a228bdd0-596a-3d78-b614-3c20ff000cf1",
                                        "entry_id": "a83feeb4-a568-305c-87ed-3db4d6976d67",
                                        "glosses": [
                                            "Gerät, mit dem man Temperaturen bestimmt"
                                        ],
                                        "tags": [
                                            "Messtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3953a1c9-5d30-4ea0-82b5-f23e730eca18",
                                                "sense_id": "a228bdd0-596a-3d78-b614-3c20ff000cf1",
                                                "text": "„Dabei ist das Klima tatsächlich nicht schlecht, und wir haben sogar in der Gemeinde ein paar Neunzigjährige. Das Thermometer […] fällt im Winter höchstens auf vier Grad, und im Hochsommer kommen wir allerhöchstens auf fünfundzwanzig bis dreißig Grad, was vierundzwanzig nach Réaumur oder vierundfünfzig Grad Fahrenheit […] ergibt, nicht mehr!“"
                                            },
                                            {
                                                "example_id": "be25c3c7-583e-4a7c-85a2-82222f643024",
                                                "sense_id": "a228bdd0-596a-3d78-b614-3c20ff000cf1",
                                                "text": "„Bis zur Tankstelle in Pelly Crossing, auf halbem Weg nach Dawson, ist das Thermometer schon auf minus 20 Grad gefallen.“"
                                            },
                                            {
                                                "example_id": "ac85cc3b-2aa0-4e51-925d-0aacc7394fe8",
                                                "sense_id": "a228bdd0-596a-3d78-b614-3c20ff000cf1",
                                                "text": "„Auch in der Wetterstation Salzburg-Freisaal wurden die 33,2 Grad vom 27. Mai übertroffen, der Thermometer zeigte 34,6 Grad.“"
                                            },
                                            {
                                                "example_id": "75ac45a7-9638-4457-a23a-6933f294a6f4",
                                                "sense_id": "a228bdd0-596a-3d78-b614-3c20ff000cf1",
                                                "text": "„Ein kurz in den weichen Boden gestecktes Thermometer zeigt bereits nach wenigen Augenblicken 45 Grad Celsius an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e9d3b1-6604-44b7-9fa1-5f55136d6656",
                        "source_entry_id": "df2f71c3-9b7c-36dd-86e2-e61ec66cf0b0",
                        "source_sense_id": "213c20b3-59fb-3c8b-adeb-dfb7df0f9f1d",
                        "target_lang_word": "термометр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "термометр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5b62d7-238f-3707-826b-7065edf356ab",
                                        "entry_id": "32190be0-3240-3a79-8603-8dd33b3c026a",
                                        "glosses": [
                                            "прибор для измерения температуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "935ac9a0-ef02-43bb-8474-5141818da08c",
                                                "sense_id": "9e5b62d7-238f-3707-826b-7065edf356ab",
                                                "text": "Время, уже настало холодное, и Делилев термометр опускался на 209° (Реомюр 3°)."
                                            },
                                            {
                                                "example_id": "156b3f7c-6ca9-4180-a62d-7e986e93913d",
                                                "sense_id": "9e5b62d7-238f-3707-826b-7065edf356ab",
                                                "text": "На всю больницу было только два скальпеля и ни одного термометра, в ваннах держали картофель."
                                            },
                                            {
                                                "example_id": "0ee65efa-48da-46cb-966d-c91e9434fe66",
                                                "sense_id": "9e5b62d7-238f-3707-826b-7065edf356ab",
                                                "text": "Хотя термометр изобрёл Галилей ещё в 1592 году, современный вид медицинский градусник приобрёл именно в 1910-м."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf7fcb9-fedb-4765-b4a3-13bc54f776be",
                        "source_entry_id": "df2f71c3-9b7c-36dd-86e2-e61ec66cf0b0",
                        "source_sense_id": "213c20b3-59fb-3c8b-adeb-dfb7df0f9f1d",
                        "target_lang_word": "градусник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "градусник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2056b8c3-e986-3cde-9119-b3135846b3ff",
                                        "entry_id": "ce874731-4ee9-3a0f-8e79-dcc7e1177157",
                                        "glosses": [
                                            "разг. то же, что термометр; прибор для измерения температуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79195336-8b8f-4128-88c0-918a7a90ca26",
                                                "sense_id": "2056b8c3-e986-3cde-9119-b3135846b3ff",
                                                "text": "― У меня сегодня утром градусник на солнце двадцать пять градусов показывал, ― сообщает дядя Григорий Павлыч."
                                            },
                                            {
                                                "example_id": "76707a30-5524-4fd5-8d5f-cfbc97e88d74",
                                                "sense_id": "2056b8c3-e986-3cde-9119-b3135846b3ff",
                                                "text": "В шесть часов больным подавали утренний чай, и они медленно пили его, а потом ставили градусник, измеряя температуру."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
