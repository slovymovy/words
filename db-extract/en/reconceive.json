                                "example_id": "812c78f0-57dd-44ab-97e7-61f6b96ccdda",
                                "sense_id": "f24c2863-b4d4-33b6-9c58-011228267f77",
                                "text": "Once a bustling thoroughfare, the section of Pennsylvania Avenue that borders the White House has been reconceived as a pedestrian strip paved in granite and protected by guard stations to keep people at a safe distance from the president."
                            }
                        ]
