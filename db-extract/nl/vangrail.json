                    {
                        "translation_id": "76af7233-baa8-4414-8afb-0b4efe5189d7",
                        "source_entry_id": "e5703484-a91b-381f-a886-c7354708098e",
                        "source_sense_id": "7a224b9a-5096-3aa6-bcb1-46f522427016",
                        "source_sense_description": "metalen stroken langs autowegen, die dient om te voorkomen dat auto's van de rijbaan raken",
                        "target_lang_word": "Leitplanke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitplanke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "495619ca-57a5-38a7-8be4-c9c70fe6bb3f",
                                        "entry_id": "ebf03489-011c-353f-a39d-c66a6deeacad",
                                        "glosses": [
                                            "Sicherheitsbegrenzung einer Straßenaußenseite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5440e7-70b7-430e-9851-00eb8b64c508",
                                                "sense_id": "495619ca-57a5-38a7-8be4-c9c70fe6bb3f",
                                                "text": "Wenn die Leitplanke meinen Wagen nicht aufgehalten hätte, wäre ich den Abgrund hinuntergestürzt."
                                            },
                                            {
                                                "example_id": "949122ac-65cc-4f44-a115-1404d88a7456",
                                                "sense_id": "495619ca-57a5-38a7-8be4-c9c70fe6bb3f",
                                                "text": "„Jenseits der linken Leitplanke endet hier Georgiens Hoheitsgebiet.“"
                                            },
                                            {
                                                "example_id": "00521ebb-d653-4bb8-8a0f-4dc0c1494244",
                                                "sense_id": "495619ca-57a5-38a7-8be4-c9c70fe6bb3f",
                                                "text": "„Als die Zugmaschine auf die Leitplanke aufschlug, nahm Paul noch wahr, wie sein Kopf auf die Konsole zuraste.“"
                                            },
                                            {
                                                "example_id": "44491f35-66e7-4577-a22e-52e9b3ed0023",
                                                "sense_id": "495619ca-57a5-38a7-8be4-c9c70fe6bb3f",
                                                "text": "„Wenn die Leute den Erdrutsch beschrieben, sprachen sie über das Rauschen der Wassermassen, die gegen das Land schlugen, über das Kreischen der Leitplanke, die zerrissen wurde und nach unten kippte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6b1dc68-9ea3-473d-b5a6-4c961b6c70da",
                        "source_entry_id": "e5703484-a91b-381f-a886-c7354708098e",
