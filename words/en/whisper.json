{
    "word_family": [
        "whisperer",
        "whispering",
        "whispery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3320db69-169a-328b-8485-40a72c1027b2",
                    "sense_definition": "To speak very softly using one's breath rather than one's vocal cords, so that only someone very close can hear.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speaking-quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>whisper</w> in class so the teacher wouldn't hear her talking to her friend.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>шептать</w> в классе, чтобы учитель не услышал, как она разговаривает с подругой."
                            }
                        },
                        {
                            "text": "Please <w>whisper</w> softly while the baby is sleeping in the next room.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>говорите шёпотом</w>, пока ребенок спит в соседней комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "breathe"
                    ],
                    "antonyms": [
                        "shout",
                        "yell",
                        "scream"
                    ],
                    "common_phrases": [
                        "whisper softly",
                        "whisper in class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить очень тихо, используя дыхание вместо голосовых связок, так что слышать может только тот, кто находится совсем рядом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шептать",
                                "target_lang_sense_clarification": "говорить очень тихо"
                            },
                            {
                                "target_lang_word": "говорить шёпотом",
                                "target_lang_sense_clarification": "использовать шёпот"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222453e5-f9f5-339c-b796-dcef941a596a",
                    "sense_definition": "To say something specific in a very quiet voice.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speaking-quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He leaned over to <w>whisper</w> sweet nothings into her ear during the movie.",
                            "target_lang_translations": {
                                "ru": "Он наклонился, чтобы <w>прошептать</w> ей на ухо нежные слова во время фильма."
                            }
                        },
                        {
                            "text": "I saw him <w>whisper</w> a secret to his brother before they both started laughing.",
                            "target_lang_translations": {
                                "ru": "Я видел, как он <w>шепнул</w> секрет своему брату, прежде чем они оба рассмеялись."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whisper sweet nothings",
                        "whisper a secret"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать что-то конкретное очень тихим голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прошептать",
                                "target_lang_sense_clarification": "произнести что-то шёпотом"
                            },
                            {
                                "target_lang_word": "шепнуть",
                                "target_lang_sense_clarification": "сказать коротко или по секрету"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                    "sense_definition": "To make a soft, rustling sound like wind moving through leaves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soft-sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>whisper</w> through the trees as the sun started to set.",
                            "target_lang_translations": {
                                "ru": "Ветер начал <w>шелестеть</w> в кронах деревьев, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "I love to listen to the leaves <w>whisper</w> in the breeze on a quiet afternoon.",
                            "target_lang_translations": {
                                "ru": "Мне нравится слушать, как <w>шепчут</w> листья на ветру тихим днем."
                            }
                        }
                    ],
                    "synonyms": [
                        "breathe",
                        "breathe"
                    ],
                    "common_phrases": [
                        "whisper through trees",
                        "whisper in the breeze"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used poetically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать мягкий, шуршащий звук, подобный ветру, проходящему сквозь листву."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелестеть",
                                "target_lang_sense_clarification": "о звуках листвы или ветра"
                            },
                            {
                                "target_lang_word": "шептать",
                                "target_lang_sense_clarification": "поэтическое описание звуков природы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fd078f-74f3-3666-9ab4-f0927343d466",
                    "sense_definition": "To send a private message to a specific person in a digital chat room.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "digital-communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>whisper</w> to the moderator if you have a private question about the rules.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>написать в личку</w> модератору, если у вас есть частный вопрос о правилах."
                            }
                        },
                        {
                            "text": "The player decided to <w>whisper</w> a message to his teammate so the others wouldn't see it.",
                            "target_lang_translations": {
                                "ru": "Игрок решил <w>шепнуть</w> сообщение своему товарищу по команде, чтобы остальные его не увидели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whisper a message"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet and gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить личное сообщение конкретному человеку в цифровом чате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шепнуть",
                                "target_lang_sense_clarification": "отправить личное сообщение в чате"
                            },
                            {
                                "target_lang_word": "написать в личку",
                                "target_lang_sense_clarification": "сленг, личное сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19a64eac-9181-3204-8f6a-54cfb9449e28",
                    "sense_definition": "To use specialized, gentle techniques to train or calm an animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal-training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is known for his ability to <w>whisper</w> to horses that others find impossible to ride.",
                            "target_lang_translations": {
                                "ru": "Он известен своей способностью <w>находить подход</w> к лошадям, на которых другие не могут ездить."
                            }
                        },
                        {
                            "text": "The trainer tried to <w>whisper</w> to the frightened dog to gain its trust.",
                            "target_lang_translations": {
                                "ru": "Тренер пытался <w>заговорить</w> с испуганной собакой, чтобы завоевать ее доверие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whisper to horses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать специальные мягкие техники для дрессировки или успокоения животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усмирять",
                                "target_lang_sense_clarification": "мягко успокаивать животное"
                            },
                            {
                                "target_lang_word": "заговаривать",
                                "target_lang_sense_clarification": "использовать голос для влияния на животное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07fe07f0-51d7-3cec-8cb5-26c994e2a9bd",
                    "sense_definition": "The sound or act of speaking very quietly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speaking-quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were talking in a <w>whisper</w> so they wouldn't get in trouble.",
                            "target_lang_translations": {
                                "ru": "Студенты разговаривали <w>шёпотом</w>, чтобы не навлечь на себя неприятности."
                            }
                        },
                        {
                            "text": "She answered in a near <w>whisper</w> because she was so nervous.",
                            "target_lang_translations": {
                                "ru": "Она ответила почти <w>шёпотом</w>, потому что очень нервничала."
                            }
                        }
                    ],
                    "antonyms": [
                        "shout",
                        "scream"
                    ],
                    "common_phrases": [
                        "in a whisper",
                        "near whisper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или акт очень тихой речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шёпот",
                                "target_lang_sense_clarification": "тихая речь без голоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "838fb551-742e-3637-bc47-2537c96d99bc",
                    "sense_definition": "A piece of information or news that is spread quietly or unofficially; a rumor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rumors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>whispers</w> of rebellion among the staff regarding the new policy.",
                            "target_lang_translations": {
                                "ru": "Среди сотрудников ходят <w>слухи</w> о бунте по поводу новой политики."
                            }
                        },
                        {
                            "text": "I heard a <w>whisper</w> that the company might be closing its local office.",
                            "target_lang_translations": {
                                "ru": "Я слышал <w>молву</w>, что компания может закрыть свой местный офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "breathe",
                        "breathe"
                    ],
                    "common_phrases": [
                        "whispers of rebellion",
                        "hear a whisper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или новость, распространяемая тайно или неофициально; слух."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слухи",
                                "target_lang_sense_clarification": "неофициальная информация"
                            },
                            {
                                "target_lang_word": "молва",
                                "target_lang_sense_clarification": "то, о чем говорят в народе"
                            },
                            {
                                "target_lang_word": "шёпот",
                                "target_lang_sense_clarification": "переносное значение: тайные разговоры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e13dc0f-c3b6-31ca-9127-aad00bf03730",
                    "sense_definition": "A very small amount or a slight trace of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small-amounts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef added just a <w>whisper</w> of basil to the sauce to enhance the flavor.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил в соус лишь <w>нотку</w> базилика, чтобы подчеркнуть вкус."
                            }
                        },
                        {
                            "text": "There was only a <w>whisper</w> of hope left after the team lost their best player.",
                            "target_lang_translations": {
                                "ru": "Остался лишь слабый <w>отголосок</w> надежды после того, как команда потеряла своего лучшего игрока."
                            }
                        }
                    ],
                    "synonyms": [
                        "breathe",
                        "breathe"
                    ],
                    "common_phrases": [
                        "whisper of basil",
                        "whisper of hope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое количество или легкий след чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нотка",
                                "target_lang_sense_clarification": "едва заметный привкус или оттенок"
                            },
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "слабый намек на что-либо"
                            },
                            {
                                "target_lang_word": "отголосок",
                                "target_lang_sense_clarification": "слабое проявление чувства или надежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c303987c-7658-3994-b7b4-777b2981176a",
                    "sense_definition": "A soft, rustling sound, such as wind moving through leaves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soft-sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whisper</w> of the wind through the pines was the only sound in the forest.",
                            "target_lang_translations": {
                                "ru": "<w>Шёпот</w> ветра в соснах был единственным звуком в лесу."
                            }
                        },
                        {
                            "text": "I woke up to the gentle <w>whisper</w> of the leaves outside my window.",
                            "target_lang_translations": {
                                "ru": "Я проснулся от нежного <w>шелеста</w> листьев за окном."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whisper of the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, шуршащий звук, например, ветра в листве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шёпот",
                                "target_lang_sense_clarification": "тихий звук природы"
                            },
                            {
                                "target_lang_word": "шелест",
                                "target_lang_sense_clarification": "звук листьев или травы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}