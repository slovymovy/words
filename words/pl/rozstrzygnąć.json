                    "sense_definition": "podjąć ostateczną decyzję w jakiejś spornej lub wątpliwej sprawie, doprowadzić coś do zakończenia",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd musi sprawiedliwie <w>rozstrzygnąć</w> ten wieloletni spór między sąsiadami.",
                            "target_lang_translations": {
                                "ru": "Суд должен справедливо <w>разрешить</w> этот многолетний спор между соседями."
                            }
                        },
                        {
                            "text": "Jedna celna bramka w doliczonym czasie gry ostatecznie <w>rozstrzygnęła</w> losy meczu.",
                            "target_lang_translations": {
                                "ru": "Один точный гол в добавленное время окончательно <w>решил</w> исход матча."
                            }
                        }
                    ],
                    "common_phrases": [
