                        "glosses": [
                            "Gesamtheit aller Umstände (Einrichtungen, Handlungen), die bei der Herstellung und Nutzung von Münzen beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad08cc64-3ee8-4c72-bb82-a8745f5e66e7",
                                "sense_id": "3e9b3ffc-9082-347f-ac67-e6af9a95ca61",
                                "text": "„Zugute kommt das Münzwesen vor allem dem Fernhandel.“"
                            },
                            {
                                "example_id": "c87ed2b7-4976-4dd1-833c-6cfda9d3fce4",
                                "sense_id": "3e9b3ffc-9082-347f-ac67-e6af9a95ca61",
                                "text": "„Die Münzprägung wurde an den königlichen Pfalzen zentralisiert, was die Vereinheitlichung des Münzwesens erleichterte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
