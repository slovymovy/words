                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff0931f-3719-4761-8ad5-386391164def",
                                "sense_id": "7abdf7fc-959a-34b3-b2e0-2f32e9175bc1",
                                "text": "Unsere Monatsnamen sind lateinischen Ursprungs."
                            },
                            {
                                "example_id": "0ce37010-8ec5-4b2b-ab7b-cad8bc46d288",
                                "sense_id": "7abdf7fc-959a-34b3-b2e0-2f32e9175bc1",
                                "text": "„Die lateinischen Monatsnamen drängen die alten deutschen, für deren Geltung sich Karl der Große eingesetzt hatte, immer mehr zurück (…)...“"
                            },
                            {
                                "example_id": "c127df37-e25e-4efa-a930-64c2d9230253",
                                "sense_id": "7abdf7fc-959a-34b3-b2e0-2f32e9175bc1",
                                "text": "„Die altägyptichen Monatsnamen sind noch heute bei den Kopten in Gebrauch.“"
                            },
                            {
                                "example_id": "74fcf33b-1582-422f-97a1-e80685187e88",
                                "sense_id": "7abdf7fc-959a-34b3-b2e0-2f32e9175bc1",
                                "text": "„1897 entdeckte man nahe des südostfranzösischen Ortes Coligny die Überreste eines Kalenders mit gallischen Monatsnamen und Feiertagsbezeichnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
