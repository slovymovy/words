                "senses": [
                    {
                        "sense_id": "d2641ef7-6eed-39f0-847f-9d82fe18114f",
                        "entry_id": "2233efbd-6948-346b-b681-184bec0c1515",
                        "glosses": [
                            "That serves to distinguish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e94c4c-610b-4bec-8d2f-51e4b1aae626",
                                "sense_id": "d2641ef7-6eed-39f0-847f-9d82fe18114f",
                                "text": "It has no obvious distinguishing characteristics, and therefore people are constantly ascribing to it the characteristics of other similar species."
                            },
                            {
                                "example_id": "fe1440ae-cb3b-46f1-ab23-cf9a1e2b39ae",
                                "sense_id": "d2641ef7-6eed-39f0-847f-9d82fe18114f",
                                "text": "The distinguishing feature of an acronym is that it is pronounced as if it were a single word, in the manner of NATO and NASA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b005866-d813-4be1-a883-e4a3a735573c",
                        "source_entry_id": "2233efbd-6948-346b-b681-184bec0c1515",
                        "source_sense_id": "d2641ef7-6eed-39f0-847f-9d82fe18114f",
                        "source_sense_description": "that serves to distinguish — see also distinctive",
