                    {
                        "translation_id": "6c1ddb2b-eab6-447c-a3cc-fba4f321a6f4",
                        "source_entry_id": "e6af5ae6-886d-3c07-8844-95585124f829",
                        "source_sense_id": "ae6c9208-c719-3bcb-a3c3-1be1b94d179e",
                        "source_sense_description": "een winkel waar boeken verkocht worden",
                        "target_lang_word": "Buchhandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                        "entry_id": "0502ec11-80d0-3fa1-9e43-d94da5bfb50b",
                                        "glosses": [
                                            "Einzelhandelsgeschäft, in dem Bücher verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6599d255-a49e-48de-8311-aadfa90e449d",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "Dieses Buch habe ich in der Buchhandlung am Marktplatz gekauft."
                                            },
                                            {
                                                "example_id": "e98a3f60-daef-46f0-8f82-a3e69d062790",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "„Die Buchhandlung am Bahnhof Friedrichstraße war noch immer geöffnet.“"
                                            },
                                            {
                                                "example_id": "76c390f3-4b74-4d25-9109-1ec4b0d1932c",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "„Sie schrieb auch mehrmals, dass sie gerne weiter in einer Bibliothek oder einer Buchhandlung arbeiten würde, denn im Westerwald (und später in Köln) hatte sie ja viele Jahre als Bibliothekarin gearbeitet.“"
                                            },
                                            {
                                                "example_id": "39715f4c-aa9d-45c1-9bc0-eddec7fb3c60",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "„Wir haben eine Buchhandlung gekauft.“"
                                            },
                                            {
                                                "example_id": "cc2073aa-95db-4859-b78e-f5738a4109e9",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "„Der alte Mann lud nämlich manchmal Kinder in seine Buchhandlung ein und las ihnen vor.“"
                                            },
                                            {
                                                "example_id": "201ee8d5-de71-48c8-b422-f23305ecb462",
                                                "sense_id": "073acd22-2a73-302b-a3d8-d9469062d767",
                                                "text": "„Als ich etwa 20 Jahre später in einer Buchhandlung in Los Angeles Autogramme gab, stellte sich auch Forry an — mit meiner Einsendung von damals in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50e66805-55ce-4018-b362-2cf63390e1ec",
                        "source_entry_id": "e6af5ae6-886d-3c07-8844-95585124f829",
                        "source_sense_id": "ae6c9208-c719-3bcb-a3c3-1be1b94d179e",
                        "source_sense_description": "een winkel waar boeken verkocht worden",
                        "target_lang_word": "Buchladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                        "entry_id": "abc98ce6-2e4d-3375-88a7-b86110457f7b",
                                        "glosses": [
                                            "ein Ladengeschäft zum Verkauf von Büchern"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb7151e-c8f7-45ce-b6b0-9d4c09e10265",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "Warst du schon im Buchladen?"
                                            },
                                            {
                                                "example_id": "49b1563b-3358-4420-90f2-d83743add13c",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "„In einem Buchladen begegnete ich Rainer Maria Rilke.“"
                                            },
                                            {
                                                "example_id": "44a0e9b2-bc6f-4a9e-a7e5-d1cb6f01402f",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "„Nach einer Weile wusste sie genau, wo jedes Buch in dem Buchladen stand!“"
                                            },
                                            {
                                                "example_id": "f2f62069-d138-4400-8d3e-b73840e33ce0",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "„In den Buchläden des Viertels dachte man erst, es sei leicht, auf den Zug aufzuspringen.“"
                                            },
                                            {
                                                "example_id": "55cbf03f-7336-4043-852a-881483d0608a",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "„Ich gehe in den Buchladen, um die Zeitung zu kaufen.“"
                                            },
                                            {
                                                "example_id": "30215aec-eab1-48f3-8ca2-c152a5913c76",
                                                "sense_id": "b901bd72-f37e-3694-9f5a-2b3f877b9384",
                                                "text": "„Wir begegneten uns zum erstenmal in einem obskuren Buchladen in der Rue Montmartre, wo der Zufall, daß wir beide dasselbe, übrigens sehr seltene und merkwürdige Buch suchten, uns in nähere Beziehung zueinander brachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
