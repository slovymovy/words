                                        "examples": [
                                            {
                                                "example_id": "3420ca17-ee8b-499c-a023-f839795b7cc9",
                                                "sense_id": "1973f133-c443-389e-9577-862667005dff",
                                                "text": "쪽에 은비녀를 지르다."
                                            },
                                            {
                                                "example_id": "0ae899b1-69b0-42c3-94da-5a230e2ad653",
                                                "sense_id": "1973f133-c443-389e-9577-862667005dff",
                                                "text": "오늘날 한국에서는 쪽을 한 아낙네를 보기가 드물다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4def87e-b5fa-3847-a9ef-56f8e7827496",
                                        "entry_id": "49b611ec-269d-31c5-ae1d-db60233193b3",
                                        "glosses": [
                                            "책이나 인쇄하여 묶은 서류의 낱낱의 종이 혹은 그에 따른 번호."
                                        ],
                                        "tags": [],
                                        "note": "면",
                                        "examples": [
                                            {
                                                "example_id": "73454d86-3822-48f9-9120-f2fcd44e6f67",
                                                "sense_id": "d4def87e-b5fa-3847-a9ef-56f8e7827496",
                                                "text": "네가 읽고 있는 그 쪽을 잘 읽어 보아라."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff1ea1d-b0ed-367f-8243-edf9af535b5f",
                                        "entry_id": "49b611ec-269d-31c5-ae1d-db60233193b3",
                                        "glosses": [
                                            "'얼굴'의 속된 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f623564-b3b3-4a66-9723-0c9611464968",
                                                "sense_id": "0ff1ea1d-b0ed-367f-8243-edf9af535b5f",
                                                "text": "쪽 팔린다: 창피하다."
                                            },
                                            {
                                                "example_id": "52e8e152-d64d-433c-9a69-09ab1c4d8bf2",
                                                "sense_id": "0ff1ea1d-b0ed-367f-8243-edf9af535b5f",
                                                "text": "아내 앞에서 쪽도 못 쓰는 공처가다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3e9579-985f-3cca-a07f-ce57e78ca8b1",
                                        "entry_id": "49b611ec-269d-31c5-ae1d-db60233193b3",
                                        "glosses": [
                                            "'국자'의 경상남도 사투리."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
