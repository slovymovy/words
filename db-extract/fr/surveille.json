                "senses": [
                    {
                        "sense_id": "5af87f55-871a-3ce6-a668-bc152f73cfd5",
                        "entry_id": "ccae1fbb-f0b3-31a9-9dc9-3cccaeef3c08",
                        "glosses": [
                            "Première personne du singulier du présent de l’indicatif de surveiller."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e2312986-90d2-4c6b-88e5-dee57c00f1e1",
                                "sense_id": "5af87f55-871a-3ce6-a668-bc152f73cfd5",
                                "text": "Alors, vous me suivez… le coupable, le vrai, se croit sauvé, il se relâche, il fait une gaffe… mais moi, je surveille sans en avoir l’air. Et, tzoum… je le pince…"
                            },
                            {
                                "example_id": "6cbcb0c2-35bc-49b6-ba9b-8ee0e7c4df9a",
                                "sense_id": "5af87f55-871a-3ce6-a668-bc152f73cfd5",
                                "text": "Il faudra que je me surveille sérieusement, déclara-t-il, car, depuis quelques jours, j’ai une nette propension à lapsusser."
                            },
                            {
                                "example_id": "c2926701-5a65-4b8a-8c9b-343366dc1019",
                                "sense_id": "5af87f55-871a-3ce6-a668-bc152f73cfd5",
                                "text": "La surveille, qui est-ce qui arrive dans une belle voiture ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f12521a7-2d97-3608-891b-4879dc55d9b0",
                        "entry_id": "ccae1fbb-f0b3-31a9-9dc9-3cccaeef3c08",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de surveiller."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b86aeb38-c606-4544-98e7-89bb85bb30f2",
                                "sense_id": "f12521a7-2d97-3608-891b-4879dc55d9b0",
                                "text": "L’entreprise surveille par ailleurs deux choses : la présence de formaldéhyde et la poussière de bois."
                            },
                            {
                                "example_id": "accba15e-b1d8-42b9-8879-466bebb9806a",
                                "sense_id": "f12521a7-2d97-3608-891b-4879dc55d9b0",
                                "text": "Dans vingt ans, si elle ne se surveille pas, ce sera une plantureuse mamma aux cheveux couleur de nuit comme les Incas dont elle doit aussi tenir et aux yeux mystérieusement bleus."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce96aee-181f-3d51-ac1c-e3168591db47",
                        "entry_id": "ccae1fbb-f0b3-31a9-9dc9-3cccaeef3c08",
