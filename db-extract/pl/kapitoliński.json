                        "translation_id": "d754ceee-4db4-4bf6-87a9-c8a37bd73c8f",
                        "source_entry_id": "1da288e6-c777-3486-a8e8-dc287f2d3f92",
                        "source_sense_id": "ef3ab8bf-640c-3e49-9fac-8ded45c6e053",
                        "target_lang_word": "Capitoline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Capitoline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41be9221-a990-3d1b-b750-50015c38c0c9",
                                        "entry_id": "d43a3a18-385f-3f2c-adea-38db1dc4a8c3",
                                        "glosses": [
                                            "Synonym of Capitoline Hill, the highest of the seven hills of Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3374195e-cee3-41cb-b7eb-ce2cddbf8d06",
                                                "sense_id": "41be9221-a990-3d1b-b750-50015c38c0c9",
                                                "text": "He said to meet him on the Capitoline."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Capitoline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebde7dfe-5672-3d2d-bac9-934022db7a19",
                                        "entry_id": "5d072f68-a07d-359d-a7ee-68e528ea7951",
                                        "glosses": [
                                            "Of or relating to Capitoline Hill in Rome or (historical) the various temples there in antiquity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c35294a7-26a5-480d-8605-98cb96530d65",
                        "source_entry_id": "1da288e6-c777-3486-a8e8-dc287f2d3f92",
                        "source_sense_id": "ef3ab8bf-640c-3e49-9fac-8ded45c6e053",
                        "target_lang_word": "capitolino",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capitolino",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5e434afe-99fc-365f-adb5-ef8b4f190f07",
                                        "entry_id": "a5cc68fa-34e2-3079-b397-dc0e1bf6e441",
                                        "glosses": [
                                            "Que pertenece o concierne a la Colina Capitolina, ubicada en la ciudad de Roma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a0b795-4bfc-4a5e-8604-72d92a598de1",
                                                "sense_id": "5e434afe-99fc-365f-adb5-ef8b4f190f07",
                                                "text": "Desde Zamora, rayana de Lusitania, a Gerona, fronteriza en las Galias, hay sembrados más secretos históricos y arquitectónicos, más misterios legendarios, más tesoros tradicionales, más poesía y más gloria que en la olímpica Grecia y en la Roma capitolina ¿Por qué no soy yo Homero, Virgilio o Dante? ¡Ay de mí! ¡El más pigmeo de los poetas modernos sueña con la edad de los gigantes!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a4a0e58-f308-4e2a-8784-e0cecc65949e",
                        "source_entry_id": "1da288e6-c777-3486-a8e8-dc287f2d3f92",
                        "source_sense_id": "ef3ab8bf-640c-3e49-9fac-8ded45c6e053",
                        "target_lang_word": "капитолийский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "капитолийский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7ede164d-e093-3d0f-873e-2148c3d79061",
                                        "entry_id": "1a7db1f2-cd40-35f8-a0ec-464b7eea1003",
                                        "glosses": [
                                            "относящийся к Капитолию — одному из один из семи холмов, на которых возник Древний Рим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5e3dab-dc48-4d9e-957b-27b7787f800b",
                                                "sense_id": "7ede164d-e093-3d0f-873e-2148c3d79061",
                                                "text": "Яркие лучи, изливаясь из двух огромных люстр, то скользили по блестящей зелени тысячи чужеземных растений, то преломлялись в бесчисленных отливах тёмно-гранатового атласа мебели, то, лаская грациозные контуры мраморной психеи или капитолийского амура, терялись в густых шпалерниках камелий…"
                                            },
                                            {
                                                "example_id": "a4c40387-6840-48bd-8217-e046a75516c6",
                                                "sense_id": "7ede164d-e093-3d0f-873e-2148c3d79061",
                                                "text": "Если сердцем Афин был Акрополь, то для Рима им в определённой мере стал Капитолий — Капитолийский холм, расположенный на берегу Тибра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef3f748-b2a6-39e8-b77c-b9e0919d17e1",
                                        "entry_id": "1a7db1f2-cd40-35f8-a0ec-464b7eea1003",
                                        "glosses": [
                                            "относящийся к Капитолию — зданию Конгресса США в Вашингтоне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44cb975c-b38b-4c5b-b8df-f16d822abf7f",
                                                "sense_id": "3ef3f748-b2a6-39e8-b77c-b9e0919d17e1",
                                                "text": "И с тех пор я полюбил Америку. Не страну новых цезарей в демократических пиджаках и широкополых стэтсоновских шляпах, которая представлялась мне современным вариантом великой Римской империи со всеми её грубыми изваяниями и монументами, стадионами, ристалищами, мавзолеями, курульными эдилами, мраморными креслами законодателей, грандиозными обелисками, отражающимися в длинных зеркалах прямоугольных прудов среди холмов заповедного индейского леса и английских лужаек города Вашингтона, который вознес в бледное небо североамериканской зимы туманную, высокую папскую тиару антихудожественного капитолийского купола, как бы утверждая надо всем Западным полушарием горькую истину, провозглашенную моим другом Анри Барбюсом, что всякие куполы, самые величественные, просто смешны, как колпаки, которыми гасили свечи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
