                        "entry_id": "6fb70b91-e89c-3f94-a985-c6673aec5d20",
                        "glosses": [
                            "Insecte, animal au corps segmenté en trois parties, dont le thorax est pourvu de trois paires de pattes articulées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad29b57-3831-49a7-8512-f27584859765",
                                "sense_id": "cb2684a8-8288-3ba6-85e4-c58478a74edd",
                                "text": "Die Biene ist ein Kerbtier, aber die Spinne ist kein Insekt.",
                                "translation": "L'abeille est un insecte, mais l'araignée n'est pas un insecte."
                            }
                        ]
                    }
