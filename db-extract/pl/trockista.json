                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee5a540-d898-4220-869b-0e3386603377",
                                "sense_id": "313e64d7-6b87-3345-9eb5-bd317d708751",
                                "text": "My, trockiści, walczyliśmy przeciw solidarnościowej kontrrewolucji i o proletariacką rewolucją polityczną w Polsce, która obaliłaby pasożytniczą biurokrację stalinowską i oparła się na bezpośrednich rządach rad robotniczych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42f9c646-082c-40ac-be87-6d3430f63fe6",
                        "source_entry_id": "146dc216-5260-3646-ac01-bc31f51be965",
                        "source_sense_id": "313e64d7-6b87-3345-9eb5-bd317d708751",
                        "target_lang_word": "Trotskyist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trotskyist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28bf094b-5c96-3c93-b8e7-5090500b9c11",
                                        "entry_id": "a44106d9-d77f-3b41-8b94-fec3a8d08367",
                                        "glosses": [
                                            "A supporter of Trotskyism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13d839a1-17ff-43b0-b947-dba2b291b484",
                        "source_entry_id": "146dc216-5260-3646-ac01-bc31f51be965",
                        "source_sense_id": "313e64d7-6b87-3345-9eb5-bd317d708751",
                        "target_lang_word": "Trotskyite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                        "entry_id": "abbbe8ac-1e85-3d76-8f48-4df91da18b83",
                                        "glosses": [
                                            "An advocate of the communist doctrines of Leon Trotsky (born Лев Дави́дович Бронште́йн (Lev Davídovič Bronštéjn) / Lev Davidovich Bronstein)."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a790af-3884-48a7-a0c6-c94e1caed0d7",
                                                "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                                "text": "A great number of disillusioned young men in the Western world are saying now that it is Stalin who is to blame and proclaiming themselves Trotskyites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                        "entry_id": "99f055d2-40b0-3708-b699-fe3a5bbf0618",
                                        "glosses": [
                                            "Of, relating to, supporting, or advocating the doctrines of Leon Trotsky."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08604fe-e9d3-4a7b-8bd8-d61e61b51399",
                                                "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                                "text": "[…] [her] father had fought in the Lincoln Brigade but now provided janitorial supplies to factories by day and attended Trotskyite meetings by night […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c24a8b6-6ac3-466e-aaad-9a35d456a499",
                        "source_entry_id": "146dc216-5260-3646-ac01-bc31f51be965",
                        "source_sense_id": "313e64d7-6b87-3345-9eb5-bd317d708751",
                        "target_lang_word": "Trot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9035660-ea49-3e07-9b52-565634f9f860",
                                        "entry_id": "fd22ea59-b179-3039-9330-65494e3b53b3",
                                        "glosses": [
                                            "A Trotskyist."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07190270-7770-4594-b8f3-09e2fcd35bca",
                                                "sense_id": "e9035660-ea49-3e07-9b52-565634f9f860",
                                                "text": "Loyal to a tee, he is still at a loss to understand the failure of the Frank Dobson candidacy in the London mayoral contest, and abandoned constituency meetings after a couple of events because they were \"too dominated by Trots\"."
                                            },
                                            {
                                                "example_id": "1cc964b5-3a0c-405b-b85a-cb1064d81085",
                                                "sense_id": "e9035660-ea49-3e07-9b52-565634f9f860",
                                                "text": "We believed that the Trots represented a mad, extreme form of Labour that was never going to do anything for anybody, yet we felt strongly that nothing would be achieved by jumping ship and defecting to the SDP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d271a51-feea-4f29-aa6b-ad64edf0263b",
                        "source_entry_id": "146dc216-5260-3646-ac01-bc31f51be965",
                        "source_sense_id": "313e64d7-6b87-3345-9eb5-bd317d708751",
                        "target_lang_word": "trot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527b8d3c-bf92-30dd-a92d-71da2e155713",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A gait of a person or animal faster than a walk but slower than a run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5654ecca-3c0a-4920-bcc7-c58580a609a6",
                                                "sense_id": "527b8d3c-bf92-30dd-a92d-71da2e155713",
                                                "text": "Waziri’s warriors marched at a rapid trot through the jungle in the direction of the village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d698921-51ba-3c06-966e-bf0083fa3121",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A brisk journey or progression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e36372c-53b2-40cf-8cb7-479efaafe4a4",
                                                "sense_id": "6d698921-51ba-3c06-966e-bf0083fa3121",
                                                "text": "We often take the car and have a trot down to the beach."
                                            },
                                            {
                                                "example_id": "51334fa1-3346-404b-abe8-ebe945501f68",
                                                "sense_id": "6d698921-51ba-3c06-966e-bf0083fa3121",
                                                "text": "In this lesson we'll have a quick trot through Chapter 3 before moving on to Chapter 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f9ae17-c970-31e8-9f30-245d47c293f1",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A gait of a four-legged animal between walk and canter, a diagonal gait (in which diagonally opposite pairs of legs move together)."
                                        ],
                                        "tags": [
                                            "of horses"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e42a36b-d827-4a11-9dcc-030d9d28280b",
                                                "sense_id": "62f9ae17-c970-31e8-9f30-245d47c293f1",
                                                "text": "Dogs have a variety of gaits. Most dogs have the walk, trot, pace, and gallop."
                                            },
                                            {
                                                "example_id": "7cb1ccd5-5635-4d3c-ba21-43ab5ec5390e",
                                                "sense_id": "62f9ae17-c970-31e8-9f30-245d47c293f1",
                                                "text": "The toelt is comfortable for the rider because the amplitude of the dorsoventral displacement is lower than at the trot.[…]The slow trot is a two-beat symmetric diagonal gait. Among the normal variations of the trot of saddle horses, the speed of the gait increases from collected to extended trot."
                                            },
                                            {
                                                "example_id": "3e6ed1ea-ed6a-4c92-9a6a-425efa4afec4",
                                                "sense_id": "62f9ae17-c970-31e8-9f30-245d47c293f1",
                                                "text": "To assume the correct position for the posting trot, first walk, with the body inclined forward in a posting position. Then put the horse into a slow or sitting trot at six miles an hour. Do not post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308e87bc-e228-3633-bcd0-11544509e805",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A toddler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fa01a2-f862-44d3-8a21-8fca3630fc5f",
                                                "sense_id": "308e87bc-e228-3633-bcd0-11544509e805",
                                                "text": "1855, William Makepeace Thackeray, The Newcomes, 1869, The Works of William Makepeace Thackeray, Volume V: The Newcomes, Volume I, page 123,\n[…] but Ethel romped with the little children — the rosy little trots — and took them on her knees, and told them a thousand stories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e55f4be-ced3-3d5e-acd8-9d647d9a4f55",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A moderately rapid dance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e274d296-baea-3dd3-aaf6-03a1079c27c8",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A young animal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cca8bd1-5c60-36c2-9c65-bbfccb9218a2",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "An ugly old woman, a hag."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6d2e2e8-47b2-3cdf-9942-abfc8a4699e3",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A succession of heads thrown in a game of two-up."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "facafce2-4aea-361b-ba24-5f9d478ffdf0",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "A run of luck or fortune."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7910228f-4a8e-4d23-9c1c-2e891b7edf4b",
                                                "sense_id": "facafce2-4aea-361b-ba24-5f9d478ffdf0",
                                                "text": "He′s had a good trot, but his luck will end soon."
                                            },
                                            {
                                                "example_id": "01cf3f36-0db2-43e0-9545-11b25a7e1bda",
                                                "sense_id": "facafce2-4aea-361b-ba24-5f9d478ffdf0",
                                                "text": "It was to be a hugely special occasion, for apart from the picture shows at the Majestic, there was usually nothing at all going on in Sandspit to make anyone think they were on a good trot living there."
                                            },
                                            {
                                                "example_id": "6f8e905d-514e-4b2d-b216-14313a48bf44",
                                                "sense_id": "facafce2-4aea-361b-ba24-5f9d478ffdf0",
                                                "text": "Should he or she be having a bad trot, the exchange rate will be higher than normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523ae19b-04fe-3db3-97e8-c0b242db50ed",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "Synonym of horse (illegitimate study aid)"
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9f6f3be-2fe9-3b06-ac6f-49b94457fef2",
                                        "entry_id": "8c866abb-fe83-3b16-821d-26ccc92b4e99",
                                        "glosses": [
                                            "Diarrhoea."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "709ed88f-f425-4bef-a72b-552e42cea122",
                                                "sense_id": "e9f6f3be-2fe9-3b06-ac6f-49b94457fef2",
                                                "text": "He's got a bad case of the trots and has to keep running off to the toilet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                        "entry_id": "2d2ed9a1-03d4-3243-af19-2a4b4bcc8025",
                                        "glosses": [
                                            "To move along briskly; specifically, to move at a pace between a walk and a run."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3f9d178-a76e-4d2e-93d2-ded20cd983e9",
                                                "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                                "text": "I didn't want to miss my bus, so I trotted the last few hundred yards to the stop."
                                            },
                                            {
                                                "example_id": "580c9e9c-b5cb-4788-bb04-a24cae40c9f3",
                                                "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                                "text": "The dog trotted along obediently by his master's side."
                                            },
                                            {
                                                "example_id": "dabc8de8-358e-40d7-9c63-f08db611ca7b",
                                                "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                                "text": "I would trot ten or twelve miles each day, go into a cheap restaurant and eat my fill of bread, but would never be satisfied. During these wanderings I once hit on a vegetarian restaurant in Farringdon Street. The sight of it filled me with the same joy that a child feels on getting a thing after its own heart."
                                            },
                                            {
                                                "example_id": "d1af282a-b281-4245-a367-bd7c906fbe4d",
                                                "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                                "text": "They sent little Jane to the garden to play,\nBut she opened the gate, and then trotted away\nUnder the hawthorns and down the green lane,\nBad little, mad little, runaway Jane!"
                                            },
                                            {
                                                "example_id": "d5b584c3-e3a2-4179-8a7e-fd3778230baf",
                                                "sense_id": "440a7d2f-779c-3926-babe-70cfe1948d27",
                                                "text": "It was earliest morning, when even small trees cast long shadows and scarlet foxes trot denward through the dew like flecks of fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a241c82d-57e6-3976-83a8-e340422d79a9",
                                        "entry_id": "2d2ed9a1-03d4-3243-af19-2a4b4bcc8025",
                                        "glosses": [
                                            "To move at a gait between a walk and a canter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15c70344-cef6-31fe-b170-7bc35ffefe08",
                                        "entry_id": "2d2ed9a1-03d4-3243-af19-2a4b4bcc8025",
                                        "glosses": [
                                            "To cause to move, as a horse or other animal, in the pace called a trot; to cause to run without galloping or cantering."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0eecf46e-8fe7-38a5-8e3a-d04338ba7de7",
                                        "entry_id": "2d2ed9a1-03d4-3243-af19-2a4b4bcc8025",
                                        "glosses": [
                                            "To bid against (a person) at an auction, so as to raise the price of the goods."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
