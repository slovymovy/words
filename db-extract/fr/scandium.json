        "fr-extract.jsonl": [
            {
                "entry_id": "f47e6b5b-fea2-3869-a5f0-854b5e51d9ae",
                "word": "scandium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3b67404-8619-42aa-ac04-efa6092f6f68",
                        "entry_id": "f47e6b5b-fea2-3869-a5f0-854b5e51d9ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "scandiums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "957f890e-9e2d-3b28-86f4-a2a2d2375906",
                        "entry_id": "f47e6b5b-fea2-3869-a5f0-854b5e51d9ae",
                        "glosses": [
                            "Élément chimique de numéro atomique 21 et de symbole Sc qui fait partie des métaux de transition et des terres rares."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5495e2f-44a5-4c20-9c72-8582d4548ba3",
                                "sense_id": "957f890e-9e2d-3b28-86f4-a2a2d2375906",
                                "text": "La répartition géographique du scandium est donc l’image de celle des vases silteuses islandaises."
                            },
                            {
                                "example_id": "9e705fd3-8d31-4139-a7a0-82b1e6cfdae2",
                                "sense_id": "957f890e-9e2d-3b28-86f4-a2a2d2375906",
                                "text": "Certain·es auteur·es rattachent également le scandium, de numéro atomique 21, aux « terres rares », bien que selon le BRGM il ne soit pas présent dans les mêmes gisements."
                            }
                        ]
                    },
                    {
                        "sense_id": "6916ec23-7eac-3a7f-aed1-a94f4d2513c3",
                        "entry_id": "f47e6b5b-fea2-3869-a5f0-854b5e51d9ae",
                        "glosses": [
                            "Corps simple de cet élément, d’aspect blanc-argenté, mou, très léger, qui devient jaunâtre ou rose lorsqu’il est exposé à l’air."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fc6f7a1f-c86d-4622-a6c6-ac1fba1f6dee",
                                "sense_id": "6916ec23-7eac-3a7f-aed1-a94f4d2513c3",
                                "text": "Bien qu’elle n’engendre pas de retombées sur la Côte-Nord, la production de scandium à Sorel-Tracy représente quand même une nouvelle rassurante, surtout qu’une incertitude a longtemps flotté au sujet l’avenir de la mine de Havre-Saint-Pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "95b0791b-3ba5-39a5-8af9-431fa65a195c",
                        "entry_id": "f47e6b5b-fea2-3869-a5f0-854b5e51d9ae",
                        "glosses": [
                            "Atome (ou, par ellipse, noyau) de scandium."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
