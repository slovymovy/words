            {
                "entry_id": "fc3f6f29-0f91-3461-9370-b67072738891",
                "word": "dumper",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7a424622-d4d4-43ac-8c25-94adcc7bab65",
