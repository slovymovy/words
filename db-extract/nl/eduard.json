                "translations": [
                    {
                        "translation_id": "8f6bcf16-9514-4a16-8884-2907f68f5614",
                        "source_entry_id": "09d33fb4-356e-3cf5-af43-e35088cbf3b1",
                        "source_sense_id": "89576209-4b6e-3098-85cf-56ea14317df8",
                        "source_sense_description": "spelwoord voor de letter e",
                        "target_lang_word": "Emil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                                        "entry_id": "16ca09e8-609c-34da-b087-6e7a69d0a810",
                                        "glosses": [
                                            "männlicher Vorname; Emil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c5b3df1-ab4e-4d5b-8398-e0c7854d2fa1",
                                                "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                                                "text": "Wir werden Emil morgen zu seinem Geburtstag gratulieren."
                                            },
                                            {
                                                "example_id": "7a24f034-4b77-4a0c-afc5-157892acda2f",
                                                "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                                                "text": "Emil Spannocchi kam als jüngstes von drei Kindern von Anton Graf Spannocchi und Gabriele Gräfin von Attems 1916 auf Schloss Aigen, heute Teil der Stadt Salzburg, zur Welt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d345ce3-7bad-49a8-9e07-0a1b70d7c265",
                        "source_entry_id": "09d33fb4-356e-3cf5-af43-e35088cbf3b1",
                        "source_sense_id": "89576209-4b6e-3098-85cf-56ea14317df8",
                        "source_sense_description": "spelwoord voor de letter e",
                        "target_lang_word": "Edward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A male given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee615e3-3d65-4883-96c1-3a26ffb9f458",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The Christian humility of King Edward the Confessour brought such credit to this name, that since that time it hath been most usual in all estates."
                                            },
                                            {
                                                "example_id": "65c70d7d-98bb-4f61-abd8-3b37b1689e7e",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "Heaven is my witness! that in the warmest transport of my wishes for the prosperity of my child, I never once wished to crown his head with more glory and honour than what George or Edward would have spread around it."
                                            },
                                            {
                                                "example_id": "623d78e9-1a28-4dc0-aad3-8b3d93a25084",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "There's a world of difference between the name Edward, which sounds rather regal and stuffy (Edwardian) and the name Eddie, which sounds like a guy on the bus."
                                            },
                                            {
                                                "example_id": "29072844-ccca-49f4-b690-7bafdd34d26a",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The engineers are Akash Bobba, Edward Coristine, Luke Farritor, Gautier Cole Killian, Gavin Kliger, and Ethan Shaotran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adad8b9-2738-3613-bcc6-58147661063d",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A surname. See also Edwards."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                        "entry_id": "a840541c-3bea-3e0f-8108-1d25a296272a",
                                        "glosses": [
                                            "A gold coin produced in the reign of King Edward."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbcf2cec-2edd-4620-9972-a582644ff30f",
                                                "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                                "text": "It is indeed the same golden Edward, with three holes in it, with which I presented my Mary on her birthday, in her eighteenth year, to buy a new suit for the holidays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c476b7e-17f7-4c14-a277-6dabe3dba983",
                        "source_entry_id": "09d33fb4-356e-3cf5-af43-e35088cbf3b1",
                        "source_sense_id": "89576209-4b6e-3098-85cf-56ea14317df8",
                        "source_sense_description": "spelwoord voor de letter e",
                        "target_lang_word": "Eugène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eugène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                        "entry_id": "33bfd2a0-8439-3f60-b8b5-eebcc792c254",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126dc104-20e1-4c5d-8caf-a81b38f9a32a",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "En attendant, Eugène conjecturait sur le départ de Dimitri, dont la disparition soudaine restait mystérieuse."
                                            },
                                            {
                                                "example_id": "ef6de8d3-3a7f-4417-951f-ebb3a1fd1ba3",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "J’allais oublier qu’Eugène croit aux soldats laboureurs !"
                                            },
                                            {
                                                "example_id": "bceb35ea-2ddc-4137-aa3c-76202b3c4e80",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "À cette époque, l’aîné, Eugène, avait près de quarante ans. C’était un garçon de taille moyenne, légèrement chauve, tournant déjà à l’obésité."
                                            },
                                            {
                                                "example_id": "80f2a7fe-5915-4776-9a13-cd981707611b",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "— Vous ne pouvez pas épouser un Eugène Duthoit. D’abord, « Eugène », c’est un nom ridicule !"
                                            },
                                            {
                                                "example_id": "d37e09b2-2c9c-4104-9d71-75fda00a2718",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "Mais aussi Yvon Fauconnier, Mike Birch, le futur vainqueur, ou encore Eugène Riguidel, marin haut en couleur à qui il doit sa participation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
