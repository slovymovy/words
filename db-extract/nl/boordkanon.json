                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba279a20-9ea9-4713-9d48-f8b5658e2986",
                                "sense_id": "9cbc8c9e-fbae-328d-92da-69f50daad499",
                                "text": "Er zijn vier varianten van de F-35 Lightning II, de volledige naam van de straaljager. Nederland heeft de A-variant, die als enige is uitgerust met een boordkanon. De Britten krijgen toestellen die verticaal kunnen opstijgen. Deze B-variant is bedoeld om de huidige standaardvliegtuigen van de vloot te vervangen: de Harrier-straaljager."
                            },
                            {
                                "example_id": "d2edf096-c10f-4920-af36-147d9064d590",
                                "sense_id": "9cbc8c9e-fbae-328d-92da-69f50daad499",
                                "text": "Aan boord is ruimte voor kruisraketten en torpedo's. In totaal zijn er 80 lanceerbuizen. Het boordkanon kan honderden projectielen afvuren over een afstand van meer dan 100 kilometer."
                            }
                        ]
                    }
