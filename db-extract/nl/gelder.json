                        "examples": [
                            {
                                "example_id": "0e95b0ec-2c2f-4d6e-ab25-45548c308c60",
                                "sense_id": "ce49ccd2-361a-36bd-8089-aa7eccd2020c",
                                "text": "⧖ Ende hun, die 't stuk der volstandigheit dreeven by luiden met het vuur voor de scheenen zittende, smartte 't verlies van de veldtvruchten eenigher maanden: bewys, wat het scheelt, enkelen raader oft gelder met een te weezen.\n(=En zij die standvastigheid bepleitten bij mensen die in groot gevaar verkeerden, hadden zelf moeite de oogst van een paar maanden te verliezen: wat laat zien hoe het uitmaakt of je alleen advies geeft, of ergens direct voor opdraait.)"
                            }
                        ]
                    }
