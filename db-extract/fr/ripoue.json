                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a3bd0cec-06f0-479c-8ace-f16edc38fb90",
                                "sense_id": "772f6aa4-e712-345c-a542-c960621d5d7e",
                                "text": "Je ne couche pas avec mon patron, et je ne suis pas non plus une ripoue.\nQuand j'étais entrée à l'école de Cannes-Écluse, juste après ma licence en droit, jamais je n'aurais imaginé que je devrais ainsi me défendre dans le cabinet d'une juge d'instruction."
                            },
                            {
                                "example_id": "53e4c6a5-d349-4eb4-9e55-bc38e526bdcf",
                                "sense_id": "772f6aa4-e712-345c-a542-c960621d5d7e",
                                "text": "L'inspection des services l’a mise sur le gril, pour voir si elle n'était pas une ripoue, elle aussi, comme Shayne Townsend."
                            }
                        ]
                    }
