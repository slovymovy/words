            {
                "entry_id": "82b46195-5be9-38cc-bb64-d5485e1a56fb",
                "word": "autisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "13be462f-7dfe-4bde-9f77-543921582db3",
