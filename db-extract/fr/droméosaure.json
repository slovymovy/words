                        "glosses": [
                            "Variante (rare) de dromaeosaure. Espèce de dinosaure carnivore à plumes de la famille des Dromaeosauridae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f12998b-309a-4fcd-be4e-6749b6206452",
                                "sense_id": "eceec798-7d10-3d91-9e6a-975b6065133a",
                                "text": "Les dinonychosaures sont de petits dinosaures carnivores actuellement répartis en deux lignées : les droméosaures, et les saurornithoïdes plus frêles"
                            },
                            {
                                "example_id": "73f722e6-425c-41c3-8872-9d868df6e6a8",
                                "sense_id": "eceec798-7d10-3d91-9e6a-975b6065133a",
                                "text": "La théorie prétend que les dinosaures de petites tailles, appelés vélociraptores ou droméosaures ont évolué en développant des ailes puis en volant. Ainsi, l’Archæoptéryx"
                            }
                        ]
