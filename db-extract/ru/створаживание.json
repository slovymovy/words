                    },
                    {
                        "translation_id": "ec5d1aca-9bc8-431f-8a8f-f426ffa274d1",
                        "source_entry_id": "b82585da-d0ca-38da-91ef-449bee6b9c80",
                        "source_sense_id": "6194d0c7-ff8d-3477-9ac5-75365b54856a",
                        "target_lang_word": "Gerinnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerinnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                        "entry_id": "7454e50a-9892-310a-b322-7fe1029bef7e",
                                        "glosses": [
                                            "Festwerden einer eiweißhaltigen Flüssigkeit, beispielsweise von Blut oder Milch, durch chemisch-physikalische Prozesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88dfbbd2-153a-41d8-a9ad-39a70f4a8c62",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "Die Fähigkeit zur Gerinnung ist eine wichtige Aufgabe des Blutes."
                                            },
                                            {
                                                "example_id": "c171d515-285d-4b40-8dbb-e650cce2b69b",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Vitamin K benötigt der Körper für eine intakte Gerinnung.“"
                                            },
                                            {
                                                "example_id": "a50e58af-dd14-446e-8fcb-169a4757f4d9",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Umso wichtiger ist es, […] das Risiko für einen erneuten Schlaganfall zu verringern. Dies geschieht im Allgemeinen durch Medikamente, die die Gerinnung des Blutes beeinflussen.“"
                                            },
                                            {
                                                "example_id": "70e02874-0463-4953-bbf3-cd91144031e0",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Neue gerinnungshemmende Tabletten […] haben […] den Nachteil, dass es keine Gegenmittel gibt, die bei Bedarf die Gerinnung wieder schnell normalisieren.“"
                                            },
                                            {
                                                "example_id": "fd8308d1-e577-4cae-8b52-5dc34b9bc73d",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Es gibt viele Patienten, die Aspirin als Prophylaxe bei Herzerkrankungen als Blutverdünner nehmen, damit die Blutplättchen nicht so leicht verkleben und um einer Gerinnung vorzubeugen.“"
                                            },
                                            {
                                                "example_id": "9d83e9a9-4012-4bdb-bd9b-9b8859a3dcaa",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Eigentlich ist der Begriff «Blutverdünner» irreführend. Die Medikamente machen das Blut nicht etwa «flüssiger», sondern hemmen seine Gerinnung.“"
                                            },
                                            {
                                                "example_id": "21499ead-967e-421a-b961-6b674de17e03",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "[Coronabehandlung:] „»[…] Unsere Befunde legen nahe, dass eine konsequente Verhinderung und Behandlung der Gerinnung einen großen Nutzen für die Patienten bringt.«“"
                                            },
                                            {
                                                "example_id": "776bee6c-7736-4a35-9f6a-27a1a7c25676",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "[Das aus Blutspenden gewonnene Thrombozytenkonzentrat] „enthält die für die Gerinnung unverzichtbaren Blutplättchen, die vor allem von Patienten in der Chemotherapie und Tumorpatienten benötigt werden.“"
                                            },
                                            {
                                                "example_id": "f0a9763d-8354-41c2-8a55-58e2da6cd15f",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„bei Angst und Anspannung [werden] die Stresshormone Adrenalin und Kortisol ausgeschüttet, um Reaktions- und Leistungsfähigkeit zu steigern: Die Gefäße weiten sich, Blutdruck und Pulsfrequenz steigen, mehr Blut fließt durch die Adern und zugleich wird die Gerinnung aktiviert, damit man im Fall einer Verletzung nicht verblutet.“"
                                            },
                                            {
                                                "example_id": "32d620f1-fc6c-4044-a647-b9b7d667d85b",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Das blutgerinnungshemmende Protein Hirudin, das sich im Speichel der [Blutegel] befindet, lässt das gestaute Blut des Patienten durch die fehlende Gerinnung nach außen abfließen.“"
                                            },
                                            {
                                                "example_id": "c9a8b3b0-2878-4ee8-86bc-d2549103a219",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "Lab startet die Gerinnung von Milch. Ohne Lab gäbe es keinen Käse."
                                            },
                                            {
                                                "example_id": "6ccf24e8-aa78-4dc0-be77-4cb47a6b59bb",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Durch die Gerinnung von Kasein erhält der Käse seine feste Beschaffenheit.“"
                                            },
                                            {
                                                "example_id": "e1ee64fa-bfbe-47a9-a5b9-fab41c439091",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„Das im Lab enthaltene Enzym bringt schon in geringer Dosis sehr große Mengen (1:6000–1:600.000 Teile) Milch zur Gerinnung.“"
                                            },
                                            {
                                                "example_id": "5446c40d-8df6-4c59-bf0f-d2098b874fe9",
                                                "sense_id": "5e70aaae-e286-3c8f-a153-36cff456f8ca",
                                                "text": "„[…] für die Gerinnung (Koagulation) von Naturkautschuk wird oft Ameisen- oder Essigsäure eingesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
