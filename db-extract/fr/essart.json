                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8355588e-29e6-360b-ade4-e0d6c3986e9f",
                                        "entry_id": "7bb0f3a1-7160-3ddf-8fe0-2c3d0a2e693b",
                                        "glosses": [
                                            "Forest land cleared for agriculture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "528ef1f6-0314-3595-9cf7-b341c6fc8839",
                                        "entry_id": "7bb0f3a1-7160-3ddf-8fe0-2c3d0a2e693b",
                                        "glosses": [
                                            "The act or offence of grubbing up trees and bushes, and thus destroying the thickets or coverts of a forest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d16a18-b4e4-4a79-9011-a1250f2a9cd8",
                                                "sense_id": "528ef1f6-0314-3595-9cf7-b341c6fc8839",
                                                "text": "[…] an assart of the Forest, is the greatest offence or trespasse of all other, that can be done in the forest, to vert or venison, containing in it as much as waste or more. For whereas the waste of the Forest, is but the felling and cutting downe of the couerts, which may grow againe in time: an assart, is a plucking them vp […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8e4ccf-bb01-36c4-9df9-1142bdb7a55e",
                                        "entry_id": "f960b177-f244-3d9e-ab39-86201643f0e6",
                                        "glosses": [
                                            "To clear forest land for agriculture; remove stumps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485e8a41-66f7-46d9-ba6a-3a4da673bfc6",
                                                "sense_id": "4e8e4ccf-bb01-36c4-9df9-1142bdb7a55e",
                                                "text": "[…] if a man sue out a Licence to assart his grounds in the Forest, and to make it several for Tillage, then it is no offence."
                                            },
                                            {
                                                "example_id": "29a32af1-2091-4340-bd48-5125df171d57",
                                                "sense_id": "4e8e4ccf-bb01-36c4-9df9-1142bdb7a55e",
                                                "text": "1775, John Ash, The New and Complete Dictionary of the English Language, London: Edward & Charles Dilly, Volume I,\nASSART v.t. […] To clear away wood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f49e3a4-75bf-41e1-87c6-81c6fda74fd8",
