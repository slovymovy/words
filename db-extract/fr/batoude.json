                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e455f4-b890-410b-8e05-0243fd2ae2da",
                                "sense_id": "d5bbc9ad-2959-34db-90f9-04c3e3263829",
                                "text": "En Suède comme en Russie, on donnait beaucoup de numéros à la batoude."
                            },
                            {
                                "example_id": "c4b3ecb3-9c48-428a-b08e-89fe79f22f05",
                                "sense_id": "d5bbc9ad-2959-34db-90f9-04c3e3263829",
                                "text": "C’était un tremplin légèrement modifié, et tenant un peu de la batoude anglaise, et ayant trois mètres de longueur avec une inclinaison du plancher qui s’élevait au-dessus du sol de quarante centimètres, à l’endroit où le sauteur prend son élancement."
                            }
