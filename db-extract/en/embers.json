                    {
                        "translation_id": "73592754-cb2f-457a-ba99-5a7e5b0d1ee7",
                        "source_entry_id": "349de22e-9c11-3dc6-8a28-7d288dd894c5",
                        "source_sense_id": "688f32d1-def5-3663-af1a-fc19b3a31cc8",
                        "source_sense_description": "the smoldering or glowing remains of a fire, smoldering ash",
                        "target_lang_word": "зола́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зола́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                        "entry_id": "387272bf-abdb-3cbd-a16f-bf45684e36d8",
                                        "glosses": [
                                            "твёрдый продукт сжигания чего-либо, образующийся в виде небольших сероватых ломких хлопьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a026d71-8580-4330-9f5b-81429f0eb65a",
                                                "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                                "text": "Может быть — бродило тогда у меня в голове — если я до них дотронусь, то они рассыплются золою у меня в руке."
                                            },
                                            {
                                                "example_id": "4445a4fd-b52f-4c27-8a03-561b0aa09a2c",
                                                "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                                "text": "Потом подошёл к очагу, порылся в золе, нашёл там горячие уголья, раздул их не без труда и зажёг лучину, валявшуюся на лавке. … Позолота на прорезных травах иконостаса походила местами на уголья, тлеющие под золою и готовые вспыхнуть."
                                            },
                                            {
                                                "example_id": "2badc9f8-87ce-46b0-8663-fdfa6406f857",
                                                "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                                "text": "Беженцы копали картофель и пекли его в золе костров, разведённых из соломы или станичных плетней…"
                                            },
                                            {
                                                "example_id": "ae6f45b3-4ce0-43fa-9000-de16603bda3e",
                                                "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                                "text": "Кстати, хочу напомнить: древесная зола — наиболее ценное минеральное удобрение."
                                            },
                                            {
                                                "example_id": "3dafb617-8820-4265-a672-ce55f5fbceb8",
                                                "sense_id": "635a0146-6dc1-34ae-af77-68d688b4c696",
                                                "text": "Сырьём для получения глинозёма могут служить каменноугольные золы, отходы обогащения каменных углей и глинозёмистые шлаки, образующиеся при восстановительной плавке некоторых железных руд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
