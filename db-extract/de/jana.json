                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ebf79cf-118e-4ea0-ab40-a7b2eb974767",
                                "sense_id": "a04567c2-b579-31da-8bca-3b045da2d408",
                                "text": "Janas Zimmer ist immer furchtbar unaufgeräumt."
                            },
                            {
                                "example_id": "70380498-6489-4dc9-bfb0-f286b7d5febd",
                                "sense_id": "a04567c2-b579-31da-8bca-3b045da2d408",
                                "text": "„Jana sah Maxim an und spürte nichts als Hilflosigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9b141ae-5a4e-448a-9da2-f354a27e0a28",
                        "source_entry_id": "ce6fca72-114d-3ae0-8666-6857fa36c980",
                        "source_sense_id": "a04567c2-b579-31da-8bca-3b045da2d408",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Jane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                                        "entry_id": "5aacff7e-6147-3d79-b115-18cab9ebe74a",
                                        "glosses": [
                                            "A female given name from French, the standard feminine form of John since the 17th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06a87e2e-be98-487d-a13c-855cece39f34",
                                                "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                                                "text": "In latter years some of the better and nicer sort, misliking Joan, have mollified the name of Joan into Jane, as it may seem, for that Jane is never found in old Records; and as some will, never before the time of King Henry the eight."
                                            },
                                            {
                                                "example_id": "34faea7f-17a7-4988-b29c-2f6835c28663",
                                                "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                                                "text": "People will please their fancies, and every lady has favourite names. I myself have several, and they are mostly short and simple. Jane, that queenly name! Jane Seymour, Jane Grey, 'the noble Jane de Montford;' - - -"
                                            },
                                            {
                                                "example_id": "9be45886-1c70-471d-b3af-7f487a8f884d",
                                                "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                                                "text": "\"What I mean is,\" said Mrs. Riversedge, \"that when I get maids with unsuitable names I call them Jane; they soon get used to it.\"\n\"An excellent plan,\" said the aunt of Clovis coldly; \"unfortunately I have got used to being called Jane myself. It happens to be my name.\""
                                            },
                                            {
                                                "example_id": "077b8411-6f27-4277-80a1-d6039cb0b3d5",
                                                "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                                                "text": "In the amended complaint, Carter is accused of raping the then-13-year-old Jane Doe at an afterparty for the MTV Video Music Awards in the year 2000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01f2366-7d50-31d4-96cc-a1a2d47d5d10",
                                        "entry_id": "5aacff7e-6147-3d79-b115-18cab9ebe74a",
                                        "glosses": [
                                            "A surname originating as a patronymic derived from a Middle English variant of John."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Jane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "132dd97b-09f9-3456-9a3b-c709c56dcbc3",
                                        "entry_id": "cfc4f261-f1b6-3611-8f77-3359f3f5f663",
                                        "glosses": [
                                            "used as a placeholder name for any woman, especially a young working-class woman"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87d08c29-24f3-3cb4-8839-da5eb616904a",
                                        "entry_id": "cfc4f261-f1b6-3611-8f77-3359f3f5f663",
                                        "glosses": [
                                            "A girlfriend."
