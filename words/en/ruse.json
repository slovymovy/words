{
    "word_family": [
        "ruser",
        "rusery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d060126f-0572-3b48-947c-06ad7554251b",
                    "sense_definition": "An action intended to deceive; a clever trick or stratagem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers used a clever <w>ruse</w> to gain entry into the enemy fortress without being detected.",
                            "target_lang_translations": {
                                "ru": "Солдаты использовали хитрую <w>уловку</w>, чтобы проникнуть во вражескую крепость незамеченными."
                            }
                        },
                        {
                            "text": "She quickly realized his story was just a clever <w>ruse</w> to get her out of the office.",
                            "target_lang_translations": {
                                "ru": "Она быстро поняла, что его история была всего лишь хитрой <w>уловкой</w>, чтобы выманить её из офиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "stratagem",
                        "ploy",
                        "artifice",
                        "wile"
                    ],
                    "common_phrases": [
                        "clever ruse",
                        "simple ruse",
                        "employ a ruse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, направленное на обман; хитрая уловка или стратегический прием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием для достижения цели"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "хитрый поступок, уловка"
                            },
                            {
                                "target_lang_word": "ухищрение",
                                "target_lang_sense_clarification": "ловкий, изобретательный прием"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "ловкий прием, фокус"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803f759e-ee25-3c5e-8334-17b75d0057d0",
                    "sense_definition": "Cunning, guile, or trickery in general.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was known for his reliance on <w>ruse</w> and surprise rather than brute force.",
                            "target_lang_translations": {
                                "ru": "Генерал был известен тем, что полагался на <w>хитрость</w> и эффект неожиданности, а не на грубую силу."
                            }
                        },
                        {
                            "text": "They managed to take the small outpost by <w>ruse</w> rather than by open assault.",
                            "target_lang_translations": {
                                "ru": "Им удалось захватить этот небольшой аванпост <w>хитростью</w>, а не открытым штурмом."
                            }
                        }
                    ],
                    "synonyms": [
                        "guile",
                        "cunning",
                        "trickery",
                        "craftiness"
                    ],
                    "antonyms": [
                        "honesty",
                        "sincerity"
                    ],
                    "common_phrases": [
                        "by ruse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коварство, хитрость или обман в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "изворотливость, лукавство"
                            },
                            {
                                "target_lang_word": "лукавство",
                                "target_lang_sense_clarification": "склонность к хитрости и обману"
                            },
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "скрытая злонамеренность, хитрость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c8d6846-65ba-3f91-97ba-b237986bedae",
                    "sense_definition": "A turning or doubling back, especially of hunted animals to escape hunting dogs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fox tried every <w>ruse</w> it knew, doubling back through the stream to throw the hounds off its scent.",
                            "target_lang_translations": {
                                "ru": "Лиса испробовала все известные ей <w>уловки</w>, возвращаясь по своим следам через ручей, чтобы сбить гончих со следа."
                            }
                        },
                        {
                            "text": "The hunters were familiar with the animal's sudden <w>ruse</w> and anticipated its next move.",
                            "target_lang_translations": {
                                "ru": "Охотники были знакомы с внезапными <w>петлями</w> зверя и предугадывали его следующий шаг."
                            }
                        }
                    ],
                    "synonyms": [
                        "double",
                        "detour"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical hunting contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворот или бег назад по своим следам, особенно у преследуемых животных с целью запутать собак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скидка",
                                "target_lang_sense_clarification": "прыжок зверя в сторону для запутывания следов"
                            },
                            {
                                "target_lang_word": "петля",
                                "target_lang_sense_clarification": "круговой маневр зверя для запутывания следов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e00bc45-47c5-3901-b362-694b3b9f2122",
                    "sense_definition": "To deceive or trick someone using a ruse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attempted to <w>ruse</w> his opponents by pretending to retreat, but they did not fall for it.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>перехитрить</w> своих противников, притворившись, что отступает, но они на это не купились."
                            }
                        },
                        {
                            "text": "The clever negotiator managed to <w>ruse</w> the other party into accepting the unfavorable terms.",
                            "target_lang_translations": {
                                "ru": "Хитрому переговорщику удалось <w>обманом</w> заставить другую сторону принять невыгодные условия."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "deceive",
                        "outwit",
                        "bamboozle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used in modern standard English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмануть или перехитрить кого-либо с помощью уловки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перехитрить",
                                "target_lang_sense_clarification": "оказаться хитрее кого-либо"
                            },
                            {
                                "target_lang_word": "обмануть",
                                "target_lang_sense_clarification": "ввести в заблуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ce4663-811d-32a8-b7d8-f8a50f2d8e9a",
                    "sense_definition": "Of an animal: to turn or double back to elude hunters or hunting dogs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stag would <w>ruse</w> repeatedly through the thicket, making it nearly impossible for the hounds to follow.",
                            "target_lang_translations": {
                                "ru": "Олень то и дело <w>делал скидки</w> в зарослях, из-за чего гончим было почти невозможно идти по его следу."
                            }
                        },
                        {
                            "text": "Observing the prey <w>ruse</w> across its own tracks, the tracker realized they had lost the trail.",
                            "target_lang_translations": {
                                "ru": "Заметив, как добыча <w>петляет</w> по собственным следам, следопыт понял, что они потеряли след."
                            }
                        }
                    ],
                    "synonyms": [
                        "double",
                        "dodge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical hunting terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О животном: делать петли или возвращаться по своим следам, чтобы уйти от охотников или собак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать скидку",
                                "target_lang_sense_clarification": "прыгать в сторону, запутывая след"
                            },
                            {
                                "target_lang_word": "петлять",
                                "target_lang_sense_clarification": "запутывать следы, делая круги"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
