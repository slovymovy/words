                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbb48a1a-3d23-3f05-9dcf-2a66195c44ee",
                        "entry_id": "9ade7c09-3bf6-3740-9641-a3a606144cca",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord schot"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "58c71b85-005e-4fcb-bc04-e1a00c5ba57b",
                                "sense_id": "cbb48a1a-3d23-3f05-9dcf-2a66195c44ee",
                                "text": "Nog twee schoten weerkaatsten tussen de heuvels, harde knallen die de lucht doorboorden en vervolgens boven het bos in het niets verdwenen."
                            },
                            {
                                "example_id": "279f76ef-626c-401d-bd77-c8e7a32da602",
                                "sense_id": "cbb48a1a-3d23-3f05-9dcf-2a66195c44ee",
                                "text": "'De teerling is geworpen en in ons voordeel gevallen, en het verzet van het gepeupel en het kabaal van hun geschreeuw en hun schoten dat je overal hoort, heeft geen enkele zin."
                            },
                            {
                                "example_id": "fd45237e-a630-4408-8edc-d94b7af7a331",
                                "sense_id": "cbb48a1a-3d23-3f05-9dcf-2a66195c44ee",
                                "text": "Er was iets in de buurt wat me onrustig maakte, maar ik kon niet zo goed duiden wit, totdat de eerste schoten ons om de oren floten en Nadja en ik in de varens doken."
                            }
                        ]
                    },
                    {
                        "sense_id": "40890d75-9616-3ac7-95b3-1bb8426705b6",
                        "entry_id": "9ade7c09-3bf6-3740-9641-a3a606144cca",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord schoot"
                        ],
                        "tags": [
