                        "form": "Pipox"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fa26300-d2fa-38d3-91b2-557dc9d976b5",
                        "entry_id": "e07606ee-67ed-3f11-919d-a0ee2cb32c20",
                        "glosses": [
                            "entlegene Siedlung"
                        ],
