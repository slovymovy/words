                        "examples": [
                            {
                                "example_id": "1426508d-1c16-4b0d-8a7a-26f81991aecc",
                                "sense_id": "29a306fb-bc59-36fe-9d68-3edb9f8852f7",
                                "text": "Het is bijna te keutelig voor woorden, en dát van een vrouw die volgens een haar bewonderende biografe ‘te avontuurlijk en te onafhankelijk (was) om zoals haar “moesjes” een beetje kwijnend op een sofa te zitten.’"
                            },
                            {
                                "example_id": "d0f1a25c-5fba-4f36-9b30-7ec9df60a61c",
                                "sense_id": "29a306fb-bc59-36fe-9d68-3edb9f8852f7",
                                "text": "Een Voorbereiding is een ‘schandeboekje, zoo walgelijk keutelig als er misschien nog nooit één in druk is gegeven’."
                            }
                        ]
                    }
