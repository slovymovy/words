                                        "sense_id": "79d50263-ccf1-3682-a68f-a96d87e8cdeb",
                                        "entry_id": "d024a8de-87bc-3921-8875-cb611c1fa6bc",
                                        "glosses": [
                                            "Relatif aux Sarmates, peuple scythe de l'Antiquité."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4de693f9-f39f-4f22-aefd-dce9a26cd1dc",
                                                "sense_id": "79d50263-ccf1-3682-a68f-a96d87e8cdeb",
                                                "text": "D'après d'anciennes traditions, ce furent des peuples sarmates, habitant la Tauride (Crimée actuelle) ou la région de Kertch, riveraine de la mer d'Azov, qui, les premiers en Europe, apprirent à fabriquer des armes et des outils de fer."
                                            },
                                            {
                                                "example_id": "ec0a5ee6-5066-40b2-87a8-caae34ebe99b",
                                                "sense_id": "79d50263-ccf1-3682-a68f-a96d87e8cdeb",
                                                "text": "À son image les femmes sarmates allaient chasser à cheval « même sans les hommes », emportant armes et chevaux dans leur tombe, sans compter les hautes tiares insignes de leur magie, étranges hennins que portaient aussi parfois les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ebefa5-9090-39be-a384-d1d511f34a52",
                                        "entry_id": "d024a8de-87bc-3921-8875-cb611c1fa6bc",
                                        "glosses": [
                                            "Relatif à Sermaises, commune française située dans le département du Loiret."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
