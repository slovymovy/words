                "senses": [
                    {
                        "sense_id": "895d2926-c95f-3c06-9ec1-62e65f0f15ed",
                        "entry_id": "a7e77607-8533-38bc-b312-1039f94ab0ae",
                        "glosses": [
                            "in einem Medium erschienener Bericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238956e5-b62c-4664-b845-99e3d6d81072",
                                "sense_id": "895d2926-c95f-3c06-9ec1-62e65f0f15ed",
                                "text": "Laut Medienberichten soll es bei dem Flugzeugabsturz keine Überlebenden gegeben haben."
                            },
                            {
                                "example_id": "913a1c54-7fd0-4f78-a729-e06ca4b61b5c",
                                "sense_id": "895d2926-c95f-3c06-9ec1-62e65f0f15ed",
                                "text": "„Die Deutsche Telekom bestätigt einen Medienbericht, wonach persönliche Informationen über mehr als 30 Mio. Handy-Kunden eingesehen und manipuliert werden konnten.“"
                            },
                            {
                                "example_id": "87d46d4f-bd7a-49a8-aa5c-65b378f40dee",
                                "sense_id": "895d2926-c95f-3c06-9ec1-62e65f0f15ed",
                                "text": "„Laut einem Medienbericht kommt die Preissteigerung zwar später, könnte aber deutlich stärker ausfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
