                "senses": [
                    {
                        "sense_id": "ed870e17-5c84-364a-90a0-ade254303194",
                        "entry_id": "749f257c-7183-3234-ac7a-a423ca00d428",
                        "glosses": [
                            "разг. становиться твёрдым, онемелым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61cceef4-3663-42b0-9c0b-d24e38fbe544",
                                "sense_id": "ed870e17-5c84-364a-90a0-ade254303194",
                                "text": "От мороза у меня ноги совсем деревенеют."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2a61651-0055-4eb5-8086-be59f7152da3",
                        "source_entry_id": "749f257c-7183-3234-ac7a-a423ca00d428",
                        "source_sense_id": "ed870e17-5c84-364a-90a0-ade254303194",
                        "target_lang_word": "stiffen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiffen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef63093-b712-3397-825d-6af1702b6838",
                                        "entry_id": "80f72e0c-61b3-3f6b-8a58-1e722439cef2",
                                        "glosses": [
                                            "To make stiff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ac9996-233e-4801-819d-88827d746c36",
                                                "sense_id": "0ef63093-b712-3397-825d-6af1702b6838",
                                                "text": "Criminal prosecutions of abusers are generally the responsibility of local authorities, but the act stiffened sentences for stalking under federal law."
                                            },
                                            {
                                                "example_id": "c3bcae02-e628-4250-83cd-e275196a92bd",
                                                "sense_id": "0ef63093-b712-3397-825d-6af1702b6838",
                                                "text": "It followed a sequence of functions: a machine cuts cloth panels to be sewn, the panels are drenched with the polymer and stiffened, a robotic arm uses suction cups to lift each panel and position it in a sewing machine. Finally, the robotic arm lifts the stitched T-shirt off the sewing machine. […] The system could work for most fabrics, with the exception of leather and waterproof materials that can't be drenched with the stiffening polymer. […] Zornow has patents pending in 10 countries for the process to stiffen fabric."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2813331-304c-308a-9318-e78ec3db8038",
                                        "entry_id": "80f72e0c-61b3-3f6b-8a58-1e722439cef2",
                                        "glosses": [
                                            "To become stiff."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89719b0-d64c-4d42-84c8-007197c048ea",
                                                "sense_id": "f2813331-304c-308a-9318-e78ec3db8038",
                                                "text": "Bewildered by the unexpected greeting, my son stiffened, but managed a polite answer."
                                            },
                                            {
                                                "example_id": "4b44d791-4ea7-4972-a50d-69d4637b97d9",
                                                "sense_id": "f2813331-304c-308a-9318-e78ec3db8038",
                                                "text": "He does note that fascia, like most connective tissue in the body, stiffens with age, overuse and injury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1c24bbe-5fda-41f2-a211-706a1cb46e65",
