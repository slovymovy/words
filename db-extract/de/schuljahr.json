                ],
                "senses": [
                    {
                        "sense_id": "81a2e74e-26c4-3ca9-9b6b-9b4bc3b77184",
                        "entry_id": "b3b74627-6adb-3740-a7f8-e70fa5250de2",
                        "glosses": [
                            "Année scolaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41bfc4c-ab1c-4577-a717-06df9bafdff9",
                                "sense_id": "81a2e74e-26c4-3ca9-9b6b-9b4bc3b77184",
                                "text": "Am Ende des Schuljahres erhalten die Schüler ihre Zeugnisse.",
                                "translation": "À la fin de l’année scolaire, les élèves reçoivent leurs bulletins."
                            },
                            {
                                "example_id": "36dfb4bb-56e8-46bd-8a22-7f397c64a593",
                                "sense_id": "81a2e74e-26c4-3ca9-9b6b-9b4bc3b77184",
                                "text": "Ich war fünfzehneinhalb Jahre alt und musste vor allem die versäumten Schuljahre nachholen.",
                                "translation": "J’avais quinze ans et demi et je devais avant tout rattrapper les années scolaires manquées."
                            },
                            {
                                "example_id": "bb068c2b-34bc-462c-b1b4-66bb69cdcf3f",
                                "sense_id": "81a2e74e-26c4-3ca9-9b6b-9b4bc3b77184",
                                "text": "In dem Schreiben teilte uns die Schule lapidar mit, dass das Schuljahr bald vorbei sei.",
                                "translation": "Dans le document, il était écrit que l’année scolaire était bientôt finie."
                            }
                        ]
                    }
                ],
