                },
                {
                    "sense_id": "dc4debb8-314a-327d-8b50-d0c7ec5e87d2",
                    "sense_definition": "gibt das Werkzeug, Hilfsmittel oder Beförderungsmittel an, das für eine Handlung benutzt wird",
