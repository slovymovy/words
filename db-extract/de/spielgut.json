                "senses": [
                    {
                        "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                        "entry_id": "1ae76de1-0b57-3d1d-87dd-6c61100bd156",
                        "glosses": [
                            "Ansammlung von Spielmaterialien, Spielregeln, Spieltraditionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f85763-d94b-4c60-bca5-8a91e499e4db",
                                "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                                "text": "„Ich weiß auch, daß die persönlichen Spielerfahrungen nicht verallgemeinerbar sind, daß die Kinder in unserer Kultur heute zum Teil ganz andere Spiele spielen und die Kinder anderer Kulturen wieder ein anderes Spielgut haben.“"
                            },
                            {
                                "example_id": "03db98c9-f82d-4476-a8dd-2182253411b2",
                                "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                                "text": "„Beim Vergleich des Spielgutes mit Märchen, Sage, Lied und Tanz ergeben sich übereinstimmende Züge und Motive, die auf eine gemeinsame Wurzel hinweisen.“"
                            },
                            {
                                "example_id": "81ef2464-29c5-4c17-b045-db6a539e86c4",
                                "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                                "text": "„Spätestens ist jetzt kreatives Spielen gefragt; dieses stützt sich auf das Vermögen, fantasievoll mit Spielgut umzugehen.“"
                            },
                            {
                                "example_id": "1f8a7da5-8f6f-4f5a-a7d5-c3cc809e278d",
                                "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                                "text": "„Aber das ist doch Kitsch, das sind doch Karikaturen, so beantwortete eine Sprecherin des Arbeitsausschusses Spielgut die Frage, ob sie diese Püppchen mit ihrem Gütezeichen Spielgut auszeichnen würde.“"
                            },
                            {
                                "example_id": "db388128-5a28-4f0b-baae-80d3e0d61c11",
                                "sense_id": "8daefac9-9fb8-3dcc-81ed-b0e0daa1552e",
                                "text": "„Nebenher läuft, bzw. schließt sich an, eine Fülle von klang- und effektvollem modischem Spielgut wie Var., Phantasien, Rondos, für die sich seit der Jahrhundert-Wende steigender Bedarf einstellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
