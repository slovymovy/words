                "senses": [
                    {
                        "sense_id": "e35dc65b-4bf0-3188-8fb3-7e56334986a1",
                        "entry_id": "e22a41b1-d281-3865-a0c9-a53a69171dc3",
                        "glosses": [
                            "organische Fähigkeit zur Wahrnehmung von Geruchsinformationen und deren Verarbeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "357b4095-15b4-4d8f-9aaa-c56fc49bfffd",
                                "sense_id": "e35dc65b-4bf0-3188-8fb3-7e56334986a1",
                                "text": "„Riechstörungen (Dysosmien) sind Störungen des Geruchssinns. Diese können unterschiedlich stark ausgeprägt sein - von Verminderungen (Hyposmie) bis hin zu einem vollständigen Verlust des Riechvermögens (Anosmie).“"
                            },
                            {
                                "example_id": "53226854-f890-4d6f-9937-cc20469e5848",
                                "sense_id": "e35dc65b-4bf0-3188-8fb3-7e56334986a1",
                                "text": "„Wissenschaftler am Max-Planck-Institut für chemische Ökologie in Jena haben dazu gemeinsam mit Kollegen aus Japan das Riechvermögen von gezüchteten Bombyx mori Motten mit dem ihrer wildlebenden, nächsten Verwandten verglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
