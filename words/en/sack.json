                },
                {
                    "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                    "sense_definition": "Dismissal from employment or discharge from a position.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was afraid he would get the <w>sack</w> for being late so often.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что получит <w>расчёт</w> за частые опоздания.",
                                "zh": "他很担心因为经常迟到而被<w>解雇</w>。"
                            }
                        },
                        {
                            "text": "The manager threatened to give him the <w>sack</w> if his performance did not improve.",
                            "target_lang_translations": {
                                "ru": "Менеджер пригрозил ему <w>увольнением</w>, если его показатели не улучшатся.",
                                "zh": "经理威胁说如果他的表现再不改善，就将他<w>解雇</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dismissal",
                        "discharge",
                        "the axe",
                        "the boot"
                    ],
                    "common_phrases": [
