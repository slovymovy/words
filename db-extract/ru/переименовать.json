                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4539ea-56d8-4823-9a70-8aa640ba1114",
                                                "sense_id": "2d373140-a481-3bcd-9e10-370635e32adc",
                                                "text": "Le navire polaire « Gustav Holm » fut rebaptisé momentanément le « Groenland » ; […]."
                                            },
                                            {
                                                "example_id": "d7a033c0-b466-449d-9f96-7b87e7904b35",
                                                "sense_id": "2d373140-a481-3bcd-9e10-370635e32adc",
                                                "text": "Zinoviev préside l'Internationale communiste et le Soviet de Pétrograd qu'il rebaptise Léningrad."
                                            },
                                            {
                                                "example_id": "67f54c39-4aed-4311-ad36-6dd9123b2cee",
                                                "sense_id": "2d373140-a481-3bcd-9e10-370635e32adc",
                                                "text": "Pour commencer, dit Luc, dans un joli minibus vert, le guide à l'accent gaga nous a emmenés, forcément, à Geoffroy-Guichard, qu'il a rebaptisé « le ventre de l’ASS »."
                                            },
                                            {
                                                "example_id": "c6225025-fd62-4d68-8260-237b612de807",
                                                "sense_id": "2d373140-a481-3bcd-9e10-370635e32adc",
                                                "text": "Le taxieur prend soudain à gauche et s'engage dans l'avenue de France, fraîchement rebaptisée avenue Mohamed VI, avec l'intention de mener en bateau son passager et lui donner ainsi le temps de terminer son histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46d5b03-1956-37a7-bb80-3d79c0f04fb1",
                                        "entry_id": "ab9d5113-85fd-336f-a56e-820a657a67f5",
                                        "glosses": [
                                            "Baptiser une seconde fois."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b630ef-5347-40d2-bc98-d7c87ad55414",
                                                "sense_id": "a46d5b03-1956-37a7-bb80-3d79c0f04fb1",
                                                "text": "Certaines sectes rebaptisent ceux qui passent d’une autre communion chrétienne dans la leur."
                                            }
                                        ]
                                    }
