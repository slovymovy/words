                        "examples": [
                            {
                                "example_id": "5ed1cb22-e6d8-483d-9898-923742c49cb2",
                                "sense_id": "917e40ba-5a7e-3c41-8cf1-1f68743529ab",
                                "text": "Взъемлют с нищих за крещение, Грабят с больных за причастие."
                            },
                            {
                                "example_id": "bbc8535b-fb19-42e8-8aab-42b6c6593406",
                                "sense_id": "917e40ba-5a7e-3c41-8cf1-1f68743529ab",
                                "text": "От многих же совсем и ничего не взъемлю; // Мне бог невидимо прещедрый воздает // И с лишком пятьдесят меня питает лет."
                            }
                        ]
                    }
