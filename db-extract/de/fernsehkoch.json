                                "example_id": "18388000-310c-4b68-b1fc-21fc49bbf3c8",
                                "sense_id": "9a573e1c-2419-35eb-919f-53a85ff3a55d",
                                "text": "Oftmals können Fernsehköche den interessierten Zuschauern wertvolle Tipps geben."
                            }
