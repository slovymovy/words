                                "target_senses": [
                                    {
                                        "sense_id": "2ad31256-882d-37c9-bdbe-425ae8643873",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "So as to be generally favored or accepted by the people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "commonly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d858b2-9ad9-4139-b7cc-0484b4fc082b",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "They were popularly known as \"the Kings of California\""
                                            },
                                            {
                                                "example_id": "bf5347e0-9f93-465b-ac63-5529d7abfb60",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "Officially the Nordland Railway begins at Hell, but popularly the whole route north of Trondheim is so called."
                                            },
                                            {
                                                "example_id": "0324245b-d4b4-4ae7-b298-790c38384343",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "[T]he Oligocene's signature species were an unsavoury group of pigs and pig-like creatures, foremost among which were the entelodonts, more popularly known as hell pigs, or terminator pigs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35b4b98-0e79-3d40-8a78-2a03467a32ae",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "currently"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa3f5317-d816-4c55-b62c-2bcff0ba55ab",
                        "source_entry_id": "e6208e97-8d9d-3724-aaa2-fe13f779e237",
                        "source_sense_id": "b73d36ed-d1b1-393d-bfab-b531502689d5",
                        "target_lang_word": "populárně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b6cad4e-ed7b-44aa-b887-9a9d960a038c",
                        "source_entry_id": "e6208e97-8d9d-3724-aaa2-fe13f779e237",
                        "source_sense_id": "b73d36ed-d1b1-393d-bfab-b531502689d5",
                        "target_lang_word": "populär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                        "entry_id": "94f98e7f-cfd0-3c37-9995-fb7ef27dabaa",
                                        "glosses": [
                                            "in der Öffentlichkeit bekannt und beliebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae869a4-3970-4d75-86fd-c50510aa5f14",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "Die japanische Küche wird ja sowieso immer populärer."
                                            },
                                            {
                                                "example_id": "bb70b862-8c3b-4d65-a30e-90973edcb599",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "Eigentlich wurde diese Art zu kochen erfunden, als in der Taisho-Ära, die 1912 begann, nach einer langen Phase der Abschottung westliche Essgewohnheiten in Japan populär wurde."
                                            },
                                            {
                                                "example_id": "091a6479-2335-4ffd-a22b-0c311f078381",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "f7f5d6fb-2a4a-4279-ac76-1554f5247dc1",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "„Die erste populäre Handlung der Regierung ist die Beschlagnahme der gehamsterten Lebensmittel, es bleibt bei der Beschlagnahme.“"
                                            },
                                            {
                                                "example_id": "7dc1a506-f9b9-46ce-9b68-0e01ff639a1b",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "„Janoschs schelmische Geschichten wurden immer populärer.“"
                                            },
                                            {
                                                "example_id": "7e842b5b-4584-46eb-aa5d-43c9663589d9",
                                                "sense_id": "e3e898b6-0986-3ad0-849c-2b90ce8226a7",
                                                "text": "„Neben Beschränkungen der Sportarten selbst beispielweise war das im Westen, aber auch in Polen und der Tschechoslowakei sehr populäre Drachenfliegen in der DDR verboten, wurden manche der stadtnahen Flugplätze wie Saarmund und Eggersdorf willkürlich wegen Fluchtgefahr geschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "840f506f-64bf-3e3d-a63c-ac264ddf6be5",
                                        "entry_id": "94f98e7f-cfd0-3c37-9995-fb7ef27dabaa",
                                        "glosses": [
                                            "ohne Fachwissen verständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190f4d4f-1061-4d55-b6ec-45afb915e75f",
                                                "sense_id": "840f506f-64bf-3e3d-a63c-ac264ddf6be5",
                                                "text": "Professor Harald Lesch schreibt neben seiner wissenschaftlichen Arbeit populäre Sachbücher über Astronomie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b10e519-4735-4b36-a5e1-9cdabb27a097",
                        "source_entry_id": "e6208e97-8d9d-3724-aaa2-fe13f779e237",
                        "source_sense_id": "b73d36ed-d1b1-393d-bfab-b531502689d5",
