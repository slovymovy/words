                    "sense_definition": "Accord, réconciliation ou entente diplomatique entre des personnes, des groupes ou des États autrefois en conflit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les négociations ont permis d'amorcer un <w>rapprochement</w> historique entre les deux pays voisins."
