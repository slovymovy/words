                "senses": [
                    {
                        "sense_id": "ada69749-2e5b-35cb-a066-2f4218416a66",
                        "entry_id": "ecb77df2-fe8a-33e3-a185-ae78865c6713",
                        "glosses": [
                            "das dichte, einkreisende Umringen einer versammelten Personengruppe durch Polizeikräfte, um eine (mutmaßlich) von dieser ausgehende Gefahr (beispielsweise eine Straßenschlacht) zu unterbinden oder einzudämmen beziehungsweise die Gruppe zu kontrollieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d35c8c-fbf6-4a32-8f89-b7d87c77d80b",
                                "sense_id": "ada69749-2e5b-35cb-a066-2f4218416a66",
                                "text": "„Im Nachgang zu Polizeikesseln kommt es immer wieder zu juristischen Nachspielen, da Betroffene sich gegen die Einkesselung juristisch zur Wehr setzen.“"
                            },
                            {
                                "example_id": "137fc214-932c-4770-91ad-2e729773ef5e",
                                "sense_id": "ada69749-2e5b-35cb-a066-2f4218416a66",
                                "text": "„›Der Polizeikessel diente eindeutig der Einschüchterung‹, so Hebel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "758629f4-e926-4e03-9f74-72a1c7490a1b",
                        "source_entry_id": "ecb77df2-fe8a-33e3-a185-ae78865c6713",
                        "source_sense_id": "ada69749-2e5b-35cb-a066-2f4218416a66",
                        "target_lang_word": "kettling",
