                        "sense_id": "1518c9f2-c917-3ce4-88c8-b29e10fa35e3",
                        "entry_id": "8f8b14b5-0abc-360c-9aa7-f59393241535",
                        "glosses": [
                            "de ruimte waar passagiers (meestal van vliegtuigen) aankomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8946a9cc-acc4-4280-bf34-a506ff623c57",
                                "sense_id": "1518c9f2-c917-3ce4-88c8-b29e10fa35e3",
                                "text": "We stonden te wachten in de aankomsthal op onze opa en oma die van een wereldreis terugkwamen."
                            },
                            {
                                "example_id": "3962d675-717d-4181-8d9e-2404fab20b63",
                                "sense_id": "1518c9f2-c917-3ce4-88c8-b29e10fa35e3",
                                "text": "Schiphol en GGD Kennemerland gaan op korte termijn de door het kabinet aangekondigde Covid-19-teststraat inrichten op de luchthaven. Die komt bij aankomsthal 3, meldt Schiphol."
                            },
                            {
                                "example_id": "c8d27faa-b058-43a7-8511-ecc11c98d8d7",
                                "sense_id": "1518c9f2-c917-3ce4-88c8-b29e10fa35e3",
                                "text": "De personeelstekorten op luchthaven Schiphol zijn nu ook zichtbaar in de aankomsthallen waar inmiddels grote hoeveelheden koffers liggen die zijn gescheiden van hun eigenaar. Dat komt doordat er ook personeelstekorten zijn bij de bedrijven die verantwoordelijk zijn voor het zogenoemde afhandelen van de koffers."
                            }
                        ]
                    }
