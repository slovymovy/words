                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2badd6-f37a-4a8f-8afc-3c5b548db427",
                                "sense_id": "3d2ae3e9-1fd1-3892-a041-2d6f3c650117",
                                "text": "Eigenaren Gabriël Mutlu en Peter Soet zetten eerst warm brood met oosterse tapenade, tzatziki en kruidenboter op tafel. Alles is vers bereid."
                            },
                            {
                                "example_id": "ddb53deb-4c10-4c67-901d-7a8a0e233d0e",
                                "sense_id": "3d2ae3e9-1fd1-3892-a041-2d6f3c650117",
                                "text": "Maak de salsa: verwijder het vruchtvlees van de gezouten citroenen. Doe de schil met de olijven, de komijn en de tijm in het bakje van de staafmixer en draai tot een grove tapenade. Voeg als u wilt wat pittigheid toe."
                            }
                        ]
