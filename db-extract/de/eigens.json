                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                        "entry_id": "e2652ea0-6bfe-3fe6-bbeb-3da1993c5fc2",
                        "glosses": [
                            "besonders für diesen Menschen oder für diesen Zweck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68371d1c-757d-48a7-9ed4-b22e8f283fa3",
                                "sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                                "text": "Das habe ich eigens für dich getan."
                            },
                            {
                                "example_id": "87eb3566-061d-42c9-a52e-65a4441a8d47",
                                "sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                                "text": "„Sichtlich nervös ist er, während links neben ihm am Mikrofon der junge König der Belgier spricht, das Oberhaupt der alten Kolonialmacht, eigens angereist aus seinem Heimatland.“"
                            },
                            {
                                "example_id": "3391c40c-2979-4f5b-9683-e8579ee64024",
                                "sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                                "text": "„Der Vater saß auf seinem gewohnten Platz neben dem Ofen, den die Mutter eigens für uns angemacht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25fe0d43-bac2-4924-9e00-cc7c12a9682c",
                        "source_entry_id": "e2652ea0-6bfe-3fe6-bbeb-3da1993c5fc2",
                        "source_sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                        "source_sense_description": "besonders für diesen Menschen oder für diesen Zweck",
                        "target_lang_word": "particularly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particularly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00af5e4a-b806-361d-a03c-51050f2a52a4",
                                        "entry_id": "23a7e7ca-aa3c-36ac-b193-c59feedfe64f",
                                        "glosses": [
                                            "Especially, extremely."
                                        ],
                                        "tags": [
                                            "focus",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa5332f-ccad-46a3-b707-57670077251a",
                                                "sense_id": "00af5e4a-b806-361d-a03c-51050f2a52a4",
                                                "text": "The apéritifs were particularly stimulating."
                                            },
                                            {
                                                "example_id": "ba581c23-ce0c-4080-aeb0-34393871f97f",
                                                "sense_id": "00af5e4a-b806-361d-a03c-51050f2a52a4",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner."
                                            },
                                            {
                                                "example_id": "428dd2e1-9cc6-4c45-a12a-a75a49ae4a56",
                                                "sense_id": "00af5e4a-b806-361d-a03c-51050f2a52a4",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2477d1-1921-3096-ae70-481552716dd9",
                                        "entry_id": "23a7e7ca-aa3c-36ac-b193-c59feedfe64f",
                                        "glosses": [
                                            "To a great extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23814b65-6c1c-3fde-85db-0a06d6b19328",
                                        "entry_id": "23a7e7ca-aa3c-36ac-b193-c59feedfe64f",
                                        "glosses": [
                                            "Specifically, uniquely or individually."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bdfd9a8-7720-4036-b0c8-5ed4622606dc",
                                                "sense_id": "23814b65-6c1c-3fde-85db-0a06d6b19328",
                                                "text": "But as the half progressed, Liverpool's pressure and high-tempo passing game increased United's frustration and it threatened to boil over on the stroke of half-time when Van Persie, who had already been booked, was involved in angry verbal exchanges with several Liverpool players, particularly Gerrard."
                                            },
                                            {
                                                "example_id": "d08356d4-8ed0-4829-bb9b-a81f2c904163",
                                                "sense_id": "23814b65-6c1c-3fde-85db-0a06d6b19328",
                                                "text": "[Minnesota Senator Steve] Daines isn’t the only example of right-wing politicians who wish to wield anti-Semitism as a convenient cudgel against their political enemies, with scant if any evidence. But Montana’s vanishingly small Jewish population makes it particularly clear that this strategy has little to do with flesh-and-blood Jews at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef735fe-2122-3af0-b48d-4367c8d126b9",
                                        "entry_id": "23a7e7ca-aa3c-36ac-b193-c59feedfe64f",
                                        "glosses": [
                                            "In detail; with regard to particulars."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaaca1be-9bd5-3b77-ba6a-a03eaa9daeaf",
                                        "entry_id": "23a7e7ca-aa3c-36ac-b193-c59feedfe64f",
                                        "glosses": [
                                            "In a particular manner; fussily."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95bb75a6-8e70-44df-acc6-4eb6aff3c440",
                                                "sense_id": "eaaca1be-9bd5-3b77-ba6a-a03eaa9daeaf",
                                                "text": "He, rather too particularly perhaps, avoids public company, and is the very reverse of a bon vivant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ce3f99d-7076-4d18-8ac1-5ef31360bb73",
                        "source_entry_id": "e2652ea0-6bfe-3fe6-bbeb-3da1993c5fc2",
                        "source_sense_id": "76da35f4-4020-345b-b314-07f68f5487a8",
                        "source_sense_description": "besonders für diesen Menschen oder für diesen Zweck",
                        "target_lang_word": "exprès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                        "entry_id": "e066ebd1-5ea7-3dd7-9f50-2f31e15377e4",
                                        "glosses": [
                                            "Qui est énoncé d’une manière formelle et impérative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14456bde-5afa-492c-9359-46cf4e10068e",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Ce soin ne peut être réalisé qu’avec le consentement exprès du patient."
                                            },
                                            {
                                                "example_id": "ea7cab68-246d-454c-9b0b-1a5f7d6b8cce",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Monsieur, il s’agit de réformes dans l’état, et nullement de révolutions ; il s'agit d’améliorer, et non d’innover en quoi que ce soit : c’est la teneur expresse de nos cahiers."
                                            },
                                            {
                                                "example_id": "c176f44f-67e7-4ac5-8030-b87dc2754f33",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Il est de toute évidence qu’il eût fallu, au contraire, accorder aux tuberculeux des surpensions, à la condition expresse qu’ils se résignassent à la claustration du sanatorium."
                                            },
                                            {
                                                "example_id": "97f2586f-3226-4ecd-ab99-b793e7f79d07",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "– Tout ce qui a été fait, dit-elle, l’aura toujours été selon les volontés expresses de votre belle-fille."
                                            },
                                            {
                                                "example_id": "f587d5f1-8955-4ea8-96de-2f0e07a70f7e",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "« L’affirmation et l’opiniâtreté sont signes exprès de bêtises », écrit Montaigne, et je le croirais, mais j’aurais préféré que sa phrase fût un peu moins… affirmative."
                                            },
                                            {
                                                "example_id": "d48983ed-d8ce-41db-a073-b569f70b7bbd",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Mais il avait aussi l’ordre exprès de veiller à ce que les indigènes conservassent leurs oripeaux quoi qu’il advînt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                        "entry_id": "76562636-ff31-3c52-b127-88a05633952a",
                                        "glosses": [
                                            "Avec intention formelle et délibérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1daad3-ad3f-4947-9c83-a24646a33812",
                                                "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                                "text": "C’est un recueil de ses chroniques théâtrales avec une préface de Courteline. J’y rencontre des pages de maître, noyées exprès dans un flot d’outrance volontaire et préméditée."
                                            },
                                            {
                                                "example_id": "275588f5-5df0-4507-927d-ffc7a1f09908",
                                                "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                                "text": "Il n’accusait point les clous de se tordre exprès, ni le bois de se fendre, ni le plâtre du mur d’éclater par morceaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                        "entry_id": "fea96457-6088-3dd3-8f1e-66194afde234",
                                        "glosses": [
                                            "Personne chargée d’acheminer une lettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1694a5-2120-49bc-87bf-7052d69b0aa6",
                                                "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                                "text": "Cependant l’exprès berrichon qui, de la Châtre, où M. Harley avait relayé et rédigé ses lettres pour Boussac, était venu au petit trot (en une grande journée) remplir ce bizarre message, avait, conformément à ses instructions, demandé à parler à mademoiselle Jane."
                                            },
                                            {
                                                "example_id": "f742d721-db23-4ce5-a972-037e98349f10",
                                                "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                                "text": "Quelques jours plus tard, un exprès, accouru d’Orsel à toute bride, remit à Dominique une lettre cachetée de noir dont la lecture le bouleversa, lui, si parfaitement maître de ses émotions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                        "entry_id": "fea96457-6088-3dd3-8f1e-66194afde234",
                                        "glosses": [
                                            "Lettre reçue par livraison rapide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c731ce7-e6b4-4260-9de7-7dc0edf5a2cf",
                                                "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                                "text": "Je viens de recevoir un exprès dans ma boîte postale."
                                            },
                                            {
                                                "example_id": "9b4b66b9-a4ec-43a4-b225-3a8df97843cc",
                                                "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                                "text": "Je me hâte d’envoyer un exprès à Mylady, afin qu’elle me donne les ordres néceſſaires pour un cas auſſi urgent, je n’en écrirai pas davantage pour ne pas retarder le départ de l’exprès."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                        "entry_id": "d7411368-330c-327b-a0dd-267cd1ef2fae",
                                        "glosses": [
                                            "Celui qui est envoyé spécialement pour porter ou pour recevoir des lettres, des nouvelles, des ordres, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e259d2e1-5b82-4cf5-ab70-66f712e85021",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "M. Philippe, le fils du banquier, poussa même la complaisance jusqu’à prévenir par un exprès M. Tournevau, emprisonné dans sa famille."
                                            },
                                            {
                                                "example_id": "7ae64ca7-8271-4db7-b0ce-3abed295a000",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "Très juste, dit le président, qui dépêcha aussitôt un exprès à tous ces personnages."
                                            },
                                            {
                                                "example_id": "a475bc96-6944-4bc9-b40e-3f377a7aae38",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "Une heure après sa mort, l’exprès était parti, et, plus heureux que ses deux prédécesseurs, il était, vers la fin du cinquième jour, arrivé à Louesche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
