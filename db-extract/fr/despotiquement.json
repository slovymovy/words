                "senses": [
                    {
                        "sense_id": "107ba9f9-73cf-3cdb-8859-3617f73a82ec",
                        "entry_id": "871d106e-b271-3e49-88c3-7f1c37e59dc2",
                        "glosses": [
                            "D’une manière despotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c6f32f-580c-45d1-b670-34d21917b07b",
                                "sense_id": "107ba9f9-73cf-3cdb-8859-3617f73a82ec",
                                "text": "… , s'il existe un homme pervers qui veuille dominer despotiquement les représentants du peuple, sa tête tombera aussitôt qu'il sera démasqué."
                            },
                            {
                                "example_id": "23c39561-a73f-4a2f-a73e-3df340ab9339",
                                "sense_id": "107ba9f9-73cf-3cdb-8859-3617f73a82ec",
                                "text": "Elle administrait despotiquement, sans supporter le moindre empiétement, le petit empire de son intérieur, et se montrait néanmoins fort soumise à son mari dans tout ce qui touchait les questions graves, les affaires, comme disait M. Lescalle."
                            }
                        ]
                    }
