                                                "sense_id": "9d738664-1ee1-3ef3-8a2e-cd7ea72ec7bc",
                                                "text": "A solar eclipse is one of nature's most impressive sights."
                                            },
                                            {
                                                "example_id": "b5e30ea3-40b7-45a0-ae3f-ab3263e1bfaf",
                                                "sense_id": "9d738664-1ee1-3ef3-8a2e-cd7ea72ec7bc",
                                                "text": "The earliest reliable accounts of Chinese eclipses come from Spring and Autumn Annals (Ch’un-ch’iu), recording eclipses from 772 to 481 BCE, including a total solar eclipse in 709 BCE."
                                            }
