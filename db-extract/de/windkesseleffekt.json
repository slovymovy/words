                ],
                "senses": [
                    {
                        "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                        "entry_id": "30961708-dd9a-36a6-ac5b-5da11b33b1b5",
                        "glosses": [
                            "Druckausgleich durch die Elastizität der herznahen Arterien (vor allem der Aorta), wodurch die starke Druckdifferenz zwischen Systole (Phase des Blutauswurfs durch Kontraktion des Herzmuskels) und Diastole (Entspannung des Herzmuskels) verringert wird"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "eaf8b9fb-db20-4779-965d-d8538654e1eb",
                                "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                                "text": "„Zuletzt sind auch noch Auswirkungen auf die Aorta denkbar, da die Hauptschlagader (Aorta) bei jedem Herzschlag den Druck ‚auffangen‘ und weiterleiten muss (Windkesseleffekt).“"
                            },
                            {
                                "example_id": "b6fde5e6-7e64-4ab7-8e31-8cfd524926ac",
                                "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                                "text": "„Der Windkesseleffekt unterstützt die Fortleitung der Herzkraft in die Peripherie und dient dem kontinuierlichen Weitertransport des Blutes, dessen Strom sonst durch den Reibungswiderstand der Gefäßwände allmählich zumStillstand käme.“"
                            },
                            {
                                "example_id": "f5d04df3-e112-4b3f-8424-f163b950980f",
                                "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                                "text": "„Durch den Windkesseleffekt der Aorta ist ein geringerer systolischer Druck erforderlich, die Diastole fällt nicht soweit ab und es findet Durchblutung während der Diastole statt.“"
                            },
                            {
                                "example_id": "fbd40aaf-98a3-47da-bcbc-7f1242ed1d3f",
                                "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                                "text": "„Das Herz pumpt das Blut durch die Aortenwurzel in einen Druckbehälter, der die Aufgabe hat, die Elastizität der Aorta und der nachfolgenden Blutgefäße (Windkesseleffekt) nachzubilden.“"
                            },
                            {
                                "example_id": "4f09e7d4-b573-4bc5-89d9-4a8203ef63cc",
                                "sense_id": "38b6595a-3c2e-3e9f-bd37-0fcea1f57c6c",
                                "text": "„Dieser als Windkesseleffekt bekannte Vorgang reduziert insbesondere die geschwindigkeitsproportionalen Reibungsverluste des Blutkreislaufs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
