                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
                        "entry_id": "198797fd-2996-3df2-93af-a8361621ad6f",
                        "glosses": [
                            "de voortplanting van klank in een besloten ruimte en de ervaring die deze voortplanting bezorgd aan de luisteraar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6fb3cb-f3d7-41be-82b3-8826d00a2cac",
                                "sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
                                "text": "De akoestiek van een ruimte kan vaak verbeterd worden door de wanden met speciale materialen te bekleden."
                            },
                            {
                                "example_id": "5b455432-79e0-45da-823c-e78fc5a99d16",
                                "sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
                                "text": "Met 10.000 vierkante meter en een capaciteit van 10.000 personen is deze groot genoeg en hij voldoet ook qua akoestiek (‘zelfs Madonna klinkt hier goed’, aldus een medewerkster van de evenementenlocatie) en logistiek. „De Randstad zit toch al vol”, zegt hij. „We moeten groot durven denken. Waarom zou het hier niet kunnen? We hebben ruimte genoeg.”"
                            },
                            {
                                "example_id": "38d54410-6992-46a2-ba82-b4564a517d1d",
                                "sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
                                "text": "Hier ziet ze hoe het beton de menselijke stemmen en de gehele akoestiek van een lichaam opslokt."
                            },
                            {
                                "example_id": "7de950ca-eb62-4787-8e0f-e011f15ec38a",
                                "sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
                                "text": "Niet denken aan de holle akoestiek die, ondanks de kussentjes en de kleedjes, niet verdwijnt en die mijn telefoonstem doet echoën in mijn oor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7e0ede9-324c-436a-9ffd-ac006074358e",
                        "source_entry_id": "198797fd-2996-3df2-93af-a8361621ad6f",
                        "source_sense_id": "d9d9f314-b28e-3870-96e9-7435a7322a8d",
