                ],
                "senses": [
                    {
                        "sense_id": "b96ca878-f7a5-39d0-8a12-d921ed94cbc9",
                        "entry_id": "6e700e33-47de-31a3-af30-26ca7b94b024",
                        "glosses": [
                            "Mandat de sept ans ; exercice d’une charge dont la durée est de sept ans ; durée de sept ans d’une magistrature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82975bb-f363-4e08-a088-e32653d6a265",
                                "sense_id": "b96ca878-f7a5-39d0-8a12-d921ed94cbc9",
                                "text": "Le septennat du Président de la République française est devenu un quinquennat après un référendum en l'an 2000."
                            }
                        ]
                    },
                    {
                        "sense_id": "7134d3b7-9492-3583-a127-2a20d37e5f44",
                        "entry_id": "6e700e33-47de-31a3-af30-26ca7b94b024",
                        "glosses": [
                            "Mandat du président de la République française, de 1873 à 2002."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7579f75c-4674-4daa-ab00-da01562771bd",
                                "sense_id": "7134d3b7-9492-3583-a127-2a20d37e5f44",
                                "text": "Le 19 novembre la loi suivante fut votée: Article premier. Le pouvoir exécutif est confié pour sept ans au maréchal Mac-Mahon à partir de la promulgation de la présente loi. Ce pouvoir continuera d'être exercé sous le titre de Président de la République […]. Ainsi fut institué le Septennat; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b3d5cf5-d82a-441b-86e7-aee3247149a4",
                        "source_entry_id": "6e700e33-47de-31a3-af30-26ca7b94b024",
