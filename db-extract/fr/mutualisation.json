                        "entry_id": "a0b760e0-80ad-3ccf-8c7d-0bf783d12969",
                        "glosses": [
                            "Transformation d’une compagnie d’assurance-vie, ou d’une société par actions en compagnie ou société mutuelle, par le rachat de ses propres actions."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "df5c43bb-17a7-30c9-9817-91fc5dc5666b",
                        "entry_id": "a0b760e0-80ad-3ccf-8c7d-0bf783d12969",
                        "glosses": [
                            "Mise en commun de moyens, afin souvent de réduire les coûts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7351d31f-27b3-4c08-9984-389ffa9c6287",
                                "sense_id": "df5c43bb-17a7-30c9-9817-91fc5dc5666b",
                                "text": "Un espace de mutualisation de fichiers et d’échanges est à disposition des enseignants qui scolarisent des élèves handicapés."
                            }
                        ]
                    },
                    {
                        "sense_id": "054f42da-4ab7-34aa-ab5d-a99d70a86d50",
                        "entry_id": "a0b760e0-80ad-3ccf-8c7d-0bf783d12969",
                        "glosses": [
                            "Mise en commun de coûts, de risques afin d’en répartir la charge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65640580-5530-42b3-a56a-cb6b2118a92c",
                                "sense_id": "054f42da-4ab7-34aa-ab5d-a99d70a86d50",
                                "text": "Après cinq ans d’expérimentation, un bilan positif a été établi, montrant l’efficience de ce modèle de mutualisation en milieu hyperrural."
                            }
                        ]
                    }
