                        ],
                        "examples": [
                            {
                                "example_id": "d3cba26f-39fc-42b8-ad0a-d8dc06aa93a2",
                                "sense_id": "3b531597-c3cc-3244-bf09-ad7a22d8e906",
                                "text": "I used to fancy my revolver shooting when I was with the colours, and if I do get a chance I’ll put a shot through the old hunks, if only to prove to you that I’m no liar."
                            },
                            {
                                "example_id": "3fc3834e-6578-454b-8c77-1ef06afe7e00",
                                "sense_id": "3b531597-c3cc-3244-bf09-ad7a22d8e906",
                                "text": "Now, Bildad, I am sorry to say, had the reputation of being an incorrigible old hunks, and in his sea-going days, a bitter, hard task-master."
                            }
                        ]
                    },
