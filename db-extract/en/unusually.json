                                "target_senses": [
                                    {
                                        "sense_id": "66e8246b-bf32-35d3-9fd1-4770bdf55013",
                                        "entry_id": "05e7f462-4d22-3bf8-97d9-42c339bd12af",
                                        "glosses": [
                                            "D'une manière inhabituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775defba-3926-4124-aa28-3e5b1d046306",
                                                "sense_id": "66e8246b-bf32-35d3-9fd1-4770bdf55013",
                                                "text": "Après un trajet de vingt minutes se dessina devant lui la silhouette de la petite ville de Saint-Laurent-Nouan, inhabituellement sombre en cette nuit, sans lumière aux fenêtres ni éclairage public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5615259-9880-4fbd-97ee-0f49b1a8d19d",
                        "source_entry_id": "965f5e2b-8fa3-3ded-80fa-7d7b73b47b72",
                        "source_sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                        "source_sense_description": "in an unusual manner",
                        "target_lang_word": "étrangement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                        "entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                                        "glosses": [
                                            "D'une manière étrange ; bizarrement, étonnamment, de manière peu commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f922f6-f230-486b-b715-2fed1c9550bf",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; […]."
                                            },
                                            {
                                                "example_id": "810ed90e-05ac-4013-9cd6-2769f947e1d0",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                                            },
                                            {
                                                "example_id": "cf56dc80-e5ed-4f66-b9d7-71144ee10f49",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec358cac-6bda-41be-8285-65751c501cb0",
                        "source_entry_id": "965f5e2b-8fa3-3ded-80fa-7d7b73b47b72",
                        "source_sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                        "source_sense_description": "in an unusual manner",
                        "target_lang_word": "étonnamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étonnamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                        "entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                                        "glosses": [
                                            "D’une manière étonnante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d3bd58-4217-4bcf-8bac-754782e3f78c",
                                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                                "text": "Elle a eu une crise affreuse ; mais elle va étonnamment bien à présent."
                                            },
                                            {
                                                "example_id": "487acc96-0f76-4ee7-a47c-a672812c71e2",
                                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                                "text": "Il était d’une grande urbanité d’autrefois, ainsi que le maître de maison lui-même, s’effaçait devant tout le monde et subissait étonnamment les raseurs."
                                            },
                                            {
                                                "example_id": "eae2862a-e3e3-4191-a60d-baf8b5026f69",
                                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                                "text": "C’était étonnamment moins difficile parce qu’il s'agissait de l’histoire d'Adréa Bescond et qu’elle était sur le plateau, me donnant l’impression d’aider à faire comprendre ce qu’elle a vécu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aeaf231-bbb3-42e3-9202-8e013ec4a57d",
                        "source_entry_id": "965f5e2b-8fa3-3ded-80fa-7d7b73b47b72",
                        "source_sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                        "source_sense_description": "in an unusual manner",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
