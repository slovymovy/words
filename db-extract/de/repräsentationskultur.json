                ],
                "senses": [
                    {
                        "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                        "entry_id": "2aa599f5-6645-3f63-a6e5-9f18bad64e39",
                        "glosses": [
                            "Art und Weise der kulturellen Repräsentation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253d6d02-a7d3-4df9-8db3-957625cb7ea7",
                                "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                                "text": "„Die Chance dafür bestehe, da Berlin - \"ob es will oder nicht\" - auf Jahre \"der Repräsentationskultur verpflichtet\" sei.“"
                            },
                            {
                                "example_id": "7d58a372-7272-4cd8-a3bb-908e0d367818",
                                "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                                "text": "„Dafür fährt man (mit Ehrenkarten) besser nach Bayreuth oder Salzburg, dort herrscht wahre Repräsentationskultur, der luxuriösen Spielstätte politischer Kultur, ausgelegt mit gesellschaftlichem Parkett, das dann freilich auch die Allgemeinheit etwas kosten darf.“"
                            },
                            {
                                "example_id": "876a1c9b-6c9b-4ff4-96b5-0ee74a9b5217",
                                "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                                "text": "„Mit Repräsentationskultur - vom Musikantenstadl bis zum Symphoniekonzert - haben diese \"Leute\" nichts am Hut.“"
                            },
                            {
                                "example_id": "83fe683c-ba05-4614-83f8-98a9e3856584",
                                "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                                "text": "„In den vergangenen Jahren konnte man sich des tristen Eindrucks kaum erwehren, dass früher oder später alle ökonomischen Basisdaten der österreichischen Repräsentationskultur in einem tiefen schwarzen Loch landen.“"
                            },
                            {
                                "example_id": "0202baef-f560-4a6d-81b9-06bd152516cb",
                                "sense_id": "c82e8612-98a6-3e2b-86f0-945ac60761b8",
                                "text": "„Er entwickelte an den Orten seines Wirkens eine ausgeprägte höfische Repräsentationskultur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
