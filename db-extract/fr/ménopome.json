                    {
                        "sense_id": "f3abf389-7bf6-3319-8eae-ac449cc7031e",
                        "entry_id": "94c375d1-af68-3bcd-a82e-f7a595ddcc1f",
                        "glosses": [
                            "Espèce d’urodèle de grande taille, endémique des Appalaches, aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1472dc84-9b70-4f9d-99e2-c6ba285b9343",
                                "sense_id": "f3abf389-7bf6-3319-8eae-ac449cc7031e",
                                "text": "Les amphiumes et les ménopomes, batraciens de forme analogue aux salamandres, et qui vivent aux États-Unis, forment une seconde catégorie. Leur métamorphose est moindre encore ; puisque, tout en perdant les branchies, ils conservent néanmoins de chaque côté du cou l’orifice par lequel ces organes sortaient au dehors. Ces animaux ont tous les vertèbres biconcaves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e742c638-c757-4c59-8e09-350dd22a62d9",
                        "source_entry_id": "94c375d1-af68-3bcd-a82e-f7a595ddcc1f",
                        "source_sense_id": "f3abf389-7bf6-3319-8eae-ac449cc7031e",
                        "target_lang_word": "modderduivel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modderduivel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "98247636-0763-3bee-9030-e2e0a5ddd566",
                                        "entry_id": "60d979c6-3cca-3120-88c2-65202fdcf80d",
                                        "glosses": [
                                            "bepaald soort grote salamander, Cryptobranchus alleganiensis\\nWordt ook wel gebruikt als benaming voor de verwante Japanse en Chinese reuzensalamander uit het geslacht Andrias"
                                        ],
                                        "tags": [
                                            "salamanders"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fec4ccf-6f4d-4454-9566-1ee5d1a22cdf",
                                                "sense_id": "98247636-0763-3bee-9030-e2e0a5ddd566",
                                                "text": "De Noord-Amerikaanse modderduivel staat op uitsterven. De 70 centimeter lange salamander telt tachtig tot negentig procent minder soortgenoten dan enkele decennia terug het geval was. Zichzelf voortplanten doen de modderduivels amper en dus wil de wetenschap een handje helpen: door een voorraadje sperma in te vriezen en wanneer nodig in te zetten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e0afc6-2858-3930-8c77-b79e49de4be5",
                                        "entry_id": "60d979c6-3cca-3120-88c2-65202fdcf80d",
                                        "glosses": [
                                            "mensenetend wezen dat zich in slijk ophoudt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72ae725-6136-45d2-a13e-8426ae7555a3",
                                                "sense_id": "76e0afc6-2858-3930-8c77-b79e49de4be5",
                                                "text": "De jonge bewoners van de regenboognatie vragen naar Vlaamse spookjes. Ik vertel een waarschuwingssprookje over de modderduivels in de Rupel dat mij als kind werd verteld, het eindigt met een kannibalistische scène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f414f77a-a4c0-3d0c-989b-f198c4a7d049",
                                        "entry_id": "60d979c6-3cca-3120-88c2-65202fdcf80d",
                                        "glosses": [
                                            "wielrenner die het veldrijden beoefent"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a01598e-bc57-4d48-8554-ec99769f803e",
                                                "sense_id": "f414f77a-a4c0-3d0c-989b-f198c4a7d049",
                                                "text": "Gisteren kon de echte regenboogtrui aan de collectie van Nys worden toegevoegd; op overtuigende wijze werd de 28-jarige veldrijder in het Duitse plaatsje Sankt Wendel wereldkampioen. (…) Al het hele seizoen deelt hij de lakens uit in het peloton modderduivels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84fd30a-3489-3152-b576-de785bb6521c",
                                        "entry_id": "60d979c6-3cca-3120-88c2-65202fdcf80d",
                                        "glosses": [
                                            "iemand van het platteland"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f433de-6bc8-419f-a7b4-445a5f1e9ab0",
                                                "sense_id": "c84fd30a-3489-3152-b576-de785bb6521c",
                                                "text": "⧖ Evenwel Couragie, begost men my hier te Casjotteeren,\nHoe Pokken zouden deeze Modderduyvels, met my spotten, en scheeren!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
