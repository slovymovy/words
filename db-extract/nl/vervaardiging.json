                "senses": [
                    {
                        "sense_id": "d977bcbb-65f9-315d-824f-9fd202b3638a",
                        "entry_id": "fa2d4482-8061-33ad-94a8-2e975586e3d4",
                        "glosses": [
                            "het maken, produceren van iets"
