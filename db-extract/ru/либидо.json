                        "sense_id": "947fbe8c-48d3-3fbd-a4e2-38501f36817f",
                        "entry_id": "9b7d5b48-e302-320a-9dc2-ebdbc96412f4",
                        "glosses": [
                            "физиол., сексол. сексуальное желание, половое влечение, половой инстинкт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2643b525-aaf4-4387-bedf-edd588714d5a",
                                "sense_id": "947fbe8c-48d3-3fbd-a4e2-38501f36817f",
                                "text": "От того, насколько сильно или слабо наше либидо, зависит сексуальная жизнь человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "018d335e-a662-4f78-947e-f7dab15c0fcc",
