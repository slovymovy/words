                "senses": [
                    {
                        "sense_id": "f269415f-4542-3170-a484-7cb0d4e6b969",
                        "entry_id": "fe5160e1-774c-354f-8052-faeee4972b37",
                        "glosses": [
                            "een middel waarmee een toename in aantal, of een krachtiger effect wordt bereikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6123af3c-0927-4391-83b6-60f70486d986",
                                "sense_id": "f269415f-4542-3170-a484-7cb0d4e6b969",
                                "text": "Een megafoon is een versterker van geluid."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a87363-2629-319a-a19d-9037bbb5d201",
                        "entry_id": "fe5160e1-774c-354f-8052-faeee4972b37",
                        "glosses": [
                            "een schakeling van elektronische componenten die een toegevoerd signaal in spanning doet toenemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44597364-8199-42ef-b80b-24bd43c5e877",
                                "sense_id": "a0a87363-2629-319a-a19d-9037bbb5d201",
                                "text": "Een versterker dient het signaal te vergroten, zonder het te vervormen of er stoorsignalen aan toe te voegen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b735f965-575e-4318-8b70-4c843293a1c5",
