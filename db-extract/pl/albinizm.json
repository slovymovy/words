                    {
                        "translation_id": "94355282-bee0-44d3-8f83-ada85a85d69a",
                        "source_entry_id": "ebafc0dc-4d93-3b19-8295-49a34066ebb7",
                        "source_sense_id": "07964bad-acd2-344a-8f81-d151dd7b44f5",
