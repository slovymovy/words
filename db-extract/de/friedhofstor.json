                "senses": [
                    {
                        "sense_id": "38df5f67-699c-3b30-a4ce-105c2c70f18b",
                        "entry_id": "e0ce8f6e-b1b9-38a2-af6d-48c387233651",
                        "glosses": [
                            "Eingangstor, das zu einem Friedhof gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4a658f8-5be8-48e8-96f2-0f7241e5509e",
                                "sense_id": "38df5f67-699c-3b30-a4ce-105c2c70f18b",
                                "text": "„Aufmerksam registrierte er, dass die Vadia einige Meter vom Friedhofstor entfernt einfach aufhörte.“"
                            },
                            {
                                "example_id": "55bda32c-946e-4e2d-9c72-ff5f5324a834",
                                "sense_id": "38df5f67-699c-3b30-a4ce-105c2c70f18b",
                                "text": "„Noch ehe er das Friedhofstor erreichte, hatte die Finsternis sich bereits über die Hälfte der Gräber ausgebreitet.“"
                            },
                            {
                                "example_id": "6735d0ef-fb40-420f-bdf6-15dc1bb07a27",
                                "sense_id": "38df5f67-699c-3b30-a4ce-105c2c70f18b",
                                "text": "„Der Totengräber versuchte, den Schädel mit einem Spaten aufzuhalten, aber er wich dem Mann aus und rollte auf das Friedhofstor zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
