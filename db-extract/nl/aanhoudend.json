                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37c17e4d-8cbc-3efe-9166-d269e52ed5b0",
                        "entry_id": "6c0babaa-fa3a-3332-8254-8b8b7d99df73",
                        "glosses": [
                            "voortdurend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c49bcb9-f494-4720-ada7-1820d532f4f7",
                                "sense_id": "37c17e4d-8cbc-3efe-9166-d269e52ed5b0",
                                "text": "Gealarmeerd door de aandacht die normaal gesproken op zijn eten was gericht, trok de kok zich weer terug in zijn keuken. Maar niet voordat hij de televisie zo hard had gezet dat hij de nieuwslezer boven het aanhoudend sissen van de frituurpan kon horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf8b8a08-292d-4f51-9a0e-1c40cbabefa0",
                        "source_entry_id": "6c0babaa-fa3a-3332-8254-8b8b7d99df73",
                        "source_sense_id": "37c17e4d-8cbc-3efe-9166-d269e52ed5b0",
                        "target_lang_word": "continuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuous",
