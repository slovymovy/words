                        "glosses": [
                            "Qui mérite d’être glorifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5f434cd-4ec7-4aea-b511-2940dd083126",
                                "sense_id": "536c8f81-acae-31f7-b997-cfc9f9b2c766",
                                "text": "Et attendu que Dieu est d’une telle nature, il s’ensuit qu’il est souverainement glorifiable & louable, & que le diffame, la honte, & le des-honneur opposites contraires à la gloire, luy sont extrémement dis-proportionnez & dis-convenables."
                            },
                            {
                                "example_id": "5bbb7836-c834-4809-916b-ed3aab65fe99",
                                "sense_id": "536c8f81-acae-31f7-b997-cfc9f9b2c766",
                                "text": "C’est aller à l’encontre des règles de la théologie, car ce qui est « glorifiable » en Mahomet, c’est la pénétration et la présence de l’inspiration divine."
                            }
                        ]
                    }
