                ],
                "senses": [
                    {
                        "sense_id": "b2617a3e-6860-3979-80ea-13eeb5133648",
                        "entry_id": "c5c3b0ff-7b1a-3bc0-a1cf-bb66ae0b1196",
                        "glosses": [
                            "Représenter naturellement."
                        ],
                        "tags": [
                            "Peinture",
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1d838316-2d68-4517-b23e-6e3e3c106f30",
                                "sense_id": "b2617a3e-6860-3979-80ea-13eeb5133648",
                                "text": "Verbes de peinture. Agrouper plusieurs corps. Brunir, bronzer. Colorier, corporer la couleur, croquer. […] Noyer les couleurs, naïver. Ombrer, opaquer. Peindre uniment, peindre lentement, peindre à sec."
                            },
                            {
                                "example_id": "e8c6bfc6-95eb-4dad-9909-8e9ec0b8d10e",
                                "sense_id": "b2617a3e-6860-3979-80ea-13eeb5133648",
                                "text": "Il faut narrer, écrit Binet, l’état de l’affaire, ou l’humeur, et le naturel de la personne, et comme avec un pinceau le naïfver, et tracer pour gaigner et mouvoir l’Auditeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "47c0ce59-d4aa-3557-a7eb-27acb741ccc8",
                        "entry_id": "c5c3b0ff-7b1a-3bc0-a1cf-bb66ae0b1196",
                        "glosses": [
                            "Rendre naïf."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e85168dd-c9de-47ad-b349-c1b6bd147ceb",
                                "sense_id": "47c0ce59-d4aa-3557-a7eb-27acb741ccc8",
                                "text": "[…] c’est qu’il recherchera avec obstination l’imperfection, en tentant de « naïver » sa prose lourdingue. Parce que Laforgue est lourd. Il est surchargé d’allusions."
                            }
                        ]
                    }
