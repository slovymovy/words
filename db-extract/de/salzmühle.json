                "senses": [
                    {
                        "sense_id": "df8bf77a-4d5e-30b8-b8a0-71ffb0fcc92e",
                        "entry_id": "1cf77cff-5e30-31d6-937d-9e2599f61b71",
                        "glosses": [
                            "eine Mühle (ein mechanisches oder elektromechanisches Gerät) zum Mahlen von Salz"
                        ],
                        "tags": [
                            "Haushalt",
                            "Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "7b82bea1-763d-4297-b5f9-ddf1d995a591",
                                "sense_id": "df8bf77a-4d5e-30b8-b8a0-71ffb0fcc92e",
                                "text": "Sie trug die Gefäße zum Küchentisch, beugte sich über die Salzmühle und flüsterte leise die Zauberformel: ›Mühle, Mühle mahl geschwind, Salz, so viel wie Staub im Wind!‹"
                            },
                            {
                                "example_id": "b3860f50-fccc-4ccf-b3c4-8070e3a0d9e0",
                                "sense_id": "df8bf77a-4d5e-30b8-b8a0-71ffb0fcc92e",
                                "text": "Der Schnee wurde als Salz gedeutet, und die Salzmühle dazu verwertet, um zu erklären, warum das Meer salzig sei."
                            }
                        ],
                        "sense_index_json": "\"1\""
