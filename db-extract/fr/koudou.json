                ],
                "senses": [
                    {
                        "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                        "entry_id": "d055838d-2d67-3e72-b177-288cd7288d6e",
                        "glosses": [
                            "Une des espèces de grandes antilopes d’Afrique, à longues cornes droites torsadées chez le mâle, à pelage rayé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea5fa6a2-7082-4f61-b6f0-b3a647a116e0",
                                "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                                "text": "– Sais-tu ce que c’est qu’un koudou ?\n– Un koudou ? Oui.\n– Qu’est-ce que c’est ?\n– Une espèce de grande bête, mi-cerf, mi-buffle, avec une crinière noire, et des raies blanches sur les flancs.\n– C’est ça, bravo !"
                            },
                            {
                                "example_id": "92aed9e2-7510-421a-9854-a1ecdbe9b9c8",
                                "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                                "text": "Après des jours de poursuite, le koudou aux cornes merveilleuses est là, devant moi, à 300 mètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09f66452-90b0-472d-9533-32a3d5db6860",
                        "source_entry_id": "d055838d-2d67-3e72-b177-288cd7288d6e",
                        "source_sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                        "target_lang_word": "Kudu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kudu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e21971-3730-306e-8c25-1b05812f8ca7",
                                        "entry_id": "a2473b9f-d802-3931-86e8-23057609572c",
                                        "glosses": [
                                            "in Afrika verbreitete Antilopenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e31805d-7bf4-4b1a-acb4-ab0990c88fc1",
                                                "sense_id": "e5e21971-3730-306e-8c25-1b05812f8ca7",
                                                "text": "„›Als er den Dienstweg entlanggefahren ist, hat er einen starken Verwesungsgeruch wahrgenommen, aber da hat er sich noch nichts dabei gedacht, denn manchmal erwischt ein Zug einen Kudu oder ein anderes Tier, manchmal auch einen Betrunkenen.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51556cc8-221e-4272-9d5c-bf07a6d2936f",
