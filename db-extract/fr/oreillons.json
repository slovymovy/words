                "entry_id": "92c79858-74b9-3dca-8490-ff4469d38de8",
                "word": "oreillons",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "90620f64-6f11-3823-8f4f-70a37fc23ff0",
                        "entry_id": "92c79858-74b9-3dca-8490-ff4469d38de8",
                        "glosses": [
                            "Infection virale des glandes parotides provoquant des douleurs aux oreilles."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7ebffcef-dec4-48e0-975c-cdcd0eb1523c",
                                "sense_id": "90620f64-6f11-3823-8f4f-70a37fc23ff0",
                                "text": "« Je pouvais à peine ouvrir la bouche, comme quand on a les oreillons. »"
                            },
                            {
                                "example_id": "3519e770-51fd-45f0-86b3-b672c6e0ed97",
                                "sense_id": "90620f64-6f11-3823-8f4f-70a37fc23ff0",
                                "text": "L’idée de combiner les vaccins n’est pas nouvelle. Par exemple, depuis les années 1970, on combine les vaccins contre la rougeole, la rubéole et les oreillons (vaccin RRO) pour immuniser les jeunes enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06d147e6-08f3-4ab0-a446-6841c828cd27",
                        "source_entry_id": "92c79858-74b9-3dca-8490-ff4469d38de8",
                        "source_sense_id": "90620f64-6f11-3823-8f4f-70a37fc23ff0",
                        "target_lang_word": "Mumps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mumps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c89a4b9-f31c-3d99-b58f-6a14daf48ccc",
                                        "entry_id": "8bfdcbe4-5a70-3e78-ba85-6ecb605918a5",
                                        "glosses": [
                                            "ansteckende Infektionskrankheit, bei der eine Entzündung insbesondere der Ohrspeicheldrüse vorliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd90fb8-0648-49b6-be9f-8ee84922714d",
                                                "sense_id": "5c89a4b9-f31c-3d99-b58f-6a14daf48ccc",
                                                "text": "Da Mumps eine lebenslange Immunität hinterlässt, zählt die Krankheit zu den Kinderkrankheiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
