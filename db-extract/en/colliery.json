                        "cross_references": [
                            {
                                "target_word": "houillère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d733a97-5f6c-3f1d-a501-d44b46b5289f",
                                        "entry_id": "743f0e75-d662-3845-87a6-f39e88e6bc76",
                                        "glosses": [
                                            "Mine de houille."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81bec464-dcbb-4a12-b189-cb0c400930f2",
                                                "sense_id": "0d733a97-5f6c-3f1d-a501-d44b46b5289f",
                                                "text": "Comme un gigantesque cimetière profané s’ouvrait dans les filons de la houillère, grandissait, se perdait dans les acculs lointains, là où les claque-dents devaient si bien dormir leur dernier sommeil sous les toits écrasés des tailles."
                                            },
                                            {
                                                "example_id": "364ad8e0-ac79-4b9e-bab0-c6cfd2241aef",
                                                "sense_id": "0d733a97-5f6c-3f1d-a501-d44b46b5289f",
                                                "text": "Les «Compagnie Marseillaise de navigation à vapeur,» des «Société houillère et métallurgique des Asturies.»"
                                            },
                                            {
                                                "example_id": "7f2da76f-7e99-4af2-b451-a7ebaa786981",
                                                "sense_id": "0d733a97-5f6c-3f1d-a501-d44b46b5289f",
                                                "text": "D’autre part cette école ne disposait à l’origine que d’une houillère, quasi épuisée et qui ne fournissait que du charbon de 2e qualité, d’une forge et d’une fabrique de fer blanc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "houillère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a6ec80-6593-3a7d-a790-4a1b2ff4b0b6",
                                        "entry_id": "81435831-d168-3bd3-9771-530cec4c7c94",
                                        "glosses": [
                                            "Féminin singulier de houiller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0007ef47-0bf6-4c33-9584-2fe70ebceb61",
                                                "sense_id": "e6a6ec80-6593-3a7d-a790-4a1b2ff4b0b6",
                                                "text": "Au cours de ces dernières années, de nombreux modèles nouveaux de tamis pour le classement granulométrique du charbon, sont entrés en service dans l'industrie houillère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7adb586-6ea6-4f53-8e7c-324f42233fc0",
                        "source_entry_id": "09d52741-d3f9-3fdd-9927-711d9cfffa6f",
                        "source_sense_description": "underground coal mine",
                        "target_lang_word": "charbonnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charbonnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52e764c5-ead8-3e23-b6f6-d3f7d79d384a",
                                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                                        "glosses": [
                                            "Exploitation de la houille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                                        "glosses": [
                                            "Les mines de houille en exploitation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942f2b9b-91b9-4317-80f9-4d639dc99246",
                                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                                "text": "Et pourtant il serait difficile de ne pas même dire un seul mot de ces petits charbonnages que j'ai visités dans le département : mines de Brassac, au sud, comprenant La Combelle et Charbonnier; mines de Messeix, au sud-ouest, près de Bourg-Lastic; mines de Saint-Éloy, au nord."
                                            },
                                            {
                                                "example_id": "8eb6a43d-7b56-4251-a16f-4a0d17c2813d",
                                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                                "text": "En cette fin d'année 1937, des ateliers de flottage sont en projet ou en cours d'installation dans plusieurs charbonnages français."
                                            },
                                            {
                                                "example_id": "6352785d-e76c-4779-aa24-dad9edec1890",
                                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                                "text": "On appelait « Indes noires « les charbonnages d’Écosse en raison de la source de richesses qu’ils représentaient pour la Grande-Bretagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58cafae-a8ee-33d4-a3dd-b30eefdf10b5",
                                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                                        "glosses": [
                                            "Société d'exploitation d'une mine de charbon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da67417a-1532-4f6f-97fc-a02182e63df7",
                                                "sense_id": "f58cafae-a8ee-33d4-a3dd-b30eefdf10b5",
                                                "text": "La pauvreté toutefois, si déterminante pour Alexis, n’entrait pas en ligne de compte pour le jeune Belge dont la mère avait hérité d’un charbonnage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7add9b5c-0316-3117-9835-e652e02785c8",
                                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                                        "glosses": [
                                            "Action de s’approvisionner en charbon pour les machines."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "056f2802-510b-4e9e-9859-64834cdded57",
                                                "sense_id": "7add9b5c-0316-3117-9835-e652e02785c8",
                                                "text": "Notre première escale après charbonnage à Stornoway en Écosse fut donc Sudéroë, l'île la plus au Sud de l'archipel des Féroë."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf1b033-00e3-3553-b04f-a9cca5e1ce0e",
                                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                                        "glosses": [
                                            "Droit concédé par un noble à un roturier pour lui permettre l'exploitation d'une mine de charbon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
