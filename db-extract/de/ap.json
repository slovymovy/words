                    },
                    {
                        "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                        "entry_id": "f224ca2b-7634-3034-86e4-c927e9d76402",
                        "glosses": [
                            "Arbeitspapier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8d60db-243a-486d-a91f-2541a73dece0",
                                "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                                "text": "„Der Sachkommission ist für dieses Arbeitspapier (AP) - veröffentlicht in: Synode 1/1973/45 bis 64 - zu danken. […] [Die Kirche] […] bringt in dieses Gespräch ihre Vorstellung von dem ein, was sie selber für geklärt hält und nicht ohne Grund ›verunklart‹ wissen möchte. Hierzu leistet das AP einen nützlichen Beitrag.“"
                            },
                            {
                                "example_id": "f0ea61df-6dfa-4789-a3cd-5106ae08b13c",
                                "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                                "text": "„Die Behandlung der Messdaten sind im Arbeitspapier Tragfähigkeit, Teil D […] [AP 433 D], näher beschrieben.“"
                            },
                            {
                                "example_id": "b5d0b1aa-ebd0-48d2-8e52-b9147067d705",
                                "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                                "text": "(Überschrift:) „Neue JBZ Arbeitspapiere“",
                                "translation": "(Text in Listenform:) „AP 32 / Zur Bedeutung der nationalen Identität in Salzburg […]“"
                            },
                            {
                                "example_id": "9dda93d9-7c2e-48a4-986b-312a0a12b598",
                                "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                                "text": "(Überschrift:) „FGSV-Arbeitspapier Nr. 69“",
                                "translation": "(Text:) „AP Nr. 69 ist nicht nur in Deutschland, sondern auch im Europäischen Ausland weit verbreitet und wird von den am Bau beteiligten Parteien weitgehend anerkannt[.]“"
                            },
                            {
                                "example_id": "576d6e74-522e-4458-9a1a-dd6b143960e5",
                                "sense_id": "8a48bae6-be63-3cbc-91e0-d5bea6b2f928",
                                "text": "(Text:) Die JBZ-Arbeitspapiere der Robert-Jungk-Stiftung erscheinen seit dem Jahr 2010 in regelmäßigen Abständen. (Überschrift:) AP 26 / Salzburg morgen"
                            }
                        ],
