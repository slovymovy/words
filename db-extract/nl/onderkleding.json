                                        "glosses": [
                                            "À la partie, à la face inférieure d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8b104f-53fa-4dd3-9cdc-bfc0824a1b75",
                                                "sense_id": "3784abcb-b18a-363f-84ab-aae9d88e41f3",
                                                "text": "Cherchez dessous la table."
                                            }
                                        ]
                                    }
