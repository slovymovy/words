                "translations": [
                    {
                        "translation_id": "6d82e49b-6a31-4241-8877-d817db21045c",
                        "source_entry_id": "dbffc68e-45aa-3b30-81d5-d9d25bfeffbc",
                        "source_sense_id": "0204f92a-ab1d-3854-b4a4-25ca7290ee68",
