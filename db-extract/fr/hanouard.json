                        "sense_id": "ecfcde12-ddd3-3219-87a5-d2f4d3eff0eb",
                        "entry_id": "cb18c946-fc89-3a5f-8584-edd2c1f0de20",
                        "glosses": [
                            "Officier porteur de sel, à Paris, sous l'Ancien Régime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476aebad-e638-460f-85c4-03d3b05ab92e",
                                "sense_id": "ecfcde12-ddd3-3219-87a5-d2f4d3eff0eb",
                                "text": "Le prix du blé s'est élevé de six sols huit deniers, maître Croulebois, continua le boulanger s'adressant à un hanouard ou porteur de sel."
                            },
                            {
                                "example_id": "f4cdc88e-9c15-41c6-be86-c455521b5ddc",
                                "sense_id": "ecfcde12-ddd3-3219-87a5-d2f4d3eff0eb",
                                "text": "À la mort d'un roi, les hanouards avaient le privilège de porter son cercueil entre Paris et la première croix sur la route de Saint Denis."
                            }
                        ]
                    }
