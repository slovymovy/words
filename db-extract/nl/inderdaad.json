        "nl-extract.jsonl": [
            {
                "entry_id": "9e008efe-619f-3090-8f22-8c012c89ccfb",
                "word": "inderdaad",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                        "entry_id": "9e008efe-619f-3090-8f22-8c012c89ccfb",
                        "glosses": [
                            "een bevestiging dat iets het geval is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a13dfa-c414-4657-b680-2e7ecce852d5",
                                "sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                                "text": "Dat is inderdaad een moeilijk woord."
                            },
                            {
                                "example_id": "5ebe0e2e-f1d9-4df0-adba-f150ce526528",
                                "sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                                "text": "Thuis had ik een systeem in elkaar geknutseld met klittenband die de paraplu aan mijn rugzak bevestigde, waardoor ik mijn handen vrijhield voor mijn wandelstokken. Wandelstokken? Inderdaad, ik was met de trend meegegaan en had een paar Leki Thermalite-wandelstokken aangeschaft."
                            },
                            {
                                "example_id": "cf3b6b7d-fff7-41ee-90d4-74cd88941afe",
                                "sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                                "text": "Ik sta er inderdaad verdomd goed op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc07528-84a8-4b67-87a1-6a15aeb60d33",
                        "source_entry_id": "9e008efe-619f-3090-8f22-8c012c89ccfb",
                        "source_sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                        "source_sense_description": "een bevestiging dat iets het geval is",
                        "target_lang_word": "tatsächlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatsächlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                        "entry_id": "418c6704-8a1f-3b8a-8ac8-f22d926425f4",
                                        "glosses": [
                                            "(manchmal auch wider Erwarten) wahrheitsgemäß, wirklich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63edba5d-01d5-42a3-937c-6f923a5eba67",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Der Dozent ist tatsächlich netter, als ich gedacht hatte."
                                            },
                                            {
                                                "example_id": "23a85b9a-954e-4785-9035-b8e5f7b2b941",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Tatsächlich ordnet sich der gegen Philipp V. ausgebrochene 2. Römisch-Makedonische Krieg in eine lange Reihe imperialistischer Übergriffe ein, die so alt waren wie die Errichtung der römischen Hegemonie über Italien.“"
                                            },
                                            {
                                                "example_id": "2aa8eebb-2ffd-4e99-8665-fb660a346f6f",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Penibel ausgearbeitete Pläne für Internierungslager und Listen mit Namen der zur Internierung vorgesehenen Systemkritiker lagen tatsächlich längst vor.“"
                                            },
                                            {
                                                "example_id": "63223d4c-359f-4340-907a-d26d6bbfedab",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Den Einwand verstehe ich nicht, es hat doch eine tatsächliche Veränderung stattgefunden, oder nicht?"
                                            },
                                            {
                                                "example_id": "bea08c6f-2874-4137-867b-d721ae326511",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Eine tatsächliche Verständigung bleibt auch dann wirksam, wenn von den Beteiligten nicht vorhergesehene Besteuerungsfolgen eintreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5a1bccf-d0f0-4109-b2c0-d027cc3e312e",
                        "source_entry_id": "9e008efe-619f-3090-8f22-8c012c89ccfb",
                        "source_sense_id": "a1652412-bc56-3806-b3ff-ed578853799c",
                        "source_sense_description": "een bevestiging dat iets het geval is",
                        "target_lang_word": "indeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                        "entry_id": "115c0151-a17f-3daf-aa49-0ceb97a011e2",
                                        "glosses": [
                                            "Truly; in fact; actually."
                                        ],
                                        "tags": [
                                            "modal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b51349c-b18f-475a-b9f6-3869f6380653",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Indeed, he made several misplays."
                                            },
                                            {
                                                "example_id": "2f615a69-60c7-4444-9c49-40f8db0e4351",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Yes, I do indeed look very similar to you."
                                            },
                                            {
                                                "example_id": "59531854-098f-48c6-a23d-233bf359ca6e",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            },
                                            {
                                                "example_id": "135cbdc5-caf4-4033-b5ec-f3805616fce5",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "I was about to say that I had known the Celebrity from the time that he wore kilts. But I see that I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            },
                                            {
                                                "example_id": "ec7a1929-81db-4b0c-a09a-3c91b8677120",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed, she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry. His wooing had been brief but incisive."
                                            },
                                            {
                                                "example_id": "fec50aa1-be54-4e1b-aa65-4fed9eff1eac",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            },
                                            {
                                                "example_id": "93310381-d101-475e-90b5-d7dbf3f89a16",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f973fb4-f65f-31fa-b024-4cc7c524e485",
                                        "entry_id": "115c0151-a17f-3daf-aa49-0ceb97a011e2",
                                        "glosses": [
                                            "In fact."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71e53b3-b22a-4583-a2a4-741466272d74",
                                                "sense_id": "4f973fb4-f65f-31fa-b024-4cc7c524e485",
                                                "text": "As a soccer player, he is terrible indeed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "479f14bb-622a-392c-8a82-0c0639178f56",
                                        "entry_id": "a4749f99-36fc-3df5-89c8-73152bf90687",
                                        "glosses": [
                                            "Indicates emphatic agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b6c4ed-7d19-4075-b6c6-ab200e6f3888",
                                                "sense_id": "479f14bb-622a-392c-8a82-0c0639178f56",
                                                "text": "\"I am a great runner.\" \"Indeed!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed6a074-78e3-3562-8646-ff89bd407534",
                                        "entry_id": "a4749f99-36fc-3df5-89c8-73152bf90687",
                                        "glosses": [
                                            "With interrogative intonation (low–high), indicates serious doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715940ee-9195-4321-856e-6e72ab97f13b",
                                                "sense_id": "aed6a074-78e3-3562-8646-ff89bd407534",
                                                "text": "\"I am a great runner.\" \"Indeed?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
