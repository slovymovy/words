{
    "word_family": [
        "jalousement",
        "jalouser",
        "jalousie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                    "sense_definition": "Qui craint de perdre l'affection d'une personne au profit d'une autre, ou qui supporte mal ses relations avec autrui.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il devient très <w>jaloux</w> dès que sa compagne parle à d'autres hommes."
                        },
                        {
                            "text": "Sa petite sœur est <w>jalouse</w> de l'attention que ses parents portent au bébé."
                        }
                    ],
                    "synonyms": [
                        "possessif",
                        "ombrageux"
                    ],
                    "antonyms": [
                        "confiant"
                    ],
                    "common_phrases": [
                        "être jaloux de",
                        "crise de jaloux"
                    ]
                },
                {
                    "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                    "sense_definition": "Qui éprouve du dépit ou de la rancœur face aux avantages, aux réussites ou aux possessions d'autrui.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "envie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>jaloux</w> de la nouvelle voiture de son voisin de palier."
                        },
                        {
                            "text": "Son succès rapide a suscité des réactions <w>jalouses</w> parmi ses collègues de bureau."
                        }
                    ],
                    "synonyms": [
                        "envieux",
                        "amer"
                    ],
                    "antonyms": [
                        "bienveillant"
                    ],
                    "common_phrases": [
                        "rendre jaloux"
                    ]
                },
                {
                    "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                    "sense_definition": "Qui veille scrupuleusement à préserver un bien moral, un droit ou un privilège auquel il est très attaché.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet écrivain solitaire est particulièrement <w>jaloux</w> de son indépendance créative."
                        },
                        {
                            "text": "Le peuple demeure <w>jaloux</w> de ses libertés démocratiques chèrement acquises."
                        }
                    ],
                    "synonyms": [
                        "sourcilleux",
                        "vigilant"
                    ],
                    "antonyms": [
                        "négligent",
                        "indifférent"
                    ],
                    "common_phrases": [
                        "jaloux de sa liberté",
                        "jaloux de son indépendance"
                    ]
                },
                {
                    "sense_id": "3f43aeb9-0102-3921-8273-82529c01b0b5",
                    "sense_definition": "Qui a vivement à cœur de réaliser quelque chose ou d'obtenir un résultat favorable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis <w>jaloux</w> de mériter pleinement votre confiance pour cette mission délicate."
                        },
                        {
                            "text": "Il s'est montré <w>jaloux</w> de préserver la réputation sans tache de sa famille."
                        }
                    ],
                    "synonyms": [
                        "désireux",
                        "soucieux",
                        "empressé"
                    ]
                },
                {
                    "sense_id": "22790053-7836-3ce2-b969-dd4aac637357",
                    "sense_definition": "Se dit d'un bateau qui manque de stabilité transversale et a tendance à rouler excessivement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne embarcation était particulièrement <w>jalouse</w> par mer agitée."
                        },
                        {
                            "text": "Le capitaine redoutait ce navire <w>jaloux</w> qui penchait dangereusement à chaque coup de vent."
                        }
                    ],
                    "synonyms": [
                        "instable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0819c1a-f793-3912-848f-6a37d16a945c",
                    "sense_definition": "Personne qui ressent de l'envie ou de la rancœur face au bonheur ou à la réussite d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leur magnifique villa au bord de l'eau fait bien des <w>jaloux</w> dans le village."
                        },
                        {
                            "text": "Un <w>jaloux</w> ne peut jamais supporter le triomphe de ses propres amis."
                        }
                    ],
                    "synonyms": [
                        "envieux"
                    ],
                    "common_phrases": [
                        "faire des jaloux"
                    ]
                },
                {
                    "sense_id": "15175b15-8248-3ceb-a200-710ff00a0517",
                    "sense_definition": "Personne ou figure d'autorité qui protège avec intransigeance ses prérogatives exclusives ou son pouvoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le monarque régnait en maître suprême, tel un <w>jaloux</w> veillant sur chaque parcelle de souveraineté."
                        },
                        {
                            "text": "Ce vieux chef de parti politique se comporte comme un <w>jaloux</w> qui refuse de céder la main."
                        }
                    ]
                }
            ]
        }
    ]
}