        "nl-extract.jsonl": [
            {
                "entry_id": "0ede0e01-3546-3985-b3fa-3392fd631b68",
                "word": "verlustigen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
                        "entry_id": "0ede0e01-3546-3985-b3fa-3392fd631b68",
                        "glosses": [
                            "plezier beleven door naar iets te kijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed0e8f02-4c31-49db-a406-fa83de14ecd2",
                                "sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
                                "text": "Een verontwaardigde Facebookgebruiker beschuldigt de groep van harteloosheid. ,,Mensen die legale jacht niet kunnen verdragen en denken dat het in orde is om zich minachtend uit te laten over de mensheid en zich te verlustigen aan de dood van een vader van vijf kinderen. Ik ben bedroefd, ziek van walging en geschokt.\""
                            },
                            {
                                "example_id": "c2f5128c-7380-4950-942c-b008f20bd372",
                                "sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
                                "text": "Met het maken van de beelden heeft de verdachte de meisjes \"in al hun naaktheid en kwetsbaarheid gefilmd, de films bewerkt en zich aan de beelden verlustigd\", zo stelde de aanklager."
                            },
                            {
                                "example_id": "b8654f1a-7f3a-46ef-89ae-e643c5f99704",
                                "sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
                                "text": "Op de catwalks wemelde het van de geborduurde jurkjes en jassen en hoewel we die natuurlijk nooit kunnen betalen, kunnen we ons er wel aan verlustigen en ons dan vervolgens aan naald en draad vergrijpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba744aef-eb6d-4a84-94cb-2d70d16bb709",
                        "source_entry_id": "0ede0e01-3546-3985-b3fa-3392fd631b68",
                        "source_sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
                        "source_sense_description": "plezier beleven door naar iets te kijken",
                        "target_lang_word": "divert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92bb08c4-aed3-3c7b-8d91-fa3ab9613ea0",
                                        "entry_id": "4a14a9f3-c0a3-3cc9-a64b-fd8497271cd4",
                                        "glosses": [
                                            "To turn aside from a course."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c7eb87-d51e-4b7b-b29b-eff585504354",
                                                "sense_id": "92bb08c4-aed3-3c7b-8d91-fa3ab9613ea0",
                                                "text": "The workers diverted the stream away from the road."
                                            },
                                            {
                                                "example_id": "1f031fb0-8fe3-467a-ad9e-3450100ebf3d",
                                                "sense_id": "92bb08c4-aed3-3c7b-8d91-fa3ab9613ea0",
                                                "text": "Many of the remaining trains have been retimed and where possible freight trains have also been diverted to alternative routes."
                                            },
                                            {
                                                "example_id": "8599e4e9-5b8c-45e5-b513-1ab36a524309",
                                                "sense_id": "92bb08c4-aed3-3c7b-8d91-fa3ab9613ea0",
                                                "text": "Until the main road from Hatfield to Hertford was diverted a few years ago, heavy lorries trundling through the village sometimes knocked chunks off corner buildings, but now the village has regained much of its former tranquillity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ff1a79-ac41-3c89-b6df-5dd670cc7e70",
                                        "entry_id": "4a14a9f3-c0a3-3cc9-a64b-fd8497271cd4",
                                        "glosses": [
                                            "To distract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aeb9377-5043-4ff1-91f8-aaf18f24d827",
                                                "sense_id": "15ff1a79-ac41-3c89-b6df-5dd670cc7e70",
                                                "text": "Don't let him divert your attention; keep your eye on the ball."
                                            },
                                            {
                                                "example_id": "e9bdb672-8a71-45dc-aef2-90000c0a99d4",
                                                "sense_id": "15ff1a79-ac41-3c89-b6df-5dd670cc7e70",
                                                "text": "that crude apple that diverted Eve"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beafc57b-3ccd-381e-aa2f-02ae86053f55",
                                        "entry_id": "4a14a9f3-c0a3-3cc9-a64b-fd8497271cd4",
                                        "glosses": [
                                            "To entertain or amuse (by diverting the attention)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fcefda-cfeb-4629-92d9-553945a9c24d",
                                                "sense_id": "beafc57b-3ccd-381e-aa2f-02ae86053f55",
                                                "text": "We are amused by a tale, diverted by a comedy."
                                            },
                                            {
                                                "example_id": "715170d1-66d5-49b8-8917-dab297cfe839",
                                                "sense_id": "beafc57b-3ccd-381e-aa2f-02ae86053f55",
                                                "text": "But somehow, despite wooden, unfunny dialogue, rigid characterization, and the dreadful mindless meaninglessness of it all, Good News manages to divert us for its three hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44003c0-e0f4-3a01-93a0-972671ded27e",
                                        "entry_id": "4a14a9f3-c0a3-3cc9-a64b-fd8497271cd4",
                                        "glosses": [
                                            "To turn aside; to digress."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386e84c5-552a-45a5-96c6-4eb1f7723d82",
                                                "sense_id": "c44003c0-e0f4-3a01-93a0-972671ded27e",
                                                "text": "I diverted to see one of the prince's palaces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b809f80-1d69-41f3-969f-a81915f599ab",
                        "source_entry_id": "0ede0e01-3546-3985-b3fa-3392fd631b68",
                        "source_sense_id": "413e2d48-dce5-37b5-9761-3695040234dc",
