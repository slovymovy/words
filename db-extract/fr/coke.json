                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koks",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "36a1f8ca-48ab-36a9-8ab9-dac779194390",
                                        "entry_id": "337c1ef9-efc4-3ba2-b52d-263ff44397ab",
                                        "glosses": [
                                            "tuhé palivo vyráběné suchou destilací (karbonizací) černého uhlí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c96e78-0164-4abc-aecd-643cb37c99e1",
                                                "sense_id": "36a1f8ca-48ab-36a9-8ab9-dac779194390",
                                                "text": "Dříve byly mimo elektřinu rozhodujícími palivy hlavně hnědé uhlí, koks, svítiplyn, eventuálně uhelné kaly. Dnes vede především zemní plyn, kusové dřevo, solární energie, dále tzv. čisté energie vzduchu, země, spodní i tekoucí vody."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f44f55-d28d-3acf-beee-8dcabd7bf4f7",
                                        "entry_id": "337c1ef9-efc4-3ba2-b52d-263ff44397ab",
                                        "glosses": [
                                            "kokain"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a24bad7-cd0d-47d0-90cf-43d72dd31dcc",
                                                "sense_id": "62f44f55-d28d-3acf-beee-8dcabd7bf4f7",
                                                "text": "„Nemyslím, že by takoví lidé, kteří berou koks nebo se svlékají na veřejnosti, měli bohatší a méně nudný život nežli já,“ dodala držitelka Oscara, která s manželem očekává narození druhého potomka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
