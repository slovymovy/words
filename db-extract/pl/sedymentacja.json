                                        "glosses": [
                                            "Formation de sédiments ; ensemble des phénomènes qui conduisent à la formation et au dépôt d’un sédiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e2bda6-12c5-4398-ad99-3f421f77d355",
                                                "sense_id": "cfb32ea0-0120-3371-836e-7f536832bb15",
                                                "text": "Cette sédimentation organique, jointe aux apports de terre provenant de l’écroulement des berges sous les pieds des bestiaux, amène un asséchement progressif des noues."
                                            },
                                            {
                                                "example_id": "3b0f2b2a-c19a-4f40-800e-330d084983ec",
                                                "sense_id": "cfb32ea0-0120-3371-836e-7f536832bb15",
                                                "text": "L’érosion et la sédimentation glaciaires avaient laissé de nombreux points tourbeux parfois à des altitudes assez basses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
