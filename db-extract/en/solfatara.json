                                        "entry_id": "d72a529b-4540-3c34-bc10-fd89ea8cc64e",
                                        "glosses": [
                                            "über vulkanischem Gebiet aus Erdspalten ausströmende Gase mit einem hohen Anteil an Schwefelwasserstoffverbindungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7419b2d6-d4da-4f33-b3d2-2d8d25f54db6",
                                                "sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                                                "text": "„Als Solfatare, ‚Schwefelgrube‘, bezeichnet man die nachvulkanischen Stellen, an denen 100-200 °C heißer Wasserdampf und Schwefelwasserstoff ausströmt.“"
                                            },
                                            {
                                                "example_id": "272a809d-2834-4c13-9ac4-b29dd8864b2f",
                                                "sense_id": "fd37d191-e41f-36c3-b743-ca262e8e1ef3",
                                                "text": "„Beim Betreten der Solfatare bemerkt man zunächst die weisse Färbung des Bodens.“"
                                            }
