                ],
                "senses": [
                    {
                        "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                        "entry_id": "1c89e5aa-c64c-3d9d-a57d-57b6b40488d7",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e73d5691-a356-4517-ad53-8bf577790019",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Frau Jentzsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "15bd26b0-2cc2-46c1-a0c0-16d4bf9828d2",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Herr Jentzsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e9a654c-8215-4aa1-a1bf-16652b8489c5",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Die Jentzschs kommen heute vom Genfersee."
                            },
                            {
                                "example_id": "de0871f3-ba00-420f-9f7f-157167808f2b",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Der Jentzsch trägt nie die Schals, die die Jentzsch ihm strickt."
                            },
                            {
                                "example_id": "2bcdb084-040e-4c11-baa4-bfea55c2a7fb",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jentzsch kommt, geht der Herr Jentzsch.“"
                            },
                            {
                                "example_id": "d65211e9-acbb-47c3-b18b-12a0ba060fd4",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Jentzsch kommt und geht."
                            },
                            {
                                "example_id": "77dc35ab-c40a-4da0-863c-a1a0e7be1bbe",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "Jentzschs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "bbe6dda8-09fc-4698-a401-63278b32f09a",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "An verregneten Herbsttagen ist Familie Jentzschs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "9092446f-9474-4cba-b4ae-be7051ccb902",
                                "sense_id": "f4f053a4-c7a2-3081-9ac9-4cf515e7bcc5",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Jentzsch das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
