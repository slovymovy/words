                "senses": [
                    {
                        "sense_id": "c2b9bcd4-3689-3e02-9e76-40d219b06eb0",
                        "entry_id": "937b8e7d-becd-3c61-b3d3-cf9c4508eab6",
                        "glosses": [
                            "auf das Gehirn spezialisierter Chirurg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fef084f-e190-41e2-b37c-a946d42d375b",
                                "sense_id": "c2b9bcd4-3689-3e02-9e76-40d219b06eb0",
                                "text": "„Er kannte Sir Warren, einen renommierten Gehirnchirurgen, seit einigen Jahren.“"
                            },
                            {
                                "example_id": "505ae7c0-baa9-43f4-be2c-a85c39888f02",
                                "sense_id": "c2b9bcd4-3689-3e02-9e76-40d219b06eb0",
                                "text": "„Sie schenkte allen ihr strahlendes Lächeln und erklärte, dass Shep zurückgeblieben sei, um mit ihrem Daddy zu reden, weil er ernsthaft überlege, Gehirnchirurg zu werden.“"
                            },
                            {
                                "example_id": "e28096fc-4a1c-4cf9-adac-edf277f23435",
                                "sense_id": "c2b9bcd4-3689-3e02-9e76-40d219b06eb0",
                                "text": "„Man muss kein Gehirnchirurg sein, um zu erkennen, dass das alles nichts als Schwachsinn ist.“"
                            },
                            {
                                "example_id": "18ef7679-83fa-4353-846c-46ec54292c69",
                                "sense_id": "c2b9bcd4-3689-3e02-9e76-40d219b06eb0",
                                "text": "„Es gibt mehr Gehirnchirurgen als hyperbare Schweißer, aber wahrscheinlich hast du recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
