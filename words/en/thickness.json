                },
                {
                    "sense_id": "61615d38-d598-306e-b665-8dec00eca484",
                    "sense_definition": "The minimum number of planar subgraphs into which a given graph can be decomposed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calculating the <w>thickness</w> of a complete graph is a classic problem in graph theory.",
                            "target_lang_translations": {
                                "ru": "Вычисление <w>толщины</w> полного графа — классическая задача теории графов."
                            }
                        },
                        {
                            "text": "The <w>thickness</w> of this specific network graph determines its planarity properties.",
                            "target_lang_translations": {
                                "ru": "<w>Толщина</w> этого конкретного сетевого графа определяет его свойства планарности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graph thickness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in graph theory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Минимальное количество плоских подграфов, на которые может быть разложен данный граф."
