                            {
                                "example_id": "6a94a20e-3a9e-46fc-8758-78bca0a26e3c",
                                "sense_id": "e3a6307b-7af3-324e-8b5f-b5cc767df220",
                                "text": "„Der Lustgarten mit seiner ausgedehnten Rasenfläche ist mit Laubbäumen an vier Ecken flankiert und mit einer Reihe von Kastanien umgeben.“"
                            }
                        ],
