                "senses": [
                    {
                        "sense_id": "45334ad4-96f4-370a-9587-ca5a32c17508",
                        "entry_id": "d831e1a3-4ef6-348d-b2be-712dcc30c2eb",
                        "glosses": [
                            "an der Immunreaktion beteiligte Körperzelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d526a76c-3856-4b8b-a7d3-2a539814b615",
                                "sense_id": "45334ad4-96f4-370a-9587-ca5a32c17508",
                                "text": "„Die allergische Reaktion ist im Grunde eine Überreaktion der Immunzellen auf antigene Stimuli.“"
                            },
                            {
                                "example_id": "48c9ede1-30d1-421f-95e3-e3a537eebb8f",
                                "sense_id": "45334ad4-96f4-370a-9587-ca5a32c17508",
                                "text": "„Das Typ-I-Muster ist für die Aktivierung von Immunzellen verantwortlich, die intrazellulär lokalisierte Bakterien und Viren abtöten sollen, wohingegen das Typ-II-Muster für die Abtötung extrazellulärer Parasiten, Bakterien und Viren zuständig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
