                    },
                    {
                        "form_id": "3e395b56-b21f-4afe-9edb-873d06c6e8f9",
                        "entry_id": "dafd23f9-34ae-3449-9dc3-178904631ffb",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unfundierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                        "entry_id": "dafd23f9-34ae-3449-9dc3-178904631ffb",
                        "glosses": [
                            "so, dass es nicht fundiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d31d0b6-5fdc-4e2f-8b9a-45f51af44723",
                                "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                                "text": "„Allein da sich … keine Spur der Carmen 3-Quellen in Carmen 2 festnageln lässt, so scheint die Annahme vorläufig unfundierbar, und eine solche Rechnung mit dem unbekannten Anfang … wird durch die Stellung des Runenschlusses stark erschüttert.“"
                            },
                            {
                                "example_id": "557fcd32-45aa-4c1b-b650-170f3ac2d6e8",
                                "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                                "text": "„Das Nichts hat keinen Grund, ist weder Grund noch möglicher Anfang, ist unfundierbar und die Aufhebung der Fundamente des Seinkönnens.“"
                            },
                            {
                                "example_id": "700e8300-996e-40e5-b6b8-3c577faed1c1",
                                "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                                "text": "„Die Forum-Redaktion ist der Auffassung, daß beim gegenwärtigen Mangel an zuverlässiger Information jede Art von öffentlichen Erwägungen über Umstände und Beweggründe einer möglichen übersiedlung Tombergs in die DDR unfundierbar und deshalb schädlich ist ….“"
                            },
                            {
                                "example_id": "4beacc69-c078-4a26-96c6-6a88891f5db2",
                                "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                                "text": "„»Second Life war einfach unfundierbar«, sagt der Mann, der sich diese virtuelle Welt ausgedacht hat.“"
                            },
                            {
                                "example_id": "96dc512a-e28b-4cfe-b8b0-6ab8ee7d76eb",
                                "sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                                "text": "„In der heutigen täglichen Lebensdauer ist Elektrizität ein wesentlicher Rohstoff für den reibungslosen Laufen des Lebens. Das Leben ohne Macht ist unfundierbar, bedeutet aber gleichzeitig Elektrizität Drähte / Kabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cf3670a-3e69-4d06-9dd8-22f154cc687b",
                        "source_entry_id": "dafd23f9-34ae-3449-9dc3-178904631ffb",
                        "source_sense_id": "c1c22ccc-92f1-3099-80a0-77f8c71dc862",
                        "source_sense_description": "so, dass es nicht fundiert werden kann",
                        "target_lang_word": "ungroundable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungroundable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "341cf80e-cef5-3e6f-b09e-04a8e9840d9e",
                                        "entry_id": "c603d103-99d1-356f-8934-50efc26aa365",
                                        "glosses": [
                                            "Not groundable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c915d67c-fcf2-4a5e-9066-f78bd859fd02",
                                                "sense_id": "341cf80e-cef5-3e6f-b09e-04a8e9840d9e",
                                                "text": "2008, South Park (TV series), The Ungroundable\nYou can't ground me, for I'm neither living nor dead. How can thy ground that which is ungroundable?"
                                            },
                                            {
                                                "example_id": "c8b93746-f62e-49a6-b790-3ddfce309680",
                                                "sense_id": "341cf80e-cef5-3e6f-b09e-04a8e9840d9e",
                                                "text": "“We're nineteen. Soon we'll be out of the teens.” “And ungroundable,” Eve agreed darkly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90fd825-51d8-3f9e-9a5d-2e48fe14d5ff",
                                        "entry_id": "c603d103-99d1-356f-8934-50efc26aa365",
                                        "glosses": [
                                            "Not groundable.",
                                            "Impossible to ground."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829fc464-191c-4302-980e-1f523c8fc964",
                                                "sense_id": "c90fd825-51d8-3f9e-9a5d-2e48fe14d5ff",
                                                "text": "Insisting on existential decision as the last word in such an ungroundable sphere is one way of understanding ethical responsibility."
                                            },
                                            {
                                                "example_id": "9c96479e-def9-4f4f-88bc-decd76950969",
                                                "sense_id": "c90fd825-51d8-3f9e-9a5d-2e48fe14d5ff",
                                                "text": "[…] judgments that are ungroundable because infinitely reflective […]"
                                            },
                                            {
                                                "example_id": "e03489fa-6c2b-4441-9f2a-ca750aea0b59",
                                                "sense_id": "c90fd825-51d8-3f9e-9a5d-2e48fe14d5ff",
                                                "text": "Our rational functioning draws energy and guidance from a basic, rationally ungroundable stance or orientation […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1666a8-b93a-312f-901c-dac2feeb736a",
                                        "entry_id": "c603d103-99d1-356f-8934-50efc26aa365",
                                        "glosses": [
                                            "Not groundable.",
                                            "Unable to be electrically grounded."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e631864-233c-4887-a3e6-b61e924e3226",
                                                "sense_id": "ca1666a8-b93a-312f-901c-dac2feeb736a",
                                                "text": "Needless to say, clothing is ungroundable, so short sleeves are recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
