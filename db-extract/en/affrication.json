                    {
                        "translation_id": "35225d3e-b6e6-423e-8e00-8860364fb402",
                        "source_entry_id": "1d5061cc-a963-39c1-809a-d0986b7f6221",
                        "source_sense_description": "the process of becoming an affricate",
                        "target_lang_word": "affrication",
