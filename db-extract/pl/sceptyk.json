                                "target_senses": [
                                    {
                                        "sense_id": "486ec851-b7a3-3f89-a48e-ad8ba40b5c7e",
                                        "entry_id": "6db97240-6aab-3c1d-a456-b23d48dee213",
                                        "glosses": [
                                            "истор., филос. в античности — представитель философского направления, выдвигающего сомнение в возможностях мышления, в надёжности истины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977c2f85-847f-49a3-a4cf-cae6a7cedd8c",
                                                "sense_id": "486ec851-b7a3-3f89-a48e-ad8ba40b5c7e",
                                                "text": "Возникновение школы скептиков относится к концу IV в. до н. э."
                                            },
                                            {
                                                "example_id": "154f4520-635d-48c7-b736-a66b49bb2257",
                                                "sense_id": "486ec851-b7a3-3f89-a48e-ad8ba40b5c7e",
                                                "text": "Будучи проницательными критиками, скептики умели находить слабые стороны теории познания и логики различных философских школ, нащупывать уязвимые места в их учениях и давать им критику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b46e5b6-ef83-32f6-9dd1-d4b996a999c4",
                                        "entry_id": "6db97240-6aab-3c1d-a456-b23d48dee213",
                                        "glosses": [
                                            "человек, относящийся ко всему с недоверием, сомнением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bea401-9301-437f-9246-0fed43486142",
                                                "sense_id": "7b46e5b6-ef83-32f6-9dd1-d4b996a999c4",
                                                "text": "А всего лишь несколько лет назад скептики предрекали, что Сити превратится в долгострой."
                                            },
                                            {
                                                "example_id": "47be0ae9-5cee-4b70-bfc8-5e7e56278438",
                                                "sense_id": "7b46e5b6-ef83-32f6-9dd1-d4b996a999c4",
                                                "text": "Заключённые любили этот пышный хлеб, огромные «пайки», но скептики говорили: — Что это за хлеб — никакого говна нет, десятый день не оправляюсь."
                                            },
                                            {
                                                "example_id": "b69f4f02-917b-4773-ae2f-211c40053324",
                                                "sense_id": "7b46e5b6-ef83-32f6-9dd1-d4b996a999c4",
                                                "text": "Результаты получились не просто интересными, а вполне убедительными даже для пессимистов и скептиков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
