                    {
                        "sense_id": "9a36b10f-39bd-3f1e-b688-3e22fdb75699",
                        "entry_id": "5427d312-3529-3f38-8654-f1af1ddc5ab3",
                        "glosses": [
                            "Hafenstadt in Mittelitalien, an der Adria; Hauptstadt der Region Marken"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "e42fa053-c497-4f33-ae67-22428f8c03cf",
                                "sense_id": "9a36b10f-39bd-3f1e-b688-3e22fdb75699",
                                "text": "„Ich schreibe dies in Livias Zimmer an ihrem Tisch, mit dem Blick aufs Meer, das den Horizont hinter allen Schornsteinen von Ancona abschließt. Das Meeresufer ist nicht herrlich wie in Neapel; es sind öde Felsen. Bäume gibt es in Ancona nicht.“"
                            },
                            {
                                "example_id": "d369595d-b3da-4ff0-9686-46078c0c1ca3",
                                "sense_id": "9a36b10f-39bd-3f1e-b688-3e22fdb75699",
                                "text": "„Am 25. Februar traf ich bei Einbruch der Nacht im besten Gasthof Anconas ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
