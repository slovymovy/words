                        "target_lang_word": "ligne de flottaison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligne de flottaison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                        "entry_id": "0c58edea-4b98-34e5-a866-358e25926c41",
                                        "glosses": [
                                            "Ligne qui sépare la partie submergée de celle qui ne l’est pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88cadcc0-03bc-4c35-a0a6-4626e13899a7",
                                                "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                                "text": "Le chebek est un bâtiment élégant et rapide. Il a un faible tirant d’eau avec une ligne de flottaison concave vers l'avant et des flancs bombés ; […]."
                                            },
                                            {
                                                "example_id": "c21adda3-2b54-46f6-b4b8-6cd2b8ff2856",
                                                "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                                "text": "Plus dense que le Cocos nucifera le coco de mer a sa ligne de flottaison trop basse et l’eau pénétrant dans la graine, elle arrive morte sur les côtes étrangères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe44837-12e6-3c49-a10d-d56bbfa411c3",
                                        "entry_id": "0c58edea-4b98-34e5-a866-358e25926c41",
                                        "glosses": [
                                            "Partie visible d'un site web sans utilisation de la barre de défilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302f973d-adab-4dc5-be67-ba52ce387511",
                                                "sense_id": "4fe44837-12e6-3c49-a10d-d56bbfa411c3",
                                                "text": "Ne mettez pas ce bouton sous la ligne de flottaison par exemple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01728b33-22c3-4bde-9364-4e078af16b12",
                        "source_entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                        "source_sense_description": "line on the hull of a ship",
                        "target_lang_word": "Wasserlinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserlinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                        "entry_id": "b0731447-85ce-3e37-a377-fad48bbbfb5f",
                                        "glosses": [
                                            "Linie, bis zu der ein Schiffsrumpf ins Wasser einsinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22776537-c6b4-4194-ab31-87a31293e81b",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "Das Schiff wurde durch einen Torpedo direkt unter der Wasserlinie getroffen."
                                            },
                                            {
                                                "example_id": "c03fafed-14d3-494e-8fa4-9b7b7a220ad3",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Der erste Torpedo traf tief unter der Wasserlinie den Bug des Schiffes dort, wo die Mannschaftsräume lagen.“"
                                            },
                                            {
                                                "example_id": "2e90bc7b-b76d-4af9-8671-e443dafaf866",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Dieser sollte als Rammsporn dienen, feindliche Schiffe unter der Wasserlinie leck schlagen und versenken.“"
                                            },
                                            {
                                                "example_id": "3a63d4bf-6f6e-42b9-8cac-843080cc8a69",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Das Fenster liegt einen knappen Meter über der Wasserlinie.“"
                                            },
                                            {
                                                "example_id": "ebc2089e-2a41-4fc6-819c-e9a278c3a218",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Der Reporter erklärte, dass die Staumauer am oberen Ende beschädigt sei und der Schaden sich glücklicherweise nur bis etwa zwei Meter unter die Wasserlinie erstrecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
