                "senses": [
                    {
                        "sense_id": "2c49a450-b871-3db5-abd2-194be447c40a",
                        "entry_id": "9531ecea-602d-3882-8c66-737f24467053",
                        "glosses": [
                            "eines der im Volksglauben der Antike und des Mittelalters bevorzugt in der Mittagsstunde erscheinenden Geister und Wesen, das von einem Menschen Besitz ergreift und ihn negativ beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5404f5da-cd7e-411e-aaaf-43466da88899",
                                "sense_id": "2c49a450-b871-3db5-abd2-194be447c40a",
                                "text": "Die Mönchskrankheit ist also ein Phämonen des Mittags, weshalb Acedia als daemonium meridianum, als Mittagsdämon, bezeichnet wird."
                            },
                            {
                                "example_id": "d58d3d0d-1bb5-4853-807d-36118f40d082",
                                "sense_id": "2c49a450-b871-3db5-abd2-194be447c40a",
                                "text": "Mittagsdämon wurde auf deutschem Gebiet zum ersten Mal von Caesarius von Heisterbach in seinem „Dialogus miraculorum“ aus dem 13. Jahrhundert erwähnt."
                            },
                            {
                                "example_id": "d5647eef-61fb-46f0-80c4-dabf1c4c54ad",
                                "sense_id": "2c49a450-b871-3db5-abd2-194be447c40a",
                                "text": "Der Mittagsdämon wird auch im Talmud mehrfach erwähnt."
                            },
                            {
                                "example_id": "54ef811c-ca17-41e5-91f6-62fb299d592e",
                                "sense_id": "2c49a450-b871-3db5-abd2-194be447c40a",
                                "text": "„Der Dämon der Akedia, den man auch Mittagsdämon nennt, ist der gefährlichste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
