                                "target_senses": [
                                    {
                                        "sense_id": "6b2cb29d-4fdf-3c54-9f9f-9ae8fead09c1",
                                        "entry_id": "beaa0e89-5e43-3fd3-94f0-811f2db457c0",
                                        "glosses": [
                                            "Mourir avant un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81224a1e-0453-4bbb-9b14-5816ce3deef9",
                                                "sense_id": "6b2cb29d-4fdf-3c54-9f9f-9ae8fead09c1",
                                                "text": "Si le fils venant à prédécéder sans enfants, le père reprend par droit de retour le fidéicommis, auquel il avait renoncé."
                                            }
                                        ]
