        "fr-extract.jsonl": [
            {
                "entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                "word": "narcose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "901452a0-f9c1-40d2-a82f-d7e81a6c688d",
                        "entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                        "tags": [
                            "plural"
                        ],
                        "form": "narcoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8588086a-a161-3f72-8ffa-ff45c3b687bb",
                        "entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                        "glosses": [
                            "Perte de conscience sous l'effet d'un narcotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849dc943-5226-43b6-8696-71a4ec9fc09f",
                                "sense_id": "8588086a-a161-3f72-8ffa-ff45c3b687bb",
                                "text": "En plus des expériences cliniques avec narcose mixte et barbiturique, nous avons voulu étudier électroencéphalographiquement l'action du R sur le sommeil barbiturique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf91c52-9c84-3b82-bf58-d64bef611c98",
                        "entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                        "glosses": [
                            "Anesthésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c769c0-e17c-434c-8f6e-5e3f778f9c9f",
                                "sense_id": "0bf91c52-9c84-3b82-bf58-d64bef611c98",
                                "text": "La mort survient pendant la narcose ou après l'opération."
                            }
                        ]
                    },
                    {
                        "sense_id": "e71d9800-58bd-3bcb-b615-82d052150dbe",
                        "entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                        "glosses": [
                            "Narcose à l'azote, ivresse des profondeurs."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "4d7e1cce-36e1-4437-af8d-e4304b26e934",
                                "sense_id": "e71d9800-58bd-3bcb-b615-82d052150dbe",
                                "text": "Une grande partie des narcoses surviennent lors de la plongée profonde. Elle débute vers 30 mètres pour certains et devient systématique à partir de 60 mètres."
                            },
                            {
                                "example_id": "39c4b473-b7a9-4b9f-9d45-fa5b29899210",
                                "sense_id": "e71d9800-58bd-3bcb-b615-82d052150dbe",
                                "text": "L’explication la plus plausible de cet incident serait une fausse manœuvre lors du gonflage des bouteilles, la présence dans celles-ci de vapeurs d’huile et d’oxyde de carbone. Peut-être aussi une sorte de narcose dues à des plongées successives et à l’excès de gaz carbonique provenant des efforts effectués par les plongeurs qui tentaient en effet de remonter une pierre sculptée qu’ils avaient repéré le jour même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df53b45b-0f1d-40f8-a7bc-10e2b31db20e",
                        "source_entry_id": "a09cabcd-a6ae-3523-86ee-69cd1fc4d98f",
                        "source_sense_description": "perte de connaissance sous l'effet d'un narcotique",
                        "target_lang_word": "Narkose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narkose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "376ecf70-25fb-31de-b8b7-fd0893be34d3",
                                        "entry_id": "21531628-881d-3f62-b2fc-9c32a67401b1",
                                        "glosses": [
                                            "medikamentös herbeigeführter, kontrollierter Zustand der Bewusstlosigkeit, bei Bedarf mit Schmerzausschaltung und Muskelerschlaffung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8eca4b5-f1fc-4189-b926-0d07db5394d8",
                                                "sense_id": "376ecf70-25fb-31de-b8b7-fd0893be34d3",
                                                "text": "„Die Narkose ermöglicht die Durchführung von besonders schmerzhaften und auch anderweitig nicht vom Patienten tolerierten Prozeduren in der Human- und Veterinärmedizin.“"
                                            },
                                            {
                                                "example_id": "fa8bb88e-4e50-4306-9330-c04fee50e467",
                                                "sense_id": "376ecf70-25fb-31de-b8b7-fd0893be34d3",
                                                "text": "„Er mußte den Jungen, der abgezehrt und rachitisch aussah, während der Narkose beobachten.“"
                                            },
                                            {
                                                "example_id": "c295e76a-4b27-4952-82fb-8a92c3726f51",
                                                "sense_id": "376ecf70-25fb-31de-b8b7-fd0893be34d3",
                                                "text": "„Er stellte sich die Aufgabe zu untersuchen, ob man in der Narkose zuerst das Bewusstsein oder die Schmerzempfindung verliert.“"
                                            },
                                            {
                                                "example_id": "07548823-6818-4848-b726-c947a3bb5a6f",
                                                "sense_id": "376ecf70-25fb-31de-b8b7-fd0893be34d3",
                                                "text": "„Letztlich hat mir also der Suff das Leben gerettet, sagt Halldór breit grinsend zu seinem Sohn, als er nach der Operation aus der Narkose erwacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5935a87b-7e48-48b6-ba44-50f802ada97f",
