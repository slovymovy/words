                                "target_lang_word": "calmarsi",
                                "target_lang_sense_clarification": "ritrovare la tranquillità"
                            },
                            {
                                "target_lang_word": "acquietarsi",
                                "target_lang_sense_clarification": "placarsi gradualmente"
                            }
