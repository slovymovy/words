                ],
                "senses": [
                    {
                        "sense_id": "27e17cbe-6ad1-328d-82c1-60e52ddc212c",
                        "entry_id": "6b4256d1-94e1-3dee-b456-82a01d87c586",
                        "glosses": [
                            "устар. обильный, богатый злаками; плодородный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59641fbf-4d13-4310-928d-0201fad2eb6e",
                                "sense_id": "27e17cbe-6ad1-328d-82c1-60e52ddc212c",
                                "text": "Мне представились новые горы, новый горизонт; подо мною расстилались злачные, зелёные нивы."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4368b09-37c2-330c-b92d-fb1449d450a4",
                        "entry_id": "6b4256d1-94e1-3dee-b456-82a01d87c586",
                        "glosses": [
                            "перен., шутл.: связанный с кутежами, развратом"
                        ],
                        "tags": [
                            ", с доп., с сущ., обозначающем место, заведение и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "0270853c-add0-4cd7-9ba4-26f34246a9ea",
                                "sense_id": "b4368b09-37c2-330c-b92d-fb1449d450a4",
                                "text": "Он принялся ходить по берлинским злачным местам, глуша себя не столько вином, сколько танцами."
                            },
                            {
                                "example_id": "222441f5-5500-4c65-98f0-aa133dffebe2",
                                "sense_id": "b4368b09-37c2-330c-b92d-fb1449d450a4",
                                "text": "Как-то вечером я прочёсывал район Бульвар Клиши — подножие Монмартского холма, — знаменитый своими дешёвыми злачными местами."
                            }
                        ]
                    }
                ],
