                            {
                                "example_id": "5d833624-3e47-4fbc-af70-4e1a2f39d3be",
                                "sense_id": "8bcc39ca-4bb3-31d3-a8cb-6fb1f8509da3",
                                "text": "EINGSAUNG\nIn the folk beliefs of the Burman and Talaing people of Burma, these nats are benevolent house guardians that dwell in the south corner of the home in a post decorated with leaves. They are propitiated with offerings of coconuts."
