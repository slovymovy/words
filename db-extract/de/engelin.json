                ],
                "senses": [
                    {
                        "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                        "entry_id": "1b7d3e5a-d622-3d9e-a8a5-752b09a7801a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a598d92a-35d9-45db-bd6b-3034e6a99fdb",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Frau Engelin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "173865b8-4792-41e1-b17a-de952668dd32",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Herr Engelin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a4bc1e14-cd85-45e8-bfa8-5e0d46bf1e43",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Die Engelins kommen heute aus dem Waldviertel."
                            },
                            {
                                "example_id": "e29db640-dd48-436e-9d5a-1d3202214a18",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Der Engelin trägt nie die Schals, die die Engelin ihm strickt."
                            },
                            {
                                "example_id": "c1d22e6d-d24e-4a4c-9019-5389fb442d95",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Engelin kommt, geht der Herr Engelin.“"
                            },
                            {
                                "example_id": "b6566df7-94d5-46bf-a548-9eaabeeb252f",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Engelin kommt und geht."
                            },
                            {
                                "example_id": "12d700da-073d-4655-a1f8-14022662edec",
                                "sense_id": "b0ba3eba-ded6-3045-a549-323a4c3eb928",
                                "text": "Engelins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
