                                            {
                                                "example_id": "7e9be32e-c317-4d46-b90d-6a49979ab39c",
                                                "sense_id": "f0ee994c-fbe1-3fd3-a931-1a1d25bd07e7",
                                                "text": "Он вдруг почувствовал себя в положении мышонка, попавшегося в мышеловку на кусочек свиного сальца."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cdf0cc2-ddf6-3f04-ae8b-b79cb20c91bd",
