                                "example_id": "a79b3a19-678b-462b-9aef-ae1908142165",
                                "sense_id": "f23d6519-e5db-3463-baaf-c6cf930f9b84",
                                "text": "Remove everyday germs and neutralise cooking odours with our antibacterial handwash."
                            },
                            {
                                "example_id": "e7b33f93-6472-481f-b7d8-d69e5fde530f",
                                "sense_id": "f23d6519-e5db-3463-baaf-c6cf930f9b84",
                                "text": "Mum will always ask directly: “Amani, have you been washing your hands again?” Sounds like a strange question, doesn’t it? I mean, most parents would be pleased to have a hygienic child. But there’s that and then there’s using a whole bottle of handwash a day."
                            }
                        ]
