                "senses": [
                    {
                        "sense_id": "e9984058-b26d-3b3d-a27f-505b4ada1525",
                        "entry_id": "cdd769ed-dcac-33c4-9c8c-0234249f5e83",
                        "glosses": [
                            "Not able to be explained logically. Without being accountable, or reasonable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6659f97c-5f7e-4ec2-8cb8-62629565e273",
                                "sense_id": "e9984058-b26d-3b3d-a27f-505b4ada1525",
                                "text": "After all that hard work, he unaccountably failed to take out the patent."
                            },
                            {
                                "example_id": "e55f82db-6b0b-42fb-8ff5-31c41746578d",
                                "sense_id": "e9984058-b26d-3b3d-a27f-505b4ada1525",
                                "text": "The jury was unaccountably slow to reach a verdict. He was clearly innocent."
                            },
                            {
                                "example_id": "4782fafd-57b4-4692-b428-f97404aa8295",
                                "sense_id": "e9984058-b26d-3b3d-a27f-505b4ada1525",
                                "text": "The number 392, very unaccountably, was never filled, and two of the sets of parts never appear to have been assembled at all, and were presumably kept as spares."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "915c8ba1-0ab3-4a42-906e-f8a7649672d2",
                        "source_entry_id": "cdd769ed-dcac-33c4-9c8c-0234249f5e83",
                        "source_sense_id": "e9984058-b26d-3b3d-a27f-505b4ada1525",
                        "source_sense_description": "not able to be explained logically. Without being accountable, or reasonable",
                        "target_lang_word": "inexplicablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexplicablement",
