                    {
                        "form_id": "c3e9b8d9-4feb-49e9-a579-7e9c65aeaf10",
                        "entry_id": "9d300a6f-3ead-381e-b118-ba364de8dd2e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Agrammatismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                        "entry_id": "9d300a6f-3ead-381e-b118-ba364de8dd2e",
                        "glosses": [
                            "spezielle Form der Aphasie (Sprachstörung), bei der die Verwendung der grammatischen Elemente (Deklination, Konjugation, Funktionswörter) gestört ist"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3cdf161a-bd03-45f6-ae6c-5e5d8d8251a8",
                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                "text": "Agrammatismus gehört zum Erscheinungsbild der Broca-Aphasie."
                            },
                            {
                                "example_id": "65940a1a-26d6-44ae-b00a-7ee1102d46ac",
                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                "text": "„Gelegentlich wird Agrammatismus als Bezeichnung für die Entwicklungsstörung grammatischer Fähigkeiten bei Kindern verwendet (→ Dysgrammatismus).“"
                            },
                            {
                                "example_id": "64f9b670-bcf4-4df9-9e72-48a8da426b31",
                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                "text": "„Seit dieser Zeit haben Agrammatismus und Paragrammatismus nichts von ihrer faszinierenden Wirkung auf die Aphasieforschung, leider auch kaum etwas von der Rätselhaftigkeit ihrer Pathogenese eingebüßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4d3068e-3a26-33ce-80e0-67fb49473c78",
                        "entry_id": "9d300a6f-3ead-381e-b118-ba364de8dd2e",
                        "glosses": [
                            "grammatikalisch falsche Wortbildung, in der das Unvermögen, Wörter richtig zu verbinden, zum Ausdruck kommt"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5442d399-e343-45dc-a62b-99d74b6914fb",
                                "sense_id": "d4d3068e-3a26-33ce-80e0-67fb49473c78",
                                "text": "Kurts Sprache strotzt nur so vor Agrammatismen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
