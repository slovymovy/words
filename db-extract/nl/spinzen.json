        "nl-extract.jsonl": [
            {
                "entry_id": "3e5ced72-24e1-3e83-a8ae-1ffc8a3b0769",
                "word": "spinzen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94bb2f07-16ed-353e-8f35-fd05c533c2db",
                        "entry_id": "3e5ced72-24e1-3e83-a8ae-1ffc8a3b0769",
                        "glosses": [
                            "loeren om iets te kunnen krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123bd019-b00f-46d4-b041-45bebc754681",
                                "sense_id": "94bb2f07-16ed-353e-8f35-fd05c533c2db",
                                "text": "Van Hanegem benadrukte op de golfbaan dat hij helemaal geen interesse heeft in een plek in de technische staf. 'Ik heb Mario verzekerd dat ik nergens op zit te spinzen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34804f4f-800f-4e25-a7c7-262271081eb4",
                        "source_entry_id": "3e5ced72-24e1-3e83-a8ae-1ffc8a3b0769",
                        "source_sense_id": "94bb2f07-16ed-353e-8f35-fd05c533c2db",
                        "source_sense_description": "loeren om iets te kunnen krijgen",
                        "target_lang_word": "hope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                        "entry_id": "a6ed0dab-9999-3495-aac7-3ab10dffa91c",
                                        "glosses": [
                                            "To want (something) to happen, with a sense of expectation that it might [with that (+ clause); or (informal) with clause; or with so or (negative) not]."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d1b0ab-7f74-4f96-917a-8a675ba4354e",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "— Is he going to shut up soon? — I hope so."
                                            },
                                            {
                                                "example_id": "1f9e4773-7e52-4991-b770-14350ac55120",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "I'm going to get a new car. I hope it will be better than the last one."
                                            },
                                            {
                                                "example_id": "f5c0a78d-961d-4b9a-a441-1fd3be6a093d",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "They are hoping it does not rain, but I expect it will."
                                            },
                                            {
                                                "example_id": "1b539d27-f377-4a04-801a-fb37a3f908ef",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "He's still hoping that everything will turn out fine."
                                            },
                                            {
                                                "example_id": "d574dfd0-7950-4da4-8817-e3f4f0b59d3a",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "I'd hoped I'd find a job, but I never did, so I was hoping you could lend me some cash."
                                            },
                                            {
                                                "example_id": "43d87c7a-f438-4547-96cc-49adefd65e01",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "I hope {to - (that) I'll} have finished by next Sat at the latest."
                                            },
                                            {
                                                "example_id": "d2cd6c5e-a261-4be2-b4f9-819e2ec8a7e6",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "It is to be hoped that some corresponding smartening up of these other schedules may be expected before long."
                                            },
                                            {
                                                "example_id": "c819b522-4b82-4909-b78e-55404ba02db3",
                                                "sense_id": "9222c2a7-98ca-3860-a192-30af7d414457",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7597cb-ddb3-3744-a5a4-feb8e836f4d3",
                                        "entry_id": "a6ed0dab-9999-3495-aac7-3ab10dffa91c",
                                        "glosses": [
                                            "To intend to do something and look forward to the prospect of having done it [with to (+ infinitive)]."
                                        ],
                                        "tags": [
                                            "catenative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0981881-a08d-4070-8af7-4a2c77d436a1",
                                                "sense_id": "9d7597cb-ddb3-3744-a5a4-feb8e836f4d3",
                                                "text": "I hope to succeed."
                                            },
                                            {
                                                "example_id": "e47d4700-fcab-49a9-8f6e-edb907249df3",
                                                "sense_id": "9d7597cb-ddb3-3744-a5a4-feb8e836f4d3",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d022f258-7fea-3d31-9749-d9782a4ab7a3",
                                        "entry_id": "a6ed0dab-9999-3495-aac7-3ab10dffa91c",
                                        "glosses": [
                                            "To expect optimistically that one might get something (either a change in circumstance or an object) [with for]."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ef13e6-9fea-4abb-a632-bb2a39ce23a9",
                                                "sense_id": "d022f258-7fea-3d31-9749-d9782a4ab7a3",
                                                "text": "They're hoping for the best, but I don't think it's looking very good."
                                            },
                                            {
                                                "example_id": "2a638069-b490-4f0d-91bf-15fa91c4fe05",
                                                "sense_id": "d022f258-7fea-3d31-9749-d9782a4ab7a3",
                                                "text": "I'm hoping for my boss to offer me a pay raise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd28338b-9409-39ef-9951-73f2b82c4860",
                                        "entry_id": "a6ed0dab-9999-3495-aac7-3ab10dffa91c",
                                        "glosses": [
                                            "To place confidence; to trust with confident expectation of good [with in]."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d5c76d1-f1ae-4afd-9138-e31b39ce765d",
                                                "sense_id": "fd28338b-9409-39ef-9951-73f2b82c4860",
                                                "text": "I hope in thy word."
                                            },
                                            {
                                                "example_id": "1c3fabd6-ce80-4212-81e7-b32ca5fd1134",
                                                "sense_id": "fd28338b-9409-39ef-9951-73f2b82c4860",
                                                "text": "Why art thou cast down, O my soul? and why art thou disquieted within me? Hope thou in God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b7e760-3f76-3d5f-a39d-ff0df8cdbf47",
                                        "entry_id": "a6ed0dab-9999-3495-aac7-3ab10dffa91c",
                                        "glosses": [
                                            "To wish."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a17a2fb6-91fb-4042-9edb-d76d89f15653",
                                                "sense_id": "62b7e760-3f76-3d5f-a39d-ff0df8cdbf47",
                                                "text": "I hope you all the best."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66def986-40a9-3d7f-ba4c-695f89e60515",
                                        "entry_id": "1db7694b-a648-3642-85ad-57b387f568be",
                                        "glosses": [
                                            "The feeling of trust, confidence, belief or expectation that something wished for can or will happen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f677a6d-9f29-41fa-a827-783cc35ec4d2",
                                                "sense_id": "66def986-40a9-3d7f-ba4c-695f89e60515",
                                                "text": "All hopes for a truce are gone after the latest attack."
                                            },
                                            {
                                                "example_id": "b92dcd9c-f430-43ae-ad83-34e990a6b687",
                                                "sense_id": "66def986-40a9-3d7f-ba4c-695f89e60515",
                                                "text": "After losing my job, there's frail hope of affording my world cruise."
                                            },
                                            {
                                                "example_id": "19cd834f-bf30-4682-ba1c-7db2442b0c22",
                                                "sense_id": "66def986-40a9-3d7f-ba4c-695f89e60515",
                                                "text": "There is still hope that we can find our missing cat."
                                            },
                                            {
                                                "example_id": "3b1e863e-113f-4696-b164-ad0ed6293399",
                                                "sense_id": "66def986-40a9-3d7f-ba4c-695f89e60515",
                                                "text": "My hopes wa'n't disappointed. I never saw clams thicker than they was along them inshore flats. I filled my dreener in no time, and then it come to me that 'twouldn't be a bad idee to get a lot more, take 'em with me to Wellmouth, and peddle 'em out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05791cd-37c5-3371-bb42-1c11ba9c9556",
                                        "entry_id": "1db7694b-a648-3642-85ad-57b387f568be",
                                        "glosses": [
                                            "The actual thing wished for."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "486463e3-6fd8-377e-b081-6f35bc9f4f9f",
                                        "entry_id": "1db7694b-a648-3642-85ad-57b387f568be",
                                        "glosses": [
                                            "A person or thing that is a source of hope."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b5ef2-49ed-4b3d-869a-b779a6a7e081",
                                                "sense_id": "486463e3-6fd8-377e-b081-6f35bc9f4f9f",
                                                "text": "We still have one hope left: my roommate might see the note I left on the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c17d91-683d-37f9-bc72-f80bad5d5825",
                                        "entry_id": "1db7694b-a648-3642-85ad-57b387f568be",
                                        "glosses": [
                                            "The virtuous desire for future good."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77950b13-c735-432d-aa95-ffafd35bc754",
                                                "sense_id": "03c17d91-683d-37f9-bc72-f80bad5d5825",
                                                "text": "But now abideth faith, hope, love, these three; and the greatest of these is love."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bef3ab8-cdd0-30b2-a14d-4b159aefdf54",
                                        "entry_id": "196c3803-50a6-3033-a32d-7b7222952b9b",
                                        "glosses": [
                                            "A hollow; a valley, especially the upper end of a narrow mountain valley when it is nearly encircled by smooth, green slopes; a combe."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b922e5-1584-3412-918c-b0b9d9129511",
                                        "entry_id": "08e42350-c2c9-3615-81f5-085d8dd82e65",
                                        "glosses": [
                                            "A sloping plain between mountain ridges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a05f885-3725-373a-a25f-a0fe35561263",
                                        "entry_id": "08e42350-c2c9-3615-81f5-085d8dd82e65",
                                        "glosses": [
                                            "A small bay; an inlet; a haven."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9c3559-d552-4e24-a789-4abeeb002d64",
                                                "sense_id": "0a05f885-3725-373a-a25f-a0fe35561263",
                                                "text": "Being by contrarie winds driuen to staie against Erith, at Grauesend, in Tilberie hope."
                                            },
                                            {
                                                "example_id": "3026fc25-70d0-42c5-a74e-4ff070c9dfb7",
                                                "sense_id": "0a05f885-3725-373a-a25f-a0fe35561263",
                                                "text": "A little hamlet which straggled along the side of a creek formed by the discharge of a small brook into the sea[…]It was called Wolf's Hope (i.e. Wolf's Haven)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d24dfc4e-4cb6-4074-bec7-d576c72654e1",
                        "source_entry_id": "3e5ced72-24e1-3e83-a8ae-1ffc8a3b0769",
                        "source_sense_id": "94bb2f07-16ed-353e-8f35-fd05c533c2db",
                        "source_sense_description": "loeren om iets te kunnen krijgen",
                        "target_lang_word": "long for",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "long for",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d296c52b-0ede-3bf7-9593-23fe436e3799",
                                        "entry_id": "2e492514-250f-3852-9cd4-b94d4da0747d",
                                        "glosses": [
                                            "likely to remain for a long time"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0880c1a7-02cc-4dcd-8b96-095a74934faf",
                                                "sense_id": "d296c52b-0ede-3bf7-9593-23fe436e3799",
                                                "text": "I asked the doctor if I was long for this world"
                                            },
                                            {
                                                "example_id": "9678558b-4996-4f55-ab17-61bc5ca380d5",
                                                "sense_id": "d296c52b-0ede-3bf7-9593-23fe436e3799",
                                                "text": "But it doesn't matter, because Roxie's not long for this town. As soon as her mother's better, she'll be on her way to Paris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "long for",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da8b48bf-a8d5-3746-a2b1-051aed4eeb3b",
                                        "entry_id": "db50053e-4f1e-3b63-8147-390b2d33e95a",
                                        "glosses": [
                                            "To have a desire for (a thing or an event)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56e95c8-68ad-4d8a-8a4c-0519386108bc",
                                                "sense_id": "da8b48bf-a8d5-3746-a2b1-051aed4eeb3b",
                                                "text": "He was the object of my affection; I longed for him to notice me."
                                            },
                                            {
                                                "example_id": "b523598a-cc6f-433a-88af-8ff1b96e728a",
                                                "sense_id": "da8b48bf-a8d5-3746-a2b1-051aed4eeb3b",
                                                "text": "Oh how I long for this pandemic to end so we can go dancing again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf486ab-bb7e-3ccd-906c-0bac642ff09b",
                                        "entry_id": "db50053e-4f1e-3b63-8147-390b2d33e95a",
                                        "glosses": [
                                            "To miss (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a135d97e-abbf-49d3-993b-72301764687c",
                                                "sense_id": "eaf486ab-bb7e-3ccd-906c-0bac642ff09b",
                                                "text": "“I will stay now, if you bid me,” she replied, as low. “See, I am going to my mother, who longs for me as I for her. I will not go unless you let me.”"
                                            },
                                            {
                                                "example_id": "dd4ad2ec-df6c-477b-8fa4-ee5bad630334",
                                                "sense_id": "eaf486ab-bb7e-3ccd-906c-0bac642ff09b",
                                                "text": "For some time he had not heard from his consort[…]His heart longed for her and his child."
                                            },
                                            {
                                                "example_id": "71a97d7a-e00e-45b0-a515-94650cd995af",
                                                "sense_id": "eaf486ab-bb7e-3ccd-906c-0bac642ff09b",
                                                "text": "He remembered those long years before his marriage, when he had longed for her and she had resisted him[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca85fbfc-099c-421e-a155-2c4b82a2d57a",
