                "senses": [
                    {
                        "sense_id": "cc98a2e6-5737-3db5-8f73-22fc55ad2607",
                        "entry_id": "2e27b102-76b4-31cd-bb8f-a9758592cee9",
                        "glosses": [
                            "Mécanisme destiné à interrompre une partie de flipper quand le joueur triche en soulevant l'appareil de façon à en modifier l'inclinaison."
                        ],
                        "tags": [
                            "Billard électrique"
                        ],
                        "examples": [
                            {
                                "example_id": "691a6e10-d78e-4785-9213-233bcf938caa",
                                "sense_id": "cc98a2e6-5737-3db5-8f73-22fc55ad2607",
                                "text": "J'ai également mon public : les loubards qui sortent des minettes de Prisu et qui me dérangent en cognant contre le tilt du flipper, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d06c5f9-6a12-3259-adaf-f60c54d60d3e",
                        "entry_id": "2e27b102-76b4-31cd-bb8f-a9758592cee9",
                        "glosses": [
                            "Action provoquée par enclenchement de ce mécanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e5602c-a2de-48bb-9a9f-c17fbdcedfb3",
                                "sense_id": "7d06c5f9-6a12-3259-adaf-f60c54d60d3e",
                                "text": "Le tilt qui s'ensuivit produisit un bruit presque irréel. Un farfadet très agité et debout sous la plaque de verre du flipper se mit à ricaner en fixant Robert bizarrement."
                            },
                            {
                                "example_id": "0682c491-7f31-49fe-b700-ab43511c74ee",
                                "sense_id": "7d06c5f9-6a12-3259-adaf-f60c54d60d3e",
                                "text": "Les flippers Gottlieb voyaient leurs boules rebondir sur leurs bumpers, leurs kickers, leurs slingshots, leurs spinners tournaient comme les ailes de moulins les jours de grands vents. Des tilts résonnaient aux cadrans des frontons."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa902e12-d8fe-3c7c-8703-a1fa9558f6fe",
                        "entry_id": "2e27b102-76b4-31cd-bb8f-a9758592cee9",
                        "glosses": [
                            "Déclic d'un mécanisme. Déclic intellectuel."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "0d9499a5-01d7-4422-8cff-0e4a5fe5d9e2",
                                "sense_id": "aa902e12-d8fe-3c7c-8703-a1fa9558f6fe",
                                "text": "Harcèlement, un des mots qui provoque un tilt dans le cerveau d'Aude."
                            },
                            {
                                "example_id": "7a41bf21-0df6-42d0-9274-7aa9cbcf9d14",
                                "sense_id": "aa902e12-d8fe-3c7c-8703-a1fa9558f6fe",
                                "text": "Et là, un tilt, une connexion dans mon cerveau : je sais pourquoi elle n'en parle pas !"
                            }
                        ]
                    }
                ],
