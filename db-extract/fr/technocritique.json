            },
            {
                "entry_id": "e1b1ecb4-fc62-357d-8ba2-0b1c03a8f0e5",
                "word": "technocritique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b281aef-15e0-4dc7-afa4-f66ebedab47b",
