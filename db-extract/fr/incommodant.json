                "senses": [
                    {
                        "sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                        "entry_id": "c07f4bfe-e830-3711-88dd-0c16761cfcad",
                        "glosses": [
                            "Qui incommode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb4fbb1-e6d9-4943-812c-4723f57f06c6",
                                "sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                                "text": "Les bouffées de chaleur sont l’un des symptômes les plus incommodants de la ménopause."
                            },
                            {
                                "example_id": "361f8eed-4b99-40b7-9528-0d67a0deb2b8",
                                "sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                                "text": "Le deuxième serait le déni, car il est tentant de parfois fermer les yeux sur des constats parfois incommodants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3f423e6-b817-4233-b497-18245629b63a",
                        "source_entry_id": "c07f4bfe-e830-3711-88dd-0c16761cfcad",
                        "source_sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                        "target_lang_word": "hinderlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinderlijk",
