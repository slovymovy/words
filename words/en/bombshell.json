            "pos": "noun",
            "senses": [
                {
                    "sense_id": "447a5780-1978-3f98-ae7d-42a699336bea",
                    "sense_definition": "Something that is very surprising, shocking, or sensational.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shocking_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the sudden resignation came as a total <w>bombshell</w> to the entire staff.",
                            "target_lang_translations": {
                                "es": "La noticia de la repentina renuncia cayó como un auténtico <w>jarro de agua fría</w> sobre todo el personal."
                            }
                        },
                        {
                            "text": "Her announcement was a real <w>bombshell</w> that changed the direction of the entire project.",
                            "target_lang_translations": {
                                "es": "Su anuncio fue un verdadero <w>bombazo</w> que cambió el rumbo de todo el proyecto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drop a bombshell"
                    ],
                    "target_lang_definitions": {
                        "es": "Noticia, hecho o acontecimiento muy sorprendente, impactante o sensacional."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "bombazo",
                                "target_lang_sense_clarification": "noticia o hecho impactante"
                            },
                            {
                                "target_lang_word": "bomba",
                                "target_lang_sense_clarification": "noticia imprevista y sensacional"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8197d395-830a-3afa-a7c4-ebc71ceadfb8",
                    "sense_definition": "A person who is considered extremely attractive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attractive_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was known as a classic Hollywood <w>bombshell</w> during the golden age of cinema.",
                            "target_lang_translations": {
                                "es": "Era conocida como una clásica <w>bomba</w> de Hollywood durante la época dorada del cine."
                            }
                        },
                        {
                            "text": "The actress was often cast in roles that highlighted her status as a blonde <w>bombshell</w>.",
                            "target_lang_translations": {
                                "es": "A menudo le daban a la actriz papeles que destacaban su estatus de <w>rubia despampanante</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blonde bombshell"
                    ],
                    "target_lang_definitions": {
                        "es": "Persona, especialmente una mujer, considerada sumamente atractiva o exuberante."
                    },
                    "translations": {
