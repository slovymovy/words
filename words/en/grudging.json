{
    "word_family": [
        "grudge"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0feea026-af4d-37f0-9dee-734aec924aac",
                    "sense_definition": "Given or done in an unwilling or reluctant way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>grudging</w> apology after the argument.",
                            "target_lang_translations": {
                                "nl": "Ze bood na de ruzie haar excuses aan met <w>wrokkige tegenzin</w>."
                            }
                        },
                        {
                            "text": "He offered a <w>grudging</w> admission that he was wrong.",
                            "target_lang_translations": {
                                "nl": "Hij gaf met <w>tegenzin</w> toe dat hij ongelijk had."
                            }
                        }
                    ],
                    "synonyms": [
                        "reluctant",
                        "unwilling"
                    ],
                    "antonyms": [
                        "willing",
                        "enthusiastic"
                    ],
                    "common_phrases": [
                        "grudging respect",
                        "grudging acceptance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat met tegenzin of onwilligheid wordt gegeven of gedaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wrokkig",
                                "target_lang_sense_clarification": "gekenmerkt door wrok of onwil"
                            },
                            {
                                "target_lang_word": "met tegenzin",
                                "target_lang_sense_clarification": "uitgedrukt als een bijwoordelijke bepaling"
                            },
                            {
                                "target_lang_word": "gedwongen",
                                "target_lang_sense_clarification": "niet uit vrije wil gedaan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfddd33d-f61a-3262-9b83-43904ea01371",
                    "sense_definition": "The act of expressing resentment or dissatisfaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>grudgings</w> of the staff made the work environment very difficult.",
                            "target_lang_translations": {
                                "nl": "Het constante <w>geklaag</w> van het personeel maakte de werkomgeving erg moeilijk."
                            }
                        },
                        {
                            "text": "He listened to their <w>grudgings</w> without saying a single word in his defense.",
                            "target_lang_translations": {
                                "nl": "Hij luisterde naar hun <w>gemor</w> zonder een woord ter verdediging te zeggen."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "resentment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het uiten van wrok, ontevredenheid of klachten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geklaag",
                                "target_lang_sense_clarification": "het voortdurend uiten van ontevredenheid"
                            },
                            {
                                "target_lang_word": "gemor",
                                "target_lang_sense_clarification": "het uiten van ongenoegen op een stille of onderdrukte manier"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21de3477-855f-3c4b-9b62-3eee64ebcc90",
                    "sense_definition": "Present participle and gerund of <w>grudge</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>grudging</w> the time he has to spend on this project.",
                            "target_lang_translations": {
                                "nl": "Hij <w>staat met tegenzin de tijd af</w> die hij aan dit project moet besteden."
                            }
                        },
                        {
                            "text": "She is <w>grudging</w> him the success he worked so hard to achieve.",
                            "target_lang_translations": {
                                "nl": "Ze <w>misgunt</w> hem het succes waar hij zo hard voor heeft gewerkt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb grudge."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het misgunnen van iets aan iemand of het met tegenzin afstaan van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "misgunnen",
                                "target_lang_sense_clarification": "iemand iets niet gunnen"
                            },
                            {
                                "target_lang_word": "met tegenzin afstaan",
                                "target_lang_sense_clarification": "iets geven terwijl je dat liever niet doet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}