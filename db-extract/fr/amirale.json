                                    {
                                        "sense_id": "b21ebe61-d1b5-3755-b7da-d0bc692d396d",
                                        "entry_id": "a9909216-ba79-3c24-9049-bdaa9fb2c0ae",
                                        "glosses": [
                                            "A female admiral."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6317664f-196e-4728-ab03-00a28b4e1c71",
                                                "sense_id": "b21ebe61-d1b5-3755-b7da-d0bc692d396d",
                                                "text": "The Czar has conferred upon Queen Olga (consort of the King of Greece), the honorary position of an admiral of the Russian fleet."
                                            },
                                            {
                                                "example_id": "fc4e0099-4c6b-4af6-934b-35dfe9e115ea",
                                                "sense_id": "b21ebe61-d1b5-3755-b7da-d0bc692d396d",
                                                "text": "The famous royal yacht Osborne is now considered too old for the use of the Royal family, and is to be replaced by a new turbine yacht—the Alexandra. She has been built on the Clyde and has been launched this week by Princess Louise, the Duchess of Argyll, who is \"Admiraless\" of the Western Coast."
                                            },
                                            {
                                                "example_id": "21eeced2-5975-4380-9059-889514be3aab",
                                                "sense_id": "b21ebe61-d1b5-3755-b7da-d0bc692d396d",
                                                "text": "Admiraless Artemis was the commander of the naval forces of the Persian Empire during the reign of emperor Khashayar (Xerxes)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7de1520-77a8-3c12-a45d-8f80ab7d9371",
                                        "entry_id": "a9909216-ba79-3c24-9049-bdaa9fb2c0ae",
                                        "glosses": [
                                            "The wife of an admiral."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403b9449-ae8a-4f0f-8b24-58576e10e7bd",
                                                "sense_id": "e7de1520-77a8-3c12-a45d-8f80ab7d9371",
                                                "text": "We were met at the entrance by the Admiral and Admiraless and given the freedom of the house."
                                            },
                                            {
                                                "example_id": "d88bdc29-2d0e-47ed-ac65-ede03ea63121",
                                                "sense_id": "e7de1520-77a8-3c12-a45d-8f80ab7d9371",
                                                "text": "Interest centred somewhat on Mrs. King-Hall's \"At Home,\" held on Thursday, as this was the first function at Admiralty House since the incoming of the new Admiral. Sydney has already taken to the Admiraless and her young daughter."
                                            },
                                            {
                                                "example_id": "8ad396a1-1c7e-4a74-96e3-c8668b917c71",
                                                "sense_id": "e7de1520-77a8-3c12-a45d-8f80ab7d9371",
                                                "text": "The Admiral, Admiraless and Miss P[aterson] came down in the afternoon. I introduced the Admiral to Lord Sackville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
