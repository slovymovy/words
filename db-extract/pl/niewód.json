                                "target_senses": [
                                    {
                                        "sense_id": "37952f6b-362e-3c3f-ace3-fe34757f087d",
                                        "entry_id": "0255c19e-7165-37fb-8814-63edd08f565b",
                                        "glosses": [
                                            "большая рыболовная сеть, состоящая из мотни посередине и двух боковых крыльев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f524614-ca89-429e-8471-7b0a94b43550",
                                                "sense_id": "37952f6b-362e-3c3f-ace3-fe34757f087d",
                                                "text": "Старик ловил неводом рыбу"
                                            },
                                            {
                                                "example_id": "9e9a42d3-2cdb-4fd3-93fe-031c90759120",
                                                "sense_id": "37952f6b-362e-3c3f-ace3-fe34757f087d",
                                                "text": "Впереди невода рыбы не ловят (она уж поймана). На невод не ступать и не плевать, рыба не будет ловиться, поверье. Не неводом, не вытащишь, говоря о том, чего нельзя достать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
