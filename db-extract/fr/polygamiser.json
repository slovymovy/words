                "senses": [
                    {
                        "sense_id": "006ab47c-bf2a-3d61-8838-ff50f20232ce",
                        "entry_id": "489cfd31-71d6-3874-a788-65b5e662990f",
                        "glosses": [
                            "Donner un caractère polygame à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50965c0-9e51-48c9-bea5-bc022e3ebbae",
                                "sense_id": "006ab47c-bf2a-3d61-8838-ff50f20232ce",
                                "text": "La vocation de jouer les doublures, de polygamiser notre relation devait devenir une évidence mondaine et non plus un sacrilège barbare."
                            },
                            {
                                "example_id": "f63fbfc4-b5de-47a3-acff-9592a3b3f9a4",
                                "sense_id": "006ab47c-bf2a-3d61-8838-ff50f20232ce",
                                "text": "La Coordination des femmes noires dénonce la condition des femmes mais aussi le racisme, le néocolonialisme : « nous ne sommes pas à exploiter, consommer, polygamiser, prostituer, ethnologiser, coloniser »."
                            },
                            {
                                "example_id": "119f0125-49d1-4817-bfab-c9837abe9e49",
                                "sense_id": "006ab47c-bf2a-3d61-8838-ff50f20232ce",
                                "text": "Peut-on considérer que le mari trompe sa femme, s'il est dans l'optique de \"polygamiser\" sa relation ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4282759-47f0-314f-83ec-389321ee3ab2",
                        "entry_id": "489cfd31-71d6-3874-a788-65b5e662990f",
                        "glosses": [
                            "Pratiquer la polygamie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a728a56-ccb0-482a-8a31-af7248de73a1",
                                "sense_id": "e4282759-47f0-314f-83ec-389321ee3ab2",
                                "text": "On leur reproche à ces émigrés enfermés à la périphérie, pratiquement exclus bénévoles de la grande Patrie française, de polygamiser ;"
                            }
                        ]
                    }
