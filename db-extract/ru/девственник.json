                "senses": [
                    {
                        "sense_id": "76a70834-5e2c-33a7-89ba-43ceaba5ff9b",
                        "entry_id": "1dafeaa6-5659-3498-af33-77868ffffff9",
                        "glosses": [
                            "тот, кто сохраняет девственность, не вступает в половые связи"
