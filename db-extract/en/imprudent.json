                        "source_sense_id": "a9f0fb56-e19f-33bc-b7a9-9c5baf7c95ac",
                        "source_sense_description": "not prudent; wanting in prudence or discretion; indiscreet; injudicious; not attentive to consequence; improper",
                        "target_lang_word": "unbedacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
