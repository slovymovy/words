                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95359dbb-25f9-39a7-a658-7be20f0e7cc0",
                                        "entry_id": "4832524b-1a3c-3897-b3ed-ee3a5dd9e8c0",
                                        "glosses": [
                                            "Überempfindlichkeit gegenüber Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3619932c-cebc-4c66-8949-19ff9e3cf8bc",
                                                "sense_id": "95359dbb-25f9-39a7-a658-7be20f0e7cc0",
                                                "text": "Er leidet an chronischer Lichtscheu."
                                            },
                                            {
                                                "example_id": "4e1cd0fa-d775-41cd-be43-3bec9f2ed738",
                                                "sense_id": "95359dbb-25f9-39a7-a658-7be20f0e7cc0",
                                                "text": "„Vor 2 Wochen begann am linken Auge, unter sehr heftigen Symptomen, ebenfalls Keratoconjunctivitis mit starker Lichtscheu.“"
                                            },
                                            {
                                                "example_id": "d494d5a3-3571-46bf-ba73-cbe6002eddd4",
                                                "sense_id": "95359dbb-25f9-39a7-a658-7be20f0e7cc0",
                                                "text": "„Lichtscheu kann man auch bei verschiedenen ernsten Augenerkrankungen beobachten und es bedarf deswegen einer augenärztlichen Abklärung.“"
                                            },
                                            {
                                                "example_id": "e268cfb8-2e6d-442a-8254-03e6c7993537",
                                                "sense_id": "95359dbb-25f9-39a7-a658-7be20f0e7cc0",
                                                "text": "„Die Lichtscheu ist jederzeit sehr intensiv, obschon Kinder oft in der freien Luft die Augen öffnen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
