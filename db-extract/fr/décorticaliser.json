                "senses": [
                    {
                        "sense_id": "24d2e571-89b5-3993-bcb8-51fd62ece0fe",
                        "entry_id": "acaea199-25a0-39cf-9e73-87f0aec0900b",
                        "glosses": [
                            "Faire perdre son caractère cortical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e10ed82-21f1-46d8-bd07-f953c86e8aa2",
                                "sense_id": "24d2e571-89b5-3993-bcb8-51fd62ece0fe",
                                "text": "L’émotion est subliminale. À haute dose, elle décorticalise les hommes ou leur provoque des réactions dénuées de tout sens commun."
                            },
                            {
                                "example_id": "7c9e4b64-052c-41a0-97db-1f7d7b12643e",
                                "sense_id": "24d2e571-89b5-3993-bcb8-51fd62ece0fe",
                                "text": "Une des faces de la rondelle osseuse de greffe est décorticalisée sur 1 à 1,5 mm à l’aide de la pince gouge en préservant un « cône spongieux » central qui qui viendra épouser la concavité de la surface radiale."
                            }
                        ]
                    }
