                ],
                "senses": [
                    {
                        "sense_id": "6bd98973-9ed2-373a-a738-58931c9487bf",
                        "entry_id": "d205e4dc-6786-3e66-a5c6-091d13933dc2",
                        "glosses": [
                            "toepasbaar voor alle situaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a9c39dc-6e12-49ae-a756-18622583d954",
                                "sense_id": "6bd98973-9ed2-373a-a738-58931c9487bf",
                                "text": "GroenLinks is ook kritisch: ,,Mijn fractie zal nooit voor een wet stemmen die allesomvattend is’’, zegt Klaver. ,,We moeten oppassen dat de tijdelijke situatie nu wettelijk gaan vastleggen. Ingrijpende beslissingen zullen altijd langs het parlement moeten.’’"
                            },
                            {
                                "example_id": "b13a5cc8-1575-46a8-ab3e-3ad3f7515d7a",
                                "sense_id": "6bd98973-9ed2-373a-a738-58931c9487bf",
                                "text": "„Ja. Er is niets wat ik niet zou doen om jouw vrouw uit het leven van mijn kind te houden. Zelfs als dat betekent dat we jou zouden kwijtraken.” Ik loop naar hem toe. Die ene vraag, die allesomvattende vraag waarvan het antwoord Mark met één klap uit mijn leven weg kan vagen, heeft hij nog niet gesteld: ben ik wel Ella’s vader?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77821679-773e-4a38-bcec-357ce86a6f0c",
                        "source_entry_id": "d205e4dc-6786-3e66-a5c6-091d13933dc2",
                        "source_sense_id": "6bd98973-9ed2-373a-a738-58931c9487bf",
                        "source_sense_description": "toepasbaar voor alle situaties",
                        "target_lang_word": "all-embracing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all-embracing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a56842-baa1-38a7-b9c0-af569aed30c5",
                                        "entry_id": "aa0509e3-b71d-3a04-b6df-59c989db487a",
                                        "glosses": [
                                            "Having a broad scope; of universal application."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1e2cba-553b-4c61-a00c-44b5e4b14ae7",
                                                "sense_id": "e8a56842-baa1-38a7-b9c0-af569aed30c5",
                                                "text": "The trouble today is that few such causes of delay are taken up with the people concerned; \"there is a war on\" provides the usual all-embracing excuse."
                                            },
                                            {
                                                "example_id": "64edb9d3-f498-4a9b-9c82-240460400c72",
                                                "sense_id": "e8a56842-baa1-38a7-b9c0-af569aed30c5",
                                                "text": "[...] at each station the train times are not shown in one all-embracing chronological list, but in two separate sheets, one with a conspicuous band of yellow detailing westbound departures and the other with a similar band of blue the eastbound trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
