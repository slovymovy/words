                ],
                "senses": [
                    {
                        "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                        "entry_id": "2bac038d-c0e9-3011-bbb5-3fea93c6e8ad",
                        "glosses": [
                            "so groß wie eine Faust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a57f577-17b3-4c76-b5fd-76b62a6d54a8",
                                "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                                "text": "„Faustgroße Hagelkörner prasselten auf ihre junge Kopfhaut.“"
                            },
                            {
                                "example_id": "78fd7da9-4a51-40a1-addc-dfe37f4e102c",
                                "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                                "text": "„Auf der anderen Seite des Schädels klaffte ein faustgroßes Loch, spie einen gewaltigen Blutschwall aus; die Frau kippte vornüber und lag dann, für immer erloschen, in ihrem Blut.“"
                            },
                            {
                                "example_id": "d03d6ded-348e-48e4-aa9e-5dad3246cc37",
                                "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                                "text": "„Sie lieh mir einen dünnen Seidenschal, um den faustgroßen Knutschfleck an meinem Hals zu kaschieren.“"
                            },
                            {
                                "example_id": "31cc2ad7-e278-4626-9377-0a8500629269",
                                "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                                "text": "„Er hatte schwarzes Fell mit einem faustgroßen weißen Tupfer auf der Brust.“"
                            },
                            {
                                "example_id": "1744eb10-e6ae-44aa-a5e7-f01d173aedcf",
                                "sense_id": "aa278983-461f-3712-b8d9-7f59619e65e4",
                                "text": "„Und inzwischen mochte er auch das mantou sehr gerne, das faustgroße Dampfbrot, das hier anstelle von Toast serviert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
