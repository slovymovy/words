                "senses": [
                    {
                        "sense_id": "c24024b2-ad15-3cd2-a7d9-aacc6c2803b0",
                        "entry_id": "4278d6fe-6670-3f51-89bf-1962266f991e",
                        "glosses": [
                            "Theaterstück, das sich durch besondere neuartige darstellerische Mittele auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbac8f91-4843-46b6-b16f-acaa1a82550d",
                                "sense_id": "c24024b2-ad15-3cd2-a7d9-aacc6c2803b0",
                                "text": "„Bondy und Herrmann haben schon ein anderes bös-graziöses Experimentiertheater mit der menschlichen Seele, nämlich Mozarts ‚Cosi fan tutte‘, verwirklicht, indem sie ihm die Zeit (ihren wortwörtlich sichtbar gemachten ‚Ablauf‘) hinzuerfanden.“"
                            },
                            {
                                "example_id": "a9a83296-a5f2-49c2-88d0-14215dddeecb",
                                "sense_id": "c24024b2-ad15-3cd2-a7d9-aacc6c2803b0",
                                "text": "„Das Stück, vom Autor selbst im Bremer Experimentiertheater ‚Concordia‘ einstudiert und am letzten Freitag uraufgeführt, handelt von einer Bürgersfrau, die nach und nach mit Gift zwei Ehemänner, Vater und Mutter, ihre Kinder, den Bruder sowie einige Freunde und Bekannte zu Tode bringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
