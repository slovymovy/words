                                    },
                                    {
                                        "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A police record."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113d10b7-5912-4c17-9cd4-6846048d06d1",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "We got a crowd of black, white customers, out-of-state license plates, what have you. Somebody gonna check that out. They gonna drop a dime on me, call 911. And you know with my jacket I can't go back to jail."
                                            },
                                            {
                                                "example_id": "40e25565-ae8c-4ceb-bc2b-aacf57f04b48",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "Yo's jacket shows possession with intent, possession of unlicensed firearm, and assault, for which he still owes three years."
                                            },
                                            {
                                                "example_id": "3116c5f3-95e3-4454-9eb0-1b6c0e4d10bf",
                                                "sense_id": "a8d5cba5-fea4-31b1-a447-ee1237881259",
                                                "text": "\"I need to look up somebody's jacket.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7190f67-57f3-3800-a8ae-ed758be7fae7",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "In ordnance, a strengthening band surrounding and reinforcing the tube in which the charge is fired."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d09c59d-97c0-3f8e-8f34-32ae300f631b",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "The tough outer skin of a baked potato."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a124df7-c6bb-4db7-a290-c02b47efbf4f",
                                                "sense_id": "1d09c59d-97c0-3f8e-8f34-32ae300f631b",
                                                "text": "Cook the potatoes in their jackets."
                                            }
                                        ]
                                    },
