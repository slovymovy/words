                "senses": [
                    {
                        "sense_id": "0f99f561-83ec-38df-80db-1aa4a5c54d05",
                        "entry_id": "bc222581-4c16-35f2-aa9a-144799f2baa2",
                        "glosses": [
                            "Anzeichen für eine Krankheit, das auftritt, bevor das Krankheitsbild vollständig ausgeprägt ist, das aber für die Krankheit meistens nicht charakteristisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b991513d-d607-45f5-a40e-90afdbd7d108",
                                "sense_id": "0f99f561-83ec-38df-80db-1aa4a5c54d05",
                                "text": "„Erste Signale einer Schizophrenie zeigen sich häufig schon viele Jahre vor der ersten psychotischen Episode. Da diese Prodrome aber oft sehr unspezifisch sind, werden sie meist nicht erkannt oder anderweitig zugeordnet.“"
                            },
                            {
                                "example_id": "4b738fd3-eca1-49b8-b17a-2248039ee245",
                                "sense_id": "0f99f561-83ec-38df-80db-1aa4a5c54d05",
                                "text": "Erhöhte Körpertemperatur als Vorläufer einer Erkältungskrankheit ist ein Beispiel für ein Prodrom im Bereich der Infektionskrankheiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "550b3c69-848e-4efd-b575-eff13a2410e5",
                        "source_entry_id": "bc222581-4c16-35f2-aa9a-144799f2baa2",
                        "source_sense_id": "0f99f561-83ec-38df-80db-1aa4a5c54d05",
                        "source_sense_description": "Medizin: auftretende Symptome vor Ausprägung des eigentlichen Krankheitsbildes",
                        "target_lang_word": "prodrome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76970990-b62a-37fc-b3f1-bb28db9bde39",
                                        "entry_id": "ec891597-a6fc-327c-b981-136371be16a4",
                                        "glosses": [
                                            "A precursor or harbinger; also a warning event."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dc19e66-3330-4cbb-b936-85d5f87ee624",
                                                "sense_id": "76970990-b62a-37fc-b3f1-bb28db9bde39",
                                                "text": "These may prove the Prodromes […] to the ruin of our Monarchy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73b4b30-a797-3123-afe4-bea0372b8b15",
                                        "entry_id": "ec891597-a6fc-327c-b981-136371be16a4",
                                        "glosses": [
                                            "An introductory or preliminary book or treatise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad897a5-c7bc-4c0e-9bff-ec7739877733",
                                                "sense_id": "c73b4b30-a797-3123-afe4-bea0372b8b15",
                                                "text": "(archaic)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3edb7a6e-5912-3871-84cb-48dddd3ae598",
                                        "entry_id": "ec891597-a6fc-327c-b981-136371be16a4",
                                        "glosses": [
                                            "An early sign or symptom (or set of signs and symptoms) warning of the onset of a disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f96752-b289-4d6f-9a4e-17b34b2064cb",
                                                "sense_id": "3edb7a6e-5912-3871-84cb-48dddd3ae598",
                                                "text": "It is becoming increasingly recognised that bipolar, like schizophrenia, has a prodromal phase which can be identified prior to development of the full illness. However, one issue with research into this area is the potential conflation of the concepts of a prodrome for bipolar, referring to symptoms that can be retrospectively identified as preceding the onset of the disorder, and a ‘risk syndrome’ consisting of clinical features, comorbidities and risk factors which increase the risk of later developing bipolar. At present, neither prodrome nor risk syndrome has been fully defined, although the bipolar at-risk (BAR) assessment tool has demonstrated predictive validity and reliability for identifying those at risk of bipolar, with around 23% of those identified transitioning to mania or hypomania."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prodrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed02dda-67c2-39f0-89b5-b650bbabeb1c",
                                        "entry_id": "d7ed835f-66f2-3ace-8a3a-08d172792fa4",
                                        "glosses": [
