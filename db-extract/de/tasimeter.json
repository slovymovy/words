                "senses": [
                    {
                        "sense_id": "d029594d-84bb-395d-9912-cc2a388732cf",
                        "entry_id": "2a57300b-47f3-3ce1-9d1c-ac89fba968b8",
                        "glosses": [
                            "Gerät, das kleine Druckänderungen registrieren kann"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2523fa-5c26-497f-9154-801da0b20111",
                                "sense_id": "d029594d-84bb-395d-9912-cc2a388732cf",
                                "text": "„Mit erst 31 Jahren war er bereits ein berühmter und streitbarer Erfinder, suchte Respekt auch als Wissenschaftler und hatte der Presse sein eigens entwickeltes Tasimeter präsentiert, das die Wärme von Sternen und ebenso der Korona messen sollte.“"
                            },
                            {
                                "example_id": "841ffff0-cb03-44a8-92ef-5a2d040bc7d1",
                                "sense_id": "d029594d-84bb-395d-9912-cc2a388732cf",
                                "text": "„Für feinere Untersuchungen über strahlende Wärme empfiehlt sich die Verbindung des Tasimeters mit der WHEASTONE’schen Brücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aef00cfb-2820-4204-a0d2-1c62dd4a2f3f",
                        "source_entry_id": "2a57300b-47f3-3ce1-9d1c-ac89fba968b8",
                        "source_sense_id": "d029594d-84bb-395d-9912-cc2a388732cf",
                        "source_sense_description": "historisch: Gerät, das kleine Druckänderungen registrieren kann",
                        "target_lang_word": "tasimeter",
