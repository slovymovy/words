                                "target_senses": [
                                    {
                                        "sense_id": "730f153f-6e06-3826-9a1f-49d9f7932156",
                                        "entry_id": "4d68d3b6-2f98-3f24-8658-267933115af0",
                                        "glosses": [
                                            "анат. внутренняя сторона кисти руки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4f6ea9-61fa-4526-be29-d358bf64478b",
                                                "sense_id": "730f153f-6e06-3826-9a1f-49d9f7932156",
                                                "text": "Самгин сидел наклонясь, опираясь ладонями в колени."
                                            },
                                            {
                                                "example_id": "2c0181b6-ddcc-4362-a748-efdf7cc17208",
                                                "sense_id": "730f153f-6e06-3826-9a1f-49d9f7932156",
                                                "text": "Снова выполните те же движения, но повернув кисть руки ладонью назад или вверх."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91042d1b-74a7-3a05-8878-feed4de8f04f",
                                        "entry_id": "4d68d3b6-2f98-3f24-8658-267933115af0",
                                        "glosses": [
                                            "устар. мера длины, равная четырём дюймам или примерно 10,16 см"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebc8116-bcd9-4be3-8bc1-8b760229ada8",
                                                "sense_id": "91042d1b-74a7-3a05-8878-feed4de8f04f",
                                                "text": "Вот два старичка, борода, словно белая пелена, до колен расстилается, несут на подносе куфу великую с мёдом да чудную чашу: белее рыбьего зуба, вышиной в три ладони, обделана в жемчуг да в яхонт румяный."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
