                        "examples": [
                            {
                                "example_id": "675bd13e-c611-4341-aadf-2e44f092edc3",
                                "sense_id": "b72cbab1-46b1-3191-968b-3fb58ee0c12f",
                                "text": "Intussen blijft het Libanese kabinet verder leegstromen. Maandag stapte opnieuw een minister op, ditmaal die van justitie. Marie Claude Najm werd vorige week uitgescholden en met water besproeid toen ze een door de explosie getroffen gebied in Beiroet bezocht. Zondag stapten al de ministers van informatie en die van milieu op."
                            }
                        ]
