                                "target_senses": [
                                    {
                                        "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                                        "glosses": [
                                            "In the International System of Units, the base unit of thermodynamic temperature; ¹⁄_(273.16) of the thermodynamic temperature of the triple point of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1dccf8-2e06-4a34-953d-333227c03f00",
                                                "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                                                "text": "Ice melts above 273.15 kelvins."
                                            },
                                            {
                                                "example_id": "020701ad-ddde-4d35-9271-0368bd73c892",
                                                "sense_id": "a929af10-ddb4-3bc9-9404-70d4c1410fee",
                                                "text": "Water boils above 373.15 kelvins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                                        "glosses": [
                                            "One degree of difference on this scale, as a unit interval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c09a64b-1b81-4626-ac9a-099af2f6adb4",
                                                "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                                                "text": "The dew point here today is only 1 kelvin above what it was yesterday."
                                            },
                                            {
                                                "example_id": "08957f59-5fb7-4edd-a693-9cd4079f7979",
                                                "sense_id": "67adf99c-6c7d-3e06-99c9-8d7615ba927c",
                                                "text": "The interval between the freezing and boiling points of water is 100 kelvins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab04200c-d8c1-3072-b05e-68ab564d4dc9",
                                        "entry_id": "602af790-3b58-30fa-a068-9f32dd0f793c",
                                        "glosses": [
                                            "A measurement of color warmth defined by the temperature kelvin at which an incandescent blackbody would emit a given color."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
