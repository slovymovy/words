                "senses": [
                    {
                        "sense_id": "35e0f0fd-8042-3ac4-99fe-4c3c9a9764f3",
                        "entry_id": "1ad98f4e-79e6-3fef-a06f-7efcbcf739a1",
                        "glosses": [
                            "Degré de similarité entre deux gènes existants chez deux espèces différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45187461-e7c6-48ad-aa77-804c1df98d41",
                                "sense_id": "35e0f0fd-8042-3ac4-99fe-4c3c9a9764f3",
                                "text": "L’orthologie entre deux gènes n'empêche pas que ces gènes aient pu dériver pour produire des fonctions différentes chez les deux espèces qui les abritent."
                            },
                            {
                                "example_id": "749c3617-43b3-4906-881d-d255590bf736",
                                "sense_id": "35e0f0fd-8042-3ac4-99fe-4c3c9a9764f3",
                                "text": "Dans les protéines à plusieurs domaines, deux niveaux d’orthologie peuvent être distingués d’une part au niveau de chaque domaine séparément, d’autre part au niveau de la protéine complète."
                            }
                        ]
                    }
                ],
