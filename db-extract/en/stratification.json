                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "481b79f3-e233-300e-b04d-a2183df45b66",
                                        "entry_id": "5dfc6e65-4cc3-36db-86e9-ce151534a9aa",
                                        "glosses": [
                                            "Positionierung von Personen",
                                            "bei medizinischen Behandlungen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "4c8e5910-f57a-3993-8684-1bbc2d62137f",
                                        "entry_id": "5dfc6e65-4cc3-36db-86e9-ce151534a9aa",
                                        "glosses": [
                                            "Positionierung von Personen",
