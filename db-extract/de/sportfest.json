                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14226ac-7b6f-4c81-8ac7-f82cf3bff72c",
                                "sense_id": "8d666fec-2314-35ed-a808-2a3f6d76daf7",
                                "text": "„Das Zürcher Hallenstadion wird mit einem großen Sportfest eingeweiht.“"
                            },
                            {
                                "example_id": "a563646c-5a8a-4af2-837b-42256224d00d",
                                "sense_id": "8d666fec-2314-35ed-a808-2a3f6d76daf7",
                                "text": "„Bei einem Sportfest in Oslo verbessert der Kenianer Henry Rono den 5000-m-Weltrekord auf 13:08,4 min.“"
                            },
                            {
                                "example_id": "93e86a6c-6cbd-42b4-a8ac-4bb5cae2c1f1",
                                "sense_id": "8d666fec-2314-35ed-a808-2a3f6d76daf7",
                                "text": "„Wer untrainiert nach Olympia kam, konnte disqualifiziert werden, denn schließlich wollte das größte Sportfest der Antike auch die beste Show bieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
