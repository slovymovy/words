                        "entry_id": "79d9de71-ecd0-3099-89b3-00804747ce62",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "взбу́чках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a18c5753-449c-3b07-a649-67c66164c13b",
                        "entry_id": "79d9de71-ecd0-3099-89b3-00804747ce62",
                        "glosses": [
                            "действие по значению гл. взбучить; грубый разговор, нагоняй"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f8d8ec-8b8e-43cf-bd9e-4a3445cf884e",
                                "sense_id": "a18c5753-449c-3b07-a649-67c66164c13b",
                                "text": "Задать взбучку."
                            },
                            {
                                "example_id": "fda52f4a-48df-4f70-a4a5-87e55aab4cda",
                                "sense_id": "a18c5753-449c-3b07-a649-67c66164c13b",
                                "text": "[Аксёнов] духом не падал, голову держал высоко и, пощипывая бородку, поглядывал вокруг себя с таким видом, будто ему предстояло премию получать, а не взбучку за нарушения дисциплины."
                            },
                            {
                                "example_id": "35cf5b7d-e0db-4395-8466-92b409b87b64",
                                "sense_id": "a18c5753-449c-3b07-a649-67c66164c13b",
                                "text": "Молотов чертыхнулся, но приехал на встречу с послом, а Козырев получил хорошую взбучку."
                            }
                        ]
                    },
                    {
                        "sense_id": "a48d0466-40ba-3439-9f26-c49f3f4de4af",
                        "entry_id": "79d9de71-ecd0-3099-89b3-00804747ce62",
                        "glosses": [
                            "действие по значению гл. взбучить; побои (в наказание за что-либо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5d7adc-003d-4d01-b5b0-dd3e699c0d8c",
                                "sense_id": "a48d0466-40ba-3439-9f26-c49f3f4de4af",
                                "text": "Взбучка, так взбучка! Я готов, как провинившийся школьник, подставить спину под розги. Всё снесу, но буду ему предан до последнего вздоха!"
                            }
                        ]
                    }
                ],
                "translations": [],
