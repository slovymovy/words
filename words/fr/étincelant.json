                    "frequency": "Low",
                    "semantic_group_id": "eclat_intellectuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur a captivé le public grâce à un esprit <w>étincelant</w> et plein d'humour."
                        },
                        {
                            "text": "Sa conversation était toujours <w>étincelante</w> et riche en réparties inattendues."
                        }
                    ],
                    "synonyms": [
