                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c40f54-1f92-4b4c-a152-ec97ef6de897",
                                                "sense_id": "aadb6271-7246-3099-a41f-8edc88a41cec",
                                                "text": "Města jemenská měla své kolonie na pobřeží suahelském."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db05d520-f4c5-4542-a2a3-d9fa33405d1e",
                        "source_entry_id": "35613c49-48d3-3f8d-87d8-944cc03f3918",
                        "source_sense_id": "0bb9e36f-d5f0-3f46-ba04-45e98ffa60e2",
                        "target_lang_word": "yéménite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yéménite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                        "entry_id": "d7ccd721-617b-3a5e-83aa-d82c4ab6b4ce",
                                        "glosses": [
                                            "Qui concerne le Yémen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a2bd68-fda8-4908-9095-a37051b978a9",
                                                "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                                "text": "Les mesures esthétiques utilisées par les femmes touarègues renvoient toutes à des origines arabes yéménites."
                                            },
                                            {
                                                "example_id": "f1637c24-6640-4c03-941c-856307d4bf42",
                                                "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                                "text": "Contrairement à leurs prédécesseurs, ils se laissent « yéméniser ». Malgré leur origine turkmène, ils se forgent une généalogie yéménite, en rattachant leur branche à la glorieuse souche des ghassanides."
                                            },
                                            {
                                                "example_id": "7effcc21-4a17-4c5e-8105-7479c16848c8",
                                                "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                                "text": "À Jaffa, ce village de pêcheurs à côté de Tel-Aviv, je visitais le souk. Je me fis arnaquer en achetant des bijoux prétendument yéménites, mais je vis surtout des djellabas blanches, comme celles qu’il portait."
                                            },
                                            {
                                                "example_id": "8ddff744-a856-4a87-b7b5-fa4f31deef1b",
                                                "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                                "text": "Lettrés et savants les entourent, des discussions s’animent sur les sujets les plus variés, des mérites comparés des épées indiennes ou yéménites aux diverses lectures d’Aristote."
                                            },
                                            {
                                                "example_id": "d9e5b9ed-1879-4f87-abd9-4b27fafa33ee",
                                                "sense_id": "75736ba1-83ab-32d8-b5d4-b80b4e52dd40",
                                                "text": "L’augmentation des commerces tenus par les Yéménites va de pair avec la disparition des commerçants somalis et afars, ainsi qu’une « yéménisation » des modes de vie. La langue arabe progresse de plus en plus et les restaurants yéménites fleurissent en dehors des quartiers centraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
