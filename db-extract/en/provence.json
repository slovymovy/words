                                "target_senses": [
                                    {
                                        "sense_id": "4037702b-1f21-3cc7-beb5-1b5b13bd448a",
                                        "entry_id": "cc674e9d-a5ef-354e-bf1c-f6f512155add",
                                        "glosses": [
                                            "die Landschaft im äußersten Südosten von Frankreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c82222a-efa7-4261-bc46-6cfdc2c4d233",
                                                "sense_id": "4037702b-1f21-3cc7-beb5-1b5b13bd448a",
                                                "text": "Kräuter der Provence sind als Gewürzmischung handelsüblich und typisch für die provenzalische Küche."
                                            },
                                            {
                                                "example_id": "6a5a6433-ae07-46f8-92c8-c8100d620d1e",
                                                "sense_id": "4037702b-1f21-3cc7-beb5-1b5b13bd448a",
                                                "text": "„Die Bergwanderer in der Provence feuern jeden Radfahrer, der an ihnen vorbeikriecht, mit allez! allez! an.“"
                                            },
                                            {
                                                "example_id": "abaa8d4d-fdf2-41c4-924b-c4d96e1f2ed7",
                                                "sense_id": "4037702b-1f21-3cc7-beb5-1b5b13bd448a",
                                                "text": "„In der Provence ist der Winter nur dann rauh, wenn es windig ist, und leider bläst der Nordwind sehr häufig.“"
                                            },
                                            {
                                                "example_id": "c3c8c824-4421-4d05-8b50-09b18ff0cc6b",
                                                "sense_id": "4037702b-1f21-3cc7-beb5-1b5b13bd448a",
                                                "text": "„Er hielt sich in der Provence verborgen, zuletzt vergaß er die Vorsicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
