                "senses": [
                    {
                        "sense_id": "f8111aee-365b-3615-be5e-036d3e4b6f26",
                        "entry_id": "bb6d48bb-81be-3273-9dd0-c898824211b8",
                        "glosses": [
                            "eine Gruppe von bezahlten Applaudierern (Claqueuren), zum Beispiel bei einer Theateraufführung oder dem Auftritt eines Politikers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6709eb9f-18d4-461f-bc0b-0571093469d7",
                                "sense_id": "f8111aee-365b-3615-be5e-036d3e4b6f26",
                                "text": "„Er will die Claque des Fernsehens, fabriziertes Lachen und fabrizierten Applaus, ausmerzen und auch jede Probe vor einem Interview.“"
                            },
                            {
                                "example_id": "13b423c5-a17b-4af5-b88b-f0af370a6e5f",
                                "sense_id": "f8111aee-365b-3615-be5e-036d3e4b6f26",
                                "text": "„Zwar hören wir über die Aktivität von Claquen erst seit Clodius. Doch wahrscheinlich tauchte dieses Phänomen schon vorher auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
