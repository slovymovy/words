                "senses": [
                    {
                        "sense_id": "ff16869a-bbc6-3cfc-a2f7-8a21ef5d02cd",
                        "entry_id": "32a8f6da-aada-315d-bbdf-363026bea108",
                        "glosses": [
                            "keine Wellen aufweisend/schlagend; ohne Wellen"
                        ],
                        "tags": [
                            "von Gewässern"
                        ],
                        "examples": [
                            {
                                "example_id": "cf91e7e6-86d4-4083-9d83-e1a32fed8cc8",
                                "sense_id": "ff16869a-bbc6-3cfc-a2f7-8a21ef5d02cd",
                                "text": "„Das Meer ist schwarz und schauerlich, es scheint in sich wie Öl zu kleben und ist wellenlos.“"
                            },
                            {
                                "example_id": "8366e2d3-caef-4a21-ac48-0e7871084c3c",
                                "sense_id": "ff16869a-bbc6-3cfc-a2f7-8a21ef5d02cd",
                                "text": "„Das Meer und die Küste gehören zusammen auf Gedeih und Verderb. Ist der Ozean ein lauwarmes, wellenloses Süppchen, sehen auch die Strände schlapp aus; ist er rau und wild, wird die Küste es auf Dauer auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
