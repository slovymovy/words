    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8884103-4582-3ae3-9f07-c75e4f262e54",
                    "sense_definition": "Saluer quelqu'un en prenant sa main dans la sienne, dans l'expression « serrer la main » ; au pronominal, se saluer ainsi l'un l'autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "serrer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai refusé de lui <w>serrer</w> la main après la dispute."
                        },
                        {
                            "text": "Quand ils se rencontrent, les deux collègues se <w>serrent</w> la main."
                        },
                        {
                            "text": "Le directeur est venu me <w>serrer</w> la main à la fin de la réunion."
                        }
                    ],
                    "common_phrases": [
                        "serrer la main",
                        "se serrer la main",
                        "serrer la main à quelqu'un"
                    ]
                },
                {
                    "sense_id": "01a89a2e-cac3-3209-9a77-9af5654a1ebf",
                    "sense_definition": "Presser fortement quelqu'un ou quelque chose avec la main ou les bras ; étreindre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "serrer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>serré</w> son fils dans ses bras avant de partir."
                        },
                        {
                            "text": "Il m'a <w>serré</w> le bras si fort que j'ai eu mal."
                        },
                        {
                            "text": "Le petit garçon <w>serre</w> son ours en peluche contre lui pour dormir."
                        }
                    ],
                    "antonyms": [
                        "lâcher"
                    ],
                    "common_phrases": [
                        "serrer dans ses bras",
                        "serrer très fort",
                        "serrer le poing"
                    ]
                },
                {
                    "sense_id": "f3e63376-86a0-35df-99b3-d05c46760bde",
                    "sense_definition": "Fixer ou tendre davantage quelque chose en le tournant ou en le tirant, comme une vis, un nœud ou une ceinture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "serrer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>serrer</w> cette vis pour que l'étagère tienne."
                        },
                        {
                            "text": "Ton nœud de cravate n'est pas assez <w>serré</w>."
                        },
                        {
                            "text": "Le mécanicien a <w>serré</w> les boulons de la roue."
                        }
                    ],
                    "antonyms": [
                        "desserrer",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "serrer une vis",
                        "serrer un nœud",
                        "serrer sa ceinture"
                    ]
                },
                {
                    "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                    "sense_definition": "Être trop étroit et gêner le corps, en parlant d'un vêtement ou d'une chaussure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serrer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces chaussures me <w>serrent</w> un peu, je vais prendre une taille au-dessus."
                        },
                        {
                            "text": "Ce pantalon <w>serre</w> trop à la taille depuis que j'ai grossi."
                        }
                    ],
                    "common_phrases": [
                        "des chaussures qui serrent",
                        "serrer à la taille"
                    ]
                },
                {
                    "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                    "sense_definition": "Rapprocher étroitement des personnes ou des choses ; au pronominal, se mettre très près les uns des autres pour gagner de la place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rapprocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous sommes obligés de nous <w>serrer</w> pour que tout le monde tienne sur le banc."
                        },
                        {
                            "text": "Il a <w>serré</w> les dents pour ne pas crier de douleur."
                        },
                        {
                            "text": "<w>Serrez</w>-vous un peu, il reste encore une place à côté de toi."
                        }
                    ],
                    "antonyms": [
                        "écarter"
                    ],
                    "common_phrases": [
                        "se serrer les uns contre les autres",
                        "serrer les dents",
                        "serrer de près"
                    ]
                },
                {
                    "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                    "sense_definition": "Mettre quelque chose à sa place, le ranger ou le mettre en lieu sûr, à l'abri.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma grand-mère <w>serrait</w> toujours le linge propre dans la grande armoire."
                        },
                        {
                            "text": "Peux-tu <w>serrer</w> ces papiers dans le tiroir du bureau, s'il te plaît ?"
                        }
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "serrer ses affaires",
                        "serrer dans un tiroir"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi vieilli en France pour « ranger »."
                        }
                    ]
                },
                {
                    "sense_id": "26bba3b9-3a0d-31f7-b46f-117927a49378",
                    "sense_definition": "Causer une forte émotion ou une sensation d'oppression, surtout au cœur ou à la gorge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voir mon vieux chien malade me <w>serre</w> le cœur."
                        },
                        {
                            "text": "L'angoisse lui <w>serrait</w> la gorge avant l'examen."
                        }
                    ],
                    "common_phrases": [
                        "serrer le cœur",
                        "serrer la gorge"
                    ]
                },
                {
                    "sense_id": "2593ba78-478e-358a-922f-14dcb3e9313e",
                    "sense_definition": "Perdre son sang-froid, ne plus se maîtriser et faire n'importe quoi, comme un moteur qui serre quand il n'a plus d'huile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il en avait tellement marre de ses voisins qu'il a fini par <w>serrer</w>."
                        },
                        {
                            "text": "Arrête de crier comme ça, sinon je vais <w>serrer</w> !"
                        }
                    ],
                    "synonyms": [
                        "craquer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Emploi argotique, langage de jeunes."
                        }
                    ]
                },
                {
                    "sense_id": "182ace9f-d6e8-32cb-bcc8-2a6c0e234f27",
                    "sense_definition": "Séduire quelqu'un, réussir à sortir avec lui ou à flirter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté à la fête pour <w>serrer</w> une fille."
                        },
                        {
                            "text": "Il espère <w>serrer</w> quelqu'un à la soirée de samedi."
                        }
                    ],
                    "synonyms": [
                        "séduire",
                        "emballer",
                        "pécho"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Emploi argotique, langage de jeunes."
                        }
                    ]
                },
                {
                    "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                    "sense_definition": "Attraper quelqu'un, l'interpeller et l'arrêter, en parlant de la police.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a fini par <w>serrer</w> le voleur près de la gare."
                        },
                        {
                            "text": "Il s'est fait <w>serrer</w> par les flics en sortant de la banque."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "arrêter"
                    ],
                    "antonyms": [
                        "libérer"
                    ],
                    "common_phrases": [
                        "se faire serrer",
                        "serrer un voleur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi familier."
                        }
                    ]
                },
                {
                    "sense_id": "b7717ffb-c001-3fb8-b6a2-0f1ac668b5eb",
                    "sense_definition": "Économiser, épargner, se restreindre dans ses dépenses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce mois-ci, je dois <w>serrer</w> si je veux payer mon loyer."
                        },
                        {
                            "text": "Depuis qu'il a perdu son travail, la famille doit <w>serrer</w> sur tout."
                        }
                    ],
                    "antonyms": [
                        "dépenser"
                    ]
                },
                {
                    "sense_id": "24cbc91a-4038-303f-bc47-266098e3bc83",
                    "sense_definition": "Longer de très près, rester tout contre une côte, un mur ou un bord.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rapprocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bateau <w>serre</w> la côte pour éviter les courants du large."
                        },
                        {
                            "text": "La nuit, il <w>serrait</w> les murs pour ne pas être vu."
                        }
                    ],
                    "antonyms": [
                        "s'éloigner"
                    ],
                    "common_phrases": [
                        "serrer la côte",
                        "serrer le mur",
                        "serrer la muraille"
                    ]
                },
                {
                    "sense_id": "19eb2b9c-7635-3511-bf92-d190f8e85a98",
                    "sense_definition": "Marine : replier une voile et l'attacher le long de sa vergue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche de la tempête, le capitaine ordonna de <w>serrer</w> les voiles."
                        },
                        {
                            "text": "Les marins ont <w>serré</w> le grand hunier avant la nuit."
                        }
                    ],
                    "antonyms": [
                        "déployer"
                    ],
                    "common_phrases": [
                        "serrer les voiles",
                        "serrer la voile"
                    ]
                },
                {
                    "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                    "sense_definition": "Marine : rapprocher son navire de la terre ou du navire qui précède, pour garder la ligne de bataille.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque navire devait <w>serrer</w> sur celui qui le précédait pour garder la ligne."
                        },
                        {
                            "text": "Le pilote a décidé de <w>serrer</w> la terre pour éviter le courant du large."
                        }
                    ],
                    "common_phrases": [
                        "serrer la ligne",
                        "serrer la terre"
                    ]
                },
                {
                    "sense_id": "acbac867-7468-31f4-8389-2af6739fb40b",
                    "sense_definition": "Cinéma : diminuer l'angle de champ d'une prise de vue ou d'un plan, pour cadrer de plus près.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le réalisateur demande à l'opérateur de <w>serrer</w> le plan sur le visage de l'actrice."
                        },
                        {
                            "text": "La caméra <w>serre</w> la scène au plus près."
                        }
                    ],
                    "antonyms": [
                        "élargir"
                    ],
                    "common_phrases": [
                        "serrer le plan",
                        "serrer le cadre"
                    ]
                }
            ]
        }
    ]
}