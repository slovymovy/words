                },
                {
                    "sense_id": "0a9786ee-e597-3c01-a807-7d4245a7e9bb",
                    "sense_definition": "A large closed horse-drawn carriage used in the past to carry passengers and mail along a regular route.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stage</w> arrived in town late due to the muddy roads.",
                            "target_lang_translations": {
                                "ru": "<w>Дилижанс</w> прибыл в город с опозданием из-за грязных дорог.",
                                "tr": "<w>Posta arabası</w> çamurlu yollar yüzünden kasabaya geç ulaştı.",
                                "zh": "由于道路泥泞，<w>驿站马车</w>迟到了镇上。"
                            }
                        },
                        {
                            "text": "Travelers in the 19th century often relied on the <w>stage</w> to get between cities.",
                            "target_lang_translations": {
                                "ru": "Путешественники в XIX веке часто полагались на <w>дилижанс</w>, чтобы добраться из одного города в другой.",
                                "tr": "19. yüzyıldaki gezginler şehirler arasında seyahat etmek için sıklıkla <w>posta arabasına</w> güvenirlerdi.",
                                "zh": "19世纪的旅行者经常依靠<w>驿站马车</w>在城市之间往返。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "short for stagecoach"
                        }
                    ],
                    "target_lang_definitions": {
