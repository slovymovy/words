                                        "entry_id": "a4731540-318f-34d9-a845-7da68f449efc",
                                        "glosses": [
                                            "The act or practice of abstaining, refraining from indulging a desire or appetite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29455247-1667-44f1-963e-903e95dc37a3",
                                                "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                                                "text": "Penance, Faſts, and Abſtinence, / To puniſh Bodies for the Souls offence."
                                            },
                                            {
                                                "example_id": "140adb71-caa6-498c-9170-e6d51bda1072",
                                                "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                                                "text": "The abstinence from a present pleasure that offers itself is a pain, nay, oftentimes, a very great one."
                                            },
                                            {
                                                "example_id": "f6b7a255-1a00-4ad6-b87f-7a552bb2df07",
                                                "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                                                "text": "These five short films by San Francisco artist James Broughton, reveal to the viewer the artistic changes undergone by the artist during his 15-year abstinence from filmmaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e946573d-0ce7-3f91-a647-9fa45dc0d9c4",
                                        "entry_id": "a4731540-318f-34d9-a845-7da68f449efc",
                                        "glosses": [
                                            "The act or practice of abstaining, refraining from indulging a desire or appetite.",
                                            "Specifically, the practice of abstaining from intoxicating/alcoholic beverages; total abstinence; teetotalism)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1da1a79b-3229-3c77-99e1-6b7fc7bce94e",
                                        "entry_id": "a4731540-318f-34d9-a845-7da68f449efc",
                                        "glosses": [
                                            "The act or practice of abstaining, refraining from indulging a desire or appetite.",
                                            "Specifically, the practice of abstaining from sexual intercourse, either permanently or until marriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "625ed6a8-4004-410e-8b29-e70bc49fcef9",
                                                "sense_id": "1da1a79b-3229-3c77-99e1-6b7fc7bce94e",
                                                "text": "Abstinence is the only 100% guaranteed contraception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7754c212-73a8-3274-88d0-eaebbcc58250",
                                        "entry_id": "a4731540-318f-34d9-a845-7da68f449efc",
                                        "glosses": [
                                            "The act or practice of abstaining, refraining from indulging a desire or appetite.",
                                            "Abstention from certain foods on days of penitential observance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1099a9c7-bd17-43c0-a467-5846d737bc46",
                                                "sense_id": "7754c212-73a8-3274-88d0-eaebbcc58250",
                                                "text": "\"The church teaching before Vatican II was that it was 'gravely sinful' to take 2 ounces of meat on a day of abstinence such as Friday,\" said the Rev. Joseph S. Rossi, a Jesuit professor of church history at Loyola College."
                                            }
                                        ]
                                    },
