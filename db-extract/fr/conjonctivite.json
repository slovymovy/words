                                    {
                                        "sense_id": "956b6862-ad4b-360b-bf5d-8c83c39c6a82",
                                        "entry_id": "c86c4df0-96b0-3b2f-ab7a-199fe723ffed",
                                        "glosses": [
                                            "Bindehautentzündung"
                                        ],
                                        "tags": [
                                            "Krankheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7282413f-b30d-4f55-aed3-101176850015",
                                                "sense_id": "956b6862-ad4b-360b-bf5d-8c83c39c6a82",
                                                "text": "Konjunktivitis (oder Conjunktivitis, lateinisch Conjunctivitis) ist der medizinische Fachausdruck für eine akute oder chronische Entzündung der Bindehaut (Tunica conjunctiva) des Auges."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc535ac8-0d5d-4f5b-acc9-31a7d3df2545",
                        "source_entry_id": "6a0ddd8d-778f-3c5a-8b2e-719f570c4f36",
