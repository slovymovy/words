    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "189858dc-8718-376b-b086-67920e26ca65",
                "word": "horsewoman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d9a60fb-3c87-4503-8514-cfdd724078f7",
                        "entry_id": "189858dc-8718-376b-b086-67920e26ca65",
                        "tags": [
                            "plural"
                        ],
