                ],
                "senses": [
                    {
                        "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                        "entry_id": "6c1c75ff-1d85-3660-9412-bffea4a74da2",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb769f61-8683-4562-a388-bbf717742141",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Frau Seidowski ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "60ec8a36-3464-42b6-b99c-f14e6102b309",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Herr Seidowski wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "98b8b0d7-7e7f-44a2-ad44-98355e2fe5f1",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Die Seidowskis fahren heute in den Odenwald."
                            },
                            {
                                "example_id": "62c57cad-4a6a-4441-a3e0-51d199624e90",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Der Seidowski trägt nie die Schals, die die Seidowski ihm strickt."
                            },
                            {
                                "example_id": "1edaf999-ef2f-452c-a537-7997b8db3f11",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seidowski kommt, geht der Herr Seidowski.“"
                            },
                            {
                                "example_id": "fb8983e7-2a4d-4c8b-94df-0bf56ad2e8f9",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Seidowski kommt und geht."
                            },
                            {
                                "example_id": "807a0d3b-a20c-44a7-8d1f-7a8fff5d8818",
                                "sense_id": "84c321a9-e80b-3e73-832d-548d3a7936f9",
                                "text": "Seidowskis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
