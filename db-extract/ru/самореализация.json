                ],
                "translations": [
                    {
                        "translation_id": "f68e2d91-a5a0-4321-8243-ec32ab6b576b",
                        "source_entry_id": "97f8df66-da92-3484-8372-7438597b2a1f",
                        "source_sense_description": "психологическое",
                        "target_lang_word": "selfrealization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b75f54f-04b7-4990-a240-80e900cf31df",
                        "source_entry_id": "97f8df66-da92-3484-8372-7438597b2a1f",
                        "source_sense_description": "психологическое",
                        "target_lang_word": "Selbstverwirklichung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstverwirklichung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                        "entry_id": "c2f745a9-26a8-3116-826c-7c0f22810ba9",
                                        "glosses": [
                                            "Realisierung der Vorstellungen, die jemand von sich selbst und seinen Möglichkeiten hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a49e8285-862d-4e72-8840-82676c0e2fdd",
                                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                                "text": "„Die Selbstverwirklichung des sowjetischen Menschen, sein politisches Engagement und sein Befreiungskampf fanden ausschließlich jenseits der eigenen Heimat statt.“"
                                            },
                                            {
                                                "example_id": "403c7d08-1473-44e2-bf8b-f4bf999941ba",
                                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                                "text": "Die Idee der Selbstverwirklichung zählt zu den zentralen Werten der westlichen Moderne."
                                            },
                                            {
                                                "example_id": "9f65b409-5274-4731-b942-aa403f87a882",
                                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                                "text": "Selbstverwirklichung - ein Schlag- oder eigentlich schon Modewort, das von esoterisch angehauchten Hausfrauen bis zu dynamischen Jungunternehmern immer wieder gerne benutzt wird."
                                            },
                                            {
                                                "example_id": "fc1ac090-5d3c-4abe-8415-00ae94e2834e",
                                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                                "text": "Andere streben die Selbstverwirklichung im Beruf an, so dass sie es nicht nötig haben, außerberuflichen Aktivitäten als den eigentlich interessanten Tätigkeiten nachzugehen."
                                            },
                                            {
                                                "example_id": "0a26e0ab-c3b2-4e39-b325-c04179ba8a50",
                                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                                "text": "„Das Lebensgefühl der westlichen Welt oder, genauer gesagt, des nicht mehr ganz so Wilden Westens drückt sich in der Suche nach Freiheit und Selbstverwirklichung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
