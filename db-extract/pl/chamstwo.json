                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b457b43-1f25-3140-9541-f9ea49910dda",
                        "entry_id": "7e354d0a-bf06-388f-bc86-dd50fcaf6438",
                        "glosses": [
                            "zbiór cech należących do chama; brak kultury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9091a5-9ef2-4096-b0fb-7c6248452930",
                                "sense_id": "0b457b43-1f25-3140-9541-f9ea49910dda",
                                "text": "Nienawidzę chamstwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8fc8153c-ef52-37a6-b2dd-17281db55f1b",
                        "entry_id": "7e354d0a-bf06-388f-bc86-dd50fcaf6438",
                        "glosses": [
                            "chłopi, lud"
                        ],
                        "tags": [
                            "dated",
                            "scornfully"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "122a055b-617a-4a68-b781-cdc2b366a80f",
                        "source_entry_id": "7e354d0a-bf06-388f-bc86-dd50fcaf6438",
                        "source_sense_id": "0b457b43-1f25-3140-9541-f9ea49910dda",
                        "target_lang_word": "boorishness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boorishness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                        "entry_id": "69a609b3-127e-3283-8ac2-aabc8a44da66",
                                        "glosses": [
                                            "The state or characteristic of being a boor or of being boorish; boorish behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72ce42d-4d7a-4ddc-8f05-4fc1f4643490",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "No refinement in him would now have surprised her; but neither would any outbreak of boorishness."
                                            },
                                            {
                                                "example_id": "c2eacf1f-c563-4742-a1e7-79a6905881d5",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "From the first the Russian had exhibited every trait of his true character—selfishness, boorishness, arrogance, cowardice, and lust."
                                            },
                                            {
                                                "example_id": "aa1b5681-db03-42e1-bbcf-cf2c4845a261",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "Unfortunately, there were moments of pure indulgence, drunken boorishness and rambling unintelligible poetry midway through the evening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90dd548d-65cf-4ac4-8da2-62f3cdba3b92",
                        "source_entry_id": "7e354d0a-bf06-388f-bc86-dd50fcaf6438",
                        "source_sense_id": "0b457b43-1f25-3140-9541-f9ea49910dda",
                        "target_lang_word": "хамство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хамство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc68fc44-6713-39a4-af15-b5ff7a2432e4",
                                        "entry_id": "0dad7f67-75b9-3ae4-ae91-dca4775db8c4",
                                        "glosses": [
                                            "некультурность, невежество, свойственные хаму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac1a099-03e9-4889-841d-c2fdf9fa3085",
                                                "sense_id": "dc68fc44-6713-39a4-af15-b5ff7a2432e4",
                                                "text": "Сама наука не простоит минуты без красоты, ― знаете ли вы про это, смеющиеся, ― обратится в хамство, гвоздя не выдумаете!"
                                            },
                                            {
                                                "example_id": "981b2d07-2d97-41c0-8caa-320512392ccf",
                                                "sense_id": "dc68fc44-6713-39a4-af15-b5ff7a2432e4",
                                                "text": "Скажите, пожалуйста, что вам за охота так рано жениться? Это только мужики женятся рано, но там, известно, хамство, а вы-то с чего?"
                                            },
                                            {
                                                "example_id": "f1b2b4be-733d-45be-9750-cb48641006f3",
                                                "sense_id": "dc68fc44-6713-39a4-af15-b5ff7a2432e4",
                                                "text": "Хорошо сказал один русский: «Заразительная гнилость чужеземная снедает древнее здравие душ и тел российских; грубость нравов уменьшилась, но оставленное ею место лестью и хамством наполнилось; из старого ума выжили, нового не нажили — дураками умрём!»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f40ec8d7-dcbb-3d82-8b45-489a677aa55c",
                                        "entry_id": "0dad7f67-75b9-3ae4-ae91-dca4775db8c4",
                                        "glosses": [
                                            "разг. хамское поведение, хамский поступок, характеризующиеся грубостью, беззастенчивостью и наглостью наряду с осознанием собственной безнаказанности хама и беззащитности тех на кого оно направлено"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c316605a-ef54-4bdb-adc4-b71dfdbb3c08",
                                                "sense_id": "f40ec8d7-dcbb-3d82-8b45-489a677aa55c",
                                                "text": "Я помню, как потрясен он был хамством продавщицы, выбирая какую-то ювелирную мелочь в магазине."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хамство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b4d15456-48d4-3aa5-9dff-16327b8b8c84",
                                        "entry_id": "b2cd6e07-bdc7-366d-ae05-e6c6e499ea5c",
                                        "glosses": [
                                            "собир., истор., презр. хамы; люди, принадлежавшие к низшим классам и потому лишённые, по мнению дворян, человеческого достоинства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d8abb84-64a0-4a09-9506-21ed0f6ff434",
                                                "sense_id": "b4d15456-48d4-3aa5-9dff-16327b8b8c84",
                                                "text": "По хамству скоро гвалт пошёл."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
