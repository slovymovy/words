    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0ab679f-8143-319d-999c-9eff04f14a7a",
                    "sense_definition": "een klein doorboord bolletje van glas, hout of ander materiaal, vaak gebruikt voor sieraden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sieraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind is de hele middag bezig met <w>kraaltjes</w> rijgen.",
                            "target_lang_translations": {
                                "en": "The child has been busy threading <w>beads</w> all afternoon."
                            }
                        },
                        {
                            "text": "Zij draagt een prachtige ketting gemaakt van blauwe <w>kralen</w>.",
                            "target_lang_translations": {
                                "en": "She is wearing a beautiful necklace made of blue <w>beads</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kralen rijgen",
                        "glazen kralen"
                    ],
                    "target_lang_definitions": {
                        "en": "a small perforated ball of glass, wood, or other material, often used for jewelry"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bead",
                                "target_lang_sense_clarification": "a small decorative object with a hole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0e84574-a899-3db1-9b7e-ccf2996fd236",
                    "sense_definition": "een klein bolvormig object of druppeltje dat lijkt op een kraal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gesmolten metaal verzamelde zich in kleine <w>kraaltjes</w> op de bodem van de oven.",
                            "target_lang_translations": {
                                "en": "The molten metal gathered in small <w>beads</w> on the bottom of the furnace."
                            }
                        },
                        {
                            "text": "Na de regenbui hingen er glinsterende <w>kralen</w> van water aan de bladeren.",
                            "target_lang_translations": {
                                "en": "After the rain shower, glistening <w>beads</w> of water hung from the leaves."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kraaltjes van zweet"
                    ],
                    "target_lang_definitions": {
                        "en": "a small spherical object or droplet that resembles a bead"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bead",
                                "target_lang_sense_clarification": "a small drop of liquid or round object"
                            },
                            {
                                "target_lang_word": "droplet",
                                "target_lang_sense_clarification": "a very small drop of liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9348d3a1-061e-32f4-811b-3090db004978",
                    "sense_definition": "een omheinde ruimte voor vee of een nederzetting, vooral in zuidelijk Afrika",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omheining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herder dreef de runderen aan het eind van de dag terug naar de <w>kraal</w>.",
                            "target_lang_translations": {
                                "en": "The shepherd drove the cattle back to the <w>kraal</w> at the end of the day."
                            }
                        },
                        {
                            "text": "In het midden van de traditionele nederzetting bevond zich een grote <w>kraal</w> voor de bescherming van de dieren.",
                            "target_lang_translations": {
                                "en": "In the middle of the traditional settlement was a large <w>corral</w> for the protection of the animals."
                            }
                        }
                    ],
                    "synonyms": [
                        "omheining",
                        "veekraal"
                    ],
                    "common_phrases": [
                        "vee in de kraal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Zuid-Afrika"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an enclosed space for livestock or a settlement, especially in Southern Africa"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kraal",
                                "target_lang_sense_clarification": "an enclosure for livestock in Southern Africa"
                            },
                            {
                                "target_lang_word": "corral",
                                "target_lang_sense_clarification": "an enclosure for livestock"
                            },
                            {
                                "target_lang_word": "enclosure",
                                "target_lang_sense_clarification": "a fenced-in area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e3b7753-7dd1-342b-b406-10e4de29dc4b",
                    "sense_definition": "verouderde spelling voor <w>koraal</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze oude tekst wordt het rif nog aangeduid als een <w>kraal</w>.",
                            "target_lang_translations": {
                                "en": "In this old text, the reef is still referred to as a <w>coral</w>."
                            }
                        },
                        {
                            "text": "De visser zocht naar kostbaar rood <w>kraal</w> in de diepe wateren.",
                            "target_lang_translations": {
                                "en": "The fisherman searched for precious red <w>coral</w> in the deep waters."
                            }
                        }
                    ],
                    "synonyms": [
                        "koraal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde vorm van koraal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "archaic spelling for coral"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coral",
                                "target_lang_sense_clarification": "marine organism or its skeleton"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf60c624-5f40-3c83-a029-aa9db9402643",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>kralen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kraal</w> de rand van het metaal om het steviger te maken.",
                            "target_lang_translations": {
                                "en": "I <w>bead</w> the edge of the metal to make it sturdier."
                            }
                        },
                        {
                            "text": "Wanneer ik deze techniek toepas, <w>kraal</w> ik de plaat voorzichtig.",
                            "target_lang_translations": {
                                "en": "When I apply this technique, I carefully <w>bead</w> the plate."
                            }
                        }
                    ],
                    "traits": [
