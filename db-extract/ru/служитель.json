                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451aa6cd-87ad-44b8-8e12-bf5b3e9c14be",
                                                "sense_id": "8e8b91d9-9014-3bca-b5e6-d14be59c6eb7",
                                                "text": "Wife, Mother, Child, I know not. My affaires\nAre Seruanted to others[…]"
