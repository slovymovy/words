    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                "word": "nettler",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b62de93-12c4-495c-bdd4-255d83adf2ef",
                        "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "nettlers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3eb6f20-5b63-3eaf-a319-418b8ad460a4",
                        "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                        "glosses": [
                            "One who nettles; a vexatious or provoking individual or organization."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a1ecc3-6a76-424b-add4-b18c7ae6069f",
                                "sense_id": "b3eb6f20-5b63-3eaf-a319-418b8ad460a4",
                                "text": "But theſe are the Nettlers, theſe are the babbing Bookes that tell, though not halfe your fellows feats."
                            },
                            {
                                "example_id": "be03fe9e-d721-4823-a2ea-6b2858b9851c",
                                "sense_id": "b3eb6f20-5b63-3eaf-a319-418b8ad460a4",
                                "text": "The husband is a mildly stuffy blueblood who somewhat nettles his high-style-model wife, but she is a brisk, free-wheeling creature who is a bit of a nettler herself."
                            },
                            {
                                "example_id": "4282a5f4-fc49-4cf9-9a5d-65e9311c59d5",
                                "sense_id": "b3eb6f20-5b63-3eaf-a319-418b8ad460a4",
                                "text": "But for all the archivist energies and pack-rat instincts of its founder, the Church League of America never became much more than a filing system turned noisy, a nettler of liberals, a voice that suggested that the ecumenical forces could not alone own the day."
                            }
                        ]
                    },
                    {
                        "sense_id": "e99b911b-5824-323c-80bd-8eddb558cf6b",
                        "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                        "glosses": [
                            "An irritation or provocation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "944a3e62-3b73-45fd-87c1-66b8d08ef7bb",
                                "sense_id": "e99b911b-5824-323c-80bd-8eddb558cf6b",
                                "text": "That thrust you gave me, Tims, has prov'd a nettler— Your stab turns out, what I have been, — a Settler!"
                            },
                            {
                                "example_id": "76c4d34d-8173-49e2-9232-9b8eb042a0d0",
                                "sense_id": "e99b911b-5824-323c-80bd-8eddb558cf6b",
                                "text": "Let us remember that these spiked nettlers of life are part of our discipline. Life would get nauseating if it were all honey."
                            },
                            {
                                "example_id": "1d110873-4848-4ef9-8abe-b0b7a51b52ae",
                                "sense_id": "e99b911b-5824-323c-80bd-8eddb558cf6b",
                                "text": "It will hardly surprise you to learn that frustrations about boy friends and dating plans are common teen-age nettlers."
                            }
                        ]
                    },
                    {
                        "sense_id": "63f18160-721e-39c9-aec4-5e5cd496dd14",
                        "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                        "glosses": [
                            "On who applies nettles to another person (as a prank, punishment, or as part of a ritual)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78870746-c94a-4f7a-9653-3c20c5c0e0ed",
                                "sense_id": "63f18160-721e-39c9-aec4-5e5cd496dd14",
                                "text": "So far as we know, neither Walsingham nor Burghley ever recongnized their portraits as Cosmosophos and Piloplutos in Lodge's Catharos...A Nettle for Nice Noses. but it is safe to say that neither the Secretary nor the Lord Treasurer allowed their noses to be nettled with impunity if the nettler ever came within their proper reach."
                            },
                            {
                                "example_id": "e38f0a22-2860-4d33-a620-71d0f9904e28",
                                "sense_id": "63f18160-721e-39c9-aec4-5e5cd496dd14",
                                "text": "Nettled noses can be no delight to the nettled and ought to be no delight to the nettlers."
                            },
                            {
                                "example_id": "2f93d988-b614-4e00-8053-6beb68f9238a",
                                "sense_id": "63f18160-721e-39c9-aec4-5e5cd496dd14",
                                "text": "Yost, (personal communication) reports for the Waorani that nettling, among other things is used to pass power or certain abilities from one person ( the nettler ) to another. It is never, as Westerners often think, a cruel form of punishment."
                            }
                        ]
                    },
                    {
                        "sense_id": "3048c0b5-e351-3a4b-917f-7dd753a3573d",
                        "entry_id": "61960e3c-917d-39ef-bbe6-24c3369519e9",
                        "glosses": [
                            "A plant or animal that has poisonous stinging hairs, spikes or tendrils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cccf36f-ad28-4f4a-81bb-b14dc36285e8",
                                "sense_id": "3048c0b5-e351-3a4b-917f-7dd753a3573d",
                                "text": "The first description of the latter cnidae in that species was made by Uchida in 1929 (Uchida, 1929). Both animals are rather heavy nettlers for human divers and bathers."
                            },
                            {
                                "example_id": "59fbd8b1-2c37-4f49-b9ab-fc9541acfcc1",
                                "sense_id": "3048c0b5-e351-3a4b-917f-7dd753a3573d",
                                "text": "Nettlers are the mild-mannered poison peddlers of the world. Nettlers are passive stingers.They include stinging plants, some are appropriately called nettles, jellyfish and some caterpillars."
                            },
                            {
                                "example_id": "97b06f23-363a-44fa-aa7a-6456c599bced",
                                "sense_id": "3048c0b5-e351-3a4b-917f-7dd753a3573d",
                                "text": "Fortunately, there are only a few jellyfish in the North Sea which are painfully nettlers, but you should always be careful not to touch unknown cnidarians."
                            }
                        ]
                    }
                ],
