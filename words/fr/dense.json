    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "88912ae1-449f-380f-b865-d3998f03725d",
                    "sense_definition": "Dont les éléments constitutifs sont très serrés ou très rapprochés ; épais, compact.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un brouillard très <w>dense</w> empêchait les automobilistes de bien voir la route."
                        },
                        {
                            "text": "Nous avons marché pendant des heures à travers une forêt particulièrement <w>dense</w>."
                        }
                    ],
                    "synonyms": [
                        "compact",
                        "épais",
                        "serré"
                    ],
                    "antonyms": [
                        "clairsemé",
                        "léger"
                    ],
                    "common_phrases": [
                        "brouillard dense",
                        "forêt dense",
                        "circulation dense"
                    ]
                },
                {
                    "sense_id": "9e146aa7-6c82-3265-b17a-53dbbd51056f",
                    "sense_definition": "En physique, qui a une masse volumique élevée, qui pèse lourd par rapport à son volume.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plomb est un métal très <w>dense</w> souvent utilisé pour fabriquer des poids."
                        },
                        {
                            "text": "L'eau liquide est plus <w>dense</w> que la glace qui flotte à sa surface."
                        }
                    ],
                    "synonyms": [
                        "lourd",
                        "pesant"
                    ],
                    "antonyms": [
                        "léger"
                    ],
                    "common_phrases": [
                        "matière dense",
                        "métal dense"
                    ]
                },
                {
                    "sense_id": "bab50ac2-4705-32d7-b84f-844c1cd844f8",
                    "sense_definition": "En topologie, qualifie une partie d'un espace dont l'adhérence est égale à cet espace tout entier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ensemble des nombres rationnels est <w>dense</w> dans l'ensemble des réels."
                        },
                        {
                            "text": "Ce théorème s'applique à tout sous-espace vectoriel <w>dense</w> de cet espace normé."
                        }
                    ],
                    "common_phrases": [
                        "ensemble dense",
                        "sous-ensemble dense"
                    ]
                }
            ]
        }
    ]
