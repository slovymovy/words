                                "example_id": "53aedeed-74a4-4853-99f1-4ef7abd45cb7",
                                "sense_id": "73acbbf5-9489-3ca2-ab18-4c242bba91cb",
                                "text": "Tagsüber arbeitet Julie August als Layouterin in einem Berliner Verlag."
                            }
