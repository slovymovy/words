                },
                {
                    "sense_id": "f5b3696d-0e3d-3d68-93bc-aaf6b97edd20",
                    "sense_definition": "A small degree or extent; somewhat.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "degree_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>bit</w> tired after the long run.",
                            "target_lang_translations": {
                                "ru": "Он <w>немного</w> устал после длинной пробежки.",
                                "zh": "长跑后他有<w>点</w>累了。"
                            }
                        },
                        {
                            "text": "It is a <w>bit</w> cold outside, so wear a jacket.",
                            "target_lang_translations": {
                                "ru": "На улице <w>немного</w> холодно, так что надень куртку.",
                                "zh": "外面有<w>点</w>冷，所以穿件夹克吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slightly",
                        "somewhat",
                        "little",
                        "touch",
                        "tad",
                        "a little"
                    ],
                    "common_phrases": [
                        "a bit of a",
                        "not a bit",
                        "quite a bit"
                    ],
                    "target_lang_definitions": {
