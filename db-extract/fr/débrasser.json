                "senses": [
                    {
                        "sense_id": "8cf29876-be21-3650-9181-f61782d7a872",
                        "entry_id": "b9401172-20eb-3dd1-9176-e07d565cec3a",
                        "glosses": [
                            "Ramener le tangon plus vers l’avant du bateau."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "7e20be85-6c99-4efe-ab49-728387d8a973",
                                "sense_id": "8cf29876-be21-3650-9181-f61782d7a872",
                                "text": "Non ne pas surbrasser dans la brise, tu vas partir à l'abattée et ça fait mal; au contraire, débrasse un peu plus que dans le livre."
                            },
                            {
                                "example_id": "c5939ca7-d6aa-497a-9080-8978a02e04fc",
                                "sense_id": "8cf29876-be21-3650-9181-f61782d7a872",
                                "text": "Action sur le bras : débrasser le tangon part vers l'avant, brasser le tangon est ramené en arrière et plus perpendiculaire au bateau."
                            },
                            {
                                "example_id": "4de8f8fa-2685-4325-9392-92fba4eb318d",
                                "sense_id": "8cf29876-be21-3650-9181-f61782d7a872",
                                "text": "J’ai l’avantage d’avoir un peu d’avance alors que nous avons des trajectoires suffisamment proches dorénavant pour continuer de jouer la course sur toutes ces petites choses comme barrer, border, choquer, brasser, débrasser au rythme des grains et des petites bascules qu’on va encore négocier, dit-il."
                            }
                        ]
                    }
                ],
