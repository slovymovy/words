                        "examples": [
                            {
                                "example_id": "b19e0182-f73a-4215-b3de-2b05e069bd7b",
                                "sense_id": "4d6940a1-feff-31d3-b671-38e128515ceb",
                                "text": "De kist van de jonggestorven dichter Jacques Perk werd, voor de herbegrafenis, in aanwezigheid van diens vader geopend."
                            },
                            {
                                "example_id": "44003b5e-a9a1-4d64-a33e-f594e524d6eb",
                                "sense_id": "4d6940a1-feff-31d3-b671-38e128515ceb",
                                "text": "Zonder eerbetoon, zonder Spaanse vlag. Voor de tweede keer begraaft Spanje vandaag Francisco Franco. De Spaanse oud-dictator wordt overgedragen van de Dodenvallei bij Escorial naar een familiegraf in een plaatsje bij Madrid. De helikoptervlucht met de kist duurt hooguit een kwartier, een fractie van de decennialang durende strijd rond de herbegrafenis."
                            }
