                                "target_senses": [
                                    {
                                        "sense_id": "167231cb-70a9-3aac-a90c-ff3722e6ba64",
                                        "entry_id": "81b9d7d1-324c-3722-b277-6a9351f9152c",
                                        "glosses": [
                                            "Se dice de quien finge ser o sentir lo contrario de lo que es o lo que siente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d700ae4d-419d-44c6-8e34-bcd7e4675b7d",
                                                "sense_id": "167231cb-70a9-3aac-a90c-ff3722e6ba64",
                                                "text": "¿O cómo puedes decir a tu hermano: “Hermano, déjame sacar la paja que está en tu ojo”, no mirando tú la viga que está en el tuyo? Hipócrita, saca primero la viga de tu propio ojo y entonces verás bien para sacar la paja que está en el ojo de tu hermano."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a090de0e-9b65-34b6-a150-962819be4748",
                                        "entry_id": "81b9d7d1-324c-3722-b277-6a9351f9152c",
                                        "glosses": [
