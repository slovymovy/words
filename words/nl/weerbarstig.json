{
    "word_family": [
        "weerbarstigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4d33441-a09b-3a1b-bb11-2320c39b2add",
                    "sense_definition": "zich verzettend tegen gezag of regels",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>weerbarstige</w> tiener weigerde naar zijn ouders te luisteren.",
                            "target_lang_translations": {
                                "en": "The <w>rebellious</w> teenager refused to listen to his parents."
                            }
                        },
                        {
                            "text": "Het was een <w>weerbarstige</w> leerling die de hele klas verstoorde.",
                            "target_lang_translations": {
                                "en": "He was an <w>unruly</w> student who disrupted the entire class."
                            }
                        }
                    ],
                    "synonyms": [
                        "opstandig",
                        "weerspannig"
                    ],
                    "antonyms": [
                        "gehoorzaam",
                        "meegaand"
                    ],
                    "target_lang_definitions": {
                        "en": "Resisting authority or rules; rebellious or defiant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rebellious",
                                "target_lang_sense_clarification": "describing someone who resists authority"
                            },
                            {
                                "target_lang_word": "defiant",
                                "target_lang_sense_clarification": "showing open resistance to authority"
                            },
                            {
                                "target_lang_word": "unruly",
                                "target_lang_sense_clarification": "difficult to control or discipline"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c865ad55-c058-303e-b1e3-ddf59f050ace",
                    "sense_definition": "moeilijk op te lossen of te hanteren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moeilijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is een <w>weerbarstig</w> probleem dat niet zomaar verdwijnt.",
                            "target_lang_translations": {
                                "en": "This is a <w>stubborn</w> problem that will not just go away."
                            }
                        },
                        {
                            "text": "De economische crisis bleek een <w>weerbarstige</w> kwestie voor de regering.",
                            "target_lang_translations": {
                                "en": "The economic crisis proved to be an <w>intractable</w> issue for the government."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardnekkig",
                        "lastig"
                    ],
                    "target_lang_definitions": {
                        "en": "Difficult to solve, handle, or deal with; persistent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stubborn",
                                "target_lang_sense_clarification": "difficult to change or overcome"
                            },
                            {
                                "target_lang_word": "intractable",
                                "target_lang_sense_clarification": "hard to control or deal with"
                            },
                            {
                                "target_lang_word": "persistent",
                                "target_lang_sense_clarification": "continuing to exist despite efforts to stop it"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "226a889a-72f0-3baa-871b-dd641c155df9",
                    "sense_definition": "moeilijk te vormen of te buigen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fysieke_eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>weerbarstige</w> metaal liet zich niet gemakkelijk smeden.",
                            "target_lang_translations": {
                                "en": "The <w>stiff</w> metal could not be forged easily."
                            }
                        },
                        {
                            "text": "Door de kou was het materiaal erg <w>weerbarstig</w> geworden.",
                            "target_lang_translations": {
                                "en": "Due to the cold, the material had become very <w>inflexible</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stug",
                        "onbuigzaam"
                    ],
                    "antonyms": [
                        "buigzaam",
                        "soepel"
                    ],
                    "target_lang_definitions": {
                        "en": "Difficult to shape, bend, or manipulate physically."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "not easily bent or changed in shape"
                            },
                            {
                                "target_lang_word": "inflexible",
                                "target_lang_sense_clarification": "resisting physical bending"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b91112f-1343-3fe0-818b-ca646b46a7c8",
                    "sense_definition": "moeilijk in model te brengen of te verzorgen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke_eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Van dat <w>weerbarstige</w> haar valt geen kapsel te maken.",
                            "target_lang_translations": {
                                "en": "You cannot style that <w>unmanageable</w> hair."
                            }
                        },
                        {
                            "text": "Zij gebruikte veel gel om haar <w>weerbarstige</w> lokken in bedwang te houden.",
                            "target_lang_translations": {
                                "en": "She used a lot of gel to keep her <w>stubborn</w> locks under control."
                            }
                        }
                    ],
                    "synonyms": [
                        "stug"
                    ],
                    "target_lang_definitions": {
                        "en": "Difficult to style, manage, or groom (often used for hair)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unmanageable",
                                "target_lang_sense_clarification": "difficult to style or control"
                            },
                            {
                                "target_lang_word": "stubborn",
                                "target_lang_sense_clarification": "resisting attempts to be styled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}