{
    "word_family": [
        "leach",
        "leachate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "760ff77d-5da2-33b7-adc8-4f95d4bb6a39",
                    "sense_definition": "A substance that dissolves and washes out from soil or another solid material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agricultural chemical acted as a persistent <w>leacher</w> in the sandy ground.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственный химикат действовал как стойкое <w>вымываемое вещество</w> в песчаной почве."
                            }
                        },
                        {
                            "text": "Scientists tested runoff samples to see which contaminant was the primary <w>leacher</w> moving into groundwater.",
                            "target_lang_translations": {
                                "ru": "Ученые исследовали пробы стоков, чтобы выяснить, какой загрязнитель был основным <w>вымываемым компонентом</w>, попадающим в грунтовые воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "leachate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, которое растворяется и вымывается из почвы или другого твердого материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымываемое вещество",
                                "target_lang_sense_clarification": "о растворяющемся и уносимом водой веществе"
                            },
                            {
                                "target_lang_word": "фильтрат",
                                "target_lang_sense_clarification": "просачивающееся жидкое вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1736dc84-adab-3ed5-ab50-526deed86bac",
                    "sense_definition": "Obsolete form of <w>lecher</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript described the villain as a vile <w>leacher</w> who preyed upon the innocent.",
                            "target_lang_translations": {
                                "ru": "В старинной рукописи злодей описывался как мерзкий <w>развратник</w>, охотившийся на невинных."
                            }
                        },
                        {
                            "text": "In the play, he was denounced as a shameless <w>leacher</w> devoid of honor.",
                            "target_lang_translations": {
                                "ru": "В пьесе его заклеймили как бесстыдного <w>сластолюбца</w>, лишенного чести."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "archaic spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова lecher (развратник, сластолюбец)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развратник",
                                "target_lang_sense_clarification": "похотливый человек"
                            },
                            {
                                "target_lang_word": "сластолюбец",
                                "target_lang_sense_clarification": "устаревшее или книжное значение"
                            },
                            {
                                "target_lang_word": "блудник",
                                "target_lang_sense_clarification": "архаичное значение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
