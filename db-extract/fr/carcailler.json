                        "glosses": [
                            "Crier, en parlant de la caille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8aea975a-8657-385b-9ee4-41fc8336989c",
                        "entry_id": "136a9026-4a94-3645-a2fc-06c28756006f",
                        "glosses": [
                            "Faire un bruit rappelant le cri de la caille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961101e2-f5a1-4f60-91a9-cf3015f5726d",
                                "sense_id": "8aea975a-8657-385b-9ee4-41fc8336989c",
                                "text": "Ses entrailles carcaillèrent; il se retrouva prestissimo au lieu d’aisances à lire, étronner et trôner."
                            }
                        ]
                    }
                ],
                "translations": [
