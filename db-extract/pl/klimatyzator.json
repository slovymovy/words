                    {
                        "translation_id": "df592816-770e-4cd4-98a1-5cf6e8fbb8c1",
                        "source_entry_id": "837ee8e1-0b60-33bb-a08c-67bee7dc2849",
                        "source_sense_id": "fc7f41db-6ab0-3203-80e5-8ca60d3a9bb2",
