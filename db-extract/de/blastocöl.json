                "senses": [
                    {
                        "sense_id": "43deb3fa-d440-3c20-bad3-520d4cd38dcf",
                        "entry_id": "4cbb6c83-04ea-3eed-af50-813743e54bd8",
                        "glosses": [
                            "Keim- oder Furchungshöhle der Blastula"
                        ],
                        "tags": [
                            "Entwicklungsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0563123c-4372-4a67-a6e9-37c7e9ade5ea",
                                "sense_id": "43deb3fa-d440-3c20-bad3-520d4cd38dcf",
                                "text": "„Die am animalen Pol liegenden Blastomeren entwickeln einen apicalen Wimpernschopf und am gegenüberliegenden Pol wandern die Abkömmlinge der Mikromeren in das Blastocöl ein […].“"
                            },
                            {
                                "example_id": "e8b9e58e-e2a5-4a68-b226-ac5cec36a41b",
                                "sense_id": "43deb3fa-d440-3c20-bad3-520d4cd38dcf",
                                "text": "„In der Regel handelt es sich bei der Blastula um eine hohle Zellkugel, die einen flüssigkeitsgefüllten Hohlraum umgibt, das Blastocoel oder die primäre Leibeshöhle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
