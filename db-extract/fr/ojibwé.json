                ],
                "senses": [
                    {
                        "sense_id": "f7f068cd-45a5-3229-a54e-1c47c09a7dee",
                        "entry_id": "5bcd1d47-a4f0-3a5d-bb3f-d2c85ccd1040",
                        "glosses": [
                            "Langue polysynthétique directe-inverse de la famille des langues algonquiennes, parlée principalement dans le nord de l’Ontario et jusque dans certaines communautés de Colombie-Britannique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31399a6-e1e3-444f-820a-1e16a55a6859",
                                "sense_id": "f7f068cd-45a5-3229-a54e-1c47c09a7dee",
                                "text": "De la soixantaine de langues autochtones déclarées lors du recensement en 2011, une poignée seulement, comme les langues cries, l’ojibwé, l’oji-cri et le déné, demeurent fortes et viables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cd29319-de07-477e-9078-b4c8fbd03c69",
                        "source_entry_id": "5bcd1d47-a4f0-3a5d-bb3f-d2c85ccd1040",
                        "source_sense_id": "f7f068cd-45a5-3229-a54e-1c47c09a7dee",
                        "target_lang_word": "Ojibwe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ojibwe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39732171-e011-313f-8835-c2964156ca2c",
                                        "entry_id": "f30396b9-ae10-3ce1-a07f-3880434d4b7d",
                                        "glosses": [
                                            "The language spoken by the native Algonquin people of central Canada, one of a closely related group of languages and dialects of the Algonquian branch of the Algic language family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8784d8a8-d1a5-4131-97c5-5be9f01cc3ec",
                                                "sense_id": "39732171-e011-313f-8835-c2964156ca2c",
                                                "text": "On a Tuesday in April 2017, Janet Macbeth composed an all-office email. “My story,” read the subject line in Nishnaabemwin, the Ojibwe language.\n“Hello everyone,” the email continued in Nishnaabemwin. “My name is Janet.”"
                                            },
                                            {
                                                "example_id": "da1e4710-92b4-428e-94f1-47a4aa9266b7",
                                                "sense_id": "39732171-e011-313f-8835-c2964156ca2c",
                                                "text": "Endangered language communities would be thrilled with and proud of that kind of exposure for their language, like when Star Wars was dubbed into Navajo and Ojibwe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ojibwe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e99a470-e53d-38b1-abb4-36b7680b4970",
                                        "entry_id": "3fbd3b9a-c5c0-3fc6-aa84-705b21b9f9c7",
                                        "glosses": [
                                            "A member of a native Algonquin people of central Canada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f905ef-4d9f-413c-861a-34e51ce78c87",
                                                "sense_id": "2e99a470-e53d-38b1-abb4-36b7680b4970",
                                                "text": "The Anishinaabe people are American Indians who have historically been associated with the Great Lakes region of what is now called Canada and the United States. The Anishinaabe people of the Great Lakes include the Odawas (also known as the Ottawas), the Chippewas (also known as the Ojibwes), and the Potawatomis (also known as the Bodéwadmis)—three interrelated groups that are sometimes collectively referred to as the Three Fires Confederacy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ojibwe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23ea3474-d218-3599-8015-0103d0807618",
                                        "entry_id": "1b7efc24-cf55-34b0-9d48-a6498b26089a",
                                        "glosses": [
                                            "Of or pertaining to this people, culture or language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d260f93-e901-4734-98d3-0569d46d0d3a",
                                                "sense_id": "23ea3474-d218-3599-8015-0103d0807618",
                                                "text": "Then for 50 years its story lay dormant — although the Dream Dance remained a component of Ojibwe life both north and south of the Canada-U.S. border until its rediscovery by a Winnipeg historian and her colleagues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
