                ],
                "senses": [
                    {
                        "sense_id": "f580f005-1a7d-325a-887d-25e67ffae6b2",
                        "entry_id": "e28853d1-4367-34de-bd42-3450a1074a0a",
                        "glosses": [
                            "Reise, die der Bildung oder weiteren Ausbildung des Reisenden dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568670bb-c99b-4ceb-be79-31dde0c79f0f",
                                "sense_id": "f580f005-1a7d-325a-887d-25e67ffae6b2",
                                "text": "„Den zeigt er dem schwärmerischen jungen Naturfreund, für diesen ein unvergeßliches Erlebnis, wahrscheinlich nicht weniger bedeutsam als die gesamte verwegene Bildungsreise.“"
                            },
                            {
                                "example_id": "e7dafe44-3043-45d8-ae3e-2269e66fd890",
                                "sense_id": "f580f005-1a7d-325a-887d-25e67ffae6b2",
                                "text": "„Zudem ist Barth trotz seiner Jugend schon sehr erfahren, hat Abenteuerlust und Durchhaltewillen bewiesen: Als er von 1845 bis 1847 auf einer Bildungsreise die Länder rund um das Mittelmeer erkundete, wurde er im libysch-ägyptischen Grenzgebiet von Banditen überfallen und angeschossen.“"
                            },
                            {
                                "example_id": "eec839d9-ccae-494f-87b0-3899685195e9",
                                "sense_id": "f580f005-1a7d-325a-887d-25e67ffae6b2",
                                "text": "„Auch unternahm er eine Bildungsreise nach Griechenland und Kleinasien.“"
                            },
                            {
                                "example_id": "004a3310-31a9-46bb-888a-75c5a8d2715e",
                                "sense_id": "f580f005-1a7d-325a-887d-25e67ffae6b2",
                                "text": "„Seine Aufzeichnungen lesen sich wie das Protokoll einer Bildungsrise: Jeden Tag besichtigte er Krankenhäuser, Fabriken und Sehenswürdigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
