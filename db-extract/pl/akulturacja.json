                "senses": [
                    {
                        "sense_id": "3f76d169-cb9b-3c01-96f1-0c5444a18018",
                        "entry_id": "9ce50fde-7496-398c-be08-35faddfed8b5",
                        "glosses": [
                            "Übernahme von Teilen einer fremden Kultur durch eine Gruppe oder eine Person; Akkulturation"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
