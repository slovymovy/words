                ],
                "senses": [
                    {
                        "sense_id": "2a534b2f-2e69-3075-b4e1-658b592459da",
                        "entry_id": "546555c1-0bf6-36b9-8d14-c72de04268cb",
                        "glosses": [
                            "Sortir du moufle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02c69a6-50ac-4ac1-8315-df4da3b11a29",
                                "sense_id": "2a534b2f-2e69-3075-b4e1-658b592459da",
                                "text": "Lorsque le moufle est froid, démoufler avec précaution, surtout si les pièces ne sont pas de dépouille."
                            },
                            {
                                "example_id": "1f328ea0-91c2-49ec-91ca-6edd8ed5b950",
                                "sense_id": "2a534b2f-2e69-3075-b4e1-658b592459da",
                                "text": "Avant de démoufler, on laisse bien refroidir, afin d’éviter qu’un trop brusque changement de température ne fasse éclater la dent; on façonne le talon de vulcanite en lui donnant le meilleur aspect possible et on polit."
                            },
                            {
                                "example_id": "ac769e22-c125-46e7-b6cd-67ed91e41e33",
                                "sense_id": "2a534b2f-2e69-3075-b4e1-658b592459da",
                                "text": "Cet appareil, appliqué directement sur l’arbre de mouvement, est construit de manière à être placé sans démoufler les arbres."
                            }
                        ]
                    }
                ],
