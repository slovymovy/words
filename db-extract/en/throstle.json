    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3691355f-0f5e-321b-979a-80d8a3ec62e9",
                "word": "throstle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b860fafc-279f-4e21-9f1f-e5e30aefcdf8",
                        "entry_id": "3691355f-0f5e-321b-979a-80d8a3ec62e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "throstles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4fe50e0-c6b5-34d1-8547-0e28bdcc80ef",
                        "entry_id": "3691355f-0f5e-321b-979a-80d8a3ec62e9",
                        "glosses": [
                            "A song thrush."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "0104aa3e-e59d-48be-863c-a32f0f94bb5d",
                                "sense_id": "c4fe50e0-c6b5-34d1-8547-0e28bdcc80ef",
                                "text": "The Throstell, with shrill Sharps; as purposely he song / T’awake the lustlesse Sunne; or chyding, that so long"
                            },
                            {
                                "example_id": "2fdf8802-caa1-4fbf-8497-edd85f541e38",
                                "sense_id": "c4fe50e0-c6b5-34d1-8547-0e28bdcc80ef",
                                "text": "The throstle is by some believed to be the finest singing bird in Britain, on account of the sweetness, variety, and continuance of its melody."
                            },
                            {
                                "example_id": "c9a82ee8-72d4-4892-a3dc-311f858f3c55",
                                "sense_id": "c4fe50e0-c6b5-34d1-8547-0e28bdcc80ef",
                                "text": "O Lady! in this wan and heartless mood / To other thoughts by yonder throstle woo'd"
                            },
                            {
                                "example_id": "8fdeb237-655d-4720-8c41-e1cc94a6cdd2",
                                "sense_id": "c4fe50e0-c6b5-34d1-8547-0e28bdcc80ef",
                                "text": "[T]hro' wild March the throstle calls, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "75671e43-17eb-3588-ab2b-5a7e5a909d95",
                        "entry_id": "3691355f-0f5e-321b-979a-80d8a3ec62e9",
                        "glosses": [
                            "A machine for spinning wool, cotton, etc., from the rove, consisting of a set of drawing rollers with bobbins and flyers, and differing from the mule in having the twisting apparatus stationary and the processes continuous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dbddff-ce6d-4cf8-ac3b-ab4efc5ee7c8",
                                "sense_id": "75671e43-17eb-3588-ab2b-5a7e5a909d95",
                                "text": "THE RING THROSTLE. / A Throstle under the above title has been recently introduced from America, the principal novel feature of which, is a substitute for the flyer and heavy spindle of the common throstle, and for the cone or cape, and the barrel tube of the Danforth throstle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dbc8b36-a82b-4189-9c0b-e78650ad66e4",
                        "source_entry_id": "3691355f-0f5e-321b-979a-80d8a3ec62e9",
                        "source_sense_description": "song thrush",
                        "target_lang_word": "Drossel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drossel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                        "entry_id": "f7d4c12f-5d38-38f3-875a-6c70f08acf02",
                                        "glosses": [
                                            "eine Gattung insektenfressender Singvogel, deutlich größer als ein Spatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d173535-4907-48e2-8d55-b1143bf3742b",
                                                "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                                "text": "Viele nordische Drosseln überwintern in Mitteleuropa."
                                            },
                                            {
                                                "example_id": "27022173-573c-4469-a25d-80adf7145681",
                                                "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                                "text": "„Eine der wenigen Begebenheiten, die den beschaulichen Inselalltag aus dem Rhythmus brachten, war der Zug der Stare, Drosseln und Schnepfen, die im Frühjahr und Herbst auf der Insel zwischenlandeten.“"
                                            },
                                            {
                                                "example_id": "42a0cda9-1715-4dbc-89a7-aeec00cc2d69",
                                                "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                                "text": "„Eine Drossel begann zu schlagen.“"
                                            },
                                            {
                                                "example_id": "94221cf0-831c-4bd1-b36c-64c297ab8f88",
                                                "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                                "text": "„Die Drossel begann aufs neue zu singen.“"
                                            },
                                            {
                                                "example_id": "b02013b4-77a5-4e2c-9365-f99094d8c197",
                                                "sense_id": "cabde3ff-8314-35c4-ac6b-7623ceb57253",
                                                "text": "„Draußen im Garten hüpften die Drosseln in den Bäumen herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d1f2492-fccc-3d81-a150-279fdf0c94c7",
                                        "entry_id": "f7d4c12f-5d38-38f3-875a-6c70f08acf02",
                                        "glosses": [
                                            "die Singdrossel, die zur Gattung der Echten Drosseln gehört"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d4bd11-6476-45ca-8d39-b0ee66ebd7a2",
                                                "sense_id": "4d1f2492-fccc-3d81-a150-279fdf0c94c7",
                                                "text": "Amsel, Drossel, Fink und Star",
                                                "translation": "Und die ganze Vogelschar (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9dbc80f4-e2a9-35ce-aa4d-923f04d23a72",
                                        "entry_id": "f7d4c12f-5d38-38f3-875a-6c70f08acf02",
                                        "glosses": [
                                            "die Familie Turdidae"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a88dc6-994c-427d-9410-4a189dfcb5c7",
                                                "sense_id": "9dbc80f4-e2a9-35ce-aa4d-923f04d23a72",
                                                "text": "Die Nachtigall wird zu den Drosseln oder den Fliegenschnäppern gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Drossel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3df2138f-f648-3d0b-be86-769e346abb97",
                                        "entry_id": "6dfadf03-332b-396f-ba0c-340e8951d312",
                                        "glosses": [
                                            "Luftröhre, Kehle des Wildes"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf9a1d3-5c9d-4992-9195-5db3d49fe682",
                                                "sense_id": "3df2138f-f648-3d0b-be86-769e346abb97",
                                                "text": "Und wenn von einer (alten) Schnapsdrossel die Rede ist, also einer dem Alkohol zugeneigten Person, so hat dieses nicht mit dem Singvogel zu tun. Der scherzhafte Ausdruck bezieht sich vielmehr auf den waidmännischen Ausdruck für die Kehle. Damit erklärt sich auch die Herkunft von \"erdrosseln\", also gewaltsam die Kehle zuschnüren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6bd09acf-552a-3d97-a0d7-64ecea66e768",
                                        "entry_id": "6dfadf03-332b-396f-ba0c-340e8951d312",
                                        "glosses": [
                                            "eine Vorrichtung zur Regulierung der Durchflussmenge"
                                        ],
                                        "tags": [
                                            "Mechanik",
                                            "Maschinenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e236f34-9113-4670-ba5d-fcf24dccaf0f",
                                                "sense_id": "6bd09acf-552a-3d97-a0d7-64ecea66e768",
                                                "text": "Die Drossel setzt Strömen hoher Frequenz einen hohen Widerstand entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7fdac330-c826-3ea3-a6ee-320b8c96cddf",
                                        "entry_id": "6dfadf03-332b-396f-ba0c-340e8951d312",
                                        "glosses": [
                                            "ein passives, induktives elektrisches Bauteil zur Energiespeicherung oder Störungsdämpfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64078d58-c784-4769-8959-b1d3022588a5",
                                                "sense_id": "7fdac330-c826-3ea3-a6ee-320b8c96cddf",
                                                "text": "Die Drossel regelt die Durchflussmenge von Gasen oder Flüssigkeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
