                "senses": [
                    {
                        "sense_id": "ed5cba0a-6cdc-3846-ab1a-c61d4bcc65c9",
                        "entry_id": "f61fe90a-3f40-3d62-8102-e02a148b03af",
                        "glosses": [
                            "Angleichung (Assimilation) von Vokalen im Wort aneinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecb1fc6-5b54-4675-9b3f-af8e8755605f",
                                "sense_id": "ed5cba0a-6cdc-3846-ab1a-c61d4bcc65c9",
                                "text": "„Im Türkischen kennt man 2 Vokalharmonien: Die große und die kleine Vokalharmonie. Die Vokalharmonie steuert die Abfolge und eventuelle Umwandlungen der Vokale in den einzelnen Wörtern und den Endungen.“"
                            },
                            {
                                "example_id": "066bb881-44f7-47a8-858f-60c6b47918e8",
                                "sense_id": "ed5cba0a-6cdc-3846-ab1a-c61d4bcc65c9",
                                "text": "„Die Vokalharmonie ist ein in ihrem Ansatz einfaches Wortgestaltungsprinzip, sie setzt zwei Vokalklassen voraus…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "306a588f-2f7d-3b61-980b-f0ec9f5cf75d",
                        "entry_id": "f61fe90a-3f40-3d62-8102-e02a148b03af",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "ee65231c-4ebb-4028-8dd8-6995c85a2612",
                                "sense_id": "306a588f-2f7d-3b61-980b-f0ec9f5cf75d",
                                "text": "„Besonders beeindruckend sind die Vokalharmonien der Band – abwechselnd übernehmen weibliche und männliche Stimmen die Führung, am schönsten wird es, wenn mehrstimmig gesungen wird.“"
                            },
                            {
                                "example_id": "9de676dd-8e73-40c5-97f8-040c0927f3a0",
                                "sense_id": "306a588f-2f7d-3b61-980b-f0ec9f5cf75d",
                                "text": "„Dies war sowohl der unterkühlt groovenden Militanz der Musik geschuldet – den bassschweren Rhythmusarchitekturen und zuckersüßen Vokalharmonien – wie dem schwarznationalen Radikalismus, in dem Black Uhuru die Aufgabe ihres Roots-Reggae sahen…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
