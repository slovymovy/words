                                        "glosses": [
                                            "Of a digit or figure, see significant figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "significant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a3d42bc-6668-3522-b390-0d09504815a8",
                                        "entry_id": "5a6597ad-1f4e-396f-96a5-542a87dc4063",
                                        "glosses": [
                                            "That which has significance; a sign; a token; a symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258cf864-9057-4066-b3f9-d480404c776e",
                                                "sense_id": "0a3d42bc-6668-3522-b390-0d09504815a8",
                                                "text": "In dumb significants proclaim your thoughts."
                                            },
                                            {
                                                "example_id": "664fda76-316c-4beb-a417-047420e2bae2",
                                                "sense_id": "0a3d42bc-6668-3522-b390-0d09504815a8",
                                                "text": "And in my glass significants there are"
