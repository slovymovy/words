                                    {
                                        "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                        "entry_id": "33841bf7-08cb-38ea-9e74-eab38d7fcecd",
                                        "glosses": [
                                            "Groupe ayant des intérêts convergents et réalisant des activités ayant pour but d’influencer la prise de décisions dans une orientation favorable à ses intérêts économiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a8f7d0-e49b-40ab-8573-475bfecc8e8e",
                                                "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                                "text": "Pour complaire à un lobby, on n’hésite pas à prendre le risque de provoquer des dégâts considérables sur le plan diplomatique et économique."
                                            },
                                            {
                                                "example_id": "24f87f62-1df5-4f3d-bb9f-90b9c1d8d25c",
                                                "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                                "text": "J’avais tenté de trouver quelques études indépendantes sur le sujet, elles ne sont pas légion car dépendant trop souvent du lobby thermaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                        "entry_id": "33841bf7-08cb-38ea-9e74-eab38d7fcecd",
                                        "glosses": [
                                            "Hall d’accueil d’un hôtel."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f4bf18-fb4d-4ee3-882e-e4e657e0280c",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Allez vous rassembler dans le lobby de l’hôtel, là je vais vous remettre vos clés."
                                            },
                                            {
                                                "example_id": "25592ff2-e8cb-4b7b-87ed-657dca335304",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Il y avait beaucoup de monde dans le lobby. Protégé par l’anonymat de son uniforme, il a pu se glisser discrètement vers une sortie de service."
                                            },
                                            {
                                                "example_id": "553ee74e-7779-45e4-9e2d-afd825ca0f68",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Soudain amis pour la vie, nous étions ensuite restés des heures dans le lobby de l’hôtel, à discuter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
