                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter onderzocht of de <w>zenuw</w> in zijn rug beschadigd was.",
                            "target_lang_translations": {
