            {
                "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                "word": "bookend",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e8664506-24c0-4721-b671-144815d5227b",
                        "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "bookends"
                    },
                    {
                        "form_id": "82afca22-6654-4913-b8a6-2958a10ca1ef",
                        "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "bookending"
                    },
                    {
                        "form_id": "4a5fe368-8e13-4776-8139-6bbcd00b452d",
                        "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "bookended"
                    },
                    {
                        "form_id": "b4f4e89d-56c5-4de5-9992-48b9c5897b10",
                        "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "tags": [
                            "past"
                        ],
                        "form": "bookended"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                        "entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "glosses": [
                            "To come before and after, or at both sides of."
                        ],
                        "tags": [
                            "figuratively",
                            "often",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e28fa4a8-3d83-48b2-a2d0-d7f03813aca9",
                                "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                                "text": "Taking the 18th-century tale at a steady, relentless drumbeat, and with a seductively cool detachment, Kubrick guides you through his hero’s rise and fall, bookended by two sensational duelling scenes."
                            },
                            {
                                "example_id": "25f6c18d-1b0e-4ba6-9f98-2d4bf6331c45",
                                "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                                "text": "Side one has good songs bookended by better songs."
                            },
                            {
                                "example_id": "a9014137-7428-42d4-9984-0a7387700292",
                                "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                                "text": "The tale is bookended by battles – faces meatily pummelled, bones crunchily broken and throats spurtingly sliced as offstage conflicts are placed centre-screen."
                            },
                            {
                                "example_id": "539044c6-ba3f-46e1-9003-6ef384b9c277",
                                "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                                "text": "Her aim is to answer questions that “raze to the bone of life”, including the most profound of all: “How, in this blink of existence bookended by nothingness, do we attain completeness of being?”"
                            },
                            {
                                "example_id": "80a60d42-b708-454f-ad5f-5a6ce3f49c16",
                                "sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                                "text": "Yes, there are leisure lines to be enjoyed - in the Welsh 'Queen' resorts of Llandudno and Aberystwyth, or the steamer jewel of Douglas on the Isle of Man, where dramatic mountain and hill inclines were overcome and bookended with amusements and culinary amenities for the enjoyment of visitors."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5ea9852-6eff-4126-a5f6-149a11cce5ae",
                        "source_entry_id": "904ced14-b200-3422-83bd-6c6deb610c14",
                        "source_sense_id": "249be256-278c-32ce-a820-c6cc10786b12",
                        "source_sense_description": "to come before and after, or at both sides of",
                        "target_lang_word": "einrahmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einrahmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                        "entry_id": "410182a0-e508-33de-b8ff-4f3d3f017c34",
                                        "glosses": [
                                            "etwas oder jemanden in einen Rahmen fassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b35d16b-2ab7-4d6c-84b6-aca2ce233b76",
                                                "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                                "text": "Da finden sich alte Karten, die mit ihren bunten, bis zu Gold- und Silberprägungen gesteigerten Farben und ihren ebenso naiven wie hochkünstlerischen Ausschmückungen oft wie Gemälde wirken, die man sich am liebsten einrahmte und an die Wand hinge."
                                            },
                                            {
                                                "example_id": "725da99d-a7cf-4e11-b5a3-80336fe47a41",
                                                "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                                "text": "Die Einladungskarte zu einem ganz besonderen Diner hütet Hervé Valverdes wie einen Schatz. Der Besitzer eines Feinschmecker-Restaurants in Bordeaux hat sie eingerahmt und präsentiert sie gerne seinen Gästen."
                                            },
                                            {
                                                "example_id": "8f260c87-8c58-4cdc-9f4a-46949735f429",
                                                "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                                "text": "An der Wand hinter dem Schreibtisch von Craig Holman hängt eingerahmt die Auszeichnung als „Top-Lobbyist“."
                                            },
                                            {
                                                "example_id": "48059a21-2542-450e-b8fd-9e7dcac364ce",
                                                "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                                "text": "2001 beschloss Thaler, 30 Bilder von ihr mit nach Dachau zu nehmen, wo ein befreundeter Glasermeister sie ihm kostenlos einrahmte."
                                            },
                                            {
                                                "example_id": "f1b5a099-6d23-4ff0-bd42-2af44e815456",
                                                "sense_id": "9687588d-5f64-31cf-b926-a0c601fed257",
                                                "text": "Gerade Maria Borges sah aus wie ein Paradiesvogel, mit einer üppigen Federpracht, die ihren Kopf praktisch einrahmte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
