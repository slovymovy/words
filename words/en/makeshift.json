{
    "word_family": [
        "shift"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84688318-4eeb-3fd9-bc6e-c933e85466cb",
                    "sense_definition": "Serving as a temporary substitute for something else, often created quickly from available materials.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temporary_solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used the ledge and a few branches for a <w>makeshift</w> shelter.",
                            "target_lang_translations": {
                                "ru": "Они использовали выступ скалы и несколько веток для <w>импровизированного</w> укрытия."
                            }
                        },
                        {
                            "text": "The team had to use a <w>makeshift</w> desk made of old wooden crates.",
                            "target_lang_translations": {
                                "ru": "Команде пришлось использовать <w>самодельный</w> стол, сделанный из старых деревянных ящиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "improvised",
                        "temporary",
                        "provisional"
                    ],
                    "antonyms": [
                        "permanent"
                    ],
                    "common_phrases": [
                        "makeshift shelter",
                        "makeshift repair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная замена, часто созданная на скорую руку из подручных материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импровизированный",
                                "target_lang_sense_clarification": "созданный на месте из того, что было под рукой"
                            },
                            {
                                "target_lang_word": "самодельный",
                                "target_lang_sense_clarification": "сделанный самостоятельно, часто кустарным способом"
                            },
                            {
                                "target_lang_word": "временный",
                                "target_lang_sense_clarification": "существующий лишь на короткий срок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42d6efe6-d594-329c-bb68-a390a71dec77",
                    "sense_definition": "A temporary or inadequate substitute used until something better is available.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temporary_solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tent was only a <w>makeshift</w> until we could find a proper hotel.",
                            "target_lang_translations": {
                                "ru": "Палатка была лишь <w>временной заменой</w>, пока мы не смогли найти нормальный отель."
                            }
                        },
                        {
                            "text": "These policies are mere <w>makeshifts</w> that fail to address the root cause.",
                            "target_lang_translations": {
                                "ru": "Эти меры — лишь <w>временные приспособления</w>, которые не решают проблему в корне."
                            }
                        }
                    ],
                    "synonyms": [
                        "stopgap",
                        "substitute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное или недостаточно качественное решение, используемое до появления чего-то лучшего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "временная замена",
                                "target_lang_sense_clarification": "объект или решение, используемое вместо основного"
                            },
                            {
                                "target_lang_word": "временное приспособление",
                                "target_lang_sense_clarification": "устройство или мера, принятая в экстренном порядке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7a668c-1d83-37b0-81a1-acbbeb67e804",
                    "sense_definition": "A dishonest or unreliable person who lives by their wits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play described the villain as a <w>makeshift</w> and a scoundrel.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе злодей был описан как <w>прохвост</w> и негодяй."
                            }
                        },
                        {
                            "text": "He was known in the village as a <w>makeshift</w> who could never be trusted.",
                            "target_lang_translations": {
                                "ru": "В деревне его знали как <w>пройдоху</w>, которому нельзя было доверять."
                            }
                        }
                    ],
                    "synonyms": [
                        "rogue",
                        "swindler"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely historical and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный или ненадежный человек, живущий за счет своей хитрости (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прохвост",
                                "target_lang_sense_clarification": "мошенник, ненадёжный человек (устар.)"
                            },
                            {
                                "target_lang_word": "пройдоха",
                                "target_lang_sense_clarification": "ловкий плут"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}