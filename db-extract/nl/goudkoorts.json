                        "examples": [
                            {
                                "example_id": "8b30df84-44cf-4d1d-91ed-e4fe8303795e",
                                "sense_id": "321ee020-cb33-3d21-aca3-4f35ae05caf2",
                                "text": "Zelfs kondigde de uitgever van het Californian dagblad de staking der uitgave aan, aangezien de goudkoorts hem alle lezers ontnam.",
                                "translation": "The publisher of the Californian daily even announced an end to publication, for the gold fever deprived him of all his readers.",
