                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5a64a2-1ca0-4a01-bdf6-d478fee6c097",
                                "sense_id": "3ee0ba13-7fc7-3e23-9651-1085b9d11141",
                                "text": "They are typified by those thermodynamicists who for decades have drawn ever closer to the temperature of absolute zero, when atoms cease all motion."
                            },
                            {
                                "example_id": "6e406150-4370-48b5-b0f5-4807635929b8",
                                "sense_id": "3ee0ba13-7fc7-3e23-9651-1085b9d11141",
                                "text": "In my favorite Meta A.I. ad, a woman tells her boyfriend that she’s excited to have him meet her parents — before impishly mentioning that her father is a thermodynamicist at NASA. The befuddled boyfriend rushes home, phone in hand. “Hey Meta,” he asks. “What the heck is a thermodynamicist?”"
                            }
