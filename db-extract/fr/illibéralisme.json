                                    {
                                        "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                                        "entry_id": "d0834528-45db-3479-807d-1171a2581221",
                                        "glosses": [
                                            "The principle, state or quality of being illiberal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084863e2-c9c2-4885-a74a-ead72c905b81",
                                                "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                                                "text": "As the Oxford political theorist Michael Freeden observed, if just one of the necessary components — for example, the free market — dominates, then the result can be illiberalism."
                                            },
                                            {
                                                "example_id": "b3d8bf39-8364-44eb-8688-ad31afcfa08a",
                                                "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                                                "text": "In the Netherlands, the anti-immigrant right became the second-most-popular vote-getter — a new high-water mark for illiberalism in that once famously liberal country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
