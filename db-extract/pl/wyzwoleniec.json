                                "target_senses": [
                                    {
                                        "sense_id": "cf856c18-daad-3fa7-af82-cbbfbb1ec4d9",
                                        "entry_id": "cec3f6f7-dfec-3db8-a13d-6bfc3a5a2430",
                                        "glosses": [
                                            "A man who has been released from a condition of slavery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b153cb7-73ad-4fee-ad87-2d4483ce1a1c",
                                                "sense_id": "cf856c18-daad-3fa7-af82-cbbfbb1ec4d9",
                                                "text": "The nomen belonged to all members of a gens and to all those attached to it (women, clients, and freedmen included)."
                                            },
                                            {
                                                "example_id": "379d84e6-b91e-47b7-91cd-c96cecab1414",
                                                "sense_id": "cf856c18-daad-3fa7-af82-cbbfbb1ec4d9",
                                                "text": "Education was a high priority for Appalachian freedmen and freedwomen just as it was for blacks throughout the Reconstruction South."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6e93e2d-4963-409b-9a74-4242c97a612a",
                        "source_entry_id": "2b18c160-b435-33a5-b3f8-719ee4cd5bbd",
