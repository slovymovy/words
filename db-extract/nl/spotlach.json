                        "glosses": [
                            "een lach waarmee men met iets of iemand de spot drijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b359ab-1c4c-4dc3-9c9f-65ee72c1705e",
                                "sense_id": "1cbac68f-f2c3-3765-ad22-520331a7bef0",
                                "text": "Zij voeren dat van vroeger verder, alle kleine beuzelingen zijn gewichtigheden en alle gewichtige problemen worden met een spotlach afgedaan; het toilet en het kapsel nemen vele uren in beslag, als vroeger dragen zij hun haren gepoederd, zijn hun wangen geschminkt, hun kleren met kanten en strikken versierd."
                            },
                            {
                                "example_id": "f078764f-bdc0-460a-9fd6-a77e01c59ecf",
                                "sense_id": "1cbac68f-f2c3-3765-ad22-520331a7bef0",
                                "text": "Hij ziet de spotlach niet die ze hem nazendt."
                            }
                        ]
                    }
