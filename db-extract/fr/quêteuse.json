                "senses": [
                    {
                        "sense_id": "90f3c729-9379-3329-b8ec-6c487cdc2f90",
                        "entry_id": "2ca094e7-90aa-3ebc-93e7-59bd768154fe",
                        "glosses": [
                            "Celle qui quête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2312db6-a874-4c74-873d-196e5853e0a1",
                                "sense_id": "90f3c729-9379-3329-b8ec-6c487cdc2f90",
                                "text": "Le front plissé, Jacques de Fleurville ouvre la porte avec un geste de contrariété. On sent qu’il aura vite fait de se débarrasser de la quêteuse indiscrète. Mais Arlette le regarde droit dans les yeux."
                            },
                            {
                                "example_id": "61aa966e-8311-413c-ad6b-098595ecf70e",
                                "sense_id": "90f3c729-9379-3329-b8ec-6c487cdc2f90",
                                "text": "S’il arrive qu’on ose offrir à de vieilles quêteuses de vieux cadeaux, on hésite lorsque la solliciteuse est élégante et jeune…"
                            },
                            {
                                "example_id": "701e7d53-0b95-4a59-a3e0-2f8b43083dbb",
                                "sense_id": "90f3c729-9379-3329-b8ec-6c487cdc2f90",
                                "text": "Des blessés, des amputés, des capotes délavées de permissionnaires. Autant de quêteuses que de passants, pour je ne sais quelle œuvre."
                            }
                        ]
                    }
                ],
