                            {
                                "example_id": "c2028a38-eeba-4229-b56f-44513af4152a",
                                "sense_id": "7cda66c9-16a3-3db0-abd5-a33f8b608451",
                                "text": "„Doch diese Annahme ist falsch. Tatsächlich gelten nur 20 Prozent der Sahara als Sandwüste.“"
                            },
                            {
                                "example_id": "0f75593d-9c09-4375-9ad2-033bc29cbc92",
                                "sense_id": "7cda66c9-16a3-3db0-abd5-a33f8b608451",
                                "text": "„Das Gelände im edlen Strandviertel Barra, wo 2016 unter anderen Tennis gespielt und Rad gefahren werden soll, gleicht einer Sandwüste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
