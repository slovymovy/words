                                "target_lang_sense_clarification": "Monday to Friday"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "w tygodniu",
                                "target_lang_sense_clarification": "w dni powszednie"
                            },
                            {
                                "target_lang_word": "w dni powszednie",
                                "target_lang_sense_clarification": "od poniedziałku do piątku"
                            }
                        ]
                    }
                }
            ]
        },
        {
