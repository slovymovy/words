                    {
                        "translation_id": "b62a4a3a-007f-4fd4-b46b-d6dae045c5cf",
                        "source_entry_id": "d8598a12-a305-3f8c-b872-1dfccbdac221",
                        "source_sense_description": "To make bad or worse",
                        "target_lang_word": "verderben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verderben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2239e5e0-0e56-3d99-9c49-1cf2d38220cd",
                                        "entry_id": "3360ccae-49a4-3ae5-8790-228793be8995",
                                        "glosses": [
                                            "etwas unbrauchbar oder zunichte machen, speziell auch jemandem ein positives Gefühl nehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e32aa47-4751-4ce9-91f6-aec3883e04ca",
                                                "sense_id": "2239e5e0-0e56-3d99-9c49-1cf2d38220cd",
                                                "text": "Erzähl mir nicht den Schluss des Fußballspiels, sonst verdirbst du mir die Freude!"
                                            },
                                            {
                                                "example_id": "238a05b7-1d8c-47a2-9047-1b42274daa22",
                                                "sense_id": "2239e5e0-0e56-3d99-9c49-1cf2d38220cd",
                                                "text": "Mit so viel Salz hast du die ganze Suppe verdorben."
                                            },
                                            {
                                                "example_id": "8dd424c5-4349-4e1a-b741-248ce8b3781e",
                                                "sense_id": "2239e5e0-0e56-3d99-9c49-1cf2d38220cd",
                                                "text": "Verdirb dir nicht deine letzte Chance!"
                                            },
                                            {
                                                "example_id": "60706e25-8cda-4389-8e07-a8c682995f5d",
                                                "sense_id": "2239e5e0-0e56-3d99-9c49-1cf2d38220cd",
                                                "text": "„Gandhi hatte das nicht in böser Absicht gesagt, aber wie er später einmal bemerkte, hatte er es sich damit ein für allemal mit Jinnah verdorben, dessen Kenntnisse der Muttersprache keinen Vergleich mit seiner englischen Rhetorik aushielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b342718-1eb5-30f0-aca2-77d0e3906095",
                                        "entry_id": "3360ccae-49a4-3ae5-8790-228793be8995",
                                        "glosses": [
                                            "verfaulen, schlecht werden (hauptsächlich von Lebensmitteln)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043ab624-c95d-455b-91b4-4fd27e847223",
                                                "sense_id": "6b342718-1eb5-30f0-aca2-77d0e3906095",
                                                "text": "Die Bananen liegen da schon seit Wochen und sind längst verdorben."
                                            },
                                            {
                                                "example_id": "33c3ecb1-ae43-4339-beac-141680ccae9f",
                                                "sense_id": "6b342718-1eb5-30f0-aca2-77d0e3906095",
                                                "text": "Die Erdbeeren verderben bei dem Regenwetter auf dem Feld."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "497f69f2-a88e-3adc-843d-6271c7e1a6eb",
                                        "entry_id": "3360ccae-49a4-3ae5-8790-228793be8995",
                                        "glosses": [
                                            "anstößig, sündig, nicht so, wie es der Norm entspricht"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb14ac14-acc8-478f-8432-6d1e9a470878",
                                                "sense_id": "497f69f2-a88e-3adc-843d-6271c7e1a6eb",
                                                "text": "Durch ihre ewige Nachsicht hat sie die Kinder ganz und gar verdorben."
                                            },
                                            {
                                                "example_id": "d883d4b3-0964-4ab0-b416-e64f738a81c5",
                                                "sense_id": "497f69f2-a88e-3adc-843d-6271c7e1a6eb",
                                                "text": "Lass dich nicht mit so einer verdorbenen Person ein."
                                            },
                                            {
                                                "example_id": "e238854e-2ecc-4b1e-bd85-de248358478d",
                                                "sense_id": "497f69f2-a88e-3adc-843d-6271c7e1a6eb",
                                                "text": "Das ist doch ein ganz verdorbenes Pack."
                                            },
                                            {
                                                "example_id": "97a46798-8b06-4fbb-bae7-1ad8170057ee",
                                                "sense_id": "497f69f2-a88e-3adc-843d-6271c7e1a6eb",
                                                "text": "Gleich in der ersten Nummer der von ihm gegründeten Wochenschrift Die Zukunft hatte Harden munter den Rest der Zeitungsmacher als ein Heer käuflicher Fälscher denunzierte, das „ein Millionenvolk verdummt und verderbt“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
