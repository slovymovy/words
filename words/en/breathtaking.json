                    "sense_id": "2a050f55-09aa-3016-862f-eae4aec3b314",
                    "sense_definition": "stunningly beautiful or amazing to look at",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the Grand Canyon and spent a week taking in the <w>breathtaking</w> scenery all around him.",
                            "target_lang_translations": {
                                "ru": "Он отправился в Гранд-Каньон и провел неделю, любуясь <w>захватывающими</w> дух пейзажами вокруг него."
                            }
                        },
                        {
                            "text": "The <w>breathtaking</w> view from the top of the mountain made the long hike worth it.",
                            "target_lang_translations": {
                                "ru": "<w>Потрясающий</w> вид с вершины горы оправдал долгий поход."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunning",
                        "spectacular",
                        "magnificent",
                        "awesome"
                    ],
                    "antonyms": [
                        "unimpressive",
                        "ordinary",
                        "dull"
                    ],
                    "common_phrases": [
