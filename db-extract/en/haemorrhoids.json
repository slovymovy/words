    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e081197c-789d-30cd-a1e6-1451ee31c406",
                "word": "haemorrhoids",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ef163bc-67b5-3cd6-9628-ef5bb905be14",
                        "entry_id": "e081197c-789d-30cd-a1e6-1451ee31c406",
                        "glosses": [
                            "A pathological condition caused by painful masses of dilated veins in swollen anal tissue."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "30e2cc76-dfee-4d32-bc5c-9c0828302d31",
                                "sense_id": "0ef163bc-67b5-3cd6-9628-ef5bb905be14",
                                "text": "\"I hope the worst is behind me\". - France's midfielder Florent Malouds reveals he had an operation for haemorrhoids shortly after arriving in Germany for the World Cup\" Argus 17 June 2006 p.14"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0d2659c-5c35-4aea-8855-c99fadd0019b",
                        "source_entry_id": "e081197c-789d-30cd-a1e6-1451ee31c406",
                        "source_sense_id": "0ef163bc-67b5-3cd6-9628-ef5bb905be14",
                        "source_sense_description": "a pathological condition",
                        "target_lang_word": "aambeien",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aambeien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "29a68bcc-06c1-3668-8aed-e4b1cbf7fca1",
                                        "entry_id": "5acafb85-78b7-3bab-bc38-7149b6ea8f0b",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord aambei"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02a2643-25b4-4c2b-b6fd-182a8ab35bb1",
                                                "sense_id": "29a68bcc-06c1-3668-8aed-e4b1cbf7fca1",
                                                "text": "‘Heeft u inwendige of uitwendige aambeien?’ vraagt de verkoopster aan de vrouw bij de toonbank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbb87026-d61c-3984-ba5a-116aab29c055",
                                        "entry_id": "5acafb85-78b7-3bab-bc38-7149b6ea8f0b",
                                        "glosses": [
                                            "knobbelachtige zwelling van aders in het onderste deel van de endeldarm en in de anus"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a57e7d37-8d1f-4839-9a2e-4d0dc05f2f67",
                                                "sense_id": "fbb87026-d61c-3984-ba5a-116aab29c055",
                                                "text": "Aambeien plaagden hem."
                                            },
                                            {
                                                "example_id": "4d7a8051-6c77-4b8c-905f-96470522725d",
                                                "sense_id": "fbb87026-d61c-3984-ba5a-116aab29c055",
                                                "text": "Ik gebruik het graag, dat vochtige wc-papier. Dat komt zo: mijn kak was verleden jaar een tijd nogal hard. Daardoor kreeg ik last van aambeien."
                                            },
                                            {
                                                "example_id": "1a3c8229-a18e-41aa-b0b3-da8eddaad786",
                                                "sense_id": "fbb87026-d61c-3984-ba5a-116aab29c055",
                                                "text": "Aambeien is de meest voorkomende anale aandoening in Nederland."
                                            },
                                            {
                                                "example_id": "a3c258c1-0cbb-45d5-ba4a-b21f8cc7de0a",
                                                "sense_id": "fbb87026-d61c-3984-ba5a-116aab29c055",
                                                "text": "Ten slotte schaterde ze als een uitgelaten eend toen de man het vruchtendessert bracht en omdat hij in de gaten had dat we Nederlanders waren zijn standaard belegen taalgrapje maakte: 'For you! Fresh aambeien!' 'Woehoe!' brulde Joy door het restaurant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
