                                "target_senses": [
                                    {
                                        "sense_id": "057aafaf-11b4-34a7-bccd-39957008a447",
                                        "entry_id": "8cd1122b-e4ab-3fef-b371-91e987b9be90",
                                        "glosses": [
                                            "nicht erlaubt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1adafea-cbb2-45da-a741-3fa7fa3c65ab",
                                                "sense_id": "057aafaf-11b4-34a7-bccd-39957008a447",
                                                "text": "Rauchen ist in diesem Gebäude strengstens verboten."
                                            },
                                            {
                                                "example_id": "c6725a54-5a77-4e58-bbf8-edc17fe3597e",
                                                "sense_id": "057aafaf-11b4-34a7-bccd-39957008a447",
                                                "text": "„Wenn diese Berichte von Gewalttaten oder verbotener Leidenschaft handelten, dann umso besser.“"
                                            },
                                            {
                                                "example_id": "2eb51d97-13f0-464a-839e-3a4304226d68",
                                                "sense_id": "057aafaf-11b4-34a7-bccd-39957008a447",
                                                "text": "„Um verbotene Substanzen müsse es damals nicht unbedingt gegangen sein, Amateursportler bäten manchmal auch einfach um Cortison.“"
                                            }
                                        ],
