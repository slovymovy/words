                        ],
                        "examples": [
                            {
                                "example_id": "f1fa6cf9-6a26-4a5b-8d39-4547599433fc",
                                "sense_id": "4ac5003d-d97a-32d7-8b28-1901b944feac",
                                "text": "Он ра́довался своему́ дыха́нию, своему́ сме́ху, ра́довался, что существу́ет графи́н, потоло́к, луч, тесёмка на занаве́ске.",
                                "translation": "He was delighted with his breathing and with his laughter; he was delighted with the existence of the water-bottle, the ceiling, the sun beam, the ribbon on the curtain.",
                                "english": "He was delighted with his breathing and with his laughter; he was delighted with the existence of the water-bottle, the ceiling, the sun beam, the ribbon on the curtain."
                            }
                        ]
