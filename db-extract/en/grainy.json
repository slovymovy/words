                                    {
                                        "sense_id": "c79476e0-7716-37f3-b6d4-985b1f38a63d",
                                        "entry_id": "6e16fc88-bde4-3526-a6f4-e51d09636f61",
                                        "glosses": [
                                            "aus groben Körnern bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a87d092-4ee1-4c88-adce-324c2da989ad",
                                                "sense_id": "c79476e0-7716-37f3-b6d4-985b1f38a63d",
                                                "text": "Nehmen Sie doch etwas grobkörnigeren Katzensand, der wird nicht so leicht in die Wohnung getragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d39f103-dc44-3a0d-860b-36f7692951db",
                                        "entry_id": "6e16fc88-bde4-3526-a6f4-e51d09636f61",
                                        "glosses": [
                                            "ein großes Korn aufweisend, sodass es sehr lichtempfindlich, aber kontrastarm ist"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1035906f-b8de-4585-9f7b-664398f4c209",
                                                "sense_id": "1d39f103-dc44-3a0d-860b-36f7692951db",
                                                "text": "Das Foto ist so grobkörnig, dass man den Gesichtsausdruck des Mannes da links gar nicht gut erkennen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
