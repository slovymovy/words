                    {
                        "translation_id": "7b850ccf-7d16-4b7f-aca1-7c3e56115085",
                        "source_entry_id": "36c18735-f16b-3d4c-a7f1-2f190c816c37",
                        "source_sense_id": "fdd3652e-fef9-3fbb-9107-498b99a9db73",
                        "source_sense_description": "Einwohner der Provence",
                        "target_lang_word": "Provençal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Provençal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105d9cac-dbe2-3cff-b617-31e38b92b60c",
                                        "entry_id": "68b9aad6-1a18-33c7-8b66-38985ee0a114",
                                        "glosses": [
                                            "Habitant de la Provence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447a6557-2425-40e3-94bf-0d0f1806465e",
                                                "sense_id": "105d9cac-dbe2-3cff-b617-31e38b92b60c",
                                                "text": "Charles aima Bettina Wallenrod autant qu’il était aimé d’elle, et c’est beaucoup dire ; mais quand un Provençal s’exalte, tout chez lui devient naturel en fait de sentiment."
                                            },
                                            {
                                                "example_id": "f10caf2a-bcea-4d2a-94f9-46f37988920e",
                                                "sense_id": "105d9cac-dbe2-3cff-b617-31e38b92b60c",
                                                "text": "Dans le Languedoc, ils m’appellent Provençal. Mais c'est moi qui m'suis gouré en disant mon nom. Sinon, en Bretagne, c'est le Gros Faisan au sud, et au nord, c'est juste Ducon ..."
                                            },
                                            {
                                                "example_id": "b6e7b811-727f-4277-bc4c-92ac6192ab64",
                                                "sense_id": "105d9cac-dbe2-3cff-b617-31e38b92b60c",
                                                "text": "Vers la fin du siècle dernier, le vélocifère, prédécesseur de la diligence et des messageries, débarquait à Paris un provençal, plein de verve et d'entrain, né dans la ville d’Aix, et bossu, comme Ésope, par devant et par derrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
