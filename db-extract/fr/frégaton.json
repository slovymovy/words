                        "glosses": [
                            "Petit bateau pointu par les deux bouts et qui ne va qu'à la rame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc3c24a-90ac-490f-907a-f95946e73eb4",
                                "sense_id": "75d5364d-8670-36b9-ab0c-825d8a8e268c",
                                "text": "Le frégaton n’avait qu’un mât comme la frégate ; il n’avait pas de couverte, et se servait, dans les virements de bord, de quelques rames longues et lourdes."
                            }
                        ]
                    },
