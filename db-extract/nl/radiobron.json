                        "glosses": [
                            "een klein, afgebakend gebied aan de hemel van waaruit radiostraling afkomstig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12389661-a263-4728-9b8d-1ed22f87474c",
                                "sense_id": "1010bc8b-9ee6-3158-aabf-d26a94bd2c3f",
                                "text": "Samen met twee collega's, Shri Kulkarni en George Djorgovski, ontdekte Andy Fruchter op de positie van de radiobron een zwak sterretje dat regelmatig van helderheid veranderde."
                            },
                            {
                                "example_id": "0e88548b-1189-45e4-a00f-326607dbbb6f",
                                "sense_id": "1010bc8b-9ee6-3158-aabf-d26a94bd2c3f",
                                "text": "Grote radiotelescopen op aarde hebben een extreem scherp gezichtsvermogen, en uit het puntvormige karakter van de radiobron volgt dat hij niet groter kan zijn dan zo'n tweehonderd miljoen kilometer - minder dan de middellijn van de baan die de aarde om de zon beschrijft."
                            }
