{
    "word_family": [
        "destitution"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                    "sense_definition": "Extremely poor and lacking the basic necessities of life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families were left <w>destitute</w> after the war destroyed their homes and businesses.",
                            "target_lang_translations": {
                                "tr": "Savaş evlerini ve iş yerlerini yok ettikten sonra birçok aile <w>muhtaç</w> durumda kaldı.",
                                "nl": "Veel gezinnen bleven <w>berooid</w> achter nadat de oorlog hun huizen en bedrijven had verwoest."
                            }
                        },
                        {
                            "text": "The charity works to provide food and shelter for the <w>destitute</w> people living on the streets.",
                            "target_lang_translations": {
                                "tr": "Hayır kurumu, sokaklarda yaşayan <w>sefil</w> insanlar için yiyecek ve barınak sağlamaya çalışıyor.",
                                "nl": "De liefdadigheidsinstelling zet zich in om voedsel en onderdak te bieden aan de <w>behoeftige</w> mensen die op straat leven."
                            }
                        }
                    ],
                    "synonyms": [
                        "penniless",
                        "impoverished",
                        "indigent"
                    ],
                    "antonyms": [
                        "wealthy",
                        "affluent"
                    ],
                    "common_phrases": [
                        "destitute people",
                        "left destitute"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı yoksul, temel yaşam ihtiyaçlarından yoksun.",
                        "nl": "Buitengewoon arm en verstoken van de eerste levensbehoeften."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "muhtaç",
                                "target_lang_sense_clarification": "Temel ihtiyaçlarını karşılayamayacak durumda olan."
                            },
                            {
                                "target_lang_word": "sefil",
                                "target_lang_sense_clarification": "Aşırı yoksulluk içinde yaşayan."
                            },
                            {
                                "target_lang_word": "yoksul",
                                "target_lang_sense_clarification": "Maddi durumu çok kötü olan."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "berooid",
                                "target_lang_sense_clarification": "Volledig zonder geld of middelen van bestaan."
                            },
                            {
                                "target_lang_word": "behoeftig",
                                "target_lang_sense_clarification": "Hulp of financiële steun nodig hebbend om te overleven."
                            },
                            {
                                "target_lang_word": "onbemiddeld",
                                "target_lang_sense_clarification": "Zonder financiële middelen of bezittingen."
                            },
                            {
                                "target_lang_word": "noodlijdend",
                                "target_lang_sense_clarification": "In ernstige armoede of nood verkerend."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3102d2cc-359c-327e-b8d2-b5d6f2585fe3",
                    "sense_definition": "Completely lacking or devoid of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lacking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The remote island is <w>destitute</w> of any natural resources or fresh water sources.",
                            "target_lang_translations": {
                                "tr": "Uzak ada, herhangi bir doğal kaynaktan veya tatlı su kaynağından <w>yoksun</w>.",
                                "nl": "Het afgelegen eiland is <w>verstoken van</w> natuurlijke hulpbronnen of zoetwaterbronnen."
                            }
                        },
                        {
                            "text": "His argument was <w>destitute</w> of any logical evidence to support his claims.",
                            "target_lang_translations": {
                                "tr": "Argümanı, iddialarını destekleyecek herhangi bir mantıksal kanıttan <w>mahrumdu</w>.",
                                "nl": "Zijn betoog was <w>ontbloot van</w> enig logisch bewijs om zijn beweringen te staven."
                            }
                        }
                    ],
                    "synonyms": [
                        "devoid",
                        "lacking",
                        "bereft"
                    ],
                    "antonyms": [
                        "full",
                        "abundant"
                    ],
                    "common_phrases": [
                        "destitute of"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyden tamamen yoksun veya mahrum.",
                        "nl": "Volledig verstoken of ontbloot van iets."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yoksun",
                                "target_lang_sense_clarification": "Bir şeyden mahrum olma durumu."
                            },
                            {
                                "target_lang_word": "mahrum",
                                "target_lang_sense_clarification": "Bir şeyin eksikliğini çeken."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verstoken van",
                                "target_lang_sense_clarification": "Iets belangrijks of noodzakelijks missend."
                            },
                            {
                                "target_lang_word": "ontbloot van",
                                "target_lang_sense_clarification": "Geheel zonder een bepaalde eigenschap of kwaliteit."
                            },
                            {
                                "target_lang_word": "zonder",
                                "target_lang_sense_clarification": "Niet in het bezit van iets."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28e92427-4307-3779-ad92-d3de596668b5",
                    "sense_definition": "To make someone extremely poor by taking away their resources or wealth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic collapse served to <w>destitute</w> many families who had previously been middle class.",
                            "target_lang_translations": {
                                "tr": "Ani ekonomik çöküş, daha önce orta sınıf olan birçok aileyi <w>yoksullaştırdı</w>.",
                                "nl": "De plotselinge economische ineenstorting zorgde ervoor dat veel gezinnen die eerder tot de middenklasse behoorden, werden <w>verarmd</w>."
                            }
                        },
                        {
                            "text": "The legal battle threatened to <w>destitute</w> the entire family by draining their savings.",
                            "target_lang_translations": {
                                "tr": "Hukuki mücadele, birikimlerini tüketerek tüm aileyi <w>sefalete sürüklemekle</w> tehdit etti.",
                                "nl": "De juridische strijd dreigde het hele gezin <w>tot de bedelstaf te brengen</w> door al hun spaargeld op te souperen."
                            }
                        }
                    ],
                    "synonyms": [
                        "impoverish",
                        "bankrupt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini kaynaklarını veya servetini elinden alarak aşırı yoksul bırakmak.",
                        "nl": "Iemand tot uiterste armoede brengen door diens geld of middelen te ontnemen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yoksullaştırmak",
                                "target_lang_sense_clarification": "Birini fakir duruma düşürmek."
                            },
                            {
                                "target_lang_word": "sefalete sürüklemek",
                                "target_lang_sense_clarification": "Birini aşırı yoksulluk içine itmek."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verarmen",
                                "target_lang_sense_clarification": "Iemand arm of berooid maken."
                            },
                            {
                                "target_lang_word": "ruïneren",
                                "target_lang_sense_clarification": "Financieel ten gronde richten."
                            },
                            {
                                "target_lang_word": "tot de bedelstaf brengen",
                                "target_lang_sense_clarification": "Iemand in diepe armoede storten."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}