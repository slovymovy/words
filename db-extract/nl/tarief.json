                        "cross_references": [
                            {
                                "target_word": "tariff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A system of government-imposed duties levied on imported or exported goods; a list of such duties, or the duties themselves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8e4bb1-bf60-4593-bdf4-d25ee1b6670f",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "For the sake of this support, the party advocated for agricultural tariffs, for antimargarine laws, and for restrictions on meat importation."
                                            },
                                            {
                                                "example_id": "9f1beaed-1178-4f8c-8b5f-74e990a7c3e2",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "Possibly Wallonians bought goods in Flanders that they could have obtained cheaper in Holland if it were not for the tariff."
                                            },
                                            {
                                                "example_id": "2ee7614c-4a7e-4786-898b-49554c641bf4",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "It’s been nearly four years since China put tariffs on American-grown soybeans during a tit-for-tat trade war with then-President Donald Trump – and they remain in place despite the change in administrations."
                                            },
                                            {
                                                "example_id": "c5d3a05e-1b7f-4b79-be5c-30947e25c149",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "Speaking to press in the Oval Office on Friday after signing executive orders, Trump said the tariff would apply to any phone maker selling devices in the US."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A schedule of rates, fees or prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad2a17e-ff47-48cf-b876-bb7570c77e8f",
                                                "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                                "text": "Under a peak/off-peak electricity tariff, you pay a lower rate for the power when demand is less."
                                            },
                                            {
                                                "example_id": "0fb3e032-1fa0-4e3e-9249-d52563411ca1",
                                                "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                                "text": "There is a tariff in every carriage, and most of them also have taxometers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "028fbc80-f9d9-3c0e-bca0-3134336f54af",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A sentence determined according to a scale of standard penalties for certain categories of crime."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tariff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa23e06-9bb4-3a19-82b5-5101ccd624f7",
                                        "entry_id": "79c86a06-c897-320b-8494-e03f88edb3b7",
                                        "glosses": [
                                            "To levy a duty on (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1aa662-2671-4077-957e-801ec05e8616",
                                                "sense_id": "aaa23e06-9bb4-3a19-82b5-5101ccd624f7",
                                                "text": "From the perspective of foreign producers, it is more difficult to export tariffed goods to the US because US importers have to pay the tariff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c6b0a7-3070-48dc-875e-3ed9a4b66927",
                        "source_entry_id": "cd039452-d8d8-3e57-8065-e94c5b662832",
                        "source_sense_id": "91c9229f-ceba-32b6-89fc-96e5f02b099d",
                        "source_sense_description": "een vastgesteld bedrag per eenheid",
                        "target_lang_word": "tarif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f22df4e8-36eb-3e78-b528-32d0741798d9",
                                        "entry_id": "e5db9bb4-1350-3a3f-8a59-882c2a2b9c07",
                                        "glosses": [
                                            "Tableau qui marque le prix de certaines denrées, les droits d’entrée, de sortie, de passage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf124230-5e07-4912-8f36-852c74ac8694",
                                                "sense_id": "f22df4e8-36eb-3e78-b528-32d0741798d9",
                                                "text": "Revu l'arrêté royal du 24 février 1823, nᵒ 125, contenant approbation du tarif des taxes municipales de Gand ; […]."
                                            },
                                            {
                                                "example_id": "fe0c0f7c-0c0e-4be8-8a24-9ade6b82cbf7",
                                                "sense_id": "f22df4e8-36eb-3e78-b528-32d0741798d9",
                                                "text": "C'était le tarif des prix, soit à la course, soit à l'heure, avec la traduction française en regard du texte allemand. Faute de mieux, je m'en contentai; je lus mon tarif des voitures avec attention, […]."
                                            },
                                            {
                                                "example_id": "64513b39-35bc-4204-bfd4-0467ca640349",
                                                "sense_id": "f22df4e8-36eb-3e78-b528-32d0741798d9",
                                                "text": "Comme le tarif était peu élevé (1 fr. 25 par verso ou par 72 mots ), les solicitors allongèrent leurs actes en y insérant des clauses redondantes, afin de rendre suffisant le montant de leurs honoraires."
                                            },
                                            {
                                                "example_id": "245c8e8d-5d73-48dd-98e4-c36ed986972d",
                                                "sense_id": "f22df4e8-36eb-3e78-b528-32d0741798d9",
                                                "text": "Tarif des frais et dépens, règlement qui fixe le coût des divers actes et les divers droits de vacations en matière de procédure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b0e5e5-ce1a-366d-a78d-48718a55a730",
                                        "entry_id": "e5db9bb4-1350-3a3f-8a59-882c2a2b9c07",
                                        "glosses": [
                                            "Prix à payer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ca605a-a25c-4317-817f-a9826ede1c66",
                                                "sense_id": "f6b0e5e5-ce1a-366d-a78d-48718a55a730",
                                                "text": "Le train à tarif réduit."
                                            },
                                            {
                                                "example_id": "09907455-2140-4eb0-8608-360f9edc1eac",
                                                "sense_id": "f6b0e5e5-ce1a-366d-a78d-48718a55a730",
                                                "text": "Les marchandises doivent être payées par l’acheteur au tarif indiqué, à moins qu’une négociation concluante ait eu lieu entre le vendeur et l’acheteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
