                        "target_lang_word": "Ehebrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehebrecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "445a1414-3115-3f23-b851-4fff4a3c4958",
                                        "entry_id": "eb5412b0-df7f-327c-aa58-7489e7779d14",
                                        "glosses": [
                                            "Person, die Ehebruch begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35fe47de-d46a-4a34-88fd-22edce372729",
                                                "sense_id": "445a1414-3115-3f23-b851-4fff4a3c4958",
                                                "text": "„Ehebrecher wird man, erklärt Pastor Kockosch, wenn man das Eheweib eines anderen nur ansieht, ihrer zu begehren, auch wenn man als Verheirateter ein junges Mädchen ansieht, das noch keinen Schapprich hat, ist man ein Ehebrecher.“"
                                            },
                                            {
                                                "example_id": "1d7a9e99-576e-4063-9ee3-d0dbe405aa47",
                                                "sense_id": "445a1414-3115-3f23-b851-4fff4a3c4958",
                                                "text": "„Letztes Jahr ist er mit zweiundvierzig zum Ehebrecher geworden, und seitdem erscheint er unangemeldet vor meiner Tür.“"
                                            },
                                            {
                                                "example_id": "b3a8d96c-c2db-4a9b-a5f6-1d17f1b78441",
                                                "sense_id": "445a1414-3115-3f23-b851-4fff4a3c4958",
                                                "text": "„Er konnte ja nicht ahnen, daß er zwei Ehebrechern seinen Segen erteilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27a95b76-54d1-4acf-85bb-e98d7258ccc1",
                        "source_entry_id": "d72d5243-136f-36d6-b450-bfe5b1648f14",
                        "source_sense_id": "39ea03a7-58b6-32ff-9c7b-f7823f8f179b",
                        "target_lang_word": "прелюбодей",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прелюбодей",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "319b3145-b723-3436-ae1b-4b5d1853f338",
                                        "entry_id": "a0fe7bd3-1ebe-3b7c-a1fb-2e8546931d9b",
                                        "glosses": [
                                            "устар. тот, кто совершает, совершил прелюбодеяние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a462ea4d-b7ea-419c-beec-e13f10d601d7",
                                                "sense_id": "319b3145-b723-3436-ae1b-4b5d1853f338",
                                                "text": "Ты же, прихлебатель за всеми столами, в ранней молодости наложник во всех спальнях и там же впоследствии прелюбодей, — пятно позора для любого сословия и напоминание о гражданской войне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
