                        "entry_id": "8fb7982e-d85a-3de7-a541-c36505fffab5",
                        "glosses": [
                            "een stellige verklaring dat iets zo is, vaak zonder het geven van de redenen waarom, mening, propositie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75be27db-cb49-4980-a22d-941cad9d96eb",
                                "sense_id": "69c41e68-4f97-309f-8473-08c1413677cf",
                                "text": "De bewering dat Wikipedia nooit van de grond zou komen is inmiddels wel weerlegd."
                            },
                            {
                                "example_id": "b6e8f031-15f4-415c-a118-1608854b4f43",
                                "sense_id": "69c41e68-4f97-309f-8473-08c1413677cf",
                                "text": "Hij klakte hard met zijn tong om zijn bewering van meer cachet te voorzien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3058f60a-9470-41d6-b32f-7564439b2570",
                        "source_entry_id": "8fb7982e-d85a-3de7-a541-c36505fffab5",
                        "source_sense_id": "69c41e68-4f97-309f-8473-08c1413677cf",
                        "source_sense_description": "een stellige verklaring dat iets zo is, vaak zonder het geven van de redenen waarom",
                        "target_lang_word": "claim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970f7e4f-15fd-329e-9ed7-82c6c07c5133",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "A demand of ownership made for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba41502b-8d68-4aca-998b-b80155283ac0",
                                                "sense_id": "970f7e4f-15fd-329e-9ed7-82c6c07c5133",
                                                "text": "a claim of ownership"
                                            },
                                            {
                                                "example_id": "0920e0d6-0fd0-402b-ab73-d085691a107f",
                                                "sense_id": "970f7e4f-15fd-329e-9ed7-82c6c07c5133",
                                                "text": "a claim of victory"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28df3f02-5bb8-3c23-9b09-9c5b84674041",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "The thing claimed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6e654f5-f1db-355c-b54c-b608413f76fb",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "The right or ground of demanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05dc20f-f7fa-420c-96f4-0323f18d6eb0",
                                                "sense_id": "a6e654f5-f1db-355c-b54c-b608413f76fb",
                                                "text": "You don't have any claim on my time, since I'm no longer your employee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc27dbf-e3fc-36d1-88f6-39384678a003",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "A new statement of something one believes to be the truth, usually when the statement has yet to be verified or without valid evidence provided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4a7d3c-d40a-41e5-8652-1c0faf75ec52",
                                                "sense_id": "8cc27dbf-e3fc-36d1-88f6-39384678a003",
                                                "text": "The company's share price dropped amid claims of accounting fraud."
                                            },
                                            {
                                                "example_id": "acc758da-f75b-4e2b-a885-e4772f6a743c",
                                                "sense_id": "8cc27dbf-e3fc-36d1-88f6-39384678a003",
                                                "text": "Bailey, in using accents, felt that he was 'directing to their proper pronuntiation' and showing 'the Orthoepia of the English Tongue' (title page, Dictionarium Britannicum, 1730 edition). The claim is ridiculous."
                                            },
                                            {
                                                "example_id": "6d78a08c-2e69-4174-92d9-59dcafdb7bda",
                                                "sense_id": "8cc27dbf-e3fc-36d1-88f6-39384678a003",
                                                "text": "The thing is, we've even had formal confirmation from Government itself that the crucial research required to make such sweeping claims hasn't been done!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e4b5041-fb32-36f2-b98c-2a269c0e3d40",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "A demand of ownership for previously unowned land."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501a61d1-2328-4163-b8a4-a40c7bf51ae2",
                                                "sense_id": "9e4b5041-fb32-36f2-b98c-2a269c0e3d40",
                                                "text": "Miners had to stake their claims during the gold rush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf27170-6297-3703-ab95-24ca2f0e8d2f",
                                        "entry_id": "a4e64be1-ff56-3d43-b368-016841e0dc54",
                                        "glosses": [
                                            "A legal demand for compensation or damages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "claim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6511cfd3-b217-39e6-b544-a9aa31bb4dcd",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To demand ownership of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62522dee-6113-4aab-9f9b-629665d6bdf8",
                                                "sense_id": "6511cfd3-b217-39e6-b544-a9aa31bb4dcd",
                                                "text": "Jeffrey Chuang, an economics student at University College London, said: \"I am for independence. I do not think China has any right to claim Taiwan. We have confidence in our country and we know that China is not capable of doing anything to us.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adb6297-f1cb-3db2-bf22-e3e6d1e94e13",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To state a new fact, typically without providing evidence to prove it is true."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78f9ed72-8ea2-312f-b137-557b1135099f",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To demand ownership or right to use for land."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2151380c-b601-392e-8148-6f8da845b514",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To demand compensation or damages through the courts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a820f52-3e84-338d-8038-0b342a578868",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To be entitled to anything; to deduce a right or title; to have a claim."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b46072-2147-4c08-b869-b8796ee8e578",
                                                "sense_id": "2a820f52-3e84-338d-8038-0b342a578868",
                                                "text": "We must know how the first ruler, from whom any one claims, came by his authority, upon what ground any one has empire"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9d2e2d-beac-33d6-903b-c1de3f451683",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To cause the loss of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebb2733-2489-4da3-a086-810d1a32b4a5",
                                                "sense_id": "be9d2e2d-beac-33d6-903b-c1de3f451683",
                                                "text": "The attacks claimed the lives of five people."
                                            },
                                            {
                                                "example_id": "66a36961-cff5-49b7-a284-45f1c409baba",
                                                "sense_id": "be9d2e2d-beac-33d6-903b-c1de3f451683",
                                                "text": "A fire claimed two homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c774d3-fe0b-3e61-be14-6af1d2465bce",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To win as a prize in a sport or competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ef12df-a2c3-4ac7-b7d2-11d606b166da",
                                                "sense_id": "d3c774d3-fe0b-3e61-be14-6af1d2465bce",
                                                "text": "He claimed $100 after winning the top spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbde0cf2-5af2-3418-b227-d6c0344eaaf6",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To proclaim."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0205b076-e163-33ce-a3fb-ba7edabbd68e",
                                        "entry_id": "79dfc152-2f6c-3877-a75d-6b05cc2c6ee7",
                                        "glosses": [
                                            "To call or name."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73227ad-ae35-4643-be83-0b4acf1453d2",
                                                "sense_id": "0205b076-e163-33ce-a3fb-ba7edabbd68e",
                                                "text": "Nor all, that else through all the world is named[…] / Might like to this be clamed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60656d8f-c6f1-4890-bc02-72c50dd7b92d",
                        "source_entry_id": "8fb7982e-d85a-3de7-a541-c36505fffab5",
                        "source_sense_id": "69c41e68-4f97-309f-8473-08c1413677cf",
                        "source_sense_description": "een stellige verklaring dat iets zo is, vaak zonder het geven van de redenen waarom",
                        "target_lang_word": "assertion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assertion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab2e479-1b2d-3144-915c-8e792d415f21",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "The act of asserting; positive declaration or averment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "Something which is asserted; a declaration; a statement asserted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "416056ae-a017-4614-acdf-c1af0e682a47",
                                                "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                                "text": "You're a man of strong assertions!"
                                            },
                                            {
                                                "example_id": "af66a702-bf37-464a-a903-2c57213037a5",
                                                "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                                "text": "Suppose you are given the semifactual assertion, \"even if Nora had liked mathematics then she would have became^([sic]) a scientist\" and then you find out that Nora did in fact become a scientist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "A statement or declaration which lacks support or evidence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120c76aa-6503-41da-9e74-c8f1f935728a",
                                                "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                                "text": "That's just a bare assertion."
                                            },
                                            {
                                                "example_id": "4a5dfda5-691b-4aea-8306-7cefef93db49",
                                                "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                                "text": "Drivers' union ASLEF bluntly rebuffed the claim of unofficial action, calling it a lie. And Avanti West Coast was unable to provide any proof for its assertion, when questioned by RAIL."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e7dd9f7-52c5-334c-a5aa-9c2b95653b5c",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "Maintenance; vindication"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01284959-b39c-4cf2-afb4-32cf40065fad",
                                                "sense_id": "1e7dd9f7-52c5-334c-a5aa-9c2b95653b5c",
                                                "text": "the assertion of one's rights or prerogatives"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16bd5c75-fa92-3f50-bbb9-9aae453c36b7",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "A statement in a program asserting a condition expected to be true at a particular point, used in debugging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c1c824-9bc5-4884-8933-f5d7d2f43cde",
                                                "sense_id": "16bd5c75-fa92-3f50-bbb9-9aae453c36b7",
                                                "text": "The user should be absolutely confident that the error issued is a real design error. In other words, a user should be confident that his assertion code is correct and that the assertion failure is not a false condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d601b1d-76f4-340b-8275-69202374a3b1",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "the set of information that the statement preparer is providing in a financial statement audit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
