                "senses": [
                    {
                        "sense_id": "3b27747d-6b23-3bc3-8773-90fcb7a362e7",
                        "entry_id": "03e13eed-5cba-3866-a41b-74daa9d35109",
                        "glosses": [
                            "явление самопроизвольного беспорядочного перемещения предметов в зданиях, сопровождающегося странными «потусторонними» звуками и разрушительными последствиями"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92ac0f6e-6197-44f6-a414-13f217f28a6e",
                        "source_entry_id": "03e13eed-5cba-3866-a41b-74daa9d35109",
                        "source_sense_id": "3b27747d-6b23-3bc3-8773-90fcb7a362e7",
                        "target_lang_word": "poltergeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poltergeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                        "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                                        "glosses": [
                                            "An unseen ghost which makes noises and causes disruption, especially by causing physical objects to move or fly about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf2f9a9-de95-46e1-8e99-10de3add0121",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "A poltergeist haunts the house by moving objects around, making chain-rattling noises and throwing things."
                                            },
                                            {
                                                "example_id": "95eb6569-fe22-4b2f-b0ba-83c9430ed796",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "The chapel is haunted by a demonic poltergeist."
                                            },
                                            {
                                                "example_id": "1944fb72-fc56-4420-bbdf-afa838ad11f9",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "\"Perhaps even a small poltergeist might come your way. Any trifle would be welcome.\" His bull's bellow of laughter followed them into the lift."
                                            },
                                            {
                                                "example_id": "57f40f4a-afee-43fe-b0d6-e118610aa773",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "I risk becoming nothing more than a common poltergeist wallowing in regrets and introspection and other terrible things."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3feb21b-cdde-407e-8cde-cda38a1d8d6f",
                        "source_entry_id": "03e13eed-5cba-3866-a41b-74daa9d35109",
                        "source_sense_id": "3b27747d-6b23-3bc3-8773-90fcb7a362e7",
                        "target_lang_word": "Poltergeist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poltergeist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e439f7e5-572e-336c-9181-033626f0185d",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "ein fiktives Wesen, Geist, der in Häusern und Schlössern wohnt, dort — naturwissenschaftlich derzeit nicht erklärbar — herumpoltert, andere Geräusche erzeugt, elektrische Störungen hervorruft und Gegenstände bewegt"
                                        ],
                                        "tags": [
                                            "Parapsychologie",
                                            "Parawissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710b402d-8ea2-4932-90af-bb16a3da8728",
                                                "sense_id": "e439f7e5-572e-336c-9181-033626f0185d",
                                                "text": "Der Poltergeist geht wieder um."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "Person oder Tier, das unerwünschten Lärm verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d0dc23-de2a-4b4d-82a5-5e148bc68e2c",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "Du bist heute ja wieder ein richtiger Poltergeist."
                                            },
                                            {
                                                "example_id": "7db6f9ea-70c3-4efc-9d53-6dbb34b928f5",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "Bei uns treibt ein Poltergeist unterm Dach sein Unwesen: ein Marder."
                                            },
                                            {
                                                "example_id": "3aec4c2d-eb0b-4195-a4a8-7a2570391873",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "„Draußen regen sich die Poltergeister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b7ac92b-9911-3f3f-ab8b-ac812860cc42",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "Person mit ruppigem Auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256f6f07-dc92-4775-b5dd-77e98b3cdbf9",
                                                "sense_id": "4b7ac92b-9911-3f3f-ab8b-ac812860cc42",
                                                "text": "In der Versammlung produzierte er sich wieder als Poltergeist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
