                        "cross_references": [
                            {
                                "target_word": "Zwischenhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d681afa2-6ce1-3657-8c61-a5d406568df2",
                                        "entry_id": "24ed8b75-9455-38c1-a977-77fc4e3178dc",
                                        "glosses": [
                                            "Person, die Waren kauft, um sie dann an einen Einzelhändler oder Weiterverarbeiter weiterzuverkaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3adcb7e-6cb0-4a20-9ec1-8939f7b1f3ee",
                                                "sense_id": "d681afa2-6ce1-3657-8c61-a5d406568df2",
                                                "text": "„Für Bauern und Zwischenhändler war es weit attraktiver, ihre Produkte über private Kontakte zu verkaufen, statt sie zu den oft kaum kostendeckenden offiziellen Preisen auf dem regulären Markt anzubieten.“"
                                            },
                                            {
                                                "example_id": "b987b2d3-c91e-4d55-a8bc-859fa754fbea",
                                                "sense_id": "d681afa2-6ce1-3657-8c61-a5d406568df2",
                                                "text": "„Zwischenhändler reichen die Unfreien über Monate hinweg an neue Besitzer weiter, die sie ihrerseits weiterverkaufen.“"
                                            },
                                            {
                                                "example_id": "e7d81ffd-7af4-4149-b1d4-b6d8494ee336",
                                                "sense_id": "d681afa2-6ce1-3657-8c61-a5d406568df2",
                                                "text": "„Wenn die Ware über die Grenze gebracht war, wurde sie auf deutscher Seite an die Zwischenhändler verkauft, und von dort aus ging sie an die Schwarzmarkthändler in Köln und ins Ruhrgebiet.“"
                                            },
                                            {
                                                "example_id": "7db46231-be74-4259-8f61-c23bff11d7d2",
                                                "sense_id": "d681afa2-6ce1-3657-8c61-a5d406568df2",
                                                "text": "„Indem die Amerikaner Kokafelder umpflügen, Kokainlabore zerstören und Zwischenhändler dingfest machen, treiben sie den Gewinn der Drogenkartelle nach oben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
