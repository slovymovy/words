                "senses": [
                    {
                        "sense_id": "45923f42-10e2-3b16-81f7-579aba0a6316",
                        "entry_id": "8ab87e74-ed41-393b-9794-eecad794eccd",
                        "glosses": [
                            "przemieszczenie, przeniesienie, zmiana miejsca, przebywania, pobytu"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "733155a2-9282-4757-bde1-dc8f61816bff",
                                "sense_id": "45923f42-10e2-3b16-81f7-579aba0a6316",
                                "text": "Kolejną fazą będzie więc relokacja i kierowanie inwestycji w stronę nowych gałęzi, które dadzą impuls do dalszego rozwoju"
                            },
                            {
                                "example_id": "35cddf21-f6ed-450d-9055-99729059aead",
                                "sense_id": "45923f42-10e2-3b16-81f7-579aba0a6316",
                                "text": "Po masowej akcji osiedlania w połowie 1949 roku na relokację czekało 175 tys. osób"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42b82fdf-561e-45eb-927c-201a870af09a",
                        "source_entry_id": "8ab87e74-ed41-393b-9794-eecad794eccd",
                        "source_sense_id": "45923f42-10e2-3b16-81f7-579aba0a6316",
                        "target_lang_word": "relocation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relocation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3f686b9-4945-3964-83f4-ffa5f44b6e70",
                                        "entry_id": "5710137b-2efd-312f-89b4-adb4cb002bdd",
                                        "glosses": [
                                            "The act of moving from one place to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0740ae85-bbeb-447f-a84c-313705837137",
                                                "sense_id": "f3f686b9-4945-3964-83f4-ffa5f44b6e70",
                                                "text": "Another source of discontent with the Phase I stock has been obviated by relocation of the interior heating elements and the introduction of thermostatic control; this has eradicated the searing blasts of hot air passengers used to feel about their calves […]."
                                            },
                                            {
                                                "example_id": "32c3893a-a634-44ba-a21b-62edead9746f",
                                                "sense_id": "f3f686b9-4945-3964-83f4-ffa5f44b6e70",
                                                "text": "The work to deliver an 18tph service involves relocation of four signals and associated equipment to improve signal spacing."
                                            },
                                            {
                                                "example_id": "f334b5fd-5b15-4146-bd96-ad1f0e80fbdb",
                                                "sense_id": "f3f686b9-4945-3964-83f4-ffa5f44b6e70",
                                                "text": "He was also entitled to a relocation payment but has chosen not to take it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e64e6c83-b6ed-3ef3-b739-aca66fede1f8",
                                        "entry_id": "5710137b-2efd-312f-89b4-adb4cb002bdd",
                                        "glosses": [
                                            "Renewal of a lease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d22c337b-eec8-3136-ad79-c3562b27b8a4",
                                        "entry_id": "5710137b-2efd-312f-89b4-adb4cb002bdd",
                                        "glosses": [
                                            "The assigning of addresses to variables either at linkage editing, or at runtime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1effcbf-b560-4f4f-a0b4-8e2b7ce98ec9",
                                                "sense_id": "d22c337b-eec8-3136-ad79-c3562b27b8a4",
                                                "text": "A peculiarity of ECOFF relocation entries is that even on 32-bit machines, they're 10 bytes long, which means that on machines that require aligned data, the linker can't just load the entire relocation table into a memory array[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c17e15a6-afcf-424c-bedd-81cee635c947",
                        "source_entry_id": "8ab87e74-ed41-393b-9794-eecad794eccd",
                        "source_sense_id": "45923f42-10e2-3b16-81f7-579aba0a6316",
                        "target_lang_word": "relocalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relocalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c649b6ee-cf95-3e4c-8aef-863c73267cd2",
                                        "entry_id": "45aae844-e087-30c7-81c0-bbdc78a7e9ae",
                                        "glosses": [
                                            "Action de transférer quelque chose (en particulier une activité économique, des postes de travail, etc.) à un nouvel emplacement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264f7137-2af1-43d3-93a5-fa7869f991a6",
                                                "sense_id": "c649b6ee-cf95-3e4c-8aef-863c73267cd2",
                                                "text": "115 personnes ont été accueillies dans le Grand Est dans le cadre du programme européen de relocalisation des réfugiés"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574033bf-ffd8-3d43-b32d-d94dd83bbd94",
                                        "entry_id": "45aae844-e087-30c7-81c0-bbdc78a7e9ae",
                                        "glosses": [
                                            "Rapatriement de quelque chose (en particulier une activité économique) préalablement délocalisée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ed686e-46ed-4855-aadc-bf8b23b6df5c",
                                                "sense_id": "574033bf-ffd8-3d43-b32d-d94dd83bbd94",
                                                "text": "La relocalisation des activités, dans l’industrie, dans l’agriculture et les services, doit permettre d’instaurer une meilleure autonomie face aux marchés internationaux, de reprendre le contrôle sur les modes de production et d'enclencher une transition écologique et sociale des activités."
                                            },
                                            {
                                                "example_id": "37c0739a-e305-4a91-9380-5e1c661ed05e",
                                                "sense_id": "574033bf-ffd8-3d43-b32d-d94dd83bbd94",
                                                "text": "Pour reprendre pleinement la main sur le devenir de son lait, le fermier en est arrivé à la conclusion qu’il n’existe qu’une solution : la relocalisation. « La relocalisation de l’économie, c’est recréer de la richesse sur le territoire en valorisant votre produit jusqu’au bout, c’est un pied de nez à la mondialisation », soutient Matthieu Gloria, associé d’Adrien sur la ferme du Val Fleury et emballé par l’idée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6377d135-f39f-394c-a69c-c68cbb2bf1b2",
                                        "entry_id": "45aae844-e087-30c7-81c0-bbdc78a7e9ae",
                                        "glosses": [
                                            "Relocalisation de personnes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1538cf54-bb24-4e25-8745-f49acdfefba6",
                                                "sense_id": "6377d135-f39f-394c-a69c-c68cbb2bf1b2",
                                                "text": "Le 20 juillet 2015, compte tenu de la situation particulière de chaque État membre, une résolution des représentants des gouvernements des États membres, réunis au sein du Conseil [européen], concernant la relocalisation depuis la Grèce et l’Italie de 40 000 personnes ayant manifestement besoin d’une protection internationale a été adoptée par consensus."
                                            },
                                            {
                                                "example_id": "ae653a11-afcf-49a9-a4eb-c0bcbb6ae8ad",
                                                "sense_id": "6377d135-f39f-394c-a69c-c68cbb2bf1b2",
                                                "text": "relocalisation, le transfert d'un demandeur du territoire de l'État membre que les critères énoncés au chapitre III du règlement (UE) no 604/2013 désignent comme responsable de l'examen de sa demande de protection internationale vers le territoire de l'État membre de relocalisation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
