                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a <w>sensation</w> of sherry at the bar.",
                            "target_lang_translations": {
                                "ru": "Он заказал <w>глоток</w> хереса в баре.",
                                "de": "Er bestellte einen <w>Schluck</w> Sherry an der Bar.",
                                "fr": "Il a commandé une <w>gorgée</w> de sherry au bar."
                            }
                        },
                        {
                            "text": "The old man asked for a <w>sensation</w> to warm his bones.",
                            "target_lang_translations": {
                                "ru": "Старик попросил <w>капельку</w>, чтобы согреть кости.",
                                "de": "Der alte Mann bat um ein <w>Gläschen</w>, um seine Knochen zu wärmen.",
                                "fr": "Le vieil homme a demandé un <w>petit verre</w> pour se réchauffer les os."
                            }
                        }
