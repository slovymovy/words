                        ]
                    },
                    {
                        "translation_id": "0af6c0f7-a2e7-403d-8795-8dba3fa48000",
                        "source_entry_id": "0fd82cfd-7ecf-3e6b-90a0-6e60f5b0d4f4",
                        "source_sense_id": "4c4d3bfb-3e11-31d7-9e48-8be5d49c12b1",
                        "source_sense_description": "bijzondere kennis of vaardigheid van iemand",
                        "target_lang_word": "spécialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spécialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4df6f606-beb4-3115-b95c-26551d08a979",
                                        "entry_id": "adfe1ee0-3187-3f6d-b600-d29fd7c45f08",
                                        "glosses": [
                                            "Caractère de ce qui est spécial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dd8d8d-e1db-4ae8-970c-a37da4205623",
                                                "sense_id": "4df6f606-beb4-3115-b95c-26551d08a979",
                                                "text": "Sans que la spécialité déroge à la généralité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d577179a-c07e-399b-8b6a-67059621f093",
                                        "entry_id": "adfe1ee0-3187-3f6d-b600-d29fd7c45f08",
                                        "glosses": [
                                            "Désignation d’une chose spéciale, en matière d’hypothèques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3814ee92-d095-37d5-a9df-ae4986510786",
                                        "entry_id": "adfe1ee0-3187-3f6d-b600-d29fd7c45f08",
                                        "glosses": [
                                            "Application exclusive d’un certain fonds à une nature particulière de dépense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d96322d-9511-451b-86e5-e8d89129403b",
                                                "sense_id": "3814ee92-d095-37d5-a9df-ae4986510786",
                                                "text": "On a dérogé à la spécialité, : on n’a pas appliqué le fonds à la dépense, suivant ce qui avait été prescrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c77295c-500b-3cd8-9017-41fdb236b9fd",
                                        "entry_id": "adfe1ee0-3187-3f6d-b600-d29fd7c45f08",
                                        "glosses": [
                                            "Branche d’études ou de travaux circonscrits auxquels se consacre une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca8ee4b-a2d5-4b6f-909e-2b9b1c03d462",
                                                "sense_id": "8c77295c-500b-3cd8-9017-41fdb236b9fd",
                                                "text": "Les opportunités pour les gériatres sont terribles ici. Cette spécialité est terriblement dévaluée. C'est très triste parce que je pensais vraiment, quand j'ai choisi la gériatrie, que c'était la spécialité du futur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a21fe3f-8dfd-384d-929d-483ff2c1f4ad",
                                        "entry_id": "adfe1ee0-3187-3f6d-b600-d29fd7c45f08",
                                        "glosses": [
                                            "Produit ou mets propre à une industrie, à une région, une entreprise, un restaurants, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8958ba4-ebac-471e-a089-ec39306626a4",
                                                "sense_id": "5a21fe3f-8dfd-384d-929d-483ff2c1f4ad",
                                                "text": "Te sachant gourmande, le gâteau basque à la crème et à la cerise, ainsi que le gâteau à la broche, font partie des spécialités régionales."
                                            },
                                            {
                                                "example_id": "6dccffc4-bff1-4b66-a3ea-05689f4a300c",
                                                "sense_id": "5a21fe3f-8dfd-384d-929d-483ff2c1f4ad",
                                                "text": "Un autre herbicide peut être utilisé sur liseron, il s’agit de la cyanatrine vendue sous le nom de Lisofix. Cette spécialité très peu phytotoxique s’utilise à 12,5 litres/hectare en deux fois […]"
                                            },
                                            {
                                                "example_id": "84228a2c-54ad-48c1-9479-e797373ca35c",
                                                "sense_id": "5a21fe3f-8dfd-384d-929d-483ff2c1f4ad",
                                                "text": "Quand à saint Hernin ou Thernen, il a pour spécialité de guérir des maux de tête. Sa fontaine — une antique divonne — est située sur le bord d'un chemin qui longe le cimetière."
                                            },
                                            {
                                                "example_id": "99198d3a-7861-42cf-9f2f-e2224f9e2d33",
                                                "sense_id": "5a21fe3f-8dfd-384d-929d-483ff2c1f4ad",
                                                "text": "Continuons avec les desserts : la spécialité du chef est le tube de chocolat et sa mousseline aux fraises, mais il y a aussi cet exquis Antillais (mousseline au chocolat, avec en son cœur, des bananes flambées)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
