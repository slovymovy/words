                "senses": [
                    {
                        "sense_id": "3b1f0ed2-fe2c-3b04-9c47-34aa1a58e9b1",
                        "entry_id": "23f885f6-317b-3d4a-b1bd-466c7d3334a0",
                        "glosses": [
                            "Très énervé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a93b86-fba8-4c1e-a008-5d902aca55eb",
                                "sense_id": "3b1f0ed2-fe2c-3b04-9c47-34aa1a58e9b1",
                                "text": "— Pascal, soupira Madeleine, laissez-moi, je vous en prie.\nÀ genoux, il la regarda un moment, les sens exaspérés."
                            },
                            {
                                "example_id": "af205aa3-b60d-479e-8a91-e88042e2ec24",
                                "sense_id": "3b1f0ed2-fe2c-3b04-9c47-34aa1a58e9b1",
                                "text": "À la fin exaspéré, pour lui prouver que mes intentions étaient pures, je lui fis offrir une somme ridiculement élevée pour monter seulement me parler cinq minutes dans ma chambre."
                            },
                            {
                                "example_id": "bf3cda6b-5785-4be1-90eb-a7326908e92a",
                                "sense_id": "3b1f0ed2-fe2c-3b04-9c47-34aa1a58e9b1",
                                "text": "La pluie mollissant un peu, l’atmosphère légèrement dégagée, nous voyons un torrent exaspéré, tout empanaché d’écume, débouliner de roc en roc et s’engouffrer avec un fracas de tonnerre sous la route, qui est ici un viaduc, en rejaillissant jusque sur les pieds des chevaux."
                            }
                        ]
                    }
