                "senses": [
                    {
                        "sense_id": "333caa12-9329-30fe-a781-6857fdc4c4aa",
                        "entry_id": "632b4514-f0ff-34d4-b4d7-d602df22b64b",
                        "glosses": [
                            "Synonyme de flexitarien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1805db90-9314-4a73-9a0d-11975d25a4c5",
                                "sense_id": "333caa12-9329-30fe-a781-6857fdc4c4aa",
                                "text": "Le flexitariste mange relativement peu de viande et de produits animaliers, mais il les choisit de qualité."
                            },
                            {
                                "example_id": "0c332c1e-7ae7-4bc9-b540-e3e1cb9ee4f6",
                                "sense_id": "333caa12-9329-30fe-a781-6857fdc4c4aa",
                                "text": "Le flexitariste suit principalement un régime alimentaire végétarien ou végétalien mais fait quelques exceptions parfois selon les occasions, en mangeant de la viande, du poisson ou autres produits dérivés des animaux comme les œufs."
                            },
                            {
                                "example_id": "eb3176ff-3fd7-4d8f-a33d-c553ad34eda3",
                                "sense_id": "333caa12-9329-30fe-a781-6857fdc4c4aa",
                                "text": "Oui à la viande, non aux conséquences sur l’environnement : les flexitaristes prônent la diversification alimentaire en consommant 80 % du temps des produits d’origine végétale et pour les 20 % restants : place à la viande."
                            }
                        ]
                    }
                ],
