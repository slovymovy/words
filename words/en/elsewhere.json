                    "sense_definition": "In, at, or to some other place.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you won’t serve us, we will simply go <w>elsewhere</w>.",
