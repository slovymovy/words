                "translations": [
                    {
                        "translation_id": "6d8623d9-4048-4552-b99b-cf46c3dd9802",
                        "source_entry_id": "4e477b74-13c4-396c-bb3c-68c97ddaacd4",
                        "source_sense_description": "обособиться от кого-либо",
                        "target_lang_word": "détacher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                        "entry_id": "feee837b-163a-3275-b378-6ba1dea02aba",
                                        "glosses": [
                                            "Débarrasser d’une tache, de taches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c758e24f-a58d-4df5-a267-a30dcaf70860",
                                                "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                                "text": "[…], Françoise savait faire une reprise, préparer le potage ou détacher un vêtement ; à sa façon de tenir un fer à repasser elle l'avait reconnue de bonne race."
                                            },
                                            {
                                                "example_id": "eb61e565-ec10-4cab-a52f-92d11cb26e9a",
                                                "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                                "text": "Détacher un habit. Substance qui sert à détacher. Savon à détacher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Dégager une personne ou une chose de ce qui l’attachait, de ce qui la retenait, de l’objet auquel elle était attachée, fixée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb4adddc-6f8d-46d2-af77-344d4f051cad",
                                                "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                                "text": "Détacher un chien. Détacher une tapisserie, un tableau. Détacher une barque du rivage."
                                            },
                                            {
                                                "example_id": "86bb6f52-7b25-4f84-a697-a87fb412757c",
                                                "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                                "text": "Détacher un fruit de l’arbre. Un créneau qui commence à se détacher de la muraille. Un bloc énorme se détache de la montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e26a0ae-a126-3e1a-b2cf-ded7bed646dc",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Ôter, défaire ce qui sert à attacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12648968-8cd2-4126-89f1-bb53e6a90f17",
                                                "sense_id": "1e26a0ae-a126-3e1a-b2cf-ded7bed646dc",
                                                "text": "Détacher une épingle. Détacher une agrafe. Détacher un ruban, une jarretière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6632c592-53d8-3e4e-a487-cca1f28a6085",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Tenir écarté de."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851afa23-38c5-42d2-8379-f0d8c910dbc1",
                                                "sense_id": "6632c592-53d8-3e4e-a487-cca1f28a6085",
                                                "text": "L’Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour \"monachiser\" ses clercs séculiers et les détacher de la femme tentatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a771cbd-3e8e-3eae-a3a1-40ec83d88e26",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Rendre distinct, isolé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425e9d20-f019-48c4-be69-594d26eac8ac",
                                                "sense_id": "4a771cbd-3e8e-3eae-a3a1-40ec83d88e26",
                                                "text": "Détacher les notes du texte par un filet. Ce titre ne se détache pas assez du texte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Faire apercevoir et ressortir les contours d’un objet, lui donner de la saillie par le contraste de sa couleur avec celle du fond, ou par quelque autre moyen."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6e0bbe-fa58-4124-af6c-61aab7e6771a",
                                                "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                                "text": "Il n’y a personne à voir ; chez ma grand’tante, où je demeure, je n’ai encore vu que quelques marins se détachant sur un fond de douairières, et quelles douairières ! d’avant la Révolution !"
                                            },
                                            {
                                                "example_id": "dfbd54f4-4c1c-4f63-9a29-0ba08ed7c07c",
                                                "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. […]. L’hiver, lorsque la neige a cessé de tomber depuis quelques jours, lorsque l’armée des sapins noirs immobiles se détache sur le sol blanc, le voyageur solitaire doit se défendre contre un sentiment de crainte, presque d’angoisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Séparer d’avec ce qui est joint et fait en quelque sorte un même corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3a4ce8-649f-4cc7-92d3-9555a4b260c0",
                                                "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                                "text": "Le ressort du diocèse de Tournay s'étend sur quelques parties de territoire réunies à la France et détachées des communes de Lamain, Templeuve et Bailièvre."
                                            },
                                            {
                                                "example_id": "a9b5287e-3fbe-4f81-96a9-08a0d8aae215",
                                                "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                                "text": "Détacher un pré, une vigne d’une ferme. Cette administration a été réunie au ministère dont on l’avait autrefois détachée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Tirer une troupe d’un corps d’armée, des soldats d’un régiment, d’une compagnie, etc., pour un service particulier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05eb4f79-c0ea-45f5-8ed4-325f79935ba6",
                                                "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                                "text": "Au mois de juillet 1641, raconte Dom Grenier, la garnison de Péronne détacha une douzaine de cavaliers sur Allaines pour y faire des prisonniers et du butin. Ils pénétrèrent à l’improviste dans les basses-cours et s'emparèrent de tous les porcs qu'ils purent y rencontrer."
                                            },
                                            {
                                                "example_id": "612b768d-4bd4-4aa3-8046-690cc65449cd",
                                                "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                                "text": "On détacha de la flotte deux bâtiments légers, qui prirent les devants. Trois vaisseaux se détachèrent de la flotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "753ff59f-acdb-3a8d-b7e1-b6962e261e8a",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Déterminer une personne à quitter ses engagements, ses occupations, ses passions, ses affections, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "550753f8-df16-4b39-9f45-55f94fa06e50",
                                                "sense_id": "753ff59f-acdb-3a8d-b7e1-b6962e261e8a",
                                                "text": "Détacher quelqu’un d’un parti, d’une alliance. Il s’est détaché de la passion qu’il avait. Il s’est détaché peu à peu de cette femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "511bc754-e89d-46a5-a774-97802d49dc54",
                        "source_entry_id": "4e477b74-13c4-396c-bb3c-68c97ddaacd4",
                        "source_sense_description": "избавиться от чего-либо",
                        "target_lang_word": "renoncer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renoncer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79b89f3f-9060-33a9-b136-2762b1894f16",
                                        "entry_id": "dda45dfa-74f4-3bd9-82a7-35ff97fa3916",
                                        "glosses": [
                                            "Se désister de quelque chose, soit par acte exprès, soit autrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdcf9f6b-efa1-40d2-9abf-ddea71ef63ca",
                                                "sense_id": "79b89f3f-9060-33a9-b136-2762b1894f16",
                                                "text": "Il y a longtemps que je le dis : le libéralisme ne nous livrera plus de bataille rangée ; il a renoncé aux conspirations, au carbonarisme, aux prises d’armes, il mine en dessous et se prépare à un complet Ôte-toi de là que je m’y mette !"
                                            },
                                            {
                                                "example_id": "d815bb88-6623-4594-8529-d593121169f1",
                                                "sense_id": "79b89f3f-9060-33a9-b136-2762b1894f16",
                                                "text": "Si néanmoins les enfans trouvent , que la communauté ne leur soit pas avantageuse , ils y peuvent renoncer , comme le peuvent leurs heritiers en cas de décès."
                                            },
                                            {
                                                "example_id": "a4001803-d7ab-4c77-ba16-7fcfca5a5c6d",
                                                "sense_id": "79b89f3f-9060-33a9-b136-2762b1894f16",
                                                "text": "Blessée, la Finistérienne Maëva Squiban (Stade Rochelais) doit également renoncer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                        "entry_id": "dda45dfa-74f4-3bd9-82a7-35ff97fa3916",
                                        "glosses": [
                                            "Quitter, abandonner la possession, le désir de quelque chose, l’attachement à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78bda1b-6ecd-42e1-8ac2-ec03e7988d76",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "Mais le frère Brian est entré dans notre ordre par caprice et désappointement, entraîné, je n’en doute pas, à prononcer nos vœux et à renoncer au monde, non par la sincérité d’une vocation sincère, mais comme un homme qu’un mécontentement léger aurait poussé vers la pénitence."
                                            },
                                            {
                                                "example_id": "4aa840d0-e537-4681-87ba-5c4daf8b8246",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "Après la chute tragique des combattants qui avaient cherché à s’éperonner, on renonça de part et d’autre à cette dangereuse offensive, et Bert ne distingua plus aucune tentative d’abordage."
                                            },
                                            {
                                                "example_id": "89c37d2a-897d-4eaa-b398-6f6ff1ad0b62",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "Ce n’est pas par lâcheté, c’est par une immense modestie que l’on renonce ce soir à la guerre, au carnage, à sa mort, à la mort surtout des autres, des camarades."
                                            },
                                            {
                                                "example_id": "7f7a9b77-0b55-4daf-a3f8-cf64e62b2d2c",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "Un corbeau déjà dressé et comment (il buvait du vin), avait jugé bon néanmoins de renoncer aux bienfaits de la civilisation et de reprendre la clé des bois."
                                            },
                                            {
                                                "example_id": "4c05b3fd-94c3-474d-a83f-3df694bdc54c",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "En effet, le cadavre était froid. L’homme essaya de le soulever : la rigidité, la lourdeur des membres le firent renoncer à son projet."
                                            },
                                            {
                                                "example_id": "9b0f1448-4ff4-41f6-9d18-7443a7f03b96",
                                                "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                                                "text": "On ne renonce pas petit à petit à quoi que ce soit. Mark Twain disait : « Rien de plus facile que de renoncer au tabac. J’y renonce tous les matins »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f645163c-3123-39e7-b8c8-8ad39a19649f",
                                        "entry_id": "dda45dfa-74f4-3bd9-82a7-35ff97fa3916",
                                        "glosses": [
                                            "Se dépouiller de tout amour-propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffebeaaa-949f-492f-b70a-6790d58cf4a5",
                                                "sense_id": "f645163c-3123-39e7-b8c8-8ad39a19649f",
                                                "text": "Renoncer à soi-même, ce n'est pas se détruire, c'est donner et se donner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56515fbe-6bad-3424-af82-678967a9aac2",
                                        "entry_id": "dda45dfa-74f4-3bd9-82a7-35ff97fa3916",
                                        "glosses": [
                                            "Mettre une carte d’une autre couleur que celle qui est jouée, soit qu’on ait de cette dernière, soit qu’on n’en ait pas."
                                        ],
                                        "tags": [
                                            "Jeu de carte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a13e93-ffea-4d5f-92b1-7e56de0f7372",
                                                "sense_id": "56515fbe-6bad-3424-af82-678967a9aac2",
                                                "text": "Renoncer à trèfle."
                                            },
                                            {
                                                "example_id": "90d2e2af-a193-41c9-87ef-58b375cf934a",
                                                "sense_id": "56515fbe-6bad-3424-af82-678967a9aac2",
                                                "text": "Renoncer à pique."
                                            },
                                            {
                                                "example_id": "91334a30-84c8-4127-822c-ad98be43f08e",
                                                "sense_id": "56515fbe-6bad-3424-af82-678967a9aac2",
                                                "text": "On joue pique et vous jouez trèfle : vous renoncez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24fbc0b7-1a66-3306-86a9-05fbbd2f9e0b",
                                        "entry_id": "dda45dfa-74f4-3bd9-82a7-35ff97fa3916",
                                        "glosses": [
                                            "Renier, désavouer, ne vouloir plus reconnaître quelqu’un pour ce qu’il est ou pour ce qu’on le croyait."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a67fea-3db8-41b5-b59f-96fae1ad6486",
                                                "sense_id": "24fbc0b7-1a66-3306-86a9-05fbbd2f9e0b",
                                                "text": "Avant que le coq chante, tu me renonceras trois fois."
                                            },
                                            {
                                                "example_id": "27d345ab-6871-48a2-8a15-ffb2fa9dd72d",
                                                "sense_id": "24fbc0b7-1a66-3306-86a9-05fbbd2f9e0b",
                                                "text": "S’il fait telle chose, je le renonce pour mon parent."
                                            },
                                            {
                                                "example_id": "7d3d33cb-e383-4551-9e35-d5013878a353",
                                                "sense_id": "24fbc0b7-1a66-3306-86a9-05fbbd2f9e0b",
                                                "text": "L’on dirait étrangement que le critique a, de nos jours, renoncé son privilège, et quitté, sur les Lettres, tout droit de regard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
