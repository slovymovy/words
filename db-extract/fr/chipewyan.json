                ],
                "senses": [
                    {
                        "sense_id": "2d3c3804-2e27-3c33-a6f5-7c014644de95",
                        "entry_id": "83ee73f3-adf8-3fa2-918c-d21baec19288",
                        "glosses": [
                            "Membre du peuple autochtone du Canada, parlant traditionnellement le chipewyan et vivant dans les régions subarctiques à l’ouest de la baie d’Hudson, au Manitoba, le nord de la Saskatchewan et de l’Alberta, les Territoires du Nord-Ouest et le Nunavut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "195d6725-7f5d-48d7-a479-bfecf2ef3a52",
                                "sense_id": "2d3c3804-2e27-3c33-a6f5-7c014644de95",
                                "text": "Le Conseil tribal d'Athabasca (CTA) réunit cinq Premières Nations du nord de l'Alberta, soit les Chipewyans d'Athabasca, les Chipewyans des Prairies, la Première Nation 468 de Fort McMurray, la Première Nation crie Mikisew et celle de Fort McKay."
                            },
                            {
                                "example_id": "8aded3e1-b74d-4474-a906-634543d046f8",
                                "sense_id": "2d3c3804-2e27-3c33-a6f5-7c014644de95",
                                "text": "Il ajoute que le résultat indiquait une ascendance substantielle des Amériques, soit de l’Amérique du Nord, de l’Amérique du Sud et de l’Amérique centrale. Les populations de référence incluent les Cris, les Raramuris, les Pimas, les Mayas, les Chanes, les Karitianas, les Chipewyans ainsi que huit autres groupes."
                            }
                        ]
                    }
