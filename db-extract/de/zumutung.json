                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наглость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "872daf33-5f5b-36c6-87e3-744ec722edad",
                                        "entry_id": "4cbbae18-1d32-311a-b1b7-2d27b3664802",
                                        "glosses": [
                                            "свойство по значению прилагательного наглый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e17438d-8529-4930-b2ae-7fdc374bb748",
                                                "sense_id": "872daf33-5f5b-36c6-87e3-744ec722edad",
                                                "text": "Наглость – это что-то вроде бесстыдства и дерзкого самоуверенного нахальства, которое граничит с хамством"
                                            },
                                            {
                                                "example_id": "e46e3c97-809a-4aa1-bb5a-ebb3b0db280f",
                                                "sense_id": "872daf33-5f5b-36c6-87e3-744ec722edad",
                                                "text": "Наглость и неуверенность в себе как две полярности"
                                            },
                                            {
                                                "example_id": "47221f8f-af2c-44d4-8b3e-b58d90e3d168",
                                                "sense_id": "872daf33-5f5b-36c6-87e3-744ec722edad",
                                                "text": "Неведение — это первое счастье. А вот за второе место постоянно происходит жесткая конкурентная борьба между наглостью, хитростью и беспринципностью"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7049b23a-435c-382b-98b0-f3a6552ab437",
                                        "entry_id": "4cbbae18-1d32-311a-b1b7-2d27b3664802",
                                        "glosses": [
                                            "наглый поступок, наглое поведение, высказывание и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c408b9-728a-4ab3-865d-92b985f7d23d",
                                                "sense_id": "7049b23a-435c-382b-98b0-f3a6552ab437",
                                                "text": "прикиньте какая наглость вчера приключилась со мной"
                                            },
                                            {
                                                "example_id": "70f13929-ae19-49ec-9ab5-758a299005d9",
                                                "sense_id": "7049b23a-435c-382b-98b0-f3a6552ab437",
                                                "text": "Не сказала б, что это была наглость со стороны Тамары"
                                            },
                                            {
                                                "example_id": "7b09440c-996c-4c42-85f6-86a37f8febb6",
                                                "sense_id": "7049b23a-435c-382b-98b0-f3a6552ab437",
                                                "text": "какая \"наглость\" спорить со старшими"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf093460-4523-4747-a93f-eabdc383969b",
                        "source_entry_id": "0f127d25-9d42-310b-9bb5-dd10dedb616a",
                        "source_sense_id": "45fe699b-e751-3772-aea5-299a040c4473",
                        "source_sense_description": "Frechheit, Respektlosigkeit, inakzeptables Verhalten oder Ergebnis",
