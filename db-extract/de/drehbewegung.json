                        ],
                        "form": "die Drehbewegungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                        "entry_id": "bf94a9ed-ffa0-3773-807d-5952c6557e40",
                        "glosses": [
                            "Bewegung eines Punktes oder Körpers um eine Rotationsachse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2008deee-9641-4379-8c86-a7de27b8e0c1",
                                "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                                "text": "„Die angesaugte Luft wird in einer oder mehreren Stufen in eine Drehbewegung versetzt und beschleunigt, durch die Zentrifugalkraft wandert der Staub nach außen und von dort in einen Auffangbehälter.“"
                            },
                            {
                                "example_id": "aa2e81c9-20c5-42c8-8900-c68ea6064c49",
                                "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                                "text": "„Er umfasst den ersten Griff, setzt beide Füße an die Wand, holt mit einer Drehbewegung des Körpers Schwung, springt zur nächsten Leiste und hangelt sich scheinbar mühelos zum höchsten Griff.“"
                            },
                            {
                                "example_id": "3b8aad07-6305-473d-bf9f-cd54f3132daf",
                                "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                                "text": "„Wegen ihres lädierten Knies entfalle jede Art von Drehbewegung und Gewichtsbelastung der Beine.“"
                            },
                            {
                                "example_id": "946c39ef-f9a2-4f88-9853-3638ed84b8bf",
                                "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                                "text": "„Die Drehbewegung soll für Durchlüftung sorgen und die Feuchtigkeit verteilen.“"
                            },
                            {
                                "example_id": "ac4731fd-276d-44d5-b08a-528e01b47f16",
                                "sense_id": "86338c31-671b-3c0b-a988-6ae670373a34",
                                "text": "„Wenn das Spermium Kurs auf das Ei nimmt, treibt es die Drehbewegung der peitschenähnlichen Verlängerung am Hinterende an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
