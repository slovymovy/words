{
    "word_family": [
        "tender",
        "tenderly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                    "sense_definition": "Gentleness, affection, and kindness shown towards someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke to the frightened child with great <w>tenderness</w>.",
                            "target_lang_translations": {
                                "tr": "Korkmuş çocukla büyük bir <w>şefkatle</w> konuştu."
                            }
                        },
                        {
                            "text": "Their cold indifference eventually gave way to love and <w>tenderness</w>.",
                            "target_lang_translations": {
                                "tr": "Soğuk kayıtsızlıkları sonunda yerini sevgi ve <w>sevecenliğe</w> bıraktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "affection",
                        "gentleness",
                        "warmth"
                    ],
                    "antonyms": [
                        "harshness",
                        "coldness"
                    ],
                    "common_phrases": [
                        "love and tenderness",
                        "great tenderness"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine karşı gösterilen nezaket, şefkat ve sevgi dolu tutum."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şefkat",
                                "target_lang_sense_clarification": "sevgi ve merhamet duygusu"
                            },
                            {
                                "target_lang_word": "sevecenlik",
                                "target_lang_sense_clarification": "cana yakın ve nazik olma durumu"
                            },
                            {
                                "target_lang_word": "hassasiyet",
                                "target_lang_sense_clarification": "duygusal duyarlılık veya incelik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                    "sense_definition": "Warm concern or sympathy for the feelings and well-being of others.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When they saw the suffering victims, they were filled with <w>tenderness</w> for them.",
                            "target_lang_translations": {
                                "tr": "Acı çeken kurbanları gördüklerinde, onlara karşı içleri <w>merhametle</w> doldu."
                            }
                        },
                        {
                            "text": "He felt a sudden rush of <w>tenderness</w> toward his aging parents.",
                            "target_lang_translations": {
                                "tr": "Yaşlanan ebeveynlerine karşı aniden yoğun bir <w>şefkat</w> hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "compassion",
                        "sympathy"
                    ],
                    "antonyms": [
                        "indifference",
                        "callousness"
                    ],
                    "common_phrases": [
                        "tenderness for"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarının hislerine ve esenliğine karşı duyulan içten kaygı veya merhamet."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "merhamet",
                                "target_lang_sense_clarification": "acıma ve şefkat gösterme"
                            },
                            {
                                "target_lang_word": "şefkat",
                                "target_lang_sense_clarification": "başkalarını düşünme ve koruyuculuk hissi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                    "sense_definition": "Physical pain, soreness, or sensitivity when an injured or affected part of the body is touched.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor checked for abdominal <w>tenderness</w> during the physical examination.",
                            "target_lang_translations": {
                                "tr": "Doktor, fiziksel muayene sırasında karında <w>hassasiyet</w> olup olmadığını kontrol etti."
                            }
                        },
                        {
                            "text": "He experienced extreme <w>tenderness</w> whenever pressure was applied to the bruise.",
                            "target_lang_translations": {
                                "tr": "Morluğa her baskı uygulandığında aşırı <w>hassasiyet</w> hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "soreness",
                        "sensitivity"
                    ],
                    "common_phrases": [
                        "abdominal tenderness",
                        "extreme tenderness"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vücudun yaralı veya rahatsız bir bölgesine dokunulduğunda hissedilen acı, ağrı veya duyarlılık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hassasiyet",
                                "target_lang_sense_clarification": "dokunmayla artan fiziksel duyarlılık"
                            },
                            {
                                "target_lang_word": "duyarlılık",
                                "target_lang_sense_clarification": "dokunmaya karşı aşırı tepki"
                            },
                            {
                                "target_lang_word": "acı",
                                "target_lang_sense_clarification": "baskı uygulandığında duyulan sızı veya ağrı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}