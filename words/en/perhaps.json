                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Perhaps</w> John will come over for dinner.",
                            "target_lang_translations": {
                                "ru": "<w>Возможно</w>, Джон зайдёт на ужин.",
                                "nl": "<w>Misschien</w> komt John eten.",
                                "pl": "<w>Być może</w> John wpadnie na kolację.",
                                "de": "<w>Vielleicht</w> kommt John zum Abendessen vorbei.",
                                "fr": "<w>Peut-être</w> que John viendra dîner.",
                                "it": "<w>Forse</w> John verrà a cena.",
                                "cs": "<w>Možná</w> John přijde na večeři.",
                                "tr": "<w>Belki</w> John akşam yemeğine gelir.",
                                "es": "<w>Tal vez</w> John venga a cenar.",
                                "zh": "<w>也许</w>约翰会过来吃晚饭。"
                            }
                        },
                        {
                            "text": "He was seriously wounded, <w>perhaps</w> fatally.",
                            "target_lang_translations": {
                                "ru": "Он был серьёзно ранен, <w>возможно</w>, смертельно.",
                                "nl": "Hij was ernstig gewond, <w>wellicht</w> dodelijk.",
                                "pl": "Był poważnie ranny, <w>być może</w> śmiertelnie.",
                                "de": "Er war schwer verwundet, <w>vielleicht</w> tödlich.",
                                "fr": "Il a été grièvement blessé, <w>peut-être</w> mortellement.",
                                "it": "Era ferito gravemente, <w>forse</w> mortalmente.",
                                "cs": "Byl vážně zraněn, <w>možná</w> smrtelně.",
                                "tr": "Ağır yaralanmıştı, <w>belki de</w> ölümcül şekilde.",
                                "es": "Estaba gravemente herido, <w>quizás</w> de muerte.",
                                "zh": "他受了重伤，<w>可能</w>是致命伤。"
                            }
                        },
                        {
                            "text": "<w>Perhaps</w> it will rain later this afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Может быть</w>, сегодня днём пойдёт дождь.",
                                "nl": "<w>Misschien</w> gaat het later vanmiddag regenen.",
                                "pl": "<w>Może</w> później po południu będzie padać.",
                                "de": "<w>Vielleicht</w> regnet es heute Nachmittag noch.",
                                "fr": "Il va <w>peut-être</w> pleuvoir plus tard cet après-midi.",
                                "it": "<w>Forse</w> pioverà più tardi questo pomeriggio.",
                                "cs": "<w>Snad</w> bude později odpoledne pršet.",
                                "tr": "<w>Belki</w> öğleden sonra yağmur yağar.",
                                "es": "<w>Quizá</w> llueva más tarde esta tarde.",
                                "zh": "<w>可能</w>今天下午晚些时候会下雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maybe",
                        "possibly"
                    ],
                    "common_phrases": [
                        "perhaps not",
                        "perhaps so"
