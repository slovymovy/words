                                ]
                            },
                            {
                                "target_word": "bleach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce25905f-1ee6-3b2e-b58d-ecf1435e1d44",
                                        "entry_id": "b47b6f30-a64a-3e99-bf12-0d8f9ea2d5d7",
                                        "glosses": [
                                            "To treat with bleach, especially so as to whiten (fabric, paper, etc.) or lighten (hair)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf49c9d0-d9e7-4d66-a775-2563edd84ecd",
                                                "sense_id": "ce25905f-1ee6-3b2e-b58d-ecf1435e1d44",
                                                "text": "Candifacio, to make whyte, to bleache, to make to glowe lyke a burnyng cole."
                                            },
                                            {
                                                "example_id": "b1699d2e-fbf4-4347-a79c-6806e1408f31",
                                                "sense_id": "ce25905f-1ee6-3b2e-b58d-ecf1435e1d44",
                                                "text": "The destruction of the colouring matters attached to the bodies to be bleached is effected either by the action of the air and light, of chlorine, or of sulphurous acid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e42c12-a738-3745-837a-0ea7dd318183",
                                        "entry_id": "b47b6f30-a64a-3e99-bf12-0d8f9ea2d5d7",
                                        "glosses": [
                                            "To be whitened or lightened (by the sun, for example)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f254218-8aaf-4984-9498-1bf7e8b0b9c7",
                                                "sense_id": "a6e42c12-a738-3745-837a-0ea7dd318183",
                                                "text": "The white sheet bleaching on the hedge,\nWith heigh! the sweet birds, O, how they sing!"
                                            },
                                            {
                                                "example_id": "7b0f75db-fc91-4747-8f47-39b638d0461b",
                                                "sense_id": "a6e42c12-a738-3745-837a-0ea7dd318183",
                                                "text": "[…] when Mrs. Giddy-gaddy came to take out her clothes, deep green stains appeared on every thing, for she had forgotten the green silk lining of a certain cape, and its color had soaked nicely into the pink and blue gowns, the little chemises, and even the best ruffled petticoat. […] “Lay them on the grass to bleach,” said Daisy, with an air of experience."
                                            },
                                            {
                                                "example_id": "cea5f660-9a0a-4617-8fe6-d473812e498e",
                                                "sense_id": "a6e42c12-a738-3745-837a-0ea7dd318183",
                                                "text": "The autumn trees, ravaged as they are, take on the flash of tattered flags kindling in the gloom of cool cathedral caves where gold letters on marble pages describe death in battle and how bones bleach and burn far away in Indian sands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffbae144-d63c-37f1-82c9-120ffa4c50e9",
                                        "entry_id": "b47b6f30-a64a-3e99-bf12-0d8f9ea2d5d7",
                                        "glosses": [
                                            "To lose color due to stress-induced expulsion of symbiotic unicellular algae."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf6c4be3-0f71-4196-acc1-145dea44909c",
                                                "sense_id": "ffbae144-d63c-37f1-82c9-120ffa4c50e9",
                                                "text": "Once coral bleaching begins, corals tend to continue to bleach even if the stressor is removed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33db1db5-8abf-36af-9624-611952b862b6",
                                        "entry_id": "b47b6f30-a64a-3e99-bf12-0d8f9ea2d5d7",
                                        "glosses": [
                                            "To make meaningless; to divest of meaning; to make empty."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ed44f7-c8df-479a-895c-a1174eb1a52b",
                                                "sense_id": "33db1db5-8abf-36af-9624-611952b862b6",
                                                "text": "semantically bleached words that have become illocutionary particles"
                                            }
                                        ]
                                    }
                                ]
                            },
