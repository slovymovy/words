                        "glosses": [
                            "Que l'on peut ouïr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f12788e-6438-4117-8c74-227d1c68db55",
                                "sense_id": "ae961b0b-fa82-353a-afb7-7656dd5b77f4",
                                "text": "Sire Dieu, piteux et oyable, nous requérons suppliant ta débonnaireté que tu par les mérites et intercessions de la benoite Vierge Marie... il te plaise de donner débonnaireté à nous ici et en tous lieux ton saint ange, garde et défense, charité mutuelle à ceux qui sont en désaccord, aux féalx (fidèles) vraie foi, et aux féalx trépassés vie et repos perdurable, tu qui règnes avec Dieu le Père et le Fils et le Saint-Esprit aux siècles des siècles."
                            },
                            {
                                "example_id": "9a8c5032-1c20-4227-8e6f-22aadee8631a",
                                "sense_id": "ae961b0b-fa82-353a-afb7-7656dd5b77f4",
                                "text": "Je crie mais ne suis point oyable : seriez-vous sourds ?"
                            },
                            {
                                "example_id": "2b1ad7e0-adc0-4228-9688-411713120a43",
                                "sense_id": "ae961b0b-fa82-353a-afb7-7656dd5b77f4",
                                "text": "Les deux sens premiers conçoivent les choses qui sont ou visibles ou oyables."
                            }
                        ]
                    }
