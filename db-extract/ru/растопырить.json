                                    {
                                        "sense_id": "298dcd35-8ae4-3d20-a33c-0479520160b5",
                                        "entry_id": "87ae11fe-1869-3d08-a072-4d992e72e4c9",
                                        "glosses": [
                                            "Remover la tapa o la cubierta de algo, haciéndolo visible."
                                        ],
                                        "tags": [],
