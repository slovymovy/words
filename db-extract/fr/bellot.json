                        "examples": [
                            {
                                "example_id": "cd9066af-579d-4d19-a049-4adac8dad606",
                                "sense_id": "cc3950e5-bbb8-3c0c-a6c9-cad092786b8e",
                                "text": "Mon petit bellot. Ma petite bellotte."
                            },
                            {
                                "example_id": "14984b4b-aefb-48df-9781-f462222348f0",
                                "sense_id": "cc3950e5-bbb8-3c0c-a6c9-cad092786b8e",
                                "text": "— Oh ! notre petite bellote sera chez elle, répondit madame Marneffe en sonnant Reine pour faire demander madame Olivier."
                            },
                            {
                                "example_id": "bff3b1c6-fa17-4b37-88a1-aa03c8b933a0",
                                "sense_id": "cc3950e5-bbb8-3c0c-a6c9-cad092786b8e",
                                "text": "12 décembre 44 – Tout cela pour dire, bellotte au cœur d’hétaïre et au corps de nonne, que Bruno vient me voir ce soir et m’emmène dîner, si possum. Je lui ai dit que peut-être non possum."
                            }
                        ]
                    }
