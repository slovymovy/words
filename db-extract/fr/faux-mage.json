                ],
                "senses": [
                    {
                        "sense_id": "a53ff2d6-8c54-31d5-8861-bff6aea133f2",
                        "entry_id": "35011604-e8a6-36c3-8d5f-d3b55fbb4990",
                        "glosses": [
                            "Fromage végétal, habituellement élaboré à base d’oléagineux ou de graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38598c58-374d-4bc6-9d0a-25ed174590e5",
                                "sense_id": "a53ff2d6-8c54-31d5-8861-bff6aea133f2",
                                "text": "Il existe de nombreux substituts aux fromages laitiers. Ils sont parfois appelés « faux-mage ». Je vous laisse découvrir ça en cherchant soit « fromage végane » soit « faux-mage ». Il s'agit de « fromages » à base de laits végétaux ou d'oléagineux."
                            },
                            {
                                "example_id": "8ed848b6-3abc-405c-b8b8-b18ea564b5f5",
                                "sense_id": "a53ff2d6-8c54-31d5-8861-bff6aea133f2",
                                "text": "Démoulez le faux-mage, retirez la gaze, puis saupoudrez de paprika et de poivre avant de servir."
                            },
                            {
                                "example_id": "d8289ebc-c9cf-4ab1-a824-605d616ec524",
                                "sense_id": "a53ff2d6-8c54-31d5-8861-bff6aea133f2",
                                "text": "Il est également possible de fabriquer des « faux-mages » maison !\nLa recette de base inclus généralement des noix de cajou : mixées, elle donne un goût assez typé et une texture crémeuse."
                            }
                        ]
                    }
