                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1d37cdb0-5d3f-3eb6-94b5-d1a1c261b8fc",
                                        "entry_id": "978095ad-ea6d-37c0-9fc4-58a439a24d55",
                                        "glosses": [
                                            "graag avonturen willend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8777b7f9-1792-43a6-bd15-54cba6bf1504",
                                                "sense_id": "1d37cdb0-5d3f-3eb6-94b5-d1a1c261b8fc",
                                                "text": "Jij bent echt een avontuurlijk persoon!"
                                            },
                                            {
                                                "example_id": "6e59d43e-b01f-4b5b-9c73-484b5da2520b",
                                                "sense_id": "1d37cdb0-5d3f-3eb6-94b5-d1a1c261b8fc",
                                                "text": "Tatertot was een prachtige vrouw van in de dertig die bij de start van haar PCT haar hoofd tegen de hitte had kaalgeschoren. Ze hield van extremen, een avontuurlijke levensgenieter die altijd leven in de brouwerij bracht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae51bff3-0351-3c7a-bd07-c5c1eb45f3d3",
                                        "entry_id": "978095ad-ea6d-37c0-9fc4-58a439a24d55",
                                        "glosses": [
                                            "veel onverwachte en spannende situaties opleverend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f4fd53-9286-4be9-ae4e-04e072169d4e",
                                                "sense_id": "ae51bff3-0351-3c7a-bd07-c5c1eb45f3d3",
                                                "text": "Dit is wel een heel avontuurlijke onderneming geworden ..."
                                            },
                                            {
                                                "example_id": "c72d0352-ffed-4e25-97d6-0cab95c7c36e",
                                                "sense_id": "ae51bff3-0351-3c7a-bd07-c5c1eb45f3d3",
                                                "text": "Deze geheel verzorgde vakantie kun je moeilijk avontuurlijk noemen."
                                            },
                                            {
                                                "example_id": "1faf1f8d-559a-47dd-bef2-50dc3b2fd4bc",
                                                "sense_id": "ae51bff3-0351-3c7a-bd07-c5c1eb45f3d3",
                                                "text": "Everts woonde begin dit jaar nog in Tokio waar ze meehielp aan de watervoorzieningen rondom alle Olympische locaties. Een avontuurlijke baan in een dynamische stad die geen uit-knop lijkt te hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177dd852-01ef-3ec3-b3aa-4bee1ae71ae7",
                                        "entry_id": "978095ad-ea6d-37c0-9fc4-58a439a24d55",
                                        "glosses": [
                                            "met weinig zekerheid, gevaarlijk, riskant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85294ff-a3bf-42c7-8a87-5aa98bf06184",
                                                "sense_id": "177dd852-01ef-3ec3-b3aa-4bee1ae71ae7",
                                                "text": "Omdat de staat een huurregeling had ingevoerd, was woningbouw onder eigen hoede avontuurlijk in de zin dat de rentabiliteit op de lange duur in de vorm van verwachte huuropbrengsten er niet gunstig uitzag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1a0bb69-1716-4324-9600-38ad1aad9f61",
                        "source_entry_id": "67b28a1e-3e85-3b37-8aea-3703cc7a9929",
                        "source_sense_id": "70a01544-2bbb-3ac9-bb37-71a1fc1e50df",
                        "source_sense_description": "adventurous",
                        "target_lang_word": "truculent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truculent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "405642e7-fae5-3d0f-abd0-f06e0d0442eb",
                                        "entry_id": "b842d660-0814-3dc1-969f-b5be609dda18",
                                        "glosses": [
                                            "Qui est violent ou excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132be0a9-aeb1-4427-99e4-b0d0a289c9bb",
                                                "sense_id": "405642e7-fae5-3d0f-abd0-f06e0d0442eb",
                                                "text": "Hélas ! je n’osais m’en plaindre, puisque ma fonction lamentable est d’être toujours truculent et de ne jamais rater mon diogénique personnage."
                                            },
                                            {
                                                "example_id": "2332d66c-73c7-4eb6-9b8a-dabfc46d27d9",
                                                "sense_id": "405642e7-fae5-3d0f-abd0-f06e0d0442eb",
                                                "text": "Je me souviens qu’elle me présenta une fois à un apoplectique et truculent gentleman, couvert d’ordres et de rubans, et sur lui me souffla à l’oreille, sur un mode tragique, les plus abasourdissants détails, qui durent être perçus de chaque personne alors dans le salon."
                                            },
                                            {
                                                "example_id": "4f9b9340-89dc-43fc-bf9b-4dfafbc3e467",
                                                "sense_id": "405642e7-fae5-3d0f-abd0-f06e0d0442eb",
                                                "text": "Calvin est aussi ennemi du style désordonné que du style superficiel. Le désordre peut se remarquer de diverses manières. Il peut être d'abord une exagération dans un sens déterminé, et nous avons le style truculent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247306df-7c6f-3767-8711-51c394d34528",
                                        "entry_id": "b842d660-0814-3dc1-969f-b5be609dda18",
                                        "glosses": [
                                            "Qui est pittoresque ou haut en couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b69541d7-6aad-4b14-86ad-ff0f4b0be4b0",
                                                "sense_id": "247306df-7c6f-3767-8711-51c394d34528",
                                                "text": "[…] ; l'autre, son barda sur l'épaule, les chausses lui dégringolant le long des jambes, la tête rejetée en arrière et s'envoyant un jet de sa gourde dans le gosier, a l'allure épaisse et la trogne truculente d'un rustaud des Flandres."
                                            },
                                            {
                                                "example_id": "8bcc7682-d3d7-450a-817d-3f83d2fcd6bb",
                                                "sense_id": "247306df-7c6f-3767-8711-51c394d34528",
                                                "text": "Ces cinq nouvelles poursuivent l'investigation des comportements amoureux et, hormis « La Baronne » et son personnage truculent de prostituée de haut vol, les personnages masculins occupent le devant de la scène narrative dans quatre des cinq contes ajoutés à ceux du Nouveau Décaméron."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
