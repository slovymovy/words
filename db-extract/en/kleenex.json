                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a224df00-a8f8-4d69-8b7b-e61c266e8392",
                                                "sense_id": "95284154-ef14-3d99-a556-216f53d6b2a3",
                                                "text": "Sur un Kleenex j’ai capté une odeur sucrée, médicamenteuse, qui m’a rappelé les inhalations que me faisait subir ma mère lorsque j’étais enrhumée, tête recouverte par une serviette, penchée au-dessus d’une bassine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d67b5d-ba9e-4532-974a-3480e014e074",
                        "source_entry_id": "fa10bea7-9ee1-3bdc-b80d-a5169db1ac42",
                        "source_sense_id": "ee9700df-d41b-3c56-985b-5342dc2efa0b",
                        "source_sense_description": "generic term for a disposable tissue",
                        "target_lang_word": "Tempo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tempo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af6361f0-fe15-3205-8bcd-9977daa65dab",
                                        "entry_id": "f1b1825a-5f7a-3911-8c9f-712a245bed44",
                                        "glosses": [
                                            "die Taktfrequenz in der Musik"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956a74f9-891b-4932-903b-5d5d99b5bc69",
                                                "sense_id": "af6361f0-fe15-3205-8bcd-9977daa65dab",
                                                "text": "Dieser Satz enthält drei verschiedene Tempi."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c9b77f1-8c5c-3ade-87b6-03934bb051eb",
                                        "entry_id": "f1b1825a-5f7a-3911-8c9f-712a245bed44",
                                        "glosses": [
                                            "Geschwindigkeit, mit der sich etwas bewegt oder eine Handlung abläuft"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34bc64a8-4d95-47d1-b66b-b77220636a69",
                                                "sense_id": "3c9b77f1-8c5c-3ade-87b6-03934bb051eb",
                                                "text": "Er war mit einem höllischen Tempo unterwegs."
                                            },
                                            {
                                                "example_id": "59258a60-81b0-4772-b937-f7f620ef66e9",
                                                "sense_id": "3c9b77f1-8c5c-3ade-87b6-03934bb051eb",
                                                "text": "Hier ist Tempo 30 vorgeschrieben. (30 km/h)"
                                            },
                                            {
                                                "example_id": "2cff946a-14ca-4bc5-8a6a-19a1b8599c78",
                                                "sense_id": "3c9b77f1-8c5c-3ade-87b6-03934bb051eb",
                                                "text": "„Das Tempo der Energiewende reicht nicht aus, um den CO₂-Ausstoß schnell genug runterzubringen.“"
                                            },
                                            {
                                                "example_id": "7ad685bc-4710-43b4-a091-f9c6d183c5dd",
                                                "sense_id": "3c9b77f1-8c5c-3ade-87b6-03934bb051eb",
                                                "text": "„Das Wohnhaus lag dicht an der Straße, mit durchsichtigen Gardinen und Topfblumen in den Fenstern, ich drosselte das Tempo, als ich vorüberfuhr, versuchte hineinzuschauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab954a3e-4aa7-312e-9ded-745d517f88d8",
                                        "entry_id": "f1b1825a-5f7a-3911-8c9f-712a245bed44",
                                        "glosses": [
                                            "Vorsprung von einem Zug beim Schach"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40316fec-e56c-443f-bb05-6ae31a35e9f5",
                                                "sense_id": "ab954a3e-4aa7-312e-9ded-745d517f88d8",
                                                "text": "Sie war schon drei Tempi im Vorsprung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tempo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53839371-8852-3604-b947-b965b9ba7582",
                                        "entry_id": "c12925a0-542b-3bf2-a409-0e9888bccbff",
                                        "glosses": [
                                            "frühere Automarke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21cc9d0c-b4ef-4415-afb4-bb7e51ab9380",
                                                "sense_id": "53839371-8852-3604-b947-b965b9ba7582",
                                                "text": "Er lieferte die Ware mit einem alten Tempo an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tempo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89d79342-1574-389f-8fa8-c839d29e9489",
                                        "entry_id": "14114be0-5dab-32a0-80f8-2bbe7d574ce0",
                                        "glosses": [
                                            "Papiertaschentuch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c028b1f-7dcc-4b44-82dc-a505eb2eaeef",
                                                "sense_id": "89d79342-1574-389f-8fa8-c839d29e9489",
                                                "text": "Hast du mal ein Tempo für mich?"
                                            },
                                            {
                                                "example_id": "6529ab62-978a-4e91-9899-db42ce92e996",
                                                "sense_id": "89d79342-1574-389f-8fa8-c839d29e9489",
                                                "text": "In seiner Tasche war nur ein benutztes Tempo."
                                            },
                                            {
                                                "example_id": "7a2c3a86-9b64-496c-b7b3-ca47eb4cea14",
                                                "sense_id": "89d79342-1574-389f-8fa8-c839d29e9489",
                                                "text": "„Dietrich schneuzt sich und starrt danach wie gebannt in das Tempo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
