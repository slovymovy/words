                ],
                "senses": [
                    {
                        "sense_id": "3df9f71a-a2a2-3e48-9048-c3f413e507ec",
                        "entry_id": "98598d66-84da-3c44-82d3-efa308d98836",
                        "glosses": [
                            "Cape caucasienne pour homme fabriquée à base de feutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d5e372-b4bc-4660-a5c1-6845c9ea017f",
                                "sense_id": "3df9f71a-a2a2-3e48-9048-c3f413e507ec",
                                "text": "Vient une tourmente de neige ; un cavalier s'approche, couvrant de sa bourka noire quelques précieux fardeau."
                            },
                            {
                                "example_id": "db0bc512-39ae-4de4-bf58-4b2d29839351",
                                "sense_id": "3df9f71a-a2a2-3e48-9048-c3f413e507ec",
                                "text": "Soyez donc en mesure d’affirmer que le Géorgien et l’Arménien se coiffent de la toque en pain de sucre, que les marchands revêtent la « touloupa », sorte de pelisse en peau de mouton, que le Kurde ou le Parsi portent encore la « bourka », manteau en tissu pelucheux, rendu imperméable par son apprêt !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a3e0504-95f1-4536-860c-8b17893c4e70",
                        "source_entry_id": "98598d66-84da-3c44-82d3-efa308d98836",
                        "source_sense_id": "3df9f71a-a2a2-3e48-9048-c3f413e507ec",
                        "target_lang_word": "Burka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                        "entry_id": "448b735c-7aca-3a54-9101-8e5789128306",
                                        "glosses": [
                                            "traditionell blaues Kleidungsstück, das als Ganzkörperschleier getragen wird und auch die Augen (mit einem Vorhang aus Rosshaar) bedeckt"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aa55b76-e941-44ec-84f9-7e68f154b8b2",
                                                "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                                "text": "In einigen europäischen Ländern ist das Tragen der Burka in der Öffentlichkeit verboten."
                                            },
                                            {
                                                "example_id": "b2849fbd-27df-4984-b2da-a0a4d1d84ce3",
                                                "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                                "text": "Die afghanische Burka wurde ursprünglich nur in den Städten getragen."
                                            },
                                            {
                                                "example_id": "007db7d2-1603-49da-9cbf-bde10ae0cd95",
                                                "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                                "text": "In Europa sieht man kaum Burkas."
                                            },
                                            {
                                                "example_id": "21f1dcd8-1d37-485c-97e0-6ed00869c914",
                                                "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                                "text": "„Die Max-Overalls waren nicht nur warm, es wirkte, als spielten sie eine ähnliche Rolle wie die Burka bei strenggläubigen Muslimas.“"
                                            },
                                            {
                                                "example_id": "5914bd77-e035-4082-90f1-f709ff811793",
                                                "sense_id": "d520e17b-56a7-3e97-8fd5-d6b4f5bc8ad8",
                                                "text": "„Ihre Beschlüsse vermittelte sie durch eine Trennwand oder durch ihren Vollschleier, der jedoch wesentlich bunter und prachvoller aussah als das, was wir heute als Burka kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Burka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c291e964-9567-3a24-8695-3bf23e70efaf",
                                        "entry_id": "da34a0fe-e77b-38b8-9430-d801f7891299",
                                        "glosses": [
                                            "dicker Umhang aus Schaf- oder Lammfell, der traditionell im Kaukasus getragen wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b090c86-3006-41fa-8b9e-f354a1bcf118",
                                                "sense_id": "c291e964-9567-3a24-8695-3bf23e70efaf",
                                                "text": "Die Burka ist fester Bestandteil der Kultur im Nordkaukasus, in Georgien, Aserbaidschan und der russisch-ukrainischen Kosaken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
