    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                    "sense_definition": "A state of continuous change or movement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travel industry is currently in a state of <w>flux</w> due to new regulations.",
