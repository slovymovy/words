                                "target_senses": [
                                    {
                                        "sense_id": "7d6f5bc7-8965-3112-845e-7ff652af792e",
                                        "entry_id": "2b12fc27-11c7-33e7-a0a9-8c0c867700da",
                                        "glosses": [
                                            "mit beiden Augen erfolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3daf8e-6dea-47d7-ae44-6d4175caf2cc",
                                                "sense_id": "7d6f5bc7-8965-3112-845e-7ff652af792e",
                                                "text": "Das stereoskopische Sehen setzt das binokulare Sehen voraus."
                                            },
                                            {
                                                "example_id": "e92e9cd5-b11a-4bea-b366-090b87e1062c",
                                                "sense_id": "7d6f5bc7-8965-3112-845e-7ff652af792e",
                                                "text": "Unter dem Begriff binokulares Sehen werden alle Aspekte des sensorischen und auch motorischen gemeinsamen Sehens von linkem und rechtem Auge verstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d0851e3-bf4d-3294-ba03-25003d78c4a5",
                                        "entry_id": "2b12fc27-11c7-33e7-a0a9-8c0c867700da",
                                        "glosses": [
                                            "für das gleichzeitige Sehen mit beiden Augen bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80dc8f37-990a-4bcf-9e6a-f51d23aa7ac7",
                                                "sense_id": "4d0851e3-bf4d-3294-ba03-25003d78c4a5",
                                                "text": "Das Mikroskop ist mit einem binokularen Schrägblick ausgestattet."
                                            },
                                            {
                                                "example_id": "15227155-1779-4df6-a2ae-9cf61686a040",
                                                "sense_id": "4d0851e3-bf4d-3294-ba03-25003d78c4a5",
                                                "text": "Die dreidimensionale Videookulographie wird für den strabologischen Bereich modifiziert und als binokulare Methode vorgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
