                        "glosses": [
                            "Donner un caractère de délit à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37092c92-a864-4be0-ba11-bc3e0f7e1f87",
                                "sense_id": "b8a36065-b25d-3e37-8edf-403e032838d7",
                                "text": "En conséquence, on a tendence^([sic]) à tolérer de plus en plus de choses, contraventionnaliser les délits, délictualiser les crimes."
                            },
                            {
                                "example_id": "cc67b5dc-e980-4f4f-9f4f-9ed1e5f7adec",
                                "sense_id": "b8a36065-b25d-3e37-8edf-403e032838d7",
                                "text": "Il convient surtout de délictualiser la parole de l'opposition."
                            },
                            {
                                "example_id": "35c22ea2-cdab-45a5-a7f7-c3dd91c3169f",
                                "sense_id": "b8a36065-b25d-3e37-8edf-403e032838d7",
                                "text": "Une réforme est en cours pour délictualiser cette infraction dès sa première réalisation et non seulement en cas de récidive."
                            }
                        ]
