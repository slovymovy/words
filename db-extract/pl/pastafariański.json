                    {
                        "sense_id": "c632130c-cddd-3fe4-a36b-7c4d134a3818",
                        "entry_id": "64c84ebe-862f-3f8d-849e-43d5ef30fb28",
                        "glosses": [
                            "związany z pastafarianizmem, zgodny z pastafarianizmem"
