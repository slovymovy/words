                "senses": [
                    {
                        "sense_id": "199c69f2-90e0-3002-9cbe-9104c2ec063d",
                        "entry_id": "6bf87dc6-be73-3440-8755-c3b5d519852f",
                        "glosses": [
                            "weibliche Person, deren Schwester oder Bruder gleichzeitig von der Mutter ausgetragen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a837ee5e-bd1f-4303-bb00-81b4c6515f4c",
                                "sense_id": "199c69f2-90e0-3002-9cbe-9104c2ec063d",
                                "text": "Max geht mit seiner Zwillingsschwester ins Konzert."
                            },
                            {
                                "example_id": "c81c73ce-c161-4f93-8e28-80162ec0fe77",
                                "sense_id": "199c69f2-90e0-3002-9cbe-9104c2ec063d",
                                "text": "Die eineiigen Zwillingsschwestern sind nicht zu unterscheiden."
                            },
                            {
                                "example_id": "70ec9bf9-888f-4f62-98a5-0b9f44344ec3",
                                "sense_id": "199c69f2-90e0-3002-9cbe-9104c2ec063d",
                                "text": "Holger hat einen Bruder und eine Zwillingsschwester."
                            },
                            {
                                "example_id": "0a405234-5583-433e-9ca1-56e483c48741",
                                "sense_id": "199c69f2-90e0-3002-9cbe-9104c2ec063d",
                                "text": "„Aus den Zwillingsstudien von Davis (1937) geht hervor, daß die Zwillingsbrüder, die Zwillingsschwestern hatten, in ihren sprachlichen Leistungen weniger zurückgeblieben waren als diejenigen, die nur mit Zwillingsbrüdern aufwuchsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
