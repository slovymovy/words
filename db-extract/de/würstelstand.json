                "senses": [
                    {
                        "sense_id": "42d39917-4645-3ab4-9147-6ed6f4f3797a",
                        "entry_id": "df621319-3ee8-38b9-8bba-d01c220197f4",
                        "glosses": [
                            "nicht in ein Gebäude eingebaute Verkaufsstelle für Imbisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ac6b88-494d-4a4d-a03d-a567a3228716",
                                "sense_id": "42d39917-4645-3ab4-9147-6ed6f4f3797a",
                                "text": "„Zu Zeiten der Monarchie wurden die ersten Würstelstände genehmigt – um Kriegsinvaliden ein Einkommen zu ermöglichen.“"
                            },
                            {
                                "example_id": "b6e7b969-6230-4eee-b0d0-c1c6a293f529",
                                "sense_id": "42d39917-4645-3ab4-9147-6ed6f4f3797a",
                                "text": "„Der Wiener Würstelstand lebt von seinem Standort, den Mitarbeitern, der Stimmung, den Stammkunden und natürlich von den Produkten.“"
                            },
                            {
                                "example_id": "38a9b306-2778-47a1-ab28-53bd0e2a44b4",
                                "sense_id": "42d39917-4645-3ab4-9147-6ed6f4f3797a",
                                "text": "„Vor dem Würstelstand seien noch Passanten gewesen, welche Würstel gegessen hätten.“"
                            },
                            {
                                "example_id": "6951fa1d-d0b5-4377-a426-68b64be683fe",
                                "sense_id": "42d39917-4645-3ab4-9147-6ed6f4f3797a",
                                "text": "„Beim Würstelstand oder in der Imbißstube einzelne Wurst von einer Sorte, die ansonsten paarweise verkauft und verzehrt zu werden pflegt, beispielsweise ein Frankfurter Würstel; Kren unf/oder Senf und eine Semmel oder ein Stück Brot ergänzen den Einspänner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
