{
    "word_family": [
        "слезинка",
        "слёзка",
        "слёзный",
        "прослезиться",
        "слезоточивый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "970018ba-156e-3aeb-8973-1d987fc68363",
                    "sense_definition": "Капля прозрачной солоноватой жидкости, выделяемой железами глаза.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "выделения из глаз",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Одинокая <w>слеза</w> медленно покатилась по её щеке.",
                            "target_lang_translations": {
                                "pl": "Samotna <w>łza</w> powoli potoczyła się po jej policzku."
                            }
                        },
                        {
                            "text": "Он смахнул <w>слезу</w> и попытался улыбнуться.",
                            "target_lang_translations": {
                                "pl": "Otarł <w>łzę</w> i spróbował się uśmiechnąć."
                            }
                        }
                    ],
                    "synonyms": [
                        "слезинка"
                    ],
                    "common_phrases": [
                        "пустить слезу",
                        "скупая слеза"
                    ],
                    "target_lang_definitions": {
                        "pl": "Kropla przezroczystego, słonawego płynu wydzielanego przez gruczoły łzowe oka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łza",
                                "target_lang_sense_clarification": "pojedyncza kropla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43ee32b7-821a-311f-9889-21ac97c74d15",
                    "sense_definition": "Прозрачная, бесцветная солоноватая жидкость, выделяемая железами глаза (обычно во множественном числе).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "выделения из глаз",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё на глазах выступили <w>слёзы</w> от радости.",
                            "target_lang_translations": {
                                "pl": "W jej oczach pojawiły się <w>łzy</w> radości."
                            }
                        },
                        {
                            "text": "Она не могла сдержать <w>слёз</w> при прощании.",
                            "target_lang_translations": {
                                "pl": "Nie mogła powstrzymać <w>łez</w> przy pożegnaniu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "слёзы радости",
                        "сдерживать слёзы",
                        "до слёз"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przezroczysty, bezbarwny, słonawy płyn wydzielany przez gruczoły łzowe oka (zwykle w liczbie mnogiej)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łzy",
                                "target_lang_sense_clarification": "płyn wydzielany przez oczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad597902-124a-3755-9e30-25fb3a239e73",
                    "sense_definition": "Переносное значение: горе, огорчение, страдание (обычно во множественном числе).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "эмоции и страдания",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта война принесла людям только <w>слёзы</w> и горе.",
                            "target_lang_translations": {
                                "pl": "Ta wojna przyniosła ludziom tylko <w>łzy</w> i cierpienie."
                            }
                        },
                        {
                            "text": "Хватит лить <w>слёзы</w> по пустякам, нужно действовать.",
                            "target_lang_translations": {
                                "pl": "Dość już wylewania <w>łez</w> nad drobiazgami, trzeba działać."
                            }
                        }
                    ],
                    "common_phrases": [
                        "лить слёзы",
                        "сквозь слёзы"
                    ],
                    "target_lang_definitions": {
                        "pl": "Znaczenie przenośne: żal, smutek, cierpienie (zwykle w liczbie mnogiej)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łzy",
                                "target_lang_sense_clarification": "smutek, cierpienie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "032eb205-d67d-3d77-b598-9980710c9307",
                    "sense_definition": "Переносное, поэтическое значение: капля любой влаги (например, росы или дождя).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "капли влаги",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На лепестках роз блестели утренние <w>слёзы</w> росы.",
                            "target_lang_translations": {
                                "pl": "Na płatkach róż błyszczały poranne <w>łzy</w> rosy."
                            }
                        },
                        {
                            "text": "Осенний дождь оставлял свои холодные <w>слёзы</w> на оконном стекле.",
                            "target_lang_translations": {
                                "pl": "Jesienny deszcz zostawiał swoje zimne <w>łzy</w> na szybie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "слёзы росы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в поэтическом или возвышенном стиле"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Znaczenie przenośne, poetyckie: kropla dowolnej wilgoci (np. rosy lub deszczu)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łzy",
                                "target_lang_sense_clarification": "krople rosy lub deszczu w poezji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}