                "senses": [
                    {
                        "sense_id": "cd591637-2a7a-37c0-8184-0b11c59f0e29",
                        "entry_id": "b0738ef9-2b53-302c-9dd2-92cc4454de29",
                        "glosses": [
                            "zweite"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "38354ca2-ad4c-4a81-a534-33fcd1036795",
                                "sense_id": "cd591637-2a7a-37c0-8184-0b11c59f0e29",
                                "text": "„Hier“, rief Quasi. Er klappte mit den Hacken, als er sich hinter den Schirm stellte, und er diktierte rasch „Riek, Karl Heinz, Klempner in einer Zuckerfabrik, geboren am zwoten zwoten neunzehnneunundzwanzig.“"
                            },
                            {
                                "example_id": "74ed0d36-1a8d-4e60-9e83-5af212e00efe",
                                "sense_id": "cd591637-2a7a-37c0-8184-0b11c59f0e29",
                                "text": "»Guten Morgen, zwote Kompanie!« rief der Pfarrer."
                            },
                            {
                                "example_id": "2565999f-b3c4-40a9-8178-5dea3d7f3f7a",
                                "sense_id": "cd591637-2a7a-37c0-8184-0b11c59f0e29",
                                "text": "Aus dessen zwoter Ehe indes entsprang Halbbruder Helmut (55), ein schräger Vogel."
                            },
                            {
                                "example_id": "eb141d55-1096-4e04-a7ec-b337a1cd6001",
                                "sense_id": "cd591637-2a7a-37c0-8184-0b11c59f0e29",
                                "text": "Privilegierte Unternehmen sollen künftig grundsätzlich 15 % der EEG-Umlage zahlen; allerdings gedeckelt wird auf 4 % zwotes 0,5 % der Bruttowertschöpfung zu Faktorkosten des jeweiligen Unternehmens."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
