                                    {
                                        "sense_id": "2ad4617f-67dc-32c4-b0aa-bc76643419f1",
                                        "entry_id": "99ce13bf-f8ab-3765-bac4-5bb7c86c7bbe",
                                        "glosses": [
                                            "Petit échassier de la famille des rallidés ressemblant à la poule d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9108da-f9f1-45c0-b319-03103ebfaae4",
                                                "sense_id": "2ad4617f-67dc-32c4-b0aa-bc76643419f1",
                                                "text": "La baie de L’Aiguillon est le passage obligé des oiseaux migrateurs : foulques, macroules, tadornes…"
                                            },
                                            {
                                                "example_id": "ba0709af-3b0f-4065-a0c1-0ec6afbf889d",
                                                "sense_id": "2ad4617f-67dc-32c4-b0aa-bc76643419f1",
                                                "text": "– Est-ce qu’il a tué aussi des foulques ?\n– Oui, quand il avait dix-huit ans. Mais à la fin, il ne les tirait même plus. Ce n’est pas un coup de fusil digne d’un chasseur."
                                            },
                                            {
                                                "example_id": "3e9daf6e-60db-41c9-9e77-e95a5c84f28a",
                                                "sense_id": "2ad4617f-67dc-32c4-b0aa-bc76643419f1",
                                                "text": "Le 13 du même mois, on prit près de l'hospice un pluvier gris et une bécasse; mais, ce qui est plus extraordinaire, on y aperçut une foulque, quoique cette espèce soit essentiellement aquatique."
                                            }
                                        ]
                                    }
                                ]
                            }
