                            {
                                "example_id": "e6652f6b-01dd-4fbf-b576-34439d4e8e07",
                                "sense_id": "0c725b7d-a29a-343f-9072-da12c94ad058",
                                "text": "Lars Boom verlaat de ploeg per direct. De oud-renner was sinds dit seizoen ploegleider bij de Nederlandse WorldTour-ploeg. Liv heeft de samenwerking gestopt omdat Boom wil ingaan op een aanbod van een andere vrouwenploeg, meldt het team in een verklaring."
                            },
                            {
                                "example_id": "23e7de0c-0f3a-4c0a-b67d-bed8d02a9ab8",
                                "sense_id": "0c725b7d-a29a-343f-9072-da12c94ad058",
                                "text": "Wiegman, tot twee keer toe gekozen tot beste coach ter wereld van een vrouwenploeg, deed haar uitspraken tijdens de onthulling van haar eigen standbeeld in Zeist. In de beeldentuin van de KNVB heeft ze een plek gekregen tussen Johan Neeskens en Marco van Basten."
                            }
                        ]
