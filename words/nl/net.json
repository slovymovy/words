                                "ru": "Я <w>едва</w> успел на поезд, потому что очень быстро бежал."
                            }
                        },
                        {
                            "text": "Er was <w>net</w> genoeg eten voor alle gasten op het feest.",
                            "target_lang_translations": {
                                "en": "There was <w>just</w> enough food for all the guests at the party.",
                                "ru": "Еды было <w>как раз</w> достаточно для всех гостей на празднике."
                            }
                        }
                    ],
                    "common_phrases": [
                        "net genoeg",
                        "net niet"
                    ],
                    "target_lang_definitions": {
                        "en": "by a very small margin; almost not",
                        "ru": "с очень небольшим запасом; едва, почти нет"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "barely, narrowly"
                            },
                            {
                                "target_lang_word": "barely",
                                "target_lang_sense_clarification": "only just"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "едва",
                                "target_lang_sense_clarification": "с трудом, почти не"
                            },
                            {
                                "target_lang_word": "как раз",
                                "target_lang_sense_clarification": "ровно столько, сколько нужно"
                            },
                            {
                                "target_lang_word": "чуть-чуть",
                                "target_lang_sense_clarification": "с минимальным отрывом"
                            }
                        ]
                    }
                }
            ]
        },
