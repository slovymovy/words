{
    "word_family": [
        "demisable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b163e73-366e-359f-88c1-d721f88df7ad",
                    "sense_definition": "The end, failure, or downfall of an enterprise, institution, or system.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poor management and a lack of innovation led to the company's rapid <w>demise</w>.",
                            "target_lang_translations": {
                                "ru": "Плохое управление и отсутствие инноваций привели к быстрому <w>краху</w> компании.",
                                "pl": "Złe zarządzanie i brak innowacji doprowadziły do szybkiego <w>upadku</w> firmy.",
                                "zh": "管理不善和缺乏创新导致了该公司的迅速<w>倒闭</w>。"
                            }
                        },
                        {
                            "text": "The invention of the internet contributed to the <w>demise</w> of many traditional print newspapers.",
                            "target_lang_translations": {
                                "ru": "Изобретение интернета способствовало <w>гибели</w> многих традиционных печатных газет.",
                                "pl": "Wynalezienie internetu przyczyniło się do <w>kresu</w> wielu tradycyjnych gazet drukowanych.",
                                "zh": "互联网的发明加速了许多传统纸媒的<w>消亡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "downfall",
                        "fall",
                        "(the) end",
                        "crash",
                        "doom"
                    ],
                    "antonyms": [
                        "inception",
                        "birth",
                        "creation"
                    ],
                    "common_phrases": [
                        "imminent demise",
                        "political demise",
                        "lead to the demise",
                        "eventual demise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец, провал или падение предприятия, учреждения или системы.",
                        "pl": "Koniec, upadek lub porażka przedsiębiorstwa, instytucji lub systemu.",
                        "zh": "指企业、机构或系统的终结、失败或倒台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "полная неудача, провал дела или предприятия"
                            },
                            {
                                "target_lang_word": "гибель",
                                "target_lang_sense_clarification": "прекращение существования (метафорически)"
                            },
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "завершение существования"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "upadek",
                                "target_lang_sense_clarification": "nagły koniec lub porażka instytucji"
                            },
                            {
                                "target_lang_word": "kres",
                                "target_lang_sense_clarification": "zakończenie istnienia czegoś"
                            },
                            {
                                "target_lang_word": "zguba",
                                "target_lang_sense_clarification": "przyczyna upadku lub sam upadek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒闭",
                                "target_lang_sense_clarification": "指企业或机构的破产或停业"
                            },
                            {
                                "target_lang_word": "终结",
                                "target_lang_sense_clarification": "指系统或事物的结束"
                            },
                            {
                                "target_lang_word": "覆灭",
                                "target_lang_sense_clarification": "指系统或政权的彻底失败或毁灭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68c9c779-9cf9-325f-b0c2-d24572a7bb18",
                    "sense_definition": "The death of a person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nation mourned the sudden <w>demise</w> of their beloved leader.",
                            "target_lang_translations": {
                                "ru": "Нация скорбела о внезапной <w>кончине</w> своего любимого лидера.",
                                "pl": "Naród opłakiwał nagły <w>zgon</w> swojego ukochanego przywódcy.",
                                "zh": "全国人民为他们敬爱的领袖的突然<w>逝世</w>感到悲痛。"
                            }
                        },
                        {
                            "text": "He did not leave a valid will before his untimely <w>demise</w>.",
                            "target_lang_translations": {
                                "ru": "Он не оставил действительного завещания до своей безвременной <w>кончины</w>.",
                                "pl": "Nie zostawił ważnego testamentu przed swoją przedwczesną <w>śmiercią</w>.",
                                "zh": "他在英年<w>早逝</w>前没有留下一份有效的遗嘱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "death",
                        "decease",
                        "expiration",
                        "fatality",
                        "exit"
                    ],
                    "antonyms": [
                        "birth"
                    ],
                    "common_phrases": [
                        "untimely demise",
                        "sudden demise",
                        "tragic demise"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смерть человека (обычно в официальном или возвышенном контексте).",
                        "pl": "Śmierć osoby (zazwyczaj w kontekście formalnym lub podniosłym).",
                        "zh": "指人的死亡（通常用于正式或庄重的语境）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кончина",
                                "target_lang_sense_clarification": "высокий стиль, официальное или уважительное обозначение смерти"
                            },
                            {
                                "target_lang_word": "смерть",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zgon",
                                "target_lang_sense_clarification": "formalne określenie śmierci"
                            },
                            {
                                "target_lang_word": "skon",
                                "target_lang_sense_clarification": "literackie lub podniosłe określenie śmierci"
                            },
                            {
                                "target_lang_word": "śmierć",
                                "target_lang_sense_clarification": "ogólne określenie ustania życia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逝世",
                                "target_lang_sense_clarification": "用于对受人尊敬的人的正式称呼"
                            },
                            {
                                "target_lang_word": "去世",
                                "target_lang_sense_clarification": "通用的正式表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5e6dc6f-0205-3ebf-a119-aace06ed69cc",
                    "sense_definition": "The formal transfer of an estate, sovereignty, or title to a successor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>demise</w> of the Crown occurs immediately upon the death of the reigning monarch.",
                            "target_lang_translations": {
                                "ru": "<w>Переход</w> Короны происходит немедленно после смерти правящего монарха.",
                                "pl": "<w>Przejście</w> Korony następuje natychmiast po śmierci panującego monarchy.",
                                "zh": "君主一旦驾崩，王权即刻<w>移交</w>给继任者。"
                            }
                        },
                        {
                            "text": "Legal documents were prepared to ensure the smooth <w>demise</w> of the estate to the heir.",
                            "target_lang_translations": {
                                "ru": "Юридические документы были подготовлены для обеспечения плавной <w>передачи</w> поместья наследнику.",
                                "pl": "Przygotowano dokumenty prawne, aby zapewnić sprawne <w>przekazanie</w> majątku spadkobiercy.",
                                "zh": "法律文件已准备就绪，以确保遗产顺利<w>转让</w>给继承人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "demise of the Crown"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная передача имущества, суверенитета или титула преемнику.",
                        "pl": "Formalne przekazanie majątku, suwerenności lub tytułu następcy.",
                        "zh": "指财产、主权或头衔向继任者的正式移交。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "прав, титула или имущества"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "суверенитета или прав (напр. переход Короны)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przekazanie",
                                "target_lang_sense_clarification": "formalne oddanie praw lub majątku"
                            },
                            {
                                "target_lang_word": "cesja",
                                "target_lang_sense_clarification": "przelanie praw na inną osobę"
                            },
                            {
                                "target_lang_word": "przejście",
                                "target_lang_sense_clarification": "zmiana posiadacza tytułu lub korony"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移交",
                                "target_lang_sense_clarification": "指权利或财产的正式转让"
                            },
                            {
                                "target_lang_word": "转让",
                                "target_lang_sense_clarification": "指所有权或头衔的法律转移"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d008c97-9867-359c-834e-0883c0e969f9",
                    "sense_definition": "The destruction of a satellite or spacecraft when it re-enters the Earth's atmosphere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers planned the satellite's controlled <w>demise</w> over a remote part of the ocean.",
                            "target_lang_translations": {
                                "ru": "Инженеры спланировали контролируемое <w>затопление</w> спутника в отдаленной части океана.",
                                "pl": "Inżynierowie zaplanowali kontrolowane <w>zniszczenie</w> satelity nad odległą częścią oceanu.",
                                "zh": "工程师们计划让卫星在偏远海域上空受控<w>坠毁</w>。"
                            }
                        },
                        {
                            "text": "The spacecraft burned up completely during its atmospheric <w>demise</w>.",
                            "target_lang_translations": {
                                "ru": "Космический корабль полностью сгорел во время своего <w>разрушения</w> в атмосфере.",
                                "pl": "Statek kosmiczny spłonął całkowicie podczas swojego <w>wejścia</w> w atmosferę.",
                                "zh": "航天器在重返大气层<w>烧毁</w>的过程中完全解体了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dematerialization"
                    ],
                    "common_phrases": [
                        "controlled demise"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "aerospace"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушение спутника или космического корабля при входе в атмосферу Земли.",
                        "pl": "Zniszczenie satelity lub statku kosmicznego podczas ponownego wejścia w atmosferę ziemską.",
                        "zh": "指卫星或航天器在重返地球大气层时被销毁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращение существования",
                                "target_lang_sense_clarification": "технический термин в космонавтике"
                            },
                            {
                                "target_lang_word": "сгорание",
                                "target_lang_sense_clarification": "в плотных слоях атмосферы"
                            },
                            {
                                "target_lang_word": "затопление",
                                "target_lang_sense_clarification": "контролируемое уничтожение в океане"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zniszczenie",
                                "target_lang_sense_clarification": "rozpad obiektu w atmosferze"
                            },
                            {
                                "target_lang_word": "spłonięcie",
                                "target_lang_sense_clarification": "całkowite spalenie się w atmosferze"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坠毁",
                                "target_lang_sense_clarification": "指航天器失控或受控落入大气层损毁"
                            },
                            {
                                "target_lang_word": "烧毁",
                                "target_lang_sense_clarification": "指物体因摩擦生热在大气层中焚毁"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "326c4bba-8036-3ee5-9ef9-98f0a4ed8a8a",
                    "sense_definition": "To transfer an estate or rights by lease or will.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord <w>demised</w> the property to the tenant for a period of ninety-nine years.",
                            "target_lang_translations": {
                                "ru": "Арендодатель <w>сдал в аренду</w> недвижимость арендатору сроком на девяносто девять лет.",
                                "pl": "Właściciel <w>wydzierżawił</w> nieruchomość najemcy na okres dziewięćdziesięciu dziewięciu lat.",
                                "zh": "房东将该房产<w>出租</w>给租户，租期为九十九年。"
                            }
                        },
                        {
                            "text": "In his final will, he <w>demised</w> all his land to his eldest daughter.",
                            "target_lang_translations": {
                                "ru": "В своем последнем завещании он <w>отписал</w> всю свою землю старшей дочери.",
                                "pl": "W swoim ostatnim testamencie <w>zapisał</w> całą swoją ziemię najstarszej córce.",
                                "zh": "他在遗嘱中将所有的土地都<w>遗赠</w>给了长女。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать имущество или права по договору аренды или завещанию.",
                        "pl": "Przekazać majątek lub prawa w drodze dzierżawy lub testamentu.",
                        "zh": "通过租赁或遗嘱转让财产或权利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать в аренду",
                                "target_lang_sense_clarification": "передавать права пользования"
                            },
                            {
                                "target_lang_word": "завещать",
                                "target_lang_sense_clarification": "передавать по наследству"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zapisać",
                                "target_lang_sense_clarification": "przekazać w testamencie"
                            },
                            {
                                "target_lang_word": "wydzierżawić",
                                "target_lang_sense_clarification": "oddać w najem lub dzierżawę"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出租",
                                "target_lang_sense_clarification": "通过合同转让使用权"
                            },
                            {
                                "target_lang_word": "遗赠",
                                "target_lang_sense_clarification": "通过遗嘱将财产留给他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d546879-4d8b-3cb6-b5e6-ff7c7455293f",
                    "sense_definition": "To die or cease to exist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>demised</w> peacefully in his sleep after a long and prosperous reign.",
                            "target_lang_translations": {
                                "ru": "Король мирно <w>почил</w> во сне после долгого и процветающего правления.",
                                "pl": "Król <w>odszedł</w> spokojnie we śnie po długim i pomyślnym panowaniu.",
                                "zh": "国王在漫长而繁荣的统治后，在睡梦中安详地<w>离世</w>了。"
                            }
                        },
                        {
                            "text": "Many ancient traditions have <w>demised</w> and been forgotten over the centuries.",
                            "target_lang_translations": {
                                "ru": "Многие древние традиции <w>отмерли</w> и были забыты на протяжении веков.",
                                "pl": "Wiele starożytnych tradycji <w>zanikło</w> i zostało zapomnianych na przestrzeni wieków.",
                                "zh": "许多古老的传统在几个世纪的流变中已经<w>消亡</w>并被遗忘了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умереть или прекратить существование.",
                        "pl": "Umrzeć lub przestać istnieć.",
                        "zh": "死亡或停止存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почить",
                                "target_lang_sense_clarification": "устаревшее, высокое: умереть"
                            },
                            {
                                "target_lang_word": "отмереть",
                                "target_lang_sense_clarification": "перестать существовать (о традициях, обычаях)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odejść",
                                "target_lang_sense_clarification": "eufemizm oznaczający śmierć"
                            },
                            {
                                "target_lang_word": "zaniknąć",
                                "target_lang_sense_clarification": "przestać istnieć (o tradycjach)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逝去",
                                "target_lang_sense_clarification": "指生命或事物的消逝"
                            },
                            {
                                "target_lang_word": "消亡",
                                "target_lang_sense_clarification": "指传统或事物不再存在"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}