                            "Straßenbau, veraltet"
                        ],
                        "examples": [
                            {
                                "example_id": "7c4f1a3c-832f-47ed-8a9f-0abeab678e9a",
                                "sense_id": "93502439-dea0-3e40-b283-062016e0beda",
                                "text": "„Dampfwalzen rumpeln durch die Straßen.“"
                            },
                            {
                                "example_id": "de76f222-ffeb-40f8-bca6-7c711f5b7a56",
                                "sense_id": "93502439-dea0-3e40-b283-062016e0beda",
                                "text": "„Zum Beispiel überstehen aufgrund ihrer zarten Gesundheit die wenigsten Schweine eine Hausschlachtung, und ein mir bekanntes Huhn legte ein schadhaftes Ei, nur weil es unter eine Dampfwalze geraten war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9e4dae2-110e-4d7d-9680-57d156961ded",
