                "senses": [
                    {
                        "sense_id": "876fd1a8-1fe2-3016-b331-0e6d1ae7055e",
                        "entry_id": "9242b580-0488-32d8-8760-e793f7e1f918",
                        "glosses": [
                            "Ajouter du lard à (ou, exceptionnellement, donner du lard à)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346bd49a-42d9-48ee-8c4d-f8cffc1c02ba",
                                "sense_id": "876fd1a8-1fe2-3016-b331-0e6d1ae7055e",
                                "text": "Enlarder le tout (7 tranche de lard par filet devraient suffire)."
                            },
                            {
                                "example_id": "76f7bb23-d374-40a5-8329-cbc2f69bd2a8",
                                "sense_id": "876fd1a8-1fe2-3016-b331-0e6d1ae7055e",
                                "text": "enlarder le cabillaud avec deux tranches de poitrines croisées."
                            },
                            {
                                "example_id": "1ef6d922-0666-43b8-8f54-93c25dbe9fa9",
                                "sense_id": "876fd1a8-1fe2-3016-b331-0e6d1ae7055e",
                                "text": "Et alors la mer le vente, il vente le chêne, le chêne lui donne du gland, il donne du gland au porc, le porc l’enlarde, il enlarde le forgeron, le forgeron l’arme d’une faux, il fauche le blé, le blé lui donne de l’herbe, il donne de l’herbe à la vache, la vache lui donne du lait, il donne du lait au veau, le veau lui donne des tripes, il donne des tripes au paon, le paon l’emplume, il emplume monsieur, monsieur lui donne la clef, il donne la clef à madame."
                            },
                            {
                                "example_id": "817fe9f3-5325-4853-b651-ac81dcbe777e",
                                "sense_id": "876fd1a8-1fe2-3016-b331-0e6d1ae7055e",
                                "text": "On rêve tous de ça mais je pense que fatalement pour faire de la masse il faut s'enlarder un petit peu mais (…)"
                            }
                        ]
                    }
                ],
