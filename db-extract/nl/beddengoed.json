                                "sense_id": "11eda3ad-89b1-3852-b948-60c43351e50b",
                                "text": "Ik moet nieuw beddengoed kopen voor het gastenbed.",
                                "translation": "I need to buy new bedding for the guest bed.",
                                "english": "I need to buy new bedding for the guest bed."
                            },
                            {
                                "example_id": "0fa4b2da-b919-4006-95c7-c6cc2d75fd9b",
                                "sense_id": "11eda3ad-89b1-3852-b948-60c43351e50b",
                                "text": "Het beddengoed moet elke week worden gewassen.",
                                "translation": "The bedding should be washed every week.",
                                "english": "The bedding should be washed every week."
                            },
                            {
                                "example_id": "a9d9cafc-02b2-45db-93d5-9da1043abca6",
                                "sense_id": "11eda3ad-89b1-3852-b948-60c43351e50b",
                                "text": "Ze houdt van zacht en comfortabel beddengoed.",
                                "translation": "She loves soft and comfortable bedding.",
                                "english": "She loves soft and comfortable bedding."
                            }
                        ]
