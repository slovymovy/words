                                                "example_id": "410a6b56-a4ed-460f-b7f4-92bb2050bbeb",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Du setzt Deinen Pudel auf, heute morgen ist es saukalt!"
                                            },
                                            {
                                                "example_id": "47c05193-ebf6-4d6b-ba76-4406d3b12077",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Weißt Du, wo mein roter Pudel geblieben ist?."
                                            }
