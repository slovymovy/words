                "senses": [
                    {
                        "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                        "entry_id": "5e7b0356-4421-3e3a-8279-e2997f3b412f",
                        "glosses": [
                            "Gebäudeteil, in dem oft Sportgeräte/Turngeräte oder auch sonstige Geräte aufbewahrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550b6f05-4dd2-4a16-a6db-5dd97d388b30",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "[Fußball:] „Nach rund 20 Minuten geben die Dassendorfer auf. Flugs wird ein anderer Kreidewagen aus dem Geräteraum geholt. Es ist ein älteres Modell, funktioniert aber immerhin.“"
                            },
                            {
                                "example_id": "60c7ed1f-8db9-453c-ac51-78d83134f5e3",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„Crossfit ist die männliche Form des Zirkeltrainings, gibt er zu verstehen, während er den Stahlklotz in die linke Hand nimmt und in den Geräteraum trägt.“"
                            },
                            {
                                "example_id": "85935a36-795d-4af6-b63e-2c81b4347463",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„In der Halle hängen acht Sandsäcke von der Decke. Der Geräteraum ist mit Kampfplakaten aus den vergangenen 20 Jahren tapeziert.“"
                            },
                            {
                                "example_id": "8cfa82bd-0f37-4c0a-b561-0fe9ba32ad0a",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„In einer Schule dürfen die Kinder nicht in den Geräteraum und sich selbsttätig Materialien holen.“"
                            },
                            {
                                "example_id": "71bd2a20-bfbd-49d5-960b-ccd8929c716e",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„Die kleinen Kästen können 2 – 4 Kinder tragen oder auf ein Rollbrett heben und in den Geräteraum fahren.“"
                            },
                            {
                                "example_id": "d456f6c1-e8d4-44b4-939d-716096019cf9",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„Irina Palina empfängt im Geräteraum der Trainingshalle am Velodrom, mit dem entschuldigenden Hinweis, dass hier selten jemand aufräume. Matten reihen sich an den Wänden, benutzte Teller stehen auf dem Tisch, ab und zu verschwindet jemand rumpelnd mit einem Turngerät.“"
                            },
                            {
                                "example_id": "50494342-f53d-4681-843f-0190f439f058",
                                "sense_id": "722ddfe1-84db-3b9a-ae31-757466a2565a",
                                "text": "„Hinter dem Laderaum wurde ein geräumiger Geräteraum eingerichtet, in dem sperriges wissenschaftliches Gerät gelagert und bei Bedarf mittels Gabelstapler durch den Betriebsgang zum Arbeitsdeck transportiert werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
