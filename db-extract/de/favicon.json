                "senses": [
                    {
                        "sense_id": "d9db949d-013e-34b9-87f8-20a70641e5ca",
                        "entry_id": "dda8f653-a924-3e8d-9692-d7891ac0374a",
                        "glosses": [
                            "Wiedererkennungszeichen einer Website, das bei den meisten Browsern links neben der Adressleiste angezeigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02210fc1-69ea-455c-83f9-4f2143020800",
                                "sense_id": "d9db949d-013e-34b9-87f8-20a70641e5ca",
                                "text": "Favicons sind häufig eine verkleinerte und leicht angepasste Version des Firmenlogos."
                            },
                            {
                                "example_id": "41d95629-3ab7-40d7-ab69-fc2195399434",
                                "sense_id": "d9db949d-013e-34b9-87f8-20a70641e5ca",
                                "text": "„Erst kürzlich wurde das Favicon der Kalenderseite von Google um eine Nummer ergänzt, allerdings zeigt diese nicht das aktuelle Datum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3634c846-c8f5-448b-9833-1dc1e173be05",
                        "source_entry_id": "dda8f653-a924-3e8d-9692-d7891ac0374a",
                        "source_sense_id": "d9db949d-013e-34b9-87f8-20a70641e5ca",
                        "source_sense_description": "Wiedererkennungszeichen einer Website",
                        "target_lang_word": "favicon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favicon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                        "entry_id": "0582678a-489b-3683-9755-5101e4d84ab5",
                                        "glosses": [
                                            "An icon associated with a particular website, and typically displayed in the address bar of a browser viewing the site."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759f68f2-75a8-4f66-8a4a-fc9736f839d4",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "The only way to restore a favicon is to delete the link from the Favorites folder and recreate it."
                                            },
                                            {
                                                "example_id": "77239228-d2bc-4707-a211-ab7c0ef40d3c",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "A free online favicon editor allows advanced webmasters to create their own favicons and use them during website development or maintenance."
                                            },
                                            {
                                                "example_id": "b6d7c71b-ae6c-4dbc-95d9-5c58a37cbf1a",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "You, however, can do better by creating your own customized favicon for your Web site — just the thing you need to add that professional touch."
                                            },
                                            {
                                                "example_id": "cffc1d49-d31e-43bf-a078-018e3e48307b",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "Make sure to create a favicon. Since the browser will request this file anyway, there's no reason to return a 404 Page Not Found error, especially if your 404 handler consumes a database connection or other expensive resources."
                                            },
                                            {
                                                "example_id": "7520fe52-07d7-419c-ac90-933857f64ffe",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "Favicons are those cute little icons that appear on your browser's address bar when you visit some sites."
                                            },
                                            {
                                                "example_id": "b6705720-0021-4138-a8e6-43ed17ad8dcd",
                                                "sense_id": "060eaaef-caea-33b0-b58b-97a11067e0b4",
                                                "text": "You can stick with the favicon provided by your Web host.\nDo not worry about pronouncing favicon correctly. There is no definitive pronunciation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
