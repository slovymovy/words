                        "sense_id": "ce7e3fe6-0156-34a8-a47a-2f6fa7a650b1",
                        "entry_id": "08d47981-47b7-367c-99f9-657a803ea9fe",
                        "glosses": [
                            "Bibelauslegung und theologische Lehre, nach der sich Gott am Ende aller Zeiten mit allen Menschen und dem gesamten All aussöhnen wird"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "bdad8dcf-34e0-40cd-9b57-bc6135881121",
                                "sense_id": "ce7e3fe6-0156-34a8-a47a-2f6fa7a650b1",
                                "text": "\"Die Lehre einer Allaussöhnung stützt sich auf die neutestamentliche Aussage, dass Gott in Zukunft das All mit sich aussöhnen wird.\""
                            },
                            {
                                "example_id": "41d3e3f1-888c-491f-860d-952314975206",
                                "sense_id": "ce7e3fe6-0156-34a8-a47a-2f6fa7a650b1",
                                "text": "Die Lehre der Allaussöhnung impliziert die Aussage: In und bei Gott gibt es keine endgültige Verdammung!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
