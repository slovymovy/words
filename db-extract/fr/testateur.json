                    },
                    {
                        "form_id": "0e7e2e76-be3c-46fd-975e-c5429648f8b9",
                        "entry_id": "a32fcbc5-f2cd-3a54-84cc-325a2eac6591",
                        "tags": [
                            "feminine"
                        ],
                        "form": "testatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                        "entry_id": "a32fcbc5-f2cd-3a54-84cc-325a2eac6591",
                        "glosses": [
                            "Celui qui fait ou a fait un testament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4928a02e-d594-4a61-9884-17e20922d376",
                                "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                                "text": "Pour être capable de recevoir par testament, il suffit d’être conçu à l'époque du décès du testateur."
                            },
                            {
                                "example_id": "35c68020-5d12-4c89-9e37-b94205908ad9",
                                "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                                "text": "La volonté du testateur doit être sacrée et inviolable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5deee06c-825c-49f0-9d4b-5c676e853ba8",
                        "source_entry_id": "a32fcbc5-f2cd-3a54-84cc-325a2eac6591",
                        "source_sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                        "target_lang_word": "Erblasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erblasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                        "entry_id": "0c3c765f-2c46-300b-94c0-f8cca7a4faa4",
                                        "glosses": [
                                            "natürliche Person, die nach ihrem Tod ein Vermögen hinterlässt, das den gesetzlichen und testamentarisch bestimmten Erben zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c203631e-d42a-48fa-9bc1-1b8f6ef0746b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Das Erbrecht tritt erst nach dem Tode des Erblassers ein. Stirbt ein vermeintlicher Erbe vor dem Erblasser; so hat er das noch nicht erlangte Erbrecht auch nicht auf seine Erben übertragen können.“"
                                            },
                                            {
                                                "example_id": "9aef8c25-f756-4b3d-b5ec-8d23336a105b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Eine letztwillige Verfügung, durch die der Erblasser seinen Ehegatten bedacht hat, ist unwirksam, wenn die Ehe vor dem Tod des Erblassers aufgelöst worden ist.“"
                                            },
                                            {
                                                "example_id": "df78cb5a-a8a4-4130-bb65-2ac052a36b83",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Der Erblasser kann einem Abkömmling den Pflichtteil entziehen: 1. wenn der Abkömmling dem Erblasser, dem Ehegatten oder einem anderen Abkömmling des Erblassers nach dem Leben trachtet, …“"
                                            },
                                            {
                                                "example_id": "6b8b3ce3-9057-4189-8e53-8bd1fee4820a",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Sie sollen sie alle sehen und prüfen; jetzt aber lesen Sie zunächst einmal dieses Schreiben, welches der verwüstliche Erblasser damals aus Plauen erhalten hat!“"
                                            },
                                            {
                                                "example_id": "677a4d47-169f-4f7c-961d-ee8de496573d",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Man sagt, dass seitdem in Danzig in mannigfachen Fällen, insofern der Erblasser dem Genusse des Goldwassers ergeben war, von den Erben seine Sektion dringend gefordert wurde.“"
                                            },
                                            {
                                                "example_id": "5a6d08f2-fb97-43bf-9512-b1947793e998",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Dann verlas er einige persönliche Zeilen des Erblassers: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e5a1841-5baf-4398-8c4b-00aa1506a040",
                        "source_entry_id": "a32fcbc5-f2cd-3a54-84cc-325a2eac6591",
                        "source_sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                        "target_lang_word": "testator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                                        "entry_id": "4ace505d-3851-3319-9b80-cabe15c65ae1",
                                        "glosses": [
                                            "One who makes or has made a legally valid will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592a8770-3ddf-4ffe-b988-80acc80d60bc",
                                                "sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                                                "text": "[…] there is an exception “in the cases of heir and executor, who may plead a release to the ancestor or testator whom they respectively represent; so also with respect to several tortfeasors, for in all these cases there is a privity between the parties which constitutes an identity of person”."
                                            },
                                            {
                                                "example_id": "f456f75e-ae43-4122-84a8-39803bcd7bfb",
                                                "sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                                                "text": "As it is, knowing that the testator was a gentleman of the highest intelligence and acumen, and that he has absolutely no relations living to whom he could have confided the guardianship of the child, we do not feel justified in taking this course."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
