                    "sense_id": "4c7e914a-1c31-3c9e-9d97-bdbb829331b2",
                    "sense_definition": "taki, którego używa się na co dzień, w zwykłej rozmowie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "język",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej język jest wykwintny, zdania mają zapach minionej epoki, przesiane wyrazami już dziś zapomnianymi w <w>potocznym</w> języku.",
                            "target_lang_translations": {
                                "ru": "Её язык изыскан, фразы веют духом ушедшей эпохи, они пересыпаны словами, уже забытыми в <w>разговорном</w> языке."
                            }
                        },
                        {
                            "text": "W <w>potocznej</w> mowie często używamy skrótów myślowych, które nie zawsze są poprawne gramatycznie.",
                            "target_lang_translations": {
                                "ru": "В <w>разговорной</w> речи мы часто используем сокращения мысли, которые не всегда грамматически верны."
                            }
                        }
                    ],
                    "synonyms": [
                        "kolokwialny",
                        "nieformalny",
                        "swobodny"
                    ],
                    "antonyms": [
                        "literacki",
                        "formalny",
                        "oficjalny"
                    ],
                    "common_phrases": [
                        "potoczny język",
                        "potoczna mowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к повседневному, неофициальному общению; используемый в обычной речи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговорный",
