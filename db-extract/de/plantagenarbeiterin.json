                "senses": [
                    {
                        "sense_id": "747d0784-5336-38f5-84ad-71b753bf4ab7",
                        "entry_id": "05e2228b-4cf9-37b4-89b6-1ffa845ddac5",
                        "glosses": [
                            "weibliche Person, die auf einer Plantage als Arbeiterin beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358a46a4-8538-48c2-9584-b4edd252802e",
                                "sense_id": "747d0784-5336-38f5-84ad-71b753bf4ab7",
                                "text": "„Die Flugzeuge kommen ohne Vorwarnung. Sie versprühen eine Flüssigkeit, die \"wie verrückt stinkt\", wie eine Plantagenarbeiterin erzählt.“"
                            },
                            {
                                "example_id": "e7888be9-f432-4d89-bac7-fd7e6142002f",
                                "sense_id": "747d0784-5336-38f5-84ad-71b753bf4ab7",
                                "text": "„Durch den Kauf von Produkten mit dem Fairtrade-Gütesiegel unterstützen österreichische Konsumenten und Konsumentinnen nachhaltig Kleinbauernfamilien, Plantagenarbeiter und Plantagenarbeiterinnen in den sogenannten Entwicklungsländern.“"
                            }
                        ],
