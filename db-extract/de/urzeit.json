                "senses": [
                    {
                        "sense_id": "a17fccbd-161b-35f4-a679-80bbc2f72140",
                        "entry_id": "0180b52d-81a7-387c-99c8-e9a6eb23e40f",
                        "glosses": [
                            "a very long-ago age, a very early era (e.g. in the history of humanity or the earth)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5c6a41f1-bf28-46b1-93de-3a8a40f65569",
                                "sense_id": "a17fccbd-161b-35f4-a679-80bbc2f72140",
                                "text": "die Urzeiten der Menschheit",
                                "translation": "the earliest ages of humanity",
                                "english": "the earliest ages of humanity"
                            },
                            {
                                "example_id": "d25d5793-46cd-45bf-946b-3b5378a69ef8",
                                "sense_id": "a17fccbd-161b-35f4-a679-80bbc2f72140",
                                "text": "Die Dinosaurier lebten in der Urzeit.",
                                "translation": "The dinosaurs lived in primeval times.",
                                "english": "The dinosaurs lived in primeval times."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1366c5a-d3c0-361b-aa1c-47c07d84f6ff",
                        "entry_id": "0180b52d-81a7-387c-99c8-e9a6eb23e40f",
                        "glosses": [
                            "a very long time, an eternity"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively",
                            "informal",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b0219b3b-4c8a-4d3e-9142-6cee0c242b31",
                                "sense_id": "a1366c5a-d3c0-361b-aa1c-47c07d84f6ff",
                                "text": "Ich hab Urzeiten auf dich gewartet.",
                                "translation": "I waited ages for you.",
                                "english": "I waited ages for you."
                            }
                        ]
                    }
                ],
