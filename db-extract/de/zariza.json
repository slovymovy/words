                            {
                                "example_id": "069e040e-ba44-4ccc-8e73-1c5cd91bccb3",
                                "sense_id": "ba6b529e-5c96-3a1c-bd93-850a7ba6a30b",
                                "text": "„Die Zariza Jewdokija war eine abgehärmte, müde Frau von fast fünfzig Jahren, die sich auf ihr weißes Gesicht rote Bäckchen malte und deren abgetragenes, vielfach geflicktes Seidengewand die Magerkeit ihres Körpers kaum verdecken konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
