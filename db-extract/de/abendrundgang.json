                "senses": [
                    {
                        "sense_id": "4f8132ae-33a2-34e8-88f1-5c52bd267f19",
                        "entry_id": "1c2875fa-4b83-3c8a-a881-2ef3b64fff74",
                        "glosses": [
                            "Aktivität, bei der man in den Abendstunden einen bestimmten Rundkurs abgeht (beispielsweise ein gemütlicher Spaziergang, eine informative Führung, eine Erkundungstour oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5236c27-f4c5-482e-8df8-c7d43619bec0",
                                "sense_id": "4f8132ae-33a2-34e8-88f1-5c52bd267f19",
                                "text": "„Nachdem die Schwester den Abendrundgang erledigt hatte, haben wir die Betten so drapiert, dass es aussah, als lägen wir noch darin.“"
                            },
                            {
                                "example_id": "09bcf70d-7a8c-4cc0-a2b4-fd2f0dc3d287",
                                "sense_id": "4f8132ae-33a2-34e8-88f1-5c52bd267f19",
                                "text": "„Auf dem Abendrundgang begleitet mich Ardilla manchmal.“"
                            },
                            {
                                "example_id": "19238d52-1f38-4034-af19-f7da66668659",
                                "sense_id": "4f8132ae-33a2-34e8-88f1-5c52bd267f19",
                                "text": "„Am selben Tag, als sie mit Danielle von einem Abendrundgang über die Farm zurückkam, stand der Schaukelstuhl dort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
