                "senses": [
                    {
                        "sense_id": "ffe268c1-12f2-37e5-b0a0-a6088ea026ce",
                        "entry_id": "727a928d-29d4-3e61-87f6-bdb640f06846",
                        "glosses": [
                            "schending van wat heilig is of heilig gevonden wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab13ca7e-f5b3-495d-b147-3aecbe485e0b",
                                "sense_id": "ffe268c1-12f2-37e5-b0a0-a6088ea026ce",
                                "text": "Zie, de vijand die Uw land in verwarring brengt en het heelal tot een woestenij wil maken, is tegen ons opgestaan; zie de wetteloze lieden die zijn samengekomen om Uw rijk te gronde te richten en Uw Heilige Jeruzalem, Uw geliefde Rusland te verwoesten: om Uw tempels te ontheiligen, Uw altaren omver te werpen en onze heiligdommen te schenden."
                            },
                            {
                                "example_id": "e0f266d2-cccd-41c3-886b-6fcb712d99c5",
                                "sense_id": "ffe268c1-12f2-37e5-b0a0-a6088ea026ce",
                                "text": "Het bedrijf dat de beveiliging doet in de tempels, noemt de foto's daden van ontheiliging. \"Ik snap niet wat mensen ertoe drijft om dit te doen\", zegt een woordvoerder. Het Werelderfgoedcomité van de Verenigde Naties vindt de foto's weerzinwekkend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768183a0-49e7-49c4-9864-6efcac5f4916",
                        "source_entry_id": "727a928d-29d4-3e61-87f6-bdb640f06846",
                        "source_sense_id": "ffe268c1-12f2-37e5-b0a0-a6088ea026ce",
                        "source_sense_description": "schending van wat heilig is of heilig gevonden wordt",
                        "target_lang_word": "desecration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desecration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                        "entry_id": "5ee4f9b5-9a1c-397d-a28e-1155c7ad3afc",
                                        "glosses": [
                                            "An act of disrespect or impiety towards something considered sacred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82af0fa-69c6-495c-9861-e931b9531a17",
                                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                                "text": "It seemed a desecration and an unhallowed thing to touch that sleeping image of the live man by my side."
                                            },
                                            {
                                                "example_id": "892df796-fe70-4f15-9fc4-5704fca644b9",
                                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                                "text": "In the same year as the Furness objection, sadder tidings befell St Pancras Priory at Lewes, in East Sussex. Despite it having the distinction of being the earliest Cluniac monastery in Great Britain, petitions to prevent the Brighton Lewes & Hastings Railway from imposing on its site with its Lewes line failed. The line was approved and, as if as an act of deliberate desecration and assertion of the railways' power, passed over the site of the high altar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
