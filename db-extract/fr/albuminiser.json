                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dc4992-4130-484e-974b-67a2252a7166",
                                "sense_id": "5a0a0df7-e93e-389c-bbdc-9bd66bb8f7c3",
                                "text": "Pour albuminiser un verre, on fait dissoudre dans du blanc d’œuf une petite quantité d’iodure de potassium, et l’on bat le tout en neige."
                            },
                            {
                                "example_id": "3c209e71-b3fd-4a10-bdb9-a8a4a164a7a3",
                                "sense_id": "5a0a0df7-e93e-389c-bbdc-9bd66bb8f7c3",
                                "text": "On peut albuminiser le papier à deux reprises différentes, la première couche étant parfaitement sèche."
                            }
                        ]
