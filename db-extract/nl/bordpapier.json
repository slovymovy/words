                "forms": [],
                "senses": [
                    {
                        "sense_id": "94b17d9e-d4bb-3e7f-977d-206ba2952c9a",
                        "entry_id": "64638e95-8343-3b2a-9186-e46204ee71f5",
                        "glosses": [
                            "karton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf8c92bf-7930-4e31-82eb-ff59d028f4d2",
                                "sense_id": "94b17d9e-d4bb-3e7f-977d-206ba2952c9a",
                                "text": "Onder het groene tafelkleed lagen bordpapieren, voor het doorstuiven van stof in de laden en die uitschuifbaar waren, waarop dan de pooten van de voorbeeld-standerds kwamen te rusten, ook van stevig bordpapier en zoo uit éen stuk gesneden dat ze vlak weêr opgeborgen konden worden na het gebruik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1af0d5d9-c773-472d-8082-98f464820c28",
                        "source_entry_id": "64638e95-8343-3b2a-9186-e46204ee71f5",
                        "source_sense_id": "94b17d9e-d4bb-3e7f-977d-206ba2952c9a",
                        "target_lang_word": "Karton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                        "entry_id": "df5181b7-6474-359f-b62d-977db1f0bc83",
                                        "glosses": [
                                            "festeres, papierähnliches Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a337f-01fa-4386-b993-483055ca4b9b",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "Die Schachtel ist aus Karton."
                                            },
                                            {
                                                "example_id": "690bb2dd-e839-4375-9e02-b25004f6326d",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "„Sie sah nur bemalte Kartons und merkwürdig herausgeputzte Männer und Frauen, die in einer merkwürdig grellen Beleuchtung merkwürdige Bewegungen machten, redeten und sangen.“"
                                            },
                                            {
                                                "example_id": "7e8c00a4-b028-435c-a689-ce5085ff4702",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "„Als sich die Gruppe im Raum verteilte, um gewisse Maße auf einen Karton zu übertragen, nahm Robert den Freund beiseite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                        "entry_id": "df5181b7-6474-359f-b62d-977db1f0bc83",
                                        "glosses": [
                                            "dünner, rechteckiger Behälter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d68cc9c-bca9-4722-b0c5-330d816c1319",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "Er verpackt das Geschenk in einen Karton."
                                            },
                                            {
                                                "example_id": "fc72856a-3ed7-4327-a626-5db8c5651e1c",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Ihr folgte gleich darauf mit einem großen Karton eine Frau wie ein Zeisig.“"
                                            },
                                            {
                                                "example_id": "6953825d-8e07-46e8-8a03-eaf0efc600d2",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Im kleinen Hinterzimmer packte ein junges Mädchen gerade einen Karton mit Zeitschriften aus.“"
                                            },
                                            {
                                                "example_id": "9e18fe2b-4108-48d8-9b9d-56bc9d7064f8",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Ihr Blick fiel auf die Kartons hinten im Kofferraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9813c1c3-587d-42e3-9603-85b6d11c2c8e",
                        "source_entry_id": "64638e95-8343-3b2a-9186-e46204ee71f5",
                        "source_sense_id": "94b17d9e-d4bb-3e7f-977d-206ba2952c9a",
                        "target_lang_word": "cardboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0922a0b-fc9b-3ae8-8ca7-3d0562179fb1",
                                        "entry_id": "4a573e17-b990-30af-bc70-5fb2130d18c0",
                                        "glosses": [
                                            "A wood-based material resembling heavy paper, used in the manufacture of boxes, cartons and signs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                        "entry_id": "4a573e17-b990-30af-bc70-5fb2130d18c0",
                                        "glosses": [
                                            "Something flat or insubstantial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e9e6d49-38d4-45b1-9ddc-6978ce20c115",
                                                "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                                "text": "In my experience, one of the most vital times in the life of a piece of fiction is when a character begins to speak, timidly and softly, in one's head. Honest and true books get written when the author feels free to coax and invite that character in. If the author's response to that small voice is instead to submit it to a test: \"Are you: black/white/gay/straight/male/female/Christian/Jewish/old/young/politically correct\" the character will probably turn around and leave or else turn into cardboard."
                                            },
                                            {
                                                "example_id": "1c22d091-39d1-4218-a2d5-83bf206abed3",
                                                "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                                "text": "According to these keyboard warriors, the young men and women who survived the shooting are part of a big hoax, are liars, are mere cardboard cutouts – “crisis actors” who roam the country looking for mass shootings from which to promote their anti-gun message – all being pushed forward by the giant liberal machine that is Hillary Clinton’s robot attack army."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cardboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                        "entry_id": "3b369928-c2c7-3711-9620-92b1441358b5",
                                        "glosses": [
                                            "Made of or resembling cardboard; (figurative) flat or flavorless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d020749-4354-43ff-b262-906042b090fc",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "The worst of the thing, however, is that the enormity, such as it is, happens to be of a very cardboard and tinsel character."
                                            },
                                            {
                                                "example_id": "a7e330bc-91a7-440a-8513-23f0c7efc7e0",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "The thing really looked quite cardboard."
                                            },
                                            {
                                                "example_id": "59a3db31-4678-43ce-b5fe-90e07c85fee4",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "While Lensky’s character is quite cardboard, Onegin’s manipulations and lack of ability to call off the duel because he fears society’s jibes, Lensky’s youth and naivety, and Tatiana’s reaction to the duel lend the event its gravity."
                                            },
                                            {
                                                "example_id": "427580ab-04a2-49d5-9e5f-14dc4ccf5753",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "MUMMER 3 pulls out an inflated cushion with a very cardboard crown on it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2d73d71-4c6c-4a2e-abc5-2bb048020c03",
