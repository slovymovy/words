                                                "example_id": "410f4c90-70c7-4325-b024-0e189b6281e4",
                                                "sense_id": "5c75ea84-7a3a-3b63-b577-57ed456c4aa1",
                                                "text": "Es gibt in der Rechtswissenschaft eine große Zahl von Zessionsarten: entgeltliche Zessionen, unentgeltliche Zessionen, notwendige, gesetzliche Zessionen, etc."
                                            }
