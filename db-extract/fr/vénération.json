        "fr-extract.jsonl": [
            {
                "entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
                "word": "vénération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78c3c355-50a7-4ac8-a126-61c796606f59",
                        "entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
                        "tags": [
                            "plural"
                        ],
                        "form": "vénérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e851b3b-ebc7-3ac8-9e70-760e000e5455",
                        "entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
                        "glosses": [
                            "Respect qu’on a pour les saints et les choses saintes ; honneur qu’on leur rend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4d5406-4b88-4ee1-807c-78f2099ca6f6",
                                "sense_id": "5e851b3b-ebc7-3ac8-9e70-760e000e5455",
                                "text": "Le Cheikh de la mosquée parut enfin, en tête de la procession. Il marchait d'un pas lourd, chargé du magnifique manteau, maintes fois réparé avec vénération, qui avait jadis appartenu à Saïd El Badawi."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea896003-6636-3776-b77f-776ec19fbb71",
                        "entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
                        "glosses": [
                            "Estime respectueuse qu’on a pour certaines personnes ou certaines choses."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d5a9558c-6bce-49c7-b918-292c7e7f1c80",
                                "sense_id": "ea896003-6636-3776-b77f-776ec19fbb71",
                                "text": "Face à ce manque de fermeté, je me lance avec une impudence décuplée dans des techniques de peinture expérimentales et des thèmes peu communs, de plus en plus naturalistes, où l'idéalisation du réel et la vénération du modèle sont exclues."
                            },
                            {
                                "example_id": "df3e9d06-5316-43ec-8b07-3cc0f913b785",
                                "sense_id": "ea896003-6636-3776-b77f-776ec19fbb71",
                                "text": "Les économiquement faibles inscrits à son « bureau de bienfaisance », les personnes seules et âgées, les travailleurs immigrés, les déshérités de tous poils lui vouaient une vénération sans limites."
                            },
                            {
                                "example_id": "f216ed13-5218-4e92-9f9e-950529127e3d",
                                "sense_id": "ea896003-6636-3776-b77f-776ec19fbb71",
                                "text": "La langue se purifie... elle se sépare du peuple qui sent mauvais... Une langue appauvrie jusqu'à l'os... En France on est très chatouilleux sur tout ce qui concerne les problèmes de la langue. On la traite comme un objet de vénération."
                            },
                            {
                                "example_id": "418c3d2d-f1a2-476d-9c99-094a21297ec8",
                                "sense_id": "ea896003-6636-3776-b77f-776ec19fbb71",
                                "text": "J’admire donc la capacité de la démocratie américaine de faire référence à ses grands personnages et à ses promesses initiales (cette vénération de la «constitution» et de leurs auteurs)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdd6b239-adbb-4f56-9a22-54381463eb94",
                        "source_entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
                        "target_lang_word": "Verehrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verehrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45bcd3d2-8fa8-3845-961d-b954b016b21b",
                                        "entry_id": "4965c9ac-91d0-3825-a0cc-0835c9a17db9",
                                        "glosses": [
                                            "Verehren von Gott oder Göttern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "878a70e2-e3b9-4698-8a4b-ae94832a1a2a",
                                                "sense_id": "45bcd3d2-8fa8-3845-961d-b954b016b21b",
                                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                                            },
                                            {
                                                "example_id": "dbc773d7-9d58-4d50-b1e4-d144202fc116",
                                                "sense_id": "45bcd3d2-8fa8-3845-961d-b954b016b21b",
                                                "text": "„Für ihn ist die Verehrung Jupiters und der anderen hellenischen Gottheiten nicht minder unsinnig und lächerlich, als die Verehrung des hundeköpfigen Aegypters, des memphischen Stiers, der Ibisse, Affen und Böcke, welche damals mit dem Ueberhandnehmen fremdländischer Kulte den homerischen Göttern an die Seite gerückt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb1c901c-210a-3548-a960-52da4609deab",
                                        "entry_id": "4965c9ac-91d0-3825-a0cc-0835c9a17db9",
                                        "glosses": [
                                            "Hochachtung einem Menschen gegenüber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21eb9997-2b47-4acf-9d84-5ed98b781832",
                                                "sense_id": "eb1c901c-210a-3548-a960-52da4609deab",
                                                "text": "„Die Terrasse ist mit einem dekorativen Fries geschmückt, der Vertreter verschiedenster Völker bei der Verehrung des Königs zeigt.“"
                                            },
                                            {
                                                "example_id": "64646083-34ef-49a3-a249-aaaecdd4e6eb",
                                                "sense_id": "eb1c901c-210a-3548-a960-52da4609deab",
                                                "text": "„Es entsteht auf diese Weise eine vielgestaltige Verehrung des Kaisers, die an vielen Orten des Imperium Romanum die Form eines regelrechten Kaiserkultes mit der Errichtung von Tempeln und der Darbringung von Opfern annimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44b21199-8265-4cab-8757-179dbeb3b09f",
                        "source_entry_id": "57427006-071b-32c4-b19c-b87c529fe97f",
