                                "target_senses": [
                                    {
                                        "sense_id": "42f199e4-938d-3600-9964-6e6b3fec612b",
                                        "entry_id": "f1532326-d850-3013-afe3-7bf131ddf6c3",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740f7e23-4dfc-4012-bb46-65c878a4631e",
                                                "sense_id": "42f199e4-938d-3600-9964-6e6b3fec612b",
                                                "text": "Nina Kolot, retraitée, explique la coopération qui s’était instaurée entre les civils et les troupes ukrainiennes retranchées à quelques mètres de leurs domiciles."
                                            },
                                            {
                                                "example_id": "01621490-c3dc-4d3e-8351-92f4d4a6e8f5",
                                                "sense_id": "42f199e4-938d-3600-9964-6e6b3fec612b",
                                                "text": "Chaque année, l’événement fait beaucoup de bruit, mais c’est plutôt rare qu’il fasse entendre sa voix en l’occurrence, celle de sa directrice, Nina Cohen, qui lance un appel au soutien en vue de sa 6ᵉ édition du Paris Podcast Festival (PPF), l'un des grands rendez-vous annuels de l'audio parlé."
                                            },
                                            {
                                                "example_id": "f9481a88-d9f5-467e-a61e-82d45e57fca9",
                                                "sense_id": "42f199e4-938d-3600-9964-6e6b3fec612b",
                                                "text": "Touchée par quatre balles, Nina Wiley aurait dû y rester."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e724896d-ad47-4f07-b428-de9097feec4a",
                        "source_entry_id": "ae8ed9a9-13dd-35be-8e72-1f087fa49199",
