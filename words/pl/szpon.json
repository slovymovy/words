    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acb89159-1ee3-331d-8d31-bf66ff325c15",
                    "sense_definition": "ostry, zakrzywiony pazur ptaka drapieżnego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pazur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Orzeł chwycił zdobycz w swoje ostre <w>szpony</w>.",
                            "target_lang_translations": {
                                "ru": "Орёл схватил добычу в свои острые <w>когти</w>."
                            }
                        },
                        {
                            "text": "Sokół wbił <w>szpony</w> w upolowaną mysz.",
                            "target_lang_translations": {
                                "ru": "Сокол вонзил <w>когти</w> в пойманную мышь."
                            }
                        }
                    ],
                    "synonyms": [
                        "pazur"
                    ],
                    "common_phrases": [
                        "wpaść w szpony"
                    ],
                    "target_lang_definitions": {
                        "ru": "острый, загнутый коготь хищной птицы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коготь",
                                "target_lang_sense_clarification": "острый коготь птицы или зверя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ad23d3-e0a1-3fe0-8a17-8a65d0173e25",
                    "sense_definition": "bardzo długi i zaniedbany paznokieć",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pazur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiedźma miała długie, brudne <w>szpony</w> zamiast paznokci.",
                            "target_lang_translations": {
                                "ru": "У ведьмы были длинные, грязные <w>когти</w> вместо ногтей."
                            }
                        },
                        {
                            "text": "Musisz obciąć te <w>szpony</w>, bo wyglądają niechlujnie.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно подстричь эти <w>когти</w>, потому что они выглядят неопрятно."
                            }
                        }
                    ],
                    "synonyms": [
                        "szpona"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень длинный и неухоженный ноготь человека"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коготь",
                                "target_lang_sense_clarification": "переносное значение: длинный, неопрятный ноготь человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69d6648f-cbfc-3d38-aea6-a56a850cce5d",
                    "sense_definition": "dłoń z powykrzywianymi lub zaciśniętymi palcami przypominająca pazury",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pazur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starzec wyciągnął w moją stronę swoje chude <w>szpony</w>.",
                            "target_lang_translations": {
                                "ru": "Старик протянул в мою сторону свои худые <w>когти</w>."
                            }
                        },
                        {
                            "text": "Zacisnął dłonie w <w>szpony</w> z wściekłości.",
                            "target_lang_translations": {
                                "ru": "Он сжал ладони в <w>когти</w> от ярости."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "кисть руки с искривленными или сжатыми пальцами, напоминающая когти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когти",
                                "target_lang_sense_clarification": "переносное значение: руки, скрюченные пальцы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}