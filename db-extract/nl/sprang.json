                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fa4a65d7-5a5f-37cb-99be-f89ec5878aad",
                        "entry_id": "c3b66a91-ca0e-3c2b-bcfa-5771a8d7f719",
                        "glosses": [
                            "vervaardiging van textiel door vlechten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976e5674-8cfe-4a08-895a-2b9c65e86278",
                                "sense_id": "fa4a65d7-5a5f-37cb-99be-f89ec5878aad",
                                "text": "Zoals wel meer technieken is het sprang uitgevonden, gebruikt, vergeten en herontdekt op verschillende plaatsen op de wereld."
                            },
                            {
                                "example_id": "d98535da-5780-4cf5-8be5-f04a63752e35",
                                "sense_id": "fa4a65d7-5a5f-37cb-99be-f89ec5878aad",
                                "text": "Het is dan ook niet zo vreemd dat na het borduren technieken als Egyptisch vlechten – tegenwoordig sprang geheten –, raffiawerk en handweven opbloeiden door propaganda van de op rationalistische leest geschoeide V.A.N.K.-dames."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "1b2cd76e-95c0-4ba4-8684-2ffaf0f1d371",
                        "source_entry_id": "c3b66a91-ca0e-3c2b-bcfa-5771a8d7f719",
                        "source_sense_ids": [
                            "fa4a65d7-5a5f-37cb-99be-f89ec5878aad"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Egyptisch vlechten"
                    }
                ]
            },
            {
                "entry_id": "afa74ffc-5326-34c5-81d1-a7e19e58e262",
