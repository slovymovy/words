                    "frequency": "Low",
                    "semantic_group_id": "marine_marchande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine a supervisé l'<w>armement</w> du cargo avant son grand voyage vers l'Asie."
