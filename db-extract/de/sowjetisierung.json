                            {
                                "example_id": "b552391e-a7de-4ea2-843e-a966b6b316fb",
                                "sense_id": "c320b729-e727-3f7d-9b19-bc885b2758a7",
                                "text": "„Die Phase der eigentlichen, der öffentlichen und der mehr oder weniger rasanten Sowjetisierung begann bekanntlich erst im Sommer 1948.“"
                            },
                            {
                                "example_id": "aecdf8db-28d9-49f9-9a91-6492797bc6d3",
                                "sense_id": "c320b729-e727-3f7d-9b19-bc885b2758a7",
                                "text": "„Noch vor Gründung der DDR beginnt 1949 in der gesamten Sowjetischen Besatzungszone die Kampagne ‚Sport auf Produktionsgrundlage‘. Sie ist der Auftakt zur Sowjetisierung des Sports, der in der Zone als Herausbildung einer sozialistischen Sportbewegung verkauft wird.“"
                            }
                        ],
