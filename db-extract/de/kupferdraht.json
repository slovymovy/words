                                "example_id": "84465cd9-1179-4aa0-9204-63a12f2bdc12",
                                "sense_id": "b5886d20-5197-3eba-977a-0552855f63e2",
                                "text": "Für die Reparatur der Stromleitung benötigte der Elektriker einen Kupferdraht."
                            },
                            {
                                "example_id": "73037e92-f974-4d0c-9680-0b89792c29ff",
                                "sense_id": "b5886d20-5197-3eba-977a-0552855f63e2",
                                "text": "„Sie bewiesen schließlich - eine notwendige Raumfahrertugend - Improvisationstalent und behalfen sich mit einem Stück Kupferdraht.“"
                            }
