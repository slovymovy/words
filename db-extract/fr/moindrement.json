        "fr-extract.jsonl": [
            {
                "entry_id": "20ce06d7-39a7-3373-b288-bb9b12c109f4",
                "word": "moindrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                        "entry_id": "20ce06d7-39a7-3373-b288-bb9b12c109f4",
                        "glosses": [
                            "De la moindre façon."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e683c8ad-5317-4d4a-a870-1843bdd7050c",
                                "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                                "text": "Il ne viendra de votre part si mince brochure où je sois le moindrement intéressé, que la réponse ne suive de près."
                            },
                            {
                                "example_id": "9c6249d6-e054-48fc-9612-1e8b2d7e9c26",
                                "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                                "text": "Lucienne.— Vous regarderiez comme une indélicatesse d’écorner le moindrement la fortune de votre femme, et quand il s’agit de cet autre bien qui lui appartient, qui lui est dû, qui fait partie du fonds social, la fidélité conjugale, ah ! vous en faites bon marché !"
                            },
                            {
                                "example_id": "c6f80038-b30a-40a3-8c36-c42bd889132d",
                                "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                                "text": "Les varices me travaillent les jambes, bonnes gens ! que je n’ai même plus la force de me faire le moindrement de cuisine."
                            },
                            {
                                "example_id": "96a8ff49-3008-4614-8112-2f2a8af23d71",
                                "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                                "text": "Il souffrait d’ailleurs de tout ce qui l’offusquait le moindrement."
                            },
                            {
                                "example_id": "23c4b706-d03e-45a5-9cb7-af696bad3351",
                                "sense_id": "7cbe24c4-bf46-3fa5-a1a1-1ef36bbcf5f8",
                                "text": "[…] ces histoires à dormir debout qu’aucun esprit le moindrement lucide n’aurait pu accepter !…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
