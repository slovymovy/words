                "senses": [
                    {
                        "sense_id": "cde7d44b-b4b6-3cc7-a4bd-ae485265d0c4",
                        "entry_id": "2bb9030c-c35d-39cb-b486-2f0fb4c761b2",
                        "glosses": [
                            "Langspielplatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56aacab3-095f-4b13-b5e7-634d3e5cc827",
                                "sense_id": "cde7d44b-b4b6-3cc7-a4bd-ae485265d0c4",
                                "text": "„Die andere LP hatte Renate für Papa gekauft, weil da ein Lied mit dem Titel Raskolnikoff drauf war, aber es war das falsche.“"
                            },
                            {
                                "example_id": "4c30eff8-715c-4715-8822-bca95a6d345b",
                                "sense_id": "cde7d44b-b4b6-3cc7-a4bd-ae485265d0c4",
                                "text": "„Die vorletzte der zehn LPs war gerade nach unten gefallen.“"
                            },
                            {
                                "example_id": "1ad5d114-ff0e-4242-8730-b98834bff8a5",
                                "sense_id": "cde7d44b-b4b6-3cc7-a4bd-ae485265d0c4",
                                "text": "„Er besaß eine LP und zwei Singles, die Springfield Ende der Sechziger veröffentlicht hatte, die Platten hatte er zur Zeit seines Wirtschaftsprüferstudiums an der Handelshochschule in Kopenhagen gekauft.“"
                            },
                            {
                                "example_id": "01460255-6585-4c66-9c77-c4d4ed78809f",
                                "sense_id": "cde7d44b-b4b6-3cc7-a4bd-ae485265d0c4",
                                "text": "„Ich legte die LP auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
