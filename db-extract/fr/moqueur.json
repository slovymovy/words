                        "source_sense_id": "48631e8b-2790-3c44-ae62-4f3effd7b180",
                        "target_lang_word": "catbird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catbird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b19b28-2cb8-3c89-a1e3-7bd46054b5f9",
                                        "entry_id": "800f808c-61b1-3d25-95d2-806f388eb99e",
                                        "glosses": [
                                            "An American passerine bird of the genera Dumetella and Melanoptila."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c44ebd-abf3-40bc-a46c-72b03251e242",
                                                "sense_id": "48b19b28-2cb8-3c89-a1e3-7bd46054b5f9",
                                                "text": "The catbird’s note exactly resembles the voice of a kitten, that a stranger to it would instantly conclude that such an animal \"had got bewildered in the branches\"."
                                            },
                                            {
                                                "example_id": "c0262b37-4ad3-4d23-8849-29846009db24",
                                                "sense_id": "48b19b28-2cb8-3c89-a1e3-7bd46054b5f9",
                                                "text": "I recall a catbird high in the water oak above, swinging like a rag amid the branches, jabbering and screeching [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f712af56-9df2-3fa9-8921-0e1a6bcbbabf",
                                        "entry_id": "800f808c-61b1-3d25-95d2-806f388eb99e",
                                        "glosses": [
                                            "Any of four species of Australasian bowerbirds of the genera Ailuroedus and Scenopoeetes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8699d369-af0c-41be-b67a-379a5e1b9e88",
                                                "sense_id": "f712af56-9df2-3fa9-8921-0e1a6bcbbabf",
                                                "text": "The cat bird had a forlorn cry, like a whimpering child or the animal it is named for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f23ad8-8f55-3c6e-a90b-03e69e16c892",
                                        "entry_id": "800f808c-61b1-3d25-95d2-806f388eb99e",
                                        "glosses": [
                                            "A babbler-like bird from eastern Africa, Parophasma galinieri."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
