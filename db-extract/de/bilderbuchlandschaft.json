                ],
                "senses": [
                    {
                        "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                        "entry_id": "780b3bc0-8fd9-3d25-93a7-e101aed7221b",
                        "glosses": [
                            "Ort, der als besonders schön empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab8e6cb-a62e-4a0d-a657-bf6d5f27cb36",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "„In dieser Bilderbuchlandschaft können wir uns perfekt erholen.“"
                            },
                            {
                                "example_id": "cb4d6bbe-404d-40c8-90b9-b9facffa59f1",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "Von der Allgäuer Bilderbuchlandschaft bis zum geheimnisumwitterten Märchenkönig Ludwig II. - Neuschwanstein muss man gesehen haben!"
                            },
                            {
                                "example_id": "f3e1d18c-4b8c-4b9c-bf5e-6a801a3d0628",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "Bayerns schönste Seiten, Berge, Seen, Schlösser, bietet der Chiemgau auf einen Blick rund um den Chiemsee, begrenzt von den Chiemgauer Alpen. Im Winter sorgt der Schnee in der Bilderbuchlandschaft für zusätzliche Reize."
                            },
                            {
                                "example_id": "9643a2ea-8a3b-401d-af96-623164282216",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "[Balconevisi:] Der Name des Dorfs passt zum Panorama: Wie von einem Balkon blickt man hinab auf die Bilderbuchlandschaft der Toskana mit Feldern, Zypressenreihen, Wäldern und rostbraunen Gemäuern."
                            },
                            {
                                "example_id": "94869bcd-eb07-45f2-8d4b-85c9711899bd",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "[Finnland:] Umgeben von zahlreichen Seen, die jetzt alle zugefroren sind und großen und kleinen verschneiten Inseln mittendrin, zieht diese winterliche Bilderbuchlandschaft auch Besucher aus Mitteleuropa an."
                            },
                            {
                                "example_id": "32bd4926-3a28-435f-82b8-133c52f6378a",
                                "sense_id": "15edf53f-bd33-385b-8b76-7f13f8c1c964",
                                "text": "Heute jedoch spielt scheinbar die Geografie bei der Wahl des Ferienortes nur noch eine untergeordnete Rolle. Im Vordergrund stehen Sonne, Strand und Meer - klischeehafte Vorstellungen von einer Bilderbuchlandschaft und einer Bilderbucherholung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
