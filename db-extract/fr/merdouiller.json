                ],
                "senses": [
                    {
                        "sense_id": "d1f8afbe-4067-300b-bd64-da71a80f413a",
                        "entry_id": "f81bafab-945b-31d0-9673-dd57d0cbada3",
                        "glosses": [
                            "Merder ; merder un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8957e368-148e-4f36-bcea-89d8d1b220de",
                                "sense_id": "d1f8afbe-4067-300b-bd64-da71a80f413a",
                                "text": "Elle accaparait de ses trémolos douloureux notre petit monde rétréci où nous étions en train de merdouiller en chœur par sa faute."
                            },
                            {
                                "example_id": "f9a8c19f-6191-4e0c-94e6-881481c0e324",
                                "sense_id": "d1f8afbe-4067-300b-bd64-da71a80f413a",
                                "text": "Je savais que ma relation avec Isabelle merdouillait mais bon, elle était ma vie, j'aimais bien ça."
                            },
                            {
                                "example_id": "17945e8d-d62c-4e96-b0c8-d2e941c4df02",
                                "sense_id": "d1f8afbe-4067-300b-bd64-da71a80f413a",
                                "text": "Il l'avait prouvé lors de la mise en route des nouvelles machines à Trokenkäse. Celles-ci, montées en place par l'équipe du fournisseur, ne donnèrent pas satisfaction à la mise en route; l'équipe de montage merdouilla pendant quelques jours pour trouver les causes de ces difficultés."
                            }
                        ]
                    }
