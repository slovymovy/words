                        ],
                        "examples": [
                            {
                                "example_id": "0f647691-3730-4953-9e4f-8eaf4d71954d",
                                "sense_id": "768de33c-b8b9-3f96-b0c5-9d88c0158213",
                                "text": "Der Award für den besten Film ist mit hunderttausend Dollar dotiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5a4e8c2-3d70-3f16-bed8-e5bb14177639",
