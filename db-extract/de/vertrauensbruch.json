                "senses": [
                    {
                        "sense_id": "49b3cb56-de86-35ce-afae-7943ddde190f",
                        "entry_id": "22eb56e6-bbae-3ecb-a374-55e666d30aff",
                        "glosses": [
                            "Bruch des Vertrauens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2fee61-e4cf-43c7-b37a-a2830ef99179",
                                "sense_id": "49b3cb56-de86-35ce-afae-7943ddde190f",
                                "text": "„Ich muß hier bemerken, daß die Forlanen in Venedig Dienstmänner waren, die ein besonderes Vertrauen genossen; man hatte niemals gehört, daß einem von ihnen auch nur der geringste Vertrauensbruch vorgeworfen werden konnte.“"
                            },
                            {
                                "example_id": "a5122335-a862-40cf-9a65-989bf37b8ce2",
                                "sense_id": "49b3cb56-de86-35ce-afae-7943ddde190f",
                                "text": "„Die heisere Stimme klang so ärgerlich, als hätte Lillian einen Vertrauensbruch begangen.“"
                            },
                            {
                                "example_id": "4feebf12-12c4-448d-b624-cdd1a804fdc1",
                                "sense_id": "49b3cb56-de86-35ce-afae-7943ddde190f",
                                "text": "„Ferris konnte sich über seinen Sieg nicht richtig freuen, weil er wusste, dass er einen Vertrauensbruch begangen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
