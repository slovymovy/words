                ],
                "senses": [
                    {
                        "sense_id": "f79b1a2e-b72e-32cf-a9a6-cfafb5d35f37",
                        "entry_id": "b465b0be-bea1-3800-bce9-ea568d9b982f",
                        "glosses": [
                            "женск. к велосипедист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d25efc8-23b1-427e-ab19-af3da060f65c",
                                "sense_id": "f79b1a2e-b72e-32cf-a9a6-cfafb5d35f37",
                                "text": "Неброское благополучие горожан проскальзывает в неспешном ритме их жизни, спокойных лицах пешеходов и многочисленности велосипедисток."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "742574f0-ac75-4e45-bb65-ba9d662234f7",
                        "source_entry_id": "b465b0be-bea1-3800-bce9-ea568d9b982f",
                        "source_sense_id": "f79b1a2e-b72e-32cf-a9a6-cfafb5d35f37",
                        "target_lang_word": "cycliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105e27c2-68b4-35f4-ba9d-d48b0ce056be",
                                        "entry_id": "e85d81cc-c60c-3e90-b926-63a879844ed1",
                                        "glosses": [
                                            "Qui concerne le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui pratique le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c548dc8-b999-47df-85d0-ef11d3aa8d09",
                                                "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                                "text": "Entre La Couarde-sur-Mer et Ars-en-Ré, le cycliste découvrira les marais salants qui se déploient à perte de vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui va à bicyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4708f6e5-6bc4-4f7f-a72f-a170ce93b93e",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "On me dit qu'un cycliste est tombé de sa machine, et que, dans sa chute, son fusil est parti tout seul: alors on a fait feu dans sa direction."
                                            },
                                            {
                                                "example_id": "b0cff143-77fc-4a49-865a-6fde15365abd",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "— Il ne doit pas y avoir beaucoup de cyclistes dans Paris. Surtout place de la Concorde…\n— On m’a dit qu’il y en avait encore…\n— C’est vrai, s’écria Busard. J’en ai même connu un. Il est venu en vacances ici. C’était un porteur de journaux.\n— Il y a longtemps ?\n— En 1946.\n— Maintenant les porteurs de journaux doivent avoir des mobylettes.\n— Pas nécessairement, dit Busard. Ça dépend du prix de revient et de l’amortissement."
                                            },
                                            {
                                                "example_id": "d3ec2751-4324-44d7-824e-feeefd981764",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "Le cataphote rouge vacille et brille à l'arrière de la bicyclette et bouge suivant les zigzags et les mouvements que fait le cycliste invisible sur la selle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                        "entry_id": "c758381d-37e9-3b6a-9125-1281d9391c09",
                                        "glosses": [
                                            "Short moulant, à l'origine porté par les cyclistes puis devenu un vêtement à la mode pour les femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85be8df9-48fe-4fbe-8864-0a018447cc7a",
                                                "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                                "text": "L’homme porte un cycliste noir, et c’est tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
