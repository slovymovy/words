                        "glosses": [
                            "Qui contient de l’anthracène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92eb1b49-d545-47c6-830a-efe32bb15495",
                                "sense_id": "ef4b5c56-bb56-3128-8b10-fb26fb7ab800",
                                "text": "La sève (suc ou latex) contient des teneurs significatives de dérivés anthracéniques."
                            },
                            {
                                "example_id": "b966999f-0620-4db1-9ad1-e6e00cd63f88",
                                "sense_id": "ef4b5c56-bb56-3128-8b10-fb26fb7ab800",
                                "text": "Les dérivés anthracéniques ou anthracénosides sont chimiquement des quinones et plus particulièrement d’anthraquinone."
                            },
                            {
                                "example_id": "73258002-37c5-49d6-a9e4-b8f928711f42",
                                "sense_id": "ef4b5c56-bb56-3128-8b10-fb26fb7ab800",
                                "text": "Les hétérosides anthracéniques, ou plus précisément les hétérosides hydroxyanthracéniques, sont des composés d’origine végétale, ayant des propriétés laxatives."
                            }
                        ]
                    }
                ],
