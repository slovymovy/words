{
    "word_family": [
        "poshly",
        "poshness",
        "poshen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50034567-24a3-3d87-b1c1-28a0a532bf74",
                    "sense_definition": "Stylish, elegant, and expensive in a way that suggests high quality or luxury.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "luxury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the performance, they went out to a very <w>posh</w> restaurant in the city center.",
                            "target_lang_translations": {
                                "ru": "После выступления они отправились в очень <w>шикарный</w> ресторан в центре города.",
                                "zh": "演出结束后，他们去市中心一家非常<w>高档</w>的餐厅吃饭。"
                            }
                        },
                        {
                            "text": "The hotel lobby was incredibly <w>posh</w> with marble floors and gold decorations.",
                            "target_lang_translations": {
                                "ru": "Вестибюль отеля был невероятно <w>фешенебельным</w>, с мраморными полами и золотым декором.",
                                "zh": "酒店大堂铺着大理石地面，配着金色装饰，显得非常<w>豪华</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "high-end"
                    ],
                    "antonyms": [
                        "cheap",
                        "shabby"
                    ],
                    "common_phrases": [
                        "posh restaurant",
                        "posh hotel",
                        "posh area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стильный, элегантный и дорогой, указывающий на высокое качество или роскошь.",
                        "zh": "时髦、优雅而且昂贵，给人一种高品质或奢华的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шикарный",
                                "target_lang_sense_clarification": "роскошный и дорогой"
                            },
                            {
                                "target_lang_word": "фешенебельный",
                                "target_lang_sense_clarification": "о заведениях или районах"
                            },
                            {
                                "target_lang_word": "элитный",
                                "target_lang_sense_clarification": "высокого класса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高档的",
                                "target_lang_sense_clarification": "形容地方、事物等高档而有档次"
                            },
                            {
                                "target_lang_word": "豪华的",
                                "target_lang_sense_clarification": "强调豪华、气派"
                            },
                            {
                                "target_lang_word": "很讲究的",
                                "target_lang_sense_clarification": "偏口语，指时髦又贵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddba28ef-cc68-3ffb-aac6-f7fa177f5c7e",
                    "sense_definition": "Associated with or characteristic of the upper social classes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She speaks with a <w>posh</w> accent that makes her sound very well-educated.",
                            "target_lang_translations": {
                                "ru": "Она говорит с <w>аристократическим</w> акцентом, из-за чего кажется очень образованной.",
                                "zh": "她说话带着一种很<w>上流社会的</w>口音，让人觉得她受过很好的教育。"
                            }
                        },
                        {
                            "text": "He comes from a <w>posh</w> family with a long history of wealth.",
                            "target_lang_translations": {
                                "ru": "Он родом из <w>элитной</w> семьи с долгой историей богатства.",
                                "zh": "他出身于一个十分<w>显贵的</w>家庭，家族富有已久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "upper-crust"
                    ],
                    "antonyms": [
                        "working-class"
                    ],
                    "common_phrases": [
                        "posh accent",
                        "posh school",
                        "posh family"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe social status"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с высшими слоями общества или характерный для них.",
                        "zh": "与社会上层阶级有关，或具有这类阶层特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аристократический",
                                "target_lang_sense_clarification": "свойственный высшему обществу"
                            },
                            {
                                "target_lang_word": "элитарный",
                                "target_lang_sense_clarification": "принадлежащий к элите"
                            },
                            {
                                "target_lang_word": "престижный",
                                "target_lang_sense_clarification": "о школах или семьях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上流社会的",
                                "target_lang_sense_clarification": "与上层社会有关"
                            },
                            {
                                "target_lang_word": "贵族式的",
                                "target_lang_sense_clarification": "带有贵族或上等人气派的"
                            },
                            {
                                "target_lang_word": "显贵的",
                                "target_lang_sense_clarification": "形容家庭、学校等社会地位高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc3f73fc-29d8-3358-aa3f-b1c46e911994",
                    "sense_definition": "Behaving in a snobbish or arrogant way, acting as if one is superior to others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't get all <w>posh</w> with me just because you got a promotion.",
                            "target_lang_translations": {
                                "ru": "Не строй из себя <w>важную персону</w> передо мной только потому, что получил повышение.",
                                "zh": "别因为升了职就对我这么<w>高傲</w>。"
                            }
                        },
                        {
                            "text": "We have a right <w>posh</w> git moving in next door who won't even say hello.",
                            "target_lang_translations": {
                                "ru": "К нам по соседству въезжает настоящий <w>высокомерный</w> придурок, который даже не здоровается.",
                                "zh": "隔壁搬来了一个特别<w>势利</w>的讨厌鬼，连招呼都不打。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stuck-up"
                    ],
                    "antonyms": [
                        "humble",
                        "down-to-earth"
                    ],
                    "common_phrases": [
                        "get posh",
                        "posh git"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used pejoratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ведущий себя высокомерно или заносчиво, как будто превосходя других.",
                        "zh": "举止势利或傲慢，表现得好像自己比别人高一等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заносчивый",
                                "target_lang_sense_clarification": "высокомерный"
                            },
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "смотрящий свысока"
                            },
                            {
                                "target_lang_word": "пижонистый",
                                "target_lang_sense_clarification": "разг., выставляющий напоказ статус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高傲",
                                "target_lang_sense_clarification": "待人傲慢，自以为高人一等"
                            },
                            {
                                "target_lang_word": "势利",
                                "target_lang_sense_clarification": "看不起别人，态度傲慢"
                            },
                            {
                                "target_lang_word": "目中无人的",
                                "target_lang_sense_clarification": "目中无人、摆架子的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35279b6a-369e-38f5-9291-5401e1b785bb",
                    "sense_definition": "To make something <w>posh</w> or more elegant and luxurious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>posh</w> up the living room with some new designer furniture.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>прихорошить</w> гостиную новой дизайнерской мебелью.",
                                "zh": "他们决定用一些新的设计师家具来<w>装点</w>客厅。"
                            }
                        },
                        {
                            "text": "The chef tried to <w>posh</w> up the traditional recipe by adding truffle oil.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар попытался <w>облагородить</w> традиционный рецепт, добавив трюфельное масло.",
                                "zh": "厨师试图加入松露油来<w>升级</w>这道传统食谱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poshen"
                    ],
                    "common_phrases": [
                        "posh up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used with 'up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более элегантным, роскошным или элитным.",
                        "zh": "把某物弄得更优雅、更豪华或更有档次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прихорашивать",
                                "target_lang_sense_clarification": "делать более нарядным"
                            },
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать более изысканным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装点",
                                "target_lang_sense_clarification": "把地方或事物弄得更体面、更讲究"
                            },
                            {
                                "target_lang_word": "升级",
                                "target_lang_sense_clarification": "使之更上档次"
                            },
                            {
                                "target_lang_word": "美化",
                                "target_lang_sense_clarification": "让外观或格调更好"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b3be0a36-3d10-31d4-a898-8a5a5e80505f",
                    "sense_definition": "The nickname for Peterborough United F.C., an English football club.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Posh</w> fans traveled in large numbers to support their team at the away game.",
                            "target_lang_translations": {
                                "ru": "Болельщики <w>«Пош»</w> приехали в большом количестве, чтобы поддержать свою команду на выездном матче.",
                                "zh": "许多<w>波什</w>球迷前往客场，为自己的球队助威。"
                            }
                        },
                        {
                            "text": "He has been a loyal supporter of the <w>Posh</w> since he was a young boy.",
                            "target_lang_translations": {
                                "ru": "Он был преданным болельщиком <w>«Пош»</w> с самого детства.",
                                "zh": "他从小就是<w>波什</w>的忠实支持者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Posh"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to UK football culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище английского футбольного клуба «Питерборо Юнайтед».",
                        "zh": "英格兰足球俱乐部彼得堡联的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Пош»",
                                "target_lang_sense_clarification": "прозвище клуба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波什",
                                "target_lang_sense_clarification": "彼得堡联足球俱乐部的昵称音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24642a46-046f-335a-a487-343bebc6dea6",
                    "sense_definition": "A term used to refer to money or coins of low value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't have a single <w>posh</w> in his pocket to buy a piece of bread.",
                            "target_lang_translations": {
                                "ru": "У него в кармане не было ни единого <w>гроша</w>, чтобы купить кусок хлеба.",
                                "zh": "他口袋里连一个<w>铜板</w>都没有，买不起一块面包。"
                            }
                        },
                        {
                            "text": "The old merchant counted every <w>posh</w> before closing his shop for the night.",
                            "target_lang_translations": {
                                "ru": "Старый купец пересчитывал каждую <w>монетку</w>, прежде чем закрыть лавку на ночь.",
                                "zh": "老商人晚上关店前，把每一个<w>铜板</w>都数了一遍。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Термин, используемый для обозначения денег или монет низкой стоимости.",
                        "zh": "指面值很小的钱或硬币的说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "мелкая монета"
                            },
                            {
                                "target_lang_word": "копейка",
                                "target_lang_sense_clarification": "в значении отсутствия денег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜板",
                                "target_lang_sense_clarification": "旧时指小额硬币"
                            },
                            {
                                "target_lang_word": "小钱",
                                "target_lang_sense_clarification": "泛指一点小钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02ba2fb3-935f-3551-a166-c2c45dd0968e",
                    "sense_definition": "A sudden, heavy downpour or gush of rain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been quite a <w>posh</w> of rain this afternoon, flooding the garden.",
                            "target_lang_translations": {
                                "ru": "Сегодня днем прошел настоящий <w>ливень</w>, затопивший сад.",
                                "zh": "今天下午下了好一阵<w>暴雨</w>，把花园都淹了。"
                            }
                        },
                        {
                            "text": "We were caught in a sudden <w>posh</w> of water while walking near the brook.",
                            "target_lang_translations": {
                                "ru": "Мы попали под внезапный <w>поток</w> воды, когда гуляли у ручья.",
                                "zh": "我们在小溪边散步时，突然被一股<w>急流</w>般的水冲得措手不及。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "posh of rain"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный сильный ливень или поток дождя.",
                        "zh": "突然出现的大雨，或猛然涌来的水流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливень",
                                "target_lang_sense_clarification": "сильный дождь"
                            },
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "сильный напор воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴雨",
                                "target_lang_sense_clarification": "突然下得很猛的雨"
                            },
                            {
                                "target_lang_word": "急流",
                                "target_lang_sense_clarification": "一大股冲来的水"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e9cd8330-b02b-3240-b61e-504d82b82d96",
                    "sense_definition": "An exclamation used to show contempt, disbelief, or derision.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Posh</w>!\" he cried, snapping his fingers at the ridiculous suggestion.",
                            "target_lang_translations": {
                                "ru": "«<w>Вздор</w>!» — вскричал он, щелкнув пальцами на нелепое предложение.",
                                "zh": "“<w>胡扯</w>！”他对那个荒唐的建议嗤之以鼻，还打了个响指。"
                            }
                        },
                        {
                            "text": "She dismissed his excuses with a sharp \"<w>Posh</w>!\" and walked away.",
                            "target_lang_translations": {
                                "ru": "Она отвергла его оправдания резким «<w>Чепуха</w>!» и ушла.",
                                "zh": "她厉声回了一句“<w>胡说</w>！”，便转身走开了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для выражения презрения, недоверия или насмешки.",
                        "zh": "表示轻蔑、不信或嘲讽的感叹语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "выражение недоверия"
                            },
                            {
                                "target_lang_word": "чепуха",
                                "target_lang_sense_clarification": "пренебрежительное восклицание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胡扯",
                                "target_lang_sense_clarification": "表示轻蔑或不信"
                            },
                            {
                                "target_lang_word": "胡说",
                                "target_lang_sense_clarification": "表示斥责或不屑"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}