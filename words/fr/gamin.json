                        }
                    ]
                },
                {
                    "sense_id": "96470d55-4457-3953-a800-02493695db98",
                    "sense_definition": "Fils ou fille, enfant d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enfant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle doit aller chercher ses <w>gamins</w> à l'école avant la fin de l'après-midi."
                        },
                        {
                            "text": "Son <w>gamin</w> lui ressemble énormément, surtout quand il sourit."
                        }
                    ],
                    "synonyms": [
                        "gosse"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "e1192d6b-cada-3669-b1a9-985e437a6fc4",
                    "sense_definition": "Enfant pauvre vivant ou traînant dans les rues des villes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enfant_rue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gavroche est le modèle le plus célèbre du <w>gamin</w> de Paris dans la littérature."
                        },
                        {
                            "text": "Plusieurs <w>gamins</w> sans abri se réchauffaient autour du feu allumé sur le trottoir."
                        }
                    ],
                    "common_phrases": [
                        "gamin de Paris",
                        "gamin des rues"
                    ]
                },
                {
                    "sense_id": "02eb353f-99db-32e6-a197-4f4c25b7d913",
                    "sense_definition": "Personne notablement plus jeune qu'une autre ou manquant de maturité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À quarante ans passés, il se conduit encore comme un <w>gamin</w> irresponsable."
                        },
                        {
                            "text": "Ne me traite pas comme un <w>gamin</w>, j'ai largement l'âge de comprendre la situation."
                        }
                    ],
                    "common_phrases": [
                        "comme un gamin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
