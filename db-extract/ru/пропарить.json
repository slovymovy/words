                                    },
                                    {
                                        "sense_id": "b395e55f-317a-325d-b661-6a16b6e8a5e5",
                                        "entry_id": "16d6eb5d-1edc-362e-8b59-1e613471e825",
                                        "glosses": [
                                            "A failure (something incapable of success)."
                                        ],
                                        "tags": [
