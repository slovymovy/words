                "senses": [
                    {
                        "sense_id": "35f87e22-cf8f-3829-8ca9-8f710326237b",
                        "entry_id": "80f1f2fc-8b82-3d1d-9600-33dcffd7e5a1",
                        "glosses": [
                            "Prinzip, dass etwas auch bei einem Anderen in gleichem Maße vorhanden ist; Wechselbeziehung, Korrelation"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0f432cf1-8d9c-311a-9d52-517dfd15d00e",
                        "entry_id": "80f1f2fc-8b82-3d1d-9600-33dcffd7e5a1",
                        "glosses": [
                            "Wechselwirkung, beidseitiger Austausch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c97e51f-8bb7-4884-971d-7272bd25d071",
                                "sense_id": "0f432cf1-8d9c-311a-9d52-517dfd15d00e",
                                "text": "Die Freundschaft beruhte auf Gegenseitigkeit."
                            },
                            {
                                "example_id": "f868dc9c-1cc1-4552-b6a0-5ae594335b52",
                                "sense_id": "0f432cf1-8d9c-311a-9d52-517dfd15d00e",
                                "text": "„Zu einer auf Gegenseitigkeit beruhenden Liebe müsste die jeweilige Kultur hinzukommen, nach deren Regeln die Tiefe der Beziehung erst ausgelotet werden könnte.“"
                            },
                            {
                                "example_id": "42fd8353-e391-4316-a8a7-5cfa8af2819a",
                                "sense_id": "0f432cf1-8d9c-311a-9d52-517dfd15d00e",
                                "text": "„Das beruhte wohl auf Gegenseitigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e26dd8b4-ee37-423a-8096-48d4098d9651",
                        "source_entry_id": "80f1f2fc-8b82-3d1d-9600-33dcffd7e5a1",
                        "source_sense_id": "35f87e22-cf8f-3829-8ca9-8f710326237b",
                        "target_lang_word": "reciprocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reciprocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "The characteristic of being reciprocal, e.g. of a relationship between people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0042d1cc-fa49-4d21-988d-a32fadbc522b",
                                                "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                                "text": "In a friendship, reciprocity occurs where the contribution of each party meets the expectations of the other party."
                                            },
                                            {
                                                "example_id": "86aa0878-b5d1-432b-9f99-1b8e26b70979",
                                                "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                                "text": "There might be benefit on one side, and obligation on the other; but their reciprocity of affection, their mutual exchange of small kindnesses—those strongest rivets of common attachment—were no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56dae442-1642-38a0-8544-b5e918b47d36",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A reciprocal relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ad3642a-7468-3e66-9492-761db6665529",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A relation of mutual dependence or action or influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d341069-d082-3e70-9467-c64ce0727012",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A reciprocal construction involves two noun phrases where each of the participants occupies both the role of agent and patient with respect to the other. see: Wikipedia:Reciprocal pronoun."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f950f99-0507-3d86-9fd1-69b4074a75e8",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "The mutual exchange of rights, privileges or obligations between nations. see: Wikipedia:Reciprocity (international relations)."
                                        ],
                                        "tags": [
                                            "countable",
