                            {
                                "example_id": "550d7362-4d11-41c9-ac4d-a8d4b6fdebe4",
                                "sense_id": "9417adbf-a300-379f-a1ce-8baff9b7a851",
                                "text": "Henk en Piet zagen het gevaar van de situatie in en pakten Rien stevig vast om te voorkomen dat hij opnieuw door het lint zou gaan."
                            },
                            {
                                "example_id": "c6174d3e-dbd7-4624-9857-484c11bc9b7a",
                                "sense_id": "9417adbf-a300-379f-a1ce-8baff9b7a851",
                                "text": "Nadat Rien de barak had verlaten, besloot hij om de groep Duitsers tegemoet te gaan met het door de jongens achtergelaten paard en de wagen, maar nog voor hij hen kon bereiken begonnen ze al op Piet en Henk te schieten."
                            }
                        ]
