{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa8671e4-1a2f-3cf2-bff0-e1e347de6adc",
                    "sense_definition": "An award, honor, or special acknowledgment given to someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_and_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new film is likely to win several prestigious <w>accolades</w> at the festival.________",
                            "target_lang_translations": {
                                "ru": "Новый фильм, скорее всего, завоюет несколько престижных <w>наград</w> на фестивале."
                            }
                        },
                        {
                            "text": "She received the highest <w>accolade</w> for her lifetime dedication to science.________",
                            "target_lang_translations": {
                                "ru": "Она получила высшее <w>признание</w> за преданность науке на протяжении всей жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "receive an accolade",
                        "highest accolade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награда, премия или особое признание за заслуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "приз, премия или официальное признание"
                            },
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "официальная похвала за заслуги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b217228a-1ea3-388f-9de2-eb0c2d5592bc",
                    "sense_definition": "An expression of strong approval or praise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_and_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director received warm <w>accolades</w> from critics after the premiere.________",
                            "target_lang_translations": {
                                "ru": "Режиссёр получил тёплые <w>похвалы</w> от критиков после премьеры."
                            }
                        },
                        {
                            "text": "His novel earned broad <w>accolade</w> across the literary community.________",
                            "target_lang_translations": {
                                "ru": "Его роман снискал широкое <w>одобрение</w> в литературном сообществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "panegyric"
                    ],
                    "common_phrases": [
                        "earn accolades",
                        "critical accolade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение сильного одобрения, высокого мнения или похвалы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похвала",
                                "target_lang_sense_clarification": "положительный, высокий отзыв"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "выражение высокого признания"
                            },
                            {
                                "target_lang_word": "панегирик",
                                "target_lang_sense_clarification": "восторженная похвала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a32ed573-e7b1-32e5-bc48-8ff44588859d",
                    "sense_definition": "A ceremony or touch marking the conferring of knighthood, traditionally consisting of a tap on the shoulder with a sword.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "knighthood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warrior knelt before the monarch to receive the final <w>accolade</w> of knighthood.________",
                            "target_lang_translations": {
                                "ru": "Воин преклонил колени перед монархом, чтобы пройти завершающий обряд <w>акколады</w> при посвящении в рыцари."
                            }
                        },
                        {
                            "text": "During the ceremony, the King gave the <w>accolade</w> using a ceremonial sword.________",
                            "target_lang_translations": {
                                "ru": "Во время церемонии король совершил <w>акколаду</w> с помощью церемониального меча."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give the accolade",
                        "receive the accolade"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обряд посвящения в рыцари, традиционно включающий прикосновение мечом к плечу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акколада",
                                "target_lang_sense_clarification": "исторический обряд посвящения в рыцари"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3e09bc3-a2f6-352d-8b87-8eac85a2288a",
                    "sense_definition": "An embrace or kiss given as a formal greeting or salutation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He welcomed his old friend with a traditional, formal <w>accolade</w>.________",
                            "target_lang_translations": {
                                "ru": "Он приветствовал своего старого друга традиционным формальным <w>объятием</w>."
                            }
                        },
                        {
                            "text": "The diplomats exchanged a respectful <w>accolade</w> before beginning their discussions.________",
                            "target_lang_translations": {
                                "ru": "Дипломаты обменялись уважительным <w>приветствием</w>, прежде чем начать переговоры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объятие или поцелуй в качестве официального или торжественного приветствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акколада",
                                "target_lang_sense_clarification": "торжественное объятие или приветствие"
                            },
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "ритуальное приветственное объятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f6d959a-f7ea-3dd0-ae0a-cde882234a06",
                    "sense_definition": "A curly bracket symbol used in typography or notation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer misplaced an <w>accolade</w> in the mathematical formula.________",
                            "target_lang_translations": {
                                "ru": "Печатник не там поставил <w>акколаду</w> в математической формуле."
                            }
                        },
                        {
                            "text": "Use an <w>accolade</w> to group these lines of text together.________",
                            "target_lang_translations": {
                                "ru": "Используйте <w>фигурную скобку</w>, чтобы объединить эти строки текста."
                            }
                        }
                    ],
                    "synonyms": [
                        "curly bracket"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "specialized typography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фигурная скобка, используемая в типографике, нотах или обозначениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акколада",
                                "target_lang_sense_clarification": "фигурная скобка в нотах или типографике"
                            },
                            {
                                "target_lang_word": "фигурная скобка",
                                "target_lang_sense_clarification": "знак скобки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f14b6b3-aae5-3966-af0a-c0a9a6f9ea97",
                    "sense_definition": "To bestow praise, honors, or awards upon someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "praise_and_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>accolade</w> the young scientist for her breakthrough discovery.________",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>наградить</w> молодого учёного за её прорывное открытие."
                            }
                        },
                        {
                            "text": "Critics warmly <w>accoladed</w> the new theatrical production.________",
                            "target_lang_translations": {
                                "ru": "Критики тепло <w>похвалили</w> новую театральную постановку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхвалять, выражать одобрение или награждать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалить",
                                "target_lang_sense_clarification": "высоко оценивать"
                            },
                            {
                                "target_lang_word": "награждать",
                                "target_lang_sense_clarification": "присуждать награду или выражать признание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c544273-2813-3250-b9da-74bd434a32ac",
                    "sense_definition": "To confer knighthood upon a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knighthood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monarch chose to <w>accolade</w> the brave general after his victorious campaign.________",
                            "target_lang_translations": {
                                "ru": "Монарх решил <w>посвятить в рыцари</w> храброго генерала после его победоносного похода."
                            }
                        },
                        {
                            "text": "He was officially <w>accoladed</w> in the royal court yesterday.________",
                            "target_lang_translations": {
                                "ru": "Вчера в королевском дворе его официально <w>посвятили в рыцари</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посвящать человека в рыцари."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвящать в рыцари",
                                "target_lang_sense_clarification": "совершать обряд посвящения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}