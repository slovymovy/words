                                        "entry_id": "99afa5ea-539d-3dfa-a1b6-e5c335557d34",
                                        "glosses": [
                                            "saftreiche Pflanze, die an besondere Klima- und Bodenverhältnisse angepasst ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b34890-564d-4daf-8ad8-1c60d65a8eb7",
                                                "sense_id": "0f21c6bd-515b-37aa-9b76-ccebe577edf6",
                                                "text": "„Einige Hauseigentümer hatten den Rasen durch Kies, Sand und niedrige Sukkulenten ersetzt.“"
