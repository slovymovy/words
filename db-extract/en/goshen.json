                "senses": [
                    {
                        "sense_id": "ea2a7565-d917-30ef-ab6f-820a0ef6cd00",
                        "entry_id": "67a4f169-22ba-3de7-8918-815d3ce62687",
                        "glosses": [
                            "A land of light and plenty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d832ac-a62d-4e8c-9e83-c7b0ac394a46",
                                "sense_id": "ea2a7565-d917-30ef-ab6f-820a0ef6cd00",
                                "text": "The possessions of these Abbies were each a sort of Goshen, enjoying the calm light of peace and immunity."
                            },
                            {
                                "example_id": "5a1b0f26-5a03-43d1-a577-44c8feb7ee93",
                                "sense_id": "ea2a7565-d917-30ef-ab6f-820a0ef6cd00",
                                "text": "Having taken this journey in order to escape the inclemencies I had suffered on the fifty-first parallel, I had hoped, I must confess, to enter a true Goshen on the forty-eighth."
                            }
                        ]
                    }
                ],
