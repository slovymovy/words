                "senses": [
                    {
                        "sense_id": "7b32e6c0-053a-3736-bb9c-605259fc5d6b",
                        "entry_id": "6bb035e2-bf47-372d-a8c1-2a1e53dabca1",
                        "glosses": [
                            "eine Person, die gerne und lange in den Morgen hinein schläft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac7e63e-ecb2-44a0-a101-5001590c4b84",
                                "sense_id": "7b32e6c0-053a-3736-bb9c-605259fc5d6b",
                                "text": "Er ist in der Regel kein Langschläfer."
                            },
                            {
                                "example_id": "e5711f97-8fbb-4520-8317-dee67d033943",
                                "sense_id": "7b32e6c0-053a-3736-bb9c-605259fc5d6b",
                                "text": "„Dabei war Paris einmal die Stadt der Boheme und der Langschläfer, der großen Denker an Café-Tischen und der Faulenzer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8cda857-6842-4748-9d78-e25461df19c6",
                        "source_entry_id": "6bb035e2-bf47-372d-a8c1-2a1e53dabca1",
                        "source_sense_id": "7b32e6c0-053a-3736-bb9c-605259fc5d6b",
                        "source_sense_description": "eine Person, die gerne und lange in den Morgen hinein schläft",
                        "target_lang_word": "late riser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "late riser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47cd5984-83ac-3b11-9f7e-58943036e2b1",
                                        "entry_id": "4c57f15e-6d27-3a88-95f7-25f029a7fe05",
                                        "glosses": [
                                            "Someone who gets up late in the morning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f130937d-05f3-42c4-bbde-b3f09c693dcb",
                                                "sense_id": "47cd5984-83ac-3b11-9f7e-58943036e2b1",
                                                "text": "One oddity of the Scottish Region timetable is that the special page (52) devoted to the \"Midday Scot\" shows, among other meal prices, that of breakfast, on trains beginning their journeys at 1.30 p.m. Some Scots (or Sassenachs) would appear to be late risers!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e250e400-fd86-44fe-a6c0-54a21821cb4b",
                        "source_entry_id": "6bb035e2-bf47-372d-a8c1-2a1e53dabca1",
                        "source_sense_id": "7b32e6c0-053a-3736-bb9c-605259fc5d6b",
                        "source_sense_description": "eine Person, die gerne und lange in den Morgen hinein schläft",
                        "target_lang_word": "lève-tard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lève-tard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                        "entry_id": "2b6de876-3f9d-3a19-87b4-6dfa143fe3d0",
                                        "glosses": [
                                            "Qui aime se lever tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fbadee7-4596-479c-a69e-e09f717143df",
                                                "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                                "text": "Avec l'adolescence, la fille est devenue lève-tard."
                                            },
                                            {
                                                "example_id": "1bccded5-657d-4a63-956d-e2f2b33a3028",
                                                "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                                "text": "Le buraliste, plutôt lève-tard et de mauvaise humeur, montait à peine son rideau de fer récalcitrant en poussant quelques jurons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lève-tard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                        "entry_id": "db8630d3-08ff-3524-8dd5-2ced04806f91",
                                        "glosses": [
                                            "Personne qui a l’habitude de se lever tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ae31ac-1ed3-4a67-a184-83775bd5fa81",
                                                "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                                "text": "Je ne suis pas du matin, je suis un lève-tard."
                                            },
                                            {
                                                "example_id": "22a3401e-ca59-4a13-b491-6ce5fde16d97",
                                                "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                                "text": "Maria, dans son tablier noir de satinette à fleurs, m’accueillit au bas de l’escalier avec cette chaleur un peu moqueuse qu’on réserve aux lève-tard, mais m’abandonna ensuite devant mon bol de thé au lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
