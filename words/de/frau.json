                    ],
                    "antonyms": [
                        "Herr"
                    ],
                    "common_phrases": [
                        "sehr geehrte Frau"
                    ]
                },
                {
                    "sense_id": "7ac69076-c0c8-3ca4-8923-44b3ffa2ef72",
                    "sense_definition": "Höfliche Anrede in Verbindung mit einer Amts-, Berufs- oder Funktionsbezeichnung",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vielen Dank für Ihre Antwort, <w>Frau</w> Ministerin, das beantwortet meine Frage vollständig."
                        },
                        {
                            "text": "„<w>Frau</w> Präsidentin, ich bitte ums Wort“, sagte der Abgeordnete."
                        }
                    ],
                    "antonyms": [
                        "Herr"
                    ],
                    "common_phrases": [
                        "Frau Präsidentin",
                        "Frau Ministerin"
                    ]
                },
                {
                    "sense_id": "31be9655-c122-37dd-8202-9b22656f9046",
                    "sense_definition": "Herrin oder Dame von höherem gesellschaftlichen Stand",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Frau</w> des Hauses führte die Gäste durch den großen Garten des Anwesens."
                        },
                        {
                            "text": "Er verbeugte sich höflich und wünschte der gnädigen <w>Frau</w> einen angenehmen Abend."
                        }
                    ],
                    "synonyms": [
                        "Herrin",
                        "Dame"
                    ],
                    "antonyms": [
                        "Herr"
                    ],
                    "common_phrases": [
