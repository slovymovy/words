                        "source_entry_id": "adacd3dd-a310-3a73-8b6f-a2e6c8e0885f",
                        "source_sense_id": "7c9ff74b-809a-3e0b-a0ba-ea26fe6f8d1e",
                        "target_lang_word": "problémiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "problémiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38d6715a-76c7-3582-9018-0473f3d8be3f",
                                        "entry_id": "dcaaa9e4-cdb0-368b-a0d3-68138d5e30d2",
                                        "glosses": [
                                            "Compositeur de problèmes d’échecs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc43be11-dd5a-4b5b-ac59-334986ddcd22",
                                                "sense_id": "38d6715a-76c7-3582-9018-0473f3d8be3f",
                                                "text": "Ce chassé-croisé entre les fausses pistes et les solutions est l’une des caractéristiques de l’écriture de Nabokov qui était à la fois écrivain, entomologiste et problémiste (compositeur de problèmes de jeu d’échec)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3406e86-db6a-3d46-b123-0e24381d4d0e",
                                        "entry_id": "dcaaa9e4-cdb0-368b-a0d3-68138d5e30d2",
                                        "glosses": [
                                            "Solutionniste, amateur de problèmes d’échecs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c7a4ed-0996-4b2c-b937-0fa2bc51adb8",
                                                "sense_id": "a3406e86-db6a-3d46-b123-0e24381d4d0e",
                                                "text": "Le véritable problémiste-solutionniste n’est pas seulement celui qui aime résoudre les problèmes d’échecs. Pour mériter ce titre, il faut savoir s’intéresser aux thèmes […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc57ff2-dfaa-327d-8ca6-be16b96c18d0",
                                        "entry_id": "dcaaa9e4-cdb0-368b-a0d3-68138d5e30d2",
                                        "glosses": [
                                            "Compositeur de problèmes de jeu de dames."
                                        ],
                                        "tags": [
                                            "Jeu de dames"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77eabe29-3d11-4983-8bec-7adda57809a9",
                                                "sense_id": "7bc57ff2-dfaa-327d-8ca6-be16b96c18d0",
                                                "text": "[…], l’organisation des concours et championnats, la remise des trophées, la participation d’Haïti au concours international de problémistes par correspondance, la publicité par les voies de la presse et de la radio et tant d’autres initiatives qui font honneur à cette société."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
