                                        "sense_id": "462b2218-e553-3f91-9415-144fa77bd64c",
                                        "entry_id": "c7dad9d2-da1a-3c24-90ea-5531aa337b41",
                                        "glosses": [
                                            "Complacimiento exagerado acerca de galanura de la imagen y de las capacidades de la propia persona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6d7490-7582-4b4a-8ef6-ea4e89a7f664",
                                                "sense_id": "462b2218-e553-3f91-9415-144fa77bd64c",
                                                "text": "El narcisismo o trastorno narcisista es un diagnóstico dentro de la clasificación de los trastornos de la personalidad. La rabia narcisista se produce cuando una persona con narcisismo percibe que está siendo atacada por otra."
                                            }
