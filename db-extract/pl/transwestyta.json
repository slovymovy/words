                                    {
                                        "sense_id": "8d743d2f-d99c-36d1-830c-fb0d1e30c227",
                                        "entry_id": "1b8d4dd8-4563-399f-a5b1-3631190803c8",
                                        "glosses": [
                                            "sich wie eine Frau kleidender Mann"
