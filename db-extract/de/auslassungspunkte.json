                "senses": [
                    {
                        "sense_id": "543a3c09-c889-3fe5-979c-fb7b5b3b28e3",
                        "entry_id": "d28201a3-8379-32ce-a8a0-51637dffa33f",
                        "glosses": [
                            "drei aufeinanderfolgende Punkte in einem Text, womit die Auslassung eines Teils der ursprünglichen Aussage angezeigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4caad628-2811-4fc8-8236-c162be014659",
                                "sense_id": "543a3c09-c889-3fe5-979c-fb7b5b3b28e3",
                                "text": "„Sodann folgen die drei lieb gewordenen Auslassungspunkte, und - sagen wir auf Position 34 - erscheint der Name des finnischen Teilnehmers …“"
                            },
                            {
                                "example_id": "f77456c5-ce88-410f-add9-b01ce8a14b3a",
                                "sense_id": "543a3c09-c889-3fe5-979c-fb7b5b3b28e3",
                                "text": "„Stehen Auslassungspunkte am Satzende, entfällt der Satzschlusspunkt <§ 100>.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "add82f53-7dca-404a-a8d6-84fbf393ed66",
                        "source_entry_id": "d28201a3-8379-32ce-a8a0-51637dffa33f",
                        "source_sense_id": "543a3c09-c889-3fe5-979c-fb7b5b3b28e3",
                        "source_sense_description": "drei aufeinanderfolgende Punkte in einem Text, die eine Auslassung von Textteilen anzeigt",
                        "target_lang_word": "ellipsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ellipsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "A mark consisting of multiple full stops (with or without spaces), used to indicate omitted, missing, or illegible words; or (in mathematics) that a pattern continues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf88038-6e9d-492a-aeda-4158de5046c7",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 1, 2, 3, ..., 8, 9 means that the numbers 4, 5, 6, and 7 are not explicitly included, but are considered to be part of the pattern."
                                            },
                                            {
                                                "example_id": "24622cfa-058e-46aa-8f76-333fcec80359",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 0.333... means that the number is a repeating decimal, having threes that go on forever."
                                            },
                                            {
                                                "example_id": "cecd226d-42d0-411a-a1f9-6c6eee952733",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "CARD: Hey Baby. Thanks for the … last night. Love you!\nHAZEL: Wow. I've never despised an ellipsis so much in my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d55e460-36e9-3e95-b838-e68742767733",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of a word or phrase that can be inferred from the context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of scenes in a film that do not advance the plot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751686c1-4bac-411c-92d7-ea793c111853",
                                                "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                                "text": "It was now possible for writers and directors to cut scenes that did not further the plot; called \"ellipses\" by filmmakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ab923c-841e-3ec5-83f9-fa8f981c656f",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "An ellipse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "665cec8e-97a6-45ce-ad54-4f7eb6173b44",
                        "source_entry_id": "d28201a3-8379-32ce-a8a0-51637dffa33f",
                        "source_sense_id": "543a3c09-c889-3fe5-979c-fb7b5b3b28e3",
                        "source_sense_description": "drei aufeinanderfolgende Punkte in einem Text, die eine Auslassung von Textteilen anzeigt",
                        "target_lang_word": "points de suspension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "points de suspension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37156411-d263-363f-ad1d-b79b198dc19c",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une incomplétude de la phrase ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5002ba36-d83f-47d6-b874-4262813ab90e",
                                                "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                                "text": "Les points de suspension ont la même signification grammaticale que les points si l’on s’arrête après eux, et sont donc suivi d’une majuscule."
                                            },
                                            {
                                                "example_id": "1f5fd248-2e8a-4a25-9691-00f54e009739",
                                                "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                                "text": "Et points de suspension, si commodes pour exprimer tout ce qu’on ne dit pas ! Il devrait s’appeler point de sous-entendu, çui-là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ed00c5-db20-3541-90f4-3056aac543af",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une hésitation ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6df49c9-5a11-4643-b230-cf1b31b81f51",
                                                "sense_id": "b9ed00c5-db20-3541-90f4-3056aac543af",
                                                "text": "Si les points de suspension expriment une hésitation, ils jouent un rôle équivalent au point-virgule, et la reprise de la phrase se fait sans majuscule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc2d588-1143-3172-9210-8558d78d7a4d",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une élision, une coupure ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf2f91c-6617-4a06-87f6-1ea5dfbe93f1",
                                                "sense_id": "cdc2d588-1143-3172-9210-8558d78d7a4d",
                                                "text": "Pour indiquer un passage coupé dans une citation, on emploie les points de suspension entre crochets : « […] »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abcee2d-70e9-3334-bc37-be06b0660f37",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "équivalent de etc. dans une liste incomplète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44994a-cf19-422b-b1be-8b316ea0dc62",
                                                "sense_id": "8abcee2d-70e9-3334-bc37-be06b0660f37",
                                                "text": "Les points de suspension finaux dans la phrase « J’ai acheté des pommes, des poires, des ananas… » suggèrent que les emplettes ont été fructueuses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "points de suspension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5034eda-891a-30c9-b7bb-b1deb45c7346",
                                        "entry_id": "c429e534-f802-3fe0-81f2-6f5fdcef468b",
                                        "glosses": [
                                            "Pluriel de point de suspension."
                                        ],
                                        "tags": [
                                            "form-of"
