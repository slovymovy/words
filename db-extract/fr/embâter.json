                "senses": [
                    {
                        "sense_id": "628a43b2-068c-350e-bfc1-cda1b330b13a",
                        "entry_id": "52912f6f-ac30-37f9-b184-c83a5e6d931a",
                        "glosses": [
                            "Charger d’un bât."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa274605-7c84-408c-bc79-d21663dba3fb",
                                "sense_id": "628a43b2-068c-350e-bfc1-cda1b330b13a",
                                "text": "Embâter un cheval, un âne."
                            },
                            {
                                "example_id": "e65ed07a-6909-4236-9950-65ff74410298",
                                "sense_id": "628a43b2-068c-350e-bfc1-cda1b330b13a",
                                "text": "– À qui est le cheval qui hersait l’autre matin ?\n– C’est un mulet, dit l’homme qui avait eu le fusil.\n– Embâte-le et sors-le, dit Angelo."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a3766ad-cbbe-3230-8ad6-37a0c076c6c2",
                        "entry_id": "52912f6f-ac30-37f9-b184-c83a5e6d931a",
                        "glosses": [
                            "Charger quelqu’un d’une chose qui l’incommode."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "abeb7450-90e9-4f6f-9388-ff6724f3e851",
                                "sense_id": "3a3766ad-cbbe-3230-8ad6-37a0c076c6c2",
                                "text": "On l’a embâté d’une affaire bien désagréable."
                            },
                            {
                                "example_id": "554a43e9-0313-4726-981c-0afe8295d3e6",
                                "sense_id": "3a3766ad-cbbe-3230-8ad6-37a0c076c6c2",
                                "text": "Frédéric fut aise de n’avoir pas à rédiger sa partie.\nMais beaucoup moins d’être embâté du travail de Campas pour ce qui concernait les effectifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9fa0a56-d7ce-3c7c-a557-f031bd68d375",
                        "entry_id": "52912f6f-ac30-37f9-b184-c83a5e6d931a",
                        "glosses": [
                            "Se dit aussi en parlant des personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f4ddc4-7914-4084-90e3-7d473f31d45d",
                                "sense_id": "e9fa0a56-d7ce-3c7c-a557-f031bd68d375",
                                "text": "Qui est-ce qui m’a embâté d’un pareil imbécile ?"
                            }
                        ]
                    }
                ],
