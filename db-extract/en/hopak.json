                                        "entry_id": "9f181848-392e-3a79-bf85-4c8c62f4647e",
                                        "glosses": [
                                            "Danse populaire ukrainienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139da84e-ce31-4280-97aa-bfc5fa8fb7da",
                                                "sense_id": "e08e5e11-706d-3619-9bf2-c5b28a7f2a60",
                                                "text": "L’opéra se termine avec le hopak (danse ukrainienne)."
                                            },
                                            {
                                                "example_id": "cf9776ba-0839-465b-b59a-4aefd97d440b",
                                                "sense_id": "e08e5e11-706d-3619-9bf2-c5b28a7f2a60",
                                                "text": "J’ai donc fait des recherches et j’ai découvert que les Cosaques pratiquaient le hopak, une sorte de karaté russe, qui est une danse de combat."
                                            },
                                            {
                                                "example_id": "eea1af39-df91-4fc3-bc0d-30f7c5a6c0ad",
                                                "sense_id": "e08e5e11-706d-3619-9bf2-c5b28a7f2a60",
                                                "text": "Un honnête homme n’avait non seulement pas la place de se mettre à l’aise ou de danser le hopak, mais même de se coucher quand le vin alourdissait sa tête et que ses jambes commençaient à décrire des zigzags."
                                            }
                                        ]
                                    }
