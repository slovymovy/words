                "senses": [
                    {
                        "sense_id": "b5bd1bac-9e16-30e8-b389-6c5f94b7e2ef",
                        "entry_id": "e69ed8f3-d241-36e7-a68a-8a13952c0160",
                        "glosses": [
                            "durch Heirat/Einheirat neu gewonnene Familienmitglieder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f06e8f9-2cf2-4c45-b195-9a4f5d90f43d",
                                "sense_id": "b5bd1bac-9e16-30e8-b389-6c5f94b7e2ef",
                                "text": "„Ein anderer Grund für die Heirat zwischen Bruder und Schwester war vielleicht, daß man dadurch keine Schwiegerverwandten bekam.“"
                            },
                            {
                                "example_id": "cf232126-8ca2-4a8a-b781-e48f3d7c5667",
                                "sense_id": "b5bd1bac-9e16-30e8-b389-6c5f94b7e2ef",
                                "text": "„Ihm zur Seite wurde eine Kommission gestellt, in der mit Paullus ein Schwiegerverwandter der Scipionen saß.“"
                            },
                            {
                                "example_id": "f46cf595-19b9-4be2-a24a-2095b6fcd7aa",
                                "sense_id": "b5bd1bac-9e16-30e8-b389-6c5f94b7e2ef",
                                "text": "„Schwiegerverwandte werden mit dem Terminus uin oder uisan bezeichnet. Alle weiblichen Schwiegerverwandten werden als uis, alle männlichen Schwiegerverwandten mit dem Terminus |uib bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
