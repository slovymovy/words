            "senses": [
                {
                    "sense_id": "3ce57f03-ab23-3cdd-9690-c867aef6cc13",
                    "sense_definition": "Envoyer quelque chose à une destination par la poste ou par un transporteur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "envoi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant va <w>expédier</w> votre commande dès demain matin.",
                            "target_lang_translations": {
                                "en": "The retailer will <w>dispatch</w> your order first thing tomorrow morning.",
                                "ru": "Торговец <w>отправит</w> ваш заказ уже завтра утром.",
                                "de": "Der Händler wird Ihre Bestellung schon morgen früh <w>versenden</w>.",
                                "es": "El comerciante <w>despachará</w> su pedido mañana a primera hora.",
                                "zh": "您的订单，店家明天一早就<w>发货</w>。"
                            }
                        },
                        {
                            "text": "Nous devons <w>expédier</w> un colis urgent à nos clients en Italie.",
                            "target_lang_translations": {
                                "en": "We must <w>send</w> an urgent parcel to our customers in Italy.",
                                "ru": "Нам нужно <w>отправить</w> срочную посылку нашим клиентам в Италию.",
                                "de": "Wir müssen ein dringendes Paket an unsere Kunden in Italien <w>verschicken</w>.",
                                "es": "Debemos <w>enviar</w> un paquete urgente a nuestros clientes en Italia.",
                                "zh": "我们得给意大利的客户<w>寄</w>一个紧急包裹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "envoyer",
                        "acheminer",
                        "adresser"
                    ],
                    "antonyms": [
                        "recevoir"
                    ],
                    "common_phrases": [
                        "expédier un colis",
                        "expédier un paquet",
                        "expédier une lettre",
                        "expédier du courrier"
                    ],
                    "target_lang_definitions": {
                        "en": "To send something to a destination by post or by a carrier.",
                        "ru": "Отправить что-либо адресату по почте или через перевозчика.",
                        "de": "Etwas per Post oder über einen Transportdienst an einen Empfänger schicken.",
                        "es": "Enviar algo a un destino por correo o mediante un transportista.",
                        "zh": "把物品通过邮政或承运人送到目的地。"
                    },
                    "translations": {
