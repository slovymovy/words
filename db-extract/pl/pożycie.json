                                "example_id": "9e3db4ca-626a-4396-9e9a-9893e31f9765",
                                "sense_id": "d712218b-e391-3f94-a498-c5e0036a08c4",
                                "text": "W bliższym pożyciu z ludźmi, których szanował i lubił, był on zawsze pełen prostoty, swobody i naturalności."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8cf2b438-3764-34b3-87c5-e5bca464237b",
