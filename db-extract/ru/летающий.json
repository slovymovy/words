                "senses": [
                    {
                        "sense_id": "b3dc005d-8a5a-3619-84ef-01ccdd460d41",
                        "entry_id": "54d6819d-0897-3e45-b916-3fd8ccbde0ad",
                        "glosses": [
                            "действ. прич. наст. вр. от летать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "0254db25-4ad0-438d-9566-6697bf2bf753",
                                "sense_id": "b3dc005d-8a5a-3619-84ef-01ccdd460d41",
                                "text": "И увидел я одного Ангела, стоящего на солнце; и он воскликнул громким голосом, говоря всем птицам, летающим по средине неба: летите, собирайтесь на великую вечерю Божию,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e75511d5-4022-426f-b706-05f767ee10a2",
                        "source_entry_id": "54d6819d-0897-3e45-b916-3fd8ccbde0ad",
                        "source_sense_id": "b3dc005d-8a5a-3619-84ef-01ccdd460d41",
                        "target_lang_word": "flying",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1970390e-0864-3b49-a4a0-b940f69d6b18",
                                        "entry_id": "80da9e55-3038-3821-9f75-5b27d2d06fcc",
                                        "glosses": [
                                            "An act of flight."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862702fd-e2f0-423d-9adc-5edf44d1256d",
                                                "sense_id": "1970390e-0864-3b49-a4a0-b940f69d6b18",
                                                "text": "\"Flyings\" could vary considerably in complexity and lavishness and could involve an actor or property being either lifted from the stage into the flies above or vice versa. As Colin Visser has observed, flyings and sinkings are both \"associated with supernatural manifestations of various kinds\" […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0635d022-982a-3093-915c-ecbc7370060f",
                                        "entry_id": "80da9e55-3038-3821-9f75-5b27d2d06fcc",
                                        "glosses": [
                                            "The action or process of sustained motion through the air."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9853e5-b193-42ba-a0bd-82763a11b434",
                                                "sense_id": "0635d022-982a-3093-915c-ecbc7370060f",
                                                "text": "His seconde hawke wexyd gery\nAnd was with flyenge wery.\nShe had flowyn so oft,\nThat on the rode loft\nShe perkyd her to rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ce820f-05e9-3295-96d1-7e0240196616",
                                        "entry_id": "80da9e55-3038-3821-9f75-5b27d2d06fcc",
                                        "glosses": [
                                            "The action of sustained hydrodynamic lift on hydrofoils lifting the vessel hull lifted out of the water, for sustained motion across water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
