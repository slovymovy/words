{
    "word_family": [
        "nuptial",
        "postnuptial"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55523c8c-ed88-39d2-8d79-e9ac502e0a87",
                    "sense_definition": "Occurring or existing before a marriage takes place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marriage timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple decided to have a <w>prenuptial</w> dinner with their families the night before the wedding.",
                            "target_lang_translations": {
                                "ru": "Пара решила устроить <w>предсвадебный</w> ужин со своими семьями накануне свадьбы."
                            }
                        },
                        {
                            "text": "They sought legal advice regarding a <w>prenuptial</w> agreement to protect their individual assets.",
                            "target_lang_translations": {
                                "ru": "Они обратились за юридической консультацией по поводу <w>брачного</w> договора, чтобы защитить свои личные активы."
                            }
                        }
                    ],
                    "synonyms": [
                        "premarital",
                        "antenuptial"
                    ],
                    "antonyms": [
                        "postnuptial"
                    ],
                    "common_phrases": [
                        "prenuptial agreement",
                        "prenuptial counseling",
                        "prenuptial arrangements"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или существующий до заключения брака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добрачный",
                                "target_lang_sense_clarification": "относящийся к периоду до свадьбы"
                            },
                            {
                                "target_lang_word": "предсвадебный",
                                "target_lang_sense_clarification": "происходящий непосредственно перед свадьбой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40474ec9-1f44-3ee8-a2e6-68ccceb5a70e",
                    "sense_definition": "A shortened form of <w>prenuptial agreement</w>, which is a legal contract made before marriage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal documents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before they got married, his lawyer suggested that he should sign a <w>prenuptial</w>.",
                            "target_lang_translations": {
                                "ru": "Перед тем как они поженились, его адвокат предложил ему подписать <w>брачный контракт</w>."
                            }
                        },
                        {
                            "text": "The collaborative <w>prenuptial</w> is recommended for couples who want to be transparent about their finances.",
                            "target_lang_translations": {
                                "ru": "Совместный <w>брачный договор</w> рекомендуется парам, которые хотят быть прозрачными в своих финансах."
                            }
                        }
                    ],
                    "synonyms": [
                        "prenuptial agreement"
                    ],
                    "common_phrases": [
                        "sign a prenuptial",
                        "collaborative prenuptial"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a shorthand in legal and social contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма термина «брачный контракт», юридического соглашения, заключаемого до вступления в брак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брачный контракт",
                                "target_lang_sense_clarification": "юридический документ"
                            },
                            {
                                "target_lang_word": "брачный договор",
                                "target_lang_sense_clarification": "официальное соглашение о разделе имущества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}