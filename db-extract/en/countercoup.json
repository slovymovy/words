                        "glosses": [
                            "A coup which seeks to overthrow the government installed by a previous coup"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75be54ad-08f9-463c-af05-cb0c1a330a3c",
                                "sense_id": "d18c6535-9707-39a5-bbaa-9f1c667aa904",
                                "text": "But amid rumors of countercoups and maneuvering by Mr. Thaksin’s allies, the generals seem to have calculated that they needed his skills."
                            }
                        ]
                    }
                ],
