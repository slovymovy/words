                "senses": [
                    {
                        "sense_id": "710aa759-c57e-3af5-a26b-287a761d3183",
                        "entry_id": "c7985c99-c553-3534-8219-9edceca6ec9d",
                        "glosses": [
                            "Lunetter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417d8eb1-d0b7-4b95-bd9b-2415357d8393",
                                "sense_id": "710aa759-c57e-3af5-a26b-287a761d3183",
                                "text": "Rhabillé, relunetté, recoiffé, bref relooké, Lionel Jospin savoure avec délice les plus beaux moments de sa longue carrière politique."
                            }
                        ]
                    },
                    {
                        "sense_id": "56bb9386-1124-3e1f-ad8b-dc103ffdcd13",
                        "entry_id": "c7985c99-c553-3534-8219-9edceca6ec9d",
                        "glosses": [
                            "Remettre ses lunettes."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "04dd2050-cab1-494d-9dcf-379df6cf2a03",
                                "sense_id": "56bb9386-1124-3e1f-ad8b-dc103ffdcd13",
                                "text": "Il les rétagérise d'un geste précis empreint d'un vague dégoût, se relunette et sourit béatement."
                            }
                        ]
                    }
