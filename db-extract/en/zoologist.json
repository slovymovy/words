                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3902f322-4533-4018-aaf8-e0af8f1a04be",
                        "source_entry_id": "9e068960-b839-39dc-b48e-68228f7d7d0e",
                        "source_sense_id": "8d824278-6b78-3ad0-8787-c75021cccf3d",
                        "source_sense_description": "one who studies zoology",
                        "target_lang_word": "zoologiste",
