                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "323c1304-8c77-4269-bec6-c1272a8a94ef",
                                "sense_id": "d68820ab-9564-33c4-96d5-519de8d0424e",
                                "text": "Het is het jaar 1868 en de reiziger in dit boek is ds. P.Heering. Hij is geen zeeman en ziet alles met andere ogen dan een varensman."
                            },
                            {
                                "example_id": "1adfd2d3-b168-4bd2-996b-ac43d282e5af",
                                "sense_id": "d68820ab-9564-33c4-96d5-519de8d0424e",
                                "text": "Voor de zeeman in vroeger tijd was de bijbel verplichte kost. Tegenwoordig kan de varensman van alle rang of stand zijn eigen reisbi- bliotheekje laten samen- stellen, met boeken ter verstrooiing of educatie. Dat alles dank zij de Bibliotheek voor Varenden te Rotterdam."
                            }
                        ]
                    }
