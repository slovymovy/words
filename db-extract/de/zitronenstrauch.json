                                        "examples": [
                                            {
                                                "example_id": "28f94285-001a-482e-919d-7db33122ff66",
                                                "sense_id": "9aa3d3b5-3a76-3465-b068-ef49aeacf589",
                                                "text": "Seule, la verveine odorante est utilisée par l’herboristerie et dans l’industrie de la parfumerie, à cause de la fine odeur de citron vert de son huile essentielle dont le principal constituant est le cotral."
                                            }
