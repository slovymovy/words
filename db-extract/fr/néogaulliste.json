                        "glosses": [
                            "Relatif à un nouveau mouvement politique inspiré du gaullisme."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f1c466b1-e07b-426e-8517-7209441ac893",
                                "sense_id": "7cbcca1e-7b20-3dc1-9139-3170594e11a1",
                                "text": "Les soupçons de marchés truqués de ce syndicat, sa gestion « la mano en la mano » par le PC et la droite néogaulliste ou son train de vie fastueux ont été épinglés par « Le Canard »."
                            },
                            {
                                "example_id": "865a8937-d0fd-45c3-a302-3414aec3d222",
                                "sense_id": "7cbcca1e-7b20-3dc1-9139-3170594e11a1",
                                "text": "Les idées populistes du clan Le Pen-Buisson-Copé auraient-elles à ce point pénétré les rangs du parti néogaulliste ?"
                            }
                        ]
                    }
                ],
