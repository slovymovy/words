{
    "word_family": [
        "brusquely",
        "brusqueness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6e93155-098c-35e4-a4a3-aa20a7b51108",
                    "sense_definition": "Rudely abrupt or curt in manner or speech.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rude_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave a <w>brusque</w> refusal when asked for more time to finish the project.",
                            "target_lang_translations": {
                                "cs": "Manažer dal <w>bryskní</w> zamítavou odpověď, když byl požádán o více času na dokončení projektu."
                            }
                        },
                        {
                            "text": "Her <w>brusque</w> manner often makes people feel unwelcome during meetings.",
                            "target_lang_translations": {
                                "cs": "Její <w>úsečné</w> vystupování často způsobuje, že se lidé na schůzkách cítí nevítaní."
                            }
                        }
                    ],
                    "synonyms": [
                        "offhand",
                        "short"
                    ],
                    "common_phrases": [
                        "brusque manner",
                        "brusque refusal"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrubě úsečný nebo strohý v chování či řeči."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bryskní",
                                "target_lang_sense_clarification": "vyjadřující strohost a rychlost v jednání"
                            },
                            {
                                "target_lang_word": "úsečný",
                                "target_lang_sense_clarification": "vyjadřující nedostatek zdvořilosti a stručnost"
                            },
                            {
                                "target_lang_word": "strohý",
                                "target_lang_sense_clarification": "vyjadřující chladný a neosobní přístup"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab56d1e1-7578-3b40-8b80-5bf555f4bd29",
                    "sense_definition": "To treat someone in a curt or rudely abrupt manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rude_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>brusqued</w> his colleagues whenever they tried to offer him helpful advice.",
                            "target_lang_translations": {
                                "cs": "Pokaždé, když se mu kolegové snažili nabídnout užitečnou radu, je <w>odbyl</w>."
                            }
                        },
                        {
                            "text": "It is unprofessional to <w>brusque</w> clients who are simply asking for clarification.",
                            "target_lang_translations": {
                                "cs": "Je neprofesionální <w>jednat úsečně</w> s klienty, kteří se pouze ptají na vysvětlení."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jednat s někým stroze nebo hrubě úsečným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odbýt",
                                "target_lang_sense_clarification": "jednat s někým stroze a rychle ho odmítnout"
                            },
                            {
                                "target_lang_word": "jednat úsečně",
                                "target_lang_sense_clarification": "chovat se k někomu nezdvořile a stroze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f2af3ea5-accd-344c-b58f-4b554830a337",
                    "sense_definition": "A city in Santa Catarina, Brazil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many textile industries are located in the city of <w>Brusque</w>.",
                            "target_lang_translations": {
                                "cs": "Ve městě <w>Brusque</w> se nachází mnoho textilních průmyslových podniků."
                            }
                        },
                        {
                            "text": "We traveled to <w>Brusque</w> to visit the local historical museum.",
                            "target_lang_translations": {
                                "cs": "Cestovali jsme do <w>Brusque</w>, abychom navštívili místní historické muzeum."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Město v brazilském státě Santa Catarina."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Brusque",
                                "target_lang_sense_clarification": "vlastní jméno města"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}