                "senses": [
                    {
                        "sense_id": "894621b1-0229-3c8f-83c9-7af3ed4938ff",
                        "entry_id": "48fd24d6-2c1a-326b-81d9-c08d4cc90e96",
                        "glosses": [
                            "Vertreter einer Gattung kleiner fleisch- und insektenfressender, gefiederter Dinosaurier aus der späten Kreidezeit"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c886cd83-eff8-493f-b2c5-f5f93f69a9db",
                                "sense_id": "894621b1-0229-3c8f-83c9-7af3ed4938ff",
                                "text": "„Shuvuuia war ein kleiner und leicht gebauter Dinosaurier, der viel mit den modernen Vögeln gemeinsam hatte, einschließlich seiner Kiefer und Federn. Seinen ungewöhnlichen Namen verdankt er dem mongolischen Wort für Vogel, Shuvuu, das Art-Epitheton deserti steht für den Fundort, die mongolische Wüste.“"
                            },
                            {
                                "example_id": "b6fd3078-2c2d-48ad-9c42-7a5d56c43c35",
                                "sense_id": "894621b1-0229-3c8f-83c9-7af3ed4938ff",
                                "text": "„Shuvuuia deserti hingegen hatte sowohl ein außergewöhnliches Gehör als auch eine hervorragende Nachtsicht, vergleichbar mit den Fähigkeiten einer Schleiereule. Und das wiederum legt nahe, dass Shuvuuia in völliger Dunkelheit gejagt haben könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
