                        "sense_id": "9775cdfa-ddbd-3243-ba4f-f35ad7fb2515",
                        "entry_id": "13dc8094-dbae-35d8-af1c-f5ee92f06899",
                        "glosses": [
                            "свойство по значению прилагательного универсальный; повсеместная распространённость, всеобщность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10934c1-0480-477b-a51b-544d98a2b727",
                                "sense_id": "9775cdfa-ddbd-3243-ba4f-f35ad7fb2515",
                                "text": "При решении этих проблем она встала на путь гиноцентризма, доказывая абсолютную универсальность и самодостаточность женщин."
                            }
                        ]
                    },
                    {
                        "sense_id": "f90b68f7-2b2b-3dd4-8aeb-dfb55120d067",
                        "entry_id": "13dc8094-dbae-35d8-af1c-f5ee92f06899",
                        "glosses": [
                            "обладание разными знаниями, навыками; разносторонность"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d79bb5e5-50f7-4fc5-bd50-61b87e6794a1",
