        "fr-extract.jsonl": [
            {
                "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                "word": "gargote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27b397d8-5293-4027-97e0-5bbe2ea16f00",
                        "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "tags": [
                            "plural"
                        ],
                        "form": "gargotes"
                    },
                    {
                        "form_id": "84c875e4-ba86-4428-94dc-c947d13e922e",
                        "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "tags": [],
                        "form": "gargotte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "229cbf13-a91d-343c-8892-6079d7d29685",
                        "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "glosses": [
                            "Petit établissement où l’on peut boire et manger des plats frugaux à bon marché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d57fc78-0334-4631-8b3c-145d74b86c21",
                                "sense_id": "229cbf13-a91d-343c-8892-6079d7d29685",
                                "text": "La voiture s’arrêta, et M. Dufour se mit à lire l’enseigne engageante d’une gargote."
                            },
                            {
                                "example_id": "a6b68888-78a7-483d-b2d9-eb3e4c70d48d",
                                "sense_id": "229cbf13-a91d-343c-8892-6079d7d29685",
                                "text": "L’une de ambitions du Père Pedro est d’assurer la reconversion des chiffonniers, notamment en leur proposant des microcrédits, pour leur permettre d’ouvrir une gargote."
                            }
                        ]
                    },
                    {
                        "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                        "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "glosses": [
                            "Restaurant bon marché servant des plats de mauvaise qualité."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0f41da96-7f2c-4b61-98ad-6254d4c13466",
                                "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                                "text": "Le jour où la misère la fatiguerait, le jour où elle serait lasse de boire du vin au litre et de manger ces hideuses portions à sauce brune qu’on leur montait de la gargote, le jour où elle en aurait jusque-là de l’art dramatique de la banlieue, ce jour-là, elle savait bien qu’elle reprendrait son existence d’autrefois."
                            },
                            {
                                "example_id": "3925e65d-39b8-42a8-b8c7-8ae38eea72f3",
                                "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                                "text": "Petite et misérable gargote de la rue Sainte-Geneviève où je me nourrissais jadis si mal que j’en ai, quand j’y pense, encore faim, je ne vous oublie pas."
                            },
                            {
                                "example_id": "2dc5f67b-249e-4cea-9b89-e142651177f0",
                                "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                                "text": "Des garnis sans rideaux, des gargotes, des débits grouillants de vermine occupent – entre les loges des filles — la longueur des façades et une humanité malpropre, hébétée, loqueteuse s’y agite machinalement."
                            },
                            {
                                "example_id": "2fec2e83-0562-44e8-9f55-5801e1422401",
                                "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                                "text": "Dans une gargote à peine reniflable, nous dînâmes d’un merveilleux emperador grillé."
                            },
                            {
                                "example_id": "cddc7b80-ca35-45a3-a09c-93c5451fafa9",
                                "sense_id": "df04d80b-cd78-34e9-8e53-d9adf1354722",
                                "text": "En revanche, certaines gargotes, pensant certainement réinventer la cuisine, donnent plutôt envie de passer illico son chemin."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3dd100-3814-3968-9170-48b8b7d6b221",
                        "entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "glosses": [
                            "Toute mauvaise cuisine."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7c51aec6-33ed-44e3-b541-777281895a20",
                                "sense_id": "bd3dd100-3814-3968-9170-48b8b7d6b221",
                                "text": "Cette cuisinière nous fait une vraie gargote."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "042bbd2a-477c-41c3-90f3-6af19daf7bda",
                        "source_entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
                        "target_lang_word": "greasy spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greasy spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                        "entry_id": "7beb017f-3e17-3e84-8e37-8c572acc1e81",
                                        "glosses": [
                                            "An inexpensive diner or other informal restaurant, especially one specializing in frying or grilling."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7ae2cf-1e0a-4df7-86dc-e8a761770c58",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "We found a good little greasy spoon down a side street."
                                            },
                                            {
                                                "example_id": "b082dc55-8cc0-4bd0-b6ff-219492cf3e35",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "I find that most gay men love to cook for others but would rather visit any greasy spoon than eat by themselves."
                                            },
                                            {
                                                "example_id": "e1ba1e59-dcae-4a61-8784-eac82e4098f0",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "From the highway, Phil's looked like any other greasy spoon inviting the weary traveler off the road for a little indigestion and a cup of coffee — the same red booths patched with black electrical tape and faded formica counters lined with chrome-sided stools, a glass pie pin near the cash register, and coffee served in thick white mugs."
                                            },
                                            {
                                                "example_id": "77f396d5-1300-404e-87f8-f14f8f82b7f9",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "Reward yourself for a week of healthful eating with breakfast at a greasy spoon. Nutritionists say an occasional cheat meal can make it easier to stick with a healthy diet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28b1cf07-7f0e-4bad-a710-6dc2e9a73587",
                        "source_entry_id": "d10cba92-6400-38c3-b706-043f17fbd859",
