                "senses": [
                    {
                        "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                        "entry_id": "38967802-e699-34a1-a59a-41f7a7fdeaf8",
                        "glosses": [
                            "To make jewelry."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d325ec7c-ab4d-4826-9a0b-aa170fb72a2c",
                                "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                                "text": "He was using all the arts of barbering, livery stabling, jewelrying, oratorying, and tailoring."
                            },
                            {
                                "example_id": "40e7c95a-3eac-4760-866d-54a22526045e",
                                "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                                "text": "The members of this family have an honest and honorable record in their dealings and relations in every way, preferring the peaceful calling of farming, poultrying, and jewelrying; with a home of many comforts and enjoyments."
                            }
                        ]
                    },
                    {
                        "sense_id": "235b419d-c0b2-3ae7-a740-5e920ea0d430",
                        "entry_id": "38967802-e699-34a1-a59a-41f7a7fdeaf8",
                        "glosses": [
                            "To adorn with jewelry or make into jewelry."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bcf6346b-27eb-4a2a-89dd-a12ea41fd82f",
                                "sense_id": "235b419d-c0b2-3ae7-a740-5e920ea0d430",
                                "text": "The large UNESCO hall, where she exhibited, held them all in full space and light — the early paintings, the hand-woven textures and colors in wool, the brilliance of enamels and glass, jewelried silver and gold, and the structured clay metal and stone pieces."
                            }
                        ]
                    }
                ],
