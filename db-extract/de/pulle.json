                "senses": [
                    {
                        "sense_id": "ce4d5ed8-2956-344a-a93d-c07fb73e0b20",
                        "entry_id": "ff63c135-3bc6-38e4-9a31-15aafeebfc89",
                        "glosses": [
                            "Flasche"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "10476186-6009-42b7-9069-2bc655f03b10",
                                "sense_id": "ce4d5ed8-2956-344a-a93d-c07fb73e0b20",
                                "text": "Für die Wanderung nahm Hans drei Pullen Wasser mit."
                            },
                            {
                                "example_id": "02650a58-4d55-4fe5-85a7-e31cc8fca697",
                                "sense_id": "ce4d5ed8-2956-344a-a93d-c07fb73e0b20",
                                "text": "„Thomas schwieg eine Weile betroffen, er nahm jetzt auch einen Schluck aus der Pulle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84bdfc98-e465-4149-8270-a72113b40ba9",
                        "source_entry_id": "ff63c135-3bc6-38e4-9a31-15aafeebfc89",
                        "source_sense_id": "ce4d5ed8-2956-344a-a93d-c07fb73e0b20",
                        "source_sense_description": "umgangssprachlich: Flasche",
                        "target_lang_word": "bottle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0979e3-ee2a-32ad-9606-0c966b6f42ef",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "A container, typically made of glass or plastic and having a tapered neck, used primarily for holding liquids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519fa242-2436-40a5-883c-bd1a37d07ffb",
                                                "sense_id": "ab0979e3-ee2a-32ad-9606-0c966b6f42ef",
                                                "text": "Beer is often sold in bottles."
                                            },
                                            {
                                                "example_id": "aee7d178-ca09-471b-ab45-930c34238a60",
                                                "sense_id": "ab0979e3-ee2a-32ad-9606-0c966b6f42ef",
                                                "text": "He had one hand on the bounce bottle—and he’d never let go of that since he got back to the table—but he had a handkerchief in the other and was swabbing his deadlights with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c2c707a-7541-38d6-8555-642e2b2d5d4d",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "The contents of such a container."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fdafcd-68c5-44bc-966c-cd88d87dd7a2",
                                                "sense_id": "1c2c707a-7541-38d6-8555-642e2b2d5d4d",
                                                "text": "I only drank a bottle of beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f193516-9394-33c4-8a04-a8ec63d5bfa0",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "A container with a rubber nipple used for giving liquids to infants, a baby bottle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5bf9d9e-6855-4fea-a44c-8cd8a8d16982",
                                                "sense_id": "5f193516-9394-33c4-8a04-a8ec63d5bfa0",
                                                "text": "The baby wants a bottle."
                                            },
                                            {
                                                "example_id": "386724a9-b274-4f10-982f-677184243793",
                                                "sense_id": "5f193516-9394-33c4-8a04-a8ec63d5bfa0",
                                                "text": "With Marvin getting older ... and walking now ... I thought it was time to start weaning him off of his bottle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf63032-be09-37fa-9690-ffd7b241c413",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "(originally \\\"bottle and glass\\\" as rhyming slang for \\\"arse\\\") Nerve, courage."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e553d4f9-a905-4e64-9a49-642c4804d17e",
                                                "sense_id": "adf63032-be09-37fa-9690-ffd7b241c413",
                                                "text": "You don’t have the bottle to do that!"
                                            },
                                            {
                                                "example_id": "76489894-67b3-4d7d-80f2-f49267c7781d",
                                                "sense_id": "adf63032-be09-37fa-9690-ffd7b241c413",
                                                "text": "He was going to ask her out, but he lost his bottle when he saw her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca5e444-3902-3996-9ae7-1f8283bf6c59",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "A container of hair dye, hence with one’s hair color produced by dyeing."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed10130-79b8-4d39-a06e-676180c8a31e",
                                                "sense_id": "fca5e444-3902-3996-9ae7-1f8283bf6c59",
                                                "text": "Did you know he’s a bottle brunette? His natural hair color is strawberry blonde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d68f141-9ba0-3327-a8b6-f91ed5d3ab38",
                                        "entry_id": "27d0690d-ff42-3558-a73a-8ffa2b251f38",
                                        "glosses": [
                                            "Intoxicating liquor; alcohol."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52afe6bb-47b0-4955-be00-54babb2af1da",
                                                "sense_id": "6d68f141-9ba0-3327-a8b6-f91ed5d3ab38",
                                                "text": "to drown one’s troubles in the bottle"
                                            },
                                            {
                                                "example_id": "1d18c15c-c6d1-4b31-91ae-77e2c9986ec1",
                                                "sense_id": "6d68f141-9ba0-3327-a8b6-f91ed5d3ab38",
                                                "text": "to hit the bottle"
                                            },
                                            {
                                                "example_id": "351beddb-b2c5-4c6a-b172-791bcc0d4d96",
                                                "sense_id": "6d68f141-9ba0-3327-a8b6-f91ed5d3ab38",
                                                "text": "See that black boy over there runnin' scared / His ol' man's in a bottle / He done quit his 9 to 5 to drink full time / So now he's livin' in the bottle."
                                            },
                                            {
                                                "example_id": "79758460-3c05-477d-8126-741f154f3ecf",
                                                "sense_id": "6d68f141-9ba0-3327-a8b6-f91ed5d3ab38",
                                                "text": "See, my old man’s got a problem / He live with the bottle, that’s the way it is"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54491406-6de9-3b3b-b27f-2ded93d4c91c",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To seal (a liquid) into a bottle for later consumption. Also fig."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c5ff6a-dbb2-4a62-8600-e9cc15a1ed50",
                                                "sense_id": "54491406-6de9-3b3b-b27f-2ded93d4c91c",
                                                "text": "This plant bottles vast quantities of spring water every day."
                                            },
                                            {
                                                "example_id": "5f0c6327-2468-4c7f-a49c-452c325db52e",
                                                "sense_id": "54491406-6de9-3b3b-b27f-2ded93d4c91c",
                                                "text": "The temptation is to regard him [John Ogdon] as an idiot savant, a big talent bottled inside a recalcitrant body and accompanied by a personality that seems not just unremarkable, but almost entirely blank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42322bbe-961d-3a15-88af-4502108fd746",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To feed (an infant) baby formula."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e2328a-7599-4532-bce2-6b571573c550",
                                                "sense_id": "42322bbe-961d-3a15-88af-4502108fd746",
                                                "text": "Because of complications she can't breast feed her baby and so she bottles him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e44b8884-a8fc-3303-8e9b-9a7a44a74cda",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To refrain from doing (something) at the last moment because of a sudden loss of courage."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a95b23-15b1-450b-abb3-45f32d4e8203",
                                                "sense_id": "e44b8884-a8fc-3303-8e9b-9a7a44a74cda",
                                                "text": "The rider bottled the big jump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c218eb3-5a52-3cb3-b73a-1cb5984d9991",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To throw away a leading position."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d897fb-6f20-4ae3-aa52-5f7e1a72d208",
                                                "sense_id": "0c218eb3-5a52-3cb3-b73a-1cb5984d9991",
                                                "text": "Arsenal bottled the Premier League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98c6d904-769f-3a5a-8614-5ba84ebc5625",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To strike (someone) with a bottle."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b44ee029-88be-4e07-986b-8fdaeb981ba4",
                                                "sense_id": "98c6d904-769f-3a5a-8614-5ba84ebc5625",
                                                "text": "He was bottled at a nightclub and had to have facial surgery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53181d0e-c246-3087-9de1-3a64b87b8395",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "To pelt (a musical act on stage, etc.) with bottles as a sign of disapproval."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82266abf-5599-45b9-b9cd-b60339c7b654",
                                                "sense_id": "53181d0e-c246-3087-9de1-3a64b87b8395",
                                                "text": "Meat Loaf was once bottled at Reading Festival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4340582-5401-3566-ae8b-d5d42f5358b2",
                                        "entry_id": "4911d7c7-8ecf-3469-bf06-6c9e0be2fdb2",
                                        "glosses": [
                                            "Of pages printed several on a sheet: to rotate slightly when the sheet is folded two or more times."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc4c735-c481-49ca-854c-de610f3ba48a",
                                                "sense_id": "f4340582-5401-3566-ae8b-d5d42f5358b2",
                                                "text": "Closely related to creep is the process of bottling. As you may have noticed from your folded sheet of paper, pages don't merely creep when they're folded — they also rotate slightly. This rotation or bottling is caused by the thickness or bulk of the paper."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf00059-8daa-3908-85ea-3537d1151daa",
                                        "entry_id": "5bf7ff8e-ae8c-3ef3-91ca-0fb33ed9accc",
                                        "glosses": [
                                            "A dwelling; habitation."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45827774-708d-3210-9461-e4d342326452",
                                        "entry_id": "5bf7ff8e-ae8c-3ef3-91ca-0fb33ed9accc",
                                        "glosses": [
                                            "A building; house."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43a89fd7-d48b-33d1-9ef6-3fb026bf6aa8",
                                        "entry_id": "31299f06-7244-36be-98c9-9957d02cdde5",
                                        "glosses": [
                                            "A bundle, especially of hay; something tied in a bundle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c67818-a5ae-4409-9b89-524f1fdabdc9",
                                                "sense_id": "43a89fd7-d48b-33d1-9ef6-3fb026bf6aa8",
                                                "text": "I was no ſooner in the middle of the pond, but my horſe vaniſht away, and I ſat vpon a bottle of hey, neuer ſo neare drowning in my life: […]"
                                            },
                                            {
                                                "example_id": "364e93f7-543f-4300-8425-6334ddfb8977",
                                                "sense_id": "43a89fd7-d48b-33d1-9ef6-3fb026bf6aa8",
                                                "text": "[…]Me-thinkes I haue a great deſire to a bottle of hay: good hay, ſweete hay hath no fellow."
                                            },
                                            {
                                                "example_id": "176acf9b-a5c6-4640-a7ae-d648c983dc25",
                                                "sense_id": "43a89fd7-d48b-33d1-9ef6-3fb026bf6aa8",
                                                "text": "Don Pedro. Well, if ever thou dost fall from this faith, thou wilt prove a notable argument. / Benedick. If I do, hang me in a bottle like a cat and shoot at me; and he that hits me, let him be clapped on the shoulder and called Adam."
                                            },
                                            {
                                                "example_id": "6f6a388c-3c32-42ae-aa26-e99c194e1e33",
                                                "sense_id": "43a89fd7-d48b-33d1-9ef6-3fb026bf6aa8",
                                                "text": "Can you deny that you've been off and on lately between flunkydom and The Cause, like a donkey between two bottles of hay?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
