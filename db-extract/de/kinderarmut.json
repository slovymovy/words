                ],
                "senses": [
                    {
                        "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                        "entry_id": "9e982a4f-8713-3962-81bb-8842cd4ddfa4",
                        "glosses": [
                            "Situation, dass in einer Gesellschaft viele Kinder in armen oder ärmlichen Verhältnissen leben müssen (wirtschaftliche Armut)"
                        ],
                        "tags": [
                            "Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "92148fda-5547-42d7-be0a-7a80994426b5",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Die Kinderarmut zu bekämpfen und ihr vorzubeugen ist vor allem Aufgabe der Politik.“"
                            },
                            {
                                "example_id": "c47a2350-558a-4690-a069-37f7c5d97a22",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Katharina Spieß: »Kinderarmut in Deutschland hat zugenommen, wenn wir den Zeitraum der letzten zehn Jahre betrachten.«“"
                            },
                            {
                                "example_id": "dce84f7a-cb14-4afa-aa7d-b3c478786c44",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„In einem so wohlhabenden Land wie der Bundesrepublik muss es Kinderarmut nicht geben,“ […]."
                            },
                            {
                                "example_id": "bec32460-9d5b-49aa-a15c-8a4cb26bbd96",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„»Kinderarmut ist ein trauriger Skandal in unserem reichen Land«, erklärte Bartsch.“"
                            },
                            {
                                "example_id": "49308c52-0d84-4eea-8270-996dc53268cd",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Kinderarmut ist in vielen EU-Ländern ein Problem - auch in Deutschland ist etwa jedes fünfte Kind betroffen“"
                            },
                            {
                                "example_id": "dd3458b7-6821-49e6-bd8b-8d21a4d471e7",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Offensichtlich ist die Forderung und Unterstützung verantwortungsvoller Vaterschaft entscheidend für die Bekämpfung von Kinderarmut.“"
                            },
                            {
                                "example_id": "a99ef441-2f0b-42ad-8175-4f59e5f3d20f",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Da sich Kinderarmut nicht monokausal erklären und auf eine Ursache reduzieren lässt, kann sie nur mehrdimensional bekämpft werden.“"
                            },
                            {
                                "example_id": "c5c6d41a-c747-45de-8889-149826cd56a4",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Kinderarmut zu bekämpfen erfordert, Strukturen sozialer Ungleichheit zu beseitigen.“"
                            },
                            {
                                "example_id": "b93b728f-bff2-4830-a611-ab25a9291699",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Dänemark, die Niederlande und andere europäische Länder, die eine geringere Kinderarmut haben, zeigen, dass eine umfassende Strategie mit abgestimmten Schritten notwendig ist.“"
                            },
                            {
                                "example_id": "393248a9-5dd3-4107-b96c-4fac5b859134",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "„Der Kölner Soziologe Christoph Butterwegge wirft der Politik vor, dass das Problem der Armut \"verharmlost\" und \"verdrängt\" werde. Es gebe schwere Versäumnisse bei der wirkungsvollen Bekämpfung, vor allem bei der Alters- und Kinderarmut.“"
                            },
                            {
                                "example_id": "17438541-fa20-4d80-b0df-1bafe7da915c",
                                "sense_id": "e4df1c8d-dcc0-3d55-8d45-0906ef270fff",
                                "text": "Kinderarmut bekämpft man zuerst mit einer bedingungslosen finanziellen Kindergrundsicherung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bcc23f91-3944-314c-b09b-dcdf20f89c15",
                        "entry_id": "9e982a4f-8713-3962-81bb-8842cd4ddfa4",
                        "glosses": [
                            "Situation, dass in einer Gesellschaft zu wenig Kinder geboren werden (demografische Armut)"
                        ],
                        "tags": [
                            "Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "57e1b65e-e3e2-4503-903e-7d8ffbfe5cfa",
                                "sense_id": "bcc23f91-3944-314c-b09b-dcdf20f89c15",
                                "text": "„Eine geringere Kinderarmut weisen nur die nordischen Länder und Österreich auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
