                        "glosses": [
                            "een met gras bedekt wandelpad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0690e4-43e8-439b-90d6-fd36a6010cc9",
                                "sense_id": "f1f880f1-32b8-340d-8b6d-8e49f5db81cd",
                                "text": "Het graspad brengt ons naar de IJsselmeerdijk waarboven we al van verre majestueuze zeilen de horizon zien kleuren."
                            },
                            {
                                "example_id": "202e0bfc-9166-4e98-8af2-70057103c9e9",
                                "sense_id": "f1f880f1-32b8-340d-8b6d-8e49f5db81cd",
                                "text": "De graslanden, grienden en moerassen van het natuurgebied behoorden ooit tot het Regulierenklooster. Brede graspaden leiden ons langs bosschages en houtwallen, waarin we een ree schichtig zien wegvluchten."
                            },
                            {
                                "example_id": "4a35fa23-bb15-4744-9ad0-96f640c6be70",
                                "sense_id": "f1f880f1-32b8-340d-8b6d-8e49f5db81cd",
                                "text": "De 160 standhouders hebben hun in totaal 260 kramen en stands deels op een harde ondergrond staan en deels op gras. Houtspaanders houden het graspad begaanbaar. Er zijn niet alleen boeken, kleding, cd’s en hoeden te koop, maar ook schoenen, brocante, fruit, oliebollen, antiek en worst: alles door elkaar."
                            }
                        ]
                    }
