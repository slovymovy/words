                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d683426-8a73-435f-bbd6-bc315014ebc5",
                                                "sense_id": "dcc511b1-42d1-358a-8efb-2407394429b4",
                                                "text": "She brought out the silver tea service."
                                            },
                                            {
                                                "example_id": "f4a1a98c-e710-4bfb-a98d-cdd30e921a63",
                                                "sense_id": "dcc511b1-42d1-358a-8efb-2407394429b4",
                                                "text": "When their lavish fiestas ended they threw the silver service and even golden vessels from their balconies to be picked up by lucky passersby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de6ae1c-3b91-3566-92ed-7bddfbd0830c",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
                                            "The act of initially starting, or serving, the ball in play in tennis, volleyball, and other games."
                                        ],
