                "senses": [
                    {
                        "sense_id": "6bb5a60f-265d-3a85-8ee3-9839522315c9",
                        "entry_id": "3a6eba87-9a4b-3a09-bd7a-656ed843e5c9",
                        "glosses": [
                            "да́льше (dálʹše)的另一種寫法：往下，下去"
                        ],
                        "tags": [
                            "alt-of",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "630983f6-3093-4055-b2c6-35b552871d96",
                                "sense_id": "6bb5a60f-265d-3a85-8ee3-9839522315c9",
                                "text": "не выезжа́ть да́лее родно́го села́",
                                "translation": "没离开过故乡；沒去過比故鄉更遠的地方"
                            },
                            {
                                "example_id": "d2994640-0617-4f09-aebf-d0f0ff4cb64e",
                                "sense_id": "6bb5a60f-265d-3a85-8ee3-9839522315c9",
                                "text": "До села́ не да́лее двух киломе́тров.",
                                "translation": "距离村子不超过两公里。"
                            },
                            {
                                "example_id": "0be61b2b-04fa-464e-88e7-b3e7c5e04b0b",
                                "sense_id": "6bb5a60f-265d-3a85-8ee3-9839522315c9",
                                "text": "Об э́том бу́дет ска́зано да́лее.",
                                "translation": "关于这一点下面再谈。"
                            },
                            {
                                "example_id": "01b33aa6-1ca6-441a-b08f-a1de8f6da219",
                                "sense_id": "6bb5a60f-265d-3a85-8ee3-9839522315c9",
                                "text": "Проговоря́ э́то, он приостанови́лся. Да́лее! сказа́л я.",
                                "translation": "说完这个他停了一会儿。“往下讲!”我说道。"
                            }
                        ]
                    }
                ],
