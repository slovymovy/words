                        "sense_id": "eec11466-ea8f-3cc9-94e3-42fdaede1b37",
                        "entry_id": "065a49c8-08f5-3430-8c5e-47bb1cd16e5b",
                        "glosses": [
                            "Action de draguer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e2a3cc-37a2-4758-a980-221aed24deb0",
                                "sense_id": "eec11466-ea8f-3cc9-94e3-42fdaede1b37",
                                "text": "Nos dragages pratiqués suivant une technique un peu nouvelle avec de vieilles dragues réformées, nous permirent de rapporter de nombreux et très volumineux échantillons géologiques."
                            },
                            {
                                "example_id": "5d176a94-d52b-4b9a-a484-58acb718624f",
                                "sense_id": "eec11466-ea8f-3cc9-94e3-42fdaede1b37",
                                "text": "Il ressort de la rencontre que la faible pluviométrie et le dragage sont en train de menacer les cours du fleuve Niger en aval, singulièrement le Sankarani."
                            }
                        ]
                    }
                ],
