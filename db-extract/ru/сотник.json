                ],
                "senses": [
                    {
                        "sense_id": "9e5fc556-455b-3d8a-b132-101902a294b9",
                        "entry_id": "0e0cb3d1-6405-3063-a992-cbc1654c1eb9",
                        "glosses": [
                            "истор. командир подразделения (сотни) в русском войске"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0446d518-ba4b-3567-87f1-de98551b1498",
                        "entry_id": "0e0cb3d1-6405-3063-a992-cbc1654c1eb9",
                        "glosses": [
                            "воен., истор. командир сотни в стрелецких войсках"
                        ],
                        "tags": [
                            "в Русском государстве до 16—17 вв."
                        ],
                        "examples": [
                            {
                                "example_id": "a09463d5-0f6c-466c-a9b0-374e4d22f211",
                                "sense_id": "0446d518-ba4b-3567-87f1-de98551b1498",
                                "text": "Стрелецкий сотник."
                            }
                        ]
                    },
                    {
                        "sense_id": "e642791b-5a32-3ba4-97c0-aefdd0ab26c9",
                        "entry_id": "0e0cb3d1-6405-3063-a992-cbc1654c1eb9",
                        "glosses": [
                            "воен., истор. офицерский чин в казачьих войсках, соответствующий чину поручика в пехоте"
                        ],
                        "tags": [
                            "в Российском государстве до 1917 г."
                        ],
                        "examples": [
                            {
                                "example_id": "1e11c1ab-8e92-4eb0-82cc-7f45fa5d4c2b",
                                "sense_id": "e642791b-5a32-3ba4-97c0-aefdd0ab26c9",
                                "text": "А утром того 4 июня подполковника Ковалевского разыскал командир хоперцев сотник Гвоздин."
                            },
                            {
                                "example_id": "dc232d3c-0cc1-4152-9799-d8a60cab78bb",
                                "sense_id": "e642791b-5a32-3ba4-97c0-aefdd0ab26c9",
                                "text": "Чрез две-три минуты к сотнику сбежались остальные девятнадцать казаков."
                            },
                            {
                                "example_id": "7658238d-034e-4f7d-b6b5-454bab36c58d",
                                "sense_id": "e642791b-5a32-3ba4-97c0-aefdd0ab26c9",
                                "text": "Но тут вдруг вбежал в церковь сотник с казаками, приказал самозванца вытащить вон из церкви, а оттуда в кандалах отправил в полковую канцелярию в Переяслав."
                            },
                            {
                                "example_id": "379e2298-91eb-45cb-90c9-eec922b35ccb",
                                "sense_id": "e642791b-5a32-3ba4-97c0-aefdd0ab26c9",
                                "text": "Сотник, из новых казачьих офицеров, поздоровался с казаками."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa78046b-8de7-4373-ad23-0c13f60142d4",
                        "source_entry_id": "0e0cb3d1-6405-3063-a992-cbc1654c1eb9",
                        "target_lang_word": "centurion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centurion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41368c6a-383c-3111-a826-44b7269b24b3",
                                        "entry_id": "d638f0ac-67fe-30c7-8eb3-91550b11f685",
                                        "glosses": [
                                            "Officier qui commandait une compagnie de cent hommes."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd451c15-28c0-4488-a70b-6c4af71b2928",
                                                "sense_id": "41368c6a-383c-3111-a826-44b7269b24b3",
                                                "text": "Enfin, on trouve les centurions, des officiers subalternes sortis du rang qui commandent une centurie ou un manipule (groupe de deux centuries)."
                                            },
                                            {
                                                "example_id": "65110314-3007-45ad-99a8-7b64fc44ec94",
                                                "sense_id": "41368c6a-383c-3111-a826-44b7269b24b3",
                                                "text": "Un centurion de l’armée romaine avait un esclave auquel il tenait beaucoup ; celui-ci était malade, sur le point de mourir."
                                            },
                                            {
                                                "example_id": "b9ad732e-5284-4673-b1a8-64fae4c1409b",
                                                "sense_id": "41368c6a-383c-3111-a826-44b7269b24b3",
                                                "text": "Les légionnaires du centurion Marcus, officier d’Arles, participaient vendredi 12 août à une marche expérimentale sur quatre kilomètres entre Le Fâ et Arces-sur-Gironde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
