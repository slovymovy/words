                "senses": [
                    {
                        "sense_id": "0e14c6c0-3cd1-316c-a192-fe4c19bd485a",
                        "entry_id": "3c1a8dbb-bf8d-3c68-af33-df6e879a2a2e",
                        "glosses": [
                            "członek amerykańskiego ruchu literacko-kulturowego lat pięćdziesiątych XX wieku"
