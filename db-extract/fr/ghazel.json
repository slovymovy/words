                "senses": [
                    {
                        "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                        "entry_id": "8f9af960-7380-347e-8f23-03a7218f7ad8",
                        "glosses": [
                            "Dans la poésie turque et persane, court poème lyrique de forme rigoureuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a5c8ab-33fe-4202-866d-595acea6c6fa",
                                "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                                "text": "– Je me rappelle un ghazel persan où un amant célèbre la finesse de la peau de sa maîtresse. \"Quand elle boit du vin rouge, dit-il, on le voit passer le long de sa gorge.\""
                            },
                            {
                                "example_id": "ca3aa695-b98d-459d-84a4-0ab5e5da2ae0",
                                "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                                "text": "Il est possible que la popularité du ghazel arabe de quatorze vers ait contribué au succès rapide de cette forme d'égale dimension."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffa92c07-8529-45c8-86a1-a61b82d95421",
                        "source_entry_id": "8f9af960-7380-347e-8f23-03a7218f7ad8",
                        "source_sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                        "target_lang_word": "Ghasel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ghasel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "081e88ea-3c10-3cba-ad66-b29bec9cc575",
                                        "entry_id": "d7683ee9-d06c-3205-8e09-20296f7cdff8",
                                        "glosses": [
                                            "arabische Form lyrischer Dichtung nach dem Reimschema aa, ba, ca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6388d537-6213-4f0f-95af-a1abaf645060",
                                                "sense_id": "081e88ea-3c10-3cba-ad66-b29bec9cc575",
                                                "text": "„Ich umarmte meine Mutter, aber ich erzählte ihr nichts von dem, was mir begegnet war, denn ich hatte in unseren Ghaselen gelesen, daß die Feen es lieben, wenn man ihr Geheimnis bewahrt.“"
                                            },
                                            {
                                                "example_id": "0c28dda6-6f12-486f-a847-c5b86d54b587",
                                                "sense_id": "081e88ea-3c10-3cba-ad66-b29bec9cc575",
                                                "text": "„Das war's etwa, was ich schreiben würde. Recht gut ineinander verschlungen, ein Ghasel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
