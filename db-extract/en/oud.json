        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7bbd044e-4853-3f06-b4c2-4735779336eb",
                "word": "oud",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bfb7ed1f-b8a9-4068-9e42-597f81ca153d",
                        "entry_id": "7bbd044e-4853-3f06-b4c2-4735779336eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "ouds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7bf7cac-ec87-3af5-abaf-9dcec5fd4338",
                        "entry_id": "7bbd044e-4853-3f06-b4c2-4735779336eb",
                        "glosses": [
                            "A short-necked and fretless plucked stringed instrument of the lute family, of Arab and Turkish origin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "512834da-d230-4a5f-a816-a7aa29f73f0c",
                                "sense_id": "c7bf7cac-ec87-3af5-abaf-9dcec5fd4338",
                                "text": "Common throughout the Arab and Persian world, the oud is a fretless short-neck lute with a pear-shaped, flat top, rounded back, and a peghead characteristically bent backwards at a very sharp angle. The oud's origins are unknown, although myths attribute either celestial or magical beginnings, it more likely came from ancient Persia."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a235c60-7b2b-3c81-b362-add0c2b86803",
                        "entry_id": "7bbd044e-4853-3f06-b4c2-4735779336eb",
                        "glosses": [
                            "Agarwood, in particular the noble rot of Aquilaria trees used to make perfumes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf30bb6f-a87a-4c43-aef3-f5abf4921593",
                                "sense_id": "6a235c60-7b2b-3c81-b362-add0c2b86803",
                                "text": "The recent fashion for oud (the noble rot of Aquilaria trees) took flight when YSL released M7, where the oud accord was center stage. It came with an advertising campaign featuring a hairy naked guy, a sight rated “beautiful” by my co-author. Real oud is complex material, with honey, tobacco, leaf, minty-fresh and castoreum animalic notes all mixed together."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82b42feb-6f61-4121-a2af-4604da7bde9b",
                        "source_entry_id": "7bbd044e-4853-3f06-b4c2-4735779336eb",
                        "source_sense_description": "Arabic plucked string instrument",
                        "target_lang_word": "úd",
