                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "364212b3-6588-40cb-b9dc-e9598bf1bd0f",
                                "sense_id": "8ad54ea2-45e7-3df3-bc8a-e99d92ec8dc5",
                                "text": "\"Je kunt het vergelijken met operette en opera: de lichtvoetigheid tegenover het zwaardere werk. rock-'n-roll is een uitingsvorm waarin op het scherpst van de snede wordt geopereerd. Een musical is geen geschikte kunstvorm om het leven van Herman Brood gestalte te geven.\""
                            },
                            {
                                "example_id": "333a4c8e-fdcc-4055-9f5d-fec370349cbc",
                                "sense_id": "8ad54ea2-45e7-3df3-bc8a-e99d92ec8dc5",
                                "text": "Hij heeft kennelijk de bedoeling om zijn koningschap meer (internationale) statuur en politieke relevantie te geven, en om mensen die hem lichtvoetigheid verwijten de wind uit de zeilen te nemen."
                            }
