                "senses": [
                    {
                        "sense_id": "bc7de20d-c615-3f18-80d8-8033be01c8d4",
                        "entry_id": "ab89067c-d5fe-332f-bdd4-9dbcf55ebe99",
                        "glosses": [
                            "Flatter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab26b42-0ee8-4914-ad35-84c5615b6182",
                                "sense_id": "bc7de20d-c615-3f18-80d8-8033be01c8d4",
                                "text": "Il y avait aussi la Roumanie de Ceausescu qui, elle aussi, tenait tête vaillamment à l’Union Soviétique. Et l’Europe de caresser, de flatter, de poupougner ce dictateur impitoyable et sanglant dont la véritable nature n’apparaîtrait que lors de la révolution qui le renverserait."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fd33f0c-06b1-3caf-9926-cf9330a302c0",
                        "entry_id": "ab89067c-d5fe-332f-bdd4-9dbcf55ebe99",
                        "glosses": [
                            "Cajoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9850481c-7988-48a1-9ea0-7d0433eae2c6",
                                "sense_id": "6fd33f0c-06b1-3caf-9926-cf9330a302c0",
                                "text": "Elle prie qu’on la laisse rentrer poupougner le fruit exotique de ses entrailles que la compagnie prolongée des cerbères-nounous peut perturber."
                            }
                        ]
                    }
