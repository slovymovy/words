                "senses": [
                    {
                        "sense_id": "60a7d5cd-a6be-3663-be4a-da3e83022fab",
                        "entry_id": "89eb3aeb-d19d-3f7c-8457-65b9d1cb8160",
                        "glosses": [
                            "festgelegte maximale Arbeitszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701238c9-fb10-4ccf-a2bb-20e79ec1ba98",
                                "sense_id": "60a7d5cd-a6be-3663-be4a-da3e83022fab",
                                "text": "„Arbeitgeberpräsident Ingo Kramer hatte zuvor gefordert, das Arbeitszeitgesetz sollte von einer täglichen auf eine wöchentliche Höchstarbeitszeit umgestellt werden, um mehr Spielräume zu schaffen und betriebliche Notwendigkeiten abzubilden.“"
                            },
                            {
                                "example_id": "078138eb-180c-42f4-b39a-2b3d590650e5",
                                "sense_id": "60a7d5cd-a6be-3663-be4a-da3e83022fab",
                                "text": "„Wird allerdings die gesetzliche Höchstarbeitszeit von 48 Stunden überschritten, so ein Urteil des BAG aus dem Jahre 2005, ist auch hier Schluss: Die Mehrarbeit muss bezahlt werden.“"
                            },
                            {
                                "example_id": "f3bfc145-6036-4c03-838f-1f2a4c15f127",
                                "sense_id": "60a7d5cd-a6be-3663-be4a-da3e83022fab",
                                "text": "„Die werktägliche Höchstarbeitszeit gemäß § 3 ArbZG soll daher auf eine wöchentliche Höchstarbeitszeit umgestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
