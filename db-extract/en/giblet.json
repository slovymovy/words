                        ]
                    },
                    {
                        "translation_id": "a42955dd-ce0f-4cca-a3e7-ba1b2426fe28",
                        "source_entry_id": "d7888a72-b96b-3a9b-b6fa-bfd14b73cd25",
                        "source_sense_id": "e82c7e2c-0c52-348f-a2a3-a48bc8069064",
                        "source_sense_description": "edible bird entrails",
                        "target_lang_word": "вну́тренности",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вну́тренности",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "accfcf5e-128b-3053-bb99-507ddd28a15f",
                                        "entry_id": "a80b193a-dea6-36f2-95c2-b517b78ef346",
                                        "glosses": [
                                            "анат. органы, расположенные в брюшной (в том числе и тазовой области), грудной и черепной полости человека и животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1294c17-f7ea-4f80-bccf-5be37295a844",
                                                "sense_id": "accfcf5e-128b-3053-bb99-507ddd28a15f",
                                                "text": "Пуля по близости удара пролетела насквозь; часть внутренностей несчастного была повреждена."
                                            },
                                            {
                                                "example_id": "1db3e6cc-da63-47cf-8487-8297af2710be",
                                                "sense_id": "accfcf5e-128b-3053-bb99-507ddd28a15f",
                                                "text": "То просто убитые, с маленькой ранкой на лбу, то залитые кровью, с отсечёнными членами, разбитыми внутренностями."
                                            },
                                            {
                                                "example_id": "b04924c3-e3d4-404d-bed0-3fd16fd5b59c",
                                                "sense_id": "accfcf5e-128b-3053-bb99-507ddd28a15f",
                                                "text": "Наскоро выпотрошив тушу, оставив из внутренностей только печень и сердце, охотники потащили нерпу на связанных жердях к лодке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04bc94be-f9a6-32c2-8d0e-c9f1c60fac3c",
                                        "entry_id": "a80b193a-dea6-36f2-95c2-b517b78ef346",
                                        "glosses": [
                                            "разг. внутренние части машины, устройства, механизма и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5054f10-b24b-4ec1-8090-8756bc917aac",
                                                "sense_id": "04bc94be-f9a6-32c2-8d0e-c9f1c60fac3c",
                                                "text": "В цехе группа людей в голубых халатах копалась во внутренностях новой установки."
                                            },
                                            {
                                                "example_id": "3de4a6b1-b78a-43f3-95a4-c2d0c975ab2f",
                                                "sense_id": "04bc94be-f9a6-32c2-8d0e-c9f1c60fac3c",
                                                "text": "Миша пулей выскочил из машины, поднял капот, стал рыться во внутренностях «Волги»."
                                            },
                                            {
                                                "example_id": "b11c2233-fda2-4460-a719-fb88276b7f28",
                                                "sense_id": "04bc94be-f9a6-32c2-8d0e-c9f1c60fac3c",
                                                "text": "Гораздо хуже, если вредные примеси не только оседают в виде накипи на внутренностях наших электрических чайников."
                                            }
                                        ]
                                    }
                                ]
                            },
