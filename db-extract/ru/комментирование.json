                    {
                        "translation_id": "59940f74-ace1-4924-bec6-817187bffb5f",
                        "source_entry_id": "5b622573-c304-38c4-b147-080371663b0a",
                        "source_sense_id": "bf9ac935-c431-36ac-baab-8d6577705064",
                        "target_lang_word": "Dolmetschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dolmetschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2415e379-bb4f-3da1-a097-80ca851e9840",
                                        "entry_id": "e8c408a0-6c61-3477-843d-efaa537c0d58",
                                        "glosses": [
                                            "übersetzter Text („das Gedolmetschte“); Übersetzungstext, Übersetzungsversion"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae3f012b-44a4-462f-9db6-0756256e1f85",
                                                "sense_id": "2415e379-bb4f-3da1-a097-80ca851e9840",
                                                "text": "„Gegen dieses Argument ließ sich keine Einwendung weiter machen. Da weder der Scheik, noch irgend einer der Heiden […] aus Kairo in Nürnberg gewesen war, so mußte er die Dolmetschung des Gartens aus dem Arabischen ins Deutsche, auf Treu und Glauben dahinnehmen.“"
                                            },
                                            {
                                                "example_id": "f8150842-3921-48da-88e7-816dd32789f8",
                                                "sense_id": "2415e379-bb4f-3da1-a097-80ca851e9840",
                                                "text": "„Was die Dolmetschung eines neuen Auslegers sagen wolle, daß die Schafe aus der Quelle kommen und prohibitae potu sind, verstehe ich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6cf0db8-66ba-3401-b47a-5791d1591561",
                                        "entry_id": "e8c408a0-6c61-3477-843d-efaa537c0d58",
                                        "glosses": [
                                            "Tätigkeit, Vorgang des Übersetzens"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350ef70e-590a-4a26-aecf-b49365df1794",
                                                "sense_id": "a6cf0db8-66ba-3401-b47a-5791d1591561",
                                                "text": "„Da beide das Deutsche nur gebrochen redeten, fielen sie in der Hitze des Gefechtes immer in ihre Muttersprachen zurück und wurden einander vollkommen unverständlich. Dergleichen Zankduette waren die Wonne vertrauter Hausfreunde; Graf Wallenberg, des Böhmischen und des Italienischen mächtig, versäumte niemals, die zwei Feinde zusammenzubringen und durch die perfideste Dolmetschung zur höchsten Leidenschaftlichkeit zu steigern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f5ae3c2e-6856-3970-b1b9-416b70034e7a",
                                        "entry_id": "e8c408a0-6c61-3477-843d-efaa537c0d58",
                                        "glosses": [
                                            "Deutung / Interpretation"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d98e66-1e18-4a9d-b13d-aedbe0d488a5",
                                                "sense_id": "f5ae3c2e-6856-3970-b1b9-416b70034e7a",
                                                "text": "„Dies alles ist Überwindung, Befreiung von der Billigung des Gegebenen. Untertanlosigkeit gegen alle blosse Dolmetschung des Lebens.“"
                                            },
                                            {
                                                "example_id": "47bed43c-6312-4d46-9ffc-732c9b33abce",
                                                "sense_id": "f5ae3c2e-6856-3970-b1b9-416b70034e7a",
                                                "text": "„Dieses bedeutende Gesicht, und die schaudervolle Erscheinung durchbebten die Seele Fausts; er sprang auf, öffnete das Fenster, um freie Luft zu atmen, die ungeheuren Alpen lagen vor ihm, die aufgehende Sonne vergoldete nun eben ihre dunklen Spitzen, und dieses Bild schien ihm eine Dolmetschung seines Gefühls.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46d4c639-a045-489d-8362-a8778d8bf43a",
                        "source_entry_id": "5b622573-c304-38c4-b147-080371663b0a",
                        "source_sense_id": "bf9ac935-c431-36ac-baab-8d6577705064",
                        "target_lang_word": "Erläuterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erläuterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "Erklärung (von Zusammenhängen, Sachverhalten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8097fa6-da91-4a30-bdc4-a5133b081776",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "Die Erläuterungen des Vortragenden waren viel zu umständlich."
                                            },
                                            {
                                                "example_id": "b9611590-50de-41c2-8419-2654c873bab8",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Nach dieser Erläuterung erzählte der Mönch die Geschichte der Bank zu Ende, denn die Griechen hatten es nicht bei ihrem Mißtrauen belassen.“"
                                            },
                                            {
                                                "example_id": "45c60c16-f36a-4f67-9f5e-b13c0c5fab60",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Um einen guten und gut erzählten Witz zu verstehen, braucht man natürlich keine Erläuterungen, schon gar keine sprachwissenschaftlich oder sonstwie wissenschaftlich untermauerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "ein Rechtsbehelf"
                                        ],
                                        "tags": [
                                            "schweizerisches Verwaltungsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb3b5df-d1e0-4d72-b052-06ea54523583",
                                                "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                                "text": "Sowohl Erläuterung als auch Berichtigung haben nicht den Zweck der Änderung eines Entscheides, sondern nur einer Klarstellung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99cca8f3-79a5-40ea-9d01-b9946650121c",
                        "source_entry_id": "5b622573-c304-38c4-b147-080371663b0a",
                        "source_sense_id": "bf9ac935-c431-36ac-baab-8d6577705064",
                        "target_lang_word": "exégèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exégèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7bc53e-b4b9-3c2a-8391-17af7d713400",
                                        "entry_id": "d1bc5700-225c-3360-a28a-7451edcafbfe",
                                        "glosses": [
                                            "Explication grammaticale et étymologique d'un texte ancien difficile, assortie d'un commentaire savant et d'une interprétation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185ac3ad-3d9b-40a6-8f75-cf82b603af16",
                                                "sense_id": "ce7bc53e-b4b9-3c2a-8391-17af7d713400",
                                                "text": "Ce que nous venons de dire suppose que l’exégèse et l’eiségèse sont corrélatives, comme la montée et la descente d’un même chemin. Il ne serait pas nécessaire d’inventer le mot « eiségèse » si l’exégèse n’avait la prétention d’être seulement une « sortie » à partir du texte."
                                            },
                                            {
                                                "example_id": "2f843e90-b575-4c73-907f-fce1cc3439bc",
                                                "sense_id": "ce7bc53e-b4b9-3c2a-8391-17af7d713400",
                                                "text": "[…] même si l’exégèse montre qu’il sera moins une pièce qu’on endosse qu’une pièce qu’on garde pliée avec soi."
                                            },
                                            {
                                                "example_id": "70b21da6-b308-4526-b900-7cbd5dbe01a5",
                                                "sense_id": "ce7bc53e-b4b9-3c2a-8391-17af7d713400",
                                                "text": "Bien qu’émanent d’un non-Musulman, d’un laïc, et traitées sans complaisance, les considérations émises dans ces pages auront concédé à la foi des fidèles la part nécessaire pour mieux approcher le texte. L’objectivité devrait tenir compte de cette foi sous peine d’impropriété. Elle y trouverait aussi, négativement, une garantie contre les erreurs ou les abus de l’exégèse."
                                            },
                                            {
                                                "example_id": "45d96eed-d2cc-44d8-a4b6-6aedc5cb7af5",
                                                "sense_id": "ce7bc53e-b4b9-3c2a-8391-17af7d713400",
                                                "text": "Syrianus, raconte Marinus, avait proposé à Proclus et à Domninus de leur faire l’exégèse soit des Oracles chaldaïques soit des poèmes orphiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312320ab-2c9f-3abd-8860-fa3dd2fc6308",
                                        "entry_id": "d1bc5700-225c-3360-a28a-7451edcafbfe",
                                        "glosses": [
                                            "Étude approfondie d'un texte et en particulier d'un texte sacré ancien. Commentaire philologique, explication historique, et interprétation de la Bible."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec68a65-1d95-4d0c-8c6e-2dc220171433",
                                                "sense_id": "312320ab-2c9f-3abd-8860-fa3dd2fc6308",
                                                "text": "Le phénix devint rapidement une figure familière dans les cercles paracelsistes, tout en suscitant des exégèses assez variées."
                                            },
                                            {
                                                "example_id": "d63d0f22-565a-4a2d-8d9e-51e1fb763299",
                                                "sense_id": "312320ab-2c9f-3abd-8860-fa3dd2fc6308",
                                                "text": "La liberté, où tant d’étourdis se trouvent portés du premier bond, fut pour moi une acquisition lente. Je n’arrivai au point d’émancipation que tant de gens atteignent sans aucun effort de réflexion qu’après avoir traversé toute l’exégèse allemande. Il me fallut six années de méditation et de travail forcené pour voir que mes maîtres n’étaient pas infaillibles."
                                            },
                                            {
                                                "example_id": "cb6c0e1c-c2a1-41f3-8d82-ec73db21dea5",
                                                "sense_id": "312320ab-2c9f-3abd-8860-fa3dd2fc6308",
                                                "text": "La supériorité des juifs, en matière d’exégèse biblique, est si manifeste qu’elle provoque souvent la conversion au judaïsme de membres du Clergé […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2afcfee-2b12-3077-b440-c2eafdc95752",
                                        "entry_id": "d1bc5700-225c-3360-a28a-7451edcafbfe",
                                        "glosses": [
                                            "ou Explication d’un écrit, rendue nécessaire par son caractère prétentieux et alambiqué."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214539c7-1eee-41ea-93fe-7de92aeeef18",
                                                "sense_id": "e2afcfee-2b12-3077-b440-c2eafdc95752",
                                                "text": "On lui remet une feuille jaune : « Renseignements généraux concernant les mariages. » [… Il devra] se faire administrer une exégèse de la feuille jaune [par son notaire]"
                                            },
                                            {
                                                "example_id": "f6391ce1-67d0-4deb-9794-01303be6c807",
                                                "sense_id": "e2afcfee-2b12-3077-b440-c2eafdc95752",
                                                "text": "Pour Kouchner, l’exégèse laborieuse de ses propres déclarations avait aussi pour objectif de se démarquer un tant soit peu des positions américaines sur la question du nucléaire iranien."
                                            },
                                            {
                                                "example_id": "6df5fb7d-0b9f-4ae1-b98f-aca3b26f1370",
                                                "sense_id": "e2afcfee-2b12-3077-b440-c2eafdc95752",
                                                "text": "Finalement, on cherche l’exégèse en toute chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
