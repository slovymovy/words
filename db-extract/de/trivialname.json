                "senses": [
                    {
                        "sense_id": "167d9853-67f1-3fa9-970a-8f12f12e2404",
                        "entry_id": "2f3ef71b-5e29-3504-9a56-d0fe746f5451",
                        "glosses": [
                            "nicht wissenschaftlich erfasste, meist allerdings bekanntere Bezeichnung eines Objektes"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9679b963-1651-34e2-958a-fec9931a26bb",
                        "entry_id": "2f3ef71b-5e29-3504-9a56-d0fe746f5451",
                        "glosses": [
                            "Stoffbezeichnungen, die von der Nomenklaturgebung der IUPAC abweichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda5f80f-7295-4fee-aaf1-98c187efcb35",
                                "sense_id": "9679b963-1651-34e2-958a-fec9931a26bb",
                                "text": "Der Trivialname von Ethin ist Acetylen."
                            },
                            {
                                "example_id": "2b13bb16-d9b3-4815-b2f5-5ba117aa30ed",
                                "sense_id": "9679b963-1651-34e2-958a-fec9931a26bb",
                                "text": "Der Trivialname von Ethansäure ist Essigsäure."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "4cc9b5b2-2ea4-3d8d-92b4-dd0a185fecf8",
                        "entry_id": "2f3ef71b-5e29-3504-9a56-d0fe746f5451",
                        "glosses": [
                            "Bezeichnung für Lebewesen, die nicht dem wissenschaftlichen Namen entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "305a509d-f47e-49d1-aac1-6c80ecffd29e",
                                "sense_id": "4cc9b5b2-2ea4-3d8d-92b4-dd0a185fecf8",
                                "text": "Trivialnamen von Vaccinium myrtillus sind Blaubeere oder auch Heidelbeere."
                            },
                            {
                                "example_id": "40fae004-81a7-4f5b-bfa2-02a87d518bf5",
                                "sense_id": "4cc9b5b2-2ea4-3d8d-92b4-dd0a185fecf8",
                                "text": "„Was uns ferner aus der ältesten europäischen Literatur, die bei den Griechen im 8. Jahrhundert vor Christus mit HOMER einsetzt, über die mykenischen Texte aber bis ins 15. Jahrhundert vor Christus hinaufreicht, an Pflanzennamen entgegentritt, hat von den wenigen Ausnahmefällen abgesehen, die hier beschrieben wurden, lediglich den Status einzelsprachlicher Trivialnamen ohne erkennbaren Urheber.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
                ],
                "translations": [
