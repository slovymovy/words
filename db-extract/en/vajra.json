            {
                "entry_id": "d05edfc5-1c39-33cb-847c-75b77d47c1fb",
                "word": "vajra",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a2cb1999-12ac-469a-9681-dc84fd861744",
                        "entry_id": "d05edfc5-1c39-33cb-847c-75b77d47c1fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "vajras"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f59f9e78-31be-382e-a01a-8bfe8e4d5e9a",
                        "entry_id": "d05edfc5-1c39-33cb-847c-75b77d47c1fb",
                        "glosses": [
                            "A Buddhist ceremonial mace and symbol, usually interpreted as both a diamond and a thunderbolt."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9657fc96-4e72-431d-8688-550f0c711dce",
                                "sense_id": "f59f9e78-31be-382e-a01a-8bfe8e4d5e9a",
                                "text": "At the centre is a five-pronged vajra draped and bound with a coloured silk scarf, representing one of the Five Buddha wisdoms or activities."
                            }
                        ]
                    },
                    {
                        "sense_id": "d350c013-3401-3b55-9186-86b6ea36404f",
                        "entry_id": "d05edfc5-1c39-33cb-847c-75b77d47c1fb",
                        "glosses": [
                            "One of the five central Buddhist principles, representing indestructible substance that cuts and penetrates through emotional instability or uncertainty."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4df6b21-abd6-4bf5-83c2-86919e17ac32",
                                "sense_id": "d350c013-3401-3b55-9186-86b6ea36404f",
                                "text": "Those five principles or buddha families are called vajra, ratna, padma, karma, and buddha."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe186f7a-108d-3ab6-a1b8-4810574ee287",
                        "entry_id": "d05edfc5-1c39-33cb-847c-75b77d47c1fb",
                        "glosses": [
                            "The weapon of Indra, the god of heaven and the chief deity of the Rigvedic pantheon, used to kill sinners and ignorant persons."
                        ],
                        "tags": [
                            "Rigveda",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
