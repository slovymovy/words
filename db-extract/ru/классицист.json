                    }
                ],
                "translations": [
                    {
                        "translation_id": "53c687eb-e808-4087-b789-bcff5573ecee",
                        "source_entry_id": "0cd8ae61-406a-3fbe-b14b-7a4f1291ece9",
                        "source_sense_id": "5208eb8f-3240-3c34-8b6c-525f7463c1c4",
                        "target_lang_word": "classic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0daed588-4840-3fa9-8517-82dbdc26bdff",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Of or relating to the first class or rank, especially in literature or art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3ff2fe-86f7-47c7-8648-ad68261bd16e",
                                                "sense_id": "0daed588-4840-3fa9-8517-82dbdc26bdff",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "3f96b1c7-0a5b-41fa-ba0b-2b9b3ab7b163",
                                                "sense_id": "0daed588-4840-3fa9-8517-82dbdc26bdff",
                                                "text": "Give, as thy last memorial to the age, / One classic drama, and reform the stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b97451-59fc-3870-8815-fe313dc59a42",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Exemplary of a particular style; defining a class/category; typical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a3c9ad-38cf-4887-924e-ab52a44b39c9",
                                                "sense_id": "b4b97451-59fc-3870-8815-fe313dc59a42",
                                                "text": "He has a classic case of narcissism."
                                            },
                                            {
                                                "example_id": "eb78ba33-930a-4f23-b7a8-250475f3a5c8",
                                                "sense_id": "b4b97451-59fc-3870-8815-fe313dc59a42",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eaaf732-9dc8-3c65-9935-a1795df3e818",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Exhibiting timeless quality and excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7215b12-4894-48b5-83d3-77fbbcf0169f",
                                                "sense_id": "3eaaf732-9dc8-3c65-9935-a1795df3e818",
                                                "text": "\"To Kill a Mockingbird\" is a 1960 classic book by Harper Lee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e122f217-3a33-31ca-ad78-26785280da5a",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Characteristic of or from the past; old; retro; vintage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69fb5734-c759-4a3f-bf59-a608aa04935b",
                                                "sense_id": "e122f217-3a33-31ca-ad78-26785280da5a",
                                                "text": "watching classic movies as a hobby"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaecb1d4-fadd-3ca0-99d1-f278395a48de",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Of or pertaining to the ancient Greeks and Romans, especially to Greek or Roman authors of the highest rank, or of the period when their best literature was produced; of or pertaining to places inhabited by the ancient Greeks and Romans, or rendered famous by their deeds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62123e28-a130-43c8-88a7-2035c2e16dce",
                                                "sense_id": "eaecb1d4-fadd-3ca0-99d1-f278395a48de",
                                                "text": "1819, Felicia Hemans, The Widow of Crescentius\nThough throned midst Latium's classic plains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "587cab0d-d692-33f9-b486-16ba256ef6ae",
                                        "entry_id": "bbf701ed-7e0a-32eb-94ce-3a280a4fc676",
                                        "glosses": [
                                            "Traditional; original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b2cd7e-fd36-4af6-b148-bc8ff71f61ba",
                                                "sense_id": "587cab0d-d692-33f9-b486-16ba256ef6ae",
                                                "text": "Users who dislike the new visual layout can return to classic mode."
                                            },
                                            {
                                                "example_id": "fa31523d-8080-42c6-ba42-0b02aa7ee404",
                                                "sense_id": "587cab0d-d692-33f9-b486-16ba256ef6ae",
                                                "text": "Many of these classic methods are still used, with some modern improvements. For example, with the aid of special microphones and automated sound detection software, ornithologists recently reported […] that pine siskins (Spinus pinus) undergo an irregular, nomadic type of nocturnal migration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "classic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04400a2a-2dad-3403-b788-37270dab9004",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "A perfect and/or early example of a particular style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8215d6f4-10e6-3ea8-a6ac-6e558fc9be3d",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "An artistic work of lasting worth, such as a film or song; a work of enduring excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d487d4b5-3f88-49db-b265-6c6d51553ec3",
                                                "sense_id": "8215d6f4-10e6-3ea8-a6ac-6e558fc9be3d",
                                                "text": "JAMES CARTER: The man's destroying a classic!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fecf4db7-59f4-3f8c-9d28-dadf87bd2c7c",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "The author of such a work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a11e4ac-f140-4b37-8b8b-815e1ab25694",
                                                "sense_id": "fecf4db7-59f4-3f8c-9d28-dadf87bd2c7c",
                                                "text": "It was the first work to which he had put his name; and it at once raised him to the rank of a legitimate English classic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0d886f-5536-39e6-b7b5-83f04c2c9205",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "A major, long-standing sporting event."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fd2ffe1-63c6-3dac-9847-7f751bba2d67",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "A major, long-standing sporting event.",
                                            "Any of the British Classic Races, five long-standing Group 1 horse races run during the traditional flat racing season."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b5604c-9a49-4a72-9a68-57497a9c0f9e",
                                                "sense_id": "2fd2ffe1-63c6-3dac-9847-7f751bba2d67",
                                                "text": "The goal of the top horses was to win a Classic (or preferably three, thus claiming the Triple Crown) or the Ascot Gold Cup, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "504c2bb2-b384-3208-9f10-dadc49c61711",
                                        "entry_id": "d9342049-587f-359e-95f6-5a0f8c9b7218",
                                        "glosses": [
                                            "One learned in the literature of Ancient Greece and Ancient Rome; a student of classical literature."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
