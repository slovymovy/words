                "senses": [
                    {
                        "sense_id": "e187064a-8649-3af1-9867-b1984731f928",
                        "entry_id": "4094034d-14cc-3543-9b95-2765697de59a",
                        "glosses": [
                            "Antrag, bei dem kurz vor Ende der befristeten Untersuchungshaft geprüft werden kann, ob die Gründe für die Inhaftierung noch gegeben sind"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "8fc03fce-20e4-4b43-9c48-aa00b68f5064",
                                "sense_id": "e187064a-8649-3af1-9867-b1984731f928",
                                "text": "„Das Wiener Straflandesgericht hat am Donnerstag den Enthaftungsantrag des ehemaligen BAWAG- Generaldirektors Helmut Elsner abgelehnt und die U- Haft des 74- Jährigen erneut verlängert.“"
                            },
                            {
                                "example_id": "53aa3377-3deb-4448-9a6e-92a5cdb856c1",
                                "sense_id": "e187064a-8649-3af1-9867-b1984731f928",
                                "text": "„Der Oberste Gerichtshof gab dem Beschwerdeführer Recht und stellte fest, dass er durch zu späte Entscheidung über seinen Enthaftungsantrag im Grundrecht auf persönliche Freiheit verletzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
