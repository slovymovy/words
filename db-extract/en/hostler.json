                "senses": [
                    {
                        "sense_id": "0fe384ac-db52-32eb-a57c-38a952132d5b",
                        "entry_id": "29f4e5a5-35f9-3656-b281-43aa0e18980a",
                        "glosses": [
                            "A worker employed at an inn, hostelry, or stable to look after horses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ca5307-184f-4423-864d-8d50e1b38f73",
                                "sense_id": "0fe384ac-db52-32eb-a57c-38a952132d5b",
                                "text": "As the chaise drove through Clavering, the hostler standing whistling under the archway of the Clavering Arms, winked the postilion ominously, as much as to say all was over."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bda228e-bcfe-3e6e-a6f0-5f02c0293b7c",
                        "entry_id": "29f4e5a5-35f9-3656-b281-43aa0e18980a",
                        "glosses": [
                            "A railway worker employed to care for a locomotive or other large engine; especially, a yard jockey."
                        ],
                        "tags": [
                            "US",
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66ba75aa-c79a-4be0-816b-b6510621b525",
                        "source_entry_id": "29f4e5a5-35f9-3656-b281-43aa0e18980a",
                        "source_sense_description": "person at an inn who looks after horses",
                        "target_lang_word": "staljongen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staljongen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bd4dbe18-8a06-33ec-b188-403ad47ca884",
                                        "entry_id": "f3f56b43-a1ea-33b3-a4b5-530229bcb71f",
                                        "glosses": [
                                            "een jonge mannelijke knecht die werkt in de stal en de dieren die daarin staan verzorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c194269-e3b9-4e0f-897f-cb3ef13a2ad6",
                                                "sense_id": "bd4dbe18-8a06-33ec-b188-403ad47ca884",
                                                "text": "Equus van Peter Shaffer door het Nationale Toneel in regie van Johan Doesburg. Een psychiater krijgt een staljongen in behandeling die is geobsedeerd door paarden."
                                            },
                                            {
                                                "example_id": "ea3aa484-948f-444e-9dd6-1eccb7002d85",
                                                "sense_id": "bd4dbe18-8a06-33ec-b188-403ad47ca884",
                                                "text": "Black Beauty eindigde in races meestal als laatste. Maar voor een race in Londonderry stond zij in een stal waarin foto’s van Passendale aan de wand waren geprikt door een staljongen die de oorlog had overleefd. Die vertelde later hoe Black Beauty hevig begon te zweten, een heftig gehinnik uitstootte, schuim op de lippen kreeg en hoe haar ogen zich vulden met bloed. Daarna begon ze heftig te rillen en met het hoofd tegen de stalmuur te beuken.’Wat gebeurde er?‘In die huiveringwekkende ogenblikken verwerkte Black Beauty haar oorlogstrauma. En daarna was ze onverslaanbaar’ Waarvan acte"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fdea76f-16ea-4acf-affb-e93960dc5f07",
                        "source_entry_id": "29f4e5a5-35f9-3656-b281-43aa0e18980a",
                        "source_sense_description": "person at an inn who looks after horses",
                        "target_lang_word": "palefrenier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palefrenier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                        "entry_id": "69d43a41-34e6-30b0-a204-8a80098953d3",
                                        "glosses": [
                                            "Employé d’une structure équestre chargé de l’entretien des écuries et des soins quotidiens aux chevaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b01e666-8c0d-457b-826d-1332807040ec",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Le coursier fut conduit dans la lice par deux palefreniers richement vêtus."
                                            },
                                            {
                                                "example_id": "487aa859-7a7e-4f3c-ac84-09c61367457a",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Les écuries du roi et l'hôtel des gardes-du-corps devinrent pour eux un nouveau sujet de désordre; ils s’y précipitèrent en foule et jetèrent l’effroi parmi les valets d'écurie et les palefreniers."
                                            },
                                            {
                                                "example_id": "1758c259-5e87-416b-8ad8-f3f3fe82e4b2",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "M. de la Vablerie-Chamberlan n’aimait que la chasse ; il avait six chiens au fond de sa cour et une voiture à deux chevaux ; le père Robert, de la rue des Capucins, leur servait de cocher, de palefrenier, de domestique et de piqueur."
                                            },
                                            {
                                                "example_id": "690ac234-bbe9-4b1a-ae64-f0bfba88f468",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Avant de sortir le cheval, le piqueur ou le palefrenier le peigne, le lisse, et, en retirant la couverture, si on le lui ordonne, il en profite pour l’emboucher."
                                            },
                                            {
                                                "example_id": "f38835ec-3138-4369-b7a7-3b722c0ef88a",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Charlemagne m’apparut comme un gros palefrenier allemand ; nos chevaliers me semblèrent des lourdauds, dont Thémistocle et Alicibiade eussent souri."
                                            },
                                            {
                                                "example_id": "2715bd1d-fd27-4f5d-ba63-987786abea8b",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Quatre chevaux splendides, tout sellés et bridés, marchent aux deux côtés de la route, tenus en main par des palefreniers nègres."
                                            },
                                            {
                                                "example_id": "d15144a5-2d3e-4485-83b8-42c60f478da5",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Le haras s’étend sur plusieurs hectares d'une herbe de contes de fées. J'emprunte une allée bordée de fusains et débouche sur la cour centrale où un palefrenier et un maître de manège s'engueulent virilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c05eed-6f60-4e81-999f-84fef49aa52e",
                        "source_entry_id": "29f4e5a5-35f9-3656-b281-43aa0e18980a",
