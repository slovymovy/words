        "nl-extract.jsonl": [
            {
                "entry_id": "f3a788d4-ffc0-3d43-9296-f0f3ee7ae661",
                "word": "platweg",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "938c064d-6da6-3b43-92d2-cd3238619b90",
                        "entry_id": "f3a788d4-ffc0-3d43-9296-f0f3ee7ae661",
                        "glosses": [
                            "op een ordinaire manier; met gewone woorden; zonder omhaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847afef7-794b-447e-a6c2-12de0d80fdf4",
                                "sense_id": "938c064d-6da6-3b43-92d2-cd3238619b90",
                                "text": "Jerson Cabral hoopte vanavond zijn debuut te maken voor Kaapverdië, maar was niet op tijd speelgerechtigd. Hij mist niet veel. De eerste helft is niet om aan te gluren. De Kaapverdianen kunnen er platweg gezegd geen reet van en Marokko is alleen gevaarlijk bij spelhervattingen."
                            },
                            {
                                "example_id": "730eb942-4b1e-42d4-b28e-d6e24e297301",
                                "sense_id": "938c064d-6da6-3b43-92d2-cd3238619b90",
                                "text": "Vandaar dat de inhoud van de versjes nogal eens kinderlijk onzinnig, brutaal spottend of platweg vulgair is. Parodieën op kindergebeden (uit het Vlaamse taalgebied) en andere liedjes laten zien dat ook op godsdienstig gebied de eerbied soms ver te zoeken was."
                            }
                        ]
                    },
                    {
                        "sense_id": "b38a05e0-05e2-3b50-918b-f7d8c4557938",
                        "entry_id": "f3a788d4-ffc0-3d43-9296-f0f3ee7ae661",
                        "glosses": [
                            "makkelijk; zonder diepgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "822d9b1d-caad-484b-b27e-2c1938bd90f9",
                                "sense_id": "b38a05e0-05e2-3b50-918b-f7d8c4557938",
                                "text": "Betekenis dient zich pas aan zodra je belangstellend bent in plaats van platweg nieuwsgierig, en je vervolgens je bevindingen precies weergeeft, in plaats van ze lukraak prijs te geven. Zo leert je ook dat suggestieve ‘Ziekenbezoek’. Judith Herzberg schrijft regels om je aan te laven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c034216b-def3-46be-9a55-9028e6cfa51a",
                        "source_entry_id": "f3a788d4-ffc0-3d43-9296-f0f3ee7ae661",
                        "source_sense_id": "938c064d-6da6-3b43-92d2-cd3238619b90",
                        "source_sense_description": "op een ordinaire manier; met gewone woorden; zonder omhaal",
                        "target_lang_word": "bluntly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bluntly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                        "entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                                        "glosses": [
                                            "In a blunt manner; without delicacy, or the usual forms of civility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c948693-1f19-478c-84d3-c40f0ab41782",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                                            },
                                            {
                                                "example_id": "8e8f4e80-d6d8-4612-9df6-f4a278baded9",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "To put it bluntly, they are going to have to start defending a heck of a lot better than they have been, otherwise their season - and top-flight status - could well be over before they know it."
                                            },
                                            {
                                                "example_id": "26f6ec1f-eaee-4e3b-8752-d5a5eca50a61",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "Drivers' union ASLEF bluntly rebuffed the claim of unofficial action, calling it a lie. And Avanti West Coast was unable to provide any proof for its assertion, when questioned by RAIL."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
