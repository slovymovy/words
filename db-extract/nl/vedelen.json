                        ],
                        "examples": [
                            {
                                "example_id": "c369e6ea-fab3-4181-a898-29c529400c2e",
                                "sense_id": "d58e30a3-71e0-34d9-8339-c0e4f0c3f0df",
                                "text": "Op de muziekbijeenkomst voor Oude Muziek werd uitbundig gevedeld en kromhoorn gespeeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a94adaa-3acf-3c80-be83-d23b55648859",
                        "entry_id": "271d2d03-d101-3362-bb1d-160ca88c2950",
                        "glosses": [
                            "met een viool volksmuziek spelen, al of niet voor geld"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "8d544519-6b95-4940-aaa3-b72869807016",
                                "sense_id": "3a94adaa-3acf-3c80-be83-d23b55648859",
                                "text": "Nooit heeft hij 't brood gebedeld,\nOfschoon dat meerder won;\nHij heeft er om gevedeld\nTot hij 't ontberen kon."
                            }
                        ]
                    }
