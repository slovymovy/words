                                "sense_id": "0ba4cb3c-7a77-31a7-ab90-ba9fb153d706",
                                "text": "Dziękuję, że zgodziła się pani na interview."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b3944391-2cdf-3d72-bf66-7b7d9805f01a",
