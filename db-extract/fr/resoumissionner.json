                "senses": [
                    {
                        "sense_id": "57fd7a78-d22f-3e1d-9905-082d2fee7f47",
                        "entry_id": "6b970f49-0cea-3c68-b17a-45ba3170f278",
                        "glosses": [
                            "Soumissionner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ace5109-97a6-439a-8231-94400a629f25",
                                "sense_id": "57fd7a78-d22f-3e1d-9905-082d2fee7f47",
                                "text": "Accor précise que les sociétés déjà présentes sur le marché doivent toutefois resoumissionner pour les nouveaux appels d'offre."
                            },
                            {
                                "example_id": "a3916667-1324-49de-b23f-f9daa05708e8",
                                "sense_id": "57fd7a78-d22f-3e1d-9905-082d2fee7f47",
                                "text": "Il peut arriver et resoumissionner sur le 20 ou 21 millions quand même."
                            },
                            {
                                "example_id": "555f8eda-d01b-4e09-b266-372979110e4d",
                                "sense_id": "57fd7a78-d22f-3e1d-9905-082d2fee7f47",
                                "text": "Il a donc fallu resoumissionner les appels d'offres, retard dans le chantier et au bout du compte une ardoise qui prend de l'ampleur."
                            }
                        ]
                    }
