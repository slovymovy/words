                            },
                            {
                                "target_lang_word": "serbest bırakmak",
                                "target_lang_sense_clarification": "özgürlüğüne kavuşturmak"
                            },
                            {
                                "target_lang_word": "dışarı çıkarmak",
                                "target_lang_sense_clarification": "kapalı alandan izin vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2112ee-bc96-3798-8b51-3d90df86c345",
                    "sense_definition": "Произвести товар, издать книгу, опубликовать материал или создать фильм для широкой аудитории.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Известная группа планирует <выпустить> новый альбом в следующем месяце.",
                            "target_lang_translations": {
                                "en": "The famous band plans to <release> a new album next month.",
                                "tr": "Ünlü grup önümüzdeki ay yeni bir albüm <çıkarmayı> planlıyor."
                            }
                        },
                        {
                            "text": "Завод обещал <выпустить> первую партию автомобилей к концу года.",
                            "target_lang_translations": {
                                "en": "The factory promised to <produce> the first batch of cars by the end of the year.",
                                "tr": "Fabrika yıl sonuna kadar ilk otomobil partisini <üretmeye> söz verdi."
                            }
                        },
                        {
                            "text": "Издательство решило <выпустить> книгу в твердом переплете.",
                            "target_lang_translations": {
                                "en": "The publishing house decided to <publish> the book in hardcover.",
                                "tr": "Yayınevi kitabı ciltli olarak <yayımlamaya> karar verdi."
                            }
