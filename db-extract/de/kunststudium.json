                "senses": [
                    {
                        "sense_id": "0e36bd7e-ed1e-3289-a500-daf951cb4876",
                        "entry_id": "ef5ae93e-c461-3ac7-a426-82fefedccc71",
                        "glosses": [
                            "Studium der Bildenden Kunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a0dff1-6704-450f-8fd7-ad4ee042b79b",
                                "sense_id": "0e36bd7e-ed1e-3289-a500-daf951cb4876",
                                "text": "„1939, nach seiner Faltbootfahrt, erhält er ein Stipendium für die Dresdener Hochschule der Bildenden Künste, und so beginnt er sein Kunststudium.“"
                            },
                            {
                                "example_id": "7dad1d4a-4bcd-4258-9ab0-da94e44b54fc",
                                "sense_id": "0e36bd7e-ed1e-3289-a500-daf951cb4876",
                                "text": "„1909 in Stockholm geboren, ist sie erst zwanzig Jahre alt, als sie nach Kunststudien in Oslo und Wien den gebürtigen Leipziger Hartung in Paris kennenlernt.“"
                            },
                            {
                                "example_id": "9dea12c1-7840-420c-8e66-37ad791d416c",
                                "sense_id": "0e36bd7e-ed1e-3289-a500-daf951cb4876",
                                "text": "„Trotzdem zwang sich Wilhelm Busch, die vom Vater so schwer erkämpfte Erlaubnis zum Kunststudium auszunutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
