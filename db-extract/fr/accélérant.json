                    {
                        "sense_id": "cee3f6b1-ab50-3087-916c-ee880f053fdc",
                        "entry_id": "fe19dc10-1326-3bab-9709-a2eac39f902c",
                        "glosses": [
                            "Qui accélère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cc58a1-d091-4549-8a01-dd77d8a9f277",
                                "sense_id": "cee3f6b1-ab50-3087-916c-ee880f053fdc",
                                "text": "J’appelle machines accélérantes celles qui sont mises en mouvement par des puissances accélérantes ou retardantes."
                            },
                            {
                                "example_id": "20cfdd22-288d-46cf-86dc-a853f4efb12b",
                                "sense_id": "cee3f6b1-ab50-3087-916c-ee880f053fdc",
                                "text": "Pour reprendre des exemples célèbres, il est certain que si la température allait en se différenciant, ou si la viscosité se faisait accélérante, on ne pourrait plus « prévoir »."
                            },
                            {
                                "example_id": "dae0e2c5-fa0d-4ada-9590-ae94b0f364f6",
                                "sense_id": "cee3f6b1-ab50-3087-916c-ee880f053fdc",
                                "text": "Le cadre en acacia massif donne un rebond incomparable. Son cadre est doté de bandes accélérantes permettant un rebond respectant la norme officielle de jeu."
                            }
                        ]
                    }
