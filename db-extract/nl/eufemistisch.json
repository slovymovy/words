                    {
                        "sense_id": "4f74925e-985e-3857-ac9d-4dd6edef8e4c",
                        "entry_id": "d6e72b10-530e-3c97-a96f-db35ef2bb144",
                        "glosses": [
                            "op een manier die niet zo pijnlijk, maar ook minder duidelijk overkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8589e7f6-fb5e-493a-8ee0-5ce280c9fd80",
                                "sense_id": "4f74925e-985e-3857-ac9d-4dd6edef8e4c",
                                "text": "In 2000 was 12% van de 55-plussers ouder dan 80 jaar, tegen 2030 stijgt dit aandeel naar 19% (…). Die evolutie wordt dubbele vergrijzing of, nogal eufemistisch, verzilvering genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36ee675b-d30d-45dc-9336-1029667798e0",
                        "source_entry_id": "d6e72b10-530e-3c97-a96f-db35ef2bb144",
                        "source_sense_id": "4f74925e-985e-3857-ac9d-4dd6edef8e4c",
                        "target_lang_word": "euphemistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphemistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                        "entry_id": "e034f2d2-6fd5-371f-8657-7a7c5655c382",
                                        "glosses": [
                                            "etwas freundlicher darstellend, als es der Wirklichkeit entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5045a542-8fce-4926-9cf3-af4b4d76d990",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Nullwachstum“ ist eine euphemistische Bezeichnung für Stagnation in der Wirtschaftsentwicklung."
                                            },
                                            {
                                                "example_id": "22789e35-9dd7-4d34-9977-212b6c8b8a54",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Wie ‚Frau‘, so steht auch das Wort ‚Mädel‘ häufig euphemistisch für ›Prostituierte‹.“"
                                            },
                                            {
                                                "example_id": "d5f779c0-e3fa-466d-b785-2345482c2f86",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Euphemistische Funktionen (verhüllen, aufbessern, verdecken) haben viele Wörter, die negative soziale Erscheinungen benennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b710bed-a77e-4774-a58f-ae130ae7dcee",
                        "source_entry_id": "d6e72b10-530e-3c97-a96f-db35ef2bb144",
                        "source_sense_id": "4f74925e-985e-3857-ac9d-4dd6edef8e4c",
                        "target_lang_word": "euphemistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphemistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c58c640-71ae-30aa-9c92-b29d1ea7c7ca",
                                        "entry_id": "fe31a3f2-9f9b-3a60-9181-f8ca769d946c",
                                        "glosses": [
                                            "Of or pertaining to euphemism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c37c17-dd08-41c0-9403-c01834a4ad5c",
                                                "sense_id": "0c58c640-71ae-30aa-9c92-b29d1ea7c7ca",
                                                "text": "Taking these cues, I rewrote and rewrote the proposal couching my problem in the bland, euphemistic language that I was rapidly learning is the lingua franca of the corporate world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
