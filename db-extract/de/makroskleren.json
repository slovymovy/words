                "senses": [
                    {
                        "sense_id": "271bc8eb-081a-31e9-8ab0-cc85ef9e421d",
                        "entry_id": "af1b198f-a490-3fe3-8f37-fd97ab7b6f75",
                        "glosses": [
                            "lange Nadel aus Kieselsäure, die als Stützelement des Körpers von Schwämmen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4ee4ad-35b9-41fb-8e26-4cb52f652c48",
                                "sense_id": "271bc8eb-081a-31e9-8ab0-cc85ef9e421d",
                                "text": "„Die Makrosklere des Parenchyms sind Diaktine, 10 — 15 mm lang, auch Monaktine, 5 mm lang.“"
                            },
                            {
                                "example_id": "ab1ee074-0470-48b5-9cce-dd75183806c6",
                                "sense_id": "271bc8eb-081a-31e9-8ab0-cc85ef9e421d",
                                "text": "„Die das feste Gerüst des Schwammes bildenden Makrosklere (Fig. 1) sind leicht gebogene, derbe Amphioxe, deren Enden mehr oder weniger schnell zugespitzt sind.“"
                            },
                            {
                                "example_id": "4f1ab07a-892e-403a-a94b-65ff2b61b95b",
                                "sense_id": "271bc8eb-081a-31e9-8ab0-cc85ef9e421d",
                                "text": "„Evans (1899), der die Metamorphose der Larve von Spongilla lacustris untersuchte, beobachtete an Stücken aus England neben der Bildung von Makroskleren im Larvenkörper auch die Bildung von Mikroskleren, von Fleischnadeln.“"
                            },
                            {
                                "example_id": "f6b25b88-aafc-4f05-9276-bce3b7185451",
                                "sense_id": "271bc8eb-081a-31e9-8ab0-cc85ef9e421d",
                                "text": "„Dazu gehören z. B. die Mikroskleren von Schwämmen (Makroskleren sind ganz selten) und die Serpeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
