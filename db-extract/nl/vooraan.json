                                                "example_id": "56ee18ed-65e6-4038-81e0-0d55a2a9daf0",
                                                "sense_id": "ebdc93d3-0dd8-3354-8027-1f5c40699786",
                                                "text": "Hughes is in front of Smith, but behind Jackson."
