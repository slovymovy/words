                        "glosses": [
                            "Fachmann auf dem Gebiet der Sportwissenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b7d8d3-4f86-4743-86cb-6054e9144fe7",
                                "sense_id": "85d2ffdd-5522-35e0-96eb-0bb95aa5ac52",
                                "text": "„DLRG und Sportwissenschaftler sind sich einig, dass Kinder nur als sichere Schwimmer gelten können, wenn sie das erste Jugendschwimmabzeichen erworben haben.“"
                            },
                            {
                                "example_id": "8d61a8e3-d29a-436e-9913-f927593cb22f",
                                "sense_id": "85d2ffdd-5522-35e0-96eb-0bb95aa5ac52",
                                "text": "„Der Sportwissenschaftler Dr. Klaus Zimmermann von der Technischen Universität Chemnitz weist darauf hin, daß beim Menschen Muskelmasse, Muskelkraft und Muskelkraftausdauer im Laufe des Lebens um etwa 30 bis 40 Prozent abnehmen.“"
                            }
                        ],
