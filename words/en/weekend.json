{
    "word_family": [
        "weekender"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea0d5034-20b9-307c-9ed7-68d09244954c",
                    "sense_definition": "The period of time between the end of one work week and the beginning of the next, typically Saturday and Sunday.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually spend my <w>weekend</w> relaxing at home with a good book.",
                            "target_lang_translations": {
                                "ru": "Обычно я провожу свои <w>выходные</w>, отдыхая дома с хорошей книгой."
                            }
                        },
                        {
                            "text": "We are planning a long <w>weekend</w> trip to the mountains next month.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце мы планируем поездку в горы на длинные <w>выходные</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "weekday",
                        "workweek"
                    ],
                    "common_phrases": [
                        "long weekend",
                        "holiday weekend",
                        "this weekend",
                        "every weekend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени между окончанием одной рабочей недели и началом следующей, обычно суббота и воскресенье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходные",
                                "target_lang_sense_clarification": "дни отдыха"
                            },
                            {
                                "target_lang_word": "уик-энд",
                                "target_lang_sense_clarification": "заимствованное название выходных"
                            },
                            {
                                "target_lang_word": "конец недели",
                                "target_lang_sense_clarification": "время завершения рабочей недели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83668111-260f-37c0-9f79-162974155ff3",
                    "sense_definition": "Taking place or occurring during the weekend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers a special <w>weekend</w> break package for couples.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает специальный пакет для пар на <w>выходные</w>."
                            }
                        },
                        {
                            "text": "She works a <w>weekend</w> job at the local bakery to earn extra money.",
                            "target_lang_translations": {
                                "ru": "Она подрабатывает по <w>выходным</w> в местной пекарне, чтобы подзаработать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weekend break",
                        "weekend job",
                        "weekend warrior",
                        "weekend trip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или имеющий место во время выходных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходного дня",
                                "target_lang_sense_clarification": "относящийся к выходным"
                            },
                            {
                                "target_lang_word": "субботний и воскресный",
                                "target_lang_sense_clarification": "происходящий в эти дни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a952e30-9e78-3e49-800a-14b319a77488",
                    "sense_definition": "Relating to or intended for use during the weekend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am wearing my <w>weekend</w> shoes because they are much more comfortable than my work boots.",
                            "target_lang_translations": {
                                "ru": "Я надел свою обувь <w>для выходных</w>, потому что она гораздо удобнее моих рабочих ботинок."
                            }
                        },
                        {
                            "text": "He packed his <w>weekend</w> bag with enough clothes for two days.",
                            "target_lang_translations": {
                                "ru": "Он сложил в свою дорожную сумку <w>для выходных</w> достаточно одежды на два дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weekend bag",
                        "weekend clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с выходными или предназначенный для использования в это время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для выходных",
                                "target_lang_sense_clarification": "предназначенный для отдыха"
                            },
                            {
                                "target_lang_word": "повседневный",
                                "target_lang_sense_clarification": "неофициальный, для свободного времени"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77042ec1-2e09-3e19-aabd-dab9e7c90f83",
                    "sense_definition": "To spend or pass the weekend in a particular place.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>weekend</w> at the beach to escape the city heat.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>провести выходные на пляже</w>, чтобы спастись от городской жары."
                            }
                        },
                        {
                            "text": "We often <w>weekend</w> in the countryside with our grandparents.",
                            "target_lang_translations": {
                                "ru": "Мы часто <w>проводим выходные</w> в деревне с нашими бабушкой и дедушкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weekend at the beach",
                        "weekend in the country"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить выходные в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить выходные",
                                "target_lang_sense_clarification": "отдыхать в конце недели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}