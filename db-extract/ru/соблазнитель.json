                                "target_senses": [
                                    {
                                        "sense_id": "c7a95267-f1e1-3407-bcc6-50335cc96a2f",
                                        "entry_id": "f3361b87-719d-3faf-a1bc-5ccdc66b08fb",
                                        "glosses": [
                                            "Someone or something that tempts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f436bc5-72d6-3504-b7b6-8745b3740a05",
                                        "entry_id": "f3361b87-719d-3faf-a1bc-5ccdc66b08fb",
                                        "glosses": [
                                            "A seducer, especially a man who seduces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8684fd7-71fc-4123-8a77-8c66f39b9cc5",
                                                "sense_id": "7f436bc5-72d6-3504-b7b6-8745b3740a05",
                                                "text": "He is a tempter of married women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7318c8fa-b0a7-4c24-af4d-5896803b8fc9",
                        "source_entry_id": "6e77c96f-7d37-3af9-b526-83c0cbc13317",
                        "source_sense_id": "c12e5a87-caa3-37f1-9827-1c7c9ac19378",
                        "target_lang_word": "tentateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                        "entry_id": "2f3de1f0-2b49-3213-9590-3c5f3304cb1f",
                                        "glosses": [
                                            "Qui soumet à la tentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032e6e87-0364-4d28-9930-1fa52890ba5a",
                                                "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                                "text": "L'Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour \"monachiser\" ses clercs séculiers et les détacher de la femme tentatrice."
                                            },
                                            {
                                                "example_id": "84068186-79df-4078-8527-a29f985bafe7",
                                                "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                                "text": "Je produis quelques talbins tentateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f435c4f-eb9c-3fba-99d8-5dfc7c89e2b0",
                                        "entry_id": "506ea0ca-8e85-349d-892c-442bdc7aa114",
                                        "glosses": [
                                            "Celui qui tente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ef8517-b746-408a-82b0-97c022ec80b9",
                                                "sense_id": "6f435c4f-eb9c-3fba-99d8-5dfc7c89e2b0",
                                                "text": "Contre toute attente, cette proposition n'est pas du goût du shah qui préfère s'en aller cette fois encore, après avoir cependant offert un plateau de fruits aux tentatrices. Autre pays, autres mœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9651330-c15e-3af2-bf60-948709958e33",
