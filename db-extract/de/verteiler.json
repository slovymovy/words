                ],
                "senses": [
                    {
                        "sense_id": "18ff6ca4-e736-3be1-8ba9-46ded2a916a9",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Person, die etwas verteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711c94fb-fd07-4a74-b7cf-5eae47b9d9f9",
                                "sense_id": "18ff6ca4-e736-3be1-8ba9-46ded2a916a9",
                                "text": "„Die Polizei nahm mehrere Verteiler von Flugblättern fest.“"
                            },
                            {
                                "example_id": "3c6352af-3a26-45dc-8f29-a04ba20ce5fa",
                                "sense_id": "18ff6ca4-e736-3be1-8ba9-46ded2a916a9",
                                "text": "„Dies ruft dann wiederum die New Yorker Polizei auf den Plan, die den Mob auflöst und auch die Verteiler vom Austrittscenter vertreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dd922d7-d2ca-3085-91b1-56998b525c09",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Person, die als Einzelhändler Waren vertreibt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "0db5f80a-3177-33d2-99be-c8584db3ce2a",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Vermerk der Empfänger auf einem Schriftstück, das mehrfach ausgefertigt wird und von dem die aufgeführten Empfänger eine Kopie erhalten"
                        ],
                        "tags": [
                            "Bürowesen"
                        ],
                        "examples": [
                            {
                                "example_id": "a316f226-8321-4efd-8809-7ed7ad7d0d2d",
                                "sense_id": "0db5f80a-3177-33d2-99be-c8584db3ce2a",
                                "text": "Auf dem Verteiler der Firmenpost vermisste ich den Namen des Projektleiters."
                            }
                        ],
                        "sense_index_json": "\"2b\""
                    },
                    {
                        "sense_id": "b088a0c2-4ba0-3966-8282-554c38d74186",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Elektrizität oder Gas an die Verbraucher leitender Betrieb"
                        ],
                        "tags": [
                            "Energiewirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7dc17848-d2f2-4a02-ad91-6949df6ef10b",
                                "sense_id": "b088a0c2-4ba0-3966-8282-554c38d74186",
                                "text": "Als umweltbewusster Konsument hat er seinen Stromverteiler auf einen Stromhersteller gewechselt, der sogenannten Grünen Strom verkauft."
                            }
                        ],
                        "sense_index_json": "\"2c\""
                    },
                    {
                        "sense_id": "92386015-e7f6-39d3-80ee-312101a8a32b",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Person, die für eine Anzahl von Kunden Sammelbestellungen macht"
                        ],
                        "tags": [
                            "Versandhandel"
                        ],
                        "examples": [
                            {
                                "example_id": "e36c2650-b6fb-43e8-8e97-764d94ce4486",
                                "sense_id": "92386015-e7f6-39d3-80ee-312101a8a32b",
                                "text": "Ich habe vom Verteiler die Nachricht bekommen, dass meine Bestellung schon unterwegs ist."
                            }
                        ],
                        "sense_index_json": "\"2d\""
                    },
                    {
                        "sense_id": "2495ef11-4e31-3174-9e0c-2d1d19d116a5",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Zündverteiler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc3ab8d-d5eb-484a-be21-6109d36d8933",
                                "sense_id": "2495ef11-4e31-3174-9e0c-2d1d19d116a5",
                                "text": "Da in seinem E-Mail-Client \"Erhalt bestätigen\" und \"Öffnen bestätigen\" immer angekreuzt ist erzeugte er unwissentlich durch die Option \"Allen antworten\" ein Problem, als er dem Firmenverteiler antwortete, was zur Folge hatte, dass alle 3500 Mitarbeiter seine Antwort und er die automatischen Bestätigungen - 7000 in Summe! - bekam sowie der E-Mail-Server stundenlang blockiert war."
                            }
                        ],
                        "sense_index_json": "\"3a\""
                    },
                    {
                        "sense_id": "45db2a21-39ee-3197-b8d4-974a637258e7",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "Verteilerdose, -kasten, -tafel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3b\""
                    },
                    {
                        "sense_id": "8b6888d3-665c-303c-825c-dd3ab094401e",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "E-Mail-Verteiler"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "3b2cfa3f-2172-4205-9e4e-7ee62c26a0d9",
                                "sense_id": "8b6888d3-665c-303c-825c-dd3ab094401e",
                                "text": "„Damals schickte eine Systemadministratorin versehentlich eine E-Mail an einen Verteiler mit 65.000 Empfängern.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "5aa57caf-f5f3-3ed1-9420-20b9c8cbc88e",
                        "entry_id": "920001d7-017c-3f89-b05e-cf0459047af3",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "7eca5bb2-ed28-4906-b017-5fca70a97545",
                                "sense_id": "5aa57caf-f5f3-3ed1-9420-20b9c8cbc88e",
                                "text": "Der Verteiler kann bis zu 16 Stellen versorgen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
