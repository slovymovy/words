                            {
                                "example_id": "b05f5419-bd2b-4690-80eb-3d1fce62a4e0",
                                "sense_id": "8c5d7551-8606-3fb2-a366-e98f33ab2310",
                                "text": "Der Vollpfosten hat sich total besoffen in die Sonne zum Schlafen gelegt und nun ist er krebsrot!"
                            },
                            {
                                "example_id": "926d7bd0-8c2c-48f8-96a9-8172bd112728",
                                "sense_id": "8c5d7551-8606-3fb2-a366-e98f33ab2310",
                                "text": "Du bist voll dumm wie ein blöder Pfosten; Du Vollpfosten!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
