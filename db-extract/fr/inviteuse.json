                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0f5ecb-67d6-4a88-b176-cb8393d9c9c0",
                                "sense_id": "fe83b3dd-f2a2-32cd-ae7c-377986819ad6",
                                "text": "Parfois une inviteuse pousse la grille du jardin."
                            },
                            {
                                "example_id": "c7a227bd-0123-4750-93f4-9ae1a39688b6",
                                "sense_id": "fe83b3dd-f2a2-32cd-ae7c-377986819ad6",
                                "text": "Je dis non aux inviteuses ! Ce bal m’horripile. Jeunes filles rouées, lascives... Je vois en vous les servantes de la mort. Car je vous vois et mon cœur s’arrête de battre. Je vous devine expertes jusqu’au bout des jambes et des ongles. Douées, trop douées !"
                            }
                        ]
                    }
