                                        "sense_id": "5d26d1aa-342d-3a1f-9077-455e9752b62c",
                                        "entry_id": "3e87b4b9-b7f1-3185-b786-8da2c445df3a",
                                        "glosses": [
                                            "Rabot dont le fer est aussi large que le rabot et que l’on utilise pour réaliser des feuillures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba59bbb4-ea17-4abc-b6f6-6de0f8bb473d",
                                                "sense_id": "5d26d1aa-342d-3a1f-9077-455e9752b62c",
                                                "text": "Le guillaume debout, c’est celui dont le fer n’est point incliné & n’a point de pente ; on s’en sert lorsque les bois sont trop rustiques, & que les autres ne peuvent les couper net."
                                            },
                                            {
                                                "example_id": "d7ac4ed3-1e25-4810-ac4b-f3c0fb6e1dd3",
                                                "sense_id": "5d26d1aa-342d-3a1f-9077-455e9752b62c",
                                                "text": "D’une façon générale les guillaumes, feuillerets, etc., se présentent non pas comme les rabots, en masse compacte où le fer est inséré à plein bois, mais comme des triangles relativement étroits […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946827b6-f7c3-3240-8801-6fb8d19b6908",
                                        "entry_id": "3e87b4b9-b7f1-3185-b786-8da2c445df3a",
                                        "glosses": [
                                            "Sorte de tamis autrefois utilisé lors de la confection des poudres à canon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c697e847-f837-4771-9c5a-b11935a48d07",
                                                "sense_id": "946827b6-f7c3-3240-8801-6fb8d19b6908",
                                                "text": "Le guillaume porte des trous de 5 à 10 millimètres de diamètre. Le grenoir de la poudre à canon a des trous de 4 millimètres de diamètre ; enfin, le grenoir de la poudre à mousquet a des ouvertures qui n'ont que 2 millimètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
