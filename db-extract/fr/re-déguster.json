                        "glosses": [
                            "Autre écriture, parfois rencontrée, de redéguster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cddfca6-2aed-4cc6-a4b4-04c9b6d93695",
                                "sense_id": "8435caad-8c45-3876-9975-ab210a7102e1",
                                "text": "Il est souhaitable que ce carrefour soit bien celui de « l'au revoir», ce qui apportera la preuve d'une tentation à revoir ce vin-là ou d'un désir de le re-déguster ou de l'acheter et non celui des « adieux » qui imposerait un refus définitif de la part du dégustateur."
                            },
                            {
                                "example_id": "d49ce5b3-d0fe-4696-8870-33e50068e49b",
                                "sense_id": "8435caad-8c45-3876-9975-ab210a7102e1",
                                "text": "On intronise également les compagnons du Dzi et juste après, on re-déguste, re-commente et re-découvre ce nectar si délicieux."
                            }
                        ]
                    }
