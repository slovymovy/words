                        "glosses": [
                            "eng anliegendes, ärmelloses Oberteil für Frauen, das unter der Kleidung getragen wird, nicht ganz bis zur Taille reicht und einem Mieder ähnelt"
                        ],
                        "tags": [],
                        "examples": [
