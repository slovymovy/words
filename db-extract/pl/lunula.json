                                        "glosses": [
                                            "halbmondförmiger Schmuckgegenstand aus spätneolithischer bis frühbronzezeitlicher Zeit"
                                        ],
                                        "tags": [
                                            "Archäologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b47d7643-a5a1-454f-8c62-db1e58673b6e",
                                                "sense_id": "f912143f-8ca8-30f1-b271-6396e67c6bc7",
                                                "text": "Irland gilt als Ursprungsort der goldenen Lunulae, die heute in Europa gefunden werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e94c9bd3-2157-36bd-aba6-61c5b52b353d",
