                    {
                        "sense_id": "7fbc8079-45f2-330a-a3c9-f05ea0bebb08",
                        "entry_id": "58199a6b-97b4-398b-a2bb-7029f831a2fa",
                        "glosses": [
                            "mensen die samen in de avonduren werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c074569f-dfa1-419f-8145-071dc1ae1802",
                                "sense_id": "7fbc8079-45f2-330a-a3c9-f05ea0bebb08",
                                "text": "Een van de maatregelen is dat er in de stembureaus een verplichte looproute naar de stemhokjes en de stembus komt. Daarnaast wordt er voor de leden van de stembureus een dag- en een avondploeg ingesteld om te voorkomen dat er door vermoeidheid verkeerd wordt geteld."
                            },
                            {
                                "example_id": "2fc7f3ff-0574-47cf-94af-95c8004c943b",
                                "sense_id": "7fbc8079-45f2-330a-a3c9-f05ea0bebb08",
                                "text": "Bierbrouwer Grolsch en vakbond FNV Bondgenoten hebben na twee dagen onderhandelen een akkoord bereikt over een nieuwe cao. De medewerkers hebben hun staking per direct beëindigd. De avondploeg is weer aan het werk gegaan."
                            }
                        ]
                    }
