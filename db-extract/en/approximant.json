                    {
                        "translation_id": "73a9a408-a22b-40bb-a3cc-a10afd905aa9",
                        "source_entry_id": "a52b3d4e-a88b-3139-b493-6f656dee28ca",
                        "source_sense_description": "consonant made by slightly narrowing the vocal tract",
                        "target_lang_word": "Approximant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Approximant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "495fadd7-ddc1-3bd8-ac0a-ac9a7c55b2b0",
                                        "entry_id": "a1517720-8c12-34f6-8083-025a63dce40c",
                                        "glosses": [
                                            "Laut, bei dem im Artikulationskanal so wie bei den Reibelauten eine Verengung gebildet wird, die aber weniger eng ist und daher kein Reibegeräusch verursacht"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f8b46a2-f654-49d6-bda9-06a7b4e233b7",
                                                "sense_id": "495fadd7-ddc1-3bd8-ac0a-ac9a7c55b2b0",
                                                "text": "„Bei den Approximanten wird, ähnlich wie bei den Frikativen, eine Enge im Ansatzrohr gebildet. Im Gegensatz zu den Frikativen nähert sich jedoch der Artikulator bei den Approximanten nicht weit genug der Artikulationsstelle an, um ein Reibegeräusch zu erzielen.“"
                                            },
                                            {
                                                "example_id": "3f10d129-0de0-4a32-87eb-6292de09c3a9",
                                                "sense_id": "495fadd7-ddc1-3bd8-ac0a-ac9a7c55b2b0",
                                                "text": "„Die UPSID-Untersuchung unterscheidet zwischen ‚liquiden‘ Lauten (/l/ und /r/) und „Öffnungslauten“ (auch Approximanten oder Halbvokale: /j/ und /w/)…“"
                                            },
                                            {
                                                "example_id": "f7dc5dea-9655-4811-8480-fc992605cf23",
                                                "sense_id": "495fadd7-ddc1-3bd8-ac0a-ac9a7c55b2b0",
                                                "text": "„Der englische labialisierte velare Approximant [w] gehört ebenfalls hierher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
