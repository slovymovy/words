                "senses": [
                    {
                        "sense_id": "9c8ec711-eb0b-3b49-af24-19f622967554",
                        "entry_id": "3ae5ec02-f8e0-3d2b-8dee-2438e790ec02",
                        "glosses": [
                            "wapen waarvan nucleaire reacties de energiebron zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde9576b-c0e5-4253-bf8e-b8ae25676d79",
                                "sense_id": "9c8ec711-eb0b-3b49-af24-19f622967554",
                                "text": "De door minister Hennis-Plasschaert voorgestelde wetswijziging om de militaire dienstplicht ook verplicht te stellen voor vrouwen is een logische. En gelukkig, zo zie je iedereen denken, is dit een theoretische kwestie. We speculeren niet graag over een eventuele oorlog, dus een debat over de dienstplicht blijft hopelijk even abstract als over een Nederlands atoomwapen."
                            },
                            {
                                "example_id": "34ac6221-c7de-47d4-b469-7f8efae53cb6",
                                "sense_id": "9c8ec711-eb0b-3b49-af24-19f622967554",
                                "text": "De atoomaanvallen op Japan kostten naar schatting 300.000 mensen het leven. Het was voor het eerst (en tot dusver voor het laatst) dat het atoomwapen daadwerkelijk werd ingezet."
                            }
                        ]
                    }
