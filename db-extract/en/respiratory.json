                "senses": [
                    {
                        "sense_id": "041e46af-1eb7-3112-afa0-2ec6bfdabe27",
                        "entry_id": "1485def9-940d-3ff8-ae33-0a6755da0f95",
                        "glosses": [
                            "Relating to respiration or the organs of respiration; breathing."
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "387e27dd-293e-4b6a-a385-0353f54e1941",
                                "sense_id": "041e46af-1eb7-3112-afa0-2ec6bfdabe27",
                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola. A recent study explored the ecological variables that may contribute to bats’ propensity to harbor such zoonotic diseases by comparing them with another order of common reservoir hosts: rodents."
                            },
                            {
                                "example_id": "98ff7574-4a66-4d3e-9536-5f2badffbc2e",
                                "sense_id": "041e46af-1eb7-3112-afa0-2ec6bfdabe27",
                                "text": "The vaccine would be the first to protect babies from respiratory syncytial virus, or R.S.V., which is the reason many infants are admitted to children’s hospitals each year and kills several hundred under 5 each year."
                            }
                        ]
                    }
                ],
