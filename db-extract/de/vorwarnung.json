                    {
                        "sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                        "entry_id": "9ebc601c-0d59-3838-8cfe-10da084570c6",
                        "glosses": [
                            "rechtzeitige Mitteilung oder Anzeige einer drohenden Gefahr, Hinweis auf eine solche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc647ae-37ed-4c4a-af9a-19a93c5d7665",
                                "sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                                "text": "„Die meisten Amok-Ereignisse treten nach Erkenntnissen der Weltgesundheitsorganisation WHO ohne Vorwarnung auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e793faaa-be92-41f1-9d45-22fa9cd8ef54",
                        "source_entry_id": "9ebc601c-0d59-3838-8cfe-10da084570c6",
                        "source_sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                        "source_sense_description": "rechtzeitige Mitteilung oder Anzeige einer drohenden Gefahr, Hinweis auf eine solche",
                        "target_lang_word": "warning",
