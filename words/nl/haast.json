    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e931f42c-ea8f-3137-82f0-a7e4bc2de4ac",
                    "sense_definition": "de drang of noodzaak om iets snel te doen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een beetje <w>haast</w> omdat mijn trein over vijf minuten vertrekt.",
                            "target_lang_translations": {
                                "en": "I am in a bit of a <w>hurry</w> because my train leaves in five minutes.",
                                "ru": "Я немного <w>тороплюсь</w>, потому что мой поезд отправляется через пять минут."
                            }
                        },
                        {
                            "text": "Waarom heb je zo'n <w>haast</w> om naar huis te gaan?",
                            "target_lang_translations": {
                                "en": "Why are you in such a <w>rush</w> to go home?",
                                "ru": "Почему ты так <w>спешишь</w> домой?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "haast hebben",
                        "geen haast",
                        "grote haast"
                    ],
                    "target_lang_definitions": {
                        "en": "the urge or necessity to do something quickly",
                        "ru": "стремление или необходимость сделать что-то быстро"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "the state of needing to move or act quickly"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "a sudden or urgent need for speed"
                            },
                            {
                                "target_lang_word": "haste",
                                "target_lang_sense_clarification": "speed or urgency of action"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спешка",
                                "target_lang_sense_clarification": "состояние, когда нужно действовать быстро"
                            },
                            {
                                "target_lang_word": "торопливость",
                                "target_lang_sense_clarification": "склонность делать всё быстро, часто излишне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb69be2-8436-3eab-8c5f-94dc9b8f8c2a",
                    "sense_definition": "een toestand van spoed of overhaasting",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In alle <w>haast</w> was hij vergeten zijn sleutels van de tafel te pakken.",
                            "target_lang_translations": {
                                "en": "In all the <w>haste</w>, he had forgotten to grab his keys from the table.",
                                "ru": "В <w>спешке</w> он забыл взять ключи со стола."
                            }
                        },
                        {
                            "text": "Met grote <w>haast</w> probeerde de dokter de patiënt te bereiken.",
                            "target_lang_translations": {
                                "en": "With great <w>haste</w>, the doctor tried to reach the patient.",
                                "ru": "С большой <w>поспешностью</w> врач пытался добраться до пациента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in alle haast",
                        "met grote haast"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of speed or over-hurrying",
                        "ru": "состояние поспешности или чрезмерной торопливости"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haste",
                                "target_lang_sense_clarification": "rapidity of motion or action"
                            },
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "rushed action or urgency"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "general haste or surge of activity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спешка",
                                "target_lang_sense_clarification": "быстрое движение или действие"
                            },
                            {
                                "target_lang_word": "поспешность",
                                "target_lang_sense_clarification": "быстрота в действиях, иногда суетливость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c97605c9-ebbe-3750-8667-df4288620c2d",
                    "sense_definition": "bijna of nagenoeg",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "benadering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wist <w>haast</w> geen woord uit te brengen door de zenuwen.",
                            "target_lang_translations": {
                                "en": "He could <w>almost</w> not get a word out because of the nerves.",
                                "ru": "От волнения он <w>почти</w> не мог вымолвить ни слова."
                            }
                        },
                        {
                            "text": "Het is <w>haast</w> onmogelijk om dit werk in één dag af te krijgen.",
                            "target_lang_translations": {
                                "en": "It is <w>nearly</w> impossible to finish this work in one day.",
                                "ru": "Эту работу <w>практически</w> невозможно закончить за один день."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijna",
                        "bijkans",
                        "nagenoeg"
                    ],
                    "common_phrases": [
                        "haast onmogelijk",
                        "haast nooit"
                    ],
                    "target_lang_definitions": {
                        "en": "almost or nearly",
                        "ru": "почти или практически"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "very close to, but not quite"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "in close approximation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "почти",
                                "target_lang_sense_clarification": "очень близко к какому-либо состоянию, но не совсем"
                            },
                            {
                                "target_lang_word": "практически",
                                "target_lang_sense_clarification": "почти полностью, на деле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92787704-f228-3f24-b453-fc2294319816",
