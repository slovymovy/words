                        "entry_id": "b24fb37b-a904-3bef-b6ca-048040495c8d",
                        "glosses": [
                            "Homme de loi mandataire ; procureur ou avoué au Royaume-Uni, sorte d’avocat aux États-Unis."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
