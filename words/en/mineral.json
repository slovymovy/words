{
    "word_family": [
        "mineralize",
        "mineralization",
        "mineralogy",
        "mineralogist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "205ab0ef-d1cd-3ad3-b985-13ff9bf8d7b2",
                    "sense_definition": "An inorganic element, such as calcium or iron, that is essential for the health of living bodies.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to eat a balanced diet to get enough vitamins and <w>minerals</w>.",
                            "target_lang_translations": {
                                "ru": "Вам нужно сбалансированно питаться, чтобы получать достаточно витаминов и <w>минералов</w>.",
                                "zh": "你需要均衡饮食以摄取足够的维生素和<w>矿物质</w>。"
                            }
                        },
                        {
                            "text": "Spinach is a vegetable rich in iron and other essential <w>minerals</w>.",
                            "target_lang_translations": {
                                "ru": "Шпинат — это овощ, богатый железом и другими необходимыми <w>минералами</w>.",
                                "zh": "菠菜是一种富含铁和其他必要<w>矿物质</w>的蔬菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vitamins and minerals",
                        "essential mineral",
                        "mineral deficiency",
                        "mineral supplement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неорганический элемент, такой как кальций или железо, необходимый для здоровья живых организмов.",
                        "zh": "人体健康所必需的无机元素，如钙或铁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минерал",
                                "target_lang_sense_clarification": "питательное вещество"
                            },
                            {
                                "target_lang_word": "микроэлемент",
                                "target_lang_sense_clarification": "в диетологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿物质",
                                "target_lang_sense_clarification": "营养学"
                            },
                            {
                                "target_lang_word": "微量元素",
                                "target_lang_sense_clarification": "营养学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1c20031-e5d4-385d-85a6-18b7cb725f37",
                    "sense_definition": "A naturally occurring solid substance with a definite chemical composition and structure, such as quartz or diamond.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists identify the rock by examining the <w>minerals</w> it contains.",
                            "target_lang_translations": {
                                "ru": "Геологи определяют породу, изучая содержащиеся в ней <w>минералы</w>.",
                                "zh": "地质学家通过检查岩石中包含的<w>矿物</w>来鉴定它。"
                            }
                        },
                        {
                            "text": "Diamond is the hardest known natural <w>mineral</w>.",
                            "target_lang_translations": {
                                "ru": "Алмаз — самый твердый из известных природных <w>минералов</w>.",
                                "zh": "钻石是已知最坚硬的天然<w>矿物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mineral deposit",
                        "clay mineral",
                        "mineral resources",
                        "rock-forming mineral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природное твердое вещество с определенным химическим составом и структурой, например кварц или алмаз.",
                        "zh": "自然界中存在的具有确定化学成分和结构的固体物质，如石英或钻石。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минерал",
                                "target_lang_sense_clarification": "геология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿物",
                                "target_lang_sense_clarification": "地质学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2823aae-3ed7-3d26-9836-3773be9687a1",
                    "sense_definition": "Water containing dissolved salts, often sparkling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a glass of sparkling <w>mineral</w>, please.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел стакан газированной <w>минералки</w>, пожалуйста.",
                                "zh": "请给我一杯气泡<w>矿泉水</w>。"
                            }
                        },
                        {
                            "text": "They bottled the <w>mineral</w> directly from the spring.",
                            "target_lang_translations": {
                                "ru": "Они разливали <w>минеральную воду</w> по бутылкам прямо из источника.",
                                "zh": "他们直接从泉水处装瓶<w>矿泉水</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sparkling mineral",
                        "bottle of mineral"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for mineral water"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вода, содержащая растворенные соли, часто газированная.",
                        "zh": "含有溶解盐类的水，通常是碳酸水。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минералка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "минеральная вода",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿泉水",
                                "target_lang_sense_clarification": "饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e02825-4289-3127-a2ff-49eb28b1c3d2",
                    "sense_definition": "Any inorganic material, as distinguished from animal or plant matter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game requires you to guess if the object is animal, vegetable, or <w>mineral</w>.",
                            "target_lang_translations": {
                                "ru": "В этой игре нужно угадать, является ли предмет животным, растением или <w>минералом</w>.",
                                "zh": "这个游戏要求你猜这个物体是动物、植物还是<w>矿物</w>。"
                            }
                        },
                        {
                            "text": "Coal is often classified as a <w>mineral</w> fuel.",
                            "target_lang_translations": {
                                "ru": "Уголь часто классифицируют как <w>минеральное</w> топливо.",
                                "zh": "煤炭通常被归类为<w>矿物</w>燃料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "animal vegetable or mineral",
                        "mineral kingdom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой неорганический материал, в отличие от животного или растительного.",
                        "zh": "任何无机材料，区别于动物或植物物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минерал",
                                "target_lang_sense_clarification": "категория вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿物",
                                "target_lang_sense_clarification": "物质分类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3541002-131c-310d-a7bc-6ab9cdcf7c15",
                    "sense_definition": "A carbonated soft drink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children asked for a bottle of red <w>mineral</w> at the shop.",
                            "target_lang_translations": {
                                "ru": "Дети попросили в магазине бутылку красной <w>газировки</w>.",
                                "zh": "孩子们在商店里要了一瓶红色的<w>汽水</w>。"
                            }
                        },
                        {
                            "text": "We bought some crisps and a <w>mineral</w> for the picnic.",
                            "target_lang_translations": {
                                "ru": "Мы купили чипсы и <w>газировку</w> для пикника.",
                                "zh": "我们为野餐买了一些薯片和<w>汽水</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bottle of mineral",
                        "can of mineral"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Газированный безалкогольный напиток.",
                        "zh": "一种碳酸软饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газировка",
                                "target_lang_sense_clarification": "напиток"
                            },
                            {
                                "target_lang_word": "прохладительный напиток",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "汽水",
                                "target_lang_sense_clarification": "饮料"
                            },
                            {
                                "target_lang_word": "碳酸饮料",
                                "target_lang_sense_clarification": "饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf60b790-84b4-3f40-95c3-004cf96d1b4a",
                    "sense_definition": "A mine or a deposit of ore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers toiled deep within the dark <w>mineral</w>.",
                            "target_lang_translations": {
                                "ru": "Рабочие трудились глубоко в темном <w>руднике</w>.",
                                "zh": "工人们在黑暗的<w>矿区</w>深处辛勤劳作。"
                            }
                        },
                        {
                            "text": "They discovered a rich <w>mineral</w> of copper in the hills.",
                            "target_lang_translations": {
                                "ru": "Они обнаружили богатое <w>месторождение</w> меди на холмах.",
                                "zh": "他们在山里发现了一个丰富的铜<w>矿床</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шахта или месторождение руды.",
                        "zh": "矿山或矿石沉积物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рудник",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "месторождение",
                                "target_lang_sense_clarification": "залежи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿床",
                                "target_lang_sense_clarification": "地质"
                            },
                            {
                                "target_lang_word": "矿区",
                                "target_lang_sense_clarification": "采矿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c1ff265-df47-3d93-81e7-44696ed18db9",
                    "sense_definition": "A poisonous or dangerous substance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alchemist warned that the vial contained a deadly <w>mineral</w>.",
                            "target_lang_translations": {
                                "ru": "Алхимик предупредил, что во флаконе содержится смертельный <w>минерал</w>.",
                                "zh": "炼金术士警告说，小瓶里装的是一种致命的<w>毒物</w>。"
                            }
                        },
                        {
                            "text": "She had been harmed by the consumption of strange <w>minerals</w>.",
                            "target_lang_translations": {
                                "ru": "Она пострадала от употребления странных <w>минералов</w>.",
                                "zh": "她因摄入奇怪的<w>毒物</w>而受到了伤害。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ядовитое или опасное вещество.",
                        "zh": "一种有毒或危险的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яд",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "отрава",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒物",
                                "target_lang_sense_clarification": "古语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53ed7f36-6d25-3b5b-8f79-95d0689e67bf",
                    "sense_definition": "Relating to, consisting of, or containing minerals.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country's economy depends heavily on its <w>mineral</w> wealth.",
                            "target_lang_translations": {
                                "ru": "Экономика страны сильно зависит от её <w>минеральных</w> богатств.",
                                "zh": "这个国家的经济在很大程度上依赖于其<w>矿物</w>财富。"
                            }
                        },
                        {
                            "text": "We use <w>mineral</w> oil to protect the wooden cutting board.",
                            "target_lang_translations": {
                                "ru": "Мы используем <w>минеральное</w> масло для защиты деревянной разделочной доски.",
                                "zh": "我们使用<w>矿物</w>油来保护木制砧板。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mineral water",
                        "mineral oil",
                        "mineral wealth",
                        "mineral wool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к минералам, состоящий из них или содержащий их.",
                        "zh": "与矿物有关的、由矿物组成的或含有矿物的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минеральный",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矿物的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "36344d4d-49b6-3988-9600-3333a734ba28",
                    "sense_definition": "A census-designated place in Tehama County, California.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Mineral</w> is located near Lassen Volcanic National Park.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Минерал</w> расположено недалеко от национального парка Лассен-Волканик.",
                                "zh": "小社区<w>米纳勒尔</w>位于拉森火山国家公园附近。"
                            }
                        },
                        {
                            "text": "We stopped in <w>Mineral</w> to check the map before continuing our journey.",
                            "target_lang_translations": {
                                "ru": "Мы остановились в <w>Минерале</w>, чтобы свериться с картой перед продолжением пути.",
                                "zh": "我们在<w>米纳勒尔</w>停下来查看地图，然后继续我们的旅程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статистически обособленная местность в округе Техейма, Калифорния.",
                        "zh": "位于美国加利福尼亚州特哈马县的一个普查规定居民点。"
                    },
                    "translations": {
                        "ru": [
                            {
