            "senses": [
                {
                    "sense_id": "e742fd6a-ab37-336a-bbad-0b9ec34a6fff",
                    "sense_definition": "Iets toevoegen of tussenschuiven in een bestaande reeks, programma of planning.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tussenschuiven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De organisatie besloot om een extra pauze <w>in</w> te <w>lassen</w> tijdens de lange vergadering.",
                            "target_lang_translations": {
                                "en": "The organization decided to <w>schedule</w> an extra break during the long meeting."
                            }
                        },
                        {
                            "text": "Er werd onverwacht een korte pauze <w>ingelast</w> om de sprekers wat rust te gunnen.",
                            "target_lang_translations": {
                                "en": "A short break was unexpectedly <w>inserted</w> to give the speakers some rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussenvoegen",
                        "invoegen",
                        "intercaleren"
                    ],
                    "antonyms": [
                        "schrappen",
                        "weglaten"
                    ],
                    "common_phrases": [
                        "een pauze inlassen",
                        "een extra rustdag inlassen"
                    ],
                    "target_lang_definitions": {
                        "en": "To add or insert something into an existing series, program, or schedule."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to schedule",
                                "target_lang_sense_clarification": "an extra break or event"
                            },
                            {
                                "target_lang_word": "to insert",
                                "target_lang_sense_clarification": "a pause or interval"
                            },
                            {
                                "target_lang_word": "to introduce",
                                "target_lang_sense_clarification": "a break or rest day"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15256429-8037-3db0-95cf-233f7ff411b8",
                    "sense_definition": "Fysiek invoegen of ertussen plaatsen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tussenschuiven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De redacteur stelde voor om een extra alinea <w>in</w> te <w>lassen</w> om de tekst te verduidelijken.",
                            "target_lang_translations": {
                                "en": "The editor suggested <w>inserting</w> an extra paragraph to clarify the text."
                            }
                        },
                        {
                            "text": "Je kunt dit hoofdstuk gemakkelijk in het boek <w>inlassen</w>.",
                            "target_lang_translations": {
                                "en": "You can easily <w>insert</w> this chapter into the book."
                            }
                        }
                    ],
                    "synonyms": [
                        "invoegen",
                        "tussenvoegen"
                    ],
                    "antonyms": [
                        "verwijderen"
                    ],
                    "common_phrases": [
                        "een tekstfragment inlassen"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically insert or place something in between."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to insert",
                                "target_lang_sense_clarification": "a paragraph or text fragment"
                            },
                            {
                                "target_lang_word": "to interpolate",
                                "target_lang_sense_clarification": "text or data"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b792df17-4abb-3686-b09f-4783dbe5f4f0",
                    "sense_definition": "Het toevoegen van een elektrische installatie in een netsectie, waarbij de netsectie gesplitst wordt.",
