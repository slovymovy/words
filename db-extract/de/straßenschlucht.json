                "senses": [
                    {
                        "sense_id": "36f3ae83-5343-36f0-a1e6-281a83c586a1",
                        "entry_id": "0b275a05-f0ea-3657-ac61-6c12898615e1",
                        "glosses": [
                            "Straßenverlauf zwischen hohen Häusern/Gebäuden an beiden Seiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb0b6fc-54c9-4e85-b440-b2d579f63aa5",
                                "sense_id": "36f3ae83-5343-36f0-a1e6-281a83c586a1",
                                "text": "„Den Kopf eingezogen, eilte sie durch die Straßenschluchten bis an die Grenzen Barmbeks, wo die Stadt sich fransig lichtete, und stolperte stöhnend und schwitzend weiter.“"
                            },
                            {
                                "example_id": "3c20f6f8-4ce6-48c4-b4e3-3e4d016fb414",
                                "sense_id": "36f3ae83-5343-36f0-a1e6-281a83c586a1",
                                "text": "„In der brütenden sommerlichen Hitze verwandelten sich Straßenschluchten in goldgelbe Steppenlandschaften, über die der Wind Wolken von allergenen Pollen blies und diesen an geschützten Stellen millimeterdick ablagerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
