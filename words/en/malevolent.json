{
    "word_family": [
        "malevolence",
        "malevolently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15026d42-b81a-3a98-84ff-1bf740aec07b",
                    "sense_definition": "Having or showing a desire to harm other people; having ill will.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evil_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain gave a <w>malevolent</w> smile just before revealing his wicked plan to the hero.",
                            "target_lang_translations": {
                                "ru": "Злодей <w>злобно</w> улыбнулся прямо перед тем, как раскрыть герою свой коварный план."
                            }
                        },
                        {
                            "text": "She felt a chill down her spine under the stranger's cold and <w>malevolent</w> stare.",
                            "target_lang_translations": {
                                "ru": "У неё побежали мурашки по коже под холодным и <w>злобным</w> взглядом незнакомца."
                            }
                        }
                    ],
                    "synonyms": [
                        "evil"
                    ],
                    "antonyms": [
                        "benevolent"
                    ],
                    "common_phrases": [
                        "malevolent intent",
                        "malevolent smile",
                        "malevolent stare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий или проявляющий желание причинить вред другим людям; злой или недоброжелательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "исполненный злобы, враждебный"
                            },
                            {
                                "target_lang_word": "злонамеренный",
                                "target_lang_sense_clarification": "имеющий злые намерения, замысливший недоброе"
                            },
                            {
                                "target_lang_word": "недоброжелательный",
                                "target_lang_sense_clarification": "испытывающий неприязнь, желающий зла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a86dfed7-c0f3-3ed9-8093-98df04704aa2",
                    "sense_definition": "Having an evil, destructive, or harmful effect or influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evil_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some local folklore claimed that a <w>malevolent</w> influence haunted the ancient forest.",
                            "target_lang_translations": {
                                "ru": "Местный фольклор утверждал, что в древнем лесу обитает некое <w>зловредное</w> влияние."
                            }
                        },
                        {
                            "text": "The characters struggled to escape the <w>malevolent</w> force controlling the haunted house.",
                            "target_lang_translations": {
                                "ru": "Герои отчаянно пытались спастись от <w>злой</w> силы, управлявшей домом с привидениями."
                            }
                        }
                    ],
                    "synonyms": [
                        "evil"
                    ],
                    "antonyms": [
                        "benevolent"
                    ],
                    "common_phrases": [
                        "malevolent force",
                        "malevolent influence",
                        "malevolent spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывающий злое, разрушительное или вредоносное воздействие или влияние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловредный",
                                "target_lang_sense_clarification": "приносящий вред, пагубный"
                            },
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "несущий зло, враждебный (о силе или влиянии)"
                            },
                            {
                                "target_lang_word": "губительный",
                                "target_lang_sense_clarification": "разрушительный, пагубный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}