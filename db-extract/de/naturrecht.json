                            "singular"
                        ],
                        "form": "dem Naturrechte"
                    },
                    {
                        "form_id": "dfed5e96-ddfe-4786-bcfe-f26f72655b4d",
                        "entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
