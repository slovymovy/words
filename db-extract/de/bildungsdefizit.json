                ],
                "senses": [
                    {
                        "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                        "entry_id": "b3c06ed0-956c-3f46-94b9-9ea13b9ff645",
                        "glosses": [
                            "Fehlen von Kenntnissen und Fertigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0eb274-5258-4874-9820-b96ed8aaebd5",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "Bildungsdefizite müssen ausgeglichen werden, da sonst diesen Kindern Nachteile drohen."
                            },
                            {
                                "example_id": "e259ac5e-f6d0-48ab-b63d-4ce08b00d5fe",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "[Der Generalsekretär der Deutschen Akademie für Kinder- und Jugendmedizin, Hans-Iko Huppertz, in einem Zeitungsinterview:] »Das derzeit [Anmerkung: während der Schulschließungen in der Coronapandemie] entstehende Bildungsdefizit bei Schülern wird dazu führen, dass sie im späteren Leben ihre Möglichkeiten nicht ausschöpfen und dauerhaft ein signifikant niedrigeres Einkommensniveau erreichen werden, als es möglich gewesen wäre.«"
                            },
                            {
                                "example_id": "673af811-d1d5-46f3-829d-add86ee5f64f",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„In Deutschland nimmt die Zahl der Familien zu, in denen Kinder von Armut und Bildungsdefiziten bedroht sind. Das geht aus dem Familienreport 2017 der Bundesregierung hervor […].“"
                            },
                            {
                                "example_id": "771ba9f7-29d0-4d91-9988-57731ee05054",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Mit fehlendem Geld lassen sich die Bildungsdefizite kaum erklären.“"
                            },
                            {
                                "example_id": "fe1daf65-5c78-4333-9a62-325a134afa40",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Immer jünger, immer ungebildeter – so sehen viele deutsche Professoren ihre Studenten. Die Bildungsdefizite der jungen Generation versuchen einige Hochschulen nun mit einem Vorbereitungsjahr aufs Studium auszugleichen.“"
                            },
                            {
                                "example_id": "dac1006b-a471-41c5-b8db-93abd461fe86",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Die Berufswahlschulen im Kanton Zürich sollen nur noch Jugendliche aufnehmen, die tatsächlich über ein «Bildungsdefizit» verfügen.“"
                            },
                            {
                                "example_id": "8d5cfb0c-6a3c-4654-9389-fff57ebdcfc9",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Einige Firmen bieten Bewerbern eine spezielle Förderung an, um schulische Bildungsdefizite auszugleichen oder zu minimieren.“"
                            },
                            {
                                "example_id": "622ce17a-a4fe-4e4e-a881-76029e7648f6",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "[Bundeswehr:] „Der Wehrbeauftragte berichtete auch von Klagen vieler Vorgesetzter über mangelnde Fitness und Bildungsdefizite bei den Soldaten.“"
                            },
                            {
                                "example_id": "ba4a0792-37c5-4466-bf50-9f8342f94de4",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Die Statistik belege, dass die Bildungsdefizite bei Jugendlichen mit Migrationshintergrund überproportional häufig anzutreffen sind, sagt Markus Kiss: »Rund 13 Prozent der 15 bis 19-jähigen Jugendlichen mit ausländischen Wurzeln verlassen die Schule ohne Abschluss, während es bei deutschen Jugendlichen sieben Prozent sind.«“"
                            },
                            {
                                "example_id": "f9a39fc0-9362-41b7-9e1f-de58b5cf3759",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„In vielen Schulen wird […] darauf geachtet, dass Kinder mit Migrationshintergrund nicht hinter die anderen Kinder zurückfallen, denn Sprach- und Bildungsdefizite lassen sich später nur noch schwer aufholen.“"
                            },
                            {
                                "example_id": "b3a16727-b9a9-4285-94aa-e1e8898a0fb7",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Viele muslimische Migranten haben jüngsten Studien zufolge erhebliche Bildungsdefizite.“"
                            },
                            {
                                "example_id": "ae1b53b1-4cc1-4ce6-8704-7b4ab8d84240",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Die arabischen Länder leiden unter gravierenden Bildungsdefiziten und hoher Jugendarbeitslosigkeit. Das sind die Ergebnisse eines aktuellen UN-Berichts.“"
                            },
                            {
                                "example_id": "de6de92f-cf31-4fd1-8793-0d008b83dca4",
                                "sense_id": "602f4533-6053-3adf-b924-3c462c9a185a",
                                "text": "„Der Jemen gilt als das ärmste Land unter den arabischen Ländern und hat gleichzeitig die größten Bildungsdefizite. Armut und niedriger Bildungsstand stehen auch hier in direktem Zusammenhang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
