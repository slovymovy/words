                "senses": [
                    {
                        "sense_id": "a4631347-b9eb-3e9b-9037-fd1a489d2423",
                        "entry_id": "57633f82-29cc-3872-9809-0f8c10e5e296",
                        "glosses": [
                            "Donner une chiquenaude sur le nez."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2666bdf0-e944-44a1-af63-e43337031b2e",
                                "sense_id": "a4631347-b9eb-3e9b-9037-fd1a489d2423",
                                "text": "Un coup de poing il nasarda\nUn seul coup de poing dans sa vie\n Mais cet uppercut assouvit\nSon héroïsme de soldat."
                            }
                        ]
                    },
                    {
                        "sense_id": "da9dd900-ddab-39c6-91be-5903ce8b7f34",
                        "entry_id": "57633f82-29cc-3872-9809-0f8c10e5e296",
                        "glosses": [
                            "Bafouer."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2e533ba0-b4c7-43e4-a1f3-ba1178e4a0c2",
                                "sense_id": "da9dd900-ddab-39c6-91be-5903ce8b7f34",
                                "text": "Fou qui se sert de sa folie pour nasarder la folie universelle, le Fol de cour suscite le rire et parfois la peur."
                            }
                        ]
                    }
