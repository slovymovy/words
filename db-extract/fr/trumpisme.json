                    {
                        "sense_id": "365ce5fb-fbb5-340c-b15d-407e5a703031",
                        "entry_id": "22eaff93-d565-3ec6-8f1f-eeaf6d8e8812",
                        "glosses": [
                            "Trumpism (political philosophy of Donald Trump)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a617af7d-5336-478c-ac44-f2070d686a6a",
                                "sense_id": "365ce5fb-fbb5-340c-b15d-407e5a703031",
                                "text": "A ceux qui, trois ans après l’arrivée au pouvoir de Donald Trump, s’interrogeraient sur les fondements du « trumpisme », la gestion de la pandémie due au coronavirus par le président des Etats-Unis pourrait donner quelques éléments de réponse.",
                                "translation": "For those who, three years after Donald Trump came to power, still question the fundamentals of “Trumpism”, management of the corona virus pandemic by the President of the United States offers the elements of a solution.",
                                "english": "For those who, three years after Donald Trump came to power, still question the fundamentals of “Trumpism”, management of the corona virus pandemic by the President of the United States offers the elements of a solution."
                            }
                        ]
                    }
