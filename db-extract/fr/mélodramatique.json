                        "translation_id": "510c68c6-bde5-4a45-b325-73a728c8aad3",
                        "source_entry_id": "570c0105-1048-3414-8761-339d88c791bb",
                        "source_sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
