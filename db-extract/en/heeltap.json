                    {
                        "sense_id": "2a06e965-abfd-3c84-a438-450b0ac2c333",
                        "entry_id": "31f09ef3-bb41-3c6b-9551-d5891e6652fe",
                        "glosses": [
                            "A small amount of (especially alcoholic) drink remaining at the bottom of a glass."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c2cd82db-2807-42e6-9469-03da2dd310c3",
                                "sense_id": "2a06e965-abfd-3c84-a438-450b0ac2c333",
                                "text": "A heeltap! a heeltap! I never could bear it! So fill me a bumper, a bumper of Claret! Let the bottle pass freely, don't shirk it nor spare it, For a heeltap! a heeltap! I never could bear it."
                            },
                            {
                                "example_id": "f939ad17-b0eb-42f8-8b4e-006dbb4fb851",
                                "sense_id": "2a06e965-abfd-3c84-a438-450b0ac2c333",
                                "text": "\"He's a good fellow, anyway, if he is a teetotaler!\" \"Drink his health!\" \"Give him a rouser, and no heeltaps!\""
                            },
                            {
                                "example_id": "c4bb7d3f-b7d3-4d45-8a7b-ddd2a717c1ed",
                                "sense_id": "2a06e965-abfd-3c84-a438-450b0ac2c333",
                                "text": "We had the heeltaps of bottles as well, so that we often drank too much—a good thing, for one seemed to work faster when partially drunk."
                            }
                        ]
                    }
                ],
