                "senses": [
                    {
                        "sense_id": "304075f1-e247-3683-82b0-3499967989da",
                        "entry_id": "04d5b42b-7efd-3a00-bcec-284365c8e999",
                        "glosses": [
                            "Schwester eines Elternteils, von der man im Falle ihres Ablebens eine Erbschaft erwartet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f272fdf-9d9c-4966-b17b-ff77f61fdde1",
                                "sense_id": "304075f1-e247-3683-82b0-3499967989da",
                                "text": "„Wenn Sie demnächst vor die Aufgabe gestellt sein sollten, die Verlassenschaft einer Erbtante auflösen zu müssen, lassen Sie sich beim Ausmisten ja nicht von Geschmacksfragen leiten.“"
                            },
                            {
                                "example_id": "83faa220-bfc4-4afe-b19d-b1f51c89b03b",
                                "sense_id": "304075f1-e247-3683-82b0-3499967989da",
                                "text": "„Das Geld der Erbtante wäre dann für die Familie nicht verloren - es würde, statt auf den Staat, auf die übrigen Miterben überspringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
