                "senses": [
                    {
                        "sense_id": "af1795a3-6b76-3f7f-b718-cffbe4d2380b",
                        "entry_id": "9389de8f-c42b-3e6b-bb43-8dc1a6c88703",
                        "glosses": [
                            "indigene nordamerikanische Numic-Sprache (Shoshone-Sprache), die im Südwesten der USA gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d965b7af-4719-497c-9e9a-c73281908e1e",
                                "sense_id": "af1795a3-6b76-3f7f-b718-cffbe4d2380b",
                                "text": "„[…] dieser vermittelte seiner Frau alles in Minnetaree und die schließlich übersetzte aus auf Shoshoni[.]“"
                            },
                            {
                                "example_id": "45f10ed7-7e1e-438c-b19d-3df83b33e9b0",
                                "sense_id": "af1795a3-6b76-3f7f-b718-cffbe4d2380b",
                                "text": "„Postnominale RSe mit Verbsuffixen gibt es ferner in mehreren uto-aztekischen Sprachen wie Yaqui, Shoshoni, Hopi und Cahuilla.“"
                            },
                            {
                                "example_id": "649290e1-a7ed-4304-8ae9-fa1976f50a2a",
                                "sense_id": "af1795a3-6b76-3f7f-b718-cffbe4d2380b",
                                "text": "„Dann folgt die Bestimmung der Sprachfamilien in den Pueblos, Rio Grande Pueblo nebst Dialekten Kera, Zuni, Moqui –, nur letztes mit dem Shoshoni verwandt, die anderen isoliert, und namentlich in keiner Beziehung zur Sprache der Azteken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
