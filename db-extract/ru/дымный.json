                            {
                                "example_id": "72da37e4-c3d6-4a9c-bdd0-2a9ba6d0d8a7",
                                "sense_id": "c38bc090-dcca-3005-aff3-7a24bbdedb50",
                                "text": "ды́мный вы́хлоп",
                                "translation": "smoky exhaust",
