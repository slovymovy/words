                "senses": [
                    {
                        "sense_id": "3bdb92ae-2b73-32fa-9783-e7f494b73546",
                        "entry_id": "8975a0ad-ed85-366e-9c4a-9e7d87a2f9c9",
                        "glosses": [
                            "Wettspielform im Golfspiel, bei der zwei Zweier-Teams gegeneinander spielen, wobei jeder seinen eigenen Ball bis zum Loch spielt und nur das bessere Ergebnis des Teams gewertet wird"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "60261cd9-a2a6-4173-a32e-5afaabf70900",
                                "sense_id": "3bdb92ae-2b73-32fa-9783-e7f494b73546",
                                "text": "„Nach den vier Foursomes am Vormittag, bei denen ein Duo gemeinsam einen Ball spielt, und den zwei beendeten Fourballs, bei denen jede Golferin ihren eigenen Ball schlägt, liegt Titelverteidiger Europa mit 4:2 in Führung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ecde8e7-1918-4d3d-9c9e-0030ff949f98",
                        "source_entry_id": "8975a0ad-ed85-366e-9c4a-9e7d87a2f9c9",
                        "source_sense_id": "3bdb92ae-2b73-32fa-9783-e7f494b73546",
