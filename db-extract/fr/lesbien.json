                                        "examples": [
                                            {
                                                "example_id": "5cc20e87-44db-4ae3-855f-72ce001e355f",
                                                "sense_id": "bd4381bb-9bed-34d7-9c6b-fe99c01a64a7",
                                                "text": "[Angelina Jolie] prožila také lesbický románek s herečkou a modelkou Jenny Shimizuovou."
                                            },
                                            {
                                                "example_id": "e37cf072-4d06-4792-9c6c-86d07423afc2",
                                                "sense_id": "bd4381bb-9bed-34d7-9c6b-fe99c01a64a7",
                                                "text": "Portrét jedné velmi netradiční rodiny a vztahů mezi jejími členy přináší americký snímek Děcka jsou v pohodě režisérky Lisy Cholodenkové. V roli lesbických matek, jejichž dospívající děti touží po seznámení s biologickým otcem, se představí známé herečky Julianne Mooreová a Annette Beningová."
                                            },
                                            {
                                                "example_id": "f4a8fdb4-7d5e-4325-9b3e-708ba5b79f63",
                                                "sense_id": "bd4381bb-9bed-34d7-9c6b-fe99c01a64a7",
                                                "text": "O britské spisovatelce Sarah Watersové se často mluví jako o autorce lesbické literatury."
                                            }
