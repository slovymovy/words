                            "feminine"
                        ],
                        "form": "carrossière"
                    },
                    {
                        "form_id": "f8fbb9e2-8cdd-490f-9598-451920ab5776",
                        "entry_id": "8574dc92-4c60-381d-8e9b-85c101d1d521",
                        "tags": [
                            "plural",
