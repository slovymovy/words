        "fr-extract.jsonl": [
            {
                "entry_id": "c4231032-811e-3a97-92c1-8a9cc44edfa7",
                "word": "lidar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7ed56a3-4be0-4da1-9e98-8690f3fd9acc",
                        "entry_id": "c4231032-811e-3a97-92c1-8a9cc44edfa7",
                        "tags": [
                            "plural"
                        ],
                        "form": "lidars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e246665-baa6-3c84-a31b-ca3529acd947",
                        "entry_id": "c4231032-811e-3a97-92c1-8a9cc44edfa7",
                        "glosses": [
                            "Technique de mesure à distance fondée sur l’analyse des propriétés d’un faisceau de lumière renvoyé par la cible à son émetteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac07eb1-0e53-46e9-b2b1-3b0098ea932c",
                                "sense_id": "5e246665-baa6-3c84-a31b-ca3529acd947",
                                "text": "Le principe de base du LIDAR est le même que celui du RADAR : on envoie un signal lumineux qui est rétrodiffusé de manière élastique ou inélastique sur une cible (nuage, aérosols, atmosphère, cible solide...) et on analyse les propriétés du rayonnement détecté au retour (intensité, délai, polarisation, fréquence...) pour obtenir des informations à distance (forme d’une cible, vitesse, distance, concentration d’espèces chimiques ou biologiques, température, pression, etc.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0549dfec-e2e9-3620-aace-abcb9671dd38",
                        "entry_id": "c4231032-811e-3a97-92c1-8a9cc44edfa7",
                        "glosses": [
                            "Appareil de prise de vue en trois dimensions, en utilisant la technique lidar."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bda6c7ea-fb84-47fe-a196-9d3df3f01c2e",
                                "sense_id": "0549dfec-e2e9-3620-aace-abcb9671dd38",
                                "text": "En analysant les données transmises par divers capteurs (radar, ultrasonique et vidéo) ainsi que des scanners laser (lidars), le véhicule en mode pilote roule à la vitesse choisie, maintient la distance de sécurité, ralentit à l’approche d’un virage et respecte les marquages au sol."
                            },
                            {
                                "example_id": "40346823-5a0e-4741-a873-476731f14b25",
                                "sense_id": "0549dfec-e2e9-3620-aace-abcb9671dd38",
                                "text": "Bardés de caméras et de lidars (des lasers de détection), les taxis électriques autonomes de Waymo (Google) et Cruise (General Motors) ont investi San Francisco depuis l'année dernière, suscitant des débats de plus en plus intenses."
                            },
                            {
                                "example_id": "74840bc0-aef7-4519-b2ee-247244d68435",
                                "sense_id": "0549dfec-e2e9-3620-aace-abcb9671dd38",
                                "text": "Les archéologues croyaient bien connaître le site de Tikal, mais le lidar a révélé que la cité maya la plus vaste du Guatemala était en réalité quatre fois plus grande qu’ils ne le pensaient et comportait un réseau complexe de routes surélevées, de cultures en terrasses, de réservoirs et de fortifications"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbe612a6-645f-44a8-8a49-ad03bc9c55b6",
                        "source_entry_id": "c4231032-811e-3a97-92c1-8a9cc44edfa7",
                        "source_sense_id": "5e246665-baa6-3c84-a31b-ca3529acd947",
                        "source_sense_description": "Technique de mesure",
                        "target_lang_word": "lidar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lidar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "944403f8-7d54-3c39-bf2d-28398482897c",
                                        "entry_id": "24600a1c-fdf3-379b-a170-b4b417f91b9f",
                                        "glosses": [
                                            "The optical analogue of radar, using intense pulses of laser light to measure the composition and structure of the atmosphere."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3672e90-aad0-44d1-8ecb-17877cb1dc4f",
                                                "sense_id": "944403f8-7d54-3c39-bf2d-28398482897c",
                                                "text": "Tesla bet on the idea that in the design of self-driving cars, lidar doesn't add enough capability, beyond what the cameras already provide, to be worth the additional cost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739e6b9d-43ae-332d-85cd-792cdaf8115d",
                                        "entry_id": "24600a1c-fdf3-379b-a170-b4b417f91b9f",
                                        "glosses": [
                                            "A device that provides such imaging."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91397068-9e85-4682-8e78-1cf36de3a2b4",
                                                "sense_id": "739e6b9d-43ae-332d-85cd-792cdaf8115d",
                                                "text": "There's a lidar mounted on the roof of that Waymo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
