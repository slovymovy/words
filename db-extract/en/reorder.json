                        "entry_id": "4a9c4948-ec78-3e55-9e2b-6a5f2a5889c1",
                        "glosses": [
                            "To place in a new order; to rearrange."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fb227b45-2cc3-4fb3-bf1d-2b07fe1bfd3c",
                                "sense_id": "a49ab436-3260-3cab-aaa7-91539a2371ea",
                                "text": "The books were sorted by title, but I'm going to reorder them by author's surname."
                            }
                        ]
                    },
                    {
                        "sense_id": "471bd359-c52a-3cb7-b348-fe0ecfed0eb3",
                        "entry_id": "4a9c4948-ec78-3e55-9e2b-6a5f2a5889c1",
                        "glosses": [
                            "To order (a product, etc.) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "258cd74f-b51c-40d6-bc10-b2101b8b7984",
                                "sense_id": "471bd359-c52a-3cb7-b348-fe0ecfed0eb3",
                                "text": "We reorder printer paper about once a month."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca086764-2994-32e2-921e-11053c176cf7",
                        "entry_id": "4a9c4948-ec78-3e55-9e2b-6a5f2a5889c1",
                        "glosses": [
                            "To order or command again; to repeat an instruction to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "37c2b8ed-e5cc-49b8-97c0-31f7b60cc782",
                                "sense_id": "ca086764-2994-32e2-921e-11053c176cf7",
                                "text": "The Board granted the postponement and reordered him to report for induction on June 18, 1970."
                            }
                        ]
                    }
                ],
