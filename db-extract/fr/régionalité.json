                                "target_senses": [
                                    {
                                        "sense_id": "4f2e8873-cb62-3e1b-a3d2-b527769921fd",
                                        "entry_id": "0d30c091-7e88-35bb-94f4-8bd043ae5882",
                                        "glosses": [
                                            "Eigenschaft, auf (nur) ein geographisches (regionales) Gebiet (eine Region) bezogen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c19d50-f937-447d-b7ac-a171e4315562",
                                                "sense_id": "4f2e8873-cb62-3e1b-a3d2-b527769921fd",
                                                "text": "„Verfolgt man die Diskussion über die Regionalität von Nahrungsmitteln, ist in der Tat die häufige Kombination des Regionsbegriffes mit dem der Nachhaltigkeit unübersehbar.“"
                                            },
                                            {
                                                "example_id": "356de355-aee0-4f4e-9be7-440ca0a34c01",
                                                "sense_id": "4f2e8873-cb62-3e1b-a3d2-b527769921fd",
                                                "text": "„Das Sprechen über Regionen, Regionalisierung und Regionalität ist ein relativ junges Phänomen. Die Begriffe stammen ursprünglich aus der Fachsprache von GeographInnen [sic] und RaumplanerInnen [sic] der 1960er Jahre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
