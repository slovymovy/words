                            {
                                "example_id": "7541961c-1c91-49ce-8f74-14f27969c4d9",
                                "sense_id": "b909ba78-8391-3520-b732-31f1c49b58f7",
                                "text": "Przecież brukselka to ohyda! Jak można to w ogóle jeść?"
                            }
                        ],
