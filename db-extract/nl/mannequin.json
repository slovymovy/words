                    {
                        "sense_id": "4a256ac0-0f7e-32e3-ab81-55cd7aed4581",
                        "entry_id": "119d677b-b91c-3a09-8c2d-02bad689c4d8",
                        "glosses": [
                            "iemand die nieuwe kledingontwerpen dragend deze aan een publiek vertoont"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "67e06f34-e894-462a-830f-f4502d5ca920",
                                "sense_id": "4a256ac0-0f7e-32e3-ab81-55cd7aed4581",
                                "text": "Om mannequin te zijn, heb je een welgevormd lichaam nodig."
                            },
                            {
                                "example_id": "82d994bd-0e4a-4e58-8a0e-15947eb88ba2",
                                "sense_id": "4a256ac0-0f7e-32e3-ab81-55cd7aed4581",
                                "text": "Wacht, zei ze toen ze mij zag, verdween in de slaapkamer en kwam meteen weer terug gekleed in een blazer met dezelfde kleur als de rok en met schoenen met hoge hakken. Ta-damriep ze en ze draaide als een mannequin rond."
                            }
                        ]
                    },
                    {
                        "sense_id": "66c92401-1466-35ef-bb8f-ca7f56ac950a",
                        "entry_id": "119d677b-b91c-3a09-8c2d-02bad689c4d8",
                        "glosses": [
                            "etalagepop"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d14b56ad-ed4e-415a-9255-672b34c0416f",
                        "source_entry_id": "119d677b-b91c-3a09-8c2d-02bad689c4d8",
                        "source_sense_id": "4a256ac0-0f7e-32e3-ab81-55cd7aed4581",
                        "source_sense_description": "iemand die nieuwe kledingontwerpen dragend deze aan een publiek vertoont",
                        "target_lang_word": "mannequin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mannequin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1c553d-c43c-36b0-9094-3c933fb3db4a",
                                        "entry_id": "68c4a074-400d-3a5a-8c0f-4da3619db8c0",
                                        "glosses": [
                                            "A dummy, or life-size model of the human body, used for the fitting or displaying of clothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e990a63b-e22f-4939-b70a-411fb25cf866",
                                                "sense_id": "4f1c553d-c43c-36b0-9094-3c933fb3db4a",
                                                "text": "At the same time, Mr. Bolton was intrigued by Mr. Sundsbo’s proposal to make models look like mannequins because it spoke to the blurring of boundaries — between good and evil, angels and demons, nature and technology, permanence and decay — that was a consistent theme of the McQueen collections."
                                            },
                                            {
                                                "example_id": "b5d04801-edc3-45c0-91fa-4feccea68e71",
                                                "sense_id": "4f1c553d-c43c-36b0-9094-3c933fb3db4a",
                                                "text": "There was a time when a mannequin was the sculptural equivalent of fashion model. Like a fashion model, the mannequin was intended to reflect our social, professional and aesthetic aspirations."
                                            },
                                            {
                                                "example_id": "b44c64a4-7b02-44da-9524-357ea98405bb",
                                                "sense_id": "4f1c553d-c43c-36b0-9094-3c933fb3db4a",
                                                "text": "With the idea that guests may feel lonely eating at a restaurant that can only reach 50% capacity[…]the restaurant will be placing mannequins throughout its dining rooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f94b32-b07a-3072-b72e-9f150d7d33d3",
                                        "entry_id": "68c4a074-400d-3a5a-8c0f-4da3619db8c0",
                                        "glosses": [
                                            "A jointed model of the human body used by artists, especially to demonstrate the arrangement of drapery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b262eebd-3900-3408-a232-61e949bbf2e2",
                                        "entry_id": "68c4a074-400d-3a5a-8c0f-4da3619db8c0",
                                        "glosses": [
                                            "An anatomical model of the human body for use in teaching of e.g. CPR."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5fb2de3-4aab-3512-acef-4b3050a83b88",
                                        "entry_id": "68c4a074-400d-3a5a-8c0f-4da3619db8c0",
                                        "glosses": [
                                            "A person who models clothes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "787aaad0-798d-4a32-b0d7-9fbd15d54987",
                                                "sense_id": "c5fb2de3-4aab-3512-acef-4b3050a83b88",
                                                "text": "[…]all of which made a perfect neutral background for the mannequins who moved around swiftly, gracefully, exhibiting one glorious creation after another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
