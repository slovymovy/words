                    {
                        "sense_id": "406ed632-b08e-3649-831f-54da86209ee5",
                        "entry_id": "b2c41776-b353-3705-ab05-4639d90973ba",
                        "glosses": [
                            "A male given name transferred from the surname, popular from the 1940s to the 1970s."
                        ],
                        "tags": [
