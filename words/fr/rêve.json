    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2adf7954-baa9-3d0e-83f6-ed069f515e90",
                    "sense_definition": "Suite d'images et d'impressions que l'on vit pendant le sommeil, parfois absurdes, agréables ou désagréables.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rêve_pendant_le_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nuit, j'ai fait un <w>rêve</w> très étrange à propos de mon école."
                        },
                        {
                            "text": "Les enfants racontent leurs <w>rêves</w> à leurs parents au petit-déjeuner."
                        }
                    ],
                    "synonyms": [
                        "songe"
                    ],
                    "common_phrases": [
                        "faire un rêve",
                        "un rêve étrange",
                        "un rêve récurrent",
                        "un beau rêve"
                    ]
                },
                {
                    "sense_id": "a4b65943-552b-3fef-8718-3a26c1bba116",
                    "sense_definition": "Désir profond ou espoir que l'on voudrait voir se réaliser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "désir_et_illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voyager autour du monde est le <w>rêve</w> de ma vie."
                        },
                        {
                            "text": "Elle a enfin réalisé son <w>rêve</w> : devenir pilote d'avion."
                        }
                    ],
                    "common_phrases": [
                        "réaliser un rêve",
                        "le rêve de ma vie",
                        "le rêve américain"
                    ]
                },
                {
                    "sense_id": "a2179757-d94e-360f-9b15-9fb8b2bd16c0",
                    "sense_definition": "Chose merveilleuse, qui paraît trop belle pour être vraie, par opposition à un cauchemar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons loué une maison de <w>rêve</w> au bord de la mer."
                        },
                        {
                            "text": "Ces vacances en Grèce étaient un vrai <w>rêve</w> pour toute la famille."
                        }
                    ],
                    "common_phrases": [
                        "maison de rêve",
                        "voyage de rêve",
                        "une vie de rêve"
                    ]
                },
                {
                    "sense_id": "fb01f264-7957-3bd1-a8db-662528a7ca47",
                    "sense_definition": "Projet sans fondement réel, idée irréaliste qui ne pourra pas se réaliser ; chimère, utopie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "désir_et_illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il croyait gagner des millions, mais ce n'était qu'un <w>rêve</w> irréalisable."
                        },
                        {
                            "text": "Un monde sans aucune guerre reste pour beaucoup un <w>rêve</w> utopique."
                        }
                    ],
                    "common_phrases": [
                        "un rêve impossible",
                        "un rêve irréalisable",
                        "un rêve illusoire"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3bf1668-f6c7-3fed-b070-cbb3130b93bb",
                    "sense_definition": "Forme conjuguée de <w>rêver</w> : première et troisième personne du singulier du présent de l'indicatif et du subjonctif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "forme_conjuguée_de_rêver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>rêve</w> souvent de voyager en Italie avec mes amis."
                        },
                        {
                            "text": "Elle <w>rêve</w> d'une petite maison au bord de la mer."
                        },
                        {
                            "text": "Je ne crois pas qu'il <w>rêve</w> encore de devenir footballeur."
                        }
                    ]
                },
                {
                    "sense_id": "f8ddcca5-3211-31bd-a591-7975a2c3a82f",
                    "sense_definition": "Forme conjuguée de <w>rêver</w> : deuxième personne du singulier de l'impératif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_conjuguée_de_rêver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Rêve</w> autant que tu veux, mais n'oublie pas de travailler."
                        },
                        {
                            "text": "N'aie pas peur de l'avenir, <w>rêve</w> grand et avance !"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "ed3b8861-626e-31cd-93fd-c8cae2a33701",
                    "sense_definition": "Interjection familière exprimant un refus net ou une négation forte, pour dire que ce que l'on demande n'arrivera jamais.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Rêve</w> ! Je ne te prêterai plus jamais ma voiture."
                        },
                        {
                            "text": "Tu veux que je fasse tous tes devoirs ? <w>Rêve</w> un peu !"
                        }
                    ],
                    "synonyms": [
