                "senses": [
                    {
                        "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                        "entry_id": "9d711a28-cb2f-362b-b809-dde7d19d5037",
                        "glosses": [
                            "lautes wütendes Brüllen (einer oder vieler Personen)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "819b2f6b-5443-4519-957f-54e61dee8d99",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "Das Wutgebrüll der Familie in der Nachbarwohnung ist sehr laut. Schlägt da der Mann die Frau?"
                            },
                            {
                                "example_id": "717d65dc-57a3-4664-96c6-fde2c6e44742",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "Das Wutgebrüll meiner dreijährigen Tochter kann ganz schön anstrengend sein."
                            },
                            {
                                "example_id": "1d953796-d04b-4a75-a980-e5bb93fbb897",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Im Augenblick, da er dem Sohn den Rücken kehrte, brach dieser in ein ebenso plötzliches wie fürchterliches Wutgebrüll aus.“"
                            },
                            {
                                "example_id": "91c211af-368d-418d-ab35-be1b1f49769c",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Eine meiner Patientinnen berichtete, daß sie in der Kindheit zu Wutgebrüll neigte, das für sie selber und für die ganze Familie immer ein schreckliches Erlebnis war.“"
                            },
                            {
                                "example_id": "ac2ab001-76b6-43ef-95dc-f3e42f87b4d9",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Das Wutgebrüll, das diesen Worten folgte, ließ dem Doc klarwerden, was auf ihn warten würde, wenn er in die Gewalt jener Schufte käme.“"
                            },
                            {
                                "example_id": "d2969334-3d19-4328-bd46-26e08986bd43",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Das Wutgebrüll der enttäuschten, freßlüsternen Räuber war ein einziger Donner.“"
                            },
                            {
                                "example_id": "289a82bb-01b0-45fe-b677-67b90dbab255",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Ein Wutgebrüll der Menge erhob sich, als sie auf diese Weise den Hauptschuldigen ihrer Rache wenigstens für den Augenblick entkommen sah.“"
                            },
                            {
                                "example_id": "8b5bfe10-9c8b-400a-b232-5eac0530c475",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Das Volk empfing ihn mit einem langhallenden Wutgebrüll, in das sich Triumphrufe und Verwünschungen mischten,“ […]."
                            },
                            {
                                "example_id": "41eabcd8-69f5-4d81-833a-b0aee1c2a456",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Die lauten Pfuirufe aus der Menge steigerten sich beim Anblick dieses herausgeputzten, dem Henker verfallenen Kopfes zu einem nicht endenwollenden Wutgebrüll.“"
                            },
                            {
                                "example_id": "bdd42e7c-f6ee-48ec-8b45-b6c018f142ee",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "[1989: SSC Neapel – Werder Bremen: 2:3:] „Als in allerallerletzter Minute, in der sich alle bereits auf das 2:2 eingestellt hatten, Rufer nach einen Bilderbuchkonter das Siegtor schießt, gibt es weder einen Aufschrei noch ein Wutgebrüll, man nimmt es kaum mehr zur Kenntnis, dieses Tor.“"
                            },
                            {
                                "example_id": "0fe9d149-2c4c-4375-b2b7-1a4064a444b2",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Von neuem erschütterte ein Wutgebrüll des Tigers die Luft, doch klang es aus weiterer Entfernung.“"
                            },
                            {
                                "example_id": "14c70502-fc05-4cf9-bb8e-72e6130b3295",
                                "sense_id": "9d241828-da26-3abe-94af-d81cab8cbecf",
                                "text": "„Mit einem Wutgebrüll flog die Tigerin auf den Bändiger los, der unter der Wucht der gelben Masse zusammenbrach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
