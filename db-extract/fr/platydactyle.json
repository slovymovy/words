                "senses": [
                    {
                        "sense_id": "833cf0c8-0529-3b13-9ddf-dc0482bfb60b",
                        "entry_id": "390e4334-abee-3029-a7de-bb9001302223",
                        "glosses": [
                            "Nom donné à plusieurs espèces de lézards également appelés tarentes, geckos, qui faisaient partie du genre désuet Platydactylus."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d784993b-677a-45ae-b5d7-a26c83819eee",
                                "sense_id": "833cf0c8-0529-3b13-9ddf-dc0482bfb60b",
                                "text": "J’ai déjà parlé des geckos du Sahara; l’un est le platydactyle urotorne, on le rencontre dans les rochers noirs, c’est le nègre de son espèce; l’autre est gris et habite dans les vieux murs des ksours, en compagnie du platydactyle des murailles, répandu dans le Midi de l’Europe."
                            },
                            {
                                "example_id": "8a4510e5-710d-4766-9f8b-4c7caef928f1",
                                "sense_id": "833cf0c8-0529-3b13-9ddf-dc0482bfb60b",
                                "text": "Chez les Thécadactyles et les Platydactyles, qui font partie du premier groupe, les doigts sont élargis plus ou moins sur toute leur largeur et garnis en dessous de lamelles transversales, imbriquées, entières ou divisées par un sillon longitudinal et médian."
                            }
                        ]
                    }
