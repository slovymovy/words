    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "87eb40a4-baf0-3a5e-9fe9-c7b760bacae6",
                "word": "olden",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e473716-d637-36f5-b241-c063a3f1886f",
                        "entry_id": "87eb40a4-baf0-3a5e-9fe9-c7b760bacae6",
                        "glosses": [
                            "From or relating to a previous era."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b3870c1-a1d7-4c1f-bce2-6252e96a79e0",
                                "sense_id": "3e473716-d637-36f5-b241-c063a3f1886f",
                                "text": "olden days, olden times"
                            },
                            {
                                "example_id": "c20285cb-a13b-41b7-a809-4ff04141585b",
                                "sense_id": "3e473716-d637-36f5-b241-c063a3f1886f",
                                "text": "\"You are right to some extent in what you say. In the olden days people had a stronger belief in all kinds of witchery; now they pretend not to believe in it, that they may be looked upon as sensible and educated people, as you say.\""
                            },
                            {
                                "example_id": "97f24c6a-2cb5-4f37-b765-ce56525e2b16",
                                "sense_id": "3e473716-d637-36f5-b241-c063a3f1886f",
                                "text": "In olden days, a glimpse of stockings\n Was looked on as something shocking;\n Now, heaven knows,\n Anything goes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e12f30b9-5dd5-3dae-a710-4efae8784683",
                        "entry_id": "87eb40a4-baf0-3a5e-9fe9-c7b760bacae6",
                        "glosses": [
                            "Old; ancient."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e088d53b-0f55-4876-9fc3-0462889e0b74",
                                "sense_id": "e12f30b9-5dd5-3dae-a710-4efae8784683",
                                "text": "We […] told over the story of past sufferings, and renewed olden vows of devotion."
                            },
                            {
                                "example_id": "d9008de7-463c-4f30-8fe6-3344990e79d0",
                                "sense_id": "e12f30b9-5dd5-3dae-a710-4efae8784683",
                                "text": "Beowulf, behind his shield, thrust forth only his right arm. In it he had picked up the sword of Ing, well known in olden lore."
                            }
                        ]
                    }
                ],
