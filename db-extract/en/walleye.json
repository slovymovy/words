                    {
                        "sense_id": "213375d9-6e74-36c9-b94e-d0bed6c70bfd",
                        "entry_id": "9afe4730-85e1-3ba1-a2de-6dc06e8ac1b3",
                        "glosses": [
                            "A species of gamefish, Sander vitreus, native to the Northern U.S. and Canada with pale, reflective eyes."
                        ],
                        "tags": [],
