                "senses": [
                    {
                        "sense_id": "cb5ee142-82f9-3d35-a1c8-53f3d1e01583",
                        "entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "glosses": [
                            "The property of being unpleasant or disagreeable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fbbf82c8-6b84-4031-9331-71ce49519090",
                                "sense_id": "cb5ee142-82f9-3d35-a1c8-53f3d1e01583",
                                "text": "Given the behaviour of the members, who do normally come to Lord’s, this seemed a bizarre attempt to offload the unpleasantness on hoi polloi taking advantage of some rare £25 tickets."
                            }
                        ]
                    },
                    {
                        "sense_id": "97ad7f60-f39d-3e6e-95d9-0c2037419241",
                        "entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "glosses": [
                            "An unpleasant behaviour, occurrence, etc."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c0881c40-3dab-4a1a-a3cc-d078fc92c8e8",
                                "sense_id": "97ad7f60-f39d-3e6e-95d9-0c2037419241",
                                "text": "Perhaps you are not so much aware as I am, of the mischief that may, of the unpleasantnesses that must, arise from a young man’s being received in this manner—domesticated among us—authorized to come at all hours—and placed suddenly on a footing which must do away all restraints."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6294241-c804-4c3f-8887-3f22b78e2107",
                        "source_entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "source_sense_description": "The property of being unpleasant or disagreeable",
