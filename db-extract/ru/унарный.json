                                "text": "Унарная операция"
                            },
                            {
                                "example_id": "6a792fa5-760f-4684-b253-9f7c77e21533",
                                "sense_id": "f962c374-3782-3d88-a6d9-fcd563ccabca",
                                "text": "Унарная функция"
                            },
