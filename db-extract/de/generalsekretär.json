                "senses": [
                    {
                        "sense_id": "3bf0f36c-2c81-3f01-9952-80aa63f0a3b0",
                        "entry_id": "5d515dc5-1732-33f8-8e81-7c66b935b789",
                        "glosses": [
                            "Führungskraft der Verwaltung einer Organisation, wie einer Partei, eines Verbands oder einer internationalen Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894bc006-32a8-4528-93c1-b18bc31ca40b",
                                "sense_id": "3bf0f36c-2c81-3f01-9952-80aa63f0a3b0",
                                "text": "Hubertus Heil war von 2005 bis 2009 Generalsekretär der SPD."
                            },
                            {
                                "example_id": "9afeb1da-a9c1-4e9e-9f8e-4ada538affa6",
                                "sense_id": "3bf0f36c-2c81-3f01-9952-80aa63f0a3b0",
                                "text": "„Generalsekretär Anders Fogh Rasmussen plädierte bei der Sicherheitskonferenz in München für neue Partnerschaften mit Ländern wie China, Indien und Pakistan.“"
                            },
                            {
                                "example_id": "d24ea2f7-0924-4012-bc37-6934779fd46d",
                                "sense_id": "3bf0f36c-2c81-3f01-9952-80aa63f0a3b0",
                                "text": "„›Was liegt, das pickt‹, sagt ÖVP-Generalsekretär Gernot Blümel zum Koalitionspakt – und daran müssten sich jetzt beide Regierungsparteien halten.“"
                            },
                            {
                                "example_id": "d035e4cc-f224-474d-9a5c-babbe3ec504e",
                                "sense_id": "3bf0f36c-2c81-3f01-9952-80aa63f0a3b0",
                                "text": "„Einer, der seine Überzeugung änderte, hieß Friesland und war damals Generalsekretär der KPD.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
