                    {
                        "translation_id": "9a5cacd4-64a5-443a-b1f7-2c0ab8772e3d",
                        "source_entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
                        "source_sense_description": "movement of molecules across a membrane",
                        "target_lang_word": "osmose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osmose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "503988e3-e203-3e3d-868a-f1d516689155",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Échange entre deux solutions séparées par une membrane semi-perméable."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046ba726-8765-40d4-83c7-5935eb1655bf",
                                                "sense_id": "503988e3-e203-3e3d-868a-f1d516689155",
                                                "text": "Les échanges opérés par osmose dépendent de la nature des solutions et de celle des membranes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19ac9dd0-8b06-3ab4-bac4-7983c6e83686",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Pénétration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2226f0e4-496e-4f53-8598-e5a774dfadc3",
                                                "sense_id": "19ac9dd0-8b06-3ab4-bac4-7983c6e83686",
                                                "text": "Son idéologie [de la bourgeoisie] s'écroule : elle justifiait la propriété par le travail et aussi par cette lente osmose qui diffuse dans l'âme des possédants les vertus des choses possédées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Harmonie, mariage, parfait ensemble."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a161a91-6a51-4f48-a957-4e4b7c07f07a",
                                                "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                                "text": "C'est l'échange des sentiments parallèles, il y a communication inconsciente, osmose inaperçue."
                                            },
                                            {
                                                "example_id": "552426b2-d9f8-4157-a445-24bd9d89ab26",
                                                "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                                "text": "À dix mètres sous moi, l'eau invisible. Entre l'eau et la brume, pas de frontière, la brume aussi lourde que l'eau, l'eau aussi irréelle que la brume. Passage dans un autre monde, transition par une osmose où toute forme ancienne est désagrégée et dissoute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bc13df4-0ffa-4181-9c71-1924fbf4d730",
                        "source_entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
