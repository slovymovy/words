                                                "example_id": "7a3cf8af-ea59-43f0-baf7-81c452ec78fd",
                                                "sense_id": "c5f11570-6e64-3053-a21e-bacad0063e70",
                                                "text": "New this season will be a 20-sheet poster depicting 21 K-M elephants parading to local Chevrolet agencies. Deal calls for use of the 20-sheet on poster panels where the auto agency has space allotment. Smaller versions of the same art also will be used.\nCirculation of Kelly-Miller heralds, which last season averaged between 5,000 and 6,000 copies per stand, will be in for one of the greatest boosts this year."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "herald",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b9d0e93-ed39-37a5-a502-a8eebeedc4fa",
                                        "entry_id": "8d6c98eb-60bf-3802-a891-d698ba5e3c5a",
                                        "glosses": [
                                            "To proclaim or announce an event."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ff478a-d632-457d-9815-26c410b0faf5",
                                                "sense_id": "2b9d0e93-ed39-37a5-a502-a8eebeedc4fa",
                                                "text": "Daffodils herald the Spring."
                                            },
                                            {
                                                "example_id": "b448bbe1-2d23-4bb0-9ca0-b8269d9e4b16",
                                                "sense_id": "2b9d0e93-ed39-37a5-a502-a8eebeedc4fa",
                                                "text": "Then, some five miles north of Bolna, the entry into the Arctic is heralded by a long blast on the whistle of the engine. The Arctic Circle is marked by a sign on the east side of the line."
                                            },
                                            {
                                                "example_id": "e1baffc2-9630-41cd-af29-0807febe2b67",
                                                "sense_id": "2b9d0e93-ed39-37a5-a502-a8eebeedc4fa",
                                                "text": "Our arrival at Worcester is heralded by the appearance of the city's cathedral tower, a solid square structure that's dominated the skyline since the 12th century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04f6ec18-3077-3f95-b5fe-754dfcb9ac65",
                                        "entry_id": "8d6c98eb-60bf-3802-a891-d698ba5e3c5a",
                                        "glosses": [
                                            "To greet something with excitement; to hail."
                                        ],
                                        "tags": [
                                            "passive",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3aca470-69df-4d3c-9c1f-c907c90abf01",
                                                "sense_id": "04f6ec18-3077-3f95-b5fe-754dfcb9ac65",
                                                "text": "The film was heralded by critics."
                                            }
                                        ]
                                    }
                                ]
                            },
