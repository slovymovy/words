                        "examples": [
                            {
                                "example_id": "4efd0e93-ca1f-4367-8092-300c86ed91a6",
                                "sense_id": "57154457-12fa-3ce8-86b0-d8beaffe0757",
                                "text": "Ze heeft ook geen zin om uit te zoeken of ze zich op ontslagbescherming kan beroepen en zich bij het arbeidsbureau kan melden, evenmin als ze het ziet zitten om de leegte te vullen met ramen zemen of e-mails schrijven."
                            },
                            {
                                "example_id": "4bfe0d83-9da6-44ea-8fb8-59487747b85f",
                                "sense_id": "57154457-12fa-3ce8-86b0-d8beaffe0757",
                                "text": "In een brief aan de Tweede Kamer laat de staatssecretaris verder weten dat ze niets ziet in ontslagbescherming om de interne vertrouwenspersoon zo onafhankelijk mogelijk zijn of haar werk te kunnen doen. De staatssecretaris denkt dat heldere afspraken tussen vertrouwenspersonen en hun werkgever helpen conflicten te voorkomen."
                            },
                            {
                                "example_id": "7b7a0796-f7bd-48a6-b131-cec8b138ce52",
                                "sense_id": "57154457-12fa-3ce8-86b0-d8beaffe0757",
                                "text": "De voetbalsters vinden onder meer dat ze op jaarbasis minimaal 16.000 euro bruto zouden moeten verdienen en eisen ook betere arbeidsvoorwaarden, waaronder ontslagbescherming in geval van zwangerschap."
                            }
                        ]
