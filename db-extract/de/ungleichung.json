                        "source_sense_id": "e1403d9d-bf38-34b2-9fde-c5fb31820144",
                        "source_sense_description": "Mathematik: Aussage über die relative Größe zweier Objekte",
                        "target_lang_word": "不等式",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "不等式",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce72008-ffa5-384e-90f0-211f77cd2a37",
                                        "entry_id": "f169a67e-5ddf-3eae-9eb1-5dda1c7a8923",
