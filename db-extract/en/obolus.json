                    {
                        "sense_id": "dfd02055-0baf-3f7e-b190-e202a42d14ec",
                        "entry_id": "e7c18ada-9fc2-3b16-ba16-85e46436c641",
                        "glosses": [
                            "A silver coin minted in Ancient Greece, valued at a sixth of a drachma."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ccfe423e-ae74-34dd-b355-be91a9ab82b1",
                        "entry_id": "e7c18ada-9fc2-3b16-ba16-85e46436c641",
                        "glosses": [
                            "A unit of weight, equal to one-sixth of a drachma."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e052419d-6712-4171-9e6d-2a6b68c17bf9",
                                "sense_id": "ccfe423e-ae74-34dd-b355-be91a9ab82b1",
                                "text": "Dav. […] And after that I met the boy of Chremes\nWith fishes, and an obolus of herbs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba044aad-341e-47eb-a1b0-7e1d56e32570",
                        "source_entry_id": "e7c18ada-9fc2-3b16-ba16-85e46436c641",
