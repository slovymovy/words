                    {
                        "translation_id": "c67aa798-6ba8-4de7-ab59-0686f9490a65",
                        "source_entry_id": "0495fbdf-fd85-38cb-ba19-27ca310a859c",
                        "source_sense_id": "3ddc1a5c-070a-376e-ae76-154a0950c808",
