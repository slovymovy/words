                "senses": [
                    {
                        "sense_id": "d72deff2-ef99-340d-b6b9-b5da81476ec6",
                        "entry_id": "44499182-0592-3944-b11c-3a7f4194656f",
                        "glosses": [
                            "Entwicklungszeitraum zwischen Kindheit und Erwachsensein; Adoleszenz, Jugendalter, Jugend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc6b9a3-3ad0-4ad8-9d59-3543d861ba9e",
                                "sense_id": "d72deff2-ef99-340d-b6b9-b5da81476ec6",
                                "text": "„Jesteś waść młodym człowiekiem i żołnierzem, a gdy nawet i starość blizka grobu, nie wie, co ją przed ostateczną godziną spotkać może, cóż dopiero adolescencya, która mając przed sobą wiek długi, na większą liczbę przygód trafić musi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b705a983-4af0-4d36-85d1-24e8c3e52c66",
                        "source_entry_id": "44499182-0592-3944-b11c-3a7f4194656f",
                        "source_sense_id": "d72deff2-ef99-340d-b6b9-b5da81476ec6",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Adoleszenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adoleszenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                        "entry_id": "39267463-d480-3838-a9a2-99bfd750dcd1",
                                        "glosses": [
                                            "Entwicklungszeit des Menschen zwischen dem Kindesalter und dem Erwachsensein; etwa zwischen 13. und 22. Lebensjahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4536dab1-f164-4757-9c93-d91046239f73",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "In den Vereinigten Staaten wird die Adoleszenz im Allgemeinen bereits bei Pubertätsbeginn angesiedelt: beginnend im Alter von 13 Jahren bis zum 24. Lebensjahr."
                                            },
                                            {
                                                "example_id": "171d6c55-8e97-4026-a934-e53effe67822",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "„Ihm schien, als habe er vor ein paar Wochen ein halbes Mädchen, ein leicht schlaksiges, nicht ganz ausgewachsenes Etwas verlassen und plötzlich jemand wiedergefunden, der die mystische Grenze der Adoleszenz gerade passiert und noch ihren Reiz, aber schon die magische Sicherheit einer sehr schönen, jungen Frau hatte.“"
                                            },
                                            {
                                                "example_id": "a083d73a-316d-42bf-9169-7889ae462c49",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "„Die Adoleszenz übertreibt es, und dann wächst es sich hoffentlich aus (mit Goethe, der dann später gemeinsames wildes Schlittenfahren und Peitschenknallen liebte und überhaupt Unfug, konnte er das dann postadoleszent ausleben).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c80e774a-959a-4593-8bca-fbc926de4782",
                        "source_entry_id": "44499182-0592-3944-b11c-3a7f4194656f",
                        "source_sense_id": "d72deff2-ef99-340d-b6b9-b5da81476ec6",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Jugendalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jugendalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                        "entry_id": "5a0623c6-7c23-35a9-b31f-8ed919551978",
                                        "glosses": [
                                            "Lebensabschnitt zwischen der Kindheit und dem Erwachsensein; die Pubertät und Adoleszenz umfassende Altersstufe"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a783020-bfc1-40c6-8c23-d129513a7048",
                                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                                "text": "„Das Manual beschreibt ein zehn Sitzungen umfassendes Gruppenprogramm zur universellen Prävention von Depressionen im Jugendalter.“"
                                            },
                                            {
                                                "example_id": "744074dd-7224-4a55-82b2-e5c030ab9ea2",
                                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                                "text": "„Die Prävention bei psychischen Erkrankungen im Kindes- und Jugendalter ist noch lange nicht ausreichend im Bewusstsein der Gesellschaft, obwohl Zahlen und Fakten alarmierend wirken sollten.“"
                                            },
                                            {
                                                "example_id": "94c6ba6a-37b8-458d-a2df-e5bc0f9ba8c7",
                                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                                "text": "„Stresserleben und Stresssymptome sind im Jugendalter weit verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d0cdc56-ee5e-45ac-8e78-8ba97fc89295",
                        "source_entry_id": "44499182-0592-3944-b11c-3a7f4194656f",
                        "source_sense_id": "d72deff2-ef99-340d-b6b9-b5da81476ec6",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Jugend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jugend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab869eb-97ea-3889-a69d-6faadda1085e",
                                        "entry_id": "88bb7c34-a3b8-3639-ae8a-647f481f3fe4",
                                        "glosses": [
                                            "die Gesamtheit der jungen Leute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19cc122-7565-406c-a04c-d4e11f97fc50",
                                                "sense_id": "0ab869eb-97ea-3889-a69d-6faadda1085e",
                                                "text": "Die Jugend hat einen anderen Musikgeschmack. Den kann man nicht mit dem der Alten vergleichen."
                                            },
                                            {
                                                "example_id": "666da664-1b58-42cb-9004-7ddde3d726e0",
                                                "sense_id": "0ab869eb-97ea-3889-a69d-6faadda1085e",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "b4690a7c-682c-47a7-a796-a0a335d199aa",
                                                "sense_id": "0ab869eb-97ea-3889-a69d-6faadda1085e",
                                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete; der Popularisierung der Wiederbewaffnung bei der Jugend widmete er danach seine ganze Energie.“"
                                            },
                                            {
                                                "example_id": "10ed84e6-9d6c-483c-871e-3c961f45669c",
                                                "sense_id": "0ab869eb-97ea-3889-a69d-6faadda1085e",
                                                "text": "„Gottfried Benn ist wieder da, hoch geehrt und erfolgreich, 1951 Büchner-Preisträger, Mitglied der Darmstädter und Münchner Akademie, Verdienstkreuz der Bundesrepublik Deutschland, Idol einer Jugend, die in ihm findet, was sie sucht: Modernität, Strenge und radikale Abkehr vom Muff der Vergangenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                        "entry_id": "88bb7c34-a3b8-3639-ae8a-647f481f3fe4",
                                        "glosses": [
                                            "das Jugendalter, die Zeit, in der jemand jung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6616280d-5955-4d01-808c-c8ae31094fb1",
                                                "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                                "text": "Die Jugend erlebt man eher unbeschwert als das Alter."
                                            },
                                            {
                                                "example_id": "8f9141b5-5785-4940-908b-82996bb222c5",
                                                "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                                "text": "„Wenn meine Großmutter von Mamans Jugend sprach, klang sie immer wie ein Kunsthändler, der einem inzwischen hoch gehandelten Werk nachtrauerte, das er vor langer Zeit viel zu günstig verkauft hatte.“"
                                            },
                                            {
                                                "example_id": "8d2834b1-bd45-4e1a-8b6a-5287f3e44cbe",
                                                "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                                "text": "„Viele wollte eben nicht wahrhaben, dass sie ihre Jugend einem sinnlosen Seekrieg geopfert hatten.“"
                                            },
                                            {
                                                "example_id": "f388a80e-6770-4f1b-a9af-f96fe3fc8f55",
                                                "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                                "text": "„Ein älteres Paar, das sich seit frühester Jugend kannte, feiert seinen 50. Hochzeitstag.“"
                                            },
                                            {
                                                "example_id": "460b47a0-ad96-4b64-a865-69d0baaf1917",
                                                "sense_id": "bb48d686-63c7-3975-8928-8f5c7048673f",
                                                "text": "„Einige Erlebnisse, die für Einsteins späteres Forschen eine Rolle spielen, scheinen Kindheit und Jugend bestimmt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
