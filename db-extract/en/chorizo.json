                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5becf9f-9b2b-3758-b06f-10e348f65a30",
                        "entry_id": "c3c6e8b4-a590-3428-84f7-05b2682eccc3",
                        "glosses": [
                            "A spicy Spanish sausage flavoured with paprika, often crumbled for use in filling tacos, quesadillas, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cadff395-ff2c-414c-a7e6-3adb0629563c",
                                "sense_id": "c5becf9f-9b2b-3758-b06f-10e348f65a30",
                                "text": "Substitute three chopped scallions and a minced jalapeño for the onion, and 6 ounces crumbled chorizo for the tomatoes. Sub ½ cup queso fresco for the Parmesan in step 2. Serve with salsa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e585f09-1589-4921-bd5e-e2c9bccc4ca2",
                        "source_entry_id": "c3c6e8b4-a590-3428-84f7-05b2682eccc3",
                        "source_sense_id": "c5becf9f-9b2b-3758-b06f-10e348f65a30",
                        "source_sense_description": "type of sausage",
                        "target_lang_word": "chorizo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chorizo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                        "entry_id": "3ecd9fca-030a-3954-8a0d-6b550a6ed627",
                                        "glosses": [
                                            "een van oorsprong Spaanse worstsoort die kruidig van smaak en roodachtig van kleur is en een stevige, grove structuur heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9694db-4119-400f-9751-8a40e6422543",
                                                "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                                "text": "Een Spaanse tortilla, niet te verwarren met de Mexicaanse variant, bestaat simpel gezegd uit veel ei met aardappel erin. Maar er valt veel mee te experimenteren. Zo kun je er extra groente bij doen of een lekkere chorizo, keuze genoeg!"
                                            },
                                            {
                                                "example_id": "1af6b4c4-4687-45c5-a245-b8e825262017",
                                                "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                                "text": "Ondanks dat de mosselen iets kleiner zijn dit jaar, zijn ze wel van topkwaliteit. Reden om vanavond deze lekkere mosselen met chorizo en couscous te proberen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed048287-018a-4e8c-8786-6c2bf3bc400d",
                        "source_entry_id": "c3c6e8b4-a590-3428-84f7-05b2682eccc3",
                        "source_sense_id": "c5becf9f-9b2b-3758-b06f-10e348f65a30",
                        "source_sense_description": "type of sausage",
                        "target_lang_word": "chorizo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chorizo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f41a3d93-e4af-30d6-be72-9b178574c634",
                                        "entry_id": "a3d5aa52-097f-3f64-8ed2-7fccb36a1e4b",
                                        "glosses": [
                                            "Saucisse le plus souvent sèche fabriquée à partir de viande de porc ou d’un mélange de porc et de bœuf, assaisonné avec du sel et du pimentón espagnol, une variété de paprika, qui lui donne sa couleur rouille et son goût légèrement fruité."
                                        ],
                                        "tags": [
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f02417-011f-470e-bfd4-36dc12ff92d3",
                                                "sense_id": "f41a3d93-e4af-30d6-be72-9b178574c634",
                                                "text": "Depuis ce temps, à la cour de Charles IV, les chorizos furent en honneur : le muletier fit sa fortune; toute la grandesse sentit l’ail par amour des chorizos, à ce qu’elle soutenait : par flatterie pour le roi, à ce que dit le peuple."
                                            },
                                            {
                                                "example_id": "79573a78-84f8-4f6f-a2a3-0790d9fc3413",
                                                "sense_id": "f41a3d93-e4af-30d6-be72-9b178574c634",
                                                "text": "De ce premier repas espagnol, bien entendu, on s’en délectait d’avance : le chorizo, la paella valencienne, etc., et un grand coup de vin d’Espagne par-dessus, que fallait-il de plus pour de solides estomacs de montagnards ?"
                                            },
                                            {
                                                "example_id": "c8da6e3e-523e-4753-ba04-19356a180af4",
                                                "sense_id": "f41a3d93-e4af-30d6-be72-9b178574c634",
                                                "text": "Il se saisit de trois rondelles de chorizo, les disposa sur un bout de pain, engloutit l’ensemble, puis se resservit un verre de vin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
