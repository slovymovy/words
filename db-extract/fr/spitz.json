            {
                "entry_id": "f99faf5c-596d-3c27-a2ff-437cd32e1ee4",
                "word": "spitz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03b745c5-c640-38f0-8556-1630b3b7961c",
                        "entry_id": "f99faf5c-596d-3c27-a2ff-437cd32e1ee4",
                        "glosses": [
                            "Race de chien originaire de pays nordique, au museau pointu, aux petites oreilles pointues et dressées, dont la queue est fièrement dressée « en trompette », et à poil long."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a8295204-2965-43bb-8a43-94ac7e8881ce",
                                "sense_id": "03b745c5-c640-38f0-8556-1630b3b7961c",
                                "text": "Les chiens de type spitz font partie du groupe 5 du classement des races de chien par la société centrale canine ou SCC."
                            },
                            {
                                "example_id": "656aa981-6c5b-4fdf-a9eb-655021f2e98d",
                                "sense_id": "03b745c5-c640-38f0-8556-1630b3b7961c",
                                "text": "Avant d’adopter son spitz, Haude a appelé tous ses collègues."
                            },
                            {
                                "example_id": "2e0f31c4-ae62-4321-ab8c-811f7e620564",
                                "sense_id": "03b745c5-c640-38f0-8556-1630b3b7961c",
                                "text": "Toute la meute se déchaînait à la fois : les aboiements lourds des limiers, les glapissements rapides des spitz, les jappements criards des épagneuls, la voix mélancolique des bassets qui pleurent, tout se confondait avec le cliquetis des chaînes, les secousses des chenils ébranlés par la rage ; et, par-dessus tout cela, le hurlement continu, monotone, du loup, dominait toujours : c’était le chant de ce concert infernal !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bca69ce-1b3b-46b7-a065-1251ced160ba",
                        "source_entry_id": "f99faf5c-596d-3c27-a2ff-437cd32e1ee4",
                        "source_sense_id": "03b745c5-c640-38f0-8556-1630b3b7961c",
