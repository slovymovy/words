                        "sense_id": "4b54408f-5459-31ab-a897-e2cb9dbcfb80",
                        "entry_id": "7c86984d-ac9b-3d2a-8d77-a351c105601a",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de prolonger."
                        ],
