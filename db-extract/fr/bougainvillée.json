                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                        "entry_id": "30647a83-32f6-34dd-bcdb-666a36e61fd3",
                        "glosses": [
                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296104c2-fc2b-4c4c-9cc3-c25d02c5dc65",
                                "sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                                "text": "« La maison du maître émerge d’un jardin fleuri d’ibiscus et de bougainvillées. »",
                                "translation": "„Das Haus des Lehrers kommt hinter einem in voller Hibisken- und Bougainvilleenblüte stehenden Garten zum Vorschein.“"
                            },
                            {
                                "example_id": "3d9a12f0-1510-40a9-8fae-c5a9b9450d8e",
                                "sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                                "text": "« Un vent d’Est agita sans bruit les feuilles d’une bougainvillée violette. »",
                                "translation": "„Ein aus Osten wehender Wind wog lautlos die Blätter einer violetten Bougainvillea.“"
                            },
                            {
                                "example_id": "f4835c78-bc60-4328-8d97-128faa3f9aa7",
                                "sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                                "text": "« Sa maison était au bout du quartier, au fond d’une allée bordée de bougainvillées. »",
                                "translation": "„Sein Haus befand sich am Rand des Viertels, am Ende einer mit Bougainvilleen gesäumten Allee.“"
                            },
                            {
                                "example_id": "1982621a-073a-4198-8ba3-dadd1e71122f",
                                "sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                                "text": "« Même en ville, la végétation est reine puisque l’on trouve à foison bougainvillées, hibiscus, palmier, cocotiers, manguiers et bananiers au pied des maisons ! »",
                                "translation": "„Selbst in der Stadt führt die Pflanzenwelt das Zepter, denn man findet in Hülle und Fülle Bougainvilleen, Hibisken, Palmengewächs, Kokospalmen, Mangobäume und Bananenstauden am Fuße der Häuser!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf807a9e-2b18-4b01-bffe-d7e371eeaf51",
                        "source_entry_id": "30647a83-32f6-34dd-bcdb-666a36e61fd3",
                        "source_sense_id": "1d1336b5-a67a-3f0d-bc7a-dfc9dcfede57",
                        "source_sense_description": "zu den Wunderblumen gehörender Strauch oder kleiner Baum",
                        "target_lang_word": "Bougainvillea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bougainvillea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                        "entry_id": "fa19b702-e262-3574-98e7-87f075e6ab3c",
                                        "glosses": [
                                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2cd015a-38e4-4e8c-bdba-bbb8868eb8c7",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie machte ihn aufmerksam auf das, was jetzt hier blühte: Hibiskus, Bougainvillea, Fuchsien.“"
                                            },
                                            {
                                                "example_id": "9387f595-00f6-48ed-9820-6bdf7443afab",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie sahen die unversehrten Stadtmauern, die zugewucherten Straßen, die von den Bougainvilleen verschlungenen Festungen, die Marmorpaläste mit den Goldaltären und den Vizekönigen, die pestkrank in ihren Rüstungen verfault waren.“"
                                            },
                                            {
                                                "example_id": "590243bf-e1b9-42e5-a7df-56ac5383cfdb",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„»[…] Auch die Bougainvillea kommt aus meiner Heimat, obwohl man hierzulande glaubt, sie wachse nur im Mittelmeerraum.«“"
                                            },
                                            {
                                                "example_id": "714e8bc9-793a-4079-ba91-a1d7e071cfa9",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Pinkblühende Bougainvilleen ranken sich an den Mauern empor, sanftes Palmenrauschen über uns.“"
                                            },
                                            {
                                                "example_id": "138e7021-db33-457c-a7f5-2cdf593b8861",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Das heutige Karthago ist der wohl schönste Vorort von Tunis mit palmen- und eukalyptusgesäumten Alleen, Villen und Gärten voll roter Hibiskusblüten und lila Bougainvilleen.“"
                                            },
                                            {
                                                "example_id": "50dcebf4-9b02-43c3-b8f2-71f065a9f9c0",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Bougainvilleen bilden schrillrote Blütenkaskaden.“"
                                            },
                                            {
                                                "example_id": "3baf6041-6bed-428a-825c-8abd0a868f32",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Unter der purpurroten Bougainvillea kommt sie wieder zu Atem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
