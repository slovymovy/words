                "senses": [
                    {
                        "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                        "entry_id": "f662e1e7-18e8-38c2-8618-a1c35930ed5b",
                        "glosses": [
                            "Reihe grammatischer Anhänge hinter dem Stamm/der Wurzel des Wortes"
                        ],
                        "tags": [
                            "Morphologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5c9dd1-9a22-4da5-9812-79e0d0ebadc0",
                                "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                                "text": "„Gleich bemerkt werde soll, dass es gute Gründe gibt, nicht von einem einfachen Suffix zu sprechen, sondern von der Suffixfolge is+t.“"
                            },
                            {
                                "example_id": "337cfb19-6f5a-4dce-b03b-51c634809559",
                                "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                                "text": "„Die Suffixfolge -nni + -na kann offenbar zu -nna verkürzt werden.“ (-nni/-na/-nna kursiv im Original)"
                            },
                            {
                                "example_id": "4097d49e-dfde-4083-8ad6-1090d745d339",
                                "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                                "text": "„Vielmehr ist davon auszugehen, daß -na-r in der Suffixfolge relativ weit hinten rangiert, wie z.B. in sake-ptu-guj-mu-mba-na-r-sa ’pri-kusyvat\" […]“"
                            },
                            {
                                "example_id": "18c4a569-a148-4441-b95b-8198f193f987",
                                "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                                "text": "„Die Suffixfolge kann wechseln: eme + s + tü ger ‚eine frau-en-versehene Jurte‘ — eme + ten […] ger + üd ‚frau-versehen-e Jurten‘.“ (Mongolisch kursiv im Original)"
                            },
                            {
                                "example_id": "29753d38-261f-4294-ae8e-539552abf64f",
                                "sense_id": "2d759bf3-bcdf-37dd-b577-9e449a66d5d3",
                                "text": "„So ist aus der Suffixfolge -ero + -ía ein neues Suffix -ería entstanden, das die Bedeutungen der beiden Suffixe […] in sich vereint.“ (-ero/-ía/-ería kursiv im Original)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
