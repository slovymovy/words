                "senses": [
                    {
                        "sense_id": "8c3ae487-5e0c-3dd0-a53e-9c0f90434cc4",
                        "entry_id": "6cb9ecb8-f61d-37d5-b021-bce2d1125ce2",
                        "glosses": [
                            "„Angabe der Anzahl der Personen, die für die Betreuung anderer Personen zur Verfügung stehen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e788b4d-6230-4d0d-ab1f-3a26e70ee492",
                                "sense_id": "8c3ae487-5e0c-3dd0-a53e-9c0f90434cc4",
                                "text": "„An deutschen Unis und Fachhochschulen muss sich ein Wissenschaftler statistisch um 15,9 Studenten kümmern - etwas mehr als noch vor gut einem Jahrzehnt. 2003 lag der Betreuungsschlüssel bei 1:15,2.“"
                            },
                            {
                                "example_id": "0c407d02-3deb-4055-860e-b902dcebf8c9",
                                "sense_id": "8c3ae487-5e0c-3dd0-a53e-9c0f90434cc4",
                                "text": "„Besonders in den ostdeutschen Bundesländern sei der Betreuungsschlüssel schlecht, eine Erzieherin muss dort also zu viele Kinder in einer Gruppe betreuen.“"
                            },
                            {
                                "example_id": "1a78074f-eac1-4378-b7b9-ad40b84186e7",
                                "sense_id": "8c3ae487-5e0c-3dd0-a53e-9c0f90434cc4",
                                "text": "Ein wichtiges Qualitätsmerkmal ist der sogenannte Betreuungsschlüssel, also um wie viele Kinder sich eine Fachkraft in einer Kita kümmern muss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
