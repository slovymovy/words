                                    {
                                        "sense_id": "4098e12c-726a-3005-aa81-2a8c5b580416",
                                        "entry_id": "fb3a8dc1-bd28-3231-9de0-be5213fc40dc",
                                        "glosses": [
                                            "zeer grote supermarkt met naast levensmiddelen ook het assortiment van een warenhuis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702d90e1-7d5e-4963-95c9-509b55a69987",
                                                "sense_id": "4098e12c-726a-3005-aa81-2a8c5b580416",
                                                "text": "hypermarkten bestonden al in Frankrijk in de jaren '70, hier was alles te koop vanaf een complete auto tot en met het kleinste huishoudartikeltje"
                                            },
                                            {
                                                "example_id": "394cc734-7972-480d-a62b-60dee3bda3ef",
                                                "sense_id": "4098e12c-726a-3005-aa81-2a8c5b580416",
                                                "text": "het shoppen in de hypermarkt was voor mij een gruwelijke ervaring waarbij uren kon worden gezocht tussen oneindige rijen artikelen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ab1576-dd24-4950-8fce-376b580bd4f2",
                        "source_entry_id": "9c13b120-4702-3357-bee3-6d26e2984054",
                        "source_sense_id": "994ca482-f971-3bab-8578-c8a731f07e2e",
                        "source_sense_description": "combination of department store and supermarket",
                        "target_lang_word": "hypermarché",
