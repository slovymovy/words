{
    "word_family": [
        "genade",
        "genadeloos"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "268cf969-5ff2-3524-a222-1f5ed64833e3",
                    "sense_definition": "Barmhartig of vol mededogen zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "genade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning was <w>genadig</w> en verleende de gevangene gratie.",
                            "target_lang_translations": {
                                "en": "The king was <w>merciful</w> and granted the prisoner a pardon."
                            }
                        },
                        {
                            "text": "Wees <w>genadig</w> voor de fouten van anderen.",
                            "target_lang_translations": {
                                "en": "Be <w>merciful</w> regarding the mistakes of others."
                            }
                        }
                    ],
                    "synonyms": [
                        "barmhartig"
                    ],
                    "antonyms": [
                        "ongenadig"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing mercy, compassion, or forgiveness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "merciful",
                                "target_lang_sense_clarification": "showing compassion or forgiveness towards someone in one's power"
                            },
                            {
                                "target_lang_word": "gracious",
                                "target_lang_sense_clarification": "showing kindness and courtesy, often used in a formal or religious context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d877514d-4990-39f2-85dd-3f91409c7866",
                    "sense_definition": "Mild of toegeeflijk in het oordeel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter was <w>genadig</w> en gaf een lagere straf.",
                            "target_lang_translations": {
                                "en": "The judge was <w>lenient</w> and gave a lighter sentence."
                            }
                        },
                        {
                            "text": "Het lot was ons <w>genadig</w> tijdens de storm.",
                            "target_lang_translations": {
                                "en": "Fate was <w>kind</w> to us during the storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "mild",
                        "toegeeflijk"
                    ],
                    "antonyms": [
                        "ongenadig"
                    ],
                    "target_lang_definitions": {
                        "en": "Lenient or forgiving in judgment or circumstances."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lenient",
                                "target_lang_sense_clarification": "more merciful or tolerant than expected, especially in punishment"
                            },
                            {
                                "target_lang_word": "forgiving",
                                "target_lang_sense_clarification": "ready and willing to forgive"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}