{
    "word_family": [
        "verlenen",
        "verlener"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d3b554a-16b3-3b21-8c78-50689bb8f575",
                    "sense_definition": "Het officieel toekennen of verschaffen van iets, zoals een vergunning, subsidie of hulp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toekenning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verlening</w> van de nieuwe omgevingsvergunning heeft enkele weken vertraging opgelopen.",
                            "target_lang_translations": {
                                "en": "The <w>granting</w> of the new environmental permit has been delayed by a few weeks."
                            }
                        },
                        {
                            "text": "Zij hielden zich bezig met de snelle <w>verlening</w> van subsidie aan startende ondernemers.",
                            "target_lang_translations": {
                                "en": "They were concerned with the rapid <w>provision</w> of subsidies to starting entrepreneurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "toekenning",
                        "verstrekking",
                        "verschaffing",
                        "vergunning"
                    ],
                    "antonyms": [
                        "intrekking",
                        "weigering"
                    ],
                    "common_phrases": [
                        "verlening van subsidie",
                        "verlening van vergunning",
                        "snelle verlening"
                    ],
                    "target_lang_definitions": {
                        "en": "The official granting, provision, or awarding of something, such as a permit, subsidy, or assistance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "granting",
                                "target_lang_sense_clarification": "of a permit, subsidy, or right"
                            },
                            {
                                "target_lang_word": "provision",
                                "target_lang_sense_clarification": "of aid, assistance, or services"
                            },
                            {
                                "target_lang_word": "issuance",
                                "target_lang_sense_clarification": "of a license or permit"
                            },
                            {
                                "target_lang_word": "award",
                                "target_lang_sense_clarification": "of a contract or subsidy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d56f88bd-b7ad-3a95-ae5e-4a2787971050",
                    "sense_definition": "De toewijzing of toebedeling van een specifiek aandeel, taak of budget.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toekenning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verlening</w> van de budgetten gebeurde op basis van de prestaties van vorig jaar.",
                            "target_lang_translations": {
                                "en": "The <w>allocation</w> of the budgets was done on the basis of last year's performance."
                            }
                        },
                        {
                            "text": "Na een lange discussie stemde de raad in met de <w>verlening</w> van extra middelen.",
                            "target_lang_translations": {
                                "en": "After a long discussion, the council agreed to the <w>allocation</w> of extra resources."
                            }
                        }
                    ],
                    "synonyms": [
                        "toewijzing",
                        "toebedeling"
                    ],
                    "common_phrases": [
                        "verlening van middelen"
                    ],
                    "target_lang_definitions": {
                        "en": "The allocation, assignment, or distribution of a specific share, task, or budget."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "allocation",
                                "target_lang_sense_clarification": "of budgets, funds, or resources"
                            },
                            {
                                "target_lang_word": "assignment",
                                "target_lang_sense_clarification": "of tasks or duties"
                            },
                            {
                                "target_lang_word": "allotment",
                                "target_lang_sense_clarification": "of shares or resources"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}