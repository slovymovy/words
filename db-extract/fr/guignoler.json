                "senses": [
                    {
                        "sense_id": "c13e7e94-c285-315e-b835-726dc7f2e126",
                        "entry_id": "3df9d4c9-ec90-3488-97a8-b28ce1a328d4",
                        "glosses": [
                            "Faire le guignol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bd790f-8cbe-46df-998a-f57375bdcb4b",
                                "sense_id": "c13e7e94-c285-315e-b835-726dc7f2e126",
                                "text": "Vous avez raison, mieux vaut guignoler, qu'est ce qu'on en a à foutre."
                            },
                            {
                                "example_id": "43ec904e-43bc-4aea-8fd0-f2f0870a2e03",
                                "sense_id": "c13e7e94-c285-315e-b835-726dc7f2e126",
                                "text": "Fini désormais, de guignoler selon les hobereaux de Londres!"
                            },
                            {
                                "example_id": "95795d5d-7d16-42f8-a977-29ec56f6542a",
                                "sense_id": "c13e7e94-c285-315e-b835-726dc7f2e126",
                                "text": "Ils n'auraient eu de cesse, que je me fusse remis à guignoler selon le siècle."
                            }
                        ]
                    }
                ],
