                        "glosses": [
                            "Grand dinosaure herbivore qui a vécu à la fin du jurassique, entre 156 et 140 millions d’années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd13324-25b3-4e87-a908-1535ac696876",
                                "sense_id": "8b34d7e8-f6a4-3193-9d64-7f9388b5af00",
                                "text": "Puis, je me souvins : c’était le stégosaure, l’animal dont Maple White avait gardé l’image dans son album,..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f4aa8be-c5c0-4915-80aa-d0a6c95c3203",
                        "source_entry_id": "754e00d6-ca3b-31da-b7eb-33a4a7147ee1",
