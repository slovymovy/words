                "senses": [
                    {
                        "sense_id": "91723e6d-8880-3d47-b0cf-d7e3caa6e911",
                        "entry_id": "243e25de-9e37-366c-bb1f-aac14874d4f0",
                        "glosses": [
                            "Versorgung der sich im Ruhestand befindenden Beamten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738f5d77-0311-4ddc-99ed-db08a6a1229e",
                                "sense_id": "91723e6d-8880-3d47-b0cf-d7e3caa6e911",
                                "text": "„Berlin hat demnach 750 Millionen Euro für die Beamtenversorgung zurückgelegt und etwa zehn Prozent davon in Aktien investiert.“"
                            },
                            {
                                "example_id": "6c67b028-3c77-48e3-9b5c-cfb0efe4a10b",
                                "sense_id": "91723e6d-8880-3d47-b0cf-d7e3caa6e911",
                                "text": "„Während die Ausgaben für die Beamtenversorgung nach den Worten der Volkswirte der Bundesbank zumindest bis Mitte des nächsten Jahrzehnts überproportional wachsen werden, gingen die Steuereinnahmen zurück.“"
                            },
                            {
                                "example_id": "b8234d03-59dc-4c6b-98db-486e7ecf2ffd",
                                "sense_id": "91723e6d-8880-3d47-b0cf-d7e3caa6e911",
                                "text": "„Wer sich die Zahlen der Beamtenversorgung im Alter anschaut und mit denen der Rentner vergleicht, könnte meinen: Als Pensionär geht das Leben für Beamte erst so richtig los.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
