            {
                "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                "word": "Garnier",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "3a888bd1-d86d-46f9-aa23-9243b0b49d17",
                        "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "das Garnier"
                    },
                    {
                        "form_id": "70b0d2b4-b67e-4998-b6bf-2b3727dde12a",
                        "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Garniers"
                    },
                    {
                        "form_id": "52dfe3fc-b4c3-4083-92f1-f8696d6d2352",
                        "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Garnier"
                    },
                    {
                        "form_id": "600f2e70-a98c-412d-b0a8-22f324736f3e",
                        "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Garnier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "glosses": [
                            "dem Schutz der Waren dienende Verkleidung des Bodens und der Seiten in Laderäumen eines Frachtschiffs"
                        ],
                        "tags": [
                            "Schiffbau"
                        ],
                        "examples": [
                            {
                                "example_id": "3eeaf7d4-eb73-41c7-b0c4-734bfb3d4891",
                                "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                                "text": "Das Garnier (auch Abdeckung) soll die Ladung vor Schweißwasser schützen, das von den Stahlkonstruktionen des Schiffes heruntertropft."
                            },
                            {
                                "example_id": "92dd9a90-ed4b-41fc-90b7-39dd0a01faa6",
                                "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                                "text": "Unebenheiten auf den Stauflächen sollen durch ein Garnier ausgeglichen werden, damit die Ladung nicht eingedrückt wird."
                            },
                            {
                                "example_id": "1e869525-d669-4ef1-a324-f19ff2609ac7",
                                "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                                "text": "Das Garnier muss sauber und verschiffungstrocken sein (13-14 % Eigenfeuchte bei Holz)."
                            },
                            {
                                "example_id": "e744404f-f453-414d-86f5-6a58b8dfc55a",
                                "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                                "text": "Bei alten Schiffen ohne Bauchdielen und Schweißlatten muß man im Unterraum ein Garnier von etwa 16 - 20 cm Höhe legen."
                            },
                            {
                                "example_id": "d4ff36aa-8f9a-4e0f-ab54-8fa11bfe9524",
                                "sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                                "text": "Der Schiffer soll den Schaden an den Gütern tragen, die im Schiff naß gefunden werden, und durch Wasser vom Verdeck, oder von den Seiten, oder aus Mangel vom Garnier naß geworden sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac4f054-06ee-49a3-81cc-afa9544ab039",
                        "source_entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "source_sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "target_lang_word": "dunnage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dunnage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11ed08dc-a271-3b50-9148-94a994a1d149",
                                        "entry_id": "078150e1-468e-34cc-b74e-75e75154f4fd",
                                        "glosses": [
                                            "Scrap material, often wood, used to fill spaces to prevent the shifting of more valuable items during transport, or underneath large or heavy items to raise them slightly above the ground, in order to protect from chafing and wet."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a03a268-5c67-413c-a41f-a33228db864b",
                                                "sense_id": "11ed08dc-a271-3b50-9148-94a994a1d149",
                                                "text": "When you have got your junks wormed and laid up, take each two pieces, and stop them together; double the middle pieces, and stop them also, and clap a good stop on, to form the eye: then bring them all together upon some dunnage, to keep them up from the deck, to enable you to pass your round-about lashings:"
                                            },
                                            {
                                                "example_id": "c6e67d38-8916-41f5-b864-6abd9ef7ab31",
                                                "sense_id": "11ed08dc-a271-3b50-9148-94a994a1d149",
                                                "text": "consortium of companies dedicated to finding a faster and less expensive way to produce dunnages. Dunnages are material handling parts used to hold bumpers and fenders in place when they are shipped or used in Ford's production"
                                            },
                                            {
                                                "example_id": "a2a3ba24-ceb8-4d4e-88c3-a1d94530ee40",
                                                "sense_id": "11ed08dc-a271-3b50-9148-94a994a1d149",
                                                "text": "The robot cameras and software direct the robots to unload the 40-pound parts from pallets (called \"dunnage\") and place them on brackets fixed to a conveyor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7cbcf78-4078-3c3d-ac05-704209ee54b6",
                                        "entry_id": "078150e1-468e-34cc-b74e-75e75154f4fd",
                                        "glosses": [
                                            "A charge levied for materials or equipment left on site."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821bf458-3ad8-4fd5-a367-4412dacc7c69",
                                                "sense_id": "a7cbcf78-4078-3c3d-ac05-704209ee54b6",
                                                "text": "The fact that the bakery was paying dunnage on the loaded car until May 25th and that it was not unloaded until after May 21, 1959, is proof that […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eaecf33-d002-3871-9636-6accd9ee6c6d",
                                        "entry_id": "078150e1-468e-34cc-b74e-75e75154f4fd",
                                        "glosses": [
                                            "Personal effects; baggage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc8da1e8-6e68-45ae-82ba-2eb0d255e333",
                                                "sense_id": "0eaecf33-d002-3871-9636-6accd9ee6c6d",
                                                "text": "The place had the empty and musty feel and smell usual to a dwelling no longer inhabited. Everywhere was a thick litter of discarded and ragged garments, old sea-boots, leaky oilskins -- all the worthless forecastle dunnage of a long voyage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f145fd6-266b-466a-95fb-2d39a120c224",
                        "source_entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "source_sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "target_lang_word": "pagliolo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4bd25b3a-05d4-4459-b922-d7e1ed38de9c",
                        "source_entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "source_sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "target_lang_word": "pagliolato",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2253059f-1e18-49bc-a4b8-c95decf43640",
                        "source_entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "source_sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "target_lang_word": "przekładka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3c6ca800-5b87-4a77-828c-fa07cb80f9dd",
                        "source_entry_id": "6eef3ed0-7156-300a-b301-2d839b8eace7",
                        "source_sense_id": "f7443f0b-0ebe-3a01-9dc0-d836d52b4430",
                        "target_lang_word": "подстилка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подстилка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "80501dae-5dfb-33e1-ad1f-97adc1fbf6c3",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "действие по значению гл. подстилать, подостлать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5a7c6c-d0cb-45b8-9fa0-f5d8d1ceb808",
                                                "sense_id": "80501dae-5dfb-33e1-ad1f-97adc1fbf6c3",
                                                "text": "И как не сжаться сердцу стыдом и жалостью, когда мы видим наших женщин с тяжёлыми носилками на мощении мостовых, на подстилке ж-д путей?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "то, что подостлано, подложено или предназначено для подстилания под кого-либо, подо что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90e6edd-cb32-40c0-aa52-c5d36a08ebdc",
                                                "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                                "text": "Он запыхался и старательно вытирает свои большие, неуклюжие сапоги о подстилку, причём старается скрыть от горничной дыру на сапоге, из которой выглядывает белый чулок."
                                            },
                                            {
                                                "example_id": "fbf85af0-4ff9-4596-ae45-a473fed51289",
                                                "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                                "text": "Дети спят вповалку на нарах, на тонких соломенных подстилках…"
                                            },
                                            {
                                                "example_id": "6b425197-216d-419d-8fdb-242321fd9238",
                                                "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                                "text": "Владимир Михайлович встревожился и пошёл в кухню, где на тоненькой подстилке лежала собака."
                                            },
                                            {
                                                "example_id": "14c59eff-5fb0-4b68-81b2-3a96ca882972",
                                                "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                                "text": "На столе лицом вниз, весь голый и — что показалось всего ужаснее Борису — без подстилки («точно вещь какая», — подумал он) лежал плотный мужчина с синей шеей и приподнятыми плечами."
                                            },
                                            {
                                                "example_id": "1978fca0-c283-4467-bb5e-85f265f7bfd7",
                                                "sense_id": "b834ac9d-6052-30bf-bc41-ca8ab80ad0c4",
                                                "text": "О Максим Ильич, я хотела бы быть всю жизнь рабою вашей, собакой вашей, ковром вашим, подстилкой для ног ваших!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df026be0-761a-3b85-8d76-b0399bd0c4e7",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "перен. лес. сплошной покров, слой чего-либо на поверхности; подложка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995bea4d-8e1f-483d-9a8e-2e9f503a05eb",
                                                "sense_id": "df026be0-761a-3b85-8d76-b0399bd0c4e7",
                                                "text": "На земле ровная и гладкая подстилка из тёмных коричневых игл, слежавшихся в плотный пружинящий войлок, по сторонам березки или иные деревца, сверху над головой радиально разбегающиеся чёрные еловые ветви."
                                            },
                                            {
                                                "example_id": "a6446c56-4b42-4b4f-acc8-ba8a4eccf25f",
                                                "sense_id": "df026be0-761a-3b85-8d76-b0399bd0c4e7",
                                                "text": "Обоняние и осязание у землероек развиты гораздо лучше, чем зрение, от которого мало толку в лесной подстилке, под снегом или в узких подземных тоннелях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c35adc4-7c63-3c64-90cc-d43277365084",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "перен., разг., пренебр. шаткая основа, ненадёжный фундамент, обоснование чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16731228-0f07-4358-9d32-7c76e4165cde",
                                                "sense_id": "5c35adc4-7c63-3c64-90cc-d43277365084",
                                                "text": "Слабоватая теоретическая подстилка под основными проблемами современности привносит в отношение к анархо-синдикалистам элемент экзотичности, особенно у любящих основательность россиян."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08bae6d3-c51c-30fc-93e7-4b2d57db2d5d",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "перен., прост., груб., одуш. развратная или продажная женщина; вообще продажный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215dc881-f0a4-4a7b-8ecd-ab92573539df",
                                                "sense_id": "08bae6d3-c51c-30fc-93e7-4b2d57db2d5d",
                                                "text": "Ещё за глаза, не видя Юлии, а настроился к ней враждебно, неприязненно, как к немецкой овчарке, обыкновенной фрицевской подстилке, но, понаблюдав, переменился."
                                            },
                                            {
                                                "example_id": "a14e91a5-898b-424c-9ad3-0d02ac0a845e",
                                                "sense_id": "08bae6d3-c51c-30fc-93e7-4b2d57db2d5d",
                                                "text": "— Вон! Вон! Змея! Протасовская подстилка!.. Отдай мне миллион!!!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6661c2-aa62-3d07-8ce0-5a27b45be2cd",
                                        "entry_id": "d5d89b27-c5bb-33f8-9bee-5cbe00e22d08",
                                        "glosses": [
                                            "перен., прост., бран. употребляется как бранное выражение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df91c3c8-99c2-4dfb-beeb-e1054ced23cf",
                                                "sense_id": "7d6661c2-aa62-3d07-8ce0-5a27b45be2cd",
                                                "text": "— Ах ты подстилка свиная!.. Меня к стенке?.. Ты что за командир выискался, буржуйское семя!.. Я шлюха?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
