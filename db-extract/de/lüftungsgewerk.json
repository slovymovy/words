                        ],
                        "examples": [
                            {
                                "example_id": "331f7579-7ccb-4ee2-80e8-77acc12be119",
                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                "text": "„Die Installation der Elektro-, Heizungs-, Sanitär- und Lüftungsgewerke im ersten Bauabschnitt – das ist der Bereich Hochstraße und Klostergasse – seien in vollem Gange.“"
                            },
                            {
                                "example_id": "b5b6af1b-667c-4dd4-9902-bc53393a1540",
                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                "text": "„Bei den gesamten Planungen des Lüftungsgewerkes sollte aus brandtechnischen Gründen natürlich auf eine Verwendung nicht brennbarer Baustoffe der Klasse Al geachtet werden.“"
                            },
                            {
                                "example_id": "ab7e9008-17a1-47ca-bb25-25bc1d9f4caa",
                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                "text": "„Die quadratische Form und das klare Design revolutionieren das Lüftungsgewerk und bieten vielfältige Gestaltungsmöglichkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
