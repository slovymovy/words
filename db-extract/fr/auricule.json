                    }
                ],
                "senses": [
                    {
                        "sense_id": "544e7268-fb95-3042-b86a-a0f74739d24f",
                        "entry_id": "a2212a90-6dad-3b7b-80aa-951e3dd435a4",
                        "glosses": [
                            "Lobe, partie charnue de l’oreille externe."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce1daf70-9c3a-3d0b-aaf8-f2be0c7046d1",
                        "entry_id": "a2212a90-6dad-3b7b-80aa-951e3dd435a4",
                        "glosses": [
                            "Pavillon de l’oreille ; partie visible de l’oreille humaine, à l’extérieur de la tête."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4c324d-3d9f-487a-a9af-2b8370703ce1",
                                "sense_id": "ce1daf70-9c3a-3d0b-aaf8-f2be0c7046d1",
                                "text": "L’auricule, ou pavillon de l’oreille, est la partie saillante en forme de coquille ; elle est formée de cartilage élastique recouvert de peau."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb6ff57-23da-30d6-9a42-7121abb5a9c4",
                        "entry_id": "a2212a90-6dad-3b7b-80aa-951e3dd435a4",
                        "glosses": [
                            "Prolongement antérieur de chaque oreillette du cœur, formant un cul-de-sac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d351d4a1-2d95-4b40-baf7-f58cbce4bc76",
                                "sense_id": "dbb6ff57-23da-30d6-9a42-7121abb5a9c4",
                                "text": "En cas de ralentissement du flux sanguin à l’intérieur de la circulation sanguine, l’auricule peut éventuellement être le siège de la formation du caillot (thrombus) pouvant être à la source d’une embolie périphérique à condition que la circulation soit ralentie."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2c4a4c8-b6f0-35a6-8431-6f0be11831b1",
                        "entry_id": "a2212a90-6dad-3b7b-80aa-951e3dd435a4",
                        "glosses": [
                            "Autre nom de l’oreille-d’ours (Primula auricula)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a2416da-3149-492a-b085-e0ed9280074a",
                                "sense_id": "e2c4a4c8-b6f0-35a6-8431-6f0be11831b1",
                                "text": "Fleuri se promenait avec son père le long d'une plate-bande où fleurissaient des jacinthes, des auricules et des narcisses."
                            },
                            {
                                "example_id": "78d5eac5-31be-4f18-8ba0-82c25ebe360d",
                                "sense_id": "e2c4a4c8-b6f0-35a6-8431-6f0be11831b1",
                                "text": "N'oubliez pas la brillante auricule ;\nSoignez aussi la riche renoncule,\nEt la tulipe, honneur de nos jardins :[…]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f72abfec-01ba-4944-8133-e61f7c6d9a98",
                        "source_entry_id": "a2212a90-6dad-3b7b-80aa-951e3dd435a4",
                        "source_sense_description": "pavillon de l’oreille",
                        "target_lang_word": "Ohrmuschel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrmuschel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c9dee28-2ac9-31b8-be90-56cd0efbf573",
                                        "entry_id": "a7a68182-da8b-3a99-8aa4-a2bc0a108dc7",
                                        "glosses": [
                                            "die sichtbaren, äußeren Teile des menschlichen Ohres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91720568-1089-4e38-8f69-d3b603db34d4",
                                                "sense_id": "0c9dee28-2ac9-31b8-be90-56cd0efbf573",
                                                "text": "Die Ohrmuschel sammelt und verstärkt dadurch den Schall."
                                            },
                                            {
                                                "example_id": "72f2c6cc-ddd2-4c80-a62c-d3e11d8cff12",
                                                "sense_id": "0c9dee28-2ac9-31b8-be90-56cd0efbf573",
                                                "text": "„Perlengehänge baumelten von den Ohrmuscheln herab.“"
                                            },
                                            {
                                                "example_id": "3ced456f-7c7e-4f66-81db-8d0cca7495a6",
                                                "sense_id": "0c9dee28-2ac9-31b8-be90-56cd0efbf573",
                                                "text": "„Die ernste, eindringliche Warnung des heiligen Eremiten, die so voll Vernunft war, hatte Eingang nicht nur in seine Ohrmuschel, sondern auch in seinen Verstand und sein Herz gefunden und sein Gewissen wachgerüttelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
