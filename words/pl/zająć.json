                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pozycja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę, <w>zajmij</w> wolne miejsce przy oknie.",
