                        "examples": [
                            {
                                "example_id": "6dcefd06-5287-4d16-8410-68c641f0a815",
                                "sense_id": "4b0141a5-8670-32c2-a909-407f891fc65f",
                                "text": "On sait très bien que, lorsqu'il faudra revenir à la discussion politique, il faudra bien, il n'y a pas d'autres solutions, être capable de resurmonter cela."
                            },
                            {
                                "example_id": "2d196854-e95f-4a2c-8e5a-052e77a5ab1d",
                                "sense_id": "4b0141a5-8670-32c2-a909-407f891fc65f",
                                "text": "On a envie d'un 2nd bébé et il faut se dire qu'on sera forte même s'il faut resurmonter tout ça."
                            }
                        ]
