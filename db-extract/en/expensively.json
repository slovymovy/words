                    {
                        "translation_id": "b55c88cb-05aa-4f33-9a35-3e7008c7e089",
                        "source_entry_id": "84f7295e-2683-3560-b690-040fb725ed19",
                        "source_sense_id": "f3a890b9-6267-3c36-910c-6c179fa5bea3",
                        "source_sense_description": "in an expensive manner",
                        "target_lang_word": "teuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teuer",
