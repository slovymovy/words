                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intensité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d454ca3-cb70-36d8-841b-754c2813f97b",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Haut niveau ou degré ; propriété de ce qui est intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd176cb7-7bef-4ed6-8f5f-4d243133f2db",
                                                "sense_id": "1d454ca3-cb70-36d8-841b-754c2813f97b",
                                                "text": "L’intensité de l’explosion ébranla tout le quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8448d939-2758-3070-b9a7-73cf109438bd",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Puissance de ce qui est exprimé ou ressenti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116f4040-7376-449e-aecb-aa6133f68d22",
                                                "sense_id": "8448d939-2758-3070-b9a7-73cf109438bd",
                                                "text": "[…] ; la gorge nouée, Adeline s'était mise à triturer un petit morceau de cuir qui dépassait d'un clou tapissier mal fixé au dossier du fauteuil fauve qu'elle regardait avec intensité pour détourner ses larmes."
                                            },
                                            {
                                                "example_id": "d85e79a2-f786-416b-a974-518a5d45a9f7",
                                                "sense_id": "8448d939-2758-3070-b9a7-73cf109438bd",
                                                "text": "Rien ne vaut l’intensité des émotions ressenties en chute libre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2bd990-72b9-3539-9bcf-e7d059179d8a",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Pureté et éclat d’une couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4c2c39-1136-4166-b118-bca33b059a87",
                                                "sense_id": "fa2bd990-72b9-3539-9bcf-e7d059179d8a",
                                                "text": "Pour mon regard neuf, chaque détail de mon univers était source d'étonnements, de l’intensité du bleu du ciel aux herbes de notre courette deux fois plus hautes que moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73bc69d5-235b-35f2-855b-d6a520eaee07",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Intensité [de courant] électrique, quantité de courant électrique qui traverse un conducteur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "note": "Elle s’exprime en ampères",
                                        "examples": [
                                            {
                                                "example_id": "b06f9d49-a161-41bb-907c-018a95376210",
                                                "sense_id": "73bc69d5-235b-35f2-855b-d6a520eaee07",
                                                "text": "Je sentais l’intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu’à mes paupières se contracter dans une crispation de plus en plus douloureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35ef5e2-5d81-3989-a796-e4e2db584c1a",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Intensité acoustique, densité de puissance sonore par unité de surface."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb1aa35-af52-468d-8147-748036392442",
                                                "sense_id": "e35ef5e2-5d81-3989-a796-e4e2db584c1a",
                                                "text": "L’intensité de son ne change rien à sa propagation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a89b7e5-7bb9-32d0-a141-27d8e091a919",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Intensité lumineuse : densité par unité d’angle solide du flux lumineux émis par une source lumineuse, dans une direction donnée."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1154bca7-8c41-43b5-91bc-207b3210c178",
                                                "sense_id": "8a89b7e5-7bb9-32d0-a141-27d8e091a919",
                                                "text": "Le candela est l’unité du Système international (SI) pour l’intensité lumineuse."
                                            },
                                            {
                                                "example_id": "daa80392-6223-4ca3-b169-4d82a9f98b4d",
                                                "sense_id": "8a89b7e5-7bb9-32d0-a141-27d8e091a919",
                                                "text": "régler l'intensité des feux"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df9521c-7104-3083-a686-8c3d13f0e371",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Intensité énergétique : densité de puissance par unité d’angle solide émis par une source de rayonnement électromagnétique, dans une direction donnée (équivalent en radiométrie de l’intensité lumineuse)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4d09f7-b74c-483b-b36f-06a1846ed09b",
                                                "sense_id": "9df9521c-7104-3083-a686-8c3d13f0e371",
                                                "text": "L’unité de base du Système international (SI) pour l’intensité énergétique en radiométrie est le watt par stéradian (W/sr)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7ecf05-d561-3212-b2b0-4795988875d7",
                                        "entry_id": "4b5d4857-2b21-3305-b127-4635b0cd035e",
                                        "glosses": [
                                            "Intensité énergétique : rapport entre l’énergie consommée et la valeur économique produite, pour un produit donné, une industrie, une entreprise, voire globalement pour l’économie d’un pays."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5360538-d946-404c-9119-ca52f52c0c1c",
                                                "sense_id": "1f7ecf05-d561-3212-b2b0-4795988875d7",
                                                "text": "La forte réduction apparente de l’intensité énergétique constatée pour les économies des pays avancés est sujette à caution, car une partie de ces « progrès » ont été obtenus en délocalisant les activités énergivores."
                                            },
                                            {
                                                "example_id": "5f80cca1-385d-4aac-ac30-fe7fa741a259",
                                                "sense_id": "1f7ecf05-d561-3212-b2b0-4795988875d7",
                                                "text": "Une hausse importante des prix de l’énergie touche particulièrement les industries lourdes à haute intensité énergétique, mais nettement moins le secteur tertiaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eb1b133-3564-415c-b7fa-abe6ee16a7b7",
