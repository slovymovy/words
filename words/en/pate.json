{
    "word_family": [
        "pâté"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02663dba-63e9-3f91-bd8e-f163462c2122",
                    "sense_definition": "A finely-ground paste of meat, fish, or vegetables, typically served as an appetizer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_paste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spread some smooth chicken liver <w>pate</w> onto a slice of toasted bread.",
                            "target_lang_translations": {
                                "ru": "Она намазала нежный куриный <w>паштет</w> на ломтик поджаренного хлеба."
                            }
                        },
                        {
                            "text": "We ordered a platter of French cheeses and a delicious salmon <w>pate</w>.",
                            "target_lang_translations": {
                                "ru": "Мы заказали тарелку французских сыров и вкуснейший <w>паштет</w> из лосося."
                            }
                        }
                    ],
                    "synonyms": [
                        "pâté"
                    ],
                    "common_phrases": [
                        "chicken liver pate",
                        "smooth pate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонко измельченный паштет из мяса, рыбы или овощей, обычно подаваемый в качестве закуски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паштет",
                                "target_lang_sense_clarification": "кулинарное блюдо из измельченного мяса, рыбы или овощей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "466e9fbb-b983-3ed5-b90b-e2751cdb3787",
                    "sense_definition": "The human head, particularly the top or crown of a bald head.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "head_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun beat down directly on his bald <w>pate</w> during the afternoon walk.",
                            "target_lang_translations": {
                                "ru": "Во время дневной прогулки солнце пекло прямо ему в лысую <w>макушку</w>."
                            }
                        },
                        {
                            "text": "He wore a small hat to cover his shiny <w>pate</w> from the cold wind.",
                            "target_lang_translations": {
                                "ru": "Он носил маленькую шляпу, чтобы защитить свою блестящую <w>лысину</w> от холодного ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "head",
                        "crown",
                        "scalp"
                    ],
                    "common_phrases": [
                        "bald pate",
                        "shiny pate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used humorously or descriptively to refer to a bald head"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человеческая голова, особенно верхняя часть или макушка лысой головы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макушка",
                                "target_lang_sense_clarification": "верхняя часть головы"
                            },
                            {
                                "target_lang_word": "лысина",
                                "target_lang_sense_clarification": "лысая голова или макушка"
                            },
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "разговорное обозначение головы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ffcdf58-9b82-3fe1-aad9-8aa816648392",
                    "sense_definition": "Wit, cleverness, or cognitive abilities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a clever <w>pate</w> to solve such a complex riddle so quickly.",
                            "target_lang_translations": {
                                "ru": "Нужна светлая <w>голова</w>, чтобы так быстро разгадать такую сложную загадку."
                            }
                        },
                        {
                            "text": "He was known as a man of shallow <w>pate</w>, unable to grasp deep philosophical ideas.",
                            "target_lang_translations": {
                                "ru": "Его знали как человека недалекого <w>ума</w>, неспособного постичь глубокие философские идеи."
                            }
                        }
                    ],
                    "synonyms": [
                        "wit",
                        "cleverness",
                        "brain"
                    ],
                    "common_phrases": [
                        "shallow pate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to denote intellect or mind"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Остроумие, сообразительность или когнитивные способности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ум",
                                "target_lang_sense_clarification": "способность мыслить, интеллект"
                            },
                            {
                                "target_lang_word": "рассудок",
                                "target_lang_sense_clarification": "способность здраво размышлять"
                            },
                            {
                                "target_lang_word": "голова",
                                "target_lang_sense_clarification": "в значении ума или сообразительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc592f15-71ae-3372-9732-5d4bc3bd9e6c",
                    "sense_definition": "The interior body or non-rind portion of cheese, characterized by its texture, density, and color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cheese_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheese has a firm, pale yellow <w>pate</w> with small, irregular eyes.",
                            "target_lang_translations": {
                                "ru": "Сыр имеет плотное, бледно-желтое <w>сырное тесто</w> с мелкими неровными глазками."
                            }
                        },
                        {
                            "text": "As the cheese matures, its <w>pate</w> becomes softer and more intensely flavored.",
                            "target_lang_translations": {
                                "ru": "По мере созревания сыра его <w>тело</w> становится мягче, а вкус — более насыщенным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheese pate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя часть или тело сыра (без корки), характеризующееся своей текстурой, плотностью и цветом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырное тесто",
                                "target_lang_sense_clarification": "внутренняя масса сыра"
                            },
                            {
                                "target_lang_word": "тело сыра",
                                "target_lang_sense_clarification": "текстура и мякоть сыра"
                            }
                        ]
                    }
                }
            ]
        },
