                                    },
                                    {
                                        "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To meet with (someone)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9944338b-36b4-4a5c-9d74-93b7ae75a908",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "Linked us, now she don't wanna link them man again / Your ex plays in the Prem but you never see him taking a pen"
                                            },
                                            {
                                                "example_id": "1ea5a05a-a060-4bf6-acae-d4291b4a1067",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "I might link my ting from Barkin'"
                                            },
                                            {
                                                "example_id": "fe376820-e878-4a54-ad0b-c8dfdf09dabc",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "Same old questions, what's your body count?\nWho were you linkin' before me?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "link",
                                "target_lang_code": "en",
                                "target_senses": [
