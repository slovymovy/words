                "senses": [
                    {
                        "sense_id": "8748c181-c1f5-3a77-9249-4c4b6c7fec6c",
                        "entry_id": "1477ad66-8c2e-36a2-8a9b-0b9b761f3c03",
                        "glosses": [
                            "islamischer Religionsunterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb64d0b-863d-4b1e-8a21-1a266f8152c5",
                                "sense_id": "8748c181-c1f5-3a77-9249-4c4b6c7fec6c",
                                "text": "„Im Islamunterricht sollen die muslimischen Kinder etwas über ihren Glauben lernen.“"
                            },
                            {
                                "example_id": "19cd3562-c53e-43b4-9451-660817988952",
                                "sense_id": "8748c181-c1f5-3a77-9249-4c4b6c7fec6c",
                                "text": "„Islamunterricht und die Gründung eines Rates für Islamische Ideologie, der die Vereinbarkeit der föderalen und nationalen Gesetze mit dem Koran und der Sunna überwachen sollte, schrieb die Verfassung ebenso fest wie die Pflicht der Regierung, sich um brüderliche Beziehungen zu anderen Ländern mit muslimischer Bevölkerungsmehrheit zu bemühen.“"
                            },
                            {
                                "example_id": "fa366369-d05b-4acf-b649-c0ec9d020a1b",
                                "sense_id": "8748c181-c1f5-3a77-9249-4c4b6c7fec6c",
                                "text": "„Im Islamunterricht wurden wir zum Selbststudium aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
