                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять задачу в одиночку, особенно совершать полет без инструктора.",
                        "zh": "独自执行任务或活动，尤指首次在没有教练的情况下驾驶飞机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылететь самостоятельно",
                                "target_lang_sense_clarification": "об авиации"
                            },
                            {
                                "target_lang_word": "делать в одиночку",
                                "target_lang_sense_clarification": "о задаче"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单飞",
                                "target_lang_sense_clarification": "航空"
                            },
                            {
                                "target_lang_word": "独自完成",
                                "target_lang_sense_clarification": "任务"
                            }
                        ]
                    }
                },
