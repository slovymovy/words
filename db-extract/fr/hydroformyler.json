                        "glosses": [
                            "Produire des aldéhydes à partir d'alcènes par hydroformylation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be17f2b-6b66-42f8-8786-3df03d66e57b",
                                "sense_id": "8213a499-b856-367d-88dd-7d1c60aa10a6",
                                "text": "De ce fait on peut accéder à une coupe C₁₁-C₁₄ qu'il est intéressant d'hydroformyler et d'hydrogéner pour préparer les alcools C₁₂-C₁₅, synthons de détergents."
                            },
                            {
                                "example_id": "351f6c4d-5e23-44e7-9e64-81e9e53bdc62",
                                "sense_id": "8213a499-b856-367d-88dd-7d1c60aa10a6",
                                "text": "NOS RESULTATS INDIQUENT QUE LA CATALYSE PAR TRANSFERT DE PHASE INVERSE CONSTITUE LA METHODE DE CHOIX POUR HYDROFORMYLER CETTE CATEGORIE D'OLEFINES."
                            }
                        ]
                    }
