                ],
                "translations": [
                    {
                        "translation_id": "9b2d1075-5f4a-467b-945b-0ad1285dd968",
                        "source_entry_id": "4fae2194-4005-3f6b-a1b0-09e4bfbbecf8",
                        "source_sense_id": "f8ccfe7a-f4b7-359c-9d6f-f6304a749dbe",
                        "target_lang_word": "Aufschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "Antwort; eine (finite) Erklärung für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8397977c-942d-44d1-bb4f-93cec4723620",
                                                "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                                "text": "„Anhand der Spurenlage wird angenommen, dass er aus ungeklärter Ursache stürzte und sich dabei die tödlichen Verletzungen zugezogen hat. […] Eine Obduktion des Mannes soll weiteren Aufschluss über seinen Tod geben.“"
                                            },
                                            {
                                                "example_id": "39c1a0c6-373a-40c7-8c75-c06604c513c5",
                                                "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                                "text": "„Die nötigen Aufschlüsse würden ihnen schon die Bücher geben, auch könne ihnen zweifellos Monsieur de Faverges von sich aus oder durch Vermittlung befreundeter alter Edelleute behilflich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "355ee454-9fab-3fe3-b15f-9a4333408645",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "die Überführung schwerlöslicher Substanzen in wasser- und säurelösliche Verbindungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010afabd-a543-4c9a-9e62-92de6b78299c",
                                                "sense_id": "355ee454-9fab-3fe3-b15f-9a4333408645",
                                                "text": "„Der Aufschluss erfolgt durch Schwefeltrioxid, das zu Sulfatanionen weiterreagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96563cc7-de33-38d6-a507-c2fca15790b4",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "Überführung der Nahrungsbestandteile in einen verdaulichen Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3690fadc-577e-3f2f-a488-9d6b1cc890e3",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "bewuchsfreie Stellen der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e801e5-fa6b-44da-9d87-4ca282832da4",
                                                "sense_id": "3690fadc-577e-3f2f-a488-9d6b1cc890e3",
                                                "text": "„Der Bletterbach ist ein Mekka für Geologen aus aller Welt: 20 Millionen Jahre Erdgeschichte sind hier in idealer Weise aufgeschlossen. Kein anderer Aufschluss bietet einen so umfassenden und vielseitigen Einblick in die oberpermische bis mitteltriassische Sedimentabfolge der Südalpen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "db137d4c-74b5-3b16-977f-45098ab7358c",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "das Eröffnen von Zellen in der Biologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66550356-8de0-4419-a1c4-1dcb28cd8070",
                                                "sense_id": "db137d4c-74b5-3b16-977f-45098ab7358c",
                                                "text": "„Durch den Aufschluss der Zellen gelangen die Proteine in eine unphysiologische Umgebung und müssen vor Inaktivierung, Denaturierung und Proteolyse geschützt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
