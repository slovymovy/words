                    {
                        "sense_id": "580485d2-9781-36cb-852f-13d86c551eac",
                        "entry_id": "3a6c6f21-d730-3a6b-b71d-d2b40740bb9b",
                        "glosses": [
                            "Qui produit une infection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85375b7-7ebb-4973-92d7-7604b0cf1965",
                                "sense_id": "580485d2-9781-36cb-852f-13d86c551eac",
                                "text": "Le 27 juillet, l’Institut national de santé publique du Québec (INSPQ) le notait aussi : « De plus en plus d’auteurs sont d’avis que la propagation par des aérosols infectieux est plausible et qu’elle devrait être prise en considération »."
                            },
                            {
                                "example_id": "af2a1106-e458-4df0-901e-88fff625b2bd",
                                "sense_id": "580485d2-9781-36cb-852f-13d86c551eac",
                                "text": "Germes infectieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f74707a-10f1-3d62-9f19-3f21dc387e7d",
                        "entry_id": "3a6c6f21-d730-3a6b-b71d-d2b40740bb9b",
                        "glosses": [
                            "Qui est caractérisé par une infection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c334bbb6-fa7b-44f7-914b-d544fd6e7c21",
                                "sense_id": "0f74707a-10f1-3d62-9f19-3f21dc387e7d",
                                "text": "Maladies infectieuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b1bdef-573d-487b-baaa-8cff60d76e39",
                        "source_entry_id": "3a6c6f21-d730-3a6b-b71d-d2b40740bb9b",
                        "target_lang_word": "infektiös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infektiös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "222e9869-70c4-36b5-819b-6eeee73b04a5",
                                        "entry_id": "6153bfa2-4247-31c3-80bc-4732ed742078",
                                        "glosses": [
                                            "eine (Infektion) verursachend; mit Krankheitserregern behaftet; durch Ansteckung entstanden"
                                        ],
                                        "tags": [
                                            "oder auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aae714b-f396-4112-aaaf-b9cdb5687a73",
                                                "sense_id": "222e9869-70c4-36b5-819b-6eeee73b04a5",
                                                "text": "Das infektiöse Material wird in besonderen Containern gesammelt und verbrannt."
                                            },
                                            {
                                                "example_id": "f838b9ce-1aa0-4638-83e3-338cb6e9af34",
                                                "sense_id": "222e9869-70c4-36b5-819b-6eeee73b04a5",
                                                "text": "Die Larve ist noch nicht infektiös, wird es aber als Nymphe."
                                            },
                                            {
                                                "example_id": "83718ee0-169f-46f5-9b8e-ca41b47e82cf",
                                                "sense_id": "222e9869-70c4-36b5-819b-6eeee73b04a5",
                                                "text": "„Mitte der 60er Jahre ist die infektiöse Endokarditis nach fast einem Jahrhundert fruchtloser Therapieversuche seit ihrer ersten Beschreibung zu einer behandelbaren Krankheit geworden.“"
                                            },
                                            {
                                                "example_id": "c9ab388b-0988-4cfd-95f5-9133655e83de",
                                                "sense_id": "222e9869-70c4-36b5-819b-6eeee73b04a5",
                                                "text": "übertragen: „Die Bühnenluft war infektiös.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d90d1501-f8bd-4094-8725-37b926d30710",
                        "source_entry_id": "3a6c6f21-d730-3a6b-b71d-d2b40740bb9b",
                        "target_lang_word": "infectious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infectious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Caused by an agent that enters the host's body (such as a bacterium, virus, parasite, or prion); often, also, transmitted among hosts via any of various routes (for example, contact, droplet-borne, airborne, waterborne, foodborne, fomite-borne, or bloodborne)."
                                        ],
                                        "tags": [
                                            "of an illness"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d829a39b-0694-42a7-83e9-d95d9d0937d0",
                                                "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                                "text": "Cancer is usually not infectious."
                                            },
                                            {
                                                "example_id": "3ee1bc65-4afb-45b6-bdbd-fc5338e514ec",
                                                "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                                "text": "More infectious diseases like the flu are usually less potent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Able to infect others; capable of transmitting pathogens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541c6cf8-aa14-4dce-b38e-a7dac77574af",
                                                "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                                "text": "Despite feeling better, the patient is still infectious."
                                            },
                                            {
                                                "example_id": "7fe6ad15-989d-4dde-8a69-e79c112594c2",
                                                "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                                "text": "I doubt that [saliva] is very infectious ... I don't think this is a normal route of transmission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Spreading quickly from one person to another."
                                        ],
                                        "tags": [
                                            "of feelings and behaviour"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a5d6d3-1e63-4b2c-97a9-141e07d4a714",
                                                "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                                "text": "Her enthusiasm for work can be really infectious."
                                            },
                                            {
                                                "example_id": "0a9eab8c-0c15-43b3-a220-22650ce3d4b4",
                                                "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                                "text": "When Maisie first met Danny, she remembers that he had an infectious laugh and a love for music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371dc47e-48e9-3a38-b2b5-ee0a689853db",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Memorable and invoking excitement or interest."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6487307b-c1d6-44e9-b5b1-b7dab18455a3",
                                                "sense_id": "371dc47e-48e9-3a38-b2b5-ee0a689853db",
                                                "text": "Pop music is more infectious than elevator music."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a4954e9-6e7c-4b95-bb42-652b55172e61",
