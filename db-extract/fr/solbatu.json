                        "glosses": [
                            "Qualifie un cheval qui a la sole meurtrie."
                        ],
                        "tags": [
                            "Hippologie",
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "a9798d95-c10b-47e4-9b93-1168603868da",
                                "sense_id": "0ac39bb7-cfe0-374e-86bd-a7aa66521007",
                                "text": "Le pied d’un Cheval est dit Solbatu, lorsque la sole est foulée, meurtrie & altérée, ce qui arrive lorsque la sole est trop desséchée & comme privée de nourriture, ou lorsque le Cheval marche defferé sur le dur, ou lorsque le fer porte sur la sole […]."
                            },
                            {
                                "example_id": "c773f24e-1878-449d-8e04-2bb2189b9914",
                                "sense_id": "0ac39bb7-cfe0-374e-86bd-a7aa66521007",
                                "text": "Un cheval solbatu (déformation de sole battue) était un animal qui boitait, à cause d'un fer qui le blessait au pied."
                            }
                        ]
                    }
