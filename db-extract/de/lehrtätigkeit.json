                "senses": [
                    {
                        "sense_id": "74f2cb03-c6c9-35ec-9057-08c7fff42d05",
                        "entry_id": "6da81f77-a541-3137-a2a1-f0d76d44ec0a",
                        "glosses": [
                            "die (berufliche) Tätigkeit als Lehrer, das Tätigsein als Lehrender"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3b387d-57c3-46e8-9de2-6ae243b17e7e",
                                "sense_id": "74f2cb03-c6c9-35ec-9057-08c7fff42d05",
                                "text": "„Künstler, die als ‚entartet‘ ausgestellt wurden, konnten ihre Lehrtätigkeit nicht fortführen und wurden aus dem staatlichen Kunstbetrieb ausgeschlossen.“"
                            },
                            {
                                "example_id": "82e1ca14-4bc2-4754-b738-badb37d36be5",
                                "sense_id": "74f2cb03-c6c9-35ec-9057-08c7fff42d05",
                                "text": "„Einstein begann seine Lehrtätigkeit an der Universität Zürich im Herbst 1909.“"
                            },
                            {
                                "example_id": "71040524-baef-478d-adc6-0b9ebd1fee97",
                                "sense_id": "74f2cb03-c6c9-35ec-9057-08c7fff42d05",
                                "text": "„So mag jener Mann, der Kant vorgezogen wurde, als sich beide 1758 um dieselbe Professur bewarben, jenes Leben geführt haben, wie es dem Kants vergleichbar ist, wenn man von der Tatsache absieht, dass Kant über seine akademische Lehrtätigkeit hinaus als philosophischer Denker tätig wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
