        "nl-extract.jsonl": [
            {
                "entry_id": "09ea6820-12b8-3876-9bfc-3b71aeceab4c",
                "word": "openzetten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "90a73103-3517-3bef-8a1e-5300b9566b69",
                        "entry_id": "09ea6820-12b8-3876-9bfc-3b71aeceab4c",
                        "glosses": [
                            "iets in een stand zetten dat een opening open blijft terwijl die eerst gesloten was"
                        ],
                        "tags": [
                            "met name van ramen, deuren, kranen e.d."
                        ],
                        "examples": [
                            {
                                "example_id": "490deea3-6f76-4682-8659-ac052a56d842",
                                "sense_id": "90a73103-3517-3bef-8a1e-5300b9566b69",
                                "text": "Juist nu de discussie omtrent het gasverbruik actueler dan ooit is. Het moet toch mogelijk zijn om bij een buitentemperatuur van minder dan bijv. 15 graden het openzetten van deuren te verbieden? En dan maar een nette “We zijn open” op de deur plakken. Wat zal dat door het hele land een vermindering van het gasverbruik opleveren"
                            },
                            {
                                "example_id": "7a112452-2a76-4874-ab40-8f2dfb2c036d",
                                "sense_id": "90a73103-3517-3bef-8a1e-5300b9566b69",
                                "text": "De medewerkers van de alarmcentrale vertelden hoe Joke haar dochter moest redden, maar het lukt haar niet. ’’Mijn man heeft het daarna ook geprobeerd, maar ondertussen kregen we te horen dat we de voordeur moesten openzetten. Ik dacht dat dat voor de ambulance was, maar de eerste persoon die binnenkwam was iemand uit de buurt’’"
                            },
                            {
                                "example_id": "ce089000-a4bb-427c-9ae7-91a4a8b86527",
                                "sense_id": "90a73103-3517-3bef-8a1e-5300b9566b69",
                                "text": "Rijkswaterstaat heeft vervanging gezocht. \"Het is altijd even puzzelen. We hopen hem snel weer open te zetten\", zei de woordvoerder. Rijkswaterstaat verwachtte eerder vanochtend dat de tunnel rond 08.00 uur weer open zou gaan, maar dat is niet gelukt. Later stelde Rijkswaterstaat die verwachting bij naar 09.00 uur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9daede2f-0444-40f7-9f57-de4126a113d3",
                        "source_entry_id": "09ea6820-12b8-3876-9bfc-3b71aeceab4c",
                        "source_sense_id": "90a73103-3517-3bef-8a1e-5300b9566b69",
                        "target_lang_word": "open up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "open up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bf99ab-ba08-3dc4-93a0-acb9881f1d08",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To open."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3399d26d-e421-4845-8026-25c9c8f01817",
                                                "sense_id": "e8bf99ab-ba08-3dc4-93a0-acb9881f1d08",
                                                "text": "Some vacancies have opened up due to retirements."
                                            },
                                            {
                                                "example_id": "db8ee327-722a-4197-b1ee-cd4ddffaad5e",
                                                "sense_id": "e8bf99ab-ba08-3dc4-93a0-acb9881f1d08",
                                                "text": "Open up the door!"
                                            },
                                            {
                                                "example_id": "4f224c09-b677-4e41-b36b-31859c1d21bb",
                                                "sense_id": "e8bf99ab-ba08-3dc4-93a0-acb9881f1d08",
                                                "text": "The executive pay gap is opening up again."
                                            },
                                            {
                                                "example_id": "193e8e7b-ee9f-40c5-a27e-dbfeea6aa2e6",
                                                "sense_id": "e8bf99ab-ba08-3dc4-93a0-acb9881f1d08",
                                                "text": "Wilshire then opened up Everton's defence, but Van Persie lifted his finish over the onrushing Howard and also over the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f89f041-f9e6-3173-9d7e-76ad6742967b",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To widen."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6951c1-c6c2-47a4-8da7-a9d84ff13701",
                                                "sense_id": "0f89f041-f9e6-3173-9d7e-76ad6742967b",
                                                "text": "The corridor gradually opened up into a triangular room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aaf202f-e14d-3269-a638-d95964929b28",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To reveal oneself; to share personal information about oneself; to become communicative."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f5bada-a8d8-4071-a926-60e5c23db287",
                                                "sense_id": "1aaf202f-e14d-3269-a638-d95964929b28",
                                                "text": "After three hours of questioning, he finally opened up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4464896-0619-3522-af3d-588b5cd8630e",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To commence firing weapons."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36daff7a-91b9-4268-b740-80569a4e9dd4",
                                                "sense_id": "c4464896-0619-3522-af3d-588b5cd8630e",
                                                "text": "As the convoy entered the pass, we opened up on them with everything we had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f3ead11-9496-3be0-b03d-e72747eabeae",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To rain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf87f346-d53b-412f-95e4-494e00f82329",
                                                "sense_id": "2f3ead11-9496-3be0-b03d-e72747eabeae",
                                                "text": "The sky has really opened up. I've never seen this much rain!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4caa3051-39cc-3ddf-8e95-d5e30b1b8563",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "To begin running, driving, travelling, etc., at maximum (or faster) speed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b25f7f-a7f9-4de4-bc5b-d0a0161ff4e0",
                                                "sense_id": "4caa3051-39cc-3ddf-8e95-d5e30b1b8563",
                                                "text": "The pigeon is moving as before with unhurried haste. [...] But it must be all out. If it wasn't, then it would open up and get away from that shadow of death behind it."
                                            },
                                            {
                                                "example_id": "2754cee9-cb3f-41e5-875d-942fc3434933",
                                                "sense_id": "4caa3051-39cc-3ddf-8e95-d5e30b1b8563",
                                                "text": "Then we simply crawled onwards to Tebay, and not until well on to the 1 in 75 did the driver open up; the result was no greater drop than from 57 at Tebay to a sustained 40 m.p.h. up the last mile to Shap Summit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578eae2a-8538-371a-84fa-8ebd8db65850",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "Synonym of cheat out (“tano face or d not until turn toward the audience more than would be natural”)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8372cf2-5cd3-464a-9714-eb5a381840be",
                                                "sense_id": "578eae2a-8538-371a-84fa-8ebd8db65850",
                                                "text": "In stage acting, we are frequently asked to cheat out to the audience by opening up our body positions so that we are something halfway between facing them and our partner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4afd0e46-2930-3c1d-9434-a090efb8d349",
                                        "entry_id": "dfddb8d0-47e9-39aa-b38d-ea9932acf5d8",
                                        "glosses": [
                                            "Of wine: to develop its full flavor a short time after being uncorked and poured."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
