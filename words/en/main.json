                {
                    "sense_id": "a106bd99-ff21-36a7-8bde-7f0806ac6f00",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Robert <w>Main</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Роберт <w>Мейн</w>."
                            }
                        },
                        {
                            "text": "We are meeting with Mr. <w>Main</w> to discuss the contract.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с мистером <w>Мейном</w>, чтобы обсудить контракт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мейн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6cde87c0-74b5-35a0-91e3-01ec26d24a26",
                    "sense_definition": "Exceedingly, extremely, or very much.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>main</w> hot today, and the window was left open.",
                            "target_lang_translations": {
                                "ru": "Сегодня было <w>ужасно</w> жарко, и окно оставили открытым."
                            }
                        },
                        {
                            "text": "I am <w>main</w> dry and could really use a drink of water.",
                            "target_lang_translations": {
                                "ru": "У меня <w>сильно</w> пересохло в горле, мне бы не помешало выпить воды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
