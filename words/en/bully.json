        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                    "sense_definition": "A person who habitually seeks to harm, intimidate, or coerce those whom they perceive as vulnerable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school <w>bully</w> demanded lunch money from the younger students.",
                            "target_lang_translations": {
                                "ru": "Школьный <w>хулиган</w> требовал деньги на обед у младших учеников.",
                                "nl": "De school<w>pestkop</w> eiste lunchgeld van de jongere leerlingen.",
                                "de": "Der Schul<w>tyrann</w> forderte von den jüngeren Schülern ihr Pausengeld."
                            }
                        },
                        {
                            "text": "She stood up to the <w>bully</w> and reported him to the teacher.",
                            "target_lang_translations": {
                                "ru": "Она дала отпор <w>задире</w> и пожаловалась на него учителю.",
                                "nl": "Ze bood weerstand aan de <w>pestkop</w> en meldde hem bij de leraar.",
                                "de": "Sie leistete dem <w>Mobber</w> Widerstand und meldete ihn beim Lehrer."
                            }
                        }
                    ],
                    "synonyms": [
                        "tormentor",
                        "intimidator",
                        "ruffian",
                        "thug",
                        "harasser"
                    ],
                    "antonyms": [
                        "protector"
                    ],
                    "common_phrases": [
                        "school bully",
                        "workplace bully",
                        "cyber bully"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который систематически преследует, запугивает или обижает тех, кто слабее или уязвимее.",
                        "nl": "Iemand die stelselmatig anderen lastigvalt, intimideert of kwelt, vaak omdat zij als kwetsbaar worden gezien.",
                        "de": "Eine Person, die andere systematisch schikaniert, einschüchtert oder quält, oft weil sie diese als schwächer wahrnimmt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задира",
                                "target_lang_sense_clarification": "человек, склонный к ссорам и агрессии"
                            },
