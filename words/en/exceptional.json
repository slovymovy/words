    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc475660-fe74-3a24-8320-476bcbce48e5",
                    "sense_definition": "Much better than average; superior in quality, ability, or degree.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared an <w>exceptional</w> meal that everyone enjoyed.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил <w>исключительный</w> ужин, который всем понравился.",
                                "tr": "Şef herkesin beğendiği <w>olağanüstü</w> bir yemek hazırladı."
                            }
                        },
                        {
                            "text": "She showed <w>exceptional</w> talent for music at a very young age.",
                            "target_lang_translations": {
                                "ru": "Она проявила <w>выдающийся</w> музыкальный талант в очень юном возрасте.",
                                "tr": "Çok genç yaşta müziğe karşı <w>olağanüstü</w> bir yetenek gösterdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "egregious"
                    ],
                    "antonyms": [
                        "ordinary",
                        "mediocre",
                        "commonplace"
                    ],
                    "common_phrases": [
                        "exceptional quality",
                        "exceptional talent",
                        "exceptional circumstances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гораздо лучше среднего; превосходный по качеству, способностям или степени.",
                        "tr": "Ortalamadan çok daha iyi; kalite, yetenek veya derece bakımından üstün."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "превосходный, необычный"
                            },
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "о таланте или заслугах"
                            },
                            {
                                "target_lang_word": "необыкновенный",
                                "target_lang_sense_clarification": "поразительный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olağanüstü",
                                "target_lang_sense_clarification": "mükemmel, fevkalade"
                            },
                            {
                                "target_lang_word": "istisnai",
                                "target_lang_sense_clarification": "sıra dışı yüksek kalitede"
                            },
                            {
                                "target_lang_word": "seçkin",
                                "target_lang_sense_clarification": "üstün yetenek veya nitelikte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b32b44c8-ed22-3e99-a4cd-685ba2bec369",
                    "sense_definition": "Forming an exception; not ordinary, typical, or usual.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We only allow late submissions in very <w>exceptional</w> cases.",
                            "target_lang_translations": {
                                "ru": "Мы разрешаем позднюю сдачу работ только в <w>исключительных</w> случаях.",
                                "tr": "Geç teslimlere sadece çok <w>istisnai</w> durumlarda izin veriyoruz."
                            }
                        },
                        {
                            "text": "This is an <w>exceptional</w> situation that requires a unique solution.",
                            "target_lang_translations": {
                                "ru": "Это <w>исключительная</w> ситуация, требующая уникального решения.",
                                "tr": "Bu, özgün bir çözüm gerektiren <w>istisnai</w> bir durumdur."
                            }
                        }
                    ],
                    "antonyms": [
