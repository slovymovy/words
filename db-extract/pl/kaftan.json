                "translations": [
                    {
                        "translation_id": "1453f93d-ae1c-4842-8ad7-80c7dd58548d",
                        "source_entry_id": "0ac0f1b1-69ff-3763-9177-0bd9c1f7b32b",
                        "source_sense_id": "97bd1e15-521e-3c33-acd6-18bd61f8499b",
                        "target_lang_word": "caftan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caftan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11488cb2-5357-3fdb-803b-2a659cd8359d",
                                        "entry_id": "97d6c648-6813-3343-adb1-6ca7d7c27401",
                                        "glosses": [
                                            "Alternative spelling of kaftan."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d7be78e-f313-41bb-8d85-7f2d682f75f1",
                                                "sense_id": "11488cb2-5357-3fdb-803b-2a659cd8359d",
                                                "text": "From the pocket of her discarded caftan she lifted a thick medallion and set it in place around her neck."
                                            },
                                            {
                                                "example_id": "2f812488-2e7c-4da6-9e68-ccfa0151094b",
                                                "sense_id": "11488cb2-5357-3fdb-803b-2a659cd8359d",
                                                "text": "Still, he did look striking in his long white flowing pants and a white caftan."
                                            },
                                            {
                                                "example_id": "635ddf23-5e81-4e86-b28c-a1b337f6a907",
                                                "sense_id": "11488cb2-5357-3fdb-803b-2a659cd8359d",
                                                "text": "[…] there’s always “The Golden Girls.” Less couture, more caftans; less Gramercy Park townhouses, more Miami ranch houses, but all the joy and laughs that “And Just Like That …” didn’t deliver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ba6d37-5692-482e-b9af-db9cdf0338a3",
                        "source_entry_id": "0ac0f1b1-69ff-3763-9177-0bd9c1f7b32b",
                        "source_sense_id": "97bd1e15-521e-3c33-acd6-18bd61f8499b",
