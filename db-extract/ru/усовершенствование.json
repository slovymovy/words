                "senses": [
                    {
                        "sense_id": "5ea17a8b-09fd-37bc-bd31-224693bff353",
                        "entry_id": "2d811dd8-e778-3569-8388-c9eef3fe2466",
                        "glosses": [
                            "приведение чего-л. в более совершенный порядок"
                        ],
                        "tags": [],
