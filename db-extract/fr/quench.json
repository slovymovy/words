                        "entry_id": "1a47ea1d-2c3b-30a2-b691-cb0a17716b26",
                        "glosses": [
                            "Dispositif de refroidissement rapide d’un gaz par injection d’eau."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b71f54-cfc2-46ff-b3db-ec1997c051c3",
                                "sense_id": "bb91a0e8-76dc-3e5a-ae30-082995e0d5d9",
                                "text": "Le niveau de la température limite de refroidissement dépend de la teneur en eau du gaz d’échappement et de la température du gaz à l’entrée dans le quench."
