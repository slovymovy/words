    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4123aca-aa5d-3a08-bcb7-6b4e83323335",
                    "sense_definition": "A device used for opening containers, such as cans or bottles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find the <w>opener</w> for this bottle of wine.",
                            "target_lang_translations": {
                                "ru": "Я не могу найти <w>открывалку</w> для этой бутылки вина.",
                                "zh": "我找不到这瓶红酒的<w>开瓶器</w>了。"
                            }
                        },
                        {
                            "text": "Please use the can <w>opener</w> to remove the lid.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используй консервный <w>нож</w>, чтобы снять крышку.",
                                "zh": "请用<w>开罐器</w>把盖子打开。"
                            }
                        }
