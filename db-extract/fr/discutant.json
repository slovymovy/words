                        "glosses": [
                            "Personne qui discute, qui questionne une présentation qui vient d’être donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9dd4fd-6a7a-4a81-a723-e2af29fffd2e",
                                "sense_id": "f3d6bac7-68cc-3855-88d9-214d7c66eff8",
                                "text": "Nous convenons de nous revoir après l’élaboration, par le discutant, de son texte, et par le présentateur, du sien, afin d’articuler cette présentation."
                            }
                        ]
                    }
                ],
