                    }
                ],
                "translations": [
                    {
                        "translation_id": "e16209fa-58eb-4449-9b10-95191997f3f1",
                        "source_entry_id": "f806f890-02aa-334d-988c-2f5934ab187a",
                        "source_sense_id": "5266466d-b8ef-334b-b436-4898ed9790c6",
                        "source_sense_description": "1. Entrer (dans un groupement, une association).",
                        "target_lang_word": "beitreten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beitreten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba101bd2-3546-35eb-86fc-13872b4b31ec",
                                        "entry_id": "e6271940-2645-3a4b-a579-2d3ba2021d7d",
                                        "glosses": [
                                            "Mitglied einer Personenmehrheit werden (zum Beispiel eines Vereines, einer Partei, Organisation, Glaubensgemeinschaft)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "145cd37e-1505-4f39-9bf2-8b0d613a8ae7",
                                                "sense_id": "ba101bd2-3546-35eb-86fc-13872b4b31ec",
                                                "text": "„Ich kann der Gewerkschaft nicht beitreten.“"
                                            },
                                            {
                                                "example_id": "43d507aa-e655-4622-9e4a-f042333a5d1d",
                                                "sense_id": "ba101bd2-3546-35eb-86fc-13872b4b31ec",
                                                "text": "„1935 tritt Bonhoeffer der Bekennenden Kirche (BK) bei.“"
                                            },
                                            {
                                                "example_id": "5af9cb37-080c-4af6-87c8-69678da43a72",
                                                "sense_id": "ba101bd2-3546-35eb-86fc-13872b4b31ec",
                                                "text": "Ich war nie ein Freund von solchen Veranstaltungen, bei denen doch nichts anderes herauskommt, als daß ein paar vorlaute Leute den Ton angeben und sich geltend zu machen suchen, wollte also anfänglich dem Verein gar nicht beitreten."
                                            },
                                            {
                                                "example_id": "57a7306d-6632-4a2e-bf2d-b8519f63eb3d",
                                                "sense_id": "ba101bd2-3546-35eb-86fc-13872b4b31ec",
                                                "text": "»Er habe ihnen ehemals den Rath gegeben,« antwortete der Prinz, »und komme jetzt abermals darauf zurück, daß sie dem Augsburgischen Bekenntnisse beitreten sollten; dann wäre ihnen Hilfe aus Deutschland gewiß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0fa774b8-b8c5-3448-b0ab-5af696c9a050",
                                        "entry_id": "e6271940-2645-3a4b-a579-2d3ba2021d7d",
                                        "glosses": [
                                            "weitere Partei eines bereits bestehenden Vertrages oder Prozessrechtsverhältnisses werden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f63658-3faa-446d-9e80-1ebf998318bd",
                                                "sense_id": "0fa774b8-b8c5-3448-b0ab-5af696c9a050",
                                                "text": "»Meine Krieger werden euch gegen die andern Stämme beschützen, wenn diese dem Vertrage, welchen ich mit dir geschlossen habe, nicht beitreten sollten."
                                            },
                                            {
                                                "example_id": "89a8a9d1-f72a-4444-bbbc-bfee369eb604",
                                                "sense_id": "0fa774b8-b8c5-3448-b0ab-5af696c9a050",
                                                "text": "Anders als der Iran, der dem Atomwaffensperrvertrag beigetreten ist, bedroht Indien keine anderen Staaten mit deren Auslöschung."
                                            },
                                            {
                                                "example_id": "309618b2-a540-41ae-901a-cc0b40c2d17c",
                                                "sense_id": "0fa774b8-b8c5-3448-b0ab-5af696c9a050",
                                                "text": "„»Jetzt ist auch formell bestätigt, dass Kroatien dem Schengenraum zum 1. Januar 2023 beitritt«, schrieb die kroatische EU-Vertretung auf Twitter.“"
                                            },
                                            {
                                                "example_id": "bf3127a3-7e3d-441d-85f3-2bfa886cf245",
                                                "sense_id": "0fa774b8-b8c5-3448-b0ab-5af696c9a050",
                                                "text": "Doch er tritt der Klage nicht bei […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9775b25c-6d18-35f0-a45c-ad4e8601896d",
                                        "entry_id": "e6271940-2645-3a4b-a579-2d3ba2021d7d",
                                        "glosses": [
                                            "jemanden körperlich oder moralisch unterstützen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e1af57c-2b5e-4c23-aac8-d0cb9b39e44e",
                                                "sense_id": "9775b25c-6d18-35f0-a45c-ad4e8601896d",
                                                "text": "Der Kapuziner verteidigte sich schlecht, und da der Graf recht hatte, glaubte ich ihm beitreten zu müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "88ef6149-7e8c-3bd9-a5f4-36746796df82",
                                        "entry_id": "e6271940-2645-3a4b-a579-2d3ba2021d7d",
                                        "glosses": [
                                            "eine Ansicht unterstützen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14b24ab-40a2-41ec-b40d-7368f793c424",
                                                "sense_id": "88ef6149-7e8c-3bd9-a5f4-36746796df82",
                                                "text": "Und in der Tat, wenn wir erfahren, daß in der ausführlichen Beschreibung der Taten und Erlebnisse des großen Seehelden Tromp ausdrücklich der Bravour eines Schiffsleutnants Treuttelfueß gedacht wird, der sich im Jahre 1639 in dem Treffen bei Grevelingen gegen die Spanischen ausgezeichnet hatte, werden wir gewiß der Meinung des Herrn Eusebius beitreten müssen, der dieses »Treuttelfueß« als einen bloßen Druckfehler für Trenttelfuß erklärte."
                                            },
                                            {
                                                "example_id": "46117f77-faa7-4b67-95d8-74ac3afa7b04",
                                                "sense_id": "88ef6149-7e8c-3bd9-a5f4-36746796df82",
                                                "text": "»Herr Rechtsanwalt Büffel sowie der Herr Polizeirat, vielleicht auch Frau Polizeirat werden meiner Anschauung beitreten«, sprach er mit einem Wink auf die Gesamten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
