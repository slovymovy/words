{
    "word_family": [
        "прокладывать",
        "проложить",
        "прокладчик",
        "прокладочный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83d47055-4f27-3b55-8028-4a71ac2b42b9",
                    "sense_definition": "Действие по значению глагола <w>прокладывать</w>; строительство или проведение путей, дорог, труб или линий связи.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "строительство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашем районе началась активная <w>прокладка</w> новых водопроводных труб.",
                            "target_lang_translations": {
                                "en": "Active <w>laying</w> of new water pipes has begun in our district."
                            }
                        },
                        {
                            "text": "Для улучшения связи необходима <w>прокладка</w> кабеля по дну океана.",
                            "target_lang_translations": {
                                "en": "To improve communication, the <w>installation</w> of a cable along the ocean floor is necessary."
                            }
                        }
                    ],
                    "synonyms": [
                        "проводка"
                    ],
                    "common_phrases": [
                        "прокладка кабеля",
                        "прокладка дорог",
                        "прокладка труб"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of laying or installing infrastructure such as roads, pipes, cables, or communication lines."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laying",
                                "target_lang_sense_clarification": "of cables or pipes"
                            },
                            {
                                "target_lang_word": "installation",
                                "target_lang_sense_clarification": "of infrastructure"
                            },
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "of roads or paths"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb33c6d5-b8a3-3eb2-9453-7497e1556f6a",
                    "sense_definition": "Деталь из мягкого материала, помещаемая между частями механизма для обеспечения герметичности или защиты.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "техника",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кран начал течь, потому что старая резиновая <w>прокладка</w> совсем износилась.",
                            "target_lang_translations": {
                                "en": "The tap started leaking because the old rubber <w>washer</w> was completely worn out."
                            }
                        },
                        {
                            "text": "Перед сборкой двигателя убедитесь, что каждая резиновая <w>прокладка</w> установлена правильно.",
                            "target_lang_translations": {
                                "en": "Before assembling the engine, make sure each rubber <w>gasket</w> is installed correctly."
                            }
                        }
                    ],
                    "synonyms": [
                        "прослойка"
                    ],
                    "common_phrases": [
                        "резиновая прокладка",
                        "сменная прокладка"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "технический термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of soft material placed between mechanical parts to ensure a tight seal or provide protection."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gasket",
                                "target_lang_sense_clarification": "mechanical seal"
                            },
                            {
                                "target_lang_word": "washer",
                                "target_lang_sense_clarification": "for a bolt or tap"
                            },
                            {
                                "target_lang_word": "spacer",
                                "target_lang_sense_clarification": "to create distance"
                            },
                            {
                                "target_lang_word": "lining",
                                "target_lang_sense_clarification": "protective layer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f1e586b-d7da-3f94-86c9-44a0ba61cd2b",
                    "sense_definition": "Гигиеническое средство для впитывания выделений, используемое женщинами.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "гигиена",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В аптеке продается специальная гигиеническая <w>прокладка</w> с крылышками.",
                            "target_lang_translations": {
                                "en": "A special sanitary <w>pad</w> with wings is sold at the pharmacy."
                            }
                        },
                        {
                            "text": "Современная гигиеническая <w>прокладка</w> обеспечивает комфорт и надежную защиту в течение дня.",
                            "target_lang_translations": {
                                "en": "A modern sanitary <w>towel</w> provides comfort and reliable protection throughout the day."
                            }
                        }
                    ],
                    "antonyms": [
                        "тампон"
                    ],
                    "common_phrases": [
                        "гигиеническая прокладка",
                        "ежедневная прокладка"
                    ],
                    "target_lang_definitions": {
                        "en": "An absorbent hygiene product used by women during menstruation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pad",
                                "target_lang_sense_clarification": "sanitary product"
                            },
                            {
                                "target_lang_word": "sanitary towel",
                                "target_lang_sense_clarification": "British English"
                            },
                            {
                                "target_lang_word": "panty liner",
                                "target_lang_sense_clarification": "for daily use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a604a3-8bb8-38e2-9f5d-430759d7e28f",
                    "sense_definition": "Фиктивная организация, используемая для незаконного вывода денег или ухода от налогов.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "бизнес",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Следователи выяснили, что этот контракт был подписан через подставную <w>фирму-прокладку</w>.",
                            "target_lang_translations": {
                                "en": "Investigators found that this contract was signed through a <w>shell company</w>."
                            }
                        },
                        {
                            "text": "Эта <w>фирма-прокладка</w> использовалась исключительно для обналичивания бюджетных средств.",
                            "target_lang_translations": {
                                "en": "This <w>front company</w> was used exclusively for cashing out budget funds."
                            }
                        }
                    ],
                    "common_phrases": [
                        "фирма-прокладка"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "бизнес-жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A shell company or intermediary organization used for money laundering or tax evasion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shell company",
                                "target_lang_sense_clarification": "fictitious entity"
                            },
                            {
                                "target_lang_word": "intermediary",
                                "target_lang_sense_clarification": "middleman firm"
                            },
                            {
                                "target_lang_word": "front company",
                                "target_lang_sense_clarification": "for illegal activities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c53ea1c9-358a-3e00-bb92-5aa2a8ca668f",
                    "sense_definition": "Ироничное обозначение неопытного или глупого пользователя техники.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "сленг",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компьютер работает нормально, вся проблема в <w>прокладке</w> между стулом и клавиатурой.",
                            "target_lang_translations": {
                                "en": "The computer is working fine; the whole problem is the <w>user</w> between the chair and the keyboard."
                            }
                        },
                        {
                            "text": "Машина не заводится, видимо, виновата <w>прокладка</w> между рулем и сиденьем.",
                            "target_lang_translations": {
                                "en": "The car won't start; apparently, the <w>nut</w> behind the wheel is to blame."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прокладка между рулем"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "иронично"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An ironic slang term for an incompetent user, implying the problem is the person, not the machine."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "user error",
                                "target_lang_sense_clarification": "polite equivalent"
                            },
                            {
                                "target_lang_word": "loose nut",
                                "target_lang_sense_clarification": "slang for bad driver/user"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38423e98-a37e-32e1-ae71-e455c52155c5",
                    "sense_definition": "Ироничное или пренебрежительное название бело-красно-белого флага Беларуси или бело-сине-белого флага российской оппозиции.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "политика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В социальных сетях сторонники власти часто называют оппозиционный флаг словом <w>прокладка</w>.",
                            "target_lang_translations": {
                                "en": "On social media, government supporters often refer to the opposition flag as a <w>pad</w>."
                            }
                        },
                        {
                            "text": "На митинге была замечена очередная <w>прокладка</w>, которую несли протестующие.",
                            "target_lang_translations": {
                                "en": "Another <w>pad</w> was spotted at the rally, carried by the protesters."
                            }
                        }
                    ],
                    "synonyms": [
                        "БЧБ",
                        "БСБ",
                        "бе́ло-си́не-бе́лый"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "политический жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A derogatory political slang term for certain opposition flags, comparing their appearance to a sanitary pad."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pad",
                                "target_lang_sense_clarification": "derogatory political slang"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}