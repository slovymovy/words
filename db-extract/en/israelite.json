                "forms": [
                    {
                        "form_id": "8f005b09-9bf8-4931-9c6f-0c2d9e6b81d0",
                        "entry_id": "965bac67-f114-385f-8779-0969850c9aac",
                        "tags": [
                            "plural"
                        ],
                        "form": "Israelites"
