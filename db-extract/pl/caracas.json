                    {
                        "translation_id": "e78acbbf-83c9-4d91-8bf6-efd4136191b4",
                        "source_entry_id": "448d9cf6-fb65-3cad-aae9-30b1cc9aa9bd",
                        "source_sense_id": "b49fecda-bb9f-312c-ab4c-3c9b26fdbd5b",
                        "target_lang_word": "Caracas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caracas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60320ac2-bacf-3ea6-8170-2438c2c4176b",
                                        "entry_id": "952b51fc-2da6-3d14-addf-d96c96d56353",
                                        "glosses": [
                                            "Capitale du Venezuela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0830a0b8-adfe-41a0-a126-4978d66e3195",
                                                "sense_id": "60320ac2-bacf-3ea6-8170-2438c2c4176b",
                                                "text": "Je n’ai aucune envie de connaître l’hôpital, sans doute ultra-moderne, de Caracas !"
                                            },
                                            {
                                                "example_id": "eeea90a1-e99c-4982-b41f-698835a0363f",
                                                "sense_id": "60320ac2-bacf-3ea6-8170-2438c2c4176b",
                                                "text": "Le rapporteur belge en tire quelques tendances déjà connues de la Défense sociale, mais qui se sont trouvées soulignées au cours des travaux de Caracas : tendance à la déjuridicisation (le droit n’a de sens qu’en tant qu’instrument au service de l’action sociale), à la dédramatisation (la délinquance est un fait normal de la vie en collectivité, ce qu’oublient trop souvent les mass media), tendance à resocialiser (c’est-à-dire non seulement à passer du contrôle objectif de la déviance à une attitude de compréhension, d’accueil et de solidarité, mais encore à essayer d’atteindre, au-delà de l’individu à resocialiser, le micro-milieu auquel il appartient), tendance aussi à décriminologiser (la vérité anthropologique et sociale ne doit pas s’arrêter aux seuls individus connus de la police)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6bb57ff-16d8-3c5e-8117-4466adcdd3f7",
                                        "entry_id": "952b51fc-2da6-3d14-addf-d96c96d56353",
                                        "glosses": [
                                            "Gouvernement vénézuélien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f53de4e2-b12e-4de4-af4f-7534d2e352c2",
                                                "sense_id": "e6bb57ff-16d8-3c5e-8117-4466adcdd3f7",
                                                "text": "Caracas réclame la région de l’Essequibo, soit les deux tiers du Guyana et les eaux territoriales pleines de pétrole qui vont avec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
