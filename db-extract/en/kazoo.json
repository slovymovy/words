                                "target_senses": [
                                    {
                                        "sense_id": "9d7d0817-f4f3-3f5d-a603-477effad0d4c",
                                        "entry_id": "2e950a12-2fd2-32b0-8654-5d465c11c447",
                                        "glosses": [
                                            "eenvoudig, klein blaasinstrument waarbij men langs een membraan blaast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e461bcb4-f060-4151-ab08-e301e39b21c0",
                                                "sense_id": "9d7d0817-f4f3-3f5d-a603-477effad0d4c",
                                                "text": "Een lokale kunstenaar had speciaal voor het festival een aantal nieuwe instrumenten ontwikkeld zoals een clambourine en wahoo kazoo. Door speakers aan de onderkant van verschillende boten te bevestigen was de muziek onderwater te horen."
                                            },
                                            {
                                                "example_id": "152cab49-1a2e-47b8-9e0b-348696dcd13b",
                                                "sense_id": "9d7d0817-f4f3-3f5d-a603-477effad0d4c",
                                                "text": "Koop een kazoo en toeter mee tegen de babysterfte. Die oproep doet Mino Leotta in de binnenstad van Enschede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9fb388c-0777-464d-ab03-5445767a44b7",
                        "source_entry_id": "c53d1d53-b8fd-3afd-9540-0e2ef3135e04",
                        "source_sense_id": "87441735-c99d-3a4b-81bd-622b8ae36eb4",
                        "source_sense_description": "a simple musical instrument consisting of a pipe with a hole in it",
                        "target_lang_word": "kazou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72b25979-188f-36e4-aed0-b47e80f19ace",
                                        "entry_id": "03d38111-884d-38a9-9d35-0b8d90726c21",
                                        "glosses": [
                                            "Variante de kazoo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e463e439-55b9-45e9-bd78-a08dea537cb3",
                                                "sense_id": "72b25979-188f-36e4-aed0-b47e80f19ace",
                                                "text": "Pour fabriquer un kazou version musique verte, autrement dit un mirliton, procurez vous un tube creux de votre choix : renouée du Japon, branchette de sureau évidée…"
                                            },
                                            {
                                                "example_id": "8fa9fb6f-395a-4e5e-bb24-eb6569ab3034",
                                                "sense_id": "72b25979-188f-36e4-aed0-b47e80f19ace",
                                                "text": "Un ancien comédien du Français marginalisé par un sida mal stabilisé se contentait de faire désormais du bruitage de dessins animés avec une pince à linge sur le nez et un kazou entre les lèvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3852335-acf1-43f4-b832-e6c48f112ef0",
                        "source_entry_id": "c53d1d53-b8fd-3afd-9540-0e2ef3135e04",
                        "source_sense_id": "87441735-c99d-3a4b-81bd-622b8ae36eb4",
                        "source_sense_description": "a simple musical instrument consisting of a pipe with a hole in it",
                        "target_lang_word": "gazou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazou",
