                                ]
                            },
                            {
                                "target_word": "bronzé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea20708c-1da5-3299-8e8d-b3b824e22e67",
                                        "entry_id": "854ffea3-b816-39c5-b419-d13042e971bd",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe bronzer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b647fc8f-5718-48f9-ad6d-ca0c99e331be",
                                                "sense_id": "ea20708c-1da5-3299-8e8d-b3b824e22e67",
                                                "text": "Elle rayonne d’un mystérieux bonheur, et dans son petit visage bronzé par l’été, ses yeux verts semblent deux péridots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82d8e232-1003-4c8d-b12d-859deb6cc439",
