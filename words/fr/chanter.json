                {
                    "sense_id": "1765d55e-2fb1-3a24-8b27-48416450d03e",
                    "sense_definition": "Dénoncer ses complices ou avouer ce que l'on sait, souvent sous la pression (argot).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par <w>chanter</w> devant les policiers et il a donné tous les noms."
                        },
                        {
                            "text": "Même sous la pression, il refusait de <w>chanter</w>."
                        }
