                "senses": [
                    {
                        "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                        "entry_id": "5a6ff7d7-c1fd-3cc5-8659-671106f99a9c",
                        "glosses": [
                            "Anspannungsphase vor den Abiturprüfungen, in der man sich noch möglichst viel Wissen anzueignen versucht"
                        ],
                        "tags": [
                            "Kurzform für Abiturstress"
                        ],
                        "examples": [
                            {
                                "example_id": "02d5ff88-3b3e-4633-a1ca-13608af4f7dd",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Daniela steckte mitten im Abistress und versuchte voller Panik, die Formeln für Mathematik auswendig zu lernen."
                            },
                            {
                                "example_id": "1a8a00e1-5cc2-435b-b6d1-52682b78ff9b",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Gelassen blickt Annemarie Wiesse dem Abistress nächste Woche entgegen."
                            },
                            {
                                "example_id": "25d99630-681f-4791-8fc8-b3be7f34de09",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Dem Abistress zum Trotze hätten viele Schüler beim diesjährigen Theaterstück mitgewirkt und das Schülerkonzert tatkräftig unterstützt."
                            },
                            {
                                "example_id": "741664a1-2a6d-4dfc-86f6-acad706e6ed8",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Sind es Zeitprobleme wegen des bevorstehenden Abistresses in der Oberstufe, kommt der Faktor Nebenjob vor allem in der Mittelstufe zum Tragen."
                            },
                            {
                                "example_id": "559f18e1-9e79-4fd9-bc96-2d58585d3c38",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Die einen stecken bereits mitten im dicksten Abistress, haben aber noch überhaupt keinen Plan, wie es danach weitergeht, den anderen scheint das Ende ihrer Schulzeit noch Lichtjahre entfernt."
                            },
                            {
                                "example_id": "53ef4d79-3314-49ba-a973-16cd1e6cb408",
                                "sense_id": "442becf6-0eba-3dec-83e2-68df0d5dd02d",
                                "text": "Nach einer langwierigen Virus-Infektion und dem Abistress hatte Hannah Stockbauer im August bei der EM in Berlin »nur« eine Goldmedaille in der 4x200m-Staffel und Bronze über 800m Freistil geholt."
                            }
                        ],
