                ],
                "senses": [
                    {
                        "sense_id": "acc702a6-cd5f-3917-a5cf-edfd8c6424c3",
                        "entry_id": "229edc27-9238-337c-91f1-afa08e4162b1",
                        "glosses": [
                            "прост. такой, который вихляет, двигается нетвёрдой походкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a91720-df2b-4806-b633-5a83bc968eba",
                                "sense_id": "acc702a6-cd5f-3917-a5cf-edfd8c6424c3",
                                "text": "Адъютант батальона был высокий вихлявый парень с торчащими усиками, из тех, что, как назло, не растут, хоть поливай их утром и вечером."
                            }
                        ]
                    },
                    {
                        "sense_id": "e40cb5b1-cb23-3f1c-8de8-7e0d36b90829",
                        "entry_id": "229edc27-9238-337c-91f1-afa08e4162b1",
                        "glosses": [
                            "прост. неустойчивый, покачивающийся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba2928e-1690-4a6f-b7cf-4a99f3a5bb3c",
                                "sense_id": "e40cb5b1-cb23-3f1c-8de8-7e0d36b90829",
                                "text": "Трофим спрыгнул на вихлявую палубу катерка…"
                            }
                        ]
                    },
                    {
                        "sense_id": "aac8c26f-da07-3692-8222-0d107e5523cc",
                        "entry_id": "229edc27-9238-337c-91f1-afa08e4162b1",
                        "glosses": [
                            "прост. извилистый (о тропе, дороге)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa60a01-0989-4f09-b845-b9bd5ca5a842",
                                "sense_id": "aac8c26f-da07-3692-8222-0d107e5523cc",
                                "text": "Каурый повернул в сторону речного шума умную морду, стал осторожно взбираться по вихлявой дороге."
                            }
                        ]
                    }
