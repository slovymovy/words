    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7186578e-f25f-3c0f-9a76-c234f03d0ab4",
                    "sense_definition": "To bend the body low to the ground with legs bent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>crouched</w> low in the grass while watching the bird.",
                            "target_lang_translations": {
                                "cs": "Kočka se <w>přikrčila</w> nízko v trávě, zatímco pozorovala ptáka.",
                                "ru": "Кошка <w>присела</w> низко в траве, наблюдая за птицей.",
                                "nl": "De kat <w>hurkte</w> laag in het gras terwijl hij naar de vogel keek."
                            }
                        },
                        {
                            "text": "We <w>crouched</w> behind the wall to avoid being seen by the guards.",
                            "target_lang_translations": {
                                "cs": "Aby nás stráže neviděly, <w>přikrčili</w> jsme se za zdí.",
                                "ru": "Мы <w>присели</w> за стеной, чтобы нас не заметила охрана.",
                                "nl": "We <w>hurkten</w> achter de muur om niet gezien te worden door de bewakers."
                            }
                        }
                    ],
                    "synonyms": [
                        "squat",
                        "stoop"
                    ],
                    "common_phrases": [
                        "crouch down"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrčit se, přikrčit se nebo se schoulit nízko k zemi.",
                        "ru": "Принять положение, при котором тело согнуто в коленях и опущено низко к земле.",
                        "nl": "Het lichaam laag bij de grond buigen met gebogen benen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přikrčit se",
                                "target_lang_sense_clarification": "obecný výraz pro snížení postavy pokrčením nohou"
                            },
                            {
                                "target_lang_word": "dřepnout si",
                                "target_lang_sense_clarification": "přijetí pozice v dřepu"
                            },
                            {
                                "target_lang_word": "schoulit se",
                                "target_lang_sense_clarification": "pokrčení těla, často kvůli strachu nebo chladu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "присесть",
                                "target_lang_sense_clarification": "опуститься, согнув ноги в коленях"
                            },
                            {
                                "target_lang_word": "приседать",
                                "target_lang_sense_clarification": "сгибая колени, опускаться или принимать положение на корточках"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "hurken",
                                "target_lang_sense_clarification": "door de knieën zakken en laag bij de grond zitten"
                            },
                            {
                                "target_lang_word": "zich bukken",
                                "target_lang_sense_clarification": "het lichaam naar voren of beneden buigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c88714f-a66c-31bd-9fad-b5aac4f03387",
                    "sense_definition": "To bow or bend in a servile or submissive manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The advisor refused to <w>crouch</w> before the corrupt king.",
                            "target_lang_translations": {
                                "cs": "Poradce odmítl <w>poníženě se sklonit</w> před zkorumpovaným králem.",
                                "ru": "Советник отказался <w>пресмыкаться</w> перед коррумпированным королем.",
                                "nl": "De adviseur weigerde te <w>kruipen</w> voor de corrupte koning."
                            }
                        },
                        {
                            "text": "He would not <w>crouch</w> to the demands of his cruel master.",
                            "target_lang_translations": {
                                "cs": "Nechtěl <w>poklonkovat</w> požadavkům svého krutého pána.",
                                "ru": "Он не стал <w>раболепствовать</w> перед требованиями своего жестокого хозяина.",
                                "nl": "Hij wilde niet <w>kruipen</w> voor de eisen van zijn wrede meester."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokorně se sklonit nebo podrobit něčí autoritě.",
                        "ru": "Покорно склониться или унизиться перед чьей-либо властью.",
                        "nl": "Zich onderdanig of nederig opstellen tegenover iemand met autoriteit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poníženě se sklonit",
                                "target_lang_sense_clarification": "vyjádření podřízenosti"
                            },
                            {
                                "target_lang_word": "poklonkovat",
                                "target_lang_sense_clarification": "servilní chování vůči někomu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пресмыкаться",
                                "target_lang_sense_clarification": "раболепно преклоняться, угодничать, унижаться"
                            },
                            {
                                "target_lang_word": "раболепствовать",
                                "target_lang_sense_clarification": "проявлять раболепие, вести себя угодливо"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kruipen",
                                "target_lang_sense_clarification": "zich onderdanig gedragen"
                            },
                            {
                                "target_lang_word": "zich nederig opstellen",
                                "target_lang_sense_clarification": "een onderdanige houding aannemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c4fc159-0469-3376-bf49-0c9f8e0480a4",
                    "sense_definition": "To make the sign of the cross.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk would <w>crouch</w> before entering the sacred chapel.",
                            "target_lang_translations": {
                                "cs": "Mnich se před vstupem do posvátné kaple <w>pokřižoval</w>.",
                                "ru": "Монах <w>перекрестился</w> перед входом в священную часовню.",
                                "nl": "De monnik <w>maakte een kruisteken</w> voordat hij de heilige kapel binnenging."
                            }
                        },
                        {
                            "text": "She <w>crouched</w> herself as she passed the altar.",
                            "target_lang_translations": {
                                "cs": "Když procházela kolem oltáře, <w>pokřižovala</w> se.",
                                "ru": "Она <w>перекрестилась</w>, проходя мимо алтаря.",
                                "nl": "Ze <w>maakte een kruisteken</w> terwijl ze langs het altaar liep."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an old usage of the word."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit znamení kříže (zastaralé).",
                        "ru": "Осенить себя крестным знамением (устар.).",
                        "nl": "Het kruisteken maken (verouderd)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokřižovat se",
                                "target_lang_sense_clarification": "náboženské gesto"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перекреститься",
                                "target_lang_sense_clarification": "совершить религиозный жест"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "een kruisteken maken",
                                "target_lang_sense_clarification": "religieus gebaar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67156eb2-fd01-356c-a05d-5bc3c97d3c8c",
                    "sense_definition": "A position where the body is bent or stooped low.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner started from a low <w>crouch</w>.",
                            "target_lang_translations": {
                                "cs": "Běžec startoval z nízké <w>přikrčené polohy</w>.",
                                "ru": "Бегун стартовал из низкого <w>приседа</w>.",
                                "nl": "De hardloper startte vanuit een lage <w>hurkhouding</w>."
                            }
                        },
                        {
                            "text": "He stayed in a <w>crouch</w> to keep his balance on the slippery ice.",
                            "target_lang_translations": {
                                "cs": "Zůstal v <w>přikrčené poloze</w>, aby udržel rovnováhu na kluzkém ledu.",
                                "ru": "Он оставался в <w>приседе</w>, чтобы удержать равновесие на скользком льду.",
                                "nl": "Hij bleef in een <w>hurkhouding</w> om zijn evenwicht te bewaren op het gladde ijs."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pozice, při které je tělo pokrčené nebo nízko u země.",
                        "ru": "Положение тела, при котором оно согнуто или находится низко у земли.",
                        "nl": "Een houding waarbij het lichaam gebogen of laag bij de grond is."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přikrčená poloha",
                                "target_lang_sense_clarification": "fyzický postoj"
                            },
                            {
                                "target_lang_word": "dřep",
                                "target_lang_sense_clarification": "pozice v dřepu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "поза на корточках",
                                "target_lang_sense_clarification": "физическое положение тела"
                            },
                            {
                                "target_lang_word": "присед",
                                "target_lang_sense_clarification": "положение в приседе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "hurkhouding",
                                "target_lang_sense_clarification": "fysieke positie waarbij men op de hurken zit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3792276d-f37e-36b8-a371-347483cb6322",
                    "sense_definition": "A cross.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight wore a <w>crouch</w> upon his shield.",
                            "target_lang_translations": {
                                "cs": "Rytíř měl na svém štítu vyobrazený <w>kříž</w>.",
                                "ru": "Рыцарь носил <w>крест</w> на своем щите.",
                                "nl": "De ridder droeg een <w>kruis</w> op zijn schild."
                            }
                        },
                        {
                            "text": "They carved a small <w>crouch</w> into the wooden door.",
                            "target_lang_translations": {
                                "cs": "Do dřevěných dveří vyřezali malý <w>kříž</w>.",
                                "ru": "Они вырезали маленький <w>крест</w> на деревянной двери.",
                                "nl": "Ze kerfden een klein <w>kruis</w> in de houten deur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an obsolete meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kříž (zastaralé).",
                        "ru": "Крест (устар.).",
                        "nl": "Een kruis (verouderd)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kříž",
                                "target_lang_sense_clarification": "náboženský symbol"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "религиозный символ"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kruis",
                                "target_lang_sense_clarification": "religieus symbool"
                            }
                        ]
                    }
                }
            ]
