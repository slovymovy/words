                                                "example_id": "3f75d8d7-3195-419d-b4cd-5990bc94e4d4",
                                                "sense_id": "9caf060d-68c2-3aea-88ca-016d7e02153d",
                                                "text": "Żona pana Piotra powiadomiła go o wygranej na loterii."
                                            },
