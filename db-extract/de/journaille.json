                "senses": [
                    {
                        "sense_id": "fdca0b7d-51f6-394c-a0b3-d772cda326cf",
                        "entry_id": "1bc07ed1-0925-3f3b-bb90-69db1a95cdb2",
                        "glosses": [
                            "sensationalist press, gutter press, or (by extension) any media whose methods one disagrees with"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d73f9d70-5489-4b7c-9345-c1707df3fde0",
                                "sense_id": "fdca0b7d-51f6-394c-a0b3-d772cda326cf",
                                "text": "Ich kann mir schon denken, was die Journaille morgen wieder schreiben wird.",
                                "translation": "I can already imagine what the gutter press will be writing again tomorrow.",
                                "english": "I can already imagine what the gutter press will be writing again tomorrow."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c0e28b0-05bf-3c74-898a-6a1d83ac6638",
                        "entry_id": "1bc07ed1-0925-3f3b-bb90-69db1a95cdb2",
                        "glosses": [
                            "journalists of this kind collectively"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8f9aa64-764d-45d0-ad14-57b0032f7ff8",
                                "sense_id": "4c0e28b0-05bf-3c74-898a-6a1d83ac6638",
                                "text": "Als wir rauskamen, stand die Journaille natürlich schon vorm Tor.",
                                "translation": "When we came out, the gutter press were already waiting in front of the gate, of course.",
                                "english": "When we came out, the gutter press were already waiting in front of the gate, of course."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3fc78c7-085e-37eb-b3ea-8253d14086b4",
                        "entry_id": "1bc07ed1-0925-3f3b-bb90-69db1a95cdb2",
                        "glosses": [
                            "a publication of this kind"
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "feminine",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "af66cb42-132f-4e4b-bd33-27f512cdd11c",
                                "sense_id": "c3fc78c7-085e-37eb-b3ea-8253d14086b4",
                                "text": "Die verschiendenen Journaillen überbieten sich wieder in Angstparolen.",
                                "translation": "The different gutter newspapers are rivalling each other in fear-mongering again.",
                                "english": "The different gutter newspapers are rivalling each other in fear-mongering again."
                            }
                        ]
                    }
