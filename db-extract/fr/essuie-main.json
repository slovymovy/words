                "translations": [
                    {
                        "translation_id": "21bfadaa-e98a-45a0-991d-876cd9ba04b1",
                        "source_entry_id": "b5a46ac6-4b13-3371-9610-40a235fbaf49",
                        "source_sense_id": "11f7c78f-7bb7-300c-ae08-43fd69f3d796",
                        "target_lang_word": "Handtuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handtuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                        "entry_id": "fbe318bc-757d-34df-a4ef-a48393f5cc8b",
                                        "glosses": [
                                            "ein Stück Stoff, das zum Trockenreiben dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67792f24-178e-4c84-abbf-54334e4496d2",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "Er nahm ein sauberes Handtuch aus dem Schrank."
                                            },
                                            {
                                                "example_id": "07c4cd5a-2096-41e0-aa33-5ee05ee68a7e",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "Sie trocknete mit dem Handtuch das Geschirr ab."
                                            },
                                            {
                                                "example_id": "95f0e17f-1ff2-419b-abdb-e7788d5195c5",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "„Gee wickelte das höchste Paar Schuhe, das sie besaß, in ein verschlissenes Handtuch und steckte es in ihre Strandtasche.“"
                                            },
                                            {
                                                "example_id": "1bf2021c-d29e-405e-a050-4547260643ed",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "„Vom schnellen Aufstehen war ihm schwindelig geworden, und die bunten Stoffe der Handtücher tanzten vor seinen Augen.“"
                                            },
                                            {
                                                "example_id": "7c3c4128-d449-469b-a0f9-1cfaa829d23e",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "„Ich legte mein Handtuch einen Meter neben Barbaras.“"
                                            },
                                            {
                                                "example_id": "3e5030cd-4908-4349-9b49-31a901e5db42",
                                                "sense_id": "4a001067-d3a3-32af-9684-54076a2188a9",
                                                "text": "„Er ging fort und rieb sich den Kopf mit dem Handtuch trocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
