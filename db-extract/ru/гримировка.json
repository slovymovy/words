                    {
                        "translation_id": "7f4bf282-4843-453b-8072-f5e9b8dcb8da",
                        "source_entry_id": "24995585-45f1-3d8e-b167-5ec0e223f181",
                        "source_sense_id": "78101be1-0ad5-352d-ad23-ecfeaea0bfc2",
                        "target_lang_word": "makeup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "makeup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3a9091-58c5-3996-bf12-ce86f67d188d",
                                        "entry_id": "06c2e258-0c53-39eb-ab62-16997e5bd9d2",
                                        "glosses": [
                                            "An item's composition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958095fc-09ec-45a8-a363-197dd49c4de9",
                                                "sense_id": "ed3a9091-58c5-3996-bf12-ce86f67d188d",
                                                "text": "To understand how a nuclear reactor works, we must first look at its makeup."
                                            },
                                            {
                                                "example_id": "9cc64a56-c175-4918-8191-5e96e0588129",
                                                "sense_id": "ed3a9091-58c5-3996-bf12-ce86f67d188d",
                                                "text": "After the size and makeup of Congress was decided by the Founding Fathers, it was time to lawmake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa15c2f3-75a8-361c-9d22-0b6ac3d28d3e",
                                        "entry_id": "06c2e258-0c53-39eb-ab62-16997e5bd9d2",
                                        "glosses": [
                                            "Cosmetics; colorants and other substances applied to the skin to alter its appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bbbdbab-8090-4eb3-b769-713b42859178",
                                                "sense_id": "aa15c2f3-75a8-361c-9d22-0b6ac3d28d3e",
                                                "text": "She is wearing a lot of makeup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27441c86-dc5f-357c-bcaa-e7882f276f2f",
                                        "entry_id": "06c2e258-0c53-39eb-ab62-16997e5bd9d2",
                                        "glosses": [
                                            "Replacement; material used to make up for the amount that has been used up."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99285435-681d-4ae1-8ecd-db76d426dc76",
                                                "sense_id": "27441c86-dc5f-357c-bcaa-e7882f276f2f",
                                                "text": "When the water level drops, the float ball drops with it and opens the valve to the makeup water supply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ee26a2-73ba-3aa5-91a6-49a72ef98907",
                                        "entry_id": "06c2e258-0c53-39eb-ab62-16997e5bd9d2",
                                        "glosses": [
                                            "A test given to students allowing them to repeat failed material."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f7f7b2-327f-4bbb-9e0c-03df828e7b7b",
                                                "sense_id": "79ee26a2-73ba-3aa5-91a6-49a72ef98907",
                                                "text": "“Will I get a chance to take a makeup? My mother paid for the exam.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14581769-d770-3642-b63f-d91b65c1fd1a",
                                        "entry_id": "06c2e258-0c53-39eb-ab62-16997e5bd9d2",
                                        "glosses": [
                                            "In a NIMCRUT, an amount distributed from the trust's income in subsequent years to make up for a present shortfall."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "makeup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                        "entry_id": "aaf68dd6-4f4e-3f77-b2db-1e63ec2bbdcf",
                                        "glosses": [
                                            "Alternative form of make up (“(ambitransitive) to put makeup on (someone or something)”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad0a3bc3-dfdb-44d5-8745-4a102128ee41",
                                                "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                                "text": "I raided my closet and left Clay in my living room while I changed and makeuped in the bathroom."
                                            },
                                            {
                                                "example_id": "12130fd1-e99e-40dc-80ce-27ffe8e9977a",
                                                "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                                "text": "“If we get started showering, shaving, powdering, combing, and makeupping, we just may be able to make the eleven o’clock mass at Regina Pacis.”"
                                            },
                                            {
                                                "example_id": "dbed1c07-a1ab-4507-9fa5-1692f0177fe1",
                                                "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                                "text": "This isn’t about plastic surgery, image management, or makeupping the facade."
                                            },
                                            {
                                                "example_id": "e9f8aef4-0d00-4c93-a00b-bc19619e32e2",
                                                "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                                "text": "And when my guests and I got bored with stuffing our mouths, makeupping our faces, and rotting our brains, we had Bethany’s collection of classic teen comedies all queued up and ready to roll."
                                            },
                                            {
                                                "example_id": "26cfe6ed-2778-45ca-9c46-75692489d62a",
                                                "sense_id": "47c5f0e5-63d4-39d4-871c-cc5e1ecbc462",
                                                "text": "When Gracie emerges from her labor-intensive makeover in an airplane hangar—where she has been plucked, waxed, styled, makeuped, and dressed by an army of professionals—all eyes, including the stunned eyes of her love-interest-to-be Eric, are on her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f45343cc-17f4-4625-8444-a3cdf87cbc60",
                        "source_entry_id": "24995585-45f1-3d8e-b167-5ec0e223f181",
                        "source_sense_id": "78101be1-0ad5-352d-ad23-ecfeaea0bfc2",
                        "target_lang_word": "maquillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maquillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7158db-01e0-3e85-8a44-15ec71da6baa",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Action de (se) maquiller le visage."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5705dc9e-e840-4709-9134-b92c35e5542c",
                                                "sense_id": "5f7158db-01e0-3e85-8a44-15ec71da6baa",
                                                "text": "Il lui fallut deux fois plus de temps pour faire son maquillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d673cfe-5a3a-403d-bc57-de1e98d8aea6",
                                                "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                                "text": "Par son travail sur les costumes, Sophie Desmarais a mis en évidence les contrastes entre MTS [Marie-Stella, ainsi surnommée par ses camarades de classe] et Marie-Clown. Cheveux gaufrés, vêtements amples couleur saumon et bas de nylon donnent à la première une allure de gamine venue tout droit des années 80. À l’opposé, la seconde est clairement de son temps : jupe courte, chandail bedaine, bracelets clinquants, gomme à mâcher, maquillage, espadrilles. Toutes deux paraissent pourtant déguisées : pas encore adultes, encore un peu enfants."
                                            },
                                            {
                                                "example_id": "d21c958f-fe85-4412-945f-ad1a57a8b3fb",
                                                "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                                "text": "Oui, le timide n’a jamais osé danser, du coup, il a eu le temps d’affûter son sens de la répartie pendant que ses petits camarades galochaient des nanas au look douteux et au maquillage ringard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Action de dissimuler, de déformer une réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1eb8d23-2b17-4dd7-9bc9-7de8cbf18bce",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "J’en reviens à ma thèse : maquillage, mise en scène fictive, combinaison bizarre, trucs extraordinaires, imaginés dans le seul but de détourner l’attention, créés dans l’intention de faire croire à un crime, alors qu’il n’y en a pas."
                                            },
                                            {
                                                "example_id": "5586704e-3eac-448b-b685-d2ad90825b8c",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "– Savez-vous ce qui me gâte l’écriture ? Ce sont les corrections, les ratures, les maquillages qu’on y fait."
                                            },
                                            {
                                                "example_id": "d63a3584-d7fd-45bf-9a71-c188572acf19",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "Le troisième point semblait discréditer l’hypothèse d’un maquillage de voiture volée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b67137c-ec0f-33e5-ba74-424d10b675e4",
