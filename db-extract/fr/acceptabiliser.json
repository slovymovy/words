                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce7b86b-a124-49ea-b7e7-6647f4166c13",
                                "sense_id": "37d12fdc-a73f-3c28-a7c4-3bd38f1d84e5",
                                "text": "Je crois qu'elle se sert un peu de cette CMJ pour \"acceptabiliser\" le Fieldturf."
                            },
                            {
                                "example_id": "472a8874-402d-4638-8389-9cde2c02ae1b",
                                "sense_id": "37d12fdc-a73f-3c28-a7c4-3bd38f1d84e5",
                                "text": "Cette opération de respectabilité que l'auteur de l'article est entrain^([sic]) de mener pour acceptabiliser la fille de son père est comme du fil blanc brodé sur le noir."
                            },
                            {
                                "example_id": "c7421c14-1d3e-416e-9c11-732376310989",
                                "sense_id": "37d12fdc-a73f-3c28-a7c4-3bd38f1d84e5",
                                "text": "J'en ai marre de tous ceux qui s'amusent à \"acceptabiliser\" le massacre d'espèces en voie de disparition et dire qu'elles ont atteint leur *** de sac évolutionniste."
                            }
                        ]
                    }
