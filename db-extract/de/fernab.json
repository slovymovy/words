                                "target_senses": [
                                    {
                                        "sense_id": "ce11c60a-7436-3252-90f0-4d38d02e9cb9",
                                        "entry_id": "14b105f0-0664-3e22-ba73-bb0973ac2aa2",
                                        "glosses": [
                                            "distante"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a20f1d8-f9cf-3112-8d22-587f17037e48",
                                        "entry_id": "14b105f0-0664-3e22-ba73-bb0973ac2aa2",
                                        "glosses": [
                                            "longínquo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ecb1a8-3b3d-4383-8492-dacba7b63ac0",
                                                "sense_id": "7a20f1d8-f9cf-3112-8d22-587f17037e48",
                                                "text": "Nunca mais voltarei àquelas longes paragens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "longe",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "d65ca05b-a284-3971-88d7-3597d7b3a327",
                                        "entry_id": "30b3a98d-3f4a-3d88-af80-a73d1f8c79ab",
                                        "glosses": [
                                            "distante"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06f1f0f3-3214-38b7-b1ec-d2e83a565483",
                                        "entry_id": "30b3a98d-3f4a-3d88-af80-a73d1f8c79ab",
                                        "glosses": [
                                            "a grande distância"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc1a3d1-ad2b-461e-b29d-2c50c1fb0c0e",
                                                "sense_id": "06f1f0f3-3214-38b7-b1ec-d2e83a565483",
                                                "text": "Ela já estava longe quando a chamei de volta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b54069-5abd-4044-a2cb-7edb114f6d85",
                        "source_entry_id": "95c1b8df-76d5-3b24-9028-8a4f6e53a606",
                        "source_sense_id": "f8455f17-fccd-3900-bdf8-8b007e6b08a6",
                        "source_sense_description": "weit entfernt",
                        "target_lang_word": "далеко́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "далеко́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa990be-eb46-38f6-a248-8c4077e168ac",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "на большом расстоянии либо на большое расстояние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24ef70e-ddb0-43a8-9cea-70b0269f53b8",
                                                "sense_id": "3aa990be-eb46-38f6-a248-8c4077e168ac",
                                                "text": "Спешите, он не мог далеко уйти!"
                                            },
                                            {
                                                "example_id": "ae9cba2a-49f0-44d6-90e4-a571269f395a",
                                                "sense_id": "3aa990be-eb46-38f6-a248-8c4077e168ac",
                                                "text": "Чуть заметная равнодушная усмешка почему-то тронула губы Ивана, и он ответил: — Я был далеко. — А этот клетчатый был возле самого турникета?"
                                            },
                                            {
                                                "example_id": "116fb71d-9345-45a2-ae84-1a9fc048dc48",
                                                "sense_id": "3aa990be-eb46-38f6-a248-8c4077e168ac",
                                                "text": "Притворство мне неизвестно, я воспитана далеко отсюда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171642e7-939d-3a3b-b050-b85f2dc1c558",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "предик. о далёком расстоянии до кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "382ccd22-6ba3-4f91-89d6-fd59738b673c",
                                                "sense_id": "171642e7-939d-3a3b-b050-b85f2dc1c558",
                                                "text": "Это очень далеко отсюда."
                                            },
                                            {
                                                "example_id": "01cf1e67-d9b5-46b0-8930-529dc498e1df",
                                                "sense_id": "171642e7-939d-3a3b-b050-b85f2dc1c558",
                                                "text": "Но что сделает робкая невинность, когда ядовитая и мощная злоба будет извергать на неё свои пламенные грозы: тогда ей остаётся или погибнуть, или спасаться бегством; до бога высоко, до царя далеко!"
                                            },
                                            {
                                                "example_id": "f5737311-c03f-43e7-a663-26fc344a43ab",
                                                "sense_id": "171642e7-939d-3a3b-b050-b85f2dc1c558",
                                                "text": "Впрочем, даже в этом случае до демографической катастрофы будет ещё далеко."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "237dfb58-e6ba-3b90-8264-dd4f2303fb64",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "перен. в значительной степени; намного, очень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0722e739-e396-4f88-b83c-5e9937b35589",
                                                "sense_id": "237dfb58-e6ba-3b90-8264-dd4f2303fb64",
                                                "text": "И в кулинарных его интерпретациях норвежцы далеко впереди."
                                            },
                                            {
                                                "example_id": "b195bcf1-8a54-4625-883d-05a5b0421515",
                                                "sense_id": "237dfb58-e6ba-3b90-8264-dd4f2303fb64",
                                                "text": "Конечно, далеко не всем подойдёт самостоятельная сборка серверов на базе Itanium 2."
                                            },
                                            {
                                                "example_id": "4f00044b-b0fd-428c-b462-9fd91b895fb0",
                                                "sense_id": "237dfb58-e6ba-3b90-8264-dd4f2303fb64",
                                                "text": "Днём в гостинице всегда было тихо, но жизнь закипала по вечерам, и далеко за полночь окна гостиницы светились огнями: тёмные сибирские человеки играли в карты, кутили на чужие деньги и весело хороводились с подозрительными женщинами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c586e9d-0a74-3c21-a80a-acbb27e6564c",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "существенно раньше чего-либо (обычно в сочетании с предлогами: до, за)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23c4f90-7f5e-4c0c-9d4f-ca539ba326d8",
                                                "sense_id": "2c586e9d-0a74-3c21-a80a-acbb27e6564c",
                                                "text": "Точно так же, как и покойная мать, Настя вставала далеко до солнца, в предрассветный час, по трубе пастуха."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c047c47-2ed9-304e-9f84-112ca245e84c",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "задолго до наступления чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16adf85f-b3d5-45a3-b25b-d04d2040ab8a",
                                                "sense_id": "3c047c47-2ed9-304e-9f84-112ca245e84c",
                                                "text": "Однако пока ещё далеко до раскрытия нейрокода, который бы позволял интерпретировать мысли испытуемого по его электрофизиологическим «паттернам» — узорам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df633e9-61de-3f2e-bfbd-67db33a56d4b",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "предик. оценочная характеристика расстояния до чего-либо как значительного, большого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6657823c-5b6c-43bb-b636-9668373ada17",
                                                "sense_id": "6df633e9-61de-3f2e-bfbd-67db33a56d4b",
                                                "text": "Ещё далеко до массовых беспорядков, но настрой…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea039a0b-9a53-36bf-9fed-247cc43388f9",
                                        "entry_id": "b3b64256-3f1d-3992-80f3-bd7b2ae56651",
                                        "glosses": [
                                            "предик. оценочная характеристика возможностей или качеств кого-либо или чего-либо как значительно уступающих возможностям или качествам того, с кем или с чем сравниваются"
                                        ],
                                        "tags": [],
                                        "examples": [
