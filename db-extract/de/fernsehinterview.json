                "senses": [
                    {
                        "sense_id": "528f53be-863a-3594-a203-88784e64064e",
                        "entry_id": "3e214100-6f07-3979-aeb2-e074826c1406",
                        "glosses": [
                            "Interview, das für eine Ausstrahlung im Fernsehen durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428c865c-da24-4130-ba41-342628de582c",
                                "sense_id": "528f53be-863a-3594-a203-88784e64064e",
                                "text": "„Wenn dann die Hilfsbereiten auch noch politisch vereinnahmt werden, wie zum Beispiel durch den Vizekanzler, der in einem Fernsehinterview behauptet hatte, die Regierung hätte diese Menschen \"erfolgreich mobilisieren können\", wirft das Fragen über die Motive der politischen Verantwortlichen auf.“"
                            },
                            {
                                "example_id": "2f5f7fae-88f2-48bf-8ce2-490c1e430087",
                                "sense_id": "528f53be-863a-3594-a203-88784e64064e",
                                "text": "„Auch Fernsehinterviews werden in der Regel zusammengeschnitten – es sei denn, es handelt sich um ein ausführliches Studiogespräch.“"
                            },
                            {
                                "example_id": "b2672739-dc69-4b65-b0ae-f1f94eb591df",
                                "sense_id": "528f53be-863a-3594-a203-88784e64064e",
                                "text": "„Ihre zurückhaltende Art hat sie kürzlich in einem Fernsehinterview verteidigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
