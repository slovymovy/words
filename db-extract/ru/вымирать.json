                "senses": [
                    {
                        "sense_id": "bb1fbb6a-b7ba-3ebc-9b8d-775c129fe372",
                        "entry_id": "705f6fd8-1b50-3fd9-8fb9-3b5a10807d85",
                        "glosses": [
                            "исчезать вследствие массовой смерти, гибели"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf61561b-d89d-3aad-9686-13cb3ae84df2",
                        "entry_id": "705f6fd8-1b50-3fd9-8fb9-3b5a10807d85",
                        "glosses": [
                            "пустеть вследствие массовой смерти, гибели обитателей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f416e86-e2fe-4b40-a443-cb22d53d4c74",
                                "sense_id": "cf61561b-d89d-3aad-9686-13cb3ae84df2",
                                "text": "Смолоду я объехал и обошел все деревни на Каргополье, они вымирали."
                            },
                            {
                                "example_id": "677592bd-59f2-4c60-b333-537ec4225a89",
                                "sense_id": "cf61561b-d89d-3aad-9686-13cb3ae84df2",
                                "text": "И вымирает Россия по два миллиона в год."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ddbd502-dc8b-313d-b05e-f0c8b648f9ef",
                        "entry_id": "705f6fd8-1b50-3fd9-8fb9-3b5a10807d85",
                        "glosses": [
                            "перен. то же, что пустеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6257cb4-8239-472a-b482-2ba25675067e",
                                "sense_id": "3ddbd502-dc8b-313d-b05e-f0c8b648f9ef",
                                "text": "Невольно вспомнилась Вена или Зальцбург — там уже в девять вечера улицы вымирали, негде было не то что поужинать — чашку кофе выпить."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf4a5b84-254b-43c9-8e73-9bf30336e43f",
                        "source_entry_id": "705f6fd8-1b50-3fd9-8fb9-3b5a10807d85",
                        "source_sense_description": "исчезать вследствие массовой смерти",
                        "target_lang_word": "die out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "die out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                        "entry_id": "940f2481-f726-3daf-bc1a-03922e120e5f",
                                        "glosses": [
                                            "To become extinct."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8379c0c-d42c-4486-bb90-52dcc28092fc",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "The dinosaurs died out a long time ago."
                                            },
                                            {
                                                "example_id": "f3f3f360-d6c7-4bbc-b522-94accfdd2ff2",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway,[…]."
                                            },
                                            {
                                                "example_id": "92908128-2af9-4859-bc56-955b960ce7ca",
                                                "sense_id": "5526ccda-bb8c-3796-8179-d5f558030ad2",
                                                "text": "Shepard: I thought you always needed another species to serve as one of the parents.\nLiara: Think about it, Shepard. If we were not able to mate with our own species, we would have died out long before we ever mastered space flight and left our homeworld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                        "entry_id": "940f2481-f726-3daf-bc1a-03922e120e5f",
                                        "glosses": [
                                            "To cease gradually."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a33931a-1a2e-4ae8-b102-93ed540e59c6",
                                                "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                                "text": "The prejudice has died out."
                                            },
                                            {
                                                "example_id": "f762d12c-ce5c-4673-95e7-b362c7a747dd",
                                                "sense_id": "9314969d-44f8-3ac7-a054-4effb129b6bd",
                                                "text": "However, apart from all this, the Chief was a grand old man, belonging to a class of individualists which seems to be dying out in these days, when standard behaviour seems to be as prevalent as standard designs."
                                            }
                                        ]
                                    }
                                ]
                            }
