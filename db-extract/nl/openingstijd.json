        "nl-extract.jsonl": [
            {
                "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                "word": "openingstijd",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d718c9e6-7b7e-4b80-86da-7fa426191f45",
                        "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                        "tags": [
                            "plural"
                        ],
                        "form": "openingstijden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bdab25c-e40b-35fe-be2b-a4d6c8983207",
                        "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                        "glosses": [
                            "tijdstip waarop locatie open gaat voor bezoekers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a5c524-a7d0-467b-aa7c-35c839df47d8",
                                "sense_id": "6bdab25c-e40b-35fe-be2b-a4d6c8983207",
                                "text": "Je kunt er niet reserveren, krap een uur na openingstijd zit het al mudjevol."
                            },
                            {
                                "example_id": "85dcb36e-4d08-46aa-ac28-5ed7628fc138",
                                "sense_id": "6bdab25c-e40b-35fe-be2b-a4d6c8983207",
                                "text": "Ondersteund door een hoop media-aandacht opende Apple gisteren een nieuwe winkel in Amsterdam. Al uren voor openingstijd verzamelden honderden mensen zich voor het pand om als eerste naar binnen te mogen en één van de 4500 gratis t-shirts te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d2a43fc-5fe5-3603-93c3-51921e1571fc",
                        "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                        "glosses": [
                            "afgebakende periode dat een locatie open is voor bezoekers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e2571d-d5f9-496d-94aa-1bffc17839b6",
                                "sense_id": "5d2a43fc-5fe5-3603-93c3-51921e1571fc",
                                "text": "De mogelijke versoepeling van de openingstijd tot 01.00 uur is goed nieuws voor gewone café’s en restaurants, maar „betekent niets” voor nachtclubs."
                            },
                            {
                                "example_id": "f184182c-ba0c-47ea-ae71-3167d134bb49",
                                "sense_id": "5d2a43fc-5fe5-3603-93c3-51921e1571fc",
                                "text": "In het Groninger Museum intussen, voelt het alsof je er buiten openingstijd rondloopt. Er is meer personeel dan dat er bezoekers zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "98dd65ee-dd77-38cd-9149-dd17560bd0bc",
                        "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                        "glosses": [
                            "tijdsduur dat een locatie open is voor bezoekers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22b1fe14-15cf-402e-9a4c-0a02ce61542e",
                                "sense_id": "98dd65ee-dd77-38cd-9149-dd17560bd0bc",
                                "text": "De speciale werkgroep van de beurs beveelt verder aan dat de openingstijd van de beurs worden verruimd."
                            },
                            {
                                "example_id": "a801d8b2-76d1-4f84-a8be-840a2558931d",
                                "sense_id": "98dd65ee-dd77-38cd-9149-dd17560bd0bc",
                                "text": "Den Haag heeft een crisiscentrum, een uniek instituut, dat gisteren is geopend. Mensen die in een crisissituatie zijn terecht gekomen kunnen voortaan naar dit centrum van de Dr. Schröder van der Kolkstichting worden verwezen. (…) Men wil proberen bij patiënten in crisissituaties te voorkomen dat psychiatrische beelden optreden of een blijvend karakter aannemen. De openingstijd moet kort blijven. Als blijkt dat een patiënt een langduriger behandeling nodig heeft dan wordt hij „doorgeplaatst\" naar een psychiatrisch ziekenhuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a7bcc7-6487-37b8-83e9-a147250dd1f2",
                        "entry_id": "a13639cd-0eca-39bc-a50d-1fd58d709d07",
                        "glosses": [
                            "tijdsduur die benodigd was voor het eerste stukje van een race"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e678e093-7551-4aa5-9d0c-d69fc0acf9e2",
                                "sense_id": "34a7bcc7-6487-37b8-83e9-a147250dd1f2",
                                "text": "Ik hoor of zie mijn openingstijd niet. Mijn coach geeft niks aan op de kruising. Maar wat maakt zo’n rondebord uit?"
                            },
                            {
                                "example_id": "eb9592a3-bcbc-45b5-af66-22282fc66500",
                                "sense_id": "34a7bcc7-6487-37b8-83e9-a147250dd1f2",
                                "text": "Haar openingstijd na 100 meter was met 10,36 al tweehonderdste sneller dan een dag eerder."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
