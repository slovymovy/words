                        "examples": [
                            {
                                "example_id": "5ad85c89-6ed3-4a38-8329-402ea33d12a8",
                                "sense_id": "e3ff9ee0-7ce9-3ddf-82e9-845638e753b7",
                                "text": "Hoe lang hij aan het geschenk van de leerlingen werkte? „Dat kan wel 200 uur geweest zijn. Spaanplaat; op elkaar gelijmd; uitgefreesd.” Het kunstwerk bestaat uit vijf stukken. „Ik heb het ontwerp aangepast aan het lange muurvlak dat beschikbaar was.” Daar werd het in 1965 opgehangen. „De zaaier is wel 12 centimeter dik; op andere plaatsen is het kunstwerk dunner.”"
                            },
                            {
                                "example_id": "b170ed01-aa8e-4633-8e27-6695d16491e9",
                                "sense_id": "e3ff9ee0-7ce9-3ddf-82e9-845638e753b7",
                                "text": "De brug zelf is van metselwerk op stalen balken, en op de voorgrond lijken de bakstenen zich uit het muurvlak los te wrikken. Als in een koortsdroom komen ze op je af. Dat heeft niet alleen met het gesuggereerde perspectief te maken, maar ook met het reliëf in de verf. De stenen komen echt een beetje het schilderij uit."
                            }
                        ]
                    }
