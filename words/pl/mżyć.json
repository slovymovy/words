                    "sense_definition": "padać bardzo drobno i delikatnie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zewnątrz <w>mży</w>, więc lepiej załóż kurtkę z kapturem.",
                            "target_lang_translations": {
                                "en": "It is <w>drizzling</w> outside, so you'd better put on a hooded jacket.",
                                "ru": "На улице <w>моросит</w>, так что лучше надень куртку с капюшоном.",
                                "nl": "Buiten <w>miezert het</w>, dus doe maar liever een jas met capuchon aan.",
                                "de": "Draußen <w>nieselt es</w>, zieh dir also besser eine Jacke mit Kapuze an.",
                                "fr": "Il <w>bruine</w> dehors, alors tu ferais mieux de mettre une veste à capuche.",
                                "it": "Fuori <w>pioviggina</w>, quindi è meglio che ti metti una giacca con il cappuccio.",
                                "cs": "Venku <w>mrholí</w>, tak si raději vezmi bundu s kapucí.",
                                "tr": "Dışarıda <w>çiseliyor</w>, bu yüzden kapüşonlu bir ceket giysen iyi olur.",
                                "es": "Fuera <w>está lloviznando</w>, así que mejor ponte una chaqueta con capucha.",
                                "zh": "外面在<w>下毛毛雨</w>，你最好穿上一件带兜帽的外套。"
                            }
                        },
                        {
                            "text": "Cały dzień <w>mży</w> i jest bardzo nieprzyjemnie.",
                            "target_lang_translations": {
                                "en": "It has been <w>drizzling</w> all day and it's very unpleasant.",
                                "ru": "Весь день <w>моросит дождь</w>, и на улице очень неприятно.",
                                "nl": "Het <w>motregent</w> de hele dag en het is erg onaangenaam.",
                                "de": "Den ganzen Tag <w>nieselt es</w> und es ist sehr ungemütlich.",
                                "fr": "Il <w>bruine</w> toute la journée et c'est très désagréable.",
                                "it": "<w>Pioviggina</w> tutto il giorno ed è davvero sgradevole.",
                                "cs": "Celý den <w>mrholí</w> a je velmi nepříjemně.",
                                "tr": "Bütün gün <w>çiseliyor</w> ve hava çok tatsız.",
                                "es": "Lleva todo el día <w>chispeando</w> y es muy desagradable.",
                                "zh": "一整天都在<w>下细雨</w>，让人感觉很不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kropić",
                        "siąpić"
