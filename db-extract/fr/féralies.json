                "senses": [
                    {
                        "sense_id": "74ac35f9-e98b-363c-8619-fb3f57ef56a6",
                        "entry_id": "a7fbed50-1151-3923-acfa-83d5d0bcfa10",
                        "glosses": [
                            "Fêtes célébrées chaque mois de février en l’honneur des morts sous l’Antiquité romaine (les Feralia)."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ecc713cf-a22f-439c-9c5c-105ddf25192a",
                                "sense_id": "74ac35f9-e98b-363c-8619-fb3f57ef56a6",
                                "text": "Non seulement on bannit toute licence des cérémonies saintes, mais on donna à la plupart d’entre elles un admirable caractère de pureté. Ainsi, les Féralies ou fêtes des morts se passaient en purifications matérielles, emblèmes de celles de l’âme."
                            },
                            {
                                "example_id": "a64641d1-6a19-4b66-b127-6b3dbdef4b56",
                                "sense_id": "74ac35f9-e98b-363c-8619-fb3f57ef56a6",
                                "text": "Le 21 février était consacré au souvenir des morts par les Féralies ; le 22, on célébrait les Terminales, en l’honneur du dieu Terme ; le 23 était le Régifuge, ou fuite des rois, en souvenir de l’expulsion des Tarquins."
                            }
                        ]
                    }
