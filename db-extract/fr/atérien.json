                        "sense_id": "24f554b0-36b8-37db-865b-1b1c8899e773",
                        "entry_id": "257437fe-7c6b-3014-b314-e63cb283f111",
                        "glosses": [
                            "Relatif à l’Atérien."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "7724537a-321e-40cd-b179-15141262b7b7",
                                "sense_id": "24f554b0-36b8-37db-865b-1b1c8899e773",
                                "text": "Toutes ces pièces sont susceptibles de porter à leur base un rétrécissement, le pédoncule ; celui-ci est l’un des éléments caractérisant la culture atérienne qui se développera durant le Paléolithique supérieur."
                            }
                        ]
                    }
                ],
