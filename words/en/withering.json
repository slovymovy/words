{
    "word_family": [
        "wither"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "221aa5b6-9525-38f3-b9a5-13b655dbca15",
                    "sense_definition": "Intended to make someone feel ashamed or small; scornful and harsh.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scornful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a <w>withering</w> look after he made that rude comment.",
                            "target_lang_translations": {
                                "cs": "Poté, co pronesl tu hrubou poznámku, na něj vrhla <w>zdrcující</w> pohled."
                            }
                        },
                        {
                            "text": "The politician faced <w>withering</w> criticism from the press regarding his recent policy decisions.",
                            "target_lang_translations": {
                                "cs": "Politik čelil <w>zdrcující</w> kritice tisku ohledně svých nedávných politických rozhodnutí."
                            }
                        }
                    ],
                    "synonyms": [
                        "scornful",
                        "contemptuous",
                        "caustic",
                        "sarcastic"
                    ],
                    "antonyms": [
                        "admiring",
                        "praising"
                    ],
                    "common_phrases": [
                        "withering look",
                        "withering remark"
                    ],
                    "target_lang_definitions": {
                        "cs": "Určený k tomu, aby se někdo cítil zahanbeně nebo bezvýznamně; pohrdavý a drsný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zdrcující",
                                "target_lang_sense_clarification": "o pohledu nebo kritice, která někoho zničí"
                            },
                            {
                                "target_lang_word": "pohrdavý",
                                "target_lang_sense_clarification": "vyjadřující opovržení"
                            },
                            {
                                "target_lang_word": "žíravý",
                                "target_lang_sense_clarification": "o ostré, kousavé poznámce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cddb24e2-0eaa-393a-b44a-d0d9066f6931",
                    "sense_definition": "Extremely intense, severe, or destructive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers advanced despite the <w>withering</w> fire from the enemy positions.",
                            "target_lang_translations": {
                                "cs": "Vojáci postupovali navzdory <w>ničivé</w> palbě z nepřátelských pozic."
                            }
                        },
                        {
                            "text": "The team suffered a <w>withering</w> defeat in the final minutes of the championship game.",
                            "target_lang_translations": {
                                "cs": "Tým utrpěl v posledních minutách finálového zápasu <w>zdrcující</w> porážku."
                            }
                        }
                    ],
                    "synonyms": [
                        "devastating",
                        "crushing",
                        "intense"
                    ],
                    "common_phrases": [
                        "withering fire"
                    ],
                    "target_lang_definitions": {
                        "cs": "Extrémně intenzivní, závažný nebo ničivý."
                    },
                    "translations": {
