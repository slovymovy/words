                    "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                    "sense_definition": "En principe, sauf circonstance particulière ou imprévue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "principe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Normalement</w>, notre train devrait arriver à la gare dans une dizaine de minutes.",
                            "target_lang_translations": {
                                "en": "<w>Normally</w>, our train should arrive at the station in about ten minutes.",
                                "ru": "<w>Обычно</w> наш поезд должен прибыть на вокзал минут через десять.",
                                "de": "<w>Normalerweise</w> sollte unser Zug in etwa zehn Minuten am Bahnhof ankommen.",
                                "es": "<w>Normalmente</w>, nuestro tren debería llegar a la estación en unos diez minutos.",
                                "zh": "<w>通常</w>情况下，我们的火车大约十分钟后应该到站。"
                            }
                        },
                        {
                            "text": "Je finis <w>normalement</w> ma journée vers dix-huit heures, sauf en cas d'urgence.",
                            "target_lang_translations": {
                                "en": "I <w>normally</w> finish my day around six in the evening, unless there is an emergency.",
                                "ru": "Я <w>обычно</w> заканчиваю рабочий день около шести вечера, кроме экстренных случаев.",
                                "de": "Ich beende meinen Arbeitstag <w>normalerweise</w> gegen achtzehn Uhr, außer in Notfällen.",
                                "es": "<w>Normalmente</w> termino mi jornada hacia las seis de la tarde, salvo en caso de urgencia.",
                                "zh": "除非遇到紧急情况，我<w>一般</w>下午六点左右结束一天的工作。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exceptionnellement"
                    ],
                    "target_lang_definitions": {
                        "en": "In principle, unless unusual or unforeseen circumstances arise.",
                        "ru": "В принципе, если не возникает особых или непредвиденных обстоятельств.",
                        "de": "Im Prinzip, sofern keine besonderen oder unvorhergesehenen Umstände eintreten.",
                        "es": "Indica lo que ocurre en principio, salvo circunstancias particulares o imprevistas.",
                        "zh": "指按常规或原则来看，除非出现特殊或意外情况。"
                    },
