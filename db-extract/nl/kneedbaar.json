                            {
                                "example_id": "29bed0d3-0989-401e-8ef3-9addd4aa3049",
                                "sense_id": "b4ce5c6b-9bc1-350b-9cf1-cd04454cefe9",
                                "text": "Laat het mengsel koken tot een theelepeltje stroop in een glas water een balletje vormt dat nog kneedbaar is met de vingers."
                            }
