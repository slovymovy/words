                                                "sense_id": "7a3ea119-c21c-3ec4-9cca-852bd05deab9",
                                                "text": "They finally found a parking space after circling the block three times."
                                            },
                                            {
                                                "example_id": "8086a871-aefc-4661-84f9-11dda839a71e",
                                                "sense_id": "7a3ea119-c21c-3ec4-9cca-852bd05deab9",
