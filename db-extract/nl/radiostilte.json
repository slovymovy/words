                ],
                "senses": [
                    {
                        "sense_id": "35abe58c-c940-3057-8156-a954bb7392f4",
                        "entry_id": "4f3171af-2bdd-3ff0-afc9-5abe39c17c9e",
                        "glosses": [
                            "een toestand waarin men geen radioboodschappen uitzendt"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "bca030b0-5a83-4c34-a33d-3c58ba0f23a9",
                                "sense_id": "35abe58c-c940-3057-8156-a954bb7392f4",
                                "text": "Met de Mars Polar Lander van de NASA liep het slecht af. Na de geplande radiostilte tijdens de landing op 3 december 1999 is het contact nooit hersteld. De waarschijnlijkste oorzaak van het falen is dat een signaal van een sensor is opgevat als teken dat de Lander op Mars stond. Toen zijn de remraketjes uitgezet. Door een softwarefout werd dat signaal al op 40 meter hoogte afgegeven. De achterliggende oorzaak is geldgebrek en mismanagement."
                            }
                        ]
                    },
                    {
                        "sense_id": "298a4ea3-a002-39ab-a84f-4c553be8ebb6",
                        "entry_id": "4f3171af-2bdd-3ff0-afc9-5abe39c17c9e",
                        "glosses": [
                            "een toestand waarin men niet spreekt of anderszins mededelingen doet die wel van belang zouden kunnen zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "da8c3b18-95e6-416e-8eaf-ec93ac88f120",
                                "sense_id": "298a4ea3-a002-39ab-a84f-4c553be8ebb6",
                                "text": "Voor de verkiezingsdatum bestrijden ze elkaar fel, maar direct daarna vinden ze elkaar en beginnen te onderhandelen over een nieuw kabinet. Na een absolute radiostilte staan ze in het gebouw van de Tweede Kamer voor het decor van een foto met een brug in aanbouw."
                            }
                        ]
                    }
