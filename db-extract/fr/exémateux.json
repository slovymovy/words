                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                "text": "C’est une affection exémateuse."
                            },
                            {
                                "example_id": "1b08f82a-2631-4506-bbac-991686967de0",
                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                "text": "Son bras exémateux le démange."
                            },
                            {
                                "example_id": "29c692ca-6bf1-45b6-9e47-7d2bba3b281f",
                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                "text": "Petit, malingre, le visage exémateux, il n’inspirait confiance que si on l’entendait discuter alfaires."
                            }
                        ]
                    }
