                                                "sense_id": "29e961aa-5ab8-3108-b26b-8d16c30bfdb8",
                                                "text": "The ladder is based on the even sidewalk for stability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9c1a81-90e8-31cf-ae5c-dd7c92a4e173",
