                },
                {
                    "sense_id": "4c604d28-0a5a-30ec-9b77-bb9ceab32506",
                    "sense_definition": "Село в России.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "В селе <w>Толстовка</w> проживает всего несколько десятков человек.",
                            "target_lang_translations": {
                                "en": "Only a few dozen people live in the village of <w>Tolstovka</w>."
                            }
                        },
                        {
                            "text": "Дорога до деревни <w>Толстовка</w> была размыта после сильных дождей.",
                            "target_lang_translations": {
                                "en": "The road to the village of <w>Tolstovka</w> was washed out after heavy rains."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A village in Russia."
                    },
                    "translations": {
                        "en": [
