                                            {
                                                "example_id": "e5fd380a-5f07-4c43-8d3a-92a2d2785eb6",
                                                "sense_id": "e4e91607-ad14-3213-8c5b-88e1f68e9135",
                                                "text": "Der Boden ist mit besonders festen Filzen ausgelegt."
                                            }
