                        ]
                    },
                    {
                        "translation_id": "7758a0f0-7d10-435f-b6fb-4af6797642de",
                        "source_entry_id": "1cb99a30-788f-3dd2-b525-40503ee15076",
                        "source_sense_id": "4bbfeef5-e029-3187-86ef-1d862fb283b3",
                        "target_lang_word": "ichtyologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichtyologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                        "entry_id": "b6ab3874-8f81-3111-b4d4-d27655c15a75",
                                        "glosses": [
                                            "Personne qui est spécialiste de l’ichtyologie, l’étude des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946144f6-67d1-4e32-bf50-8e81b7b793a8",
                                                "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                                "text": "C’est celle de l’ichtyologiste qui explore, avec un filet, le fond des océans."
                                            },
                                            {
                                                "example_id": "be8f2946-9a3c-4dfc-a49c-226c9f8d3dcc",
                                                "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                                "text": "À prendre la moyenne des observations faites à diverses reprises, […] on pouvait affirmer, cependant, que cet être phénoménal dépassait de beaucoup toutes les dimensions admises jusqu’à ce jour par les ichthyologistes, — s’il existait toutefois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
