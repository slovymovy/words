                    {
                        "translation_id": "434241b3-4e62-4df7-906d-a098f6f0fc3c",
                        "source_entry_id": "185f6f87-53d2-373b-8927-108a75ffab25",
                        "source_sense_id": "d45f5166-f43d-35d8-b692-5519936f4a24",
                        "target_lang_word": "Hämatom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämatom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14348531-ec36-36b8-bb24-5de7c314048f",
                                        "entry_id": "ddcd4e6b-0042-3bb5-8d75-7a0939328d3f",
                                        "glosses": [
                                            "Stelle unter der Haut, an der sich durch Verletzung der hautnahen Blutgefäße Blut ansammelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da3a045-4a61-4a9b-b7b1-0e0fc5c94bab",
                                                "sense_id": "14348531-ec36-36b8-bb24-5de7c314048f",
                                                "text": "„Der 35-jährige Ukrainer war am Freitag in einen Massensturz verwickelt und hatte sich dabei ein großes Hämatom am Rücken zugezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fbcdb0a-a682-4954-852d-ed9d59ac81c0",
                        "source_entry_id": "185f6f87-53d2-373b-8927-108a75ffab25",
                        "source_sense_id": "d45f5166-f43d-35d8-b692-5519936f4a24",
                        "target_lang_word": "Bluterguss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluterguss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e251b8ad-aca4-30ed-9154-5785cfc6fbdd",
                                        "entry_id": "77764a8e-bf4e-3e7d-a226-4714c349bec4",
                                        "glosses": [
                                            "Stelle unter der Haut, an der sich durch Verletzung der hautnahen Blutgefäße Blut ansammelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d618c084-f7f0-472d-8410-6ca9c761565f",
                                                "sense_id": "e251b8ad-aca4-30ed-9154-5785cfc6fbdd",
                                                "text": "Ich habe mich schon wieder gestoßen; morgen habe ich wieder einen Bluterguss."
                                            },
                                            {
                                                "example_id": "01d1d9c1-82f3-477d-b4c9-238c1c4413f8",
                                                "sense_id": "e251b8ad-aca4-30ed-9154-5785cfc6fbdd",
                                                "text": "„Die Blutergüsse an seinem Kinn verrieten, dass er zu der Sorte Trinker gehörte, die einschlafen, während sie noch am Tisch sitzen.“"
                                            },
                                            {
                                                "example_id": "a0b52b81-168e-4901-8994-83d2130fc523",
                                                "sense_id": "e251b8ad-aca4-30ed-9154-5785cfc6fbdd",
                                                "text": "„Bei einer Fahrt nach Feldberg stürzt er vom Rad, der linke Arm ist voller Blutergüsse, an Tippen ist nicht zu denken, aber der Roman muss fertig werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04f7acee-fe96-4644-b4da-1bbbd034633f",
                        "source_entry_id": "185f6f87-53d2-373b-8927-108a75ffab25",
                        "source_sense_id": "d45f5166-f43d-35d8-b692-5519936f4a24",
                        "target_lang_word": "гематома",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гематома",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45b2c166-0b81-397a-ba19-21322e5800ce",
                                        "entry_id": "fad8e7e3-1e68-38bd-a0f7-0fe0f92891f9",
                                        "glosses": [
                                            "мед. ограниченное скопление жидкой или свернувшейся крови при закрытых и открытых повреждениях органов и тканей с разрывом сосудов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ee7d95-44d5-4d41-8420-4dc955bf3d20",
                                                "sense_id": "45b2c166-0b81-397a-ba19-21322e5800ce",
                                                "text": "Гематома носовой перегородки возникает почти исключительно при травмах, которые сопровождаются кровоизлиянием в подслизисто-надхрящничный слой."
                                            },
                                            {
                                                "example_id": "b698bba0-d4e0-4efb-8743-1618243f2594",
                                                "sense_id": "45b2c166-0b81-397a-ba19-21322e5800ce",
                                                "text": "Среди геморрагических осложнений люмбальной пункции наиболее значимы: хроническая и острая внутричерепная субдуральная гематома, спинальная субарахноидальная гематома, внутримозговая гематома."
                                            },
                                            {
                                                "example_id": "3c47a865-2440-4b36-8fa0-00d6326d9add",
                                                "sense_id": "45b2c166-0b81-397a-ba19-21322e5800ce",
                                                "text": "Горелкин. Разрешите доложить, ваша честь, это синяк… Прокурор. Это гематома. Тяжкое телесное повреждение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
