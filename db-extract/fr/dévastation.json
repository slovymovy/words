                                "target_senses": [
                                    {
                                        "sense_id": "9998da72-adde-3588-82b8-9746144d458b",
                                        "entry_id": "c43d4268-d1f2-35c6-9f1e-37267d016767",
                                        "glosses": [
                                            "The act of devastating, or the state of being devastated; a laying waste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5a10df-50b1-421e-ae69-57f338788b86",
                                                "sense_id": "9998da72-adde-3588-82b8-9746144d458b",
                                                "text": "Perhaps as startling as the sheer toll was the devastation to some of the state’s well-known locales. Boardwalks along the beach in Seaside Heights, Belmar and other towns on the Jersey Shore were blown away. Amusement parks, arcades and restaurants all but vanished. Bridges to barrier islands buckled, preventing residents from even inspecting the damage to their property."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad67de0a-849c-3197-bd47-5dba5a31e134",
                                        "entry_id": "c43d4268-d1f2-35c6-9f1e-37267d016767",
                                        "glosses": [
                                            "Waste or misapplication of the assets of a deceased person by an executor or administrator; devastavit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
