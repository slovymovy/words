                                "example_id": "481d04c7-61e6-496a-a836-4fb061ef15bd",
                                "sense_id": "2d5ceac6-8cc1-3cb0-8b03-4ef3a1c409c8",
                                "text": "Het mengsel kreeg dezelfde kleur als die van lakmoes."
