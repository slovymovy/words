                ],
                "senses": [
                    {
                        "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                        "entry_id": "941a7816-768d-3e95-8976-d5da54ac4921",
                        "glosses": [
                            "Gruppe von Dialekten, die sich durch große Ähnlichkeit auszeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be07cbc5-e600-4bcb-91fb-063a87f29ee5",
                                "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                                "text": "Die 2. [Lautverschiebung] sorgte also für zwei Großdialekte, zwei Sprechergruppen."
                            },
                            {
                                "example_id": "ac1eb82e-c46c-4035-a2aa-630ddb565e4a",
                                "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                                "text": "„Der ‚Großdialekt‘, der in Stadt und Agglomeration Zürich gesprochen wird, bildet ein Kontinuum zwischen zwei Polen[.]“"
                            },
                            {
                                "example_id": "5fd7e52d-252b-4763-8e6a-252dbf93b354",
                                "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                                "text": "„alle unterschiedenen Dialekte sind jedoch Teil des einen Großdialekts Alemannisch, zu dem übrigens noch das außerhalb der Schweiz liegende Niederalemannische gehört[.]“"
                            },
                            {
                                "example_id": "183a2bb4-f9e4-4ab6-86db-7097f3df14c8",
                                "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                                "text": "„Das Masurische ist zweifellos als Dialekt des Polnischen, genauer als Mundart des masowischen Großdialekts des Polnischen zu klassifizieren, der den heutigen nordostpolnischen Raum bedeckt.“"
                            },
                            {
                                "example_id": "5cfe67b3-d8b3-4297-9e32-512c34de7c5b",
                                "sense_id": "85ce115a-93d9-345c-8e91-0421e66fba76",
                                "text": "„Während die Hochsprache durch Stilistiken, Aussprachewörterbücher u.ä. hinreichend beschrieben, bisweilen schon fast kodifiziert ist und daher als \"Einheit\" angesprochen werden kann, gliedert sich ein regionaler Großdialekt wie etwa das Ostfränkische in zahlreiche regional bestimmte Untergruppen auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
