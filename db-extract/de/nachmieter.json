                "senses": [
                    {
                        "sense_id": "ac0484d9-7c99-3355-9ccf-e6d4d4f76e69",
                        "entry_id": "4ed855ac-5721-3811-acbb-fc59a20e900b",
                        "glosses": [
                            "jemand, der direkt nach dem Freiwerden eines Mietobjekts als dessen neuer Mieter auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6093a689-8582-495b-ba27-8c93038db056",
                                "sense_id": "ac0484d9-7c99-3355-9ccf-e6d4d4f76e69",
                                "text": "„In Zeiten von Wohnungsknappheit und Mietpreisbremse beißt so mancher Nachmieter in den sauren Apfel und zahlt für die Hinterlassenschaften eine Ablösesumme.“"
                            },
                            {
                                "example_id": "bcfea994-465d-43cd-9aae-866236faf89e",
                                "sense_id": "ac0484d9-7c99-3355-9ccf-e6d4d4f76e69",
                                "text": "„Denn selbst wenn es für die Wohnung bereits einen Nachmieter gibt, so ist es aktuell eher unwahrscheinlich, dass er oder sie demnächst einzieht.“"
                            },
                            {
                                "example_id": "acb520cf-fda6-4558-bc28-20446c54affe",
                                "sense_id": "ac0484d9-7c99-3355-9ccf-e6d4d4f76e69",
                                "text": "„Die neue Bleibe sei nicht bezugsfertig, die neuen Bewohner müssten ihren Einzug verschieben. Doch die alte Wohnung ist schon gekündigt, und der Nachmieter scharrt mit den Hufen. Was nun?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
