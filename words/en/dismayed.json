{
    "word_family": [
        "dismay"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8d6df6a-55ac-34f6-aa33-83c29352a565",
                    "sense_definition": "Feeling a sudden or complete loss of courage or confidence in the face of trouble or danger; filled with disappointment and concern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>dismayed</w> to find his car had gone when he returned to the parking lot.",
                            "target_lang_translations": {
                                "ru": "Он был <w>потрясен</w>, обнаружив, что его машина исчезла, когда он вернулся на парковку."
                            }
                        },
                        {
                            "text": "The teacher was <w>deeply</w> <w>dismayed</w> by the students' lack of interest in the important project.",
                            "target_lang_translations": {
                                "ru": "Учитель был <w>глубоко</w> <w>разочарован</w> отсутствием интереса студентов к важному проекту."
                            }
                        }
                    ],
                    "synonyms": [
                        "appalled",
                        "disheartened",
                        "alarmed",
                        "daunted"
                    ],
                    "antonyms": [
                        "encouraged",
                        "elated",
                        "pleased"
                    ],
                    "common_phrases": [
                        "deeply dismayed",
                        "dismayed at the news",
                        "look dismayed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство внезапной или полной потери мужества или уверенности перед лицом беды или опасности; состояние разочарования и тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разочарованный",
                                "target_lang_sense_clarification": "в связи с неприятным событием"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "обеспокоенный ситуацией"
                            },
                            {
                                "target_lang_word": "удрученный",
                                "target_lang_sense_clarification": "потерявший бодрость духа"
                            },
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "внезапно встревоженный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed2abea5-259d-3d48-8cb1-511088794d35",
                    "sense_definition": "Simple past and past participle of <w>dismay</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in the weather <w>dismayed</w> the hikers who were planning to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Внезапная перемена погоды <w>обескуражила</w> туристов, планировавших достичь вершины."
                            }
                        },
                        {
                            "text": "The news of the factory closing has <w>dismayed</w> the entire local community.",
                            "target_lang_translations": {
                                "ru": "Новость о закрытии завода <w>привела в уныние</w> все местное сообщество."
