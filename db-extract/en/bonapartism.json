                    },
                    {
                        "translation_id": "ae47f9c2-ca23-4afc-8d25-6e220e6c3bb7",
                        "source_entry_id": "3a09ca83-4f01-3fcd-a728-87b58ee618cd",
                        "source_sense_description": "pratices and ideology of Napoleon Bonaparte",
                        "target_lang_word": "bonapartisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonapartisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac33c04d-6bec-3e50-b867-03cc90471a09",
                                        "entry_id": "d329aff0-8616-35bc-81d9-85c3be2c5b9c",
                                        "glosses": [
                                            "Attachement au gouvernement impérial fondé par Napoléon, et à sa dynastie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11def8ae-3c63-4820-af4a-57c527e776b0",
                                                "sense_id": "ac33c04d-6bec-3e50-b867-03cc90471a09",
                                                "text": "Il parlait à son père du prince Louis Bonaparte comme de l’homme nécessaire et fatal qui seul pouvait dénouer la situation. Il avait cru en lui avant même son retour en France, lorsque le bonapartisme était traité de chimère ridicule."
                                            },
                                            {
                                                "example_id": "e9309fbc-93f4-4dd9-ad44-a6123385f121",
                                                "sense_id": "ac33c04d-6bec-3e50-b867-03cc90471a09",
                                                "text": "Les premières formes du nationalisme à la française, le bonapartisme et le boulangisme, doivent aussi composer avec l’individualisme égalitaire du fond anthropologique."
                                            },
                                            {
                                                "example_id": "3779dd87-9e50-422f-8b4d-292175c521ec",
                                                "sense_id": "ac33c04d-6bec-3e50-b867-03cc90471a09",
                                                "text": "Autrement dit, en toute société démocratique, et bien plus encore dans les bonapartismes, on ne peut que constater un décalage entre le mode de légitimité du pouvoir et la vérité effective de son fonctionnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7579c068-6390-4e8d-a15e-20696c6ab122",
                        "source_entry_id": "3a09ca83-4f01-3fcd-a728-87b58ee618cd",
                        "source_sense_description": "pratices and ideology of Napoleon Bonaparte",
                        "target_lang_word": "Bonapartismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bonapartismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702a8a3c-f24d-3d26-809c-bf09b2726b48",
                                        "entry_id": "bc8f58ce-bb84-3932-bbe9-702741f93a5c",
                                        "glosses": [
                                            "Praxis und Ideologie der Einherrschaft Napoleon Bonapartes und Napoleons III."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ca5eb8-d485-447f-8062-b8b441693649",
                                                "sense_id": "702a8a3c-f24d-3d26-809c-bf09b2726b48",
                                                "text": "„Um dem Despotismus der Versammlungen zu entgehen, vertraute sich die Nation einem einzigen Mann an, der behauptete, den Willen des Volkes und zugleich die Macht des Staates zu verkörpern. Sie gab dem Bonapartismus eher ihre Zustimmung, als daß sie sich ihm aus Begeisterung angeschlossen hätte.“"
                                            },
                                            {
                                                "example_id": "7da1031b-1c61-4a9c-a676-8e9c39344aaa",
                                                "sense_id": "702a8a3c-f24d-3d26-809c-bf09b2726b48",
                                                "text": "„Die Masse ist die eigentlichste politische Entdeckung des Bonapartismus und sie ist eine zentrale Phantasmagorie des neunzehnten Jahrhunderts für das zweideutige nachrevolutionäre Sein.“"
                                            },
                                            {
                                                "example_id": "547d5a7a-5d5f-440e-99f3-7421f8bb1691",
                                                "sense_id": "702a8a3c-f24d-3d26-809c-bf09b2726b48",
                                                "text": "„Der Bonapartismus, wie ihn Napoleon III. durch sein Reden und Handeln vorstellte, schwankte zeit seiner Herrschaft zwischen rechts und links, zwischen Demokratie und Autokratie, Fortschritt und Reaktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
