                "senses": [
                    {
                        "sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                        "entry_id": "616513c9-53b5-3f5e-b4e2-35f3ab405430",
                        "glosses": [
                            "iemand die niets of veel te weinig doet"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a031ad22-63ff-44e5-a9f9-24d7fc2228b2",
                                "sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                                "text": "Hester is inmiddels op zoek naar haar vader. Ze wil hem dolgraag leren kennen. Haar moeder heeft wel steeds gezegd dat ze zoveel op hem lijkt en dat ze net zo’n lanterfanter is als hij, maar toch zou ze graag eens met hem willen praten."
                            },
                            {
                                "example_id": "61eb8f05-4ed2-4640-badf-682245aaa2ca",
                                "sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                                "text": "In een grappige scène van De stand van de sterren, winnaar van het IDFA-festival, worden haastig een brommer en een televisie verstopt om een inspecteur van de armen-dienst om de tuin te leiden. In het derde deel van Leonard Retel Helmrichs documentaire-reeks rond de familie van oma Rumidja heeft lanterfanter Bakti het moeilijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bb00fab-1d23-42f8-8765-0211bac354f5",
                        "source_entry_id": "616513c9-53b5-3f5e-b4e2-35f3ab405430",
                        "source_sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                        "target_lang_word": "good-for-nothing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "good-for-nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae24537-5759-3394-8fa1-5f0de795ec8d",
                                        "entry_id": "240c1d3a-c2ee-3757-9227-1994b015ae3e",
                                        "glosses": [
                                            "Useless; worthless."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "good-for-nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06d2b6f6-011c-3e93-b278-6b8befb3770e",
                                        "entry_id": "8ba68290-3550-393c-9162-6b5cdb61dc10",
                                        "glosses": [
                                            "A person of little worth or usefulness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487cae47-c31e-4f0f-b9ba-6d4046c46b29",
                                                "sense_id": "06d2b6f6-011c-3e93-b278-6b8befb3770e",
                                                "text": "Americans might have taken some comfort from the fact that these critics also expressed similar misgivings about Rhodes Scholars coming from elsewhere. Isis, a student publication, lampooned Australians as good-for-nothings who badly needed education."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7495ac0d-f55c-4e9e-a31b-8c522558b060",
                        "source_entry_id": "616513c9-53b5-3f5e-b4e2-35f3ab405430",
                        "source_sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                        "target_lang_word": "lounger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lounger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "One who lounges; an idler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d813e81f-36e7-4f8f-a9cb-84fbe37caa57",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "Three or four men noticed my condition; and, evidently setting it down to the results of over many pegs, charitably endeavoured to draw me apart from the rest of the loungers."
                                            },
                                            {
                                                "example_id": "05086733-46ba-46ca-8891-a72396afd416",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "These colors, falling upon the throng of monomachists and loungers much as we see the aureate beams of divine favor fall on hierarchs in art, lent them an appearance insubstantial and thaumaturgic, as though they had all been produced a moment before by the flourish of a cloth and would vanish into the air again at a whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "A chair made for lounging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415d73d5-d2e7-459a-9a38-69c2efe64746",
                                                "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                                "text": "You shoulda heard me in the lounger / Telling people what they was"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f3eb431-07b9-4353-96bc-87668593cc7b",
                        "source_entry_id": "616513c9-53b5-3f5e-b4e2-35f3ab405430",
                        "source_sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                        "target_lang_word": "loafer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                        "entry_id": "d36816ba-58b2-3430-85ce-6cf451f58500",
                                        "glosses": [
                                            "An idle person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3bc6e66-a5df-4d67-a2b4-3417e89d8460",
                                                "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                                "text": "The garden was bounded by a three-foot brick wall with a fringe of wood rails upon the top, and against this wall was leaning a stalwart police constable, surrounded by a small knot of loafers, who craned their necks and strained their eyes in the vain hope of catching some glimpse of the proceedings within."
                                            },
                                            {
                                                "example_id": "61cbcbbf-2ea9-41c7-b0cc-f825756eb5b5",
                                                "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                                "text": "Along this unequal way, where loafers sat on whittled benches, lounged in doorways, leaned against porch props, Dan Gustin went pegging in his high-heeled boots like a mule in a Mexican chain hobble, holding a straight course for the hotel, past the doors of temptation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8258c49-74a9-3d72-9fae-f3b657cfa5a0",
                                        "entry_id": "d36816ba-58b2-3430-85ce-6cf451f58500",
                                        "glosses": [
                                            "A shoe with no laces, resembling a moccasin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf26aa1-feba-4470-a274-e6e21917f16a",
                                                "sense_id": "d8258c49-74a9-3d72-9fae-f3b657cfa5a0",
                                                "text": "Someone must explain to Sunak about the time bomb ticking beneath his £1,000 loafers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1970608-1efe-39ae-a66a-cd2b6c56fa7d",
                                        "entry_id": "a18fe0f9-0828-3ae5-ab11-45bd2a6a62d7",
                                        "glosses": [
                                            "To loaf around; to be idle."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5678f139-2709-32c3-9104-8a46193f1622",
                                        "entry_id": "e3709cfc-e416-3883-85bc-6716d728023d",
                                        "glosses": [
                                            "A particular orthogonal spaceship in Conway's Game of Life that moves at a speed of c/7, and the smallest such example."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                        "entry_id": "463ddf5d-0061-3b56-9183-a77c4aa334d7",
                                        "glosses": [
                                            "A wolf, especially a grey or timber wolf."
                                        ],
                                        "tags": [
                                            "Southwestern",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f347d86b-6dc2-41b9-91ac-0ba500f1f020",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "The great menace to livestock, other than the continual battle with cold, [...] was the gray wolf. [...] The big loafers came in from everywhere."
                                            },
                                            {
                                                "example_id": "f9b82da8-9827-4f03-b0d3-2b8bfeeacac4",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "Cowboys had killed “loafers” at five hundred yards away with rifles. [...] Lucille was not like most cowhands and she sets out to capture the \"loafer\" with her lariat."
                                            },
                                            {
                                                "example_id": "c8d33e5c-1970-4bdb-865e-7c1815f5b058",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "By the 1890s loafers had become such a problem that some newly organized counties, as well as certain cattle outfits, paid bounties for their scalps. For a cowboy making a dollar or so a day, wolf-hunting could be lucrative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8934a49d-2882-481a-a315-306cb2338a62",
                        "source_entry_id": "616513c9-53b5-3f5e-b4e2-35f3ab405430",
                        "source_sense_id": "2b83fd4a-991b-3da6-b1dc-e281f278ed0a",
                        "target_lang_word": "slowpoke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slowpoke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                        "entry_id": "06f850f5-69b6-3039-bf84-846c6450bcd3",
                                        "glosses": [
                                            "A person who moves slowly or takes a long time to do something."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "informal",
                                            "mildly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27db630-1abc-4908-9c5f-b37618636556",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "Hey, you slowpokes in the back! Get a move on!"
                                            },
                                            {
                                                "example_id": "6d4c5261-bc3b-4f38-9b2b-7e172fad09ad",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "\"Yas'm,\" said Prissy and, turning, sauntered down the walk at snail's gait. \"Hurry, you slow poke!\""
                                            },
                                            {
                                                "example_id": "d6bde299-654f-4452-beb4-9f2db0839db8",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "Some cooks are diddlers and slowpokes. Some are efficient speed demons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
