                                "target_senses": [
                                    {
                                        "sense_id": "c5ec0fad-acf9-3e40-ac7a-c4307206ab8d",
                                        "entry_id": "224c3212-9fcb-3249-8f26-2dd7b002e45a",
                                        "glosses": [
                                            "A home or residence."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad264af9-84dd-48ca-bbe1-97ed3c812266",
                                                "sense_id": "c5ec0fad-acf9-3e40-ac7a-c4307206ab8d",
                                                "text": "The call to jury duty was sent to my legal domicile; too bad I was on vacation at the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db96f44-2403-3d90-b084-a9fc07c4503e",
                                        "entry_id": "224c3212-9fcb-3249-8f26-2dd7b002e45a",
                                        "glosses": [
                                            "A residence at a particular place accompanied with an intention to remain there for an unlimited time; a residence accepted as a final abode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee2045e-94bb-4b32-950e-f665a91205a7",
                                                "sense_id": "8db96f44-2403-3d90-b084-a9fc07c4503e",
                                                "text": "the status of marriage has been indelibly fixed by the English celebration; and by this decision, her domicile, as a married woman, has been held to be that of her husband"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a69a61db-dcde-316a-a3cc-9c29d94e46d1",
                                        "entry_id": "224c3212-9fcb-3249-8f26-2dd7b002e45a",
                                        "glosses": [
                                            "The zodiac sign over which a planet (a term which in astrology includes the Sun and Moon) is considered to have especially strong influence; the planet is called the sign's ruling planet or sign ruler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "domicile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45a82235-259e-344d-b6bc-8c31e93aad16",
                                        "entry_id": "3a818dfa-682e-3990-a327-fdfa7df14e4b",
                                        "glosses": [
                                            "To have a domicile in a particular place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c47c653-51c2-4737-b77e-6cf889cdae8e",
                                                "sense_id": "45a82235-259e-344d-b6bc-8c31e93aad16",
                                                "text": "The answer depends on which state he was domiciled in at his death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e36a00da-ad64-4453-bc14-aa443bee5b14",
                        "source_entry_id": "0180ba1c-06c6-370d-806a-edfcc930627a",
                        "source_sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                        "source_sense_description": "Wohnsitz",
                        "target_lang_word": "domicile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domicile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a4ec7ba-4603-3ed4-bf8d-c1104db845e1",
                                        "entry_id": "d373d06f-87d3-3d90-ab9b-4e1510ec8543",
                                        "glosses": [
                                            "Lieu choisi par une personne pour son habitation principale."
                                        ],
                                        "tags": [
                                            "Foyer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e1b18c-f124-4ed1-89df-b7f6b7231e51",
                                                "sense_id": "5a4ec7ba-4603-3ed4-bf8d-c1104db845e1",
                                                "text": "Il faut entrer de force dans le domicile du citoyen: il faut arrêter administrativement l’homme qui ne peut être arrêté qu’en vertu d’une loi ; il faut violer la liberté de l’opinion et la liberté individuelle; il faut en un mot mettre en péril la constitution même de l’État."
                                            },
                                            {
                                                "example_id": "c8a430c4-9fcb-471f-a1c8-1269c1b3e3b7",
                                                "sense_id": "5a4ec7ba-4603-3ed4-bf8d-c1104db845e1",
                                                "text": "À Sétif (300 km au sud-est d’Alger), deux personnes ont été mortellement asphyxiées dans leur domicile par les fumées provenant d’un incendie qui s’est déclenché à proximité de leur village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                        "entry_id": "d373d06f-87d3-3d90-ab9b-4e1510ec8543",
                                        "glosses": [
                                            "Lieu où une personne a son principal établissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb3e08b-e00c-41b2-949b-fddc331d21a4",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile d’origine, domicile du père et de la mère d’une personne, et de cette personne elle-même dans son enfance."
                                            },
                                            {
                                                "example_id": "6504d02b-e9ae-4bb1-b83f-228ac1c18d33",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile élu, domicile fictif qu’une personne a déclaré choisir pour y recevoir certaines notifications ou significations."
                                            },
                                            {
                                                "example_id": "424f473c-b044-4d8b-ae58-529e08a2d582",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "élire domicile, faire élection de domicile en tel endroit, etc.;"
                                            },
                                            {
                                                "example_id": "a5e13429-1f76-4c7c-8568-b9145a43ec55",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile réel le Lieu où la personne habite réellement."
                                            },
                                            {
                                                "example_id": "c86799f5-4cdc-4dde-9b3e-262845a2d37d",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile politique, lieu où une personne exerce ses droits politiques."
                                            },
                                            {
                                                "example_id": "5e1a3993-5710-4d15-b1a6-f9262ea8eb06",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile civil le domicile ordinaire."
                                            },
                                            {
                                                "example_id": "29318301-0cfd-43e9-a6a6-728b8bc1032a",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile de fait."
                                            },
                                            {
                                                "example_id": "d190a54d-1a7a-4b65-8503-ffb2c74ee729",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "domicile légal."
                                            },
                                            {
                                                "example_id": "3d939a35-582a-4a52-a745-01d75b103b6d",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "Le domicile de tout Français, quant à l’exercice de ses droits, est au lieu où il a son principal établissement. Le changement de domicile s’opérera par le fait d’une habitation réelle dans un autre lieu, joint à l’intention d’y fixer son principal établissement. … La femme mariée n’a point d’autre domicile que celui de son mari."
                                            },
                                            {
                                                "example_id": "3a562964-bd9e-4b07-b21c-8ca23de2ba97",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "Signifié à sa personne en son domicile."
                                            },
                                            {
                                                "example_id": "2aa6d957-34e1-4cf6-9a69-326feff53d8b",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "Un exploit signifié à domicile."
                                            },
                                            {
                                                "example_id": "6242e23e-b055-476f-b1ca-418f09b2e831",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "C’est un homme sans domicile."
                                            },
                                            {
                                                "example_id": "8d7dc0a4-e725-4c34-866c-4482840c435d",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "Violation de domicile."
                                            },
                                            {
                                                "example_id": "a32b2e83-2500-46fd-9488-fcbe10032f61",
                                                "sense_id": "ad9df077-e034-3926-ad26-c832562d87f0",
                                                "text": "Le domicile politique et le domicile civil sont ordinairement réunis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
