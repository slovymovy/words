        "pl-extract.jsonl": [
            {
                "entry_id": "48402fd7-f132-336e-9350-8c90d01e3280",
                "word": "jeżowiec",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19df7d8c-a34b-33a3-a890-f26f0d9d58a4",
                        "entry_id": "48402fd7-f132-336e-9350-8c90d01e3280",
                        "glosses": [
                            "Echinoidea morskie zwierzę należące do szkarłupni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbfd6e2-efd3-4bfb-aead-b8c12cfc69f6",
                                "sense_id": "19df7d8c-a34b-33a3-a890-f26f0d9d58a4",
                                "text": "Bo straszna to przecie myśl dla ludzkiego rozumu i nieznośne czucie dla serca matki sierocej, iż jej syn wałęsa się na dnie morza, nie mogąc znaleźć spoczynku, miotany i targany, z miejsca na miejsce przez tajemnicze i straszliwe oceanu potwory, jakoby w duszy szatana wyśnione - przez diabły morskie i rekiny, przez głowonogi ośmiornice, przez gruboskorupe langusty, ohydne kraby, oślizgłe mięczaki, ukwiały i jeżowce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0459131-00df-4a66-aea2-306e8ecf0a20",
                        "source_entry_id": "48402fd7-f132-336e-9350-8c90d01e3280",
                        "source_sense_id": "19df7d8c-a34b-33a3-a890-f26f0d9d58a4",
                        "target_lang_word": "sea urchin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea urchin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                        "entry_id": "046c23c3-77ee-3f28-b819-956727dc48f5",
                                        "glosses": [
                                            "Any of many marine echinoderms, of the class Echinoidea, commonly found in shallow water, having a complex chewing structure named Aristotle's lantern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c34081-7281-47b2-9128-1aae9a757f84",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "1986, Patrick S. Leahy, Chapter 1: Laboratory Culture of Strongylocentrotus purpuratus Adults, Embryos, and Larvae, Thomas E. Schroeder (editor), Methods in Cell Biology, Volume 27: Echinoderm Gametes and Embryos, page 2,\nOf the many species of sea urchins utilized in biological research today the most widely used in North America is probably the purple sea urchin, Strongylocentrotus purpuratus."
                                            },
                                            {
                                                "example_id": "fdbad4e5-b9c1-4367-808f-3f696b289ad8",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "The pericentriolar radial complex characteristic of the spermatozoa of other echinoderms is lacking in the spermatozoa of all sea urchins."
                                            },
                                            {
                                                "example_id": "011a077a-c5fa-481e-a1d0-58652e7bddde",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "Approximately 20% of sea urchins are direct-developers, meaning that they bypass the pluteal larval stage and develop directly into an adult sea urchin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
