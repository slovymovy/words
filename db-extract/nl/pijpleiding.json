                "translations": [
                    {
                        "translation_id": "0e09471f-ed01-457f-a5ad-176334fe95f0",
                        "source_entry_id": "3c04a851-ec18-31a9-9a2a-e00f3456b165",
                        "source_sense_id": "ae5d5448-9646-36d9-b99c-0d2ec559a2d5",
                        "source_sense_description": "samenstel van pijpen om vloeistoffen of gassen door te leiden",
                        "target_lang_word": "Rohrleitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohrleitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                        "entry_id": "2bf3485b-f264-3d7e-9003-af07601f565f",
                                        "glosses": [
                                            "lange Röhre mit Pumpstationen (meist auch Abzweigungen) zum kontinuierlichen Transport größerer Mengen flüssiger oder gasförmiger Güter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "960ef9de-84cf-49db-b2ff-aefd4e654cc8",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "Erdöl und Erdgas werden heutzutage über Hunderte von Kilometern durch Rohrleitungen transportiert."
                                            },
                                            {
                                                "example_id": "6a2bcac8-2602-4b32-b736-1ba6448a0f3f",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "In der Abwassertechnik bestehen Rohrleitungen aus Rohren, Formstücken und Verbindungen zwischen Schächten oder anderen Bauwerken."
                                            },
                                            {
                                                "example_id": "c4e008d2-2d6b-4154-9ce5-e601b3fb9315",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "„Mit einer Vielzahl von Beispielen wird gezeigt, wie man Rohrleitungen für verschiedene verfahrenstechnische Aufgabenstellungen unter Berücksichtigung der rohrleitungstechnischen Anforderungen hinsichtlich Festigkeit und Flexibilität berechnet und plant.“"
                                            },
                                            {
                                                "example_id": "4f985487-963b-4d89-9eaf-9aeca7063093",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "„Unsere Manschetten dienen als flexibles Verbindungsstück zur Montage in Rohrleitungen für chemische Abluft und sind in verschiedenen Ausführungen erhältlich.“"
                                            },
                                            {
                                                "example_id": "80967f98-c36e-4377-8789-1ca90adc563b",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "„Über diese einmaligen Prüfungen sind Berichte für jede Rohrleitung zu erstellen.“"
                                            },
                                            {
                                                "example_id": "6a326be0-017a-45fb-9263-e57ac127cdcc",
                                                "sense_id": "62d389de-34f0-3a0e-8a92-d622e2641601",
                                                "text": "„Götzens ›Schloss‹ verfügte nicht über einen Brunnen, allenfalls über eine Zisterne, in die über Dachrinnen und Rohrleitungen das Regenwasser lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
