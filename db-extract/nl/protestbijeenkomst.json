                        "source_entry_id": "30f0a8ac-46ca-36fa-a739-35fbbebc77ff",
                        "source_sense_id": "7562ce58-ee3f-3713-9ae8-8214f2cec644",
                        "source_sense_description": "vergadering van mensen die het ergens niet mee eens zijn",
