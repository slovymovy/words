                                    {
                                        "sense_id": "6a0ab8be-3f0f-364a-813b-291f981fbd9f",
                                        "entry_id": "a7637194-a6d7-3245-9ba7-83161a7ee089",
                                        "glosses": [
                                            "Spécialiste en rhumatologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbee69cd-4773-42d7-a9cc-0cc405ac0e84",
                                                "sense_id": "6a0ab8be-3f0f-364a-813b-291f981fbd9f",
                                                "text": "Ce n’est qu’en 1978, à partir d’une étude sur les douleurs dentaires, que le professeur et rhumatologiste Jon Levine, du département de médecine de l’université de Californie, montre que le seul fait d'être convaincu de prendre un traitement efficace agit sur la sécrétion d’une hormone : l’endorphine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92950ea6-e4b7-4c7f-b4bd-f6c1272201b7",
                        "source_entry_id": "e8f7560f-aaf1-3374-8239-4b7cb5bd50b6",
                        "source_sense_id": "c5937fc2-9cf8-30c6-b343-98e3bca45388",
