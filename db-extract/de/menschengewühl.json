                "senses": [
                    {
                        "sense_id": "03404ae2-364c-3eb5-bf01-f98ff5c6b83e",
                        "entry_id": "7eb5beab-97f1-3ee5-aee0-5a853aa82942",
                        "glosses": [
                            "dichtes, lebhaftes Gedränge von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a3e32e-acaf-432e-91c4-4fbbe17d744d",
                                "sense_id": "03404ae2-364c-3eb5-bf01-f98ff5c6b83e",
                                "text": "„Der kleine Schelm Dai-an stieg hinab, mischte sich in das Menschengewühl und wartete ab, bis Dschu Schi-niän und der Begleiter vorbei waren: dann trat er von der Seite hinzu und zupfte Sjä Si-da.“"
                            },
                            {
                                "example_id": "aaa9e2e5-0853-4b6c-ab10-a96a2e499211",
                                "sense_id": "03404ae2-364c-3eb5-bf01-f98ff5c6b83e",
                                "text": "„Ravic drängte sich eilig durch das Menschengewühl zurück.“"
                            },
                            {
                                "example_id": "6ec933c1-5dcb-4949-a360-aa561916c29a",
                                "sense_id": "03404ae2-364c-3eb5-bf01-f98ff5c6b83e",
                                "text": "„Beim Lyceum-Theater wartete schon ein dichtes Menschengewühl an den Seiteneingängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
