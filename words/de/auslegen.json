                {
                    "sense_id": "b02bb19a-e067-3307-b6b1-294230ca4e7e",
                    "sense_definition": "Gegenstände oder Drucksachen für andere gut sichtbar oder zum Mitnehmen bereitlegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "platzieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Eingangsbereich <w>legte</w> das Hotel kostenlose Informationsbroschüren für alle Touristen <w>aus</w>."
                        },
                        {
                            "text": "Um die Ratten zu vertreiben, <w>legt</w> der Hausmeister im Keller giftige Köder <w>aus</w>."
                        }
                    ],
                    "common_phrases": [
