                "senses": [
                    {
                        "sense_id": "2c285f79-27a9-3f5f-af53-50443a0cadb2",
                        "entry_id": "70998afd-3197-39a5-b346-db2e0eb01f09",
                        "glosses": [
                            "im Bundesland Sachsen (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                        ],
                        "tags": [
                            "archaic",
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "98e6dd43-eea0-4194-9e63-d32a35281a6d",
                                "sense_id": "2c285f79-27a9-3f5f-af53-50443a0cadb2",
                                "text": "„Wohl kenne ich das edle Reis, Der Sachsen alten Ruhm und Preis Der Ehre, der Treue: Bin stolz, ein Sachs zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f502f722-c2da-395d-8a51-e943b61bc5db",
                        "entry_id": "70998afd-3197-39a5-b346-db2e0eb01f09",
                        "glosses": [
                            "eine Hiebwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e68c80-3950-496f-8779-47e42e09ec5b",
                                "sense_id": "f502f722-c2da-395d-8a51-e943b61bc5db",
                                "text": "„Auch unsere Väter haben uns als Zeichen unserer Manneswürde eine Waffe überreicht, diese Waffe ist für unser Volk ein Sachs.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
