                ],
                "senses": [
                    {
                        "sense_id": "1ac43d7f-8ad5-3089-9eef-3cd9d8c700cd",
                        "entry_id": "7b493b0e-f18b-3170-93f0-5011187da972",
                        "glosses": [
                            "Solliciter excessivement ; surmener."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe503298-c4ef-47e9-99fd-944b85ad09c8",
                                "sense_id": "1ac43d7f-8ad5-3089-9eef-3cd9d8c700cd",
                                "text": "C’est très clairement l’INRA qui est accusé d’encaisser en silence les revirements stratégiques somme toute compréhensibles d’un industriel et de sur-solliciter un marché avec les deniers publics."
                            },
                            {
                                "example_id": "9952b4ab-1407-47ee-bd42-070c3712ec76",
                                "sense_id": "1ac43d7f-8ad5-3089-9eef-3cd9d8c700cd",
                                "text": "Celui-ci peut aussi… se retenir de se mettre au travail : attendre, faire diversion, ne pas voir, ne pas comprendre, séduire, sur-solliciter le formateur, se plaindre…"
                            },
                            {
                                "example_id": "1a5106fd-9f5a-4a4c-860c-88698aa22cb3",
                                "sense_id": "1ac43d7f-8ad5-3089-9eef-3cd9d8c700cd",
                                "text": "D’abord, apprendre à limiter les informations, comme les actualités et les écrans qui sur-sollicitent le cerveau et le système nerveux."
                            }
                        ]
                    }
