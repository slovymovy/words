                "senses": [
                    {
                        "sense_id": "918c2f0d-135d-3a97-a033-ceb2a8d02ea3",
                        "entry_id": "56d44332-30d8-3962-a90b-802320253231",
                        "glosses": [
                            "État clinique d’un individu présentant un nombre de lymphocytes (globules blancs) inférieur à la normale, et qui indique une faible capacité de l’organisme à se défendre contre une infection ou contamination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974cecff-375c-4a2a-bb51-4b7b4d1fbcbb",
                                "sense_id": "918c2f0d-135d-3a97-a033-ceb2a8d02ea3",
                                "text": "Dans le cancer du sein, les carcinomes ovariens, les LNH, les lymphomes T (PTCL, PTCLU), les sarcomes, le cancer du côlon, une lymphopénie globale (< 1 000/mm³) et/ou une lymphopénie sévère (< 700/mm³) ont un impact négatif sur la SSR ou la SG qu'elles soient détectées avant tout traitement ou précocement après le début du traitement de chimiothérapie (5 jours, 15 jours)."
                            }
                        ]
                    }
