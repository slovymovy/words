                                        "sense_id": "ad62bbb6-a3c9-3a3a-a3f7-c4e5961d166a",
                                        "entry_id": "db2cd744-1c4b-3d39-b121-6da4bbef51a1",
                                        "glosses": [
                                            "Ancien nom officiel d’une commune française, située dans le département des Pyrénées-Orientales, dont le nom officiel est maintenant Clara-Villerach."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Clara",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfc1754-b7e5-39f4-a303-f8e73a0284b9",
                                        "entry_id": "afbbe031-baf2-3a94-a43b-91469e500632",
                                        "glosses": [
                                            "Prénom féminin, variante de Claire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd15558-b237-4d3d-a6f3-3ede7b139ef7",
                                                "sense_id": "1bfc1754-b7e5-39f4-a303-f8e73a0284b9",
                                                "text": "Les yeux de Nelly, Ludivine et Clara, si c’était des mitraillettes, mieux que mort, je serais réduit en miettes, passoirisé de la tête aux pieds."
                                            },
                                            {
                                                "example_id": "3570f813-9ed9-466a-9150-30780872214c",
                                                "sense_id": "1bfc1754-b7e5-39f4-a303-f8e73a0284b9",
                                                "text": "Je t’aimais tant, Clara\n Je t’aimais tant\n Je t’aimais tant, Clara\n Je t’aimais tant."
                                            },
                                            {
                                                "example_id": "e7175ad4-71eb-4957-91cb-8dba8f402613",
                                                "sense_id": "1bfc1754-b7e5-39f4-a303-f8e73a0284b9",
                                                "text": "Clara, Lucas, Lana, Louane, Joris, Nolan, Ewen s’accordent pour dire leur plaisir d’avoir participé aux sorties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99b3d06d-de0f-460b-ab60-3d736b2e367a",
                        "source_entry_id": "fe7cfac2-9927-3452-9469-e29ddc8d5e8a",
                        "source_sense_description": "cognates and transliterations of the name Clara",
                        "target_lang_word": "Clara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                        "entry_id": "6d175aa1-2ac1-3eb7-8626-d91e15cb1ba1",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9e8eb8-f8ac-448c-b854-89fe4fa5c03e",
                                                "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                                "text": "„Sie sollen sehen, daß mir in Clara und in dir noch große Freude geblieben ist und daß ich weder so schwach noch so alt bin, mich von einem Unglück niederwerfen zu lassen.“"
                                            },
                                            {
                                                "example_id": "b0914194-3b12-4fda-9a37-0d616d850f47",
                                                "sense_id": "78d12e8c-ef6f-34c3-a7ea-7d5ab163d291",
                                                "text": "„Ich habe es aber etwas schlauer angestellt als Hans und Clara.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
