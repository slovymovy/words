                    {
                        "sense_id": "fba924fd-6753-3b62-bbd1-f76fa0b2f2c6",
                        "entry_id": "079987cd-b93e-32d0-8c3c-bb373c31acd8",
                        "glosses": [
                            "Production de fruits sans fécondation d’ovule, ce phénomène ne s'observe que chez des plantes modifiées par l'homme et devenues incapables de se reproduire dans des conditions naturelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f8dc08-ccf2-43cd-9922-c2b7af26e366",
                                "sense_id": "fba924fd-6753-3b62-bbd1-f76fa0b2f2c6",
                                "text": "La visite de blastophages est indispensable chez certaines variétés de figuiers non sujettes à la parthénocarpie."
                            },
                            {
                                "example_id": "8f40ad2f-c405-4de5-9809-253ce4902212",
                                "sense_id": "fba924fd-6753-3b62-bbd1-f76fa0b2f2c6",
                                "text": "La parthénocarpie est indépendante de la stérilité femelle."
                            }
                        ]
                    }
                ],
