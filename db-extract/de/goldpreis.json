                "senses": [
                    {
                        "sense_id": "f768cc9b-f3ed-3fe5-9272-9ab013eefaa2",
                        "entry_id": "c255a10b-9e39-3860-8e6c-516ad1eb23a4",
                        "glosses": [
                            "Preis für Gold auf dem Weltmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae04dee1-5bc4-4b40-93e1-625dbb3559c7",
                                "sense_id": "f768cc9b-f3ed-3fe5-9272-9ab013eefaa2",
                                "text": "„Dass nach Anfang August, als der Goldpreis in 2069 US-Dollar pro Feinunze gegipfelt war, eine längere Verschnaufpause folgte, kam für Ronald Stöferle nicht ganz überraschend.“"
                            },
                            {
                                "example_id": "fc536bb2-5546-48c9-a69f-32f72538aefb",
                                "sense_id": "f768cc9b-f3ed-3fe5-9272-9ab013eefaa2",
                                "text": "„So überliefert Sueton, dass Caesar und seine Soldaten so viel Gold aus Gallien nach Rom schafften, dass dort der Goldpreis um ein Viertel sank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
