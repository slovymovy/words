    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                    "sense_definition": "Régime juridique et mesure de protection accordés pour veiller sur la personne et administrer les biens d'un mineur ou d'un majeur vulnérable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a décidé d'ordonner la mise sous <w>tutelle</w> de cette personne âgée devenue dépendante."
                        },
                        {
                            "text": "Pendant sa minorité, les finances de l'orphelin étaient gérées sous le contrôle strict du juge des <w>tutelles</w>."
                        }
                    ],
                    "antonyms": [
                        "émancipation"
                    ],
                    "common_phrases": [
                        "mise sous tutelle",
                        "juge des tutelles",
                        "être sous tutelle"
                    ]
                },
                {
                    "sense_id": "1c48ed9f-a149-3ee2-8c5a-da7c54df4a74",
                    "sense_definition": "Contrôle ou surveillance administrative exercé par l'État ou une collectivité sur un organisme ou un établissement public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet institut de recherche fonctionne sous la <w>tutelle</w> directe du ministère de l'Enseignement supérieur."
                        },
                        {
                            "text": "Le directeur a envoyé son rapport annuel à l'autorité de <w>tutelle</w> pour validation."
                        }
                    ],
                    "synonyms": [
                        "contrôle",
                        "surveillance"
                    ],
                    "antonyms": [
                        "autonomie",
                        "indépendance"
                    ],
                    "common_phrases": [
                        "autorité de tutelle",
                        "ministère de tutelle"
                    ]
                },
                {
                    "sense_id": "a9e09982-d26f-3622-8cd6-81e23ca4bb13",
                    "sense_definition": "Protection, influence ou dépendance contraignante exercée par quelqu'un sur une personne ou un groupe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune artiste a longtemps cherché à s'affranchir de la <w>tutelle</w> étouffante de son maître."
                        },
                        {
                            "text": "Elle ne supportait plus de vivre sous la <w>tutelle</w> constante de ses parents."
                        }
                    ],
                    "synonyms": [
                        "dépendance",
                        "domination"
                    ],
                    "antonyms": [
                        "émancipation",
                        "liberté"
                    ],
                    "common_phrases": [
                        "s'affranchir de la tutelle"
                    ]
                },
                {
                    "sense_id": "8d9135f4-0902-37e5-b262-7d76c88a17fd",
                    "sense_definition": "Régime d'administration ou de dépendance politique imposé à un territoire par une puissance extérieure ou une organisation internationale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le conflit mondial, ce territoire a été placé sous la <w>tutelle</w> des Nations unies."
                        },
                        {
                            "text": "Le peuple a lutté pendant plusieurs décennies pour mettre fin à la <w>tutelle</w> coloniale."
                        }
                    ],
                    "synonyms": [
                        "mandat",
                        "protectorat"
                    ],
                    "antonyms": [
                        "indépendance",
                        "souveraineté"
                    ],
                    "common_phrases": [
                        "tutelle internationale"
                    ]
                }
            ]
        }
    ]
