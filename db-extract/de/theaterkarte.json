                            {
                                "example_id": "dd511d27-ec96-483a-9dd0-5aecb96edd51",
                                "sense_id": "d3f97c7b-5b29-3997-b68c-be4a85d1fedb",
                                "text": "„Damit sollen Kinder, deren Eltern sich die Theaterkarte oder das Ticket ins Haus der Natur nicht leisten können, trotzdem zu Schulausflügen mitgehen können.“"
                            },
                            {
                                "example_id": "a7593cc2-895f-49e1-b909-2f7524e4fc3c",
                                "sense_id": "d3f97c7b-5b29-3997-b68c-be4a85d1fedb",
                                "text": "„Möglichkeiten dazu gibt es viele, den meisten reicht ein Buch, ein Film oder eine Theaterkarte.“"
                            }
