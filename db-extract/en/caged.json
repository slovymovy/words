                        "examples": [
                            {
                                "example_id": "f42c246d-ef96-4343-aa72-ba3642b9b9e3",
                                "sense_id": "0a8d23a5-bbef-34de-aecb-0ada30685ddf",
                                "text": "Two thirds of the class decided that free-range eggs had more taste and flavour than caged eggs and one third liked the taste of caged eggs more than free range."
                            }
