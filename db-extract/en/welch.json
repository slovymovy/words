                                                "sense_id": "b43fb177-9563-3e54-9f19-12e10062aae4",
                                                "text": "Wenn eine Taste einer Tastatur prellt, dann registriert der Computer bei einem Tastendruck fälschlicherweise zwei oder mehr Tastendrücke."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
