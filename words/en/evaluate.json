{
    "word_family": [
        "evaluation",
        "evaluative",
        "evaluator",
        "re-evaluate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b04e1928-4ac6-37f5-bb77-95b63a5c2d05",
                    "sense_definition": "To carefully examine and judge the quality, importance, amount, or value of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assessment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It will take several years to <w>evaluate</w> the material gathered in the survey.",
                            "target_lang_translations": {
                                "ru": "Потребуется несколько лет, чтобы <w>оценить</w> материал, собранный в ходе опроса."
                            }
                        },
                        {
                            "text": "The committee needs to <w>evaluate</w> performance before deciding on the annual bonuses.",
                            "target_lang_translations": {
                                "ru": "Комитету необходимо <w>оценить</w> показатели работы, прежде чем принимать решение о ежегодных бонусах."
                            }
                        }
                    ],
                    "synonyms": [
                        "weigh"
                    ],
                    "common_phrases": [
                        "evaluate performance",
                        "evaluate the impact",
                        "evaluate the effectiveness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно изучать и судить о качестве, важности, количестве или ценности чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "процесс определения ценности или качества"
                            },
                            {
                                "target_lang_word": "оценить",
                                "target_lang_sense_clarification": "результат определения ценности или качества"
                            },
                            {
                                "target_lang_word": "проанализировать",
                                "target_lang_sense_clarification": "тщательно изучить для вывода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b28ff58-c168-3bab-ae6c-4e0b056a8df2",
                    "sense_definition": "To calculate or determine the numerical value of a mathematical expression or function.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were asked to <w>evaluate</w> this integral as part of their final exam.",
                            "target_lang_translations": {
                                "ru": "Студентов попросили <w>вычислить</w> этот интеграл в рамках выпускного экзамена."
                            }
                        },
                        {
                            "text": "You must <w>evaluate</w> the expression for x equals five to find the correct answer.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>найти значение</w> выражения при x равном пяти, чтобы найти правильный ответ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evaluate the expression",
                        "evaluate the integral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять или определять числовое значение математического выражения или функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычислять",
                                "target_lang_sense_clarification": "находить значение выражения"
                            },
                            {
                                "target_lang_word": "вычислить",
                                "target_lang_sense_clarification": "найти значение выражения (результат)"
                            },
                            {
                                "target_lang_word": "находить значение",
                                "target_lang_sense_clarification": "в математическом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f8046cb-f894-3765-8d9e-b340baa9020c",
                    "sense_definition": "To result in or have a specific numerical or logical value when processed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this specific case, the entire formula <w>evaluates</w> to a scalar multiple of the identity element.",
                            "target_lang_translations": {
                                "ru": "В данном конкретном случае вся формула <w>принимает значение</w> скалярного кратного единичного элемента."
                            }
                        },
                        {
                            "text": "The code will fail if the condition <w>evaluates</w> to false during the initial check.",
                            "target_lang_translations": {
                                "ru": "Код выдаст ошибку, если условие <w>примет значение</w> «ложь» во время первоначальной проверки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evaluates to zero",
                        "evaluates to true"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать или иметь определенное числовое или логическое значение при обработке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать значение",
                                "target_lang_sense_clarification": "о результате вычисления формулы или кода"
                            },
                            {
                                "target_lang_word": "равняться",
                                "target_lang_sense_clarification": "быть равным какому-то значению"
                            },
                            {
                                "target_lang_word": "давать результат",
                                "target_lang_sense_clarification": "в логических операциях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}