                        "target_lang_word": "knack",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knack",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e917e1e6-0595-391e-9a41-68d35944425f",
                                        "entry_id": "49e0ca89-db21-3f03-b965-0309acfe04c1",
                                        "glosses": [
                                            "Saucisse fumée typique de l’Alsace, à base de viande de porc, au gout fumé."
                                        ],
                                        "tags": [
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ebd086-87c3-4862-af15-d81c9c0bba22",
                                                "sense_id": "e917e1e6-0595-391e-9a41-68d35944425f",
                                                "text": "Ma mère adorait la préparer et s’acharnait à me faire changer d’avis: « Mange au moins une knack » était son leitmotiv."
                                            },
                                            {
                                                "example_id": "61c417af-7768-451a-b603-8e818d2f119f",
                                                "sense_id": "e917e1e6-0595-391e-9a41-68d35944425f",
                                                "text": "On mange souvent les knacks avec de la moutarde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae88562d-5a30-4c68-a085-7e7721876fd0",
                        "source_entry_id": "c9772b37-6c79-3aeb-914e-9a4ca4e81aea",
