                "senses": [
                    {
                        "sense_id": "23c966af-8a1a-3b31-aae3-52782bd3200a",
                        "entry_id": "a754aada-5cd9-3629-bd0b-45b84cf85d53",
                        "glosses": [
                            "bijzonder heftig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5468a161-1bc3-4c90-a9b4-ac44f83c36a5",
                                "sense_id": "23c966af-8a1a-3b31-aae3-52782bd3200a",
                                "text": "Er stond een razende storm."
                            }
                        ]
                    },
                    {
                        "sense_id": "53ed6a62-145d-38ed-b705-5c2fc5933ef8",
                        "entry_id": "a754aada-5cd9-3629-bd0b-45b84cf85d53",
                        "glosses": [
                            "bijzonder boos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab7aebe-0785-4328-98c7-9dbf3ad10a47",
                                "sense_id": "53ed6a62-145d-38ed-b705-5c2fc5933ef8",
                                "text": "Hij werd razend toen hij dat hoorde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3659487-ae82-4ab1-99b0-98c36c1691e2",
                        "source_entry_id": "a754aada-5cd9-3629-bd0b-45b84cf85d53",
                        "source_sense_id": "23c966af-8a1a-3b31-aae3-52782bd3200a",
                        "source_sense_description": "bijzonder heftig",
                        "target_lang_word": "frenetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frenetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e18aa669-52c0-3c78-a0a5-9b004454b1fc",
                                        "entry_id": "dc7a8665-cae9-3c48-b663-009f4391b32a",
                                        "glosses": [
                                            "mit größter Begeisterung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43452ba4-af4b-4f6d-9266-4eafd92168bb",
                                                "sense_id": "e18aa669-52c0-3c78-a0a5-9b004454b1fc",
                                                "text": "adjektivisch: Wegen der frenetischen Zuschauer musste das Spiel abgebrochen werden."
                                            },
                                            {
                                                "example_id": "3c034f23-d2d5-420b-8c2c-0b1ed83bc37f",
                                                "sense_id": "e18aa669-52c0-3c78-a0a5-9b004454b1fc",
                                                "text": "„Hitler konnte sich zwar nicht mehr auf das Gottesgnadentum berufen, an dessen Stelle trat nun sein übersteigertes Selbstbewusstsein in Verbindung mit der frenetischen Zustimmung einer übergroßen Mehrheit der Deutschen.“"
                                            },
                                            {
                                                "example_id": "b3d1192c-519b-48ba-905a-9ccdc7d22e9c",
                                                "sense_id": "e18aa669-52c0-3c78-a0a5-9b004454b1fc",
                                                "text": "adverbial: Die Menge jubelte frenetisch."
                                            },
                                            {
                                                "example_id": "a0c19c6c-7802-4a9c-91c9-03d44f49882c",
                                                "sense_id": "e18aa669-52c0-3c78-a0a5-9b004454b1fc",
                                                "text": "adverbial: „Frenetisch, einfach unglaublich frenetisch!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
