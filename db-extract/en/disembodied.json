                                ]
                            },
                            {
                                "target_word": "désincarné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d231fe9f-c704-3ef1-8ca3-c66daaeec2ae",
                                        "entry_id": "e2c86e56-d1a3-30b3-bc00-91fa267c1b99",
                                        "glosses": [
                                            "Qui existe hors de toute manifestation humaine et personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7459b14-5f9a-446a-b89a-711636ee2f27",
                                                "sense_id": "d231fe9f-c704-3ef1-8ca3-c66daaeec2ae",
                                                "text": "Mais le dérapage de l’Europe ne provient pas d'une dynamique propre à l’État, machine désincarnée. Les États ne deviennent fous que parce que les hommes qui les constituent, les dominent ou les construisent sont largement psychotiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca3173e1-26e3-3bd6-b7be-29f33410bb9e",
                                        "entry_id": "e2c86e56-d1a3-30b3-bc00-91fa267c1b99",
                                        "glosses": [
                                            "Qui existe hors du monde physique, concret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd906b64-b446-437d-a719-63f1565198eb",
                                                "sense_id": "ca3173e1-26e3-3bd6-b7be-29f33410bb9e",
                                                "text": "Tout semble abstrait, voire désincarné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed24672d-d5b9-407b-930e-12b78a56d719",
                        "source_entry_id": "fdc2b47b-47af-3e5f-b237-95145f0a3b7a",
