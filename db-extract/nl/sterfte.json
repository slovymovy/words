                "senses": [
                    {
                        "sense_id": "8b85af9d-182a-39ec-acbf-1518d0e2ab16",
                        "entry_id": "0835cddc-22c9-35a7-bf64-1b733bd0ea2a",
                        "glosses": [
                            "het aantal sterfgevallen in een bepaalde tijd of in bepaalde omstandigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd457280-2676-475d-ae09-8a18afb45d2d",
                                "sense_id": "8b85af9d-182a-39ec-acbf-1518d0e2ab16",
                                "text": "Er was dit jaar een zorgbarend hoog percentage verloskundige sterfte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aea15b68-3e58-43c8-87cb-13d48b20efd9",
                        "source_entry_id": "0835cddc-22c9-35a7-bf64-1b733bd0ea2a",
                        "source_sense_id": "8b85af9d-182a-39ec-acbf-1518d0e2ab16",
                        "source_sense_description": "het aantal sterfgevallen in een bepaalde tijd of in bepaalde omstandigheden",
                        "target_lang_word": "Sterblichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sterblichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                        "entry_id": "a9aa09c9-3e62-3f7c-992f-ddbfb37621ad",
                                        "glosses": [
                                            "die Eigenschaft, (irgendwann) zu sterben bzw. sterben zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a8ffc5-e3c3-4160-aa8a-ae5d9e1cf98c",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "Die Sterblichkeit gehört zum Menschsein dazu."
                                            },
                                            {
                                                "example_id": "15bbbfee-080d-4b62-bf56-8badcf4f9c8c",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "„Er hatte aus den Tiefen der sonnengetränkten Antike eine Lebenshaltung erneuern wollen, die sich auf heroische Weise der eigenen Sterblichkeit entgegenzustemmen sucht.“"
                                            },
                                            {
                                                "example_id": "7312643b-3569-46e9-ad53-6a272cda4f59",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "„Sisis Tod erinnert sie an die eigene Sterblichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                        "entry_id": "a9aa09c9-3e62-3f7c-992f-ddbfb37621ad",
                                        "glosses": [
                                            "Sterberate"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fc210ee-f05a-42f6-8f53-fba91f42c891",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "Die Sterblichkeit bei dieser Krankheit ist sehr hoch."
                                            },
                                            {
                                                "example_id": "864e462a-31a3-4eb6-8ff4-54d27953ba35",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Hunger, Kälte, mangelnde Hygiene und die damit verbundenen Epidemien führten zu einer hohen Sterblichkeit unter den Deutschen.“"
                                            },
                                            {
                                                "example_id": "77d75b28-3eb0-4db8-afa8-710a43be3647",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Um 1880 liegt die Sterblichkeit unter den Frauen und Kindern der in Indien stationierten britischen Soldaten dreimal so hoch wie im Heimatland.“"
                                            },
                                            {
                                                "example_id": "c62384f3-3de5-4008-85da-f37ba4d9d7f4",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Seit die Ärzte dort Blut sparen, sanken in vier großen Kliniken die Sterblichkeit sowie die Häufigkeit von Schlaganfällen und Herzinfarkten ebenfalls um je ein Drittel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dacd2591-6474-4178-a985-4cfce995fc79",
                        "source_entry_id": "0835cddc-22c9-35a7-bf64-1b733bd0ea2a",
                        "source_sense_id": "8b85af9d-182a-39ec-acbf-1518d0e2ab16",
                        "source_sense_description": "het aantal sterfgevallen in een bepaalde tijd of in bepaalde omstandigheden",
                        "target_lang_word": "Mortalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mortalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca54df28-3987-32bc-bac8-e134174a4e87",
                                        "entry_id": "0708de39-1553-3a14-a80d-f5a4794388eb",
                                        "glosses": [
                                            "Zahl der in einem bestimmten Zeitraum (in der Regel ein Kalenderjahr) Gestorbenen je 1.000 der Bevölkerung"
                                        ],
                                        "tags": [
                                            "Demografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d29cc8-139c-4df4-b795-572d04ced18f",
                                                "sense_id": "ca54df28-3987-32bc-bac8-e134174a4e87",
                                                "text": "„Ziel der Krankheitsprävention […] ist die Vermeidung des Auftretens von Krankheiten und damit die Verringerung ihrer Verbreitung und die Verminderung ihrer Auswirkungen auf Morbidität und Mortalität der Bevölkerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4731c000-99d1-46f5-923b-40c6a67cf1b7",
                        "source_entry_id": "0835cddc-22c9-35a7-bf64-1b733bd0ea2a",
                        "source_sense_id": "8b85af9d-182a-39ec-acbf-1518d0e2ab16",
                        "source_sense_description": "het aantal sterfgevallen in een bepaalde tijd of in bepaalde omstandigheden",
                        "target_lang_word": "mortality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "The state or quality of being mortal.",
                                            "The state of being susceptible to death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d7c3279-605e-4d4a-9e65-139a2b4d9f3c",
                                                "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                                "text": "[H]er minde remembreth her mortalitie, / vvhat ſo is fayreſt ſhall to earth returne."
                                            },
                                            {
                                                "example_id": "525cfcde-9d76-4798-a757-506257748706",
                                                "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                                "text": "Since brass, nor stone, nor earth, nor boundless sea, / But sad mortality o’er-sways their power, / How with this rage shall beauty hold a plea, / Whose action is no stronger than a flower?"
                                            },
                                            {
                                                "example_id": "d3ccaa5c-1b57-4f46-a539-ce04c2a32c07",
                                                "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                                "text": "1714, Alexander Pope, letter to John Gay in Letters of Mr. Pope, and Several Eminent Persons, London, 1735, Volume 2, p. 208,\nI have been perpetually troubled with sickness of late, which has made me so melancholy that the Immortality of the Soul has been my constant Speculation, as the Mortality of my Body my constant Plague."
                                            },
                                            {
                                                "example_id": "f67127d5-0f0b-46ee-aa92-80322cfefb1c",
                                                "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                                "text": "“[…] Thy sense is clogg’d with dull mortality; / They spirit fetter’d with the bond of clay: / Open thine eyes and see.”"
                                            },
                                            {
                                                "example_id": "e9b2aa2e-46f6-485a-bab0-bc0caf687b1f",
                                                "sense_id": "64279822-e250-351f-8642-c0f3cc29087b",
                                                "text": "But on that onerous day [of the funeral], oppressed beyond relief, my own mortality was borne in upon me on sluggish tides of doom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e572b067-4808-32be-92c7-bfc0a9623658",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "The state or quality of being mortal.",
                                            "The quality of being punishable by death."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eadfcf3-a596-470d-9347-adab2bdc585d",
                                                "sense_id": "e572b067-4808-32be-92c7-bfc0a9623658",
                                                "text": "[…] actions of Charity do alleviate, as I may say, and take off from the Mortality of the Sin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bfc2ef-e59d-3160-822d-f7ffe040528b",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "The state or quality of being mortal.",
                                            "The quality of causing death."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0a175b-80d1-43c9-96ba-c96213277abf",
                                                "sense_id": "e9bfc2ef-e59d-3160-822d-f7ffe040528b",
                                                "text": "Hold therefore Angelo: / In our remoue, be thou at full, our selfe: / Mortallitie and Mercie in Vienna / Liue in thy tongue, and heart: Old Escalus / Though first in question, is thy secondary. / Take thy Commission."
                                            },
                                            {
                                                "example_id": "364a7142-3391-4241-9d0e-4219ba764fd8",
                                                "sense_id": "e9bfc2ef-e59d-3160-822d-f7ffe040528b",
                                                "text": "1685, Thomas Willis, Tract of Fevers, Chapter 15, in The London Practice of Physick, London: Thomas Basset and William Crooke, p. 626,\n[…] the Fevers of Women in Child-bed; to wit, both the Lacteal, and that called Putrid, which, by reason of its Mortality, deserves to be call’d Malignant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9209bc-995e-36da-8c97-70cd8bb63274",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "The number of deaths; and, usually and especially, the number of deaths per time unit (usually per year), expressed as a rate.",
                                            "Deaths resulting from an event (such as a war, epidemic or disaster)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3cf4257-5a40-44ac-9d57-0f79400254e2",
                                                "sense_id": "4f9209bc-995e-36da-8c97-70cd8bb63274",
                                                "text": "[…] the Mortality was so great in the Yard or Alley, that there was no Body left to give Notice to the Buriers or Sextons, that there were any dead Bodies there to be bury’d."
                                            },
                                            {
                                                "example_id": "11cdf1a3-01e9-4cd0-9050-dfdca1af64a3",
                                                "sense_id": "4f9209bc-995e-36da-8c97-70cd8bb63274",
                                                "text": "[…] the doctors stood aghast at the swift mortality among the untended sufferers […]"
                                            },
                                            {
                                                "example_id": "31e2b098-9103-488c-a957-a93310a40f6b",
                                                "sense_id": "4f9209bc-995e-36da-8c97-70cd8bb63274",
                                                "text": "The Great Frost was, historians tell us, the most severe that has ever visited these islands. Birds froze in mid air and fell like stones to the ground. […] The mortality among sheep and cattle was enormous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "The number of deaths; and, usually and especially, the number of deaths per time unit (usually per year), expressed as a rate.",
                                            "The number of deaths per given unit of population over a given period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28303428-de07-41e5-b1a2-49e0602bb89a",
                                                "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                                "text": "In foundling hospitals, and among the children brought up by parish charities the mortality is still greater than among those of the common people."
                                            },
                                            {
                                                "example_id": "d2d280f1-11a0-437a-ad17-579d9948013e",
                                                "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                                "text": "Some of the objects of enquiry would be […] what was the comparative mortality among the children of the most distressed part of the community, and those who lived rather more at their ease […]"
                                            },
                                            {
                                                "example_id": "4a8a8ae5-b93e-4cbf-b134-01796792c64f",
                                                "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                                "text": "And, even in peace and at home, what was the sanitary condition of the Army? The mortality in the barracks was, she found, nearly double the mortality in civil life."
                                            },
                                            {
                                                "example_id": "0ef0a00e-905b-4597-8dad-bbbc612d07e7",
                                                "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                                "text": "[…] a drought year brought conditions especially favorable to the beetle and the mortality of elms went up 1000 per cent."
                                            },
                                            {
                                                "example_id": "65812b05-608d-48d3-8123-60bc07862564",
                                                "sense_id": "6e3c6944-1233-36c3-a827-91b50c8d7db0",
                                                "text": "By studying mortality rates and pollution statistics in 90 Chinese cities, researchers from the Massachusetts Institute of Technology, Israel and China discovered that air pollution from burning coal in north China, defined as above the Huai River, with a population of around 500 million people, was 55% higher than in the south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "Death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92766312-c320-4a25-8657-dbbc7a63fdf9",
                                                "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                                                "text": "Why am I mockt with death, and length’nd out / To deathless pain? how gladly would I meet / Mortalitie my sentence, and be Earth / Insensible,"
                                            },
                                            {
                                                "example_id": "73b6db00-0782-46c0-816d-3ad84bfd6a97",
                                                "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                                                "text": "Learn to bear your Husband’s Death like a reasonable Woman. ’Tis not the fashion, now-a-days so much as to affect Sorrow upon these Occasions. No Woman would ever marry, if she had not the Chance of Mortality for a Release."
                                            },
                                            {
                                                "example_id": "cd5942ad-1420-4b94-a1e8-8b3d40486064",
                                                "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                                                "text": "[…] like a sexton delving into a grave, possibly in quest of a jewel that had been buried on the dead man’s bosom, but likely to find nothing save mortality and corruption."
                                            },
                                            {
                                                "example_id": "9f638890-4c8c-4a0b-9c08-d5e8299d1586",
                                                "sense_id": "b8a364eb-5386-3499-b8b2-bffb1c17d20b",
                                                "text": "[…] the moldy odor of mortality hung wet in the air with the sulphurous fog […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca7fa5d1-2952-3557-ba30-951e6344d250",
                                        "entry_id": "ce0a0146-1248-3db0-89fb-007e7c6ca4f5",
                                        "glosses": [
                                            "Mortals collectively."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55555cd7-02d3-4b5a-b826-67eb6ab22eba",
                                                "sense_id": "ca7fa5d1-2952-3557-ba30-951e6344d250",
                                                "text": "It is not fit Mortalitie should knowe / What his eternall prouidence decreed,"
                                            },
                                            {
                                                "example_id": "0714a26b-2565-4e26-972c-56ddeff6f148",
                                                "sense_id": "ca7fa5d1-2952-3557-ba30-951e6344d250",
                                                "text": "[S]leepe seiz’d his weary eye, / That salues all care, to all mortality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03e9060e-4ba3-4aa5-b7a0-52a31d8c0f45",
