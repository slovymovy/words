                                "target_senses": [
                                    {
                                        "sense_id": "253b966d-9ab9-385b-96d5-847f226d34e7",
                                        "entry_id": "351dbd29-e01f-3cff-9e95-523b2af77d6e",
                                        "glosses": [
                                            "Rendre sain."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb8fc68-5cd3-44d8-a099-eadeaac8f7e4",
                                                "sense_id": "253b966d-9ab9-385b-96d5-847f226d34e7",
                                                "text": "Du devoir pour les municipalités d'assainir les quartiers insalubres des villes manufacturières."
                                            },
                                            {
                                                "example_id": "105d62c0-8819-4536-86ac-a1c858bd706d",
                                                "sense_id": "253b966d-9ab9-385b-96d5-847f226d34e7",
                                                "text": "Après son départ, j’assainissais moi-même la partie de ma table où ses coudes s’étaient posés, en l’essuyant avec des serviettes que j’allais ensuite clandestinement porter au linge sale."
                                            },
                                            {
                                                "example_id": "80048ee4-e4a6-496c-83b3-ee1a111f5674",
                                                "sense_id": "253b966d-9ab9-385b-96d5-847f226d34e7",
                                                "text": "Habituellement les terrains mouilleux qu'on veut planter sont assainis au préalable et le creusement des fossés de drainage set à faire des buttes ou des remblais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b29ff3-4bba-37b7-98f7-d02048f35dea",
                                        "entry_id": "351dbd29-e01f-3cff-9e95-523b2af77d6e",
                                        "glosses": [
                                            "Rendre acceptable, décent, rééquilibrer, stabiliser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e769dffa-03db-4158-8d01-a0bdf29768d5",
                                                "sense_id": "46b29ff3-4bba-37b7-98f7-d02048f35dea",
                                                "text": "Assainir avant tout les mœurs des gens, et celles des institutions de l’État, mais également surveiller la salubrité matérielle de la cité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cffe035-3032-3c80-9c8c-57c99302ed86",
                                        "entry_id": "351dbd29-e01f-3cff-9e95-523b2af77d6e",
                                        "glosses": [
                                            "Rendre acceptable, décent, rééquilibrer, stabiliser.",
                                            "Débarrasser un outil financier de ses effets pervers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84357992-4f6c-46aa-890a-9ae54d63380a",
                                                "sense_id": "9cffe035-3032-3c80-9c8c-57c99302ed86",
                                                "text": "Pour Assainir les finances publiques, il faudrait s’attaquer au cœur du problème, qui réside partiellement dans les relations budgétaires entre les différents niveaux d’administration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
