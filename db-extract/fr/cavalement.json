                "entry_id": "22ca57e7-7e2d-3f20-b00e-148f7ffe4c1f",
                "word": "cavalement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "351c9297-290b-4dce-bd23-a0074ab53ef0",
                        "entry_id": "22ca57e7-7e2d-3f20-b00e-148f7ffe4c1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cavalements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
                        "entry_id": "22ca57e7-7e2d-3f20-b00e-148f7ffe4c1f",
                        "glosses": [
                            "Mouvement longitudinal d’un navire qui le fait reculer ou avancer à cause du choc des vagues ou de bourrasques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fb22b6-3231-4558-b952-e86cf5743fb8",
                                "sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
                                "text": "Le cavalement est Un des six degrés de liberté d’un corps libre en mouvement, les autres étant l’embardée, le pilonnement, le lacet, le tangage et le roulis."
                            },
                            {
                                "example_id": "2ca063a2-d6ed-47f6-b824-f9f6922e03bf",
                                "sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
                                "text": "Le cavalement est simplement un mouvement du bateau d’avant en arrière et plus rarement d’arrière en avant."
                            },
                            {
                                "example_id": "9998b41c-30f1-49ea-ba56-3134a179151b",
                                "sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
                                "text": "Quelques plongées plus tard, Rauno remarque que même dans des mers calmes, les vagues créent des courants très puissants qui provoquent ce que les hydrologues nomment un mouvement de «cavalement» en parlant d’un navire."
                            },
                            {
                                "example_id": "063af3d8-33ca-43e8-a220-73cf45c51d76",
                                "sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
                                "text": "Grâce aux quatre caméras qui entourent le bassin, l’équipe d’Ifremer filme et mesure les mouvements des deux objets (roulis, tangage, lacet, cavalement, embardée, pilonnement)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52ffb0c3-42e5-49b1-9b72-adecd94a8881",
                        "source_entry_id": "22ca57e7-7e2d-3f20-b00e-148f7ffe4c1f",
                        "source_sense_id": "56acdb8b-10d6-3b23-80c3-e29a86a4a387",
