                "senses": [
                    {
                        "sense_id": "32d14936-b089-3635-8061-8dcca11bb346",
                        "entry_id": "f19be639-4fac-32ff-95d6-1fdd6ad8c023",
                        "glosses": [
                            "Wolle, die von Schafen gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6eca17-731f-487c-9e90-b4ac2b49990a",
                                "sense_id": "32d14936-b089-3635-8061-8dcca11bb346",
                                "text": "„Dicke, mit Schafwolle gefüllte Filzkissen sollen das Gebäude gut dämmen, mit seinem modularen Aufbau soll eine Basiseinheit bei Bedarf jederzeit erweitert werden können.“"
                            },
                            {
                                "example_id": "61568872-3b60-4655-b024-32548be2bdf2",
                                "sense_id": "32d14936-b089-3635-8061-8dcca11bb346",
                                "text": "„Außerdem wird Zucht betrieben und die Schafwolle verkauft.“"
                            },
                            {
                                "example_id": "331fbfda-dd50-4cd8-8309-e504290d806d",
                                "sense_id": "32d14936-b089-3635-8061-8dcca11bb346",
                                "text": "„Am liebsten hätte ich verwaschenes blaues Zeug an, einen Troyer aus Schafwolle, Sabots an den Füßen, einen Speckdeckel von Baskenmütze auf dem Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
