                "senses": [
                    {
                        "sense_id": "4bcc0f76-c7a4-3fb1-9414-4fd2a5390af9",
                        "entry_id": "252706e0-4fc0-363b-8c39-2911363851a4",
                        "glosses": [
                            "Rendre (une matrice) triangulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2261f794-9ea6-4892-810d-75f35ded701a",
                                "sense_id": "4bcc0f76-c7a4-3fb1-9414-4fd2a5390af9",
                                "text": "Une première étape sera de triangulariser la matrice A étudiée afin de faire apparaître sur la diagonale principale les racines de l’équation caractéristique avec leur ordre de multiplicité."
                            },
                            {
                                "example_id": "4db0f387-21b1-41de-b4b2-277c515257c2",
                                "sense_id": "4bcc0f76-c7a4-3fb1-9414-4fd2a5390af9",
                                "text": "L’utilisation systématique de ces matrices permet aisément de triangulariser la matrice L(p) en utilisant un algorithme proposé par E. Polak (cf. réf. 2.12)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c06b7092-3f00-36e6-a0e0-06e2699896c3",
                        "entry_id": "252706e0-4fc0-363b-8c39-2911363851a4",
                        "glosses": [
                            "Faire intervenir un troisième paramètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34915462-121f-41a7-95ca-08bfcfb8b692",
                                "sense_id": "c06b7092-3f00-36e6-a0e0-06e2699896c3",
                                "text": "Il faudrait cependant triangulariser cette influence avec l’importance du catholicisme et de l’hindouisme."
                            }
                        ]
                    }
                ],
