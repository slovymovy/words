                        "glosses": [
                            "Débarrasser une substance des cendres qu’elle contient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b7c82f-be9d-4512-beff-19d64512add9",
                                "sense_id": "2ddcee2e-9bb8-3fc0-8e16-21a4036f006e",
                                "text": "Si on veut la cokéfier, elle risque de tomber en poussière, surtout si on l’a décendrée."
                            }
                        ]
