                "senses": [
                    {
                        "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                        "entry_id": "751f60f5-8845-3afe-8fc0-b870b32a61fa",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Semiotik beschäftigt"
                        ],
                        "tags": [
                            "Semiotik"
                        ],
                        "examples": [
                            {
                                "example_id": "b5ea1bb9-8fda-4e4d-92b1-85a30ff22de2",
                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                "text": "Der US-amerikanische Semiotiker Charles W. Morris teilt die Semiotik grundlegend in Syntaktik, Semantik und Pragmatik ein."
                            },
                            {
                                "example_id": "70312cd8-12dc-4218-a1f7-ca7976fcbcb0",
                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                "text": "„Semiotikerinnen und Semiotiker fragen allgemein danach, was alles Zeichen sein kann, nach den Ordnungen und Strukturen von Zeichensystemen, den verschiedenen Funktionen und Gebrauchsweisen von Zeichen, nach ihrer Materialität, Medialität, Performativität und Ästhetik sowie nach den Beziehungen zwischen verschiedenen Zeichensystemen und Medien.“"
                            },
                            {
                                "example_id": "dbd7476c-79a9-4067-a7c4-87358265eb12",
                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                "text": "„Walter A. Koch (* 26. Juli 1934 in Hamm) ist ein deutscher Semiotiker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
