                            {
                                "example_id": "b16084f8-37f7-45c4-843d-b5d3d841cb65",
                                "sense_id": "84c9d353-08df-3f19-8970-8aae9d4c45cb",
                                "text": "Wesel liegt im Westen Deutschlands, unweit der niederländischen Grenze."
                            },
                            {
                                "example_id": "33aea5f5-85d2-470b-a8de-c6613c542064",
                                "sense_id": "84c9d353-08df-3f19-8970-8aae9d4c45cb",
                                "text": "„Alle hatten bereits erfahren, ich weiß nicht wie, daß sie von Wesel bis Hannover mit mir gefahren war.“"
