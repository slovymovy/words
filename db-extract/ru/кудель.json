                        "entry_id": "00b6551e-feea-3679-8016-d933b0717e16",
                        "glosses": [
                            "спец. пучок, волокна льна, пеньки, шерсти и т. п., приготовленные для прядения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a906f04e-7dca-4500-8ef2-2cf90c4b4433",
                                "sense_id": "0cc1ec8a-4083-34c3-8d57-016b9cbefc4e",
                                "text": "Соберется эдак женщин шесть, сидят около зажженной лучины, прядут кудель, что-нибудь говорят или песни поют."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e268a6a7-48fa-4af2-91c6-277cd1faa802",
                        "source_entry_id": "00b6551e-feea-3679-8016-d933b0717e16",
                        "source_sense_id": "0cc1ec8a-4083-34c3-8d57-016b9cbefc4e",
                        "target_lang_word": "tow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2774cdc-8194-3404-87dc-2483375092c6",
                                        "entry_id": "5cb116ce-cdb2-3d83-adee-78ba0cf8f9a8",
                                        "glosses": [
                                            "To pull something behind one, such as by using a line, chain, or tongue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f86be0fa-c453-432a-80f7-a40512bddb9b",
                                                "sense_id": "e2774cdc-8194-3404-87dc-2483375092c6",
                                                "text": "Near-synonyms: draw, haul, pull, trail"
                                            },
                                            {
                                                "example_id": "02debd0a-d288-4c90-a306-7fc639670e9e",
                                                "sense_id": "e2774cdc-8194-3404-87dc-2483375092c6",
                                                "text": "In its current specification it cannot be driven and must be towed to its work location by a locomotive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34a70040-44b4-37d4-b12c-858efec0fed0",
                                        "entry_id": "5cb116ce-cdb2-3d83-adee-78ba0cf8f9a8",
                                        "glosses": [
                                            "To aid someone behind by shielding them from wind resistance."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1f8415-0f1b-3f47-85c9-d1e2a3f424ad",
                                        "entry_id": "d2f8742b-57eb-3c6d-96b6-0e2feac2b10d",
                                        "glosses": [
                                            "The act of towing and the condition of being towed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddb64b5-e9a3-4971-a83c-70aebe33a9ea",
                                                "sense_id": "ab1f8415-0f1b-3f47-85c9-d1e2a3f424ad",
                                                "text": "It isn't the car's battery; I think I need a tow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0672748-52d7-35c6-973e-eba89f640c24",
                                        "entry_id": "d2f8742b-57eb-3c6d-96b6-0e2feac2b10d",
                                        "glosses": [
                                            "Something, such as a tugboat, that tows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b22a5d75-6677-3b46-b5de-56d094095091",
                                        "entry_id": "d2f8742b-57eb-3c6d-96b6-0e2feac2b10d",
                                        "glosses": [
                                            "Something, such as a barge, that is towed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8eb67e5c-c5ee-3f77-84d6-da6889e0f22a",
                                        "entry_id": "d2f8742b-57eb-3c6d-96b6-0e2feac2b10d",
                                        "glosses": [
                                            "A rope or cable used in towing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99e191e0-471f-37d8-adc4-35e4ec2fa6ae",
                                        "entry_id": "d2f8742b-57eb-3c6d-96b6-0e2feac2b10d",
                                        "glosses": [
                                            "A speed increase given by driving in front of another car on a straight, which causes a slipstream for the car behind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764c9d52-f179-4561-ab17-06579804f8b1",
                                                "sense_id": "99e191e0-471f-37d8-adc4-35e4ec2fa6ae",
                                                "text": "On Saturday, Vettel was very unhappy with Leclerc's failure to work out a way through the traffic and give him a tow for the second runs in qualifying, as had been agreed."
                                            }
                                        ]
                                    }
                                ]
                            },
