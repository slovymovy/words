                "senses": [
                    {
                        "sense_id": "ae5358b3-5f33-3cf4-b28b-d3c38f9a55f5",
                        "entry_id": "42ee98f4-c25a-3ee3-8157-4fc86d350b89",
                        "glosses": [
                            "international gültige Telefonkarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a1fadc-dba3-4567-ab2f-da327e52e064",
                                "sense_id": "ae5358b3-5f33-3cf4-b28b-d3c38f9a55f5",
                                "text": "Für den Afrikaurlaub habe ich mir eine Callingcard gekauft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28d558ba-016f-3b6a-a954-f717dae71af0",
                        "entry_id": "42ee98f4-c25a-3ee3-8157-4fc86d350b89",
                        "glosses": [
                            "Kärtchen, auf dem persönliche Daten vermerkt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab8c4e4-fa44-4a77-a821-c2c3bc35c96b",
                                "sense_id": "28d558ba-016f-3b6a-a954-f717dae71af0",
                                "text": "Falls Sie noch Fragen haben, lasse ich ihnen meine Callingcard mit meiner Telefonnummer da."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba613f63-1ec3-4dc7-9a0c-3cd98f7658d1",
                        "source_entry_id": "42ee98f4-c25a-3ee3-8157-4fc86d350b89",
                        "source_sense_id": "ae5358b3-5f33-3cf4-b28b-d3c38f9a55f5",
                        "source_sense_description": "international gültige Telefonkarte",
                        "target_lang_word": "calling card",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calling card",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff31cc21-112e-3bf0-a04a-83a7923961bd",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "A small printed card which identifies the bearer, traditionally presented for introduction when making a social visit to a home or when attending a formal social event or business meeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e96747-d30f-4ba2-b1f0-ca66287790ea",
                                                "sense_id": "ff31cc21-112e-3bf0-a04a-83a7923961bd",
                                                "text": "If Mrs. Nelson does come here, you be sure to put on your white apron before you open the door; and for pity sake don't forget the card-tray! You ought to know better than to stick out your hand for a lady's calling-card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22797757-00d7-3ed1-b6fe-acee05189df2",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "An attribute, symptom, object, or behavior which is distinctly characteristic of someone or something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d6c9b7-e5ea-48b9-8b1f-7fae91444066",
                                                "sense_id": "22797757-00d7-3ed1-b6fe-acee05189df2",
                                                "text": "Free and slightly funky chamber music is the calling card of this festival."
                                            },
                                            {
                                                "example_id": "ba479cf5-2259-42ec-a442-bb36cdea8615",
                                                "sense_id": "22797757-00d7-3ed1-b6fe-acee05189df2",
                                                "text": "The poisoning also turned Novichok into something of a Russian calling card."
                                            },
                                            {
                                                "example_id": "008de631-cd70-4c77-9bc4-f918cc83e0ed",
                                                "sense_id": "22797757-00d7-3ed1-b6fe-acee05189df2",
                                                "text": "She didn’t set out to make candor her calling card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8522410-21e8-30a1-90c5-ab64bcda545d",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "Excrement, especially of a domestic animal."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdbbe167-ccd1-4d80-976e-3bc2a1084a1c",
                                                "sense_id": "f8522410-21e8-30a1-90c5-ab64bcda545d",
                                                "text": "A guide dog left his calling card on the court at Tuesday night's Magic-Pistons game in Orlando."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4d6e2b9-728c-315d-84ac-c2f621139577",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "A phonecard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6de46e-7181-4acb-8bcc-93eb833c50ee",
                                                "sense_id": "d4d6e2b9-728c-315d-84ac-c2f621139577",
                                                "text": "Many experts now advise consumers to use a prepaid calling card to save money on long distance calls while staying in a hotel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c617852-fe33-3a13-b9fe-d687aee57d42",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "A card advertising the services of a prostitute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "093c3817-f760-38e6-9fc0-a964455bce7f",
                                        "entry_id": "1d3111d7-bc61-3fd3-b0e8-40fbe5f44eaf",
                                        "glosses": [
                                            "An explosive dropped from a bomber aeroplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
