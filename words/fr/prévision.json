                    "frequency": "Middle",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>prévision</w> météorologique annonce de violents orages dans le sud du pays ce soir."
                        },
                        {
                            "text": "Les économistes ont révisé leur <w>prévision</w> de croissance pour le second semestre."
                        }
                    ],
                    "common_phrases": [
