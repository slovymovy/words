                    {
                        "translation_id": "eedf0ab2-b991-48a6-8d79-1b8f25283b67",
                        "source_entry_id": "52333af1-8a22-3e72-aa12-76c9697ed951",
                        "source_sense_id": "7e1e436c-fc6b-3c79-992a-ac18b6b3049f",
                        "target_lang_word": "prédelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "586f3d74-ce39-39d7-b350-bc98a2d76518",
                                        "entry_id": "4d9f9098-b6a9-379d-ad6b-eb314eef6c2b",
                                        "glosses": [
                                            "Partie inférieure dʼun retable, habituellement divisée en petits panneaux peints ou sculptés, représentant diverses scènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516064c7-9a26-4cd5-9c80-d4ddddccd8b5",
                                                "sense_id": "586f3d74-ce39-39d7-b350-bc98a2d76518",
                                                "text": "Devant la prédelle de Fra Angelico que j'aime tant (alors que le tableau qui la surmonte me paraît confus et sans profondeur) je lui expliquais les différentes scènes dont le sens est loin d'être évident."
                                            },
                                            {
                                                "example_id": "e0afd3bb-2335-4134-b40b-e2574f20ebb3",
                                                "sense_id": "586f3d74-ce39-39d7-b350-bc98a2d76518",
                                                "text": "Les frères convers vont et viennent devant nous dans leurs admirables robes blanches, comme dans la prédelle de Fra Angelico, qui est au Louvre."
                                            },
                                            {
                                                "example_id": "58f9c7dc-d4da-4831-9e93-0f246255ad0c",
                                                "sense_id": "586f3d74-ce39-39d7-b350-bc98a2d76518",
                                                "text": "Mais il arrive que le tableau soit présenté à lʼenvers, le sermon aux oiseaux se trouvant ainsi à gauche : lʼordre chronologique des scènes de la prédelle nʼest alors plus respecté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
