                                    {
                                        "sense_id": "27d6e23d-32b5-3c95-901a-23eeceaaec38",
                                        "entry_id": "b90bc2a5-e846-3dde-8c11-a0041f90c83e",
                                        "glosses": [
                                            "oběšený; muž, který byl popraven či spáchal sebevraždu oběšením a dosud visí nebo je nedávno sňatý"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5addbd41-d610-4e70-b62c-afa3791a7ccf",
                                                "sense_id": "27d6e23d-32b5-3c95-901a-23eeceaaec38",
                                                "text": "Jednoho jitra byl v slavutské modlitebně nalezen oběšenec. Byl to jakýsi Lejzr, opilec nechvalně známý, zaměstnanec tiskárny."
                                            },
                                            {
                                                "example_id": "168c00aa-1822-423c-bc26-6c2eab0348c8",
                                                "sense_id": "27d6e23d-32b5-3c95-901a-23eeceaaec38",
                                                "text": "V obličeji oběšence sedělo sta a sta much… Již silně zaváněl… Ale když jsem poodešel a zmizel mi s očí příšerný zjev oběšence, domohla se komika té události svého práva."
                                            }
                                        ]
                                    }
                                ]
                            }
