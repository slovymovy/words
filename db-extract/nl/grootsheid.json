                            {
                                "example_id": "cfca209e-bf90-4bf6-a9f6-7e6447d1e85e",
                                "sense_id": "ebf7cea4-cc2c-3e9b-8930-6ce027cc5b99",
                                "text": "De deftigheid en de grootsheid van de Oranjes is door de eeuwen heen een stralend voorbeeld geweest voor de Nederlandse adel."
                            },
                            {
                                "example_id": "dea582c9-20ae-442d-b083-141bba76e2dd",
                                "sense_id": "ebf7cea4-cc2c-3e9b-8930-6ce027cc5b99",
                                "text": "De verlepte eetzaal met afgebladderde verf en versleten tapijten getuigde van grootsheid in een andere tijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "c621d278-5354-3a8f-9a7f-3272d45d2971",
                        "entry_id": "f3f04709-64a8-3f52-a4f4-251d769b47ce",
                        "glosses": [
                            "van een hoge morele standaard"
                        ],
                        "tags": [],
                        "examples": [
                            {
