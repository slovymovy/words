                    {
                        "translation_id": "a5bf4b8b-5ab9-488b-beb4-c3a5264e6889",
                        "source_entry_id": "c32ea346-da4f-3f86-b1c5-125a8ad4b389",
                        "source_sense_id": "927afc10-376b-3cd2-be4e-a36c9a4b3f32",
                        "target_lang_word": "мени́ск",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мени́ск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "84c8bef8-e484-3faf-bf9d-f7f003641510",
                                        "entry_id": "9311ae31-6219-3d58-b30f-8c877b9b3e41",
                                        "glosses": [
                                            "опт. вогнуто-выпуклая линза, ограниченная двумя сферическими поверхностями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0752b9-5e95-4f97-ba31-4ecf277a0f0a",
                                                "sense_id": "84c8bef8-e484-3faf-bf9d-f7f003641510",
                                                "text": "В состав многолинзового объектива входит двояковыпуклая линза, два мениска и диафрагма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a23ea4ef-6fc3-3648-8bf3-948183338688",
                                        "entry_id": "9311ae31-6219-3d58-b30f-8c877b9b3e41",
                                        "glosses": [
                                            "физ. искривлённая свободная поверхность жидкости в окрестности её соприкосновения с поверхностью твёрдого тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c357fa53-91b1-467f-9ad2-0fcd6411d020",
                                                "sense_id": "a23ea4ef-6fc3-3648-8bf3-948183338688",
                                                "text": "Ртутный мениск в стеклянном капилляре выпуклый, поскольку ртуть не смачивает стекло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a688dd1-732f-37e1-adc8-f40f29147642",
                                        "entry_id": "9311ae31-6219-3d58-b30f-8c877b9b3e41",
                                        "glosses": [
                                            "анат. структура в форме полумесяца из хрящей и связок в некоторых суставах, частично разделяющая полость сустава"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92cdb086-e6ee-48f1-b30c-c2f331a0ecad",
                                                "sense_id": "5a688dd1-732f-37e1-adc8-f40f29147642",
                                                "text": "Врачи диагностировали у футболиста разрыв мениска."
                                            },
                                            {
                                                "example_id": "2c154348-8854-4e6d-834a-522f46f05390",
                                                "sense_id": "5a688dd1-732f-37e1-adc8-f40f29147642",
                                                "text": "И тут настроение испортилось: пошевелив ногой, почувствовал боль в колене. Болит мениск, а я-то надеялся, что за ночь пройдет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
