                "senses": [
                    {
                        "sense_id": "4b95c7c9-92c7-3f85-8689-946bcbc76bf1",
                        "entry_id": "136f4dac-eb1f-3186-9abc-b321cc3522a4",
                        "glosses": [
                            "związany z rzymskim mówcą i politykiem Cyceronem; taki jak w jego dziełach"
                        ],
                        "tags": [],
