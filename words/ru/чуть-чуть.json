                {
                    "sense_id": "82c7bccf-12a6-305b-97c8-42f8aa6dd369",
                    "sense_definition": "В небольшой степени, немного, совсем чуть-чуть.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Добавь в суп <w>чуть-чуть</w> соли, чтобы он стал вкуснее.",
                            "target_lang_translations": {
                                "nl": "Voeg <w>een beetje</w> zout toe aan de soep zodat hij lekkerder wordt."
                            }
                        },
                        {
                            "text": "Он <w>чуть-чуть</w> опоздал на встречу из-за пробок на дорогах.",
                            "target_lang_translations": {
                                "nl": "Hij was <w>een klein beetje</w> te laat voor de afspraak door de files op de weg."
                            }
                        }
                    ],
                    "synonyms": [
                        "немного",
                        "слегка"
                    ],
                    "antonyms": [
                        "много"
                    ],
                    "common_phrases": [
                        "чуть-чуть подождать",
                        "чуть-чуть добавить"
                    ],
                    "target_lang_definitions": {
                        "nl": "In een kleine mate, een klein beetje."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "een beetje",
                                "target_lang_sense_clarification": "meest algemene vertaling voor een kleine hoeveelheid"
                            },
                            {
                                "target_lang_word": "een klein beetje",
                                "target_lang_sense_clarification": "nadruk op de geringe omvang"
                            },
                            {
                                "target_lang_word": "iets",
                                "target_lang_sense_clarification": "gebruikt in de context van een kleine toevoeging of verandering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5089b1-5b15-35be-9da5-857b68d95f41",
                    "sense_definition": "Усилительное наречие, означающее почти, едва не совершившееся действие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>чуть-чуть</w> не упал, когда поскользнулся на льду.",
                            "target_lang_translations": {
                                "nl": "Ik viel <w>bijna</w> toen ik uitgleed op het ijs."
                            }
                        },
                        {
                            "text": "Мы <w>чуть-чуть</w> не опоздали на последний поезд метро.",
                            "target_lang_translations": {
                                "nl": "We misten <w>bijna</w> de laatste metro."
                            }
                        }
                    ],
                    "synonyms": [
                        "едва",
                        "почти"
                    ],
                    "common_phrases": [
                        "чуть-чуть не"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bijna, net niet, duidt op een actie die bijna plaatsvond."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bijna",
                                "target_lang_sense_clarification": "geeft aan dat iets bijna gebeurde"
                            },
                            {
                                "target_lang_word": "net niet",
                                "target_lang_sense_clarification": "benadrukt dat de actie nipt werd voorkomen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
