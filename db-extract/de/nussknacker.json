                                        "entry_id": "cf99421d-0274-3574-98e9-6d4c948297db",
                                        "glosses": [
                                            "A bootleg mixed drink made from a blend of alcohols and fruit juices."
                                        ],
                                        "tags": [
                                            "New-York-City",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c81982a7-5868-495b-8ea4-3c3f5b1a2996",
                                                "sense_id": "2e6d28d7-c49c-3ba7-b841-a35cabe6ebcd",
                                                "text": "The colorful bottles have popped up every summer in black and Hispanic communities — from the bodegas of Washington Heights to the stoops of Fort Greene — since the early 1990s. On beach boardwalks, at neighborhood basketball courts and block parties, New Yorkers are drinking nutcrackers, boozy homespun cocktails made from a blend of alcohol and fruit juices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af65ba59-87fc-3e64-9d7a-36238053bda0",
                                        "entry_id": "cf99421d-0274-3574-98e9-6d4c948297db",
                                        "glosses": [
                                            "Something that is difficult to figure out; a puzzle."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c50f5a9-f198-4748-b970-a18cab59ed3b",
                                                "sense_id": "af65ba59-87fc-3e64-9d7a-36238053bda0",
                                                "text": "I hadn't been to school for a while so the math was a real nutcracker"
                                            }
                                        ]
                                    }
                                ]
                            }
