                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "597219df-4716-39ed-b7bc-f36d4b96e1f8",
                        "entry_id": "61ec4338-245c-3d65-8bb1-f0544476ef95",
                        "glosses": [
                            "mężczyzna sprzedający przy straganie"
                        ],
                        "tags": [
