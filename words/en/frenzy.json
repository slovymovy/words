{
    "word_family": [
        "frenzied"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3d12177-62bc-3838-b3e1-d418f03a98b7",
                    "sense_definition": "A state of intense, uncontrolled activity or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news report caused a media <w>frenzy</w> among the public.",
                            "target_lang_translations": {
                                "de": "Der Nachrichtenbericht löste einen medialen <w>Rummel</w> in der Öffentlichkeit aus."
                            }
                        },
                        {
                            "text": "She went into a cleaning <w>frenzy</w> before the guests arrived.",
                            "target_lang_translations": {
                                "de": "Sie verfiel vor der Ankunft der Gäste in einen wahren Putz<w>rausch</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hysteria",
                        "mania"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "common_phrases": [
                        "feeding frenzy",
                        "media frenzy"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand intensiver, unkontrollierter Aktivität, Hektik oder Aufregung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rausch",
                                "target_lang_sense_clarification": "Zustand extremer Aktivität oder gesteigerter Erregung"
                            },
                            {
                                "target_lang_word": "Taumel",
                                "target_lang_sense_clarification": "hektischer, fieberhafter Erregungszustand"
                            },
                            {
                                "target_lang_word": "Hysterie",
                                "target_lang_sense_clarification": "überschwängliche oder unkontrollierte Aufregung"
                            },
                            {
                                "target_lang_word": "Wahn",
                                "target_lang_sense_clarification": "blinder Eifer oder hektische Betriebsamkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d5a1a8-2e7a-3f28-bad4-52d33eada03d",
                    "sense_definition": "A state of extreme mental agitation or violent rage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was in a <w>frenzy</w> of anger after hearing the bad news.",
                            "target_lang_translations": {
                                "de": "Er war in einer wahren <w>Raserei</w> vor Wut, nachdem er die schlechte Nachricht gehört hatte."
                            }
                        },
                        {
                            "text": "The artist worked in a creative <w>frenzy</w> for several days.",
                            "target_lang_translations": {
                                "de": "Der Künstler arbeitete mehrere Tage lang in einem kreativen <w>Rausch</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fury",
                        "delirium"
                    ],
                    "antonyms": [
                        "composure"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand extremer geistiger Erregung, Raserei oder heftigen Zorns."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Raserei",
                                "target_lang_sense_clarification": "Zustand völliger Wut oder unkontrollierten Zorns"
                            },
                            {
                                "target_lang_word": "Wut",
                                "target_lang_sense_clarification": "heftiger, unbändiger Ärger"
                            },
                            {
                                "target_lang_word": "Tobsucht",
                                "target_lang_sense_clarification": "heftiger Erregungs- und Wutanfall"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc69ac60-be89-3e6d-aede-c0eeb2ac7960",
                    "sense_definition": "To cause someone to become frantic or wildly excited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud music seemed to <w>frenzy</w> the crowd.",
                            "target_lang_translations": {
                                "de": "Die laute Musik schien die Menge <w>in Raserei zu versetzen</w>."
                            }
                        },
                        {
                            "text": "The constant pressure began to <w>frenzy</w> the exhausted workers.",
                            "target_lang_translations": {
                                "de": "Der ständige Druck begann die erschöpften Arbeiter <w>in den Wahnsinn zu treiben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "agitate",
                        "excite"
                    ],
                    "antonyms": [
                        "soothe"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden in wilde Aufregung oder Raserei versetzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in Raserei versetzen",
                                "target_lang_sense_clarification": "jemanden wild oder unkontrolliert wütend/erregt machen"
                            },
                            {
                                "target_lang_word": "aufstacheln",
                                "target_lang_sense_clarification": "zu wildem Verhalten anstiften"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b856655-c20c-3f08-840b-c72e7f1d1c10",
                    "sense_definition": "To act in a wild or frantic manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharks were <w>frenzying</w> near the surface of the water.",
                            "target_lang_translations": {
                                "de": "Die Haie <w>rasten</w> nahe der Wasseroberfläche <w>herum</w>."
                            }
                        },
                        {
                            "text": "The fish were <w>frenzying</w> around the bait.",
                            "target_lang_translations": {
                                "de": "Die Fische <w>schwirrten wie wild</w> um den Köder <w>herum</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich wild, hektisch oder rasend verhalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rasen",
                                "target_lang_sense_clarification": "sich wie wild gebärden"
                            },
                            {
                                "target_lang_word": "wild durcheinanderwirbeln",
                                "target_lang_sense_clarification": "in hektischer, unkontrollierter Bewegung sein"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc93164e-56a7-3592-9fa6-72f6106b71ec",
                    "sense_definition": "Characterized by wild, frantic, or mad behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>frenzy</w> behavior worried everyone in the room.",
                            "target_lang_translations": {
                                "de": "Sein <w>rasendes</w> Verhalten beunruhigte jeden im Raum."
                            }
                        },
                        {
                            "text": "The <w>frenzy</w> energy of the performance was overwhelming.",
                            "target_lang_translations": {
                                "de": "Die <w>wilde</w> Energie der Aufführung war überwältigend."
                            }
                        }
                    ],
                    "synonyms": [
                        "frantic",
                        "manic"
                    ],
                    "antonyms": [
                        "composed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Gekennzeichnet durch wildes, rasendes oder tollwütiges Verhalten (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rasend",
                                "target_lang_sense_clarification": "wild, unbändig"
                            },
                            {
                                "target_lang_word": "toll",
                                "target_lang_sense_clarification": "wie von Sinnen, verrückt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}