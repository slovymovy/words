                        "target_lang_word": "bail out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bail out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16e0c4d5-d496-3dca-979c-14ec3f3eb660",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To secure the release of an arrested person by providing bail money."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c0afd9b-967b-31da-bb7a-96074510b733",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To remove water from a boat by scooping it out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6237beff-241b-4164-b330-07906cce6072",
                                                "sense_id": "9c0afd9b-967b-31da-bb7a-96074510b733",
                                                "text": "But it passed, leaving us up to our knees in water. 'Bail out! bail out!' shouted Job, suiting the action to the word."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c85f7fb-7f67-3a89-98df-73de587c8c82",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To rescue, especially financially."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb34b6dc-b188-4ce1-aa15-db2d3fdefa3f",
                                                "sense_id": "7c85f7fb-7f67-3a89-98df-73de587c8c82",
                                                "text": "Once again, the industry got itself in trouble and government had to bail it out."
                                            },
                                            {
                                                "example_id": "3a78f3ef-7ee2-4ff1-9e24-5a0dc4b4149d",
                                                "sense_id": "7c85f7fb-7f67-3a89-98df-73de587c8c82",
                                                "text": "Stanning, who was commissioned from Sandhurst in 2008 and has served in Afghanistan, is not the first soldier to bail out the organisers at these Games but will be among the most celebrated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ce0904-d9aa-31c9-ba44-46b5d0458fe0",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To exit an aircraft while in flight."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75643534-e2dd-4f8e-88f3-1672267d471b",
                                                "sense_id": "85ce0904-d9aa-31c9-ba44-46b5d0458fe0",
                                                "text": "Make sure your parachute harness is securely fastened before you bail out!"
                                            },
                                            {
                                                "example_id": "13b71ea7-aa1a-44fa-86de-0c702985bd01",
                                                "sense_id": "85ce0904-d9aa-31c9-ba44-46b5d0458fe0",
                                                "text": "Holmes bailed out of his fighter and parachuted onto an apartment house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47001aa-cea6-3ba1-add1-1485e5d2ed9a",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To leave (or not attend at all) a place or a situation, especially quickly or when the situation has become undesirable; to abandon (something)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb09e21-45bc-42d3-b790-26a7aa3ae908",
                                                "sense_id": "c47001aa-cea6-3ba1-add1-1485e5d2ed9a",
                                                "text": "I'm going to bail out of class today."
                                            },
                                            {
                                                "example_id": "73a157f7-9838-4886-9ff5-b2889f8d08df",
                                                "sense_id": "c47001aa-cea6-3ba1-add1-1485e5d2ed9a",
                                                "text": "She's bailing out on the project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "819d6892-2f13-343c-94d5-5c48e3ad0d84",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To abandon (someone) when that person faces difficulties."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0f68f0f-926b-4a7a-a8eb-3354e70edb95",
                                                "sense_id": "819d6892-2f13-343c-94d5-5c48e3ad0d84",
                                                "text": "When I got arrested, she bailed out on me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37acf79-e387-32e0-a6e1-358be764f401",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To sell all or part of one's holdings in stocks, real estate, a business, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "intransitive",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d497d92-08f8-4f7a-ab4f-27abed90f019",
                                                "sense_id": "b37acf79-e387-32e0-a6e1-358be764f401",
                                                "text": "I'm going to bail out of stocks and buy gold instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b35e4d9-6c97-31e0-976f-9984550bfc57",
                                        "entry_id": "2366c755-f758-3ccd-8828-ba82fe981f84",
                                        "glosses": [
                                            "To make an unscheduled voluntary termination of an underwater dive, usually implying the use of an alternative breathing gas supply."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-of"
                                        ],
                                        "examples": []
                                    },
