                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_broadcast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По первой <w>программе</w> сейчас показывают интересный фильм.",
                            "target_lang_translations": {
                                "en": "They are showing an interesting movie on the first <w>channel</w> right now.",
                                "zh": "第一<w>频道</w>现在正在放一部有趣的电影。"
                            }
                        },
                        {
                            "text": "Бабушка попросила переключить телевизор на вторую <w>программу</w>.",
                            "target_lang_translations": {
                                "en": "Grandma asked to switch the TV to the second <w>channel</w>.",
                                "zh": "奶奶让我把电视换到第二<w>频道</w>。"
                            }
                        }
                    ],
