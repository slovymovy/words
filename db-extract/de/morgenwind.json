                    }
                ],
                "senses": [
                    {
                        "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                        "entry_id": "d5e7af11-4b98-3992-a269-ca9a9182941d",
                        "glosses": [
                            "am Morgen, in den Morgenstunden wehender Wind; morgens aufkommender Wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31d73fb-3cd6-457c-b381-d7556ba04f71",
                                "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                                "text": "„In den wahllos hingestellten einzelnen Mietskasernen zitterten die vielen Fenster in der mannigfaltigsten Bewegung und Beleuchtung, und auf allen den kleinen schwachen Balkonen hatten Frauen und Kinder vielerlei zu tun, während um sie herum, sie verdeckend und enthüllend, aufgehängte und hingelegte Tücher und Wäschestücke im Morgenwind flatterten und mächtig sich bauschten.“"
                            },
                            {
                                "example_id": "5a12977a-d358-4711-ad44-8378ac90a741",
                                "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                                "text": "„Er spuerte, vermischt mit dem kuehlen feinen Morgenwind, ein Uebermass an Trauer, dem kein Mensch gewachsen ist.“"
                            },
                            {
                                "example_id": "b8b4f7c6-8846-465f-84e2-83f76cf7c7b5",
                                "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                                "text": "„Das Schilf rischelt im Morgenwind.“"
                            },
                            {
                                "example_id": "cfb9082c-063e-4348-8c91-08da5b747bee",
                                "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                                "text": "„Als wolle er einen necken, weht der Morgenwind über Augen, Wangen und Hals und macht sofort wach.“"
                            },
                            {
                                "example_id": "806817ad-af2d-4914-90c5-1094475f4ea6",
                                "sense_id": "fed6b384-0e3e-30da-9776-4bd0b03c52fe",
                                "text": "„Der Morgenwind wehte den intensiven Geruch der Wildbumen herüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "072c7461-365b-3b00-b324-a0c36fc831f9",
                        "entry_id": "d5e7af11-4b98-3992-a269-ca9a9182941d",
                        "glosses": [
                            "aus Osten wehender Wind"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e71b9d-9dfb-40ce-a2a2-c89c33f50561",
                                "sense_id": "072c7461-365b-3b00-b324-a0c36fc831f9",
                                "text": "Heute weht ein kalter Morgenwind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
