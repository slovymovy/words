                                        "entry_id": "05bc2f7a-3206-3e87-ad84-094ba6b0f94a",
                                        "glosses": [
                                            "In the names of places or geographic features:",
                                            "The larger geographic or administrative area that encompasses or belongs to a place (especially if both share the same name)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1529df8b-4433-41d1-b04e-1db375a866f9",
                                                "sense_id": "7c1cbf5b-44d7-33f1-adab-e2975979dd41",
                                                "text": "Greater Antilles"
                                            },
                                            {
                                                "example_id": "633b5442-e9ce-4072-9f64-5a01a5af6250",
                                                "sense_id": "7c1cbf5b-44d7-33f1-adab-e2975979dd41",
                                                "text": "GMRLC is a regional consortium of medium-size research libraries (17 in 1995) located in the greater Midwest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                        "entry_id": "05bc2f7a-3206-3e87-ad84-094ba6b0f94a",
                                        "glosses": [
                                            "In the names of places or geographic features:",
                                            "Including the surrounding urban areas and conurbation (of a city or other large settlement)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "capitalized",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d7a5f8-94c9-4b3a-88b7-730519e2cd33",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "Greater London"
                                            },
                                            {
                                                "example_id": "811a64c7-54de-491d-a63d-23df60b3646a",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "Greater New York includes adjacent parts of three states, as well as the City itself."
                                            },
                                            {
                                                "example_id": "9004ef34-d30e-4e8f-b73b-6bcc2f5abb00",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "“Greater London!” What a vague and ill-defined term! We all known London proper, comprising of the City and Westminster, and making up one metropolis."
                                            },
                                            {
                                                "example_id": "7d0bde10-e05d-46e8-90dd-f6d663ca199a",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "[…]statistics revealing that while greater Tokyo has a total area that represents only 3.6 percent of the total land available[…]more than 25 percent of the country's population live there."
                                            },
                                            {
                                                "example_id": "e50eb790-f062-430a-8dd9-108582b6eedc",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "The rate in isolated counties was about a third higher than in the greater metropolitan counties."
                                            },
                                            {
                                                "example_id": "0c01dc28-858d-4819-8876-be5dce683f83",
                                                "sense_id": "3544aca5-379d-32da-8065-896c02d97ec9",
                                                "text": "In February 2010, the largest high—concentration photovoltaic (HCPV) solar power plant in Asia began operation in Lujhu, located in the Greater Kaohsiung area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6f8828-bac1-3cb4-b793-44bea0ebb50c",
                                        "entry_id": "05bc2f7a-3206-3e87-ad84-094ba6b0f94a",
                                        "glosses": [
                                            "In the names of places or geographic features:",
                                            "Referring to a state at its fullest historical (or desired future) extent including colonies, annexed land, etc."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
