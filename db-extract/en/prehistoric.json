                    },
                    {
                        "translation_id": "46e00bb9-2a8c-4059-b8e4-9497a5b5d428",
                        "source_entry_id": "74863f88-e592-3e21-919e-b7ab0972a6be",
                        "source_sense_description": "of relating to the epoch before written record",
                        "target_lang_word": "prähistorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prähistorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14faac8a-ebd3-3e83-b249-cf7e858453dd",
                                        "entry_id": "50bee830-c4c4-390d-855e-a23c0e7aadd6",
                                        "glosses": [
                                            "die Prähistorie betreffend, aus ihrer Zeit stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0976932e-88a6-4f74-9512-929075208759",
                                                "sense_id": "14faac8a-ebd3-3e83-b249-cf7e858453dd",
                                                "text": "„Es ist ein megalithisches Land; nicht in dem Sinne, daß es prähistorisch wäre - es hat wie jedes arme Land der Welt seine eigene Geschichte, die von den Metropolen ignoriert oder als \"primitiv\" abgetan wird -, sondern in dem Sinne, daß Fels seine Seele und Stein seine Mutter ist.“"
                                            },
                                            {
                                                "example_id": "a1694783-57f1-432b-a5ec-03891178ab17",
                                                "sense_id": "14faac8a-ebd3-3e83-b249-cf7e858453dd",
                                                "text": "„Der prähistorische Fundort rund 95 Kilometer nördlich von Johannesburg gilt als die Wiege der Menschheit.“"
                                            },
                                            {
                                                "example_id": "c17a6908-4e93-4864-9e2f-5a7a7114161f",
                                                "sense_id": "14faac8a-ebd3-3e83-b249-cf7e858453dd",
                                                "text": "„Einen Ausflug in die prähistorische Vergangenheit verspricht ein neuer Naturpark im Zentralmassiv, der die gemeinsame Geschichte von Mensch und Tier in der Region in den Mittelpunkt stellt.“"
                                            },
                                            {
                                                "example_id": "43f4b8cb-84a4-46bf-a505-43654e6079d4",
                                                "sense_id": "14faac8a-ebd3-3e83-b249-cf7e858453dd",
                                                "text": "„Die geplante Aufnahme von prähistorischen Pfahlbauten in das Welterbe der Unesco kommt einen weiteren Schritt voran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
