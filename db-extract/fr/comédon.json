                        "entry_id": "0c1cb361-60c0-3c34-9704-0e62b25b370c",
                        "glosses": [
                            "Petits cylindres vermiformes de matière sébacée blanchâtre, qu'on fait sortir de la peau du nez, de celle des joues et du front, et qui proviennent des follicules pileux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f385a4f5-2e63-4eb4-9ec8-4cdaeb1ced00",
                                "sense_id": "6b25c13e-8160-3d2e-aef8-680360193ad7",
                                "text": "Les comédons sont très fréquents sur les peaux séborrhéiques, au cours de l'acné."
                            },
                            {
                                "example_id": "48d88b0e-c953-4387-82b5-cd61a0dd75a4",
                                "sense_id": "6b25c13e-8160-3d2e-aef8-680360193ad7",
                                "text": "Quelques comédons saillaient aux alentours des ailes du nez."
                            }
                        ]
                    }
                ],
