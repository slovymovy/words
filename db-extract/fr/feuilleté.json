                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielschichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                        "entry_id": "431ddb1b-973d-357d-a610-c27b786a580f",
                                        "glosses": [
                                            "in verschiedenen Arten und Weisen, mit vielen Seiten, vielen Aspekten, vielen Facetten, vielen Varianten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fe3eea-173a-4606-b828-767fc2a7bfe8",
                                                "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                                "text": "„Der Gegenstand, wie vielschichtig und wichtig er auch sein mag, ist mittlerweile so oft, so kompetent und so fruchtbar diskutiert worden, dass er dem Leser inzwischen vertraut und dem Verfasser deshalb problematisch geworden ist.“"
                                            },
                                            {
                                                "example_id": "650fabcd-d820-48c1-a4e3-8799582eb4a2",
                                                "sense_id": "bfe9874f-5a3b-31a8-bb8f-33a914286eec",
                                                "text": "„Das Material ist ungemein dicht und wiewohl meist privater Art, äußerst vielschichtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e876af42-6591-3179-ab88-e252a548847b",
                                        "entry_id": "431ddb1b-973d-357d-a610-c27b786a580f",
                                        "glosses": [
                                            "aus mehreren Schichten bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88766d5b-2f8e-4b7f-b7e9-cbffa052bc50",
                        "source_entry_id": "697815c5-5b51-3fd0-b27f-bf310ef79709",
                        "target_lang_word": "laminated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laminated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Made by lamination."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96dde0c9-398b-4818-9bd7-c573be874d4a",
                                                "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                                                "text": "The accident was also one of several since Clapham [...] that demonstrated the role of breakable windows in the death toll. RSSB research would later confirm and reinforce the need for laminated glass to protect passengers and increase survivability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Consisting of many thin layers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec870e0-1a74-44f9-93c8-f2fe1c924c1b",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "A laminated arch is a timber arch made of layers of bent planks secured by treenails."
                                            },
                                            {
                                                "example_id": "73b340ce-a0e7-488b-a7e4-22717528906a",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "All springs for the engine and tender are of the laminated type with plates of carbon steel, which are secured in the spring buckles by a vertical centre rivet."
                                            },
                                            {
                                                "example_id": "dbd8784b-d06d-48a6-ae35-7e16d0ec153e",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "In general, steel springs were stipulated for primary suspension, although rubber was accepted for auxiliary springing; hydraulic dampers were specified and the use of laminated springs ruled out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Splitting into thin layers parallel to bedding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8b8d8b-90ad-4953-a3bf-d16d8a6cf3df",
                                                "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                                                "text": "Shale is laminated."
                                            }
                                        ]
                                    }
                                ]
