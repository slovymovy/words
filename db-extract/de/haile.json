                ],
                "senses": [
                    {
                        "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                        "entry_id": "94d8f9bf-a21e-33f3-ade9-e9f98d76f7cc",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ad8b19-49ec-4d93-a9e9-46d911f9e7d8",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Frau Haile ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bd528301-1b2f-46a2-bd30-2eae1be1d94b",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Herr Haile wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "52825abf-d5ab-405c-b932-ad2a193d6093",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Die Hailes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "60535970-bb69-40a7-ad16-7faee831e8b4",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Der Haile trägt nie die Schals, die die Haile ihm strickt."
                            },
                            {
                                "example_id": "998d6b09-c81f-4c1c-b9c9-35fe497fe4a7",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haile kommt, geht der Herr Haile.“"
                            },
                            {
                                "example_id": "9027db2d-a3c0-4315-b6f6-79d429cd1246",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Haile kommt und geht."
                            },
                            {
                                "example_id": "c744d142-16b0-4501-8123-6776f9c512a9",
                                "sense_id": "9efb39bb-cb87-3bd6-ba60-0d597fb17a02",
                                "text": "Hailes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
