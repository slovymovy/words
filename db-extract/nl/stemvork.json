                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuning fork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7056efe-ed74-37fb-aa9c-2626173ad7b2",
