                ],
                "senses": [
                    {
                        "sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                        "entry_id": "5634e63e-6df1-3ebc-b422-01fcf536f4ef",
                        "glosses": [
                            "Qui est dans la décrépitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "385b2460-f2dd-47b5-aaa2-9793e23a2274",
                                "sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                                "text": "Un lion décrépit, goutteux, n’en pouvant plus."
                            },
                            {
                                "example_id": "94c2bb25-cc8d-43b3-a6a4-611a37f25f74",
                                "sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                                "text": "En songeant à cela j’arrivai chez le sonneur de cloches Brainstein, qui demeurait au coin de la petite place, dans une vieille baraque décrépite ; […]."
                            },
                            {
                                "example_id": "ad8b0978-f1cf-4a87-9e3d-952ffc8d9db6",
                                "sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                                "text": "Quels hommes étaient-ce donc que ceux qui exécutaient ces merveilleuses constructions que les prodigalités des palais féeriques ne pourraient dépasser ? La race en est-elle donc perdue ? Et nous, qui nous vantons d’être civilisés, ne serions-nous, en effet, que des barbares décrépits ?"
                            },
                            {
                                "example_id": "62d3978a-3ec1-48f6-b3fe-8937a8a73e13",
                                "sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                                "text": "Ververano pleura de tout son cœur, comme s’il venait de naître puis, à la vue du visage rayonnant de sa mère, il sourit tel un vieux décrépit au seuil de la mort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6e61d11-5702-415a-80ec-d490e96ed010",
                        "source_entry_id": "5634e63e-6df1-3ebc-b422-01fcf536f4ef",
                        "source_sense_id": "22800b71-a8ba-31c8-b0d5-4377312b7505",
                        "target_lang_word": "decrepit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decrepit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                        "entry_id": "7b0d6540-03c0-3b7d-8065-e7a2ad7cfcbe",
                                        "glosses": [
                                            "Weakened or worn out from age or wear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29a45e1c-7eff-4dfe-9f7a-443a7923a5db",
                                                "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                                "text": "Sorrow is subdued by strong necessity; there is no cause why life should be lengthened for our love; and we feel that the worn and the decrepit do but go down into that grave which had received youth, health, beauty,—all that made existence precious—long before."
                                            },
                                            {
                                                "example_id": "fa04d94b-2d26-4096-a49d-71afc5a2e6c0",
                                                "sense_id": "97fc7105-3f0a-3d03-a042-ef93e582ae81",
                                                "text": "Two entrants shared this award for their work on two quite different stations, but with the same purpose of bringing a redundant station building back into use for the benefit of the community, with the added result of conserving an historic building. Saltash Town Council bought Saltash station building after it had become very decrepit and 'an eyesore' - such that it was nearly pulled down to make way for housing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0ae0deb-5b71-4fd2-bc8b-012f2a66804b",
                        "source_entry_id": "5634e63e-6df1-3ebc-b422-01fcf536f4ef",
