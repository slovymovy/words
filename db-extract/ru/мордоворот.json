                "senses": [
                    {
                        "sense_id": "9d66c4a3-ac13-3510-a797-05169cb8a26d",
                        "entry_id": "39b34197-548f-3d1a-b542-af1a29483e71",
                        "glosses": [
                            "прост. некрасивое, уродливое, обычно толстое лицо, также человек с таким лицом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31294728-b204-49ec-b903-4cc81fbbe94d",
                                "sense_id": "9d66c4a3-ac13-3510-a797-05169cb8a26d",
                                "text": "\"Вот Надежда Константиновна уж на что мордоворот была, а какого парня отхватила!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c70a87f5-38b1-38a8-b12a-48424e6370ec",
                        "entry_id": "39b34197-548f-3d1a-b542-af1a29483e71",
                        "glosses": [
                            "прост., неодобр. массивный, физически сильный, часто — агрессивный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3884c8b9-7f76-4e62-8972-54e6cb9d8f85",
                                "sense_id": "c70a87f5-38b1-38a8-b12a-48424e6370ec",
                                "text": "Водительское место занимал какой-то бритый наголо мордоворот."
                            },
                            {
                                "example_id": "1196b12d-88ff-4647-94b4-b8c680d9a354",
                                "sense_id": "c70a87f5-38b1-38a8-b12a-48424e6370ec",
                                "text": "Но провожали нас в аэропорту мордовороты в зелёных камуфляжах."
                            }
                        ]
                    }
                ],
