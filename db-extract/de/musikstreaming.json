                "senses": [
                    {
                        "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                        "entry_id": "9e81965c-02f3-3d66-b0d4-70823a1732b4",
                        "glosses": [
                            "Technik, die das Hören von Musik als Datenstrom ermöglicht, bei der Dateien schubweise als Datenpaket über das Internet an ein Endgerät (PC, Internet-Radio, etc.) gesendet und abgespielt werden ohne dass die Musik auf dem Endgerät resident gespeichert wird."
                        ],
                        "tags": [
                            "Unterhaltungselektronik",
                            "kein Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4f94b476-718d-46ee-b0db-de0d1de282fc",
                                "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                                "text": "„Einige nennen Apple Music sogar etwas komplizierter. Unterschätzen sollte man Apple deshalb nicht: Gelingt es dem Unternehmen, künftig mehr Künstler wie Taylor Swift exklusiv für sich zu gewinnen, eine gute Android-App auf den Markt zu bringen und das Radioangebot weiter auszubauen, könnte Apple tatsächlich den längeren Atem haben, wenn es um Musikstreaming geht.“"
                            },
                            {
                                "example_id": "609bf9cc-e78f-4f97-bdf2-107eca511198",
                                "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                                "text": "„Berlin ( dpa ) - Das Geschäft mit Musikstreaming aus dem Internet wächst auch in Deutschland rasant. Mit einer Steigerung von 78,6 Prozent im vergangenen Jahr seien diese Angebote entscheidend für das Wachstum des Musikmarktes gewesen, berichtete der Bundesverband Musikindustrie heute.“"
                            },
                            {
                                "example_id": "c2c43eb4-c1eb-444b-81ab-9a3f4c349b8d",
                                "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                                "text": "„Musikstreaming aus der Cloud direkt in iTunes wurde zwar nicht vorgestellt, es scheint aber, dass die notwendige Technik im nächsten iOS Update, in iTunes und auch in der Infrastruktur vorhanden ist."
                            },
                            {
                                "example_id": "7c54ded2-e1b5-42b2-ade0-c645aa7c0b0b",
                                "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                                "text": "Im Gegensatz zum Musikdownload erwirbt der Nutzer bei Musikstreaming keine Musikstücke zur freien privaten Nutzung, sondern kann Lieder lediglich im Stream oder in einer eingeschränkt nutzbaren zwischengespeicherten Version abhören."
                            },
                            {
                                "example_id": "3ba404d1-50be-447e-80e1-f5539aa20ab4",
                                "sense_id": "ce03359d-2506-39c9-9472-d14175c67f3c",
                                "text": "Musikstreaming wird in Deutschland immer beliebter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52904ef0-d788-3d41-9747-3b41a8ecb517",
