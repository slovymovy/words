                        "entry_id": "2b8de4bb-60e1-3987-8ef9-71086eaa35ce",
                        "glosses": [
                            "A box in which the core (usually made of sand) for producing the hollow part of a casting, is made."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1749d172-7728-4049-b25d-c45e5e074320",
                                "sense_id": "84d866d3-0e4d-34f8-a108-f702d6ee473f",
                                "text": "Likewise, 20 psi represents the point at which the sand mis has reached sufficient strength to be drawn from the pattern or corebox without sag or distortion."
                            },
                            {
                                "example_id": "79259507-8b99-477e-bf9d-96e1aeb9f8b2",
                                "sense_id": "84d866d3-0e4d-34f8-a108-f702d6ee473f",
                                "text": "The globe valve corebox is actually a dump type made in half sections. One half is used to form the right half of the core. The other half is used to form the left half of the core."
                            },
                            {
                                "example_id": "d89d3984-1b32-46b4-b69a-5fa8fe1f1e3e",
                                "sense_id": "84d866d3-0e4d-34f8-a108-f702d6ee473f",
                                "text": "As is the case of patterns, coreboxes range from simple wooden structures to precision metal assemblies capable of long life under exacting conditions."
                            }
                        ]
                    }
