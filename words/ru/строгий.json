{
    "word_family": [
        "строгость",
        "строго",
        "строжайший",
        "построже",
        "сострогать"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1861777-7d32-37e3-b8fc-aead07319d0f",
                    "sense_definition": "Очень требовательный, взыскательный, не допускающий поблажек.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "требовательность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш новый учитель очень <w>строгий</w>, но всегда справедливый.",
                            "target_lang_translations": {
                                "tr": "Yeni öğretmenimiz çok <w>sert</w> ama her zaman adildir.",
                                "en": "Our new teacher is very <w>strict</w>, but always fair."
                            }
                        },
                        {
                            "text": "Отец был <w>строгим</w> родителем и требовал от детей дисциплины.",
                            "target_lang_translations": {
                                "tr": "Baba <w>katı</w> bir ebeveyndi ve çocuklardan disiplin beklerdi.",
                                "en": "Father was a <w>strict</w> parent and demanded discipline from the children."
                            }
                        }
                    ],
                    "synonyms": [
                        "требовательный",
                        "взыскательный"
                    ],
                    "antonyms": [
                        "мягкий",
                        "добродушный",
                        "ласковый"
                    ],
                    "common_phrases": [
                        "строгий родитель",
                        "строгий учитель"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok talepkar, hoşgörüsüz ve kurallara sıkı sıkıya bağlı olan (kimse).",
                        "en": "Very demanding, exacting, and not allowing for leniency."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sert",
                                "target_lang_sense_clarification": "insanlar ve davranışlar için"
                            },
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "tavizsiz"
                            },
                            {
                                "target_lang_word": "disiplinli",
                                "target_lang_sense_clarification": "kurallara uyan"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "strict",
                                "target_lang_sense_clarification": "demanding and firm with people"
                            },
                            {
                                "target_lang_word": "stern",
                                "target_lang_sense_clarification": "serious and uncompromising"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5815e196-0b1b-3d2a-8c0e-bbca78cfc6e0",
                    "sense_definition": "Суровый, жёсткий, не допускающий нарушений правил или законов.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "суровость",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За нарушение правил дорожного движения предусмотрено <w>строгое</w> наказание.",
                            "target_lang_translations": {
                                "tr": "Trafik kurallarının ihlali için <w>ağır</w> bir ceza öngörülmüştür.",
                                "en": "A <w>severe</w> penalty is provided for traffic violations."
                            }
                        },
                        {
                            "text": "В этой школе действует очень <w>строгий</w> режим дня.",
                            "target_lang_translations": {
                                "tr": "Bu okulda çok <w>sıkı</w> bir günlük program uygulanmaktadır.",
                                "en": "This school has a very <w>strict</w> daily schedule."
                            }
                        }
                    ],
                    "synonyms": [
                        "жёсткий",
                        "суровый"
                    ],
                    "antonyms": [
                        "нестрогий",
                        "мягкий"
                    ],
                    "common_phrases": [
                        "строгое наказание",
                        "строгий выговор",
                        "строгий режим"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kuralların veya yasaların ihlaline izin vermeyen, sert ve acımasız.",
                        "en": "Severe, harsh, and not allowing for violations of rules or laws."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıkı",
                                "target_lang_sense_clarification": "kurallar ve rejimler için"
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "cezalar için"
                            },
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "kurallar ve yasalar için"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "strict",
                                "target_lang_sense_clarification": "regarding rules or regulations"
                            },
                            {
                                "target_lang_word": "severe",
                                "target_lang_sense_clarification": "regarding punishments or conditions"
                            },
                            {
                                "target_lang_word": "rigorous",
                                "target_lang_sense_clarification": "extremely thorough and careful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10202733-b738-3bd4-95e6-2eb00c821258",
                    "sense_definition": "Точный, абсолютно верный, не допускающий никаких отклонений от правил или фактов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "точность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В научных исследованиях необходимо соблюдать <w>строгое</w> соответствие фактам.",
                            "target_lang_translations": {
                                "tr": "Bilimsel araştırmalarda gerçeklere <w>tam</w> bir uygunluk sağlanmalıdır.",
                                "en": "In scientific research, it is necessary to maintain <w>strict</w> adherence to the facts."
                            }
                        },
                        {
                            "text": "Все расчёты должны проводиться в <w>строгом</w> порядке.",
                            "target_lang_translations": {
                                "tr": "Tüm hesaplamalar <w>kesin</w> bir sırayla yapılmalıdır.",
                                "en": "All calculations must be performed in <w>strict</w> order."
                            }
                        }
                    ],
                    "synonyms": [
                        "точный",
                        "чёткий"
                    ],
                    "antonyms": [
                        "приблизительный",
                        "неточный"
                    ],
                    "common_phrases": [
                        "строгое соответствие",
                        "строгий порядок"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kurallardan veya gerçeklerden hiçbir sapmaya izin vermeyen, kesin ve tamamen doğru.",
                        "en": "Precise, absolutely correct, and allowing no deviations from rules or facts."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "şüpheye yer bırakmayan"
                            },
                            {
                                "target_lang_word": "tam",
                                "target_lang_sense_clarification": "eksiksiz ve doğru"
                            },
                            {
                                "target_lang_word": "sıkı",
                                "target_lang_sense_clarification": "düzen ve takip için"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "strict",
                                "target_lang_sense_clarification": "adhering exactly to a standard"
                            },
                            {
                                "target_lang_word": "precise",
                                "target_lang_sense_clarification": "exact and accurate"
                            },
                            {
                                "target_lang_word": "rigid",
                                "target_lang_sense_clarification": "inflexible in following a process"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50544be0-7b2d-3227-9e36-6c552454c4b6",
                    "sense_definition": "Простой, классический, без лишних украшений или излишеств.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "стиль",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для официального приёма она выбрала элегантное <w>строгое</w> платье.",
                            "target_lang_translations": {
                                "tr": "Resmi davet için zarif ve <w>sade</w> bir elbise seçti.",
                                "en": "For the official reception, she chose an elegant, <w>simple</w> dress."
                            }
                        },
                        {
                            "text": "Интерьер офиса был выполнен в <w>строгом</w> стиле без лишних деталей.",
                            "target_lang_translations": {
                                "tr": "Ofisin iç tasarımı, gereksiz detaylar olmadan <w>sade</w> bir tarzda yapılmıştı.",
                                "en": "The office interior was designed in a <w>formal</w> style without unnecessary details."
                            }
                        }
                    ],
                    "synonyms": [
                        "аскетичный",
                        "спартанский"
                    ],
                    "common_phrases": [
                        "строгий костюм",
                        "строгий стиль",
                        "строгое платье"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gereksiz süslemelerden veya aşırılıklardan uzak, sade ve klasik.",
                        "en": "Simple, classic, and without unnecessary decorations or excesses."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sade",
                                "target_lang_sense_clarification": "gösterişsiz"
                            },
                            {
                                "target_lang_word": "klasik",
                                "target_lang_sense_clarification": "resmi ve geleneksel"
                            },
                            {
                                "target_lang_word": "resmi",
                                "target_lang_sense_clarification": "giyim tarzı için"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "simple",
                                "target_lang_sense_clarification": "plain and unadorned"
                            },
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "appropriate for professional or official settings"
                            },
                            {
                                "target_lang_word": "understated",
                                "target_lang_sense_clarification": "elegant and not showy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}