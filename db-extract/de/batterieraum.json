                "senses": [
                    {
                        "sense_id": "453bc56f-c897-3ae3-a24d-76226bb95338",
                        "entry_id": "7524902e-aa2c-35db-9593-ea200b27208a",
                        "glosses": [
                            "Räumlichkeit, in der Batterien zur Strom- oder Notstromversorgung untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e580245a-75a9-4ceb-b903-d79edd1791fd",
                                "sense_id": "453bc56f-c897-3ae3-a24d-76226bb95338",
                                "text": "„In der DIN VDE 0510 Teil 2 Abs. 9.4.3 wird die Be- und Entlüftung von Batterieräumen beschrieben.“"
                            },
                            {
                                "example_id": "01c2a118-9c8a-4da7-849b-4bd1d41c173e",
                                "sense_id": "453bc56f-c897-3ae3-a24d-76226bb95338",
                                "text": "„Das Rauchen und das Verwenden von offenem Feuer sind in den Batterieräumen verboten; hierauf ist durch Schilder an der Außenseite der Türen hinzuweisen.“"
                            },
                            {
                                "example_id": "8f845733-ab1f-46ec-8390-7f674abefa55",
                                "sense_id": "453bc56f-c897-3ae3-a24d-76226bb95338",
                                "text": "„In nur sporadisch begangenen Batterieräumen können Augenspülflaschen auch als Ausrüstung mitgeführt werden.“"
                            },
                            {
                                "example_id": "6b40e8a4-1040-4c87-a9d9-63f978074a3a",
                                "sense_id": "453bc56f-c897-3ae3-a24d-76226bb95338",
                                "text": "„In Batterieräumen sind Vorkehrungen gegen Explosionsgefahr zu treffen. Vorkehrung gegen Explosionsgefahr ist z. B. eine ausreichende lüftungstechnische Gestaltung der Batterieräume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
