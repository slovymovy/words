                        "form": "mérules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "glosses": [
                            "Champignon lignivore des maisons ou des charpentes, de nom scientifique Serpula lacrymans en Europe et Poria incrassata en Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff6b97a-31c0-4046-bb0b-94e3eea537ae",
                                "sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                                "text": "Tout est pourri, il y a des mérules [champignons] partout."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc6b482a-7a03-3393-9e94-1a1effb33e17",
                        "entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "glosses": [
                            "Genre de la famille des Agaricinées comprenant plusieurs espèces de champignons."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "76f5e9f3-7b48-4410-b40d-76ed58f4e92f",
                                "sense_id": "bc6b482a-7a03-3393-9e94-1a1effb33e17",
                                "text": "Ainsi l'absence ou la situation latérale du pédicule fait la seule distinction des mérules et des agarics."
                            }
                        ]
                    },
                    {
                        "sense_id": "87c715b1-300c-309a-8159-f1aa08784f9a",
                        "entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "glosses": [
                            "Racaille."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a34280c7-e3dc-4fa4-8031-89490343a7fa",
                                "sense_id": "87c715b1-300c-309a-8159-f1aa08784f9a",
                                "text": "Sous l'œil vigilant d'une cinquantaine d'arquebusiers, la mérule de la France investit le lieu saint."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "603ae9a7-d7a9-49b3-a206-91610ee50d2d",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Schwamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c1ca1dc-8fd3-3f26-abd9-f5b5f8599fb8",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "Tier aus dem Stamm der Schwämme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b111e61-6a8b-4b10-80e5-b24f2c8fe00d",
                                                "sense_id": "1c1ca1dc-8fd3-3f26-abd9-f5b5f8599fb8",
                                                "text": "Die Skelette der Schwämme eignen sich sehr gut als Badeschwämme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0de6220b-8f83-3bd9-a507-8cf389461433",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "Bade- oder Putzutensil aus [1], ersatzweise aus Gummi, Kunststoff oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b8ed14-1203-495a-8ea0-8480d9da9d6c",
                                                "sense_id": "0de6220b-8f83-3bd9-a507-8cf389461433",
                                                "text": "Gib mir mal den Schwamm, bitte."
                                            },
                                            {
                                                "example_id": "a70957be-8fb3-4d7f-92fc-fd943fa715f2",
                                                "sense_id": "0de6220b-8f83-3bd9-a507-8cf389461433",
                                                "text": "„Sophies sonnenverbrannter Nacken und ihre rissigen Hände, mit denen sie den Schwamm ausdrückte, hatten mich plötzlich an den jungen Stallknecht Karl erinnert, der in unserer Kindheit unsere Ponys striegelte.“"
                                            },
                                            {
                                                "example_id": "4af8577c-8d36-4ad1-885c-957040f910f8",
                                                "sense_id": "0de6220b-8f83-3bd9-a507-8cf389461433",
                                                "text": "„Dann hoben sie den Brustkorb ab und sahen die beiden Lungen, zwei Schwämmen gleich, das Herz, das wie ein großes Ei aussah, in wenig nach links hinten gerückt, das Zwerchfell, die Nieren, die ganze Masse der Eingeweide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a4837e39-659c-3821-97ab-232a534b8f33",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "der Befall mit holzzerstörendem Pilz (besonders Serpula lacrymans)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "413c02cf-ea3f-4097-9d4a-3a5f41dd3b3f",
                                                "sense_id": "a4837e39-659c-3821-97ab-232a534b8f33",
                                                "text": "In dem alten Gemäuer ist der Schwamm."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0f7f52ef-852f-38ae-bafc-5760a69e7280",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "mundartlich für Pilze (in Österreich und Alt-Bayern meist Verkleinerungsform Schwammerl, in Teilen Sachsens und im Erzgebirge Verkleinerungsform Schwämmel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8905fe-fdb9-4a10-8fed-3d2bd3a51c19",
                                                "sense_id": "0f7f52ef-852f-38ae-bafc-5760a69e7280",
                                                "text": "Im Walde, da wachsen die Schwämm' (fränkisches Volkslied)"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e25316d6-531c-3d89-97a7-879de9dab225",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "Objekt der fraktalen Geometrie"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "757840b2-14a8-4fbf-8c9e-cc60ba1f93e4",
                                                "sense_id": "e25316d6-531c-3d89-97a7-879de9dab225",
                                                "text": "Mengers Schwamm gehört wie die Koch-Kurve zu Objekten der fraktalen Geometrie."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "880e30e4-53eb-3952-9d3c-71fa0fd837c6",
                                        "entry_id": "6713d3e4-4397-3d8a-b7e9-aaeb7871a73c",
                                        "glosses": [
                                            "Tierstamm innerhalb der Vielzelligen Tiere (Metazoa)"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdfb999c-4f1b-4f8d-896c-0efbb583e848",
                                                "sense_id": "880e30e4-53eb-3952-9d3c-71fa0fd837c6",
                                                "text": "Schwämme gehören zu den ältesten Organismen auf unserem Planeten, und sie besitzen keine Muskel-, Nerven- und Sinneszellen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7363cc5c-bce4-4424-ba64-6bcf254c51e2",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Hausschwamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2ad9b66b-46b6-4cf9-b1e2-303373105c2e",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Pilz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pilz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "aus schlauchförmigen Fäden bestehender Organismus ohne Blattgrün (Reich Fungi); hat sowohl tierische als auch pflanzliche Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63093977-72e8-4475-ae1a-747e1c5d1fd8",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Seit unsere sich Welt zunehmend vernetzt, verbreiten sich auch vermehrt Pilze rund um den Globus.“"
                                            },
                                            {
                                                "example_id": "de40aff0-dce5-4a34-a267-c0d66e1d110e",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "Das größte Lebewesen der Welt ist ein Pilz."
                                            },
                                            {
                                                "example_id": "23f15fa2-1248-40ba-b948-d6ba34a5d6e5",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Pilze sind“ […] „heterotroph, das heißt, sie nutzen ebenso wie Tiere fremde Biomasse als Nahrungsquelle.“"
                                            },
                                            {
                                                "example_id": "be407a97-eb5a-4985-8539-c84c0b6d7bea",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Ohne Pilze würden sich tote Pflanzen, Pilzfruchtkörper und Tierkadaver häufen und die meisten Bäume hätten es schwer, an essentielle Nährstoffe zu kommen.“"
                                            },
                                            {
                                                "example_id": "0a43c10c-1862-4343-8610-7ea9f01e929f",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Einige Pilze können sich auch ungeschlechtlich fortpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "oberirdisch wachsendes Teil eines Pilzes^([1]) aus fleischigem Stiel und Hut"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0a152d-4be7-45d8-9b67-7bef82c92eb2",
                                                "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                                "text": "Wir sammeln Pilze."
                                            },
                                            {
                                                "example_id": "f79abfad-04f6-4101-986d-30c51ffb16ce",
                                                "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                                "text": "„Bald fand ich Himbeeren, Walderdbeeren und auch Pilze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "halluzinogene Pilze"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8728dca8-fe71-4a18-b732-6a25c221527d",
                                                "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                                "text": "„Pilze spielen in der Rauschgiftstatistik keine Rolle.“"
                                            },
                                            {
                                                "example_id": "65a02979-0f60-46b6-8dda-eec0b81d9491",
                                                "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                                "text": "„Dort, wo bewußtseinserweiternde Pilze heimisch sind, läßt sich ihr Gebrauch nur schwer verbieten, und so werden auch in der westlichen Gesellschaft heimlich Pilzrituale abgehalten, bei denen oftmals schon mit dem gebotenen Respekt an den Pilz und seine Geister herangegangen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pilz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e3be80-5e1b-30e3-80a4-1e9dd12557fc",
                                        "entry_id": "f4ab7405-e6dc-37db-8876-d01ea56f491e",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8dabe3-913e-41a1-9fa2-7fff846c5d75",
                                                "sense_id": "d3e3be80-5e1b-30e3-80a4-1e9dd12557fc",
                                                "text": "Morgen habe ich einen Termin bei meiner Zahnärztin Frau Dr. Pilz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3e8b8a-5a46-4a7d-b931-26367b7d2f83",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Pilzüberzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "44dd6d9f-2995-49f8-887b-ee5f0a40e6fb",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Moder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                        "entry_id": "3d8ca8cd-122b-3a9c-a875-3b6bd12a2dbf",
                                        "glosses": [
                                            "Ergebnis eines Fäulnisprozesses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e964855-961e-42ce-95db-d91c4ef4b5cb",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die Dielenbretter waren voller Trockenfäule gewesen, die elektrischen Leitungen gefährlich und das Badezimmer eine Art Schuppen im hinteren Teil des Hauses und vom Boden bis zur Decke bedeckt mit schwarzem Moder.“"
                                            },
                                            {
                                                "example_id": "d26d8313-6b3e-433c-8ed5-8b578b173090",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Der Geruch nach Moder stieg aus dem Bereich des Grabes.“"
                                            },
                                            {
                                                "example_id": "1702451c-d621-46e0-95ec-f6f848d59568",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die stockende Luft roch wie im Herbst nach Moder.“"
                                            },
                                            {
                                                "example_id": "bf4760a5-07c1-4c24-a216-7ed5d32bc188",
                                                "sense_id": "5618ae83-3a20-39f4-8ede-99c2957d64a0",
                                                "text": "„Die Äcker verödeten, die Niederlassung verfiel, die Männer, zermürbt von Weiberklagen, rosteten mit ihrem Eisen und überließen das kaum geklärte Feld dem Unkraut und Samenflug des Waldes, die Zäune dem Moder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc4f05ad-93e8-3d42-b9ee-ea673afd993f",
                                        "entry_id": "3d8ca8cd-122b-3a9c-a875-3b6bd12a2dbf",
                                        "glosses": [
                                            "aufgeweichte Erde"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9676464b-bcd9-40d5-8f76-9d8fbc8031c2",
                                                "sense_id": "fc4f05ad-93e8-3d42-b9ee-ea673afd993f",
                                                "text": "Sie ist mit dem Wagen im Moder steckengeblieben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95768db2-17c8-4a4a-9abc-da4bf1d85043",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
                        "source_sense_id": "be94a874-12c1-39f6-b140-8281fff21f73",
                        "source_sense_description": "Champignon lignivore",
                        "target_lang_word": "Fäulnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fäulnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41b666fe-3c95-3b48-8d88-cd03cad6a643",
                                        "entry_id": "59a2e477-5d13-35c9-aedb-cbea8373ea9e",
                                        "glosses": [
                                            "Vorgang oder Zustand, in dem etwas verfault; sich zersetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f10c161-00ad-4e58-909a-89fe1e6532d5",
                                                "sense_id": "41b666fe-3c95-3b48-8d88-cd03cad6a643",
                                                "text": "Die Fäulnis an den Bananen ist schon weit fortgeschritten."
                                            },
                                            {
                                                "example_id": "41e8ae64-c4a9-4faa-9bf8-0297988c8a36",
                                                "sense_id": "41b666fe-3c95-3b48-8d88-cd03cad6a643",
                                                "text": "„Es roch nach Fäulnis, und die Fliegen umschwirrten uns wie Aas.“"
                                            },
                                            {
                                                "example_id": "de697d69-fd1f-4711-8023-ba85e63f3108",
                                                "sense_id": "41b666fe-3c95-3b48-8d88-cd03cad6a643",
                                                "text": "„Im richtig aufgebauten Komposthaufen gibt es keine Fäulnis, sondern eine durch die Tätigkeit unzähliger Lebewesen bewirkte Rotte, weshalb der Haufen auch absolut nicht stinkt.“"
                                            },
                                            {
                                                "example_id": "b3ad2344-06e2-4919-b923-0c81e7bd554a",
                                                "sense_id": "41b666fe-3c95-3b48-8d88-cd03cad6a643",
                                                "text": "„Es war darinnen finster, und ein starker Gestank von Fäulnis und Verwesung drang durch die Türöffnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afaf2e1e-51be-4bdc-9aab-a801754c942f",
                        "source_entry_id": "12731295-4c85-3c84-9c4c-80ec60fcd648",
