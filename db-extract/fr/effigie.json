                                        "glosses": [
                                            "A dummy or other crude representation of a person, group or object that is hated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d6479d-5cfc-46bf-9d5e-f2e18cc4290b",
                                                "sense_id": "29f85009-990e-3ae9-8185-24abc2a8e237",
                                                "text": "In England on Bonfire Night, an effigy is often burned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70c6578-ee49-34ef-98d1-c4df2fd20f2a",
                                        "entry_id": "d69e6aef-6b47-3d9e-b3f7-c173790dde29",
                                        "glosses": [
                                            "A likeness of a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb03c5a-2aee-43c6-a11b-08a8f6429011",
                                                "sense_id": "e70c6578-ee49-34ef-98d1-c4df2fd20f2a",
                                                "text": "All around, terrace by terrace, there went marble lawns well guarded by onyx lions and carved with effigies of all the gods striding amid the symbols of the worlds."
                                            },
                                            {
                                                "example_id": "e3697a9a-3628-42f7-beb7-e1132ddff305",
                                                "sense_id": "e70c6578-ee49-34ef-98d1-c4df2fd20f2a",
                                                "text": "There are two tombs, each bearing effigies of a knight and his lady. One is 14th century, the other 15th century. The earlier knight wears chain mail and his lady has long, flowing hair. The later knight has plate armour, and his wife wears a wimple."
                                            }
                                        ]
                                    }
                                ]
                            }
