                "entry_id": "8ff5b941-93a1-30fa-8589-4e3248171b99",
                "word": "Newaars",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "099fe198-3256-3c77-af98-e666de273004",
                        "entry_id": "8ff5b941-93a1-30fa-8589-4e3248171b99",
                        "glosses": [
                            "Sino-Tibetaanse taal met ca. 800.000 sprekers, hoofdzakelijk in de Kathmanduvallei in Nepal"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c94a81b5-40ac-443c-bd83-84415f68838f",
                                "sense_id": "099fe198-3256-3c77-af98-e666de273004",
                                "text": "In de Shikhara-toren staan op drie niveaus paviljoentjes met zuilen en bogengaanderijen, waarin lange reliëfs met taferelen uit de grote Indiase epen Mahabharata en Ramayana te zien zijn. Ze worden gedeeltelijk in het Newaars toegelicht."
                            },
                            {
                                "example_id": "42960a33-b68d-46fa-9287-3fd90cac8352",
                                "sense_id": "099fe198-3256-3c77-af98-e666de273004",
                                "text": "Het Thangmi is een Tibeto-Birmaanse taal die nauw aan het Newaars en het Barām verwant blijkt te zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ad79160-2013-45cc-9e5a-7f13c7b30dcf",
                        "source_entry_id": "8ff5b941-93a1-30fa-8589-4e3248171b99",
                        "source_sense_id": "099fe198-3256-3c77-af98-e666de273004",
                        "source_sense_description": "Sino-Tibetaanse taal met ca. 800.000 sprekers, hoofdzakelijk in de Kathmanduvallei in Nepal",
                        "target_lang_word": "Newari",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Newari",
