                                    {
                                        "sense_id": "2a4f6e18-0334-3110-a27a-1b2b2cb71fd8",
                                        "entry_id": "459fb8b8-56f3-350d-9009-911707969162",
                                        "glosses": [
                                            "Déduire ou généraliser à partir de données partielles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3201569b-c153-4602-8784-8b257cf499aa",
                                                "sense_id": "2a4f6e18-0334-3110-a27a-1b2b2cb71fd8",
                                                "text": "Il y a un danger à extrapoler, c'est celui d'administrer le traitement à des populations ayant un plus faible risque spontané d'accident."
                                            },
                                            {
                                                "example_id": "0c280ff5-1fa4-40d1-bb5b-442dff173b86",
                                                "sense_id": "2a4f6e18-0334-3110-a27a-1b2b2cb71fd8",
                                                "text": "Avançons maintenant une hypothèse, aussi forte d'ailleurs que controversable : extrapolant un peu facilement le fameux « la culture, c'est ce qui reste quand on a tout oublié », il y a de sérieuses raisons de dire que, tout compte fait, ce qui résidait au fondement des Humanités c'était la formation de l'esprit critique ([…])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170e113f-8659-3ca1-9508-1da323db7fa1",
                                        "entry_id": "459fb8b8-56f3-350d-9009-911707969162",
                                        "glosses": [
                                            "Estimer des données dans une zone où aucune donnée n'est disponible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e389d650-3ddc-4d28-91a1-bb0594a9bf3f",
                        "source_entry_id": "6699b08e-7104-3c11-9b26-893d18af711a",
                        "source_sense_description": "to infer by extending known information",
                        "target_lang_word": "extrapolieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrapolieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e832a436-149f-347d-90d4-44d2b9a2f4e6",
                                        "entry_id": "97de8f9d-722a-3277-b447-c8e8b8ff3942",
                                        "glosses": [
                                            "sich (aufgrund bekannter Größen in einem speziellen Bereich) rechnerisch einem Ergebnis (in einem anderen Bereich) nähern, näherungsweise ein Resultat angeben"
                                        ],
                                        "tags": [
                                            "Naturwissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99c4e0b7-d194-438f-af33-de0cbb3718a8",
                                                "sense_id": "e832a436-149f-347d-90d4-44d2b9a2f4e6",
                                                "text": "„Solange nur die Anharmonizitätskonstante x e berücksichtigt wird, nehmen die aufeinander folgenden Terme linear ab, sodass man die nicht im Spektrum erscheinenden Übergänge leicht linear extrapolieren kann.“"
                                            },
                                            {
                                                "example_id": "f16d83d9-216b-4e88-8f73-9e0ea6d3036f",
                                                "sense_id": "e832a436-149f-347d-90d4-44d2b9a2f4e6",
                                                "text": "„Sensoren im Brillengestell registrierten die Ausrichtung seiner Pupillen, extrapolierten den Weg und stellten fest, wohin David blickte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "deb29572-f4af-3add-bab5-633373c53f24",
                                        "entry_id": "97de8f9d-722a-3277-b447-c8e8b8ff3942",
                                        "glosses": [
                                            "einen Ansatz weiterführen, etwas hochrechnen, entwickeln, von Bekanntem auf Unbekanntes schließen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a00b6a-2d16-4dea-93d1-1b9a4dad4439",
                                                "sense_id": "deb29572-f4af-3add-bab5-633373c53f24",
                                                "text": "„Um die Hypothese einer unterdrückungslosen Kultur aus Freuds Triebtheorie zu extrapolieren, muß man sein Konzept der primären Triebe (Urtriebe), ihre Ziele und wechselseitigen Beziehungen nochmals überprüfen.“"
                                            },
                                            {
                                                "example_id": "8c7944be-aa4c-494e-8d9b-3e34398f8101",
                                                "sense_id": "deb29572-f4af-3add-bab5-633373c53f24",
                                                "text": "„Schon hier zeigte sich seine Methode in Reinform: Ausgehend von sich selbst als Einzelfall, extrapolierte er eine Lehre mit universellem Anspruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b01f9d2-fdd7-425f-8150-ca3b0e66321a",
                        "source_entry_id": "6699b08e-7104-3c11-9b26-893d18af711a",
                        "source_sense_description": "to infer by extending known information",
                        "target_lang_word": "erschließen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erschließen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52a57025-c154-35c3-b58d-b44be3a3c061",
                                        "entry_id": "23f46985-0ca9-35c6-9efb-cd3a9cfb7179",
                                        "glosses": [
                                            "auffinden und nutzbar machen, zum Beispiel Gelände durch Infrastrukturmaßnahmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8853dd-d789-4c6d-b911-4b42071d9444",
                                                "sense_id": "52a57025-c154-35c3-b58d-b44be3a3c061",
                                                "text": "Das Baugelände ist voll erschlossen."
                                            },
                                            {
                                                "example_id": "7ddcbe61-8fd6-4552-8d90-4d6d650bf012",
                                                "sense_id": "52a57025-c154-35c3-b58d-b44be3a3c061",
                                                "text": "„Der Klettersport erschließt mir die Möglichkeit, mich meiner Umwelt mitzuteilen und Kontakt herzustellen. Der Fels ist dabei mein Freund.“"
                                            },
                                            {
                                                "example_id": "6dc2df3b-1454-4ec7-ac03-ca2d96bef83d",
                                                "sense_id": "52a57025-c154-35c3-b58d-b44be3a3c061",
                                                "text": "„Es werden immer wieder neue Ziele erschlossen - zuletzt Malaysia, das bis 2012 bereits rund 100 000 pakistanische Gastarbeiter registrierte.“"
                                            },
                                            {
                                                "example_id": "980e2ba3-2f1d-4f21-b05d-99fdb5c36d8f",
                                                "sense_id": "52a57025-c154-35c3-b58d-b44be3a3c061",
                                                "text": "„Die Diffenébrücke ist eine Klappbrücke mit Straßen- und Bahnverkehr, die den Industriehafen und die Friesenheimer Insel erschließt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8598ced9-cf68-3413-8665-b739f7ebcfb7",
                                        "entry_id": "23f46985-0ca9-35c6-9efb-cd3a9cfb7179",
                                        "glosses": [
                                            "durch bestimmte Schlussfolgerungen ermitteln, Ressourcen durch Informationsgewinn nutzbar machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97695e0-d317-47e5-805a-0f52d1a80ed3",
                                                "sense_id": "8598ced9-cf68-3413-8665-b739f7ebcfb7",
                                                "text": "Das Werk des Dichters erschließt sich erst bei intensivem Studium."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "862f50f0-f0a7-3b80-aa97-84e44f697c1f",
                                        "entry_id": "23f46985-0ca9-35c6-9efb-cd3a9cfb7179",
                                        "glosses": [
                                            "erkunden, einen Überblick gewinnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c582976-4c4b-4238-a1ac-b188450eae53",
                                                "sense_id": "862f50f0-f0a7-3b80-aa97-84e44f697c1f",
                                                "text": "Erst der Blick aus der Luft erschließt die Struktur der ganzen Anlage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
