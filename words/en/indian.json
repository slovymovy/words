                        "zh": [
                            {
                                "target_lang_word": "印度人",
                                "target_lang_sense_clarification": "印度籍公民或印度裔人士"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "579496b3-3336-3e6e-a2d8-906829fe2612",
                    "sense_definition": "A meal consisting of Indian food, or a restaurant serving such food.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "india_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go out for an <w>Indian</w> last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы решили пойти в <w>индийский ресторан</w>.",
                                "zh": "昨晚我们决定去吃<w>印度菜</w>。"
                            }
                        },
                        {
                            "text": "Have you ever tried <w>Indian</w> before?",
                            "target_lang_translations": {
                                "ru": "Ты когда-нибудь пробовал <w>индийскую кухню</w>?",
                                "zh": "你以前尝过<w>印度菜</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for an Indian"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English"
                        }
