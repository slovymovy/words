{
    "word_family": [
        "inheritance",
        "inheritor",
        "inheritable",
        "disinherit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c18a08d5-8e3d-3a10-8ac6-ff6161ebf03e",
                    "sense_definition": "Simple past and past participle of <w>inherit</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>inherited</w> a large fortune from her grandmother last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году она <w>унаследовала</w> большое состояние от своей бабушки.",
                                "pl": "W zeszłym roku <w>odziedziczyła</w> dużą fortunę po swojej babci."
                            }
                        },
                        {
                            "text": "He <w>inherited</w> the family business after his father retired.",
                            "target_lang_translations": {
                                "ru": "Он <w>унаследовал</w> семейный бизнес после того, как его отец вышел на пенсию.",
                                "pl": "Po przejściu ojca na emeryturę <w>odziedziczył</w> rodzinny biznes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherited a fortune",
                        "inherited the throne",
                        "inherited money"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «наследовать».",
                        "pl": "Forma czasu przeszłego oraz imiesłów czasu przeszłego od czasownika „dziedziczyć”."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унаследовал",
                                "target_lang_sense_clarification": "глагол прошедшего времени"
                            },
                            {
                                "target_lang_word": "унаследованный",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odziedziczył",
                                "target_lang_sense_clarification": "czasownik w czasie przeszłym (rodzaj męski)"
                            },
                            {
                                "target_lang_word": "odziedziczony",
                                "target_lang_sense_clarification": "imiesłów przymiotnikowy bierny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bd259726-e929-3397-94f3-b4daf4d1a0c8",
                    "sense_definition": "Received from a predecessor or ancestor, usually referring to property, money, or titles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "property_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used her <w>inherited</w> money to start a new company.",
                            "target_lang_translations": {
                                "ru": "Она использовала свои <w>унаследованные</w> деньги, чтобы открыть новую компанию.",
                                "pl": "Wykorzystała swoje <w>odziedziczone</w> pieniądze, aby założyć nową firmę."
                            }
                        },
                        {
                            "text": "The dispute over the <w>inherited</w> land lasted for several years.",
                            "target_lang_translations": {
                                "ru": "Спор из-за <w>унаследованной</w> земли длился несколько лет.",
                                "pl": "Spór o <w>odziedziczoną</w> ziemię trwał kilka lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "bequeathed",
                        "handed-down"
                    ],
                    "antonyms": [
                        "earned",
                        "acquired"
                    ],
                    "common_phrases": [
                        "inherited wealth",
                        "inherited property",
                        "inherited land"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полученный от предшественника или предка, обычно относится к имуществу, деньгам или титулам.",
                        "pl": "Otrzymany od poprzednika lub przodka, zazwyczaj w odniesieniu do majątku, pieniędzy lub tytułów."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унаследованный",
                                "target_lang_sense_clarification": "полученный в наследство"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odziedziczony",
                                "target_lang_sense_clarification": "otrzymany w spadku"
                            },
                            {
                                "target_lang_word": "spadkowy",
                                "target_lang_sense_clarification": "związany z otrzymanym majątkiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f533fed-6853-38a6-b2be-8997de8924d2",
                    "sense_definition": "Transmitted genetically from parents to offspring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors confirmed that the child suffers from an <w>inherited</w> disease.",
                            "target_lang_translations": {
                                "ru": "Врачи подтвердили, что ребёнок страдает <w>наследственным</w> заболеванием.",
                                "pl": "Lekarze potwierdzili, że dziecko cierpi na <w>dziedziczną</w> chorobę."
                            }
                        },
                        {
                            "text": "Eye color is an <w>inherited</w> trait passed down through generations.",
                            "target_lang_translations": {
                                "ru": "Цвет глаз — это <w>наследственная</w> черта, передающаяся из поколения в поколение.",
                                "pl": "Kolor oczu to <w>dziedziczna</w> cecha przekazywana z pokolenia na pokolenie."
                            }
                        }
                    ],
                    "synonyms": [
                        "hereditary",
                        "genetic",
                        "innate",
                        "inborn"
                    ],
                    "antonyms": [
                        "acquired"
                    ],
                    "common_phrases": [
                        "inherited disease",
                        "inherited trait",
                        "inherited condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переданный генетически от родителей к потомству.",
                        "pl": "Przekazany genetycznie od rodziców na potomstwo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследственный",
                                "target_lang_sense_clarification": "генетический, передающийся по наследству"
                            },
                            {
                                "target_lang_word": "унаследованный",
                                "target_lang_sense_clarification": "перенятый от родителей"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dziedziczny",
                                "target_lang_sense_clarification": "przekazywany genetycznie"
                            },
                            {
                                "target_lang_word": "wrodzony",
                                "target_lang_sense_clarification": "cecha nabyta od urodzenia"
                            }
                        ]
                    }
                }
            ]
        }
