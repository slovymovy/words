                "senses": [
                    {
                        "sense_id": "ebb65f42-e2d3-3895-8c44-fcf23215fc05",
                        "entry_id": "c65585d9-38bb-3bb1-bf2c-7bbfa6311c2c",
                        "glosses": [
                            "Donner un caractère infaillible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db9015e-96fa-4d2c-9936-eab05a755501",
                                "sense_id": "ebb65f42-e2d3-3895-8c44-fcf23215fc05",
                                "text": "Eh bien ! seul cherche aussi d’efficaces moyens D’infaillibiliser tes mécaniciens;"
                            },
                            {
                                "example_id": "a8893846-3e71-4ebb-a573-c2433f78efcf",
                                "sense_id": "ebb65f42-e2d3-3895-8c44-fcf23215fc05",
                                "text": "Remarquons cependant que, dans le cas de très grands ensembles (tels que celui, justement, représenté par la masse humaine) le processus tend à « s’infaillibiliser », les chances de succès croissant du côté hasard, et les chances de refus ou d’erreur diminuant du côté libertés, avec la multiplication des éléments engagés."
                            }
                        ]
                    }
