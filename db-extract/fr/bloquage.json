                        "entry_id": "75a6bda1-66de-3538-b921-41f6b14dc90e",
                        "glosses": [
                            "Variante orthographique de blocage."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fb6daa22-409d-4a18-8187-ff1fc406e352",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "La construction de ce donjon, […], est composée d'un revêtement de pierres irrégulièrement appliquées avec un bloquage de silex et de mortier, qui présente la plus forte résistance […]."
                            },
                            {
                                "example_id": "33995e91-ce42-48b3-83d6-fa945b4485ca",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "Mais dès que ce bloquage aura cessé, les armatures des moteurs seront de nouveau mises en rotation et engendreront des courants qui provoqueront une nouvelle application des freins."
                            },
                            {
                                "example_id": "f76b5678-66e8-462c-8162-71e76f9bb29f",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "Le bloquage de la provision en matière de chèque"
                            },
                            {
                                "example_id": "b81bf233-fa79-4c65-a93f-86b37e9996ee",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "Du bloquage des mâchoires dans le traitement des fractures du maxillaire inférieur"
                            },
                            {
                                "example_id": "6cfd623f-1984-44f9-ab1a-be078673e421",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "L’élévation des sommets ou des bloquages interphasiques peut apparaître séparément, l’une sans l’autre ou l’une après l’autre."
                            },
                            {
                                "example_id": "3968dcc4-44f5-4a3b-a44d-7e599c27bb82",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "Le 23-6-31, après un faux pas, bloquage immédiat en flexion, du genou droit, qui persiste pendant deux jours."
                            },
                            {
                                "example_id": "f88699ef-440f-49fb-b407-b4bb1aea1eb2",
                                "sense_id": "8cbf28c1-590a-3706-8dab-eb0baae4de97",
                                "text": "Le CICR, qui lui est assimilé, saura-t-il dépasser ces bloquages et trouver des appuis auprès des musulmans modérés, qui sont en vérité majoritaires, […]."
                            }
                        ]
