                                    {
                                        "sense_id": "29ce8576-2214-3cf0-ba59-4570f13af9e7",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "An excessively violent or vicious attack; an atrocity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
