                                "target_senses": [
                                    {
                                        "sense_id": "a4785b3a-f956-3042-b6e6-2e39f42cc4ab",
                                        "entry_id": "7121d9ff-09eb-390d-a39b-d95ced1c69f0",
                                        "glosses": [
                                            "D’une manière périodique ; à intervalles réguliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71edebfb-d0af-4b72-9c5e-d6fa6452057d",
                                                "sense_id": "a4785b3a-f956-3042-b6e6-2e39f42cc4ab",
                                                "text": "Ce pays du Dormois fut toujours le champ clos où se vidaient les querelles des Austrasiens et des Neustriens, des Lorrains et des Français, de l'Allemagne et de la France occidentale: il a vu périodiquement ses habitants décimés par les guerres, les épidémies et la famine."
                                            },
                                            {
                                                "example_id": "1d3b7518-d6c4-476a-8384-b3d886283735",
                                                "sense_id": "a4785b3a-f956-3042-b6e6-2e39f42cc4ab",
                                                "text": "Mais la terre jaunâtre et glaiseuse du Perche, désignée dans le pays sous le nom de gruette ou de bournais, exige périodiquement des marnages, en raison de son acidité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e783d4a-afe2-3d8a-abee-b607c66eb2cc",
                                        "entry_id": "7121d9ff-09eb-390d-a39b-d95ced1c69f0",
                                        "glosses": [
                                            "En un style périodique."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353737c5-abde-4507-8b24-73851bda69bd",
                                                "sense_id": "0e783d4a-afe2-3d8a-abee-b607c66eb2cc",
                                                "text": "Parler périodiquement."
                                            }
                                        ]
                                    }
