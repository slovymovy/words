                        "sense_id": "2620fb6c-5ecd-3b75-af43-1d0502203eeb",
                        "entry_id": "2453e344-d50b-3576-a858-bb4b647188f2",
                        "glosses": [
                            "Dog walking; walkies."
                        ],
                        "tags": [
                            "colloquial",
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "8047de71-ad13-4b2a-85ad-1bee0a7ed226",
                                "sense_id": "2620fb6c-5ecd-3b75-af43-1d0502203eeb",
                                "text": "Beim Gassigehen sammelte sie wie alle Hunde gerne Stöckchen, um damit zu spielen.",
                                "translation": "Like all dogs, she liked collecting sticks on walks with which to play.",
                                "english": "Like all dogs, she liked collecting sticks on walks with which to play."
                            },
                            {
                                "example_id": "e13e1a95-0d97-40bc-829f-a902e9de4dee",
                                "sense_id": "2620fb6c-5ecd-3b75-af43-1d0502203eeb",
                                "text": "Das sieht aus wie ein Maulkorb, ist es aber nicht, sondern es unterstützt wunderbar die Art des Gassigehens an der Leine und so geht er damit perfekt bei Fuß.",
                                "translation": "That looks like a muzzle, but it's not - rather, it supports the style of dog walking on the lead wonderfully, and therefore the dog goes perfectly by the feet.",
                                "english": "That looks like a muzzle, but it's not - rather, it supports the style of dog walking on the lead wonderfully, and therefore the dog goes perfectly by the feet."
                            },
                            {
                                "example_id": "7d36f076-573c-405e-b9ad-2844e31f84f4",
                                "sense_id": "2620fb6c-5ecd-3b75-af43-1d0502203eeb",
                                "text": "Oft begleitete ich meinen Vater auf den Dressurplatz, und meine Hausaufgaben erledigte ich während des täglichen Gassigehens mit dem Hund in dem umliegenden Grünanlagen",
                                "translation": "I often accompanied my father to the showgrounds, and I finished my homework during the daily walks with the dog in the surrounding green areas.",
                                "english": "I often accompanied my father to the showgrounds, and I finished my homework during the daily walks with the dog in the surrounding green areas."
                            }
                        ]
                    }
