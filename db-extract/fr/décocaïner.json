                "senses": [
                    {
                        "sense_id": "3249ead9-c14d-364f-a836-6630ead07e67",
                        "entry_id": "c9ad5d00-4389-3098-a5f6-00fb184d6057",
                        "glosses": [
                            "Débarrasser de la cocaïne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6b9175-1aec-4f69-85af-d369ec19e839",
                                "sense_id": "3249ead9-c14d-364f-a836-6630ead07e67",
                                "text": "En effet, dans la nuit, quand le soleil se couche, les étoiles ne brillent pas fort, je suis comme un néon éteint, un café décaféiné, un coca « décocaïné », un comprimé d’adrénaline, ça fait comme un éclair dans le brouillard."
                            },
                            {
                                "example_id": "a912af43-f4cc-4d6e-81a7-cbee631b0bb0",
                                "sense_id": "3249ead9-c14d-364f-a836-6630ead07e67",
                                "text": "Il mit au point un mélange comprenant de l’extrait de noix de kola, du sucre, de la caféine, des feuilles de coca décocaïnées et un composé d’extraits végétaux."
                            },
                            {
                                "example_id": "d1dad060-6c76-44b4-a880-993e1716e694",
                                "sense_id": "3249ead9-c14d-364f-a836-6630ead07e67",
                                "text": "1903: Candler engage des spécialistes pour «décocaïner» la feuille de coca."
                            }
                        ]
                    }
                ],
