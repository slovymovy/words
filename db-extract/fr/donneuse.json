                "senses": [
                    {
                        "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                        "glosses": [
                            "Celle qui donne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88107c22-0046-4096-be2d-788268a923d6",
                                "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                                "text": "Donneuse d’eau bénite. → voir bénir"
                            },
                            {
                                "example_id": "e5af3296-3685-4317-aeb6-5c2c9afa0a0d",
                                "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                                "text": "Pas question de me poser en donneuse de leçons, mais j’estime que chacun d’entre nous peut et doit assumer sa responsabilité citoyenne."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                        "glosses": [
                            "Personne, homme ou femme, qui pratique la délation."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0a32bbae-331c-4874-ae67-3229dae6139e",
                                "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                                "text": "Voyant les flics arriver, une vraie donneuse se mit à glapir en me désignant : « Le voilà ! Il est là, il est là. »"
                            },
                            {
                                "example_id": "13a5d325-c90d-410d-9eca-4a4d2d91698a",
                                "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                                "text": "Il s’est fait poucave par une donneuse. La police est venue perkize chez lui, et il a téssau."
                            }
                        ]
                    },
                    {
                        "sense_id": "7541f313-5d23-3762-98e0-8460791f00ea",
                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                        "glosses": [
                            "Celle qui distribue les cartes ou les jetons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2952f75-2700-45eb-8f64-663466659d35",
                                "sense_id": "7541f313-5d23-3762-98e0-8460791f00ea",
                                "text": "« Mais je croyais qu’on devait jouer au poker », dis-je. « Cela mis à part, la partie se joue tout comme au poker ordinaire », dit la donneuse."
                            }
                        ]
                    }
                ],
