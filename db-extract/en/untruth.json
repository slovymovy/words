                                        "entry_id": "5c4b1072-482e-318d-95a5-2ce0f8148a33",
                                        "glosses": [
                                            "то, что противоречит правде, истине; ложь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0231dc14-37a7-4688-b6ce-503ff7f438e3",
                                                "sense_id": "5f4ea144-1cfd-3ac2-b7d5-e963800bf6f5",
                                                "text": "На вашей прежней квартире мне сказали, что вы уехали из города; я знал, что это неправда."
                                            },
                                            {
                                                "example_id": "3dfd6077-cf5f-49bb-ae2e-5d0941f97e45",
                                                "sense_id": "5f4ea144-1cfd-3ac2-b7d5-e963800bf6f5",
                                                "text": "Весь мой дальнейший рассказ и с этой стороны неизбежно обречён на лживость, на неправду."
                                            },
                                            {
                                                "example_id": "2e741460-47bf-4871-a7e0-a219b8d93568",
                                                "sense_id": "5f4ea144-1cfd-3ac2-b7d5-e963800bf6f5",
                                                "text": "Говорят: «Неуклюжий, как медведь!» Это неправда. Бурый медведь быстрый, ловкий и очень сильный зверь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c2ffc7-9dbf-3a44-a44b-4903d2111e61",
                                        "entry_id": "5c4b1072-482e-318d-95a5-2ce0f8148a33",
                                        "glosses": [
                                            "отсутствие справедливости; неправое дело, обман, мошенничество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de59c293-87bb-478f-9bd3-93fdde3f4ff5",
                                                "sense_id": "65c2ffc7-9dbf-3a44-a44b-4903d2111e61",
                                                "text": "Он менее всех идеализировал древнюю Россию и прямо говорил о её неправдах."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "непра́вда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "05516852-4064-3a43-8de0-0ed194a04202",
                                        "entry_id": "0d0c7c94-b752-3c4b-b8b0-cfecbc668b8d",
                                        "glosses": [
