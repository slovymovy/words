                                "target_lang_sense_clarification": "甜点名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3196ac8d-a7a2-3582-9f3e-706f354cacaf",
                    "sense_definition": "Divided or separated into parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_divided",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judges gave a <w>split</w> decision, with two voting for the champion and one against.",
                            "target_lang_translations": {
                                "ru": "Судьи вынесли <w>раздельное</w> решение: двое проголосовали за чемпиона, а один против.",
