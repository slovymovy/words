                    {
                        "sense_id": "c4a2eee5-25a3-352e-8db4-71c5b8f575c4",
                        "entry_id": "739a6bad-3dfa-3931-9ccd-ea011f7e47b2",
                        "glosses": [
                            "een jonge nog onvolgroeide geboste ui met blad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71bdb6f1-f647-4c2a-bf33-555412feef44",
                                "sense_id": "c4a2eee5-25a3-352e-8db4-71c5b8f575c4",
                                "text": "Spijtig genoeg delft de winterwortel qua smaak het onderspit tegen de lente-ui. Ach, op zich geen verkeerd soepje, maar spannend is het niet."
                            },
                            {
                                "example_id": "7d6b00ad-7614-4e10-a123-74abec9ccdd7",
                                "sense_id": "c4a2eee5-25a3-352e-8db4-71c5b8f575c4",
                                "text": "Giet de kokosmelk in de blender samen met de tomaten, de look, de lente-ui, de tomatenpuree, het limoensap, de gember, het kerriepoeder, het zout, de ahornsiroop en wat cayennepeper."
                            }
                        ]
                    }
