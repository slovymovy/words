            "senses": [
                {
                    "sense_id": "e52961dd-afa0-3010-ac4c-c9f46ffbed87",
                    "sense_definition": "łapać zwierzęta wodne lub inne za pomocą wędki, sieci lub pułapki",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "polowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdy weekend mój ojciec i brat <w>łowią</w> ryby w pobliskim jeziorze.",
                            "target_lang_translations": {
                                "ru": "Каждые выходные мои отец и брат <w>ловят</w> рыбу в близлежащем озере."
                            }
                        },
                        {
                            "text": "Stary rybak codziennie o świcie wypływa na morze i <w>łowi</w> na wędkę.",
                            "target_lang_translations": {
                                "ru": "Старый рыбак каждый день на рассвете выходит в море и <w>удит</w> на удочку."
                            }
                        }
                    ],
                    "synonyms": [
                        "chwytać",
                        "łapać"
                    ],
                    "common_phrases": [
                        "łowić ryby",
                        "łowić na wędkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "ловить водных или других животных с помощью удочки, сети или ловушки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить",
                                "target_lang_sense_clarification": "рыбу или дичь"
                            },
                            {
                                "target_lang_word": "удить",
                                "target_lang_sense_clarification": "рыбу на удочку"
                            },
                            {
                                "target_lang_word": "рыбачить",
                                "target_lang_sense_clarification": "заниматься рыбной ловлей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6b7063-ea2e-3446-9a06-41a7ef359b49",
                    "sense_definition": "natężać uwagę, aby coś usłyszeć, dostrzec lub wychwycić zmysłami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Siedziałem cicho w ciemnym pokoju i z napięciem <w>łowiłem</w> każdy podejrzany dźwięk dochodzący z korytarza.",
                            "target_lang_translations": {
                                "ru": "Я тихо сидел в тёмной комнате и с напряжением <w>ловил</w> каждый подозрительный звук, доносившийся из коридора."
                            }
                        },
                        {
                            "text": "Prezenter mówił szybko, a publiczność w skupieniu <w>łowiła</w> każde słowo jego przemówienia.",
                            "target_lang_translations": {
                                "ru": "Ведущий говорил быстро, а публика сосредоточенно <w>ловила</w> каждое слово его речи."
                            }
                        }
                    ],
                    "synonyms": [
                        "chwytać",
                        "łapać"
                    ],
                    "common_phrases": [
                        "łowić spojrzenia",
                        "łowić uchem",
                        "łowić każde słowo"
                    ],
                    "target_lang_definitions": {
                        "ru": "напрягать слух или зрение, чтобы что-то услышать, заметить или уловить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить",
                                "target_lang_sense_clarification": "звуки, взгляды, слова"
                            },
                            {
                                "target_lang_word": "улавливать",
                                "target_lang_sense_clarification": "воспринимать органами чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec06380-1671-34f2-b47f-cdc72d4a447e",
                    "sense_definition": "wyśmiewać kogoś lub żartować z kogoś",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drwina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach studenci często bezlitośnie <w>łowili</w> naiwnych nowicjuszy na uniwersytecie.",
                            "target_lang_translations": {
                                "ru": "В былые времена студенты часто беспощадно <w>подшучивали над</w> наивными новичками в университете."
                            }
                        },
                        {
                            "text": "Zauważył wreszcie, że towarzysze tylko z niego <w>łowią</w> i przestał brać ich słowa na poważnie.",
                            "target_lang_translations": {
                                "ru": "Он наконец заметил, что товарищи лишь <w>насмехаются</w> над ним, и перестал воспринимать их слова всерьёз."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "высмеивать кого-либо или подшучивать над кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "насмехаться, подкалывать"
                            },
                            {
                                "target_lang_word": "насмехаться",
                                "target_lang_sense_clarification": "высмеивать кого-либо"
                            },
                            {
                                "target_lang_word": "подкалывать",
                                "target_lang_sense_clarification": "разыгрывать кого-то"
                            }
                        ]
                    }
                }
            ]
        }
