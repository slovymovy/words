{
    "word_family": [
        "skład",
        "składka",
        "składnik",
        "składnia",
        "złożenie",
        "złożoność"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a0c939c-00ad-3496-b072-3fcc60e2d48c",
                    "sense_definition": "zginać, załamywać coś, zmniejszając jego objętość",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "składanie_przedmiotów",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Składam</w> teraz namiot do pokrowca.",
                            "target_lang_translations": {
                                "ru": "Я сейчас <w>складываю</w> палатку в чехол."
                            }
                        },
                        {
                            "text": "Po praniu zawsze <w>składam</w> wszystkie koszulki w kostkę.",
                            "target_lang_translations": {
                                "ru": "После стирки я всегда <w>складываю</w> все футболки в стопку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "składać ubrania",
                        "składać papier"
                    ],
                    "target_lang_definitions": {
                        "ru": "сгибать или складывать что-либо, уменьшая объем предмета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складывать",
                                "target_lang_sense_clarification": "перегибать плоский объект или уменьшать занимаемое место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5f5ddef-e726-305e-8b7c-6a4deabdd983",
                    "sense_definition": "budować coś z elementów, łączyć części w jedną całość",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "składanie_przedmiotów",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od wczoraj uparcie <w>składam</w> model samolotu.",
                            "target_lang_translations": {
                                "ru": "Со вчерашнего дня я упорно <w>собираю</w> модель самолета."
                            }
                        },
                        {
                            "text": "Dziecko <w>składa</w> klocki w duży zamek.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>собирает</w> из кубиков большой замок."
                            }
                        }
                    ],
                    "synonyms": [
                        "układać"
                    ],
                    "common_phrases": [
                        "składać meble",
                        "składać komputer"
                    ],
                    "target_lang_definitions": {
                        "ru": "создавать что-либо из отдельных элементов, соединяя их в целое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "получать сложный объект путем объединения готовых частей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a8c35c1-d8a6-39b6-a286-23ee10fc13ee",
                    "sense_definition": "przekazywać coś komuś w formie oficjalnej lub uroczystej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Składałem</w> mu życzenia zaraz po przyjściu na jego imieniny.",
                            "target_lang_translations": {
                                "ru": "Я <w>выражал</w> ему поздравления сразу после прихода на его именины."
                            }
                        },
                        {
                            "text": "<w>Składam</w> podanie do urzędu z prośbą o rozpatrzenie skargi.",
                            "target_lang_translations": {
                                "ru": "Я <w>подаю</w> заявление в учреждение с просьбой рассмотреть жалобу."
                            }
                        }
                    ],
                    "synonyms": [
                        "wręczać"
                    ],
                    "common_phrases": [
                        "składać życzenia",
                        "składać oświadczenie",
                        "składać podanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "официально или торжественно передавать, подавать или выражать что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "официально передавать документ (например, заявление)"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "официально передавать пожелания или поздравления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d03bb9a-f5cf-35fe-943f-ff0b26d57348",
                    "sense_definition": "gromadzić pieniądze lub zasoby",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>składać</w> grosz do grosza, aby kupić jej prezent.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>откладывать</w> копейку к копейке, чтобы купить ей подарок."
                            }
                        },
                        {
                            "text": "Rodzina <w>składa</w> pieniądze na wakacyjny wyjazd.",
                            "target_lang_translations": {
                                "ru": "Семья <w>собирает</w> деньги на поездку в отпуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbierać"
                    ],
                    "antonyms": [
                        "rozdawać"
                    ],
                    "common_phrases": [
                        "składać na cel"
                    ],
                    "target_lang_definitions": {
                        "ru": "накапливать денежные средства или ресурсы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "получать деньги от группы лиц или накапливать их"
                            },
                            {
                                "target_lang_word": "откладывать",
                                "target_lang_sense_clarification": "копить деньги, сберегать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16ea31c6-1c11-3cd7-94a9-2b13a5006095",
                    "sense_definition": "mieć coś za swoje części składowe",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "skład_całości",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silnik <w>składa</w> się z gaźnika, tłoków i wielu innych elementów.",
                            "target_lang_translations": {
                                "ru": "Двигатель <w>состоит</w> из карбюратора, поршней и многих других элементов."
                            }
                        },
                        {
                            "text": "Ta grupa <w>składa</w> się z samych specjalistów.",
                            "target_lang_translations": {
                                "ru": "Эта группа <w>состоит</w> из одних специалистов."
                            }
                        }
                    ],
                    "synonyms": [
                        "zawierać",
                        "obejmować"
                    ],
                    "common_phrases": [
                        "składać się z"
                    ],
                    "target_lang_definitions": {
                        "ru": "состоять из определенных частей или элементов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоять из",
                                "target_lang_sense_clarification": "иметь в своем составе определенные компоненты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}