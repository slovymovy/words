        "fr-extract.jsonl": [
            {
                "entry_id": "c75f5b88-e5ad-3c5a-8bba-8cfb2a80866e",
                "word": "répression",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2b38803-4792-4e6c-9c84-b3b8e06f3699",
                        "entry_id": "c75f5b88-e5ad-3c5a-8bba-8cfb2a80866e",
                        "tags": [
                            "plural"
                        ],
                        "form": "répressions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                        "entry_id": "c75f5b88-e5ad-3c5a-8bba-8cfb2a80866e",
                        "glosses": [
                            "Action de réprimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543f234a-9cad-4f93-babf-6ec61eb0b473",
                                "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                                "text": "Avant la conquête française, la Kabylie ne connaissait pas d’autre mode de répression que la vengeance privée et les Kabyles n’étaient pas de mauvaises gens."
                            },
                            {
                                "example_id": "6bf6c16a-8113-425c-b97e-a6b5adadea96",
                                "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                                "text": "Les fusils partaient, des étrangers étaient tués. L’ordre revenu, on punit quelque fellahs en guise d’exemple. Son père, dont le caractère était vif, périt dans la répression."
                            },
                            {
                                "example_id": "62651b39-4f20-41e0-ad43-3124acc7ff2a",
                                "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                                "text": "La « drôle de guerre » menée par la bourgeoisie française plus soucieuse de répression anticommuniste et de menées antisoviétiques que de lutte antihitlérienne oblitère pour le plus grand nombre le sens de la guerre."
                            },
                            {
                                "example_id": "f543c336-2151-4476-a53d-4f9c0c9ba305",
                                "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                                "text": "Le gouvernement ordonne une répression sanglante. Arrestations, pendaisons, exécutions sommaires plongent Tripoli dans un bain de sang."
                            },
                            {
                                "example_id": "ded25048-c59c-4432-b6c6-985ab51f03e7",
                                "sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                                "text": "Entre la répression et la licence se trouve le juste milieu du contrôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aebb9675-3305-483a-8602-d2a8363ead3b",
                        "source_entry_id": "c75f5b88-e5ad-3c5a-8bba-8cfb2a80866e",
                        "source_sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
                        "target_lang_word": "Niederschlagung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niederschlagung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c591463-665e-3cd6-ac57-3692d4224f3b",
                                        "entry_id": "915324b3-fb56-36e7-ae58-2630f4285c65",
                                        "glosses": [
                                            "einen Aufstand, eine Demonstration oder Ähnliches gewaltsam beenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b9ebd7c-06e2-4fff-b3fb-230018bd5aa1",
                                                "sense_id": "2c591463-665e-3cd6-ac57-3692d4224f3b",
                                                "text": "„25 v. Chr. war die Legion an der Niederschlagung eines Aufstands in Spanien beteiligt.“"
                                            },
                                            {
                                                "example_id": "e6ec9fbe-037f-4fe7-ad8f-b5602a9f437d",
                                                "sense_id": "2c591463-665e-3cd6-ac57-3692d4224f3b",
                                                "text": "„Auch nach dem Untergang Weimars und der Niederschlagung des europäischen Faschismus hat die Geschichte von Paul Bäumer und seinen Kameraden jede heranwachsende Generation bewegt und gefesselt.“"
                                            },
                                            {
                                                "example_id": "c6b269e7-9cea-4961-8134-37a59397c36f",
                                                "sense_id": "2c591463-665e-3cd6-ac57-3692d4224f3b",
                                                "text": "„In den wenigen Jahren der Veröffentlichung der Thesen bis zur Niederschlagung des Bauernaufstandes liefen rund 3000 Flugschriften um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c635e5e-4c33-30dc-9384-77656b76d231",
                                        "entry_id": "915324b3-fb56-36e7-ae58-2630f4285c65",
                                        "glosses": [
                                            "„Abstandnahme von weiterer Beitreibung nach erfolgloser Vollstreckung“"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a7a0ff-eef5-4877-9756-83ed2ada7e83",
                                                "sense_id": "9c635e5e-4c33-30dc-9384-77656b76d231",
                                                "text": "Da Niederschlagung als verwaltungsinterne Maßnahme keine Außenwirkung besitzt, verpflichtet sie nicht zu einer Einstellung der Vollstreckung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe3facc-8d89-4e44-83a9-e564f0f8395d",
                        "source_entry_id": "c75f5b88-e5ad-3c5a-8bba-8cfb2a80866e",
                        "source_sense_id": "b3e72b49-c5aa-3092-8aca-2d95cc851426",
