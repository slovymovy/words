{
    "word_family": [
        "augmentation",
        "augmentatif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91d5aa13-4ef1-3dfd-85ac-c576bb2f9c56",
                    "sense_definition": "Rendre plus grand en nombre, en quantité, en volume ou en intensité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "variation_quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé d'<w>augmenter</w> les impôts pour financer les nouveaux projets."
                        },
                        {
                            "text": "Vous devez <w>augmenter</w> la température du four pour cuire ce gâteau correctement."
                        }
                    ],
                    "synonyms": [
                        "accroître"
                    ],
                    "antonyms": [
                        "diminuer",
                        "réduire"
                    ],
                    "common_phrases": [
                        "augmenter la cadence",
                        "augmenter la vitesse",
                        "augmenter la dose"
                    ]
                },
                {
                    "sense_id": "59bbed5a-fa91-3ce8-840c-424ec47a3d53",
                    "sense_definition": "Devenir plus grand, plus nombreux, plus important ou plus intense.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "variation_quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nombre d'étudiants <w>augmente</w> chaque année dans cette université réputée."
                        },
                        {
                            "text": "Le vent <w>augmente</w> rapidement et annonce une violente tempête pour ce soir."
                        }
                    ],
                    "synonyms": [
                        "croître"
                    ],
                    "antonyms": [
                        "diminuer"
                    ],
                    "common_phrases": [
                        "augmenter sans cesse",
                        "ne faire qu'augmenter"
                    ]
                },
                {
                    "sense_id": "0b906cef-05a8-309f-96b5-8c4e4be21fd6",
                    "sense_definition": "Devenir plus cher, en parlant d'un prix ou d'une marchandise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prix de l'essence a encore <w>augmenté</w> cette semaine dans toutes les stations."
                        },
                        {
                            "text": "Les loyers <w>augmentent</w> trop vite dans les grandes villes de la région."
                        }
                    ],
                    "antonyms": [
                        "diminuer"
                    ],
                    "common_phrases": [
                        "augmenter fortement"
                    ]
                },
                {
                    "sense_id": "1d555518-aa45-390a-b3f7-996248201fc8",
                    "sense_definition": "Accorder une rémunération plus élevée à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a promis d'<w>augmenter</w> tous les salariés au début de l'année prochaine."
                        },
                        {
                            "text": "Si le directeur ne m'<w>augmente</w> pas, je chercherai un autre travail ailleurs."
                        }
                    ],
                    "common_phrases": [
                        "augmenter un employé",
                        "être augmenté"
                    ]
                }
            ]
        }
    ]
}