                {
                    "sense_id": "a20e7006-e618-3014-b5e5-e6a94a1142ac",
                    "sense_definition": "Having the quality of frightening or threatening someone, especially in order to make them do what one wants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "threatening_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness reported that the suspect used <w>intimidatory</w> tactics to prevent her from testifying in court.",
                            "target_lang_translations": {
                                "ru": "Свидетельница сообщила, что подозреваемый использовал <w>запугивающую</w> тактику, чтобы помешать ей дать показания в суде."
                            }
                        },
                        {
                            "text": "The remarks have to be nothing less than intentionally <w>intimidatory</w> behavior designed to silence the opposition.",
                            "target_lang_translations": {
                                "ru": "Эти замечания являются не чем иным, как намеренно <w>устрашающим</w> поведением, направленным на то, чтобы заставить оппозицию замолчать."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidating",
                        "menacing",
                        "threatening"
                    ],
                    "antonyms": [
                        "reassuring",
                        "encouraging"
                    ],
                    "common_phrases": [
                        "intimidatory-behavior",
                        "intimidatory-tactics",
                        "intimidatory-manner"
                    ],
                    "traits": [
