                        "entry_id": "4ae70560-b70c-3fc7-b9da-939ffabd2914",
                        "glosses": [
                            "Forschungszweig, der sich mit der Produktion von Nahrung und nachwachsenden Rohstoffen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f808275d-f661-441b-9f75-26559bd503f9",
                                "sense_id": "b2563add-89d7-3dd0-a5fd-38e87ac8dffc",
                                "text": "Die Agrarwissenschaft profitiert auch von der Genforschung."
                            }
