                        "travail d'historien"
                    ]
                },
                {
                    "sense_id": "72521017-cd34-3622-aed4-8b471d142c74",
                    "sense_definition": "Auteur ou chroniqueur d'une époque reculée qui a consigné les événements de son temps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chroniqueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les récits des <w>historiens</w> antiques nous renseignent sur la vie quotidienne à Rome."
                        },
                        {
                            "text": "Nous connaissons les détails de cette bataille grâce aux écrits d'un <w>historien</w> grec."
                        }
                    ],
                    "synonyms": [
                        "chroniqueur",
                        "annaliste"
                    ],
