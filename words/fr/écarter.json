{
    "word_family": [
        "écart",
        "écartement",
        "écarteler",
        "écartèlement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bddb73e9-d6e1-35eb-b034-42aa7fa8bfab",
                    "sense_definition": "Éloigner des personnes ou des choses les unes des autres, ou les mettre sur le côté pour dégager un passage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû <w>écarter</w> les branches pour avancer dans cette forêt dense."
                        },
                        {
                            "text": "Elle a <w>écarté</w> les rideaux pour laisser entrer la lumière du matin."
                        }
                    ],
                    "common_phrases": [
                        "écarter les rideaux",
                        "écarter les branches"
                    ]
                },
                {
                    "sense_id": "4a453fda-2d92-3ab9-b2a0-11f79cc266f7",
                    "sense_definition": "Rejeter ou ne pas retenir une possibilité, une hypothèse ou une idée jugée inappropriée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ont rapidement pu <w>écarter</w> l'hypothèse d'un accident."
                        },
                        {
                            "text": "Nous ne pouvons pas <w>écarter</w> cette option sans l'avoir étudiée sérieusement."
                        }
                    ],
                    "common_phrases": [
                        "écarter une hypothèse",
                        "écarter une possibilité",
                        "écarter tout danger"
                    ]
                },
                {
                    "sense_id": "cf2575bf-a741-3b1a-b0c4-9a3ef7b28dba",
                    "sense_definition": "Ouvrir ou déployer les membres ou les doigts en augmentant la distance entre eux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur de gymnastique demande aux élèves d'<w>écarter</w> les bras."
                        },
                        {
                            "text": "Le médecin lui a demandé d'<w>écarter</w> les doigts pendant l'examen médical."
                        }
                    ],
                    "common_phrases": [
                        "écarter les bras",
                        "écarter les jambes",
                        "écarter les doigts"
                    ]
                },
                {
                    "sense_id": "0c4746dc-2818-3759-bf7a-45be51a39bc8",
                    "sense_definition": "Éloigner ou exclure quelqu'un d'une fonction, d'une responsabilité ou d'un groupe d'influence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le scandale financier, le congrès a voté pour <w>écarter</w> le président du pouvoir."
                        },
                        {
                            "text": "La direction a décidé d'<w>écarter</w> ce collaborateur des réunions stratégiques."
                        }
                    ],
                    "common_phrases": [
                        "écarter du pouvoir",
                        "écarter un rival"
                    ]
                },
                {
                    "sense_id": "6f088dbb-ec80-367f-a5a7-c007745e6c75",
                    "sense_definition": "Détourner quelqu'un d'une direction, d'un but ou d'une règle de conduite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rien ne pourra l'<w>écarter</w> de son projet professionnel cette année."
                        },
                        {
                            "text": "Ses mauvaises fréquentations ont fini par l'<w>écarter</w> du droit chemin."
                        }
                    ],
                    "common_phrases": [
                        "écarter du droit chemin",
                        "écarter de la trajectoire"
                    ]
                },
                {
                    "sense_id": "e8b9bd5d-7c25-360c-94f1-5b919f999900",
                    "sense_definition": "Mettre à part ou rejeter les cartes dont on ne veut pas se servir dans certains jeux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au tarot, il est strictement interdit d'<w>écarter</w> les rois."
                        },
                        {
                            "text": "Chaque joueur doit <w>écarter</w> trois cartes avant de commencer la partie."
                        }
                    ],
                    "synonyms": [
                        "discarter"
                    ]
                }
            ]
        }
    ]
}