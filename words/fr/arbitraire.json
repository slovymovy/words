    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "157921bf-39d2-3156-bb3f-04663cb711ef",
                    "sense_definition": "Qui ne dépend que de la volonté ou du caprice d'une autorité, sans respecter les lois ou la justice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tyrannique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette arrestation <w>arbitraire</w> a provoqué une vive indignation parmi les défenseurs des droits humains."
                        },
                        {
                            "text": "Le directeur impose des règles injustes par une décision <w>arbitraire</w> que personne ne comprend."
                        }
                    ],
                    "synonyms": [
                        "abusif",
                        "despotique",
                        "tyrannique"
                    ],
                    "antonyms": [
                        "équitable",
                        "juste",
                        "légal"
                    ],
                    "common_phrases": [
                        "arrestation arbitraire",
                        "décision arbitraire",
                        "pouvoir arbitraire"
                    ]
                },
                {
                    "sense_id": "cfbca606-b0fc-310f-b80f-9ad96445a66d",
                    "sense_definition": "Qui résulte d'un choix libre ou d'une convention, sans obligation logique ou naturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conventionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le linguiste explique que le lien entre le mot et la chose reste totalement <w>arbitraire</w>."
                        },
                        {
                            "text": "Fixer le prix de vente selon ce critère <w>arbitraire</w> risque de désorienter les clients."
                        }
                    ],
                    "synonyms": [
                        "conventionnel",
                        "aléatoire"
                    ],
                    "antonyms": [
                        "naturel",
                        "nécessaire",
                        "rationnel"
                    ],
                    "common_phrases": [
                        "choix arbitraire",
                        "critère arbitraire",
                        "ordre arbitraire"
                    ]
                },
                {
                    "sense_id": "6a2c5927-a502-3c6a-82a0-8e8eed98a39c",
                    "sense_definition": "Qui est remis à la libre appréciation et à la décision du juge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a prononcé une peine <w>arbitraire</w> conformément aux pouvoirs attribués au magistrat."
                        },
                        {
                            "text": "Le montant des dommages est parfois soumis à une évaluation <w>arbitraire</w> du juge."
