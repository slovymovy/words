                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dd42977-466e-3c72-8508-ed46d1599c3a",
                        "entry_id": "e63a0893-1310-367a-bb8f-69f9b6d9223d",
                        "glosses": [
                            "действие по значению гл. имитировать; подражание кому-либо или чему-либо, попытка точного воспроизведения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fad8d2c-ff63-4404-905a-9385776b7b95",
                                "sense_id": "1dd42977-466e-3c72-8508-ed46d1599c3a",
                                "text": "Для этой цели выделяются специальные команды во главе с опытным офицером, которые и проводят имитацию по определенному плану."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9517678-7ffc-3c43-bece-9be4207d8d8e",
                        "entry_id": "e63a0893-1310-367a-bb8f-69f9b6d9223d",
                        "glosses": [
                            "результат такого действия, подделка, копия чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09339a34-adb9-4c7e-b174-6f783336fa6c",
                                "sense_id": "f9517678-7ffc-3c43-bece-9be4207d8d8e",
                                "text": "Документальная фактура его рассказов — лишь обманчивая имитация."
                            },
                            {
                                "example_id": "bfc2fd04-ac8a-4ec8-b5b0-ce768e7f20c2",
                                "sense_id": "f9517678-7ffc-3c43-bece-9be4207d8d8e",
                                "text": "Что касается имитаций жемчуга, они достаточно легко диагностируются визуально, т.к. их поверхность обычно покрывается «жемчужной эссенцией», которая не дает столь характерного жемчужного блеска."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab101a45-0d7a-4fd1-be07-60fed29d6c96",
                        "source_entry_id": "e63a0893-1310-367a-bb8f-69f9b6d9223d",
                        "source_sense_description": "действие с целью подражания",
                        "target_lang_word": "mimicking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimicking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a98ce8-f794-3763-8514-bf2fe5f388d1",
                                        "entry_id": "75dc79a1-3307-34ae-8270-bf7f75916668",
                                        "glosses": [
                                            "gerund of mimic: mimicry; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "279c0e21-8f39-487a-a417-34fee840494a",
                                                "sense_id": "d6a98ce8-f794-3763-8514-bf2fe5f388d1",
                                                "text": "They had a thousand odd stories and jokes about the events of the day, and burlesque descriptions and mimickings of the spectators who had been admiring them."
                                            },
                                            {
                                                "example_id": "77863416-836e-436c-8e95-cd8a27ab8e8c",
                                                "sense_id": "d6a98ce8-f794-3763-8514-bf2fe5f388d1",
                                                "text": "Many within our community view childrearing with skepticism or disdain. Affirmatively choosing parenting as a gay man or lesbian is often seen as a retreat from public activism to private life or as a mimicking of heterosexuality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mimicking",
                                "target_lang_code": "en",
                                "target_senses": [
