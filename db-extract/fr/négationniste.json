                                    {
                                        "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                        "entry_id": "d84bb47f-ffff-3eeb-9d19-90ab6d5b7ef7",
                                        "glosses": [
                                            "One who denies an assertion in a controversial debate."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c00658c4-dece-421c-b485-0a88954bf867",
                                                "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                                "text": "The whole point of the TAC and other Aids activists is that the country can never deal with its Aids problem while the president is an Aids denialist, and while the government keeps putting back the timetable for providing ARVs."
                                            },
                                            {
                                                "example_id": "0b569e8f-927a-4e9c-82ea-05d221aa365a",
                                                "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                                "text": "The Advertising Standards Authority (ASA) has found in favour of the Treatment Action Campaign, which complained to it about an advertisement that was placed by a controversial German Aids denialist and which said, among other things, that anti-retrovirals were poisonous."
                                            }
                                        ]
                                    }
                                ]
                            },
