                "senses": [
                    {
                        "sense_id": "3a7503cd-d8a8-3883-9e0c-4a4679f79a3c",
                        "entry_id": "4d4adfab-02d4-3b0f-a11b-5090674e9276",
                        "glosses": [
                            "Donner un caractère anti-européen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35cef35-002b-439d-83ec-11d09f2b6643",
                                "sense_id": "3a7503cd-d8a8-3883-9e0c-4a4679f79a3c",
                                "text": "Les premiers à nous anti-européaniser, ce sont qui nous dirigent actuellement en nous expliquant que tous nos malheurs viennent de l'euro et de l'Europe."
                            },
                            {
                                "example_id": "44cbaece-ad58-4390-b3f1-f3c9ce965d74",
                                "sense_id": "3a7503cd-d8a8-3883-9e0c-4a4679f79a3c",
                                "text": "Allez-y jeunes, faites-nous sauter cet Elysée anti-européanisé."
                            },
                            {
                                "example_id": "e0cc75ec-56c8-45cd-977c-eec7add037e8",
                                "sense_id": "3a7503cd-d8a8-3883-9e0c-4a4679f79a3c",
                                "text": "Edith me conseille de vous dire que cette personne est un excellent vendeur avec de très bon prix (une planche de cocobolo 60x8x2,5 à 10 euros y'a pas grand chose à redire) mais qu'étant américain, les frais de port seront conditionnés par la poste US ayant récemment changé ses tarifs qui se sont largement \"anti-européanisés\"...si vous voyez ce que je veux dire."
                            }
                        ]
                    }
