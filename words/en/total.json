{
    "word_family": [
        "totally",
        "totality",
        "subtotal",
        "totalize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                    "sense_definition": "Relating to the whole of something; comprising the entire number or amount.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_sum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>total</w> cost of the trip was much higher than we expected.",
                            "target_lang_translations": {
                                "ru": "<w>Общая</w> стоимость поездки оказалась намного выше, чем мы ожидали.",
                                "zh": "这次旅行的<w>总</w>费用比我们预期的要高得多。"
                            }
                        },
                        {
                            "text": "Please write down the <w>total</w> number of guests attending the wedding.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, запишите <w>общее</w> количество гостей, присутствующих на свадьбе.",
                                "zh": "请写下参加婚礼的宾客<w>总</w>人数。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entire",
                        "whole",
                        "full",
                        "complete"
                    ],
                    "antonyms": [
                        "partial",
                        "incomplete"
                    ],
                    "common_phrases": [
                        "total number",
                        "total amount",
                        "total cost",
                        "total value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к целому; составляющий полное количество или сумму.",
                        "zh": "指事物的全部；包含整个数量或金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "о количестве или сумме"
                            },
                            {
                                "target_lang_word": "весь",
                                "target_lang_sense_clarification": "целиком"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "целый, без изъятия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总",
                                "target_lang_sense_clarification": "指整体的、全部的"
                            },
                            {
                                "target_lang_word": "全部",
                                "target_lang_sense_clarification": "指所有部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bc72b52-22f8-3810-a862-275ebb77cbfb",
                    "sense_definition": "Complete and absolute; used to emphasize the extreme degree of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree_completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting was a <w>total</w> waste of time for everyone involved.",
                            "target_lang_translations": {
                                "ru": "Встреча стала <w>полной</w> тратой времени для всех участников.",
                                "zh": "这次会议对所有参与者来说都是<w>完全</w>浪费时间。"
                            }
                        },
                        {
                            "text": "He felt like a <w>total</w> stranger in his own hometown.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>полным</w> чужаком в родном городе.",
                                "zh": "他在自己的家乡感到像个<w>完全</w>的陌生人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "complete",
                        "utter",
                        "thorough",
                        "sheer",
                        "outright",
                        "entire"
                    ],
                    "antonyms": [
                        "partial",
                        "limited"
                    ],
                    "common_phrases": [
                        "total failure",
                        "total disaster",
                        "total silence",
                        "total stranger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный и абсолютный; используется для подчеркивания крайней степени чего-либо.",
                        "zh": "完全且绝对的；用于强调某事物的极端程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный"
                            },
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "безусловный"
                            },
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "в полной мере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "指程度彻底"
                            },
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "指程度极深"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e4e047-8fc1-383f-a173-d9f0b23351f6",
                    "sense_definition": "Defined for all possible inputs within a specific set.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this mathematical model, we assume the function is <w>total</w>.",
                            "target_lang_translations": {
                                "ru": "В этой математической модели мы предполагаем, что функция <w>всюду определена</w>.",
                                "zh": "在这个数学模型中，我们假设该函数是<w>处处定义</w>的。"
                            }
                        },
                        {
                            "text": "The professor explained the properties of a <w>total</w> ordering relation.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил свойства отношения <w>полного</w> порядка.",
                                "zh": "教授解释了<w>全</w>序关系的性质。"
                            }
                        }
                    ],
                    "antonyms": [
                        "partial"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный для всех возможных входных данных в заданном множестве.",
                        "zh": "在特定集合内对所有可能的输入都有定义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о порядке"
                            },
                            {
                                "target_lang_word": "всюду определённый",
                                "target_lang_sense_clarification": "о функции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全",
                                "target_lang_sense_clarification": "指数学上的完全性"
                            },
                            {
                                "target_lang_word": "处处定义",
                                "target_lang_sense_clarification": "指函数在定义域内都有值"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "581ddf1c-8dbb-33d0-9d14-af0061e981e5",
                    "sense_definition": "The final amount obtained by adding smaller amounts together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_sum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>total</w> comes to fifty dollars and twenty cents.",
                            "target_lang_translations": {
                                "ru": "<w>Сумма</w> составляет пятьдесят долларов и двадцать центов.",
                                "zh": "<w>总计</w>为五十美元二十美分。"
                            }
                        },
                        {
                            "text": "We raised a <w>total</w> of one thousand pounds for charity.",
                            "target_lang_translations": {
                                "ru": "Мы собрали <w>сумму</w> в одну тысячу фунтов на благотворительность.",
                                "zh": "我们为慈善事业筹集了<w>总共</w>一千英镑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sum",
                        "amount"
                    ],
                    "common_phrases": [
                        "in total",
                        "grand total",
                        "sum total",
                        "running total"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательная сумма, полученная путем сложения меньших величин.",
                        "zh": "将较小的数值相加后得到的最终金额或数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумма",
                                "target_lang_sense_clarification": "количество денег или число"
                            },
                            {
                                "target_lang_word": "итог",
                                "target_lang_sense_clarification": "результат подсчета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总数",
                                "target_lang_sense_clarification": "指计算后的最终数量"
                            },
                            {
                                "target_lang_word": "总计",
                                "target_lang_sense_clarification": "指合计的金额或数值"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d4b1e5d-fc33-3e94-80b9-8b194f77f64e",
                    "sense_definition": "To equal a specific amount when added together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity_sum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bill for our dinner <w>totals</w> more than I expected.",
                            "target_lang_translations": {
                                "ru": "Счет за наш ужин <w>составляет</w> больше, чем я ожидал.",
                                "zh": "我们晚餐的账单<w>总计</w>超过了我的预期。"
                            }
                        },
                        {
                            "text": "His debts <w>totaled</w> nearly half a million by the time he retired.",
                            "target_lang_translations": {
                                "ru": "Его долги <w>составили</w> почти полмиллиона к моменту его выхода на пенсию.",
                                "zh": "到他退休时，他的债务<w>总计</w>已近五十万。"
                            }
                        }
                    ],
                    "synonyms": [
                        "make",
                        "amount to",
                        "add up to"
                    ],
                    "common_phrases": [
                        "total up to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Равняться определенной сумме при сложении.",
                        "zh": "相加后等于特定的金额或数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "образовывать сумму"
                            },
                            {
                                "target_lang_word": "равняться",
                                "target_lang_sense_clarification": "быть равным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总计",
                                "target_lang_sense_clarification": "指合计达到某数额"
                            },
                            {
                                "target_lang_word": "共计",
                                "target_lang_sense_clarification": "指总共达到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "004b9246-f490-34e0-873a-f116a2f0fe13",
                    "sense_definition": "To calculate the sum of various numbers or amounts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity_sum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>totalled</w> the receipts at the end of her shift.",
                            "target_lang_translations": {
                                "ru": "Она <w>подсчитала</w> чеки в конце смены.",
                                "zh": "她在轮班结束时<w>合计</w>了收据。"
                            }
                        },
                        {
                            "text": "Can you <w>total</w> up these figures for the report?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>суммировать</w> эти цифры для отчета?",
                                "zh": "你能为这份报告把这些数字<w>合计</w>一下吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "sum"
                    ],
                    "common_phrases": [
                        "total up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять сумму различных чисел или величин.",
                        "zh": "计算各种数字或金额的总和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсчитывать",
                                "target_lang_sense_clarification": "считать итог"
                            },
                            {
                                "target_lang_word": "суммировать",
                                "target_lang_sense_clarification": "складывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合计",
                                "target_lang_sense_clarification": "指计算总和"
                            },
                            {
                                "target_lang_word": "算出总数",
                                "target_lang_sense_clarification": "指得出最终结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2334502-8b1d-3c94-9d53-ef4cf7d408bd",
                    "sense_definition": "To damage a vehicle so badly that it cannot be repaired.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost control on the ice and <w>totaled</w> his father's car.",
                            "target_lang_translations": {
                                "ru": "Он потерял управление на льду и <w>разбил</w> машину отца.",
                                "zh": "他在冰面上失控，把父亲的车<w>撞毁</w>了。"
                            }
                        },
                        {
                            "text": "I was afraid I had <w>totaled</w> the bike when I crashed into the fence.",
                            "target_lang_translations": {
                                "ru": "Я боялся, что <w>угробил</w> велосипед, когда врезался в забор.",
                                "zh": "我撞上栅栏时，生怕把自行车<w>报废</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "demolish",
                        "wreck",
                        "trash"
                    ],
                    "common_phrases": [
                        "total a car"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повредить транспортное средство настолько сильно, что оно не подлежит ремонту.",
                        "zh": "将车辆损坏到无法修复的程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "сильно повредить"
                            },
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "разрушить полностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指车辆损坏至无法使用"
                            },
                            {
                                "target_lang_word": "撞毁",
                                "target_lang_sense_clarification": "指因碰撞而彻底损坏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}