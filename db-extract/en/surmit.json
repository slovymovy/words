                        "examples": [
                            {
                                "example_id": "ca4edc3f-14b7-485d-8490-e293bf827cbc",
                                "sense_id": "7d33fd5a-4ffa-30be-85a2-737ff95b2abd",
                                "text": "John Scargill, named in the sayd byll, made such wyll of the same maner, landes, tenements and other premyses, and every of them, as is surmytted by the same byll; and over that, sayth althings as in the saydbyll is surmytted[…]"
                            },
                            {
                                "example_id": "a5646308-342f-4329-b1db-0b3461dce1d9",
                                "sense_id": "7d33fd5a-4ffa-30be-85a2-737ff95b2abd",
                                "text": "And with this matier you may also declare vnto him, howe thinformacion made that his Oratours here could not haue audience in vi monethes was vntruly surmytted vnto him, as they haue themselfes confessed[…]"
                            },
                            {
                                "example_id": "eefbd14e-b951-4ae9-a44e-29d9171b7aad",
                                "sense_id": "7d33fd5a-4ffa-30be-85a2-737ff95b2abd",
                                "text": "They were fantasticall imagined, Onely as in my dreame I did surmit."
                            }
                        ]
                    }
