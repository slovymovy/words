                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1df5a160-93ba-3751-9f58-b4699b2c171e",
                                        "entry_id": "2266039a-f8e2-34dd-9593-e87a1eac4906",
                                        "glosses": [
                                            "с.-х. крытый загон для крупных домашних животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de6b230-7819-4e1f-8c19-9b391d193e8a",
                                                "sense_id": "1df5a160-93ba-3751-9f58-b4699b2c171e",
                                                "text": "Поднялся вдруг весь псарный двор — // Почуя серого так близко забияку, // Псы залились в хлевах и рвутся вон на драку…"
                                            },
                                            {
                                                "example_id": "38c4d3f1-3cef-4907-a00a-9861914cac56",
                                                "sense_id": "1df5a160-93ba-3751-9f58-b4699b2c171e",
                                                "text": "В хлеву день и ночь раздавалось мычанье голодной коровы, надрывавшее душу у бабки и Марьи."
                                            },
                                            {
                                                "example_id": "71dc7260-1d6d-406c-868a-5ef69398df4a",
                                                "sense_id": "1df5a160-93ba-3751-9f58-b4699b2c171e",
                                                "text": "Было у них два хлева, где стояли Терешкина лошадь и корова Пестренка, под навесом красовалась новая телега, под другим жили овцы, а в огороде была устроена особая загородка для свиней."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded548bd-a236-3b00-8e59-c3239d6b19a6",
                                        "entry_id": "2266039a-f8e2-34dd-9593-e87a1eac4906",
                                        "glosses": [
                                            "перен., разг. грязное, неприбранное помещение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0acd1eb-25fa-4df4-a8a1-b710c8188def",
                                                "sense_id": "ded548bd-a236-3b00-8e59-c3239d6b19a6",
                                                "text": "Харчевни мерзкие!. А туда ж: ресторации… нумера!. Хлева, сударь… хлева!.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
