            {
                "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                "word": "synoptique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cb19919-56fb-443f-87be-a782eee94e3f",
                        "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "synoptiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "893d2e29-8d9b-3e6a-8aea-385ae2582f1d",
                        "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                        "glosses": [
                            "Vision générale, aperçu panoramique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34a30b8-9ae1-41ef-b747-1e665bf1c4d0",
                                "sense_id": "893d2e29-8d9b-3e6a-8aea-385ae2582f1d",
                                "text": "Très flexible le module génère un synoptique qui sera intégré au logiciel de supervision."
                            },
                            {
                                "example_id": "48fd24e1-6f2a-4f31-bed9-979751a11acf",
                                "sense_id": "893d2e29-8d9b-3e6a-8aea-385ae2582f1d",
                                "text": "Procurez-vous une synoptique globale de votre réseau local auprès de votre administrateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "2617140e-66f7-317e-8634-0747e50fe6c3",
                        "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                        "glosses": [
                            "Les évangiles de saint Matthieu, saint Marc et saint Luc ensemble décrivant les mêmes événements."
                        ],
                        "tags": [
                            "Biblical",
                            "ellipsis",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6ae6d5ba-00fe-4059-a3a6-cdee9593b74d",
                                "sense_id": "2617140e-66f7-317e-8634-0747e50fe6c3",
                                "text": "Il y a un changement radical de vocabulaire entre Jean et les synoptiques."
                            },
                            {
                                "example_id": "9034e5a3-d83e-41d0-acac-5590a5eaeb12",
                                "sense_id": "2617140e-66f7-317e-8634-0747e50fe6c3",
                                "text": "Il n’y a pas d’esprit dégagé de préoccupations théologiques qui ne soit forcé de reconnaître des divergences inconciliables entre les synoptiques et le quatrième évangile, et entre les synoptiques comparés les uns avec les autres. Pour nous rationalistes, cela n’a pas grande conséquence ; mais l’orthodoxe, obligé de prouver que son livre a toujours raison, se trouve engagé en des subtilités infinies."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcd62844-3cb2-3457-9a91-fa10a5ae0c7b",
                        "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                        "glosses": [
                            "Système atmosphérique de large échelle, soit plus de 1000 km de diamètre, et durant plusieurs jours: dépressions, anticyclones, ouragans, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0a583780-ee4e-38d4-961a-61dfb38dcb64",
                        "entry_id": "b7d44353-e6a0-3314-b073-17554b7238a8",
                        "glosses": [
                            "Tableau ou schéma décrivant de façon graphique un système."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539f02dd-8070-4da9-9fc5-f08ee45407dc",
                                "sense_id": "0a583780-ee4e-38d4-961a-61dfb38dcb64",
                                "text": "Synoptique d’un processus industriel."
                            },
                            {
                                "example_id": "9a0c5ce1-eb9e-438a-8aff-ae715a6aef6a",
                                "sense_id": "0a583780-ee4e-38d4-961a-61dfb38dcb64",
                                "text": "Synoptique des voies urbaines."
                            },
                            {
                                "example_id": "72601d0b-31e9-4a73-9a65-8227e64a7188",
                                "sense_id": "0a583780-ee4e-38d4-961a-61dfb38dcb64",
                                "text": "Synoptique d’un itinéraire ferroviaire."
                            }
                        ]
                    },
