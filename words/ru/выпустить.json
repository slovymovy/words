                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Охотник успел <выпустить> стрелу, но промахнулся.",
                            "target_lang_translations": {
