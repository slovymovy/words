{
    "word_family": [
        "afrekenen",
        "rekening",
        "eindafrekening"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ac52282-23af-3da4-ac6a-3cc594706bc3",
                    "sense_definition": "De definitieve berekening of het overzicht van te betalen of betaalde kosten; de rekening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ober bracht ons de <w>afrekening</w> na een heerlijk diner in het restaurant.",
                            "target_lang_translations": {
                                "en": "The waiter brought us the <w>bill</w> after a delicious dinner in the restaurant."
                            }
                        },
                        {
                            "text": "Aan het einde van het jaar ontvangen we altijd de <w>afrekening</w> van de energieleverancier.",
                            "target_lang_translations": {
                                "en": "At the end of the year, we always receive the final <w>settlement</w> from the energy supplier."
                            }
                        }
                    ],
                    "synonyms": [
                        "rekening",
                        "factuur",
                        "nota"
                    ],
                    "common_phrases": [
                        "de jaarlijkse afrekening",
                        "de afrekening betalen"
                    ],
                    "target_lang_definitions": {
                        "en": "The final calculation or overview of costs to be paid or already paid; the bill."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settlement",
                                "target_lang_sense_clarification": "of an account or bill"
                            },
                            {
                                "target_lang_word": "bill",
                                "target_lang_sense_clarification": "final statement of charges"
                            },
                            {
                                "target_lang_word": "invoice",
                                "target_lang_sense_clarification": "itemized bill"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3230816c-a1d3-3818-ba74-e6710aecbb87",
                    "sense_definition": "De uiteindelijke bestraffing of vergelding voor iemands daden uit het verleden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van onrecht volgde eindelijk de politieke <w>afrekening</w> tijdens de verkiezingen.",
                            "target_lang_translations": {
                                "en": "After years of injustice, the political <w>reckoning</w> finally followed during the elections."
                            }
                        },
                        {
                            "text": "Hij wist dat de dag van de <w>afrekening</w> ooit zou komen voor zijn bedrog.",
                            "target_lang_translations": {
                                "en": "He knew that the day of <w>reckoning</w> would come one day for his deceit."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergelding",
                        "bestraffing",
                        "wraak"
                    ],
                    "common_phrases": [
                        "dag van de afrekening"
                    ],
                    "target_lang_definitions": {
                        "en": "The ultimate punishment or retribution for someone's past actions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reckoning",
                                "target_lang_sense_clarification": "retribution or punishment for past deeds"
                            },
                            {
                                "target_lang_word": "settling of scores",
                                "target_lang_sense_clarification": "getting revenge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c77460c-c837-3366-9c9c-5326776577be",
                    "sense_definition": "Een moord of gewelddadige aanslag binnen het criminele circuit, vaak als wraak of liquidatie.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vergelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie vermoedt dat de schietpartij in de stad een criminele <w>afrekening</w> was.",
                            "target_lang_translations": {
                                "en": "The police suspect that the shooting in the city was a criminal <w>liquidation</w>."
                            }
                        },
                        {
                            "text": "Na de mislukte drugsdeal vreesde het bendeled voor een bloedige <w>afrekening</w>.",
                            "target_lang_translations": {
                                "en": "After the failed drug deal, the gang member feared a bloody <w>settling of scores</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquidatie",
                        "onderwereldmoord"
                    ],
                    "common_phrases": [
                        "een criminele afrekening"
                    ],
                    "target_lang_definitions": {
                        "en": "A murder or violent attack within the criminal underworld, often as revenge or liquidation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "liquidation",
                                "target_lang_sense_clarification": "gangland killing or elimination"
                            },
                            {
                                "target_lang_word": "gangland killing",
                                "target_lang_sense_clarification": "murder within the criminal underworld"
                            },
                            {
                                "target_lang_word": "settling of accounts",
                                "target_lang_sense_clarification": "violent underworld retribution"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}