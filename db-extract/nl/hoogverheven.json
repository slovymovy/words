                        "examples": [
                            {
                                "example_id": "89cc7ff6-1609-4280-861b-307abdd8e9e8",
                                "sense_id": "7de04077-6a72-3977-8b39-d25b57399e9d",
                                "text": "En wie anders dan Tirant verdient het de hand te leggen op de volmaaktheden van hare hoogverheven hoogheid prinses Carmesina en ze in bezit te nemen? Als u mij vraagt hoe ik dat zo zeker weet, kan ik antwoorden: omdat ik ernaar verlang."
                            },
                            {
                                "example_id": "9e260879-48f5-46e4-badd-e81c1a64551f",
                                "sense_id": "7de04077-6a72-3977-8b39-d25b57399e9d",
                                "text": "Mijn hand wordt het niet moe uw hoogverheven doorluchtigheid te schrijven, wat mij voorkomt alsof ik met u in gesprek was en geenszins begrepen mag worden als een poging om uw eer te na te komen, waardoor ik niet zou kunnen bogen op uw achting die ik trouwens zou verliezen als dit mijn bedoeling was."
                            }
                        ]
                    }
