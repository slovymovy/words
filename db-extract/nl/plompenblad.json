                        "entry_id": "e5df736d-25d3-343b-bd8a-f12298a5f895",
                        "glosses": [
                            "gestileerd blad van de waterlelie, zoals in de Friese vlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83683c30-a4f7-484d-8c20-0f558d06fcee",
                                "sense_id": "8fcb39aa-7649-34d8-8e43-94b3e85c4ab5",
                                "text": "Er is een route met genummerde bordjes uitgezet, wat me aan een speurtocht deed denken. Ik verwachtte vragen als “op welke vlag prijkt het plompenblad?”, maar die bleven uit."
                            }
                        ]
