                "senses": [
                    {
                        "sense_id": "cb6ad0d4-ab03-33c8-bbc4-3c4d4a8d3d7b",
                        "entry_id": "51a53aab-1c8d-396b-b2c0-6e70ac69d570",
                        "glosses": [
                            "Ensemble de techniques qui permettent de rendre des objets culturels entièrement ou en partie visuels (films, spectacles, expositions…) accessibles aux personnes aveugles ou malvoyantes grâce à un texte en voix off qui décrit les éléments visuels de l’œuvre."
                        ],
                        "tags": [
                            "Audiovisuel",
                            "Handicap"
                        ],
                        "examples": [
                            {
                                "example_id": "241f7d58-5bc1-401e-a9ae-c47e73b53e52",
                                "sense_id": "cb6ad0d4-ab03-33c8-bbc4-3c4d4a8d3d7b",
                                "text": "Ce programme est disponible en audiodescription."
                            },
                            {
                                "example_id": "4e61db13-02f9-4813-bf59-50c94edd7920",
                                "sense_id": "cb6ad0d4-ab03-33c8-bbc4-3c4d4a8d3d7b",
                                "text": "L’audiodescription et moi, nous pourrons fêter en 2014 vingt-cinq ans de compagnonnage."
                            },
                            {
                                "example_id": "53eac750-b090-41b2-9fb4-a37657a937c3",
                                "sense_id": "cb6ad0d4-ab03-33c8-bbc4-3c4d4a8d3d7b",
                                "text": "Par exemple, les épreuves et les cérémonies seront en audiodescription."
                            }
                        ]
                    }
                ],
