                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc263be2-6f79-41a4-8f68-76fd00a82fc8",
                                                "sense_id": "b212ae14-5111-380b-97f7-ac7b0193b345",
                                                "text": "\"Well, Dangerfield, in less than an hour I'm off in search of my fortune. Jesus, I'm excited, like I was going to lose my cherry. Woke up this morning with an erection that almost touched the ceiling.\""
                                            },
                                            {
                                                "example_id": "9682396e-4886-4372-9633-4d31720cfbc3",
                                                "sense_id": "b212ae14-5111-380b-97f7-ac7b0193b345",
                                                "text": "Nothing stands in your way when you're a boy / Clothes always fit ya / Life is a pop of the cherry when you're a boy"
                                            },
                                            {
                                                "example_id": "fc7ea1ae-8568-4b20-844b-a67febbec8be",
                                                "sense_id": "b212ae14-5111-380b-97f7-ac7b0193b345",
                                                "text": "Philips—Sergeant Gerheim's black, silver-tongued House Mouse—is telling everybody about the one thousand cherries he has busted."
                                            },
                                            {
                                                "example_id": "d896a90c-a209-4fb1-8e70-23a729c6b960",
                                                "sense_id": "b212ae14-5111-380b-97f7-ac7b0193b345",
                                                "text": "So what bitch, I busted your cherry – / Hell fucking no, I don’t wanna git married"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce22a71-4d40-36e9-9384-a20b8b626fdf",
                                        "entry_id": "8d11eed5-6278-39f2-8b54-1867403da165",
                                        "glosses": [
                                            "A subtree consisting of a node with exactly two leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d35f1ed-9fc1-458a-a28e-86d4b264a8b0",
                                                "sense_id": "9ce22a71-4d40-36e9-9384-a20b8b626fdf",
                                                "text": "Non-isomorphism is detected whenever the algorithm finds a cherry v#95;1#92;inT#95;1"
                                            },
                                            {
                                                "example_id": "22ef0287-2c2a-4c38-8f78-7eebed81470f",
                                                "sense_id": "9ce22a71-4d40-36e9-9384-a20b8b626fdf",
                                                "text": "Step 3: Output the tree T. The edge lengths of T are determined recursively: If (x,y) is a cherry connected to node z as in Step 2"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dcdbb14-bddb-3ba0-beed-e26fe18dc43d",
                                        "entry_id": "8d11eed5-6278-39f2-8b54-1867403da165",
                                        "glosses": [
                                            "A red cricket ball."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc3ba1f-9400-4891-928d-75096ac50780",
                                                "sense_id": "8dcdbb14-bddb-3ba0-beed-e26fe18dc43d",
                                                "text": "The Indians have to get early wickets on the morrow and they will have the option of taking the new cherry."
                                            },
                                            {
                                                "example_id": "70f6b83a-5ede-4939-aa95-316f84b7e2f6",
                                                "sense_id": "8dcdbb14-bddb-3ba0-beed-e26fe18dc43d",
                                                "text": "Players are back out and it's Harmison to have first go with the cherry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34fc680-a6e3-37bb-b443-d51f6b7762fe",
