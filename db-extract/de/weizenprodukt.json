                "senses": [
                    {
                        "sense_id": "357ddce8-ae3d-3a5b-831f-9d6c9f1d86aa",
                        "entry_id": "05f949a1-0963-3a18-9843-95929b412df6",
                        "glosses": [
                            "aus Weizen hergestelltes Lebensmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e197d668-e469-49ca-8931-84ae154214b6",
                                "sense_id": "357ddce8-ae3d-3a5b-831f-9d6c9f1d86aa",
                                "text": "„Auch arbeitende Frauen greifen öfter zu Weizenprodukten, die schnell zuzubereiten sind.“"
                            },
                            {
                                "example_id": "06c59126-a8d0-4f47-adb4-7cd69caa62fe",
                                "sense_id": "357ddce8-ae3d-3a5b-831f-9d6c9f1d86aa",
                                "text": "„Der eine verzichtet auf Milch, der andere meidet jegliche Weizenprodukte.“"
                            },
                            {
                                "example_id": "ecfbbf8c-1399-445b-8b12-9820c474f36c",
                                "sense_id": "357ddce8-ae3d-3a5b-831f-9d6c9f1d86aa",
                                "text": "„Mythen über den Weizen gibt es seit Menschengedenken. […] Urvater Noah hat ihn mit in die Arche genommen, Jesus hat Brot auf wunderbare Weise vermehrt, die kirchliche Hostie ist ein reines Weizenprodukt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
