                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff1f078-0238-4453-a835-b4348b4722ed",
                                "sense_id": "f998af77-41ff-3c0a-8a0b-8a3182c44419",
                                "text": "Le Busoqueux, source quasi certaine de trait de mœurs, de cancans, de ragots, de superstitions et de patoiseries."
                            },
                            {
                                "example_id": "b45ed94d-379e-4825-b3b1-39dd7ee9992a",
                                "sense_id": "f998af77-41ff-3c0a-8a0b-8a3182c44419",
                                "text": "Le souper, comme toujours, fut bruyant, joyeux, sérieusement arrosé, chacun y allant de son histoire ou de sa chanson, et rivalisant de patoiserie."
                            },
                            {
                                "example_id": "9f76074d-338a-4ed6-b3a9-bc698c98b29b",
                                "sense_id": "f998af77-41ff-3c0a-8a0b-8a3182c44419",
                                "text": "Le poète grégorien, épris de patoiseries, reçoit aussi dans sa piaule ses élèves préférés qu’il accueille la mine éplorée, les mains croisées, d’un air compatissant de confident contrit."
                            }
                        ]
                    }
