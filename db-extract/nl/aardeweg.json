                                "target_senses": [
                                    {
                                        "sense_id": "8dcaa332-fd1a-33e8-8e0d-bb1d5205baf8",
                                        "entry_id": "e5f997cb-38ee-3074-9d4e-dfbb12f928aa",
                                        "glosses": [
                                            "mit Sand bedeckter Weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a9e4b1-ee0a-4461-9865-6dc157739fcc",
                                                "sense_id": "8dcaa332-fd1a-33e8-8e0d-bb1d5205baf8",
                                                "text": "„Wer sich vom Parkplatz aus der Farm nähert, muss einige Hundert Meter ins Tal hinabsteigen, über einen mäandernden Sandweg, mit Blick über Wälder, Felder und die Hobbithügel von Devon.“"
                                            },
                                            {
                                                "example_id": "af7a7721-0b8f-46d7-b107-75b118142c68",
                                                "sense_id": "8dcaa332-fd1a-33e8-8e0d-bb1d5205baf8",
                                                "text": "„Da hören wir einen Wagen auf dem Sandweg heranrollen, der Gendarmerieoffizier springt auf und schlüpft in die Tür hinein, als ob er ungesehen bleiben wolle.“"
                                            },
                                            {
                                                "example_id": "8b9b0dfc-1343-4e52-a8ad-fe4597c47c13",
                                                "sense_id": "8dcaa332-fd1a-33e8-8e0d-bb1d5205baf8",
                                                "text": "„Ein paar Kilometer weit lief alles gut, dann wurde die Straße plötzlich schlechter und ging in einen Sandweg über.“"
                                            },
                                            {
                                                "example_id": "552b5f60-19bc-4647-9bb5-d6d0b1f06c0c",
                                                "sense_id": "8dcaa332-fd1a-33e8-8e0d-bb1d5205baf8",
                                                "text": "„In raschem Trabe ging es die Friedrichsstraße hinunter, erst auf das Rondeel und das Hallesche Tor zu, bis der tiefe Sandweg, der zum Kreuzberg hinaufführte, zu langsamerem Fahren nötigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sandweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d98a624f-ada1-3607-90a2-a6c5bd2127b2",
