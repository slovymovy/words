                "senses": [
                    {
                        "sense_id": "31569f36-0e2a-3ab3-a106-a21712c67649",
                        "entry_id": "aba60e7e-1465-3d8a-939d-8067eb4cceb1",
                        "glosses": [
                            "Qui est en surplomb ; qui surplombe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a609a08d-b328-4e32-b47e-b12d0385918c",
                                "sense_id": "31569f36-0e2a-3ab3-a106-a21712c67649",
                                "text": "[…], il se remit en route et parvint à un autre escalier qui grimpait contre un rocher surplombant, d’où la vue s’étendait en enfilade sur l’immense majesté verte de la Chute du Fer à cheval."
                            },
                            {
                                "example_id": "4385e54b-3aaf-47a2-9bc2-2ff3a5c6f3cb",
                                "sense_id": "31569f36-0e2a-3ab3-a106-a21712c67649",
                                "text": "Et la petite ville frileuse, accrochée au flanc de la montagne comme une lanterne vénitienne, rencognée sous ses grands auvents et les étages surplombants qu'elle conservait du Moyen Âge, avec ses lumières de boutiques, ses feux, ses meubles d'acajou, ses fleurs en pots dans les salons, ses dames à triple menton, apparaissait aux pensionnaires riche, épaisse, frivole et désirable comme un port aux marins."
                            }
                        ]
                    }
