                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bcda2f-4623-413a-b621-c9374f6c4ef0",
                                "sense_id": "cd7920e8-5f80-3df0-9cca-43470ffceccb",
                                "text": "De reuzenpijlinktvis is een koppotige."
                            },
                            {
                                "example_id": "3f9c896b-f7f3-4316-8aa5-6c110d45f626",
                                "sense_id": "cd7920e8-5f80-3df0-9cca-43470ffceccb",
                                "text": "Het is een dwarsdoorsnede van de externe schelp – formaat onderarm – van de inktvisachtige Orthoceras. De schelp waarin deze koppotige (naar zijn tien tentakels op de kop) zich kon terugtrekken vormt een kaarsrechte pijlpunt, aan weerskanten afgezet met biezen van kamertjes."
                            }
                        ]
                    }
