{
    "word_family": [
        "идейный",
        "идеал",
        "идеальный",
        "идеология",
        "идеалист"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1422280f-2010-3a38-8e95-89ec39b7c50f",
                    "sense_definition": "Мысль, неожиданное соображение или догадка, которая приходит в голову.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mental_construct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера мне в голову пришла отличная <w>идея</w>.",
                            "target_lang_translations": {
                                "en": "Yesterday an excellent <w>idea</w> came to my mind.",
                                "zh": "昨天我脑子里冒出了一个好<w>主意</w>。"
                            }
                        },
                        {
                            "text": "У меня есть <w>идея</w>, как нам весело провести выходные.",
                            "target_lang_translations": {
                                "en": "I have an <w>idea</w> for how we can have a fun weekend.",
                                "zh": "我有个<w>想法</w>，能让我们愉快地度过周末。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мысль",
                        "замысел",
                        "задумка"
                    ],
                    "common_phrases": [
                        "отличная идея",
                        "пришла идея",
                        "возникла идея",
                        "хорошая идея"
                    ],
                    "target_lang_definitions": {
                        "en": "A thought, suggestion, or sudden inspiration that comes to mind.",
                        "zh": "指脑海中突然出现的想法、念头或灵感。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "general meaning"
                            },
                            {
                                "target_lang_word": "thought",
                                "target_lang_sense_clarification": "mental act or product"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主意",
                                "target_lang_sense_clarification": "指解决问题的办法或念头"
                            },
                            {
                                "target_lang_word": "想法",
                                "target_lang_sense_clarification": "指一般的思考结果或念头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc96097b-6ab1-3cae-b590-976b41bbb857",
                    "sense_definition": "Замысел, намерение или план сделать что-либо, создать или организовать.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_construct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор сразу одобрил <w>идею</w> нового проекта.",
                            "target_lang_translations": {
                                "en": "The director immediately approved the <w>idea</w> for the new project.",
                                "zh": "经理立刻批准了新项目的<w>构思</w>。"
                            }
                        },
                        {
                            "text": "Мы решили отказаться от <w>идеи</w> ехать в горы зимой.",
                            "target_lang_translations": {
                                "en": "We decided to give up the <w>idea</w> of going to the mountains in winter.",
                                "zh": "我们决定放弃冬天去山里的<w>计划</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "план",
                        "замысел",
                        "намерение"
                    ],
                    "common_phrases": [
                        "идея проекта",
                        "отказаться от идеи",
                        "поддержать идею",
                        "реализовать идею"
                    ],
                    "target_lang_definitions": {
                        "en": "A plan, intention, or design to create or organize something.",
                        "zh": "指为了创造或组织某事而制定的计划、意图或构思。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "plan or scheme"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "concrete proposal"
                            },
                            {
                                "target_lang_word": "intention",
                                "target_lang_sense_clarification": "purpose or aim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构思",
                                "target_lang_sense_clarification": "指对某事物的初步设计或想法"
                            },
                            {
                                "target_lang_word": "计划",
                                "target_lang_sense_clarification": "指具体的行动方案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a24e00ff-13f6-31e0-bc80-944577d3ac2d",
                    "sense_definition": "Главная мысль, определяющая содержание художественного произведения, научного труда или выступления.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "artistic_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Основная <w>идея</w> этого фильма мне не совсем понятна.",
                            "target_lang_translations": {
                                "en": "The main <w>idea</w> of this film is not entirely clear to me.",
                                "zh": "这部电影的中心<w>主旨</w>我不太明白。"
                            }
                        },
                        {
                            "text": "Критики долго обсуждали глубокую <w>идею</w> его нового романа.",
                            "target_lang_translations": {
                                "en": "Critics discussed the deep <w>idea</w> of his new novel for a long time.",
                                "zh": "评论家们讨论了他那部新小说中深刻的<w>概念</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "концепция"
                    ],
                    "common_phrases": [
                        "основная идея",
                        "идея книги",
                        "глубокая идея",
                        "смысл и идея"
                    ],
                    "target_lang_definitions": {
                        "en": "The central thought, message, or concept of a creative work or text.",
                        "zh": "指艺术作品、学术著作或演讲的核心思想、主题或概念。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "central thought"
                            },
                            {
                                "target_lang_word": "concept",
                                "target_lang_sense_clarification": "abstract structure"
                            },
                            {
                                "target_lang_word": "message",
                                "target_lang_sense_clarification": "communicated meaning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主旨",
                                "target_lang_sense_clarification": "指作品的核心思想"
                            },
                            {
                                "target_lang_word": "概念",
                                "target_lang_sense_clarification": "指抽象的理论或逻辑结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8add40e-952e-37b2-8a99-becb71f09ef0",
                    "sense_definition": "Прочно сложившееся мнение, убеждение или принцип, определяющий взгляды человека.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conviction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он был готов пожертвовать всем, чтобы бороться за <w>идею</w>.",
                            "target_lang_translations": {
                                "en": "He was ready to sacrifice everything to fight for an <w>idea</w>.",
                                "zh": "他愿意牺牲一切去为自己的<w>信念</w>而奋斗。"
                            }
                        },
                        {
                            "text": "Его политические <w>идеи</w> казались многим слишком радикальными.",
                            "target_lang_translations": {
                                "en": "His political <w>ideas</w> seemed too radical to many.",
                                "zh": "他的政治<w>主张</w>在许多人看来过于激进。"
                            }
                        }
                    ],
                    "synonyms": [
                        "убеждение"
                    ],
                    "common_phrases": [
                        "бороться за идею",
                        "человек идеи",
                        "преданность идее",
                        "идея фикс"
                    ],
                    "target_lang_definitions": {
                        "en": "A firmly established belief, principle, or conviction.",
                        "zh": "指一个人坚定的信念、原则或信仰。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "belief or view"
                            },
                            {
                                "target_lang_word": "belief",
                                "target_lang_sense_clarification": "conviction"
                            },
                            {
                                "target_lang_word": "cause",
                                "target_lang_sense_clarification": "principle to fight for"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信念",
                                "target_lang_sense_clarification": "指坚定的信仰或原则"
                            },
                            {
                                "target_lang_word": "主义",
                                "target_lang_sense_clarification": "指某种政治或社会思想体系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c246ab-b35f-3c28-a82e-858d9928fd36",
                    "sense_definition": "Сложное абстрактное понятие, отражающее сущность явлений в философии и науке.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophical_construct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Платон учил, что мир вещей — это лишь тень мира <w>идей</w>.",
                            "target_lang_translations": {
                                "en": "Plato taught that the world of things is merely a shadow of the world of <w>ideas</w>.",
                                "zh": "柏拉图教导说，物质世界仅仅是<w>理念</w>世界的影子。"
                            }
                        },
                        {
                            "text": "Эта философская <w>идея</w> изменила наше представление о вселенной.",
                            "target_lang_translations": {
                                "en": "This philosophical <w>idea</w> changed our understanding of the universe.",
                                "zh": "这一哲学<w>概念</w>改变了我们对宇宙的认知。"
                            }
                        }
                    ],
                    "synonyms": [
                        "понятие",
                        "представление"
                    ],
                    "common_phrases": [
                        "мир идей",
                        "абстрактная идея",
                        "развитие идеи",
                        "идея социализма"
                    ],
                    "target_lang_definitions": {
                        "en": "A complex abstract concept or archetype in philosophy.",
                        "zh": "指哲学或科学中反映事物本质的复杂抽象概念。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "philosophical construct"
                            },
                            {
                                "target_lang_word": "concept",
                                "target_lang_sense_clarification": "abstraction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理念",
                                "target_lang_sense_clarification": "指哲学上的抽象概念或理想"
                            },
                            {
                                "target_lang_word": "概念",
                                "target_lang_sense_clarification": "指逻辑上的抽象定义"
                            }
                        ]
                    }
                }
            ]
        }
    ]
