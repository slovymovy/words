                    {
                        "sense_id": "ca8508c3-2bd2-363c-a446-c74743e0b62e",
                        "entry_id": "9c5e90fa-3365-37f1-830e-6858dc2d87ba",
                        "glosses": [
                            "Nom usuel de Actinidia arguta, liane rustique originaire d’Asie orientale (de la Sibérie à la Mandchourie), parente du kiwi (Actinidia deliciosa), plus résistante au froid et dont les fruits font environ 2 centimètres de long. → voir Actinidia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe3be22-751b-47e7-893e-5cef8a90d0bd",
                                "sense_id": "ca8508c3-2bd2-363c-a446-c74743e0b62e",
                                "text": "Le kiwaï est une plante dioïque, il faut donc planter des pieds mâles et des pieds femelles pour la pollinisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "319ebb3c-4b29-3286-942c-fb9386be319e",
                        "entry_id": "9c5e90fa-3365-37f1-830e-6858dc2d87ba",
                        "glosses": [
                            "Fruit de cette plante, baie ovoïde de 25 mm de long environ, à peau lisse, poussant en grappe et à la pulpe riche en sucre et en vitamine C."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27552d8a-7bb1-4175-b5af-34eac5091dd5",
                                "sense_id": "319ebb3c-4b29-3286-942c-fb9386be319e",
                                "text": "Moins acides que les kiwis, les kiwaïs se consomment avec la peau, crus ou cuits."
                            }
                        ]
                    }
                ],
