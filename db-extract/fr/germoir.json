                ],
                "senses": [
                    {
                        "sense_id": "004d3b3b-d401-36cb-b97b-a4be25b94bb2",
                        "entry_id": "3fc4572d-5861-39af-8cc4-0afc10f25195",
                        "glosses": [
                            "Cellier où germent les graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9075c58e-ec6f-4966-bdfc-c7552e1c9ec3",
                                "sense_id": "004d3b3b-d401-36cb-b97b-a4be25b94bb2",
                                "text": "On établit ordinairement le germoir ou dans une cave, ou simplement dans une pièce au rez-de-chaussée."
                            },
                            {
                                "example_id": "59dffd5f-01cd-4436-adb9-f4fd4ed4b62d",
                                "sense_id": "004d3b3b-d401-36cb-b97b-a4be25b94bb2",
                                "text": "Le germoir de la malterie comprenait une citerne fournissant l'eau nécessaire au trempage de l'orge, un plancher dallé sur lequel était étendu le grain, deux âtres qui maintenaient la température propice à la germination et un drain pour l'évacuation des eaux usées."
                            }
                        ]
                    },
                    {
                        "sense_id": "008f0aac-9748-383e-b403-7306063f38e4",
                        "entry_id": "3fc4572d-5861-39af-8cc4-0afc10f25195",
                        "glosses": [
                            "Caisse, pot destiné à conserver les graines qu’on ne veut semer que plus tard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e18c75-808d-4f10-9034-62469d0f86db",
                                "sense_id": "008f0aac-9748-383e-b403-7306063f38e4",
                                "text": "Un germoir doit être un peu en contre-bas du sol, plutôt un peu sombre que clair, légèrement humide et à l’abri .de la gelée ; à l’intérieur sont placées des tablettes sur lesquelles on dépose les vases qui contiennent de la terre ou du sable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9552cd8c-8817-3861-9c75-fbf808fe7865",
                        "entry_id": "3fc4572d-5861-39af-8cc4-0afc10f25195",
                        "glosses": [
                            "Sorte d’ustensile destiné à la germination des graines pour la production de graine germée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205e64fb-8ef8-40cb-a4ca-8de5c9d60655",
                                "sense_id": "9552cd8c-8817-3861-9c75-fbf808fe7865",
                                "text": "Aujourd’hui les graines germées prêtes à l’emploi sont en vente partout, ou encore mieux, sont à faire pousser, tout simplement chez vous, dans un germoir."
                            }
                        ]
                    }
                ],
