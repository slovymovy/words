{
    "word_family": [
        "dzisiejszy",
        "przedwczoraj",
        "wczoraj",
        "jutro"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e00039ae-3d8d-3c01-9b2e-fd78f08f93d3",
                    "sense_definition": "w dniu dzisiejszym, w tym dniu, w którym się znajdujemy",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dzien_biezacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeżeli wczoraj był czwartek, to <w>dziś</w> jest piątek, a jutro będzie sobota.",
                            "target_lang_translations": {
                                "ru": "Если вчера был четверг, то <w>сегодня</w> пятница, а завтра будет суббота.",
                                "en": "If yesterday was Thursday, then <w>today</w> is Friday, and tomorrow will be Saturday."
                            }
                        },
                        {
                            "text": "Muszę <w>dziś</w> wieczorem zrobić zakupy, bo jutro sklepy będą zamknięte.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>сегодня</w> вечером сделать покупки, потому что завтра магазины будут закрыты.",
                                "en": "I have to do the shopping <w>this</w> evening, because tomorrow the shops will be closed."
                            }
                        }
                    ],
                    "synonyms": [
                        "dzisiaj"
                    ],
                    "antonyms": [
                        "wczoraj",
                        "jutro"
                    ],
                    "common_phrases": [
                        "dziś rano",
                        "dziś wieczorem",
                        "już dziś"
                    ],
                    "target_lang_definitions": {
                        "ru": "в сегодняшний день, в тот день, в котором мы находимся",
                        "en": "on the current day, the day we are in"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегодня",
                                "target_lang_sense_clarification": "в текущие сутки"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "today",
                                "target_lang_sense_clarification": "on this present day"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14acc6ae-91f1-33d5-a2ea-9721c298ba19",
                    "sense_definition": "w obecnych czasach, współcześnie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wspolczesnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu młodych ludzi <w>dziś</w> nie wyobraża sobie życia bez smartfona.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди <w>сегодня</w> не представляют себе жизни без смартфона.",
                                "en": "Many young people <w>today</w> cannot imagine life without a smartphone."
                            }
                        },
                        {
                            "text": "To, co dawniej było luksusem, <w>dziś</w> jest rzeczą powszechną.",
                            "target_lang_translations": {
                                "ru": "То, что раньше было роскошью, <w>сегодня</w> — обычное дело.",
                                "en": "What used to be a luxury is <w>nowadays</w> a common thing."
                            }
                        }
                    ],
                    "synonyms": [
                        "dzisiaj",
                        "teraz"
                    ],
                    "antonyms": [
                        "dawniej",
                        "niegdyś"
                    ],
                    "common_phrases": [
                        "dziś i jutro",
                        "jak na dziś"
                    ],
                    "target_lang_definitions": {
                        "ru": "в настоящее время, в наши дни, современно",
                        "en": "nowadays, in modern times, currently"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегодня",
                                "target_lang_sense_clarification": "в наши дни, в настоящее время"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "в современную эпоху"
                            },
                            {
                                "target_lang_word": "ныне",
                                "target_lang_sense_clarification": "книжное, в настоящее время"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "today",
                                "target_lang_sense_clarification": "nowadays, in modern times"
                            },
                            {
                                "target_lang_word": "nowadays",
                                "target_lang_sense_clarification": "at the present time"
                            },
                            {
                                "target_lang_word": "currently",
                                "target_lang_sense_clarification": "at present"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba473a67-2ca8-3e33-a4ed-de874b087a45",
                    "sense_definition": "bieżący dzień, dzisiejsza doba",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dzien_biezacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cały <w>dziś</w> spędziłem na sprzątaniu mieszkania i przygotowaniach do świąt.",
                            "target_lang_translations": {
                                "ru": "Весь <w>сегодняшний день</w> я провел за уборкой квартиры и подготовкой к праздникам.",
                                "en": "I spent the whole of <w>today</w> cleaning the apartment and preparing for the holidays."
                            }
                        },
                        {
                            "text": "Zostawmy te problemy na jutro, bo <w>dziś</w> już nas wystarczająco zmęczył.",
                            "target_lang_translations": {
                                "ru": "Оставим эти проблемы на завтра, потому что <w>сегодняшний день</w> нас и так достаточно утомил.",
                                "en": "Let's leave these problems for tomorrow, because <w>today</w> has already tired us out enough."
                            }
                        }
                    ],
                    "synonyms": [
                        "dzień dzisiejszy",
                        "dzisiaj"
                    ],
                    "antonyms": [
                        "wczoraj",
                        "jutro"
                    ],
                    "common_phrases": [
                        "od dziś",
                        "na dziś"
                    ],
                    "target_lang_definitions": {
                        "ru": "текущий день, сегодняшние сутки",
                        "en": "the current day, today's 24-hour period"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегодняшний день",
                                "target_lang_sense_clarification": "текущие сутки как существительное"
                            },
                            {
                                "target_lang_word": "сегодня",
                                "target_lang_sense_clarification": "в значении существительного"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "today",
                                "target_lang_sense_clarification": "the present day as a noun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5a10de-4114-3050-b396-03e261ff2f1b",
                    "sense_definition": "teraźniejszość, obecne czasy",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wspolczesnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy myśleć o przyszłości, nie zapominając o tym, co niesie ze sobą <w>dziś</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны думать о будущем, не забывая о том, что несет с собой <w>настоящее</w>.",
                                "en": "We must think about the future, without forgetting what <w>the present</w> brings with it."
                            }
                        },
                        {
                            "text": "Współczesna młodzież kształtuje nasze <w>dziś</w> i jutro.",
                            "target_lang_translations": {
                                "ru": "Современная молодежь формирует наше <w>сегодня</w> и завтра.",
                                "en": "Modern youth shapes our <w>today</w> and tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "dzisiaj",
                        "teraźniejszość"
                    ],
                    "antonyms": [
                        "wczoraj",
                        "jutro"
                    ],
                    "common_phrases": [
                        "nasze dziś"
                    ],
                    "target_lang_definitions": {
                        "ru": "настоящее время, современность",
                        "en": "the present, modern times"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегодняшний день",
                                "target_lang_sense_clarification": "настоящее время, современность"
                            },
                            {
                                "target_lang_word": "настоящее",
                                "target_lang_sense_clarification": "текущая реальность"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "the present",
                                "target_lang_sense_clarification": "the current time"
                            },
                            {
                                "target_lang_word": "today",
                                "target_lang_sense_clarification": "the present era"
                            }
                        ]
                    }
                }
            ]
        }
    ]
