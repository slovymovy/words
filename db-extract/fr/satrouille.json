                ],
                "senses": [
                    {
                        "sense_id": "e165c6d8-dde5-34e5-a74f-ff0f1dd311c4",
                        "entry_id": "45b4563b-068c-338c-8230-814bea521588",
                        "glosses": [
                            "Variante de sandrouille, femme sale."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "212c66ea-2f98-35cc-966f-1fd9a08ad9af",
                        "entry_id": "45b4563b-068c-338c-8230-814bea521588",
                        "glosses": [
                            "Seiche, pieuvre, céphalopode (polypus octopus)."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5d7631-6f0a-42f3-8888-823aae6ae270",
                                "sense_id": "212c66ea-2f98-35cc-966f-1fd9a08ad9af",
                                "text": "Ne disait-on pas que les boîtes de crabe vendues si cher contenaient un pourcentage de pieuvre ? Il n’écrivit pas son plaisir à pêcher cette bête, appelée à Mandeville « satrouille »."
                            },
                            {
                                "example_id": "c89e6fbe-4cd5-469c-ab01-7b0dd8a661de",
                                "sense_id": "212c66ea-2f98-35cc-966f-1fd9a08ad9af",
                                "text": "Pour le congre, il faut des fonds rocheux. On beite avec de l’encornet ou de la satrouille. Pour la raie, il faut des fonds sableux, des fonds tendres."
                            },
                            {
                                "example_id": "3557bcb1-5e1c-44e4-bf9e-85b4d5dc3c16",
                                "sense_id": "212c66ea-2f98-35cc-966f-1fd9a08ad9af",
                                "text": "Tout abonde sur les étals. Des maquereaux tétanisés de fraîcheur, des coques bleues, des praires caillouteuses, des satrouilles qui ont la tête on ne peut plus près du bonnet, des brelins noirs qui jouent aux escargots, des congres décapités, des roussettes peau de toile éméri."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b71f421-da21-3294-b9fc-aea1fb00d583",
                        "entry_id": "45b4563b-068c-338c-8230-814bea521588",
                        "glosses": [
                            "Lamproie (Petromyzon fluvialis)."
                        ],
