                "senses": [
                    {
                        "sense_id": "38e9fe42-6352-31b0-93c2-c310f0324c73",
                        "entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
                        "glosses": [
                            "генет. совокупность наследственного материала, генов, содержащихся в одинарном наборе хромосом какой-либо клетки организма; генетический состав клетки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21c2743-2c67-4141-9e7e-5350abca526b",
                                "sense_id": "38e9fe42-6352-31b0-93c2-c310f0324c73",
                                "text": "Геном содержит биологическую информацию, необходимую для построения и поддержания организма."
                            }
                        ]
                    },
                    {
                        "sense_id": "63a29f1f-ef76-373d-901a-840cfc04f851",
                        "entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
                        "glosses": [
                            "генет. гаплоидный набор хромосом"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4bff10ed-7f68-3a1c-85b7-2a0f38a924af",
                        "entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
                        "glosses": [
                            "генет. вся наследственная информация, содержащаяся в бактерии (не только в хромосоме)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d198b864-b054-4a20-ac12-525410af3a06",
                                "sense_id": "4bff10ed-7f68-3a1c-85b7-2a0f38a924af",
                                "text": "Оказалось, при выделении генома этой бактерии одна плазмида была не замечена."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcad124f-a1d2-44c8-867e-114dffa8b322",
                        "source_entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
                        "source_sense_description": "совокупность наследственного материала, генов, заключенного в клетке организма",
                        "target_lang_word": "genome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                        "entry_id": "c1d89cbe-20be-3444-b69e-eb72f1eabbcb",
                                        "glosses": [
                                            "The complete genetic information (either DNA or, in some viruses, RNA) of an organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc08b6dd-c90b-4e1f-b6e0-dca73445c425",
                                                "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, just as having the human genome has made it possible to ask new questions about cellular and molecular systems."
                                            },
                                            {
                                                "example_id": "fa4c79ad-2c17-4a41-bb04-8b20c931d88b",
                                                "sense_id": "448f1da7-a56a-3e61-a1fa-81296e5174f0",
                                                "text": "Because of her significant testing, Avery had had DNA sequencing of her “exome,” the part of her genome that makes proteins in the body, said Dr. Michael Wangler, a researcher at the Jan and Dan Duncan Neurological Research Institute at Texas Children’s Hospital."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c703f936-18ad-4d26-92b3-579a458c2ff0",
                        "source_entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
                        "source_sense_description": "совокупность наследственного материала, генов, заключенного в клетке организма",
