                "word": "seabird",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2c9f8f2f-b35f-4617-8d16-bc130cb99fb1",
                        "entry_id": "a7b2b4cc-92c9-3372-89eb-6e3c0fb49319",
                        "tags": [
                            "plural"
                        ],
                        "form": "seabirds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1af19699-0bca-3578-b31d-1c42b954a276",
                        "entry_id": "a7b2b4cc-92c9-3372-89eb-6e3c0fb49319",
                        "glosses": [
                            "Any bird that spends most of its time in coastal waters or over the oceans."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ed5598a-08e3-4b18-a3b7-ac19e07428db",
                        "source_entry_id": "a7b2b4cc-92c9-3372-89eb-6e3c0fb49319",
                        "source_sense_id": "1af19699-0bca-3578-b31d-1c42b954a276",
                        "source_sense_description": "any bird that spends most of its time in coastal waters",
                        "target_lang_word": "oiseau de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oiseau de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                        "entry_id": "fed65cd1-3e17-3c66-a21a-4dddec138b50",
                                        "glosses": [
                                            "Groupe d’environ 275 espèces d’oiseau appartenant à huit familles, entretenant avec le milieu marin des relations de dépendance plus ou moins stricte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8ef68a-2bd5-4e1c-a3cd-75c7649d0b29",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "On n’entend que des cris d’oiseaux de mer, goélands et macreuses, qui s’abandonnent aux caprices du vent."
                                            },
                                            {
                                                "example_id": "97b4dcc0-7910-4e7b-a833-b8360fab3303",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "Ce ne sont que des rochers à pic contre lesquels la mer se brise avec fureur : les vents et les vagues les ont façonnés en pyramides, en tours, en cavernes, en arcades; d'innombrables oiseaux de mer animent le paysage."
                                            },
                                            {
                                                "example_id": "77b98bf8-116e-4006-a25a-be960832eda1",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "À de grandes altitudes planaient les frégates et les phaétons, qui tombaient souvent avec une rapidité vertigineuse pour arracher en l’air leur proie aux oiseaux de mer plongeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f8571c1-02f3-40d6-9f92-964afd054c6a",
                        "source_entry_id": "a7b2b4cc-92c9-3372-89eb-6e3c0fb49319",
                        "source_sense_id": "1af19699-0bca-3578-b31d-1c42b954a276",
                        "source_sense_description": "any bird that spends most of its time in coastal waters",
                        "target_lang_word": "oiseau marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oiseau marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abe634ae-2d54-3b56-8ecd-b87e823a0d20",
                                        "entry_id": "5439d635-532d-3459-aff1-74a300dd94ea",
                                        "glosses": [
                                            "Synonyme de oiseau de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b3c6ae-1b0f-44f1-a08d-3a15890b694f",
                                                "sense_id": "abe634ae-2d54-3b56-8ecd-b87e823a0d20",
                                                "text": "Albatros des Galapagos : ce magnifique oiseau marin peut voler et se laisser porter par les vents durant des semaines sans toucher le sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a125cdac-6b23-4f04-92a8-bddee2a1ac46",
                        "source_entry_id": "a7b2b4cc-92c9-3372-89eb-6e3c0fb49319",
                        "source_sense_id": "1af19699-0bca-3578-b31d-1c42b954a276",
                        "source_sense_description": "any bird that spends most of its time in coastal waters",
                        "target_lang_word": "Seevogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seevogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                        "entry_id": "b561bc93-8e35-34c5-a39f-bafb8f8e2cd3",
                                        "glosses": [
                                            "Vogel, der am und in der Nähe des Meeres lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7015a40-33e9-46dd-ab74-e50c7edb7468",
                                                "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                                "text": "Basstölpel sind Seevögel, die man vor der Küste von Neufundland beobachten kann."
                                            },
                                            {
                                                "example_id": "10c9d34c-a4e5-40e9-9c61-1ba7d3653ca3",
                                                "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                                "text": "„Doch wer die Seevögel beobachten möchte, nimmt die manchmal beschwerlichen Wege gerne auf sich.“"
                                            },
                                            {
                                                "example_id": "6ec48aeb-094d-42d0-a5cc-604cf8ec39f3",
                                                "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                                "text": "„Darß und Zingst sind Brutheimat des Seeadlers; zahlreiche See- und Küstenvögel brüten auf den Inseln Oie und Kirr, auf den Bülten, den Wiesen und großen Vogelschutzgebieten Hiddensees.“"
                                            },
                                            {
                                                "example_id": "6b762b06-cf9b-43b8-95a1-fc11287a03e0",
                                                "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                                "text": "„Alle Seevögel schwiegen, und nichts Lebendes regte sich auf dem Lande.“"
                                            },
                                            {
                                                "example_id": "e456d7ca-db95-4baf-8923-9fce4de687de",
                                                "sense_id": "0a0acf97-debd-3933-825b-c23dbe2525cc",
                                                "text": "„Hunderttausende von Seevögeln flogen auf und davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
