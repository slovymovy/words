                "senses": [
                    {
                        "sense_id": "32349a79-861f-3209-9c3a-97295654eda6",
                        "entry_id": "3ed96b02-7c06-3055-9d62-25e622410209",
                        "glosses": [
                            "(oftmals in Geld ausgedrückte Ansammlung materieller und immaterieller Güter) Vermögen, das von einer Rechtspersönlichkeit verwaltet wird, selbst aber keine darstellt"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "53d1359e-2bd6-4896-857f-dc552cca9d41",
                                "sense_id": "32349a79-861f-3209-9c3a-97295654eda6",
                                "text": "„Sondervermögen sind inländische Investmentvermögen in Vertragsform, die von einer Kapitalanlagegesellschaft für Rechnung der Anleger nach Maßgabe dieses Gesetzes und den Vertragsbedingungen, nach denen sich das Rechtsverhältnis der Kapitalanlagegesellschaft zu den Anlegern bestimmt, verwaltet werden, und bei denen die Anleger das Recht zur Rückgabe der Anteile haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6562c525-8836-3031-bdf6-d2a20d994fb0",
                        "entry_id": "3ed96b02-7c06-3055-9d62-25e622410209",
                        "glosses": [
                            "wirtschaftlich verselbständigter Nebenhaushalt („Schattenhaushalt“), der ausschließlich zur Erfüllung einzelner begrenzter Aufgaben des Bundes in einer besonderen Situation bestimmt ist"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "8884cecd-1417-48fc-94e5-e909dd719776",
                                "sense_id": "6562c525-8836-3031-bdf6-d2a20d994fb0",
                                "text": "„Der Bundesrat hat am Freitag die Einrichtung eines Sondervermögens von insgesamt 3,5 Milliarden Euro aus Bundesmitteln gebilligt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
