                                        "examples": [
                                            {
                                                "example_id": "36c79a85-aa70-4eac-b532-633001292046",
                                                "sense_id": "736b5b70-1889-3155-b5ed-7d4564f11514",
                                                "text": "It was a view that would not necessarily be shared by Algerians subjected to the gégène or having had their bellies pumped full of water during the Battle of Algiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
