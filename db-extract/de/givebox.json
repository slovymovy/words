                "senses": [
                    {
                        "sense_id": "a1557617-4ecf-3d3e-ad85-4e57e5efab9c",
                        "entry_id": "8f14a736-55d0-321c-8da6-545bbeea4ecf",
                        "glosses": [
                            "A box in a public place in which people can put unwanted objects for other people to take; a dropbox."
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "133aea86-5112-4400-ae50-be9b02a9f486",
                                "sense_id": "a1557617-4ecf-3d3e-ad85-4e57e5efab9c",
                                "text": "Wir schreiben das Jahr 2033. Schon vor zwanzig Jahren hatte sich über die rasche Verbreitung von Car-Sharing-Modellen und Giveboxen in den Städten der Paradigmenwechsel vom Besitzen zum Nutzen angekündigt, der heute im vollen Gange ist",
                                "translation": "We're writing the year 2033. Twenty years, the fast spread of car-sharing and Giveboxes in cities heralded the paradigm shift from \"owning\" to \"using\" which is currently going full speed ahead.",
                                "english": "We're writing the year 2033. Twenty years, the fast spread of car-sharing and Giveboxes in cities heralded the paradigm shift from \"owning\" to \"using\" which is currently going full speed ahead."
                            },
                            {
                                "example_id": "3d601ba9-38dc-47c6-be1c-a0f867899cb9",
                                "sense_id": "a1557617-4ecf-3d3e-ad85-4e57e5efab9c",
                                "text": "Wenn sie das Zeug selbst nicht brauchen, reichen sie es weiter, umsonst auf den entsprechenden Märkten und in Umsonstläden oder in Giveboxen, die am Straßenrand, an Bushaltestellen oder in anderen öffentlichen Nischen zum kostenlosen Mitnehmen einladen.",
                                "translation": "If they don't need the thing themselves, they pass it on for free in the corresponding markets and in swap-shops, or in Giveboxes by the sides of roads, at bus stops and in other public niches, which offer free taking.",
                                "english": "If they don't need the thing themselves, they pass it on for free in the corresponding markets and in swap-shops, or in Giveboxes by the sides of roads, at bus stops and in other public niches, which offer free taking."
                            },
                            {
                                "example_id": "dc94f7fd-4903-44a1-a291-a334704c83ca",
                                "sense_id": "a1557617-4ecf-3d3e-ad85-4e57e5efab9c",
                                "text": "Nachdem richtig große Großstädte wie Berlin schon länger eine haben, gibt es nun auch in Darmstadt die erste Givebox.",
                                "translation": "While the really big cities like Berlin have had them for longer, Darmstadt now also has its first Givebox.",
                                "english": "While the really big cities like Berlin have had them for longer, Darmstadt now also has its first Givebox."
                            }
                        ]
                    }
