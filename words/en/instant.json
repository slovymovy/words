                                "target_lang_word": "растворимый",
                                "target_lang_sense_clarification": "о кофе или напитках"
                            },
                            {
                                "target_lang_word": "быстрого приготовления",
                                "target_lang_sense_clarification": "о еде (лапша, каша)"
                            }
