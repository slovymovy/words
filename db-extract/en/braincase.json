                                    {
                                        "sense_id": "1e5f1a34-36c6-36ef-93c0-1e2261788d14",
                                        "entry_id": "f5b2658b-56ff-310a-bd7a-66084cc5c656",
                                        "glosses": [
                                            "knochige Schale, in der sich das Gehirn befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61322ff7-927c-4f03-b650-2123591e9d84",
                                                "sense_id": "1e5f1a34-36c6-36ef-93c0-1e2261788d14",
                                                "text": "Trotz der Gesamtgröße des Tieres war die Hirnschale klein und nicht größer als die eines Hundes."
                                            },
                                            {
                                                "example_id": "33dc9282-02c8-4619-9747-c72fbd84f3d3",
                                                "sense_id": "1e5f1a34-36c6-36ef-93c0-1e2261788d14",
                                                "text": "Die Hirnschale [von Talpanas lippa] ist flach und breit im Verhältnis zur Länge."
                                            },
                                            {
                                                "example_id": "de457285-ea70-422b-a1a2-8fa4ea67a39e",
                                                "sense_id": "1e5f1a34-36c6-36ef-93c0-1e2261788d14",
                                                "text": "Aus Ymirs Fleisch — ward die Erde geschaffen,//Aus dem Schweiße die See,//Aus dem Gebein die Berge, — die Bäume aus dem Haar,//Aus der Hirnschale der Himmel."
                                            },
                                            {
                                                "example_id": "1ef0bf88-d75e-4ab0-9f31-b88e26d7fbda",
                                                "sense_id": "1e5f1a34-36c6-36ef-93c0-1e2261788d14",
                                                "text": "Man klappe die Hirnschale eines mittlern [sic!] Staatsanwalts auf, die irgendeines kleinen Landgerichtsdirektors, und man wird darin Anschauungen über Seelenkunde finden, die museal sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
