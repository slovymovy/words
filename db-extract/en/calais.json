                                        "entry_id": "e40fa500-3e6c-3780-965d-de1dea77c231",
                                        "glosses": [
                                            "havenstad en gemeente in het noordwesten van Frankrijk, waar de tunnel onder het Kanaal naar het Engeland begint"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187dd12d-1b92-4c37-80c2-4b1a120700fa",
                                                "sense_id": "a6ea97e3-8486-3113-876d-ddb2a366369c",
                                                "text": "Calais is een uitvalsbasis voor veel vluchtelingen die in vrachtauto's, met treinen of in bootjes naar Engeland willen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95af8870-92b3-4d1b-a9b0-cfe7b8b2e875",
                        "source_entry_id": "fe92ffd0-76ca-376d-906c-152700ca3683",
