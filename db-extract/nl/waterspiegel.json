                ],
                "translations": [
                    {
                        "translation_id": "d2cb572b-65fb-4259-8bce-c44b737530c9",
                        "source_entry_id": "1e2ccfd7-1ef2-30fb-96d9-4f5e371302f9",
                        "source_sense_id": "a2346bab-05a8-33ff-9337-af1d06bfba4c",
                        "source_sense_description": "wateroppervlak, bovenste grensvlak van het water",
                        "target_lang_word": "Wasserspiegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserspiegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44b64eda-62ec-383e-bafb-9f170fc7d80b",
                                        "entry_id": "4f932a47-4d39-3703-836d-7bfececbadc5",
                                        "glosses": [
                                            "die glatte, spiegelnde Oberfläche eines Gewässers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008192c8-1369-48b7-8b80-3da4e645f62f",
                                                "sense_id": "44b64eda-62ec-383e-bafb-9f170fc7d80b",
                                                "text": "Blitzblank lag der Wasserspiegel des Bergsees vor ihnen."
                                            },
                                            {
                                                "example_id": "871e4b99-1233-4b05-a58a-775c0620c9d0",
                                                "sense_id": "44b64eda-62ec-383e-bafb-9f170fc7d80b",
                                                "text": "„Die flachen Wasserspiegel waren mit einer feinen Eisschicht überzogen, die verharschten Schneereste knirschten unter ihren Schuhen.“"
                                            },
                                            {
                                                "example_id": "05a4cdb5-045a-4011-a16c-a1cb4e8661d3",
                                                "sense_id": "44b64eda-62ec-383e-bafb-9f170fc7d80b",
                                                "text": "„Unter der Anleitung des Ingenieurs schlug der Seemann mit der Spitzhacke ein Loch in den Felsen, das knapp über dem Wasserspiegel begann und dann in schräger Richtung nach unten führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                        "entry_id": "4f932a47-4d39-3703-836d-7bfececbadc5",
                                        "glosses": [
                                            "die Höhe, die eine Wasseroberfläche erreicht; Wasserstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4eb33b8-56e8-4aa6-845b-993d24c95cd8",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "Heute Nacht ist der Wasserspiegel um 10cm gesunken."
                                            },
                                            {
                                                "example_id": "7dd069d7-0154-4fc0-88fe-c29f21071931",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "Seit Jahren ist der Wasserspiegel der Elbe im Sommer so niedrig, dass keine Binnenschiffahrt mehr möglich ist."
                                            },
                                            {
                                                "example_id": "397d7e00-0772-473b-a5c2-0e2226d0a3c2",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "[Trockenheit:] „Vor allem der Wasserspiegel der Mud bei Weilbach im Kreis Miltenberg ist außergewöhnlich niedrig“ […]."
                                            },
                                            {
                                                "example_id": "e7510b8a-168b-401f-a1dc-27cdc0e48a72",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "[Torfabbau:] „Um an den Torf zu kommen, muss der Wasserspiegel abgesenkt werden.“"
                                            },
                                            {
                                                "example_id": "73365f5e-bfcc-4da5-aca5-4d01a6809a93",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "„Die Windmühle, ein Erdholländer, pumpt seit 1844 Grundwasser an die Oberfläche, um den Wasserspiegel in dem eingedeichten Gebiet zu senken.“"
                                            },
                                            {
                                                "example_id": "643af2f5-98b5-4e4e-8592-d878c22b5853",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "„Durch den niedrigen Wasserspiegel tauchten am Rande des Stausees die Überreste einer 3400 Jahre alten Stadt auf, die vor Jahrzehnten untergegangen war.“"
                                            },
                                            {
                                                "example_id": "6986cf22-5716-4c0e-8ccf-4e1bdb155fd5",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "„Der Glen Canyon in Utah und Arizona wurde in den 1960er Jahren zur Strom- und Wasserversorgung geflutet. Jetzt ist der Wasserspiegel durch Dürre und übermäßigen Verbrauch stark zurückgegangen und hat die Diskussion um den Stausee neu entfacht.“"
                                            },
                                            {
                                                "example_id": "f89eecb0-ee63-482c-8000-779da7afe7f1",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "„In den Blickpunkt der Öffentlichkeit geriet der See in den letzten Jahrzehnten durch ein dramatisches Absinken des Wasserspiegels, wie die nebenstehenden Satellitenaufnahmen zeigen; seine Fläche schrumpfte seit 1963 um mehr als 90 %, was auch als eine Folge der globalen Erwärmung gesehen wird.“"
                                            },
                                            {
                                                "example_id": "a2d26abc-f16e-402c-9328-a42644bdab43",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "„Der Wasserspiegel ist so stark gestiegen, dass das Sonnendeck samt Reling abgebaut wurde, damit das Boot unbeschadet unter den Brücken durchkommt.“"
                                            },
                                            {
                                                "example_id": "52d2e30a-451e-4afd-982c-bddfd9a8c8d5",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "[1950 – Reschensee/Italien:] „Für ein Wasserkraftwerk im Vinschgau stauen sie mehrere kleine Gebirgsseen zu einem einzigen großen See. Der Wasserspiegel steigt dabei um über 20 Meter. Alle Äcker und Felder in der Umgebung, die Bauernhöfe und auch die Kirche versinken in den Fluten.“"
                                            },
                                            {
                                                "example_id": "ab52bca9-71f5-48b2-8c87-651225eb1a0f",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "[Insel Kirr südlich von Zingst:] „Das Eiland erhebt sich nur wenige Meter über den Wasserspiegel, sodass Teile der Insel regelmäßig überflutet werden.“"
                                            },
                                            {
                                                "example_id": "0fe919ea-8019-48de-a092-f8639d59884c",
                                                "sense_id": "87d623a1-ab16-330d-a832-4ce4bcf9a90c",
                                                "text": "[Schleuse von Farakka (oder Farakka-Staudamm)/Indien:] „Die Schleuse dient dazu, den Wasserspiegel des Ganges auf indischer Seite besser zu regulieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
