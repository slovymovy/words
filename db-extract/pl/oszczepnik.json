                        "source_sense_id": "67052850-372e-3b1d-b4e3-b7ad366a35d7",
                        "target_lang_word": "javelineer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "javelineer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af27ff6d-f4da-384f-86ca-f6332c3728b9",
                                        "entry_id": "afbbcada-fce1-383f-a3cb-745f90ebe568",
                                        "glosses": [
                                            "A soldier who throws a javelin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb031ad1-20aa-464e-ac06-34e673d89293",
                                                "sense_id": "af27ff6d-f4da-384f-86ca-f6332c3728b9",
                                                "text": "As it now is, the enemy outshoot and outsling us so far that the Cretan archers and our javelineers cannot reach them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "926ef595-c91b-47a9-9b26-2047495308c4",
                        "source_entry_id": "47a9c6f5-f10c-3c95-8e81-6d15d7d2c557",
                        "source_sense_id": "67052850-372e-3b1d-b4e3-b7ad366a35d7",
                        "target_lang_word": "lancier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd37348-1144-3fc5-b9a8-4440a644f01d",
                                        "entry_id": "fd905edf-9471-3b73-9508-e3985911cf22",
                                        "glosses": [
                                            "Relatif au lançoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7568189-fa1f-41ec-a84a-41ada5d97344",
                                                "sense_id": "7bd37348-1144-3fc5-b9a8-4440a644f01d",
                                                "text": "Vanne lancière, vanne qui donne l'eau immédiatement à la roue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe01824-a1e9-33a4-9d44-86ea492df332",
                                        "entry_id": "7f4ef348-8e29-3a8d-a3fa-88fffc9905ae",
                                        "glosses": [
                                            "Soldat, fantassin ou cavalier, équipé d’une lance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc72dc3-320d-4350-9cc3-b7821d239b55",
                                                "sense_id": "6fe01824-a1e9-33a4-9d44-86ea492df332",
                                                "text": "Il regardait les lanciers et se trouvait tout transporté de joie et d’étonnement. Voilà donc les compagnons de Napoléon ; voilà donc le soldat français !"
                                            },
                                            {
                                                "example_id": "5bed241c-ff70-4dbc-b996-84b9297b81c3",
                                                "sense_id": "6fe01824-a1e9-33a4-9d44-86ea492df332",
                                                "text": "La section de droite est détachée à 1 kilomètre de Saint-Ponce à la gauche de l'attaque, tandis que les quatre autres pièces restées avec le capitaine, tirent sur les abords du village de Saint-Laurent, incendié par des lanciers prussiens."
                                            },
                                            {
                                                "example_id": "7e909301-900a-4b1d-b8ef-10336548c0b3",
                                                "sense_id": "6fe01824-a1e9-33a4-9d44-86ea492df332",
                                                "text": "Le 5ᵉ lanciers, qui marchait avec la brigade de Maussion, s'était porté au-devant de l'ennemi."
                                            },
                                            {
                                                "example_id": "de495e9e-dfc7-46c2-b2b0-9fa74a8ab385",
                                                "sense_id": "6fe01824-a1e9-33a4-9d44-86ea492df332",
                                                "text": "Au cours des trois duels qui lui sont attribués, la lancière a raison de ses adversaires sans faire usage de sa lance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lancier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f01799fb-401e-3959-9a83-ad79e092d46e",
                                        "entry_id": "fa57e8c8-ad25-30bf-a9fd-c067a9ad55cc",
                                        "glosses": [
                                            "Poisson de nom scientifique Alepisaurus ferox."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac311c30-3011-476a-bc00-1735c3835cc3",
                                                "sense_id": "f01799fb-401e-3959-9a83-ad79e092d46e",
                                                "text": "Pêcher le lancier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00017400-f5c5-3189-a151-25b8026d94ab",
                                        "entry_id": "fa57e8c8-ad25-30bf-a9fd-c067a9ad55cc",
                                        "glosses": [
                                            "Ancienne danse importée d'Angleterre en France sous le Second Empire, où les danseurs s'affrontent en cinq figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3338b599-0b03-485c-a930-b521b76588e7",
                                                "sense_id": "00017400-f5c5-3189-a151-25b8026d94ab",
                                                "text": "danser le lancier."
                                            },
                                            {
                                                "example_id": "15eed25e-f821-46da-ac88-0569ace287dd",
                                                "sense_id": "00017400-f5c5-3189-a151-25b8026d94ab",
                                                "text": "Une danse, le quadrille des lanciers, formait significativement le centre du film."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
