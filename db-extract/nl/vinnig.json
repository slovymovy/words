                "senses": [
                    {
                        "sense_id": "4e8af823-b306-3520-9649-4b1051d237f6",
                        "entry_id": "0b040fdb-6d91-322e-bf43-9ff98f3f3172",
                        "glosses": [
                            "beetje agressief, scherp, bits, hevig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5244c74a-cf1d-4f45-b79f-94e9aa4e2599",
                                "sense_id": "4e8af823-b306-3520-9649-4b1051d237f6",
                                "text": "Het vinnige meisje had borderline."
                            },
                            {
                                "example_id": "232dec3a-421c-4650-b7a2-a67581f9791c",
                                "sense_id": "4e8af823-b306-3520-9649-4b1051d237f6",
                                "text": "Het lijkt een faux pas. Een kuchje op het verkeerde moment. ‘Sorry’, zegt het kamermeisje Abigail (Emma Stone) als de explosieve koningin Anne (Olivia Colman) haar vinnig aankijkt. ‘Ik denk dat ik een koutje heb gevat toen ik gisteren de kruiden plukte tegen uw jicht.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e17ca503-4de8-490a-9373-658015433874",
                        "source_entry_id": "0b040fdb-6d91-322e-bf43-9ff98f3f3172",
                        "source_sense_id": "4e8af823-b306-3520-9649-4b1051d237f6",
                        "target_lang_word": "brusco",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brusco",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f6663680-6ce0-3bc7-8543-935137fcc282",
                                        "entry_id": "58e463fe-df0d-3c31-8c29-9b4209df2cca",
                                        "glosses": [
                                            "Realizado sin suavidad ni gentileza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21fb6c47-bcd6-4137-bfa9-42c5c8b1963e",
                                                "sense_id": "f6663680-6ce0-3bc7-8543-935137fcc282",
                                                "text": "Personas hay v g. que responden con frialdad ó indiferencia, ó tal vez con descortesia porque su caracter es brusco; semejantes individuos merecen por haber sido tan poco favorecidos de la naturaleza, mas bien nuestra compasion que nuestro enojo, debiendo mirárseles como a seres destituidos de racionalidad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2eab72d2-d661-38cf-a0d2-3b69b0dce8d1",
                                        "entry_id": "58e463fe-df0d-3c31-8c29-9b4209df2cca",
                                        "glosses": [
                                            "Realizado con prontitud, sin preparación o repentinamente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601bd349-f552-49ff-8d18-a9579a85f1a2",
                                                "sense_id": "2eab72d2-d661-38cf-a0d2-3b69b0dce8d1",
                                                "text": "El miliciano se apartó de un salto por un tirón brusco de riendas; Aldama hizo chasquear la lonja en la carona, y siguió su camino gruñendo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
