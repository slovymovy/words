                    "frequency": "Middle",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had in de hoeken van het papier wat <w>krullen</w> getekend ter versiering.",
                            "target_lang_translations": {
                                "en": "He had drawn some <w>flourishes</w> in the corners of the paper as decoration."
                            }
                        },
                        {
                            "text": "De ijzeren poort was versierd met een elegante <w>krul</w> aan de bovenkant.",
                            "target_lang_translations": {
                                "en": "The iron gate was decorated with an elegant <w>curl</w> at the top."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een mooie krul"
                    ],
                    "target_lang_definitions": {
