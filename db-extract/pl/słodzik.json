                    {
                        "sense_id": "a8fc81f7-397e-3d6a-bac7-295b5f3dbff2",
                        "entry_id": "083de46e-85da-3b84-b8dd-b81060215c66",
                        "glosses": [
                            "słodka substancja używana do słodzenia żywności zamiast cukru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bafcd6-b06d-42c2-b37b-f77023082d20",
                                "sense_id": "a8fc81f7-397e-3d6a-bac7-295b5f3dbff2",
                                "text": "W Polsce dozwolone jest stosowanie słodzików takich jak aspartam (E951), sorbitol (E420), ksylitol (E967) i maltitol"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "688104cf-d06b-4053-81a7-0e152f6b6bec",
                        "source_entry_id": "083de46e-85da-3b84-b8dd-b81060215c66",
                        "source_sense_id": "a8fc81f7-397e-3d6a-bac7-295b5f3dbff2",
                        "target_lang_word": "sweetener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
                                        "glosses": [
                                            "Something added to food to sweeten its taste, especially an artificial substitute for sugar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1586b6f0-3612-48c2-974a-5b70e428cfe9",
                                                "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                                "text": "Some examples of the sweeteners include aspartame, saccharin, sucralose and stevia. The W.H.O.’s announcement contradicts previous studies that have said these sweeteners don’t offer any health benefits but also do not cause harm."
                                            },
                                            {
                                                "example_id": "1d7d4e5f-f089-4143-bdc8-02520ccd5f4d",
                                                "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                                "text": "Even as FDA works to develop that plan, consumers continue to be exposed to unsafe food chemicals including not just dyes but also the artificial sweetener aspartame, the white pigment titanium dioxide, the preservative propylparaben, and the phthalate food packaging chemicals, according to CSPI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bb63ae0-1f53-3c11-9b20-d74c24231a9e",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
                                        "glosses": [
                                            "Something given or added to added to a deal to sweeten another's attitude, especially a bribe or kickback."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3bd4fc9-3897-3f42-b25d-53b1c734a386",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
                                        "glosses": [
                                            "A shill bidder at an auction."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b7c8471-644e-4624-a938-ea9833e76197",
                        "source_entry_id": "083de46e-85da-3b84-b8dd-b81060215c66",
                        "source_sense_id": "a8fc81f7-397e-3d6a-bac7-295b5f3dbff2",
                        "target_lang_word": "sladidlo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sladidlo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0a05d299-6aaf-384b-8b29-989801dd7a8d",
                                        "entry_id": "e0c1cd80-28a3-340b-bb7c-340ec4e75eda",
                                        "glosses": [
                                            "látka přidávaná do potravin k dodání sladkosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee118810-4c23-4f4b-98dd-dff5fc545857",
                                                "sense_id": "0a05d299-6aaf-384b-8b29-989801dd7a8d",
                                                "text": "V takzvaných light výrobcích se místo cukru používají umělá sladidla."
                                            },
                                            {
                                                "example_id": "c488d22a-3770-471e-bc6d-f630f3507388",
                                                "sense_id": "0a05d299-6aaf-384b-8b29-989801dd7a8d",
                                                "text": "Před objevením řepného cukru se v Evropě jako sladidlo užíval často med nebo z Blízkého východu dovezený svatojánský chléb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1524ff8f-54b4-485d-a21d-160ebeed52d5",
                        "source_entry_id": "083de46e-85da-3b84-b8dd-b81060215c66",
                        "source_sense_id": "a8fc81f7-397e-3d6a-bac7-295b5f3dbff2",
                        "target_lang_word": "édulcorant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "édulcorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                                        "entry_id": "14e0669d-8d67-3fa0-a1e8-65839223938f",
                                        "glosses": [
                                            "Qui donne une saveur douce et sucrée aux aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930f4d9a-b497-4c9e-857e-682ac054df15",
                                                "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                                                "text": "Si une partie de la propriété édulcorante du sucre lui est enlevée pendant la pulvérisation, elle lui est rendue pendant sa transformation en sirop."
                                            },
                                            {
                                                "example_id": "3e8ed48c-f216-4b0f-af0e-69aaaa25fb7e",
                                                "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "édulcorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af9b14c3-548e-366f-897e-4edf1b8360e3",
                                        "entry_id": "18b2cfe2-c1c3-3557-960a-898ffd6de48c",
                                        "glosses": [
                                            "Produit servant à parfumer ou donner un goût sucré aux aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "912139ec-c015-4c8d-8b19-9aaba2806516",
                                                "sense_id": "af9b14c3-548e-366f-897e-4edf1b8360e3",
                                                "text": "L’aspartame est un édulcorant."
                                            },
                                            {
                                                "example_id": "942f9b06-5621-42db-b565-ca3f4fd40835",
                                                "sense_id": "af9b14c3-548e-366f-897e-4edf1b8360e3",
                                                "text": "Ils remplacent le sucre dans tous les produits light. Plusieurs études récentes s'inquiètent de leurs dangers […] mais le risque des édulcorants sur la santé n'est pas démontré."
                                            }
                                        ]
                                    }
                                ]
                            },
