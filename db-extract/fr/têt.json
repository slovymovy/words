                "senses": [
                    {
                        "sense_id": "baf54966-012a-35a2-9e0e-4f330015d631",
                        "entry_id": "3a901674-8a2d-36a6-b40d-b4ea06f8acfd",
                        "glosses": [
                            "Coupelle dans laquelle on effectue la calcination de certaines matières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39990734-f1fb-43a9-8f96-ec0f3caf4096",
                                "sense_id": "baf54966-012a-35a2-9e0e-4f330015d631",
                                "text": "En 1860, « l’expérience de Lavoisier » est rapportée dans les Notions de chimie de Boutet de Monvel (p. 30), ouvrage destiné à la classe de seconde, section des Lettres : « Il se servit d’un ballon à long col recourbé comme un tube à recueillir les gaz ; l’extrémité de ce tube plongeait sous un têt troué et montait à l’intérieur d’une éprouvette », définie deux pages auparavant comme une cloche en verre, cylindrique et étroite."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                "word": "têt",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3efa272-8b2a-43b8-a975-ad335d50ae07",
                        "entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                        "tags": [
                            "plural"
                        ],
                        "form": "têts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0cf0c6dd-ed39-328d-a63c-baedaa214b3f",
                        "entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                        "glosses": [
                            "Fête traditionnelle du nouvel an vietnamien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f31715-309b-4d04-a307-363a064f4641",
                                "sense_id": "0cf0c6dd-ed39-328d-a63c-baedaa214b3f",
                                "text": "Le Têt ou le Nouvel An lunaire est la plus grande festivité au Vietnam. C’est l’occasion de se souvenir de son origine, de ses ancêtres, de sa famille et de ses proches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18f91288-9a23-4d3f-a812-c616313954a6",
                        "source_entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                        "source_sense_id": "0cf0c6dd-ed39-328d-a63c-baedaa214b3f",
                        "target_lang_word": "pedicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "446843b0-a746-36a3-86a8-57a928af9fd0",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "A fleshy line used to attach and anchor brachiopods and some bivalve molluscs to a substrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565f574c-824b-4f23-9b8b-66cf42d74bab",
                                                "sense_id": "446843b0-a746-36a3-86a8-57a928af9fd0",
                                                "text": "A species of shell-fish, often found sticking by its pedicle to the bottom of ships, doing no other injury than deadening the way a little: \"Barnacles, termed soland geese In th' islands of the Orcades.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f034ff4e-27fa-3a56-b1cf-e1ed199a7a70",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "The attachment point for antlers in cervids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1efca9e-f6f2-4c85-9eb9-2b7dc4fb7b46",
                                                "sense_id": "f034ff4e-27fa-3a56-b1cf-e1ed199a7a70",
                                                "text": "His long, rakish horns are mounted on a pedicle that extends above his head, thus accentuating the droll length of his features."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db39761e-0436-31bf-8588-dbb23779b06a",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "A stalk that attaches a tumour to normal tissue"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46bd1f10-ef5c-4355-80a2-196ca75f0b94",
                                                "sense_id": "db39761e-0436-31bf-8588-dbb23779b06a",
                                                "text": "--Figure 3. Fig. 4, Plate 58, represents the neck of the bladder and neighbouring part of the urethra of an ox, in which a polypous growth is seen attached by a long pedicle to the veru montanum and blocking up the neck of the bladder."
                                            },
                                            {
                                                "example_id": "ba63744b-85bf-4cfe-b71f-12e784d3ff81",
                                                "sense_id": "db39761e-0436-31bf-8588-dbb23779b06a",
                                                "text": "One of these women, a secundipara, had gone two weeks over time, and had a large ovarian cyst, the pedicle of which had become twisted, the fluid in the cyst being sanguineous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a3ed423-aef1-3c70-81fe-095754dad801",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "pedicel (any sense)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d4ba48-ca36-44dc-89ab-117e93e1654e",
                                                "sense_id": "2a3ed423-aef1-3c70-81fe-095754dad801",
                                                "text": "One of the ends is lengthened out into a neck or pedicle, which is as long as the egg proper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "086a4de3-a525-39d9-a2e2-a8a766c43b43",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "peduncle (any sense)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8aa2d8b-fa94-461f-9994-126ac77864f9",
                                                "sense_id": "086a4de3-a525-39d9-a2e2-a8a766c43b43",
                                                "text": "The chimpanzee Heschl's gyrus homolog also showed evidence of a strongly excavated middle Heschl's sulcus, within the confines of a single gyral pedicle, predominantly in the right hemisphere."
                                            },
                                            {
                                                "example_id": "ea553268-1777-4677-a789-544871c5ba23",
                                                "sense_id": "086a4de3-a525-39d9-a2e2-a8a766c43b43",
                                                "text": "The surface of the extracellular space at the base of the cone pedicle in goldfish has been estimated to be between 0.01 to 0.1 µm 2 depending on the fixation procedure used [ C. A. V. Vandenbranden, et al., Vision Res."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c261117b-546d-3470-b81f-70ae357396d7",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "Part of a skin or tissue graft temporarily left attached to its original site."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "932029a2-2467-3e9e-8405-bb7fa057c58d",
                                        "entry_id": "3b28186c-4da0-3ce9-ba90-540aa72fc66a",
                                        "glosses": [
                                            "A fetter for the foot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374bdc3b-3532-492e-ae69-4fcda243624e",
                        "source_entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                        "source_sense_id": "0cf0c6dd-ed39-328d-a63c-baedaa214b3f",
                        "target_lang_word": "crucible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e90b917-0203-3213-adf4-af516a27fdc4",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A cup-shaped piece of laboratory equipment used to contain chemical compounds when heating them to very high temperatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8757e926-7681-4f1b-9707-beadca41dacc",
                                                "sense_id": "0e90b917-0203-3213-adf4-af516a27fdc4",
                                                "text": "In one corner of the closet was a very small furnace, with a glowing fire in it, and on the fire a kind of duplicate crucible—two crucibles connected by a tube. One of these crucibles was nearly full of lead in a state of fusion, but not reaching up to the aperture of the tube, which was close to the brim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf594bb4-d8bf-30ac-b837-3be1b891b40d",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A heat-resistant container in which metals are melted, usually at temperatures above 500°C, commonly made of graphite with clay as a binder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b6ce7f4-f54a-3a60-91bf-7423d7a11a59",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "The bottom and hottest part of a blast furnace; the hearth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A very difficult and trying experience, that acts as a refining or hardening process."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcad3650-2f18-417d-bbc2-28701300ed84",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "But, in considering an author and his works as one, a sufficient distinction is not drawn between the ideal and the real: the last is only given by being past through the crucible of the first."
                                            },
                                            {
                                                "example_id": "b03b516b-5092-4c00-915c-2be5974869be",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "We should give our support to the liberation of the captive nations of the world and deliver our compatriots from their crucible of suffering. In other words, we should take up the difficult task of reshaping the world’s destiny by destroying the tyrannical Communist rule now afflicting the earth and by delivering humankind from the Red holocaust."
                                            },
                                            {
                                                "example_id": "2123f297-8899-4037-8d22-c3aa839b63b8",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "Some of our ancestors faced trials that we will never know—the snows of Valley Forge; the crucible of a bitter, bloody civil war; and the incredible hardships endured in taming a savage wilderness."
                                            },
                                            {
                                                "example_id": "e2cbaa00-6186-4296-ab77-cc40db453bc3",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "Beowulf's mood as he gets ready to fight the dragon - who could be read as a projection of Beowulf's own chthonic wisdom refined in the crucible of experience - recalls the mood of other tragic heroes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2294125-8df6-4601-9981-59c26bfca35d",
                        "source_entry_id": "8e3fc80d-c3ef-3030-8990-ce4561799fa8",
                        "source_sense_id": "0cf0c6dd-ed39-328d-a63c-baedaa214b3f",
                        "target_lang_word": "Tet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d099cf9e-3e68-3b10-b60b-71339ae4edf0",
                                        "entry_id": "8005fb9c-afd8-319b-99cb-2dbc04cbe895",
                                        "glosses": [
                                            "Vietnamese New Year celebration, occurring during the first seven days of the first month of the lunar calendar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a669f71-f0fe-4182-9923-e9dff7361e98",
                                                "sense_id": "d099cf9e-3e68-3b10-b60b-71339ae4edf0",
                                                "text": "1981, Mimi Holtzman, TET: celebrating the Vietnamese New Year, Voices in Educational Transition, 114"
                                            },
                                            {
                                                "example_id": "1a333712-ed25-48a1-8979-dcc217a4cca4",
                                                "sense_id": "d099cf9e-3e68-3b10-b60b-71339ae4edf0",
                                                "text": "2004, Ngọc Bích Nguyễn, Tet!: the Vietamese New Year, East Coast U.S.A. Vietnamese Pub. Consortium, 141"
                                            }
                                        ]
