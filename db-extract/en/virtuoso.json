                    {
                        "translation_id": "db5b03f9-a221-4796-8a66-1c8751da618b",
                        "source_entry_id": "b1ccabb8-992d-3223-9d3e-a5860f3f2bbc",
                        "source_sense_description": "A person with masterly ability, technique or style",
                        "target_lang_word": "virtuose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtuose",
