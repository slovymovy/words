                "senses": [
                    {
                        "sense_id": "980b9de2-ca43-338d-b770-3f14760a0faf",
                        "entry_id": "ea2a17f2-df0e-3dfc-af46-f72536e7ab17",
                        "glosses": [
                            "Donner un caractère khmer à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7a795c-3a1c-4bd8-b679-6d19e3ed26fc",
                                "sense_id": "980b9de2-ca43-338d-b770-3f14760a0faf",
                                "text": "On peut interpréter cela comme une tendance à khmériser les noms officiels des enfants d’origine chinoise, dans un contexte politique qui leur a été peu favorable ces dernières décennies."
                            },
                            {
                                "example_id": "50f8cd11-6c9f-46a9-9a16-0cce40449a2e",
                                "sense_id": "980b9de2-ca43-338d-b770-3f14760a0faf",
                                "text": "Je crois d’autre part que toute une tradition pousse les Khmers à khmériser profondément tout ce qui vient du monde extérieur."
                            }
                        ]
                    }
