                                        "entry_id": "1752eb56-364a-363a-a42c-2e5727b576a6",
                                        "glosses": [
                                            "A person from Cuba or of Cuban descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f15276-9eac-445b-b0d4-4bae9f2d49d9",
                                                "sense_id": "6ee3846e-8510-393c-9d60-2d6748f6ec62",
                                                "text": "Eleven Cubans in a vintage Buick — three of them the original “truckonauts” who tried a similar intrepid journey last year aboard a battered Chevy pickup — were intercepted by the U.S. Coast Guard early Wednesday and now face a return trip to the communist island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "827a3beb-39d4-3fac-9ed7-f181f879e95a",
                                        "entry_id": "1752eb56-364a-363a-a42c-2e5727b576a6",
                                        "glosses": [
                                            "A cigar made in Cuba."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Cuban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f930b84b-5059-3794-aabd-5ed6065de132",
                                        "entry_id": "ef4f77e0-4600-3477-8f6c-f546d9e58766",
                                        "glosses": [
                                            "Of, from, or pertaining to Cuba, the Cuban people or the Cuban dialect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc78bce-f35f-4b03-8b0e-eae4c52c151e",
                                                "sense_id": "f930b84b-5059-3794-aabd-5ed6065de132",
                                                "text": "Conservative Republicans who had demanded an investigation and hearings when Elian, the 6-year-old Cuban boy, was forceably taken from the house of his great-uncle on April 22 quickly retreated when it was clear the public supported the government action."
                                            }
                                        ]
                                    }
                                ]
