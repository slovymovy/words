                "senses": [
                    {
                        "sense_id": "651c9c87-8be9-3c9e-8ef6-d51b4376d281",
                        "entry_id": "8d592680-8dec-3c4b-b114-c96ba5d1c739",
                        "glosses": [
                            "Acquêt, ce qu’on acquiert par son industrie, et qui ne vient point de succession."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1fda86c1-a508-448a-8e30-ea157e14b747",
                                "sense_id": "651c9c87-8be9-3c9e-8ef6-d51b4376d281",
                                "text": "La femme, ainsi qu’on l’a précédemment remarqué , ne prend part aux conquêts qu’après la mort de son mari, c’est-à-dire , qu’elle n’en jouit qu’en se déclarant héritière."
                            },
                            {
                                "example_id": "b45922c9-30e7-4703-9b7f-918080188a97",
                                "sense_id": "651c9c87-8be9-3c9e-8ef6-d51b4376d281",
                                "text": "Un immeuble acquis des deniers propres à l’un des époux est un conquêt, sauf la récompense due à l’époux propriétaire, à moins que l’acquisition ne soit faite à titre de remploi au profit de l’époux propriétaire de l’immeuble vendu."
                            }
                        ]
                    }
                ],
