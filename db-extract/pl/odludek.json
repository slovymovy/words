                "translations": [
                    {
                        "translation_id": "579fc438-6530-48ab-bffb-d9b0b8e7d28a",
                        "source_entry_id": "c9d7fab4-cb34-33da-b33d-4e5434c281e5",
                        "source_sense_id": "01353bbc-4ff7-37d0-bf4c-51e8a9f0f798",
                        "target_lang_word": "нелюдим",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нелюдим",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c029a96-b8b9-3912-a806-2c8331d1651f",
                                        "entry_id": "4013204f-2894-3a70-b97b-6f93c5e180ff",
                                        "glosses": [
                                            "нелюдимый человек; тот, кто избегает общества других людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9585ad8d-f384-467e-8e34-409575fc77fa",
                                                "sense_id": "8c029a96-b8b9-3912-a806-2c8331d1651f",
                                                "text": "Но говорят, вы нелюдим: в глуши, в деревне всё вам скучно"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c8fa6b-6a8a-44ae-a507-7af6f7051d3b",
                        "source_entry_id": "c9d7fab4-cb34-33da-b33d-4e5434c281e5",
                        "source_sense_id": "01353bbc-4ff7-37d0-bf4c-51e8a9f0f798",
                        "target_lang_word": "бирюк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бирюк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3170fa5d-7511-3217-9a9b-a502dba2cc7d",
                                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                                        "glosses": [
                                            "рег. волк (обычно волк-одиночка)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bab2451-4c5e-437e-998f-8f45cbe24a55",
                                                "sense_id": "3170fa5d-7511-3217-9a9b-a502dba2cc7d",
                                                "text": "— Ох, и постарел же ты, братушка! — сожалеюще сказала Дуняшка. — Серый какой-то стал, как бирюк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b088d4-7e87-3559-820d-fa5a5f7e8e0e",
                                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                                        "glosses": [
                                            "перен. разг. одинокий, нелюдимый, необщительный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c37f368-a315-4d5e-b7e5-8e1e4a6a9b0a",
                                                "sense_id": "14b088d4-7e87-3559-820d-fa5a5f7e8e0e",
                                                "text": "Крылов подумал: сколько живу в столице, а бирюк бирюком, официанта подозвать не умею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a9b9dd-3dcb-3c52-a46a-95d97a90446b",
                                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                                        "glosses": [
                                            "перен. разг. злой, сердитый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cccde5ad-0003-4352-b962-a55ee3fbb9b2",
                                                "sense_id": "e2a9b9dd-3dcb-3c52-a46a-95d97a90446b",
                                                "text": "Да как зыкнет на меня… Истый бирюк в человечьей коже!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
