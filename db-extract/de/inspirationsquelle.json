                        "examples": [
                            {
                                "example_id": "efb6004d-cc60-4087-b8a7-83325649f4e8",
                                "sense_id": "0b3f7ed3-a53a-3a59-95f6-07a7eb76dd1e",
                                "text": "„Sein schriftstellerisches Werk, das er hauptsächlich auf Persisch verfasste, war eine Inspirationsquelle für zahlreiche urdu-sprachige Dichter des 20. Jahrhunderts.“"
                            },
                            {
                                "example_id": "fa6d2fd0-41c9-4d94-9812-1cda91498e61",
                                "sense_id": "0b3f7ed3-a53a-3a59-95f6-07a7eb76dd1e",
                                "text": "„Und dann gab es in Jordanien noch den Islam, der für alle arabischen Länder geheime Inspirationsquelle und quälende Geißel zugleich war.“"
                            }
                        ],
