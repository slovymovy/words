{
    "word": "neoteny",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                "word": "neoteny",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "67a428ab-5b36-439d-8a27-eac7b68818e1",
                        "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                        "tags": [
                            "plural"
                        ],
                        "form": "neotenies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                        "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                        "glosses": [
                            "The retention of juvenile characteristics in the adult."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "271c7c70-231f-45be-b8e3-7f69b8c65e6c",
                                "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                                "text": "Most amphibians are aquatic only while young, but some amphibians with neoteny remain aquatic even as adults."
                            },
                            {
                                "example_id": "62247dca-3983-4475-a5bc-5cd72ca65b22",
                                "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                                "text": "Richard Wrangham has noted that the domestication of animals usually tames them by slowing down components of the developmental timetable to retain juvenile traits into adulthood, a process called pedomorphy or neoteny."
                            }
                        ]
                    },
                    {
                        "sense_id": "6195c557-ee86-3925-bc72-4dc30763b4c4",
                        "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                        "glosses": [
                            "The sexual maturity of an organism still in its larval stage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a512e28-46fb-43a9-9489-8bc4274d34e6",
                        "source_entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                        "source_sense_description": "retention of juvenile characteristics in the adult",
                        "target_lang_word": "néoténie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néoténie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b5e43b6-671b-34f6-9431-1ef45aa3a34c",
                                        "entry_id": "855988b4-753f-38c3-a23f-131a4f38a801",
                                        "glosses": [
                                            "Conservation des caractéristiques juvéniles chez un adulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52650661-98ac-4276-b054-257a3b6b8a64",
                                                "sense_id": "1b5e43b6-671b-34f6-9431-1ef45aa3a34c",
                                                "text": "Le protée anguillard adulte a encore des branchies et une longue queue comme la larve, signes de néoténie."
                                            },
                                            {
                                                "example_id": "ce29adbf-9a6e-4fa1-ae26-1a0e06df4bb9",
                                                "sense_id": "1b5e43b6-671b-34f6-9431-1ef45aa3a34c",
                                                "text": "La raison en est sans doute le vestige de la « prématuration » (ou « néoténie ») du petit d’homme qui fait de lui un être absolument dépendant de son environnement à sa naissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68de091-3951-305d-acfd-419c9321265c",
                                        "entry_id": "855988b4-753f-38c3-a23f-131a4f38a801",
                                        "glosses": [
                                            "À l’inverse, atteinte de la maturité sexuelle par un organisme encore au stade larvaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ca525c-3a43-48d3-a1bc-e37c9cd66178",
                                                "sense_id": "e68de091-3951-305d-acfd-419c9321265c",
                                                "text": "Cette particularité, appelée néoténie, lui permet de vivre dans l’eau, où elle peut respirer à l’aide de branchies externes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
