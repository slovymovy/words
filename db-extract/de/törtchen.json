                            {
                                "example_id": "1e2e44e2-f731-4ed3-b050-77e2a97f7cac",
                                "sense_id": "49c0568b-df2a-3627-b183-5d24953c499d",
                                "text": "„Zu jener Zeit kostete ein Sahnetörtchen fünf Aurar, weshalb jenes Törtchen auch »Fünf-Aurar-Törtchen« genannt wurde.“"
                            },
                            {
                                "example_id": "fb20855c-ac38-4054-8a01-96aca35dfae1",
                                "sense_id": "49c0568b-df2a-3627-b183-5d24953c499d",
                                "text": "„Die Törtchen im Schaufenster waren auf einem Gestell in Form einer Turmrutschbahn angeordnet.“"
                            }
