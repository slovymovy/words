                                        "glosses": [
                                            "Vertreter der Pflanzengattung Heracleum aus der Familie der Doldenblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e957628-0d9d-4456-b1e5-a644733a1f3a",
                                                "sense_id": "9e61e446-78fb-386d-bc26-cf56adc26554",
                                                "text": "Der Saft des Riesen-Bärenklaus kann schwere Verbrennungen hervorrufen."
                                            },
                                            {
                                                "example_id": "a96340a6-e3a1-4651-942a-7c5c87d86c9f",
                                                "sense_id": "9e61e446-78fb-386d-bc26-cf56adc26554",
                                                "text": "Die Bärenklau ist auch für Pferde gefährlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e079ffd3-9558-3b63-a490-c30e0662d83f",
                                        "entry_id": "d3d6fa5e-cc28-3ec6-8020-072ddd95aaad",
                                        "glosses": [
                                            "subtropischer Vertreter der Pflanzengattung Acanthus aus der Familie der Akanthusgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67eb73e-ad11-47b9-bc47-8ff55abcab89",
                                                "sense_id": "e079ffd3-9558-3b63-a490-c30e0662d83f",
                                                "text": "Die Bärenklau kommt hauptsächlich in tropischen bis subtropischen Gebieten vor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
