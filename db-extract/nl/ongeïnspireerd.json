                "senses": [
                    {
                        "sense_id": "afb6ec0d-a590-3702-aa9a-dcd64d4fbf01",
                        "entry_id": "d76d0b5c-b506-3363-ba63-661411b7d50e",
                        "glosses": [
                            "zonder gevoel hoe men iets moet aanpakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adc6459-4d70-4399-8325-81aea6f5465d",
                                "sense_id": "afb6ec0d-a590-3702-aa9a-dcd64d4fbf01",
                                "text": "Ik zocht met mijn ogen de kiezels af, al verwachtte ik geen fossielen te vinden tussen de keien. 'Volgens mij was zijn bezoek zeer geslaagd,'zei ik, en ik was me ervan bewust hoe ongeïnspireerd ik klonk."
                            },
                            {
                                "example_id": "d576fed4-94fe-4475-ae28-de55c09f3965",
                                "sense_id": "afb6ec0d-a590-3702-aa9a-dcd64d4fbf01",
                                "text": "Intussen slaat ene Sergey Proshin een dubbele fout. Ongeïnspireerd. Zich totaal niet bewust van de belangen, zo lijkt het."
                            }
                        ]
                    }
