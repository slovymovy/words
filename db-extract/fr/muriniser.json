                "senses": [
                    {
                        "sense_id": "e5b5969e-07d5-3498-9bcc-5e73183f2865",
                        "entry_id": "2714f7c2-ced2-366e-94ea-3c798e999f4d",
                        "glosses": [
                            "Donner un caractère murin (de souris) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22226307-9652-473e-bfc6-ca47a024cf31",
                                "sense_id": "e5b5969e-07d5-3498-9bcc-5e73183f2865",
                                "text": "Nous avons humanisé les souris, ne faudrait-il pas songer à muriniser les hommes ?"
                            },
                            {
                                "example_id": "d1e3c31a-6380-4928-bfbf-d1f763b7e3b1",
                                "sense_id": "e5b5969e-07d5-3498-9bcc-5e73183f2865",
                                "text": "D’une part, pour maximiser leur validité, il faudrait « muriniser » les humains, c’est-à-dire leur faire effectuer les tâches des rongeurs (…)"
                            },
                            {
                                "example_id": "63959d2a-5884-40ff-9264-43950b86f997",
                                "sense_id": "e5b5969e-07d5-3498-9bcc-5e73183f2865",
                                "text": "Il va certainement devenir de plus en plus important non pas seulement d’affiner les systèmes expérimentaux actuels pour tester la mémoire des souris, mais aussi d’envisager des moyens de “muriniser” les humains pour les études comportementales."
                            }
                        ]
                    }
