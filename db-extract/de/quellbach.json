                "senses": [
                    {
                        "sense_id": "215c14eb-9656-32e4-a759-9b27dc934b38",
                        "entry_id": "b258bdd1-2634-3d7a-837c-551db72788d3",
                        "glosses": [
                            "kleines Fließgewässer, das sich mit einem anderen, etwa gleich starken Fließgewässer zu einem Fluss oder Bach vereinigt, wobei am Zusammenfluss ein Namenswechsel stattfindet"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d4ba9f25-7c08-47f3-9a10-0359cf381ccd",
                                "sense_id": "215c14eb-9656-32e4-a759-9b27dc934b38",
                                "text": "„Bei den Teichquellen liegt der Quellmund am Grund einer mehr oder weniger tiefen Mulde des Quellteiches, über dessen Rand der Quellbach abfließt.“"
                            },
                            {
                                "example_id": "d28a02d5-90e3-4ac2-bf3d-ec9157d0b759",
                                "sense_id": "215c14eb-9656-32e4-a759-9b27dc934b38",
                                "text": "„Durch die Mulde fließt ein Quellbach, ansonsten besteht sie überwiegend aus Trockenboden.“"
                            },
                            {
                                "example_id": "fcfd42aa-06bb-4004-ab33-4ab5bd93a5b3",
                                "sense_id": "215c14eb-9656-32e4-a759-9b27dc934b38",
                                "text": "„Die Formulierung läßt kaum einen anderen Schluß zu, als daß jener Quellbach der Légia gemeint ist, der zwischen der Pfarrkirche Saint-Martin und dem Hof Raick in Ans entspringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
