            {
                "entry_id": "e779428b-e723-32e2-b732-eb04fe23d1e4",
                "word": "MERS",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "43137ea2-6672-3783-bd68-42b4b994a325",
                        "entry_id": "e779428b-e723-32e2-b732-eb04fe23d1e4",
                        "glosses": [
                            "Acronym of Middle East respiratory syndrome."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d933fd50-3b04-4875-b56f-9dc9171c3130",
                                "sense_id": "43137ea2-6672-3783-bd68-42b4b994a325",
                                "text": "Coronaviruses are worrying because epidemics caused by other members of the viral family, SARS and MERS, have had high death rates: 10 percent for SARS, and about 35 percent for MERS."
                            },
                            {
                                "example_id": "03f647af-452c-4bd7-8eb5-9b91e7cee222",
                                "sense_id": "43137ea2-6672-3783-bd68-42b4b994a325",
                                "text": "“Even the researchers themselves point out that this should not cause panic,” said Roess, a professor of global health and epidemiology at George Mason University’s College of Public Health who has worked with international colleagues to better understand the MERS coronavirus."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e0adc7b-4eae-36f1-bb04-bea6429e5827",
                        "entry_id": "e779428b-e723-32e2-b732-eb04fe23d1e4",
                        "glosses": [
                            "Middle East respiratory syndrome coronavirus"
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce8268fb-a8c7-45c3-ac09-6ab422271a3f",
                                "sense_id": "8e0adc7b-4eae-36f1-bb04-bea6429e5827",
                                "text": "Because MERS is a virus, antibiotics are ineffective."
                            },
                            {
                                "example_id": "0666629d-0eb9-4b38-8447-6555f8ace91f",
                                "sense_id": "8e0adc7b-4eae-36f1-bb04-bea6429e5827",
                                "text": "Mers is a virus that is transmitted from animals to humans."
                            },
                            {
                                "example_id": "6dbff0fa-630d-4496-afcf-5ab6e31d394e",
                                "sense_id": "8e0adc7b-4eae-36f1-bb04-bea6429e5827",
                                "text": "MERS is a coronavirus for which there is no cure."
                            }
                        ]
                    }
                ],
