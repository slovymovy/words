                                "target_senses": [
                                    {
                                        "sense_id": "9b6bcd02-cf4b-36f1-a124-7078cbc977d4",
                                        "entry_id": "99f9732e-a574-31bb-b73d-5f9056caaab4",
                                        "glosses": [
                                            "Argentinien oder auch die Argentinier betreffend, aus Argentinien kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c48f0fa-e75b-42d4-bc80-19d18e4f1756",
                                                "sense_id": "9b6bcd02-cf4b-36f1-a124-7078cbc977d4",
                                                "text": "Er ist ein argentinischer Junge."
                                            },
                                            {
                                                "example_id": "1eb72994-75ee-4ec4-9083-e31267c36e4d",
                                                "sense_id": "9b6bcd02-cf4b-36f1-a124-7078cbc977d4",
                                                "text": "Das typisch argentinische Grillen findet mit Vorliebe sonntags und mit Freunden oder der Familie statt."
                                            },
                                            {
                                                "example_id": "d9782217-77b3-4236-9756-11597961d50e",
                                                "sense_id": "9b6bcd02-cf4b-36f1-a124-7078cbc977d4",
                                                "text": "Miguel Angel Asturias entdeckte die magische Welt seines Landes in Europa, und die anekdotisch argentinischsten Bücher von Julio Cortäzar sind die in Paris entstandenen."
                                            },
                                            {
                                                "example_id": "d19a11a8-b118-4452-a05a-eaa94c58a4ab",
                                                "sense_id": "9b6bcd02-cf4b-36f1-a124-7078cbc977d4",
                                                "text": "„Bei mehreren Flügen in den Höhenwinden (Lee-Wellen) über den argentinischen Anden gelang es einer Gruppe von Segelfliegern, mit der Stemme S10VT mehrfach die magische 1 000-Kilometer-Marke zu überwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e2a91ca-9c86-4d14-a131-e73ae21ff893",
                        "source_entry_id": "22b096aa-3d16-3e29-acc2-096058e3e33e",
                        "source_sense_id": "7b58e246-1bf7-3e43-a143-20ad11a160bb",
                        "source_sense_description": "argentinisch",
                        "target_lang_word": "argentin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argentin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caae1b50-9983-378f-b9b6-9ed45e7cb0cd",
                                        "entry_id": "f99a9483-9e35-31c0-9a30-27c4a7f68dc2",
                                        "glosses": [
                                            "Qui a l’éclat et la blancheur de l’argent."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90be78d5-2dc5-46e3-b2bc-349ebaaa7def",
                                                "sense_id": "caae1b50-9983-378f-b9b6-9ed45e7cb0cd",
                                                "text": "Onde, flots argentins."
                                            },
                                            {
                                                "example_id": "df3bfd1d-4b3e-4d16-847a-6fc28dd413f8",
                                                "sense_id": "caae1b50-9983-378f-b9b6-9ed45e7cb0cd",
                                                "text": "Avec de frêles doigts aux ongles argentins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5ea73c-081b-3902-80a2-82c2c70562b8",
                                        "entry_id": "f99a9483-9e35-31c0-9a30-27c4a7f68dc2",
                                        "glosses": [
                                            "Qui rappelle le blanc de l’argent, en parlant d’un ton, d’un effet de couleur."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1869f60e-147f-4f82-b443-44647628310a",
                                                "sense_id": "2f5ea73c-081b-3902-80a2-82c2c70562b8",
                                                "text": "Tu sais ce que c’est que la couleur argentine, n’est-ce pas ? »\nElle hésita.\n« Ou plutôt la couleur gris-perle ?\n— Gris-perle, oui, monsieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d42a9f7-c27e-3e84-8d20-a0b8f90509ff",
                                        "entry_id": "f99a9483-9e35-31c0-9a30-27c4a7f68dc2",
                                        "glosses": [
                                            "Qui a le son clair de l’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed4bc26-6508-49bb-b3e2-9061fefbb3f1",
                                                "sense_id": "1d42a9f7-c27e-3e84-8d20-a0b8f90509ff",
                                                "text": "Charles accourut à sa sœur près du pont, et j’entendis qu’il lui disait d’une voix argentine : — Pourquoi donc que tu n’es pas venue dire adieu à mon bon ami ?"
                                            },
                                            {
                                                "example_id": "5a94f104-7f45-4f68-bd7d-1de2ccb48c4e",
                                                "sense_id": "1d42a9f7-c27e-3e84-8d20-a0b8f90509ff",
                                                "text": "L’innocent paradis, plein de plaisirs furtifs,\nEst-il déjà plus loin que l’Inde et que la Chine ?\nPeut-on le rappeler avec des cris plaintifs,\nEt l’animer encore d’une voix argentine,\nL’innocent paradis plein de plaisirs furtifs ?"
                                            },
                                            {
                                                "example_id": "93c6c2e9-7d14-432d-9bac-ae412ac0d762",
                                                "sense_id": "1d42a9f7-c27e-3e84-8d20-a0b8f90509ff",
                                                "text": "Doña Luz partit d’un éclat de rire argentin dont les notes perlées auraient rendu un rossignol jaloux."
                                            },
                                            {
                                                "example_id": "09b36ef0-68ff-4a6c-b415-c0d19be5f1c7",
                                                "sense_id": "1d42a9f7-c27e-3e84-8d20-a0b8f90509ff",
                                                "text": "La Julie, lui tournant le dos, était en train de traire et, du pis qu’elle pressait en cadence, le lait tombait dans le chaudron de fer battu avec un roulement semi-argentin de tambour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "argentin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                        "entry_id": "0dba2b2a-2c5d-34ed-b841-e036a8ccc5bc",
                                        "glosses": [
                                            "Relatif à l’Argentine (le pays d’Amérique du Sud), sa culture, ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2fc9e55-698b-440c-b538-5d08f6b30580",
                                                "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                                "text": "Savinet. — Quoi… C’est que… Je comprends très bien, la dot … évidemment ! Mais la rendre en ce moment-ci … Moi, quand ma femme m’a apporté ses quatre cent mille francs, je les ai employés en valeurs argentines !…"
                                            },
                                            {
                                                "example_id": "bbfb499c-2349-4c59-993b-c6ad214eb48a",
                                                "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                                "text": "« Les femmes argentines sont entièrement élevées pour se marier et avoir des enfants », affirmait en 1918 la collectionneuse d’art Katherine Dreier, qui s’était rendue à la capitale argentine deux années auparavant."
                                            },
                                            {
                                                "example_id": "fcb5aca5-0e08-4ba1-a72f-e4654989c788",
                                                "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                                "text": "Eduardo Galeano (1940–2015), l’homme qui dut fuir deux dictatures, l’uruguayenne et l’argentine, et qui écrivit ce livre fameux, « Les veines ouvertes de l’Amérique latine », implacable réquisitoire montrant comment l’Espagne, le Portugal et l’Angleterre ont exploité, vampirisée, dévasté son continent natal, et comment de nos jours les États-Unis poursuivent ce pillage en grand… Eduardo Galeano, donc, adorait les textes courts, les contes brefs, les petites histoires, qu’il traquait partout, dans les conversations, l’actualité, les vieux fonds de la légende, de croyances et de sagesse populaire."
                                            },
                                            {
                                                "example_id": "79fa1742-ec84-4784-b75d-903098adb28b",
                                                "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                                "text": "Le déferlement des abricots argentins était inéluctable, on pouvait d’ores et déjà considérer les producteurs d’abricots du Roussillon comme virtuellement morts, il n’en resterait pas un, pas un seul, même pas un survivant pour enterrer les cadavres."
                                            },
                                            {
                                                "example_id": "630c4044-892c-42e5-bc87-962922d31946",
                                                "sense_id": "e578b725-5d13-3ad2-a158-bfa52d755386",
                                                "text": "Le président argentin, Alberto Fernandez, a décrété trois jours de deuil national."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
