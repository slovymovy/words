                "senses": [
                    {
                        "sense_id": "6310f472-63de-3ad0-8131-259fccd4370a",
                        "entry_id": "c26b66f1-8651-3ccc-9420-da9553565041",
                        "glosses": [
                            "Affranchir (un courrier) à l’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51b8d6c-b794-488d-9b64-8ab721ec4dcf",
                                "sense_id": "6310f472-63de-3ad0-8131-259fccd4370a",
                                "text": "Tous sont unanimes : chaque détail est important. Et d'abord la couleur de l'enveloppe, son format, son poids. Faut-il proposer une grille avec plusieurs hypothèses de don ? Avec combien de cases ? Sur quelle échelle ? Faut-il préaffranchir ?"
                            },
                            {
                                "example_id": "cd7fd222-43d1-49c4-a293-2d56f66170f7",
                                "sense_id": "6310f472-63de-3ad0-8131-259fccd4370a",
                                "text": "Préaffranchir la carte et y inscrire une adresse de retour, de préférence au gestionnaire."
                            },
                            {
                                "example_id": "6e0ac3cc-6447-4b68-a3d4-0717601aeef8",
                                "sense_id": "6310f472-63de-3ad0-8131-259fccd4370a",
                                "text": "Elle démontre uniquement avoir recouru au service d'affranchissement de cette institution, qui permet de préaffranchir un envoi recommandé."
                            }
                        ]
                    }
                ],
