                "senses": [
                    {
                        "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                        "entry_id": "6ac2ced4-9166-34cd-813d-35d441fdf3cb",
                        "glosses": [
                            "Spiel, bei dem eine Person ohne Mitspieler agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fac3909-fabc-4279-8c5c-d2d8b865c739",
                                "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                                "text": "„Die Spielstärke im Alleinspiel und Gegenspiel wurde dabei separat ausgewertet.“"
                            },
                            {
                                "example_id": "e14ef71d-7390-4fe4-b2c8-78f86b555106",
                                "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                                "text": "„Am besten wird der Erzieher versuchen, jede Einseitigkeit hinsichtlich der drei Formen Sozialspiel ohne Erwachsene, Sozialspiel mit Erwachsenen und Alleinspiel abzubauen […].“"
                            },
                            {
                                "example_id": "72aace4c-5760-4b43-8067-3fbaa7ce1ef3",
                                "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                                "text": "„Es ist demnach nicht zu verkennen, dass Beides, sowohl die Beschäftigung des Kindes mit sich selbst, das Alleinspielen, als der Umgang mit anderen Kindern, das gemeinschaftliche Spielen, gleich wichtige Vortheile bietet, dass Beides gleich nothwendige Lebensbedürfnisse sind.“"
                            },
                            {
                                "example_id": "53943111-72bf-424b-ad31-b68f43664eab",
                                "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                                "text": "„Ein umsichtiges Alleinspiel macht den Unterschied zwischen einer stolzen Vollspiel- oder gar Schlemmprämie und dem tiefen Graben der Faller aus.“"
                            },
                            {
                                "example_id": "64e58472-463c-4773-ba5e-280e48209e4a",
                                "sense_id": "541aa2ef-b3d6-3b6b-9afb-94e4c058c5fa",
                                "text": "„Angefangen bei den Vorschriften beim Mischen über die Reizung und die Klärungsphase bis hin zum Alleinspiel und den Scores wurden allgemeine Grundsätze erläutert und aufkommende Fragen geklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
