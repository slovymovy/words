                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea52ddd-05e6-483a-95f4-72535b1f537a",
                                "sense_id": "03622999-0fd9-37f8-9ea2-07af11e09218",
                                "text": "„Nachdem er die Tüte mit den Schokoladenbonbons geleert hatte, zog er eine Tüte mit Schokoladenkeksen aus der Tasche und setzte das Spiel bei einem zweiten Glas Bier fort.“"
                            },
                            {
                                "example_id": "975c8c57-d62b-4256-87ac-e9dcdddf8031",
                                "sense_id": "03622999-0fd9-37f8-9ea2-07af11e09218",
                                "text": "„Halbwegs bezahlbar waren nur gefüllte Schokoladenbonbons, aber selbst die gab es lediglich an besonderen Feiertagen.“"
                            }
                        ],
