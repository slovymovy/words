                "senses": [
                    {
                        "sense_id": "3ac8c22c-006d-31af-b839-a92910c7cd1a",
                        "entry_id": "f6618f06-3db4-3b7f-a0b5-02553e96d869",
                        "glosses": [
                            "to become wiser"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4557ffda-dabb-33a7-91bd-36d3fd853dfb",
                        "entry_id": "f6618f06-3db4-3b7f-a0b5-02553e96d869",
                        "glosses": [
                            "to manage to, to contrive to (to succeed in doing something difficult)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4dfd28e0-93fd-4dc3-b769-6f3f7ae6c250",
                                "sense_id": "4557ffda-dabb-33a7-91bd-36d3fd853dfb",
                                "text": "Вот вчера́ я де́вочку спасла́… Она́ умудри́лась позвони́ть мне пря́мо из маши́ны, когда́ полице́йские везли́ её в лес, звони́т и ше́пчет: «Схвати́ли на у́лице, везу́т за го́род. Все пья́ные».",
                                "translation": "Look, yesterday I saved a girl… She managed to call me right from the car while the police were taking her to the forest. She calls me and whispers, \"They grabbed me on the street, they're taking me out of the city. They're all drunk.\"",
                                "english": "Look, yesterday I saved a girl… She managed to call me right from the car while the police were taking her to the forest. She calls me and whispers, \"They grabbed me on the street, they're taking me out of the city. They're all drunk.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f2a20970-5680-388e-a6e9-11e4c324cc01",
                        "entry_id": "f6618f06-3db4-3b7f-a0b5-02553e96d869",
                        "glosses": [
                            "to manage to (to do something that could easily have been avoided)"
                        ],
                        "tags": [
                            "colloquial",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "262dd805-76fa-4b5c-9993-9e1428685029",
                                "sense_id": "f2a20970-5680-388e-a6e9-11e4c324cc01",
                                "text": "Но Сребрина Талева умудри́лась слома́ть бедро́ за день до вы́садки.",
                                "translation": "But Srebrina Taleva had managed to break her thigh the day before landing.",
                                "english": "But Srebrina Taleva had managed to break her thigh the day before landing."
                            }
                        ]
                    },
