                "senses": [
                    {
                        "sense_id": "76db562e-a8cb-3a9b-b137-3678cf13838b",
                        "entry_id": "c51fbf4c-5377-3426-9454-30b8369e1a39",
                        "glosses": [
                            "godzina 4 w nocy lub po południu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33387b7f-4403-41c1-b7d0-01c35635638a",
                                "sense_id": "76db562e-a8cb-3a9b-b137-3678cf13838b",
                                "text": "Zjadł obiad mięsny, wypił później w cukierni filiżankę kawy czarnej z likierem, około godziny czwartej znowu się posilił i już o szóstej był na dworcu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d7d7515-0f4b-43e9-98f3-4e5e9284a987",
                        "source_entry_id": "c51fbf4c-5377-3426-9454-30b8369e1a39",
                        "source_sense_id": "76db562e-a8cb-3a9b-b137-3678cf13838b",
                        "target_lang_word": "four",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "four",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd82acfa-a5ee-3c14-bb3b-4db05dd24a32",
                                        "entry_id": "4071b9d9-68cc-3628-8d6c-0b4737a0ba95",
                                        "glosses": [
                                            "A numerical value equal to 4; the number after three and before five; two plus two. This many dots (••••)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4029ae68-b2e0-44db-8dff-b48b20b11132",
                                                "sense_id": "bd82acfa-a5ee-3c14-bb3b-4db05dd24a32",
                                                "text": "There are four seasons: spring, summer, autumn and winter."
                                            },
                                            {
                                                "example_id": "b6eb5bb0-5d57-48cf-824f-8d7f5f978db4",
                                                "sense_id": "bd82acfa-a5ee-3c14-bb3b-4db05dd24a32",
                                                "text": "Venters began to count them—one—two—three—four—on up to sixteen."
                                            },
                                            {
                                                "example_id": "89c20cbc-0c6c-4875-88da-6f43c74a13ff",
                                                "sense_id": "bd82acfa-a5ee-3c14-bb3b-4db05dd24a32",
                                                "text": "Redding’s study asked four psychologists with expertise in anxiety and depressive disorders to rate each self-help book on five criteria: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75acb7b7-4910-3d0e-8e25-b9af95a308d6",
                                        "entry_id": "4071b9d9-68cc-3628-8d6c-0b4737a0ba95",
                                        "glosses": [
                                            "Describing a set or group with four elements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "four",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5f2a1a-4e4f-3428-91af-86a06366ead1",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "The digit or figure 4; an occurrence thereof."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbeb5ba2-e535-353c-b5e7-099b05390b3e",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "Anything measuring four units, as length."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef4969e-aada-4083-a86a-e991ac27442d",
                                                "sense_id": "dbeb5ba2-e535-353c-b5e7-099b05390b3e",
                                                "text": "Do you have any more fours? I want to make this a little taller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d6e9791-0660-3040-bae5-e283459e6dc1",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "Four o'clock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aef2d86-af40-4556-b5f9-3231f3da9195",
                                                "sense_id": "4d6e9791-0660-3040-bae5-e283459e6dc1",
                                                "text": "Letters to Sheffield are despatched every morning at six, and arrive every afternoon at ten minutes past four."
                                            },
                                            {
                                                "example_id": "d5d7948a-d7b9-4d5d-8234-7cd8f078048f",
                                                "sense_id": "4d6e9791-0660-3040-bae5-e283459e6dc1",
                                                "text": "Frederick, I presume, at this late hour of four, may be snatching a morsel of dinner; […]"
                                            },
                                            {
                                                "example_id": "07ff29b0-bac0-4b21-92eb-dab7ae2854d2",
                                                "sense_id": "4d6e9791-0660-3040-bae5-e283459e6dc1",
                                                "text": "The larger ships picked up the low lying atoll on their radar about four in the morning at distances from 16 to 26 miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbabc1d7-70d1-3e66-b576-e84331eee885",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "A person who is four years old."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e974d62a-51a6-470b-a031-20aa8fc4b1ae",
                                                "sense_id": "cbabc1d7-70d1-3e66-b576-e84331eee885",
                                                "text": "I'll take the threes, fours and fives and go to the playground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc1419f-f2ec-3c83-be4e-f38fda2dbdbf",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "An event in which the batsmen run four times between the wickets or, more often, a batsman hits a ball which bounces on the ground before passing over a boundary, resulting in an award of 4 runs for the batting team. If the ball does not bounce before passing over the boundary, a six is awarded instead."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f97941b3-889f-362b-a3b1-b68295c3498e",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "A power forward."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45c1e09-5425-3e10-be90-5702ef685843",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "Four-man sweep racing shell, with or without a coxswain.",
                                            "The shell itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54624082-0e11-44b8-af14-198e787e219c",
                                                "sense_id": "c45c1e09-5425-3e10-be90-5702ef685843",
                                                "text": "The team bought a new four last season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d957880d-b4fe-30f8-86e8-6ece09af19da",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "Four-man sweep racing shell, with or without a coxswain.",
                                            "The crew rowing in a four boat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938b4e3e-b3d8-4b34-aa97-ac9a441c19e3",
                                                "sense_id": "d957880d-b4fe-30f8-86e8-6ece09af19da",
                                                "text": "Our four won both races."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05778ec-325e-3ea8-80ff-e3f81bc42afe",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "Four-man sweep racing shell, with or without a coxswain.",
                                            "A regatta event for four boats."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1e157e-1725-40ac-9545-c8ca004bd9d2",
                                                "sense_id": "e05778ec-325e-3ea8-80ff-e3f81bc42afe",
                                                "text": "We got third place in the varsity four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c62fa03f-c169-3e65-ab54-bf454aef31f9",
                                        "entry_id": "92e863b3-5319-3dbd-90ed-c9d70bab6e70",
                                        "glosses": [
                                            "A four-pennyworth of spirits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826c5139-93f1-4829-9771-8f1cfbcd01bd",
                                                "sense_id": "c62fa03f-c169-3e65-ab54-bf454aef31f9",
                                                "text": "I was a-strollin' down, thinkin' between ourselves how uncommon handy a four of gin hot would be, when suddenly the glint of a light caught my eye in the window of that same house."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96a6ba94-efb2-40e5-ac27-2c11d2bbbb42",
                        "source_entry_id": "c51fbf4c-5377-3426-9454-30b8369e1a39",
                        "source_sense_id": "76db562e-a8cb-3a9b-b137-3678cf13838b",
                        "target_lang_word": "o'clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "o'clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "In conjunction with a numeral, indicates the time within a twelve-hour period (midnight to noon or noon to midnight), specifically the time when the hour hand of a clock points precisely to the symbol or marking corresponding to the designated numeral, i.e., at the hour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3036e6b-bbc9-47a6-bb3f-01ea23e64a1d",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "We are expected to be there at six o'clock in the morning!"
                                            },
                                            {
                                                "example_id": "3748c75a-5f08-4f1e-af16-4548a0188b3e",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "It is two o'clock."
                                            },
                                            {
                                                "example_id": "e56858d2-53cd-4e56-ab66-1cdd50420023",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "What o'clock is it?"
                                            },
                                            {
                                                "example_id": "4afbf226-a50a-4f2b-a94a-f150a005f22e",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "I say, Watson, what o'clock is it?"
                                            },
                                            {
                                                "example_id": "457515ae-0d4c-4f91-b73c-9c02fba31090",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            },
                                            {
                                                "example_id": "91493ca0-d54e-4f41-b799-92e2d5678afa",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "Shortly before five o'clock in the afternoon of Thursday, April 12, 1945, after the Senate adjourned, I went to the office of House Speaker Sam Rayburn. I went there to get an agreement between the Speaker and the Vice-President on certain legislation and to discuss the domestic and world situation generally. As I entered, the Speaker told me that Steve Early, the President's press secretary, had just telephoned, requesting me to call the White House."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "Used to indicate that it is time to do a specific action, or time for a specific action to occur."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179d4602-2fb7-4105-8932-5ada8a761172",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "I'm feeling peckish; I think it must be nearly dinner o'clock."
                                            },
                                            {
                                                "example_id": "e1cd6770-3ced-41b8-b0b9-aa22dec27395",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "We're here at Waffle House, and it's waffles o'clock!",
                                                "translation": "We're here at Waffle House, and it's time to eat waffles.",
                                                "english": "We're here at Waffle House, and it's time to eat waffles."
                                            },
                                            {
                                                "example_id": "1551bc29-c59e-4c19-b772-882434c9446c",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "Hooray! Beer o'clock!"
                                            },
                                            {
                                                "example_id": "36361d5a-3a52-40e5-8968-4536af0eada6",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "That same evening at tea-time — (I am sorry to have to introduce you to another eating-scene, but the hours in English households are usually marked by repasts. It is a daily calendar of feasts — breakfast o’clock, dinner o’clock, &c.,[…])."
                                            },
                                            {
                                                "example_id": "62d9287b-304e-48d3-99ff-f5a889c8c396",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "“My sister requires your attendance at supper o’clock this evening — no excuse accepted.”"
                                            },
                                            {
                                                "example_id": "05d77c9c-a9ae-4880-b709-bbb9de8910b6",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "“It's lunch o’clock. Wanna go out to eat?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "In conjunction with a numeral, indicates the direction, relative to the speaker or a vehicle, especially an aircraft, corresponding to the direction the hour hand is pointing at the time corresponding to the numeral, with twelve representing directly ahead on a horizontal plane, or directly up on a vertical plane, and three being to the right on either."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "with-numeral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbbe401d-97f7-460c-a435-f306850d98c7",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "It's at nine o'clock about two feet in from the edge of the branch. You need to know your \"o'clocks\" (nondigital) to spot birds."
                                            },
                                            {
                                                "example_id": "ac0d2399-0839-44a2-b96c-3fcbfc426c20",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Without moving your head, move your gaze upward to look at twelve o’clock. Now look down at six o’clock. Repeat three times, then blink several times, and rest with your eyes closed."
                                            },
                                            {
                                                "example_id": "92466fb1-b617-4ab8-b9de-9589d199a03c",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Thus, you could tell them to \"look at three o'clock,\" or \"look just off-center toward nine o'clock,\" and so forth. Alternatively, in some microscopes a thin black line appears to cut across the field of view"
                                            },
                                            {
                                                "example_id": "fc01a88f-892d-49f3-b189-77cb6f37d91f",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Three o'clock and nine o'clock would be at the outer right and outer left sides of the tree, respectively, and so on. The clock technique is a very helpful way for one bird watcher to direct others to a hard-to-spot perched bird."
                                            },
                                            {
                                                "example_id": "06b047d7-8631-4804-84dc-48b00d89910b",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "At 1057 we were just over the islands and at 1100 the tail gunner reported flak at six o’clock, below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
