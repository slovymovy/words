                                        "sense_id": "a443e64d-4ec9-3593-ba31-3812291f4e17",
                                        "entry_id": "7a79926a-7cd6-34a0-a280-4f0c99c4522a",
                                        "glosses": [
                                            "зоол. одногорбый одомашненный верблюд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786d2091-a1af-4451-b358-8ef70b03b048",
                                                "sense_id": "a443e64d-4ec9-3593-ba31-3812291f4e17",
                                                "text": "― Дромадеры чрезвычайно прытки, и почти всегда уходят от лошадей своих преследователей."
                                            },
                                            {
                                                "example_id": "bfb9f421-0618-4dbc-9f7b-c669192562ee",
                                                "sense_id": "a443e64d-4ec9-3593-ba31-3812291f4e17",
                                                "text": "Бедуины помогли Маше сесть на того же белого дромадера, на котором она в начале ночи проделала путь через пустыню, чтобы встретиться со Святым Старцем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ad335f1-991d-4651-98f4-fc3aac892ea2",
                        "source_entry_id": "b237f7a7-1efa-3a40-9373-0ca1ca35ec42",
                        "source_sense_description": "single-humped camel",
                        "target_lang_word": "дромеда́р",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
