                                "target_senses": [
                                    {
                                        "sense_id": "4c97e359-9058-3ec7-9afc-1d6dad5e8275",
                                        "entry_id": "b5a43f10-f302-3ee1-8f94-419f6890cdbc",
                                        "glosses": [
                                            "To make threats against (someone); to intimidate."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c38de7-8829-4dac-a623-87d2d8a3d696",
                                                "sense_id": "4c97e359-9058-3ec7-9afc-1d6dad5e8275",
                                                "text": "to menace a country with war"
                                            },
                                            {
                                                "example_id": "9e56165d-5037-4810-b355-324bf5114bf0",
                                                "sense_id": "4c97e359-9058-3ec7-9afc-1d6dad5e8275",
                                                "text": "My master […] did menace me with death."
                                            },
                                            {
                                                "example_id": "af2d9b4a-74cb-470b-912d-b19b104679b0",
                                                "sense_id": "4c97e359-9058-3ec7-9afc-1d6dad5e8275",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0729dde7-3894-37f2-8016-99ec3b060b65",
                                        "entry_id": "b5a43f10-f302-3ee1-8f94-419f6890cdbc",
                                        "glosses": [
                                            "To threaten (an evil to be inflicted)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4c88e3-b446-41a2-a257-cde261a292ab",
                                                "sense_id": "0729dde7-3894-37f2-8016-99ec3b060b65",
                                                "text": "Upon his browes was pourtraid vgly death,\nAnd in his eies the furies of his heart,\nThat ſhine as Comets, menacing reueng,\nAnd caſts a pale complexion on his cheeks."
                                            },
                                            {
                                                "example_id": "8e125424-b5a1-48b8-baaf-eb299ca2b60f",
                                                "sense_id": "0729dde7-3894-37f2-8016-99ec3b060b65",
                                                "text": "By oath he menaced / Revenge upon the cardinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f1770a-4111-357a-af6b-9426f1560a9b",
                                        "entry_id": "b5a43f10-f302-3ee1-8f94-419f6890cdbc",
                                        "glosses": [
                                            "To endanger (someone or something); to imperil or jeopardize."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
