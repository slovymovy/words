{
    "word_family": [
        "eventual",
        "eventuality"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                    "sense_definition": "In the end, especially after a long time, a series of problems, or delays.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After many hours of searching, we <w>eventually</w> found the lost keys in the car.",
                            "target_lang_translations": {
                                "ru": "После многих часов поиска мы <w>в конце концов</w> нашли потерянные ключи в машине."
                            }
                        },
                        {
                            "text": "He hopes <w>eventually</w> to attend nursing school once he saves enough money.",
                            "target_lang_translations": {
                                "ru": "Он надеется <w>со временем</w> пойти в школу медсестер, как только накопит достаточно денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "finally",
                        "ultimately",
                        "in the end",
                        "at last",
                        "sooner or later"
                    ],
                    "antonyms": [
                        "immediately",
                        "promptly",
                        "soon"
                    ],
                    "common_phrases": [
                        "eventually to attend",
                        "will happen eventually",
                        "eventually found"
                    ],
                    "target_lang_definitions": {
                        "ru": "В конце концов, особенно после долгого времени, ряда проблем или задержек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "после долгих усилий или ожидания"
                            },
                            {
                                "target_lang_word": "со временем",
                                "target_lang_sense_clarification": "через неопределенный период времени"
                            },
                            {
                                "target_lang_word": "в итоге",
                                "target_lang_sense_clarification": "как результат последовательности событий"
                            },
                            {
                                "target_lang_word": "в конечном счёте",
                                "target_lang_sense_clarification": "в завершение процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6f712c4-5f89-3e0f-8ad8-1cc8663c8a10",
                    "sense_definition": "For all terms in a sequence beyond a certain point; with only a finite number of exceptions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this mathematical sequence, <w>eventually</w> all prime numbers are odd.",
                            "target_lang_translations": {
                                "ru": "В этой математической последовательности <w>в конечном счёте</w> все простые числа становятся нечётными."
                            }
                        },
                        {
                            "text": "The function <w>eventually</w> becomes constant as the input value increases toward infinity.",
                            "target_lang_translations": {
                                "ru": "Функция <w>начиная с некоторого момента</w> становится постоянной по мере стремления входного значения к бесконечности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Для всех членов последовательности, начиная с определенного момента; за исключением конечного числа случаев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в конечном счёте",
                                "target_lang_sense_clarification": "в математическом контексте последовательностей"
                            },
                            {
                                "target_lang_word": "начиная с некоторого момента",
                                "target_lang_sense_clarification": "для всех последующих значений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60c47485-a5f1-34bd-9692-f6df8b9a75e3",
                    "sense_definition": "Used to express that something is possible or might happen; potentially.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will come <w>eventually</w>, but I haven't decided yet if it is possible.",
                            "target_lang_translations": {
                                "ru": "Я, <w>возможно</w>, приду, но я еще не решил, получится ли это."
                            }
                        },
                        {
                            "text": "The project could <w>eventually</w> succeed if the right conditions are met.",
                            "target_lang_translations": {
                                "ru": "Проект <w>потенциально</w> мог бы увенчаться успехом при соблюдении правильных условий."
                            }
                        }
                    ],
                    "synonyms": [
                        "yet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rare in modern English and often considered a false friend in other languages."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения того, что что-то возможно или может произойти; потенциально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "выражение потенциальной возможности"
                            },
                            {
                                "target_lang_word": "потенциально",
                                "target_lang_sense_clarification": "при определенных условиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}