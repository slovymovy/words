                "senses": [
                    {
                        "sense_id": "90f10f0b-d6d0-32ad-922c-a3e9b1dcbf65",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "A statement made on oath by a jury."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c7eb3063-0d3b-4851-8d36-88aeab4fcd53",
                                "sense_id": "90f10f0b-d6d0-32ad-922c-a3e9b1dcbf65",
                                "text": "In 1771, a grand jury presentment in Georgia revealed that \"Slaves are permitted to rent houses ….\""
                            }
                        ]
                    },
                    {
                        "sense_id": "21f5a8c6-a2fe-3657-a5f7-57249fbc9309",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "The notice taken by a grand jury of any offence from their own knowledge or observation, without any bill of indictment laid before them."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c4ae402-898c-4b79-941c-28813ca24fbb",
                                "sense_id": "21f5a8c6-a2fe-3657-a5f7-57249fbc9309",
                                "text": "the presentment of a nuisance, a libel, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "cca67427-7a6b-3f1b-980b-0a5a39e95cc0",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "A formal complaint submitted to a bishop or archdeacon."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "faedeb2a-1d9a-4656-8af1-948c84f1f5ae",
                                "sense_id": "cca67427-7a6b-3f1b-980b-0a5a39e95cc0",
                                "text": "He recognised that there was general resentment of the oppressive conduct of the Forest officers, and made provision for regular inquiries into it, and for presentment of Forest offences to be made at the attachment courts, as a procedure preliminary to the Forest Eyre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1be59792-e973-324d-8931-7a1e4fb0ecbe",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "The act of presenting something for acceptance; now specifically, presenting something (e.g. a bill or cheque) for payment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a96d1eda-b63d-4030-af98-67f4d44d7710",
                                "sense_id": "1be59792-e973-324d-8931-7a1e4fb0ecbe",
                                "text": "When online bill presentment, which removes all the paperwork, becomes widespread, says McKinsey's Stephenson, online banking will be far more compelling."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f15e599-8740-343b-a473-05ffed034e7c",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "An artistic representation; a picture."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c4145232-5f11-4ee5-a62f-18874000dab3",
                                "sense_id": "6f15e599-8740-343b-a473-05ffed034e7c",
                                "text": "Noted among the who's-who in portraiture: Hopkinson's Secretary Hughes, Childe Hassam's Governor Alfred E. Smith, of New York, Edmund C. Tarbell's Mary at the Harpsichord, Lillian Westcott Hale's child portrait study of Brothers, Frank Benson's Girl in Blue Jacket, and Marion Boyd Allen's presentment of Anna Vaughn Hyatt."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9a3e597-6a64-3599-8b8b-ca2f21981ac7",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "Presentation of a performance, as of a play or work of music."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9ceffb82-102a-31a4-ac10-0675a0ad9a27",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "The aspect or form in which something presents itself; appearance."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8488df11-926e-4f5f-ba1b-3b0aa3c8a8f3",
                                "sense_id": "9ceffb82-102a-31a4-ac10-0675a0ad9a27",
                                "text": "But it was especially the aspect of the three chief officers of the ship, the mates, which was most forcibly calculated to allay these colourless misgivings, and induce confidence and cheerfulness in every presentment of the voyage."
                            }
                        ]
                    },
                    {
                        "sense_id": "2255c0df-a00c-3cdc-a39a-5a0d1d16feef",
                        "entry_id": "5660235a-1801-3a9e-87fc-41349b6c44bf",
                        "glosses": [
                            "The official notice (formerly required to be given in court) of the surrender of a copyhold estate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "86916682-5aef-4f6f-9808-bc602546526b",
                                "sense_id": "2255c0df-a00c-3cdc-a39a-5a0d1d16feef",
                                "text": "As to the presentment: that, by the general custom of manors, is to be made at the next court baron immediately after the surrender"
                            }
                        ]
                    }
