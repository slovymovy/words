                "senses": [
                    {
                        "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                        "entry_id": "46179f52-df35-3d56-a42e-544e36d81cfa",
                        "glosses": [
                            "Faire cesser d’être un boulet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f24f64f-9625-4ff4-882e-469e14a2e1ec",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "Est-ce que tu penses déboulettiser Carlitomer et thomas22?"
                            },
                            {
                                "example_id": "a6250039-93dc-40f5-89fd-68c1eef0df16",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "Objectif : déboulettiser un des deux."
                            },
                            {
                                "example_id": "8b718f18-5d6b-48e5-a041-6f052ea5185b",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "Pour ma part, 3 coureurs rentable, encore 4 coureurs de seconde zone à déboulettiser."
                            },
                            {
                                "example_id": "846caf68-1887-4e47-91d7-5e8dfbda4e00",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "Une bien belle équipe sur papier, j'espère que mon :elephant: va se déboulettiser pour m'éviter la honte du siècle (je rappelle le transfert juste avant les ardennaises, ayant remplacé Boonen par Touriste...)"
                            },
                            {
                                "example_id": "2bd48eba-ccff-43e5-b6df-0febbb97621f",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "KANKOVSKY (ici ou en Roumanie) et KULIKOVSKIY (ce serait une belle occasion pour notre russe de se déboulettiser...)"
                            },
                            {
                                "example_id": "31b15266-84dd-4611-bb14-9ca8eb221eeb",
                                "sense_id": "827481e4-0acd-3cdf-9a33-3ba5088508bf",
                                "text": "Allez, plus que le Guangxi à tenir, sauf que c'est typiquement le genre d'épreuves où un coureur pourrait se déboulettiser..."
                            }
                        ]
                    }
