                ],
                "senses": [
                    {
                        "sense_id": "f729b413-0112-3888-ad53-ca7dbf7f846d",
                        "entry_id": "056e325c-ace6-3ff6-adca-e87745048d10",
                        "glosses": [
                            "eine der drei Sprachfunktionen in Karl Bühlers Organon-Modell der Sprache, die darin besteht, dass man beim Sprechen/Schreiben – gewollt oder nicht – etwas über sich selbst preisgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77728c09-03ed-4882-bf96-7f9176eb6fce",
                                "sense_id": "f729b413-0112-3888-ad53-ca7dbf7f846d",
                                "text": "„Die Symptomfunktion der Sprache, die als Teil einer pragmatisch verstandenen Kommunikationsfunktion zu sehen ist, hier aber aus analytischen Gründen isoliert werden soll, besteht darin, daß sich jeder Sprecher als Individuum und als Angehöriger einer sozialen Schicht oder Gruppe von andern Individuen beziehungsweise Angehörigen anderer Schichten oder Gruppen sprachlich unterscheidet.“"
                            },
                            {
                                "example_id": "77d9f446-e538-41d7-9f53-a76ec0d2bcc6",
                                "sense_id": "f729b413-0112-3888-ad53-ca7dbf7f846d",
                                "text": "„Die Symptomfunktion und die Kommunikationsfunktion überhaupt sind an konnotative Inhaltsmerkmale gebunden, darunter auch an die Zugehörigkeit zu dialektalen und situativen Varietäten.“"
                            },
                            {
                                "example_id": "4d65f6b7-df46-4642-ab13-ce99642c8258",
                                "sense_id": "f729b413-0112-3888-ad53-ca7dbf7f846d",
                                "text": "„Die Beispiele machen deutlich: Empörend übernimmt im Sprachgebrauch zunächst einmal eine Symptomfunktion (will sagen: es ist Anzeichen) für eine emotionale Einstellung.“"
                            },
                            {
                                "example_id": "e9bc9e76-af12-4687-af60-16ab816580cf",
                                "sense_id": "f729b413-0112-3888-ad53-ca7dbf7f846d",
                                "text": "„Versuchen Sie, dies v.a. vor dem Hintergrund der Begriffe Symbol-, Appell- und Symptomfunktion (Bühler 1965) zu leisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
