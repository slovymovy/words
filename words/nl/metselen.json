                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay bricks",
                                "target_lang_sense_clarification": "the act of building a wall with bricks and mortar"
                            },
                            {
                                "target_lang_word": "bricklay",
                                "target_lang_sense_clarification": "the professional activity of building with bricks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb1f2494-a7db-3747-a8f6-95eb8757c3b9",
