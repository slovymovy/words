                        "sense_id": "d051c2a7-0d82-343a-8950-293fdfa182a6",
                        "entry_id": "b393dbf6-3862-3c67-8daa-e9d8f2994225",
                        "glosses": [
                            "Qualifie les colonnes à base simple et au fût lisse et dont le chapiteau comprend neuf feuilles de palmier ligaturées de l'Égypte antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb858eac-02ab-4388-9647-9f54098926a9",
                                "sense_id": "d051c2a7-0d82-343a-8950-293fdfa182a6",
                                "text": "Elles se composent d’un portique et de colonnes, dont le type palmiforme se distingue tout à coup dès qu’on les aperçoit du Nil."
                            },
                            {
                                "example_id": "b31ce955-a0a0-4e5b-8e0d-05933d41e50d",
                                "sense_id": "d051c2a7-0d82-343a-8950-293fdfa182a6",
                                "text": "Cette statuette cariatide surmontée d’un chapiteau palmiforme est, à notre connaissance, unique en son genre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e260ce-41cc-39ef-8781-9e343f8ffa84",
                        "entry_id": "b393dbf6-3862-3c67-8daa-e9d8f2994225",
                        "glosses": [
                            "Qui a la forme d’un palmier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebdc1ae-76e6-4ca1-afdd-f95c5961dece",
                                "sense_id": "c5e260ce-41cc-39ef-8781-9e343f8ffa84",
                                "text": "Tandis qu’ils atteignent au plus quelques pouces d’élévation, la catharinée arborescente de Chili dépasse de 1 à 1 1/2 pied, et son port palmiforme frappe véritablement le regard d’une manière surprenante."
                            },
                            {
                                "example_id": "01ee3bb8-1879-43bb-bdc4-5fb7708b7e2c",
                                "sense_id": "c5e260ce-41cc-39ef-8781-9e343f8ffa84",
                                "text": "PALMIFORME, adj., palmiformis (palma, palme, forma, forme). Se dit, d’après Candolle, des feuilles qui sont disposées de manière à imiter les feuilles palmées. Ex. Chamærops humilis."
                            },
                            {
                                "example_id": "4623b652-57fa-4835-99ed-aaf65f765096",
                                "sense_id": "c5e260ce-41cc-39ef-8781-9e343f8ffa84",
                                "text": "Le Wettinia de Pœppig, plante palmiforme , dont la structure florale, également anormale, vient toutefois compliquer la structure florale également anormale, vient toutefois compliquer la question."
                            }
                        ]
                    }
