{
    "word_family": [
        "reflection",
        "reflective",
        "reflector"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef2b30e9-02cc-3449-96c9-40b01ff5c8cd",
                    "sense_definition": "To throw back light, heat, sound, or an image from a surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The white snow <w>reflected</w> the bright sunlight into our eyes.",
                            "target_lang_translations": {
                                "ru": "Белый снег <w>отражал</w> яркий солнечный свет нам в глаза.",
                                "zh": "白雪将明亮的阳光<w>反射</w>进我们的眼睛里。"
                            }
                        },
                        {
                            "text": "She looked into the calm water and saw her face <w>reflected</w> there.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела в спокойную воду и увидела, что её лицо <w>отражается</w> там.",
                                "zh": "她看向平静的水面，看见自己的脸<w>倒映</w>在其中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mirror",
                        "throw back",
                        "return",
                        "echo"
                    ],
                    "antonyms": [
                        "absorb"
                    ],
                    "common_phrases": [
                        "reflect light",
                        "reflect heat",
                        "reflect sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отбрасывать свет, тепло, звук или изображение от поверхности.",
                        "zh": "指光线、热量、声音或影像从物体表面反射回来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "свет, звук или тепло"
                            },
                            {
                                "target_lang_word": "отражаться",
                                "target_lang_sense_clarification": "быть видным на поверхности (об изображении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反射",
                                "target_lang_sense_clarification": "指光、声、热等从表面弹回"
                            },
                            {
                                "target_lang_word": "倒映",
                                "target_lang_sense_clarification": "指影像在水面或镜面中呈现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a70fced6-7800-35fd-a092-7779bfd50a32",
                    "sense_definition": "To show, express, or be a sign of a particular situation, quality, or feeling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high test scores <w>reflect</w> the students' hard work and dedication.",
                            "target_lang_translations": {
                                "ru": "Высокие результаты тестов <w>отражают</w> усердную работу и самоотдачу студентов.",
                                "zh": "高分<w>反映</w>了学生们的努力和付出。"
                            }
                        },
                        {
                            "text": "His angry comments did not <w>reflect</w> his true feelings about the matter.",
                            "target_lang_translations": {
                                "ru": "Его гневные комментарии не <w>отражали</w> его истинных чувств по этому вопросу.",
                                "zh": "他愤怒的评论并不能<w>反映</w>他对此事的真实感受。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indicate",
                        "demonstrate",
                        "show",
                        "reveal",
                        "display"
                    ],
                    "antonyms": [
                        "hide",
                        "conceal",
                        "mask"
                    ],
                    "common_phrases": [
                        "reflect the reality",
                        "reflect the truth",
                        "reflect well on",
                        "reflect badly on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать, выражать или служить признаком определенной ситуации, качества или чувства.",
                        "zh": "表现、表达或作为某种情况、品质或情感的迹象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "показывать или выражать"
                            },
                            {
                                "target_lang_word": "отображать",
                                "target_lang_sense_clarification": "воспроизводить действительность"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "быть признаком чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反映",
                                "target_lang_sense_clarification": "表现出客观事物的本质或情况"
                            },
                            {
                                "target_lang_word": "体现",
                                "target_lang_sense_clarification": "某种性质或现象在具体事物中表现出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5e248a9-de99-36e9-b773-da3b91965762",
                    "sense_definition": "To think deeply or carefully about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needed some quiet time to <w>reflect</w> on his decision before acting.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было немного побыть в тишине, чтобы <w>обдумать</w> своё решение, прежде чем действовать.",
                                "zh": "在采取行动之前，他需要一些安静的时间来<w>反思</w>他的决定。"
                            }
                        },
                        {
                            "text": "She sat by the window to <w>reflect</w> upon the events of the past year.",
                            "target_lang_translations": {
                                "ru": "Она села у окна, чтобы <w>поразмышлять</w> о событиях прошедшего года.",
                                "zh": "她坐在窗边，<w>沉思</w>着过去一年里发生的事情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contemplate",
                        "ponder",
                        "consider",
                        "meditate"
                    ],
                    "antonyms": [
                        "ignore",
                        "disregard"
                    ],
                    "common_phrases": [
                        "reflect on",
                        "reflect upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко или тщательно обдумывать что-либо.",
                        "zh": "对某事进行深入或仔细的思考。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "думать глубоко, созерцать"
                            },
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "тщательно взвешивать решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反思",
                                "target_lang_sense_clarification": "回顾并深入思考过去的经历或行为"
                            },
                            {
                                "target_lang_word": "深思",
                                "target_lang_sense_clarification": "深入地思考"
                            },
                            {
                                "target_lang_word": "沉思",
                                "target_lang_sense_clarification": "静静地深入思考"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}