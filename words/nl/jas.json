            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b09f9802-b653-3a3f-94c2-57838b30cc0a",
                    "sense_definition": "Een kledingstuk dat buiten over andere kleding wordt gedragen om het bovenlichaam te bedekken en warm te houden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_coat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om je <w>jas</w> aan te trekken als je naar buiten gaat.",
                            "target_lang_translations": {
                                "en": "Don't forget to put on your <w>coat</w> when you go outside.",
                                "ru": "Не забудь надеть <w>куртку</w>, когда пойдешь на улицу.",
                                "zh": "出门时别忘了穿上你的<w>外套</w>。",
                                "pl": "Nie zapomnij założyć <w>płaszcza</w>, kiedy wychodzisz na zewnątrz."
                            }
                        },
                        {
                            "text": "Hij kocht een nieuwe warme <w>jas</w> voor de winter.",
                            "target_lang_translations": {
                                "en": "He bought a new warm <w>coat</w> for the winter.",
                                "ru": "Он купил новую теплую <w>куртку</w> на зиму.",
                                "zh": "他买了一件新的保暖<w>大衣</w>过冬。",
                                "pl": "Kupił nową, ciepłą <w>kurtkę</w> na zimę."
                            }
                        }
                    ],
                    "synonyms": [
                        "mantel"
                    ],
                    "common_phrases": [
                        "jas aan",
                        "jas uit",
                        "dikke jas",
                        "nieuwe jas"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of clothing worn outside over other clothes to cover the upper body and keep warm.",
                        "ru": "Предмет одежды, который носят на улице поверх другой одежды, чтобы закрыть верхнюю часть тела и сохранить тепло.",
                        "zh": "一种穿在外面以覆盖上半身并保暖的服装。",
                        "pl": "Część garderoby noszona na zewnątrz na innych ubraniach, aby zakryć górną część ciała i zapewnić ciepło."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coat",
                                "target_lang_sense_clarification": "outer garment"
                            },
                            {
                                "target_lang_word": "jacket",
                                "target_lang_sense_clarification": "shorter outer garment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "куртка",
                                "target_lang_sense_clarification": "короткая верхняя одежда"
                            },
                            {
                                "target_lang_word": "пальто",
                                "target_lang_sense_clarification": "длинная верхняя одежда"
                            },
                            {
                                "target_lang_word": "верхняя одежда",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
