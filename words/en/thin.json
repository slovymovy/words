                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hit the ball <w>thin</w> and it flew much further than he intended.",
                            "target_lang_translations": {
                                "ru": "Он ударил по мячу <w>тонко</w> (нижней частью клюшки), и он улетел гораздо дальше, чем планировалось.",
                                "nl": "Hij raakte de bal <w>dun</w> en deze vloog veel verder dan hij had bedoeld."
                            }
