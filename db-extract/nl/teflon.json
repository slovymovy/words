                "senses": [
                    {
                        "sense_id": "5e15139c-38ff-3a57-9a7c-ae19a2fac523",
                        "entry_id": "e0b23334-d9c8-3ea1-9cfc-55d342fdab56",
                        "glosses": [
                            ", merknaam, kunststofmateriaal dat in braad- en koekenpannen zit als laagje tegen het aanbakken"
                        ],
                        "tags": [
                            "polytetrafluoretheen"
                        ],
                        "examples": [
                            {
                                "example_id": "d6afc782-9009-4aa1-933f-8ba5b37f3613",
                                "sense_id": "5e15139c-38ff-3a57-9a7c-ae19a2fac523",
                                "text": "Ik verkocht speelgoed. Ik verkocht een keer de hele partij ineens en werd betaald met een vrachtwagen vol frisdrank, die ik inruilde tegen een vrachtwagen met zonnebloempitten, bij een oliemolen ruilde ik de zonnebloempitten tegen olie, die ik voor een deel verkocht en voor een deel inruilde tegen teflonpannen en strijkijzers.."
                            },
                            {
                                "example_id": "57125857-a2ac-45e0-af5b-f5ac93d2f810",
                                "sense_id": "5e15139c-38ff-3a57-9a7c-ae19a2fac523",
                                "text": "Dupont werkte vanaf de jaren 60 met de stoffen C8 (of PFOA) en DMAC, voor de productie van teflon en lycra. Inmiddels staat vast dat blootstelling aan beide stoffen allerlei schadelijke effecten op de gezondheid kunnen hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e738a12-e638-3650-a0dd-148907c854f5",
                        "entry_id": "e0b23334-d9c8-3ea1-9cfc-55d342fdab56",
                        "glosses": [
                            "van een persoon of zaak dat deze zaken makkelijk van zich af kan laten glijden, dat het zich niet door externe factoren laat beïnvloeden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "930b55e0-0852-4c05-a9e1-4338c2bab0f3",
                                "sense_id": "5e738a12-e638-3650-a0dd-148907c854f5",
                                "text": "De lomperik-in-chief vertikte het de kinderen iets stichtends te vertellen en serveerde gewoon zijn roadshow vol zelfverheerlijking en haatzaaierij. Tillerson was woedend. Zoals wel meer mannen die uit teflon opgetrokken lijken, is de jeugdbeweging een zwakke plek voor hem."
                            },
                            {
                                "example_id": "fe2ccde7-8241-4a0e-8f19-058d1900592b",
                                "sense_id": "5e738a12-e638-3650-a0dd-148907c854f5",
                                "text": "Zo kwamen alle zwarte scenario’s voor analisten voor 2016 uit, maar trokken de beurzen zich er niets van aan. Al het onheil gleed af van de teflon-laag van de financiële markten."
                            }
                        ]
                    }
                ],
