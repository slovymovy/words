                "senses": [
                    {
                        "sense_id": "ea0151d8-5b59-3d28-92a9-ae190e2d34f7",
                        "entry_id": "2e68b4a0-df78-33db-af0e-6936c147a982",
                        "glosses": [
                            "człowiek, który dąży do pogłębiania swojej wiedzy i umiejętności w jakiejś dziedzinie (najczęściej informatyce oraz naukach ścisłych) w stopniu daleko wykraczającym poza zwykłe hobby"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5a8b985f-b2b7-4656-8cb5-b18753dc5c3b",
                                "sense_id": "ea0151d8-5b59-3d28-92a9-ae190e2d34f7",
                                "text": "Ash­ley jest znaną oso­bi­sto­ścią w świe­cie geeków oraz roz­chwy­ty­waną aktorką i pre­zen­terką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f04f56cd-b81d-47aa-9d7b-b1d04bd31a35",
                        "source_entry_id": "2e68b4a0-df78-33db-af0e-6936c147a982",
                        "source_sense_id": "ea0151d8-5b59-3d28-92a9-ae190e2d34f7",
                        "target_lang_word": "geek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0efe4ade-7b91-36c7-b6c9-ec16287ee25d",
                                        "entry_id": "a36ba2a1-3619-3773-a04a-72cd9cefd823",
                                        "glosses": [
                                            "A carnival performer specializing in bizarre and unappetizing behavior."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3afd05-3e45-46f7-bfd5-5329ffdf9683",
                                                "sense_id": "0efe4ade-7b91-36c7-b6c9-ec16287ee25d",
                                                "text": "I once saw a geek bite the head off a live chicken."
                                            },
                                            {
                                                "example_id": "2107979c-9696-4021-bcec-214d6b0136d6",
                                                "sense_id": "0efe4ade-7b91-36c7-b6c9-ec16287ee25d",
                                                "text": "You hand in your ticket / And you go watch the geek / Who immediately walks up to you / When he hears you speak / And says, “How does it feel to / be such a freak?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e700dcd-a662-3743-917b-1654dac8e61a",
                                        "entry_id": "a36ba2a1-3619-3773-a04a-72cd9cefd823",
                                        "glosses": [
                                            "A person who is intensely interested in a particular field or hobby and often having limited or nonstandard social skills. Often used with an attributive noun."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cd2dae-a048-471e-a314-36090bdcf07b",
                                                "sense_id": "3e700dcd-a662-3743-917b-1654dac8e61a",
                                                "text": "I was a complete computer geek in high school, but I get out a lot more now."
                                            },
                                            {
                                                "example_id": "fb43e3a2-c977-4d74-a619-3b699b2a5ce5",
                                                "sense_id": "3e700dcd-a662-3743-917b-1654dac8e61a",
                                                "text": "Most famous actors are really theater geeks at heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                                        "entry_id": "a36ba2a1-3619-3773-a04a-72cd9cefd823",
                                        "glosses": [
                                            "An expert in a technical field, particularly one having to do with computers."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6697ec-6db2-4e69-91d2-1ec910a9c511",
                                                "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                                                "text": "My laptop’s locked up again. I need a geek."
                                            },
                                            {
                                                "example_id": "6126abce-3844-4ca5-96b8-ab7d0fc00307",
                                                "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                                                "text": "I challenge these geeks to show a little spirit and produce an 81 tier bonfire by Friday night. It would also be nice to see a few kegs and some spirit around their awaited creation each night. Until then I rest my case."
                                            },
                                            {
                                                "example_id": "1e1b36d4-8508-4a61-98cd-aaeb8125580a",
                                                "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                                                "text": "i eschew the use of \"foo\" \"bar\" and other dill-beak geek dull unimaginative temporary filenames! i find it much better to use names like: ingracl-bbp.goo or dog or ignatz"
                                            },
                                            {
                                                "example_id": "bb5b1304-6114-43e5-9208-436ad37e7783",
                                                "sense_id": "a1ff8fe4-05ea-3449-a35c-8b58b4aba8ec",
                                                "text": "The community of radio amateurs—trespassing fiddlers on the cutting edge of technological possibilities—prefigured the geek community that was to inhabit Silicon Valley 50 years later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee884e2-976e-3cac-b978-b451548f66ad",
                                        "entry_id": "a36ba2a1-3619-3773-a04a-72cd9cefd823",
                                        "glosses": [
                                            "The subculture of geeks; an esoteric subject of interest that is marginal to the social mainstream; the philosophy, events, and physical artifacts of geeks; geekness."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bb5e2a3-c4db-44b8-b975-cf768492a943",
                                                "sense_id": "cee884e2-976e-3cac-b978-b451548f66ad",
                                                "text": "It is totally counter-intuitive. How do these ubernerds get the cute girls? Is it the ultimate triumph of the Bill Gates era, in which geek is the new cool?"
                                            },
                                            {
                                                "example_id": "7b267995-c26c-4a7d-8816-99ca935c8ac5",
                                                "sense_id": "cee884e2-976e-3cac-b978-b451548f66ad",
                                                "text": "\"Basically,\" says [Harry J.] Knowles [founder, 'Ain't It Cool News' website], \"it's my job to stay on top of the latest and coolest in geek that's out there, specifically as it relates to the world of film.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1ca5ab-7d12-30d0-93d1-f2e5b7ebc82b",
                                        "entry_id": "a36ba2a1-3619-3773-a04a-72cd9cefd823",
                                        "glosses": [
                                            "An unfashionable or socially undesirable person."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "695fa522-9c90-4b12-b84d-bd1b58007da7",
                                                "sense_id": "5e1ca5ab-7d12-30d0-93d1-f2e5b7ebc82b",
                                                "text": "Why do you hang around with them? They’re just geeks."
                                            },
                                            {
                                                "example_id": "f737a2c8-3a3e-471a-a5a7-2ba81966fc32",
                                                "sense_id": "5e1ca5ab-7d12-30d0-93d1-f2e5b7ebc82b",
                                                "text": "Yeah, well, listen. You ought to ditch the two geeks you're in the car with now and get in with us. But that's all right, we'll worry about that later."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3312e8a-3b0d-322f-a488-f6d9e29108bd",
                                        "entry_id": "cdd49873-3e69-3ec5-a333-10e8a00a6f16",
                                        "glosses": [
                                            "To perform bizarre and unpleasant feats as part of a carnival."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26333cc-e635-45d7-951b-f0c3c96d90b0",
                                                "sense_id": "b3312e8a-3b0d-322f-a488-f6d9e29108bd",
                                                "text": "Geeking, unsurprisingly, was among the first carnival acts to be outlawed as the 20th century unfurled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38b2ddd-c8b2-339a-bba8-1efb713ca9bd",
                                        "entry_id": "cdd49873-3e69-3ec5-a333-10e8a00a6f16",
                                        "glosses": [
                                            "To enthusiastically engage in geek-like or nerdy interests."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e6f518-4a3f-4312-8988-8cae0416345c",
                                                "sense_id": "c38b2ddd-c8b2-339a-bba8-1efb713ca9bd",
                                                "text": "It was our first time at a Star Trek convention and we had an amazing time wandering around and geeking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd89af06-f127-3f39-abac-1dd1f8830f30",
                                        "entry_id": "cdd49873-3e69-3ec5-a333-10e8a00a6f16",
                                        "glosses": [
                                            "To be nervous or hyperactive due to using crack cocaine."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11bcc519-bd0f-41e2-a6ce-0507d50035fa",
                                                "sense_id": "fd89af06-f127-3f39-abac-1dd1f8830f30",
                                                "text": "I ain't nothin' but a clucker, your typical glass dick suckin' basehead, geekin' motherfucker"
                                            },
                                            {
                                                "example_id": "d9dfcd4a-2f47-4e1c-8130-9ab6bc97d355",
                                                "sense_id": "fd89af06-f127-3f39-abac-1dd1f8830f30",
                                                "text": "They know I geek a lot / They don't know I keep a Glock"
                                            },
                                            {
                                                "example_id": "378582a7-5138-4862-8d58-c84f484cb3f9",
                                                "sense_id": "fd89af06-f127-3f39-abac-1dd1f8830f30",
                                                "text": "I'm tweakin', I'm geekin', I'm tweakin', I'm geekin'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99206451-d91c-3932-bff8-10d927197bd9",
                                        "entry_id": "cdd49873-3e69-3ec5-a333-10e8a00a6f16",
                                        "glosses": [
                                            "To be nervous or hyperactive due to using crack cocaine.",
                                            "To be under the influence of a mood-altering drug."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "geek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "656523d0-5bf6-32df-a907-0e9ac7f5a7cf",
                                        "entry_id": "17366558-1ab5-37c8-8ec1-624581753618",
                                        "glosses": [
                                            "A look."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f60fc81-42a5-45a8-bff7-3124bc8f0080",
                                                "sense_id": "656523d0-5bf6-32df-a907-0e9ac7f5a7cf",
                                                "text": "Have a geek at this."
                                            },
                                            {
                                                "example_id": "b88c0274-1265-4e96-a08a-88d3432bb622",
                                                "sense_id": "656523d0-5bf6-32df-a907-0e9ac7f5a7cf",
                                                "text": "Then he says let′s have a geek at some of the elephant pictures instead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83defa65-60fb-3fc6-80db-a7f223cb1786",
                                        "entry_id": "7fa37ea6-bd72-3b0f-a1f8-c200a059cd86",
                                        "glosses": [
                                            "To look; to peep; to stare about intently."
                                        ],
                                        "tags": [
                                            "Cornwall"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f94966-3e19-45c7-b02f-74e78a8bfe65",
                                                "sense_id": "83defa65-60fb-3fc6-80db-a7f223cb1786",
                                                "text": "This gayte bucca-davy, all'ys geekin' round arter a gook."
                                            },
                                            {
                                                "example_id": "c96daa01-2329-436d-93b5-4e7d4235a6a2",
                                                "sense_id": "83defa65-60fb-3fc6-80db-a7f223cb1786",
                                                "text": "I will geek, I will geek I tell ee; while I have the spirit of a man in me I'll geek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
