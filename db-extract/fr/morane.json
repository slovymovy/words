                        "glosses": [
                            "Nom donné aux jeunes garçons Massaïs qui deviennent guerriers vers l'âge de quinze ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b830cd-45fa-422b-bcc6-b2bdafa06d73",
                                "sense_id": "543697f6-ae9b-3d2c-aa68-b9bd1812ee7f",
                                "text": "Les deux Masaï qui venaient d’apparaître longeaient maintenant la lisière du camp, front haut, nuque droite et du même pas rapide, nonchalant et léger. L’un pourtant était un vieillard et l’autre un morane."
                            },
                            {
                                "example_id": "bd148c37-b6b3-4f36-994c-8f18e0f95ad1",
                                "sense_id": "543697f6-ae9b-3d2c-aa68-b9bd1812ee7f",
                                "text": "Les Anglais sont invités à participer à la grande fête donner en l’honneur d’Uru, le jeune morane qui, en tuant un lion ainsi que le voulez la tradition de ses ancêtres, a pu accéder au statut de guerrier avant sa mort."
                            }
                        ]
                    }
