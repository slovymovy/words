                    {
                        "translation_id": "299cf5fa-5871-4e5d-be29-9f7507265409",
                        "source_entry_id": "157eb781-a48e-3fb0-a90f-30ae942d4422",
                        "source_sense_id": "a2c2ed4b-5298-3a45-b4b1-5cf5476ab45c",
                        "source_sense_description": "pertaining to high levels of activity",
                        "target_lang_word": "ereignisreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
