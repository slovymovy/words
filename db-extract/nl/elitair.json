                                "target_senses": [
                                    {
                                        "sense_id": "e68b6e2a-abf0-317c-b5df-4c04a41edf8c",
                                        "entry_id": "cc1961d5-56db-3093-ae8f-2732a41bde30",
                                        "glosses": [
                                            "Of or relating to elitism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b123c6e1-3d15-4c86-ab77-f332833a03bf",
                                                "sense_id": "e68b6e2a-abf0-317c-b5df-4c04a41edf8c",
                                                "text": "And unlike his Davis, California homey DJ Shadow, who smothers tracks with avant-garde displays of turntable mastery, Mike isn't afraid to let his B-boy bouillabaisse coalesce into real bootylicious grooves that are more about moving the crowd than wowing elitist nerds who crowd around the DJ booth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elitist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0bd9329-65ad-3019-b43c-a22a149901b2",
                                        "entry_id": "1fba808d-da45-32ed-8557-d08a2b3d7367",
                                        "glosses": [
                                            "Someone who believes in or is perceived as believing in rule by an elite group."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac665046-3e38-4af9-8cee-e927dd3d2af8",
                                                "sense_id": "b0bd9329-65ad-3019-b43c-a22a149901b2",
                                                "text": "Narrators demonstrated resistance coping techniques through direct confrontation with aggressors, such as racists, sexists, homophobes, elitists, and misogynoirists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfc67e90-fe27-4157-9a5f-fbd3cb007f65",
                        "source_entry_id": "23dbcfb6-4444-36d8-8d40-3094f10e7f01",
                        "target_lang_word": "élitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe4fd93-ede6-3e31-a101-1cec6e41f4dd",
                                        "entry_id": "77406693-6f53-30b0-8e66-b04615bb03f5",
                                        "glosses": [
                                            "Relatif à une élite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f705c0d-01b0-4d74-a9db-d6ec36286d77",
                                                "sense_id": "8fe4fd93-ede6-3e31-a101-1cec6e41f4dd",
                                                "text": "— J’avais raison : vous échoueriez aux trois grands examens élitaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c987a34a-fddd-338b-be9c-fef3ca1a1db4",
                                        "entry_id": "77406693-6f53-30b0-8e66-b04615bb03f5",
                                        "glosses": [
                                            "Réservé à une élite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2ce9e1-4f7e-4884-83ca-5c959679e21c",
                                                "sense_id": "c987a34a-fddd-338b-be9c-fef3ca1a1db4",
                                                "text": "Établi vers la fin du Vᵉ siècle sur un pic isolé au sein des gorges du Tarn, le castellum de La Malène, en Gévaudan, constitue un autre genre d’établissement perché dans lequel on reconnaît un habitat élitaire marqué par une aile résidentielle dotée d'une colonnade d’étage, de peintures polychromes et de bains à la romaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61aff794-d118-435e-80e7-47a37c40f608",
                        "source_entry_id": "23dbcfb6-4444-36d8-8d40-3094f10e7f01",
                        "target_lang_word": "élitiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élitiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c61bd257-1749-3652-9f7c-5b69933d2b26",
                                        "entry_id": "58d27277-c31d-309d-b73c-ea51c5a6b771",
                                        "glosses": [
                                            "Qui concerne une élite ou l’élitisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70312ce6-dd5d-4d65-8ccd-4b04fbadca9b",
                                                "sense_id": "c61bd257-1749-3652-9f7c-5b69933d2b26",
                                                "text": "Il décida d’écrire non pas pour sa propre revue ou un hebdomadaire, ou encore une feuille élitiste lue par des intellectuels, mais pour un quotidien populaire, à très fort tirage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "élitiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e07b751a-020f-3036-8f9d-aacadcaab554",
                                        "entry_id": "9af65f92-690b-33df-bbda-0df8e37530c0",
                                        "glosses": [
                                            "Qui concerne une élite ou l’élitisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240d3715-36c7-4026-bea8-fe0167adbf7b",
                                                "sense_id": "e07b751a-020f-3036-8f9d-aacadcaab554",
                                                "text": "Je ne suis qu’une élitiste irresponsable, voulant ignorer les dures réalités sociologiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a469fb-e0ce-3e15-9946-cef61b3c2108",
                                        "entry_id": "9af65f92-690b-33df-bbda-0df8e37530c0",
                                        "glosses": [
                                            "Celle ou celui qui promeut le gouvernement des élites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48032a83-10bc-495c-a0ed-88c40d1f961d",
                                                "sense_id": "b5a469fb-e0ce-3e15-9946-cef61b3c2108",
                                                "text": "L'histoire, n'en déplaise aux élitistes et aux complotistes, faces complémentaires d'une même incompréhension, est faite par les masses, aisées, pauvres ou médiocres."
                                            }
                                        ]
                                    }
                                ]
                            }
