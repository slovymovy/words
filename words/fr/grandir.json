            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fd7da4b-e57a-308b-be9b-2492e9b84145",
                    "sense_definition": "Prendre de la taille et de l'âge au cours de son développement physique, en parlant d'un être vivant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants peuvent <w>grandir</w> très vite pendant les vacances d'été."
                        },
                        {
                            "text": "Mon petit frère a beaucoup <w>grandi</w> depuis l'année dernière."
                        }
                    ],
                    "synonyms": [
                        "croître",
                        "pousser"
                    ],
                    "antonyms": [
                        "rapetisser"
                    ],
                    "common_phrases": [
                        "grandir vite"
                    ]
                },
                {
                    "sense_id": "63eaad9d-9f2a-3b66-868f-6e3e80277484",
                    "sense_definition": "Passer son enfance ou sa jeunesse dans un lieu ou un cadre déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enfance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>grandi</w> dans un petit village à la campagne."
                        },
                        {
                            "text": "Ils ont <w>grandi</w> ensemble dans le même quartier de Paris."
                        }
                    ],
                    "common_phrases": [
                        "grandir ensemble"
                    ]
                },
                {
                    "sense_id": "c2e12fcb-90e2-3d3d-a5ed-326998b9a654",
                    "sense_definition": "Augmenter de volume, d'importance, d'étendue ou d'intensité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La ville continue de <w>grandir</w> avec l'arrivée de nouveaux habitants."
                        },
                        {
                            "text": "L'inquiétude commence à <w>grandir</w> parmi les employés de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "augmenter",
                        "s'accroître",
                        "s'amplifier"
                    ],
                    "antonyms": [
                        "diminuer",
                        "décroître"
                    ],
                    "common_phrases": [
                        "faire grandir"
                    ]
                },
                {
                    "sense_id": "0f6a210e-3fa1-3efd-b7ca-923e222bb6cb",
                    "sense_definition": "Donner à quelqu'un l'apparence d'être plus grand ou plus noble.",
