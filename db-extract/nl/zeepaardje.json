                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d4de75-21df-41fb-824a-09a209b28968",
                                                "sense_id": "67b9b27e-1408-331d-8bd7-402943095aef",
                                                "text": "„Seepferdchen gehören zu den gefährdetsten Tiergattungen der Welt.“"
                                            },
                                            {
                                                "example_id": "cf20a0c4-c5e2-42df-a041-7264fbad125e",
                                                "sense_id": "67b9b27e-1408-331d-8bd7-402943095aef",
                                                "text": "„Der Verlust eines Gens ist noch für eine weitere Besonderheit bei den Seepferdchen verantwortlich: für den Wegfall der Bauchflossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d24ea421-db51-392c-8050-e997005977eb",
                                        "entry_id": "a5970227-a8d2-3f92-9ede-30ea2b84f47e",
                                        "glosses": [
                                            "ein nach dem Tier^([1]) benanntes Schwimmabzeichen für Frühschwimmer"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c73ef4-e410-40a1-9811-97e60aba3335",
                                                "sense_id": "d24ea421-db51-392c-8050-e997005977eb",
                                                "text": "Mein Sohn ist heute sehr schön geschwommen und hat sich das Seepferdchen verdient."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
