        "ru-extract.jsonl": [
            {
                "entry_id": "d63750fc-cecc-3c01-abdc-7cc2cac0e363",
                "word": "Попугаев",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea3991b1-6a94-3567-a520-e5e3723a7c7b",
                        "entry_id": "d63750fc-cecc-3c01-abdc-7cc2cac0e363",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "469541b2-d0f8-47e3-b55c-17df73b8128a",
                                "sense_id": "ea3991b1-6a94-3567-a520-e5e3723a7c7b",
                                "text": "Другая книжка «Свиток муз» почти вся наполнена стихотворениями Востокова и Попугаева."
                            },
                            {
                                "example_id": "3ab08a9d-4bf9-4835-b5e8-4f95caa2403b",
                                "sense_id": "ea3991b1-6a94-3567-a520-e5e3723a7c7b",
                                "text": "Откуда у русского человека фамилия Попугаев?"
                            },
                            {
                                "example_id": "453503f7-9b1b-4547-a4d7-1320966b05d0",
                                "sense_id": "ea3991b1-6a94-3567-a520-e5e3723a7c7b",
                                "text": "Андрей Семёнович сел на корточки и завыл. В комнату вбежал товарищ Попугаев. — Что с вами? Вы больны? — спросил товарищ Попугаев. Андрей Семёнович молчал и тёр лицо руками. Товарищ Попугаев заглянул в чашку, стоявшую на столе. — Не знаю, — сказал Андрей Семёнович. Попугаев мгновенно исчез."
                            }
                        ]
                    }
                ],
