                        "examples": [
                            {
                                "example_id": "da56b545-9883-457f-8433-b93dfa42d14d",
                                "sense_id": "ed76436d-bcbc-3081-ab75-588b24a578a8",
                                "text": "In de Kamer van Volksvertegenwoordigers, de Vlaamse Tweede Kamer, zijn meerdere wetsvoorstellen behandeld die het niet haalden, omdat het verbod gekoppeld werd aan andere maatregelen, zoals de verhoging van de minimumleeftijd voor het kopen van tabak naar 18 jaar. Dat ligt gevoelig bij onder meer de Open VLD, de coalitiegenoot van de CD&V van Schauvliege. In het nieuwe wetsvoorstel wordt het verbod op roken in de auto niet aan andere maatregelen gekoppeld."
                            },
                            {
                                "example_id": "81d39c66-1093-47af-a157-5302109bfe20",
                                "sense_id": "ed76436d-bcbc-3081-ab75-588b24a578a8",
                                "text": "Berichtenapp WhatsApp verhoogt de minimumleeftijd van gebruikers in Europa van 13 naar 16 jaar. Dat doet het bedrijf om te voldoen aan nieuwe privacywetgeving die volgende maand van kracht wordt."
                            }
                        ]
                    }
