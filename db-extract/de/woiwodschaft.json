                ],
                "senses": [
                    {
                        "sense_id": "6af8bd24-84bd-3b87-89ad-4422461b62ed",
                        "entry_id": "1c8c869e-2e63-31b5-81b4-fcf311292cd4",
                        "glosses": [
                            "größerer Verwaltungsbezirk in slawischen Ländern, der einem Woiwoden untersteht"
                        ],
                        "tags": [
                            "Verwaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "14e2a9f3-619e-4266-97a9-e509f576080c",
                                "sense_id": "6af8bd24-84bd-3b87-89ad-4422461b62ed",
                                "text": "Die Republik Polen ist seit 1999 in sechzehn Woiwodschaften gegliedert."
                            },
                            {
                                "example_id": "41b4d959-b18b-4bc6-9f88-d0ef26190298",
                                "sense_id": "6af8bd24-84bd-3b87-89ad-4422461b62ed",
                                "text": "Breslau ist die Hauptstadt der Woiwodschaft Niederschlesien."
                            },
                            {
                                "example_id": "8d886248-22e5-4fcf-a3ad-7f6d05e9e2e2",
                                "sense_id": "6af8bd24-84bd-3b87-89ad-4422461b62ed",
                                "text": "„Die Woiwodschaft Serbien und Temeser Banat auch Serbische Woiwodschaft und Temeser Banat war ein 1849 gegründetes Kronland des Kaisertums Österreich, das bis 1860 bestand.“"
                            },
                            {
                                "example_id": "65acc6a7-f423-4e38-a9ea-7a9e4a31ad4e",
                                "sense_id": "6af8bd24-84bd-3b87-89ad-4422461b62ed",
                                "text": "„Die »S51«, mehr Autobahn als Schnellstraße, frisst sich tief in die Seenwelt der Woiwodschaft Ermland-Masuren hinein und erschafft alle paar Kilometer gigantische Verkehrskreuze, in deren Schatten Sportkomplexe und Fertighaussiedlungen entstehen oder schon entstanden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "968a244b-121f-49e5-8286-f9ae52ee5e98",
