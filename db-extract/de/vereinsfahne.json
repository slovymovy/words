                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1bb108-4a7b-4f6f-bf1f-b155c8d0acc0",
                                "sense_id": "5e97e732-f9fe-37bb-9d9a-e1ba3e42bb1c",
                                "text": "Die Vereinsfahne des Musikvereins ist schon sehr alt."
                            },
                            {
                                "example_id": "1f97ecbf-2228-434d-9afd-09e6d7b57bd6",
                                "sense_id": "5e97e732-f9fe-37bb-9d9a-e1ba3e42bb1c",
                                "text": "„Auf den Feldgottesdienst folgte der große Festumzug mit der Vereinsfahne als wichtigstem Vorzeigesymbol.“"
                            },
                            {
                                "example_id": "c5c04afe-3432-41fd-8222-11d4e518d098",
                                "sense_id": "5e97e732-f9fe-37bb-9d9a-e1ba3e42bb1c",
                                "text": "„Auch eine Kopie der Vereinsfahne des Gesangvereins Eintracht hat sie ihm mitgegeben.“"
                            }
