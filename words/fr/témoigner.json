    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff9728a8-3e46-3ee0-a3ea-bfd1327f42ab",
                    "sense_definition": "Déclarer ce que l'on sait ou ce que l'on a vu, notamment devant la justice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un passant a accepté de <w>témoigner</w> en justice après l'accident."
                        },
                        {
                            "text": "Plusieurs personnes ont <w>témoigné</w> sous serment devant le tribunal."
                        }
                    ],
                    "common_phrases": [
                        "témoigner en justice",
                        "témoigner sous serment"
                    ]
                },
                {
                    "sense_id": "c37341a7-8f51-38a5-87cf-091b70634efe",
                    "sense_definition": "Exprimer ou manifester un sentiment, une pensée envers autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lui ai envoyé un mot pour lui <w>témoigner</w> ma gratitude."
                        },
                        {
                            "text": "Les citoyens ont souhaité <w>témoigner</w> leur confiance au nouveau maire."
                        }
                    ],
                    "common_phrases": [
                        "témoigner sa gratitude",
                        "témoigner sa confiance",
                        "témoigner son affection"
                    ]
                },
                {
                    "sense_id": "ec9f2f63-6aac-304e-9202-ed2839103546",
                    "sense_definition": "Être la preuve tangible ou la marque manifeste de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preuve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces vieux édifices <w>témoignent</w> de la richesse passée de la cité."
                        },
                        {
                            "text": "Ses progrès rapides <w>témoignent</w> d'un investissement régulier."
                        }
                    ],
                    "synonyms": [
                        "démontrer"
                    ],
                    "common_phrases": [
                        "témoigner de"
                    ]
                }
            ]
