                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c5aa2cc-1ebd-44f0-95bd-1709e5c5a4da",
                        "source_entry_id": "912f8ff0-e582-3d2d-9de7-4b5a9a626737",
                        "source_sense_description": "city in Yvelines, Île-de-France",
                        "target_lang_word": "Versailles",
