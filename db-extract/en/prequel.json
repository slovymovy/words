                "senses": [
                    {
                        "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                        "entry_id": "65cb6880-3d14-3fb9-8938-14491df69128",
                        "glosses": [
                            "In a series of works, an installment that is set chronologically before its predecessor, especially the original narrative or (perhaps improper usage) any narrative work with at least one sequel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc388390-981d-4807-b1e1-ee255ddbba18",
                                "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                                "text": "'Prequels' are sequels that relate the story that preceded the original film."
                            },
                            {
                                "example_id": "3ec96dd7-7a1d-414e-857f-f9635c65c2d4",
                                "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                                "text": "2008, 26 February, Andrew Pierce, \"JRR Tolkien's estate to sue Lord of the Rings filmmakers New Line Cinema over profits, in The Daily Telegraph\nThey are also threatening to block the production of the long-awaited prequel, The Hobbit, which may now be cancelled."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd92b0f-8f7b-45c7-b3bd-383d534acda4",
                        "source_entry_id": "65cb6880-3d14-3fb9-8938-14491df69128",
                        "source_sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                        "source_sense_description": "in a series of works, an installment that is set chronologically before its predecessor",
                        "target_lang_word": "préquelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préquelle",
