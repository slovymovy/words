                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan utilise un outil <w>perçant</w> pour trouer le cuir avec une grande précision."
                        },
                        {
                            "text": "Ce foret n'est plus assez <w>perçant</w> pour traverser une plaque métallique épaisse."
