                                                "sense_id": "630c85a4-36b6-3399-94c5-7e6d78ba06cc",
                                                "text": "Erkekler arasında sahte kadın olup olmadığı üstüne tartışmalar kızıştı."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f885405b-c660-39a9-9633-fb39bf13f7f2",
                                        "entry_id": "8908f90c-23b4-373a-b6f6-ee9e6915e8ff",
                                        "glosses": [
                                            "bir sorun üzerine sözle veya yazılı olarak karşılıklı, bazen de sertçe savunma"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6729369-b2ac-49d8-ad89-9455913d32c2",
                                                "sense_id": "f885405b-c660-39a9-9633-fb39bf13f7f2",
                                                "text": "Bu açıklamalar ilginç tartışmalara yol açtı ve düşündürücü sorunlar çıktı ortaya."
                                            }
                                        ]
                                    }
