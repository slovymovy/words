                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "076804f4-570f-3bd4-85cb-bf1b2ffbe33c",
                "word": "neustrien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76f9b9a8-9396-3937-98d5-f7f8e36d6b3d",
                        "entry_id": "076804f4-570f-3bd4-85cb-bf1b2ffbe33c",
                        "glosses": [
                            "Langue qui fut, jadis, parlée en Neustrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13b3818-16ce-4710-ad72-f2c7e65ebf8f",
                                "sense_id": "76f9b9a8-9396-3937-98d5-f7f8e36d6b3d",
                                "text": "C'est alors qu'eurent lieu les grandes invasions germaniques les Visigoths au midi, à l'est les Burgondes, et les Franks par le nord. […]. Mais, après l'irruption, ces rameaux se réunirent en trois branches principales de langage: le ripuaire au nord de la Gaule, le neustrien à l'est et l’ostrasien à l'ouest."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "68b5fd22-02ca-3298-8897-68aaad269057",
