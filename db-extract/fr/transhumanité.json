                "senses": [
                    {
                        "sense_id": "5cfc7713-52fa-329a-bd00-d91d9e92d8e3",
                        "entry_id": "c15142f3-87e9-374a-9259-215ac75ff811",
                        "glosses": [
                            "Nature intrinsèque des transhumains."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "84f8ab9f-9fb7-4d89-a26d-3e1627bf6c95",
                                "sense_id": "5cfc7713-52fa-329a-bd00-d91d9e92d8e3",
                                "text": "Néanmoins, N. Bostrom ne cache pas son inquiétude pour le devenir de son dessein d'une transhumanité. Il dénonce ceux (qu'il qualifie de « bio-conservateurs ») qui critiquent cette (future) possibilité technique de créer des transhumains, des hommes-robots, des cyborgs."
                            },
                            {
                                "example_id": "614c66e3-871d-4323-a371-651ad009cc91",
                                "sense_id": "5cfc7713-52fa-329a-bd00-d91d9e92d8e3",
                                "text": "De 1982 à 1988, plusieurs autres réunions se succèderont jusqu'à la création par Natasha Vita-More d'une émission télévisée spécialement dédiée à la transhumanité, Transcentury Update."
                            },
                            {
                                "example_id": "91b753da-3dcc-463b-80a2-d624dd07d15e",
                                "sense_id": "5cfc7713-52fa-329a-bd00-d91d9e92d8e3",
                                "text": "La science-fiction regorge d'exemples de transhumanités et de machines pensantes... jusqu'à l'émergence de nouvelles formes de vies littéralement posthumaines, c'est à dire en dehors des définitions actuelles de l'espèce humaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66bfa05c-3a4c-448a-b68b-94a221463900",
                        "source_entry_id": "c15142f3-87e9-374a-9259-215ac75ff811",
                        "source_sense_id": "5cfc7713-52fa-329a-bd00-d91d9e92d8e3",
                        "target_lang_word": "transhumanity",
