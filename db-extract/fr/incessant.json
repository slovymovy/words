                        ],
                        "form": "incessante"
                    },
                    {
                        "form_id": "dfa5d0d4-99bd-4162-bf3d-b2c53bb1ea98",
                        "entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "incessantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                        "entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                        "glosses": [
                            "Qui ne cesse pas ; qui dure sans interruption ; qui est continu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34fe7273-2ae3-4792-82d4-0fcda83fa0ae",
                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                "text": "La nature a sur la matière vivante de tels droits, qu’il faut à l’homme des efforts incessants pour les contrebalancer."
                            },
                            {
                                "example_id": "d2c269b2-25e0-4d66-9e73-1ca33bcc5687",
                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                "text": "Mais dans « Frenchie Shore », on ne parle pas uniquement de danses collées serrées ou de petits roulages de pelles, mais de fellations à peine floutées ou de tripotages incessants au bord de la piscine."
                            },
                            {
                                "example_id": "06a0e245-8f64-4b02-8eec-33dce2be7e90",
                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                "text": "D'un étage à l'autre, c'était un remue-ménage incessant de paras, qui montaient et descendaient, chassant devant eux des Musulmans, […], le tout dans un grand bruit de bottes, d'éclats de rire, de grossièretés et d'insultes entremêlés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ee6eccb-9504-4a8d-a3c7-bdd2434c6416",
                        "source_entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                        "source_sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                        "target_lang_word": "unaufhörlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaufhörlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                        "entry_id": "cb7ade97-d6a7-361b-9de6-c8f6b6c37dfe",
                                        "glosses": [
                                            "ohne Unterbrechungen und kein Ende erahnen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91289c14-d0bf-4572-97f1-d41ce5bb18e0",
                                                "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                                "text": "Das Wasser fließt unaufhörlich dem Meer entgegen."
                                            },
                                            {
                                                "example_id": "0306a067-5707-45a9-9980-fd32bb90c1f2",
                                                "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                                "text": "„Unzählige Gäste waren schon im Landhaus eingetroffen, aber es wurden noch immer mehr erwartet, und auf dem endlos sich hinstreckenden Weg von Kalimas nach dem Bahnhof war es ein unaufhörliches Kommen und Gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf5abab8-4c35-424f-b4ab-6ca08d696c0c",
                        "source_entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                        "source_sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                        "target_lang_word": "incessant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incessant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                        "entry_id": "8c051f11-22d9-3ac7-964e-df30df03d9e0",
                                        "glosses": [
                                            "Without pause or stop; not ending, especially to the point of annoyance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f309daf4-df23-4a23-86dd-3d0bc76205d0",
                                                "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                                "text": "The dog's incessant barking kept the girl awake all night."
                                            },
                                            {
                                                "example_id": "d99ba1c0-f99b-40ad-8ab2-5780973fa96c",
                                                "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                                "text": "[…] incessant interferings and bickerings, in every country, between the secular powers and the ecclesiastical."
                                            },
                                            {
                                                "example_id": "53079081-c0da-4cd5-a07f-532113bfc88c",
                                                "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                                "text": "The face of Nature may be compared to a yielding surface, with ten thousand sharp wedges packed close together and driven inwards by incessant blows, sometimes one wedge being struck, and then another with greater force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0cbe71-6198-4caf-bedb-c1c26a856944",
                        "source_entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                        "source_sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                        "target_lang_word": "unceasing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unceasing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d17ddc-6a17-3aaf-8ef2-982bc55835f6",
                                        "entry_id": "b8db33ab-bcc3-3361-a733-00ac614037b3",
                                        "glosses": [
                                            "continuous; continuing indefinitely without stopping"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594f5a12-3942-4943-8884-dad033f2de0d",
                                                "sense_id": "f9d17ddc-6a17-3aaf-8ef2-982bc55835f6",
                                                "text": "The unceasing fatigue of my daily walks to and from Clapham, with my various trudgings from one Doctor Humbug to another Doctor Whimsical, combined with the before-mentioned causes to affect my health."
                                            },
                                            {
                                                "example_id": "2e288267-cd28-4ee2-91ee-61edb5bb2376",
                                                "sense_id": "f9d17ddc-6a17-3aaf-8ef2-982bc55835f6",
                                                "text": "To handle the unceasing traffic increase, immense sums of money are being expended in dealing with bottlenecks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc308504-372b-443d-944a-98f3cbfc8f21",
                        "source_entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
