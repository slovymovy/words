                                "target_senses": [
                                    {
                                        "sense_id": "c0f5025a-f266-3269-b879-b0e0659096a6",
                                        "entry_id": "94f512ba-8ce5-32d8-b5cb-2d0156057003",
                                        "glosses": [
                                            "Système d’exécution de plusieurs tâches en parallèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbdea868-a4dd-4002-83a7-7a0ed12f07f9",
                                                "sense_id": "c0f5025a-f266-3269-b879-b0e0659096a6",
                                                "text": "Les stations de travail et les serveurs bénéficient depuis longtemps des avantages des architectures multiprocesseurs, notamment un multitâche plus réactif, de meilleures performances (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df072c3f-139b-3325-b504-c3c118a56eec",
                                        "entry_id": "94f512ba-8ce5-32d8-b5cb-2d0156057003",
                                        "glosses": [
                                            "Personne qui fait plusieurs choses à la fois."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ac9958-6b62-4048-97fa-5182e0286adf",
                                                "sense_id": "df072c3f-139b-3325-b504-c3c118a56eec",
                                                "text": "Gustave Le Bon, le multitâche de la connaissance."
                                            },
                                            {
                                                "example_id": "46e44e65-3fa9-4648-8c70-002868c04d0d",
                                                "sense_id": "df072c3f-139b-3325-b504-c3c118a56eec",
                                                "text": "Chaque personne aidante fait des miracles en multitâches : infirmière, psychologue, accompagnatrice, cuisinière, artiste, athlète et j’en passe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91f56f1a-b5fd-451b-baf9-c6d7acda15a4",
                        "source_entry_id": "ecb8c1c1-c2e2-3550-93ce-dd0b8ef5aba5",
                        "source_sense_description": "simultaneous execution of multiple tasks (computing)",
                        "target_lang_word": "Multitasking",
