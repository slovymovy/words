                    {
                        "sense_id": "5f16ff9e-e368-3ee1-9029-10f8c56498da",
                        "entry_id": "1e6646d3-6f49-3726-bd6a-be0e3a8e5c6e",
                        "glosses": [
                            "großer Greifvogel aus der Gattung der Seeadler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3fae34-f6f2-4c2f-a631-2c20997f48e5",
                                "sense_id": "5f16ff9e-e368-3ee1-9029-10f8c56498da",
                                "text": "„Dort hielt er abrupt inne und starrte auf ein Regal, in dem die fünfzehn Zentimeter große Bronzestatuette eines Weißkopfseeadlers stand, die Schwingen ausgebreitet, die Fänge vorgereckt, die Raubvogelaugen nach unten gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
