                    {
                        "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                        "entry_id": "59e40722-e300-3bd4-988c-f705ec3b7b25",
                        "glosses": [
                            "Behaviour or belief that tends to resolve disputes between denominations or religions; irenical theology; conciliation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ecfad90a-89e3-4a8e-9e48-19a307ac41ad",
                                "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                                "text": "A striking feature of this volume is the pronounced irenicism of the Americans, Lindbeck of Yale and Quanbeck of the Luther Theological Seminary at St. Paul, in contrast to the unsparingly critical approach of the Europeans."
                            },
                            {
                                "example_id": "4c17ed3d-95aa-4d5a-b4b3-38b150ab0ec9",
                                "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                                "text": "The elector Palatine, as self-appointed Calvinist leader, promoted his own, narrow form of irenicism to remain within the Peace by finding common ground with Lutherans."
                            }
                        ]
                    }
                ],
