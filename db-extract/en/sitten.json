            {
                "entry_id": "09f4b882-aceb-3ebc-bf0a-77ab47347a8e",
                "word": "sitten",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "88a7e646-fbee-3ec0-92cb-5cd0e04096a6",
                        "entry_id": "09f4b882-aceb-3ebc-bf0a-77ab47347a8e",
                        "glosses": [
                            "plural simple present of sit"
                        ],
                        "tags": [
                            "form-of",
                            "obsolete",
                            "plural",
                            "present"
                        ],
                        "examples": [
                            {
                                "example_id": "f3d8c1f0-859f-45d3-81c1-3b3c485b53f5",
                                "sense_id": "88a7e646-fbee-3ec0-92cb-5cd0e04096a6",
                                "text": "Such merimake holy saints doth queme,\nBut we here sytten as drownd in a dreme."
                            },
                            {
                                "example_id": "8083fec2-3c4e-43fc-a81e-74ab9c453e00",
                                "sense_id": "88a7e646-fbee-3ec0-92cb-5cd0e04096a6",
                                "text": "This were as good as curds for our Jone, / When at a night we ſitten by the fire."
                            },
                            {
                                "example_id": "8744d7ee-2fa9-451f-8404-cea516dd248a",
                                "sense_id": "88a7e646-fbee-3ec0-92cb-5cd0e04096a6",
                                "text": "While as they sitten soft in the sweet rayes\nOr vitall vest of the lives generall,"
                            },
                            {
                                "example_id": "7040b562-41f6-4263-b39d-d31c3b50ad48",
                                "sense_id": "88a7e646-fbee-3ec0-92cb-5cd0e04096a6",
                                "text": "Then listen, Thenot, to my mournful lay,\nAs wee these willows sitten here emong;"
                            }
                        ]
                    }
                ],
