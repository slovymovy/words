                        "glosses": [
                            "Crude; undigested; upset; unformed; unorganized."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "910e41f8-6d50-474f-bdae-bfb81d3fcd2c",
                                "sense_id": "2a36eceb-e2f2-35b4-91c3-156590a5257e",
                                "text": "To fortify the most indigest and crude stomach, ay, were it of one that, through extreme weakness, vomited blood, applying only a warm napkin to the place, after the unction and fricace"
                            },
                            {
                                "example_id": "ed485d86-1281-4e67-a2e4-6ee5eb558d15",
                                "sense_id": "2a36eceb-e2f2-35b4-91c3-156590a5257e",
                                "text": "[M]onsters and things indigest […]"
                            },
                            {
                                "example_id": "1d1eebf5-916f-4554-8995-866205240edf",
                                "sense_id": "2a36eceb-e2f2-35b4-91c3-156590a5257e",
                                "text": "Me thinkes a troubled thought is thus expreſt, / To be a Chaos rude and indigeſt: […]"
                            }
                        ]
                    }
                ],
