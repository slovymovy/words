                "senses": [
                    {
                        "sense_id": "ebd0359e-4dfa-391d-b953-c339c3d2465e",
                        "entry_id": "fbb56a20-7235-3fda-a40b-861215a8ddcf",
                        "glosses": [
                            "Staat, der Mitglied in einem Bündnis ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22e5aef-7497-4f27-9049-5d2753e99dce",
                                "sense_id": "ebd0359e-4dfa-391d-b953-c339c3d2465e",
                                "text": "„Die Hoffnung bei der Euro-Einführung war, dass durch die Gemeinschaftswährung das Zinsniveau in allen Mitgliedsstaaten nach unten konvergiert und dadurch die wirtschaftliche Entwicklung begünstigt wird.“"
                            },
                            {
                                "example_id": "be5842a3-0ea6-411a-ae08-bc3a180645c0",
                                "sense_id": "ebd0359e-4dfa-391d-b953-c339c3d2465e",
                                "text": "„Nun, 70 Jahre nach der Gründung, diskutierten die Verteidigungsminister der Mitgliedsstaaten Strategien gegen einen Gegner, der nicht eindeutig zu benennen war, sondern einen nebulösen oder gar imaginären Charakter aufwies.“"
                            },
                            {
                                "example_id": "77878396-389a-4185-8efa-4f562d3e1696",
                                "sense_id": "ebd0359e-4dfa-391d-b953-c339c3d2465e",
                                "text": "„Eine Besonderheit der Europawahl ist, dass sie von den 27 Mitgliedsstaaten nicht einheitlich organisiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
