                "senses": [
                    {
                        "sense_id": "07fdc268-0e6a-3ca1-9487-3d840a5c1d7d",
                        "entry_id": "17a11096-74bd-3752-83f2-2dc6861d68f0",
                        "glosses": [
                            "przestrzeń wokół Słońca ograniczona zasięgiem występowania wiatru słonecznego (zwykle w liczbie pojedynczej)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bbdbc4e-2e9c-4418-b56a-c6f9a9c9b9c4",
                                "sense_id": "07fdc268-0e6a-3ca1-9487-3d840a5c1d7d",
                                "text": "Region wokół heliopauzy działa (…) jak tarcza ochronna, znacznie redukując ilość promieniowania kosmicznego docierającego do wnętrza heliosfery."
                            },
                            {
                                "example_id": "ececb401-03f4-4cfa-897f-6af3a443efe5",
                                "sense_id": "07fdc268-0e6a-3ca1-9487-3d840a5c1d7d",
                                "text": "Granica heliosfery, heliopauza, otacza cały Układ Słoneczny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef2d458f-8ced-4542-8598-a35fbd012677",
                        "source_entry_id": "17a11096-74bd-3752-83f2-2dc6861d68f0",
                        "source_sense_id": "07fdc268-0e6a-3ca1-9487-3d840a5c1d7d",
                        "target_lang_word": "heliosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heliosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "490e9b77-82a4-3e6c-9754-50f317d69c75",
                                        "entry_id": "a2675cac-76fb-3250-9dff-17ec0f087016",
                                        "glosses": [
                                            "The region of space where interstellar medium is blown away by solar wind; the boundary, heliopause, is often considered the edge of the Solar System."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9a5e5d-6e01-43d6-9277-fd7c5da71fb7",
                                                "sense_id": "490e9b77-82a4-3e6c-9754-50f317d69c75",
                                                "text": "The heliosphere isn’t really a sphere at all, more an elongated teardrop shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abae5a98-d655-4222-9b94-6cdbd8d4919a",
                        "source_entry_id": "17a11096-74bd-3752-83f2-2dc6861d68f0",
