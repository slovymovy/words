                            {
                                "example_id": "c675ea18-9d87-4c23-a691-1ff9fbbd4fbc",
                                "sense_id": "1dbd411c-62f4-3c2d-87d8-fd6399df05d8",
                                "text": "Et, la conscience faussement tranquille, le dactyloscope va-t-il étayer le mouchard, truquer son rapport, conclure plus outre qu’il ne voit, et mettre la science au renfort de l’indication ?"
                            }
                        ]
