                ],
                "senses": [
                    {
                        "sense_id": "89897a54-3045-3f3d-9187-ee3b3e4740f7",
                        "entry_id": "24fd66b0-c30c-3ba0-90c1-d18e0424a459",
                        "glosses": [
                            "Beweis, Nachweis"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "295aa1b2-dc38-4f1c-b1a5-ec40d946dd12",
                                "sense_id": "89897a54-3045-3f3d-9187-ee3b3e4740f7",
                                "text": "Paulus deutet den Kreuzestod meist als Sühneopfer. In Römer 3 schreibt er über Jesus: \"Den hat Gott für den Glauben hingestellt als Sühne in seinem Blut zum Erweis seiner Gerechtigkeit.\""
                            },
                            {
                                "example_id": "77c71268-7c24-4e7d-bb4e-1affd497aba3",
                                "sense_id": "89897a54-3045-3f3d-9187-ee3b3e4740f7",
                                "text": "Das ästhetische Erleben des Koran zeigt: Ihre Schönheit galt als Erweis ihrer göttlichen Herkunft!"
                            },
                            {
                                "example_id": "5f41b6f3-a2ca-4826-aaa7-7979f0250322",
                                "sense_id": "89897a54-3045-3f3d-9187-ee3b3e4740f7",
                                "text": "Der Erweis der eigenen Unentbehrlichkeit wird den Geisteswissenschaften unversehens zum ersten Gebot – zum Prüfstein dafür, wieviel von dem Geist, nach dem sie sich nennen, noch in ihnen steckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
