                    {
                        "translation_id": "22379033-a08f-49fc-b877-1bf2cc68495d",
                        "source_entry_id": "b869eee0-d1a3-3cf8-9faa-05e788095e10",
                        "source_sense_id": "610c9994-5d70-3d6d-81cb-f5be4caffe06",
                        "source_sense_description": "the act of digging up that which has been buried",
                        "target_lang_word": "эксгума́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эксгума́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                        "entry_id": "200c8a7d-aab9-3c04-baee-8fa798b42f57",
                                        "glosses": [
                                            "офиц., юр. извлечение (выкапывание) уже погребенного трупа (останков) из земли (места погребения), для проведения судебно-медицинской экспертизы, научного исследования, повторного перезахоронения в другом месте, или с преступной целью разграбления могилы (могил)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a50d06e-0cd8-4b8f-9057-a64c07c5aea3",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Что касается экспертизы по обнаружению амитал-натрия, то она проводилась после эксгумации трупа через 5 месяцев после захоронения, и эксперты отметили в своем акте, что современная наука не располагает данными о сроках сохранения яда в трупе, к тому же находившемся длительное время в воде, а затем в земле."
                                            },
                                            {
                                                "example_id": "73d73888-cd27-4402-8a60-5afbd1020038",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Изучив документы, связанные с эксгумацией писателя, могу подтвердить, что народу при вскрытии могилы на кладбище Даниловского монастыря было много."
                                            },
                                            {
                                                "example_id": "a521cf01-afb9-4ab6-97a1-897eb3bb5016",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Но в 1952 году была проведена эксгумация и останки погибших были перезахоронены в братских могилах на кладбище в Хойне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
