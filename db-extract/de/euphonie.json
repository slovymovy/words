                        ],
                        "form": "die Euphonie"
                    },
                    {
                        "form_id": "ba9f3955-bd54-469a-8a8a-517b333ebbbc",
                        "entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Euphonien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                        "entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                        "glosses": [
                            "sprachlicher Wohlklang"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "55fa09fe-f0a4-4e2c-b4c6-de314276ef8e",
                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                "text": "„Untersucht man die phonische Seite von Gedichten, so hat man es immer mit der Euphonie zu tun.“"
                            },
                            {
                                "example_id": "fad0f190-aa6a-4653-b1f5-725149f209fc",
                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                "text": "Der Euphonie „dienen z.T. die Einschiebung von Lauten zur Vermeidung der Kakophonie oder die Regeln zur Vermeidung des Hiatus.“"
                            },
                            {
                                "example_id": "3dd280ff-a15a-4d22-9232-4c63d0c94c28",
                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                "text": "„Beim Übergang in andere Sprachen (und auch sonst in der Sprachgeschichte) werden Lautformen gelegentlich verändert um der Sprechbarkeit oder des Wohlklangs willen (Euphonie, euphonisch).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1c64f483-9eec-3e75-87b5-07878413ae85",
                        "entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                        "glosses": [
                            "musikalischer Wohlklang"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "5b7ad10f-1acd-44da-96ae-de200fa58b2c",
                                "sense_id": "1c64f483-9eec-3e75-87b5-07878413ae85",
                                "text": "„‚Kakophonie – Euphonie‘ versucht, zwei Extrembereiche der Musik, die ‚Kakophonie‘ alltäglicher Geräusche und die Euphonie kitschigen Schönklangs, zu ‚stimmen‘, wie man ein Instrument stimmt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6b767e2-03fc-4f9b-8e0b-bb989cc839b0",
                        "source_entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                        "source_sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                        "source_sense_description": "Linguistik/Literaturwissenschaft: sprachlicher Wohlklang",
                        "target_lang_word": "euphony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44e85da0-6083-396d-99c6-3f5b3d122de8",
                                        "entry_id": "61862f8a-5fd3-3a12-896d-0cab4e6498e5",
                                        "glosses": [
                                            "A pronunciation of letters and syllables which is pleasing to the ear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1537b41c-5435-448f-af2f-d03693e74891",
                                                "sense_id": "44e85da0-6083-396d-99c6-3f5b3d122de8",
                                                "text": "Mandalay. In the name there was a euphony which beckoned to the imagination, yet this was the bitter, withered reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74e0b5c-9519-3386-ba85-cbd601c2c2ba",
                                        "entry_id": "61862f8a-5fd3-3a12-896d-0cab4e6498e5",
                                        "glosses": [
                                            "Pleasant phonetic quality of certain words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3711a58b-e94e-4396-b9df-76d40b8475f0",
                                                "sense_id": "f74e0b5c-9519-3386-ba85-cbd601c2c2ba",
                                                "text": "When I hear you speak, I hear beautiful euphony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "000fc890-fff6-4684-b2d4-3a71e7ccd1db",
                        "source_entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                        "source_sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                        "source_sense_description": "Linguistik/Literaturwissenschaft: sprachlicher Wohlklang",
                        "target_lang_word": "euphonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                                        "glosses": [
                                            "Ce qui rend la prononciation plus douce et plus coulante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c241ab6-baa8-46fc-bbe4-64a97aca52e8",
                                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                                "text": "Admettre, ainsi que le veulent certains volapükistes, qu'il y a des principes d’euphonie ou d’harmonie, qui doivent guider l'élèves dans le choix des tournures ou dans la construction des phrases, ce serait oublier qu’Orientaux et Occidentaux établissent l’euphonie grammaticale sur des bases complétement différentes, et confier les destinées de la langue aux caprices des esprits irréfléchis."
                                            },
                                            {
                                                "example_id": "83bb2be7-ec31-4b58-a2a0-11bf225ac7da",
                                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                                "text": "Sensible à la seule euphonie, leur maître les nommait Black et Bianca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                                        "glosses": [
                                            "Harmonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc7ce2c-ca12-4356-9f7f-86cde8c9087d",
                                                "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                                                "text": "Quel plaisir de se retremper dans l’euphonie multisonore des cordes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
