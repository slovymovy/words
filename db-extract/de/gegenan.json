                "senses": [
                    {
                        "sense_id": "97174688-da15-33e9-b5a3-7b9d87e77723",
                        "entry_id": "1a7a7c32-af44-3c95-a5e5-1e0a228c4bfb",
                        "glosses": [
                            "in Richtung auf etwas zu, das einen abhalten will; schützend vor etwas, das einen angreift; im Versuch begriffen, etwas zu bewältigen"
                        ],
                        "tags": [
                            "eher in Wortbildungen als einzeln stehend"
                        ],
                        "examples": [
                            {
                                "example_id": "1125a026-e938-44aa-9b3f-e39552416455",
                                "sense_id": "97174688-da15-33e9-b5a3-7b9d87e77723",
                                "text": "„Der Wind frischte inzwischen wieder stark auf und blies, als sich die ‚Gazelle‘ dem Aldrich-Kanal näherte, mit einer solchen Heftigkeit, dass sie mit den geheizten zwei Kesseln nicht mehr gegenan dampfen konnte.“"
                            },
                            {
                                "example_id": "052b9240-0e36-4858-a08d-903e54eba78f",
                                "sense_id": "97174688-da15-33e9-b5a3-7b9d87e77723",
                                "text": "„Wir ruderten in seines Vaters Boot stromauf, bis wir nicht mehr gegenan kamen, ließen uns zurück in die Bucht treiben.“"
                            },
                            {
                                "example_id": "d321375d-2791-4e47-b122-b674c5458a62",
                                "sense_id": "97174688-da15-33e9-b5a3-7b9d87e77723",
                                "text": "„Bundesjustizminister Heinemann bestätigt dir ohne weiteres, daß die Gerichte sowieso nicht mehr gegenan können, und die Gefängnisse sind noch voller als die Galerie Commeter bei der Eröffnung.“"
                            },
                            {
                                "example_id": "6acfb139-0cb2-43c1-9d12-2ca9c89308a4",
                                "sense_id": "97174688-da15-33e9-b5a3-7b9d87e77723",
                                "text": "„Diese Methode gibt aber nur unter gewöhnlichen Verhältnissen genügend genaue Ergebnisse, bei außergewöhnlichen, starker Wind und See gegenan oder von achtern, versagt sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
