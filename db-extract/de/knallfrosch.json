                                    {
                                        "sense_id": "4d6e364e-94a2-3189-b059-8a84d73fc312",
                                        "entry_id": "050a5af1-0e31-363c-bbd4-56c604a2c9c7",
                                        "glosses": [
                                            "A peanut butter cracker baked with marijuana, similar in concept to an Alice B. Toklas brownie."
                                        ],
