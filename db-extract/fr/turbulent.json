                "senses": [
                    {
                        "sense_id": "86a4b955-979c-3b2f-961e-68f74c763ef7",
                        "entry_id": "fb028562-5c45-347e-8478-bd2df604855a",
                        "glosses": [
                            "Qui est impétueux, qui est porté à faire du bruit, à exciter du trouble, du désordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174f4a37-47aa-4716-8515-aa35ae10b0cd",
                                "sense_id": "86a4b955-979c-3b2f-961e-68f74c763ef7",
                                "text": "Suivant le caractère des barbares, dont la fougue est violente, mais de peu de durée, ils se réconcilièrent en faisant de nouveau le serment de ne rien entreprendre l’un contre l’autre. Tous deux étaient d’un naturel turbulent, batailleur et vindicatif ; […]."
                            },
                            {
                                "example_id": "f55d63f8-f79a-4460-966d-e5ef5efe6b85",
                                "sense_id": "86a4b955-979c-3b2f-961e-68f74c763ef7",
                                "text": "Le palais des papes est à nous! Les petits hommes turbulents du XXᵉ siècle font, en ces jours d'exposition, nasiller leurs gramophones sous la majesté de ces murailles,..."
                            },
                            {
                                "example_id": "b48e44ca-dbaa-4895-b16b-7b80d2e08da2",
                                "sense_id": "86a4b955-979c-3b2f-961e-68f74c763ef7",
                                "text": "Chose certaine, Colborne envisage déjà une expédition militaire pour ramener à l’ordre les turbulents villages du Richelieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca7ea7f7-386f-3386-aeb8-53610731c458",
                        "entry_id": "fb028562-5c45-347e-8478-bd2df604855a",
                        "glosses": [
                            "Qui s’écoule à une grande vitesse de manière cahotique, en parlant d’un fluide visqueux."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "afb331ba-fce3-427e-8497-8f0f9aa0b7c3",
                                "sense_id": "ca7ea7f7-386f-3386-aeb8-53610731c458",
                                "text": "L’écoulement turbulent déplacera non seulement presque toute la boue circulable, mais détruira aussi les couches tendres de cake par une action décapante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ae6090d-1d10-420d-b4e8-fa929be41ad5",
                        "source_entry_id": "fb028562-5c45-347e-8478-bd2df604855a",
                        "source_sense_id": "86a4b955-979c-3b2f-961e-68f74c763ef7",
                        "source_sense_description": "Qui est impétueux, qui est porté à faire du bruit, à exciter du trouble, du désordre.",
                        "target_lang_word": "unruly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unruly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                        "entry_id": "6bf5d0d0-edc1-3d38-a824-3099ae290578",
                                        "glosses": [
                                            "Wild; uncontrolled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7e52af-fcb2-48a3-9b22-053d879209e9",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "The police gathered to contain the unruly mob."
                                            },
                                            {
                                                "example_id": "350e0013-bd71-4599-9a4a-24ca9881fec6",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "Unruly boys who will not grow up / Must be taken in hand / Unruly girls who will not settle down / They must be taken in hand"
                                            },
                                            {
                                                "example_id": "0bb772af-828d-4ba8-92aa-f9873e7d4c37",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "Richard DeLongpre: Are you okay, my boy angel?\nAllen Gregory DeLongpre: I have a broken heart. And undergarments filled with my own unruly waste."
                                            },
                                            {
                                                "example_id": "cca92e6e-f94a-4020-b18b-1a218947bfba",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "The bar had two entrances, one on Barrow and another via Bedford, and “86” referred to the address of the door from which intoxicated or unruly guests would be ejected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce0b17a0-774d-4bb6-94f8-bd522bf70e1e",
                        "source_entry_id": "fb028562-5c45-347e-8478-bd2df604855a",
                        "source_sense_id": "ca7ea7f7-386f-3386-aeb8-53610731c458",
