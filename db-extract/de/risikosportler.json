                "senses": [
                    {
                        "sense_id": "2496c574-0a8e-3ad1-87ee-69679f3cf7fe",
                        "entry_id": "354d4dac-0b2f-38f4-a4bc-e9248a3d4a94",
                        "glosses": [
                            "Person, die Sport betreibt, der sich durch hohe physische und psychische Belastungen auszeichnet und bei dem Gefahren bewusst in Kauf genommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6803db3d-fa15-4ef3-9569-6f5dc18a7ef4",
                                "sense_id": "2496c574-0a8e-3ad1-87ee-69679f3cf7fe",
                                "text": "„Der Schweizer Risikosportler Yves Rossy hat am Freitag als erster Mensch mit einem Jetflügel auf dem Rücken den Ärmelkanal überquert.“"
                            },
                            {
                                "example_id": "610d3761-7ccf-43a7-8da6-49b236b8f0f5",
                                "sense_id": "2496c574-0a8e-3ad1-87ee-69679f3cf7fe",
                                "text": "„Dieser Eindruck verdichtet sich in der Tat immer dann, wenn Risikosportler nicht sachlich und objektiv über ihre Erlebnisse berichten, sondern euphorisch übersteigert in Heldentaten schwelgen, […] mit Fliegerlatein die Wirklichkeit zu überhöhen versuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
