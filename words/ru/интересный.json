    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65107419-0a22-3398-8555-db77c32a46c8",
                    "sense_definition": "Вызывающий любопытство, привлекающий внимание.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "интерес",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моё внимание привлёк <w>интересный</w> документ, лежавший на столе прямо передо мной.",
                            "target_lang_translations": {
                                "de": "Meine Aufmerksamkeit wurde auf ein <w>interessantes</w> Dokument gelenkt, das direkt vor mir auf dem Tisch lag."
                            }
                        },
                        {
                            "text": "Мы прочитали очень <w>интересную</w> книгу о путешествиях по всему миру.",
                            "target_lang_translations": {
                                "de": "Wir haben ein sehr <w>interessantes</w> Buch über Reisen um die ganze Welt gelesen."
                            }
                        }
                    ],
                    "synonyms": [
                        "занимательный",
                        "любопытный",
                        "увлекательный"
                    ],
                    "antonyms": [
                        "скучный",
                        "неинтересный",
                        "безынтересный"
                    ],
                    "common_phrases": [
                        "интересный человек",
                        "интересный фильм",
                        "интересная книга"
                    ],
                    "target_lang_definitions": {
                        "de": "Neugier weckend, die Aufmerksamkeit auf sich ziehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "interessant",
                                "target_lang_sense_clarification": "allgemein für Dinge, die Aufmerksamkeit oder Interesse erregen"
                            },
                            {
                                "target_lang_word": "spannend",
                                "target_lang_sense_clarification": "wenn etwas fesselnd oder aufregend ist"
                            },
                            {
                                "target_lang_word": "unterhaltsam",
                                "target_lang_sense_clarification": "wenn etwas kurzweilig oder amüsant ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ac88053-1d64-38e2-a4d0-08d6cfa7f3a6",
                    "sense_definition": "Привлекательный для особ противоположного пола, красивый.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "привлекательность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она сразу обратила внимание на этого <w>интересного</w> мужчину.",
                            "target_lang_translations": {
                                "de": "Sie wurde sofort auf diesen <w>interessanten</w> Mann aufmerksam."
                            }
                        },
                        {
                            "text": "На вечеринке присутствовало много <w>интересных</w> женщин в красивых платьях.",
                            "target_lang_translations": {
                                "de": "Auf der Party waren viele <w>interessante</w> Frauen in schönen Kleidern anwesend."
                            }
                        }
                    ],
                    "synonyms": [
                        "привлекательный"
                    ],
                    "common_phrases": [
                        "интересный мужчина",
                        "интересная женщина"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Attraktiv, anziehend oder charismatisch wirkend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "attraktiv",
                                "target_lang_sense_clarification": "allgemein für eine anziehende äußere Erscheinung"
                            },
                            {
                                "target_lang_word": "interessant",
                                "target_lang_sense_clarification": "im Sinne von charismatisch oder faszinierend wirkend"
                            },
                            {
                                "target_lang_word": "anziehend",
                                "target_lang_sense_clarification": "eine Person, die eine besondere Ausstrahlung besitzt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}