                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae301831-990b-462a-9f1c-005a30ebc1fa",
                                                "sense_id": "9cd6e545-e607-3ab7-8a99-ccf3de545d92",
                                                "text": "Die Kürzung der Flügel vermindert die Flugeigenschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63257b09-3dbc-38ad-ba42-262ef9b16977",
                                        "entry_id": "78b629d1-a993-363a-8860-edcfd367d86b",
                                        "glosses": [
                                            "Verringerung, Verminderung (eines regelmäßig erhaltenen Geldbetrages)"
                                        ],
                                        "tags": [
                                            "finanziell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80cbe41a-3f89-43c1-8c2f-a9e93f69b6c1",
                                                "sense_id": "63257b09-3dbc-38ad-ba42-262ef9b16977",
                                                "text": "Die Firma sieht eine Kürzung der Löhne für 2009 vor."
                                            }
