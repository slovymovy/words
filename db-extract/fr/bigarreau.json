        "fr-extract.jsonl": [
            {
                "entry_id": "9d84cbd9-0a60-364a-a91e-1a6833a71dec",
                "word": "bigarreau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95742eb3-3dfb-4506-b062-13dbee330591",
                        "entry_id": "9d84cbd9-0a60-364a-a91e-1a6833a71dec",
                        "tags": [
                            "plural"
                        ],
                        "form": "bigarreaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                        "entry_id": "9d84cbd9-0a60-364a-a91e-1a6833a71dec",
                        "glosses": [
                            "Fruit du bigarreautier ; sorte de cerise rouge et blanche qui a la chair plus ferme que les autres cerises (Prunus avium)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16537e63-75ba-4b1b-add1-0eb0f36492dd",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "II y a le bigarreau tardif ou de fer, qui mûrit plus tard, & qui n’est pas si sujet aux vers que l’ordinaire : il fait un bel arbre.\nLe cœuret est une espece de bigarreau plus tendre & fait en cœur, dont le goût est relevé."
                            },
                            {
                                "example_id": "0d55edb7-aee1-496e-85b8-d284483e5d53",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "Nous nous frayons tant bien que mal un chemin entre des épaules de garçons fruitiers et des chignons de braves demoiselles dont les lèvres sont mûres comme des bigarreaux."
                            },
                            {
                                "example_id": "4ef92737-2cea-4d69-b084-2671e47b76af",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "Quand auras-tu fini, cria-t-elle, de tourner une mèche de cheveux autour du bout de ton nez ? Excellent moyen d’avoir le nez rouge et en forme de bigarreau !"
                            },
                            {
                                "example_id": "4360eceb-ccd0-4605-a27b-dfb5597aa2e6",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "Les cerises bicolores, rouges, jaunes ou noires ont pris tout naturellement le nom de bigarreaux. Elles sont plus sucrées que juteuses, la chair vieil ivoire ou rouge clair est ferme. Les bigarreaux sont les plus précoces des cerises."
                            },
                            {
                                "example_id": "1804b4bf-da36-4e1d-b301-7238a0d5572f",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "Les bigarreaux ont un pédoncule long et grêle, un fruit cordiforme avec un sillon longitudinal bien marqué et la chair est ferme."
                            },
                            {
                                "example_id": "feed785a-624d-4d1b-8451-6c1bf8f27d1a",
                                "sense_id": "03a7a8a4-a296-38bb-9967-e36c035fed46",
                                "text": "Rousseau n’est pas le seul grand écrivain à se délecter des cerises, Victor Hugo aussi se plaît à aller au verger cueillir des bigarreaux. Il en a même fait le titre d’un de ses poèmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "51ec91bc-add4-3bc4-81af-cfb2e376806c",
                        "entry_id": "9d84cbd9-0a60-364a-a91e-1a6833a71dec",
                        "glosses": [
                            "Se disait aussi de l’arbre qui porte ce fruit."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ca851ba5-0897-4c55-9649-8c65567f24f1",
                                "sense_id": "51ec91bc-add4-3bc4-81af-cfb2e376806c",
                                "text": "BIGARREAU, s. m. Sorte de cerise dure & ferme. ( Latin, cerasum duratinum. ) Graffione, sorta di ciriegia. Bigarreau se dit aussi de l’arbre même, qui s’appelle autrement Bigarreautier, ou Bigarrotier."
                            },
                            {
                                "example_id": "7aa7989c-1d9b-4233-95e1-4b99b58d5396",
                                "sense_id": "51ec91bc-add4-3bc4-81af-cfb2e376806c",
                                "text": "BIGARREAUTIER. s.m. Espèce de cerisier, arbre qui produit les bigarreaux. Cerusus duracinus. Voy. Cerisier. La Quintinie écrit bigarrotier. Il donne aussi le nom de bigarreau au bigarreautier. Le bigarreau, dit-il, a son fruit ferme, croquant, longuet & carré, mais toujours fort doux & fort agréable. Le bois en est fort gros, assez badinant, & la feuille longuette. Cela est contre l’usage."
                            }
                        ]
                    }
