                "senses": [
                    {
                        "sense_id": "0cd709e4-6725-37f7-bff2-84ec917a9a07",
                        "entry_id": "ccfb8614-5af8-3fc7-b297-1d4d02f0356d",
                        "glosses": [
                            "betrekking hebbend op of ontleend aan de Apocalyps"
                        ],
                        "tags": [],
