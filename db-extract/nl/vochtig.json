                                        "examples": [
                                            {
                                                "example_id": "c9e2bb74-f7a3-4544-9be1-b353cba46427",
                                                "sense_id": "3b26c5f5-95de-39ef-ae57-012bc8a37afd",
                                                "text": "Zasadniczo na grzybobranie można się wybrać przez cały rok, jednak najlepiej jest to robić jesienią, zwłaszcza jeśli końcówka lata była ciepła i wilgotna."
                                            },
                                            {
                                                "example_id": "d7bb50e3-5d06-47a6-a5b9-38fd937e0387",
                                                "sense_id": "3b26c5f5-95de-39ef-ae57-012bc8a37afd",
                                                "text": "Po naniesieniu kleju na powierzchnię można usunąć jego resztki wilgotną szmatką."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
