            {
                "entry_id": "862c15c2-fdd7-3e8f-b5d9-3ac6b52e01dd",
                "word": "crowdfunding",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67799168-a845-3891-93e9-4bfb6fac3425",
                        "entry_id": "862c15c2-fdd7-3e8f-b5d9-3ac6b52e01dd",
                        "glosses": [
                            "Financement d’un projet à l’aide d’outils et de méthodes de transactions financières participatifs auquel prend part un grand nombre de personnes, spécialement à l’aide d’Internet."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "24e2a1d8-e7dc-4015-8d94-0b8ab7c15198",
                                "sense_id": "67799168-a845-3891-93e9-4bfb6fac3425",
                                "text": "Une campagne de crowdfunding a d’ailleurs été lancée. Le but est de réunir la maximum de dons pour aider les clubs de sauvetage côtier de Nouvelle-Aquitaine à acquérir du matériel et développer la formation des jeunes MNS."
                            },
                            {
                                "example_id": "e1eb8b6c-1608-43b3-8ad4-08b72a638e3e",
                                "sense_id": "67799168-a845-3891-93e9-4bfb6fac3425",
                                "text": "\"Nous cherchons à décrocher la médaille d'or du crowdfunding\", a souligné ce vendredi Fleur Pellerin qui a estimé que la réforme \"pourrait contribuer de manière positive au retour de la croissance\"."
                            }
                        ]
                    }
