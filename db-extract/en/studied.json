        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "04ba6d24-bd83-3eed-b327-dcfbac7b3dfd",
                "word": "studied",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41548ba4-6f24-388a-95b5-2bceaf18511b",
                        "entry_id": "04ba6d24-bd83-3eed-b327-dcfbac7b3dfd",
                        "glosses": [
                            "Practiced; self-conscious; careful; not spontaneous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d50fb2-4cde-4f0f-ba0e-224407ca3bd1",
                                "sense_id": "41548ba4-6f24-388a-95b5-2bceaf18511b",
                                "text": "She gave a studied reply."
                            },
                            {
                                "example_id": "7b16968f-441b-4722-a2cf-d9ca5817e5cb",
                                "sense_id": "41548ba4-6f24-388a-95b5-2bceaf18511b",
                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b23f6c4e-59cd-3f0c-a3f2-fbd9df24e26a",
                        "entry_id": "04ba6d24-bd83-3eed-b327-dcfbac7b3dfd",
                        "glosses": [
                            "Qualified by, or versed in, study; learned."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6d7e33-abbe-40f2-8a3a-22f49cc93c62",
                                "sense_id": "b23f6c4e-59cd-3f0c-a3f2-fbd9df24e26a",
                                "text": "He is well studied in theology."
                            },
                            {
                                "example_id": "2fdbe9ec-00d5-422f-8dec-739a8e690c52",
                                "sense_id": "b23f6c4e-59cd-3f0c-a3f2-fbd9df24e26a",
                                "text": "I asked a man well read, well studied in Nietzsche, what the lifelong task was. He could not say. He had only read and studied and loved Nietzsche’s books."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
