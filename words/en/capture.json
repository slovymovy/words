                                "target_lang_word": "yakalamak",
                                "target_lang_sense_clarification": "görüntü veya anı"
                            },
                            {
                                "target_lang_word": "kaydetmek",
                                "target_lang_sense_clarification": "ses veya veri"
                            },
                            {
                                "target_lang_word": "ölümsüzleştirmek",
                                "target_lang_sense_clarification": "fotoğraf veya görüntü ile"
                            }
                        ],
                        "zh": [
