                "senses": [
                    {
                        "sense_id": "78b00083-4910-3ac0-b68d-76956cbf8ad6",
                        "entry_id": "d845e905-4bf2-3ffe-badb-abb2371e29a9",
                        "glosses": [
                            "Débarrasser (un chien) de ses hardes qui le tiennent attaché à un autre chien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "486347c8-8b76-4286-9925-58156e66c1e2",
                                "sense_id": "78b00083-4910-3ac0-b68d-76956cbf8ad6",
                                "text": "On ne dit pas harder des chiens mais prendre des chiens à la harde : les chiens se hardent lorsqu’en avançant ils se mêlent et s’embarrassent dans leurs couples ; le valet de chiens pour lors s’arrête et met chacun d’eux à sa place, ce qui s’appelle déharder."
                            },
                            {
                                "example_id": "4f18e778-02f6-4588-9a44-553ccbca5f83",
                                "sense_id": "78b00083-4910-3ac0-b68d-76956cbf8ad6",
                                "text": "Fin novembre, début décembre, il s’est « déhardé » et est parti seul, ou parfois avec un ou deux autres mâles, ses adversaires d’hier, redevenus compagnons d’aujourd'hui."
                            }
                        ]
                    }
                ],
