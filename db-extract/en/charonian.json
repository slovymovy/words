                        "glosses": [
                            "Of or relating to Charon."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "27fcaae2-ad4a-4ec6-8375-0d7360fd545e",
                                "sense_id": "d35119fe-81ee-3c92-a67d-14483bb900e0",
                                "text": "[It] possessed the six legs characteristic of Charonian life"
                            },
                            {
                                "example_id": "74bfb631-9925-46af-8594-33053b61008b",
                                "sense_id": "d35119fe-81ee-3c92-a67d-14483bb900e0",
                                "text": "The Charonian journey will soon be taken."
                            },
                            {
                                "example_id": "bcfaff3d-76aa-4239-b9c4-9dd2d486ddea",
                                "sense_id": "d35119fe-81ee-3c92-a67d-14483bb900e0",
                                "text": "The Elysian plain, near the Catacombs in Egypt, stood upon the foul Charonian canal: which was so noisome, that every fetid ditch and cavern was from it called Charonian. [...] Pliny speaking of some Charonian hollows in Italy, says that the exhalations were insupportable."
                            },
                            {
                                "example_id": "6d6f2cab-d973-40b5-bc26-afa3087cf59b",
                                "sense_id": "d35119fe-81ee-3c92-a67d-14483bb900e0",
                                "text": "Although this casts doubt on an intrinsic source for a present-day Charonian atmosphere, it is possible that Elliot & Young's result can be understood if Charon's gravity causes it to collect escaping gas from Pluto."
                            }
                        ]
                    }
                ],
                "translations": [],
