                ],
                "senses": [
                    {
                        "sense_id": "8ab1b29a-b790-3dd4-b6d8-4646bca226b3",
                        "entry_id": "69984084-f060-3953-b68a-c4980cfed92c",
                        "glosses": [
                            "groot eiland ten noordoosten van Canada, deel uitmakend van het koninkrijk Denemarken dat plotseling extra in de aandacht staat omdat mannetje Trump dit graag bij de Verenigde Staten wil inlijven"
                        ],
                        "tags": [
                            "toponiem: eiland"
                        ],
                        "examples": [
                            {
                                "example_id": "a724c4cb-1d78-462b-bf9f-cfe2798dce29",
                                "sense_id": "8ab1b29a-b790-3dd4-b6d8-4646bca226b3",
                                "text": "Een Marsbewoner die met een krankzinnige Amerikaanse president onderhandelt over het ruilen van Groenland tegen de rode planeet. Alleen heeft de riskende Amerikaanse dictator dat Groenland nog niet in zijn bezit. Dat moet hij nog veroveren. Of dat gaat lukken is niet zeker omdat zijn leger bestaat uit soldaten met ernstige psychologische beperkingen die het waarschijnlijk niet gaan redden tegen twaalf Deense krijgers en hun goed getrainde sledehonden. Dat komt volgens de president door zijn dementerende voorganger die diversiteit en inclusie belangrijker vond dan militair vakmanschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "07cf913a-0b6e-3d13-87f6-feeb8f00358b",
                        "entry_id": "69984084-f060-3953-b68a-c4980cfed92c",
                        "glosses": [
                            "een autonome regio binnen Denemarken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a45283-fcf9-449b-8457-2c590698ba06",
                                "sense_id": "07cf913a-0b6e-3d13-87f6-feeb8f00358b",
                                "text": "Trump zegt afspraak Deense premier af na weigering Groenland te verkopen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "364a09d3-9f82-4813-ac99-f436a3ef2f05",
                        "source_entry_id": "69984084-f060-3953-b68a-c4980cfed92c",
                        "source_sense_id": "8ab1b29a-b790-3dd4-b6d8-4646bca226b3",
                        "source_sense_description": "een groot eiland ten noordoosten van Canada, deel uitmakend van het koninkrijk Denemarken",
                        "target_lang_word": "Grönland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grönland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                        "entry_id": "67ee84d8-b020-3cff-988e-267c9c747c5a",
                                        "glosses": [
                                            "größte Insel der Erde, autonomer Bestandteil Dänemarks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099e9f28-8f55-4ad8-a046-b35454122e73",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "Man kann auch auf Grönland Urlaub machen."
                                            },
                                            {
                                                "example_id": "b837b6fc-1e62-4687-8ec1-1ed4610679e5",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "Das Grönland der Wikingerzeit war anders als das heutige."
                                            },
                                            {
                                                "example_id": "92b59d2f-da68-467e-b82b-d8c63ecccb76",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            },
                                            {
                                                "example_id": "d40b4310-1049-4abd-97e4-932ce6cf6c74",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Dänische Forscher sind überzeugt, an der Südwestküste Grönlands den größten Meteoritenkrater der Welt gefunden zu haben.“"
                                            },
                                            {
                                                "example_id": "d66e1915-b806-4f52-8aa4-7e30582d7a9e",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Frühe Archäologen und Anthropologen fanden immer mehr Ähnlichkeiten zwischen den indigenen Bevölkerungen der polaren Regionen Sibiriens, Nordamerikas und Grönlands.“"
                                            },
                                            {
                                                "example_id": "9db3f50f-4641-4589-a2c3-4e5d649c03d3",
                                                "sense_id": "ab689c05-7d54-32b5-9f5c-e19cd22ecf38",
                                                "text": "„Ich erinnerte mich an ihn in Grönland, bevor meine Mutter starb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
