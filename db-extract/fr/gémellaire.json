                    }
                ],
                "senses": [
                    {
                        "sense_id": "30c21084-1d2b-381b-82ca-4fced12aaa98",
                        "entry_id": "61ad5380-b8a8-3d15-932f-2b5b03c4a157",
                        "glosses": [
                            "Qui concerne les jumeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2894ccf2-534b-4381-bfbc-0f2ad7bc6936",
                                "sense_id": "30c21084-1d2b-381b-82ca-4fced12aaa98",
                                "text": "Le mythe gémellaire, très courant en milieu indo-européen, est aussi très répandu dans le folklore universel."
                            },
                            {
                                "example_id": "91252d15-dd20-4ffb-9681-94e990ed4e17",
                                "sense_id": "30c21084-1d2b-381b-82ca-4fced12aaa98",
                                "text": "Pour autant, toutes n’y sont pas éligibles : une grossesse gémellaire, un diabète ou encore de l’hypertension sont autant de facteurs de risque éliminatoires, tout comme un trop grand éloignement d’une maternité."
                            }
                        ]
                    },
                    {
                        "sense_id": "260cba9f-240f-3a50-b47a-4e84e7802136",
                        "entry_id": "61ad5380-b8a8-3d15-932f-2b5b03c4a157",
                        "glosses": [
                            "Qui concerne deux personnes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "801fb5c8-5b58-43b0-bff3-ac4469dc71cc",
                                "sense_id": "260cba9f-240f-3a50-b47a-4e84e7802136",
                                "text": "– Deux filles, ça ne vous effraie pas ?\n– Nullement, répondit-il sur le ton d’un homme accoutumé aux prouesses, alors qu’il était neuf aux voluptés gémellaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "facd64b0-832c-4784-8d64-8ffef0d5f553",
                        "source_entry_id": "61ad5380-b8a8-3d15-932f-2b5b03c4a157",
