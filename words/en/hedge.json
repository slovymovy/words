{
    "word_family": [
        "hedgerow",
        "hedger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fab8a5f3-27b7-3543-81e8-50f581428148",
                    "sense_definition": "A row of bushes or small trees planted close together, especially to form a boundary or fence between fields or gardens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon trimming the <w>hedge</w> in the garden. ",
                            "target_lang_translations": {
                                "zh": "他花了一下午时间修剪花园里的<w>树篱</w>。"
                            }
                        },
                        {
                            "text": "They decided to trim the <w>hedge</w> along the driveway to make it look neat.",
                            "target_lang_translations": {
                                "zh": "他们决定修剪车道旁的<w>树篱</w>，使其看起来整洁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trim the hedge",
                        "cut the hedge",
                        "privet hedge"
                    ],
                    "target_lang_definitions": {
                        "zh": "由灌木或小树紧密种植而成的行，通常用作田地或花园之间的边界或围栏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "树篱",
                                "target_lang_sense_clarification": "指由灌木或树木组成的边界。"
                            },
                            {
                                "target_lang_word": "绿篱",
                                "target_lang_sense_clarification": "指修剪整齐的灌木篱笆。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "000ce934-b03a-392d-b463-0bf48d34802b",
                    "sense_definition": "A financial investment or arrangement made to reduce the risk of adverse price movements in an asset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gold is often seen as a good <w>hedge</w> against inflation.",
                            "target_lang_translations": {
                                "zh": "黄金常被视为一种良好的抗通胀<w>对冲</w>手段。"
                            }
                        },
                        {
                            "text": "Investing in commodities provided a reliable <w>hedge</w> against inflation.",
                            "target_lang_translations": {
                                "zh": "投资大宗商品提供了可靠的抗通胀<w>套期保值</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hedge against inflation",
                        "hedge against risk"
                    ],
                    "target_lang_definitions": {
                        "zh": "为减少资产价格不利波动风险而进行的金融投资或安排。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "套期保值",
                                "target_lang_sense_clarification": "金融术语，指通过对冲手段规避风险。"
                            },
                            {
                                "target_lang_word": "对冲",
                                "target_lang_sense_clarification": "指通过反向操作来抵消风险。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a86b91f5-3397-3d4c-b42c-41cd930f4754",
                    "sense_definition": "A calculated statement that avoids making a direct commitment or definitive statement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His answer contained a careful <w>hedge</w> to avoid taking a clear stance.",
                            "target_lang_translations": {
                                "zh": "他的回答中包含了一些谨慎的<w>模棱两可的话</w>，以避免明确表态。"
                            }
                        },
                        {
                            "text": "The politician added a subtle <w>hedge</w> to her response during the interview.",
                            "target_lang_translations": {
                                "zh": "这位政治家在采访中回答时，巧妙地加了一句<w>推诿之词</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种经过计算的、避免做出直接承诺或明确表态的言辞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模棱两可的话",
                                "target_lang_sense_clarification": "指含糊其辞、不明确的表态。"
                            },
                            {
                                "target_lang_word": "推诿之词",
                                "target_lang_sense_clarification": "指为了回避责任或承诺而说的模糊话语。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d26a7e13-499e-32ea-a7c5-6db498bcdb3d",
                    "sense_definition": "To protect oneself against loss or risk, especially by making balancing investments or bets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often buy gold to <w>hedge</w> against economic uncertainty.",
                            "target_lang_translations": {
                                "zh": "投资者经常购买黄金以<w>规避</w>经济不确定性带来的风险。"
                            }
                        },
                        {
                            "text": "Many companies <w>hedge</w> their bets by investing in multiple industries.",
                            "target_lang_translations": {
                                "zh": "许多公司通过投资多个行业来分散风险，<w>规避</w>单一投资的损失。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hedge your bets",
                        "hedge against risk"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过平衡投资或下注来保护自己免受损失或风险。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "套期保值",
                                "target_lang_sense_clarification": "指通过金融手段规避风险。"
                            },
                            {
                                "target_lang_word": "规避风险",
                                "target_lang_sense_clarification": "指采取措施减少潜在损失。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3c3104-e6c2-3060-b599-ecc9b3e33f69",
                    "sense_definition": "To avoid giving a direct, clear, or definite answer or commitment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked about his future plans, he began to <w>hedge</w> and change the subject.",
                            "target_lang_translations": {
                                "zh": "当被问及未来计划时，他开始<w>含糊其辞</w>并转移话题。"
                            }
                        },
                        {
                            "text": "The spokesperson tried to <w>hedge</w> when pressed for specific details.",
                            "target_lang_translations": {
                                "zh": "当被追问具体细节时，发言人试图<w>闪烁其词</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parry",
                        "shuffle"
                    ],
                    "target_lang_definitions": {
                        "zh": "避免给出直接、明确或肯定的回答或承诺。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "含糊其辞",
                                "target_lang_sense_clarification": "指说话不明确，故意回避问题。"
                            },
                            {
                                "target_lang_word": "闪烁其词",
                                "target_lang_sense_clarification": "指说话躲躲闪闪，不肯正面回答。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb03feb-b781-3f06-82a9-71f8a127f619",
                    "sense_definition": "To surround or enclose an area with a hedge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>hedge</w> the entire property with fast-growing shrubs.",
                            "target_lang_translations": {
                                "zh": "他们计划用生长迅速的灌木将整个房产<w>围住</w>。"
                            }
                        },
                        {
                            "text": "The garden was neatly <w>hedged</w> with green bushes.",
                            "target_lang_translations": {
                                "zh": "花园被绿色的灌木整齐地<w>围了起来</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用树篱环绕或围住某区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用树篱围住",
                                "target_lang_sense_clarification": "指用植物作为围栏。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9b95fbad-fc14-3c12-af8e-3de7afc2e944",
                    "sense_definition": "A English surname derived from living near a hedge or boundary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Hedge</w> gave an inspiring lecture on history.",
                            "target_lang_translations": {
                                "zh": "<w>赫奇</w>教授做了一场鼓舞人心的历史讲座。"
                            }
                        },
                        {
                            "text": "We met Mr. <w>Hedge</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "zh": "我们昨天在会议上见到了<w>赫奇</w>先生。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源于居住在树篱或边界附近的英语姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赫奇",
                                "target_lang_sense_clarification": "音译姓氏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}