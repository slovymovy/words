                "senses": [
                    {
                        "sense_id": "85d5ff89-5506-382a-a02d-b92117109e27",
                        "entry_id": "44c4d60c-6de5-33a9-ab64-c6c254a61188",
                        "glosses": [
                            "Nachgehen einer Tätigkeit, eines Vorhabens, eines Bestrebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c3868a-d074-4c99-988f-aa9cb60f3893",
                                "sense_id": "85d5ff89-5506-382a-a02d-b92117109e27",
                                "text": "„Auf eine Weiterverfolgung des Kreditgeschäftes ist zu verzichten.“"
                            },
                            {
                                "example_id": "21a05816-67ae-417c-9fda-c8d8624d4655",
                                "sense_id": "85d5ff89-5506-382a-a02d-b92117109e27",
                                "text": "„Ein Unternehmen bietet die Prüfung eines Bußgeldbescheids und bei Erfolgsaussicht eine Weiterverfolgung des Verfahrens an.“"
                            },
                            {
                                "example_id": "3fc591b7-4a12-485f-99d9-9555a74d0c5c",
                                "sense_id": "85d5ff89-5506-382a-a02d-b92117109e27",
                                "text": "„Die Bühnen in Wien und Bremen hatten den Entwurf 1795 und 1800 abgelehnt, und nachdem Friedrich Schiller seinem Weimarer Freund von einer Weiterverfolgung des Plans abgeraten hatte, veröffentlichte dieser sein Libretto 1802 als Fragment.“"
                            },
                            {
                                "example_id": "84c0229b-4051-4a00-a4a4-d4d4ce1616e9",
                                "sense_id": "85d5ff89-5506-382a-a02d-b92117109e27",
                                "text": "„Im Zentrum stand die Weiterverfolgung der Beschlüsse des dritten Gipfeltreffens des Europarats vom Mai 2005.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
