                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27541b1e-5a32-423e-ba57-9ba3e380858b",
                                                "sense_id": "91ebf60e-8991-315e-b722-863e7b61901d",
                                                "text": "I was roused from unconsciousness by the alarm clock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de5a754-f175-37c8-a9cd-a827f8ad6750",
                                        "entry_id": "037c7ff0-1d17-3346-a591-839ba9cc63d6",
