        "de-extract.jsonl": [
            {
                "entry_id": "61c6db8e-61d4-326a-9cc5-36f231a3842a",
                "word": "practitioner",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e150c72-3e22-3cb8-ad02-1adf2ecac5be",
                        "entry_id": "61c6db8e-61d4-326a-9cc5-36f231a3842a",
                        "glosses": [
                            "Allgemeinmediziner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8878c668-27d5-48d3-9092-1b7bf2016808",
                                "sense_id": "3e150c72-3e22-3cb8-ad02-1adf2ecac5be",
                                "text": "\"So your grave, middle-aged family practitioner vanishes into thin air, my dear Watson, and there emerges a young fellow under thirty, amiable, unambitious, absent-minded, and the possessor of a favourite dog, which I should describe roughly as being larger than a terrier and smaller than a mastiff.\"",
                                "translation": "Also Ihr gravitätischer Hausarzt mittleren Alters löst sich in Luft auf, mein lieber Watson, und hervorkommt ein junger Mann unter dreißig, freundlich, anspruchslos, zerstreut, und der Besitzer eines Lieblingshundes, den ich in etwa beschreiben sollte als größer als ein Terrier und kleiner als eine Dogge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2db75365-0e1d-4c26-aec5-2ac84b83042d",
                        "source_entry_id": "61c6db8e-61d4-326a-9cc5-36f231a3842a",
                        "source_sense_id": "3e150c72-3e22-3cb8-ad02-1adf2ecac5be",
                        "source_sense_description": "Allgemeinmediziner",
                        "target_lang_word": "Allgemeinmediziner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allgemeinmediziner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90c7e391-f09d-3e20-9faf-f117b5bbae92",
                                        "entry_id": "61333237-e738-350c-9c3c-0b2196cbdddc",
                                        "glosses": [
                                            "Arzt mit dem Fachgebiet der Allgemeinmedizin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73e537d6-cb09-4d28-abd6-b2dade1bfb0e",
                                                "sense_id": "90c7e391-f09d-3e20-9faf-f117b5bbae92",
                                                "text": "Wegen seines anhaltenden Schnupfens wandte er sich an seinen Allgemeinmediziner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27167df7-2a84-4050-b914-0b135fe3a4ed",
                        "source_entry_id": "61c6db8e-61d4-326a-9cc5-36f231a3842a",
                        "source_sense_id": "3e150c72-3e22-3cb8-ad02-1adf2ecac5be",
                        "source_sense_description": "Allgemeinmediziner",
                        "target_lang_word": "Hausarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                        "entry_id": "9bc624e7-e9ac-35a1-b94f-776041c66f01",
                                        "glosses": [
                                            "Arzt, den man bei gesundheitlichen Beschwerden meist zuerst aufsucht und der gegebenenfalls auch Hausbesuche macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308d6af3-8d8d-4de7-a03f-565a7741ca2b",
                                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                                "text": "Meist ist der Hausarzt mit der gesundheitlichen Verfassung seiner Patienten am besten vertraut."
                                            },
                                            {
                                                "example_id": "4b7f458b-c0e7-41ce-bfce-e0c3a5c19564",
                                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                                "text": "„Um neun Uhr tauchte Doktor Aaron auf, der alte Hausarzt, ein Greis von überraschender Beweglichkeit.“"
                                            },
                                            {
                                                "example_id": "9b36ea6e-8a33-4ae1-a768-d265516dee4e",
                                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                                "text": "„Mit seinem Hausarzt schien er so etwas wie eine Vereinbarung getroffen zu haben.“"
                                            },
                                            {
                                                "example_id": "81ff67e0-ccad-4ec0-a250-164150031b32",
                                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                                "text": "„Der Hausarzt veranlasste verschiedene Untersuchungen.“"
                                            },
                                            {
                                                "example_id": "7d3b730a-bc84-4484-8666-3375b899f773",
                                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                                "text": "„Nur mein Hausarzt murrt, denn jedes Mal beim jährlichen Checkup beschimpft er mich als unheilbar gesund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
