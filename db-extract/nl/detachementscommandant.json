                        "examples": [
                            {
                                "example_id": "da1f603f-4f28-471d-8ec1-475061bd59b1",
                                "sense_id": "4435888d-a2c5-3f38-aec5-201035990d9b",
                                "text": "\"We hebben in een mortuarium in Kiev de lichamen kunnen onderzoeken\", zegt detachementscommandant Angelo Wouters van de Koninklijke Marechaussee. De stoffelijke overschotten waren in slechte staat, een deel van de lichamen was grotendeels verbrand. \"Dat maakt het onderzoek moeilijk.\""
                            },
                            {
                                "example_id": "38d6d3c6-c4a8-4205-8c16-46d152bcba99",
                                "sense_id": "4435888d-a2c5-3f38-aec5-201035990d9b",
                                "text": "Detachementscommandant Chris begrijpt het gevoel. Ook hij is niet blij met de situatie, maar tegelijkertijd trots op wat er wel lukt. „We zijn hier met slechts twee toestellen, maar maken echt het verschil. Zelfs de Amerikanen die hier met zoveel meer toestellen zitten, krijgen de vracht niet weggewerkt. Zij waren dolblij toen wij - en de tanker - hier kwamen.”"
                            }
                        ]
