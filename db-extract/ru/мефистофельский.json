                                    {
                                        "sense_id": "a65967ba-87cf-3cf6-ae25-ea68d4159240",
                                        "entry_id": "05e5fbbf-ce24-38c7-8778-70798180787b",
                                        "glosses": [
                                            "Alternative form of Mephistophelean."
                                        ],
