                    {
                        "sense_id": "4094e9ef-e401-3574-a3f4-261d22475cc2",
                        "entry_id": "089371d0-ef1a-3ec2-a91e-e8e1ad96325b",
                        "glosses": [
                            "Of, concerning, or existing in both space and time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba42b7e-80a9-463a-8dec-3c30e4251c66",
                                "sense_id": "4094e9ef-e401-3574-a3f4-261d22475cc2",
                                "text": "Physical existence, thus, is essentially spatiotemporal ubiety; and that which has or lacks ubiety, that is, is or is not present at some place in space at some time, is always some what or kind—which may be a kind of substance, or of property, or of relation, or of activity, or of change, or of state, and so on."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4b01e90-97c0-39b1-8497-e4cee7371c00",
                        "entry_id": "089371d0-ef1a-3ec2-a91e-e8e1ad96325b",
                        "glosses": [
                            "Of or concerning spacetime."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74b2ce27-97c0-4273-a54d-c750171d4dd5",
                        "source_entry_id": "089371d0-ef1a-3ec2-a91e-e8e1ad96325b",
                        "source_sense_description": "of or concerning space and time",
                        "target_lang_word": "spatiotemporel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
