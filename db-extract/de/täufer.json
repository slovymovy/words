                "senses": [
                    {
                        "sense_id": "145ce4a7-e410-3075-b9e6-dfdf70a1d877",
                        "entry_id": "54b77a5a-2164-330a-9913-5c47c7b4b073",
                        "glosses": [
                            "jemand, der eine Taufe durchführt"
                        ],
                        "tags": [
                            "oft als Zuname verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "f2159c37-2430-478a-9cff-90d4c0e75e91",
                                "sense_id": "145ce4a7-e410-3075-b9e6-dfdf70a1d877",
                                "text": "Das Heilsgeschehen nimmt seinen Anfang bereits in der Ankündigung der Geburt des Täufers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2faee225-485d-3d18-9415-a8bb895aad7b",
                        "entry_id": "54b77a5a-2164-330a-9913-5c47c7b4b073",
                        "glosses": [
                            "gekürzt für Wiedertäufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1797a8b6-42e4-4281-bb29-ebadf62d4400",
                                "sense_id": "2faee225-485d-3d18-9415-a8bb895aad7b",
                                "text": "„In den folgenden Jahren wurde Münster zum wichtigsten Zufluchtsort der verfolgten Täufer, die schließlich die Macht in der Stadt übernahmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e64a9e9b-7839-4467-903f-498e42c27beb",
                        "source_entry_id": "54b77a5a-2164-330a-9913-5c47c7b4b073",
                        "source_sense_id": "145ce4a7-e410-3075-b9e6-dfdf70a1d877",
