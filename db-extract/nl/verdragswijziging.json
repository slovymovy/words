                        "examples": [
                            {
                                "example_id": "b15cf3da-353f-4498-92ea-e273ffec49e0",
                                "sense_id": "1132b8d4-77e8-35a0-955d-0234b58621cf",
                                "text": "Het kabinet vindt een verdragswijziging een onbegaanbare weg, maar daar is Verheijen het dus niet mee eens. Het verdrag is van vóór de financiële en eurocrisis van de laatste 5 jaar en voldoet straks niet meer, aldus Verheijen."
                            },
                            {
                                "example_id": "f77f4573-c7fa-45c4-ae02-eedb2b2dcd25",
                                "sense_id": "1132b8d4-77e8-35a0-955d-0234b58621cf",
                                "text": "De strijd rond de zetel Straatsburg duurt al jaren. Frankrijk en Luxemburg, waar een deel van de EP-administratie is gevestigd, verzetten zich met hand en tand tegen centralisatie in Brussel. Zij kunnen een verdragswijziging blokkeren."
                            },
                            {
                                "example_id": "acdf565c-e666-4221-8bb2-03b25bc073f9",
                                "sense_id": "1132b8d4-77e8-35a0-955d-0234b58621cf",
                                "text": "Nederland wil de hoogte van de uitkeringen die naar mensen in Marokko gaan, aanpassen aan het levenspeil in dat land. Dat betekent dat ze flink lager worden. Maar volgens de rechter is dat strijdig met het verdrag met dat land. Marokko wil niet meewerken aan de verdragswijziging."
                            }
                        ]
                    }
