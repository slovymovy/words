                                        "sense_id": "b1df973d-e422-3ddb-b74c-ff36d0ce5068",
                                        "entry_id": "213da305-2522-3bab-91da-402833e022c0",
                                        "glosses": [
                                            "A large crater formed by collapse of the cone or edifice of a volcano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbdddd1e-56e8-4dee-bfb0-7336a4e586ac",
                                                "sense_id": "b1df973d-e422-3ddb-b74c-ff36d0ce5068",
                                                "text": "The lakes of both Rotorua and Taupo occupy calderas left from enormous prehistoric eruptions, and magma lies at shallow depths beneath a number of centres."
                                            }
                                        ]
                                    }
                                ]
                            }
