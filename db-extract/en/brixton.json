                                            {
                                                "example_id": "a00cfbae-c304-4a22-bf82-519c36355377",
                                                "sense_id": "a3182ba4-c530-3939-8ed4-62621b8b2304",
                                                "text": "„Neal überlegte, wie viele Touristen hinter die Kulissen des künstlichen Mary-Poppins-London blickten und die Slums in Brixton, die Armenviertel in Notting Hill Gate oder den Teil der Bayswater Road besuchten, der als ›Little Karachi‹ bekannt war.“"
                                            },
                                            {
                                                "example_id": "5bfa918b-305f-4b02-972a-ff78a42d137a",
                                                "sense_id": "a3182ba4-c530-3939-8ed4-62621b8b2304",
                                                "text": "„Aus einer Wohnung in Brixton, im fernen London.“"
                                            },
                                            {
                                                "example_id": "e34a0b97-0549-4b53-ba34-7ece06b197d9",
                                                "sense_id": "a3182ba4-c530-3939-8ed4-62621b8b2304",
                                                "text": "„‹Pass auf, mein Junge, es läuft folgendermaßen. Wir treffen uns morgen mit Mr. Fellows und dem ganzen Team. Selber Treffpunkt wie letztes Mal, in Brixton. Das wirst du ja wohl noch wissen?›“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
