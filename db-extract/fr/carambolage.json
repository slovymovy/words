                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "A pile, a group of people or things which have piled up on one another, especially",
                                            "A pile of crashed vehicles due to a traffic accident."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbdb47a3-38a7-43bd-b11d-417bd243a62c",
                                                "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                                "text": "Traffic was backed up for miles due to a twelve-car pile-up on the freeway earlier today."
                                            },
                                            {
                                                "example_id": "33963352-2dd4-413c-9ad4-8a2a458c4e2f",
                                                "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                                "text": "Pinot was among those involved in the huge pile-up just as the race entered the final three kilometres. Grazes were visible under his torn clothing as he pedalled, with a face like thunder, to the finish line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ac5eaaa-aa3f-3e39-9437-8b5089c4427f",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "A pile, a group of people or things which have piled up on one another, especially",
                                            "A pile of tackling players."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "An accumulation that occurs over time, especially one which is not welcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43073ec1-52f4-42a4-a92e-50bc74fb9c45",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "If the supervisor deals with daily workload in an orderly way and does not put pressure on the employee about a pile-up of work, then the employee's perception of pressure will be reduced and the employee will not suffer from work pressure stress."
                                            },
                                            {
                                                "example_id": "14db3056-bf1d-436b-9443-0a26633fe32a",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Evidently, the annealing in NO ambient results in a pile-up of nitrogen at the oxide/SiC interface and this results in a reduction of interface states near the conduction band edge of 4H-SiC [16,30,31]."
                                            },
                                            {
                                                "example_id": "0c0c300f-b0ac-442b-9bdb-c1502c5c77f9",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Cusp-like trapezoidal shaping functions have been shown to produce the best signal-to-noise ratio and still maintain short duration to avoid pile-up of events."
                                            },
                                            {
                                                "example_id": "9cacc770-0aa4-4a2e-afbd-87744026fd25",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Because family crises evolve and are resolved over a period of time, families seldom are dealing with a single stressor, but rather, our longitudinal data suggest they experience a pile-up of stressors and strains (i.e., demands), particularly in the aftermath of a major stressor, such as a death, a major role change for one member, or a natural disaster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
