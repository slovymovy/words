                    },
                    {
                        "translation_id": "faf99491-873a-4739-97bc-66854a595cf9",
                        "source_entry_id": "8b2ec64c-b5f9-34dd-9f5a-37a3f1a99d5c",
                        "source_sense_id": "79b04a17-42ff-3c97-ade3-614312b02ab6",
                        "source_sense_description": "suitable for, or able to be subjected to, manipulation",
                        "target_lang_word": "malléable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malléable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f966090-8d90-324c-a191-734f862b54df",
                                        "entry_id": "fe2bddcc-df08-3a34-82c3-82fca61bd8d4",
                                        "glosses": [
                                            "Qui peut s’aplatir et s’étendre en lames ou en feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99490ef1-411f-4c7d-8dfd-d848bff22e08",
                                                "sense_id": "9f966090-8d90-324c-a191-734f862b54df",
                                                "text": "Une des principales propriétés des métaux est d’être malléables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fb7e8f-ea46-31d2-9a4d-973ae4ea1071",
                                        "entry_id": "fe2bddcc-df08-3a34-82c3-82fca61bd8d4",
                                        "glosses": [
                                            "Se dit d’une matière qui s’assouplit plus ou moins aisément."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e645acf-1403-41cc-8ff2-5c96e9d7ebba",
                                                "sense_id": "60fb7e8f-ea46-31d2-9a4d-973ae4ea1071",
                                                "text": "L’argile est malléable."
                                            },
                                            {
                                                "example_id": "e9b9c32f-4215-44c3-a26e-717795f50dbc",
                                                "sense_id": "60fb7e8f-ea46-31d2-9a4d-973ae4ea1071",
                                                "text": "Le fait que nous ayons développé des mains à la forme unique nous a poussés à toucher, sculpter, modeler, graver et nous a fait percevoir le monde comme une matière malléable, pliable, modifiable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a36827-b680-391e-80b9-4fe87d98ebe2",
                                        "entry_id": "fe2bddcc-df08-3a34-82c3-82fca61bd8d4",
                                        "glosses": [
                                            "Qui se laisse facilement influencer, façonner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9dd53f-2a4e-42d5-8d68-9f99875c6053",
                                                "sense_id": "56a36827-b680-391e-80b9-4fe87d98ebe2",
                                                "text": "Il a un caractère assez malléable."
                                            },
                                            {
                                                "example_id": "d393c25f-e513-4e3f-a240-4d20f06d6abb",
                                                "sense_id": "56a36827-b680-391e-80b9-4fe87d98ebe2",
                                                "text": "Elle habitait avec sa fille, la mère de mon père, ma grand-mère Adeline, une grosse femme au visage poupin, petite, apeurée d’un rien (mais surtout des révolutions futures), l’être le plus malléable et le plus inoffensif que j’aie connu."
                                            },
                                            {
                                                "example_id": "267c5881-eb45-4a7e-ad46-4617598adacb",
                                                "sense_id": "56a36827-b680-391e-80b9-4fe87d98ebe2",
                                                "text": "La jeune fille était d’une pâte facilement malléable, mais avec la propriété de perdre aussitôt l’empreinte qu’on y avait faite."
                                            },
                                            {
                                                "example_id": "4438f672-d5aa-4f7b-8806-a8e1dd76979a",
                                                "sense_id": "56a36827-b680-391e-80b9-4fe87d98ebe2",
                                                "text": "Seul Caligula, plus jeune mais aussi moins malléable, échappait encore à l’influence néfaste de l’inquiétant préfet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
