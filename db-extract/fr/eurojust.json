                        "glosses": [
                            "Agence de l’Union européenne chargée de renforcer la coopération judiciaire entre les États membres."
                        ],
                        "tags": [
                            "Justice",
                            "Europe"
                        ],
                        "examples": [
                            {
                                "example_id": "c81c740c-cd0a-4913-b2d5-2e3b506d0055",
                                "sense_id": "1a2fa1cb-5f67-31d5-8aa6-05134ed817fa",
                                "text": "Devenue incontournable pour les enquêtes judiciaires concernant la criminalité organisée transfrontalière et le terrorisme, Eurojust est le symbole de la construction européenne en matière de justice."
                            },
                            {
                                "example_id": "65668cbc-2aa7-4f94-8c32-086d29fbf628",
                                "sense_id": "1a2fa1cb-5f67-31d5-8aa6-05134ed817fa",
                                "text": "Les États membres de l’Union européenne ont créé l’unité de coopération judiciaire EUROJUST afin de faire obstacle à toutes les formes de criminalité organisée (trafic de drogue, blanchiment d’argent, trafic d’êtres humains, contrefaçons, criminalité informatique, criminalité au détriment de l’environnement...)."
                            }
                        ]
                    }
