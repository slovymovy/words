                    {
                        "form_id": "54a0a071-e8e5-4577-b358-ae0e8ac61e75",
                        "entry_id": "a75c9316-6f94-3824-986e-57ac6d8ce640",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegserklärungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                        "entry_id": "a75c9316-6f94-3824-986e-57ac6d8ce640",
                        "glosses": [
                            "einseitige, formlose Willenserklärung an die gegnerische Partei, die den Eintritt des Kriegszustandes ankündigt, sie hat spätestens 24 Stunden nach dem Beginn der ersten Kriegshandlungen zu erfolgen (2. Haager Konferenz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9050ef04-0944-40f6-8b72-a25218c5545e",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "Mit der Abgabe der Kriegserklärung treten die Regeln des Kriegsvölkerrechtes in Kraft."
                            },
                            {
                                "example_id": "5961430c-bc8c-4096-956f-ce400d482968",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "Die USA haben dem Irak gegenüber eine Kriegserklärung ausgesprochen."
                            },
                            {
                                "example_id": "4a056710-309d-41ee-ad05-28b86645b04a",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "„Er schlägt vor, eine Kriegserklärung solle eine Art Volksfest werden mit Eintrittskarten und Musik wie bei Stiergefechten.“"
                            },
                            {
                                "example_id": "3d6ed742-90f2-41d9-b892-b1de1ff85935",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "Wenn Sie jetzt Herrn Müller mit Kündigung drohen, wird die Gewerkschaft das als Kriegserklärung auffassen."
                            },
                            {
                                "example_id": "045bf0fc-9381-4e4f-a71a-e299895a5fa2",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "„Österreichs Empörung führte letztlich zu der Kriegserklärung an Serbien.“"
                            },
                            {
                                "example_id": "ff9e98fd-bc4a-4a9f-94d2-fc448b901cdc",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "„Als nach einer Unterbrechung der uneingeschränkte U-Boot-Krieg am 30. Januar 1917 offiziell wieder aufgenommen wurde, antworteten die USA am 6. April 1917 mit der Kriegserklärung an Deutschland.“"
                            },
                            {
                                "example_id": "bd9b9d56-6b6f-46c6-95bb-c22ce4ac00c0",
                                "sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                                "text": "„Daß Nikolai am Tag der Kriegserklärung auf die Welt kam, hatten seine Eltern nie als ein böses Omen betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94315472-10a8-4643-a03b-cbef0e0e0bfe",
                        "source_entry_id": "a75c9316-6f94-3824-986e-57ac6d8ce640",
                        "source_sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                        "target_lang_word": "declaration of war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declaration of war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28a8968d-3ff4-3aee-9ab2-5c40e3792d82",
                                        "entry_id": "fed54b0e-2ac7-3dcc-b8dd-50e6079d3888",
                                        "glosses": [
                                            "A formal announcement by a country or other body with military capability that it is in a state of war with another such entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa36a7ee-7320-4662-9f0d-b7e5ed82db96",
                                                "sense_id": "28a8968d-3ff4-3aee-9ab2-5c40e3792d82",
                                                "text": "Make no mistake, the sway of the railways' mandate in the middle of the 19th century was, in some quarters, a declaration of war on the old."
                                            },
                                            {
                                                "example_id": "a969aaab-af1e-48cb-a998-6631870957d4",
                                                "sense_id": "28a8968d-3ff4-3aee-9ab2-5c40e3792d82",
                                                "text": "Although the Take Care Clause grants the president significant authority to enforce the laws, the duty to take care does not include a power to forbid the execution of the laws. Consequently, the president does not have the authority to disregard Congress’s declaration of war against Country X. On the contrary, the president has an obligation to faithfully execute the declaration of war, even against their own beliefs and wishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc8bec84-d585-4394-b551-9d46741eaffc",
                        "source_entry_id": "a75c9316-6f94-3824-986e-57ac6d8ce640",
                        "source_sense_id": "388c9c5f-2830-3222-9b5d-371d9e7a7c00",
                        "target_lang_word": "déclaration de guerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déclaration de guerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                        "entry_id": "6529da0e-9db2-3101-8762-05285c4e6002",
                                        "glosses": [
                                            "Action de déclarer la guerre, acte par lequel une nation, une puissance déclare la guerre à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171c6dcd-6ffc-42e2-a80e-9c318428f80b",
                                                "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                                "text": "En 1585, des escadres anglaises avaient attaqué, sans déclaration de guerre, Saint-Domingue et Carthagène. Une année plus tard, Drake insulta Lisbonne et détruisit, à Cadix, une flotte entière de navires de transport."
                                            },
                                            {
                                                "example_id": "dac086c6-1832-4cb9-8278-12d17cb9ccaf",
                                                "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                                "text": "Des enfants de cinq ans, auxquels on a dû expliquer le jour même de la déclaration de guerre ce qu’était la France, ce qu’était l’Allemagne […]"
                                            },
                                            {
                                                "example_id": "11f1813e-2703-4e89-a858-cd79d018b805",
                                                "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                                "text": "Si, lors d’une déclaration de guerre, la mobilisation était facultative, bien peu d’hommes partiraient ; c’est du reste pour cette raison que les gouvernements ont institué le service militaire obligatoire."
                                            },
                                            {
                                                "example_id": "8c58f65a-2bde-4f17-9b3b-25fca97920c1",
                                                "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                                "text": "Et tirant son béret dans un grand salut empreint de cette politesse spéciale des déclarations de guerre, Magali s’éloigna d’un pas traînant."
                                            },
                                            {
                                                "example_id": "a77c210e-4744-4164-9510-712a380233c7",
                                                "sense_id": "c9a75541-3b50-303c-b671-35792e0d59f9",
                                                "text": "Pour Stéphane Maugendre, le RN ne s’attaque pas seulement aux immigrés algériens durablement installés en France, « qui participent à la vie de la cité », mais aussi à des millions de Français de deuxième ou de troisième génération : « On touche à leur histoire, c’est une vraie déclaration de guerre raciste. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "806db827-e646-45d0-be8d-a9f409a341ce",
