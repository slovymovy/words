                {
                    "sense_id": "eee5a0d1-4b12-3d4e-b6fd-187b0884c752",
                    "sense_definition": "A person who plays the sport of bowling.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_player",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bowler</w> aimed carefully at the pins.",
