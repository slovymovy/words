                        "glosses": [
                            "Action de brasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5f9c61-8441-4d65-bc0e-7ffac4eb5610",
                                "sense_id": "0e2379a3-1e7b-398d-8d8b-630558a3ab3d",
                                "text": "Le mélange d’air peut s’effectuer de deux manières, ou dans le brûleur lui-même ou à l’aide d’un brassement préalable dans un appareil spécial appelé mélangeur."
                            },
                            {
                                "example_id": "83b732e9-553a-4b62-bb5d-1d3729dc2d37",
                                "sense_id": "0e2379a3-1e7b-398d-8d8b-630558a3ab3d",
                                "text": "Et la terre bougeait sous moi, comme pour défourner un événement formidable. Et j’étais le pivot d’un brassement surnaturel d’atmosphères, de ressemblances, de menaces et de sympathies. J’allais mourir. Et il allait prendre ma place."
                            }
                        ]
                    }
