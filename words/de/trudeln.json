    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ba28897-11c9-3439-9975-f04e852cf764",
                    "sense_definition": "sich unregelmäßig drehend, taumelnd oder rollend durch die Luft oder am Boden bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Herbst <w>trudeln</w> die bunten Blätter langsam von den Bäumen zu Boden."
                        },
                        {
                            "text": "Der Ball <w>trudelte</w> nach dem Schuss ganz langsam über die weiße Linie ins Tor."
                        }
                    ],
                    "common_phrases": [
                        "zu Boden trudeln"
                    ]
                },
                {
                    "sense_id": "4fca64a8-7458-3225-9b5a-cbb54cd8a4c9",
                    "sense_definition": "sich ohne Hast und gemächlich fortbewegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Fest <w>trudeln</w> die Gäste ganz langsam in kleinen Gruppen nach Hause."
                        },
                        {
                            "text": "Wir <w>trudelten</w> ohne Eile über den sonnigen Markt und schauten uns die Stände an."
                        }
                    ],
                    "antonyms": [
                        "rasen",
                        "rennen",
                        "stürmen"
                    ],
                    "common_phrases": [
                        "gemütlich trudeln"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                },
                {
                    "sense_id": "3126efc8-876b-357d-9166-adf7264da1f1",
                    "sense_definition": "mit drei Würfeln ein Glücksspiel spielen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der alten Gaststätte <w>trudelten</w> die Männer sonntags regelmäßig um kleine Geldbeträge."
                        },
                        {
                            "text": "Wenn die Spieler abends <w>trudeln</w>, werfen sie jeweils drei Würfel auf den Holztisch."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "landschaftlich für ein bestimmtes Würfelspiel"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cedb2768-497e-3303-823c-e8206afe596d",
                    "sense_definition": "Flugzustand nach einem Strömungsabriss, bei dem ein Flugzeug schraubenförmig steil abwärts sinkt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luftfahrt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Flugzeug geriet plötzlich in ein gefährliches <w>Trudeln</w> und verlor rasch an Höhe."
                        },
                        {
                            "text": "Der Pilot übte im Kunstflug das <w>Trudeln</w>, um in Notsituationen ruhig reagieren zu können."
                        }
                    ],
                    "synonyms": [
                        "Spin"
                    ],
                    "common_phrases": [
                        "ins Trudeln geraten",
                        "ins Trudeln bringen"
                    ]
                }
            ]
        }
    ]
