                    {
                        "sense_id": "2dce16de-b6fd-31cc-a6c9-b8c64378f6f6",
                        "entry_id": "30712859-574e-375c-b704-bedce6b75606",
                        "glosses": [
                            "Mischgetränk aus Milch und Tee"
