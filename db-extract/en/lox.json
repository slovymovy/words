    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d8162dac-2478-3d78-baf8-592566ecde18",
                "word": "lox",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c2ea906-44a1-3ab0-9a22-29b7229c77e6",
                        "entry_id": "d8162dac-2478-3d78-baf8-592566ecde18",
                        "glosses": [
                            "Salmon that is cured in brine and then smoked at a low temperature so that the flesh remains uncooked."
                        ],
                        "tags": [
                            "US",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ca7a0c1-a815-48d9-93f5-b16336345ebc",
                        "source_entry_id": "d8162dac-2478-3d78-baf8-592566ecde18",
                        "source_sense_id": "1c2ea906-44a1-3ab0-9a22-29b7229c77e6",
                        "source_sense_description": "type of smoked salmon",
                        "target_lang_word": "saumon fumé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saumon fumé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb51d398-aa2e-3dbb-9684-8b2f14ca4d0d",
                                        "entry_id": "89c29117-8438-306a-bcd4-f7f10a2b86bc",
                                        "glosses": [
                                            "Chair de saumon fumée, puis salée destinée à la consommation en cuisine. Généralement présenté en tranche fine ou en dé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4886a43d-9e1c-48b6-aa2c-f055b9a7d673",
                                                "sense_id": "fb51d398-aa2e-3dbb-9684-8b2f14ca4d0d",
                                                "text": "Il y avait aussi, comme hors-d’œuvre, des tranches rouges qu'on étendait sur du pain noir en le saupoudrant de poivre : c'était du saumon fumé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296b287c-7eee-3e72-93f2-8c220b7ec5ee",
                                        "entry_id": "89c29117-8438-306a-bcd4-f7f10a2b86bc",
                                        "glosses": [
                                            "Pour parler du saumon fumé en général, de son industrie, de son marché."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee82ebb-6fd1-4c52-970a-4931d76b544f",
                                                "sense_id": "296b287c-7eee-3e72-93f2-8c220b7ec5ee",
                                                "text": "Le prix du saumon fumé dans la vente au détail a notablement diminué pendant les dernières décennies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf5dcece-a5fe-4785-a682-61e2cdecadc9",
                        "source_entry_id": "d8162dac-2478-3d78-baf8-592566ecde18",
                        "source_sense_id": "1c2ea906-44a1-3ab0-9a22-29b7229c77e6",
                        "source_sense_description": "type of smoked salmon",
                        "target_lang_word": "Lachs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lachs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                        "entry_id": "d7fe2776-1552-3807-8c94-d0416e4bfd08",
                                        "glosses": [
                                            "Fische der Gattungen Salmo, Salmothymus und Oncorhynchus aus der Familie der Forellenfische (Salmonidae) innerhalb der Ordnung der Lachsartigen"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ce470f-5564-4fa8-8315-5c9b6d9e902e",
                                                "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                                "text": "Ich habe einen Lachs gefangen."
                                            },
                                            {
                                                "example_id": "5d325268-9024-45e0-9afa-002473587205",
                                                "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                                "text": "„Der Lachs war weder geräuchert, noch gebeizt und wir aßen die dünnen Scheiben wie frisches Sushi roh und ohne weitere Zutaten.“"
                                            },
                                            {
                                                "example_id": "e3a0ae27-b619-4985-babc-c1da9ba9de50",
                                                "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                                "text": "„Der Wind frischte auf, die Lachse sprangen.“"
                                            },
                                            {
                                                "example_id": "1924e081-35d1-4fb0-8897-87f780a90f3e",
                                                "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                                "text": "„Erst durch das Hinterfragen und Reflektieren, durch Werterkenntnis und Sinnzuweisung unterscheiden sich die Extremleistungen des Menschen wesentlich von denen der Lachse, Ameisen, Bergziegen oder Zugvögel.“"
                                            },
                                            {
                                                "example_id": "2aa58e2d-8ea1-4d66-9103-45c0733d705a",
                                                "sense_id": "84b1fd98-2b1a-3f94-b6bd-452b6ae5f2ca",
                                                "text": "„Eines Tages beobachteten die Siedler, wie Tausende von Lachsen die Mercy hinaufschwammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e1004ca-cbb4-32ae-9ec0-07eb4161e2f1",
                                        "entry_id": "d7fe2776-1552-3807-8c94-d0416e4bfd08",
                                        "glosses": [
                                            "Muskelstrang (Kernmuskel, langer Rückenstrecker, Musculus longissimus dorsi) des Rückens von Schlachttieren, besonders von Schweinen (Schweinelachs oder Lachsfleisch), Kälbern (Kalbslachs) und Lämmern (Lammlachs); Bestandteil des Rippenstücks oder Kotelettstrangs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42f48a8-c036-4caa-b84e-569618e4681e",
                                                "sense_id": "1e1004ca-cbb4-32ae-9ec0-07eb4161e2f1",
                                                "text": "Die Lachse sind ideal für Schweineschnitzel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lachs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e71e2f-fca8-3739-a6cd-c262afb964f0",
                                        "entry_id": "610fa633-e951-35c1-836f-e05990420a52",
                                        "glosses": [
                                            "ein gelbliches Rosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c931456c-f4c7-4a78-ace1-8a27395da89d",
                                                "sense_id": "c1e71e2f-fca8-3739-a6cd-c262afb964f0",
                                                "text": "Gebrochene Töne wie Lachs und Mauve bestimmen das Bild der Kollektion."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lachs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfbfcc4-87a5-3e6e-85aa-8857417ac197",
                                        "entry_id": "4b711d3d-5585-3446-90f8-572dfa40157e",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b07e35-884e-49a4-9a6c-6c57f2e48ae0",
                                                "sense_id": "6cfbfcc4-87a5-3e6e-85aa-8857417ac197",
                                                "text": "„Christine Dorothea Lachs (genannt die Lachsin; * 1672; † nach 1716) war eine deutsche Dichterin und Librettistin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
