                                "target_senses": [
                                    {
                                        "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                        "entry_id": "e7a09524-04e4-32dd-9a1d-13963b2c8f9b",
                                        "glosses": [
