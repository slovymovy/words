                                "sense_id": "38cf38ab-4149-313d-b706-bb89d72f1a90",
                                "text": "The socialist press of the city jubilantly exploited this utterance, scattering it broadcast over San Francisco in tens of thousands of paper dodgers."
                            },
                            {
                                "example_id": "c0311855-9c2d-4fdf-b282-6f6df7c694ce",
                                "sense_id": "38cf38ab-4149-313d-b706-bb89d72f1a90",
                                "text": "Having written jubilantly home to the Secretary of State that his mission had succeeded, he was now faced with the necessity of writing again to confess that this success had been ephemeral."
                            }
                        ]
                    }
