                "senses": [
                    {
                        "sense_id": "8721945c-502c-3d16-9199-0f15ad5dcc39",
                        "entry_id": "270e8804-d2b0-3b0b-82b5-70a6f9cd74cf",
                        "glosses": [
                            "Entgelt, das man für die Nutzung und/oder Verwertung eines Lizenzgegenstandes entrichten muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99496e5d-694f-4d29-9058-3a382306021f",
                                "sense_id": "8721945c-502c-3d16-9199-0f15ad5dcc39",
                                "text": "„Lizenzgebühren bezeichnen die aus dem Lizenzvertrag zu zahlenden Entgelte für die Verwertung bes. von Lizenzen und Patenten.“"
                            },
                            {
                                "example_id": "4e132571-8877-4df5-928f-2e44cad7225d",
                                "sense_id": "8721945c-502c-3d16-9199-0f15ad5dcc39",
                                "text": "„Die Möbelhäuser zahlen Lizenzgebühren an eine Gesellschaft in den Niederlanden.“"
                            },
                            {
                                "example_id": "e7f6487d-967b-4ab7-b239-24469607db05",
                                "sense_id": "8721945c-502c-3d16-9199-0f15ad5dcc39",
                                "text": "„Eigentlich müsste er dank der Lizenzgebühr mehr als komfortabel leben können, stattdessen sitzt er in Gerichtssälen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
