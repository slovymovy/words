                "senses": [
                    {
                        "sense_id": "c9060c31-f5b0-3add-8476-7e32fdb2154e",
                        "entry_id": "819be825-34fa-34a7-b460-7c68a65272fe",
                        "glosses": [
                            "kleine, gebogene Schere, die zum Kürzen der Finger- und Fußnägel benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3594c629-88ad-422f-8655-161fe428e593",
                                "sense_id": "c9060c31-f5b0-3add-8476-7e32fdb2154e",
                                "text": "Mein Arbeitskollege könnte auch mal wieder eine Nagelschere benutzen. Seine Fingernägel sind schon länger als meine."
                            },
                            {
                                "example_id": "9cbb6988-4f66-495a-ae68-3cb72102f870",
                                "sense_id": "c9060c31-f5b0-3add-8476-7e32fdb2154e",
                                "text": "„Mein Vater hatte auf einem Hocker vor mir gesessen, mir halb den Rücken zugedreht, sich über meine Füße gebeugt und die Nagelschere angesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
