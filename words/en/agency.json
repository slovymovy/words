{
    "word_family": [
        "agent",
        "subagency",
        "interagency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71def32a-9b80-396b-b080-78765b3a1dac",
                    "sense_definition": "A business or organization that provides a specific service for other people or companies.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to book our holiday flights and hotel through a local travel <w>agency</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили забронировать авиабилеты и отель для отпуска через местное туристическое <w>агентство</w>.",
                                "zh": "我们决定通过当地的一家旅行<w>代理机构</w>预订度假机票和酒店。"
                            }
                        },
                        {
                            "text": "She found a temporary job in the city through a recruitment <w>agency</w>.",
                            "target_lang_translations": {
                                "ru": "Она нашла временную работу в городе через кадровое <w>агентство</w>.",
                                "zh": "她通过一家招聘<w>代理机构</w>在城里找到了一份临时工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel agency",
                        "advertising agency",
                        "employment agency",
                        "recruitment agency",
                        "news agency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческая организация или учреждение, предоставляющее определенные услуги частным лицам или компаниям.",
                        "zh": "为他人或公司提供特定服务的商业组织或机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аге́нтство",
                                "target_lang_sense_clarification": "организация, оказывающая услуги"
                            },
                            {
                                "target_lang_word": "бюро́",
                                "target_lang_sense_clarification": "контора или учреждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代理机构",
                                "target_lang_sense_clarification": "提供中介服务的组织"
                            },
                            {
                                "target_lang_word": "事务所",
                                "target_lang_sense_clarification": "处理特定业务的机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f90624-722e-3809-a4d4-a6e28858efaa",
                    "sense_definition": "A government department that is responsible for a specific area of administration or activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The environmental protection <w>agency</w> is investigating the cause of the oil spill in the river.",
                            "target_lang_translations": {
                                "ru": "<w>Агентство</w> по охране окружающей среды расследует причину разлива нефти в реке.",
                                "zh": "环境保护<w>局</w>正在调查河中石油泄漏的原因。"
                            }
                        },
                        {
                            "text": "He works for a federal <w>agency</w> that manages national parks and wildlife reserves.",
                            "target_lang_translations": {
                                "ru": "Он работает в федеральном <w>агентстве</w>, которое управляет национальными парками и заповедниками.",
                                "zh": "他在一个管理国家公园和野生动物保护区的联邦<w>署</w>工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "government agency",
                        "federal agency",
                        "intelligence agency",
                        "aid agency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственное учреждение, отвечающее за конкретную область управления или деятельности.",
                        "zh": "负责特定行政管理或活动领域的政府部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аге́нтство",
                                "target_lang_sense_clarification": "государственный орган"
                            },
                            {
                                "target_lang_word": "ве́домство",
                                "target_lang_sense_clarification": "орган управления"
                            },
                            {
                                "target_lang_word": "о́рган",
                                "target_lang_sense_clarification": "государственная структура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "局",
                                "target_lang_sense_clarification": "政府职能部门"
                            },
                            {
                                "target_lang_word": "署",
                                "target_lang_sense_clarification": "政府行政机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                    "sense_definition": "The ability to take action, make choices, and produce effects independently.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Giving students more choice in their learning helps them develop a strong sense of <w>agency</w>.",
                            "target_lang_translations": {
                                "ru": "Предоставление студентам большего выбора в обучении помогает им развить сильное чувство <w>субъектности</w>.",
                                "zh": "让学生在学习中有更多选择有助于他们培养强烈的<w>主体性</w>。"
                            }
                        },
                        {
                            "text": "The novel explores the limited <w>agency</w> of women in the nineteenth century society.",
                            "target_lang_translations": {
                                "ru": "В романе исследуется ограниченная <w>свобода действий</w> женщин в обществе девятнадцатого века.",
                                "zh": "这部小说探讨了十九世纪社会中女性有限的<w>能动性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "power",
                        "action"
                    ],
                    "common_phrases": [
                        "sense of agency",
                        "moral agency",
                        "human agency",
                        "personal agency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность самостоятельно действовать, делать выбор и влиять на происходящее.",
                        "zh": "独立采取行动、做出选择并产生影响的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "субъе́ктность",
                                "target_lang_sense_clarification": "способность к активному действию"
                            },
                            {
                                "target_lang_word": "свобо́да де́йствий",
                                "target_lang_sense_clarification": "независимость в поступках"
                            },
                            {
                                "target_lang_word": "во́ля",
                                "target_lang_sense_clarification": "способность выбирать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主体性",
                                "target_lang_sense_clarification": "作为行动主体的能力"
                            },
                            {
                                "target_lang_word": "能动性",
                                "target_lang_sense_clarification": "主动采取行动的意识和能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "005b54cf-bbd5-38e0-b321-5e8b16ee2bfb",
                    "sense_definition": "The use of something or someone as a method or instrument to achieve a result.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep canyon was formed over millions of years through the <w>agency</w> of water erosion.",
                            "target_lang_translations": {
                                "ru": "Глубокий каньон формировался миллионы лет под <w>воздействием</w> водной эрозии.",
                                "zh": "深邃的峡谷是经过数百万年水流侵蚀的<w>作用</w>而形成的。"
                            }
                        },
                        {
                            "text": "They believed that the miracle occurred by the <w>agency</w> of divine intervention.",
                            "target_lang_translations": {
                                "ru": "Они верили, что чудо произошло при <w>посредстве</w> божественного вмешательства.",
                                "zh": "他们相信奇迹的发生是神灵干预的<w>媒介</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "means",
                        "instrumentality"
                    ],
                    "common_phrases": [
                        "through the agency of",
                        "by the agency of"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование кого-либо или чего-либо в качестве средства или инструмента для достижения результата.",
                        "zh": "利用某物或某人作为实现结果的方法或工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посре́дство",
                                "target_lang_sense_clarification": "использование как средства"
                            },
                            {
                                "target_lang_word": "возде́йствие",
                                "target_lang_sense_clarification": "влияние силы или фактора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作用",
                                "target_lang_sense_clarification": "作为产生结果的因素"
                            },
                            {
                                "target_lang_word": "媒介",
                                "target_lang_sense_clarification": "实现目标的手段"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}