            "senses": [
                {
                    "sense_id": "8f042545-1e3f-3e7b-8e61-abd177ce6991",
                    "sense_definition": "met behulp van schroeven of schroefdraad vastmaken of monteren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schroef_bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de nieuwe boekenplank het beste direct aan de muur <w>schroeven</w>.",
                            "target_lang_translations": {
                                "fr": "Le mieux est de <w>visser</w> la nouvelle étagère directement au mur."
                            }
                        },
                        {
                            "text": "De timmerman <w>schroefde</w> de houten platen stevig aan elkaar vast.",
                            "target_lang_translations": {
                                "fr": "Le menuisier a solidement <w>vissé</w> les panneaux de bois ensemble."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastschroeven"
                    ],
                    "antonyms": [
                        "losschroeven"
                    ],
                    "common_phrases": [
                        "aan elkaar schroeven",
                        "in elkaar schroeven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fixer ou assembler au moyen de vis ou d'un filetage."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "visser",
                                "target_lang_sense_clarification": "fixer avec des vis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd2bde3-4e54-35e8-b91c-27408eab17af",
                    "sense_definition": "zonder vleugelslag in een spiraal omhoog cirkelen op warme luchtstromen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schroef_vliegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote roofvogel <w>schroefde</w> langzaam omhoog op de opstijgende thermiek.",
                            "target_lang_translations": {
                                "fr": "Le grand rapace <w>spiralait</w> lentement vers le haut sur le courant thermique ascendant."
                            }
                        },
                        {
                            "text": "We zagen de ooievaars geruime tijd <w>schroeven</w> boven de warme akker.",
                            "target_lang_translations": {
                                "fr": "Nous avons vu les cigognes <w>tournoyer</w> un bon moment au-dessus du champ chaud."
                            }
                        }
                    ],
                    "synonyms": [
                        "cirkelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "S'élever en spirale sans battre des ailes en profitant des courants d'air chaud."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "spiraler",
                                "target_lang_sense_clarification": "monter en spirale dans un courant thermique"
                            },
                            {
                                "target_lang_word": "tournoyer",
                                "target_lang_sense_clarification": "décrire des cercles en s'élevant"
