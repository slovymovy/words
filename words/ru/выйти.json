                                "target_lang_word": "work out",
                                "target_lang_sense_clarification": "to succeed or happen as planned"
                            },
                            {
                                "target_lang_word": "turn out",
                                "target_lang_sense_clarification": "to result in a specific way"
                            },
                            {
                                "target_lang_word": "come out",
                                "target_lang_sense_clarification": "to result, e.g., of a photo or product"
                            }
                        ],
                        "de": [
