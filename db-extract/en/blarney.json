                                "sense_id": "baeb7058-451b-30eb-90f5-833e668ab196",
                                "text": "He is full of blarney."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a6ad78d-c56c-366c-866f-09490c4faf2e",
                        "entry_id": "50db62ee-e33d-3674-84ca-715a37e870a1",
                        "glosses": [
                            "Ability to talk constantly and fluently."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "33b9a181-fe85-3d0c-a790-a1f49cf60281",
                        "entry_id": "50db62ee-e33d-3674-84ca-715a37e870a1",
                        "glosses": [
                            "Persuasive flattery or kind speech; smooth, wheedling talk."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2890843f-b95c-493b-94e5-d3e67151ce7d",
                        "source_entry_id": "50db62ee-e33d-3674-84ca-715a37e870a1",
                        "source_sense_description": "mindless chatter",
                        "target_lang_word": "Geschwätz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwätz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                        "entry_id": "957de33b-e78e-3648-8b39-5d6cade1b7a7",
                                        "glosses": [
                                            "dummes, belangloses Gerede"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332888a0-8183-4e15-8f4e-0997fee58618",
                                                "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                                "text": "Die Klagen der Gebildeten unter den Verächtern der neuen Medien sind also durchaus berechtigt: Das Internet ist, genau so wie die Telefonie, im Wesentlichen Geschwätz."
                                            },
                                            {
                                                "example_id": "8369e46d-16d0-4c34-bf7d-080bdb222476",
                                                "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                                "text": "„Wir schauen auf den Redner und zählen im Stillen, wie lange sein Geschwätz noch dauern wird.“"
                                            },
                                            {
                                                "example_id": "fa1b913b-aed5-447a-b054-d87a4e8b6676",
                                                "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                                "text": "„Aber von irgendeiner Seite her sah er diesen Knoten doch immer vor sich, auch wenn sein Hirn schon vom Wein umnebelt war, wenn er schwatzte oder dem Geschwätz anderer zuhörte oder nach dem Diner oder Souper wieder bei seiner Lektüre war.“"
                                            },
                                            {
                                                "example_id": "aa4cce0d-7b0d-4820-b0e0-6ccfc9c42f29",
                                                "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                                "text": "„Der Rekollektenbruder Stefano unterhielt mich den ganzen Tag über mit hunderterlei Geschwätz, in dem sich Ignoranz und Pfiffigkeit unter dem Deckmantel der Einfalt mischten.“"
                                            },
                                            {
                                                "example_id": "47e14d38-058b-44a5-a890-f1ceceb03c7d",
                                                "sense_id": "f99c3a3d-8351-3cb3-9ff1-49b0f3d25b39",
                                                "text": "„Offenbar kümmert es den Agitator wenig, daß sein Geschwätz in absolutem Widerspruch zu Idealen wie Demokratie, Gleichheit und Gerechtigkeit steht, die gemeinhin für universal gehalten werden und die retten zu wollen er im nächsten Satz behauptet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "421526fc-a004-3798-a147-3619e8797a31",
                                        "entry_id": "957de33b-e78e-3648-8b39-5d6cade1b7a7",
                                        "glosses": [
                                            "Klatsch, heimliches Ausrichten anderer Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da29ec1-6a25-4b4c-86d5-9d8caac9a917",
                                                "sense_id": "421526fc-a004-3798-a147-3619e8797a31",
                                                "text": "Höre nicht auf das Geschwätz der Anderen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "919ae056-a84e-47dd-9c15-48b7b86dbb7c",
                        "source_entry_id": "50db62ee-e33d-3674-84ca-715a37e870a1",
                        "source_sense_description": "flattery",
                        "target_lang_word": "Schmeichelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmeichelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                        "entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                                        "glosses": [
                                            "schmeichelnde Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7698fd-e12d-4a81-a224-cc5f2a9cb712",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "Trotz seiner Schmeicheleien wollte sie nicht mit ihm zusammen sein."
                                            },
                                            {
                                                "example_id": "e0358bf3-3495-405f-8e4a-43fb2c8e54a7",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Falls diese Bemerkung als Schmeichelei gemeint war, verstand Csoma sie nicht so.“"
                                            },
                                            {
                                                "example_id": "7b3b9441-507b-473e-8b4b-59e111dca6fe",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Hugo war es ernst damit, auch wenn sich in diese Sätze eine elegante Schmeichelei mischt.“"
                                            },
                                            {
                                                "example_id": "2c63ade4-7c71-4730-a9b6-0ba6490e0f90",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Dies war eine Fortsetzung von Johns Art, sie zu liebenkosen, das Echo seiner Schmeichelei.“"
                                            },
                                            {
                                                "example_id": "9624defa-7b79-4f52-95a7-6609d2f50778",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Sie erzählte von den Schmeicheleien, die er ihr gesagt hatte; dann habe er geäussert, er wolle ins Ausland reisen, und sie gefragt, wo die Familie Rostow ihren Sommer verbringen würde, und sich dann nach Boris bei ihr erkundigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8c3f356-526a-4e22-8e8a-70a8e638a274",
