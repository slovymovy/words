                        "form": "ingedraaid"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7789831-2940-377c-8db9-2d2a8518ef33",
                        "entry_id": "ad6a0c96-9a6b-3fe0-8cda-f4c98b80d070",
                        "glosses": [
                            "to turn or screw into"
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4819301d-8d80-4a57-8f2c-35f2902d3cea",
                                "sense_id": "b7789831-2940-377c-8db9-2d2a8518ef33",
                                "text": "Je moet die schroef nog even wat verder de plank indraaien.",
                                "translation": "You have to screw that screw a bit further into the plank.",
                                "english": "You have to screw that screw a bit further into the plank."
                            },
                            {
                                "example_id": "3576619a-9595-4564-96bb-3a6283ae9031",
                                "sense_id": "b7789831-2940-377c-8db9-2d2a8518ef33",
                                "text": "De auto is niet ver genoeg het parkeervak ingedraaid.",
                                "translation": "The car isn't turned into the parking space far enough.",
                                "english": "The car isn't turned into the parking space far enough."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dc9a82b-3a2b-3204-9b3c-f9902bdb041f",
                        "entry_id": "ad6a0c96-9a6b-3fe0-8cda-f4c98b80d070",
                        "glosses": [
                            "to go to jail"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f3cf47f-f3bd-42f2-8732-8bda967be669",
                                "sense_id": "6dc9a82b-3a2b-3204-9b3c-f9902bdb041f",
                                "text": "Ik wil liever niet de bak indraaien.",
                                "translation": "I would prefer not to go to jail.",
                                "english": "I would prefer not to go to jail."
                            },
                            {
                                "example_id": "96877492-8cfa-4d8e-b603-8cedebf2c13b",
                                "sense_id": "6dc9a82b-3a2b-3204-9b3c-f9902bdb041f",
                                "text": "Hij is uiteindelijk gepakt en de gevangenis ingedraaid.",
                                "translation": "He got caught in the end and went to jail.",
                                "english": "He got caught in the end and went to jail."
                            }
                        ]
                    }
                ],
