                        "cross_references": [
                            {
                                "target_word": "Salatschüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                        "entry_id": "e794ada9-a1c9-397f-901e-c83c7c3d0d9f",
                                        "glosses": [
                                            "vertieftes Gefäß für Salatgerichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ebe008-f4d2-41dc-a633-48fb44b97ad2",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "In der großen Salatschüssel befindet sich hausgemachter Gurkensalat, in der kleineren ist Fleischsalat vom Metzger."
                                            },
                                            {
                                                "example_id": "d11b2876-54cc-464d-98f2-70ed8cc363e1",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "„Er nahm das Glas Pernod, trank einen Schluck und zwang sich, langsam auf die Salatschüssel zu blicken, als interessiere ihn die Zubereitung.“"
                                            },
                                            {
                                                "example_id": "33ec5502-d780-47e9-99aa-c3337f924463",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "„Lindner vollführte mit Thomas einen kleinen Freudentanz, bei welchem das Ende einer Salatschüssel zu beklagen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
