{
    "word_family": [
        "captive",
        "capture",
        "captor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28d617a2-2285-3eae-b63f-86ebc750be31",
                    "sense_definition": "The state of being held as a prisoner or confined against one's will.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imprisonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animals were born and raised in <w>captivity</w> at the city zoo.",
                            "target_lang_translations": {
                                "zh": "这些动物是在城市动物园的<w>圈养</w>环境下出生并长大的。",
                                "tr": "Hayvanlar şehir hayvanat bahçesinde <w>esaret altında</w> doğup büyütüldü."
                            }
                        },
                        {
                            "text": "After years of <w>captivity</w>, the bird was finally released back into the wild.",
                            "target_lang_translations": {
                                "zh": "经过多年的<w>囚禁</w>，这只鸟终于被放归大自然。",
                                "tr": "Yıllar süren <w>tutsaklığın</w> ardından kuş nihayet doğaya geri salındı."
                            }
                        }
                    ],
                    "synonyms": [
                        "confinement",
                        "imprisonment"
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "held in captivity",
                        "escape from captivity"
                    ],
                    "target_lang_definitions": {
                        "zh": "被囚禁或被限制自由的状态。",
                        "tr": "Tutsak edilme, kapatılma veya iradesi dışında alıkonulma durumu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "囚禁",
                                "target_lang_sense_clarification": "指被关押或限制人身自由的状态。"
                            },
                            {
                                "target_lang_word": "圈养",
                                "target_lang_sense_clarification": "特指动物在人工环境下被关养的状态。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tutsaklık",
                                "target_lang_sense_clarification": "Kişi veya hayvanın özgürlüğünden mahrum bırakılması durumu"
                            },
                            {
                                "target_lang_word": "esaret",
                                "target_lang_sense_clarification": "Hapsedilmiş veya bağımlı olma hali"
                            },
                            {
                                "target_lang_word": "kafes arkası",
                                "target_lang_sense_clarification": "Hayvanlar için kafeste ya da yapay ortamda tutulma durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb211fe1-5b27-37f1-8b26-100683786d5b",
                    "sense_definition": "The condition or period of being enslaved or forcibly restricted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imprisonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical records describe the <w>captivity</w> of the soldiers during the long war.",
                            "target_lang_translations": {
                                "zh": "历史记录描述了士兵们在漫长战争期间的<w>羁押</w>经历。",
                                "tr": "Tarihî kayıtlar, uzun süren savaş boyunca askerlerin <w>esaretini</w> anlatmaktadır."
                            }
                        },
                        {
                            "text": "He suffered through a long <w>captivity</w> before he was eventually rescued by his allies.",
                            "target_lang_translations": {
                                "zh": "他在最终被盟友营救之前，忍受了长期的<w>囚禁</w>。",
                                "tr": "Sonunda müttefikleri tarafından kurtarılmadan önce uzun bir <w>esirlik</w> dönemi geçirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "bondage",
                        "slavery"
                    ],
                    "antonyms": [
                        "freedom"
                    ],
                    "common_phrases": [
                        "long captivity"
                    ],
                    "target_lang_definitions": {
                        "zh": "被奴役或被强行限制自由的境遇或时期。",
                        "tr": "Köleleştirilme, esir edilme ya da zorla kısıtlanma dönemi veya durumu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "羁押",
                                "target_lang_sense_clarification": "指在战争或特殊时期被强行扣留或关押。"
                            },
                            {
                                "target_lang_word": "奴役",
                                "target_lang_sense_clarification": "指失去人身自由并被强迫劳动的状态。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esaret",
                                "target_lang_sense_clarification": "Düşman elinde tutsak olma veya kölelik durumu"
                            },
                            {
                                "target_lang_word": "esirlik",
                                "target_lang_sense_clarification": "Savaşta veya zorla alıkonulma hali"
                            },
                            {
                                "target_lang_word": "tutsaklık",
                                "target_lang_sense_clarification": "Özgürlüğün zorla kısıtlandığı dönem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}