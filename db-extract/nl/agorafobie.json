                    },
                    {
                        "translation_id": "a4eb0426-193e-401d-b1b0-e4a870c16f61",
                        "source_entry_id": "f1e80fec-7a5b-3a15-a7f8-d20f16d8ea67",
                        "source_sense_id": "96b20b17-0c62-3309-ae67-26d53e7990a1",
                        "target_lang_word": "agoraphobie",
