                    },
                    {
                        "sense_id": "8e2ccef9-2704-357c-96f8-2a4ecc685656",
                        "entry_id": "f1b418ff-f4fa-3e0f-941d-f61a7756f9c7",
                        "glosses": [
                            "past participle of shake"
                        ],
                        "tags": [
                            "form-of",
                            "informal",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "5048d155-7a9b-4874-9612-5d145d6ad3bc",
                                "sense_id": "8e2ccef9-2704-357c-96f8-2a4ecc685656",
                                "text": "Rich. Alack, why am I ſent for to a King, Before I haue ſhooke off the Regall thoughts / Wherewith I reign'd? I hardly yet haue learn'd / To inſinuate,flatter,bowe,and bend my Knee."
                            },
                            {
                                "example_id": "096748a3-0067-4a13-9bbe-11c520a45f0f",
                                "sense_id": "8e2ccef9-2704-357c-96f8-2a4ecc685656",
                                "text": "Pray, assure the empress, from me, that, notwithstanding the councils which have shook the throne of her father and mother, I shall remain here, ready to save the sacred persons of the king and queen, and of her brothers and sisters ;[…]"
                            },
                            {
                                "example_id": "73c6ecaf-22f7-4b7b-b0e3-e0037310527b",
                                "sense_id": "8e2ccef9-2704-357c-96f8-2a4ecc685656",
                                "text": "Although she could have just held it out and it would have shook by itself. His voice was having the same effect on her that the lead guitar on Chris Isaak's Wicked Game had."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
