                    "sense_definition": "een groep of verzameling van precies tien eenheden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eieren zijn verpakt per <w>tiental</w> in een kartonnen doos.",
