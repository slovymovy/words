                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2499d23-2d93-471d-96cf-7daa762398bf",
                                "sense_id": "57835f55-fdbb-309b-b392-b4ce221b3765",
                                "text": "Toute une historiographie fille des Lumières va téléologiser un processus historique homogène et en faire un chapitre de son enquête, explicitement formulé, au temps de la démocratie, au sein du plan d’études de l’école obligatoire."
                            },
                            {
                                "example_id": "b62b8aaf-90d9-4bd7-9b7d-982e44c17aa3",
                                "sense_id": "57835f55-fdbb-309b-b392-b4ce221b3765",
                                "text": "Une telle articulation conduit à moraliser le royaume futur et à téléologiser les exigences de la morale."
                            }
                        ]
                    }
