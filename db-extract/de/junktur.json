                                "target_senses": [
                                    {
                                        "sense_id": "965f8748-1b70-36af-a020-be0c0a567dff",
                                        "entry_id": "53564a4a-7728-351b-9881-3628b4b1dac5",
                                        "glosses": [
                                            "A place where things join, a junction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65a43d3a-fb81-3bc0-98ed-509fdb8de5ae",
                                        "entry_id": "53564a4a-7728-351b-9881-3628b4b1dac5",
                                        "glosses": [
                                            "A critical moment in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0822e3-2cea-447a-841b-920555ce31c3",
                                                "sense_id": "65a43d3a-fb81-3bc0-98ed-509fdb8de5ae",
                                                "text": "We're at a crucial juncture in our relationship."
                                            },
                                            {
                                                "example_id": "3e3d0dd7-67f0-47e6-888b-550fab51581a",
                                                "sense_id": "65a43d3a-fb81-3bc0-98ed-509fdb8de5ae",
                                                "text": "What a mercy you are shod with velvet, Jane! a clodhopping messenger would never do at this juncture."
                                            },
                                            {
                                                "example_id": "25a268d3-6520-4d6d-bb2b-04439816f8ce",
                                                "sense_id": "65a43d3a-fb81-3bc0-98ed-509fdb8de5ae",
                                                "text": "The object is to keep the yard operators apprised of main-line movements, so that they do not plan to occupy the main lines with activity into or out of the yard at an inopportune juncture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bedced6-d0f4-326f-9d4f-4aac26e88567",
                                        "entry_id": "53564a4a-7728-351b-9881-3628b4b1dac5",
                                        "glosses": [
                                            "The manner of moving (transition) or mode of relationship between two consecutive sounds; a suprasegmental phonemic cue, by which a listener can distinguish between two otherwise identical sequences of sounds that have different meanings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
