                        "entry_id": "aa8636d4-0a17-3ead-b43b-458a02e63c14",
                        "glosses": [
                            "Celle qui prête à un taux d’intérêt trop élevé, à un taux usuraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1f34dd-68ac-4b31-8b05-027c46813668",
                                "sense_id": "ec72ad5e-c197-391c-ad57-5dbbbe9c6935",
                                "text": "Ses yeux gris d’usurière dont nulle grimace ne pouvait atténuer la rigueur de givre étaient célèbres et généralement redoutés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7506d409-44b3-4083-8afd-dcb10e53b388",
                        "source_entry_id": "aa8636d4-0a17-3ead-b43b-458a02e63c14",
                        "source_sense_id": "ec72ad5e-c197-391c-ad57-5dbbbe9c6935",
                        "target_lang_word": "usurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                        "entry_id": "27ea4a4e-a2d7-3205-9fea-b005abd33233",
                                        "glosses": [
                                            "A person who loans money to others and charges interest, particularly at an exorbitant, exploitative, or illegal rate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941156a4-d14c-41dd-8bb7-1e2db1e2411d",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "Vſurers, you are none of theſe cryers vnto God, but thoſe that hourely vnto God are most cryde out againſt. God hath cryde out vnto you by his Preachers, GOD hath cride out vnto you by the poore ; Pryſoners on their death-beds haue cride out of you : and when they haue had but one houre to interceſſionate for their ſoules, and ſue out the pardon of their numberleſſe ſins, the whole of that howre (ſauing one minute, when in two words they cryde for mercy,) haue they ſpent, in crying for vengeance againſt you."
                                            },
                                            {
                                                "example_id": "5159f338-37e7-434c-8414-92ee7716776b",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "Profitless usurer, why dost thou use\nSo great a sum of sums, yet canst not live?"
                                            },
                                            {
                                                "example_id": "04b722fd-0ef8-4bee-b827-e5b39b5324a6",
                                                "sense_id": "69b782d3-ffbb-3362-bb82-31d23ad0457e",
                                                "text": "\"You can go to the Carpetbag usurers if you want money.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5abdbaa-d13f-4eda-9e88-28389dd8d573",
                        "source_entry_id": "aa8636d4-0a17-3ead-b43b-458a02e63c14",
                        "source_sense_id": "ec72ad5e-c197-391c-ad57-5dbbbe9c6935",
                        "target_lang_word": "usuress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usuress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a195b8d0-7c57-31e1-98ef-fb06411696c8",
                                        "entry_id": "dae4452d-d82c-3c4b-b2b1-da5e0817c69e",
                                        "glosses": [
                                            "A female usurer."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04aa1791-75d7-4457-aa47-79c33ce65471",
                                                "sense_id": "a195b8d0-7c57-31e1-98ef-fb06411696c8",
                                                "text": "That woman — that usuress — only lent me £20, but expected £50 back after just one week!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
