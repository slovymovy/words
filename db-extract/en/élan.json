                        "target_lang_word": "Elan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                        "entry_id": "814a5fdd-f990-3869-9a52-328bc299a1b2",
                                        "glosses": [
                                            "die Begeisterung oder der Schwung, womit man etwas macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf41312d-9885-4d9e-9507-cf90f6c99ad7",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "Er ist neu und steckt voller Elan."
                                            },
                                            {
                                                "example_id": "fc0fe105-9619-4c5a-8c61-2eb49675605b",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Leider berichtete ihre Mutter, die ganz begeistert von der Idee mit dem französischen Buchladen war und voller Elan in Manhattan nach einem passenden Ort suchte, dass sie kein Glück hatte.“"
                                            },
                                            {
                                                "example_id": "47511812-05b8-463e-98fd-d049af2e98b8",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Kristín füllte das ganze Zimmer mit ihrer Präsenz und dem Elan, den sie ausstrahlte, und sie redete so viel, dass Guđriđur kaum etwas zu sagen brauchte, im Grunde nichts, nur zuhören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
