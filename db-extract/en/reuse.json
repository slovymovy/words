                        "sense_id": "0f28b771-7cee-3ef8-ba4c-1b37d4a3bda1",
                        "entry_id": "17953607-d279-3801-bef4-ff1a5d41ab9d",
                        "glosses": [
                            "The act of salvaging or in some manner restoring a discarded item to yield something usable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "17402c32-ed00-3e3a-a904-c503b52482b0",
                        "entry_id": "17953607-d279-3801-bef4-ff1a5d41ab9d",
                        "glosses": [
                            "The act of using again, or in another place."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "614fb8a3-69ff-4cfd-935d-984fc8071e90",
                                "sense_id": "17402c32-ed00-3e3a-a904-c503b52482b0",
                                "text": "Code reuse can save programmers a lot of typing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b5e985e-1f96-4a79-8959-d58e8d9ca56a",
                        "source_entry_id": "17953607-d279-3801-bef4-ff1a5d41ab9d",
                        "source_sense_description": "act of salvaging or restoring a discarded item to yield something usable",
                        "target_lang_word": "réemploi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réemploi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e14dc1f8-2fa9-3f04-ad92-9b80f2a2acda",
                                        "entry_id": "7a1a800e-7ccd-3553-a8f3-776a7329c492",
                                        "glosses": [
                                            "Utilisation renouvelée de quelque chose, transformé ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c578bfed-8828-4df8-8c06-8c928c86de5b",
                                                "sense_id": "e14dc1f8-2fa9-3f04-ad92-9b80f2a2acda",
                                                "text": "Gilbert et la Gazette, maître maçon et son goujat, s’étaient mis à décaper les murs, à arracher les pierres gâtées, à gratter à mort les poches de mortier pourri, à nettoyer les joints, à rechercher, dans les broussailles, les équarries, les pierres d’angle, les pierres mureuses, à les classer toutes prêtes au réemploi."
                                            },
                                            {
                                                "example_id": "5ffeac8f-be3e-416e-9f1d-81f68c8e703c",
                                                "sense_id": "e14dc1f8-2fa9-3f04-ad92-9b80f2a2acda",
                                                "text": "Pour elles, la valorisation des déchets s’arrête souvent au recyclage, alors que l’Union européenne demande depuis 2008 que le réemploi soit, au même titre que le recyclage, une priorité dans la valorisation des déchets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5164f506-f288-3278-a841-92ae93f1f37e",
                                        "entry_id": "7a1a800e-7ccd-3553-a8f3-776a7329c492",
                                        "glosses": [
                                            "Achat d’un bien avec le produit de la revente d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d479e66-a5c6-3d6a-a2f7-efec07392a22",
                                        "entry_id": "7a1a800e-7ccd-3553-a8f3-776a7329c492",
                                        "glosses": [
                                            "Nouvel emploi obligatoire des fonds provenant des valeurs spécifiées d’un contrat ou d’un héritage en valeurs également spécifiées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8b9f03-3e82-4de1-99c6-0d5fd4c68288",
                                                "sense_id": "5d479e66-a5c6-3d6a-a2f7-efec07392a22",
                                                "text": "Le réemploi des biens dotaux est stipulé d’ordinaire dans les contrats de mariage."
                                            },
                                            {
                                                "example_id": "f6f1ac7d-fd1b-4010-9ad7-ac04782b6ba1",
                                                "sense_id": "5d479e66-a5c6-3d6a-a2f7-efec07392a22",
                                                "text": "Il ne peut vendre qu’à charge de réemploi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f9c26ed-8309-4fc7-ab1b-956522e6bb24",
                        "source_entry_id": "17953607-d279-3801-bef4-ff1a5d41ab9d",
                        "source_sense_description": "act of salvaging or restoring a discarded item to yield something usable",
                        "target_lang_word": "réusage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réusage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42d53a6b-d5f3-3e96-b5c1-b8474a94fec6",
                                        "entry_id": "ab40176e-802b-3388-b656-e553bf6c5815",
                                        "glosses": [
                                            "Nouvelle utilisation, deuxième vie pour une œuvre ou un objet, pour une fonction différente de celle prévue initialement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6dfaab-facc-4fe6-bb42-bfeb24071d05",
                                                "sense_id": "42d53a6b-d5f3-3e96-b5c1-b8474a94fec6",
                                                "text": "Pendant très longtemps, la contenant normal des boissons en tout genre était la bouteille en verre consignée, que les clients étaient amenés à rapporter au magasin pour récupérer quelques centimes par bouteille et surtout, permettre leur réusage."
                                            },
                                            {
                                                "example_id": "955402f5-6601-49ef-aded-0343dc1c9aae",
                                                "sense_id": "42d53a6b-d5f3-3e96-b5c1-b8474a94fec6",
                                                "text": "Doigts de fée adeptes du réusage, ces couturières transforment vêtements et linge de maison en lingettes, porte-monnaie, robes design…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d56e75e6-86cc-45b6-a496-b69580a1fe5c",
                        "source_entry_id": "17953607-d279-3801-bef4-ff1a5d41ab9d",
