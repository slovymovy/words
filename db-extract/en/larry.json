            {
                "entry_id": "7d824974-c08e-3880-95a3-ee2d8cae4376",
                "word": "Larry",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ddabb81b-cf64-3bb6-9d83-383ee7ec5214",
                        "entry_id": "7d824974-c08e-3880-95a3-ee2d8cae4376",
                        "glosses": [
                            "The real-person fiction ship of Louis Tomlinson and Harry Styles of the band One Direction."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "59005a00-c7b5-46d8-8ff6-64379318806f",
                                "sense_id": "ddabb81b-cf64-3bb6-9d83-383ee7ec5214",
                                "text": "\"Larry\" shippers even make evidence videos on YouTube to try to prove that they are actually a couple, showing a more extreme side of shipping."
                            },
                            {
                                "example_id": "5e0ba0b2-2db5-4355-b176-4e2313ff4374",
                                "sense_id": "ddabb81b-cf64-3bb6-9d83-383ee7ec5214",
                                "text": "Fan platforms often include some type of Larry fan fiction, fan art and detailed explanations of their fan theories."
                            },
                            {
                                "example_id": "b320927f-e7c9-47bb-8387-edab64836bca",
                                "sense_id": "ddabb81b-cf64-3bb6-9d83-383ee7ec5214",
                                "text": "Perhaps the most striking example of this intra-fandom antagonism comes in responses to Larry shippers."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "50d29eba-2267-4ad9-926f-0b32be3edaf4",
                        "source_entry_id": "7d824974-c08e-3880-95a3-ee2d8cae4376",
                        "source_sense_ids": [
                            "ddabb81b-cf64-3bb6-9d83-383ee7ec5214"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Larry Stylinson"
                    }
                ]
