                "senses": [
                    {
                        "sense_id": "f5fa9f28-a285-3461-9c38-334a07247807",
                        "entry_id": "695752ce-b873-3346-b73c-5ae8c41d4b44",
                        "glosses": [
                            "Stadt im Süden Grönlands; Julianehåb"
                        ],
                        "tags": [
                            "dänisch"
                        ],
                        "examples": [
                            {
                                "example_id": "9bfa54f5-c5ad-4fdc-bad6-0608ef787fb9",
                                "sense_id": "f5fa9f28-a285-3461-9c38-334a07247807",
                                "text": "Der dänische Reiseleiter blieb mehrere Wochen in Qaqortoq."
                            },
                            {
                                "example_id": "6a5e4e9f-b4be-4abb-b15f-a64197f71d1d",
                                "sense_id": "f5fa9f28-a285-3461-9c38-334a07247807",
                                "text": "„Nicht nur in der Umgebung, sondern bereits in Qaqortoq selber gibt es eine Reihe von spannenden Sehenswürdigkeiten zu entdecken.“"
                            },
                            {
                                "example_id": "d5449a14-ceaf-4dfe-b9d7-fbabf4b7ae31",
                                "sense_id": "f5fa9f28-a285-3461-9c38-334a07247807",
                                "text": "„In Qaqortoq etwa stieg die Durchschnittstemperatur während der vergangenen 30 Jahre von 0,63 Grad auf 1,93 Grad, und das schlägt sich nieder in einer Wachstumsperiode von 120 Tagen - zwei Wochen länger als bisher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
