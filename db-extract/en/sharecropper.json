                                "target_senses": [
                                    {
                                        "sense_id": "f96633f5-719f-311f-aff3-93d49390d15a",
                                        "entry_id": "6e89583d-ff7a-368a-aa58-0fa3072c6283",
                                        "glosses": [
                                            "Exploitant agricole partageant sa récolte avec le propriétaire du terrain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e39d47d0-de0a-438b-8516-751be0bcaa33",
                                                "sense_id": "f96633f5-719f-311f-aff3-93d49390d15a",
                                                "text": "Parmi ces curieux se trouvait Justin, le fils du méger Rébufat, un garçon d'une vingtaine d'années, créature chétive et louche qui nourrissait contre sa cousine Miette une haine implacable."
                                            },
                                            {
                                                "example_id": "66b96ffb-0aad-463d-badf-23bd2b056c06",
                                                "sense_id": "f96633f5-719f-311f-aff3-93d49390d15a",
                                                "text": "C’était la Séguiranne, la propriété où avait grandi Sophie, chez sa tante Dieudonné, la femme du méger."
                                            },
                                            {
                                                "example_id": "ecb1691b-628e-4747-9166-cac326eca6aa",
                                                "sense_id": "f96633f5-719f-311f-aff3-93d49390d15a",
                                                "text": "Il avait confié son cheval au méger d'une campagne voisine, et il se dirigeait vers une grande maison carrée, solidement bâtie, sorte de château campagnard comme on en trouve beaucoup sur les coteaux de la Provence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0df274-bf3e-3a18-9009-de57a2d9e2c7",
                                        "entry_id": "2e8cf5a2-8fdb-3f85-9385-3bea10bcc8bf",
                                        "glosses": [
                                            "Manger."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b41e954-7bb5-4b85-b196-0eb1423f62d3",
                                                "sense_id": "bf0df274-bf3e-3a18-9009-de57a2d9e2c7",
                                                "text": "Les paysans préfèrent aller à la pêche avant de travailler pour un bourgeois qu’ils soupçonnent vouloir se passer de méger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
