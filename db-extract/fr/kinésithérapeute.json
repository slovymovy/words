                "senses": [
                    {
                        "sense_id": "44dc1b2f-b116-35b5-bfa7-d6584b5f8d6c",
                        "entry_id": "f868cd8b-ee14-3d66-80ea-dec3ee483918",
                        "glosses": [
                            "Spécialiste de la kinésithérapie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93a8586-a7e3-4513-b201-cfa736b8e767",
                                "sense_id": "44dc1b2f-b116-35b5-bfa7-d6584b5f8d6c",
                                "text": "Elle peut être commencée en milieu rhumatologique et poursuivie si nécessaire en centre de rééducation spécialisée (à condition que ce dernier en ait l'expérience) ou sous le contrôle d'un rééducateur ou d'un kinésithérapeute libéral."
                            },
                            {
                                "example_id": "1befedd3-aa6f-4b21-a5cf-c6735a0a8ddc",
                                "sense_id": "44dc1b2f-b116-35b5-bfa7-d6584b5f8d6c",
                                "text": "Pour Nicolas Pinsault, kinésithérapeute et chercheur à l’université de Grenoble, même si les cas sont « rarissimes », les manipulations des vertèbres et cervicales peuvent bien occasionner des « dissections artérielles »."
                            },
                            {
                                "example_id": "a73e10cf-4c60-468c-8523-92ae951bbc23",
                                "sense_id": "44dc1b2f-b116-35b5-bfa7-d6584b5f8d6c",
                                "text": "Nos compétences vont au-delà de la kiné de désencombrement, répond Yvan Tourjansky, président de l’union régionale des kinésithérapeutes libéraux d’Île-de-France."
                            }
                        ]
                    }
                ],
