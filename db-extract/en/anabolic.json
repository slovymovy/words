                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f182542c-abbd-3f7b-a37f-7c7b7127edfd",
                        "entry_id": "49e35c88-5598-303e-ae5d-f0fca4e17467",
                        "glosses": [
                            "Of or relating to anabolism."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b07e537f-c722-4e55-a766-e49f02ce28dc",
                                "sense_id": "f182542c-abbd-3f7b-a37f-7c7b7127edfd",
                                "text": "Men may also have fertility challenges, especially if their hypogonadism was caused by anabolic steroid use."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53ebe93a-0764-4092-9db8-06f39ea69a9f",
