                    {
                        "sense_id": "0aca1293-05f8-37eb-94a9-367fd1c96282",
                        "entry_id": "6424273d-4dcf-32fd-a4e4-3fba8ecf7b30",
                        "glosses": [
                            "Médicament empêchant les œstrogènes de stimuler les cellules cancéreuses."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "775a99b9-e156-4c19-800a-15aca7f7113b",
                                "sense_id": "0aca1293-05f8-37eb-94a9-367fd1c96282",
                                "text": "Les anti-œstrogènes sont des médicaments qui entrent en compétition avec les œstrogènes. Ils ne suppriment pas la sécrétion des œstrogènes, mais ils prennent leur place au niveau des récepteurs présents à la surface des cellules et bloquent ainsi leurs effets de stimulation sur les cellules cancéreuses."
                            },
                            {
                                "example_id": "9bd136fc-6b43-47b1-9f8e-398893178d5f",
                                "sense_id": "0aca1293-05f8-37eb-94a9-367fd1c96282",
                                "text": "L’utilisation dans le sport des anti-œstrogènes n’est pas destinée, en premier lieu, à augmenter les performances, mais plutôt à supprimer les effets secondaires indésirables d’un abus d’anabolisants."
                            }
                        ]
                    }
