        "pl-extract.jsonl": [
            {
                "entry_id": "a0a63b54-5b37-36ac-a3d9-b61732245b3c",
                "word": "bezlotek",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6fdda5b7-b73f-335b-8b23-4b2c694f60bc",
                        "entry_id": "a0a63b54-5b37-36ac-a3d9-b61732245b3c",
                        "glosses": [
                            "ptak nielotny, o czarno-białym upierzeniu, przystosowany do życia w zimnym klimacie, poruszający się głównie pieszo lub pływaniem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "838aaf87-b6bb-40c5-b743-8567b27c9669",
                        "source_entry_id": "a0a63b54-5b37-36ac-a3d9-b61732245b3c",
                        "source_sense_id": "6fdda5b7-b73f-335b-8b23-4b2c694f60bc",
                        "target_lang_word": "penguin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penguin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cba8e60-c5cd-32b4-a824-4c945630e262",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "Any of several flightless sea birds, of the family Spheniscidae within the order Sphenisciformes, found in the Southern Hemisphere, marked by their usual upright stance, walking on short legs, and (generally) their stark black and white plumage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d87db40c-c0c6-4e60-a943-1c47d770b855",
                                                "sense_id": "2cba8e60-c5cd-32b4-a824-4c945630e262",
                                                "text": "Here are also birds cal'd Pen-gwins (white-head in Welch) like Pigmies walking upright, their finns or wings hanging very orderly downe like sleeves […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7483ec4f-0011-3925-aa11-5ba72d0d4dd4",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "An auk (sometimes especially a great auk), a bird of the Northern Hemisphere."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc35f08-f153-4f5f-ad9d-554a94282d87",
                                                "sense_id": "7483ec4f-0011-3925-aa11-5ba72d0d4dd4",
                                                "text": "This last species of penguin, or auk, seems to be the same with the alca cirrhata of Dr. Pallis, Spicileg. Zool. Fasc. v. p. 7. tab. i. & v. fig. 1–3. F."
                                            },
                                            {
                                                "example_id": "dd7db14b-52db-4648-b712-6a46f8c86bf8",
                                                "sense_id": "7483ec4f-0011-3925-aa11-5ba72d0d4dd4",
                                                "text": "More than a hundred years ago, for example, was seen the last of the great wingless penguins or auks, which early writers quaintly called \" wobble-birds.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a78a4fc5-c8d7-3b78-a350-87135fc324c4",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "A nun."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f692619-5079-46d7-b14e-1776b8896a55",
                                                "sense_id": "a78a4fc5-c8d7-3b78-a350-87135fc324c4",
                                                "text": "Jake (John Belushi): What are we doing here?\n Elwood (Dan Aykroyd): You promised you'd visit the penguin the day you got out.\n Jake: Yeah. So, I lied to her.\n Elwood:You can't lie to a nun. We gotta go in and visit the penguin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1cb8a2-8976-38f4-aced-b5b59b7f6105",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "A type of catch where the palm of the hand is facing towards the leg with the arm stretched downward, resembling the flipper of a penguin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dea78d5-5323-3da1-a5f6-0e9fbeea2efa",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "A spiny bromeliad with egg-shaped fleshy fruit, Bromelia pinguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f31dc9-52a0-4bc0-9dac-39381c0d107f",
                                                "sense_id": "6dea78d5-5323-3da1-a5f6-0e9fbeea2efa",
                                                "text": "These productive patches, and the houses, were each surrounded by a fence, made of a prickly shrub, called the Pinguin, which propagates itself with great rapidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f3bee9-a28f-3f92-a12b-9cd85d523a9c",
                                        "entry_id": "87fa09eb-5178-3952-b2c7-b40359aa93eb",
                                        "glosses": [
                                            "A member of the air force who does not fly aircraft."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5e1ef6-ac60-4be2-a78c-59353cb3e706",
                                                "sense_id": "c8f3bee9-a28f-3f92-a12b-9cd85d523a9c",
                                                "text": "Although it is a permanent R.A.F. station (pre-war, that is), we meander about, even in the Mess, in battle dress and flying boots, sweaters, etc., much to the disgust of some of the more dignified 'penguins' […]"
                                            },
                                            {
                                                "example_id": "746fb605-cd9b-4469-bad9-0ad3dae4ed38",
                                                "sense_id": "c8f3bee9-a28f-3f92-a12b-9cd85d523a9c",
                                                "text": "Notwithstanding his elevated status as the wing’s Senior Intelligence Officer, Monty, too, was a “penguin,” equal in that respect to an armament assistant, airframe mechanic, pigeon loftsman or any of the seventy-odd ground trades listed by the Royal Canadian Air Force at the war’s end."
                                            },
                                            {
                                                "example_id": "550de11a-51ab-4d21-a892-3e08c375c0be",
                                                "sense_id": "c8f3bee9-a28f-3f92-a12b-9cd85d523a9c",
                                                "text": "She may have been a “penguin”—an Air Force service member who didn't fly—but it sure beat being at home, as Brady had pointed out."
                                            },
                                            {
                                                "example_id": "bcfeb9df-9c63-4b50-a19c-133bd41c7572",
                                                "sense_id": "c8f3bee9-a28f-3f92-a12b-9cd85d523a9c",
                                                "text": "This was to be my home for three months where ground officer cadets, referred to colloquially as ‘penguins’ were trained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
