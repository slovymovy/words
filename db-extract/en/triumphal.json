                ],
                "translations": [
                    {
                        "translation_id": "35229664-aaa6-4df5-bf99-e443fcff1d41",
                        "source_entry_id": "bee2b69a-f577-34ad-bc76-94d1658eb7bf",
                        "source_sense_description": "of or relating to a triumph",
                        "target_lang_word": "triomphal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triomphal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32edc8dd-146b-3176-b738-c6da3ec8d7d3",
                                        "entry_id": "5ef116cd-d83b-3d78-81a9-3026bd6d20e7",
                                        "glosses": [
                                            "Qui appartient, qui est relatif à un triomphe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c236c6a7-bf40-4865-8da6-5c1723f965ce",
                                                "sense_id": "32edc8dd-146b-3176-b738-c6da3ec8d7d3",
                                                "text": "Dans la cérémonie du triomphe , le général entroit dans la ville de Rome , au jour fixé par le sénat; il étoit habillé du vêtement triomphal, il tenoit dans la main droite un sceptre d'ivoire, dans la gauche une branche de laurier; une Victoire palmifère et ailée tenoit une couronne de laurier au-dessus de la tête du triomphateur."
                                            },
                                            {
                                                "example_id": "abc9d94e-6e9d-45ca-802d-fe5c0b41894d",
                                                "sense_id": "32edc8dd-146b-3176-b738-c6da3ec8d7d3",
                                                "text": "Elle a semé sous mes pas les roses de ta jeunesse, ma route est plus belle que la voie triomphale où s’avancent les conquérants."
                                            },
                                            {
                                                "example_id": "9ac6000b-853e-468e-9614-b18fc774c190",
                                                "sense_id": "32edc8dd-146b-3176-b738-c6da3ec8d7d3",
                                                "text": "José Mourinho a percé en tant qu’entraîneur du FC Porto, avec lequel il a remporté la Ligue des champions en 2004. Ce fut le début d’une carrière triomphale, qui passa par Chelsea, l’Internazionale, le Real Madrid et Manchester United."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3cc0a88-675b-3479-91ec-efdb8ed6d3ad",
                                        "entry_id": "5ef116cd-d83b-3d78-81a9-3026bd6d20e7",
                                        "glosses": [
                                            "Qui a le caractère d’un triomphe, d’un succès éclatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96fc8e6-c6e0-4598-9ed3-881fd26e761d",
                                                "sense_id": "f3cc0a88-675b-3479-91ec-efdb8ed6d3ad",
                                                "text": "Une satisfaction triomphale enflait légèrement ses narines roses, et son bonheur tranquille était signé dans tous les développements de sa beauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54f3fb0-7d3c-42f7-ae7e-ebb9a3adfcb1",
                        "source_entry_id": "bee2b69a-f577-34ad-bc76-94d1658eb7bf",
                        "source_sense_description": "of or relating to a triumph",
                        "target_lang_word": "triumfalny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
