                        "sense_id": "141e3834-3bae-3f79-bcc6-ce36cc214548",
                        "entry_id": "2b434191-c420-3cb4-a1bc-77646dcb1a67",
                        "glosses": [
                            "Respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a72ec5-cac3-428e-ac3a-35a206acdbfe",
                                "sense_id": "141e3834-3bae-3f79-bcc6-ce36cc214548",
                                "text": "Als er [Harry] sich umwandte und sich zu den anderen auf den Boden setzen wollte, fiel ihm auf, dass sie ihn alle voll Ehrfurcht anstarrten, scheinbar tief beeindruckt, dass er mit Firenze bekannt war, der sie sichtlich einschüchterte."
                            }
                        ]
                    }
                ],
