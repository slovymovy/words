                                                "sense_id": "79e0b8d7-863a-3ccf-9894-60da46129995",
                                                "text": "Not only are all religions welcome at the Voice Community Kitchen, but experts also say such initiatives could be key to improving ethnoreligious engagement and lead to better conflict mediation in the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce17469b-a73e-327c-96c7-dac9849fd7b1",
                                        "entry_id": "cd1e4860-3254-383e-b507-8373ee0db831",
                                        "glosses": [
                                            "A new development; a fresh approach to something; a new way of dealing with a problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a62501c-13d2-36af-a4b9-0301e204199e",
                                        "entry_id": "cd1e4860-3254-383e-b507-8373ee0db831",
                                        "glosses": [
                                            "The ability to act first or on one's own."
