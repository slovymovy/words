                "senses": [
                    {
                        "sense_id": "ea1a65e8-b259-3971-b6f0-3cedfa675e42",
                        "entry_id": "5b21e758-b4bb-311b-9dff-c7a770211df4",
                        "glosses": [
                            "einzelne Regelung innerhalb eines Vertrages, in dem die Verwaltung durch einen Dritten geregelt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59af8402-d870-40bb-a863-4cb6b5752734",
                                "sense_id": "ea1a65e8-b259-3971-b6f0-3cedfa675e42",
                                "text": "„Für jedes in das Treuhandsystem einzubeziehende Hoheitsgebiet werden die Treuhandbestimmungen einschließlich aller ihrer Änderungen und Ergänzungen von den unmittelbar beteiligten Staaten, zu denen bei Mandatsgebieten eines Mitglieds der Vereinten Nationen auch die Mandatsmacht zählt, in Form eines Abkommens vereinbart […].“"
                            },
                            {
                                "example_id": "ae6e7761-faca-46f3-b991-5dff06bfc67a",
                                "sense_id": "ea1a65e8-b259-3971-b6f0-3cedfa675e42",
                                "text": "„Stalin hatte bereits bei der Londoner Außenministerkonferenz 1945 die sowjetische Kontrolle über Tripolitanien, den westlichen Teil Libyens, im Rahmen einer Treuhandbestimmung eingefordert, war damit aber erwartungsgemäß am amerikanischen Widerstand gescheitert.“"
                            },
                            {
                                "example_id": "a5f17e78-13c3-4511-943c-62752946f709",
                                "sense_id": "ea1a65e8-b259-3971-b6f0-3cedfa675e42",
                                "text": "„Bezüglich der Frage, wie ein Ermessensbegünstigter sein Recht auf Ausführung der Treuhandbestimmung durchsetzen soll, bestehen jedoch Unklarheiten.“"
                            },
                            {
                                "example_id": "4b9d4d37-cfcd-444b-b874-d4e0ae74d1a0",
                                "sense_id": "ea1a65e8-b259-3971-b6f0-3cedfa675e42",
                                "text": "„Das Recht des Begünstigten auf Ausführung der Treuhandbestimmungen wird in der Literatur u.a. als Recht auf «ordnungsgemässe Geschäftsführung» bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
