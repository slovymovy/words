                "senses": [
                    {
                        "sense_id": "2977b24d-eb9b-3de1-9299-052fe959c36e",
                        "entry_id": "b1622b3c-5bde-3e22-bd58-8d345cd03bca",
                        "glosses": [
                            "церк. : конец мира, гибель всего существующего, живого"
                        ],
                        "tags": [
                            "в христианском вероучении"
                        ],
                        "examples": [
                            {
                                "example_id": "bcf83cf2-ad5f-4014-a370-de73d8cb9c16",
                                "sense_id": "2977b24d-eb9b-3de1-9299-052fe959c36e",
                                "text": "― Пришли последние дни: восстанет язык на язык, царство на царство… наступит светопреставление!"
                            }
                        ]
                    },
                    {
                        "sense_id": "659cd55a-0494-35f7-a177-72f302e09c87",
                        "entry_id": "b1622b3c-5bde-3e22-bd58-8d345cd03bca",
                        "glosses": [
                            "перен. шутл. о полной неразберихе, беспорядке, суматохе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8c456d-53ff-447b-b492-b07c4d745a6e",
                                "sense_id": "659cd55a-0494-35f7-a177-72f302e09c87",
                                "text": "Все княжны в обмороке, слезы, траур по фаворитке-болонке, визг шестерых княжен, визг англичанки, ― светопреставление!"
                            },
                            {
                                "example_id": "26165e76-59f4-44fa-9333-2bc6ba4f4b17",
                                "sense_id": "659cd55a-0494-35f7-a177-72f302e09c87",
                                "text": "И я-то ору! И они-то все орут! И батюшка с перепугу кричит! Такое светопреставление было, что у нас в городе по сю пору его и стар, и мал помнят."
                            }
                        ]
                    }
                ],
