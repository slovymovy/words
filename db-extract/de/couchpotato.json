                                                "sense_id": "370d0697-9ff2-3d97-b918-38460f109e5f",
                                                "text": "Being a couch potato won't let you help achieve your goals."
                                            },
                                            {
                                                "example_id": "cff94a3e-2e73-411e-bbfc-4f6caa7392c9",
                                                "sense_id": "370d0697-9ff2-3d97-b918-38460f109e5f",
                                                "text": "Bah! What lesson can a couch potato father teach his kids!"
                                            }
                                        ]
