                {
                    "sense_id": "d5e49ce6-1d14-30ab-a775-0541c80410c5",
                    "sense_definition": "The competitive sport of racing bicycles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bicycle_riding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Professional <w>cycling</w> requires incredible endurance and leg strength.",
