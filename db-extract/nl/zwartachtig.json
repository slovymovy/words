                "senses": [
                    {
                        "sense_id": "c1fdbb85-4920-319c-95a9-be9d61bda981",
                        "entry_id": "334ab03e-72c7-3b6f-a2c5-fd5888fad486",
                        "glosses": [
                            "zo donker dat het op zwart lijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98253963-3024-464b-ae44-299a0f9ab8c0",
                                "sense_id": "c1fdbb85-4920-319c-95a9-be9d61bda981",
                                "text": "Op sommige plaatsen van het lichaam, vooral aan de kop en de poten neigt de kleur meer naar zwartachtig rood."
                            },
                            {
                                "example_id": "2a90ffa9-8060-4867-a5f2-bc8e0426a4c5",
                                "sense_id": "c1fdbb85-4920-319c-95a9-be9d61bda981",
                                "text": "„Zijn al jaren papperige huid en de op het laatst opgezwollen gelaatstrekken, gevoegd bij de dikke, zwartachtig verkleurde traanzakjes kwamen steeds zichtbaarder tevoorschijn”, schrijft de Duitse historicus Joachim Fest in zijn boek ”De Ondergang”, dat onlangs ook verfilmd werd."
                            }
                        ]
                    }
