                "translations": [
                    {
                        "translation_id": "289d9a14-c2a8-4ed9-beba-bca3a11e3e13",
                        "source_entry_id": "433c6caa-111d-3d2e-8f7e-73ae3aacb598",
                        "source_sense_id": "7b3d94b4-59ab-3281-9b55-e317fd5e462e",
                        "target_lang_word": "employment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "employment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "438c5660-ef63-30c4-b78c-187832f4bb80",
                                        "entry_id": "40408ea6-d311-3991-92a5-5d6f30969c60",
                                        "glosses": [
                                            "The occupation or work for which one is used, and often paid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238b5660-5a0c-451b-a805-37481638c756",
                                                "sense_id": "438c5660-ef63-30c4-b78c-187832f4bb80",
                                                "text": "[I]t is certaine no man sees more of the Navye's Transactions than himselfe [the Clerk of the Acts], and possibly may speak as much to the project if required, or else he is a blockhead, and not fitt for that imployment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9886b3-0f9a-3a17-b372-5ff7de2afea2",
                                        "entry_id": "40408ea6-d311-3991-92a5-5d6f30969c60",
                                        "glosses": [
                                            "The act of employing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be5370b-9734-43df-8aed-5badcca62be2",
                                                "sense_id": "5a9886b3-0f9a-3a17-b372-5ff7de2afea2",
                                                "text": "The personnel director handled the whole employment procedure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd86356-5aee-3242-a1f4-87c197c5bdfb",
                                        "entry_id": "40408ea6-d311-3991-92a5-5d6f30969c60",
                                        "glosses": [
                                            "The state of being employed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c15300-d2e8-4f94-b31e-bdeb20a4bb8d",
                                                "sense_id": "7fd86356-5aee-3242-a1f4-87c197c5bdfb",
                                                "text": "[…] King Henry [VIII] full fraught all thoſe vvith vvealth and revvards, vvhom he retained in his imployment."
                                            },
                                            {
                                                "example_id": "8bf71d81-9c16-4cdf-aeb4-943a5f3772a0",
                                                "sense_id": "7fd86356-5aee-3242-a1f4-87c197c5bdfb",
                                                "text": "At the period just preceding the advent of Bartleby, I had two persons as copyists in my employment, and a promising lad as an office-boy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd8d250-6b9c-37ab-a8ec-6b5168a64dc2",
                                        "entry_id": "40408ea6-d311-3991-92a5-5d6f30969c60",
                                        "glosses": [
                                            "A purpose, a use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c8b015-0efe-44c6-81ea-333a0b8a9302",
                                                "sense_id": "5fd8d250-6b9c-37ab-a8ec-6b5168a64dc2",
                                                "text": "This new employment of his time caused no relaxation in his attention to my education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8884ed-97b9-3c3c-8a26-60a8693d2f1a",
                                        "entry_id": "40408ea6-d311-3991-92a5-5d6f30969c60",
                                        "glosses": [
                                            "An activity to which one devotes time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
