                    }
                ],
                "senses": [
                    {
                        "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                        "entry_id": "75c8a6db-a9bb-3d71-be15-a9dd8f128df5",
                        "glosses": [
                            "so, dass es nicht datiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51e72f1-7955-42ab-856a-e2c5c76a876e",
                                "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                                "text": "„[Michelangelos] Leben währte wohl kein volles Jahrhundert wie das Tizians, aber man kann nur in Jahrhunderten und Jahrtausenden rechnen, wenn man von seinem Werk spricht, und selbst solche Zeitmaße versagen vor einer Schöpfung, die undatierbar ist wie ein Gebirge.“"
                            },
                            {
                                "example_id": "7bc9aea9-e313-4dba-bcfa-3602c94555c6",
                                "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                                "text": "„Ganz so undatierbar ist diese Erinnerung nicht, legt doch ihr Autor schon in der Einstiegsgeschichte »Heimat« eine (auto-)biografische Fährte, die in die Jahre der prädigitalen Freizeitvergnügungen weist […]“"
                            },
                            {
                                "example_id": "0102edad-e7f5-4125-ab5c-ff0b1e0c404b",
                                "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                                "text": "„Die Briefe Nr. 77-82 sind undatiert oder undatierbar.“"
                            },
                            {
                                "example_id": "b5780fc8-1129-48e8-8621-b590991b152f",
                                "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                                "text": "„[Der vierte Band] enthält […] einzelne Lieder, die zu Schuberts Lebzeiten an entlegener Stelle, in Zeitschriften und Almanachen, gedruckt, aber nicht mehr von ihm selbst in Liederhefte aufgenommen oder als Opera mit eigener Opuszahl veröffentlicht werden konnten sowie die im Deutsch-Verzeichnis als »undatierbar« aufgeführten Lieder D 990A bis D 990C.“"
                            },
                            {
                                "example_id": "8ec11035-3ec1-43fe-8254-d38dd54489d6",
                                "sense_id": "751e878b-5f24-3b6f-bbe0-bb76f15ddaad",
                                "text": "„P. Armstrong führt die meisten Pithosfragmente aus Balbura ebenfalls als undatierbar. Das zeigt, wie schwierig die Datierung solcher Fragmente im Rahmen eines Surveys ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
