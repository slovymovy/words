                    "frequency": "High",
                    "semantic_group_id": "transport_taxi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pleut beaucoup ce soir, nous devrions prendre un <w>taxi</w> pour rentrer à l'hôtel."
                        },
                        {
                            "text": "Le <w>taxi</w> s'arrête devant la gare pour faire descendre les passagers avec leurs valises."
                        }
                    ],
                    "synonyms": [
                        "taxi-auto",
                        "taxoche"
                    ],
                    "common_phrases": [
