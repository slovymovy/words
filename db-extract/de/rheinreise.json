                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3844539d-d903-4344-b76b-2cae012f8ce1",
                                "sense_id": "b05779f4-277e-3d14-98b5-8978e4c06dd2",
                                "text": "„In seinem Notizbuch war die Route einer Rheinreise verzeichnet, und er hielt sein Geld zusammen, weil er es für diese Reise zu brauchen glaubte.“"
                            },
                            {
                                "example_id": "afafa9de-68ce-4a7f-bb57-cb5c9f39fccd",
                                "sense_id": "b05779f4-277e-3d14-98b5-8978e4c06dd2",
                                "text": "„Unsere Rheinreise nähert sich ihrem Ende:…“"
                            },
                            {
                                "example_id": "302da88d-a734-43c8-90bb-c39cdfc45053",
                                "sense_id": "b05779f4-277e-3d14-98b5-8978e4c06dd2",
                                "text": "„Auf dem Weg zum Schiff entdecken wir an der Rheinpromenade einen Gedenkstein mit bronzener Platte für den großen französischen Romancier Victor Hugo, der auf seiner Rheinreise im Oktober 1840 die Stadt besuchte.“"
                            }
                        ],
