    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                    "sense_definition": "A person who campaigns to bring about political or social change.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_advocacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>activist</w> organized a protest to protect the city park from being destroyed.",
                            "target_lang_translations": {
                                "ru": "Местный <w>активист</w> организовал протест, чтобы защитить городской парк от уничтожения."
                            }
                        },
                        {
                            "text": "She has been a dedicated environmental <w>activist</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она является преданной экологической <w>активисткой</w> уже более двадцати лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political activist",
                        "environmental activist",
                        "human rights activist",
                        "community activist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, участвующий в кампаниях за политические или социальные изменения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активист",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "активистка",
                                "target_lang_sense_clarification": "женский род"
                            },
                            {
                                "target_lang_word": "общественный деятель",
                                "target_lang_sense_clarification": "более формальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "688bdc77-53e8-3b64-9ebb-e187cffb26a7",
                    "sense_definition": "A person who is highly active and influential in their professional field or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influential_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a corporate <w>activist</w>, he pushed the board to adopt more modern management styles.",
                            "target_lang_translations": {
                                "ru": "Как корпоративный <w>активист</w>, он подталкивал совет директоров к внедрению более современных стилей управления."
                            }
                        },
                        {
                            "text": "The new CEO is a real mover and shaker who acts as an <w>activist</w> for industry reform.",
                            "target_lang_translations": {
                                "ru": "Новый генеральный директор — настоящий лидер, который выступает как <w>активист</w> реформы отрасли."
                            }
                        }
                    ],
                    "synonyms": [
                        "mover and shaker"
                    ],
                    "common_phrases": [
                        "shareholder activist",
                        "judicial activist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, проявляющий высокую активность и влияние в своей профессиональной сфере или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активист",
                                "target_lang_sense_clarification": "в контексте реформ внутри организации"
                            },
                            {
                                "target_lang_word": "инициатор",
                                "target_lang_sense_clarification": "человек, продвигающий изменения"
                            },
                            {
                                "target_lang_word": "двигатель перемен",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                    "sense_definition": "Characterized by or involving direct vigorous action to support or oppose one side of a controversial issue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advocacy_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group took an <w>activist</w> approach to solving the housing crisis in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Группа применила <w>активистский</w> подход к решению жилищного кризиса в районе."
                            }
                        },
                        {
                            "text": "Critics argue that the judge's <w>activist</w> stance goes beyond the original intent of the law.",
                            "target_lang_translations": {
                                "ru": "Критики утверждают, что <w>активистская</w> позиция судьи выходит за рамки первоначального духа закона."
                            }
                        }
                    ],
                    "common_phrases": [
                        "activist approach",
                        "activist judge",
                        "activist stance",
                        "activist investor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся решительными действиями в поддержку или против одной из сторон в спорном вопросе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активистский",
                                "target_lang_sense_clarification": "связанный с деятельностью активистов"
                            },
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "проявляющий инициативу"
                            },
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "в контексте решительных методов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}