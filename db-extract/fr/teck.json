                    {
                        "sense_id": "34513e10-3df1-354d-93e4-1d4d493400e6",
                        "entry_id": "18de517f-fc63-3ff5-8cfe-feae2c2fe0f3",
                        "glosses": [
                            "Grand arbre de la famille des verbénacées, qui croît dans l’Inde, et dont le bois imputrescible est recherché pour la construction des vaisseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2054392c-0a64-41ad-af75-489cb661aee3",
                                "sense_id": "34513e10-3df1-354d-93e4-1d4d493400e6",
                                "text": "Un bordage de bois de teck."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ae7f40a-ee61-301d-9811-463556bd0400",
                        "entry_id": "18de517f-fc63-3ff5-8cfe-feae2c2fe0f3",
                        "glosses": [
                            "Bois de cet arbre utilisé en ébénisterie."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "27bea290-85ff-44ba-9622-fd6d455149a4",
                                "sense_id": "4ae7f40a-ee61-301d-9811-463556bd0400",
                                "text": "J'écris ces lignes dans la cabine du Firecrest. Le teck et le bois d'érable brillent."
                            },
                            {
                                "example_id": "040a2758-924c-4977-9512-19d5d1bedcb3",
                                "sense_id": "4ae7f40a-ee61-301d-9811-463556bd0400",
                                "text": "— Vous remarquerez, a dit le notaire sentencieusement, que tous les murs et toutes les cloisons sont en bois de teck."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2ee788a-fe4f-4a9d-8729-5481335cb589",
                        "source_entry_id": "18de517f-fc63-3ff5-8cfe-feae2c2fe0f3",
                        "source_sense_description": "arbre dont le bois est imputrescible",
                        "target_lang_word": "Teak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
