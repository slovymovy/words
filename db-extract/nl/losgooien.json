                                    },
                                    {
                                        "sense_id": "4b5fedd0-3779-314b-9d41-0ae81f8731d6",
                                        "entry_id": "c6d40461-e2b2-3369-b322-e5ce72833573",
                                        "glosses": [
                                            "To finish the last row of knitted stitches and remove them securely from the needle."
                                        ],
