                "senses": [
                    {
                        "sense_id": "0d0b22f4-494d-3fe6-a3bd-92f90b31c6ff",
                        "entry_id": "2097f6a5-d329-3adf-9a60-01439c387f4f",
                        "glosses": [
                            "to take shape, to emerge, to appear, to stand out (against), to become visible (to have one's outlines become visible against a background)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d1e247b7-0e7b-3f39-a0bf-d68a24d0ca90",
                        "entry_id": "2097f6a5-d329-3adf-9a60-01439c387f4f",
                        "glosses": [
                            "to be pictured, to appear (in one's imagination)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20fc10cf-ffd5-493e-a67a-a8c5bd11701a",
                                "sense_id": "d1e247b7-0e7b-3f39-a0bf-d68a24d0ca90",
                                "text": "Ему́ рису́ется беззабо́тная жизнь.",
                                "translation": "He pictures to himself a carefree life.",
                                "english": "He pictures to himself a carefree life."
                            },
                            {
                                "example_id": "56264633-726d-423e-84c2-015411096a9d",
                                "sense_id": "d1e247b7-0e7b-3f39-a0bf-d68a24d0ca90",
                                "text": "Со́лнце ду́мало, что жи́знью земли́ руководи́т оно́. Вся челове́ческая жизнь рисова́лась ему́ лишь воплоще́нием эне́ргии его́ луче́й.",
                                "translation": "Mikhail Osorgin",
                                "english": "Mikhail Osorgin"
                            }
                        ]
                    },
                    {
                        "sense_id": "b64c5e25-d7f2-31af-a494-d1b7fc954f30",
                        "entry_id": "2097f6a5-d329-3adf-9a60-01439c387f4f",
                        "glosses": [
                            "to show off (to act in an unnatural way, attempting to arouse interest in oneself)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bea7d0-a8d1-44d3-8d44-0e409c99a8a6",
                                "sense_id": "b64c5e25-d7f2-31af-a494-d1b7fc954f30",
                                "text": "Ты что, пе́ред де́вушкой рису́ешься?",
                                "translation": "Are you showing off in front of your girlfriend?",
                                "english": "Are you showing off in front of your girlfriend?"
                            }
                        ]
                    },
