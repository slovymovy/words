                ],
                "senses": [
                    {
                        "sense_id": "77865ec9-abac-3e3d-b485-0a86541b9eb4",
                        "entry_id": "a268e494-3085-36e8-a70c-d0702b4f990d",
                        "glosses": [
                            "Atelier de couture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309c575e-0038-4659-b153-feb60bb6e23b",
                                "sense_id": "77865ec9-abac-3e3d-b485-0a86541b9eb4",
                                "text": "Das jüdische Ehepaar, bei dem Paul untergebracht worden war, betrieb eine kleine Schneiderei in einem Dorf nahe Reims und Paul hatte neben dem Familienanschluss gleich einen beruflichen Start gefunden.",
                                "translation": "Le couple juif chez qui Paul vivait tenait une petite boutique de couture dans un village près de Reims et Paul, en plus de rejoindre la famille, a immédiatement trouvé un début de carrière."
                            }
                        ]
                    },
                    {
                        "sense_id": "faae96ba-d5cc-3b92-be3f-0988e8bdb8c9",
                        "entry_id": "a268e494-3085-36e8-a70c-d0702b4f990d",
                        "glosses": [
                            "Couture, fabrication de vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcdadc0-5a6d-4d2c-b4b8-7e33d55e53ee",
                                "sense_id": "faae96ba-d5cc-3b92-be3f-0988e8bdb8c9",
                                "text": "Wenn Cornelius Stern in der Woche fern von ihr in seinem Hochschulstädtchen blieb, dann hatten wir viel Raum für Gespräche, aber auch für unser gemeinsames Hobby, die Schneiderei.",
                                "translation": "Lorsque Cornelius Stern restait loin d’elle dans sa petite ville universitaire pendant la semaine, nous avions beaucoup de temps pour les conversations, mais aussi pour notre passe-temps commun, la couture."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
