                                "target_senses": [
                                    {
                                        "sense_id": "ce9c61e4-bca1-34c0-a37d-dac97cd97089",
                                        "entry_id": "07c80c5b-142a-3389-a583-d8c3b62bb8b7",
                                        "glosses": [
                                            "Of, pertaining to, or using methodology or a methodology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8223aaf-abb9-40df-8e4f-d4e05094475a",
                                                "sense_id": "ce9c61e4-bca1-34c0-a37d-dac97cd97089",
                                                "text": "No single study will ever be able to overcome any and all methodological limitations."
                                            },
                                            {
                                                "example_id": "a3cc17e2-a35d-4e7a-aa3d-12a5931188c2",
                                                "sense_id": "ce9c61e4-bca1-34c0-a37d-dac97cd97089",
                                                "text": "The value of pedagogical material informed by objective methodological procedures developed in corpus linguistics is widely recognized."
                                            }
                                        ]
