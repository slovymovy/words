                            {
                                "target_word": "qawwali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9abde140-f181-3d14-a66b-218655c9e338",
                                        "entry_id": "8105ba8d-6638-3f8e-bd4a-6f6f92977e54",
                                        "glosses": [
                                            "A style of Muslim devotional music, especially among the South Asian Sufis, accompanied by drums and harmonium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2e7d42-7508-43ee-9cfb-932a2e432c48",
                                                "sense_id": "9abde140-f181-3d14-a66b-218655c9e338",
                                                "text": "Jameela Siddiqi listens to qawwali and talks to its performers […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b390f6-4570-30b2-ac40-e4a03d688c24",
                                        "entry_id": "8105ba8d-6638-3f8e-bd4a-6f6f92977e54",
                                        "glosses": [
                                            "A song in this style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "278eeecb-6754-4b1b-b30b-8723d7a195f8",
                                                "sense_id": "76b390f6-4570-30b2-ac40-e4a03d688c24",
                                                "text": "They are singing not a religious qawwali but its secular and lay cousin."
                                            },
                                            {
                                                "example_id": "162df538-c5a5-4c25-b52a-9a3cbe01ae3d",
                                                "sense_id": "76b390f6-4570-30b2-ac40-e4a03d688c24",
                                                "text": "Every Thursday, in the dargah's enclosure, musicians in shimmering turquoise kurtas, their fingers bejewelled with bling, perform qawwalis attributed to Khusrau […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
