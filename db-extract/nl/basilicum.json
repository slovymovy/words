                                    {
                                        "sense_id": "35175249-fcaf-33af-b42f-aca4b0dda09d",
                                        "entry_id": "7536480b-dd77-3d30-8503-a029eb89299c",
                                        "glosses": [
                                            "The angle to which a joiner's tool is ground away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf42f5b3-12cf-47c6-a089-276e1117ea30",
                                                "sense_id": "35175249-fcaf-33af-b42f-aca4b0dda09d",
                                                "text": "[H]old the edge of your Iron upvvards in your left hand and your VVhet-ſtone in your right, and having firſt ſpit upon your Stone to vvet it, apply it to the Baſil of your Iron, in ſuch a Poſition that it may bear upon the vvhole bredth of the Baſil; and ſo vvorking the Stone over the Baſil, you vvill quickly vvear the courſer grating of the Grind ſtone off the edge on that ſide: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "013e3ba6-c87b-3032-be2a-79d52a2d95e2",
                                        "entry_id": "d1905b63-ee19-3b55-bfd6-8c4bbd908c9e",
                                        "glosses": [
                                            "To grind the edge of a tool to an acute angle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a41545a-5110-428f-83ea-d2c9d6cdd39c",
                                                "sense_id": "013e3ba6-c87b-3032-be2a-79d52a2d95e2",
                                                "text": "These usually large chisels may have the edge basiled on either the inside or the outside of the 90° angle of the blade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9ea22a-b5b1-3f25-90ad-e1ac72c62fdc",
                                        "entry_id": "54d77b57-3e5a-3ea6-abba-b5f2887d800e",
                                        "glosses": [
                                            "The skin of a sheep tanned with bark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d12faa-a5a5-40ea-a577-68cf88b53c47",
                                                "sense_id": "5a9ea22a-b5b1-3f25-90ad-e1ac72c62fdc",
                                                "text": "Each sleeper has for covering a large basil (dressed sheep-skin), such as cobblers use for aprons. As they lie in long rows, in the most profound repose, with these dark brown wrappers about them, they present the uniform look and arrangement of a long line of mummies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b4b9c4d-9598-39a5-a091-9d129db980bc",
                                        "entry_id": "3444646f-15b1-3cd7-bc69-07ce9a39ee1f",
                                        "glosses": [
                                            "A type of cannon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "224eed5b-edf1-3abc-ae44-bb5fc9f8cc91",
                                        "entry_id": "3444646f-15b1-3cd7-bc69-07ce9a39ee1f",
                                        "glosses": [
                                            "A fetter fastened round the ankle of a prisoner."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da22b764-cc17-4862-b3cf-96c277131285",
                                                "sense_id": "224eed5b-edf1-3abc-ae44-bb5fc9f8cc91",
                                                "text": "When I once more feel that sharp smarting around the scabby sores that cluster like so many oysters on my ankles beneath my chained iron basils, I know that the tide has turned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cbaf8bf-fd1e-49de-9461-9ab27d80d3ec",
                        "source_entry_id": "13c1c949-3de9-3b17-9a55-767597c321eb",
                        "source_sense_id": "46dbd5ca-32a8-38f0-b0c5-b9a24393a1ba",
                        "source_sense_description": "een keukenkruid",
                        "target_lang_word": "basilic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basilic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99312335-4740-3a83-a12c-b71656ad807a",
                                        "entry_id": "11f711b2-9655-3648-abdc-59e8eeb3efa5",
                                        "glosses": [
                                            "Nom donné à diverses plantes annuelles ou perennes du genre Ocimum, de la famille des Lamiacées (Lamiaceae) dont certaines espèces sont utilisées et cultivées comme plantes aromatiques et condimentaires. Ce nom est aussi parfois donné à d’autres plantes aromatiques proches, de la même famille mais d’un genre différent."
                                        ],
                                        "tags": [
                                            "Aromate"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "946ecd0e-4c20-3edb-823a-8b3cab665742",
                                        "entry_id": "11f711b2-9655-3648-abdc-59e8eeb3efa5",
                                        "glosses": [
                                            "En Europe francophone, basilic utilisé seul se réfère à Ocimum basilicum, plante herbacée annuelle cultivée comme plante aromatique et qui est la base du pesto, condiment emblématique de la cuisine italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4a28a2-f292-466a-8a87-1889c5d0b45e",
                                                "sense_id": "946ecd0e-4c20-3edb-823a-8b3cab665742",
                                                "text": "Il y avait du carpaccio, de l’huile d’olive et du citron. Ensuite, ce serait des tortellinis avec des tomates fraîches coupées en dés, du basilic et de la roquette."
                                            },
                                            {
                                                "example_id": "c2561006-ebb8-46f1-af66-ea73deb68f76",
                                                "sense_id": "946ecd0e-4c20-3edb-823a-8b3cab665742",
                                                "text": "Dans l’antiquité, le basilic était un animal fantastique, qui tuait, disait-on, d’un regard. Aussi a-t-on fait encore du basilic l’emblème de la haine, bien que la plante n’ait aucun rapport avec l’animal fabuleux dont elle porte le nom."
                                            },
                                            {
                                                "example_id": "de127269-2b8a-49a3-9ab1-5e9ae0409b9f",
                                                "sense_id": "946ecd0e-4c20-3edb-823a-8b3cab665742",
                                                "text": "Le savetier florentin, tout en poussant l’alène, écoutait avec un bon sourire. C’était un petit homme chauve, qui représentait un des types familiers à la peinture flamande. Sur la table, parmi les formes de bois, les clous, les morceaux de cuir et les boules de poix, un pied de basilic étalait sa tête verte et ronde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basilic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "196e501f-ffff-3115-8a6f-b7df5be6033f",
                                        "entry_id": "6b2ae8cd-9612-3160-a98c-c3473fa896f9",
                                        "glosses": [
                                            "Créature imaginaire, mythologique, venimeuse qui serait capable de tuer par un simple regard, prenant selon les sources la forme d’un lézard, d’un serpent ou d’un hybride de coq et de reptile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e827d17-ada2-4127-9784-55711d01c111",
                                                "sense_id": "196e501f-ffff-3115-8a6f-b7df5be6033f",
                                                "text": "Saprejeu, mes amis ! s’écria le chirurgien, cet œil de basilic m’a glacé."
                                            },
                                            {
                                                "example_id": "39489a84-682a-44c1-9b3c-c5d3a7e6422c",
                                                "sense_id": "196e501f-ffff-3115-8a6f-b7df5be6033f",
                                                "text": "— Soyez tranquille, ma nièce, quand les fadaises et billevesées que débitent ces baladins dont les affaires m’intéressent fort peu, m’ennuieront par trop grièvement, je vous regarderai et soudain j’ouvrirai l’œil clair comme basilic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a2a9db-51f3-36e8-bae5-3f3eeb46fb3a",
                                        "entry_id": "6b2ae8cd-9612-3160-a98c-c3473fa896f9",
                                        "glosses": [
                                            "Lézard d’Amérique du Sud qui a la capacité de courir sur l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca0482b-336f-4fde-ab13-8e1faf854a5b",
                                                "sense_id": "c2a2a9db-51f3-36e8-bae5-3f3eeb46fb3a",
                                                "text": "Il zézayait légèrement, rongeait ses ongles sans arrêt, et ses yeux railleurs devenaient dorés, comme ceux de certains basilics exotiques, sitôt qu’il le mettait en colère."
                                            },
                                            {
                                                "example_id": "2b58adbd-be83-44d9-ba5b-658d13204343",
                                                "sense_id": "c2a2a9db-51f3-36e8-bae5-3f3eeb46fb3a",
                                                "text": "…il vaudrait mieux s’inspirer des basilics, ces petits lézards d’Amérique tropicale qui courent sur l’eau à la vitesse de dix kilomètres par heure. L’observation de la mécanique de leurs pas montre qu’ils se décomposent en trois phases.Le lézard frappe la patte à plat sur l’eau, un peu comme lorsqu’un plongeur fait un « plat ». En réaction, l’eau exerce une force sur la patte et la ralentit. La patte s’enfonce néanmoins très rapidement dans l’eau, si rapidement que l’eau ne la recouvre pas instantanément. Un trou d’air de plusieurs centimètres de profondeur se forme donc brièvement dans l’eau, au-dessus de la patte. Le basilic retire sa patte très rapidement, avant que le trou d’air ne se remplisse d’eau. Cette dernière condition impose que le rythme des foulées soit très rapide. De fait, la patte du lézard doit quitter l’eau en moins de 50 millisecondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787dbec4-5372-38a6-bb48-890b6285f2ea",
                                        "entry_id": "6b2ae8cd-9612-3160-a98c-c3473fa896f9",
                                        "glosses": [
                                            "Poisson de la famille des Blenniidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0940fba-7b05-36e5-92be-d2178f20f94e",
                                        "entry_id": "6b2ae8cd-9612-3160-a98c-c3473fa896f9",
                                        "glosses": [
                                            "Anciennement, très gros canon, portant 160 livres de balle, et nommé d’après le serpent, comme les couleuvrines."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f269171-a4d2-4ba8-bd17-ed65f4f14be9",
                                                "sense_id": "e0940fba-7b05-36e5-92be-d2178f20f94e",
                                                "text": "En réalité, bien que le château des Carpathes fût mieux conservé qu’il n’en avait l’air, une contagieuse épouvante, doublée de superstition, le protégeait non moins que l’avaient pu faire autrefois ses basilics, ses sautereaux, ses bombardes, ses couleuvrines, ses tonnoires et autres engins d’artillerie des vieux siècles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f85ce0d0-1ab6-3404-8288-ed30131e9a0b",
                                        "entry_id": "6b2ae8cd-9612-3160-a98c-c3473fa896f9",
                                        "glosses": [
                                            "Meuble représentant un dragon à tête de coq dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6127ae1-672e-4f1b-b4a9-41b4be2632ad",
                                                "sense_id": "f85ce0d0-1ab6-3404-8288-ed30131e9a0b",
                                                "text": "D’azur à une bande, accompagnée en chef d’un basilic couronné, et en pointe d’une étoile à six rais, le tout d’argent, qui est de Chanville en Moselle. → voir illustration « armoiries avec basilic »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
