                ],
                "senses": [
                    {
                        "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                        "entry_id": "f4135c96-a38e-31c3-86a0-f3125e24300d",
                        "glosses": [
                            "Raum oder Gebäude zum Aufzeichnen von Ton oder Sprache, beispielsweise für Radiosendungen, Hörspiele oder Musikstücke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2c8877-922a-44e1-bae8-a4350bdbf1bb",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Obwohl Freddie Mercury nicht wirklich gut Gitarre spielen kann, spielt er im Tonstudio den Gitarren-Part selbst ein, bevor Queen-Gitarrist Brian May in das Studio kommt.“"
                            },
                            {
                                "example_id": "cce63f1d-c482-4380-a2a7-b2d3f09c5c9e",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Das Rolf-Liebermann-Studio ist ein großes Tonstudio des Norddeutschen Rundfunks (NDR) in der Oberstraße 120 in Hamburg […].“"
                            },
                            {
                                "example_id": "90e0a5da-5e07-44fe-bc7a-ce22e2a01d38",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Ob auf der Bühne im Theater, vor der Kamera für Film und Fernsehen oder im Tonstudio als Synchronsprecher, Schauspieler werden in den unterschiedlichsten Bereichen eingesetzt.“"
                            },
                            {
                                "example_id": "322a1c6b-d765-41fc-b3ac-284037c30f1d",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„In Tonstudios arbeiten zu wenig Frauen.“"
                            },
                            {
                                "example_id": "aa36eb61-bf51-42d5-ac41-502e5276e328",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Lieber zehntausende singende Iren im Stadion als ein Fußballer im Tonstudio: Was dabei herauskommt, wenn Profikicker doch zum Mikro greifen, ist meist mehr als grausam.“"
                            },
                            {
                                "example_id": "44f3d8f3-208e-41e3-8a58-5ddfc4f8a620",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Musikproduzent Jan Kerscher betreibt das Tonstudio Ghost City Recordings im fränkischen Seenland.“"
                            },
                            {
                                "example_id": "39ebb129-3531-455b-b9c4-c3a17eaeb63a",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„In Los Angeles hat er in den Hügeln ein Haus über der Stadt mit eigenem Tonstudio.“"
                            },
                            {
                                "example_id": "ac173dbc-3a20-49d6-9eac-7d494dd8432b",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Privat zieht Rio mit Freunden und Band 1975 von Berlin nach Fresenhagen in Schleswig-Holstein, wo sie sich ein altes Bauernhaus kaufen. Im eigens eingerichteten Tonstudio schreibt und komponiert er mit seinen Kollegen verschiedene Theaterstücke und Filmmusik.“"
                            },
                            {
                                "example_id": "3b412c9c-e150-4fd7-82cb-7b208117f681",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "„Ohne Corona-Krise wäre hier normalerweise ab Mittag Hochbetrieb. Musiker würden in den engen Proberäumen üben und im Tonstudio ihre Songs aufnehmen, Kinder Gitarre- oder Schlagzeugspielen lernen.“"
                            },
                            {
                                "example_id": "aec8474e-136d-4ff8-971b-4332a937ff77",
                                "sense_id": "6630b698-a15b-3d11-8cc0-bcd9b1736298",
                                "text": "[Wolf Biermann] „hoffte, dass seine Lieder irgendwann doch auf den DDR-Plattenlabels Amiga oder Eterna erscheinen würden. Nun nimmt er die Sache selbst in die Hand: Da er kein Tonstudio nutzen kann, entstehen die Aufnahmen zu seiner erste Langspielplatte Ost in seiner Wohnung - mit Hilfe westlicher Technik, die er eingeschmuggelt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
