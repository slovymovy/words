                                                "sense_id": "4a3c3096-f526-3b2d-9d89-dce57ff0f5b7",
                                                "text": "to go for a wander in the park"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e62bea5-e84a-36e9-bb73-7db4d2700ea2",
                                        "entry_id": "dc28301d-8916-3566-a093-c7f7d5b7445d",
                                        "glosses": [
                                            "Deviation from a correct or normal value."
                                        ],
                                        "tags": [
