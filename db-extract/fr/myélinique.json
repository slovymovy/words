                ],
                "senses": [
                    {
                        "sense_id": "110ed135-01c1-3c85-9482-c5283f97140e",
                        "entry_id": "4a9da180-725e-38a8-97d0-f7c6f27c5283",
                        "glosses": [
                            "Relatif à la myéline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1574cb50-636e-44c9-9ea2-7c3bf7c81b75",
                                "sense_id": "110ed135-01c1-3c85-9482-c5283f97140e",
                                "text": "La neuropathie est plutôt sensitive ou sensitivo-motrice et l'atteinte est myélinique, très proche des neuropathies du premier groupe de réponse anti-SGPG/SGLPG/MAG immunodominante."
                            },
                            {
                                "example_id": "edd55e38-e5dd-4d95-8959-59e415423412",
                                "sense_id": "110ed135-01c1-3c85-9482-c5283f97140e",
                                "text": "La gaine isolante que constitue la stratification myélinique est interrompue à intervalles réguliers par des étranglements (nœuds de Ranvier) au niveau desquels l’axone est dénudé."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3fb599a-4264-3976-abe8-36fe0787c3de",
                        "entry_id": "4a9da180-725e-38a8-97d0-f7c6f27c5283",
                        "glosses": [
                            "Qualifie une fibre nerveuse recouverte de myéline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40b6f2f-352f-4b8f-b9ea-2987db84c58f",
                                "sense_id": "a3fb599a-4264-3976-abe8-36fe0787c3de",
                                "text": "Une ou plusieurs fibres nerveuses sensitives myéliniques perforent la capsule, perdent leur gaine de myéline, se ramifient et s'achèvent en terminaisons qui ont la forme d'un club de golf."
                            }
                        ]
                    }
