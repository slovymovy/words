                "senses": [
                    {
                        "sense_id": "a9a2169e-8554-358c-998a-61bd9115efe5",
                        "entry_id": "a16abd7d-276e-34e5-afbd-6fb4b66f63b6",
                        "glosses": [
                            "to move on, to progress to a higher level"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5338431b-d31f-49aa-923e-6712494deb39",
                                "sense_id": "a9a2169e-8554-358c-998a-61bd9115efe5",
                                "text": "Met het contactpersoon kunt u bespreken of doorstromen naar een hoger schoolniveau tot de mogelijkheden behoort.",
                                "translation": "You can discuss with the contact person whether progressing to a higher school level is a possibility.",
                                "english": "You can discuss with the contact person whether progressing to a higher school level is a possibility."
                            }
                        ]
                    },
                    {
                        "sense_id": "e81e5673-406f-3a27-a45f-9007d253eae8",
                        "entry_id": "a16abd7d-276e-34e5-afbd-6fb4b66f63b6",
                        "glosses": [
                            "to flow, to proceed"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cb2264-9b65-472b-9fdc-bccc5f85d244",
                                "sense_id": "e81e5673-406f-3a27-a45f-9007d253eae8",
                                "text": "De nieuwe weg moet ervoor zorgen dat het verkeer weer vlot kan doorstromen.",
                                "translation": "The new road should ensure that traffic can flow smoothly again.",
                                "english": "The new road should ensure that traffic can flow smoothly again."
                            }
                        ]
                    },
                    {
                        "sense_id": "953feca3-7c80-3ce9-9b7a-9cc420cb00af",
                        "entry_id": "a16abd7d-276e-34e5-afbd-6fb4b66f63b6",
                        "glosses": [
                            "to keep flowing (as a fluid)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "43c634d7-1b40-483f-a8a9-6c7b057e98ce",
                                "sense_id": "953feca3-7c80-3ce9-9b7a-9cc420cb00af",
                                "text": "Het laboratorium is allang verlaten, maar dat water stroomt nog gewoon door, in de kanalen, buizen en stuwen.",
                                "translation": "The laboratory has long been abandoned, but that water keeps flowing in the canals, pipes and weirs.",
                                "english": "The laboratory has long been abandoned, but that water keeps flowing in the canals, pipes and weirs."
                            }
                        ]
                    }
