                    "sense_definition": "w sposób łatwy do zauważenia, usłyszenia lub odczytania",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel poprosił ucznia, aby mówił głośno i <w>wyraźnie</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика говорить громко и <w>чётко</w>."
                            }
                        },
                        {
                            "text": "Z daleka nie widziałem wszystkiego, ale ten napis był <w>wyraźnie</w> widoczny.",
                            "target_lang_translations": {
                                "ru": "Издалека я видел не всё, но эта надпись была <w>отчётливо</w> видна."
                            }
                        }
                    ],
                    "antonyms": [
