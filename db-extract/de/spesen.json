                "senses": [
                    {
                        "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                        "entry_id": "3c20489c-e55f-3e6a-80bc-dd3c03a6363e",
                        "glosses": [
                            "charges, costs and expenses incurred in the performance of one′s job that are reimbursed by the employer; (allowable, travel and entertainment/T&E) expenses"
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "9e86594b-80a7-4c30-bcf7-213cccd984f7",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "geringe, hohe, horrende Spesen",
                                "translation": "low, high, horrendous expenses",
                                "english": "low, high, horrendous expenses"
                            },
                            {
                                "example_id": "c4b6333c-20e9-4604-abd2-084147172f39",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "Spesen abrechnen, erstatten, haben, machen",
                                "translation": "to submit a claim for, to settle, to have, to make expenses",
                                "english": "to submit a claim for, to settle, to have, to make expenses"
                            },
                            {
                                "example_id": "d603d3f0-b925-4282-a617-cab47219f50a",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "die Spesen tragen, übernehmen, zahlen",
                                "translation": "to bear/to carry, (to agree) to pay, to pay the costs/expenses",
                                "english": "to bear/to carry, (to agree) to pay, to pay the costs/expenses"
                            },
                            {
                                "example_id": "e066dd62-a8d8-4d9f-beca-234f37f6b563",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "Spesen eingeschlossen",
                                "translation": "charges included",
                                "english": "charges included"
                            },
                            {
                                "example_id": "02f7d040-ef0e-40ed-afc0-042d691795c9",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "nach Abzug der Spesen, bei Verzicht auf Spesen",
                                "translation": "after deduction of expenses, with waiving of expenses",
                                "english": "after deduction of expenses, with waiving of expenses"
                            },
                            {
                                "example_id": "a8b4f45d-eccc-470e-b0a2-bf515d376373",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "Alle angefallenen Spesen wurden ihm erstattet.",
                                "translation": "He was reimbursed for any expenses incurred.",
                                "english": "He was reimbursed for any expenses incurred."
                            },
                            {
                                "example_id": "56152855-60d2-4d70-a332-0d6943780da4",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "Nach Frankfurt wurden als Entschädigungssumme 25000 gezahlt: macht 595000, und so hätten die Dinge bei Vaters Tode gelegen, wären alle diese Spesen nicht im Laufe der Jahre durch rund 200000 Kurantmark Verdienst korrigiert worden.",
                                "translation": "Twenty-five thousand to Frankfort^([sic]), as compensation on the house, leaves five hundred and ninety-five thousand—which is what we should have had at Father′s death if we hadn′t partly made up for all these expenses through years, by a profit of some two hundred thousand marks current.",
                                "english": "Twenty-five thousand to Frankfort^([sic]), as compensation on the house, leaves five hundred and ninety-five thousand—which is what we should have had at Father′s death if we hadn′t partly made up for all these expenses through years, by a profit of some two hundred thousand marks current."
                            },
                            {
                                "example_id": "627a3139-b325-4f83-ab95-0bb412974f32",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "Translation:\n2010, Hans Fallada; Michael Hofmann (translator): Every Man Dies Alone. 6th printing, Melville House Publishing, New York, p. 226 (GoogleBooks; retrieved October 12, 2015):\n»Ich möchte noch um einen kleinen Vorschuss gebeten haben, Herr Kommissar. Nein um keinen Verschuss«, verbesserte er sich, »sondern um Geld für meine Spesen«.",
                                "translation": "“May I ask the inspector for a little advance first? No, not so much an advance,” Borkhausen corrected himself, “as some cash toward my expenses.”",
                                "english": "“May I ask the inspector for a little advance first? No, not so much an advance,” Borkhausen corrected himself, “as some cash toward my expenses.”"
                            },
                            {
                                "example_id": "41204e1c-c6a1-4467-93ed-85754ffa0cad",
                                "sense_id": "4821adae-4a7c-3ad5-bff7-bed2ebcdd67d",
                                "text": "»Gut. Zwei Beiträge werden vorausbezahlt. Und einer davon deckt ihnen die Spesen. […]«",
                                "translation": "“Good. Two articles will be paid in advance. One of them will cover your expenses. […]”",
                                "english": "“Good. Two articles will be paid in advance. One of them will cover your expenses. […]”"
                            }
                        ]
                    }
