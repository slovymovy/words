                ],
                "senses": [
                    {
                        "sense_id": "88673d0e-ce1d-3b22-874f-67c2865f9eb6",
                        "entry_id": "d5b0ee8f-5fb9-3327-9302-d384281bf83e",
                        "glosses": [
                            "altägyptisches Symbol, das für das Weiterleben im Jenseits steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba9e6294-6acc-4655-8692-343807e8aa97",
                                "sense_id": "88673d0e-ce1d-3b22-874f-67c2865f9eb6",
                                "text": "„Als er sich von den Fenstern abwandte, bemerkte Blake, dass das von Spinnweben verhangene Kreuz über dem Altar nicht von gewöhnlicher Art war, sondern dem urtümlichen Anch oder crux ansata des finsteren Ägypten glich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d54fb95-8919-4cd7-9a19-6a25f3053ece",
                        "source_entry_id": "d5b0ee8f-5fb9-3327-9302-d384281bf83e",
                        "source_sense_id": "88673d0e-ce1d-3b22-874f-67c2865f9eb6",
                        "source_sense_description": "altägyptisches Symbol",
                        "target_lang_word": "ankh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ankh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2aa1b70-623e-3709-a959-358faf25e79e",
                                        "entry_id": "0e6e58e6-ec69-3648-81a0-bf7e0000140e",
                                        "glosses": [
                                            "A cross shaped like a T with a loop at the top, the Egyptian hieroglyph representing the Egyptian triliteral ꜥnḫ (“life”) and often used as an amulet or charm for this concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4307ddf-c71e-4ca1-bacd-5b663b861a9f",
                                                "sense_id": "f2aa1b70-623e-3709-a959-358faf25e79e",
                                                "text": "On temple wall paintings, the ankh is often seen being carried by gods who hold it up to the nose of the pharaoh. This gesture symbolizes the offering of the \"breath of life\" or eternity. Sometimes the pharaoh is also depicted with a stream of water in the form of ankhs being poured over him during a purification ritual."
                                            },
                                            {
                                                "example_id": "0e82c0e9-6696-4915-9406-3f612d742e2c",
                                                "sense_id": "f2aa1b70-623e-3709-a959-358faf25e79e",
                                                "text": "The ankh combines the male and female sexual symbols: a female oval surmounting a male cross. It was also called the Key of the Nile, and was said to represent the sacred marriage between the God and Goddess which took place each year at the source of the Nile before the river flooded. Egyptians regarded the ankh as a universal life charm."
                                            },
                                            {
                                                "example_id": "ff0fca8d-3b06-44b5-87f6-5b57e0c0af2c",
                                                "sense_id": "f2aa1b70-623e-3709-a959-358faf25e79e",
                                                "text": "Now, the ankh that Thoth always held hovered in the air between Sekhmet and the Magus, and both fixed their gaze upon it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f18b1347-61c9-3d7f-935a-b3179e5d82ce",
                                        "entry_id": "0e6e58e6-ec69-3648-81a0-bf7e0000140e",
                                        "glosses": [
                                            "A tau cross."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d08b972a-ad2f-435d-ba72-d555584917f8",
                        "source_entry_id": "d5b0ee8f-5fb9-3327-9302-d384281bf83e",
                        "source_sense_id": "88673d0e-ce1d-3b22-874f-67c2865f9eb6",
                        "source_sense_description": "altägyptisches Symbol",
                        "target_lang_word": "ânkh",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ânkh",
