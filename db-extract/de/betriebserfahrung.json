                "senses": [
                    {
                        "sense_id": "48a17d7f-7d26-3b4d-a08b-5aef62429b38",
                        "entry_id": "76e98e84-c2d9-3804-bbdb-d2a1ddab4392",
                        "glosses": [
                            "Kenntnis, auch durch belehrende Erlebnisse, aus der täglichen Praxis in einem bestimmten Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa18c2f-125d-444a-93ea-8beb937aa605",
                                "sense_id": "48a17d7f-7d26-3b4d-a08b-5aef62429b38",
                                "text": "„Die bisherige Betriebserfahrung hat uns gezeigt, dass Online-Messgeräte eine wesentliche Unterstützung zur sicheren Einhaltung der geforderten Grenzwerte im Ablauf sind.“"
                            },
                            {
                                "example_id": "2c4d2c03-2430-42f4-bf03-9d7403cb316a",
                                "sense_id": "48a17d7f-7d26-3b4d-a08b-5aef62429b38",
                                "text": "„Kommt es in einer in- oder ausländischen kerntechnischen Anlage zu einem Ereignis mit sicherheitstechnischer Bedeutung, so können die daraus gewonnenen Betriebserfahrungen für den sicheren Betrieb deutscher Anlagen von Interesse sein.“"
                            },
                            {
                                "example_id": "1578b4b9-2052-4213-8797-e4ca8a35f086",
                                "sense_id": "48a17d7f-7d26-3b4d-a08b-5aef62429b38",
                                "text": "„Die Erkenntnisse, die aus der Auswertung von Betriebserfahrung in diesem Sinn gewonnen werden, bilden die Grundlage sowohl für technische und organisatorische Verbesserungen in den Anlagen als auch für Anpassungen technischer Regeln und Normen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
