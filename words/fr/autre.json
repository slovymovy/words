                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chemise est trop petite, montre-m'en une <w>autre</w> s'il te plaît."
                        },
                        {
                            "text": "Certains étudiants sont partis tôt, tandis que d'<w>autres</w> ont préféré rester dans la bibliothèque."
                        }
                    ],
                    "common_phrases": [
                        "un autre",
                        "les uns les autres"
