                        "examples": [
                            {
                                "example_id": "f465c8e7-cbcd-42bd-9773-72fefffd4a6d",
                                "sense_id": "c9e52a1c-76b7-3530-8d1b-693383d82ae2",
                                "text": "„Geduld geht auf das urgermanische Verbalabstraktum ga-thuldis zurück.“"
                            },
                            {
                                "example_id": "155d1ca9-7114-462f-8181-ce2ed5c9ff26",
                                "sense_id": "c9e52a1c-76b7-3530-8d1b-693383d82ae2",
                                "text": "„Idea ist als Verbalabstraktum von idein „erblicken“, „erkennen“ (Aorist zu horan „sehen“) abgeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
