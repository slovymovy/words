                "senses": [
                    {
                        "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                        "entry_id": "0c150d0c-7e0d-320a-b66a-c1f14463b325",
                        "glosses": [
                            "gezielter Austausch der Raumluft in einem ganz bestimmten Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b63a71d-8c06-428c-a0e2-4b6dec19e441",
                                "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                                "text": "„Wenn zur Reduzierung der Kühlschmierstoffkonzentrationen am Arbeitsplatz Absauganlagen allein nicht ausreichend sind, hat der Unternehmer dafür zu sorgen, dass zusätzlich zu den Maßnahmen nach Abschnitt 6.3.3.3 Maßnahmen zur Raum- oder Zonenlüftung eingesetzt werden.“"
                            },
                            {
                                "example_id": "29e4afa3-0592-4b91-90a2-29ce289f4190",
                                "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                                "text": "„Raumlüftung: Ist eine ausreichende Luftreinhaltung am Arbeitsplatz durch Zonenlüftung oder örtliche Lüftung (Absaugung) nicht möglich, muss eine Raumlüftung eingerichtet sein.“"
                            },
                            {
                                "example_id": "bcb87630-3dde-4432-98e8-8611cab679b2",
                                "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                                "text": "„Während des gesamten Umbaus selbst wurde die Zonenlüftung des OP 3 (Zu- und Abluft) geschlossen.“"
                            },
                            {
                                "example_id": "70848dd5-826b-4238-98ef-cf57afc91e85",
                                "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                                "text": "„Zonenlüftung zur räumlichen Trennung von Nichtraucher- und Raucherbereichen innerhalb gemeinsamer Umschließungsflächen, dadurch gekennzeichnet, dass in einen Raum ohne unterbrechende Umschließungsflächen in einem zu bestimmenden Teil Zuluft (ZL) über eine Anordnung von ZL-Auslässen eintritt und aus dem anderen zu bestimmenden Teil Abluft (AL) über AL-Auslässe abgeführt wird.“"
                            },
                            {
                                "example_id": "b3bba0e8-a5e8-4e7b-81a4-914e1f687d22",
                                "sense_id": "30a191d2-af39-3700-88a3-e58e5421b860",
                                "text": "„Der Chip unterstützt demnach ein vollständiges Regelungssystem für mehrere Lüfter, das eine exakte Zonenlüftung bei minimalem Energieverbrauch ermöglicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
