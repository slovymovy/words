                                "example_id": "6070955d-72e1-4a63-a324-505b46ebdc56",
                                "sense_id": "4ab99d05-1071-3246-b1a1-086595ab3e62",
                                "text": "Haar achtentachtigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zevenentachtig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
