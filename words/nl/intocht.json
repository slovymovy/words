{
    "word_family": [
        "intrekken",
        "tocht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0560a442-60ab-3429-8319-5024c9c4c275",
                    "sense_definition": "Een feestelijke, plechtige binnenkomst van een belangrijk persoon of een groep.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aankomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ieder jaar kijken duizenden kinderen enthousiast naar de feestelijke <w>intocht</w> van Sinterklaas in de haven.",
                            "target_lang_translations": {
                                "en": "Every year, thousands of children eagerly watch the festive <w>arrival</w> of Sinterklaas in the harbor.",
                                "ru": "Каждый год тысячи детей с восторгом наблюдают за праздничным <w>прибытием</w> Синтерклааса в порт."
                            }
                        },
                        {
                            "text": "De koning maakte een plechtige <w>intocht</w> in de hoofdstad onder luid applaus van het publiek.",
                            "target_lang_translations": {
                                "en": "The king made a solemn <w>entry</w> into the capital to loud applause from the public.",
                                "ru": "Король совершил торжественный <w>въезд</w> в столицу под громкие аплодисменты публики."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenkomst",
                        "inkomst",
                        "intrede"
                    ],
                    "common_phrases": [
                        "feestelijke intocht",
                        "intocht van Sinterklaas"
                    ],
                    "target_lang_definitions": {
                        "en": "A festive or ceremonial entry of an important person or group.",
                        "ru": "Торжественный, праздничный въезд или вступление важного лица или группы людей."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entry",
                                "target_lang_sense_clarification": "ceremonial or public arrival"
                            },
                            {
                                "target_lang_word": "triumphal entry",
                                "target_lang_sense_clarification": "grand, celebratory entrance"
                            },
                            {
                                "target_lang_word": "arrival",
                                "target_lang_sense_clarification": "festive arrival, such as of a procession"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "въезд",
                                "target_lang_sense_clarification": "торжественный въезд в город"
                            },
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "торжественный приход или процессия"
                            },
                            {
                                "target_lang_word": "прибытие",
                                "target_lang_sense_clarification": "праздничный приезд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef293e5-5369-3d5d-b196-8710adbff8a2",
                    "sense_definition": "Het binnenrukken of binnenvallen van een leger of gewapende strijdmacht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>intocht</w> van de vijandige troepen betekende het begin van een lange en zware bezetting.",
                            "target_lang_translations": {
                                "en": "The <w>entry</w> of enemy troops marked the beginning of a long and harsh occupation.",
                                "ru": "<w>Вступление</w> вражеских войск ознаменовало начало долгой и тяжелой оккупации."
                            }
                        },
                        {
                            "text": "Veel inwoners vluchtten uit angst voor de naderende militaire <w>intocht</w> in de stad.",
                            "target_lang_translations": {
                                "en": "Many residents fled in fear of the approaching military <w>march-in</w> into the city.",
                                "ru": "Многие жители бежали из страха перед приближающимся военным <w>вторжением</w> в город."
                            }
                        }
                    ],
                    "synonyms": [
                        "invasie"
                    ],
                    "common_phrases": [
                        "militaire intocht"
                    ],
                    "target_lang_definitions": {
                        "en": "The marching in or entry of an army or armed force into a place.",
                        "ru": "Вступление или вторжение армии или вооружённых сил на территорию."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entry",
                                "target_lang_sense_clarification": "military advance into a city or area"
                            },
                            {
                                "target_lang_word": "march-in",
                                "target_lang_sense_clarification": "arrival or advance of troops"
                            },
                            {
                                "target_lang_word": "incursion",
                                "target_lang_sense_clarification": "hostile entry or invasion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "вступление войск в город"
                            },
                            {
                                "target_lang_word": "вторжение",
                                "target_lang_sense_clarification": "вход вооружённых сил"
                            },
                            {
                                "target_lang_word": "ввод",
                                "target_lang_sense_clarification": "ввод войск"
                            }
                        ]
                    }
                }
            ]
        }
    ]
