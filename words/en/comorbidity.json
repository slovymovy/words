            "senses": [
                {
                    "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                    "sense_definition": "The presence of one or more additional diseases or disorders occurring together with a primary condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted that high <w>comorbidity</w> makes treating chronic illness much more complicated."
                        },
                        {
                            "text": "Researchers found a significant <w>comorbidity</w> between anxiety and major depressive disorder."
                        }
                    ],
                    "common_phrases": [
                        "high comorbidity",
                        "psychiatric comorbidity"
                    ]
                },
                {
                    "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                    "sense_definition": "A specific medical condition or disease that coexists alongside a primary disease.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Coronary artery disease is often a <w>comorbidity</w> of diabetes mellitus."
                        },
                        {
                            "text": "Patients with an underlying <w>comorbidity</w> were advised to receive the vaccine first."
                        }
                    ],
                    "synonyms": [
                        "comorbid condition",
                        "co-morbid condition"
                    ],
                    "common_phrases": [
                        "underlying comorbidity",
                        "common comorbidity",
                        "multiple comorbidities"
                    ]
                },
                {
                    "sense_id": "e0b53b04-c313-3ca5-b602-e1c743a411b2",
                    "sense_definition": "The combined clinical effect or impact caused by coexisting diseases or disorders.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe overall <w>comorbidity</w> increased the risk of complications during surgery."
                        },
                        {
                            "text": "Clinicians must evaluate the cumulative burden of <w>comorbidity</w> on the patient's recovery time."
                        }
                    ],
                    "common_phrases": [
                        "burden of comorbidity"
                    ]
                }
            ]
        }
    ]
