                {
                    "sense_id": "99e5127d-5ac9-3381-99a1-34eb8e716bdd",
                    "sense_definition": "Acting in a way that shows one thinks they are better or more powerful than others; pompous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked around the office with an <w>important</w> look on his face.",
                            "target_lang_translations": {
                                "ru": "Он ходил по офису с <w>ва́жным</w> видом.",
                                "nl": "Hij liep door het kantoor met een <w>gewichtig</w> gezicht.",
                                "pl": "Chodził po biurze z <w>ważną</w> miną.",
                                "de": "Er lief mit einer <w>wichtigen</w> Miene im Büro herum.",
                                "fr": "Il marchait dans le bureau avec un air <w>important</w>.",
                                "it": "Girava per l'ufficio con un'aria <w>importante</w> stampata sul viso.",
                                "cs": "Chodil po kanceláři s <w>důležitým</w> výrazem ve tváři.",
                                "tr": "Ofiste yüzünde <w>kasıntı</w> bir ifadeyle dolaştı.",
                                "es": "Caminaba por la oficina con un aire <w>importante</w> en el rostro.",
                                "zh": "他在办公室里走来走去，脸上带着一副<w>自大</w>的神情。"
                            }
                        },
                        {
                            "text": "Don't act so <w>important</w> just because you got a promotion.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>ва́жным</w> только из-за того, что тебя повысили.",
                                "nl": "Doe niet zo <w>gewichtig</w> alleen omdat je promotie hebt gemaakt.",
                                "pl": "Nie bądź taki <w>ważny</w> tylko dlatego, że dostałeś awans.",
                                "de": "Tu nicht so <w>wichtig</w>, nur weil du befördert wurdest.",
                                "fr": "Ne te donne pas des airs si <w>importants</w> juste parce que tu as eu une promotion.",
                                "it": "Non darti così tante <w>arie</w> solo perché hai ottenuto una promozione.",
                                "cs": "Nedělej se tak <w>důležitým</w> jen proto, že tě povýšili.",
                                "tr": "Sırf terfi aldın diye bu kadar <w>kasıntı</w> davranma.",
                                "es": "No te des tanta <w>importancia</w> solo porque te ascendieron.",
                                "zh": "别因为升了职就这么<w>摆架子</w>。"
                            }
                        }
                    ],
