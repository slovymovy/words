                                        "glosses": [
                                            "To settle (a group of people, a species, or the like) in a place as a colony."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab3ab89-b7c5-4cef-a428-16d1bc78b3c6",
                                                "sense_id": "4c1335ae-ce9d-336d-8384-078ab63e30bb",
                                                "text": "When you are colonized by dangerous bacteria their presence in your body does no damage. You become a reservoir for those little stinkers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b55a39a-b30a-3f34-91f0-5cd78c29c186",
                                        "entry_id": "2a730fe8-0eae-3f89-abdd-737f482d3c19",
                                        "glosses": [
                                            "To settle among and establish control over (the indigenous people of an area)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c08687-9f3e-47a1-8d46-e626d0b4e0bb",
                                                "sense_id": "0b55a39a-b30a-3f34-91f0-5cd78c29c186",
                                                "text": "The administration finally sent a naval vessel to return the 368 survivors to the United States in 1864. This ended official efforts to colonize blacks."
                                            }
                                        ]
                                    },
