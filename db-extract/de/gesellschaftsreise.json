                "senses": [
                    {
                        "sense_id": "68a80ab4-acb6-3aa3-a739-da443f7c8042",
                        "entry_id": "ed82c522-5510-3bac-9dd7-1525d138e85c",
                        "glosses": [
                            "organisierte Reise für eine Gruppe von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d175ad-95b7-443c-a3be-1dbc652d74af",
                                "sense_id": "68a80ab4-acb6-3aa3-a739-da443f7c8042",
                                "text": "„Die Reisebüros veranstalten Gesellschaftsreisen von England nach Frankreich, wobei freilich Paris immer wieder der Hauptanziehungspunkt ist.“"
                            },
                            {
                                "example_id": "c33f4fe6-0e0c-4df6-b92c-a59c509216ec",
                                "sense_id": "68a80ab4-acb6-3aa3-a739-da443f7c8042",
                                "text": "„Ich räume ein, dass es wahrscheinlich häufiger Reis zum Mittag gibt, als man es hierzulande für schmackhaft und bekömmlich hält, aber sicher legt auch eine chinesische Hausfrau die Rate für die Musiktruhe zurück und verzichtet ungern auf die jährliche Gesellschaftsreise nach Italien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
