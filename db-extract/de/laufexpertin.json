                "senses": [
                    {
                        "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                        "entry_id": "8d33b646-d329-3e02-98b7-6acd2999162c",
                        "glosses": [
                            "Frau mit fundiertem Wissen und meist auch umfangreicher persönlicher Erfahrung im Bereich des Laufens/Laufsports"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b23af652-e6f7-4506-ac2c-e88ba87a262e",
                                "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                                "text": "„Die Laufexpertin im Team freut sich natürlich, dass sie am 8./9.“"
                            },
                            {
                                "example_id": "44980d6c-d7b3-4b1c-8b4b-511c7a28132f",
                                "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                                "text": "„Worauf es wirklich ankommt und was dir ein Laktattest bringt erfährst du in dieser Podcastepisode von Sportwissenschaftlerin und Laufexpertin Elisabeth Niedereder.“"
                            },
                            {
                                "example_id": "80221c11-790b-44e2-848f-2bb4bac968e4",
                                "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                                "text": "„In Zusammenarbeit mit Laufexpertin Svenja Garlof und ihrem Team haben wir 2022 die Mohr Sports Running Academy ins Leben gerufen.“"
                            },
                            {
                                "example_id": "2c5e2f05-ad42-4fad-a0db-d20ec8b66392",
                                "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                                "text": "„‚Das Halbmarathon-Tempo war zu Beginn 5:50 und liegt nun bei 5:15 am Kilometer‘, freut sich die die Laufexpertin.“"
                            },
                            {
                                "example_id": "30cce5e8-74fe-42dd-b4e2-03fcf1ad88e4",
                                "sense_id": "ffde1485-4269-3353-adae-9f8d2e004fdf",
                                "text": "„Die Autorin und ausgewiesene Laufexpertin fand vor rund sieben Jahren zum Trailrunning – eher zufällig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
