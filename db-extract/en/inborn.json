                "translations": [
                    {
                        "translation_id": "a96c0248-1f0a-48c5-b804-15afce923f99",
                        "source_entry_id": "771b9eea-402c-3a4d-a2fd-068639ea1bbd",
                        "source_sense_description": "Innate, possessed by an organism at birth",
                        "target_lang_word": "aangeboren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aangeboren",
