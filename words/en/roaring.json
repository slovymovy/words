{
    "word_family": [
        "roar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11ef36fe-bae6-3240-897d-fa03e2d31fb9",
                    "sense_definition": "Very successful and active",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ice-cream sellers did a <w>roaring</w> trade in the midday heat.",
                            "target_lang_translations": {
                                "nl": "De ijsverkopers deden een <w>bloeiende</w> handel in de middaghitte.",
                                "ru": "Продавцы мороженого вели <w>бойкую</w> торговлю в полуденную жару."
                            }
                        },
                        {
                            "text": "The new restaurant is doing a <w>roaring</w> business this summer.",
                            "target_lang_translations": {
                                "nl": "Het nieuwe restaurant doet deze zomer <w>goede</w> zaken.",
                                "ru": "Этим летом у нового ресторана <w>процветающий</w> бизнес."
                            }
                        }
                    ],
                    "synonyms": [
                        "thriving",
                        "prosperous",
                        "bustling",
                        "flourishing",
                        "successful"
                    ],
                    "common_phrases": [
                        "roaring trade",
                        "roaring business"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zeer succesvol en actief",
                        "ru": "Очень успешный, процветающий и оживлённый (о торговле, бизнесе)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bloeiend",
                                "target_lang_sense_clarification": "verwijzend naar een succesvolle handel of bedrijf"
                            },
                            {
                                "target_lang_word": "druk",
                                "target_lang_sense_clarification": "verwijzend naar veel activiteit in een bedrijf"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "процветающий",
                                "target_lang_sense_clarification": "об успешном, прибыльном бизнесе или торговле"
                            },
                            {
                                "target_lang_word": "бойкий",
                                "target_lang_sense_clarification": "о живой, активной торговле (например, бойкая торговля)"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "об интенсивном росте или развитии дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e8e5dd-fabc-3f81-8fd5-bfcd15c47a23",
                    "sense_definition": "Intensive or extreme in nature",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They enjoyed a <w>roaring</w> fire on the cold winter night.",
                            "target_lang_translations": {
                                "nl": "Ze genoten van een <w>knetterend</w> vuur op de koude winternacht.",
                                "ru": "Они наслаждались <w>пылающим</w> огнем в холодную зимнюю ночь."
                            }
                        },
                        {
                            "text": "The party was a <w>roaring</w> success with all the guests.",
                            "target_lang_translations": {
                                "nl": "Het feest was een <w>enorm</w> succes bij alle gasten.",
                                "ru": "Вечеринка имела <w>оглушительный</w> успех у всех гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roaring fire",
                        "roaring success"
                    ],
                    "target_lang_definitions": {
                        "nl": "Intens of extreem van aard",
                        "ru": "Интенсивный, сильный или ярко выраженный"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knetterend",
                                "target_lang_sense_clarification": "specifiek voor een vurig, luid brandend vuur"
                            },
                            {
                                "target_lang_word": "enorm",
                                "target_lang_sense_clarification": "om een groot succes te benadrukken"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оглушительный",
                                "target_lang_sense_clarification": "о колоссальном успехе (оглушительный успех)"
                            },
                            {
                                "target_lang_word": "пылающий",
                                "target_lang_sense_clarification": "о ярко и сильно горящем огне"
                            },
                            {
                                "target_lang_word": "бушующий",
                                "target_lang_sense_clarification": "о сильном пламени или стихии"
                            },
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "для выражения крайней степени успеха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28fede79-d6da-3ba1-b86e-fcc4a5f4ca24",
                    "sense_definition": "A loud deep prolonged sound",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>roaring</w> of the lions could be heard across the savanna.",
                            "target_lang_translations": {
                                "nl": "Het <w>gebrul</w> van de leeuw was over de hele savanne te horen.",
                                "ru": "<w>Рёв</w> львов разносился по всей саванне."
                            }
                        },
                        {
                            "text": "We listened to the <w>roaring</w> of the waves against the cliffs.",
                            "target_lang_translations": {
                                "nl": "We luisterden naar het <w>gedreun</w> van de oceaangolven tegen de kliffen.",
                                "ru": "Мы слушали <w>грохот</w> волн, разбивающихся об утесы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een luid, diep en langdurig geluid",
                        "ru": "Громкий, глубокий и продолжительный звук; рев, грохот"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gebrul",
                                "target_lang_sense_clarification": "het geluid van een dier of de zee"
                            },
                            {
                                "target_lang_word": "gedreun",
                                "target_lang_sense_clarification": "een zwaar, aanhoudend geluid"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "громкий глубокий звук животного, волн или мотора"
                            },
                            {
                                "target_lang_word": "рычание",
                                "target_lang_sense_clarification": "звук, издаваемый хищниками"
                            },
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "тяжелый глухой шум (например, волн или машин)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "720215d0-c104-3da5-bc94-33a2184fe398",
                    "sense_definition": "A respiratory condition in horses causing noisy breathing",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian diagnosed the horse with <w>roaring</w> after the race.",
                            "target_lang_translations": {
                                "nl": "De dierenarts stelde na de race de diagnose <w>luchtwegobstructie</w> bij het paard vast.",
                                "ru": "После скачек ветеринар диагностировал у лошади <w>свистящее удушье</w>."
                            }
                        },
                        {
                            "text": "The horse struggled with <w>roaring</w> during heavy exercise.",
                            "target_lang_translations": {
                                "nl": "Het paard had last van <w>luchtwegobstructie</w> tijdens zware inspanning.",
                                "ru": "Лошадь страдала от <w>свистящего удушья</w> при тяжелых нагрузках."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een ademhalingsaandoening bij paarden die zorgt voor een piepend of luidruchtig geluid",
                        "ru": "Свистящее удушье; заболевание дыхательных путей у лошадей, вызывающее шумное дыхание"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "luchtwegobstructie",
                                "target_lang_sense_clarification": "medische term voor de aandoening bij paarden"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "свистящее удушье",
                                "target_lang_sense_clarification": "ветеринарный термин для ронхопатии или паралича гортани у лошадей"
                            },
                            {
                                "target_lang_word": "хрип",
                                "target_lang_sense_clarification": "характерное шумное дыхание у больной лошади"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6731340-f837-3b5b-98ec-baf81540cef8",
                    "sense_definition": "Present participle and gerund of <w>roar</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd was <w>roaring</w> with excitement after the goal.",
                            "target_lang_translations": {
                                "nl": "De menigte was <w>brullend</w> van opwinding na het doelpunt.",
                                "ru": "Толпа <w>ревела</w> от восторга после забитого гола."
                            }
                        },
                        {
                            "text": "The engine was <w>roaring</w> as the car sped down the track.",
                            "target_lang_translations": {
                                "nl": "De motor was aan het <w>dreunen</w> terwijl de auto over het circuit raasde.",
                                "ru": "Двигатель <w>ревел</w>, когда машина неслась по трассе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van brullen",
                        "ru": "Причастие или герундий от глагола roar (реветь, грохотать)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "brullend",
                                "target_lang_sense_clarification": "het maken van een luid, diep geluid"
                            },
                            {
                                "target_lang_word": "dreunend",
                                "target_lang_sense_clarification": "het maken van een zwaar, trillend geluid"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ревущий",
                                "target_lang_sense_clarification": "издающий громкий, глубокий звук"
                            },
                            {
                                "target_lang_word": "грохочущий",
                                "target_lang_sense_clarification": "издающий сильный шум, гул"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}