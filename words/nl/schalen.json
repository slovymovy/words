                    "sense_id": "1684276c-73d8-35bb-a165-e804f23cd38d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>schaal</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij legde de appels in de grote houten <w>schalen</w> op tafel.",
                            "target_lang_translations": {
