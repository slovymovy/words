{
    "word_family": [
        "stijgen",
        "stijging",
        "opstijging",
        "stijger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b57598cc-6e30-3e9f-aac5-de0a769bdf42",
                    "sense_definition": "het verlaten van de grond om te gaan vliegen, meestal door een vliegtuig of vogel",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vliegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vliegtuig vol toeristen <w>steeg op</w> na het taxiën op de landingsbaan.",
                            "target_lang_translations": {
                                "en": "The plane full of tourists <w>took off</w> after taxiing on the runway."
                            }
                        },
                        {
                            "text": "Vanwege de harde wind kon het kleine toestel vanmorgen niet veilig <w>opstijgen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the strong wind, the small aircraft could not <w>take off</w> safely this morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertrekken",
                        "de lucht ingaan"
                    ],
                    "antonyms": [
                        "landen",
                        "neerkomen"
                    ],
                    "common_phrases": [
                        "klaar om op te stijgen",
                        "veilig opstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "leaving the ground to start flying, usually by an aircraft or bird"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "of an aircraft or bird"
                            },
                            {
                                "target_lang_word": "lift off",
                                "target_lang_sense_clarification": "of a rocket or aircraft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b068b96-9196-33d1-83b4-5b0b1d5370e7",
                    "sense_definition": "zich naar boven bewegen of omhooggaan in de lucht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omhooggaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zagen de warme luchtballon langzaam boven de bomen <w>opstijgen</w>.",
                            "target_lang_translations": {
                                "en": "We saw the hot air balloon slowly <w>rise</w> above the trees."
                            }
                        },
                        {
                            "text": "Er <w>steeg</w> een dunne rookpluim <w>op</w> uit de schoorsteen van het oude huis.",
                            "target_lang_translations": {
                                "en": "A thin plume of smoke <w>rose</w> from the chimney of the old house."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhooggaan",
                        "stijgen"
                    ],
                    "antonyms": [
                        "afdalen",
                        "neerdalen"
                    ],
                    "common_phrases": [
                        "omhoog opstijgen",
                        "langzaam opstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "moving upwards or rising into the air"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "moving upwards in the air"
                            },
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "to go up"
                            },
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "to rise on high"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac487608-e40e-36de-aff4-ed0f2110d1b3",
                    "sense_definition": "op de rug van een paard gaan zitten om te gaan rijden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "paardrijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na te zijn <w>opgestegen</w>, spoorde de ruiter zijn paard aan te galopperen.",
                            "target_lang_translations": {
                                "en": "After having <w>mounted</w>, the rider urged his horse to gallop."
                            }
                        },
                        {
                            "text": "De amazone hielp het kind om voorzichtig op de pony te <w>opstijgen</w>.",
                            "target_lang_translations": {
                                "en": "The horsewoman helped the child to carefully <w>mount</w> the pony."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestijgen",
                        "opstappen"
                    ],
                    "antonyms": [
                        "afstijgen"
                    ],
                    "common_phrases": [
                        "op een paard opstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "getting onto the back of a horse to start riding"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "to get on a horse"
                            },
                            {
                                "target_lang_word": "get on",
                                "target_lang_sense_clarification": "to climb onto a horse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}