    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14a6c069-c874-3911-9a48-744dce9d0086",
                    "sense_definition": "A temporary procedure or fix that bypasses a problem to allow continued work until a permanent solution is found.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "problem_solving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software bug is annoying, but we found a <w>workaround</w> that lets us finish the project on time."
                        },
                        {
                            "text": "Engineers are currently developing a permanent fix, but for now, this <w>workaround</w> is the only way to keep the system running."
                        }
                    ],
                    "synonyms": [
                        "band-aid",
                        "patch",
                        "quick fix",
                        "stopgap",
                        "workaround"
                    ],
                    "common_phrases": [
                        "find a workaround",
                        "simple workaround"
                    ]
                },
                {
                    "sense_id": "21b0bf75-2ffb-3bc0-bfb9-8b22f9a870d9",
                    "sense_definition": "A method used to bypass or circumvent obstacles, such as strict rules, regulations, or physical constraints.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "problem_solving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company used legal <w>workarounds</w> to avoid paying the new import taxes."
                        },
                        {
                            "text": "They needed to find a creative <w>workaround</w> to fit all the equipment into the small storage space."
                        }
                    ],
                    "synonyms": [
