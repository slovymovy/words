                        },
                        {
                            "text": "Nowy program komputerowy stanowi znaczne <w>ułatwienie</w> w codziennej pracy biurowej.",
                            "target_lang_translations": {
                                "ru": "Новая компьютерная программа служит значительным <w>подспорьем</w> в ежедневной офисной работе."
                            }
                        }
                    ],
                    "synonyms": [
