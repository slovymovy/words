                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6066f546-0728-3279-a371-aea872bec19c",
                                        "entry_id": "20f1e799-7599-33b7-aa64-f5c4dfe58d9e",
                                        "glosses": [
                                            "To turn or put to the left or larboard side of a ship; said of the helm."
                                        ],
                                        "tags": [
                                            "imperative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
