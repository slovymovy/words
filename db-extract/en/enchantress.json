                                                "sense_id": "22ecfb28-d054-30c3-9039-bdb412db45e4",
                                                "text": "Heks!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd5cfd3f-cf20-3724-9e75-6d2d82185e4b",
                                        "entry_id": "166a73dc-aeb3-3f29-9495-4eb991f3420c",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van heksen"
                                        ],
                                        "tags": [
                                            "form-of",
