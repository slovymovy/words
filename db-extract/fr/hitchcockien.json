                                        "entry_id": "8e6dfd48-8e30-3440-b3fc-7ea05f21bdf4",
                                        "glosses": [
                                            "Of or pertaining to Alfred Hitchcock (1899–1980), British filmmaker and producer, or his works, especially noted for suspense and psychothrillers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f1ca7a-5fec-49c6-af17-d7d7f9990a32",
                                                "sense_id": "5b5d136d-c7ea-3361-a10c-61ea2789357c",
                                                "text": "What is this tree? I think it's another in the series of Hitchcockian big things, like the Mount Rushmore statues, or to take another example, like Moby Dick. This tree is not simply a natural object. It is within our mental space what in psychoanalysis is called “the thing”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
