                "senses": [
                    {
                        "sense_id": "9e8f8e9b-76d1-3446-ae1d-40b0b68d4407",
                        "entry_id": "7db05174-91c2-3d10-b0b8-1785e101c70b",
                        "glosses": [
                            "Gerät, welches die kinetische bzw. potenzielle Energie eines Flusses oder Baches in, für den Menschen nutzbare, Energie umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43560da9-290a-4482-ae90-aeaa1f9ad58e",
                                "sense_id": "9e8f8e9b-76d1-3446-ae1d-40b0b68d4407",
                                "text": "Ich nutze ein Wasserrad, um Energie für mein Haus zu gewinnen"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bdd9cc5-415a-4fdc-b2f4-ae91471bc46f",
                        "source_entry_id": "7db05174-91c2-3d10-b0b8-1785e101c70b",
                        "source_sense_id": "9e8f8e9b-76d1-3446-ae1d-40b0b68d4407",
