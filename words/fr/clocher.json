{
    "word_family": [
        "cloche",
        "clochette",
        "clocheton",
        "clochard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                    "sense_definition": "Tour ou partie élevée d'un édifice, en particulier d'une église, abritant des cloches.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De loin, on aperçoit déjà le <w>clocher</w> de l'église qui domine tout le village."
                        },
                        {
                            "text": "Les hirondelles volent souvent autour du vieux <w>clocher</w> pendant les chaudes journées d'été."
                        }
                    ],
                    "synonyms": [
                        "campanile"
                    ],
                    "common_phrases": [
                        "clocher de l'église",
                        "vue sur le clocher"
                    ]
                },
                {
                    "sense_id": "f4acc130-e5da-3391-9678-e6ef59efeff9",
                    "sense_definition": "Paroisse ou communauté villageoise, prise comme symbole d'attachement local.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette querelle de <w>clocher</w> entre les deux villages voisins dure depuis plusieurs décennies."
                        },
                        {
                            "text": "Chaque élu défend son propre <w>clocher</w> sans penser à l'intérêt général de la région."
                        }
                    ],
                    "common_phrases": [
                        "querelle de clocher"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a118402c-c4ec-33fa-8af3-64221732f9f0",
                    "sense_definition": "Présenter une anomalie, ne pas tourner rond ou susciter le doute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anomalie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai vérifié les calculs plusieurs fois parce que quelque chose <w>clochait</w> dans le résultat final."
                        },
                        {
                            "text": "Son comportement inhabituel montre bien qu'il y a un détail qui <w>cloche</w> dans cette histoire."
                        }
                    ],
                    "common_phrases": [
                        "quelque chose qui cloche"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Courant dans le registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "01df5de7-2a19-3e0b-a614-939d2b4ddf01",
                    "sense_definition": "Marcher avec difficulté en appuyant inégalement sur ses jambes en raison d'une douleur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demarche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis sa chute sur les marches, le vieil homme <w>cloche</w> légèrement en marchant."
                        },
                        {
                            "text": "Le jeune sportif s'est tordu la cheville et <w>clochait</w> en quittant le terrain de football."
                        }
                    ],
                    "synonyms": [
                        "boiter",
                        "claudiquer"
                    ],
                    "common_phrases": [
                        "clocher d'un pied"
                    ]
                },
                {
                    "sense_id": "f3cbbb05-8366-39a4-ab39-d31d753b7ddf",
                    "sense_definition": "Manquer de stabilité et chanceler sur sa base, en parlant d'un meuble.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille table en bois <w>cloche</w> parce que l'un de ses quatre pieds est trop court."
                        },
                        {
                            "text": "Il a placé une cale sous l'armoire pour l'empêcher de <w>clocher</w> sur le plancher inégal."
                        }
                    ]
                },
                {
                    "sense_id": "7c82fdab-d2ba-315f-bd11-45ced9a75ea2",
                    "sense_definition": "Faire résonner des cloches pour annoncer l'heure ou signaler un événement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sonnerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'horloge municipale s'est mise à <w>clocher</w> les douze coups de midi dans le calme du village."
                        },
                        {
                            "text": "Le sacristain montait à la tour chaque matin afin de <w>clocher</w> l'angélus à l'aube naissante."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Usage vieilli ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "4bc0a7a0-31ec-346b-a301-0d479dcaaeae",
                    "sense_definition": "Mettre sous une cloche protectrice, notamment des plantes fragiles au potager.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jardinage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a décidé de <w>clocher</w> toutes ses jeunes salades pour les préserver du gel nocturne."
                        },
                        {
                            "text": "Il convient de <w>clocher</w> ces semis délicats pour éviter les attaques répétées des limaces au printemps."
                        }
                    ]
                }
            ]
        }
    ]
}