                            {
                                "example_id": "7108ea6d-7db9-4cf0-b20d-bdb499b3a04d",
                                "sense_id": "7b82f1fb-e7ce-39a5-a815-848c105f199a",
                                "text": "Il voit les fortifications qui se découpent en étoile, la citadelle qui se rengorge comme une géline dans un tourteau, […]."
                            },
                            {
                                "example_id": "74606b49-685e-4592-a8e1-ca5de63b23bf",
                                "sense_id": "7b82f1fb-e7ce-39a5-a815-848c105f199a",
                                "text": "Je la paie d’un gobelet de vin et d’un fin morceau, lièvre, lapin, oie, voire géline ou chapon."
                            },
                            {
                                "example_id": "45ba14fc-e2de-4667-a9a6-1a9034d1a0c1",
                                "sense_id": "7b82f1fb-e7ce-39a5-a815-848c105f199a",
                                "text": "De maigres gélines picoraient autour d’une boueuse mare à canards ; dans une écurie, un cheval s’ébrouait à grand bruit."
                            }
                        ]
                    }
