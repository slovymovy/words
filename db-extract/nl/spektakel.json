                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a98430b-2695-4eb3-bcf5-8822992b78c8",
                                                "sense_id": "53ef84cd-0276-3213-9848-0f8aa4b94a5b",
                                                "text": "Die Theatergruppe hatte schon ein Spektakel vorbereitet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8219f8e6-0467-3527-a3b8-9ad699dc6d58",
                                        "entry_id": "b2d6c9c5-11f0-3884-963d-a653a1b616bc",
                                        "glosses": [
                                            "aufregender Anblick, aufsehenerregender Vorgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d595d642-96bf-4921-8090-e4797dc6cd61",
                                                "sense_id": "8219f8e6-0467-3527-a3b8-9ad699dc6d58",
                                                "text": "Die totale Sonnenfinsternis ist schon ein seltenes Spektakel."
                                            },
                                            {
                                                "example_id": "e53891d3-ac24-47a5-baa3-dbbb475ea00a",
                                                "sense_id": "8219f8e6-0467-3527-a3b8-9ad699dc6d58",
                                                "text": "„Wie ein Kind, das nicht mitmachen darf, habe ich das Spektakel von Emmanuel Macrons Amtseinführung einen ganzen Sonntag lang aus der Ferne verfolgt, am Fernsehen in meinem Berliner Wohnzimmer.“"
                                            },
                                            {
                                                "example_id": "5a62bbc9-1e33-49c7-b107-4ff4921a5057",
                                                "sense_id": "8219f8e6-0467-3527-a3b8-9ad699dc6d58",
                                                "text": "„Es waren nicht nur das politische Spektakel und die Reaktionen der Dichterkollegen, die Remarque nervös und abwehrend reagieren ließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Spektakel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85ffd79c-c4be-3ce6-bd38-f2ec7e43432d",
                                        "entry_id": "2e3e0707-13ec-3d6f-a13b-afa0101f5c1d",
                                        "glosses": [
