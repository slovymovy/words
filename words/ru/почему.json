{
    "word_family": [
        "почему-то",
        "почему-либо",
        "почему-нибудь"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ce9c02d2-5650-32e8-bfac-26eb571aa6fe",
                    "sense_definition": "Вопросительное слово, которое используется для выяснения причины или основания чего-либо; по какой причине.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reason_question",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не понимаю, <w>почему</w> ты злишься на меня.",
                            "target_lang_translations": {
                                "en": "I don't understand <w>why</w> you are angry with me.",
                                "zh": "我不明白你<w>为什么</w>生我的气。"
                            }
                        },
                        {
                            "text": "<w>Почему</w> вы не пришли вчера на собрание?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> didn't you come to the meeting yesterday?",
                                "zh": "<w>为什么</w>你昨天没来参加会议？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "почему бы и нет",
                        "вот почему",
                        "почему именно я"
                    ],
                    "target_lang_definitions": {
                        "en": "An interrogative word used to ask about the cause or reason for something.",
                        "zh": "用于询问某事的原因或理由的疑问词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "asking for reason"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为什么",
                                "target_lang_sense_clarification": "询问原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c8474b4-7efa-3e0c-969d-3d46c713752f",
                    "sense_definition": "Вопросительное слово, которое используется для выяснения цели действия; с какой целью.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "purpose_question",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Почему</w> мы должны помогать им, если они сами не хотят работать?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> should we help them if they don't want to work themselves?",
                                "zh": "如果他们自己都不想工作，我们<w>为什么</w>要帮他们？"
                            }
                        },
                        {
                            "text": "Скажи мне, <w>почему</w> ты решил поехать именно в этот город?",
                            "target_lang_translations": {
                                "en": "Tell me <w>why</w> you decided to go to this particular city?",
                                "zh": "告诉我，你<w>为什么</w>决定去这座城市？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An interrogative word used to ask about the purpose of an action.",
                        "zh": "用于询问行动目的的疑问词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "asking for purpose"
                            },
                            {
                                "target_lang_word": "what for",
                                "target_lang_sense_clarification": "colloquial, asking for purpose"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为什么",
                                "target_lang_sense_clarification": "询问目的"
                            },
                            {
                                "target_lang_word": "何必",
                                "target_lang_sense_clarification": "反问目的，表示没必要"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "25344493-2f46-330c-94f6-f070ce1b2c96",
                    "sense_definition": "Союзное слово, которое присоединяет придаточное предложение следствия; вследствие чего, по этой причине.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Было уже очень поздно, <w>почему</w> мы и решили остаться дома.",
                            "target_lang_translations": {
                                "en": "It was already very late, <w>which is why</w> we decided to stay home.",
                                "zh": "当时已经很晚了，<w>所以</w>我们决定待在家里。"
                            }
                        },
                        {
                            "text": "Он плохо знал местность, <w>почему</w> и заблудился в первом же переулке.",
                            "target_lang_translations": {
                                "en": "He didn't know the area well, <w>which is why</w> he got lost in the very first alley.",
                                "zh": "他对当地不熟，<w>因此</w>在第一条巷子里就迷路了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "оттого"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction connecting a clause of consequence; as a result of which.",
                        "zh": "连接结果从句的连词，表示因此、所以。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which is why",
                                "target_lang_sense_clarification": "relative conjunction"
                            },
                            {
                                "target_lang_word": "that is why",
                                "target_lang_sense_clarification": "consequence"
                            },
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "consequence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所以",
                                "target_lang_sense_clarification": "表示结果"
                            },
                            {
                                "target_lang_word": "因此",
                                "target_lang_sense_clarification": "表示结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}