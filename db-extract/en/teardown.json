                "senses": [
                    {
                        "sense_id": "571f6dc3-2cb9-3abc-b2ad-a56132c95ec5",
                        "entry_id": "ece90e86-5552-3649-93eb-41e1b31c2317",
                        "glosses": [
                            "A well-maintained structure purchased and torn down to make way for a new structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c22239fa-63f1-475b-8efc-0aa11f55a447",
                                "sense_id": "571f6dc3-2cb9-3abc-b2ad-a56132c95ec5",
                                "text": "The downtown redevelopment involved numerous teardowns."
                            },
                            {
                                "example_id": "613e0929-bd6d-4293-ab39-72a234dc2468",
                                "sense_id": "571f6dc3-2cb9-3abc-b2ad-a56132c95ec5",
                                "text": "Architect and clients also agreed that a teardown wasn’t an option."
                            }
                        ]
                    },
                    {
                        "sense_id": "376e3e90-a639-30c9-bb54-ed58d3bf7246",
                        "entry_id": "ece90e86-5552-3649-93eb-41e1b31c2317",
                        "glosses": [
                            "The process of opening and disassembling a device to inspect, showcase, or refurbish its components."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbd0e711-5de3-4560-8d3e-4658b066f48c",
                                "sense_id": "376e3e90-a639-30c9-bb54-ed58d3bf7246",
                                "text": "Every new shop manual that our team writes is based on a complete teardown."
                            },
                            {
                                "example_id": "6bc7f67b-cea2-4db7-b317-cff33c94979c",
                                "sense_id": "376e3e90-a639-30c9-bb54-ed58d3bf7246",
                                "text": "Professional teardown reports often cost a few thousand dollars and include component photos, descriptions, comparison tables, and access to an online database of teardown data."
                            }
                        ]
                    }
                ],
