                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn slaapkamer is altijd erg <w>slordig</w> met kleren op de grond.",
                            "target_lang_translations": {
                                "en": "His bedroom is always very <w>messy</w> with clothes on the floor.",
                                "ru": "В его спальне всегда очень <w>неряшливо</w>, а на полу валяется одежда.",
                                "pl": "Jego sypialnia jest zawsze bardzo <w>nieuporządkowana</w>, z ubraniami na podłodze.",
                                "de": "Sein Schlafzimmer ist immer sehr <w>unordentlich</w>, mit Kleidung auf dem Boden.",
                                "fr": "Sa chambre est toujours très <w>désordonnée</w> avec des vêtements par terre.",
                                "it": "La sua camera da letto è sempre molto <w>disordinata</w> con vestiti sul pavimento.",
                                "cs": "Jeho ložnice je vždy velmi <w>nepořádná</w>, s oblečením na zemi.",
                                "tr": "Yatak odası, yerdeki kıyafetlerle her zaman çok <w>dağınık</w>.",
                                "es": "Su dormitorio siempre está muy <w>desordenado</w>, con ropa en el suelo.",
                                "zh": "他的卧室总是非常<w>凌乱</w>，地上到处都是衣服。"
                            }
                        },
                        {
                            "text": "Je kunt niet met zulke <w>slordige</w> kleding naar het feest gaan.",
                            "target_lang_translations": {
