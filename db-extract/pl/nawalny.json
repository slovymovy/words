                "senses": [
                    {
                        "sense_id": "41d9c24f-91ca-347b-8eac-ea99249bf991",
                        "entry_id": "56b1d8fc-b151-31cc-9d58-bae0eeecf4d2",
                        "glosses": [
                            "uderzający silnie, z gwałtownością"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a51875-aa23-414c-acb2-06a4d8b503a8",
                                "sense_id": "41d9c24f-91ca-347b-8eac-ea99249bf991",
                                "text": "Nad kościołem katedralnym / Śnieżnobiałe ptaki lecą, / Jak gwiazd deszczem lśnią nawalnym, / Jak liljami błękit kwiecą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "75de6e34-5718-3c04-a232-55420aa4d8df",
                        "entry_id": "56b1d8fc-b151-31cc-9d58-bae0eeecf4d2",
                        "glosses": [
                            "pojawiający się gromadnie, w dużej ilości"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
