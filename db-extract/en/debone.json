                "senses": [
                    {
                        "sense_id": "189ab4a0-37c9-3018-b460-c94423aa3b31",
                        "entry_id": "b35d23d5-ae00-3e04-99fb-95f439991778",
                        "glosses": [
                            "To remove the bones from."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc038df2-c1be-4c9b-a596-d40fca4c2c2c",
                                "sense_id": "189ab4a0-37c9-3018-b460-c94423aa3b31",
                                "text": "I am deboning a fish."
                            },
                            {
                                "example_id": "d69058b7-dc82-4fb1-9a8d-4e3624fd1c16",
                                "sense_id": "189ab4a0-37c9-3018-b460-c94423aa3b31",
                                "text": "Down it went on the counter, for patient bone removal that would last him a whole day. Frank had done an awful lot of deboning in his life"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc5e004a-ad77-403f-b233-7bdfea01b4ac",
                        "source_entry_id": "b35d23d5-ae00-3e04-99fb-95f439991778",
