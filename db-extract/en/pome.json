                "translations": [
                    {
                        "translation_id": "d7db931c-11c7-45ac-b427-afeeb07a69db",
                        "source_entry_id": "238d1af6-d11a-3588-9c93-66694c6a2a5b",
                        "source_sense_description": "type of fruit",
                        "target_lang_word": "pitvrucht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pitvrucht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed081c2e-c128-3ace-95c7-a011b34583b3",
                                        "entry_id": "dd48fd2a-8651-3d22-87bd-ce95c87c18d3",
                                        "glosses": [
                                            "van vruchten dat ze een kleine pit bevatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8336a6-b335-4329-b275-efd3009a0e39",
                                                "sense_id": "ed081c2e-c128-3ace-95c7-a011b34583b3",
                                                "text": "Er bestaan pitvruchten, zoals appelen en peren, met kleine pitjes in een klokhuis. En er bestaan steenvruchten, zoals kersen, perziken en pruimen, met een dikke, harde pit in het hart. Maar dit jaar bestaat er verwarring: in de peren zit een steen."
                                            },
                                            {
                                                "example_id": "3aba7e4c-468c-4116-aea5-5d9048eb1d29",
                                                "sense_id": "ed081c2e-c128-3ace-95c7-a011b34583b3",
                                                "text": "Schenk: „Als we kunnen achterhalen wat die verschillen in allergeniciteit veroorzaakt, wordt het testen een stuk gemakkelijker. Veel mensen met een appel-allergie zijn ook allergisch voor kersen, perziken en andere pitvruchten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7248f83a-84ea-36b3-9352-dc2b86dde4eb",
                                        "entry_id": "dd48fd2a-8651-3d22-87bd-ce95c87c18d3",
                                        "glosses": [
                                            "benaming van een smaak van wijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2664cfc9-43a8-4632-b4db-26679a4ac5c3",
                                                "sense_id": "7248f83a-84ea-36b3-9352-dc2b86dde4eb",
                                                "text": "Smaak: begint fluwelig en mondvullend met pitvruchten en kruiden, eik en duidelijk aanwezige tannine. In het middenrif is de smaak geëvolueerd en toont een begin van verdroging. Een pittig accent versterkt de einddronk, gekenmerkt door nootmuskaat en kruidnagel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1283bc25-8511-4375-9d98-7b6646b4fd8a",
                        "source_entry_id": "238d1af6-d11a-3588-9c93-66694c6a2a5b",
                        "source_sense_description": "type of fruit",
                        "target_lang_word": "piridion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piridion",
