                "senses": [
                    {
                        "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                        "entry_id": "855c53b9-6572-31b6-b779-992769351925",
                        "glosses": [
                            "verband hebbend met de kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04038df-5e17-49c9-b29c-15676e7954cc",
                                "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                                "text": "Ben je kerkelijk?"
                            },
                            {
                                "example_id": "2ce90236-0adc-4f80-ac60-dd1bb0d9a031",
                                "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                                "text": "De feministen hadden ook moeite met een andere wet uit 1924. Kerkelijke partijen hadden toen bepaald dat vrouwen op de dag van hun huwelijk werden ontslagen uit overheidsfuncties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8a9d6a2-d111-4bda-9dc0-6ce653942655",
                        "source_entry_id": "855c53b9-6572-31b6-b779-992769351925",
                        "source_sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                        "source_sense_description": "verband hebbend met de kerk",
                        "target_lang_word": "kirchlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kirchlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9adc69-8f46-3309-8c25-a4c2245e68cc",
                                        "entry_id": "281ade01-9c4c-3123-9a47-1f1ba7dd08b0",
                                        "glosses": [
                                            "zur Kirche gehörend, die Kirche betreffend, von der Kirche ausgehend (als institutionelle Glaubensgemeinschaft)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2db81e6-123e-40ce-8a19-f578b1f1b8de",
                                                "sense_id": "1a9adc69-8f46-3309-8c25-a4c2245e68cc",
                                                "text": "Nach der standesamtlichen Hochzeit haben wir uns auch kirchlich getraut."
                                            },
                                            {
                                                "example_id": "e9f49d5a-6a9f-4fec-88eb-17ee2aeb095e",
                                                "sense_id": "1a9adc69-8f46-3309-8c25-a4c2245e68cc",
                                                "text": "Politische und kirchliche Vertreter nahmen an der Veranstaltung teil."
                                            },
                                            {
                                                "example_id": "f5932d72-b7ea-49ec-b1fb-4b7772c33f3c",
                                                "sense_id": "1a9adc69-8f46-3309-8c25-a4c2245e68cc",
                                                "text": "„1940 vollendete Pater Pierre sein Hauptwerk »Der Mensch im Kosmos«, erhielt allerdings keine kirchliche Druckerlaubnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c9cfa15-14c7-4b84-9057-898f76131062",
                        "source_entry_id": "855c53b9-6572-31b6-b779-992769351925",
                        "source_sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                        "source_sense_description": "verband hebbend met de kerk",
                        "target_lang_word": "ecclesiastic",
