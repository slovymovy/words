{
    "word_family": [
        "accident",
        "accidental"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                    "sense_definition": "Without intention; by mistake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unintentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>accidentally</w> dropped my phone into the water.",
                            "target_lang_translations": {
                                "ru": "Я <w>случайно</w> уронил свой телефон в воду.",
                                "tr": "Telefonumu <w>kazara</w> suya düşürdüm.",
                                "zh": "我<w>不小心</w>把手机掉进水里了。"
                            }
                        },
                        {
                            "text": "She <w>accidentally</w> sent the email to the wrong person.",
                            "target_lang_translations": {
                                "ru": "Она <w>по ошибке</w> отправила электронное письмо не тому человеку.",
                                "tr": "E-postayı <w>yanlışlıkla</w> yanlış kişiye gönderdi.",
                                "zh": "她<w>无意中</w>把邮件发给了错误的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unintentionally",
                        "by accident",
                        "inadvertently",
                        "unwittingly",
                        "involuntarily",
                        "on accident"
                    ],
                    "antonyms": [
                        "on purpose",
                        "intentionally",
                        "deliberately",
                        "purposely",
                        "knowingly"
                    ],
                    "common_phrases": [
                        "accidentally deleted",
                        "accidentally dropped",
                        "accidentally broke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без умысла; по ошибке.",
                        "tr": "Kasıt olmadan; yanlışlıkla.",
                        "zh": "非故意地；因疏忽或错误而导致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "без намерения"
                            },
                            {
                                "target_lang_word": "нечаянно",
                                "target_lang_sense_clarification": "по неосторожности, без умысла"
                            },
                            {
                                "target_lang_word": "ненамеренно",
                                "target_lang_sense_clarification": "не имея намерения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanlışlıkla",
                                "target_lang_sense_clarification": "hata sonucu"
                            },
                            {
                                "target_lang_word": "kazara",
                                "target_lang_sense_clarification": "istemeden, kaza ile"
                            },
                            {
                                "target_lang_word": "yanlışlıkla / istemeden",
                                "target_lang_sense_clarification": "kastı olmadan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不小心",
                                "target_lang_sense_clarification": "因疏忽而导致"
                            },
                            {
                                "target_lang_word": "无意中",
                                "target_lang_sense_clarification": "没有主观意图"
                            },
                            {
                                "target_lang_word": "错",
                                "target_lang_sense_clarification": "因错误而导致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                    "sense_definition": "In a way that happens by chance or unexpectedly, rather than being planned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist discovered the new medicine <w>accidentally</w> while studying something else.",
                            "target_lang_translations": {
                                "ru": "Учёный открыл новое лекарство <w>случайно</w>, изучая что-то другое.",
                                "tr": "Bilim insanı, başka bir şey üzerinde çalışırken yeni ilacı <w>tesadüfen</w> keşfetti.",
                                "zh": "科学家在研究其他课题时<w>偶然</w>发现了这种新药。"
                            }
                        },
                        {
                            "text": "We met <w>accidentally</w> at the train station this morning.",
                            "target_lang_translations": {
                                "ru": "Мы <w>случайно</w> встретились на вокзале сегодня утром.",
                                "tr": "Bu sabah tren istasyonunda <w>tesadüfen</w> karşılaştık.",
                                "zh": "今天早上我们在火车站<w>碰巧</w>遇见了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "by chance",
                        "unexpectedly",
                        "unintentionally",
                        "by mistake"
                    ],
                    "antonyms": [
                        "intentionally",
                        "deliberately",
                        "by design"
                    ],
                    "common_phrases": [
                        "discovered accidentally",
                        "met accidentally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданно, по воле случая, а не по плану.",
                        "tr": "Planlanmış olmaktan ziyade tesadüfen veya beklenmedik bir şekilde.",
                        "zh": "并非计划之内，而是偶然或出乎意料地发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "по стечению обстоятельств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tesadüfen",
                                "target_lang_sense_clarification": "şans eseri"
                            },
                            {
                                "target_lang_word": "şans eseri",
                                "target_lang_sense_clarification": "tesadüf sonucu"
                            },
                            {
                                "target_lang_word": "rastlantı sonucu",
                                "target_lang_sense_clarification": "beklenmedik şekilde"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶然",
                                "target_lang_sense_clarification": "非必然，出乎意料"
                            },
                            {
                                "target_lang_word": "碰巧",
                                "target_lang_sense_clarification": "凑巧发生"
                            }
                        ]
                    }
                }
            ]
        }
