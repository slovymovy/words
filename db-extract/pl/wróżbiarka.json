                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "325403ce-d812-42e7-9cbc-8ddaf4503709",
                        "source_entry_id": "f5dbc356-c359-303c-b030-da90d599cb54",
                        "source_sense_id": "bc2e1712-0ca1-3c51-b55d-150cf238f036",
                        "target_lang_word": "Wahrsagerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrsagerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                        "entry_id": "f7799cf1-4e51-3516-9bd0-b4b7d72af9e6",
                                        "glosses": [
                                            "jemand, der versucht, die Zukunft vorherzusagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb4e669-ac70-46d5-bbfe-1fcd0d807ced",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "Auf die Prophezeiungen von Wahrsagerinnen kann man sich nicht verlassen."
                                            },
                                            {
                                                "example_id": "8a276318-c86d-40ee-b0d1-394804af02aa",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Nachdenklich zieht er sein Portemonnaie hervor, nimmt zwei Zehnpfennigstücke heraus und zieht an einem grünen Automaten neben dem der Wahrsagerin eine Packung Pfefferminz.“"
                                            },
                                            {
                                                "example_id": "00178ae2-c7a5-438a-b50f-dea368cf7af8",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Tante Fatma sei die beste Wahrsagerin jenseits des Bosporus, sagte meine Schwester.“"
                                            },
                                            {
                                                "example_id": "f59771d0-d611-40f4-a07e-84c33c8fd6f6",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Denn die Wahrsagerin ist noch beschäftigt, oder sie braucht Zeit zur Meditation und zur Einstimmung auf den Gast.“"
                                            },
                                            {
                                                "example_id": "75e79e6c-cea9-4f29-a31b-653fbc087053",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„In seiner Kindheit wurde Freud von einer Wahrsagerin vorausgesagt, er würde Minister werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "038bd23e-ac02-4f64-abaa-bec248344430",
                        "source_entry_id": "f5dbc356-c359-303c-b030-da90d599cb54",
                        "source_sense_id": "bc2e1712-0ca1-3c51-b55d-150cf238f036",
                        "target_lang_word": "ворожея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ворожея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "baa3f8da-d38f-3d65-b87b-ffec41de9bfa",
                                        "entry_id": "dc3b72d4-7adc-38c8-9e90-351231f282c8",
                                        "glosses": [
                                            "женск. к ворожей; женщина, занимающаяся ворожбой; колдунья; гадалка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf48041-e3ad-4cce-ae35-645630dcfd9c",
                                                "sense_id": "baa3f8da-d38f-3d65-b87b-ffec41de9bfa",
                                                "text": "«Я позову старуху, ворожею; против её никакая сила не устоит. Она выльет переполох тебе»."
                                            },
                                            {
                                                "example_id": "c12442d6-bbe5-45cd-a5bd-0f30cc6348c0",
                                                "sense_id": "baa3f8da-d38f-3d65-b87b-ffec41de9bfa",
                                                "text": "Ревнивые мужья хотели от ворожей узнавать о неверности своих жён. Ворожею призывали в дом: она присматривалась к сердцу женщины, которую муж подвергал испытанию; если ворожея замечала, что у жены сердце трепещет, то укоряла её в неверности и отдавала невинную на произвольную расправу мужа."
                                            },
                                            {
                                                "example_id": "e2adc0ad-2dd3-4c3b-8fb7-f9197ae7bf70",
                                                "sense_id": "baa3f8da-d38f-3d65-b87b-ffec41de9bfa",
                                                "text": "Но живёт в Куйбышеве одна старушка — тайная ворожея и лечит заговором, берёт по десятке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
