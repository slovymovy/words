                "senses": [
                    {
                        "sense_id": "b1b7d9e2-5a9f-3231-a257-cba7a48a6c1e",
                        "entry_id": "35e7dbcd-d818-32dc-bfdd-4211607087f8",
                        "glosses": [
                            "benaming voor een jongere die rond 1960 behoorde tot de subcultuur die afwijzend stond tegenover de gevestigde maatschappij en veel interesse had voor brommers, rock en Amerikaanse cultuur"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "28779ecb-5698-42f3-b822-9a82658f0de3",
                                "sense_id": "b1b7d9e2-5a9f-3231-a257-cba7a48a6c1e",
                                "text": "Tegenover de artistieke pleiners stonden de veel ruwere dijkers, die zich bevonden in de omgeving van de Amsterdamse Nieuwedijk. Deze jongeren hadden hun haar strak achterovergekamd (pleiners hadden een Cesarkapsel) en droegen geen bordeelsluipers maar leren puntschoenen."
                            },
                            {
                                "example_id": "a3dc18d1-398e-4de0-92dc-f1248c81d217",
                                "sense_id": "b1b7d9e2-5a9f-3231-a257-cba7a48a6c1e",
                                "text": "Er zijn, zoals u misschien bekend is, \"Dijkers\" en \"Pleiners\". Onder de eerste naam gaan de jongens schuil, die hun vrije tijd op de Nieuwendijk plegen door te brengen. Hun tegenhangers zijn die van het Leidseplein."
                            }
                        ]
                    },
                    {
                        "sense_id": "bed9a6f6-4d9a-3eac-b293-719ed4ada437",
                        "entry_id": "35e7dbcd-d818-32dc-bfdd-4211607087f8",
                        "glosses": [
                            "iemand met de taak een waterkering aan te leggen of in stand te houden"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dfabdb7b-e8dc-439f-8d8d-33775d315a4e",
                                "sense_id": "bed9a6f6-4d9a-3eac-b293-719ed4ada437",
                                "text": "Maer ik moetme eerst wat sterken\nMet een mond-vol brood, of twee;\nDaer een dijker op sou werken,\nDie twee dagen honger leê."
                            }
                        ]
                    }
