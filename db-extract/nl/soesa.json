                                        "entry_id": "748bf6fd-822a-3898-bba5-150cbeb9b21b",
                                        "glosses": [
                                            "ugs. für unnötige Aufregung, Hektik, Durcheinander, unnötige Umstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab7f92f-160e-4ef2-b21a-8b380f280545",
                                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                                "text": "Mach' nicht so einen Heckmeck!"
                                            },
                                            {
                                                "example_id": "a4188141-614e-463b-8236-19801341d153",
                                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                                "text": "„Heute rege ich mich über Frau Beckham auf, wenn so ein Heckmeck gemacht wird, in welcher Suite das Paar in Mailand nächtigt…“"
                                            },
                                            {
                                                "example_id": "03e33424-5cdf-423a-afe0-8c8314e6f967",
                                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                                "text": "„Mach jetzt nicht so einen Heckmeck. Zieh dir endlich Schuhe an und geh zur Schule“, sagt der Vater zu seinem Sohn, der sich am frühen Morgen viel Zeit lässt."
                                            },
                                            {
                                                "example_id": "2d666e4d-117b-4f81-8b7b-5edb559224d0",
                                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                                "text": "„Dergleichen Heckmeck hatte er sich noch nie bei Rekruten einfallen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
