        "fr-extract.jsonl": [
            {
                "entry_id": "de179b1e-9f44-3290-8323-559b081f1fb5",
                "word": "constipation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d206d25-e30c-4fb1-9234-67be8ff6cfd7",
                        "entry_id": "de179b1e-9f44-3290-8323-559b081f1fb5",
                        "tags": [
                            "plural"
                        ],
                        "form": "constipations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "936fb9d2-c913-3cb4-8cf5-707bc4ec3e68",
                        "entry_id": "de179b1e-9f44-3290-8323-559b081f1fb5",
                        "glosses": [
                            "État d’une personne ou d’un animal qui est constipé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d23f04-8cee-48da-ac1e-ce31a5c502ff",
                                "sense_id": "936fb9d2-c913-3cb4-8cf5-707bc4ec3e68",
                                "text": "La constipation se guérit en insinuant du beurre dans l’anus de l’animal pour amollir la fiente ; la tirer ensuite avec le doigt, ce qui se nomme défienter : suppositoires de savon ; lavemens comme aux tranchées."
                            },
                            {
                                "example_id": "94c39346-670d-48ef-88e7-9445f9aad5ce",
                                "sense_id": "936fb9d2-c913-3cb4-8cf5-707bc4ec3e68",
                                "text": "De son côté, le vieux Clemenceau, « le Tigre », un fameux soldat lui aussi, rendait grâce à une constipation chronique, sans laquelle, affirmait-il, il n’aurait jamais eu le bonheur de lire les Mémoires de Saint-Simon."
                            },
                            {
                                "example_id": "490cf869-8425-4962-8e6c-9cb5a7664167",
                                "sense_id": "936fb9d2-c913-3cb4-8cf5-707bc4ec3e68",
                                "text": "Elle souffrait d’apopathodiaphulatophobie, nom que l'on donnait précisément à la peur de la constipation, à sa phobie maladive… Elle invoquait le docteur Jacquemin et affirmait que la flore intestinale était le miroir de la santé. Lui-même parlait de coefficient d'utilisation digestive et détaillait le poids des excréments qu'on évacuait chaque jour, qui était en moyenne de quatre cent cinquante grammes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1f20f16-4615-4fe5-bda0-9569a2a90653",
                        "source_entry_id": "de179b1e-9f44-3290-8323-559b081f1fb5",
                        "source_sense_id": "936fb9d2-c913-3cb4-8cf5-707bc4ec3e68",
                        "target_lang_word": "Verstopfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstopfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84a8b28a-5c48-356c-966d-31683c3779df",
                                        "entry_id": "e16b665b-c2f9-36fd-9386-0dc5cafd8a24",
                                        "glosses": [
                                            "durch verhärteten Kot erschwerte Stuhlentleerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3212e71-e2cf-45ff-a46b-03c2df68662e",
                                                "sense_id": "84a8b28a-5c48-356c-966d-31683c3779df",
                                                "text": "Nicht jeder, der keinen täglichen Stuhlgang hat, leidet an Verstopfung."
                                            },
                                            {
                                                "example_id": "c9fb9d95-82e6-4ead-a8a8-5bd3714fbe4d",
                                                "sense_id": "84a8b28a-5c48-356c-966d-31683c3779df",
                                                "text": "Äpfel sollen Verstopfungen und Durchfall lindern."
                                            },
                                            {
                                                "example_id": "fb900021-0956-4932-96ee-7b288b49ec6f",
                                                "sense_id": "84a8b28a-5c48-356c-966d-31683c3779df",
                                                "text": "„Aber in Überlandbussen kriegte ich immer Verstopfung, und es saß unweigerlich irgendein alter Union Jack drin, der einen ranzigen Bart hatte und schnarchte.“"
                                            },
                                            {
                                                "example_id": "6c678f4b-b192-4f17-b403-035addceab82",
                                                "sense_id": "84a8b28a-5c48-356c-966d-31683c3779df",
                                                "text": "„Das Narkosemittel hatte eine schmerzhafte Verstopfung bewirkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82b6eb69-3e11-335b-ad26-e833e7576444",
                                        "entry_id": "e16b665b-c2f9-36fd-9386-0dc5cafd8a24",
                                        "glosses": [
                                            "durch ein Hindernis gestörter Durchfluss bei Rohren, Sieben und dergleichen, oder auch bei Straßen oder Blutgefäßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2fd7d9-978e-462b-8bf8-84f95fad3ef2",
                                                "sense_id": "82b6eb69-3e11-335b-ad26-e833e7576444",
                                                "text": "Die Verstopfung der Toilette musste eine Klempner beheben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e11ab027-7106-4cc8-8581-b885c37a8e94",
                        "source_entry_id": "de179b1e-9f44-3290-8323-559b081f1fb5",
