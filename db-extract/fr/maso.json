                        "entry_id": "83a892d5-98e1-364d-ac59-2f0c99afc621",
                        "glosses": [
                            "Personne qui aime souffrir."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3ebfa981-855e-44dc-b69a-63fb8b125bd6",
                                "sense_id": "f9cc9240-65a8-3cce-ae13-ea5b90d91429",
                                "text": "Il faut être maso pour rester dans ce métier !"
                            },
                            {
                                "example_id": "3e315a5a-fb84-4431-8024-2aa7290e211c",
                                "sense_id": "f9cc9240-65a8-3cce-ae13-ea5b90d91429",
                                "text": "C’est un truc de masos, ton histoire !"
                            },
                            {
                                "example_id": "4f793586-67d2-4fef-887d-9c1c0155ca58",
                                "sense_id": "f9cc9240-65a8-3cce-ae13-ea5b90d91429",
                                "text": "C’est un maso (elle voulait dire masochiste ; depuis toujours elle goûtait les abréviations, et ce n’était point pour faire jeune)."
                            }
                        ]
                    }
                ],
