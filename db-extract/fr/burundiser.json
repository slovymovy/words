                "senses": [
                    {
                        "sense_id": "3cb23dff-799e-3f6e-947d-60ad40282083",
                        "entry_id": "63bfe94e-957f-3d59-9956-6af02f0e152d",
                        "glosses": [
                            "Donner un caractère burundais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b67e192-d631-4b33-a069-6817c4722789",
                                "sense_id": "3cb23dff-799e-3f6e-947d-60ad40282083",
                                "text": "Aux premiers rangs de « cette poignée qui compte les millions » figurent les animateurs de l’Association des Commerçants Burundais (ACB), mise en place deux ans plus tôt par le gouvernement pour « burundiser » une part du commerce national."
                            },
                            {
                                "example_id": "be378b3d-e2ec-463b-8f14-a564b05aa302",
                                "sense_id": "3cb23dff-799e-3f6e-947d-60ad40282083",
                                "text": "Avec ce libertinage de la presse, il suffirait d'un peu pour burundiser notre pays."
                            },
                            {
                                "example_id": "63eb9d7c-bbdd-49a7-a5f8-038dc1ff1cb2",
                                "sense_id": "3cb23dff-799e-3f6e-947d-60ad40282083",
                                "text": "Selon lui, les libéraux ambitionnent d'«ivoiriser», de «burundiser» ou de «rwandiser» le Sénégal, mais ils n'y parviendront pas."
                            }
                        ]
                    }
