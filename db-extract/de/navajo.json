                "senses": [
                    {
                        "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                        "entry_id": "3387016b-d018-32df-ac26-af89dccc03ad",
                        "glosses": [
                            "Angehörige eines nordamerikanischen Indianervolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39daa4a9-3812-46fa-80b0-2ff8bd51a696",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„Wie eng die Realisierung all dieser Pläne von der Politik abhängt, wurde mir klar, als ich mit Dr. Robert A. Roessel, Jr., dem Kanzler des College, sprach, dessen Frau, Ruth Roessel, eine Navajo, die Leiterin der Navajo Studies ist.“"
                            },
                            {
                                "example_id": "9524bcb7-ef39-45f5-a8f9-d9e84fd6c95e",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„Meine Mum war eine Navajo, und ich hatte ihre dunkle Hautfarbe und das schwarze Haar.“"
                            },
                            {
                                "example_id": "0452e5f9-376b-451d-a28e-cd927881baea",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„Aber die Familie erwartete, daß ich wieder ganz eine Navajo sein würde.“"
                            },
                            {
                                "example_id": "9217bb3f-42ec-4b28-8f48-fdcdb1510e06",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„Mary Landon würde keine Navajo werden.“"
                            },
                            {
                                "example_id": "5127d12b-06fc-48b0-99ca-f3d84879182a",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„Erst Mitte 1977 wurde eine Navajo, Georgia Briggs, in die gleiche Stellung eingewiesen, obwohl sie von ihren Freunden gewarnt worden war.“"
                            },
                            {
                                "example_id": "e7c18796-c6a4-4855-b432-e2abba482855",
                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                "text": "„‚Aber ich bin eine Navajo‘, rief sie aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
