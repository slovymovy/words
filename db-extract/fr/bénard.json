                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36843969-ac89-32bb-9947-39b400213439",
                        "entry_id": "87d48ace-e520-3502-9389-7cc3189b4b44",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6221895-3190-4017-944e-ec0e292114cf",
                                "sense_id": "36843969-ac89-32bb-9947-39b400213439",
                                "text": "Avec : Olivier Bénard, Florence Coste ou Charlotte Durand-Raucher, Steven Dagrou, Nadège Perrier, Nicolas Taffin."
                            }
                        ]
