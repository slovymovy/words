                    {
                        "sense_id": "2a485fd4-8e64-35ee-bc4d-30c9e671aed9",
                        "entry_id": "01eb96c4-f8a5-3094-aa1d-985d2f1a7265",
                        "glosses": [
                            "Person, die Fenster reinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec77084-12ec-48cf-bbd9-265091fba572",
                                "sense_id": "2a485fd4-8e64-35ee-bc4d-30c9e671aed9",
                                "text": "In den Sommerferien reinigten die Fensterputzer die Fenster der Schule."
                            },
                            {
                                "example_id": "1b7932f4-f951-43f1-91fe-36ac0ce68865",
                                "sense_id": "2a485fd4-8e64-35ee-bc4d-30c9e671aed9",
                                "text": "„Er arbeitete als Fensterputzer, bis er den Job nach einem Arbeitsunfall verlor.“"
                            },
                            {
                                "example_id": "7b6e5a89-020f-49e4-a262-5cbfcd5a5ee7",
                                "sense_id": "2a485fd4-8e64-35ee-bc4d-30c9e671aed9",
                                "text": "„Draußen ist der Fensterputzer zugange.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
