                                                "example_id": "38538877-33c6-40ff-b07f-72e208718fe1",
                                                "sense_id": "fecbed48-bbbd-3fe6-98db-48935c3dde8c",
                                                "text": "Spätestens seit Beginn der 80er Jahre ist der Kunsthandel als Waschanlage für Drogengeld bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
