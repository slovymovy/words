                    {
                        "translation_id": "3187c1b1-3a70-4905-8413-5eb2e63e09dc",
                        "source_entry_id": "4e42a5eb-5ba1-3311-8d53-5bd1ab3163af",
                        "source_sense_description": "describe or represent as evil",
                        "target_lang_word": "verteufeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verteufeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a26e21b0-4483-3d1c-90eb-3b26b46f1bc4",
                                        "entry_id": "dc4e53ed-9260-3871-8796-1f1826b60153",
                                        "glosses": [
                                            "zur Ursache allen Übels erklären, schlecht machen, verunglimpfen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a984d7-24e8-4768-a9ed-f9c4903bdc74",
                                                "sense_id": "a26e21b0-4483-3d1c-90eb-3b26b46f1bc4",
                                                "text": "Er wurde ganz zu Unrecht verteufelt."
                                            },
                                            {
                                                "example_id": "bfbf1c08-9b13-40be-98cd-ee17db3f7c0f",
                                                "sense_id": "a26e21b0-4483-3d1c-90eb-3b26b46f1bc4",
                                                "text": "Er wird nicht verteufelt, wohl aber deutlich kritisiert."
                                            },
                                            {
                                                "example_id": "d012b191-c85f-4057-bc30-dba1df334ef0",
                                                "sense_id": "a26e21b0-4483-3d1c-90eb-3b26b46f1bc4",
                                                "text": "„Von den Medien durchgekaut, verteufelt und verketzert, für Politiker oftmals ein willkommener Dreschflegel, um viel leeres Stroh zu dreschen.“"
                                            },
                                            {
                                                "example_id": "16672a0e-bf3a-4bd3-a6c2-b94511a70ef1",
                                                "sense_id": "a26e21b0-4483-3d1c-90eb-3b26b46f1bc4",
                                                "text": "„Die See, das «schwarze Wasser» (kala pani), war von den Brahmanen verteufelt worden, die die Rettung der indischen Kultur in einer Abschirmung gegenüber der Außenwelt sahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
