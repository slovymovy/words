                {
                    "sense_id": "7266419f-adba-39ac-a6dd-a47a9c6f9c68",
                    "sense_definition": "The technical skill and knowledge required to operate and navigate a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mastering the art of <w>sailing</w> takes years of practice and dedication.",
                            "target_lang_translations": {
                                "ru": "Овладение искусством <w>мореплавания</w> требует многих лет практики и самоотдачи.",
                                "tr": "<w>Yelkencilik</w> sanatında uzmanlaşmak yıllarca pratik ve özveri gerektirir.",
                                "zh": "掌握<w>航海术</w>这门艺术需要多年的练习和投入。"
                            }
                        },
                        {
                            "text": "She taught him the basics of <w>sailing</w> and navigation.",
                            "target_lang_translations": {
                                "ru": "Она научила его основам <w>парусного дела</w> и навигации.",
                                "tr": "Ona <w>denizciliğin</w> ve navigasyonun esaslarını öğretti.",
                                "zh": "她教了他<w>操船技术</w>和导航的基础知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seamanship",
                        "navigation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Технические навыки и знания, необходимые для управления судном и навигации.",
                        "tr": "Bir deniz taşıtını kullanmak ve sevk etmek için gereken teknik beceri ve bilgi.",
                        "zh": "操作和驾驶船只所需的专业技能与知识。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мореплавание",
                                "target_lang_sense_clarification": "искусство навигации"
                            },
                            {
                                "target_lang_word": "парусное дело",
                                "target_lang_sense_clarification": "навык"
                            },
                            {
                                "target_lang_word": "судовождение",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "tr": [
