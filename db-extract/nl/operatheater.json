                        "examples": [
                            {
                                "example_id": "4b5956c4-1f3c-4eaa-9f8d-ff9d3192f0b2",
                                "sense_id": "12ac7a09-8adb-39c0-ae0f-3dea9a696771",
                                "text": "Ook voorzagen die lokale rijken hun stad van een operatheater, waar wereldsterren optraden die ervoor zorgden dat iedereen in West-Europa wist waar Taganrog lag."
                            },
                            {
                                "example_id": "af690c2d-e6ab-4c92-ab7d-bdbdc74a0bcd",
                                "sense_id": "12ac7a09-8adb-39c0-ae0f-3dea9a696771",
                                "text": "Abbado had de leiding over enkele van de grootste orkesten ter wereld. Zo dirigeerde hij het London Symphony Orchestra, de Berliner Philharmoniker en het Chicago Symphony Orchestra. Ook was hij directeur van het La Scala-operatheater in Milaan en later van de Wiener Staatsoper."
                            }
                        ]
