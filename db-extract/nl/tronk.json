            {
                "entry_id": "64d177be-9fb3-35c7-b193-660230204e79",
                "word": "tronk",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "82f5872d-86fb-4bf0-bc52-7d8c79e8da6c",
                        "entry_id": "64d177be-9fb3-35c7-b193-660230204e79",
                        "tags": [
                            "singular"
                        ],
                        "form": "tronken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b1aa910-3b70-3024-8c53-873bbd08b05c",
                        "entry_id": "64d177be-9fb3-35c7-b193-660230204e79",
                        "glosses": [
                            "eenvoudige gevangenis"
                        ],
                        "tags": [
                            "Nederlands-Indië"
                        ],
                        "examples": [
                            {
                                "example_id": "5957140a-596d-4492-847f-db953c752dcc",
                                "sense_id": "6b1aa910-3b70-3024-8c53-873bbd08b05c",
                                "text": "Terwijl de maats bezig waren met het slachten van een buffel en een varken voor het Paaschfeest, plukhaarde onze Dominee met een Assistent en werden beiden in de boeien gezet! Den volgenden dag was Paaschzondag en dan moest de Dominee (die ook wel een ziekentrooster kan zijn geweest) natuurlijk preeken. Hij werd dus weer uit den tronk gehaald en ook den volgenden dag kwamen allen naar zijn predicatie luisteren."
                            },
                            {
                                "example_id": "d29b9747-3405-4f39-9c7b-883451cdf938",
                                "sense_id": "6b1aa910-3b70-3024-8c53-873bbd08b05c",
                                "text": "Nadat hij was opgepakt werd hij bij de wacht ‘twee etmalen in de tronk gesloten’, ‘sonder eeten off drinken’, aldus Ontong."
                            }
                        ]
                    }
                ],
