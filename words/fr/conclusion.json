    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68c2045c-b0dd-3c30-8229-aeb3fc60e940",
                    "sense_definition": "Dernière partie d'un discours, d'un texte ou d'une œuvre qui récapitule les points essentiels.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a rédigé une excellente <w>conclusion</w> pour clore son mémoire universitaire."
                        },
                        {
                            "text": "Pour finir sa présentation, elle a proposé une courte <w>conclusion</w> très claire."
                        }
                    ],
                    "synonyms": [
                        "dénouement",
                        "épilogue",
                        "fin"
                    ],
                    "antonyms": [
                        "introduction",
                        "préambule",
                        "prologue"
                    ],
                    "common_phrases": [
                        "en conclusion"
                    ]
                },
                {
                    "sense_id": "d5de1c7e-3ed2-3492-9eb3-4ae24decb7d7",
                    "sense_definition": "Conséquence ou déduction que l'on tire d'une réflexion, d'un fait ou d'un raisonnement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs ont pu tirer une <w>conclusion</w> claire après avoir analysé tous les résultats."
                        },
                        {
                            "text": "Nous sommes rapidement arrivés à la même <w>conclusion</w> après cette longue discussion."
                        }
                    ],
                    "synonyms": [
                        "corollaire",
                        "déduction",
                        "conséquence"
                    ],
                    "antonyms": [
                        "prémisse"
                    ],
                    "common_phrases": [
                        "arriver à la conclusion",
                        "tirer des conclusions"
                    ]
                },
                {
                    "sense_id": "e270476e-0da1-3059-887a-414a2d7f9d32",
                    "sense_definition": "Finalisation ou accomplissement définitif d'un acte juridique, d'une négociation ou d'un contrat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux gouvernements célèbrent la <w>conclusion</w> d'un traité de paix historique."
                        },
                        {
                            "text": "Cette signature marque la <w>conclusion</w> d'un contrat attendu depuis plusieurs mois."
                        }
                    ],
                    "synonyms": [
                        "aboutissement",
                        "règlement",
                        "signature"
                    ],
                    "antonyms": [
                        "ouverture",
                        "rupture"
                    ],
                    "common_phrases": [
                        "conclusion d'un accord",
                        "conclusion d'un contrat"
                    ]
                },
                {
                    "sense_id": "df93c008-06c9-33f3-b04d-6a4fc36572aa",
                    "sense_definition": "Prétentions et demandes écrites formulées par les parties devant une juridiction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a déposé ses <w>conclusions</w> auprès du greffe avant l'audience de demain."
                        },
                        {
                            "text": "Le tribunal a soigneusement examiné les dernières <w>conclusions</w> de la partie civile."
                        }
                    ],
                    "synonyms": [
                        "prétentions",
                        "requêtes"
                    ],
                    "common_phrases": [
                        "déposer des conclusions",
                        "prendre des conclusions"
                    ]
                },
                {
                    "sense_id": "f6af2f1b-e1d9-3ee2-bee0-2cf2c0d26742",
                    "sense_definition": "Avis ou réquisitions formels motivés exprimés par le ministère public lors d'une procédure judiciaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le procureur de la République a présenté ses <w>conclusions</w> devant les magistrats de la cour."
                        },
                        {
                            "text": "Les juges ont attentivement écouté les <w>conclusions</w> du ministère public avant de délibérer."
                        }
                    ],
                    "synonyms": [
                        "réquisitoire",
                        "réquisitions"
                    ],
                    "common_phrases": [
                        "conclusions du ministère public",
                        "conclusions du parquet"
                    ]
                }
            ]
        }
    ]
