                                "text": "Die Überschrift ist in Paragon gedruckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfc36f41-cbee-3e8e-9d62-4cdf00ad0821",
