                "senses": [
                    {
                        "sense_id": "08159cc4-63c0-3d47-adfd-5e27e71765f9",
                        "entry_id": "2d95527b-2712-3b1a-afe2-27da81f73383",
                        "glosses": [
                            "Kapelle, die dem heiligen Matthias geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e39cd4f-9ab9-439b-b795-cf756916841e",
                                "sense_id": "08159cc4-63c0-3d47-adfd-5e27e71765f9",
                                "text": "„Die Matthiaskapelle bewahrte die Reliquie bis 1347 auf, bevor sie über Sayn 1381 zur Burg Helfenstein und 1420 in den Trierer Dom gelangte.“"
                            },
                            {
                                "example_id": "e577ac33-71b8-4417-a219-496cf1a34319",
                                "sense_id": "08159cc4-63c0-3d47-adfd-5e27e71765f9",
                                "text": "„Ein Besuch der Matthiaskapelle ist sicher eines der eindrucksvollsten Erlebnisse an der Mosel.“"
                            },
                            {
                                "example_id": "58412935-1aab-4a04-849d-f7a5050c0b71",
                                "sense_id": "08159cc4-63c0-3d47-adfd-5e27e71765f9",
                                "text": "„Neben der Matthiaskapelle (1414) mit der Sakristei und Archivfunktion befinden sich an der Südseite die Annakapelle (vor 1449) - vormals Friedhofskapelle - und die Ungarische Kapelle (1367 und 1756-1767) zur Betreuung der ungarischen Pilger.“"
                            },
                            {
                                "example_id": "c6962a9e-bb90-4204-8371-f4c63ffd904b",
                                "sense_id": "08159cc4-63c0-3d47-adfd-5e27e71765f9",
                                "text": "„Die Matthiaskapelle in der Burg wurde im 13. Jahrhundert errichtet und sollte wohl der repräsentative Ort für die Aufbewahrung und Verehrung der Reliquie sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
