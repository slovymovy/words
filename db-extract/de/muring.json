                                "target_senses": [
                                    {
                                        "sense_id": "4c8fdd63-9bd8-3bdc-8147-b12d3f8bd52f",
                                        "entry_id": "52b5be22-8386-3ddf-a85b-8d6652a2f4da",
                                        "glosses": [
                                            "present participle and gerund of moor"
                                        ],
                                        "tags": [
                                            "form-of",
