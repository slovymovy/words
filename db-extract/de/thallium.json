                                        "sense_id": "3c2d56f7-57d9-31c2-a05e-e505ae89fa2a",
                                        "entry_id": "7bd40e68-8ffb-3a14-ad2f-f1857c0245cc",
                                        "glosses": [
                                            "A metallic chemical element (symbol Tl) with atomic number 81: a gray post-transition metal that discolors when exposed to air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a0ab555-a5af-4887-b09c-65d6beb340ed",
                                                "sense_id": "3c2d56f7-57d9-31c2-a05e-e505ae89fa2a",
                                                "text": "Environmental authorities in Lüeyang County, Shaanxi province, discovered excessive levels of thallium in two of the Jialing River’s upstream tributaries on Jan. 20, according to a statement Monday. The concentration of thallium that day was 170% higher than the standard for Qingni River, one of the upstream tributaries bordering Gansu province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3af0b383-5b5b-3a87-b7c3-7d2173e04186",
                                        "entry_id": "7bd40e68-8ffb-3a14-ad2f-f1857c0245cc",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed0d1b5a-87bc-43cb-83d9-665cb19da105",
                        "source_entry_id": "a46f6702-e4ff-305a-9fa9-ab4f72a2d5ba",
                        "source_sense_id": "fc67c75e-3f94-367a-bdbe-c58ef4254ca6",
