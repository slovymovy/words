            "senses": [
                {
                    "sense_id": "d509af04-6c9e-33c8-93a3-231506c6a526",
                    "sense_definition": "Manifester sa mauvaise humeur ou son mécontentement par des plaintes fréquentes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mecontentement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe son temps à <w>râler</w> dès que le train a quelques minutes de retard."
                        },
                        {
                            "text": "Les enfants ont beaucoup <w>râlé</w> quand nous avons éteint la télévision."
                        }
                    ],
                    "synonyms": [
                        "grogner",
                        "protester",
                        "ronchonner",
                        "rouspéter"
                    ],
                    "common_phrases": [
