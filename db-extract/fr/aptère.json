                "senses": [
                    {
                        "sense_id": "6a671abb-41e0-310c-9177-a0ccf9427a74",
                        "entry_id": "ff80295f-aec6-3005-80b3-f9d83cc3662d",
                        "glosses": [
                            "Qualifie un animal dépourvu d’ailes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e5898a-0d07-4476-b99f-de5e0a5ddddc",
                                "sense_id": "6a671abb-41e0-310c-9177-a0ccf9427a74",
                                "text": "Grand chasseur, le crapaud dévore toutes sortes de petits invertébrés, aptères ou ailés."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc63dda8-7bc2-3113-bb6b-d67e33f96154",
                        "entry_id": "ff80295f-aec6-3005-80b3-f9d83cc3662d",
                        "glosses": [
                            "Qualifie les insectes dépourvus d’ailes alors que d'autres individus de la même espèce ou d’espèces appartenant au même taxon peuvent en avoir."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cc393c26-1907-47c0-b37a-b9730e289d21",
                                "sense_id": "cc63dda8-7bc2-3113-bb6b-d67e33f96154",
                                "text": "Chez les fourmis, la caste des ouvrières est aptère alors que les individus reproducteurs possèdent des ailes fonctionnelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad290366-fc45-32bd-b314-ced1cc6136cd",
                        "entry_id": "ff80295f-aec6-3005-80b3-f9d83cc3662d",
                        "glosses": [
                            "Qualifie les représentations allégoriques de la victoire sans les ailes qu'elle porte habituellement."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
