                "senses": [
                    {
                        "sense_id": "27ef9720-ca51-34ef-a41a-52c588133460",
                        "entry_id": "9fe1356c-dd50-3e07-8c56-439f7ebdede3",
                        "glosses": [
                            "genetisch veränderte Immunzelle, die bestimmte krankhafte Zustände aus dem Gewebe heraus bessert"
                        ],
                        "tags": [
                            "Gentechnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b78a5dac-7eb0-4a7b-bea9-e10b59da13b1",
                                "sense_id": "27ef9720-ca51-34ef-a41a-52c588133460",
                                "text": "„Geschätzt zwei Millionen Kinder und Erwachsene in Deutschland leiden an Schuppenflechte. Es ist eine Autoimmunerkrankung, bei der sich das Immunsystem gegen den eigenen Körper richtet. Sogenannte „Designerzellen“ sollen das nun verhindern.“"
                            },
                            {
                                "example_id": "f33c9a50-46fd-4a33-bed8-dce42abaf663",
                                "sense_id": "27ef9720-ca51-34ef-a41a-52c588133460",
                                "text": "„Layla ist ein lebendes Wunder: Mit 14 Wochen entwickelte sie eine besonders aggressive Form der Leukämie, die Ärzte gaben sie auf. Doch dann keimte Hoffnung auf: Designerzellen sollten sie retten. Zwei Monate nach einer einzigen Injektion galt Layla als geheilt.“"
                            },
                            {
                                "example_id": "f03f5249-8f21-41f8-a468-0b2caffbf2cd",
                                "sense_id": "27ef9720-ca51-34ef-a41a-52c588133460",
                                "text": "„Die Diagnose gelingt diesen Designerzellen über die zwei Entzündungsfaktoren, die das Krankheitsgeschehen bei der Schuppenflechte dominieren, erklärt der Forscher im Skype-Interview: \"Das ist zum einen der Botenstoff TNF, ein Protein, welches das Immunsystem ausschüttet, und ein weiterer Botenstoff, das sogenannte Interleukin 22, welches ebenfalls durch das Immunsystem ausgeschüttet wird.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
