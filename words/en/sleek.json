                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His gentle words helped to <w>sleek</w> her ruffled feathers after the argument.",
