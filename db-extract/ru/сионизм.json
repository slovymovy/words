                    }
                ],
                "translations": [
                    {
                        "translation_id": "39111679-1f60-401c-b4cd-ef2d37f8c113",
                        "source_entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "source_sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "target_lang_word": "Zionism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zionism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "492fb9ff-f379-3a42-a281-15cb1d2057d9",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "Jewish nationalism, the movement which supported first the establishment of a Jewish homeland and now supports the continuation of a Jewish state in the region of Palestine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07339c24-37fa-4158-99c8-d7d61696691d",
                                                "sense_id": "492fb9ff-f379-3a42-a281-15cb1d2057d9",
                                                "text": "These investigations indicate that although a large proportion of American Jews call themselves Zionists, their meanings of Zionism are closer to what some investigators have called pro-Israelism. According to the still common Israeli definition of a Zionist as one who views the Diaspora negatively and considers the settlement of Jews in Israel as essential, the vast majority of American Jews would not be considered Zionists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff13fcfc-be63-384f-b59c-c47f7f355a1f",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "A religion practiced throughout sub-Saharan Africa and most popular in Swaziland, consisting of a mixture of Protestantism and animism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aa4efdd-fc23-38ec-97b7-99c9e3740709",
                                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                                        "glosses": [
                                            "A Christian eschatological concept that links the migration of Jews to Palestine with apocalyptic events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68fc5d6b-3518-4305-a723-211ccc8f634f",
                        "source_entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "source_sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "target_lang_word": "sionismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sionismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "40057146-e694-3fdc-98eb-9d60e563ee56",
                                        "entry_id": "ef48f5d6-24e6-3b45-ad47-58e02eb6e62a",
                                        "glosses": [
                                            "El movimiento político y social que preconiza la vuelta del pueblo hebreo a la tierra de Israel, y la creación de un estado hebreo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dae22f08-1e6d-424a-8478-eb002c46efd8",
                        "source_entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "source_sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "target_lang_word": "sionismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sionismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "c17abb93-9258-3651-a5fa-a9725c1c920c",
                                        "entry_id": "020cd7b2-2776-31e0-8dee-f5591e0ac7ba",
                                        "glosses": [
                                            "movimento politico alla fine dell'Ottocento con lo scopo di formare in Palestina uno stato per gli ebrei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9eae01-0d5b-423d-af19-1f506d5f4cc8",
                                                "sense_id": "c17abb93-9258-3651-a5fa-a9725c1c920c",
                                                "text": "prima di un’escalation bellica e belligerante, inizialmente il sionismo fu l’innocente speranza messianica per gli ebrei riguardo alla ricostruzione del Tempio di Gerusalemme"
                                            },
                                            {
                                                "example_id": "4a2abefe-ac5f-4dfc-98c4-1bd878f11886",
                                                "sense_id": "c17abb93-9258-3651-a5fa-a9725c1c920c",
                                                "text": "Ahimè, l'attuale sionismo è una strumentalizzazione anche ai danni della religione ebraica"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed452a38-fbe7-4772-9637-9bcc2153756c",
                        "source_entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "source_sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "target_lang_word": "Zionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                        "entry_id": "9061dbda-7761-3bdb-af9d-8e0ea25d2a5b",
                                        "glosses": [
                                            "im 19. Jahrhundert entstandene jüdische Bewegung, die sich für die Errichtung eines jüdischen Staats in Palästina einsetzte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beaa9b98-60c5-411f-92c3-c9eceaeffa39",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "Der Zionismus entstand zeitgleich mit anderen europäischen Emanzipations- und Nationalbewegungen infolge der Aufklärung und der Französischen Revolution."
                                            },
                                            {
                                                "example_id": "753a1332-2587-4f17-9831-f7cb76f13f1d",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Herzl, der Begründer des politischen Zionismus, hatte sich im Übrigen auch vorgestellt, dass man im künftigen »Judenstaat« Deutsch als Landessprache pflegen, dass man in den Kaffeehäusern deutschsprachige Zeitungen lesen würde.“"
                                            },
                                            {
                                                "example_id": "2150d745-0bea-45ec-85ae-34880cd1cd72",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„In letzter Zeit hatte sich allerdings eine gewisse Abkühlung seiner Begeisterung für den Zionismus bemerkbar gemacht.“"
                                            },
                                            {
                                                "example_id": "27930cbc-a06f-45f0-ab43-f35f88a1bb84",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Nicht jede dieser Bewegungen hatte die Errichtung eines autonomen oder souveränen jüdischen Gemeinwesens auf einem eigenen Territorium zum Ziel, wie etwa der Zionismus, der eine Staatsgründung in Palästina anstrebte.“"
                                            },
                                            {
                                                "example_id": "f61df464-639c-4185-9150-3be20decad20",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Ben Gurion begann außerdem den Aufstieg des Nationalsozialismus in Deutschland als ein Mittel zur Förderung des Zionismus zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b557418-2ba4-47d1-9e29-29e28f68f2fa",
                        "source_entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "source_sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "target_lang_word": "sionisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sionisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                        "entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                                        "glosses": [
                                            "Mouvement pour la fondation d’un centre spirituel, territorial ou étatique juif en Palestine, idéologie politique nationaliste apparue au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10096f9f-510d-4462-a79c-35f5d062e10d",
                                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                                "text": "Comprendre le sionisme est devenu indispensable, non seulement à qui s'interroge sur la présence du peuple juif au cœur de l’histoire du XXᵉ siècle, mais pour éclairer les enjeux peut-être les plus décisifs du monde contemporain."
                                            },
                                            {
                                                "example_id": "e36bbcc9-abc7-4a63-a886-13b22c71e8d6",
                                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                                "text": "La fin du XIXᵉ siècle, Théodore Herzl donne son sens précis à un mouvement politique et à une idéologie naissants : le sionisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
