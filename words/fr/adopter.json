{
    "word_family": [
        "adoption",
        "adoptif",
        "adoptable",
        "adoptant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54d58305-c569-364d-abdf-5aba88c6a756",
                    "sense_definition": "Prendre légalement la responsabilité d'un enfant ou accueillir un animal chez soi pour l'élever.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille_et_foyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'attente, ce jeune couple a enfin pu <w>adopter</w> un enfant."
                        },
                        {
                            "text": "Nous avons décidé d'<w>adopter</w> un chien au refuge de la ville le week-end dernier."
                        }
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "adopter un enfant",
                        "adopter un chien",
                        "adopter un animal"
                    ]
                },
                {
                    "sense_id": "102e2064-1897-3b53-a6c3-bdcafec8dc96",
                    "sense_definition": "Choisir de suivre une méthode, d'avoir un comportement ou de faire sienne une pratique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement_et_choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour réussir cet examen difficile, il est important d'<w>adopter</w> une bonne méthode de travail."
                        },
                        {
                            "text": "L'entreprise a décidé d'<w>adopter</w> une attitude plus écologique pour réduire ses déchets."
                        }
                    ],
                    "synonyms": [
                        "choisir",
                        "prendre"
                    ],
                    "common_phrases": [
                        "adopter une attitude",
                        "adopter un comportement",
                        "adopter une nouvelle méthode"
                    ]
                },
                {
                    "sense_id": "fdbac04a-41e2-3cf7-b2f0-51e9be4af41d",
                    "sense_definition": "Approuver un projet, une loi ou une résolution par un vote officiel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique_et_legislation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les députés réunis en séance plénière ont finalement <w>adopté</w> cette nouvelle loi à la majorité."
                        },
                        {
                            "text": "Le conseil municipal a <w>adopté</w> le budget prévisionnel pour l'année à venir."
                        }
                    ],
                    "synonyms": [
                        "voter",
                        "approuver",
                        "valider"
                    ],
                    "common_phrases": [
                        "adopter une loi",
                        "adopter un projet de loi",
                        "adopter une résolution"
                    ]
                }
            ]
        }
    ]
}