                        "examples": [
                            {
                                "example_id": "1e8c163e-5aa1-40be-9d6f-804a639f2649",
                                "sense_id": "7b8292b9-1746-3fca-8c53-3c81ded4f4dd",
                                "text": "There is Basildon - and Hurley - and Pangbourne, with its roaring lasher"
                            },
                            {
                                "example_id": "4dda78ab-aa92-4e26-981c-810473e9f288",
                                "sense_id": "7b8292b9-1746-3fca-8c53-3c81ded4f4dd",
                                "text": "They paddled on in silence till they came to the lasher. Together they hauled the punt over the rollers ... Through the network of branches moonlight drifted, making ... water, rushing foam-streaked from the lasher, eerie and fantastic."
                            }
                        ]
                    }
