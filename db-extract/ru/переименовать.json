                "senses": [
                    {
                        "sense_id": "51be1268-d300-33e8-8e7d-62645d29b353",
                        "entry_id": "1874b57f-41dd-33e5-8e88-5859b7c3c854",
                        "glosses": [
                            "дать кому-либо, чему-либо новое, другое имя или название"
                        ],
                        "tags": [],
