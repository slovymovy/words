                "senses": [
                    {
                        "sense_id": "85d70100-59ce-3631-803a-7b5366da05e1",
                        "entry_id": "9a6df712-7515-32cd-8893-4f0142aaff56",
                        "glosses": [
                            "een lens die het opvallende zonlicht op een klein oppervlak concentreert dat daardoor sterk verhit wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aebc5522-3c2c-4aee-a8a7-3d694d29fe15",
                                "sense_id": "85d70100-59ce-3631-803a-7b5366da05e1",
                                "text": "Een vergrootglas kan als brandglas werken en brand veroorzaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c00794c0-6928-412a-9e9e-c97619ceb15c",
                        "source_entry_id": "9a6df712-7515-32cd-8893-4f0142aaff56",
                        "source_sense_id": "85d70100-59ce-3631-803a-7b5366da05e1",
                        "source_sense_description": "een lens die het opvallende zonlicht op een klein oppervlak concentreert dat daardoor sterk verhit wordt",
                        "target_lang_word": "Brennglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                        "entry_id": "e8962477-b8e4-3a56-ac41-80557daa1243",
                                        "glosses": [
                                            "Glasstück, das so geformt ist, dass es einfallendes Licht in einem Punkt bündelt"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4687ff79-e362-4d23-856c-2e4e79871eb4",
                                                "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                                "text": "Bei Sonnenschein kann man mit einem Brennglas wunderbar kokeln."
                                            },
                                            {
                                                "example_id": "626679b8-64dc-485e-b6cc-ff47bb060100",
                                                "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                                "text": "„Das mit dem Brennglas schien ihm einzuleuchten.“"
                                            },
                                            {
                                                "example_id": "d6d954ca-b38f-4ae1-a8e3-91293fad5c05",
                                                "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                                "text": "„Laut den Archäologen George Sines und Yannis A. Sakellarakis wurden bereits viele von Menschenhand geschliffene Linsen der Antike entdeckt, die aus Kristall (meist Quarz) gefertigt wurden, jedoch ist mangels schriftlicher Quellen nicht überliefert, ob diese jeweils als Sehhilfe oder lediglich als Brennglas zum Feuermachen verwendet wurden.“"
                                            },
                                            {
                                                "example_id": "9134a96e-84de-4209-a0a3-c2f5c3625ab7",
                                                "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                                "text": "[Waldbrände:] „Neben dem Klimawandel sind die Gründe für die zerstörerischen Flammen vielschichtig und oftmals menschengemacht: eine achtlos hingeworfene Zigarette, die auf dem trockenen Boden weiter glimmt, die Glasscherbe einer kaputten Flasche, die wie ein Brennglas wirkt.“"
                                            },
                                            {
                                                "example_id": "550e979a-46d9-4005-b48c-8631e60b028a",
                                                "sense_id": "d5b266f1-d7f9-3dd6-ba8a-3818c8257aa6",
                                                "text": "„Pencroff sah das improvisierte Brennglas und dann den Ingenieur an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                        "entry_id": "e8962477-b8e4-3a56-ac41-80557daa1243",
                                        "glosses": [
                                            "etwas (meist ein Problem) wird besonders deutlich erkennbar"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86781b3d-d61d-4486-b8ac-259a90f3c356",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "„Wie unter einem Brennglas hat uns die Pandemie gezeigt, wie wichtig es ist, Freundschaften und Beziehungen zu pflegen“ […]."
                                            },
                                            {
                                                "example_id": "0cbbe9e7-4a16-4fc1-af3b-f08805afd1e2",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "„Unter dem Brennglas der Krisen treten die Versäumnisse der Vergangenheit überdeutlich zu Tage.“"
                                            },
                                            {
                                                "example_id": "3fc4bb1d-1ae7-4932-be21-2324c9b5486b",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "„Ein völlig anderer Notfall ist hingegen die nur bedingt einsatzfähige Bundeswehr, deren maroder Zustand seit Beginn des Ukraine-Kriegs wie unter einem Brennglas sichtbar wird.“"
                                            },
                                            {
                                                "example_id": "18a8a932-3092-4f89-bc6b-895dc8e68e44",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "[1991 – Putschversuch in Russland:] „Der Putschversuch von Moskau hatte uns wie unter dem Brennglas gezeigt, wie fragil die Entwicklung in Moskau war.“"
                                            },
                                            {
                                                "example_id": "2a69f7c5-d85a-475d-a702-ec6e6f8f9b1f",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "[Lady Di, Princess of Wales:] „Der Dokumentarfilm \"The Princess\" erzählt ihr Leben unter dem Brennglas der Öffentlichkeit nach“ […]."
                                            },
                                            {
                                                "example_id": "ed4cfe3a-be9c-4538-b11e-a35275a6b08a",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "„Wie in einem Brennglas zeigt der Roman die brutale Realität des Krieges - in einer Situation, in der das Weiterkämpfen längst aussichtlos war.“"
                                            },
                                            {
                                                "example_id": "e278aca4-e384-444e-9ce3-02ee93697a7b",
                                                "sense_id": "a517cdfb-73bc-3fdc-a9f6-fe44db70639f",
                                                "text": "[Coronapandemie 2020:] „Wie ein Brennglas zeigt die Krise, welche besondere Belastung Alleinerziehende haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4a8f0a0-37f8-43b8-8d72-d7e6bd8a50c2",
                        "source_entry_id": "9a6df712-7515-32cd-8893-4f0142aaff56",
                        "source_sense_id": "85d70100-59ce-3631-803a-7b5366da05e1",
                        "source_sense_description": "een lens die het opvallende zonlicht op een klein oppervlak concentreert dat daardoor sterk verhit wordt",
                        "target_lang_word": "burning glass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burning glass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25aa2e93-2281-337c-98df-d45990544b0b",
                                        "entry_id": "81ea6962-cb38-3694-b513-6684c60e5ac8",
                                        "glosses": [
                                            "A large convex lens or concave mirror that can concentrate the sun's rays onto a small area, heating up the area and thus resulting in ignition of the exposed surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7652c1fc-0e98-4a2e-bfa4-b6c9ec7b2041",
                        "source_entry_id": "9a6df712-7515-32cd-8893-4f0142aaff56",
                        "source_sense_id": "85d70100-59ce-3631-803a-7b5366da05e1",
                        "source_sense_description": "een lens die het opvallende zonlicht op een klein oppervlak concentreert dat daardoor sterk verhit wordt",
                        "target_lang_word": "loupe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loupe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7b5766-b5b5-35c4-9c83-fa92666fe73f",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Verre convexe des deux côtés qui grossit les objets à la vue."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98336438-4499-463d-8385-68b74048d8d1",
                                                "sense_id": "2d7b5766-b5b5-35c4-9c83-fa92666fe73f",
                                                "text": "Une antique Remington occupait l’extrémité d’une table, voisinant avec un registre ouvert et tout ce qu’il fallait pour écrire, plus un cendrier débordant de mégots, une petite lampe à abat-jour vert, un téléphone, un trébuchet sensible comme une midinette, une loupe d’horloger, une pierre de touche, etc."
                                            },
                                            {
                                                "example_id": "dc56b639-ba82-436d-a418-3d84e3d1c8f8",
                                                "sense_id": "2d7b5766-b5b5-35c4-9c83-fa92666fe73f",
                                                "text": "La loupe servit dès lors à éplucher les figures des femmes. Renée fit des découvertes étonnantes ; elle trouva des rides inconnues, des peaux rudes, des trous mal bouchés par la poudre de riz."
                                            },
                                            {
                                                "example_id": "1292df0b-4979-4cc2-aac3-40bc820973df",
                                                "sense_id": "2d7b5766-b5b5-35c4-9c83-fa92666fe73f",
                                                "text": "D’ailleurs, le moment serait peut-être opportun de les passer à la loupe… Car sans eux, rien ne se fait, et il serait dommage de les oublier…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "198189ac-2fac-3cbe-b023-dd55de403ba4",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Tumeur enkystée qui vient sous la peau, qui s’élève en rond et augmente quelquefois jusqu’à une extrême grosseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293177b4-646d-47ff-a34a-47f0f1170559",
                                                "sense_id": "198189ac-2fac-3cbe-b023-dd55de403ba4",
                                                "text": "J’avoue que cette physionomie me fit faire, ce premier jour et bien d’autres, la question qui pour moi est encore aujourd’hui insoluble : comment cette grande fille-là était-elle sortie de ce gros bonhomme en redingote jaune vert et à gilet blanc, qui avait une figure couleur des confitures de sa femme, une loupe sur la nuque, laquelle débordait sa cravate de mousseline brodée, et qui bredouillait ?…"
                                            },
                                            {
                                                "example_id": "c6113714-57a5-45ee-b941-71b0b7557488",
                                                "sense_id": "198189ac-2fac-3cbe-b023-dd55de403ba4",
                                                "text": "On gratta à la porte et une fille, une campagnarde, parut, plus large que haute, rousse, bancale, une loupe lui cachant l’œil gauche, l’œil droit d’un bleu si pâle qu’il en paraissait blanc, les lèvres énormes et les dents débordant les lèvres."
                                            },
                                            {
                                                "example_id": "0ea60720-52a9-4cb4-9546-6b2e120528b9",
                                                "sense_id": "198189ac-2fac-3cbe-b023-dd55de403ba4",
                                                "text": "Ici, malgré tout mon désir de ne relater que l’essentiel, je ne puis passer sous silence la loupe d’Anthime Armand-Dubois. Car, tant que je n’aurai pas plus sûrement appris à démêler l’accidentel du nécessaire, qu’exigerais-je de ma plume sinon exactitude et rigueur ? Qui pourrait affirmer en effet que cette loupe n’avait joué aucun rôle, qu’elle n’avait pesé d’aucun poids dans les décisions de ce qu’Anthime appelait sa libre pensée ? Plus volontiers il passait outre sa sciatique ; mais cette mesquinerie, il ne la pardonnait pas au bon Dieu."
                                            },
                                            {
                                                "example_id": "d5ab3c3b-76e5-4f5d-9c7d-90e308a7b79d",
                                                "sense_id": "198189ac-2fac-3cbe-b023-dd55de403ba4",
                                                "text": "Depuis un an en effet, j’allais deux fois par semaine subir au catéchisme l’enseignement de Mlle Gosselin, personne de petite taille qui ne souriait jamais, gardait toujours son chapeau noir sur la tête et portait au-dessus de la lèvre une loupe plantée de quelques poils. Elle nous faisait réciter les prières, quelques cantiques et les commandements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e52095db-235a-3871-a683-96ee3ed74a4a",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Excroissance ligneuse qui se développe sur le tronc ou sur les branches de certains arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b21c3f-1988-463f-85d3-ec7d2372547a",
                                                "sense_id": "e52095db-235a-3871-a683-96ee3ed74a4a",
                                                "text": "Il aimait le tronc bossué de l’orme, dont chaque loupe pousse, avec de tendres rejetons, des touffes de feuilles dentelées et des samares de papier."
                                            },
                                            {
                                                "example_id": "5eb80938-9098-4aa6-9e26-ae1102d5e53b",
                                                "sense_id": "e52095db-235a-3871-a683-96ee3ed74a4a",
                                                "text": "Les loupes d’orme servent à faire de jolis ouvrages de tabletterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b9a8ee-06c3-3192-b939-bf5e88a3f180",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Pierre précieuse d’une transparence imparfaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a609928-bb5b-435c-b810-0801c070f3b5",
                                                "sense_id": "a2b9a8ee-06c3-3192-b939-bf5e88a3f180",
                                                "text": "Loupe de saphir, de rubis, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9564a04b-393d-3b9a-9c61-fb53a08e35ed",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Masse de matière nacrée restée informe dans la coquille d’une huître perlière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "793641a9-b172-388c-80a8-9248de1a1cd2",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Produit issu d'une fonte imparfaite qui contient des scories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90fea1bf-97e1-4c72-b948-ea54f45ea90e",
                                                "sense_id": "793641a9-b172-388c-80a8-9248de1a1cd2",
                                                "text": "Le produit obtenu était une loupe impure, très souvent aciéreuse, mêlée à beaucoup de scories ; on la purifiait en la cinglant et en la martelant plusieurs fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66b657c-2e28-3ecb-9c98-1f8affb6b7c6",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Goût de la flânerie ou même de la fainéantise."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "614b5ac5-86a0-3018-9b6a-94a1a5bf0ebf",
                                        "entry_id": "d73e4faa-8f6c-36ae-a796-88c51824e691",
                                        "glosses": [
                                            "Moyen de faire ressortir, de rendre plus visible."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ec6a78-8723-44b7-ad0b-9ccc0a9043c6",
                                                "sense_id": "614b5ac5-86a0-3018-9b6a-94a1a5bf0ebf",
                                                "text": "L’intérêt mondial pour cette maladie et le regroupement des cas sur quelques semaines créent cependant un effet loupe, qui laisse espérer que ces malades ne tomberont pas dans l’oubli."
                                            }
                                        ]
                                    }
                                ]
                            },
