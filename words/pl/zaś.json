{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "c4908f20-2e26-3b95-a810-0e178cc033d4",
                    "sense_definition": "spójnik wprowadzający przeciwstawienie lub kontrast, odpowiednik słowa natomiast",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden brat lubi czytać książki, drugi <w>zaś</w> woli grać w piłkę.",
                            "target_lang_translations": {
                                "ru": "Один брат любит читать книги, другой <w>же</w> предпочитает играть в футбол."
                            }
                        },
                        {
                            "text": "Pogoda była piękna, <w>zaś</w> wieczorem zaczęło padać.",
                            "target_lang_translations": {
                                "ru": "Погода была прекрасная, а вот вечером пошёл дождь."
                            }
                        }
                    ],
                    "synonyms": [
                        "natomiast",
                        "a"
                    ],
                    "common_phrases": [
                        "a zaś",
                        "zaś natomiast"
                    ],
                    "target_lang_definitions": {
                        "ru": "союз, вводящий противопоставление или контраст, эквивалент слова «а» или «же»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "используется для противопоставления одного предложения другому"
                            },
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "союз для противопоставления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a93b41b8-b8f8-3eeb-8d0c-d38b6cc782b2",
                    "sense_definition": "znowu, ponownie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiad <w>zaś</w> przyjechał do miasta w odwiedziny.",
                            "target_lang_translations": {
                                "ru": "Сосед же приехал в город в гости."
                            }
                        },
                        {
                            "text": "Dziecko <w>zaś</w> zaczęło płakać bez wyraźnego powodu.",
                            "target_lang_translations": {
                                "ru": "Ребёнок же начал плакать без видимой причины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Górny Śląsk"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "снова, опять, повторно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опять",
                                "target_lang_sense_clarification": "указывает на повторение действия"
                            },
                            {
                                "target_lang_word": "снова",
                                "target_lang_sense_clarification": "указывает на возобновление действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cc16802-d33b-3e63-ab7d-2b5103570b80",
                    "sense_definition": "potem, następnie, później",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Najpierw zjedliśmy obiad, <w>zaś</w> poszliśmy na spacer.",
                            "target_lang_translations": {
                                "ru": "Сначала мы пообедали, а затем пошли на прогулку."
                            }
                        },
                        {
                            "text": "Najpierw kupię bilety, <w>zaś</w> zadzwonię do ciebie.",
                            "target_lang_translations": {
                                "ru": "Сначала я куплю билеты, а потом позвоню тебе."
                            }
                        }
                    ],
                    "synonyms": [
                        "potem",
                        "później"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Poznań"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "потом, затем, после этого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затем",
                                "target_lang_sense_clarification": "указывает на последовательность действий"
                            },
                            {
                                "target_lang_word": "потом",
                                "target_lang_sense_clarification": "указывает на время, следующее за предыдущим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d24adc7-f679-3735-a702-c4849b94e913",
                    "sense_definition": "słowo używane dla wzmocnienia znaczenia innych spójników lub przysłówków",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy <w>zaś</w> przyjdzie czas, wszystko się wyjaśni.",
                            "target_lang_translations": {
                                "ru": "Когда же придёт время, всё прояснится."
                            }
                        },
                        {
                            "text": "Gdzie <w>zaś</w> szukać pomocy w takiej sytuacji?",
                            "target_lang_translations": {
                                "ru": "Где же искать помощи в такой ситуации?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Poznań"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "слово, используемое для усиления значения других союзов или наречий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "частица для эмоционального выделения или подчеркивания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}