                    },
                    {
                        "translation_id": "9fae14c8-58d8-4e8a-862b-f8ce13ca7f70",
                        "source_entry_id": "eaa6c2a7-0ce5-347a-948d-f16e89d3b08c",
                        "source_sense_description": "выражающий насмешку, издевательство",
                        "target_lang_word": "derisive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derisive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14aa75ad-a168-3233-8708-12e5d06dae47",
                                        "entry_id": "43142528-59df-3ade-8187-dbe2c4164846",
                                        "glosses": [
                                            "Expressing or characterized by derision; mocking; ridiculing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6a0fef-bf0d-4386-b782-74923e7eec47",
                                                "sense_id": "14aa75ad-a168-3233-8708-12e5d06dae47",
                                                "text": "The critic's review of the film was derisive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c0d229-ff9b-304a-95c7-ab15d9461c57",
                                        "entry_id": "43142528-59df-3ade-8187-dbe2c4164846",
                                        "glosses": [
                                            "Deserving or provoking derision or ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace7ccda-8db9-41e1-8da9-34b064d3a710",
                                                "sense_id": "02c0d229-ff9b-304a-95c7-ab15d9461c57",
                                                "text": "The plot of the film was so derisive that the audience began to jeer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "derisive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "088b7238-ae34-349f-85f0-656e466a6672",
                                        "entry_id": "aa62a20b-7a7e-37f4-905d-d7e4bac2ef43",
                                        "glosses": [
                                            "A derisive remark."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80fc18b4-e825-4fdc-a28b-ec1a4b1b344b",
                                                "sense_id": "088b7238-ae34-349f-85f0-656e466a6672",
                                                "text": "The three lambs stood at bay, huddled close together, and helplessly bleated feeble derisives at the wolf who has headed them off from safety; but their polite and Englishy tone was a source of Homeric laughter to this Thersites of the Pleasance."
                                            },
                                            {
                                                "example_id": "487a9539-83f4-429f-a0ac-b722a84b08ea",
                                                "sense_id": "088b7238-ae34-349f-85f0-656e466a6672",
                                                "text": "He leaped over the embankment at the river's edge in such a manner that it appeared he had been fatally hit and was down for good; the Yankees shouting such derisives as \"Another damn Rebel for hell,\" \"Goodbye, you Rebel bastard,\" etc., didn't go right away to rob the corpse."
                                            },
                                            {
                                                "example_id": "0cd5aeb0-1165-4a46-929d-7417dd91070e",
                                                "sense_id": "088b7238-ae34-349f-85f0-656e466a6672",
                                                "text": "Indeed, the power inherent in the labels attributed to them has repeatedly transformed these terms from allegedly scientific ones into colloquial derisives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
