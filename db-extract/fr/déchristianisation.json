                                "target_senses": [
                                    {
                                        "sense_id": "889db099-8667-39bf-a121-d4d1a899ae67",
                                        "entry_id": "dcf7ef70-054a-3924-99f1-a495ba280106",
                                        "glosses": [
                                            "The act of dechristianizing; the systematic removal of Christianity or Christian elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714ec997-0d5c-44a9-842f-78f57d684b9b",
                                                "sense_id": "889db099-8667-39bf-a121-d4d1a899ae67",
                                                "text": "Fouché, before 1789 a teacher attached to the Oratorian order, engaged in an extraordinary campaign of ‘dechristianization’ in his tour of duty in the department of the Nièvre in September [...]."
                                            }
                                        ]
