                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04165bd9-39eb-4223-9a49-b14f129dea85",
                                "sense_id": "e7d40a06-aa01-3a05-82e0-ebfb99e6c3f1",
                                "text": "De winkelbediende, een jongeman met een honkbalpet achterstevoren op zijn hoofd, tekende een kaartje voor me."
                            },
                            {
                                "example_id": "258015e8-e56a-43dc-88c7-d36544cebcc3",
                                "sense_id": "e7d40a06-aa01-3a05-82e0-ebfb99e6c3f1",
                                "text": "Demjanjuk heeft tijdens het helemaal niets gezegd. Hij droeg doorgaans een honkbalpet en een zonnebril, en werd in een rolstoel de rechtszaal binnen gereden. Vervolgens werd hij op een bed gelegd, waarna hij ogenschijnlijk onaangedaan de zittingen volgde."
                            }
                        ]
                    }
