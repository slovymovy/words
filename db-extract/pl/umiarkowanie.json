                                "target_senses": [
                                    {
                                        "sense_id": "9cb635b8-ddaa-36b6-9aae-a4f553579757",
                                        "entry_id": "b4f5d56e-df49-3074-be3d-df87b4e34861",
                                        "glosses": [
                                            "Avec modération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e6fb8e-8864-440e-9eb9-affb220aecb0",
                                                "sense_id": "9cb635b8-ddaa-36b6-9aae-a4f553579757",
                                                "text": "C'est un grand signe de médiocrité de louer toujours modérément."
                                            },
                                            {
                                                "example_id": "c0d7e427-7e17-4688-82ad-bc097788f270",
                                                "sense_id": "9cb635b8-ddaa-36b6-9aae-a4f553579757",
                                                "text": "Il est plus facile de renoncer à ce qui nous plaît, que d’en user modérément."
                                            },
                                            {
                                                "example_id": "d0b9dba6-e347-4e34-acd0-b2ec2da7443a",
                                                "sense_id": "9cb635b8-ddaa-36b6-9aae-a4f553579757",
                                                "text": "Mais le duc de Mayenne lui fit dire de prêcher plus modérément, sinon qu'il l'enverrait, cousu dans son froc , prêcher dans la rivière."
                                            }
                                        ]
                                    }
