                "senses": [
                    {
                        "sense_id": "fbc90c5b-5fc8-3ff3-872b-549ee1193f99",
                        "entry_id": "75025d23-437e-3aad-ba4c-8ec764978199",
                        "glosses": [
                            "zadawanie komuś pytań, wypytywanie lub dopytywanie się"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d25274b-f538-4bda-919e-52bc2a0e837a",
                                "sense_id": "fbc90c5b-5fc8-3ff3-872b-549ee1193f99",
                                "text": "Najogólniej ujmując można powiedzieć, że badanie, to interakcja trzech przedmiotów: badacza, ankietera i respondenta. Istotą owej interakcji jest komunikacja werbalna, a ściśle mówiąc interrogacja, a więc ukierunkowana komunikacja za pośrednictwem pytań i odpowiedzi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0cf5a1b8-be42-3be4-9eb2-1bb7e1d9a371",
                        "entry_id": "75025d23-437e-3aad-ba4c-8ec764978199",
                        "glosses": [
                            "zadawanie pytań podczas przesłuchania w śledztwie"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "525140c0-4099-4c42-882e-014a52cf3fa9",
                                "sense_id": "0cf5a1b8-be42-3be4-9eb2-1bb7e1d9a371",
                                "text": "Więzienie i interrogacje przekonały więźnia, że jego indywidualizm jest przyczyną jego męczarni, i po przyjęciu formułek szybko awansuje"
                            },
                            {
                                "example_id": "058c2163-792f-4c0b-ab0c-04ec1eb43170",
                                "sense_id": "0cf5a1b8-be42-3be4-9eb2-1bb7e1d9a371",
                                "text": "po pierwszym pytaniu / policzki nabiegają krwią // krew rozprowadzają / narzędzia i interrogacja // żelazem trzciną / wolnym ogniem / określa się granice / jego ciała"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5fdc4506-a556-3550-a779-d5d2897520b9",
                        "entry_id": "75025d23-437e-3aad-ba4c-8ec764978199",
                        "glosses": [
                            "figura retoryczna polegająca na zadaniu pytania zamiast podania twierdzenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cacc28a-0eeb-4d19-bac4-269a7a9c2102",
                                "sense_id": "5fdc4506-a556-3550-a779-d5d2897520b9",
                                "text": "Wśród zastosowanych przez autora środków stylistycznych, w wierszu znalazły się umiejętnie wstawione eksklamacje, interrogacje i pauzy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
