                        "glosses": [
                            "grot waarin het hele jaar veel ijs aanwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f577343-c1fc-4256-866c-5aa454e19c39",
                                "sense_id": "12ea07de-ef1a-3727-ac82-55bcd21f363c",
                                "text": "Reeds in april en mei gaat de zon niet meer onder, maar ligt er nog volop sneeuw en is het water in de fjorden nog bevroren. Die periode is het mogelijk een huskytocht te maken of een ijsgrot te bezoeken."
                            },
                            {
                                "example_id": "05cdfe03-0706-4e32-8d79-08562228e241",
                                "sense_id": "12ea07de-ef1a-3727-ac82-55bcd21f363c",
                                "text": "Ze nemen ze gevangen zodra ze door hun ijsgrotten varen. Je komt er pas weer uit als je een dansbattle wint. Als Clodovea zing ik de IJsco-mambo, een heel zomers liedje."
                            }
                        ]
                    }
