        "fr-extract.jsonl": [
            {
                "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                "word": "gentilhomme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "892a8555-7519-4ba0-a374-7e124066c0d7",
                        "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "gentilshommes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abf883b3-d1fa-34fe-ab36-47f0db26b6eb",
                        "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "glosses": [
                            "Celui qui est de naissance noble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be075ce0-0805-4bd1-83de-dd47511410e8",
                                "sense_id": "abf883b3-d1fa-34fe-ab36-47f0db26b6eb",
                                "text": "À l’œuvre donc, Brian de Bois-Guilbert ! et, mort ou vivant, vous verrez aujourd’hui Maurice de Bracy se comporter en gentilhomme de haute valeur et de noble lignage !"
                            },
                            {
                                "example_id": "c032d7de-623d-49fb-ac44-bea275873f75",
                                "sense_id": "abf883b3-d1fa-34fe-ab36-47f0db26b6eb",
                                "text": "Durant toute la période historique, ces deux classes nettement déterminées, — gentilshommes et roturiers, — agirent et réagirent l’une contre l’autre, […]."
                            },
                            {
                                "example_id": "3f7ab7d6-c8bf-4a72-a86e-2bdc231458fd",
                                "sense_id": "abf883b3-d1fa-34fe-ab36-47f0db26b6eb",
                                "text": "Les prêtres s’entendent à merveille pour procurer de riches dots aux nobles appau­vris, au point qu’on a pu accuser l’Église de considérer le mariage comme un accouplement de gentilshommes vivant en marlous et de bourgeoises réduites au rôle de marmites."
                            },
                            {
                                "example_id": "7dce1c51-6afe-4b55-a1c1-276c65eeacbd",
                                "sense_id": "abf883b3-d1fa-34fe-ab36-47f0db26b6eb",
                                "text": "Mais sa popularité ne survit pas à son mariage avec Marina, Polonaise et catholique, qui amène à la Cour une suite de gentilshommes de son pays dont l’attitude conquérante irrite les Moscovites."
                            }
                        ]
                    },
                    {
                        "sense_id": "427e1008-f5bb-3dc4-8834-69e85c5e5eb2",
                        "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "glosses": [
                            "Homme qui, sans être noble de naissance, a des sentiments, des manières nobles."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "137cc716-1c08-4a40-8c36-5004028d4219",
                                "sense_id": "427e1008-f5bb-3dc4-8834-69e85c5e5eb2",
                                "text": "Il ressemblait bien plutôt à un gentilhomme en visite chez des voisins de campagne qu’à un prisonnier sur le point d’être fusillé, il ne semblait pas se soucier le moins du monde du péril qu’il courait ; […]."
                            },
                            {
                                "example_id": "d9ae06d3-f9a4-414e-9b61-705acfcb18da",
                                "sense_id": "427e1008-f5bb-3dc4-8834-69e85c5e5eb2",
                                "text": "Nous sommes deux gentilshommes, dit-il en donnant à ce mot l’acception du mot anglais gentleman, et nous pouvons nous entendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f15f5ecd-6fe5-379d-a6d8-954563f3450e",
                        "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "glosses": [
                            "Homme noble qui s’attachait à un prince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa6609fa-4630-49bd-968c-c94ad3ac8bb2",
                                "sense_id": "f15f5ecd-6fe5-379d-a6d8-954563f3450e",
                                "text": "Le trisaïeul de son trisaïeul était l’égal, le compagnon, le pair du roi; à ce titre il est lui-même d'une classe privilégiée, celle des gentilshommes; aussi ce n'est pas par intérêt qu’il sert les princes; il met son honneur à leur être dévoué."
                            },
                            {
                                "example_id": "78f39a6c-7fa9-40bf-942e-65e0d684a2f1",
                                "sense_id": "f15f5ecd-6fe5-379d-a6d8-954563f3450e",
                                "text": "Autour de Monsieur se groupaient quelques gentilshommes, factieux, avides, remuants, qui ne pouvaient grandir et s’enrichir que par le désordre. Le duc d’Orléans était leur garant, leur pavillon, leur espoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4d81426-a898-3310-ac57-5089855986be",
                        "entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "glosses": [
                            "Un titre de charge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3553f6-bd9f-41aa-8ff6-4b4ca1014fea",
                                "sense_id": "e4d81426-a898-3310-ac57-5089855986be",
                                "text": "Premier gentilhomme de la chambre. Gentilhomme ordinaire. Gentilhomme servant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be135cb7-231d-4fab-b423-a4b1ab17d2bd",
                        "source_entry_id": "c8d6ca49-9b99-3af1-9d6e-13c90c1c41aa",
                        "target_lang_word": "gentleman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentleman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "Any well-bred, well-mannered, or charming man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fe4155-0455-4bb0-a364-970bdad8d815",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "ba7af072-f77b-4039-a3d3-80f7f6bc92f2",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "As a political system democracy seems to me extraordinarily foolish,[…]. My servant is, so far as I am concerned, welcome to as many votes as he can get.[…]I do not suppose that it matters much in reality whether laws are made by dukes or cornerboys, but I like, as far as possible, to associate with gentlemen in private life."
                                            },
                                            {
                                                "example_id": "be204bcc-e4dc-4b91-9841-f10c7fbd25a2",
                                                "sense_id": "4eded55f-50f2-363f-b57f-5f17babac59e",
                                                "text": "She wanted to go see a movie called Gigi, which I was not too thrilled about. But being a gentleman, I bit my tongue and said, “Okay.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d77ac7e-240c-3dec-ba00-bbd89f213451",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "Any man."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "polite",
                                            "term-of-address"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d746b18-0fb0-4422-a4e3-127eb0b7446c",
                                                "sense_id": "7d77ac7e-240c-3dec-ba00-bbd89f213451",
                                                "text": "Please escort this gentleman to the gentlemen's room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "A man of gentle but not noble birth, particularly a man of means (originally ownership of property) who does not work for a living but has no official status in a peerage; (UK law) an armigerous man ranking below a knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187426b7-5eb6-420c-a427-5d4d8bd966d0",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "Being a gentleman, Robert was entitled to shove other commoners into the gongpit but he still had to jump out of the way of the knights to avoid the same fate himself."
                                            },
                                            {
                                                "example_id": "bd3e0582-49da-4f8f-98a0-28b91dc75a85",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "And when their ſcattered armie is ſubdu’d:\nAnd you march on their ſlaughtered carkaſſes,\nShare equally the gold that bought their liues,\nAnd liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "ef3f7daa-1f14-4326-9e5b-c9703b502c43",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "But when Adam delued, and Eue ſpan,\nVVho was then a Gentleman?"
                                            },
                                            {
                                                "example_id": "e0db961e-a5b7-4647-b73c-0ae57e87c04a",
                                                "sense_id": "4d885a51-2f67-3c31-90c9-105cbaf37f2b",
                                                "text": "“[…] This is Mr. Churchill, who, as you are aware, is good enough to come to us for his diaconate, and, as we hope, for much longer; and being a gentleman of independent means, he declines to take any payment.” Saying this Walden rubbed his hands together and smiled contentedly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "703d393c-f0fb-3c0a-a137-170652f82a0c",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An effeminate or oversophisticated man."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bbf278c-d96f-451c-8d3b-ccbc58cfc646",
                                                "sense_id": "703d393c-f0fb-3c0a-a137-170652f82a0c",
                                                "text": "Well, la-di-da, aren't you just a proper gentleman?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8981621-578c-33c8-8788-2b68c3932fcb",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An amateur or dabbler in any field, particularly those of independent means."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "historical",
                                            "sometimes",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58239d0e-27b5-4a1a-a85b-2db9085a2afa",
                                                "sense_id": "c8981621-578c-33c8-8788-2b68c3932fcb",
                                                "text": "Latrobe had extensive dealings with Jefferson, the most prominent gentleman-architect in the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f10bbf-0541-30e4-b70c-6f99476f7c69",
                                        "entry_id": "1b7626de-1d1e-3a36-861e-214395ef8aa9",
                                        "glosses": [
                                            "An amateur player, particularly one whose wealth permits him to forego payment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
