                                                "sense_id": "1f28f858-7bbe-3633-86bb-14834512e967",
                                                "text": "Ik ruim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8f7d567-fc63-3dfa-b887-7768711cfc8c",
                                        "entry_id": "35af8731-8b7e-3ce1-9982-fed9862f2acd",
                                        "glosses": [
                                            "gebiedende wijs van ruimen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5431697a-364d-431f-9cdf-57eea8ee8373",
                                                "sense_id": "e8f7d567-fc63-3dfa-b887-7768711cfc8c",
                                                "text": "Ruim!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786bd68f-5f49-38b5-bb71-38db9a4884f4",
                                        "entry_id": "35af8731-8b7e-3ce1-9982-fed9862f2acd",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van ruimen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
