                    "sense_id": "4c89895b-84ce-341a-916b-d67be378bc3c",
                    "sense_definition": "pokrywać się chmurami, stawać się pochmurnym",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niebo zaczęło się <w>chmurzyć</w> i wkrótce zaczął padać deszcz.",
                            "target_lang_translations": {
                                "en": "The sky began to <w>cloud over</w> and soon it started to rain.",
                                "ru": "Небо стало <w>хмуриться</w>, и вскоре пошёл дождь.",
                                "nl": "De lucht begon te <w>betrekken</w> en al snel begon het te regenen.",
                                "de": "Der Himmel begann <w>sich zu bewölken</w>, und bald fing es an zu regnen.",
                                "fr": "Le ciel a commencé à <w>se couvrir</w> et la pluie n'a pas tardé à tomber.",
                                "it": "Il cielo ha iniziato ad <w>annuvolarsi</w> e presto ha cominciato a piovere.",
                                "cs": "Nebe se začalo <w>mračit</w> a brzy začalo pršet.",
                                "tr": "Gökyüzü <w>bulutlanmaya</w> başladı ve çok geçmeden yağmur yağdı.",
                                "es": "El cielo empezó a <w>nublarse</w> y pronto empezó a llover.",
                                "zh": "天空开始<w>变阴</w>，不久就下起雨来。"
                            }
                        },
                        {
                            "text": "Gdy tylko niebo zaczęło się <w>chmurzyć</w>, wróciliśmy szybko do domu.",
                            "target_lang_translations": {
                                "en": "As soon as the sky began to <w>cloud up</w>, we quickly returned home.",
                                "ru": "Как только небо начало <w>затягиваться тучами</w>, мы быстро вернулись домой.",
                                "nl": "Zodra de lucht begon te <w>betrekken</w>, keerden we snel terug naar huis.",
                                "de": "Sobald der Himmel begann, <w>sich zuzuziehen</w>, kehrten wir schnell nach Hause zurück.",
                                "fr": "Dès que le ciel a commencé à <w>s'ennuager</w>, nous sommes vite rentrés à la maison.",
                                "it": "Non appena il cielo ha cominciato a <w>rannuvolarsi</w>, siamo tornati subito a casa.",
                                "cs": "Jakmile se obloha začala <w>zatahovat</w>, vrátili jsme se rychle domů.",
                                "tr": "Gökyüzü <w>kapanmaya</w> başlar başlamaz hemen eve döndük.",
                                "es": "En cuanto el cielo empezó a <w>encapotarse</w>, volvimos rápidamente a casa.",
                                "zh": "天色刚一开始<w>转阴</w>，我们就赶紧回了家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zachmurzać się",
                        "chmurnieć"
                    ],
                    "common_phrases": [
                        "niebo chmurzy się"
                    ],
                    "target_lang_definitions": {
                        "en": "to become covered with clouds, to cloud over",
                        "ru": "покрываться облаками или тучами, становиться пасмурным (о небе, погоде)",
                        "nl": "bedekt raken met wolken, bewolkt worden",
                        "de": "sich mit Wolken bedecken, bewölkt oder trübe werden (vom Himmel oder Wetter)",
                        "fr": "se couvrir de nuages, devenir nuageux ou sombre en parlant du ciel",
                        "it": "Coprirsi di nuvole, diventare nuvoloso (riferito al cielo o al tempo)",
                        "cs": "pokrývat se mraky, stávat se zataženým nebo pošmourným (o obloze či počasí)",
                        "tr": "Gökyüzünün bulutlarla kaplanması, havanın bulutlanması veya kapanması.",
                        "es": "Cubrirse de nubes, volverse nublado o encapotarse el cielo.",
                        "zh": "（天空）布满乌云，转阴，阴沉下来"
                    },
