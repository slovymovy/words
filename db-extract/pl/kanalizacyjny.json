                "senses": [
                    {
                        "sense_id": "a5665912-622c-3119-884d-43f4a26725db",
                        "entry_id": "c7ae893d-9801-32ca-a811-a992080bfd8c",
                        "glosses": [
                            "związany z kanalizacją, dotyczący kanalizacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb23f0ce-5849-4c61-a16f-c13f69f7653c",
                                "sense_id": "a5665912-622c-3119-884d-43f4a26725db",
                                "text": "Na przełomie listopada i grudnia gmina Poronin ogłosi przetarg na wykonanie głównego ciągu kanalizacyjnego na Stasikówce i w Suchem"
                            },
                            {
                                "example_id": "f5db6a9c-a201-419d-8518-1fd91717db91",
                                "sense_id": "a5665912-622c-3119-884d-43f4a26725db",
                                "text": "Ponownie została poruszona sprawa przyłączenia gospodarstw do sieci kanalizacyjnej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6eeff18b-d36d-47e0-b59c-3b64cf40d2b4",
                        "source_entry_id": "c7ae893d-9801-32ca-a811-a992080bfd8c",
                        "source_sense_id": "a5665912-622c-3119-884d-43f4a26725db",
                        "target_lang_word": "канализационный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "канализационный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30d06eca-40e1-393a-a1d9-442b9ac48429",
                                        "entry_id": "a07e9403-74f0-3e0b-858d-537e0a955bda",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным канализация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17b26b1-73f4-458e-925f-671bc852f52c",
                                                "sense_id": "30d06eca-40e1-393a-a1d9-442b9ac48429",
                                                "text": "Здание пропитано зловонием, ибо канализационные трубы разбиты."
                                            },
                                            {
                                                "example_id": "dba1cec4-2c4c-4927-bded-f30c3389417d",
                                                "sense_id": "30d06eca-40e1-393a-a1d9-442b9ac48429",
                                                "text": "Вода, сбрасываемая канализационными станциями, сплошь и рядом чище, чем вода в реке, куда она сбрасывается."
                                            },
                                            {
                                                "example_id": "6d898c71-34a4-41cb-8900-3da475d14bf0",
                                                "sense_id": "30d06eca-40e1-393a-a1d9-442b9ac48429",
                                                "text": "Дюкеры, которые качают канализационные стоки с правого берега на левый и лежат на дне Волги, выработали срок своей службы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
