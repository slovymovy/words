                "senses": [
                    {
                        "sense_id": "cbe33054-955d-3776-86f9-86a96fca52d4",
                        "entry_id": "23f9b27a-7d03-3030-9104-3986a6a7c69d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным переплёт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f90eb5f-ade4-4aa5-93a4-1a270cc3a055",
                                "sense_id": "cbe33054-955d-3776-86f9-86a96fca52d4",
                                "text": "Потом ящик переплётный надо было заказать для укладки завещания."
                            }
                        ]
                    },
                    {
                        "sense_id": "18b4cab0-c813-34db-95e3-1434496803e0",
                        "entry_id": "23f9b27a-7d03-3030-9104-3986a6a7c69d",
                        "glosses": [
                            "связанный с переплетением книг, занимающийся изготовлением переплётов книг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86869a14-7538-4164-8939-6d141a189ccb",
                                "sense_id": "18b4cab0-c813-34db-95e3-1434496803e0",
                                "text": "Переплётный подмастерье Андрей Иванович Колосов, в туфлях и без сюртука, сидел за столом и быстро шерфовал куски красного сафьяна."
                            }
                        ]
                    }
