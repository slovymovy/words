                ],
                "senses": [
                    {
                        "sense_id": "c86a837a-4d83-30b3-ab61-46ab03666e1b",
                        "entry_id": "e926e369-4277-3cc3-9c35-7c1cf7894d47",
                        "glosses": [
                            "Identité de genre non-binaire en dehors des concepts de masculinité et de féminité, employant des métaphores souvent liées aux plantes, aux animaux, à l’espace, aux concepts, etc."
                        ],
                        "tags": [
                            "Genres humains et identités de genre"
                        ],
                        "examples": [
                            {
                                "example_id": "21868767-13a3-4450-9a29-ff21a95ecf6d",
                                "sense_id": "c86a837a-4d83-30b3-ab61-46ab03666e1b",
                                "text": "Si les personnes xénogenres existent depuis toujours, l’appellation ne date que d’il y a environ vingt ans, et émerge donc grâce aux développements de ces deux avancées."
                            },
                            {
                                "example_id": "a2b39266-de4b-47ad-bd6b-704209371fe5",
                                "sense_id": "c86a837a-4d83-30b3-ab61-46ab03666e1b",
                                "text": "Les personnes qui s’identifient comme xénogenre sont mieux décrites par leur relation avec d’autres êtres ou concepts – des choses qui n’ont généralement rien à voir avec le genre."
                            },
                            {
                                "example_id": "33204ccf-8d5f-4a66-9e41-174d8d31eafd",
                                "sense_id": "c86a837a-4d83-30b3-ab61-46ab03666e1b",
                                "text": "Certaines personnes parviennent à créer un compromis, entre leur ressenti intime et les injonctions sociales, suffisament sastifaisant pour elles, à travers la catégorie « xénogenre »."
                            },
                            {
                                "example_id": "1b956269-4703-4f4d-94de-64b20f29f041",
                                "sense_id": "c86a837a-4d83-30b3-ab61-46ab03666e1b",
                                "text": "Il est au sens propre un personnage-support de ce xénogenre qu’est le narrat"
                            }
                        ]
                    }
                ],
