                ],
                "senses": [
                    {
                        "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                        "entry_id": "0242817f-2656-3eae-b785-69e2d921cb41",
                        "glosses": [
                            "persönliche Gabe oder Fähigkeit, Erfindungen machen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a9759f-250b-4570-b2ca-885a5e1974fc",
                                "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                                "text": "„Dann kann zum Beispiel Kreativität zu Kunst werden, Lerneifer zur Wissenschaft führen oder Erfindergeist zu einem erfolgreichen Start-up.“"
                            },
                            {
                                "example_id": "1072b0c9-147e-4cb2-ad14-a138ce90118f",
                                "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                                "text": "„Es werden Menschen gebraucht, die kreativ sind, Erfindergeist mitbringen, einzigartig sind und die wissen, wo ihre individuellen Stärken liegen.“"
                            },
                            {
                                "example_id": "1a358fe7-1a0a-48f5-9ec1-e84ca587e2ba",
                                "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                                "text": "„Nichteinmalder Angriff während der Jagd oder die Kopfverletzung, die sich Cally dabei zugezogen hat, können ihrem Erfindergeist einen Dämpfer verpassen.“"
                            },
                            {
                                "example_id": "52d75f3b-1869-4be1-9315-4426204e7fb3",
                                "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                                "text": "„In seinen Musikvideos setzt er seinen künstlerischen Schwerpunkt auf die 5 Visualisierung von Traum und Fantasie und lässt seine Kreativität und seinen Erfindergeist mit einfließen.“"
                            },
                            {
                                "example_id": "da4ef3bd-5d32-4b1a-8381-8371129bb28d",
                                "sense_id": "ccd91a8b-2a52-3b6a-8901-830bdbd7eee4",
                                "text": "„Theater und Musik machen Stuttgart zu einem Kultur-Hotspot, und für Erfindergeist ist die Metropole nicht nur wegen seiner Autoindustrie bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
