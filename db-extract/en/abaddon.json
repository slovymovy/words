                        "sense_id": "5e49e05f-8ad8-3f3c-859f-32029798588a",
                        "entry_id": "cb64bfe6-188c-3ada-82a2-f061b8f61dc5",
                        "glosses": [
                            "Hell; the bottomless pit; a place of destruction."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "ee74f05b-a228-42f1-8946-18ba8b060bff",
                                "sense_id": "5e49e05f-8ad8-3f3c-859f-32029798588a",
                                "text": "In all her gates, Abaddon rues Thy bold attempt."
                            }
                        ]
                    }
                ],
