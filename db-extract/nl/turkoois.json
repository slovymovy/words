                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5968ab6-aee6-3ab7-b3da-5c878c1e6f80",
                                        "entry_id": "1d4b12ab-df62-3f8a-916a-bb8b3369f9f9",
                                        "glosses": [
                                            "A sky-blue, greenish-blue, or greenish-gray semi-precious gemstone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee53d99-4227-41ca-bff7-bb143d661b87",
                                                "sense_id": "a5968ab6-aee6-3ab7-b3da-5c878c1e6f80",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5ade13-b7a3-35d8-9d10-ed011ff9ed65",
                                        "entry_id": "1d4b12ab-df62-3f8a-916a-bb8b3369f9f9",
                                        "glosses": [
                                            "A pale greenish-blue colour, like that of the gemstone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b5253a-106e-4b93-a53e-276f7ea9de2a",
                                                "sense_id": "eb5ade13-b7a3-35d8-9d10-ed011ff9ed65",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
