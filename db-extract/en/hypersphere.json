                    {
                        "sense_id": "b9e6725c-90cd-3a60-a3bf-fc3a5b8e026c",
                        "entry_id": "27ddb837-dfdc-301d-a946-e3840a59775a",
                        "glosses": [
                            "The set of all points in a given hyperspace that are at a given distance from a given point; a generalization of a sphere in four or more dimensions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef39bb9-e35e-4460-b640-c0059b9865c8",
                                "sense_id": "b9e6725c-90cd-3a60-a3bf-fc3a5b8e026c",
                                "text": "The timing and location of these battles have not been established. “Sphere” in this context is a hypersphere made up of complexes of two and three-D surfaces, or membranes, shortened in this translation to “branes,” extending into higher dimensions that combine vectors of transit, but also scalar tactical probabilities—a difficult concept to grasp, but essential to understanding Forerunner warfare."
                            },
                            {
                                "example_id": "f7d342de-8c97-4999-b169-67a8536b1017",
                                "sense_id": "b9e6725c-90cd-3a60-a3bf-fc3a5b8e026c",
                                "text": "To prove that the hypersphere is a manifold we wish to divide it into polyhedral solids."
                            }
                        ]
                    },
                    {
                        "sense_id": "66be038d-fa6e-391e-89ef-0038839f23de",
                        "entry_id": "27ddb837-dfdc-301d-a946-e3840a59775a",
                        "glosses": [
                            "A zorb; the act of zorbing, entering a zorbing ball, strapping into a harness, and rolling down a hill."
                        ],
