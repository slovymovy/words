                    {
                        "translation_id": "f56fe897-c6d2-4881-a922-06629cfb939a",
                        "source_entry_id": "e8c1f9c5-a0b9-32cb-95f0-12e0575606f2",
                        "source_sense_id": "fb668d06-b6b1-3478-9f40-54464c6fbd1d",
                        "target_lang_word": "Lump",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lump",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93429d9b-f263-3f68-ba52-c11f70a63625",
                                        "entry_id": "a8df5a61-86a0-3c01-924c-026c3f9748a9",
                                        "glosses": [
                                            "gemeiner Mensch, Mensch mit schlechtem Charakter"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a0af85-4b6b-4e6d-80d0-5a0e045891bb",
                                                "sense_id": "93429d9b-f263-3f68-ba52-c11f70a63625",
                                                "text": "Du bist ein elender Lump!"
                                            },
                                            {
                                                "example_id": "1de0fa52-df58-4a6b-86f3-795646679792",
                                                "sense_id": "93429d9b-f263-3f68-ba52-c11f70a63625",
                                                "text": "„Er wollte anständig sein, aber da sind Schufte und Strolche und Lumpen, darum will Franz Biberkopf nichts mehr sehen und hören von der Welt, und wenn er Penner wird, er versauft den letzten Pfennig von seinem Geld.“"
                                            },
                                            {
                                                "example_id": "cfc27e0a-2a28-4803-9f6e-a35e9bdccf52",
                                                "sense_id": "93429d9b-f263-3f68-ba52-c11f70a63625",
                                                "text": "„Wenn ich mit ihr verfahren wäre wie mit Nanetta und Martina, hätte sie sich, als ich sie verließ, nicht in einem so überreizten Zustand befunden, der wohl der Hauptgrund dafür gewesen war, daß sie dem Werben dieses Lumpen nachgegeben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "baefdec3-a641-3174-baff-83e40f06f592",
                                        "entry_id": "a8df5a61-86a0-3c01-924c-026c3f9748a9",
                                        "glosses": [
                                            "gemeiner Mensch, Mensch mit schlechtem Charakter",
                                            "zu mutwilligen Streichen aufgelegter Mensch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df638b49-a384-43a8-b21f-de46a82617b7",
                                                "sense_id": "baefdec3-a641-3174-baff-83e40f06f592",
                                                "text": "Wo warst du nur, du kleiner Lump?"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
