    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "edc646b3-1eac-3491-9aa6-4a118ed81980",
                "word": "flannelled",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e6d974dd-42ed-3ca7-927d-45304da163ca",
                        "entry_id": "edc646b3-1eac-3491-9aa6-4a118ed81980",
                        "glosses": [
                            "Wearing clothes made of flannel; especially wearing cricket whites."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a39a6e9-e8ca-4159-901e-1eaff019bb08",
                                "sense_id": "e6d974dd-42ed-3ca7-927d-45304da163ca",
                                "text": "A decided improvement is, however, to substitute the flannelled mackintosh, made by Messrs Walters and Co., for the blanket."
                            },
                            {
                                "example_id": "de253aa4-6acb-4000-94f5-76e9036db8a3",
                                "sense_id": "e6d974dd-42ed-3ca7-927d-45304da163ca",
                                "text": "His impressions of headmasters were for the most part taken against a background of white-flannelled boys in playing-fields or grey-flannelled boys in walled court-yards."
                            },
                            {
                                "example_id": "7e6d1dde-bf72-4c3a-a2e3-26207278dbc2",
                                "sense_id": "e6d974dd-42ed-3ca7-927d-45304da163ca",
                                "text": "There was an oak-framed \"Light of the World\" over the bed, supplemented on the other walls with progressive personal records — eleven podgy, flannelled little boys in quartered chocolate-and-gold caps, guarded and patronized by a flannelled and whiskered master […]"
                            },
                            {
                                "example_id": "1cfef5d4-af34-4337-a201-e0925ef4983a",
                                "sense_id": "e6d974dd-42ed-3ca7-927d-45304da163ca",
                                "text": "Well, he wasn't bad-looking, he had a kind of unblinking concentration that amused her, and he was in a different class from those flannelled undergraduates, all books and bats and bicycles, who jostled for her attention: at least Hector Ramsay did something; sometimes she could even smell the engine-oil on him when he came straight from flying."
                            }
                        ]
                    }
                ],
