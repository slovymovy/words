                                        "glosses": [
                                            "Rule by intellect; a government which weds power with intelligence."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9753ed40-0b7e-4b36-8ebe-fa4f1cdceec3",
                                                "sense_id": "6c72f2b0-65a7-3707-9a2c-e8a4917e9055",
                                                "text": "Similar to Plato’s “government of the wise,” a noocracy would be, in the words of “biosphere” popularizer Vladimir Vernadsky, “a social and political system based on the priority of the human mind.”"
                                            }
