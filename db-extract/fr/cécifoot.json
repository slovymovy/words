                "senses": [
                    {
                        "sense_id": "c115ebd1-1499-325a-bd0b-faa7e6c716cd",
                        "entry_id": "580516e6-55c4-390c-924d-04146741fbfc",
                        "glosses": [
                            "Handisport pratiqué par des malvoyants opposant deux équipes composées chacune de quatre malvoyants et d’un gardien de but voyant."
                        ],
                        "tags": [
                            "Handisport"
                        ],
                        "examples": [
                            {
                                "example_id": "c6683e7c-2ebc-4197-a050-747341f65481",
                                "sense_id": "c115ebd1-1499-325a-bd0b-faa7e6c716cd",
                                "text": "L’équipe de France de cécifoot a subi la loi du Brésil 2 à 0 en finale."
                            },
                            {
                                "example_id": "8c7a2642-6c01-4e32-b3fd-5a89fc7a57db",
                                "sense_id": "c115ebd1-1499-325a-bd0b-faa7e6c716cd",
                                "text": "Outre des disciplines comme l’athlétisme, l’équitation, la natation, le judo, l’aviron, le ski, le tir à l’arc, l’escrime, citons parmi le large éventail des activités sportives adaptées le cécifoot, le foot-fauteuil, le rugby à XIII en fauteuil, le goal-ball, …"
                            },
                            {
                                "example_id": "10f8024b-fbf4-4735-b2f9-5cbc82294b27",
                                "sense_id": "c115ebd1-1499-325a-bd0b-faa7e6c716cd",
                                "text": "À commencer par « Yvan Wouandji Kepmegni, médaillé paralympique et champion d’Europe avec l’équipe de France de cécifoot », annonce Évelyne Ciriegi, présidente du comité régional olympique et sportif d’Île-de-France."
                            }
                        ]
                    }
