    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbee33af-9283-371c-8520-9e89b525d714",
                    "sense_definition": "osoba biorąca udział w walkach lub bitwach, odznaczająca się męstwem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "człowiek walczący",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzielny <w>wojownik</w> walczył z mieczem w dłoni do samego końca bitwy.",
                            "target_lang_translations": {
                                "ru": "Храбрый <w>воин</w> сражался с мечом в руке до самого конца битвы."
                            }
                        },
                        {
                            "text": "<w>Wojownicy</w> złożyli broń, którą następnie policja na wszelki wypadek zniszczyła.",
                            "target_lang_translations": {
                                "ru": "<w>Бойцы</w> сложили оружие, которое полиция затем уничтожила на всякий случай."
                            }
                        }
                    ],
                    "synonyms": [
                        "woj",
                        "żołnierz",
                        "bojownik"
                    ],
                    "antonyms": [
                        "pacyfista"
                    ],
                    "common_phrases": [
                        "dzielny wojownik",
                        "nieustraszony wojownik",
                        "dusza wojownika"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, участвующий в сражениях или битвах, отличающийся мужеством"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воин",
                                "target_lang_sense_clarification": "человек, сражающийся в битвах; боец"
                            },
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "человек, проявляющий отвагу и стойкость в борьбе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6fdc893-e45a-3100-a26a-16e4ef943cd3",
                    "sense_definition": "członek plemienia lub dawnej społeczności zajmujący się walką i obroną wspólnoty",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "człowiek walczący",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody człowiek musiał przejść próbę odwagi, aby starszyzna uznała go za pełnoprawnego <w>wojownika</w>.",
                            "target_lang_translations": {
                                "ru": "Молодой человек должен был пройти испытание мужества, чтобы старейшины признали его полноправным <w>воином</w>."
                            }
                        },
                        {
                            "text": "<w>Wojownicy</w> z tego plemienia nosili tradycyjne barwy wojenne podczas ważnych uroczystości.",
                            "target_lang_translations": {
                                "ru": "<w>Воины</w> этого племени наносили традиционную боевую раскраску во время важных церемоний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plemienny wojownik",
                        "wojownicy z plemienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член племени или древней общины, занимающийся сражениями и защитой своего сообщества"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воин",
                                "target_lang_sense_clarification": "боец древнего племени или общины"
                            },
                            {
                                "target_lang_word": "воитель",
                                "target_lang_sense_clarification": "член племени, профессиональный боец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1161e8c8-268f-3818-b011-e0d3455679f9",
                    "sense_definition": "drapieżny ptak z rodziny jastrzębiowatych",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wojowniki</w> wspaniałe polują często parami na mniejsze ssaki leśne.",
                            "target_lang_translations": {
                                "ru": "Венценосные <w>орлы</w> часто охотятся парами на мелких лесных млекопитающих."
                            }
                        },
                        {
                            "text": "W rezerwacie ornitolodzy zaobserwowali rzadki okaz młodego <w>wojownika</w>.",
                            "target_lang_translations": {
                                "ru": "В заповеднике орнитологи наблюдали редкую особь молодого <w>орла</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wojownik wspaniały"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хищная птица семейства ястребиных; хохлатый орёл или боевой орёл"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орёл",
                                "target_lang_sense_clarification": "хищная птица семейства ястребиных, в частности хохлатый орёл (Spizaetus) или боевой орёл (Polemaetus)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}