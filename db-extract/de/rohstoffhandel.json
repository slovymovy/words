                        ],
                        "form": "dem Rohstoffhandel"
                    },
                    {
                        "form_id": "46d532c5-4ea6-46cd-b657-c8159df90eec",
                        "entry_id": "ecaa32a6-6d88-3971-becb-f66b2e5fbbca",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rohstoffhandel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                        "entry_id": "ecaa32a6-6d88-3971-becb-f66b2e5fbbca",
                        "glosses": [
                            "Kauf und Verkauf von Rohstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea57dde-a0b7-49c9-a4e5-c23d2b0a2704",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "Der Rohstoffhandel wirft immer noch reichlich Gewinne ab."
                            },
                            {
                                "example_id": "a07975bf-c435-4785-ba80-b00c2f371949",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Der Rohstoffhandel galt während Jahrzehnten als verschwiegenes Geschäft.“"
                            },
                            {
                                "example_id": "0bb48f3b-682e-41e6-b8ea-b30042d8a0ea",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Die Schweiz ist dafür bekannt, ein wichtiges Finanzzentrum zu sein. Dabei spielt der Rohstoffhandel für die Schweiz sogar noch eine größere Rolle.“"
                            },
                            {
                                "example_id": "0209e5ce-417c-4978-8694-1b75a34be41a",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Die Wirtschaft in der Schweiz wächst wieder. Die Ökonomen der Konjunkturforschungsstelle (KOF) der ETH Zürich korrigieren das vorausgesagte Wachstum für dieses Jahr nach oben: von 1,0 auf 1,6 Prozent. Die Besserung ist auf den Rohstoffhandel zurückzuführen. Die Schweiz ist einer der wichtigsten Handelsplätze für Rohstoffe aus aller Welt.“"
                            },
                            {
                                "example_id": "e01117d8-0170-4cc3-9026-9271a9d11ee9",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Lugano in der Schweiz ist einer der Hotspots für die Geschäfte russischer Oligarchen in Europa. Hier haben mehrere Firmen und Gesellschaften von zwei russischen, Putin-treuen Multimilliardären ihren Sitz: Viktor Rashnikov und Alexey Mordaschov verdienen ihr Geld vor allem im Stahl- und Rohstoffhandel.“"
                            },
                            {
                                "example_id": "9bad2dbd-7a7a-4940-91aa-de918ac63956",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Zwar haben sich die Eidgenossen weitgehend den EU-Sanktionen gegen russische Firmen angeschlossen. Doch gerade der Rohstoffhandel bleibt davon unberührt. Dabei gehen 80 Prozent des weltweiten russischen Rohstoffhandels über die Schweiz.“"
                            },
                            {
                                "example_id": "1fa69262-1a61-4a7e-bc47-b84c9d144f81",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„In den folgenden Jahren erholte sich die russische Volkswirtschaft durch den ansteigenden Rohstoffhandel.“"
                            },
                            {
                                "example_id": "eb27b777-602f-4dcf-a885-7043012aa073",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Den Rohstoffhandel und bestimmte Derivategeschäfte gibt die Bank auf - zum Beispiel mit den als toxisch bezeichneten Credit Default Swaps (CDS).“"
                            },
                            {
                                "example_id": "0f61cde7-7a94-4ebf-9ed0-88f9fa26bc06",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Die Glencore plc ist die weltweit grösste im Rohstoffhandel und Bergwerksbetrieb tätige Unternehmensgruppe.“"
                            },
                            {
                                "example_id": "9e667491-0d2b-472a-935f-c8bdbd6a5d41",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Im Rohstoffhandel, speziell an den Börsen für Metalle, wird kein reines Lithium gehandelt, das chemisch zu instabil wäre. Gehandelt werden stattdessen stabile Lithiumverbindungen, i. d. R. mit Lithiumsalzen bzw. Lithium-basierenden Kristallhaufwerken, überwiegend Lithiumkarbonat oder Lithiumhydroxidmonohydrat.“"
                            },
                            {
                                "example_id": "a4f1da44-1cd0-4562-aaec-271aa57a5d92",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Die Herkunft von einzelnen Gold- und Silberstücken sind meistens nicht genau nachvollziehbar, da der Rohstoffhandel über unübersichtliche Lieferketten zustande kommt.“"
                            },
                            {
                                "example_id": "131991b3-8407-4bdd-8ecf-f89850a90cf0",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Manche Staaten nehmen viel Geld mit dem Rohstoffverkauf ein, vor allem die Öl-exportierenden Länder, für andere kann Rohstoffhandel jedoch ein besonders schlechtes Geschäft sein.“"
                            },
                            {
                                "example_id": "3437286b-fb0b-4603-90ea-0782c745121f",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„60 verschiedene Rohstoffe stecken in einem Mobiltelefon, noch mehr in einem Auto. Viele Rohstoffe stammen aus Ländern, in denen mit dem Rohstoffhandel Kriege und Konflikte finanziert oder illegale bewaffnete Gruppierungen unterstützt werden.“"
                            },
                            {
                                "example_id": "7dd57dbd-16ac-4a3d-9cee-86782b20af56",
                                "sense_id": "e3f8f124-a791-3770-940a-91ce288f5a72",
                                "text": "„Es gibt kein Verbot, das Indien den Rohstoffhandel mit russischem Öl untersagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
