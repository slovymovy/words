                ],
                "senses": [
                    {
                        "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                        "entry_id": "b86eee4c-1043-30ef-9a34-46be5cf83145",
                        "glosses": [
                            "das Einschlagen eines Blitzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "885bdda5-fcf1-4ae2-b2ac-7d364e6d4b76",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Durch einen Blitzeinschlag während eines Jugend-Fußballspiels in Rheinland-Pfalz sind 33 Menschen teils schwer verletzt worden, darunter 29 Kinder.“"
                            },
                            {
                                "example_id": "376f82c0-e448-4a8c-9349-da3533a8e1a9",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Schon im vergangenen Jahr hatte das Wetter üble Folgen - damals wurden bei Blitzeinschlägen 33 Menschen verletzt.“"
                            },
                            {
                                "example_id": "60ce3c21-f4bf-4841-a23d-ba6076ea3436",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Ein solches Ereignis ist sehr selten, selbst für Vielflieger ist die Wahrscheinlichkeit für einen miterlebten Blitzschlag äußerst gering.“"
                            },
                            {
                                "example_id": "3400f11c-008c-46c4-a162-bf30b8579d94",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Nach einem Blitzeinschlag stand am Montag ein Bauernhof im Berchtesgadener Land in Flammen.“"
                            },
                            {
                                "example_id": "9eb84895-3acb-4b75-a8d3-c1893457b60d",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Schuld war ein Blitzeinschlag am vorvergangenen Sonntag - der allerdings nicht nur die Elektronik der Glocken lahmgelegt hat, sondern auch gleich mehrere andere elektrische Anlagen in den heiligen Hallen - trotz Blitzableiters und einem Überspannungsschutz.“"
                            },
                            {
                                "example_id": "7f0a9552-eaa0-4baa-9d89-040809f9ecd9",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„„Das Problem sind die Überspannungen, die bei Blitzeinschlägen auftreten“, weiß VDE-Experte Thomas Raphael.“"
                            },
                            {
                                "example_id": "f59aec6a-6d1a-4d14-9789-44affed752b0",
                                "sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                                "text": "„Die heute verwendete Elektrik und Elektronik, gleich ob im Industrie-, Versorgungs- oder Heimbereich, ob drahtgebunden oder drahtlos sind, bedingt durch den Einsatz hochwertiger und empfindlicher Bauteile, extrem gefährdet durch Blitzeinschläge und den daraus resultierenden Überspannungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36f69d2f-0f23-41cf-8d2f-96f4f9bc1318",
                        "source_entry_id": "b86eee4c-1043-30ef-9a34-46be5cf83145",
                        "source_sense_id": "d4edb3d1-15f8-3454-b616-b7a0c20820d0",
                        "source_sense_description": "das Einschlagen eines Blitzes",
                        "target_lang_word": "foudroiement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foudroiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18da9342-1bb1-3dd9-bdb8-c33e94904c6f",
                                        "entry_id": "dd832aaa-8bed-362a-b75d-c8f61416830f",
                                        "glosses": [
                                            "Action de foudroyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e7bc32-e949-4bbc-9c12-3731101a0ad5",
                                                "sense_id": "18da9342-1bb1-3dd9-bdb8-c33e94904c6f",
                                                "text": "Il a fallu, soit l’éclatant désastre de Marius et son allocution au Cimbre chargé de le tuer, soit l’auguste commandement d’une mère au lion de Florence, pour faire connaître historiquement quelques-uns de ces foudroiements de la pensée."
                                            },
                                            {
                                                "example_id": "016d8e49-d83f-4b2f-a9de-bdca0a67f2d5",
                                                "sense_id": "18da9342-1bb1-3dd9-bdb8-c33e94904c6f",
                                                "text": "Depuis une quinzaine dʼannées, des recherches sur la physiopathologie du foudroiement ont complété les publications des cas cliniques, ouvrant la voie à la kéraunopathologie et aux recommandations pour la prise en charge des foudroyés."
                                            },
                                            {
                                                "example_id": "0d5191e1-c0db-4a19-92ef-c92786657cbe",
                                                "sense_id": "18da9342-1bb1-3dd9-bdb8-c33e94904c6f",
                                                "text": "Ils sont aussi chargés de faire les sacrifices propitiatoires ayant un rapport avec les accidents liés à lʼeau : foudroiements, noyades etc."
                                            },
                                            {
                                                "example_id": "cc878efc-0709-46de-9130-87bfb8a9f1ea",
                                                "sense_id": "18da9342-1bb1-3dd9-bdb8-c33e94904c6f",
                                                "text": "Cette victime honnête du tardif amour, de la surprise voluptueuse, ne se résigna pas tout de suite au foudroiement et à la béatitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
