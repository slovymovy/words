                        "examples": [
                            {
                                "example_id": "8251cf38-0bc9-4487-bbda-f34a63c8d1d7",
                                "sense_id": "8d368dd3-9de4-3aaa-88ae-0843c01b4083",
                                "text": "Ze had Kron nooit serieus genomen als hij zijn pijlen op de agressiviteit van het kapitalisme richtte; ze had hem niet geloofd als hij haar van Gombrowski's kwaadaardigheid probeerde te overtuigen."
                            },
                            {
                                "example_id": "72981994-903b-4764-8766-bbfd333d43d4",
                                "sense_id": "8d368dd3-9de4-3aaa-88ae-0843c01b4083",
                                "text": "Bovendien verloor ik op school iets van de agressiviteit die er met de jaren in me was gegroeid."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe3f4cac-2be3-3d38-a77f-3fc8bf1ab134",
                        "entry_id": "5d687ca1-47ce-3cc2-94a1-a760c9215ffc",
