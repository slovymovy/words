                ],
                "senses": [
                    {
                        "sense_id": "8a69bcb6-52db-329b-9fb4-5078a75cad05",
                        "entry_id": "418c94e0-b037-3c91-a448-e4ff94b6e3ec",
                        "glosses": [
                            "Lèvre pendante de certains animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088f2380-f914-43e2-8ff3-9fbf9643025a",
                                "sense_id": "8a69bcb6-52db-329b-9fb4-5078a75cad05",
                                "text": "Parfois, certains gémissaient, en proie à des rêves inquiétants, et les chevaux ronflaient ou soufflaient en retroussant leurs babines."
                            },
                            {
                                "example_id": "36991dbb-78ac-41f3-9987-3231845dd0c2",
                                "sense_id": "8a69bcb6-52db-329b-9fb4-5078a75cad05",
                                "text": "Un singe qui remue les babines."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3274f2e-c91a-3381-8288-29a33e278a50",
                        "entry_id": "418c94e0-b037-3c91-a448-e4ff94b6e3ec",
                        "glosses": [
                            "Lèvres humaines."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "0e25618b-c5af-4a20-8c4d-42cabfe5f3c9",
                                "sense_id": "f3274f2e-c91a-3381-8288-29a33e278a50",
                                "text": "Il laisse parler les autres et écoute. Puis finit par dire « Moi aussi, je pense comme eux » avec la voix chevrotante et les babines molles."
                            },
                            {
                                "example_id": "e92ba436-c019-4deb-a65c-64adeda3f4eb",
                                "sense_id": "f3274f2e-c91a-3381-8288-29a33e278a50",
                                "text": "Les babines se faisaient aller, mais les bottines ne suivaient pas."
                            },
                            {
                                "example_id": "cab1f55a-21ec-4545-aaed-a37ee2b7ab7c",
                                "sense_id": "f3274f2e-c91a-3381-8288-29a33e278a50",
                                "text": "Poudre de cacao sur le beurre des tartines\nCoudre de papao sur le bord des babines"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "205242a8-9808-41aa-aa87-b43b959b8578",
