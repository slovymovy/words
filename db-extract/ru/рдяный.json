                ],
                "senses": [
                    {
                        "sense_id": "6c62b9d7-3138-3af1-97db-423591dea681",
                        "entry_id": "12615185-7076-3666-b892-17c80929ed6b",
                        "glosses": [
                            "поэт. красный, алый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40535d84-8ff8-4e02-9173-5bd5cfcbdc2a",
                                "sense_id": "6c62b9d7-3138-3af1-97db-423591dea681",
                                "text": "Покраснел старик, словно мак рдяный, да как крикнет, да топнет."
                            },
                            {
                                "example_id": "5ccf3162-cc52-4ec2-aad3-69548dbcd28d",
                                "sense_id": "6c62b9d7-3138-3af1-97db-423591dea681",
                                "text": "Тронутые ранними утренниками дубы, клёны и липы медленно роняли свои пожелтевшие или рдяные, как кровь, листья."
                            }
                        ]
                    }
                ],
