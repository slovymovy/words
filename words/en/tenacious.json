{
    "word_family": [
        "tenacity",
        "tenaciously",
        "tenaciousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c274cd42-57ad-3d03-8c60-98ef7459946d",
                    "sense_definition": "Unwilling to yield or give up; dogged and persistent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed a <w>tenacious</w> effort to finish the marathon despite her injury.",
                            "target_lang_translations": {
                                "tr": "Sakatlığına rağmen maratonu bitirmek için <w>azimli</w> bir çaba gösterdi."
                            }
                        },
                        {
                            "text": "The defense attorney was known for his <w>tenacious</w> pursuit of the truth.",
                            "target_lang_translations": {
                                "tr": "Savunma avukatı, gerçeğin peşindeki <w>inatçı</w> takibiyle tanınırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "steadfast",
                        "obstinate"
                    ],
                    "antonyms": [
                        "irresolute",
                        "yielding"
                    ],
                    "common_phrases": [
                        "tenacious effort",
                        "tenacious pursuit"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vazgeçmeye veya pes etmeye istekli olmayan; kararlı ve azimli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "inatçı",
                                "target_lang_sense_clarification": "Bir konuda ayak direyen, pes etmeyen kişi."
                            },
                            {
                                "target_lang_word": "azimli",
                                "target_lang_sense_clarification": "Bir hedefe ulaşmak için kararlılıkla çalışan."
                            },
                            {
                                "target_lang_word": "direngen",
                                "target_lang_sense_clarification": "Zorluklara karşı pes etmeyen, dayanıklı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b50dfcb-a0e7-329f-88c1-8f68cb6123f8",
                    "sense_definition": "Clinging to an object or surface; adhesive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet clay was incredibly <w>tenacious</w>, sticking to our boots with every step.",
                            "target_lang_translations": {
                                "tr": "Islak kil inanılmaz derecede <w>yapışkandı</w>, her adımda botlarımıza yapışıyordu."
                            }
                        },
                        {
                            "text": "Some plants have <w>tenacious</w> burrs that cling tightly to animal fur.",
                            "target_lang_translations": {
                                "tr": "Bazı bitkilerin hayvan tüylerine sıkıca tutunan <w>yapışkan</w> dikenleri vardır."
                            }
                        }
                    ],
                    "synonyms": [
                        "sticky",
                        "adhesive"
                    ],
                    "antonyms": [
                        "loose"
                    ],
                    "common_phrases": [
                        "tenacious grip"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir nesneye veya yüzeye yapışan; yapışkan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yapışkan",
                                "target_lang_sense_clarification": "Bir yüzeye tutunma özelliği olan."
                            },
                            {
                                "target_lang_word": "sıkıca tutan",
                                "target_lang_sense_clarification": "Bir yere kuvvetle tutunmuş olan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9b29e1d-86f2-340a-be74-3ac7673301b3",
                    "sense_definition": "Holding together firmly; cohesive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain turned the dirt road into a <w>tenacious</w> paste that trapped the vehicles.",
                            "target_lang_translations": {
                                "tr": "Şiddetli yağmur toprak yolu araçları hapseden <w>yapışkan</w> bir çamura dönüştürdü."
                            }
                        },
                        {
                            "text": "They used a <w>tenacious</w> glue to bond the broken pieces of the vase.",
                            "target_lang_translations": {
                                "tr": "Vazonun kırık parçalarını birleştirmek için <w>yapışkan</w> bir tutkal kullandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "cohesive",
                        "coherent"
                    ],
                    "antonyms": [
                        "friable"
                    ],
                    "common_phrases": [
                        "tenacious paste"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıkıca bir arada duran; yapışkan ve bütünleşik."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yapışkan",
                                "target_lang_sense_clarification": "Bir arada tutan, yapışma özelliği gösteren madde."
                            },
                            {
                                "target_lang_word": "bütünleşik",
                                "target_lang_sense_clarification": "Parçaları birbirine sıkıca bağlı olan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0315c83e-a816-3e52-8e03-62c0c7b8c658",
                    "sense_definition": "Having a good memory; retentive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He possessed a <w>tenacious</w> memory, easily recalling details from decades ago.",
                            "target_lang_translations": {
                                "tr": "Onlarca yıl öncesinin detaylarını kolayca hatırlayabildiği <w>kuvvetli bir hafızaya</w> sahipti."
                            }
                        },
                        {
                            "text": "Her <w>tenacious</w> mind allowed her to learn complex languages in a short time.",
                            "target_lang_translations": {
                                "tr": "<w>Kuvvetli hafızası</w> sayesinde karmaşık dilleri kısa sürede öğrenebildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "memorious"
                    ],
                    "antonyms": [
                        "forgetful"
                    ],
                    "common_phrases": [
                        "tenacious memory"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güçlü bir hafızaya sahip olan; unutmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuvvetli hafızalı",
                                "target_lang_sense_clarification": "Detayları kolayca hatırlayabilen."
                            },
                            {
                                "target_lang_word": "unutmayan",
                                "target_lang_sense_clarification": "Bilgiyi zihninde tutabilen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}