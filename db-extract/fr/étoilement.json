                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ddfec4b-4d35-491d-a68e-f66f98d2e340",
                                "sense_id": "f4f33686-9bef-3ba2-8124-385f00270129",
                                "text": "Entrant par les hautes fenêtres du dortoir, venant blanchir imperceptiblement l'étoilement de ses quatre veilleuses accroupies sur leurs lits d’huile grasse."
                            }
                        ]
                    },
