                        "target_lang_word": "半天",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "半天",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8d0065-a35c-37d1-9641-ae5d42d92707",
                                        "entry_id": "2c597520-fb31-375c-820e-2eb651560ac9",
                                        "glosses": [
                                            "半邊天。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52bfa318-8b89-4c34-bdcd-c4228027be3c",
                                                "sense_id": "2e8d0065-a35c-37d1-9641-ae5d42d92707",
                                                "text": "《宋書‧天文志二》：“﹝晉穆帝升平二年﹞十二月，枉矢自東南流於西北，其長半天。”"
                                            },
                                            {
                                                "example_id": "697e9c67-4d08-471d-ad90-9358e96ae7e9",
                                                "sense_id": "2e8d0065-a35c-37d1-9641-ae5d42d92707",
                                                "text": "清·俞樾《茶香室三鈔‧彭瑩玉》：“一夕夜雪，見寺東約二十里，紅燄半天。”"
                                            },
                                            {
                                                "example_id": "68bb5425-40e0-437d-87f1-8502e1da5496",
                                                "sense_id": "2e8d0065-a35c-37d1-9641-ae5d42d92707",
                                                "text": "魯迅《故事新編‧出關》：“窗外起了一陣風，括上黃塵來，遮得半天暗。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ce8590-7c4c-3f9d-bc48-0f519ff2b4da",
                                        "entry_id": "2c597520-fb31-375c-820e-2eb651560ac9",
                                        "glosses": [
                                            "半空中。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d389865d-7263-47a0-9f8a-0e2084beb858",
                                                "sense_id": "b4ce8590-7c4c-3f9d-bc48-0f519ff2b4da",
                                                "text": "《南史‧梁武帝紀下》：“及崔慧景之逼，長沙宣武王入援，至城，夢乘馬飛半天而墜。”"
                                            },
                                            {
                                                "example_id": "c56c966c-e2cd-4e5f-ab02-1082ef2b00de",
                                                "sense_id": "b4ce8590-7c4c-3f9d-bc48-0f519ff2b4da",
                                                "text": "宋·楊萬里《游蒲澗呈周帥蔡漕張舶》詩：“人在半天泉在井，不敢下瞰惟聞聲。”"
                                            },
                                            {
                                                "example_id": "01353019-9b30-4c11-8d8c-6160f90b8bc7",
                                                "sense_id": "b4ce8590-7c4c-3f9d-bc48-0f519ff2b4da",
                                                "text": "《西游記》第九二回：“此時約有三更時候，半天中月明如晝。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9193cc2e-bde2-3a26-b01c-2bfad1ad02d7",
                                        "entry_id": "2c597520-fb31-375c-820e-2eb651560ac9",
                                        "glosses": [
                                            "白天的一半。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64da08d7-46c3-4e83-b624-d43326e57913",
                                                "sense_id": "9193cc2e-bde2-3a26-b01c-2bfad1ad02d7",
                                                "text": "老舍《駱駝祥子》一：“這派的車夫，也許拉‘整天’，也許拉‘半天’。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908bdcf9-1e58-3fb1-bb9e-770ef93a1859",
                                        "entry_id": "2c597520-fb31-375c-820e-2eb651560ac9",
                                        "glosses": [
                                            "好久，相當長的一段時間。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba1457d-aba1-4876-9c59-a658ba21a2fc",
                                                "sense_id": "908bdcf9-1e58-3fb1-bb9e-770ef93a1859",
                                                "text": "《紅樓夢》第三二回：“黛玉聽了，怔了半天。”"
                                            },
                                            {
                                                "example_id": "6ef160de-c830-4f04-b8e4-7f975d5beddb",
                                                "sense_id": "908bdcf9-1e58-3fb1-bb9e-770ef93a1859",
                                                "text": "丁玲《田家沖》三：“么妹醒半天了，悄悄的蜷在被窩裏不做聲。”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
