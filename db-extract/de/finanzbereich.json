                    {
                        "sense_id": "a4a78641-035a-3607-be59-d76277a2cd58",
                        "entry_id": "ae803501-3352-3ccc-84eb-d5dc34ec3354",
                        "glosses": [
                            "Gesamtheit von allem, was Geld im weitesten Sinne betrifft"
