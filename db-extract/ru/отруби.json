                    },
                    {
                        "translation_id": "e728f718-2f01-46b1-8cfe-dd7e2befee70",
                        "source_entry_id": "18a9a060-41cb-3483-bfa7-2b061d747457",
                        "source_sense_id": "a847d35d-a4a1-30f8-ae3c-ad898db23d59",
                        "target_lang_word": "son",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "son",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6483f6a3-2293-3790-b562-f5c4096f69ae",
                                        "entry_id": "74f9bb7e-f1a2-3377-9747-1026c41c666c",
                                        "glosses": [
                                            "Troisième personne du sujet, objet masculin singulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e6b9c5-bf70-476d-ba5b-1736b5d5cf8b",
                                                "sense_id": "6483f6a3-2293-3790-b562-f5c4096f69ae",
                                                "text": "J’ai lu son livre."
                                            },
                                            {
                                                "example_id": "c897a80c-4052-47a4-a890-2eba006b5594",
                                                "sense_id": "6483f6a3-2293-3790-b562-f5c4096f69ae",
                                                "text": "Son coup droit fait mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc85689d-f100-386e-b80e-615e69d4eb62",
                                        "entry_id": "74f9bb7e-f1a2-3377-9747-1026c41c666c",
                                        "glosses": [
                                            "Indique des rapports d’habitude, de connaissance, etc."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1440d528-a579-4f94-8638-4db492c5f47e",
                                                "sense_id": "dc85689d-f100-386e-b80e-615e69d4eb62",
                                                "text": "Voilà son public."
                                            },
                                            {
                                                "example_id": "368cd0cb-d079-43ea-9373-73e3f80e1a0e",
                                                "sense_id": "dc85689d-f100-386e-b80e-615e69d4eb62",
                                                "text": "Posséder son Homère."
                                            },
                                            {
                                                "example_id": "ed4306a6-036b-4ebc-aa0f-cd7a2108767d",
                                                "sense_id": "dc85689d-f100-386e-b80e-615e69d4eb62",
                                                "text": "Il sait bien son arithmétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1deafb7-e42b-3973-a3fc-a065d7666567",
                                        "entry_id": "74f9bb7e-f1a2-3377-9747-1026c41c666c",
                                        "glosses": [
                                            "Joint aux verbes « sentir, faire » dans le langage familier, il renforce le sens de la phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017fe725-582a-4a15-b61d-4f38e7631d96",
                                                "sense_id": "a1deafb7-e42b-3973-a3fc-a065d7666567",
                                                "text": "Il sent son homme de qualité ; il sent son hypocrite."
                                            },
                                            {
                                                "example_id": "68f60502-3fd4-4d81-81b4-b44e838e23e4",
                                                "sense_id": "a1deafb7-e42b-3973-a3fc-a065d7666567",
                                                "text": "Il fait son malin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f16d631-16ff-3323-95d6-881ee51f6e04",
                                        "entry_id": "74f9bb7e-f1a2-3377-9747-1026c41c666c",
                                        "glosses": [
                                            "Forme supplétive de sa, utilisée quand la chose possédée est au féminin, pour effectuer une liaison obligatoire avec le mot suivant qui commence par une voyelle ou un h muet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e26e4a7-29fb-4efd-8a9a-3d4c31743f29",
                                                "sense_id": "6f16d631-16ff-3323-95d6-881ee51f6e04",
                                                "text": "Une ville, sa ville ; une île, son île."
                                            },
                                            {
                                                "example_id": "508f7586-b723-4330-8d94-34a30e567902",
                                                "sense_id": "6f16d631-16ff-3323-95d6-881ee51f6e04",
                                                "text": "Une maison, sa maison, son immense maison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "son",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                        "entry_id": "5bd4a548-a087-35ba-9f35-a262a310f627",
                                        "glosses": [
                                            "Quelque chose que l’on peut écouter ou entendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cfed47-956d-42c4-ba38-f3ef35005d1e",
                                                "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                                "text": "Tout à coup, comme si le son s’évadait brusquement du tournant de la montagne, on entendit des voix hurlantes, beuglant de tous leurs poumons, aussi faux que possible."
                                            },
                                            {
                                                "example_id": "285bd586-313e-4a7a-90f9-461e02c7004a",
                                                "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                                "text": "Au bord même de notre abri, un 88 dirigeait son tir foudroyant ; tous les combattants connaissent cette pièce autrichienne dont le projectile arrive plus vite que le son."
                                            },
                                            {
                                                "example_id": "ad91fb9c-d489-4d54-a7ea-43b4bf02c43e",
                                                "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                                "text": "Je baissai la vitre et roulai en écoutant les sons étouffés d’une fin de soirée d'été."
                                            },
                                            {
                                                "example_id": "96524cf9-817a-4f3b-ad6b-5343e765e9ae",
                                                "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                                "text": "J’éduquais mon oreille à traduire des multitudes de sons infimes, petits trots de souris et grincements de bois, […]."
                                            },
                                            {
                                                "example_id": "0fa1f894-6e7c-4e4b-baf4-e3bb48f2cbd0",
                                                "sense_id": "70762956-25cb-37ac-847e-06bc7ca67fdd",
                                                "text": "— Cet animal s’oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da40005-5c40-34dd-8609-fe8ece755ace",
                                        "entry_id": "5bd4a548-a087-35ba-9f35-a262a310f627",
                                        "glosses": [
                                            "Bruit harmonieux produit par un instrument de musique, caractérisé par un timbre et représenté par une note."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b33f93-86a4-410a-8fb1-4682082324b4",
                                                "sense_id": "2da40005-5c40-34dd-8609-fe8ece755ace",
                                                "text": "Oh ! les chastes églogues ! Oh ! les idylles chantées par les poètes ! Oh ! les paysanneries enrubannées et naïves qui défilent, conduites par la muse de Mme Deshoulières, au son des flageolets et des tambourins !"
                                            },
                                            {
                                                "example_id": "db572b79-4342-4afa-a06b-7749d021e325",
                                                "sense_id": "2da40005-5c40-34dd-8609-fe8ece755ace",
                                                "text": "Il ne savait aucune des paroles du grand choral de Luther, mais il ouvrait toute grande sa bouche et émettait des sons vastes, graves et partiellement harmonieux…"
                                            },
                                            {
                                                "example_id": "19be8f19-2ea3-417a-b9a2-1470902e740d",
                                                "sense_id": "2da40005-5c40-34dd-8609-fe8ece755ace",
                                                "text": "La texture des sons elle-même ne ressemblait à rien. Elle n'avait pas, comme le violon, les gémissements de la voix humaine, ne bôombait pas à la manière des profonds tambours qui s'apparentent aux cloches ni ne tintait, même dans les aigus, comme les sonnailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3391f73-9239-3511-9a15-9d41e65bb5c0",
                                        "entry_id": "5bd4a548-a087-35ba-9f35-a262a310f627",
                                        "glosses": [
                                            "Phone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92324064-1d7f-4105-96e0-24c267f73482",
                                                "sense_id": "f3391f73-9239-3511-9a15-9d41e65bb5c0",
                                                "text": "Le phonème \\r\\ par exemple correspond aux sons : [r], [ɾ], [ʀ], [ʁ], [ʳ], [ɹ], etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "son",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7ab2041-99f0-3dac-aca0-44849b9b34cb",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "Si l’on écrase entre deux pierres des grains de blé, l’enveloppe corticale de chaque grain est brisée, et les débris, qui portent le nom de son, se mêlent à la farine provenant de la trituration de la partie intérieure ; comme cette dernière est plus fine il suffit d’un tamisage pour la séparer du son. — (Edmond Nivoit, Notions élémentaires sur l’industrie dans le département des Ardennes, E. Jolly, Charleville, 1869, page 107)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0de93db0-b796-346a-999f-d11f9d03020c",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "En raison du perfectionnement des petits moulins du pays, il était devenu possible de faire séparer le son d’avec la farine. Beaucoup commençaient d’user de cette amélioration, et il y en avait même qui remplaçaient le seigle par le froment, qui mangeaient du vrai pain de bourgeois. — (Émile Guillaumin, La vie d’un simple, 1904, page 179)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a58481fb-b4f3-38f1-89f9-046d025c4409",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "« Il a des cheveux couleur de maïs bien mûr et sa figure est criblée comme de miettes de son. » — (Léonce Bourliaguet, Quatre du cours moyen, 1934, réédition Magnard, 1967, page 14)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51d2a3c3-a637-39ad-9cc7-573832de3ffb",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "Nous nous en allions, quand nous apercevons une petite boutique en plein vent, une charmante boutique d’objets à 0,50 franc : glaces de poche, images, bonbons, bagues en or, colliers blancs ou roses, tous perdus dans des tas de son, et on farfouille dedans comme on veut. — (Colette Vivier, La maison des petits bonheurs, 1939, réédition Casterman Poche, page 168)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c31f522-38bb-37ee-8f17-cebd6a682c1f",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "Du fait de la richesse en cellulose (35%), le son est un bon laxatif mécanique, mais il peut irriter l'intestin de certains malades. — (François Couplan, Le Régal végétal, 2015, page 127)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a3ebb56-a1e5-3c92-83d5-fb162142ea5b",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "Le grain des céréales (caryopse) est constitué d’une enveloppe extérieure, le son, d'un albumen et d’un germe. — (Les plantes, 2005, page 106)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22e83928-0ab6-3142-96c2-3ca979c1d2c7",
                                        "entry_id": "72f1a3a0-3846-3a79-af25-477dccab8f70",
                                        "glosses": [
                                            "Déchets de bois produits lorsque l’on scie, sciure."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3055bbe-b0ff-498b-9251-14b9c82e1c4a",
                                                "sense_id": "22e83928-0ab6-3142-96c2-3ca979c1d2c7",
                                                "text": "Le poète reparut dans l’amant, il replaçait sur un piédestal de déesse la poupée dont il avait entrevu le son sous la couverte de peau rose."
                                            }
                                        ]
                                    }
                                ]
