                        "entry_id": "3c3fe3c1-15dc-3682-b856-89b70444498b",
                        "glosses": [
                            "Prozess der planmäßigen Gestaltung mit Vorbereitung, Strukturierung, Planung und Durchführung eines Vorhabens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed0f4e46-7cec-460e-88be-661f3a1c4cfe",
                                "sense_id": "d3a96f64-831e-332e-b09d-b805dfa96450",
                                "text": "Die lokale Organisierung dieses Events übernahm die Landfrauengruppe."
                            }
