                        "form": "es ist benennbar"
                    },
                    {
                        "form_id": "a1298a7e-1bb4-4cc5-bdd5-5588dd113546",
                        "entry_id": "a547d0a7-9211-3a96-9340-bcc865ef3979",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind benennbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                        "entry_id": "a547d0a7-9211-3a96-9340-bcc865ef3979",
                        "glosses": [
                            "so, dass es benannt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f672ea-eca6-47ac-a2cc-205a4fe6617b",
                                "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                                "text": "„Und so nun hat das artistische Fundament und Funktionsgesetz seines Wesens noch etwas Tieferes hinter sich, eine nicht benennbare Wesenheit, die auch seine ganze künstlerisch bestimmte Erscheinung noch trägt und umgreift.“"
                            },
                            {
                                "example_id": "1e8b83ea-e88f-41b6-b9c4-79c29ef85c3a",
                                "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                                "text": "„Sie glauben, es müsse immer alles, was man tut, aussprechbar und benennbar sein …“"
                            },
                            {
                                "example_id": "57693895-759d-4178-b7af-8816f06cb407",
                                "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                                "text": "„Sie wies alle Merkmale auf, durch die sie benennbar und nachweisbar wurde, und war gleichwohl, im wahrsten Sinn des Wortes, ein Hirngespinst.“"
                            },
                            {
                                "example_id": "45c3e22f-8632-4512-8119-048452f55eba",
                                "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                                "text": "„So sehen auch die Veden seinen indischen Bruder Kama als erste der göttlichen Gewalten an, die sich greifbar und benennbar aus der undurchdringlichen Flut des Anfangs hob.“"
                            },
                            {
                                "example_id": "b481aded-a530-497e-8cdf-b5b925fe5296",
                                "sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                                "text": "„Es löst sich ein Schicksal wie Duft aus den Poren der Blumen, du atmest und riechst es dabei, und da glüht es und scheint dir, und Lippe, die redet, und Lippe, die weint, ist dir alles vertraut und benennbar und gar nicht unsäglich …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d701b55c-86e7-4af0-88d0-4931c530fa16",
                        "source_entry_id": "a547d0a7-9211-3a96-9340-bcc865ef3979",
                        "source_sense_id": "8cad37b9-5a7a-3446-aa69-c3a361f428da",
                        "source_sense_description": "so, dass es benannt werden kann",
                        "target_lang_word": "nameable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nameable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                        "entry_id": "dde5aa4b-da27-3bb1-9fd9-e60bd13f5e37",
                                        "glosses": [
                                            "Capable of being distinguished and named; able to be called by a specific name."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40c5d4d-f07d-4b03-9c6d-e7ba869cc960",
                                                "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                                "text": "1635, Alexander Gill, The Sacred Philosophie of Holy Scripture, London: Joyce Norton and Richard Whitaker, Chapter 8, p. 30,\n[God’s] pure being, because it is neither understandable, nor nameable by us, we speake of goodnesse, of power, &c. as of the effluences or prime acts thereof […]"
                                            },
                                            {
                                                "example_id": "80f59342-1944-47af-8e9a-913dd3314ec1",
                                                "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                                "text": "Mr. Hyde […] gave an impression of deformity without any nameable malformation […]"
                                            },
                                            {
                                                "example_id": "9953f58a-eb8f-4d88-9c62-776bb45ab5ea",
                                                "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                                "text": "The vogue for the sleuth-flâneur […] in the first half of the twentieth century has encouraged recent attempts to map the rise of British detective fiction, and its subsequent love affair with the thriller, onto the shifts in national morale precipitated by international conflict. One train of thought, for instance, suggests that the genre provides nameable, explicable corpses to mourn, after the senseless obliterations of the First World War."
                                            },
                                            {
                                                "example_id": "5e707cc2-7201-4998-8749-f3f688de12fb",
                                                "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                                "text": "There's a strange kind of power in games like that; like XCOM, with its nameable soldiers, or The Sims' customizable families."
                                            },
                                            {
                                                "example_id": "c64d4491-88c1-4f2b-ad94-0d25a25cf38d",
                                                "sense_id": "b78ea7f0-d257-3887-a180-867472ee80d7",
                                                "text": "Grits have been part of the story of the South as long as the South has been a nameable region — and they were around long before that, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de03a2f0-3612-38f8-a1d3-c0fa48f3e59e",
                                        "entry_id": "dde5aa4b-da27-3bb1-9fd9-e60bd13f5e37",
                                        "glosses": [
                                            "Worthy of being named or having a name; significant; memorable (especially in negative expressions)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16dbd44a-80bd-41cd-93a8-a3799c409c20",
                                                "sense_id": "de03a2f0-3612-38f8-a1d3-c0fa48f3e59e",
                                                "text": "[…] the culture [of alfalfa] is not very expensive, though the profit is not nameable till the second or third year, when the cuttings are considerable […]"
                                            },
                                            {
                                                "example_id": "0202cd38-2b9d-4008-964a-2be3f39cc6d8",
                                                "sense_id": "de03a2f0-3612-38f8-a1d3-c0fa48f3e59e",
                                                "text": "1810, William Coleman, An Appeal to the People, New York: C.S. Van Winkle, p. 72,\nA mission hatched by Jefferson under the pretence of forming a commercial treaty, though we have neither trade of any nameable amount with Russia, nor any political concerns with her […]"
                                            }
                                        ]
                                    }
                                ]
                            }
