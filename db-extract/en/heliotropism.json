                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ed781299-141c-4cb9-99c9-4f020795a877",
                        "entry_id": "0c615dbb-6ac9-3004-a221-becf6a01f438",
