                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045457cb-db96-4c97-9c3f-6ec09a0be85b",
                                                "sense_id": "423f83c8-d16a-34cb-b326-ffd7e064ade6",
                                                "text": "Jean Stievenart, ouvrier métallurgiste dans la région lilloise, a rencontré un établi maoïste au moment de la formation professionnelle consécutive à son embauche, en 1970 : “On était en stage ensemble à l'école. On voyait qu'il avait des capacités intellectuelles supérieures aux nôtres; […].”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maoïste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40ec74aa-a976-3401-8498-1017b832aed5",
                                        "entry_id": "d22fbd83-28aa-3561-bc43-117fc4b5273d",
                                        "glosses": [
                                            "Partisan de la doctrine de Mao Zedong."
                                        ],
                                        "tags": [
                                            "Maoïsme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd98241-cf05-4a30-a971-bafe4330641b",
                                                "sense_id": "40ec74aa-a976-3401-8498-1017b832aed5",
                                                "text": "N’importe quel gamin pourrait faire ça dans une situation similaire, sans pour autant devenir un maoïste flamboyant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f7990fe-1274-4c03-8975-c6195f48896e",
                        "source_entry_id": "7ba401cd-1707-3482-822f-e8e0ae3eaf89",
                        "source_sense_id": "e35b48c0-962e-3f46-97b3-037cd41a87c1",
