                    {
                        "sense_id": "913c7b9f-8d0e-380b-bf3f-179d081d6cf8",
                        "entry_id": "25de59bb-7bd6-32f6-a8c1-3d2876beaaaf",
                        "glosses": [
                            "Action d’attiédir, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323fa8b1-09ac-4183-85e5-0b7c0faae755",
                                "sense_id": "913c7b9f-8d0e-380b-bf3f-179d081d6cf8",
                                "text": "L’attiédissement de cette eau sera long."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9ca0853-d65d-3465-bf96-5c7bdc4896ac",
                        "entry_id": "25de59bb-7bd6-32f6-a8c1-3d2876beaaaf",
                        "glosses": [
                            "Relâchement, diminution de la ferveur, des sentiments"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0cdbba25-6655-4eb4-bfcf-755a4b36d379",
                                "sense_id": "e9ca0853-d65d-3465-bf96-5c7bdc4896ac",
                                "text": "Son amitié pour moi n’a souffert aucun attiédissement."
                            },
                            {
                                "example_id": "af93ac76-b1f2-4cb2-87e8-1f3676a7b755",
                                "sense_id": "e9ca0853-d65d-3465-bf96-5c7bdc4896ac",
                                "text": "Il avait d’abord fait paraître une grande ferveur ; mais il est tombé depuis peu dans l’attiédissement, dans un grand attiédissement."
                            },
                            {
                                "example_id": "43d6ef2f-99f6-4da2-bc7a-e877b3b60ded",
                                "sense_id": "e9ca0853-d65d-3465-bf96-5c7bdc4896ac",
                                "text": "Lui aussi est une réaction du couple face à l’attiédissement du sentiment amoureux."
                            },
                            {
                                "example_id": "e4816d97-1d63-40cc-a655-b0b04a42aa10",
                                "sense_id": "e9ca0853-d65d-3465-bf96-5c7bdc4896ac",
                                "text": "Chez moi, l’amour se fiche du résultat. L’éloignement ne correspond en rien à une renonciation ou à un attiédissement de ma ferveur."
                            }
                        ]
                    }
                ],
