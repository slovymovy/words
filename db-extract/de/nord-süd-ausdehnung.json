                "senses": [
                    {
                        "sense_id": "4fc9515a-b85f-3f8f-8065-e9a35554a541",
                        "entry_id": "0fb0f93b-ff26-3fe6-bd5b-ee0579c3dcb8",
                        "glosses": [
                            "Länge/Strecke von der nördlichsten bis zur südlichsten Grenze eines Gebiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1360b8c-2d12-44e3-8dcd-7835a051dcbb",
                                "sense_id": "4fc9515a-b85f-3f8f-8065-e9a35554a541",
                                "text": "„Die Nord-Süd-Ausdehnung beträgt rund 8000, die Ost-West-Ausdehnung rund 6000 km; im hohen Norden reicht Nordamerika bis auf 7 Breitenkreise an den Nordpol heran, als südliche Begrenzung gilt gewöhnlich der Isthmus von Tehuantepec in Mexiko.“"
                            },
                            {
                                "example_id": "8b326936-9c12-4bfe-91ba-43bc1e49a0d5",
                                "sense_id": "4fc9515a-b85f-3f8f-8065-e9a35554a541",
                                "text": "„Damit findet man in Chile – aufgrund der riesigen Nord-Süd-Ausdehnung des Landes – sämtliche Klimazonen vor: Im Norden des Landes herrscht Wüstenklima (Atacama), in der Mitte ist es gemäßigt warm mit trockenen Sommern und feuchten Wintern und der Süden ist sehr regenreich und kühl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
