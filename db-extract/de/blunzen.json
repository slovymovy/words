                            "Austrian German",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "fc8abf62-ef61-4e7c-a1bf-d51bf9bd8fb1",
                                "sense_id": "066356ac-809d-3319-920a-4f1ac3296b54",
                                "text": "Da schau an, wie die schiache Blunzen von nebenan wieder in der Sonne brutzelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
