                        "entry_id": "ba2989b9-a6c2-3b7a-a2a9-50a54be76313",
                        "glosses": [
                            "Vertreter der Pflanzengattung Adonis aus der Familie der Hahnenfußgewächse mit 30 bis 35 Arten, deren Blätter zwei- oder dreifach fiederteilig sind und fädlich-linealische Zipfel besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d71caf0-62a7-4647-9209-158240b5c7a5",
                                "sense_id": "f66cef2a-93b4-3b5c-ba41-4523e4603a89",
                                "text": "Die Adonisröschen haben leuchtend rot oder gelb gefärbte Blüten und sind der nahe verwandten Gattung der Windröschen (Anemone) etwas ähnlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53a7661a-cc2c-491b-91c3-24164be76977",
                        "source_entry_id": "ba2989b9-a6c2-3b7a-a2a9-50a54be76313",
