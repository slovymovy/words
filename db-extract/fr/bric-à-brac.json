                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236edecb-1289-4669-9933-6680cab81b92",
                                                "sense_id": "be91fcfe-e952-3bdd-9449-d9fb32a460c7",
                                                "text": "Sie verkaufte ihren alten Trödel auf dem Flohmarkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1008caf1-6d3d-398c-9ffb-a9b38f02f91e",
                                        "entry_id": "a0430f9f-ecdd-3323-a799-462cc4835080",
                                        "glosses": [
                                            "Trödelmarkt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "badd31c3-d426-4013-b950-8ab2c13af39d",
                                                "sense_id": "1008caf1-6d3d-398c-9ffb-a9b38f02f91e",
                                                "text": "Am Wochenende wollen sie Schnäppchen auf dem Trödel suchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ba3848-3437-492e-b336-f05ea0cc9446",
                        "source_entry_id": "8cfed73e-e695-3d45-a850-5f7f96101669",
                        "target_lang_word": "bric-a-brac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bric-a-brac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                        "entry_id": "128b4d7e-158a-3bf5-bbc8-24374128222d",
                                        "glosses": [
                                            "Small ornaments and other miscellaneous display items of little value."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ccbc1b5-310e-484f-8ece-b48cb12a18a1",
                                                "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                                "text": "The palace of Versailles has been turned into a bricabrac shop, of late years; and its time-honoured walls have been covered with many thousand yards of the worst pictures that eye ever looked on."
                                            },
                                            {
                                                "example_id": "acf08874-a9b9-4eee-80f2-9a712bfe009a",
                                                "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                                "text": "No doubt her pleasure would have been at that moment to give him not only that gold which she had been saving up against rent-day, but the spoons, the furniture, and all the valuables of the house, including, perhaps, J. J.'s bricabrac, cabinets, china, and so forth."
                                            },
                                            {
                                                "example_id": "84549af5-d7a5-49c2-a5f1-e416ef01289b",
                                                "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                                "text": "Haven't an affair in the world, […] except a quarrel with a bric-à-brac man."
                                            },
                                            {
                                                "example_id": "75777a34-b4fe-4835-9ac1-8a9bcdcece39",
                                                "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                                "text": "Indeed, who wants the real animal or hunter? What would that do amid astral and bric-a-brac and tapestry, and ladies and gentlemen talking in subdued tones of [Robert] Browning and [Henry Wadsworth] Longfellow and art?"
                                            },
                                            {
                                                "example_id": "378df7f7-85cd-4c84-84fa-c88267ec368e",
                                                "sense_id": "26d78803-5666-33d3-b1ad-d9acfc3715fa",
                                                "text": "\"Well, mi casa su casa,\" said Corbin as they rounded the final bend. They were standing in a cozy maintenance alcove with a sleeping roll on a memory foam mattress on the floor, a series of labelled duffel bags, a space heater and dehumidifier locked in eternal stalemate, a card table and two chairs, and a wide variety of bric-a-brac. There were safety and information posters on the walls, rips and creases showing that they'd been liberated from their original points of fixture. There were photographs mac-tac'd to conduits and concrete. There was even a sad little pot plant beneath a slowly leaking pipe — pot pot, Udo realized, and she almost smiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7325bb0-99db-348a-9e59-1fe72404298d",
                                        "entry_id": "128b4d7e-158a-3bf5-bbc8-24374128222d",
                                        "glosses": [
                                            "Any collection containing a variety of miscellaneous items; a hodgepodge, an olio."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73ed7f8-0a03-4acd-b084-dc9579f61624",
                                                "sense_id": "a7325bb0-99db-348a-9e59-1fe72404298d",
                                                "text": "Yes: I think he is a good fellow: rather miscellaneous and bric-à-brac, but likable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d01ecff-de14-44e8-9f81-e4e847f61b81",
                        "source_entry_id": "8cfed73e-e695-3d45-a850-5f7f96101669",
