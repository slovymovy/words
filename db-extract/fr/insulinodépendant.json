                "senses": [
                    {
                        "sense_id": "e490054c-f96d-3a37-8614-bb99a1bc0e27",
                        "entry_id": "4069e291-a856-368e-9d7e-2c96b40d7e32",
                        "glosses": [
                            "Se dit de la forme de diabète due à l'absence de sécrétion d’insuline par le pancréas, et qui nécessite donc d’être traité par des injections régulières de cette hormone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4960858-0985-47ed-b3c1-47725bc3fec6",
                                "sense_id": "e490054c-f96d-3a37-8614-bb99a1bc0e27",
                                "text": "L’humoriste et comédien a révélé être atteint d’un diabète insulinodépendant."
                            },
                            {
                                "example_id": "c8c1b147-bc61-4e5d-9def-4a3a278433b8",
                                "sense_id": "e490054c-f96d-3a37-8614-bb99a1bc0e27",
                                "text": "Le diabète de type 1 est appelé diabète insulinodépendant (DID) à l’inverse du diabète de type 2 qui, lui, ne l’est pas.."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dc735fa-fb2e-332d-8635-662e2fbd75c0",
                        "entry_id": "4069e291-a856-368e-9d7e-2c96b40d7e32",
                        "glosses": [
                            "Se dit également parfois des personnes atteintes du diabète de ce type, par ellipse de la forme « diabétique insulinodépendant »."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "158a4d47-b40e-434c-b587-dda988968fb5",
                                "sense_id": "6dc735fa-fb2e-332d-8635-662e2fbd75c0",
                                "text": "La coroner a analysé le dossier médical de l’homme de 37 ans provenant de l’Institut universitaire en santé mentale de Québec pour établir qu’il était insulinodépendant couplé d’un trouble de l’usage de substance."
                            },
                            {
                                "example_id": "02452943-6e5d-4058-a714-62307567c270",
                                "sense_id": "6dc735fa-fb2e-332d-8635-662e2fbd75c0",
                                "text": "Vivre avec un enfant insulinodépendant n’est pas de tout repos."
                            }
                        ]
                    }
