                "senses": [
                    {
                        "sense_id": "a7659c40-cba3-3233-82f4-53aaa435aeb2",
                        "entry_id": "fb5792d0-f905-3590-bfdc-8dfe2895eca1",
                        "glosses": [
                            "Foolish conduct; wrongdoing."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b26033dd-ece3-42de-a6b3-0e425aa6fd01",
                                "sense_id": "a7659c40-cba3-3233-82f4-53aaa435aeb2",
                                "text": "And what, your reverences, is unskill ? what is unskill's root ? what is skill ? what is skill's root ? Onslaught on creatures, your reverences, is unskill, taking what is not given is unskill. Sexual misconduct is unskill. Lying speech is unskill."
                            }
                        ]
                    },
                    {
                        "sense_id": "46fbbafe-8c72-391e-b24c-f1b800f914ef",
                        "entry_id": "fb5792d0-f905-3590-bfdc-8dfe2895eca1",
                        "glosses": [
                            "Lack of skill; skilllessness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8eb0f57f-4e3e-435c-ba4e-520d7897b794",
                                "sense_id": "46fbbafe-8c72-391e-b24c-f1b800f914ef",
                                "text": "I make others to relate[…]what I cannot so well expresse, either through unskill of language, or want of judgement."
                            },
                            {
                                "example_id": "68ad1c70-d28b-41da-93f9-5609bba507d7",
                                "sense_id": "46fbbafe-8c72-391e-b24c-f1b800f914ef",
                                "text": "It is at this point that the real menace of unskill becomes clear. Much has been written and spoken about the retarding effect of unskill upon our national production, and this is indeed serious. But the real danger is more fundamental."
                            }
                        ]
                    }
