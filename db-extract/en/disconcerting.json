                                                "sense_id": "02bad703-35ea-30ff-aa9d-f4138326f4af",
                                                "text": "In der Wohnung schlugen ihr unangenehme Gerüche entgegen."
                                            },
                                            {
                                                "example_id": "36d8e7ba-6088-4868-82bf-6f6419662552",
                                                "sense_id": "02bad703-35ea-30ff-aa9d-f4138326f4af",
