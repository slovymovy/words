                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb6df50-6845-494d-9f2a-7bcc4fba6b2e",
                                "sense_id": "cfe26345-5f7f-3ed6-87f5-c91a97c81d41",
                                "text": "Het ging in delen van oase naar oase, van koningsstad naar koningsstad. Eenvoudige nomadische boeren ontwikkelden handelsgeest en werden schatrijk in het grote systeem van overslag van goederen, met tussenhandel en belastingafdrachten. De handelaren kregen ook veelvuldig te maken met rovers."
                            },
                            {
                                "example_id": "e39fe08c-7b24-4568-9bbb-974a22d48e28",
                                "sense_id": "cfe26345-5f7f-3ed6-87f5-c91a97c81d41",
                                "text": "Vervolgens werden de resten per vliegtuig overgebracht naar de koningsstad Krakau. Het vliegtuig vloog lager dan gebruikelijk om de aswolk boven Polen te ontwijken."
                            }
                        ]
                    }
