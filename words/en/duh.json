{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7bf255d4-2aff-3c96-90b4-87ff92b87140",
                    "sense_definition": "Used to express that something is very obvious or self-evident.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obviousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is hot in the desert. - Well, <w>duh</w>!",
                            "target_lang_translations": {
                                "pl": "Na pustyni jest gorąco. - <w>No ba</w>!"
                            }
                        },
                        {
                            "text": "You forgot your keys again? <w>Duh</w>, of course I did.",
                            "target_lang_translations": {
                                "pl": "Znowu zapomniałeś kluczy? <w>No jasne</w>, że zapomniałem."
                            }
                        }
                    ],
                    "synonyms": [
                        "obviously!",
                        "doy",
                        "no duh",
                        "no kidding"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal expression used in casual conversation."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrażenie używane, aby podkreślić, że coś jest oczywiste lub zrozumiałe samo przez się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "no ba",
                                "target_lang_sense_clarification": "Potoczne wyrażenie potwierdzające, że odpowiedź jest oczywista."
                            },
                            {
                                "target_lang_word": "oczywiście",
                                "target_lang_sense_clarification": "Standardowe określenie potwierdzające oczywistość faktu."
                            },
                            {
                                "target_lang_word": "jasne",
                                "target_lang_sense_clarification": "Potoczne potwierdzenie, że coś jest zrozumiałe."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42a15591-ebdf-348e-b6f2-5e40b0460a53",
                    "sense_definition": "Used to mockingly represent stupidity or lack of intelligence.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Duh</w>, I am so smart that I forgot how to open the door.",
                            "target_lang_translations": {
                                "pl": "<w>Derp</w>, jestem taki mądry, że zapomniałem, jak otworzyć drzwi."
                            }
                        },
                        {
                            "text": "He made a <w>duh</w> face while pretending to be confused by the simple task.",
                            "target_lang_translations": {
                                "pl": "Zrobił <w>głupią minę</w>, udając, że proste zadanie go przerasta."
                            }
                        }
                    ],
                    "synonyms": [
                        "derp",
                        "der"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal, often mocking contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrażenie używane w sposób drwiący, aby zasugerować czyjąś głupotę lub brak inteligencji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "derp",
                                "target_lang_sense_clarification": "Slangowe określenie używane do wyśmiewania głupiego zachowania lub miny."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}