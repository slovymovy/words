{
    "word_family": [
        "kidnapper",
        "kidnapping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eafdcef4-20e7-3171-93bc-5e195ba918e7",
                    "sense_definition": "To seize or detain a person unlawfully and move or conceal them, often for ransom.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminals planned to <w>kidnap</w> the wealthy businessman for a large ransom.",
                            "target_lang_translations": {
                                "ru": "Преступники планировали <w>похитить</w> богатого бизнесмена ради крупного выкупа."
                            }
                        },
                        {
                            "text": "Police are investigating a plot to <w>kidnap</w> a child from the local park.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует заговор с целью <w>похищения</w> ребенка из местного парка."
                            }
                        }
                    ],
                    "synonyms": [
                        "abduct",
                        "snatch"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "common_phrases": [
                        "kidnap-for-ransom",
                        "plot to kidnap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно захватить или удерживать человека, часто с целью получения выкупа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похищать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "похитить",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "выкрасть",
                                "target_lang_sense_clarification": "обычно о тайном уводе человека или ребенка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ef9d959-3c7d-3e32-a511-5a2f7d92501c",
                    "sense_definition": "The crime, or an instance, of seizing someone unlawfully.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>kidnap</w> of the diplomat caused an international crisis between the two nations.",
                            "target_lang_translations": {
                                "ru": "<w>Похищение</w> дипломата вызвало международный кризис в отношениях между двумя странами."
                            }
                        },
                        {
                            "text": "He was charged with attempted <w>kidnap</w> after the failed attack.",
                            "target_lang_translations": {
                                "ru": "Ему было предъявлено обвинение в попытке <w>похищения</w> после неудавшегося нападения."
                            }
                        }
                    ],
                    "synonyms": [
                        "abduction",
                        "kidnapping"
                    ],
                    "common_phrases": [
                        "attempted kidnap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преступление или случай незаконного захвата человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похищение",
                                "target_lang_sense_clarification": "действие или инцидент"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}