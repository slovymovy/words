                                        "entry_id": "cba744a5-e365-3587-ab5d-9c877e7513bc",
                                        "glosses": [
                                            "An instrument with which anything is scraped.",
                                            "An instrument by which the soles of shoes are cleaned from mud by drawing them across it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82da3ee-e4ac-44ea-96f1-32713f6a68fe",
                                                "sense_id": "59f3d64f-756f-39e1-8cf8-4515ca441e39",
                                                "text": "and that in trying to scrape the mud off a very unsteady little shoe, he generally got his leg over the scraper."
                                            },
