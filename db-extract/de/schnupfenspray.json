                "senses": [
                    {
                        "sense_id": "6a5de603-e101-3ffe-bb99-ca85087ee078",
                        "entry_id": "5fa54e77-3aa0-3ab2-af9e-504c8ead6096",
                        "glosses": [
                            "Spray, mit dem eine Flüssigkeit gegen Schnupfen als feinverteiltes Aerosol auf die Nasenschleimhaut aufgebracht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ae00aa-59cb-4e34-9166-283066e9686e",
                                "sense_id": "6a5de603-e101-3ffe-bb99-ca85087ee078",
                                "text": "„Paul reichte ihr postwendend ein Schnupfenspray, das er ebenfalls im Medizinschrank gefunden hatte.“"
                            },
                            {
                                "example_id": "6220df53-60eb-4f98-b450-1404c0e254dc",
                                "sense_id": "6a5de603-e101-3ffe-bb99-ca85087ee078",
                                "text": "„Aber ein wenig Schnupfenspray brachte Linderung und er dachte gar nicht daran sich ins Bett zu legen und zu faulenzen.“"
                            },
                            {
                                "example_id": "63e7a29c-2d89-4642-97d0-bc4e7f5d9a8d",
                                "sense_id": "6a5de603-e101-3ffe-bb99-ca85087ee078",
                                "text": "„Bei sehr stark verstopfter Nase soll zuvor ein Schnupfenspray zum Abschwellen benutzt werden (0,5% Phenylephrin).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
