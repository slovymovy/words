                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd904cd4-c056-46f4-b6b3-65c75d6dd972",
                                "sense_id": "209137a1-1371-3ebb-8ea3-a46c44147132",
                                "text": "На то ль тебя родил, на то ли я крушился, // Тамира, чтобы ты преслушна мне была? // За пришлецем бежать из отческого дому, // И кровности его дерзнула предпочесть!"
                            },
                            {
                                "example_id": "a0791ce0-2a40-4a4e-aabd-41f1ff23e372",
                                "sense_id": "209137a1-1371-3ebb-8ea3-a46c44147132",
                                "text": "Это было уже не простое любопытство, а сознание кровности дела."
                            }
                        ]
                    }
