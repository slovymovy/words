                ],
                "senses": [
                    {
                        "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                        "entry_id": "ce45c044-63f3-3f36-a66d-867cd2aa2e7c",
                        "glosses": [
                            "Peuple des bords de le mer Noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "457d59bd-ba1b-4fd5-8ec6-feeccf7e658b",
                                "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                                "text": "Celtes, Germains, Slaves m’apparurent comme des espèces de Scythes consciencieux, mais péniblement civilisés."
                            },
                            {
                                "example_id": "25d2363e-5035-4a34-9673-9bf5d552529e",
                                "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                                "text": "Les objets sculptés par les Scythes au VIIe siècle avant J.-C. (casques, épées, bijoux) font la joie d’un public de connaisseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                        "entry_id": "ce45c044-63f3-3f36-a66d-867cd2aa2e7c",
                        "glosses": [
                            "Personne mal dégrossie, peu civilisée."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "b788c5d3-1322-45af-b0be-db62b5130d28",
                                "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                                "text": "Le Scythe, retourné dans sa triste demeure,\nPrend la serpe à son tour, coupe et taille à toute heure,\nConseille à ses voisins, prescrit à ses amis\nUn universel abattis."
                            },
                            {
                                "example_id": "24fdb1e1-ea4b-4fcf-a747-4f2a9333d355",
                                "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                                "text": "Alphonse Daudet le renseigna sur quelques tours de phrase, qu’il n’avait pas parfaitement saisis : « Je vis ici au milieu de Scythes, vous comprenez, Daudet ; il faut me pardonner »"
                            }
                        ]
                    }
                ],
