                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5bdea968-e47e-3300-8a7e-53b401af37e9",
                        "entry_id": "a6314b67-3db7-3509-84bd-3f2472ad7ef8",
