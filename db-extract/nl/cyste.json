                    },
                    {
                        "translation_id": "d3ed2e02-f452-41c4-851e-66bb73a981be",
                        "source_entry_id": "c9d9e239-a679-31d2-9dfc-10467a1c6225",
                        "source_sense_id": "257e7fb4-db21-3cf7-99eb-33cd5c7b5f29",
                        "source_sense_description": "holte gevuld met vocht",
                        "target_lang_word": "kyste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
