                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "One who directs; the person in charge of managing a department or directorate (e.g., director of engineering), project, or production (as in a show or film, e.g., film director)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955b2415-0e35-462e-bf6d-0cfad5ecd265",
                                                "sense_id": "948fadb6-ad8e-3444-90ad-0f6b4bee8755",
                                                "text": "Francis Gurry is director of WIPO."
                                            },
                                            {
                                                "example_id": "e703f58b-f821-41ab-97f6-bcf54239759a",
                                                "sense_id": "948fadb6-ad8e-3444-90ad-0f6b4bee8755",
                                                "text": "The easiest way for Neera Tanden to win confirmation as Joe Biden’s budget director is for Democrats to take the Senate in January."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A member of a board of directors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e444e3-bc56-4635-a2a5-493237365f81",
                                                "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                                "text": "[...] the confusion between directors who know nothing and managers who know everything [...]."
                                            },
                                            {
                                                "example_id": "524945a6-3d69-42f0-907d-091c37ef5545",
                                                "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                                "text": "Being named to a board of a directors at an established company may seem out of reach — especially if you’re under 50. Or a woman. Or a minority. Or you haven’t made it to the C-suite (yet). […] Last year, S&P 500 boards named 428 new directors, according to Spencer Stuart’s Board Index. Of them, 40% were women, 17% were under 50, and only a third were active or retired CEOs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785b7c3b-7f61-3674-8b90-51b1cc1dd312",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A counselor, confessor, or spiritual guide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3c96970-7537-33c8-8cfa-9c64525dbf31",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "That which directs or orientates something."
                                        ],
                                        "tags": [],
                                        "examples": [
