                        "sense_id": "ae702aa1-ea03-3043-a0d7-0646b16a12be",
                        "entry_id": "efac2f9d-0ddc-3f44-8bb7-8e4f86e65bda",
                        "glosses": [
                            "Anhänger oder Mitglied der Mehrheitssozialdemokratischen Partei Deutschlands (MSPD)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4d86812e-6415-4ac0-ad8c-114b6869710a",
                                "sense_id": "ae702aa1-ea03-3043-a0d7-0646b16a12be",
                                "text": "„Ein sechsköpfiger Regierungsrat, je zur Hälfte mit Mehrheitssozialdemokraten und Unabhängigen besetzt, würde die neue Republik bis auf Weiteres regieren und das Kanzleramt ersetzen, das Ebert also für nur 23 Stunden innehatte.“"
                            },
                            {
                                "example_id": "bdeba2b9-d373-435e-a2bb-978bbd408465",
                                "sense_id": "ae702aa1-ea03-3043-a0d7-0646b16a12be",
                                "text": "„Auf Antrag des Mehrheitssozialdemokraten Max Cohen sprachen sich etwa 400 gegen 50 Delegierte für die Wahl der Nationalversammlung am 19. Januar 1919 aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
