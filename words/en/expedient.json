                    "frequency": "Middle",
                    "semantic_group_id": "practicality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most people, faced with a difficult decision, will choose the most <w>expedient</w> option."
                        },
                        {
                            "text": "It was considered a highly <w>expedient</w> solution to the sudden budget deficit."
                        }
                    ],
                    "synonyms": [
                        "advisable",
                        "desirable",
                        "judicious",
                        "politic",
                        "prudent",
                        "wise"
                    ],
                    "antonyms": [
