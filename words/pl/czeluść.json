                },
                {
                    "sense_id": "c7ee9884-6be9-3bdd-aa70-6372958035d4",
                    "sense_definition": "gardziel, paszcza zwierzęcia lub potwora",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ogromny lew rozwarł potężną <w>czeluść</w>, wydając z siebie przeraźliwy ryk.",
                            "target_lang_translations": {
                                "ru": "Огромный лев разинул мощную <w>пасть</w>, издав ужасающий рёв."
                            }
                        },
                        {
                            "text": "Ryba połknęła przynętę w mgnieniu oka, chowając ją w szerokiej <w>czeluści</w>.",
                            "target_lang_translations": {
                                "ru": "Рыба в мгновение ока проглотила наживку, спрятав её в широком <w>зеве</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozewrzeć czeluść"
                    ],
                    "target_lang_definitions": {
