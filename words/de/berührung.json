    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5db09646-001b-34e9-b0b5-52717bf5836f",
                    "sense_definition": "Das gezielte oder zufällige körperliche Anfassen oder in Kontakt Treten mit jemandem oder etwas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine sanfte <w>Berührung</w> beruhigte das weinende Kind innerhalb weniger Augenblicke."
                        },
                        {
                            "text": "Bei der leichten <w>Berührung</w> an ihrer Schulter zuckte sie erschrocken zusammen."
                        }
                    ],
                    "synonyms": [
                        "Kontakt"
                    ],
                    "common_phrases": [
                        "sanfte Berührung",
                        "körperliche Berührung"
                    ]
                },
                {
                    "sense_id": "3ab78e51-9186-3700-b4e5-13324da40508",
                    "sense_definition": "Der persönliche oder geistige Kontakt mit Menschen, Institutionen, Wissensgebieten oder Lebensumständen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "kontakt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch sein Studium im Ausland kam er erstmals mit einer fremden Kultur in <w>Berührung</w>."
                        },
                        {
                            "text": "Viele Menschen kommen im Alltag überhaupt nicht mit solchen behördlichen Verfahren in <w>Berührung</w>."
                        }
                    ],
                    "synonyms": [
                        "Austausch",
                        "Kontakt",
                        "Umgang"
                    ],
                    "common_phrases": [
                        "in Berührung kommen",
                        "in Berührung bringen"
                    ]
                },
                {
                    "sense_id": "c0bcdb0d-31a1-3b21-9d23-b6771902482f",
                    "sense_definition": "Das direkte Aufeinandertreffen oder Aneinandergeraten von Gegenständen, Oberflächen oder chemischen Stoffen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Berührung</w> von heißem Fett mit kaltem Wasser kann zu gefährlichen Explosionen führen."
                        },
                        {
                            "text": "Bei der kleinsten <w>Berührung</w> löst der sensible Sensor sofort einen Alarm aus."
                        }
                    ],
                    "synonyms": [
                        "Aufeinandertreffen",
                        "Kontakt"
                    ],
                    "common_phrases": [
                        "bei Berührung"
                    ]
                },
                {
                    "sense_id": "760d01f4-a9cd-3a12-82f8-256e2141b320",
                    "sense_definition": "Das kurze Ansprechen, Behandeln oder Erwähnen eines Themas in einer Rede oder einem Gespräch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diskurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Berührung</w> dieses heiklen Themas sorgte während der Verhandlung für spürbare Unruhe."
                        },
                        {
                            "text": "Bereits die flüchtige <w>Berührung</w> des Problems machte den Beteiligten große Sorgen."
                        }
                    ],
                    "synonyms": [
                        "Erwähnung"
                    ]
                }
            ]
        }
    ]
}