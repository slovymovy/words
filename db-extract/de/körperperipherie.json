                ],
                "senses": [
                    {
                        "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                        "entry_id": "a4498740-6b75-3838-a803-5054e72f56a1",
                        "glosses": [
                            "Bereiche des Körpers, die weiter vom Körperzentrum (insbesondere vom Herz und dem zentralen Nervensystem) entfernt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb277694-aafc-4318-92c3-e0b851d118a7",
                                "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                                "text": "„Die herznahen Arterien sind elastischer als die in der Körperperipherie gelegenen.“"
                            },
                            {
                                "example_id": "5a2c9de5-5452-4011-a4fe-14b657998b69",
                                "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                                "text": "„Diese peripher wirksamen Analgetika funktionieren in der Körperperipherie und sorgen für eine Blockierung der Schmerzweiterleitung.“"
                            },
                            {
                                "example_id": "7bcc1387-b961-4224-82b0-e6ebb5dd97c8",
                                "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                                "text": "„Es gibt einen Kommunikationsweg (Leitungsbahn) im Körper [sic!] über den die Informationen zwischen zentralem Nervensystem und Körperperipherie nur eingeschränkt ‚fließen‘ können.“"
                            },
                            {
                                "example_id": "60bb70ac-5b41-464e-9b74-dfb0200e8081",
                                "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                                "text": "„Das Lymphatische System leitet die Lymphe von der Körperperipherie zum Zentrum hin.“"
                            },
                            {
                                "example_id": "eeaa201d-6cbf-42b4-889b-20511ff8cefd",
                                "sense_id": "326b38d5-f9e5-342b-b3a5-8555d74b6c42",
                                "text": "„Bei hohen Temperaturen erweitern sich die Gefäße in der Körperperipherie, wir beginnen zu schwitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
