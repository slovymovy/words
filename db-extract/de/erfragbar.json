                ],
                "senses": [
                    {
                        "sense_id": "4bc7f4b9-2334-363e-adb8-985fffc04ca1",
                        "entry_id": "304be25e-3a36-34d8-8f31-d37b97b041f1",
                        "glosses": [
                            "sich erfragen lassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38801b9b-658e-4a85-a430-a9aed7916467",
                                "sense_id": "4bc7f4b9-2334-363e-adb8-985fffc04ca1",
                                "text": "„An den Zuschauerpunkten der Wertungsprüfungen, Start und auf dem Serviceplatz richtet der Veranstalter übrigens Shops ein, an denen neben Fan-Artikeln auch die aktuellen Ergebnisse erfragbar sind.“"
                            },
                            {
                                "example_id": "1465f23c-7c2f-41a3-a873-c5043b586aa0",
                                "sense_id": "4bc7f4b9-2334-363e-adb8-985fffc04ca1",
                                "text": "„Dazu gibt es jedoch Einkommensgrenzen, die beim SOMA direkt oder den Gemeinden des Bezirks erfragbar sind.“"
                            },
                            {
                                "example_id": "6a5ea70e-c7f6-4cb2-ac8a-812dfd8cc492",
