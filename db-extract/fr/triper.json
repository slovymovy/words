                "senses": [
                    {
                        "sense_id": "90b927bf-6e5d-3eab-af5f-866ed763bff8",
                        "entry_id": "37cd2f0e-b242-3a5f-a095-c19a2186033f",
                        "glosses": [
                            "Ressentir l’effet produit par l’absorption d’une drogue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5178f65-4f06-3652-bdbb-1b224d89ed7c",
                        "entry_id": "37cd2f0e-b242-3a5f-a095-c19a2186033f",
                        "glosses": [
                            "Avoir une relation sexuelle ou amicale existante ou imaginaire avec une personne suscitant beaucoup de plaisir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66023d40-6da0-4378-970f-1eded7ec4c5e",
                                "sense_id": "f5178f65-4f06-3652-bdbb-1b224d89ed7c",
                                "text": "Hier soir, Max a tripé avec Virginie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c011abe0-603d-3cec-a844-1c676e0c777d",
                        "entry_id": "37cd2f0e-b242-3a5f-a095-c19a2186033f",
                        "glosses": [
                            "Avoir un délire humoristique seul ou à plusieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9e86b7-bdee-4b2e-a916-aaf837b588d7",
                                "sense_id": "c011abe0-603d-3cec-a844-1c676e0c777d",
                                "text": "Francis Mickael me fait marrer, il tripe bien."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb7ce28d-56d9-333e-8a45-a19eb6d3e094",
                        "entry_id": "37cd2f0e-b242-3a5f-a095-c19a2186033f",
                        "glosses": [
                            "Ressentir sinon une extase, du moins une grande plénitude, un ravissement."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dc291879-1830-4385-976b-721141cf1dea",
                                "sense_id": "fb7ce28d-56d9-333e-8a45-a19eb6d3e094",
                                "text": "Les uns tripent à casser des vitrines. Les autres se frottent les mains en voyant des vitrines se faire casser."
                            }
                        ]
                    }
