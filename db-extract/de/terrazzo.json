                                        "glosses": [
                                            "A faux-marble material used for flooring and countertops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b889126-1b86-4e96-ad42-8c2c5e68b54f",
                                                "sense_id": "c94595e1-8a9d-3621-aade-6465b91f3b5c",
                                                "text": "A fibreglass fish should have been spewing water into a terrazzo fountain, but the pipes had not yet been connected and bags of cement were heaped in the basin."
                                            },
                                            {
                                                "example_id": "301e111e-f2b0-4504-81f6-ad57e422f748",
                                                "sense_id": "c94595e1-8a9d-3621-aade-6465b91f3b5c",
                                                "text": "Richard Sammons[…] began by leaving the ground floor studio pretty much as he found it, with 15-foot ceilings and a black terrazzo floor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
