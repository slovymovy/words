                "senses": [
                    {
                        "sense_id": "f3f60eb6-0cde-31c0-91d4-2e4f317006b7",
                        "entry_id": "1eea98cf-856e-3e90-afb4-6642405500ab",
                        "glosses": [
                            "Speisepilz mit rötlich braunem Hut und festem weißlichem Fleisch, der in Japan und China an Stämmen von Bambus und Eichen kultiviert und auch in der Naturheilkunde verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f523a9-3761-429b-9133-17674e226bdf",
                                "sense_id": "f3f60eb6-0cde-31c0-91d4-2e4f317006b7",
                                "text": "Der Shiitake ist eine Pilzsorte."
                            },
                            {
                                "example_id": "ecc173ce-7128-4cfd-8f4b-fdc7e5b7351b",
                                "sense_id": "f3f60eb6-0cde-31c0-91d4-2e4f317006b7",
                                "text": "„Der Shiitake, Cortinellus Shiitake, ist ein in Japan heimischer Blätterpilz, der an Stämmen von Eichen oder Bambus wächst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6afaeec-65bb-49cc-b8b3-d70efafc85f1",
