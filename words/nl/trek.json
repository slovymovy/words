                {
                    "sense_id": "9f6c39d8-b169-328c-909c-99c2c9105c6c",
                    "sense_definition": "Een luchtstroom door een ruimte of kanaal, bijvoorbeeld in een schoorsteen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "air_current",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De open haard brandt niet goed omdat er te weinig <w>trek</w> in de schoorsteen zit.",
                            "target_lang_translations": {
                                "en": "The fireplace is not burning well because there is too little <w>draft</w> in the chimney.",
                                "ru": "Камин плохо горит, потому что в дымоходе слишком слабая <w>тяга</w>.",
                                "de": "Der Kamin brennt nicht gut, weil zu wenig <w>Zug</w> im Schornstein ist."
                            }
                        },
                        {
                            "text": "Doe de deur dicht, want er staat een koude <w>trek</w> in de gang.",
                            "target_lang_translations": {
                                "en": "Close the door, because there is a cold <w>draft</w> in the hallway.",
                                "ru": "Закрой дверь, а то в коридоре холодный <w>сквозняк</w>.",
                                "de": "Mach die Tür zu, denn es herrscht ein kalter <w>Zug</w> im Flur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de trek staan",
                        "goede trek"
                    ],
                    "target_lang_definitions": {
                        "en": "An air current through a space or channel, for example in a chimney.",
                        "ru": "Поток воздуха через пространство или канал, например, в дымоходе.",
                        "de": "Ein Luftstrom durch einen Raum oder Kanal, zum Beispiel in einem Schornstein."
                    },
                    "translations": {
