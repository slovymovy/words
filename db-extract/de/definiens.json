                                            {
                                                "example_id": "f242d3b3-056f-44ff-9e1f-3b8a8e71dc4d",
                                                "sense_id": "56c1b464-9545-3abd-86aa-9c485e8b6d89",
                                                "text": "Yet such predicates will not in general even be interpreted over the domain of objects over which the definientia range."
                                            },
                                            {
                                                "example_id": "444569de-bba3-40c8-a1e6-b188d56dbbaa",
                                                "sense_id": "56c1b464-9545-3abd-86aa-9c485e8b6d89",
                                                "text": "In these definitions, then, there is only one part of the definiens, the form (e.g. being a human soul), which is prior to the kind and its matter."
                                            }
                                        ]
                                    }
                                ]
                            }
