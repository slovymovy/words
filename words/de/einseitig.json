                    ]
                },
                {
                    "sense_id": "adc57c97-43a7-35a2-9763-19268985e019",
                    "sense_definition": "Nur von einem der Beteiligten ausgehend oder empfunden; nicht auf Gegenseitigkeit beruhend.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine Gefühle für sie blieben leider nur eine schmerzhafte und <w>einseitige</w> Liebe."
                        },
                        {
                            "text": "Eine Partnerschaft funktioniert nicht gut, wenn das Bemühen darum völlig <w>einseitig</w> bleibt."
