                ],
                "senses": [
                    {
                        "sense_id": "5d41bdd3-252e-31a5-97d6-939ee4d6260f",
                        "entry_id": "f960a429-c34c-32ed-80a7-3a948ac90a70",
                        "glosses": [
                            "Rendre (un programme, en particulier) illisible pour éviter qu’il soit exploité de façon non autorisée, par exemple, en transformant les noms des variables pour qu'ils deviennent incompréhensibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86825449-28f5-45e6-9a4c-3e54a0c282fd",
                                "sense_id": "5d41bdd3-252e-31a5-97d6-939ee4d6260f",
                                "text": "En outre, nous recommandons de minimiser ou d’obfusquer les fichiers avant qu’ils ne soient déployés sur le serveur au lieu de minimiser ou de les obfusquer dynamiquement à chaque requête HTTP pour gagner ainsi du temps processeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a193f9d-63c8-4747-93ef-5079b3ac6330",
                        "source_entry_id": "f960a429-c34c-32ed-80a7-3a948ac90a70",
                        "source_sense_id": "5d41bdd3-252e-31a5-97d6-939ee4d6260f",
                        "target_lang_word": "obfuscate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obfuscate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66230084-92dd-3e58-93a9-eb9d5edc6926",
                                        "entry_id": "2ec22672-b24c-384d-b5d6-193a92da1a8f",
                                        "glosses": [
                                            "To make dark; to overshadow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                                        "entry_id": "2ec22672-b24c-384d-b5d6-193a92da1a8f",
                                        "glosses": [
                                            "To deliberately make more confusing in order to conceal the truth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b7c01b-7c0c-4251-9dc8-3f87bd3d377b",
                                                "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                                                "text": "obfuscate facts"
                                            },
                                            {
                                                "example_id": "0ae5eba2-2b8c-4d44-ad08-ecc762eca607",
                                                "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                                                "text": "Can weakness be really obfuscated?"
                                            },
                                            {
                                                "example_id": "ff7d9ab0-7e9f-47dd-b2ec-5534937e3550",
                                                "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                                                "text": "Before leaving the scene, the murderer set a fire in order to obfuscate any evidence of his identity."
                                            },
                                            {
                                                "example_id": "7a7e8a8a-cfe6-4b7b-a49f-6478c866b4f3",
                                                "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                                                "text": "When asked if Kelly could have been more transparent or truthful, that official wrote: “In this White House, it’s simply not in our DNA. Truthful and transparent is great, but we don’t even have a coherent strategy to obfuscate.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef7ea40-4716-3db7-8276-6eebdc8b82d4",
                                        "entry_id": "2ec22672-b24c-384d-b5d6-193a92da1a8f",
                                        "glosses": [
                                            "To alter code while preserving its behavior but concealing its structure and intent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fb637f-d71c-438d-80b6-e4ce0aba902a",
                                                "sense_id": "fef7ea40-4716-3db7-8276-6eebdc8b82d4",
                                                "text": "We need to obfuscate these classes before we ship the final release."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obfuscate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6dab01-6332-3c7b-9b34-49ce3502691c",
                                        "entry_id": "1f134981-0e8a-3e3c-9914-6d2dd8d275d9",
                                        "glosses": [
                                            "Obfuscated; darkened; obscured."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f616ac88-b8f0-4a91-bfc4-0464fdecfb9f",
                                                "sense_id": "ba6dab01-6332-3c7b-9b34-49ce3502691c",
                                                "text": "Also the vertues beynge in a cruell persone be nat only obfuscate or hyd : But also lyke wyse as norysshynge meates and drynkes in an sycke body"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
