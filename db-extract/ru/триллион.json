                "translations": [
                    {
                        "translation_id": "e7655a3e-d66b-4fd0-980a-a241b412520b",
                        "source_entry_id": "58c29e82-f744-3fa6-9fb4-bdd5829b5227",
                        "source_sense_description": "тысяча миллиардов",
                        "target_lang_word": "trillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "A million (times a) million: 1 followed by twelve zeros, 10¹²."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "US",
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0912a570-0ef1-44fd-b10a-65c5356c0e35",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "Javik: Stand in the ashes of a trillion dead souls and ask the ghosts if honor matters. Their silence is your answer."
                                            },
                                            {
                                                "example_id": "7e1155e1-f686-4582-8323-9b9ff367a622",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "Data published by the Treasury Department showed that “total public debt outstanding” rose to $34.001 trillion on December 29."
                                            },
                                            {
                                                "example_id": "d3607037-11a3-4523-b9cc-5f5ad9d0f89d",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "As President Donald Trump prepares to order the dismantling of the Department of Education, the financial arm of the agency – which makes loans directly to borrowers and manages trillions of dollars in student debt – faces an uncertain future, with steep staff cuts and lack of communication exacerbating the uncertainty, according to interviews with more than a dozen current and former department employees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5744187d-930b-31b3-9a29-6019ed5aa31e",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "A million (times a) million (times a) million: 1 followed by eighteen zeros, 10¹⁸."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "An unspecified very large number."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8235f9b-0927-4516-af62-6b30cf8bb48c",
                                                "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                                "text": "Near-synonyms: gazillion; see also Thesaurus:zillion"
                                            },
                                            {
                                                "example_id": "6073d4e8-4fbc-4bec-aa6d-79d0cd99e6b4",
                                                "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                                "text": "There were trillions of people at the concert."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b498aa80-e562-3758-a1eb-bdcd3a4c7035",
                                        "entry_id": "5a75fa07-9159-3a44-bcad-76d4be33fd7d",
                                        "glosses": [
                                            "A statistic formed by a player playing some number of minutes, but recording no stats."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7a2940-9a22-48da-98d6-d06b7cdd03f4",
                        "source_entry_id": "58c29e82-f744-3fa6-9fb4-bdd5829b5227",
                        "source_sense_description": "тысяча миллиардов",
                        "target_lang_word": "Billion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Billion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                        "entry_id": "064343c6-610c-319e-b3c8-8e243446f77a",
                                        "glosses": [
                                            "1.000.000.000.000 = 10¹² ( eine Million Millionen bzw. eine Million hoch zwei gleich „bi-“);"
                                        ],
                                        "tags": [
                                            "Eselsbrücke"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7a4619-9315-4db3-9c2c-82aa355573c9",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "Eine Billion ist eine sehr hohe Zahl, die nicht in sehr vielen Kontexten auftaucht."
                                            },
                                            {
                                                "example_id": "402a55ef-ee10-423c-b3b2-b579153ddef8",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "Nach Informationen der Financial Times Deutschland sprach er vor Abgeordneten der schwarz-gelben Koalition über eine Hebelung des Fonds auf maximal eine Billion Euro."
                                            },
                                            {
                                                "example_id": "7be61459-d12c-4b18-acfb-4482f20de7e7",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "„Ich vertrieb mir die Zeit, indem ich den Schreibtisch durchsuchte, allerdings nichts fand außer fünfzig Billionen altes Inflationsgeld, das unser Lieblingswärter sammelte wie jedes andere entwertete Papiergeld.“"
                                            },
                                            {
                                                "example_id": "01b2046a-310a-4ea5-a69b-319bc69f5fc2",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "„Als am Ende der Inflation im Jahre 1923 die Mark von einer Billion auf vier Mark stabilisiert wurde, hatte er Konkurs anmelden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff17795a-c984-47b1-9bc8-229a555e69f6",
                        "source_entry_id": "58c29e82-f744-3fa6-9fb4-bdd5829b5227",
                        "source_sense_description": "тысяча миллиардов",
                        "target_lang_word": "biljoen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biljoen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                        "entry_id": "94537397-339e-3c95-b31f-c323313a0530",
                                        "glosses": [
                                            "1.000.000.000.000 ( = 10¹² )"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e454cc6-3c37-4c0a-8f8f-ac6c7e79393a",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "\"Conflicten kosten de wereldbevolking in 2014 in totaal 12,7 biljoen euro\""
                                            },
                                            {
                                                "example_id": "0df1514f-35ee-4180-803b-e724813e9a75",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "\"Roken kost wereldeconomie bijna biljoen euro per jaar\""
                                            },
                                            {
                                                "example_id": "55863ef7-f769-4126-bc55-fcca77ac74d2",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "Een biljoen bytes noemen we internationaal een terabyte en dat zijn 1000 gigabytes."
                                            },
                                            {
                                                "example_id": "3ac11b5a-05ad-4ce9-afb8-a1fcc923b41b",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "(28-december-2017) De rijken zijn dit jaar nog rijker geworden. Volgens een berekening van persbureau Bloomberg zijn de 500 rijkste mensen bij elkaar zo’n 1 biljoen dollar rijker (840 miljard euro)."
                                            },
                                            {
                                                "example_id": "1763df06-2349-4598-a11e-b3b72a4de627",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "Wereldwijd worden er jaarlijks vijf biljoen plastic tassen geproduceerd: gezamenlijk een gebied dat twee keer zo groot als Frankrijk is."
                                            },
                                            {
                                                "example_id": "107633ee-8302-4f33-8f60-c5890409b5f4",
                                                "sense_id": "267fa38c-a643-36f1-89b2-baa9b5157cc5",
                                                "text": "Polen schat schade door nazi’s op 1,3 biljoen en wil compensatie"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "biljoen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0744b42-f6a9-3039-8d59-38ec77c56cea",
                                        "entry_id": "dd2e4460-4cfb-31a6-a133-f850cda1238d",
