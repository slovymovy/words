{
    "word_family": [
        "check",
        "check-in",
        "checker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05b6fc80-4b76-3f92-80d1-6dd13484c1e3",
                    "sense_definition": "The physical place in a supermarket or store where you pay for your goods.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shopping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please meet me at the <w>checkout</w> once you have finished picking out your groceries.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, встреть меня у <w>кассы</w>, когда закончишь выбирать продукты."
                            }
                        },
                        {
                            "text": "There was a very long queue at the supermarket <w>checkout</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром на <w>кассе</w> в супермаркете была очень длинная очередь."
                            }
                        }
                    ],
                    "synonyms": [
                        "counter",
                        "till"
                    ],
                    "common_phrases": [
                        "supermarket checkout",
                        "checkout counter",
                        "express checkout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место в супермаркете или магазине, где вы оплачиваете товары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касса",
                                "target_lang_sense_clarification": "место оплаты в магазине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49300ac9-52af-3472-be6e-7fc4106bd70c",
                    "sense_definition": "The process of leaving a hotel after paying the bill, or the specific time by which you must vacate the room.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel has a midday <w>checkout</w> policy for all guests.",
                            "target_lang_translations": {
                                "ru": "В отеле действует правило <w>выезда</w> до полудня для всех гостей."
                            }
                        },
                        {
                            "text": "We requested a late <w>checkout</w> because our flight doesn't leave until the evening.",
                            "target_lang_translations": {
                                "ru": "Мы попросили поздний <w>выезд</w>, так как наш рейс только вечером."
                            }
                        }
                    ],
                    "antonyms": [
                        "check-in"
                    ],
                    "common_phrases": [
                        "late checkout",
                        "hotel checkout",
                        "checkout time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс выезда из отеля после оплаты счета или время, до которого необходимо освободить номер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выезд",
                                "target_lang_sense_clarification": "из отеля"
                            },
                            {
                                "target_lang_word": "чекаут",
                                "target_lang_sense_clarification": "сленг, время освобождения номера"
                            },
                            {
                                "target_lang_word": "регистрация отъезда",
                                "target_lang_sense_clarification": "официальная процедура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b1bca2b-7a40-3966-9d47-1e6ec1240192",
                    "sense_definition": "The final stage of an online purchase where you confirm your items and provide payment details.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "e-commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had several items in my cart but decided not to proceed to <w>checkout</w>.",
                            "target_lang_translations": {
                                "ru": "У меня в корзине было несколько товаров, но я решил не переходить к <w>оформлению заказа</w>."
                            }
                        },
                        {
                            "text": "The website offers a guest <w>checkout</w> option so you don't have to create an account.",
                            "target_lang_translations": {
                                "ru": "Сайт предлагает возможность <w>оформления заказа</w> без регистрации, чтобы вам не нужно было создавать аккаунт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guest checkout",
                        "online checkout",
                        "proceed to checkout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительный этап онлайн-покупки, на котором вы подтверждаете товары и вводите платежные данные."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оформление заказа",
                                "target_lang_sense_clarification": "в интернет-магазине"
                            },
                            {
                                "target_lang_word": "оплата",
                                "target_lang_sense_clarification": "этап подтверждения покупки"
                            },
                            {
                                "target_lang_word": "чекаут",
                                "target_lang_sense_clarification": "технический термин в e-commerce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16c9c77a-73f8-3d47-bf98-2f97383b57df",
                    "sense_definition": "A systematic test or inspection to ensure that a piece of equipment or a system is working correctly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers performed a final <w>checkout</w> of the aircraft systems before takeoff.",
                            "target_lang_translations": {
                                "ru": "Инженеры провели финальную <w>проверку</w> систем самолета перед взлетом."
                            }
                        },
                        {
                            "text": "A thorough equipment <w>checkout</w> is necessary to prevent any accidents during the experiment.",
                            "target_lang_translations": {
                                "ru": "Тщательный <w>осмотр</w> оборудования необходим для предотвращения несчастных случаев во время эксперимента."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspection",
                        "test",
                        "checkup"
                    ],
                    "common_phrases": [
                        "equipment checkout",
                        "system checkout",
                        "final checkout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематическая проверка или инспекция для подтверждения исправности оборудования или системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проверка",
                                "target_lang_sense_clarification": "технический осмотр"
                            },
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "исправности систем"
                            },
                            {
                                "target_lang_word": "инспекция",
                                "target_lang_sense_clarification": "перед эксплуатацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cfe6326-62ab-332c-9737-644ebceb4e9a",
                    "sense_definition": "In the game of darts, the score achieved to win a leg.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the match with an impressive 141 <w>checkout</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл матч с впечатляющим <w>чекаутом</w> в 141 очко."
                            }
                        },
                        {
                            "text": "The player missed his double and failed to complete the <w>checkout</w>.",
                            "target_lang_translations": {
                                "ru": "Игрок промахнулся мимо удвоения и не смог выполнить <w>закрытие</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "finish"
                    ],
                    "common_phrases": [
                        "highest checkout",
                        "darts checkout"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in UK sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В игре в дартс: количество очков, набранное для победы в леге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чекаут",
                                "target_lang_sense_clarification": "завершение лега в дартсе"
                            },
                            {
                                "target_lang_word": "закрытие",
                                "target_lang_sense_clarification": "окончание игры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}