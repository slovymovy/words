                        "examples": [
                            {
                                "example_id": "4b60f142-01d0-4f15-88f2-7f468991bb2b",
                                "sense_id": "90a0000b-123b-3795-971d-44d1ed5ad25f",
                                "text": "Папа с трудом внёс ёлку в дом."
                            },
                            {
                                "example_id": "31500713-a01b-4a8f-9899-e4d4d47608ca",
                                "sense_id": "90a0000b-123b-3795-971d-44d1ed5ad25f",
                                "text": "вот, принесли некоторые на постели человека, который был расслаблен, и старались внести его в дом и положить перед Иисусом…"
                            }
                        ]
                    },
                    {
                        "sense_id": "ef8e244e-5c2b-33d8-ae97-12dd3d0c927b",
                        "entry_id": "d7504fb9-ab31-3aec-9f07-a0f748d0fde7",
