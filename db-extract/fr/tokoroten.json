                "translations": [
                    {
                        "translation_id": "ccf6d767-ffd7-450c-bb06-253ec9919594",
                        "source_entry_id": "d273f3c7-0a71-3572-b7bd-fd46e1b30a44",
                        "source_sense_id": "8b285bbb-395d-3505-b576-35af7c3c49ca",
                        "target_lang_word": "tokoroten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tokoroten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                        "entry_id": "7eecb691-5a40-3f45-9a10-4e07581e3cb1",
                                        "glosses": [
                                            "A dish in Japanese cuisine made from agarophytes, traditionally by boiling tengusa (Gelidium amansii) and then allowing the mixture to congeal into a jelly."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2091b651-06bc-4b1f-b14c-89ad8bca59ba",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "Vendors now sell gold fish through the streets, along with hawkers of tokoroten, or sea-weed jelly, and gaily decorated wind bells."
                                            },
                                            {
                                                "example_id": "7786794a-e8e9-49c4-9dd0-945f202a97ce",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "You ate peanuts and tokoroten, so you’re probably past saving."
                                            },
                                            {
                                                "example_id": "db5a11e7-1ec3-4e9e-b348-2013b121ee43",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "About 350 years ago, it was discovered accidentally when Lord Shimazu had some unused tokoroten left in his garden in Kyoto. It was winter and very cold. The tokoroten congealed at night, and when the sun came out, it dried out."
                                            },
                                            {
                                                "example_id": "7f735f8d-6c2a-4c24-87f4-d9e7b1510f38",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "In Asia, agar is used in many traditional dishes, such as red bean jelly, tokoroten noodles and mitsumame."
                                            },
                                            {
                                                "example_id": "ecd18203-3600-4fa5-b284-5177661010ee",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "The main course was fried beef cutlets, followed by tokoroten, a jellied agar garnished with dark molasses, for dessert."
                                            },
                                            {
                                                "example_id": "2c35fbeb-6125-49c1-a5a3-9dea6666acb8",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "(206) Agar-agar (Gelidium corneum. Tengusa). Use to make tokoroten or kanten."
                                            },
                                            {
                                                "example_id": "fb8b2d20-5f4a-40e8-9156-2765454c61d8",
                                                "sense_id": "716de282-2f78-3428-8b48-cda778a37874",
                                                "text": "Limu manauea (Hawaii); agar-agar (Philippines) / direct human food; source of food-grade agar; used in the production of tokoroten"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
