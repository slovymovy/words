                    "sense_definition": "Dunne aardappelschijfjes, gebakken in vet of olie, die als hartige snack worden gegeten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "snack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een grote zak <w>chips</w> gekocht voor de filmavond.",
                            "target_lang_translations": {
                                "en": "I bought a big bag of <w>potato chips</w> for movie night.",
                                "ru": "Я купил большую пачку <w>чипсов</w> для киновечера.",
                                "pl": "Kupiłem dużą paczkę <w>chipsów</w> na wieczór filmowy.",
                                "de": "Ich habe eine große Tüte <w>Chips</w> für den Filmabend gekauft.",
                                "fr": "J'ai acheté un grand paquet de <w>chips</w> pour la soirée cinéma.",
                                "it": "Ho comprato un grande sacchetto di <w>patatine</w> per la serata cinema.",
                                "cs": "Koupil jsem velký sáček <w>brambůrků</w> na filmový večer.",
                                "tr": "Film gecesi için büyük bir paket <w>cips</w> aldım.",
                                "es": "He comprado una bolsa grande de <w>patatas fritas</w> para la noche de películas."
                            }
                        },
                        {
                            "text": "Op verjaardagen staan er vaak schaaltjes met nootjes en <w>chips</w> op tafel.",
                            "target_lang_translations": {
                                "en": "At birthdays, there are often bowls of nuts and <w>crisps</w> on the table.",
                                "ru": "На днях рождения на столе часто стоят миски с орешками и <w>чипсами</w>.",
                                "pl": "Na urodzinach na stole często stoją miseczki z orzeszkami i <w>chipsami</w>.",
                                "de": "An Geburtstagen stehen oft Schälchen mit Nüssen und <w>Chips</w> auf dem Tisch.",
                                "fr": "Lors des anniversaires, il y a souvent des bols de noix et de <w>chips</w> sur la table.",
                                "it": "Ai compleanni ci sono spesso ciotole con noccioline e <w>patatine</w> sul tavolo.",
                                "cs": "Na narozeninách bývají na stole často misky s oříšky a <w>brambůrkami</w>.",
                                "tr": "Doğum günlerinde masada genellikle kuruyemiş ve <w>cips</w> kaseleri bulunur.",
                                "es": "En los cumpleaños suele haber cuencos con frutos secos y <w>patatas fritas</w> sobre la mesa."
                            }
                        }
