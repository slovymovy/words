                "forms": [],
                "senses": [
                    {
                        "sense_id": "73b0879f-7f4f-3128-a18c-00b7c1a3e486",
                        "entry_id": "3604184a-fbef-341e-8c1a-3777b65a8734",
                        "glosses": [
                            "An epithet of Hecate (daughter of Perses)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa391b1c-bdf2-4977-83e4-29f7bae37d34",
                                "sense_id": "73b0879f-7f4f-3128-a18c-00b7c1a3e486",
                                "text": "It was not confined to the Male Fury, but belonged also to Medea, the Perseid Hecate or Fury of Colchis, […]"
                            },
                            {
                                "example_id": "ac94642f-84fa-4029-8a09-ce63814421df",
                                "sense_id": "73b0879f-7f4f-3128-a18c-00b7c1a3e486",
                                "text": "Then to the shrine of Perseid Hecate,² / Concealed by forest shades, she boldly went, / Her passions on the wane. But when she there / Saw Aeson's son, her embers flamed anew!"
                            }
                        ]
                    }
                ],
