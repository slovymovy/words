                ],
                "senses": [
                    {
                        "sense_id": "48145ed1-05a8-319e-b702-8eff237344c9",
                        "entry_id": "2d43a72c-bbe5-3ab2-a7b0-30048439a1ff",
                        "glosses": [
                            "Continuous; uninterrupted; continued without break or interruption."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6ba71e2e-b447-4c51-9dc0-3585be096eb9",
                                "sense_id": "48145ed1-05a8-319e-b702-8eff237344c9",
                                "text": "Childish in some, terrible in others; to be derided in one, pitied or admired in another; to him by fits, to a second continuate: and howsoever these symptoms be common and incident to all persons, yet they are the most remarkable, frequent, furious, and violent in melancholy men."
                            },
                            {
                                "example_id": "60545f7d-9cd4-4ebe-a605-51fd7de2869f",
                                "sense_id": "48145ed1-05a8-319e-b702-8eff237344c9",
                                "text": "An untirable and continuate goodness."
                            },
                            {
                                "example_id": "2538dc3d-93d8-476a-b508-a4766e5ead11",
                                "sense_id": "48145ed1-05a8-319e-b702-8eff237344c9",
                                "text": "We are of Him and in Him, even as though our very flesh and bones should be made continuate with his."
                            }
                        ]
                    },
                    {
                        "sense_id": "fda2b08e-9acd-37cb-9fed-2d32bb407cdc",
                        "entry_id": "2d43a72c-bbe5-3ab2-a7b0-30048439a1ff",
                        "glosses": [
                            "Chronic; long-lasting; long-continued."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
