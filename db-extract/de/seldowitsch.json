                "senses": [
                    {
                        "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                        "entry_id": "491eacc1-bb84-31e0-bdd7-db811a9de459",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c324c52-e1c9-499d-912d-14928216ac32",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Frau Seldowitsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "89b160f7-2bab-4fe7-ad19-dd6677df9f46",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Herr Seldowitsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fcbaa01a-0ba7-4a56-bd15-bea912a635c4",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Die Seldowitschs fliegen heute nach Wien."
                            },
                            {
                                "example_id": "f03f46a2-30cd-46a6-a1ec-802e40bfa926",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Der Seldowitsch trägt nie die Schals, die die Seldowitsch ihm strickt."
                            },
                            {
                                "example_id": "912a956f-329c-48c2-9043-4b6bc29403c5",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seldowitsch kommt, geht der Herr Seldowitsch.“"
                            },
                            {
                                "example_id": "e07a3efb-ceeb-4365-9954-2b12b068af60",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Seldowitsch kommt und geht."
                            },
                            {
                                "example_id": "18406252-8e9c-4f35-bc95-eb872cfdcd05",
                                "sense_id": "697f51b2-e5d9-3e06-ad34-4ee103650791",
                                "text": "Seldowitschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
