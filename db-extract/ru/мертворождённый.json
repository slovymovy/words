                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stillborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                                        "entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                                        "glosses": [
                                            "Dead at birth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906a7daa-8a7e-4e58-a1a6-d64727c42b63",
                                                "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                                                "text": "Queen Anne, before Elizabeth, bore a still-born son."
                                            },
                                            {
                                                "example_id": "2a2fdd26-7a80-4e7b-86ad-1f3516f3cdca",
                                                "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                                                "text": "1978, Holy Bible (New International Version), Job 3:16,\nOr why was I not hidden in the ground like a stillborn child, like an infant who never saw the light of day?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                                        "entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                                        "glosses": [
                                            "Ignored, without influence, or unsuccessful from the outset; abortive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfdf7129-f863-455b-b4ea-98aa478097b7",
                                                "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                                                "text": "This, gentlemen, is a list of the joint-stock companies created last year. . . . Of these some were stillborn, but the majority hold the market."
                                            },
                                            {
                                                "example_id": "f57558da-ac16-40f5-857b-04845ac33bb4",
                                                "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                                                "text": "His lips framed themselves to whistle the first bars of a popular song, but the sound died stillborn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stillborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40cc19b8-7fc8-3491-8374-c286dc215b0d",
                                        "entry_id": "f2b85c19-1a23-3119-8bb1-89d347b3b9d6",
                                        "glosses": [
                                            "A baby that is born dead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88594d5-cdca-4ab7-8b60-aeed81b2acce",
                                                "sense_id": "40cc19b8-7fc8-3491-8374-c286dc215b0d",
                                                "text": "About 35% of stillborns are discovered to have major structural anomalies by chromosomal studies and autopsy findings."
                                            }
                                        ]
