                                    {
                                        "sense_id": "00234733-3ca2-3281-a9ae-153a3e43a562",
                                        "entry_id": "5c580150-81cc-39a4-8137-8412d400eac1",
                                        "glosses": [
                                            "физ., редк. общее название для электрона [1] и позитрона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34f7129-0226-4113-8ad9-6780a3ac2a93",
                                                "sense_id": "00234733-3ca2-3281-a9ae-153a3e43a562",
                                                "text": "Великий Дирак, получив своё знаменитое уравнение для положительно и отрицательно заряженного электрона, долго боялся ему поверить."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "электрон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ac735352-7992-3e4a-bbdb-baa8989d182c",
                                        "entry_id": "8c60edb6-9b09-3c6a-8e31-ebb6d5246754",
                                        "glosses": [
                                            "устар. сплав золота и серебра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e9c4f3-47e8-42fa-b055-16c4c2a348ad",
                                                "sense_id": "ac735352-7992-3e4a-bbdb-baa8989d182c",
                                                "text": "По тяжести это могло быть золотом или электроном."
                                            },
                                            {
                                                "example_id": "b5005762-3676-4434-a0bc-f6bdbd3dde50",
                                                "sense_id": "ac735352-7992-3e4a-bbdb-baa8989d182c",
                                                "text": "Есть такой сплав — электрон, из которого в античности любили изготавливать драгоценные предметы."
                                            }
                                        ]
                                    },
