                "senses": [
                    {
                        "sense_id": "6e8f4170-8b9e-3c45-9045-2fed3e6e253e",
                        "entry_id": "16634853-cb84-33ea-87a7-6f7a9555eab6",
                        "glosses": [
                            "État intermédiaire, pour un animal sauvage, entre captivité et liberté, dans les zoos et les autres parcs animaliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d2a5b6d-64f2-4867-9976-48e38ed17b56",
                                "sense_id": "6e8f4170-8b9e-3c45-9045-2fed3e6e253e",
                                "text": "Ce sont des inconvénients mineurs comparés aux avantages que présente sur les zoos ordinaires cette nouvelle conception d’une semi-captivité moins cruelle pour les animaux et plus significative pour le public."
                            },
                            {
                                "example_id": "8e2e6917-3832-4939-a3c9-91b0880646f5",
                                "sense_id": "6e8f4170-8b9e-3c45-9045-2fed3e6e253e",
                                "text": "Un programme est en cours pour le cheval de Przewalski, avec un troupeau en semi-captivité dans le Parc national des Cévennes, avant l’étape décisive de la réintroduction en Mongolie."
                            },
                            {
                                "example_id": "6b5150b4-f57b-4f62-a516-d0a9e5dd4ef8",
                                "sense_id": "6e8f4170-8b9e-3c45-9045-2fed3e6e253e",
                                "text": "En France, l’expression courante de « semi-liberté » témoigne d’une semi-captivité complémentaire."
                            },
                            {
                                "example_id": "217ff43f-c49e-4647-bfcc-f65a7b2abe93",
                                "sense_id": "6e8f4170-8b9e-3c45-9045-2fed3e6e253e",
                                "text": "Incapables de retourner en milieu naturel, ces cétacés pourraient ainsi finir leurs jours en semi-captivité."
                            }
                        ]
                    }
                ],
