                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd91a31-c666-4105-93e5-84f1c0c65c1c",
                                "sense_id": "84ccde18-0503-3bd4-b2cc-d317b146fad0",
                                "text": "Bij de begroting is daarom op basis van zeer beperkte inzichten nog rekening gehouden met forse tekorten op het sociaal domein voor in totaal ruim 2,3 miljoen euro. Na de financiële analyse van het startjaar, blijkt dat de soep minder heet wordt gegeten als hij werd opgediend."
                            }
