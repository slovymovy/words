                        "examples": [
                            {
                                "example_id": "19302ee3-a3ce-4fee-927a-3f9b369f787a",
                                "sense_id": "36ee7f2f-d0c7-3d4c-a96e-2825c2b77f77",
                                "text": "Dans son discours déjà mentionné, Camilo José Cela place La España negra de Solana sous les signes complémentaires de l’héliophobie et de la claustrophilie."
                            },
                            {
                                "example_id": "492dfaa3-d1d4-4a15-8700-a8a7ff1b14af",
                                "sense_id": "36ee7f2f-d0c7-3d4c-a96e-2825c2b77f77",
                                "text": "Lieu caché par excellence (il l’appelle encore « ma retraite »), la petite maison devient le symbole d’une spatialité spécifique : celle où l’art en général, la créativité littéraire en particulier, ne se conçoit que par rapport à l’idée de claustrophilie."
                            }
                        ]
