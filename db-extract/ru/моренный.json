                ],
                "translations": [
                    {
                        "translation_id": "40dc94b0-133e-4377-ab1b-32fabbfde8a3",
                        "source_entry_id": "66e61f54-007e-399b-9ed7-8cff92be0c49",
                        "source_sense_id": "3e8f6223-4ce1-33d9-b220-e2c919b53cb1",
                        "target_lang_word": "morainal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morainal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5488fb-9989-37b5-a09e-c5c8015583cd",
                                        "entry_id": "3228175e-c4d7-3f71-a7b7-3200d09683d8",
                                        "glosses": [
                                            "Of or pertaining to a moraine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a50a9a1-e9eb-4c47-b484-c507771457d1",
                                                "sense_id": "eb5488fb-9989-37b5-a09e-c5c8015583cd",
                                                "text": "Below the glaciers throughout the entire Wind River Range great numbers of morainal lakes are found."
                                            },
                                            {
                                                "example_id": "5991aaf0-f146-456f-8ab3-fa12f6a57681",
                                                "sense_id": "eb5488fb-9989-37b5-a09e-c5c8015583cd",
                                                "text": "Grand Lake, probably the largest, is about three miles long by one mile wide. Its basin appears to be largely due to a morainal dam."
                                            },
                                            {
                                                "example_id": "d0beafc2-b7e4-402e-908c-dab8e7a334a6",
                                                "sense_id": "eb5488fb-9989-37b5-a09e-c5c8015583cd",
                                                "text": "The ice stopped at Perth Amboy, Metuchen, North Plainfield, Madison, Morristown—leaving a sinuous, morainal, lobate line that not only connects these New Jersey towns but keeps on going to the Rocky Mountains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
