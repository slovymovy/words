                "senses": [
                    {
                        "sense_id": "a0ae9de2-c98a-31b9-8aec-05d85d62f3fb",
                        "entry_id": "ab5c2520-7044-392b-b961-386f50d5364d",
                        "glosses": [
                            "nadanie mocy prawnej, uznanie czegoś za zgodne z prawem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb65902-8b01-445a-9fc4-1aeed389beac",
                                "sense_id": "a0ae9de2-c98a-31b9-8aec-05d85d62f3fb",
                                "text": "Ze względu na cierpienie i śmierć nieuchronnie z nim związane jesteśmy zdecydowanie przeciwni tzw. ubojowi rytualnemu, a legalizację tego procederu w Polsce uważamy za kulturowy krok wstecz."
                            },
                            {
                                "example_id": "9dc967e6-0f8f-42bd-af2c-b878541d22c8",
                                "sense_id": "a0ae9de2-c98a-31b9-8aec-05d85d62f3fb",
                                "text": "Politycy obawiają się, że wprowadzenie nowych zasad zawierania małżeństwa spowoduje legalizację w Niemczech wielożeństwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
