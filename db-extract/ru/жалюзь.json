                            {
                                "example_id": "fb461348-82c3-4a44-8e0a-415da57c0ed6",
                                "sense_id": "5d3afb2c-02ca-3113-8eb8-638af72ed7c3",
                                "text": "Надо заменить вот эту жалюзь и шторы не выкидывать."
                            },
                            {
                                "example_id": "fd9f96fd-7481-4483-87b5-3fbecbb65d52",
                                "sense_id": "5d3afb2c-02ca-3113-8eb8-638af72ed7c3",
                                "text": "Протри каждую жалюзь."
                            },
                            {
                                "example_id": "8b9ab52c-e785-4bfa-9bb7-6245afc86723",
                                "sense_id": "5d3afb2c-02ca-3113-8eb8-638af72ed7c3",
                                "text": "Вот этой жалюзью, и — тебе по дурной башке настучать."
                            }
                        ]
