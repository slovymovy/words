        "de-extract.jsonl": [
            {
                "entry_id": "3fa3e622-9a5f-38d8-a03c-ec4371e14442",
                "word": "pyjamas",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0b7bacf-55e2-383d-90ed-1f676df90744",
                        "entry_id": "3fa3e622-9a5f-38d8-a03c-ec4371e14442",
                        "glosses": [
                            "hauptsächlich britisch: Pyjama"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217db018-2979-4bec-8360-9ae906aec786",
                                "sense_id": "c0b7bacf-55e2-383d-90ed-1f676df90744",
                                "text": "I don't like striped pyjamas, they look so old-fashioned.",
                                "translation": "Ich mag keine gestreiften Schlafanzüge, die sehen so altmodisch aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3d38094-ccb7-4d8b-a567-0b24862adb64",
                        "source_entry_id": "3fa3e622-9a5f-38d8-a03c-ec4371e14442",
                        "source_sense_id": "c0b7bacf-55e2-383d-90ed-1f676df90744",
                        "source_sense_description": "hauptsächlich britisch: Pyjama",
                        "target_lang_word": "Pyjama",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyjama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                        "entry_id": "98b2b9ea-a7c1-31b6-8f9e-153c87e49a9e",
                                        "glosses": [
                                            "zumeist aus leichtem Stoff gefertigtes sowie aus zusammengehörender Hose und Jacke bestehendes Kleidungsstück, das zum Schlafen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe771f3-8b77-462e-a3b3-9d5b32128e93",
                                                "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                                "text": "Das alte Pyjama, das du trägst, ist voller Löcher."
                                            },
                                            {
                                                "example_id": "14385416-a1f4-455c-a273-91a56fe63986",
                                                "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                                "text": "„Sie lagen im Bett, Billie in meinem: sie hatte einen knallbunten Pyjama an, auf dem hundert Blumen blühten, jetzt sah sie aus, wie die wilde Lieblingsfrau eines Maharadschas… sie lächelte ruhig in ihr Rätselblatt.“"
                                            },
                                            {
                                                "example_id": "4ca4907a-8fcd-44a5-979e-5fdc2d821237",
                                                "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                                "text": "„Selbst ohne Uniform, in gestreiften Pyjamas und Pantoffeln, bewegten sie sich anders als Zivilisten.“"
                                            },
                                            {
                                                "example_id": "614f4c3a-0919-464d-ace7-11834d6e53bd",
                                                "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                                "text": "„Nach einer Weile wendet sie die Pyjamas um.“"
                                            },
                                            {
                                                "example_id": "e064f362-1e1b-4507-b4a0-f186e14eab2c",
                                                "sense_id": "6dfb0472-d16b-3402-8880-5cd46db76a02",
                                                "text": "„Ihr Pyjama bestand aus einer schwarzen, eng geschnittenen Samthose und einer bunt bemalten, rotseidenen Jacke mit Gürtel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9136221-b7b9-4a66-aba1-9dca4c9071d3",
                        "source_entry_id": "3fa3e622-9a5f-38d8-a03c-ec4371e14442",
                        "source_sense_id": "c0b7bacf-55e2-383d-90ed-1f676df90744",
                        "source_sense_description": "hauptsächlich britisch: Pyjama",
                        "target_lang_word": "Schlafanzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafanzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                        "entry_id": "6c36f4d1-197f-3c9f-8ae3-282913ef93d3",
                                        "glosses": [
                                            "für die Nachtruhe vorgesehene Kleidung, oft aus Hose und Oberteil bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd01254-46ce-49e3-b3b0-dd786d0f7dac",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "Vor Jahren besagte eine statistische Erhebung, dass 37 % der Menschen nachts keinen Schlafanzug tragen."
                                            },
                                            {
                                                "example_id": "7a14013e-4828-4720-b003-d3d61fc5eed9",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "Noch im Schlafanzug lief er vor die Tür, als er die Sirene hörte."
                                            },
                                            {
                                                "example_id": "2ed5c755-cc19-4118-83ca-cb877185cc4e",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "Um zehn Uhr morgens hatte sie immer noch ihren Schlafanzug an und telefonierte seelenruhig mit einer Freundin."
                                            },
                                            {
                                                "example_id": "017cc52d-7b6e-4252-9e83-00e1780428d7",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "Verschenken Sie etwa zu Weihnachten Socken, Krawatten und Schlafanzüge?"
                                            },
                                            {
                                                "example_id": "b4a1c1d9-518a-4c4e-ab5f-e4a89e0a5c6a",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "„Ins Krankenhaus bekam ich meinen blauen Schlafanzug mit.“"
                                            },
                                            {
                                                "example_id": "80e0b9be-938f-49db-85d8-346ae7061e38",
                                                "sense_id": "a0d72c49-6b88-38e3-849b-e6ae0dccf44b",
                                                "text": "„Socken und Pullover überm Schlafanzug kletterte er ins Bett und rollte sich zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e197ff12-515b-4acf-a469-dd3eb56eb6df",
                        "source_entry_id": "3fa3e622-9a5f-38d8-a03c-ec4371e14442",
                        "source_sense_id": "c0b7bacf-55e2-383d-90ed-1f676df90744",
                        "source_sense_description": "hauptsächlich britisch: Pyjama",
                        "target_lang_word": "pyjama",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyjama",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                        "entry_id": "e31d0eb4-2ec7-3e2b-bd6a-a68f825139a1",
                                        "glosses": [
                                            "Costume d’intérieur fait le plus souvent d’une étoffe légère, qui se compose d’une veste non ajustée et d’un pantalon très ample, et qui se porte aussi comme vêtement de nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70db9288-51a8-4b51-8212-ad886c76ab16",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Il agit donc sur la tirette, le rideau se releva brusquement, et alors, à la stupéfaction générale, on vit saint Jean-Baptiste, en pyjama bleu de ciel, […]"
                                            },
                                            {
                                                "example_id": "9bf728b3-621d-4860-b8f4-3c9b13baa3f2",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Elle rangeait sa chambre tous les matins, et elle éprouvait un ravissement inconnu à caresser la soie de son pyjama."
                                            },
                                            {
                                                "example_id": "3292377a-cd29-49dc-ad2b-705a1cd87b70",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "On apercevait une grande pièce en désordre, la table encore dressée pour le petit déjeuner, un pyjama jeté sur un divan."
                                            },
                                            {
                                                "example_id": "452cd15d-b2f5-4f44-9529-514e945a64fe",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Je n'ai jamais compris pourquoi les pyjamas avaient des poches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2a6a60-3163-358b-8545-44c3bbc2ba77",
                                        "entry_id": "e31d0eb4-2ec7-3e2b-bd6a-a68f825139a1",
                                        "glosses": [
                                            "Costume porté dans les années 1930 par certaines femmes dans les stations balnéaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4c7318-f0c5-4fc0-b645-02ac4cab43f3",
                                                "sense_id": "dc2a6a60-3163-358b-8545-44c3bbc2ba77",
                                                "text": "Les femmes portaient alors des pyjamas de plage très seyants, de couleurs variées : blancs, bleu marine, bleu turquoise, mais cachant le corps que l’on devinait souple, détendu, attirant d’abandon sensuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
