                                        "sense_id": "c87ed1b7-2276-3c81-8e74-13ff5b431cef",
                                        "entry_id": "2236baae-badf-3d1b-bd51-aabce320e054",
                                        "glosses": [
                                            "An early termination of a mission, action, or procedure in relation to missiles or spacecraft; the craft making such a mission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f801209-f433-4cd7-bf39-ac6907472fb5",
                                                "sense_id": "c87ed1b7-2276-3c81-8e74-13ff5b431cef",
                                                "text": "We've had aborts on three of our last seven launches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9fdc861-1756-3f44-8366-c175061a7ad1",
                                        "entry_id": "2236baae-badf-3d1b-bd51-aabce320e054",
                                        "glosses": [
                                            "The function used to abort a process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d803084-f651-310c-bd88-0ab8ed4733d6",
                                        "entry_id": "2236baae-badf-3d1b-bd51-aabce320e054",
                                        "glosses": [
                                            "An event in which a process is aborted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e533161-bdec-4bdb-85b8-ba033c53fee3",
                                                "sense_id": "7d803084-f651-310c-bd88-0ab8ed4733d6",
                                                "text": "We've had three aborts over the last two days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff404db-57b3-3a8f-9c42-7fcf03b9ba63",
                                        "entry_id": "2236baae-badf-3d1b-bd51-aabce320e054",
                                        "glosses": [
                                            "The product of a miscarriage; an aborted offspring; an abortion."
