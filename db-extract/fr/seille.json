                                    {
                                        "sense_id": "a5465385-54f3-3077-8c06-af25071a7ae2",
                                        "entry_id": "db81b85e-2485-3e96-94d2-39ee05e3f75b",
                                        "glosses": [
                                            "To categorize (data) by splitting it into buckets, or groups of related items."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd2ae40-344e-40ee-a51a-a1dd8809ca7c",
                                                "sense_id": "a5465385-54f3-3077-8c06-af25071a7ae2",
                                                "text": "These candidates are then bucketed into a discretized version of the space of all possible lines."
                                            },
                                            {
                                                "example_id": "07403274-8627-4dc0-a241-240e147343bc",
                                                "sense_id": "a5465385-54f3-3077-8c06-af25071a7ae2",
                                                "text": "Thus, sorting each bucket takes O(1) times. The total effort of bucketing, sorting buckets, and concotenating^([sic]) the sorted buckets together is O(n)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433dec6f-86a0-33bb-8f60-a8cfde016578",
                                        "entry_id": "db81b85e-2485-3e96-94d2-39ee05e3f75b",
                                        "glosses": [
