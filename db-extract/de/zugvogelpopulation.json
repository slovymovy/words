                    {
                        "sense_id": "e9905302-2d3a-3390-ad88-954d603129f0",
                        "entry_id": "55f7dc60-32fa-311e-9aeb-d89251d70f9c",
                        "glosses": [
                            "Gesamtheit der Zugvögel verschiedener Arten in einem Biotop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a4a62e-81d4-4451-9186-33a7d667542f",
                                "sense_id": "e9905302-2d3a-3390-ad88-954d603129f0",
                                "text": "„Was sollte ihm die für dieses Habitat übliche Zugvogelpopulation mit ihrem raschen, fast rhythmischen Wechsel noch an Neuem bieten?“"
                            },
                            {
                                "example_id": "61d388f2-46b9-4c96-8acb-5512f41a7a0e",
                                "sense_id": "e9905302-2d3a-3390-ad88-954d603129f0",
                                "text": "„Der Umweltdachverband und BirdLife Österreich haben am Donnerstag in einer Aussendung davor gewarnt, dass die Zugvogelpopulation in Österreich zunehmend sinkt.“"
                            },
                            {
                                "example_id": "f350e374-f8a7-4f62-995c-1bd2a0443414",
                                "sense_id": "e9905302-2d3a-3390-ad88-954d603129f0",
                                "text": "„Aus einer reinen Zugvogelpopulation konnte man Standvögel züchten und umgekehrt.“"
                            }
                        ],
