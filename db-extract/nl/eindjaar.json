                        "examples": [
                            {
                                "example_id": "1d2a7b91-9820-4470-ba17-1e7f87918545",
                                "sense_id": "2589fe10-8cf9-3607-8499-1dba81abea48",
                                "text": "Alle problemen rond de luchtkwaliteit in Gelderland zijn volgens Gedeputeerde Staten (GS) in 2015 opgelost. Een voorwaarde is wel dat het Rijk voldoende geld beschikbaar stelt en de Europese Unie (EU) uitstel geeft voor het voldoen aan de strenge normen voor het terugdringen van fijnstof en stikstofdioxide. Brussel stelt 2010 als eindjaar."
                            },
                            {
                                "example_id": "a8a77b39-ade5-42fc-866d-793ffe9d3ba9",
                                "sense_id": "2589fe10-8cf9-3607-8499-1dba81abea48",
                                "text": "Van het ruime begrotingsoverschot van 1,6 procent dat het CPB eerder nog raamde blijft 0,5 procent over in het eindjaar van dit kabinet. Tegelijkertijd slaat het houdbaarheidsoverschot om in een –tekort: dat betekent dat er na de komende kabinetsperiode aanvullende hervormingen, bezuinigingen of lastenverzwaringen nodig zullen zijn om de verzorgingsstaat na 2021 op peil te kunnen houden."
                            }
                        ]
                    }
