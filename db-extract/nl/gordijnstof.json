                "senses": [
                    {
                        "sense_id": "5379f331-e3bb-335b-a31e-f30726b7c1f0",
                        "entry_id": "ce17dad7-bee3-3521-bd03-17d824b41db6",
                        "glosses": [
                            "dik weefsel dat men kan gebruiken voor het maken van gordijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d7c95e-33e3-462e-b980-d7c714172f70",
                                "sense_id": "5379f331-e3bb-335b-a31e-f30726b7c1f0",
                                "text": "Mevrouw Noppen droeg een lange patchworkjurk, een collage van een heleboel verschillende stofsoorten - veel tinten roze en rood, zwartwitte gordijnstof, gaas, stukken met gouddraad en ander geglitter doorschoten - een soort lappenjurk die haar zwaar aangezette heupen alleen maar schonkiger maakte."
                            },
                            {
                                "example_id": "037193fb-a348-46c6-8bcc-4b5e6b3f6bb6",
                                "sense_id": "5379f331-e3bb-335b-a31e-f30726b7c1f0",
                                "text": "En liefhebbers, zoals zij, willen niet in gordijnstof rondlopen. De pakjes moeten net zo zijn als op tv, de baard niet van echt te onderscheiden. Samen begonnen ze in 2005 die markt van kostuums te bedienen, in 2009 stapte Martino Vos eruit en ging Lanjouw alleen verder."
                            }
                        ]
                    }
