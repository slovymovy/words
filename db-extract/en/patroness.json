                                        "entry_id": "3300339e-d8a3-37f2-951c-d3f482784588",
                                        "glosses": [
                                            "Dame, die mit ihrem (bekannten) Namen als offizielle Unterstützerin für eine Veranstaltung, eine Organisation, ein Projekt etc. in Erscheinung tritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a6688b-9e4d-4aaa-8c4c-61410f325bab",
                                                "sense_id": "151f99e4-79e9-30de-b514-8c3e3c2626f0",
                                                "text": "„Als Folge ihres Engagements für den Taubenrennsport ist die Queen Schirmherrin mehrerer sogenannter Racing Societies.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
