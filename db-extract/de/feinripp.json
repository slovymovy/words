                        ],
                        "examples": [
                            {
                                "example_id": "6bfae169-d613-4b23-9e5b-af09f1ace60e",
                                "sense_id": "a7977468-4f8f-365b-b1c4-b2393449cc56",
                                "text": "„Feinripp ist die symbolgewordene Spießigkeit eines Mannes, der gern Bier trinkt und dabei Sportschau guckt.“"
                            },
                            {
                                "example_id": "806389d3-e779-4deb-86d2-ed033d117cfd",
                                "sense_id": "a7977468-4f8f-365b-b1c4-b2393449cc56",
                                "text": "„Spießig ist, wer Feinripp trägt oder Jesuslatschen, als Mann eine rasierte Glatze, Ohrring oder eine rotgepunktete Fliege zum Smoking.“"
                            }
                        ],
