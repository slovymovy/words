                        "examples": [
                            {
                                "example_id": "d0ecca24-daa8-4d4f-a617-98a7fe9cadc0",
                                "sense_id": "6d456aa1-e2a1-388a-9b46-3835fc1cbf1c",
                                "text": "Het ziekteverzuim stijgt. Dat zegt ArboNed, een van de grootste arbodiensten in Nederland. Het gemiddelde verzuimpercentage onder werknemers steeg in september naar 4,2 procent, in augustus was dat nog 3,9 procent. Het gaat vooral om een toename van luchtwegklachten."
                            },
                            {
                                "example_id": "6a2e2b95-7b00-48fc-8da5-2d89bb696a9f",
                                "sense_id": "6d456aa1-e2a1-388a-9b46-3835fc1cbf1c",
                                "text": "Volgens de politie ligt het verzuimpercentage bij de gehele organisatie op 6 procent. De politie wil de cijfers verder gaan onderzoeken om te kijken hoe de toename in het aantal ziekmeldingen onder operationele agenten te verklaren is. Een woordvoerder zegt dat er binnen de politie geen signalen zijn die erop wijzen dat het ziekteverzuim dit jaar hoger is dan andere jaren."
                            }
                        ]
                    }
