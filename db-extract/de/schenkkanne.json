                        "examples": [
                            {
                                "example_id": "13780378-95a8-41d1-92e9-4dd8a787b68c",
                                "sense_id": "5c7ca685-1c62-3ef6-baf4-a1269ac9cb6f",
                                "text": "„Eine bronzene Schenkkanne für Wein oder Bier wirkt für das Auge zwar pompös, taugte aber, da aus mehreren Stücken zusammengebaut, kaum für den Gebrauch.“"
                            },
                            {
                                "example_id": "14e22669-b3e8-49f6-812e-8147a172a201",
                                "sense_id": "5c7ca685-1c62-3ef6-baf4-a1269ac9cb6f",
                                "text": "„Stunden war die Tafel aufgehoben und warmes Wasser zum Händewaschen in einer goldenen Schenkkanne gereicht worden.“"
                            }
                        ],
