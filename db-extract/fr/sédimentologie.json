                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7497e185-0eba-4fe1-aa52-ae9f319ff3ee",
                        "entry_id": "1874199f-5536-3365-9c7a-043cfef06035",
                        "tags": [
                            "plural"
