                        "glosses": [
                            "Essuyer avec du Sopalin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4c47b0-0021-4261-ac91-52e989f0225f",
                                "sense_id": "bb868ecb-7301-371f-8f59-b930d650a968",
                                "text": "Brossez, frottez, « sopalinez », comme vous voudrez, vos champignons, afin de leur ôter la terre mais surtout sans les mouiller."
                            },
                            {
                                "example_id": "6978ee25-4007-4c2f-a518-951ae6f58d3b",
                                "sense_id": "bb868ecb-7301-371f-8f59-b930d650a968",
                                "text": "Je vais lui sopaliner sa cage"
                            },
                            {
                                "example_id": "4f7cfe1f-3dd0-46d0-9e3a-d258d071d668",
                                "sense_id": "bb868ecb-7301-371f-8f59-b930d650a968",
                                "text": "Sopaliner la maison…j’y avais pas pensé…Bonne idée !"
                            }
                        ]
                    }
