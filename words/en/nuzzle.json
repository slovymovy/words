{
    "word_family": [
        "nuzzle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c806a96-4139-3a48-a329-95798e226fdf",
                    "sense_definition": "To rub or touch someone or something gently with the nose or face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse <w>nuzzled</w> its foal’s head gently to wake him up.",
                            "target_lang_translations": {
                                "cs": "Kůň jemně <w>otřel svůj nos o hlavu</w> hříběte, aby ho probudil."
                            }
                        },
                        {
                            "text": "The puppy <w>nuzzled</w> against my hand to show affection.",
                            "target_lang_translations": {
                                "cs": "Štěně se <w>otřelo nosem</w> o mou ruku, aby projevilo náklonnost."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuzzle"
                    ],
                    "common_phrases": [
                        "nuzzle against"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jemně se otírat nebo dotýkat někoho či něčeho nosem nebo obličejem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otírat se nosem",
                                "target_lang_sense_clarification": "vyjádření fyzického kontaktu zvířete nebo člověka"
                            },
                            {
                                "target_lang_word": "šťouchat nosem",
                                "target_lang_sense_clarification": "jemný kontakt nosem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88820b20-47fa-34d8-89ff-ee2b80a04dce",
                    "sense_definition": "To press affectionately against someone or something to show comfort or closeness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby <w>nuzzled</w> up to her mother for warmth.",
                            "target_lang_translations": {
                                "cs": "Miminko se <w>přitulilo</w> k matce, aby se zahřálo."
                            }
                        },
                        {
                            "text": "The cat <w>nuzzled</w> up to my leg while I was reading.",
                            "target_lang_translations": {
                                "cs": "Kočka se mi <w>otřela o nohu</w>, zatímco jsem četl."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuzzle up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přitisknout se k někomu nebo něčemu z náklonnosti pro pocit bezpečí nebo blízkosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tulit se",
                                "target_lang_sense_clarification": "vyjádření náklonnosti a blízkosti"
                            },
                            {
                                "target_lang_word": "přitisknout se",
                                "target_lang_sense_clarification": "fyzické přiblížení pro útěchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33f1bd95-570d-3193-b000-82f6caebf8f8",
                    "sense_definition": "To push the nose or snout into the ground to dig for food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pigs were <w>nuzzling</w> in the dirt looking for acorns.",
                            "target_lang_translations": {
                                "cs": "Prasata <w>ryla</w> v hlíně a hledala žaludy."
                            }
                        },
                        {
                            "text": "Wild boars often <w>nuzzle</w> the forest floor to find roots.",
                            "target_lang_translations": {
                                "cs": "Divoká prasata často <w>ryjí</w> lesní půdu, aby našla kořínky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rýt nosem nebo čenichem v zemi při hledání potravy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rýt",
                                "target_lang_sense_clarification": "činnost zvířat při hledání potravy v zemi"
                            },
                            {
                                "target_lang_word": "hrabat čenichem",
                                "target_lang_sense_clarification": "specifický pohyb čenichem v zemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee13023f-eef8-33dd-b71d-41cc22b80c10",
                    "sense_definition": "To settle or lie comfortably and snugly in a bed or nest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitten <w>nuzzled</w> down into the soft blanket.",
                            "target_lang_translations": {
                                "cs": "Kotě se <w>zavrtalo</w> do měkké deky."
                            }
                        },
                        {
                            "text": "After a long day, she <w>nuzzled</w> down into her pillows.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém dni se <w>zachumlala</w> do polštářů."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuzzle down"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zavrtat se nebo se pohodlně usadit do měkkého podkladu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zavrtat se",
                                "target_lang_sense_clarification": "pohodlné usazení do lůžka či přikrývky"
                            },
                            {
                                "target_lang_word": "zachumlat se",
                                "target_lang_sense_clarification": "pohodlné zachumlání do peřin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38950ebb-9d17-32e5-b3ee-58660498db53",
                    "sense_definition": "An act of rubbing or touching with the nose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse gave a gentle <w>nuzzle</w> to the visitor's hand.",
                            "target_lang_translations": {
                                "cs": "Kůň jemně <w>šťouchl nosem</w> do ruky návštěvníka."
                            }
                        },
                        {
                            "text": "She felt a soft <w>nuzzle</w> from her dog against her arm.",
                            "target_lang_translations": {
                                "cs": "Cítila, jak se jí pes jemně <w>otřel nosem</w> o paži."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt otření nebo doteku nosem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otření nosem",
                                "target_lang_sense_clarification": "podstatné jméno označující dotek nosem"
                            },
                            {
                                "target_lang_word": "šťouchnutí nosem",
                                "target_lang_sense_clarification": "krátký dotek nosem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}