                                        "examples": [
                                            {
                                                "example_id": "3d11b732-b6ff-4c53-bf1d-682ddd1d6a13",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Jeanne de la Motte war 1784 siebenundzwanzig Jahre alt, ihre Haare waren kastanienbraun und wellig, ihre Augen blau und ausdrucksvoll, ihr Lächeln berückend."
                                            },
                                            {
                                                "example_id": "88b11936-4f26-4e82-a0b2-77a3d4fde7d3",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Mit ihrem kastanienbraun gefärbten Haar und dem faltigen Gesicht könnte die Ältere ideal die Schwester des Lebemannes Saki Bey abgeben, von der es im Roman heißt, »ihre Füße steckten in Pantoffeln in der Form weißer Kaninchen«."
                                            },
                                            {
                                                "example_id": "aea485bb-2da1-4763-86a4-f66b156ea9fb",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Das orange gefärbte Gesicht wird von einem langen Backenbarte von glänzender Weisse umgeben mit einer kastanienbraunen Linie über den Augenbrauen."
                                            },
                                            {
                                                "example_id": "0b96d279-cf55-4677-96aa-3bd127de41e3",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Reimer war ein junger, schwarzbrauner Schneidersmann und hatte große kastanienbraune, immer wie mit Traum und Schlaf kämpfende Augen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
