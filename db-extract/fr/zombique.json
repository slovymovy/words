                        "examples": [
                            {
                                "example_id": "27587d2b-403a-4f2a-893d-f18ea0366215",
                                "sense_id": "cb010c9c-5ed1-3049-806c-e0ebb5764281",
                                "text": "Informée du « fond de mort des vivants », du caractère « zombique » de ses congénères, Sand en devient l'infirmière, celle vers qui vont se tourner tous les désirs de guérison, […]."
                            },
                            {
                                "example_id": "267d825e-f798-4139-b869-62fa45af9fb8",
                                "sense_id": "cb010c9c-5ed1-3049-806c-e0ebb5764281",
                                "text": "Féerique fascination d'éberlués zombiques tandis que, plus loin, d'autres sans doute distraits reprenaient dans l'ombre leurs noueuses fornications."
                            }
                        ]
