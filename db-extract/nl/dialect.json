                                                "sense_id": "bb4cf1db-ccee-3aac-9875-3805854d39c1",
                                                "text": "dialetto lombardo, toscano, siciliano, salentino, napoletano, veneto"
                                            },
                                            {
                                                "example_id": "1763dfa6-0399-4010-b6a9-a5467a56b571",
                                                "sense_id": "bb4cf1db-ccee-3aac-9875-3805854d39c1",
                                                "text": "maggiore è la vicinanza di una regione d'Italia con l'Europa centrale, maggiore è la somiglianza di un suo dialetto col tedesco"
                                            }
