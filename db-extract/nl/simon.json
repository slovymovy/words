                                            {
                                                "example_id": "db458d85-1c8d-4e16-801d-b476a2c76e72",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Frau Samuel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0641123c-0494-4d78-ba20-4e48013b155e",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Herr Samuel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0397647e-a68d-466d-8eeb-230179e2cbd6",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Die Samuels fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "44c59e74-e66b-420a-8f49-aac73a9e002a",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Der Samuel trägt nie die Schals, die die Samuel ihm strickt."
                                            },
                                            {
                                                "example_id": "19e7aaec-a65b-449f-9dc2-e8ac90c1dc7b",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Samuel kommt, geht der Herr Samuel.“"
                                            },
                                            {
                                                "example_id": "a80c6e80-b8e8-4121-9afa-c5befbc1ba5f",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Samuel kommt und geht."
                                            },
                                            {
                                                "example_id": "04d9073b-1a79-4134-aa68-5f88f0d68e35",
                                                "sense_id": "11bd7c18-266b-3acb-aca8-8778da31f817",
                                                "text": "Samuels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
