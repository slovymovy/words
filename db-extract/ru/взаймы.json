        "ru-extract.jsonl": [
            {
                "entry_id": "2db5a98e-a9e6-3e31-b958-4e838f7285bd",
                "word": "взаймы",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b426b9f3-4c9c-3bb1-9963-1130fe452d53",
                        "entry_id": "2db5a98e-a9e6-3e31-b958-4e838f7285bd",
                        "glosses": [
                            "в долг, с условием последующей отдачи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279fd09b-99fe-4484-8f83-98b8746ee6c2",
                                "sense_id": "b426b9f3-4c9c-3bb1-9963-1130fe452d53",
                                "text": "А то, сударь, что я никогда не даю денег взаймы тем, которые принимают их без счёту."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38695d36-05f3-4ce9-b326-fc0992b3f836",
                        "source_entry_id": "2db5a98e-a9e6-3e31-b958-4e838f7285bd",
                        "source_sense_id": "b426b9f3-4c9c-3bb1-9963-1130fe452d53",
                        "target_lang_word": "on loan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on loan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe56439-4484-3562-959f-726409b083e6",
                                        "entry_id": "36bb7af7-13e8-3bb9-9777-aff50bccbee7",
                                        "glosses": [
                                            "Loaned or lent, not owned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340e397e-166e-4476-b2cf-d6a4743f1ddc",
                                                "sense_id": "bfe56439-4484-3562-959f-726409b083e6",
                                                "text": "An ex-L.S.W.R. 0-6-0 goods engine, No. 0395, and a \"Terrier\" tank-engine, No. 2678, are now on loan."
                                            },
                                            {
                                                "example_id": "98431673-5c34-40ed-93e8-8431d6346f79",
                                                "sense_id": "bfe56439-4484-3562-959f-726409b083e6",
                                                "text": "Shortly thereafter Sugarman learned that the technology behind the pricey sunglasses wasn't on loan from NASA."
                                            },
                                            {
                                                "example_id": "a6f8ce42-7df1-4e6d-833b-612b7eba8df9",
                                                "sense_id": "bfe56439-4484-3562-959f-726409b083e6",
                                                "text": "As you generate your list of references check whether your library holds the books, and if so whether they are on loan."
                                            },
                                            {
                                                "example_id": "8a764f8d-f13a-4c6a-acba-72cbeae6b618",
                                                "sense_id": "bfe56439-4484-3562-959f-726409b083e6",
                                                "text": "Bowman only hinted it was “on loan” from the Chatham Dockyard, so I didn't ask more."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "on loan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34d79de7-ce9a-3c92-9194-4ac6b758f72a",
                                        "entry_id": "d6634def-7273-3dbc-8f75-318ab9adbb3e",
                                        "glosses": [
                                            "Loaned or lent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b185236c-195d-4390-bd2e-8997837db203",
                                                "sense_id": "34d79de7-ce9a-3c92-9194-4ac6b758f72a",
                                                "text": "She worked on loan from another agency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
