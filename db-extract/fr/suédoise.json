                                ]
                            },
                            {
                                "target_word": "шве́дка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dd44fbe6-c120-3a0e-9c0f-d2334cba96bb",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "разг. то же, что шведская печь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e35656-4053-4546-b251-6fcc0c1d4f48",
                                                "sense_id": "dd44fbe6-c120-3a0e-9c0f-d2334cba96bb",
                                                "text": "Сооруженная посредине моей половины дома печка «шведка» с духовкой, плитой и баком для воды как бы делила эту квартиру на отдельные комнаты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2380ea63-4a94-314d-90b0-4be52a6fdd60",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "спорт. в футболе удар по мячу внешней стороной стопы (ребром стопы, дальним от продольной оси тела)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd83c1e5-5ee8-38ff-a800-24830bc8ac09",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "разг. мужская рубашка с короткими рукавами, аналогичная поло"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a2e3a05-63e0-42f5-924d-be06bc952cbf",
                                                "sense_id": "bd83c1e5-5ee8-38ff-a800-24830bc8ac09",
                                                "text": "Одет сугубо по-граждански: фирменные джинсы, такая же шведка, дорогая кожаная барсетка."
                                            },
                                            {
                                                "example_id": "b09a0f5d-8324-4740-b65b-c1d5cf3bd1ef",
                                                "sense_id": "bd83c1e5-5ee8-38ff-a800-24830bc8ac09",
                                                "text": "Предполагаемый торговец наркотиками оказался худощавым парнем с простецким лицом, одетым в дешевые джинсы и такую же шведку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ed7674-fdf5-3eec-9597-75aa0d7dee2c",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "устар. подпорода норийского типа лошадей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "587eac00-fd72-497e-9a9b-b1207460166f",
                                                "sense_id": "c4ed7674-fdf5-3eec-9597-75aa0d7dee2c",
                                                "text": "Голос его звучал глухо, но с таким оттенком добродушия, что извозчик про себя улыбнулся и уже как следует угостил свою «шведку» ударом кнута."
                                            },
                                            {
                                                "example_id": "c0d65c0b-bd5b-4525-8865-ce4c16df57bf",
                                                "sense_id": "c4ed7674-fdf5-3eec-9597-75aa0d7dee2c",
                                                "text": "По одной из таких пустынных улиц часу в двенадцатом самого ненастного дня, по ступицу в жидкой, болотистой грязи, плыли маленькие одноместные дрожечки, запряженные парою бойких рыженьких шведок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794dd97a-9671-3bc1-a3f5-ec9d3474f496",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "разг. то же, что разводной ключ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792de85d-ca01-450d-a50d-2672a98398ce",
                                                "sense_id": "794dd97a-9671-3bc1-a3f5-ec9d3474f496",
                                                "text": "Кузьмину наливали стакан, но он вместо ожидаемых воспоминаний ложился спать, уложив под подушку разводной ключ-шведку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42131d6a-51ac-3646-b4b2-d9facd76e8b0",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "разг. то же, что шведская стенка, гимнастический снаряд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e415c337-f2c3-4655-aa4e-94e4826ee024",
                                                "sense_id": "42131d6a-51ac-3646-b4b2-d9facd76e8b0",
                                                "text": "В СССР «шведка» была обязательным атрибутом каждого спортзала — будь то зал для тренировки спортсменов-профессионалов или школьный спортзал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b28fedcf-8e48-3441-a9f0-af8278c7bfeb",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "ботан. то же, что сведа, род растений семейства амарантовые, (лат. Suaeda)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e466d2-fe9a-430f-beae-73e6e5379027",
                                                "sense_id": "b28fedcf-8e48-3441-a9f0-af8278c7bfeb",
                                                "text": "Для рудеральной растительности города Якутска виды тоже отобрались из естественных сообществ: ремонтом и защитой земли «занялись» бескильница, шведка, тростник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7468748-61ab-35a7-a86e-df30336da985",
                                        "entry_id": "94ec101d-1012-3ed3-a389-a761c0bb091b",
                                        "glosses": [
                                            "устар. (точное значение неизвестно)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e44908-8f00-4662-8e53-1b42aa695508",
                                                "sense_id": "d7468748-61ab-35a7-a86e-df30336da985",
                                                "text": "В 3 ч. поехали в охотничьих моих санках со шведкой внаружу, как два года тому назад после нашей свадьбы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "393abe58-c06e-4030-9360-02b3eedb8e57",
                        "source_entry_id": "d7b71169-a88a-3050-8568-37c5d25a17ba",
                        "source_sense_id": "99f549e1-af2d-3e22-a6c1-274b6e94f4ee",
