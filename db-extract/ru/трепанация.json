                        "cross_references": [
                            {
                                "target_word": "Trepanation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                        "entry_id": "7c062bfe-6eac-3162-be47-bb4f41f4c2bd",
                                        "glosses": [
                                            "operatives Verfahren zur Öffnung des Schädels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0619933b-b10a-4cf4-a286-264c39414489",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Trepanationen dienten vor allem der Behandlung von Kriegsverletzungen, […].“"
                                            },
                                            {
                                                "example_id": "9ab8aeea-6165-4310-b2de-a8133cfe1b02",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Er möchte nämlich eine Trepanation durchführen und mit dem Skalpell eine bestimmte Partie des rechten Gehirnlappens einritzen.“"
                                            },
                                            {
                                                "example_id": "140185e5-6a6b-479d-9edf-0e6cbdcda35e",
                                                "sense_id": "cf9a6fc3-9e92-3d5e-a184-a01cb7bee0f8",
                                                "text": "„Meist waren die Schädel der Menschen künstlich deformiert und mehrere zeigten die Spuren von Trepanationen, wie die Öffnung des Schädels bezeichnet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
