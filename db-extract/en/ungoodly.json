                        "glosses": [
                            "Badly; in a rough or improper manner."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "62aef7a4-6eeb-45af-932d-104a85b29815",
                                "sense_id": "22fcd1e5-7a8d-3c53-b08f-0663d04e1f93",
                                "text": "[…]the remnaunt toke his ſervauntꝭ and intreated them vngoodly and ſlewe thẽ."
                            },
                            {
                                "example_id": "a31e92e2-1818-46fe-ae3d-8a2e84ca2236",
                                "sense_id": "22fcd1e5-7a8d-3c53-b08f-0663d04e1f93",
                                "text": "And good thinges vngoodlye vſed, are not good, ſayeth an honorable biſhoppe in an erneſter matter then this is: yet we muſte beware that we laye not mennes faultes vpõ the thing which is not worthie, for ſo nothing ſhulde be good."
                            }
                        ]
                    }
