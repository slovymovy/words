                "entry_id": "064b2e4c-ac0c-3668-89ee-439bb2afc343",
                "word": "harengueux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "502b547e-266c-4949-977b-b3927bc0cdfc",
                        "entry_id": "064b2e4c-ac0c-3668-89ee-439bb2afc343",
                        "tags": [
                            "invariable"
                        ],
                        "form": "^((h aspiré))\\a.ʁɑ̃.ɡø\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de5bed2c-945b-3b3d-9fad-7508f6712ace",
                        "entry_id": "064b2e4c-ac0c-3668-89ee-439bb2afc343",
                        "glosses": [
                            "Bateau spécialisé dans la pêche du hareng."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3fff9a-278f-4ea4-8d31-8f9749d57c32",
                                "sense_id": "de5bed2c-945b-3b3d-9fad-7508f6712ace",
                                "text": "Nos harengueux repeints en gris, flanqués sur la coque d’un numéro d’immatriculation, deux lettres et deux chiffres, partageaient les bassins avec la deuxième escadre légère, des sous-marins, les torpilleurs de la Dover Patrol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfeced95-2514-4db0-b56c-4c705f5a1da5",
                        "source_entry_id": "064b2e4c-ac0c-3668-89ee-439bb2afc343",
                        "source_sense_id": "de5bed2c-945b-3b3d-9fad-7508f6712ace",
                        "target_lang_word": "drifter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drifter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06f9521a-b3b2-3ecb-b1d3-dfe1712a4858",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A person who moves from place to place or job to job."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88147aae-ce07-4f60-8ca9-c54c690aee2a",
                                                "sense_id": "06f9521a-b3b2-3ecb-b1d3-dfe1712a4858",
                                                "text": "There are drifters painting beside you / They don't see the future that I do"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A type of lightweight sail used in light winds like a spinnaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c15678-379b-415f-a885-d458f617bd8f",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "In winds above 10 knots we usually run wing-and-wing with our 100 percent lapper set on a whisker pole opposite the mainsail. As the wind drops, we get out the drifter and set it flying to leeward (Fig. 1)."
                                            },
                                            {
                                                "example_id": "6a3ff44f-92bd-471c-88d2-f78160ad69af",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "After trying a variety of light-wind sails, we've found the most versatile and simple one to be a nylon drifter."
                                            },
                                            {
                                                "example_id": "3d5db2ec-7b58-4f79-b5e8-8d883edba46e",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "Some people recommend a medium- to lightweight 140- or 150-percent headsail, and others go for a drifter/reacher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A driver who uses driving techniques to modify vehicle traction to cause a vehicle to slide or power slide rather than drive in line with the tires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74bc41be-f807-4395-9813-7f4e754bb21c",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "However, sensing the available traction may actually be more important to a drifter."
                                            },
                                            {
                                                "example_id": "4f2312cc-2a72-483a-a011-79e94adc13fe",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "For professional drifters looking for even more fine-tuning of their suspension setups, some companies offer more advanced two-way adjustable shocks […]"
                                            },
                                            {
                                                "example_id": "404f7264-7f38-4212-8166-b1b14df1256d",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "While this method is used by a few drifters in rear-wheel drive cars, this technique is really the only way one can drift in a front-wheel drive car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A parachutist who jumps before the rest of the group to determine wind direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63ebe9a-5897-4af3-9b07-903095f0b3b9",
                                                "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                                "text": "As we circled the area, the Dakota appeared and dropped a drifter."
                                            },
                                            {
                                                "example_id": "763d0d3e-6d75-41c8-b83e-7c9d3a14d988",
                                                "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                                "text": "[…] a circling Beverley dropped parachutists in small groups — a few hard words were said about R.A.F. organisation. The time came at last for the first four to get into the balloon car. First out was a drifter — an experienced parachutist who jumps first to assess conditions by allowing himself to drift at random."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ceef1ce-ea96-3750-8217-113ace32c2c4",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A person employed in driving in rock other than coal."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "drifter",
