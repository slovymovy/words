                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur prend dix minutes pour <w>échauffer</w> ses muscles avant d'entrer sur le terrain."
                        },
                        {
                            "text": "Il est recommandé d'<w>échauffer</w> la voix avant de monter sur scène pour chanter."
                        }
                    ],
                    "synonyms": [
