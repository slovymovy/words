                        ]
                    },
                    {
                        "translation_id": "122e6ef4-d097-49cf-b9df-3033cad438d4",
                        "source_entry_id": "ca87223c-d210-30a6-a8a5-065fa71400a7",
                        "source_sense_description": "то, что внушает страх или отвращение; то, чем запугивают",
                        "target_lang_word": "bogeyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bogeyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                        "entry_id": "06f996b6-7def-30cc-94c3-a75475bc092f",
                                        "glosses": [
                                            "A menacing, ghost-like monster in children's stories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76996e4-868a-43a3-b33f-9898a217bc41",
                                                "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                                "text": "Near-synonyms: bogeyperson, bogeywoman"
                                            },
                                            {
                                                "example_id": "06239591-b7f3-492f-a597-c9cf378233b8",
                                                "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                                "text": "Lay your head down child\nI won't let the boogeyman come\nCounting bodies like sheep\nTo the rhythm of the war drums\nPay no mind to the rabble\nPay no mind to the rabble\nHead down, go to sleep\nTo the rhythm of the war drums"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                        "entry_id": "06f996b6-7def-30cc-94c3-a75475bc092f",
                                        "glosses": [
                                            "Any make-believe threat, especially one used to intimidate or distract; a real threat greatly exaggerated for those purposes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c82fe4b-1d02-486e-a491-e0bc38068c79",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "Near-synonyms: bug-a-boo, bugaboo, chimera"
                                            },
                                            {
                                                "example_id": "16ac37fb-e72b-4f29-9e9c-23258e1ff61a",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "The bogeyman of a Halloween-candy poisoner behind every door has animated occasional moral panics against trick-or-treating."
                                            },
                                            {
                                                "example_id": "7a55b2df-31a2-4846-9dd3-cf4d226a87c3",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "With no original ideas or solutions, they've now resorted to bringing out a tried-and-tested bogeymen in a last-ditch attempt to derail much-needed legislation."
                                            },
                                            {
                                                "example_id": "1c0ef2ea-76ce-4a34-b959-7d1f6b42e669",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "Before the Internet it was television. And, if not that, it was radio, films, or games. All have taken their turn as the popular bogeyman, blighting the minds of the young."
                                            },
                                            {
                                                "example_id": "ff72d65b-cae9-42e7-85ed-b4019ff54f40",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "If there’s a down side to the film, it’s that “Soros” probably doesn’t devote enough time to the way its subject has become a favorite bogeyman to conservatives that paint him as the guiding hand behind grassroots campaigns by those intent on discrediting them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "982205fa-14a1-4ef3-9b64-f8c308741023",
                        "source_entry_id": "ca87223c-d210-30a6-a8a5-065fa71400a7",
                        "source_sense_description": "то, что внушает страх или отвращение; то, чем запугивают",
                        "target_lang_word": "bête noire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bête noire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                        "entry_id": "472d7ff1-53de-3918-b102-5413396f2c9b",
                                        "glosses": [
                                            "Someone or something that is unbearable and so particularly avoided or disliked; the bane of someone's existence; an object of aversion; an anathema."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3210378a-629a-4bc8-bf86-f700097c708a",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "[A] petticoated politician was [Napoleon] Bonaparte's bête noire, or antipathy, […]"
                                            },
                                            {
                                                "example_id": "7f11ed87-cdac-4b06-9268-08af52b3cd7d",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "No reader can be ignorant that for many years past the bêtes noires of the Whigs and Radicals were what they delighted to call ‘political parsons.’ If the clergyman was a magistrate, he was libelled as a political parson; if he presided at a vestry that levied a church-rate, he was persecuted as a political parson."
                                            },
                                            {
                                                "example_id": "7ab4d0f3-25c1-4d5d-8f9f-55fa3ae091eb",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "[…] I found at length that the widow was growing dreadfully afraid of me, calling me her bête noire, her dark spirit, her murderous adorer, and a thousand other names indicative of her extreme disquietude and terror."
                                            },
                                            {
                                                "example_id": "bbe96904-72b2-4204-8e29-61bbe40f67a0",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "Unruly dogs and cows are the bêtes noires of her morning walks,—wasps and earwigs haunt her retirement,—and ghosts and burglaries mar her midnight peace!"
                                            },
                                            {
                                                "example_id": "68b3768c-27b7-4f43-8495-daff938af245",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "Life is easy for people who have just one bête noire and a trusty silver bullet. There are, for example, people whose bête noire is censorship and whose silver bullet is the First Amendment. […] And there are many whose life is all about this week's subject—privacy—as if nothing else matters. Problem is that privacy conflicts with other important rights, such as freedom of speech."
                                            },
                                            {
                                                "example_id": "e770991b-0fa9-430f-848b-5b24f7f22081",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "The CD was leaning against the side of the right-hand shelf unit, so to get a firm grip with a fingertip, he was going to have to use his left hand. It went against every instinct he had about getting greasy fingermarks on CDs, a personal bête noire, but on this occasion he was just going to have to put up with it."
                                            },
                                            {
                                                "example_id": "2ca3183d-715d-4a4f-b6fc-c598dacfecda",
                                                "sense_id": "8c7237cd-7ef3-3461-9ad8-974fba84a3dd",
                                                "text": "The government knows that the liberal broadsheet press is shot through with anti-Putin, borderline Russophobic prejudice. Indeed, many commentators still blame Russia for Brexit. And so, at its lowest ebb, [Boris] Johnson's wretched government has decided to play to the gallery, and generate some plastic animosity towards the bête noire of the liberal elite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
