                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He called a <w>combination</w> to sink the ball in the corner pocket.",
                            "target_lang_translations": {
