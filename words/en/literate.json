{
    "word_family": [
        "literacy",
        "illiterate",
        "illiteracy",
        "semiliterate",
        "alliterate",
        "literature"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49ddbaac-e498-3607-8c4f-1fde0bafaa7d",
                    "sense_definition": "Able to read and write.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "literacy_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every child deserves the chance to grow up healthy and become fully <w>literate</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый ребёнок заслуживает возможности вырасти здоровым и стать полностью <w>грамотным</w>."
                            }
                        },
                        {
                            "text": "The government launched new evening programs to help adults become <w>literate</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство запустило новые вечерние программы, чтобы помочь взрослым стать <w>грамотными</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "illiterate"
                    ],
                    "common_phrases": [
                        "computer literate",
                        "digitally literate",
                        "financially literate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеющий читать и писать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грамотный",
                                "target_lang_sense_clarification": "умеющий читать и писать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17314666-3427-3ab5-b48e-cff7ab0e5459",
                    "sense_definition": "Knowledgeable in literature or writing; educated and well-read.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literacy_knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote in an elegant and highly <w>literate</w> style that impressed the critics.",
                            "target_lang_translations": {
                                "ru": "Она писала изящным и исключительно <w>грамотным</w> стилем, впечатлившим критиков."
                            }
                        },
                        {
                            "text": "The author caters to a very <w>literate</w> audience that appreciates classic references.",
                            "target_lang_translations": {
                                "ru": "Автор ориентируется на весьма <w>начитанную</w> аудиторию, способную оценить классические отсылки."
                            }
                        }
                    ],
                    "synonyms": [
                        "well-read",
                        "cultivated",
                        "educated"
                    ],
                    "common_phrases": [
                        "literate audience",
                        "literate society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знающий литературу, образованный, начитанный или обладающий хорошим языковым стилем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образованный",
                                "target_lang_sense_clarification": "имеющий хорошие знания, просвещённый"
                            },
                            {
                                "target_lang_word": "начитанный",
                                "target_lang_sense_clarification": "хорошо знакомый с литературой"
                            },
                            {
                                "target_lang_word": "грамотный",
                                "target_lang_sense_clarification": "литературный, изысканный (о стиле, речи)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "507a2014-6eac-3f16-93a8-487f03087074",
                    "sense_definition": "Having or using a written form, as of a language or culture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "written_language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars studied how oral traditions changed when translated into a <w>literate</w> language.",
                            "target_lang_translations": {
                                "ru": "Учёные исследовали, как менялись устные традиции при переводе на <w>письменный</w> язык."
                            }
                        },
                        {
                            "text": "The development of a script allowed the empire to unify its various <w>literate</w> tongues.",
                            "target_lang_translations": {
                                "ru": "Создание письменности позволило империи объединить свои различные <w>письменные</w> языки."
                            }
                        }
                    ],
                    "synonyms": [
                        "written"
                    ],
                    "common_phrases": [
                        "literate culture",
                        "literate tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий письменность или письменную традицию (о языке или культуре)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "письменный",
                                "target_lang_sense_clarification": "обладающий письменной формой"
                            },
                            {
                                "target_lang_word": "имеющий письменность",
                                "target_lang_sense_clarification": "о языке или народе с развитой письменностью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d160e51e-8629-3f7c-a4bd-e7f2546f3235",
                    "sense_definition": "A person who is able to read and write.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person_literate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survey divided respondents into non-readers and confirmed <w>literates</w>.",
                            "target_lang_translations": {
                                "ru": "Опрос разделил респондентов на не умеющих читать и подтверждённо <w>грамотных людей</w>."
                            }
                        },
                        {
                            "text": "Community centers offered specialized courses aimed at new <w>literates</w>.",
                            "target_lang_translations": {
                                "ru": "Общественные центры предлагали специализированные курсы, ориентированные на <w>людей, недавно освоивших грамоту</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "illiterate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, умеющий читать и писать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грамотный человек",
                                "target_lang_sense_clarification": "тот, кто владеет грамотой"
                            },
                            {
                                "target_lang_word": "грамотей",
                                "target_lang_sense_clarification": "умеющий читать и писать (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0955ad0f-01e4-3326-82c9-7e3f21d65eb6",
                    "sense_definition": "An educated person who has not taken a university degree, especially an applicant for holy orders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, a <w>literate</w> was occasionally admitted to the ministry without graduating.",
                            "target_lang_translations": {
                                "ru": "В XIX веке <w>человек без университетского диплома</w> иногда допускался к церковному служению."
                            }
                        },
                        {
                            "text": "The bishop agreed to ordain him as a <w>literate</w> despite his lack of a college diploma.",
                            "target_lang_translations": {
                                "ru": "Епископ согласился рукоположить его как <w>литерата</w>, несмотря на отсутствие у него университетского диплома."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically within the Church of England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образованный человек без университетского диплома (в англиканской церкви — кандидат в священнослужители без высшего образования)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "литерат",
                                "target_lang_sense_clarification": "исторический церковный термин: кандидат без университетского диплома"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}