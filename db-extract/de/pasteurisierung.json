                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasteurisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9ae000-a868-3ece-9e4a-e3f56d55778b",
                                        "entry_id": "d2d65561-2b1d-3525-97df-b2b66ae39b02",
                                        "glosses": [
                                            "Heat-treatment of a perishable food to destroy heat-sensitive vegetative cells followed by immediate cooling to limit growth of the surviving cells and germination of spores."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb28bfd8-c056-4bee-a25b-dd9e973a01ce",
                                                "sense_id": "dd9ae000-a868-3ece-9e4a-e3f56d55778b",
                                                "text": "Lorries collect the milk from the various outlying farms, whence it is taken to the district distribution centre to undergo pasteurisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab5e25bc-6082-45c6-bbfb-2f2095fa71ee",
                        "source_entry_id": "37907bd0-bc14-3098-863c-cc3f433ee2ac",
                        "source_sense_id": "25d23451-a165-3643-bb11-130bfe8775f7",
                        "target_lang_word": "pasteurisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasteurisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fae1cb4-27de-3bd5-8b63-6deb39c15b26",
                                        "entry_id": "15f04fd8-7426-3c71-a6e1-8cee2241d748",
                                        "glosses": [
                                            "Action de pasteuriser."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b8a846-66f9-40d0-8761-efd87e274629",
                                                "sense_id": "9fae1cb4-27de-3bd5-8b63-6deb39c15b26",
                                                "text": "La crème après la sortie du pasteurisateur était brusquement refroidie pour éviter les « grémillons » et tout goût de cuit. Nous avons vérifié une fois de plus que la pasteurisation, ainsi pratiquée, ne modifiait en rien les qualités du beurre […]."
                                            },
                                            {
                                                "example_id": "952ef93e-567d-497c-9dad-251bd085a73f",
                                                "sense_id": "9fae1cb4-27de-3bd5-8b63-6deb39c15b26",
                                                "text": "Dans la laiterie, les technologies utilisables pour la conservation du lait sont […] la pasteurisation basse (chauffage de 30 min. à 63-65°C) ou haute (15 sec. à 72°C)."
                                            },
                                            {
                                                "example_id": "503dc465-5576-4af3-844f-8716ed960ac8",
                                                "sense_id": "9fae1cb4-27de-3bd5-8b63-6deb39c15b26",
                                                "text": "Selon le Pr Finlay, la découverte de la pasteurisation à la fin du XIXe siècle a convaincu la société à se débarrasser des microbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
