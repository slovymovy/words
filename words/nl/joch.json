                    "frequency": "Middle",
                    "semantic_group_id": "jongere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je laat je toch door dat <w>joch</w> niet op je kop zitten?",
                            "target_lang_translations": {
                                "en": "You're not going to let that <w>kid</w> push you around, are you?",
                                "ru": "Ты же не позволишь этому <w>пацану</w> садиться тебе на шею?"
                            }
                        },
                        {
                            "text": "Dat brutale <w>joch</w> luistert totaal niet naar wat de leraar zegt.",
                            "target_lang_translations": {
                                "en": "That cheeky <w>lad</w> doesn't listen to what the teacher says at all.",
                                "ru": "Этот наглый <w>юнец</w> вообще не слушает, что говорит учитель."
                            }
                        }
                    ],
                    "synonyms": [
