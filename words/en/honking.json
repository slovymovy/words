{
    "word_family": [
        "honk",
        "honker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd988ec6-aa84-3695-9572-a50094d8b36d",
                    "sense_definition": "present participle and gerund of <w>honk</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "honk_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>honking</w> his horn impatiently at the car in front of him.",
                            "target_lang_translations": {
                                "ru": "Водитель нетерпеливо <w>сигналил</w> машине перед ним.",
                                "zh": "司机正不耐烦地对着前车<w>鸣笛</w>。"
                            }
                        },
                        {
                            "text": "I could hear the geese <w>honking</w> as they flew over the house this morning.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как <w>гоготали</w> гуси, пролетая над домом этим утром.",
                                "zh": "今天早上我听见鹅飞过房子时发出的<w>鸣叫</w>声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honking the horn",
                        "honking geese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола honk (сигналить или гоготать).",
                        "zh": "动词 honk 的现在分词和动名词形式，指发出喇叭声或鹅叫声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигналящий",
                                "target_lang_sense_clarification": "о водителе или машине"
                            },
                            {
                                "target_lang_word": "гогочущий",
                                "target_lang_sense_clarification": "о гусях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸣笛",
                                "target_lang_sense_clarification": "指车辆发出喇叭声"
                            },
                            {
                                "target_lang_word": "鸣叫",
                                "target_lang_sense_clarification": "指鹅等禽类发出的叫声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70536b26-10e5-32be-856b-96206be67348",
                    "sense_definition": "A sound that honks, such as from a car horn or a goose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "honk_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We listened to the distant <w>honkings</w> of the geese on the lake.",
                            "target_lang_translations": {
                                "ru": "Мы слушали далекое <w>гоготание</w> гусей на озере.",
                                "zh": "我们听着湖面上远处传来的<w>鹅叫声</w>。"
                            }
                        },
                        {
                            "text": "The constant <w>honking</w> from the street made it impossible to sleep.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>гудение</w> с улицы мешало уснуть.",
                                "zh": "街上持续不断的<w>喇叭声</w>让人无法入睡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blaring",
                        "beeping"
                    ],
                    "common_phrases": [
                        "constant honking",
                        "distant honkings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук, издаваемый автомобильным гудком или гусем.",
                        "zh": "由汽车喇叭或鹅发出的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудение",
                                "target_lang_sense_clarification": "автомобильный сигнал"
                            },
                            {
                                "target_lang_word": "сигнализация",
                                "target_lang_sense_clarification": "процесс подачи сигналов"
                            },
                            {
                                "target_lang_word": "гоготание",
                                "target_lang_sense_clarification": "звук гусей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喇叭声",
                                "target_lang_sense_clarification": "汽车发出的鸣笛声"
                            },
                            {
                                "target_lang_word": "鹅叫声",
                                "target_lang_sense_clarification": "鹅发出的鸣叫声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eafc90c9-37a0-3ded-ba0f-a91c4fbbb94c",
                    "sense_definition": "Very large or impressive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was wearing a <w>honking</w> great diamond ring on his pinky finger.",
                            "target_lang_translations": {
                                "ru": "На его мизинце было <w>здоровенное</w> кольцо с бриллиантом.",
                                "zh": "他的小指上戴着一枚<w>硕大</w>的钻戒。"
                            }
                        },
                        {
                            "text": "That is a <w>honking</w> big bruise you have on your leg.",
                            "target_lang_translations": {
                                "ru": "У тебя на ноге <w>огромный</w> синяк.",
                                "zh": "你腿上的那块淤青真是<w>巨大</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "huge",
                        "massive",
                        "enormous"
                    ],
                    "antonyms": [
                        "tiny",
                        "minuscule"
                    ],
                    "common_phrases": [
                        "honking great",
                        "honking big"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage often spelled honkin'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, внушительный или впечатляющий (разговорное).",
                        "zh": "形容体积非常大或令人印象深刻（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здоровенный",
                                "target_lang_sense_clarification": "о размере"
                            },
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "внушительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "形容体积庞大"
                            },
                            {
                                "target_lang_word": "硕大的",
                                "target_lang_sense_clarification": "形容非常大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69940464-4fe6-36db-bf7f-13531c3e2b8c",
                    "sense_definition": "Having a very strong and unpleasant smell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get those <w>honking</w> socks out of the living room right now.",
                            "target_lang_translations": {
                                "ru": "Убери эти <w>вонючие</w> носки из гостиной прямо сейчас.",
                                "zh": "立刻把那些<w>恶臭</w>的袜子从客厅拿走。"
                            }
                        },
                        {
                            "text": "The fridge started <w>honking</w> after the power was out for three days.",
                            "target_lang_translations": {
                                "ru": "Холодильник начал <w>вонять</w> после того, как три дня не было электричества.",
                                "zh": "冰箱断电三天后开始<w>发臭</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stinking",
                        "smelly",
                        "reeking"
                    ],
                    "antonyms": [
                        "fragrant",
                        "scented"
                    ],
                    "common_phrases": [
                        "honking socks",
                        "honking smell"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to describe a powerful stench"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий очень сильный и неприятный запах (сленг).",
                        "zh": "指散发出非常强烈且难闻的气味（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонючий",
                                "target_lang_sense_clarification": "о сильном запахе"
                            },
                            {
                                "target_lang_word": "смердящий",
                                "target_lang_sense_clarification": "очень неприятный запах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶臭的",
                                "target_lang_sense_clarification": "形容气味极度难闻"
                            },
                            {
                                "target_lang_word": "发臭的",
                                "target_lang_sense_clarification": "形容散发臭味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f3b7b28-92c9-3c45-9519-d129e2d15baf",
                    "sense_definition": "Extremely bad or terrible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather during our vacation was absolutely <w>honking</w>.",
                            "target_lang_translations": {
                                "ru": "Погода во время нашего отпуска была просто <w>паршивой</w>.",
                                "zh": "我们度假期间的天气简直<w>糟糕</w>透了。"
                            }
                        },
                        {
                            "text": "I had a <w>honking</w> headache after the loud concert last night.",
                            "target_lang_translations": {
                                "ru": "После вчерашнего громкого концерта у меня была <w>ужасная</w> головная боль.",
                                "zh": "昨晚看完吵闹的音乐会后，我头痛得<w>厉害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "dreadful",
                        "terrible"
                    ],
                    "antonyms": [
                        "excellent",
                        "wonderful"
                    ],
                    "common_phrases": [
                        "honking weather",
                        "honking headache"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang for bad or unpleasant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, ужасный или неприятный (британский сленг).",
                        "zh": "指极其糟糕或令人不快（英国俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "о качестве или состоянии"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "形容质量或情况很差"
                            },
                            {
                                "target_lang_word": "极差的",
                                "target_lang_sense_clarification": "形容程度非常不好"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9c10cf89-c05d-320d-a68c-40c546f98a7c",
                    "sense_definition": "To a very large degree; extremely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>honking</w> great mistake that will cost us dearly.",
                            "target_lang_translations": {
                                "ru": "Это <w>чертовски</w> большая ошибка, которая дорого нам обойдется.",
                                "zh": "那是一个<w>极其</w>严重的错误，会让我们付出沉重的代价。"
                            }
                        },
                        {
                            "text": "He bought a <w>honking</w> big television that takes up the whole wall.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>невероятно</w> большой телевизор, который занимает всю стену.",
                                "zh": "他买了一台<w>非常</w>大的电视，占满了整面墙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "massively"
                    ],
                    "common_phrases": [
                        "honking great"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень большой степени; чрезвычайно (используется как усилитель).",
                        "zh": "在很大程度上；极其（用作程度副词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "усилительное наречие"
                            },
                            {
                                "target_lang_word": "невероятно",
                                "target_lang_sense_clarification": "в высокой степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示程度高"
                            },
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "表示程度极高"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}