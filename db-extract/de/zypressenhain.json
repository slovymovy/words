                        "glosses": [
                            "kleines Wäldchen, in dem vorwiegend Zypressen wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a62cbc6-b344-49ed-b9d7-305a432eaffe",
                                "sense_id": "40e2e509-a65f-37ca-8656-c46f6a378682",
                                "text": "„Der Zypressenhain der Grabstätten, der an unsre Wohnung angränzte, zog uns oft hinab zu Spaziergängen in seinem Schatten.“"
                            },
                            {
                                "example_id": "d61db74f-1324-492c-81dd-ffcbb9f1115c",
                                "sense_id": "40e2e509-a65f-37ca-8656-c46f6a378682",
                                "text": "„Ich ahnde, wenn im Rosenhain",
                                "translation": "Kein Lebensmorgen grauet.“"
                            }
                        ],
