                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "12f73b12-e466-3096-b602-a7b70f1b056a",
                        "entry_id": "fe79a413-efcc-31bc-895c-598f906284f1",
                        "glosses": [
                            "Grande quantité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "35a72a46-7e52-48af-8884-5fd8b6e4446e",
                                "sense_id": "12f73b12-e466-3096-b602-a7b70f1b056a",
                                "text": "Le jour où commença la construction, des présences se laissèrent voir à l’entrée du site, regroupées en un petit tapon dans lequel on avait piqué des pancartes."
                            },
                            {
                                "example_id": "10a538d8-feab-4893-90b4-7e4cf2a77b2c",
                                "sense_id": "12f73b12-e466-3096-b602-a7b70f1b056a",
                                "text": "Vous, réalisez-vous qu’il y en a un tapon qui sont pour ?"
                            }
                        ]
                    }
