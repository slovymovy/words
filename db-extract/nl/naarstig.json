                                    {
                                        "sense_id": "fa62f3bf-3e38-3afa-96b3-dad7fa075808",
                                        "entry_id": "044b9642-b49a-3463-9ee0-ba2f1e83a3e0",
                                        "glosses": [
                                            "Performing with industrious concentration; hard-working and focused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e96d6af-b7d3-48e8-b059-f706a930d5ba",
                                                "sense_id": "fa62f3bf-3e38-3afa-96b3-dad7fa075808",
                                                "text": "Scientists are very diligent in their work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aedb230-03f6-4ef4-89a6-102f70ebd41e",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
                        "source_sense_description": "ijverig en vlug",
                        "target_lang_word": "hardworking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardworking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8de6521-0c87-36ad-adf8-2849eb39aca1",
                                        "entry_id": "96809993-9abd-3da1-862b-7d3389764fdd",
                                        "glosses": [
                                            "Of a person, taking their work seriously and doing it well and rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b5cdf7-01c8-4073-9cf0-da55b70211d3",
                                                "sense_id": "b8de6521-0c87-36ad-adf8-2849eb39aca1",
                                                "text": "“My team and manager are exceptional; they are hardworking, talented, and supportive,” noted one respondent. “The company as a whole really focuses on their employees and that is very important to me.”"
                                            },
                                            {
                                                "example_id": "d8c9a165-1162-4bc1-9306-214eaed25f8b",
                                                "sense_id": "b8de6521-0c87-36ad-adf8-2849eb39aca1",
                                                "text": "It exacerbates homelessness, slows family formation, prevents workers from moving to opportunity and puts an enormous strain on the budgets of hardworking people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "007f9e9c-2283-4ad0-93e3-ef8baf28cc4c",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
                        "source_sense_description": "ijverig en vlug",
                        "target_lang_word": "industrious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "industrious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                        "entry_id": "a1fa3869-c8a5-33f6-a726-8844fb6b0a33",
                                        "glosses": [
                                            "Hard-working and persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae73af4a-5fc5-4dc4-a023-8277cc6b3df9",
                                                "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                                "text": "She was a very industrious student at school."
                                            },
                                            {
                                                "example_id": "4dabaa21-3397-4a81-90f3-6c44a8c648b0",
                                                "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                                "text": "The ant has made himself illustrious / Through constant industry industrious. / So what? / Would you be calm and placid / If you were full of formic acid?"
                                            }
