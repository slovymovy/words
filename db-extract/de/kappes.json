                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e9904a74-196b-4745-9bea-fe32bc1b45cc",
                                "sense_id": "8118de77-39cc-34ef-abbc-333f47f6e147",
                                "text": "Ich mach heut' Abend Kappes-Durcheinander.",
                                "translation": "I'm making a cabbage stew for dinner.",
                                "english": "I'm making a cabbage stew for dinner."
                            },
                            {
                                "example_id": "ca6854b1-7bb6-41b2-9f8e-c6bf23e83f35",
                                "sense_id": "8118de77-39cc-34ef-abbc-333f47f6e147",
                                "text": "„Kappes“, der anders als im Ruhrgebiet, wo das ein ganzes Gericht war, bei uns einfach nur Weißkohl­schnetzel in weißer Soße meinte und als Beilage gegessen wurde."
                            }
                        ]
                    },
                    {
                        "sense_id": "18bf98e4-8653-31dc-8799-3cb8939a578a",
                        "entry_id": "0d72fede-ee94-3fb1-a7b6-4e3ae87d3a95",
                        "glosses": [
                            "nonsense"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a87e35d2-532a-430c-ba35-7781d9623b49",
                                "sense_id": "18bf98e4-8653-31dc-8799-3cb8939a578a",
                                "text": "Erzähl mir keinen Kappes!",
                                "translation": "Don't tell me such nonsense!",
                                "english": "Don't tell me such nonsense!"
                            },
                            {
                                "example_id": "42c9d111-4bb4-4f77-8c05-6932116725d2",
                                "sense_id": "18bf98e4-8653-31dc-8799-3cb8939a578a",
                                "text": "„Scholz sonst auch 2021 nicht teilnehmen dürfen“, wie die grüne Bundesvorsitzende Franziska Brantner mit Verweis auf die Umfragewerte vom Frühjahr und Sommer vor drei Jahren meinte, als die SPD teilweise weit hinter ihrer Partei lag. Das ist allerdings auch Kappes, denn ab Juni holte die SPD damals deutlich auf."
                            }
                        ]
                    }
                ],
