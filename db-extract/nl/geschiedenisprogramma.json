                        "examples": [
                            {
                                "example_id": "e09538ce-6cae-4d12-9760-ecda63f9150d",
                                "sense_id": "711f34e7-be62-3a5e-95f8-3c162613b7d9",
                                "text": "\"Tijdens de opnames van Andere Tijden Sport in Argentinië over het WK van 1978 kwamen we tot een ander inzicht over dat toernooi. De geschiedenis werd als het ware herschreven. En dat is toch wat je wilt met een geschiedenisprogramma."
                            },
                            {
                                "example_id": "32d68c03-9cbf-4e17-bccc-5319f4529159",
                                "sense_id": "711f34e7-be62-3a5e-95f8-3c162613b7d9",
                                "text": "De letterkundige Frits van Oostrom heeft de Libris Geschiedenis Prijs 2018 gekregen voor zijn boek Nobel Streven. Het onwaarschijnlijke maar waargebeurde verhaal van ridder Jan van Brederode. Van Oostrom kreeg de prijs vanochtend uitgereikt tijdens het geschiedenisprogramma OVT op NPO Radio 1. Aan de prijs is een bedrag van 20.000 euro verbonden."
                            },
                            {
                                "example_id": "ecf17e1c-7cc6-4f66-bc0a-bb3ce4ec834a",
                                "sense_id": "711f34e7-be62-3a5e-95f8-3c162613b7d9",
                                "text": "Om 21.31 uur wordt de laatste aflevering van de zomerserie van Andere Tijden Sport uitgezonden. Met nog een kleine week te gaan tot de Spelen van Rio de Janeiro blikt het geschiedenisprogramma terug op de Spelen van 1984. In Los Angeles was het Stephan van den Berg die goud pakte bij het windsurfen."
                            }
                        ]
                    }
