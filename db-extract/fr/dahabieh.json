        "fr-extract.jsonl": [
            {
                "entry_id": "2b62b4e6-a444-3a93-8aa7-f88ada16f0a5",
                "word": "dahabieh",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8d1b9a8-004a-456d-a2d1-1bf289973080",
                        "entry_id": "2b62b4e6-a444-3a93-8aa7-f88ada16f0a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "dahabiehs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c8d4734-20e6-351e-ac3a-a6f9a47aa8b5",
                        "entry_id": "2b62b4e6-a444-3a93-8aa7-f88ada16f0a5",
                        "glosses": [
                            "Petit bateau spécifiquement égyptien, propulsé à la voile ou à la rame, utilisé pour le transport des voyageurs et des marchandises sur le Nil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a215371e-7412-466f-8b27-911edaaa38a6",
                                "sense_id": "6c8d4734-20e6-351e-ac3a-a6f9a47aa8b5",
                                "text": "Cet état de choses dura un certain temps, puis, un beau jour, le prince eut envie de faire une promenade en dahabieh ; il donna, à cet effet, les ordres nécessaires et s’embarqua, se promettant de se distraire."
                            },
                            {
                                "example_id": "20023cb9-24f5-4ddf-afe6-ef5c8845aa77",
                                "sense_id": "6c8d4734-20e6-351e-ac3a-a6f9a47aa8b5",
                                "text": "Il évoquera les dahabiehs, ces deux barques à fond plat qu’il a louées, la première pour lui-même et ses compagnons, la seconde pour les serviteurs, pour la cuisine et les animaux vivants : lapins, oies, poules, pigeons, dindes, et même des moutons qu’on doit emmener pour la nourriture journalière."
                            },
                            {
                                "example_id": "569649fe-7bdf-418a-837d-69a9ca3a0dbe",
                                "sense_id": "6c8d4734-20e6-351e-ac3a-a6f9a47aa8b5",
                                "text": "Privatiser une dahabieh pour parcourir le Nil, le comble du luxe à bord de la « Flaneuse »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
