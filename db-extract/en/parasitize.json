                                        "examples": [
                                            {
                                                "example_id": "5346e643-85fa-4626-ae96-9e3cb7008236",
                                                "sense_id": "9bcc1b96-a5d9-3c6d-90c5-994884b2ae75",
                                                "text": "L'aventure du phylloxera fut, d'ailleurs, sur le point de se renouveler quelques années plus tard, lors de l’invasion de l'Europe par le doryphore, vulgairement appelés bête du Colorado et comme son nom l'indique, lui aussi originaire de l'Amérique du Nord, et qui parasite la pomme de terre."
                                            },
                                            {
                                                "example_id": "d3891ff8-4321-4bba-aa2e-dd7c50d8c6f6",
                                                "sense_id": "9bcc1b96-a5d9-3c6d-90c5-994884b2ae75",
                                                "text": "Le coucou parasite le nid d’autres espèces d’oiseaux pour y pondre ses œufs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57f993a-24d8-3ecc-bbce-2f362de5bcb0",
                                        "entry_id": "55b1d184-84f5-3d73-a5bf-730d7ed6b79b",
                                        "glosses": [
                                            "Perturber, troubler la réception des signaux sonores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4549290-342e-4d04-8c74-bbccebc714a0",
                                                "sense_id": "f57f993a-24d8-3ecc-bbce-2f362de5bcb0",
                                                "text": "On n’entend rien, de la friture parasite la connexion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c74a8b-82a6-39f9-a288-fe881de59093",
                                        "entry_id": "55b1d184-84f5-3d73-a5bf-730d7ed6b79b",
                                        "glosses": [
                                            "Nuire à la sérénité mentale ou psychologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
