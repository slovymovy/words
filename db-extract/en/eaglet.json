                                    },
                                    {
                                        "sense_id": "09dc03c6-9545-365b-856a-f0b28a33f96d",
                                        "entry_id": "01e1ce32-8cd7-3120-9aa3-8f1f566acde4",
                                        "glosses": [
                                            "młody obrońca polskiego Lwowa z lat 1918–1920"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "006230dd-8997-4584-b9d5-53252be7d7bc",
                                                "sense_id": "09dc03c6-9545-365b-856a-f0b28a33f96d",
                                                "text": "Do powstania legendy Orląt Lwowskich przyczyniła się także postawa harcerek i harcerzy, zarówno lwowskich, jak i z całego kraju, którzy masowo wzięli udział w obronie Lwowa i Galicji Wschodniej"
                                            },
                                            {
                                                "example_id": "850e6262-349d-456e-8f54-a83668e5b7c3",
                                                "sense_id": "09dc03c6-9545-365b-856a-f0b28a33f96d",
                                                "text": "Uchwałą Rady Miasta Katowice nr nr X/139/11 z 30 maja 2011 roku estakadzie nadano nazwę estakada Orląt Lwowskich"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
