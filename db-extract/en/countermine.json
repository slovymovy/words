                    {
                        "sense_id": "2787ce89-0b1f-3885-ac6e-8fcf5852fbf9",
                        "entry_id": "dee0dfe0-7e44-3d38-880e-8750ba126ae1",
                        "glosses": [
                            "To plot opposition; to frustrate the initiatives of another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e327dcb-901e-4e66-ae96-b869f27758ba",
                                "sense_id": "2787ce89-0b1f-3885-ac6e-8fcf5852fbf9",
                                "text": "[…] every gamester will agree how necessary it is to know exactly the play of another, in order to countermine him."
                            }
                        ]
                    },
                    {
                        "sense_id": "39a48a0a-107e-3eac-84a0-a77513d2d597",
                        "entry_id": "dee0dfe0-7e44-3d38-880e-8750ba126ae1",
                        "glosses": [
                            "to sap hostile mining."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e892e0fa-63ff-45b0-802a-249e0c1817bc",
                                "sense_id": "39a48a0a-107e-3eac-84a0-a77513d2d597",
                                "text": "[…]so Fritz could sleep easily in his trench, so far as mines were concerned; and Fritz, confident in his Herr Professors, altogether neglected any attempt to counter-mine."
                            }
                        ]
                    }
                ],
