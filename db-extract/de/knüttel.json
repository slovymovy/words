                "senses": [
                    {
                        "sense_id": "1a31f99c-e4b2-31fc-9787-40957ada5ac3",
                        "entry_id": "a145fe2d-cbbc-3daf-a44f-b7d4c5e10406",
                        "glosses": [
                            "hölzerne Schlagwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271766ea-dc92-4718-812e-5d8343899dac",
                                "sense_id": "1a31f99c-e4b2-31fc-9787-40957ada5ac3",
                                "text": "„Im Vorraum der Wachstube hatte ein eindrucksvoller Haufen von Knütteln, Äxten und Gewehren gelegen; die Gewehre sorgsam zur Seite geschoben, sie sollten untersucht werden.“"
                            },
                            {
                                "example_id": "f4f3fb57-7a19-4982-a909-c2abef057d3f",
                                "sense_id": "1a31f99c-e4b2-31fc-9787-40957ada5ac3",
                                "text": "„Der Diener An-tung wollte sich gerade davon machen, als ihm der achte Weng plötzlich mit einem Knüttel einen betäubenden Schlag versetzte, so daß er ins Wasser stürzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16e44c57-c101-41c4-a028-5ab68975a664",
                        "source_entry_id": "a145fe2d-cbbc-3daf-a44f-b7d4c5e10406",
                        "source_sense_id": "1a31f99c-e4b2-31fc-9787-40957ada5ac3",
                        "source_sense_description": "hölzerne Schlagwaffe",
                        "target_lang_word": "gourdin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gourdin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06f2f0d5-d5c2-3c36-9a7b-cd3bbf287a65",
                                        "entry_id": "cca064fe-a8cc-3d32-81d0-718e43c5a684",
                                        "glosses": [
                                            "Gros bâton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0076c7-f595-49cb-b2a7-fbd1ded400b5",
                                                "sense_id": "06f2f0d5-d5c2-3c36-9a7b-cd3bbf287a65",
                                                "text": "[…] ; l’armée permanente de l’Islande se réduit à deux policemen, dont les gourdins suffisent à maintenir l’ordre le plus parfait sur toute l’étendue du territoire."
                                            },
                                            {
                                                "example_id": "fbd5c3ce-6ab3-4e99-8010-865eabada825",
                                                "sense_id": "06f2f0d5-d5c2-3c36-9a7b-cd3bbf287a65",
                                                "text": "Simon Cohen, se conformant en ceci à l’usage du pays qui interdit le port des armes à ses coreligionnaires marocains, est inerme; les chameliers ont des gourdins et de mauvais poignards, […]."
                                            },
                                            {
                                                "example_id": "8c40f938-065e-4d67-b7e1-cf41ce335838",
                                                "sense_id": "06f2f0d5-d5c2-3c36-9a7b-cd3bbf287a65",
                                                "text": "Il avait l’air d’un guignol dans sa boîte, avec ses lunettes rondes et ses petits bras. Il ne lui manquait qu’un gourdin."
                                            },
                                            {
                                                "example_id": "4882df74-2088-47bd-ac8c-768f0b43e3e7",
                                                "sense_id": "06f2f0d5-d5c2-3c36-9a7b-cd3bbf287a65",
                                                "text": "Arrivent alors les combats de titans que l’on attendait tous : Etna et Vénus se crêpent le chignon (ah ! ces fameux duels crypto-sado-maso à coups de fouet ! un délice…) tandis que Mars, armé d’un râteau, fait ce qu’il peut pour parer les coups de Vulcain, lequel, pour sa part, mériterait d’entrer dans le Guiness Book comme détenteur du record du plus gros gourdin de l’histoire du cinéma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac5748f4-9ea8-3365-9cbd-7ece0dc0c891",
                                        "entry_id": "cca064fe-a8cc-3d32-81d0-718e43c5a684",
                                        "glosses": [
                                            "Sexe de l’homme, pénis."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2bf575-9f79-42a2-b0e4-8f4ed9cc1090",
                                                "sense_id": "ac5748f4-9ea8-3365-9cbd-7ece0dc0c891",
                                                "text": "Quand le grand Jacques avait le gourdin au garde-à-vous, il pouvait suspendre un portemanteau avec costar et tout, ça flanchait pas."
                                            },
                                            {
                                                "example_id": "8faf4a5c-ca82-418c-9a93-9ac60c2e01ac",
                                                "sense_id": "ac5748f4-9ea8-3365-9cbd-7ece0dc0c891",
                                                "text": "À l’approche des vagos, les travs déchaînés aux tenues provocantes se mettent à siffler, exhibent leur tarpé ou carrément leur gourdin."
                                            },
                                            {
                                                "example_id": "d26e8920-b2f2-498c-8cd8-91e7b8397b91",
                                                "sense_id": "ac5748f4-9ea8-3365-9cbd-7ece0dc0c891",
                                                "text": "A bien réfléchir aujourd’hui, il devait avoir le gourdin d’ébène. Le secret de tous les maques, les gigolpinces...qu’ils bandent quart de tour, sans motif bien évident, et qu’ils tiennent la note jusqu’à ce que leur partenaire crie grâce moult fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
