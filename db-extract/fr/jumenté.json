                        "examples": [
                            {
                                "example_id": "265c483b-c388-430b-a9d7-9102c8fcf3d0",
                                "sense_id": "a6a9e239-6444-3d1c-92a2-adf161be0846",
                                "text": "Les jumentés sont des animaux qui ont les doigts enveloppés dans des onglons ou sabots, mais sans que leurs pieds soient bisulces, même lorsqu’ils ont quatre doigts."
                            },
                            {
                                "example_id": "bce51812-59db-41d6-82ee-64ed5263c003",
                                "sense_id": "a6a9e239-6444-3d1c-92a2-adf161be0846",
                                "text": "Le sabot du cheval est-il une adaptation à la course quand le tigre, le lion, sont aussi rapides que les jumentés ? Le chamois avec ses doigts cornés ne serait-il pas mieux pourvu par la nature s’il avait des griffes pour sa gymnaslique sur les cimes ?"
                            }
                        ]
                    }
