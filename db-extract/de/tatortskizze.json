                        "examples": [
                            {
                                "example_id": "ca313054-7a8b-4245-81a1-62c55855ec16",
                                "sense_id": "a9d2664b-8f31-3705-b2a3-9e68c0b156c7",
                                "text": "„Merkwürdigkeiten und Verfahrensfehler begleiteten die Untersuchungen: Es existierte keine Tatortskizze.“"
                            },
                            {
                                "example_id": "5f3637d0-9cfa-4b6d-b06f-69541f7d06b8",
                                "sense_id": "a9d2664b-8f31-3705-b2a3-9e68c0b156c7",
                                "text": "„Die offizielle Tatortskizze des Bezirksbautechnikers Hofrat Haertinger vom 15. Juni 1886 wird von den Guglmännern auf ganz eigene Weise gedeutet.“"
                            },
                            {
                                "example_id": "2c455840-32cc-4d94-946a-d446e84ac8c9",
                                "sense_id": "a9d2664b-8f31-3705-b2a3-9e68c0b156c7",
                                "text": "„Anhand einer neu erstellten Tatortskizze und der Akten von 1985 machten sie M. als Hauptverdächtigen aus.“"
                            }
                        ],
