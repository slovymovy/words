                        "glosses": [
                            "Femme qui caillasse, qui jette des projectiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b8b4e8-51b4-4c7a-8ef6-62292820f88a",
                                "sense_id": "0b352bb9-ef31-3cf3-98b6-36a80595ff28",
                                "text": "Malgré ça, cette gosse s’était entraînée à un truc bien particulier. Je peux le dire parce que chaque fois que je parlais à une «vraie» fille, ma petite caillasseuse se surpassait en précision."
                            },
                            {
                                "example_id": "c9710e97-4175-4cec-bd76-2113e203e66f",
                                "sense_id": "0b352bb9-ef31-3cf3-98b6-36a80595ff28",
                                "text": "Elle s'était tournée pour se retrouver groin à nez avec la caillasseuse qui semblait si furax qu’on aurait dit qu’elle avait avalé un de ses rats de travers."
                            }
                        ]
                    }
