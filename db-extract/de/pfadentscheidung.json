                "senses": [
                    {
                        "sense_id": "643b1434-7935-3dbd-86ea-a0ede70652a5",
                        "entry_id": "1bd20b14-572c-38b2-b5c0-0a4e140f504a",
                        "glosses": [
                            "politische Entscheidung, die sich historisch begründet"
                        ],
                        "tags": [
                            "Politikwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "46042472-7b51-4f65-81f2-f4154e4bab33",
                                "sense_id": "643b1434-7935-3dbd-86ea-a0ede70652a5",
                                "text": "„Eine grundlegende Revision der Pfadentscheidung für die aktive und umfassende Kohlepolitik (wie zur gleichen Zeit in einer ganzen Reihe westeuropäischer Staaten vollzogen) zeichnete sich jedoch keineswegs ab.“"
                            },
                            {
                                "example_id": "07fa2077-43be-4e93-964e-70f04bc794b0",
                                "sense_id": "643b1434-7935-3dbd-86ea-a0ede70652a5",
                                "text": "„Ob anlässlich der Verfassungsgebung für das bislang nur staatlich, nicht gesellschaftlich-kulturell geeinte Deutschland Formen direkter Demokratie in den Verfassungstext aufgenommen werden oder nicht … hat angesichts der politischen Traditionen und der im Prozess der Vereinigung anstehenden Probleme die Bedeutung einer politisch-kulturellen Pfadentscheidung.“"
                            },
                            {
                                "example_id": "f7d3d370-b712-43e1-be60-ea4fb47a2d33",
                                "sense_id": "643b1434-7935-3dbd-86ea-a0ede70652a5",
                                "text": "„Viele ordnungspolitische Pfadentscheidungen der Gegenwart wurden bereits in früheren Zeiten getroffen, ohne dass ihre Ergebnisse heute bekannt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
