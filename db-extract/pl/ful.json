                        "glosses": [
                            "język regionu Afryki Zachodniej używany przez ludy Fula"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2779122-cc23-4405-b716-5c8dc1c10ab1",
                                "sense_id": "219a24f2-cad0-3ca4-b084-7f8173cb75f2",
                                "text": "Wśród dialektów zachodnio-bantuidalnych stanowisko odrębne zajmuje ful, język, który pod wpływem narzeczy semicko-chamickich i ngo-nke oddalił się znacznie od pierwotnego typu rodziny"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ed3cc29-ba06-47cf-ab6e-3ce251d6dfe6",
                        "source_entry_id": "65a5b4d1-799d-3620-8086-55e4f04ce3af",
                        "source_sense_id": "219a24f2-cad0-3ca4-b084-7f8173cb75f2",
