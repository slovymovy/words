                                        "entry_id": "48c80535-8dfa-3cc1-b53b-d1f57f3563d7",
                                        "glosses": [
                                            "Tisch für handwerkliche und ähnliche Arbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf64e729-737f-41d9-8112-f7858266f44c",
                                                "sense_id": "f57ed75b-37d0-32cd-95c0-d5c04e5bb62e",
                                                "text": "„Der Werktisch war mittlerweile auf den Boden abgesunken.“"
                                            }
