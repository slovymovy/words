                    "sense_id": "47423789-24d2-316c-85d4-291f7cf12a69",
                    "sense_definition": "Nom affectueux et familier donné au grand-père.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dimanche, les enfants aiment déjeuner chez leur <w>papi</w>.",
                            "target_lang_translations": {
                                "en": "On Sundays, the children love having lunch at their <w>grandpa's</w>.",
                                "ru": "По воскресеньям дети любят обедать у своего <w>дедушки</w>.",
                                "nl": "Op zondag lunchen de kinderen graag bij hun <w>opa</w>.",
                                "de": "Sonntags essen die Kinder gern bei ihrem <w>Opa</w> zu Mittag.",
                                "pl": "W niedziele dzieci chętnie jadają obiad u swojego <w>dziadka</w>.",
                                "it": "La domenica ai bambini piace pranzare dal loro <w>nonno</w>.",
                                "cs": "V neděli děti rády obědvají u svého <w>dědečka</w>.",
                                "tr": "Pazarları çocuklar <w>dedelerinde</w> öğle yemeği yemeyi severler.",
                                "es": "Los domingos, a los niños les gusta almorzar en casa de su <w>abuelito</w>.",
                                "zh": "每逢星期天，孩子们都喜欢去<w>爷爷</w>家吃午饭。"
                            }
                        },
                        {
                            "text": "Mon <w>papi</w> me raconte souvent des histoires sur sa jeunesse.",
                            "target_lang_translations": {
                                "en": "My <w>grandpa</w> often tells me stories about his youth.",
                                "ru": "Мой <w>дедушка</w> часто рассказывает мне истории о своей молодости.",
                                "nl": "Mijn <w>opa</w> vertelt me vaak verhalen over zijn jeugd.",
                                "de": "Mein <w>Opa</w> erzählt mir oft Geschichten aus seiner Jugend.",
                                "pl": "Mój <w>dziadek</w> często opowiada mi historie o swojej młodości.",
                                "it": "Mio <w>nonno</w> mi racconta spesso delle storie sulla sua gioventù.",
                                "cs": "Můj <w>dědeček</w> mi často vypráví příběhy ze svého mládí.",
                                "tr": "<w>Dedem</w> bana gençliği hakkında sık sık hikâyeler anlatır.",
                                "es": "Mi <w>abuelo</w> me cuenta a menudo historias de su juventud.",
                                "zh": "我<w>爷爷</w>常常给我讲他年轻时的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grand-père"
                    ],
                    "common_phrases": [
                        "chez papi et mamie"
                    ],
                    "traits": [
