                            {
                                "target_lang_word": "вставать на место",
                                "target_lang_sense_clarification": "подходить по размеру"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takmak",
                                "target_lang_sense_clarification": "yuvaya yerleştirmek"
                            },
                            {
                                "target_lang_word": "oturtmak",
                                "target_lang_sense_clarification": "tam yerine yerleştirmek"
                            },
                            {
                                "target_lang_word": "yerleştirmek",
                                "target_lang_sense_clarification": "içine koymak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插入",
                                "target_lang_sense_clarification": "放入狭窄处"
                            },
                            {
                                "target_lang_word": "嵌入",
                                "target_lang_sense_clarification": "精确地放入空间"
                            }
                        ]
                    }
