                        "source_sense_description": "of, or pertaining to, Diptera or the dipterans",
                        "target_lang_word": "tweevleugelig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweevleugelig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "91f0055e-2193-30f5-aa59-afd291d60a49",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldige lichaamsdelen die de opwaartse druk leveren om te vliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f6ea5a-846c-404f-bdd8-468d1d4f1679",
                                                "sense_id": "91f0055e-2193-30f5-aa59-afd291d60a49",
                                                "text": "⧖ De bewoners van Mars zijn tweevoetig, tweehandig, tweevleugelig; zij zweven in de ruimte; zij worden, naar wensch, lichtstralend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9f4e9dc-27a9-3e00-a963-2bdc22c81196",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldige lichaamsdelen die de opwaartse druk leveren om te vliegen",
                                            "behorend tot de orde Diptera, insecten met twee vleugels zoals vliegen en muggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80074aed-976b-426f-8407-d6f6ff9dc8cb",
                                                "sense_id": "d9f4e9dc-27a9-3e00-a963-2bdc22c81196",
                                                "text": "⧖ De bewoners van Mars zijn tweevoetig, tweehandig, tweevleugelig; zij zweven in de ruimte; zij worden, naar wensch, lichtstralend."
                                            },
                                            {
                                                "example_id": "8d146134-92f9-4900-80de-bf6cff3b8be1",
                                                "sense_id": "d9f4e9dc-27a9-3e00-a963-2bdc22c81196",
                                                "text": "De blinde bij (Eristalis tenax) is een tweevleugelig insect uit de familie van de zweefvliegen. De wonderlijke naam – de soort is niet blind en ook geen bij – zit in de uiterlijke gelijkenis met de honingbij en zijn onvermogen om te steken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77727196-dc96-3047-a3ce-04eeaf0f34e1",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldig uitstekende gedeelten"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589d6e98-e43b-453b-ac4e-a9506cc45593",
                                                "sense_id": "77727196-dc96-3047-a3ce-04eeaf0f34e1",
                                                "text": "De archiefkast was de onmiddellijke opvolger van de tweevleugelige hoekboekenkast, waarvan beide vleugels de zuidwestelijke hoek van de met haar straatkant naar het westen gekeerde kamer in beslag namen, (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d126133d-4e19-390d-b85f-72719d6a7f42",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldig uitstekende gedeelten",
                                            "met twee delen links en rechts van een middendeel"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08a02496-d950-48b4-8054-1209a5cb477a",
                                                "sense_id": "d126133d-4e19-390d-b85f-72719d6a7f42",
                                                "text": "De archiefkast was de onmiddellijke opvolger van de tweevleugelige hoekboekenkast, waarvan beide vleugels de zuidwestelijke hoek van de met haar straatkant naar het westen gekeerde kamer in beslag namen, (…)"
                                            },
                                            {
                                                "example_id": "157c19f3-599f-4e81-892c-9eed3415f88a",
                                                "sense_id": "d126133d-4e19-390d-b85f-72719d6a7f42",
                                                "text": "En van waar hij staat, ziet de veerman het tweevleugelig dak van het huis met de zware schoorstenen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94bed2d4-a9d5-39d9-839e-400afd60c165",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldig uitstekende gedeelten",
                                            "bestaande uit een linker- en rechterhelft die om scharnieren links, respectievelijk rechts kunnen worden geopend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e82e1d7-2fc4-42f7-8692-d18546b18fe6",
                                                "sense_id": "94bed2d4-a9d5-39d9-839e-400afd60c165",
                                                "text": "De archiefkast was de onmiddellijke opvolger van de tweevleugelige hoekboekenkast, waarvan beide vleugels de zuidwestelijke hoek van de met haar straatkant naar het westen gekeerde kamer in beslag namen, (…)"
                                            },
                                            {
                                                "example_id": "7f18d9f0-8495-4abc-9e84-c612c5cf6729",
                                                "sense_id": "94bed2d4-a9d5-39d9-839e-400afd60c165",
                                                "text": "Het was een huis om van te houden. Het was breed en symmetrisch, met een tweevleugelige deur in het midden en een groot raam met dubbele ruiten aan iedere kant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3816bef0-a6d1-34f7-b7bc-ee1207ad1470",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldig uitstekende gedeelten",
                                            "voorzien van twee vlakke uitsteeksels waardoor het langere tijd in de lucht blijft zweven"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541936b7-930e-4dd9-94f2-caae2b0c1add",
                                                "sense_id": "3816bef0-a6d1-34f7-b7bc-ee1207ad1470",
                                                "text": "De archiefkast was de onmiddellijke opvolger van de tweevleugelige hoekboekenkast, waarvan beide vleugels de zuidwestelijke hoek van de met haar straatkant naar het westen gekeerde kamer in beslag namen, (…)"
                                            },
                                            {
                                                "example_id": "c97e48ba-4b33-4ade-89fa-5bf35149c712",
                                                "sense_id": "3816bef0-a6d1-34f7-b7bc-ee1207ad1470",
                                                "text": "Daarbij vormen benamingen naar de karakteristieke tweevleugelige vruchtjes, die wel het meest tot de verbeelding van de gewone voorbijganger spreken, een opvallend grote groep: brillen-, flikkerkes-, molen-, neusjes-, prikneusjes-, propellertjes-, vleugel-, vliegertjes-, vlinder-, vliegmachientjes-, wieltjes-, zeildertjesboom enz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8439ec2-e48e-3de7-bed5-3cebc850687f",
                                        "entry_id": "6413e2ad-1d2a-38ea-857a-06e06675ce20",
                                        "glosses": [
                                            "met twee spiegelbeeldig uitstekende gedeelten",
                                            "opgebouwd uit een patroon van symmetrisch geplaatste kleinere blaadjes"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
