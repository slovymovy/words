{
    "word_family": [
        "looter",
        "looting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f27effe7-4bfb-33d5-8569-b86eff8b744b",
                    "sense_definition": "To steal goods from a place, typically during a war, riot, or after a battle in a video game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>loot</w> the city after the enemy forces retreated.",
                            "target_lang_translations": {
                                "ru": "Солдаты начали <w>разграблять</w> город после отступления вражеских войск."
                            }
                        },
                        {
                            "text": "In many role-playing games, players can <w>loot</w> bodies to find rare items and gold.",
                            "target_lang_translations": {
                                "ru": "Во многих ролевых играх игроки могут <w>лутать</w> тела, чтобы найти редкие предметы и золото."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunder",
                        "sack"
                    ],
                    "common_phrases": [
                        "loot the city",
                        "loot the temple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грабить или расхищать имущество, обычно во время войны, беспорядков или при сборе добычи в видеоиграх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разграблять",
                                "target_lang_sense_clarification": "о месте или городе"
                            },
                            {
                                "target_lang_word": "мародерствовать",
                                "target_lang_sense_clarification": "во время войны или бедствий"
                            },
                            {
                                "target_lang_word": "лутать",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc320309-d995-3b3d-a136-1baf9d23fd4d",
                    "sense_definition": "To rob someone or steal something using violence or threats.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bandits planned to <w>loot</w> the travelers as they passed through the narrow mountain pass.",
                            "target_lang_translations": {
                                "ru": "Бандиты планировали <w>ограбить</w> путешественников, когда те будут проходить через узкий горный перевал."
                            }
                        },
                        {
                            "text": "He was accused of trying to <w>loot</w> the merchant by threatening him with a weapon.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в попытке <w>обобрать</w> торговца, угрожая ему оружием."
                            }
                        }
                    ],
                    "synonyms": [
                        "rob"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограбить кого-либо или украсть что-либо, используя насилие или угрозы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабить",
                                "target_lang_sense_clarification": "отнимать силой"
                            },
                            {
                                "target_lang_word": "обчищать",
                                "target_lang_sense_clarification": "разг., полностью обкрадывать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5984f9e-6950-32a7-8b53-87f3eb902ab3",
                    "sense_definition": "Goods or valuables taken from an enemy or a place by force, especially during war or in video games.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stolen goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates divided the <w>loot</w> equally among the crew members after the raid.",
                            "target_lang_translations": {
                                "ru": "Пираты поровну разделили <w>добычу</w> между членами команды после набега."
                            }
                        },
                        {
                            "text": "After defeating the boss, the players gathered all the <w>loot</w> from the floor.",
                            "target_lang_translations": {
                                "ru": "После победы над боссом игроки собрали весь <w>лут</w> с пола."
                            }
                        }
                    ],
                    "synonyms": [
                        "booty",
                        "plunder"
                    ],
                    "common_phrases": [
                        "valuable loot",
                        "hidden loot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товары или ценности, захваченные силой у врага или в определенном месте, особенно во время войны или в видеоиграх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добыча",
                                "target_lang_sense_clarification": "захваченные ценности"
                            },
                            {
                                "target_lang_word": "трофеи",
                                "target_lang_sense_clarification": "военные или игровые"
                            },
                            {
                                "target_lang_word": "лут",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "награбленное",
                                "target_lang_sense_clarification": "имущество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f1a9e24-4f89-37aa-9551-484d941c4ef1",
                    "sense_definition": "A slang term for money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent a lot of <w>loot</w> on that fancy new sports car.",
                            "target_lang_translations": {
                                "ru": "Он спустил кучу <w>бабла</w> на этот шикарный новый спорткар."
                            }
                        },
                        {
                            "text": "I need to earn some more <w>loot</w> before I can afford a vacation.",
                            "target_lang_translations": {
                                "ru": "Мне нужно заработать еще немного <w>денег</w>, прежде чем я смогу позволить себе отпуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "money"
                    ],
                    "common_phrases": [
                        "lot of loot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for money"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабло",
                                "target_lang_sense_clarification": "жарг."
                            },
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "жарг."
                            },
                            {
                                "target_lang_word": "деньжата",
                                "target_lang_sense_clarification": "разг."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db9b315c-090b-3c5c-b7a5-76add8bc8e12",
                    "sense_definition": "Valuable items or gifts received for free.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gifts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to see all the <w>loot</w> they received on Christmas morning.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге от всех тех <w>подарков</w>, которые они получили рождественским утром."
                            }
                        },
                        {
                            "text": "The conference attendees walked away with bags full of free <w>loot</w> from the sponsors.",
                            "target_lang_translations": {
                                "ru": "Участники конференции ушли с сумками, полными бесплатной <w>халявы</w> от спонсоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "free loot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for party favors or gifts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценные вещи или подарки, полученные бесплатно (например, сувениры на мероприятии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "халява",
                                "target_lang_sense_clarification": "разг., бесплатные вещи"
                            },
                            {
                                "target_lang_word": "подарки",
                                "target_lang_sense_clarification": "бесплатные сувениры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d7c8bfd-7cf8-3601-9e19-ee866266b71c",
                    "sense_definition": "A shortened form of the word <w>lieutenant</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant told the private to go wake up the <w>loot</w> at the station.",
                            "target_lang_translations": {
                                "ru": "Сержант велел рядовому пойти и разбудить <w>лейтенанта</w> на посту."
                            }
                        },
                        {
                            "text": "The men often referred to their commanding officer as the <w>loot</w> when he wasn't around.",
                            "target_lang_translations": {
                                "ru": "Солдаты часто называли своего командира <w>лехой</w>, когда его не было рядом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military or police clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова «лейтенант»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "леха",
                                "target_lang_sense_clarification": "армейский жарг., лейтенант"
                            },
                            {
                                "target_lang_word": "лейтенантик",
                                "target_lang_sense_clarification": "разг."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ad224e-2b10-39f0-bbc6-ae9eebab191c",
                    "sense_definition": "A specialized scoop used in saltworks to remove scum from brine pans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker used a wooden <w>loot</w> to clear the surface of the boiling brine.",
                            "target_lang_translations": {
                                "ru": "Рабочий использовал деревянный <w>скребок</w>, чтобы очистить поверхность кипящего рассола."
                            }
                        },
                        {
                            "text": "Maintaining the <w>loot</w> was essential for keeping the salt production clean.",
                            "target_lang_translations": {
                                "ru": "Поддержание <w>инструмента</w> в порядке было необходимо для чистоты производства соли."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in salt production"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный скребок или ковш, используемый на солеварнях для удаления пены с рассола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скребок",
                                "target_lang_sense_clarification": "для очистки рассола"
                            },
                            {
                                "target_lang_word": "шумовка",
                                "target_lang_sense_clarification": "техн., для удаления пены"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}