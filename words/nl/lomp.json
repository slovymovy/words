{
    "word_family": [
        "lompheid",
        "lomperd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c964af74-a9aa-3486-92d2-374aa304875f",
                    "sense_definition": "zich op een onwellevende en onbehouwen manier gedragend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onbeleefd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doe eens niet zo <w>lomp</w> tegen je grootmoeder.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>rude</w> to your grandmother.",
                                "ru": "Не веди себя так <w>грубо</w> со своей бабушкой."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>lomp</w> antwoord op mijn vriendelijke vraag.",
                            "target_lang_translations": {
                                "en": "He gave a <w>churlish</w> answer to my friendly question.",
                                "ru": "Он дал <w>хамский</w> ответ на мой вежливый вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "bot",
                        "grof",
                        "onbeleefd",
                        "ongemanierd",
                        "onbeschoft",
                        "plomp"
                    ],
                    "antonyms": [
                        "beleefd",
                        "verfijnd",
                        "hoffelijk"
                    ],
                    "common_phrases": [
                        "lomp gedrag",
                        "lomp antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "behaving in an impolite, coarse, or uncouth manner",
                        "ru": "ведущий себя невежливо, грубо или неотесанно"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "lacking in refinement or civility"
                            },
                            {
                                "target_lang_word": "churlish",
                                "target_lang_sense_clarification": "surly and ungracious"
                            },
                            {
                                "target_lang_word": "coarse",
                                "target_lang_sense_clarification": "rough or crude in manners"
                            },
                            {
                                "target_lang_word": "boorish",
                                "target_lang_sense_clarification": "resembling a boor; ill-mannered"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "невежливый в общении"
                            },
                            {
                                "target_lang_word": "неотесанный",
                                "target_lang_sense_clarification": "невоспитанный, лишенный манер"
                            },
                            {
                                "target_lang_word": "невежливый",
                                "target_lang_sense_clarification": "нарушающий правила приличия"
                            },
                            {
                                "target_lang_word": "хамский",
                                "target_lang_sense_clarification": "крайне грубый и наглый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c868467-8fe2-3d48-9bf5-471e56a8aa2d",
                    "sense_definition": "gebrek aan intelligentie of handigheid tonend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>lompe</w> fout om de sleutels in de auto te laten liggen.",
                            "target_lang_translations": {
                                "en": "It was a <w>stupid</w> mistake to leave the keys in the car.",
                                "ru": "Это была <w>глупая</w> ошибка — оставить ключи в машине."
                            }
                        },
                        {
                            "text": "Hoe kun je nu zo <w>lomp</w> zijn om dat niet te begrijpen?",
                            "target_lang_translations": {
                                "en": "How can you be so <w>clumsy</w> as to not understand that?",
                                "ru": "Как можно быть таким <w>несообразительным</w>, чтобы этого не понять?"
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeleefd"
                    ],
                    "antonyms": [
                        "slim",
                        "handig"
                    ],
                    "common_phrases": [
                        "lompe fout"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele contexten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "showing a lack of intelligence, tact, or dexterity",
                        "ru": "проявляющий недостаток ума, сообразительности или ловкости"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clumsy",
                                "target_lang_sense_clarification": "lacking skill or grace"
                            },
                            {
                                "target_lang_word": "stupid",
                                "target_lang_sense_clarification": "showing a lack of intelligence"
                            },
                            {
                                "target_lang_word": "tactless",
                                "target_lang_sense_clarification": "lacking sensitivity in dealing with others"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "неразумный"
                            },
                            {
                                "target_lang_word": "неуклюжий",
                                "target_lang_sense_clarification": "неловкий в действиях"
                            },
                            {
                                "target_lang_word": "топорный",
                                "target_lang_sense_clarification": "грубо сделанный или бестолковый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a090dbd8-eddc-3a0d-928f-68fad30b7147",
                    "sense_definition": "een oude, gescheurde of versleten lap stof",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arme man droeg slechts een paar oude <w>lompen</w>.",
                            "target_lang_translations": {
                                "en": "The poor man wore only a few old <w>rags</w>.",
                                "ru": "Бедняк был одет лишь в несколько старых <w>тряпок</w>."
                            }
                        },
                        {
                            "text": "Zij verzamelden <w>lompen</w> om papier van te maken.",
                            "target_lang_translations": {
                                "en": "They collected <w>rags</w> to make paper from.",
                                "ru": "Они собирали <w>ветошь</w> для производства бумаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "lor",
                        "vod"
                    ],
                    "common_phrases": [
                        "oude lompen"
                    ],
                    "target_lang_definitions": {
                        "en": "an old, torn, or worn-out piece of cloth",
                        "ru": "старый, разорванный или изношенный кусок ткани"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rag",
                                "target_lang_sense_clarification": "a piece of old cloth"
                            },
                            {
                                "target_lang_word": "tatter",
                                "target_lang_sense_clarification": "a torn piece of hanging cloth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "лоскут старой ткани"
                            },
                            {
                                "target_lang_word": "ветошь",
                                "target_lang_sense_clarification": "старое тряпье"
                            },
                            {
                                "target_lang_word": "лохмотья",
                                "target_lang_sense_clarification": "рваная одежда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd4e081-f632-33b0-bb8f-c8b670231cd4",
                    "sense_definition": "benaming voor verschillende soorten vissen met een plomp, grof uiterlijk, zoals de kwabaal",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>lomp</w> is een vis die in koud water leeft.",
                            "target_lang_translations": {
                                "en": "The <w>tusk</w> is a fish that lives in cold water.",
                                "ru": "<w>Морская щука</w> — это рыба, обитающая в холодной воде."
                            }
                        },
                        {
                            "text": "Vissers vangen soms een <w>lomp</w> in de noordelijke zeeën.",
                            "target_lang_translations": {
                                "en": "Fishermen sometimes catch a <w>burbot</w> in the northern seas.",
                                "ru": "Рыбаки иногда вылавливают <w>ломпа</w> в северных морях."
                            }
                        }
                    ],
                    "synonyms": [
                        "slijmvis"
                    ],
                    "target_lang_definitions": {
                        "en": "a name for various types of fish with a blunt, coarse appearance, such as the burbot",
                        "ru": "название различных видов рыб с массивным, грубым внешним видом, таких как морская щука"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tusk",
                                "target_lang_sense_clarification": "the fish Brosme brosme"
                            },
                            {
                                "target_lang_word": "burbot",
                                "target_lang_sense_clarification": "a cod-like freshwater fish"
                            },
                            {
                                "target_lang_word": "ling",
                                "target_lang_sense_clarification": "a long-bodied marine fish"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "морская щука",
                                "target_lang_sense_clarification": "рыба семейства тресковых (Molva molva)"
                            },
                            {
                                "target_lang_word": "ломп",
                                "target_lang_sense_clarification": "прямое заимствование названия рыбы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}