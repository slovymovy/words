                    {
                        "translation_id": "b669c283-54bc-46f9-80e5-4054f9a2f1de",
                        "source_entry_id": "4b428b4b-dfaa-3aaa-91f2-d8c201d73dec",
                        "source_sense_id": "4cac7ac6-cf1f-3789-9302-5016febd0091",
                        "target_lang_word": "Manuskript",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manuskript",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                        "entry_id": "428940fe-fd8c-31dd-b9e9-ce8325258bdd",
                                        "glosses": [
                                            "handschriftlich verfasstes Werk"
                                        ],
                                        "tags": [
                                            "Bibliothekswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b7e16c-13ec-402b-b1f7-b1c261ca0d45",
                                                "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                                "text": "Ein von Hand geschriebener Brief ist ein Manuskript."
                                            },
                                            {
                                                "example_id": "89a7c82d-cf61-4da0-b103-bd3559792599",
                                                "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                                "text": "Sie hat das Manuskript dem Verlag vorgelegt."
                                            },
                                            {
                                                "example_id": "d2d7d064-fe70-4787-bd35-3bb628fd363b",
                                                "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                                "text": "„Inhaltlich waren fast alle aus Ägypten der Forschung zugänglich gemachten koptischen Manuskripte kirchlichen Charakters - es waren Liturgien, Übersetzungen von Bibelabschnitten, Märtyrerleben.“"
                                            },
                                            {
                                                "example_id": "a20bf4a4-2158-4259-b4fa-2c0c4f140d4b",
                                                "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                                "text": "„Diesmal ist es aber kein griechisches Manuskript, sondern ein demotischer Papyrus.“"
                                            },
                                            {
                                                "example_id": "d04f8d3e-d37a-41a0-bdd9-50bac01f9a89",
                                                "sense_id": "e9501831-6d37-313f-b8bf-014ba1f08fde",
                                                "text": "„Der Stifter der Manuskripte war ein talentierter junger Mann um die dreißig und aus vornehmer Familie, der den Namen Sir Kenelm Digby trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                        "entry_id": "428940fe-fd8c-31dd-b9e9-ce8325258bdd",
                                        "glosses": [
                                            "hand- oder maschinenschriftlicher Beitrag eines Autors, der als Vorlage zur Vervielfältigung dient"
                                        ],
                                        "tags": [
                                            "Verlagswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27dcac3-0124-4e75-971f-ad5e75ec96be",
                                                "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                                "text": "Der Autor lieferte sein Manuskript nicht fristgerecht beim Verlag ab."
                                            },
                                            {
                                                "example_id": "8124d939-1084-4343-a57e-dab2bf33324e",
                                                "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                                "text": "„Comenius hatte das Manuskript 1655 dem Nürnberger Verleger Michael Endter zugeschickt.“"
                                            },
                                            {
                                                "example_id": "963a641b-3fb3-4e18-9ac0-a9a0df6ce002",
                                                "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                                "text": "„Die erste Fassung des Manuskripts war verbrannt.“"
                                            },
                                            {
                                                "example_id": "51ea5efb-2ca6-4f03-aef5-e7524d5ef7ea",
                                                "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                                "text": "„Tatsächlich gab es nur wenige, die in ihren Manuskripten über ein Minimum hinaus Satzzeichen setzten: Bis ins 19. Jahrhundert war die Zeichensetzung eine Frage des Geschmacks, was bis zu einem gewissen Grad auch heute noch gilt.“"
                                            },
                                            {
                                                "example_id": "d486a144-c4f5-44a5-b984-27a01fa112f8",
                                                "sense_id": "65ec3f8b-9f01-3a59-8f4f-f40d0ad29b75",
                                                "text": "„Im Oktober 1944 gelingt es Fallada, sein Manuskript nach draußen zu schmuggeln, am 4. Dezember wird er entlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51ef2f14-6a2a-342c-ad81-28361916bb28",
                                        "entry_id": "428940fe-fd8c-31dd-b9e9-ce8325258bdd",
                                        "glosses": [
                                            "eigenhändige Notizen für einen bestimmten Zweck, zum Beispiel für einen Vortrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17571ca4-8dc9-4ff5-a217-d2ca682cf248",
                                                "sense_id": "51ef2f14-6a2a-342c-ad81-28361916bb28",
                                                "text": "„Noch während des Festaktes arbeitet Patrice Émery Lumumba am Manuskript auf seinen Knien.“"
                                            },
                                            {
                                                "example_id": "98281a1b-8e2c-4070-afcd-9af4a80551dd",
                                                "sense_id": "51ef2f14-6a2a-342c-ad81-28361916bb28",
                                                "text": "„Doch »Paris, die Hauptstadt des 19. Jahrhunderts« blieb unvollendet, obwohl in seinem Nachlass nach dem Kriege ein großes Konvolut aus Manuskripten, Zetteln, Notizen gefunden wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
