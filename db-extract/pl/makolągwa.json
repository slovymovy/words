                        "glosses": [
                            "Carduelis cannabina, mniejszy od wróbla ptak gniazdujący w krzewach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0bcb208-c8f5-40d4-9870-8140e15fe2b5",
                                "sense_id": "3f0c891f-d69a-3726-b3ef-eba524a7088b",
                                "text": "Później korzystały z nich tylko wróble, dzierlatki, pliszki, srokosze, makolągwy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
