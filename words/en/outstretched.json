{
    "word_family": [
        "outstretch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d409ae1d-3dd0-359e-ad2a-9feb7b7bbbee",
                    "sense_definition": "Extended or stretched out to a full length.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extended",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They ran towards each other with <w>outstretched</w> arms, and the credits rolled.",
                            "target_lang_translations": {
                                "tr": "Birbirlerine <w>uzatılmış</w> kollarla koştular ve jenerik aktı."
                            }
                        },
                        {
                            "text": "The defender blocked the ball with an <w>outstretched</w> leg.",
                            "target_lang_translations": {
                                "tr": "Savunma oyuncusu topu <w>uzatılmış</w> bir bacakla engelledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "extended",
                        "stretched"
                    ],
                    "antonyms": [
                        "retracted"
                    ],
                    "common_phrases": [
                        "outstretched arms",
                        "outstretched hand"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam uzunluğuna kadar uzatılmış veya gerilmiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uzatılmış",
                                "target_lang_sense_clarification": "Bir uzvun veya nesnenin dışarıya doğru açılmış hali."
                            },
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "Özellikle kolların veya ellerin karşılamaya hazır şekilde açılması."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "037eecf0-b949-3773-a6f2-9392663bd9a0",
                    "sense_definition": "Simple past and past participle of <w>outstretch</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extended",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>outstretched</w> his hand to greet the new guest.",
                            "target_lang_translations": {
                                "tr": "Yeni misafiri karşılamak için elini <w>uzattı</w>."
                            }
                        },
                        {
                            "text": "She had <w>outstretched</w> her arms to catch the falling child.",
                            "target_lang_translations": {
                                "tr": "Düşen çocuğu yakalamak için kollarını <w>uzatmıştı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Uzatmak fiilinin geçmiş zaman veya ortaç hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uzattı",
                                "target_lang_sense_clarification": "Bir şeyi ileriye doğru germek veya sunmak eyleminin geçmiş zamanı."
                            },
                            {
                                "target_lang_word": "uzatmış",
                                "target_lang_sense_clarification": "Bir şeyi ileriye doğru germek veya sunmak eyleminin geçmiş zaman ortacı."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}