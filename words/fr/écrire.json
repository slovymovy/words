                    ]
                },
                {
                    "sense_id": "73c93ce1-d009-3015-aeee-b0eb5a01533d",
                    "sense_definition": "Concevoir et rédiger une œuvre littéraire, un article ou un texte de fond.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur renommé passe plusieurs années à <w>écrire</w> un nouveau roman historique."
                        },
                        {
                            "text": "Elle souhaite <w>écrire</w> un article complet sur la situation économique."
                        }
                    ],
                    "synonyms": [
                        "composer",
                        "rédiger"
                    ],
                    "common_phrases": [
                        "écrire un roman",
                        "écrire un livre",
                        "écrire un poème"
                    ]
                },
                {
                    "sense_id": "625a62c0-d4de-3054-81b9-f441f3631e4a",
                    "sense_definition": "Enregistrer des informations ou des données numériques sur un support de stockage.",
