                "senses": [
                    {
                        "sense_id": "bec4e578-4dc1-361a-9492-5456e06c608b",
                        "entry_id": "ade7e8ac-a922-31d8-93f5-c87f1d17f70a",
                        "glosses": [
                            "am Gürtel, Oberschenkel oder an der Schulter befestigte Leder- oder Kunststoff-Tasche für eine schnell greifbare Handfeuerwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a302d5ca-faaf-4ed3-89b2-8e177f905c35",
                                "sense_id": "bec4e578-4dc1-361a-9492-5456e06c608b",
                                "text": "„Im ersten Schreck greifen sie zu ihren Pistolen, schauen sich dann wortlos an und stecken ihre Ballermänner zurück in die Holster.“"
                            },
                            {
                                "example_id": "3365b60d-76bf-4153-a4bf-b58ee78c5fad",
                                "sense_id": "bec4e578-4dc1-361a-9492-5456e06c608b",
                                "text": "„Er legte eine Hand auf die Waffe, die im Holster an seinem Gürtel steckte.“"
                            },
                            {
                                "example_id": "04988bf0-e41d-4ed2-8fd9-767191eb0235",
                                "sense_id": "bec4e578-4dc1-361a-9492-5456e06c608b",
                                "text": "„Dann zogen sie ihre Waffen aus dem Holster und gingen leise zum Wöllhaus.“"
                            },
                            {
                                "example_id": "ede1d161-8606-4dce-b430-61208b5fe826",
                                "sense_id": "bec4e578-4dc1-361a-9492-5456e06c608b",
                                "text": "„Im Holster baumelt die Walther, zur Sicherheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
