                                                "example_id": "ef4e8091-fd22-4708-b0ce-07fee00b2e0d",
                                                "sense_id": "7aa08473-263e-3f41-9d41-8aa599229f6d",
                                                "text": "She is employed by a waterworks at the outskirts of the city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7478405c-5261-3de9-afba-138aa98c6ce9",
                                        "entry_id": "b7dc481d-c80e-3224-b3dc-096a7a80eee6",
                                        "glosses": [
                                            "Often in the form turn on the waterworks: crying or tears, especially in a way that is considered manipulative or over-emotional."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "842b16d6-452f-4407-98a2-ce6823c6e65f",
                                                "sense_id": "7478405c-5261-3de9-afba-138aa98c6ce9",
                                                "text": "She turned on the waterworks when we told her the old man was dead, but she was asking questions about the will soon enough."
                                            }
                                        ]
                                    },
