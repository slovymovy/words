                "senses": [
                    {
                        "sense_id": "5945fecf-d4ee-3948-ab04-fb9d2184b911",
                        "entry_id": "623078e9-db9b-37a1-86ff-95d235bdcdb8",
                        "glosses": [
                            "korte beschrijving of simpele tekening van een bepaalde plek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3673f1ef-b90a-4fd2-9eab-4bba1358d5fd",
                                "sense_id": "5945fecf-d4ee-3948-ab04-fb9d2184b911",
                                "text": "Hendriks sloeg de stofmap open, en bladerde in papieren - net zo lang tot hij een situatieschets gevonden had van het kruispunt Hobbemastraat/Stadhouderskade, compleet met de kinderlijke afbeelding van een rood autootje."
                            },
                            {
                                "example_id": "5350c87e-c137-4199-9700-9a0453fcfd4c",
                                "sense_id": "5945fecf-d4ee-3948-ab04-fb9d2184b911",
                                "text": "\"Mensen eten uit vuilnisbakken en kinderen sterven van de honger.\" Het lijkt een situatieschets van een land waar al jaren hongersnood heerst. Maar dit gaat over Venezuela, niet zolang geleden een van de rijkste landen van Zuid-Amerika dankzij de grote olievoorraden. Nu verkeert het in een zware economische en politieke crisis en daar lijkt het maar moeilijk uit te komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7724f8c2-7da1-4935-8e44-662bcf8d4ea0",
                        "source_entry_id": "623078e9-db9b-37a1-86ff-95d235bdcdb8",
                        "source_sense_id": "5945fecf-d4ee-3948-ab04-fb9d2184b911",
                        "source_sense_description": "korte beschrijving of simpele tekening van een bepaalde plek",
                        "target_lang_word": "plan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "993a5f3e-39b6-32ce-9fa0-b8fed93e557d",
                                        "entry_id": "ef2f4427-0180-3883-9787-da2b9d568852",
                                        "glosses": [
                                            "A drawing showing technical details of a building, machine, etc., with unwanted details omitted, and often using symbols rather than detailed drawing to represent doors, valves, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2830448c-58a9-4694-b25a-358d1975261a",
                                                "sense_id": "993a5f3e-39b6-32ce-9fa0-b8fed93e557d",
                                                "text": "The plans for many important buildings were once publicly available."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c124df-c5b9-399f-99cf-f75ac8d483b2",
                                        "entry_id": "ef2f4427-0180-3883-9787-da2b9d568852",
                                        "glosses": [
                                            "A set of intended actions, usually mutually related, through which one expects to achieve a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ccc348-5874-409a-9103-5cd4f704ac1e",
                                                "sense_id": "65c124df-c5b9-399f-99cf-f75ac8d483b2",
                                                "text": "He didn't really have a plan; he had a goal and a habit of control."
                                            },
                                            {
                                                "example_id": "a06ada59-3832-4b84-a182-d3d749089d3c",
                                                "sense_id": "65c124df-c5b9-399f-99cf-f75ac8d483b2",
                                                "text": "Life is what happens to you / While you're busy making other plans"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eafa969-23d5-3df2-8fe0-545dbc78e5c5",
                                        "entry_id": "ef2f4427-0180-3883-9787-da2b9d568852",
                                        "glosses": [
                                            "A two-dimensional drawing of a building as seen from above with obscuring or irrelevant details such as roof removed, or of a floor of a building, revealing the internal layout; as distinct from the elevation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4bd9eaa-1294-497b-8038-6824298d8a4f",
                                                "sense_id": "8eafa969-23d5-3df2-8fe0-545dbc78e5c5",
                                                "text": "Seen in plan, the building had numerous passageways not apparent to visitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6288d505-aa99-3ab3-8d1e-544f3f413d64",
                                        "entry_id": "ef2f4427-0180-3883-9787-da2b9d568852",
                                        "glosses": [
                                            "A method; a way of procedure; a custom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d16cdd0-1a0d-47d1-a6e4-331ebb92384b",
                                                "sense_id": "6288d505-aa99-3ab3-8d1e-544f3f413d64",
                                                "text": "The simple plan, / That they should take who have the power, / And they should keep who can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cec1b71-0147-30aa-b3b4-564f7d3aa62a",
                                        "entry_id": "ef2f4427-0180-3883-9787-da2b9d568852",
                                        "glosses": [
                                            "A subscription to a service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8cf609-fc99-4eba-9677-bf3ec9028368",
                                                "sense_id": "6cec1b71-0147-30aa-b3b4-564f7d3aa62a",
                                                "text": "a phone plan"
                                            },
                                            {
                                                "example_id": "4fb5ff45-b5d2-49d4-8b0d-801e618db235",
                                                "sense_id": "6cec1b71-0147-30aa-b3b4-564f7d3aa62a",
                                                "text": "an Internet plan"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afe44b17-86e7-35ba-a8dc-9df70c149144",
                                        "entry_id": "70b905a4-390c-30b1-a28a-63e89b0e1905",
                                        "glosses": [
                                            "To design (a building, machine, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7979ce0-5b01-428a-a6d5-91d2535ad039",
                                                "sense_id": "afe44b17-86e7-35ba-a8dc-9df70c149144",
                                                "text": "The architect planned the building for the client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27a73ab-3049-3512-871d-197c0e3a7673",
                                        "entry_id": "70b905a4-390c-30b1-a28a-63e89b0e1905",
                                        "glosses": [
                                            "To create a plan for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063938ec-31c0-4a4d-b717-ccc27804cc67",
                                                "sense_id": "c27a73ab-3049-3512-871d-197c0e3a7673",
                                                "text": "They jointly planned the project in phases, with good detail for the first month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f794de-46f1-3ea6-9b73-0abc6582f8b6",
                                        "entry_id": "70b905a4-390c-30b1-a28a-63e89b0e1905",
                                        "glosses": [
                                            "To intend."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73bddac-1313-4ed6-ab23-30e254d6efb5",
                                                "sense_id": "f8f794de-46f1-3ea6-9b73-0abc6582f8b6",
                                                "text": "He planned to go, but work intervened."
                                            },
                                            {
                                                "example_id": "402274c2-d86b-4d2d-9a26-f0a3dd0526a2",
                                                "sense_id": "f8f794de-46f1-3ea6-9b73-0abc6582f8b6",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7abcdc-b8fb-3e30-b2ed-9cde7b9ed1fc",
                                        "entry_id": "70b905a4-390c-30b1-a28a-63e89b0e1905",
                                        "glosses": [
                                            "To make a plan."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf15cf6-05d6-457a-926c-e10167edf54d",
                                                "sense_id": "bc7abcdc-b8fb-3e30-b2ed-9cde7b9ed1fc",
                                                "text": "They planned for the worst, bringing lots of emergency supplies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
