                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec4f60a-727b-4239-beea-a6291bbdaeb8",
                                                "sense_id": "5e8d543e-653b-3e80-bc92-e6b64db5d53a",
                                                "text": "Der Alkohol, der in der chemischen Industrie verwendet wird, wird zuvor vergällt."
