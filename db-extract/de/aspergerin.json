                "senses": [
                    {
                        "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                        "entry_id": "efe92b42-656d-394d-b5c5-dfd1b52967f2",
                        "glosses": [
                            "Einwohnerin der württembergischen Stadt Asperg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cca704d-117c-42f1-83e3-2f21fe8a4fdb",
                                "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                                "text": "„Doch es werde angesichts des Todes der jungen Aspergerin allenfalls ein ‚Festbetrieb mit angezogener Handbremse‘, wie Bürgermeister Eiberger sagt.“"
                            },
                            {
                                "example_id": "b994d5aa-10f2-4a87-8160-26364db56f93",
                                "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                                "text": "„Das Jubiläums-Etikett stammt aus der Feder der Aspergerin, Professorin Michaela Köhler von der Hochschule für Kommunikation und Gestaltung.“"
                            },
                            {
                                "example_id": "aed82859-235a-40af-aa99-833d3e86e359",
                                "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                                "text": "„Vermutlich hätte die Aspergerin zu Retina, Topaz, Remo, und wie sie alle heißen, auch jeweils Anekdoten auf Lager.“"
                            },
                            {
                                "example_id": "f903aac8-9f7f-473d-a577-9b5bfef866e7",
                                "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                                "text": "„Daisy Bolkart dribbelte sich in der 64. Minute bis kurz vor das Tor, wo die letzte Aspergerin zum Eckball klärte.“"
                            },
                            {
                                "example_id": "7aac2372-bb67-4509-be12-150cbe004333",
                                "sense_id": "25ccdb70-c7d0-337d-93af-11cbc0ced165",
                                "text": "„Doch Maren parierte den Schuss der Aspergerin glänzend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
