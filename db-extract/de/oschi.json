                "senses": [
                    {
                        "sense_id": "3374bc1c-5630-3ef5-af70-ea64c58469ec",
                        "entry_id": "46a65e4d-8ba0-357f-90bf-9b8a7811099e",
                        "glosses": [
                            "etwas, das durch seine Größe einen Eindruck hinterlässt"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "345c7568-4723-4a8c-b9ed-a04af860cee8",
                                "sense_id": "3374bc1c-5630-3ef5-af70-ea64c58469ec",
                                "text": "Mann, das ist aber ein Oschi!"
                            },
                            {
                                "example_id": "f5914c93-d7a4-44ab-94f6-ffbb729355f8",
                                "sense_id": "3374bc1c-5630-3ef5-af70-ea64c58469ec",
                                "text": "„Wenn Wiebke geahnt hätte, was für Spinnen bei uns auf dem Boden wohnten, hätte sie Asyl auf einem der Jupitermonde beantragt. Oschis mit haselnußgroßem Körper und pelzigen Beinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4a2ea80-218f-4554-90ae-b2e1e00521b7",
                        "source_entry_id": "46a65e4d-8ba0-357f-90bf-9b8a7811099e",
                        "source_sense_id": "3374bc1c-5630-3ef5-af70-ea64c58469ec",
                        "source_sense_description": "salopp: etwas, das durch seine Größe einen Eindruck hinterlässt",
                        "target_lang_word": "whopper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whopper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                        "entry_id": "05559051-0076-3e8e-9632-3c40fe327ad9",
                                        "glosses": [
                                            "Something remarkably large."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae534717-6ad6-487d-9a71-47647cf0a493",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "I’d gone out pike fishing, bless you, never thinking of a trout, and when I saw that whopper on the end of my line, blest if it didn’t quite take me aback. Well, you see, he weighed twenty-six pound."
                                            },
                                            {
                                                "example_id": "fed2456d-6de6-4924-afab-b2ceb3e03379",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "I’ve just run down from Ulster County to look at the town, bein’ that the hayin’s over with. Gosh! but it’s a whopper. I thought Poughkeepsie was some punkins; but this here town is five times as big."
                                            },
                                            {
                                                "example_id": "d8810abf-5e67-47d8-bb4f-f9d42d35198a",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "There's a storm blowing up, Sylvester—a 'whopper', speaking in the vernacular of the peasantry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                        "entry_id": "05559051-0076-3e8e-9632-3c40fe327ad9",
                                        "glosses": [
                                            "An outrageous or blatant lie."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5347f41d-b98c-4743-be26-59f9052f3ca9",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "When he got done telling it there was one of them uncomfortable silences that comes, you know, when a person has been telling a whopper and you feel sorry for him and wish you could think of some way to change the subject and let him down easy, […]"
                                            },
                                            {
                                                "example_id": "8dd56416-1a51-4e14-b0ed-560e757cbad2",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "Coming out with a whopper now. Rhapsodies about damn all. Believes his own lies. Does really. Wonderful liar. But want a good memory."
                                            },
                                            {
                                                "example_id": "a13c5af5-6488-409b-9bfa-c8638dcbba4a",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "Isuzu Inc. hit pay dirt in the late '80s with its series of “Joe Isuzu” spots, featuring an oily, Satanic-looking salesman who told whoppers about Isuzu's genuine llama-skin upholstery and ability to run on tapwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3ef51b6-e38c-4975-9814-92d649d0a039",
                        "source_entry_id": "46a65e4d-8ba0-357f-90bf-9b8a7811099e",
                        "source_sense_id": "3374bc1c-5630-3ef5-af70-ea64c58469ec",
                        "source_sense_description": "salopp: etwas, das durch seine Größe einen Eindruck hinterlässt",
                        "target_lang_word": "кабанчик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кабанчик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4a53f313-86e0-31d7-a3d1-29148dceffc9",
                                        "entry_id": "4ea66719-415e-35e0-8ce0-9f01ef5ccd10",
                                        "glosses": [
                                            "уменьш.-ласк. к кабан; маленький кабан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5683bef5-546c-45d4-a999-100833046e8d",
                                                "sense_id": "4a53f313-86e0-31d7-a3d1-29148dceffc9",
                                                "text": "— Ещё я кабанчика откармливаю, осенью зарежем, — на всю зиму колба́сы будут, ветчина, сало."
                                            },
                                            {
                                                "example_id": "ab0cb676-1209-429b-99b3-c6f8bda89684",
                                                "sense_id": "4a53f313-86e0-31d7-a3d1-29148dceffc9",
                                                "text": "Он охотник, и пусть ещё не сезон, но ведь есть же у него знакомые егеря — пусть застрелят кабанчика или лося или, на худой конец, поделятся из старых запасов…"
                                            },
                                            {
                                                "example_id": "108eda3c-aa89-43f4-b98b-fdeac514d59d",
                                                "sense_id": "4a53f313-86e0-31d7-a3d1-29148dceffc9",
                                                "text": "Зато был симпатичный дикий кабанчик Борька."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
