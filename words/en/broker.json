{
    "word_family": [
        "brokerage",
        "brokering",
        "pawnbroker",
        "stockbroker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98b0effe-4c05-399a-a1e9-768d8159b971",
                    "sense_definition": "A person who acts as a mediator between a buyer and a seller, often for a commission.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mediator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The real estate <w>broker</w> showed us several houses that fit our budget.",
                            "target_lang_translations": {
                                "ru": "Агент по недвижимости (<w>брокер</w>) показал нам несколько домов, соответствующих нашему бюджету."
                            }
                        },
                        {
                            "text": "You should consult an insurance <w>broker</w> to find the best policy for your car.",
                            "target_lang_translations": {
                                "ru": "Вам следует проконсультироваться со страховым <w>брокером</w>, чтобы найти лучший полис для вашего автомобиля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "insurance broker",
                        "real estate broker",
                        "mortgage broker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, выступающее в качестве посредника между покупателем и продавцом, часто за комиссионное вознаграждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брокер",
                                "target_lang_sense_clarification": "универсальный термин для посредника"
                            },
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "лицо, помогающее в сделке"
                            },
                            {
                                "target_lang_word": "маклер",
                                "target_lang_sense_clarification": "посредник при заключении сделок, часто с недвижимостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c7abd9d-b066-3287-adea-d5e708c44f11",
                    "sense_definition": "A professional who buys and sells stocks and other securities on behalf of clients.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mediator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He called his <w>broker</w> to sell his shares before the market closed.",
                            "target_lang_translations": {
                                "ru": "Он позвонил своему <w>брокеру</w>, чтобы продать акции до закрытия рынка."
                            }
                        },
                        {
                            "text": "A professional stock <w>broker</w> can help you manage your investment portfolio.",
                            "target_lang_translations": {
                                "ru": "Профессиональный биржевой <w>брокер</w> поможет вам управлять вашим инвестиционным портфелем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stock broker",
                        "investment broker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессионал, который покупает и продает акции и другие ценные бумаги от имени клиентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брокер",
                                "target_lang_sense_clarification": "биржевой или фондовый специалист"
                            },
                            {
                                "target_lang_word": "биржевой маклер",
                                "target_lang_sense_clarification": "посредник на фондовом рынке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95227d6e-cd10-37c5-af03-b7f5495a3e8f",
                    "sense_definition": "A person who liaises between two or more parties to attempt to achieve a specific outcome or agreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mediator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat acted as an honest <w>broker</w> during the difficult peace negotiations.",
                            "target_lang_translations": {
                                "ru": "Дипломат выступил в роли честного <w>посредника</w> в ходе трудных мирных переговоров."
                            }
                        },
                        {
                            "text": "She served as a power <w>broker</w> in the city's political scene for decades.",
                            "target_lang_translations": {
                                "ru": "Она десятилетиями была влиятельным <w>посредником</w> на политической арене города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honest broker",
                        "power broker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, осуществляющее связь между двумя или более сторонами для достижения определенного результата или соглашения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "в переговорах или политике"
                            },
                            {
                                "target_lang_word": "доверенное лицо",
                                "target_lang_sense_clarification": "влиятельный посредник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d398019-76e6-37d5-955c-a6b333fbae34",
                    "sense_definition": "An agent or software component involved in the exchange of messages or digital transactions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mediator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The message <w>broker</w> ensures that data is correctly routed between different applications.",
                            "target_lang_translations": {
                                "ru": "<w>Брокер</w> сообщений обеспечивает правильную маршрутизацию данных между различными приложениями."
                            }
                        },
                        {
                            "text": "We need to configure the data <w>broker</w> to handle the increased traffic.",
                            "target_lang_translations": {
                                "ru": "Нам нужно настроить <w>брокер</w> данных для обработки возросшего трафика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "message broker",
                        "data broker"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Агент или программный компонент, участвующий в обмене сообщениями или цифровых транзакциях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брокер",
                                "target_lang_sense_clarification": "программный компонент, например, брокер сообщений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                    "sense_definition": "To arrange or negotiate the details of a deal, agreement, or alliance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries managed to <w>broker</w> a deal that ended the trade war.",
                            "target_lang_translations": {
                                "ru": "Двум странам удалось <w>заключить</w> сделку, положившую конец торговой войне."
                            }
                        },
                        {
                            "text": "The United Nations helped <w>broker</w> a ceasefire between the warring factions.",
                            "target_lang_translations": {
                                "ru": "Организация Объединенных Наций помогла <w>достичь</w> соглашения о прекращении огня между враждующими сторонами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broker a deal",
                        "broker a peace",
                        "broker an agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или согласовывать детали сделки, соглашения или союза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать посредником",
                                "target_lang_sense_clarification": "в переговорах"
                            },
                            {
                                "target_lang_word": "организовывать",
                                "target_lang_sense_clarification": "согласовывать условия сделки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d4fecd4-7d81-36b9-830d-3e8d6ad99749",
                    "sense_definition": "To act as a mediator in a sale or commercial transaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negotiate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firm specializes in <w>brokering</w> large-scale international commodity trades.",
                            "target_lang_translations": {
                                "ru": "Фирма специализируется на <w>посредничестве</w> в крупных международных товарных сделках."
                            }
                        },
                        {
                            "text": "He spent his career <w>brokering</w> transactions between tech startups and investors.",
                            "target_lang_translations": {
                                "ru": "Он провел свою карьеру, <w>организовывая</w> сделки между технологическими стартапами и инвесторами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brokering transactions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать в качестве посредника в продаже или коммерческой сделке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься брокерской деятельностью",
                                "target_lang_sense_clarification": "профессиональное посредничество"
                            },
                            {
                                "target_lang_word": "посредничать",
                                "target_lang_sense_clarification": "в коммерческих операциях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf2fc302-dbb4-3ee6-ba94-2d74b510642e",
                    "sense_definition": "The comparative form of <w>broke</w>, meaning having even less money.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After paying his rent, he was even <w>broker</w> than he was last month.",
                            "target_lang_translations": {
                                "ru": "После оплаты аренды он оказался еще <w>беднее</w>, чем в прошлом месяце."
                            }
                        },
                        {
                            "text": "I am <w>broker</w> than usual this week because of the car repairs.",
                            "target_lang_translations": {
                                "ru": "На этой неделе я еще больше <w>на мели</w>, чем обычно, из-за ремонта машины."
                            }
                        }
                    ],
                    "synonyms": [
                        "broke"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage of comparative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная форма слова «broke» (на мели), означающая наличие еще меньшего количества денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еще беднее",
                                "target_lang_sense_clarification": "в финансовом плане"
                            },
                            {
                                "target_lang_word": "еще больше на мели",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9b9c6b7a-6b81-34ec-b6cd-cc5c664dce77",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Broker</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Брокера</w>."
                            }
