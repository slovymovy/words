                ],
                "senses": [
                    {
                        "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                        "entry_id": "f778e899-d8fa-3461-9cbf-70c1a49f0f91",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc32ce25-4524-45e0-adba-af2de260e7d3",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Frau Siebenhaar ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "213348ec-6c36-4411-ac93-3959533f7d72",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Herr Siebenhaar wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cff0fe5b-ed7b-4dbd-be4f-5660258c50b9",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Die Siebenhaars fahren heute ins Hessische Bergland."
                            },
                            {
                                "example_id": "ddb2cdd2-f8ac-4af5-8afd-b75be43d80cd",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Der Siebenhaar trägt nie die Schals, die die Siebenhaar ihm strickt."
                            },
                            {
                                "example_id": "c3882d80-ac85-4700-899b-5552495067b6",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Siebenhaar kommt, geht der Herr Siebenhaar.“"
                            },
                            {
                                "example_id": "5c6cdfb6-1de9-4d29-b86c-74fb91cc3ad1",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Siebenhaar kommt und geht."
                            },
                            {
                                "example_id": "c7ea1aca-8359-458f-b8ff-4480dd06cb17",
                                "sense_id": "3980d0c1-e616-37ce-9280-442d504c5567",
                                "text": "Siebenhaars kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
