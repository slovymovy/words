            {
                "entry_id": "29400370-4e79-3a41-aaf7-44de835b87c9",
                "word": "tracering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8100ebec-2970-4779-b319-c0d80eab6827",
                        "entry_id": "29400370-4e79-3a41-aaf7-44de835b87c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "traceringen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "009e63ad-da50-3995-9c37-bd0312d5a0d0",
                        "entry_id": "29400370-4e79-3a41-aaf7-44de835b87c9",
                        "glosses": [
                            "de stenen versiering in geometrische patronen in het boogveld van gotische vensters en nissen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4093c66-8f9b-3408-81b3-af95ce5a157a",
                        "entry_id": "29400370-4e79-3a41-aaf7-44de835b87c9",
                        "glosses": [
                            "speurtocht naar de weg die iets of iemand heeft afgelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62743427-c340-4951-b35c-96cdf6e8f350",
                                "sense_id": "d4093c66-8f9b-3408-81b3-af95ce5a157a",
                                "text": "Het slachthuis heeft tot maandag de tijd gekregen om de tracering op orde te brengen. Anders wordt de erkenning geschorst en mogen er geen dieren meer worden geslacht."
                            },
                            {
                                "example_id": "224fbeae-67a1-4a80-b5be-6e24dd3a0f45",
                                "sense_id": "d4093c66-8f9b-3408-81b3-af95ce5a157a",
                                "text": ",,Juist wanneer men handelt in mosselen, een product met bovengemiddelde risico's wat betreft de voedselveiligheid, moet men doordrongen zijn van het grote belang van een snelle en juiste tracering en terughalen."
                            },
                            {
                                "example_id": "53d72b9e-0e2e-4890-b5ef-b7e87dd31c40",
                                "sense_id": "d4093c66-8f9b-3408-81b3-af95ce5a157a",
                                "text": "\"Er is in samenwerking met de Voedsel- en Warenautoriteit een uitgebreide tracering uitgevoerd waarmee is vastgesteld dat het product dat verdacht is op de aanwezigheid van de EHEC-bacterie niet aan andere klanten is verkocht\", aldus Beimer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1292bcd5-6340-45d8-b133-2fe494f22744",
                        "source_entry_id": "29400370-4e79-3a41-aaf7-44de835b87c9",
                        "source_sense_id": "009e63ad-da50-3995-9c37-bd0312d5a0d0",
                        "source_sense_description": "versiering in gotische vensters en nissen",
                        "target_lang_word": "tracery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de2b7ea9-8a54-334a-891a-67e34840a5ac",
                                        "entry_id": "a9b99f92-a346-336a-b5f1-be9b419e5688",
                                        "glosses": [
                                            "Bars or ribs, usually of stone or wood, or other material, that subdivide an opening or stand in relief against a door or wall as an ornamental feature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75622fe-ae77-4d2b-9015-ae151ab61d9f",
                                                "sense_id": "de2b7ea9-8a54-334a-891a-67e34840a5ac",
                                                "text": "Because of the flamelike undulations of its window tracery, the Norman archæologist, M. de Caumont, who had brought into use the name Romanesque, invented the equally useful term Flamboyant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba790e54-b710-32c0-9cf7-bfe4c2fde881",
                                        "entry_id": "a9b99f92-a346-336a-b5f1-be9b419e5688",
                                        "glosses": [
                                            "A delicate interlacing of lines reminiscent of the architectural ornament."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "062ec0ac-cd29-4991-8279-73cf949feed9",
                                                "sense_id": "ba790e54-b710-32c0-9cf7-bfe4c2fde881",
                                                "text": "He is homesick for the hale rough weather; for the tracery of the frost upon his window-panes at morning, the reluctant descent of the first flakes, and the white roofs relieved against the sombre sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
