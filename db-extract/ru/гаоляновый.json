                "senses": [
                    {
                        "sense_id": "8dd63a63-0b05-3da9-bb78-fb452c1df753",
                        "entry_id": "bc5d8323-cff5-37e3-bdf1-bdd3951fec04",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным гаолян — разновидностью сорго, распространённой в Восточной Азии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace9f4f8-616f-4ce5-aeaa-cedc56b668f0",
                                "sense_id": "8dd63a63-0b05-3da9-bb78-fb452c1df753",
                                "text": "На гаоляновой соломе лежало четверо солдат."
                            },
                            {
                                "example_id": "ee127abc-5deb-4405-9510-e4516e1d8ac0",
                                "sense_id": "8dd63a63-0b05-3da9-bb78-fb452c1df753",
                                "text": "А впереди громоздился город за белесыми гаоляновыми полями предместий."
                            }
                        ]
                    }
                ],
