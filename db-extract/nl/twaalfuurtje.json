                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae4d1373-c199-3f22-98d2-962a0aaef272",
                        "entry_id": "b723a5c4-df13-39a2-a397-0b3661562f15",
                        "glosses": [
                            "het middageten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601fa27a-235d-41f0-b34f-bc7ab197330f",
                                "sense_id": "ae4d1373-c199-3f22-98d2-962a0aaef272",
                                "text": "Dick Passchier is een vakman die, behalve Tweekamp en Spel zonder grenzen, ook Zeskamp en Stedenspel doet en later panellid wordt bij Zo Vader, Zo Zoon. Op de radio presenteert hij het culturele radio-magazine Pick up en het lunchpauzeprogramma Twaalfuurtje. Passchier staat bekend om zijn kalme manier van presenteren."
                            },
                            {
                                "example_id": "531c1de2-fcb5-4fff-ba2f-19243d4ebd9e",
                                "sense_id": "ae4d1373-c199-3f22-98d2-962a0aaef272",
                                "text": "U kost zelf ook geld, lieve lezer, uw sokken kosten geld, uw gebit, uw tongpiercing, uw verzekering, uw kapsel, uw ondergoed, uw overjas en uw twaalfuurtje kosten allemaal geld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62e5816e-d30f-4369-9ef6-f84b1da851ea",
                        "source_entry_id": "b723a5c4-df13-39a2-a397-0b3661562f15",
