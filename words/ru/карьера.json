                    "sense_id": "669802fd-59fd-36c7-ba3f-4be678c731d7",
                    "sense_definition": "Успешное продвижение в служебной, общественной, научной или иной деятельности; достижение известности и высокого статуса.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он мечтает сделать блестящую <w>карьеру</w> в крупной международной компании.",
                            "target_lang_translations": {
                                "en": "He dreams of making a brilliant <w>career</w> in a large international company.",
                                "zh": "他梦想在一家大型跨国公司里拥有辉煌的<w>事业</w>。"
                            }
                        },
                        {
                            "text": "Для многих молодых людей <w>карьера</w> стоит на первом месте в списке приоритетов.",
                            "target_lang_translations": {
                                "en": "For many young people, <w>career</w> comes first on the list of priorities.",
                                "zh": "对许多年轻人来说，<w>职业生涯</w>在优先事项清单中排在第一位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "продвижение",
                        "рост"
                    ],
                    "common_phrases": [
                        "сделать карьеру",
                        "строить карьеру",
                        "блестящая карьера",
                        "политическая карьера",
                        "карьерный рост"
                    ],
                    "target_lang_definitions": {
                        "en": "Successful advancement in professional, public, scientific, or other activities; achieving fame and high status.",
                        "zh": "在职业、社会、科学或其他活动中取得的成功进展；获得名望和高地位。"
                    },
                    "translations": {
