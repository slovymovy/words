        "fr-extract.jsonl": [
            {
                "entry_id": "a85f12f4-1774-3156-ab2d-c5d567bb4658",
                "word": "publiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                        "entry_id": "a85f12f4-1774-3156-ab2d-c5d567bb4658",
                        "glosses": [
                            "D’une manière publique, avec publicité, au vu et au su de tout le monde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc011566-a045-455b-a01b-775683b26258",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "Ce n’est pas un spectacle extraordinaire à Saint-Louis que de voir deux hommes « respectables » mettre habit bas et se colleter publiquement."
                            },
                            {
                                "example_id": "de9d98be-07b7-4a7d-b48d-06f69e307089",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "C’est par mes seuls conseils qu’il veut publiquement\nDu prince Héraclius faire le châtiment."
                            },
                            {
                                "example_id": "bc110326-e3da-4f9a-a749-6a6a0d3e420a",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "Elle s’en est vantée assez publiquement."
                            },
                            {
                                "example_id": "ce713162-fc96-4d48-be16-15f986ca9e92",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "En 1670, M. Leibnitz, âgé de vingt-quatre ans, se déclara publiquement philosophe dans un livre dont voici l’histoire…"
                            },
                            {
                                "example_id": "e4212aaf-ee95-4405-be83-84b782c5774f",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "Les belles tous les jours vous trompent, on le leur rend ;\nOn se prend, on se quitte assez publiquement ;\nLes maris savent vivre, et sur rien ne contestent\nLes hommes s’aiment tous ; les femmes se détestent\nMieux que jamais : enfin c’est un monde charmant ;\nEt Paris s’embellit délicieusement."
                            },
                            {
                                "example_id": "fad4da36-ad93-4b97-9629-69720328b87d",
                                "sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                                "text": "Il ne me reste plus qu’à rapporter plusieurs traits de la vie privée de Louis XI […] Ce prince est le premier de nos rois qui ait introduit ou du moins fort étendu l’usage de manger publiquement avec ses sujets : une de ses plus grandes dépenses étoit pour sa table."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ce12161-93b1-47c5-970c-91ebdcdb1bf2",
                        "source_entry_id": "a85f12f4-1774-3156-ab2d-c5d567bb4658",
                        "source_sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                        "target_lang_word": "öffentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "öffentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0ccee9-b953-3dff-8215-83c5c69791d8",
                                        "entry_id": "22734353-e0fe-3c53-b3cb-f3e8949cdfbf",
                                        "glosses": [
                                            "so, dass es jeder benutzen darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a3fb788-ccfd-4957-a013-fc4927f01d25",
                                                "sense_id": "6e0ccee9-b953-3dff-8215-83c5c69791d8",
                                                "text": "Ich besitze keinen Wagen, deshalb benütze ich die öffentlichen Verkehrsmittel."
                                            },
                                            {
                                                "example_id": "03e3350b-ff8f-439f-aca8-5370bed895e3",
                                                "sense_id": "6e0ccee9-b953-3dff-8215-83c5c69791d8",
                                                "text": "„Pocketbikes sind für öffentliche Straßen nicht zugelassen.“"
                                            },
                                            {
                                                "example_id": "876de5ed-94c5-479c-9a04-6d65a24bfe3c",
                                                "sense_id": "6e0ccee9-b953-3dff-8215-83c5c69791d8",
                                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                                            },
                                            {
                                                "example_id": "dfc790a1-9b33-4792-aec9-0279db8c1841",
                                                "sense_id": "6e0ccee9-b953-3dff-8215-83c5c69791d8",
                                                "text": "„In Anbetracht dieser Tatsache ist Wagniserziehung heute leider ein öffentlich vernachlässigter Bildungsbereich, der einzelnen innovativen Eltern, Organisationen wie dem Deutschen Alpenverein oder der Erlebnispädagogik vorbehalten bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                        "entry_id": "22734353-e0fe-3c53-b3cb-f3e8949cdfbf",
                                        "glosses": [
                                            "vor den Augen aller"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b4ed5f1-c779-4479-8768-9011f8739fcf",
                                                "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                                "text": "„Vor zehn Jahren wurde der Missbrauch von Jugendlichen am Berliner Canisiuskolleg öffentlich.“"
                                            },
                                            {
                                                "example_id": "3ce9e66d-48b4-4ffc-9bda-0ba28cd2c6bf",
                                                "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                                "text": "„In Anbetracht dieser Tatsache ist Wagniserziehung heute leider ein öffentlich vernachlässigter Bildungsbereich, der einzelnen innovativen Eltern, Organisationen wie dem Deutschen Alpenverein oder der Erlebnispädagogik vorbehalten bleibt.“"
                                            },
                                            {
                                                "example_id": "4367c941-7a1b-44ab-9a15-f0be26089508",
                                                "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                                "text": "„Die Linguistik sollte dies als Chance begreifen und sich in den entsprechenden öffentlichen Diskursen mit ihrem Fachwissen vernehmlich zu Wort melden.“"
                                            },
                                            {
                                                "example_id": "aa4c9f54-9817-416d-abf6-fa86fa9ae5cb",
                                                "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "bbe61074-14e1-47a3-954d-f1b9afce269c",
                                                "sense_id": "7aa555ed-98e4-3312-b53d-e3021da2d24b",
                                                "text": "Die Zahl der öffentlich bekannten Todesurteile und Hinrichtungen ist im vergangenen Jahr [2017] weltweit gesunken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5cb78f8-d164-41bc-94b5-6fda39236d9d",
                        "source_entry_id": "a85f12f4-1774-3156-ab2d-c5d567bb4658",
                        "source_sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                        "target_lang_word": "publicly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publicly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa3a211-6288-301c-b03d-e719caa7773f",
                                        "entry_id": "249c7e1d-0a49-37da-8606-75ea3ac3ac63",
                                        "glosses": [
                                            "In public, openly, in an open and public manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0759322-7e38-4f77-aa84-0323368a16a3",
                                                "sense_id": "8aa3a211-6288-301c-b03d-e719caa7773f",
                                                "text": "criticize someone publicly"
                                            },
                                            {
                                                "example_id": "3136ab50-74bf-4a9e-be1d-0296ac6e9f2c",
                                                "sense_id": "8aa3a211-6288-301c-b03d-e719caa7773f",
                                                "text": "publicly announce something"
                                            },
                                            {
                                                "example_id": "3efc4e4d-4dd2-4940-a84e-1f7a74a700a8",
                                                "sense_id": "8aa3a211-6288-301c-b03d-e719caa7773f",
                                                "text": "Although the Holy See publicly expressed its rejection of sexual abuse and pedophilia and expressed its commitment to cooperate with civil authorities when cases of pedophile priests were found¹², there are no known cases of bishops or cardinals, being found responsible for abusing children or covering up for pedophilia in their parishes."
                                            },
                                            {
                                                "example_id": "fc20c27e-e2db-4d5b-a647-8272db1bd3f4",
                                                "sense_id": "8aa3a211-6288-301c-b03d-e719caa7773f",
                                                "text": "Recently, the Supreme Court justices Sonia Sotomayor and Amy Coney Barrett spoke together publicly about how members of the court speak civilly to one another while disagreeing, sometimes vigorously, about the law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e2e8d0-3eb5-308c-8c62-c1a4fa49a4d9",
                                        "entry_id": "249c7e1d-0a49-37da-8606-75ea3ac3ac63",
                                        "glosses": [
                                            "By, for, or on behalf of the public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b266489-0985-4193-8a3d-d36dcc3b3aa4",
                                                "sense_id": "64e2e8d0-3eb5-308c-8c62-c1a4fa49a4d9",
                                                "text": "publicly available"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c35e509-344e-49a7-b647-42f1de402127",
                        "source_entry_id": "a85f12f4-1774-3156-ab2d-c5d567bb4658",
                        "source_sense_id": "455b82a2-8900-3349-bd98-53284577dd80",
                        "target_lang_word": "openly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "openly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                        "entry_id": "0ff5e0eb-4807-374b-ae3f-e7449d1a78d3",
                                        "glosses": [
                                            "In an open manner; visibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c062ac-f4ae-41bd-b3c5-6b1e6f4b2bd3",
                                                "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                                "text": "Nevertheless, without openly admitting it, he was devoted to Boxer;"
                                            },
                                            {
                                                "example_id": "bf11c3e8-806d-49c5-be06-ca0cac028e71",
                                                "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                                "text": "The openly ridiculous plot has The Pirate Captain (Hugh Grant) scheming to win the Pirate Of The Year competition, even though he’s a terrible pirate, far outclassed by rivals voiced by Jeremy Piven and Salma Hayek."
                                            },
                                            {
                                                "example_id": "27d97819-ef94-4156-a2ed-14ea7f0d819d",
                                                "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                                "text": "We must speak our minds openly, debate our disagreements honestly, but always pursue solidarity."
                                            },
                                            {
                                                "example_id": "f4c7f7b9-05ee-416f-a6df-65c3f5beabc7",
                                                "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                                "text": "Particular note, in this period, should be made of the actions of Joseph Denman, commander of the Northern Division of the Squadron, who went on an absolutely ruthless and systematic campaign along the African coast, burning so-called \"slaving factories\" to the ground and openly daring anyone who objected to try and stop him."
                                            },
                                            {
                                                "example_id": "71597a6a-9739-4ee8-823e-4493312d2460",
                                                "sense_id": "c8453ead-e2b5-3d11-9932-969e50d063d9",
                                                "text": "When a column of smoke appeared on Thursday over the Sitong Bridge overpass in the Haidian district of Beijing, it drew attention to a protester who had hung banners openly bashing China’s top leader by name and criticizing the country’s “zero Covid” policy, including one calling for “freedom and not lockdowns.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
