                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "588b56e9-a360-4906-82f0-7df2907c167e",
                        "entry_id": "83a187e9-6a1f-3f50-9671-ce737ad09994",
                        "tags": [
