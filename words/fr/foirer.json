                {
                    "sense_id": "fa095f31-644f-34ac-9282-9aa92c936ad9",
                    "sense_definition": "Ne pas fonctionner comme prévu, tourner mal ou aboutir à un échec.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leur plan initial a totalement <w>foiré</w> à cause du mauvais temps.",
                            "target_lang_translations": {
                                "en": "Their original plan totally <w>misfired</w> because of the bad weather.",
                                "ru": "Их первоначальный план полностью <w>сорвался</w> из-за плохой погоды.",
                                "de": "Ihr ursprünglicher Plan ist wegen des schlechten Wetters völlig <w>gescheitert</w>.",
                                "es": "Su plan inicial <w>se malogró</w> por completo a causa del mal tiempo.",
                                "zh": "因为天气糟糕，他们最初的计划彻底<w>泡汤</w>了。"
                            }
                        },
                        {
                            "text": "Rien ne fonctionne aujourd'hui, toutes nos démarches <w>foirent</w> lamentablement.",
                            "target_lang_translations": {
                                "en": "Nothing is working today; all our efforts are <w>failing</w> miserably.",
                                "ru": "Сегодня ничего не работает: все наши попытки жалко <w>проваливаются</w>.",
                                "de": "Heute funktioniert gar nichts, alle unsere Bemühungen <w>scheitern</w> kläglich.",
                                "es": "Hoy no funciona nada; todas nuestras gestiones <w>fracasan</w> miserablemente.",
                                "zh": "今天什么都不顺，我们的一切努力都<w>泡汤</w>了，惨不忍睹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "échouer",
                        "capoter"
                    ],
                    "antonyms": [
                        "marcher",
                        "fonctionner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To not work as planned, or to end in failure.",
                        "ru": "Не идти по плану, пойти наперекосяк или закончиться неудачей.",
                        "de": "Nicht wie geplant verlaufen oder in einem Misserfolg enden.",
                        "es": "No salir según lo previsto, echarse a perder o acabar en fracaso.",
                        "zh": "没有按计划进行，或最终以失败告终。"
