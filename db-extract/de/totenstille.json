                "senses": [
                    {
                        "sense_id": "cb4631f9-1ef7-3a1f-9a63-c5014f00ae74",
                        "entry_id": "056f7ddd-53dc-3e25-8cae-2b95ac21473d",
                        "glosses": [
                            "eine tiefe, oft Furcht erweckende Stille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc0bfef-8175-453a-83c2-ee8dbef43dd5",
                                "sense_id": "cb4631f9-1ef7-3a1f-9a63-c5014f00ae74",
                                "text": "„Im Raum herrschte plötzlich Totenstille.“"
                            },
                            {
                                "example_id": "630f02db-ff2c-43bd-8b37-9c4db29eef01",
                                "sense_id": "cb4631f9-1ef7-3a1f-9a63-c5014f00ae74",
                                "text": "„Im Raum herrschte Totenstille.“"
                            },
                            {
                                "example_id": "d992252a-ef56-442d-867e-7d39444978bf",
                                "sense_id": "cb4631f9-1ef7-3a1f-9a63-c5014f00ae74",
                                "text": "„Der Andere lag ruhig, und um ihn herum war wieder Totenstille.“"
                            },
                            {
                                "example_id": "bd7abf40-9b87-47e7-af18-ff1c0dbe01e6",
                                "sense_id": "cb4631f9-1ef7-3a1f-9a63-c5014f00ae74",
                                "text": "„Tatsächlich sahen wir auch niemanden mehr; um uns herum herrschte Totenstille, abgesehen vom Prasseln des Regens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
