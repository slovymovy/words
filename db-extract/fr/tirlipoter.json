                "senses": [
                    {
                        "sense_id": "e12bfd88-eb12-3b2d-a65a-69683439a795",
                        "entry_id": "4b9af546-998e-3b19-a881-8388c8807f21",
                        "glosses": [
                            "Dans un jeu qui consiste à faire deviner un verbe à partir de questions auxquelles on répond par oui ou non, verbe servant à remplacer dans les questions le verbe qui doit être deviné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805f404e-11a5-442f-83a6-9ea0b6c08882",
                                "sense_id": "e12bfd88-eb12-3b2d-a65a-69683439a795",
                                "text": "OUI… On peut tirlipoter sa femme."
                            },
                            {
                                "example_id": "4c0bf697-4055-476d-9995-54ef85be921f",
                                "sense_id": "e12bfd88-eb12-3b2d-a65a-69683439a795",
                                "text": "Peut-on tirlipoter son fly-back ?"
                            },
                            {
                                "example_id": "ebf2736b-dd5f-4512-a938-dc349a4f0f4a",
                                "sense_id": "e12bfd88-eb12-3b2d-a65a-69683439a795",
                                "text": "Sans causer de la Ricaine que j'ai levée dans l'avion et qui se met à tirlipoter le Vieux !"
                            }
                        ]
                    }
