                                    },
                                    {
                                        "sense_id": "d2629826-49d8-327f-a019-818d4766af7e",
                                        "entry_id": "82831548-8573-347d-951c-67a3d4aac95e",
                                        "glosses": [
                                            "Qui ont été mariés deux fois."
                                        ],
                                        "tags": [
                                            "Droit canon"
                                        ],
                                        "examples": [
                                            {
