                                    {
                                        "sense_id": "a1010b25-423b-3a44-ab21-39db816135a9",
                                        "entry_id": "3cba8aca-5df8-310b-9c50-686cc34ad1d2",
                                        "glosses": [
                                            "Ville polonaise et chef-lieu de la voïvodie de Basse-Silésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d68db6-fc7f-410c-9d91-dbccb0685958",
                                                "sense_id": "a1010b25-423b-3a44-ab21-39db816135a9",
                                                "text": "Lorsque nous déambulons dans les rues de Wrocław, quatrième ville de la Pologne, nous avons peine à croire que de nombreux bâtiments n’ont guère plus de 70 ans tant ils ont été fidèlement reconstitués comme à l’époque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "180ea947-7572-4ee6-9333-9ca5a9a40852",
                        "source_entry_id": "468efe95-068a-382f-b543-9f122cc34909",
                        "source_sense_id": "e2fe47e0-97a7-3f2d-b044-3761a7d27204",
                        "source_sense_description": "a city in southwestern Poland",
                        "target_lang_word": "Breslau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Breslau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55ddf10d-d5d6-3227-afe1-d5224e7123e2",
                                        "entry_id": "e82bd23e-ac08-3a27-861d-a96dcaf1f145",
                                        "glosses": [
                                            "Nom allemand de Vratislavie (Wrocław)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5015a2a1-6c7e-444e-b9c7-2e140be16972",
                                                "sense_id": "55ddf10d-d5d6-3227-afe1-d5224e7123e2",
                                                "text": "À Breslau, Mommsen, qui venait tout juste de se marier, compléta sa Römische Geschichte et commença à organiser le Corpus Inscriptionum Latinarum."
                                            },
                                            {
                                                "example_id": "f8d37a4a-536a-47e9-88fb-21f8b522e90f",
                                                "sense_id": "55ddf10d-d5d6-3227-afe1-d5224e7123e2",
                                                "text": "Ainsi Simon, qui avait établi sa réputation avec les miniréfrigérateurs d’hélium portables à Berlin puis Breslau et Oxford, se consacra à la construction d’une usine qui devait occuper une vingtaine d’hectares et consommer 60 000 kilowatts."
                                            }
                                        ]
                                    }
                                ]
                            },
