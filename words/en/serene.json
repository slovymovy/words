{
    "word_family": [
        "serenity",
        "serenely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1032d61f-5e7d-3ec9-87a7-8a0ddf360623",
                    "sense_definition": "Calm, peaceful, and unruffled in demeanor or state of mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at her students with a <w>serene</w> expression during the difficult exam.",
                            "target_lang_translations": {
                                "zh": "在这场艰难的考试中，她带着<w>安详</w>的神情看着学生们。"
                            }
                        },
                        {
                            "text": "The <w>serene</w> atmosphere of the garden helped her relax after a long day.",
                            "target_lang_translations": {
                                "zh": "花园里<w>宁静</w>的气氛让她在漫长的一天后放松下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "placid",
                        "tranquil",
                        "composed"
                    ],
                    "common_phrases": [
                        "serene expression",
                        "serene atmosphere"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容神态、心境或状态平静安宁，不慌不乱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宁静",
                                "target_lang_sense_clarification": "形容神态、心境或气氛平和安定"
                            },
                            {
                                "target_lang_word": "安详",
                                "target_lang_sense_clarification": "形容人的表情、神情安定平和"
                            },
                            {
                                "target_lang_word": "平和",
                                "target_lang_sense_clarification": "形容内心或状态温和平静"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "417e46d4-82c6-3861-af8c-cd18c7063df1",
                    "sense_definition": "Without worry or anxiety; unaffected by disturbance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the chaos in the office, he remained <w>serene</w> and focused on his work.",
                            "target_lang_translations": {
                                "zh": "尽管办公室里一片混乱，他依然<w>镇定</w>自若，专心工作。"
                            }
                        },
                        {
                            "text": "He reported that everything was <w>serene</w> at the project site before he left.",
                            "target_lang_translations": {
                                "zh": "他离开前报告说，项目现场一切都很<w>平静</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unruffled",
                        "untroubled",
                        "unbothered"
                    ],
                    "common_phrases": [
                        "remain serene"
                    ],
                    "target_lang_definitions": {
                        "zh": "没有忧虑或焦躁，不受干扰，依然冷静。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "镇定",
                                "target_lang_sense_clarification": "在混乱或压力下仍保持冷静"
                            },
                            {
                                "target_lang_word": "从容",
                                "target_lang_sense_clarification": "不焦虑、不受扰乱，显得沉着"
                            },
                            {
                                "target_lang_word": "平静",
                                "target_lang_sense_clarification": "事情或局面没有不安和波动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "329b9777-026e-372a-869f-49c15a986968",
                    "sense_definition": "Fair, unclouded, and clear, typically referring to the sky.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>serene</w> sky greeted the hikers as they reached the mountain peak.",
                            "target_lang_translations": {
                                "zh": "登山者到达山顶时，迎接他们的是一片<w>晴朗</w>的天空。"
                            }
                        },
                        {
                            "text": "The <w>serene</w> blue sky made for a perfect day at the beach.",
                            "target_lang_translations": {
                                "zh": "那片<w>澄澈</w>的蓝天让这一天成了海滩上的完美日子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "unclouded"
                    ],
                    "common_phrases": [
                        "serene sky"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容天空明净无云、清澈开朗。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "晴朗",
                                "target_lang_sense_clarification": "形容天空明净无云"
                            },
                            {
                                "target_lang_word": "澄澈",
                                "target_lang_sense_clarification": "书面语，形容天空清澈明净"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf9d1c8-2425-3987-9421-75c08badb11a",
                    "sense_definition": "Used as part of certain formal titles to indicate sovereignty or high status.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat was introduced as Her <w>Serene</w> Highness at the royal gala.",
                            "target_lang_translations": {
                                "zh": "在皇家晚会上，这位外交官被介绍为“尊贵的<w>殿下</w>”。"
                            }
                        },
                        {
                            "text": "The title of <w>Serene</w> Highness is rarely used in modern political contexts.",
                            "target_lang_translations": {
                                "zh": "“尊贵的<w>殿下</w>”这一头衔在现代政治语境中很少使用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Serene Highness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in formal or historical royal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于某些正式头衔中，表示统治者或贵族的尊贵身份。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "殿下",
                                "target_lang_sense_clarification": "用于正式或历史性的君主头衔“Serene Highness”中，通常译作“尊贵的殿下”"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "099e86b7-27c0-3cb3-b38d-d68715c756c6",
                    "sense_definition": "A rare female given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Serene</w> is an unusual name that has roots in classical literature.",
                            "target_lang_translations": {
                                "zh": "<w>瑟琳</w>是个不常见的名字，源自古典文学。"
                            }
                        },
                        {
                            "text": "The character named <w>Serene</w> appears in the old poem.",
                            "target_lang_translations": {
                                "zh": "那首古诗里出现了一个名叫<w>瑟琳</w>的人物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个罕见的女性名字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瑟琳",
                                "target_lang_sense_clarification": "罕见女性名字的常见音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a5069a6-3537-3625-8e60-1a8b54c11c5a",
                    "sense_definition": "A state of serenity, clearness, or calmness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>serene</w> of the morning was broken by the loud city traffic.",
                            "target_lang_translations": {
                                "zh": "清晨的<w>宁静</w>被城市喧闹的车流打破了。"
                            }
                        },
                        {
                            "text": "She sought the <w>serene</w> of the countryside to escape her busy life.",
                            "target_lang_translations": {
                                "zh": "她向往乡间的<w>静谧</w>，以逃离忙碌的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "serenity",
                        "calmness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古旧名词用法，指宁静、清明或平和的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宁静",
                                "target_lang_sense_clarification": "古旧用法，指安宁平静的状态"
                            },
                            {
                                "target_lang_word": "静谧",
                                "target_lang_sense_clarification": "偏书面，指安静平和的气氛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9797d1d0-0827-32c1-9abd-311ca8b706c9",
                    "sense_definition": "A fine rain or mist falling from a clear sky after sunset.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers were warned about the <w>serene</w> that often falls in these tropical regions at night.",
                            "target_lang_translations": {
                                "zh": "旅客们被提醒要注意这种热带地区夜间常有的<w>晴夜细雨</w>。"
                            }
                        },
                        {
                            "text": "He felt the dampness of the <w>serene</w> on his skin as he walked home.",
                            "target_lang_translations": {
                                "zh": "他走回家时，感到皮肤上沾着<w>晴夜细雨</w>的潮气。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a specific meteorological phenomenon."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古旧用法，指日落后在晴朗天空下出现的细雨或薄雾。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "晴夜细雨",
                                "target_lang_sense_clarification": "古旧说法，指日落后晴空中降下的细雨或薄雾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe8f9d25-65df-3d13-94d7-bf3c08aa095e",
                    "sense_definition": "To make something calm or peaceful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soft music helped to <w>serene</w> his troubled mind after the argument.",
                            "target_lang_translations": {
                                "zh": "争吵过后，轻柔的音乐帮助<w>安抚</w>了他烦乱的心绪。"
                            }
                        },
                        {
                            "text": "They tried to <w>serene</w> the atmosphere by speaking in low, gentle tones.",
                            "target_lang_translations": {
                                "zh": "他们试着用低柔的语气说话来<w>缓和</w>气氛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "pacify",
                        "tranquilize"
                    ],
                    "antonyms": [
                        "agitate",
                        "disturb"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古旧动词用法，指使某事物变得平静或安宁。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安抚",
                                "target_lang_sense_clarification": "使人的情绪或心境平静下来"
                            },
                            {
                                "target_lang_word": "缓和",
                                "target_lang_sense_clarification": "使局面、气氛等变得平和"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}