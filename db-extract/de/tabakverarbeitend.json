                "senses": [
                    {
                        "sense_id": "99ffd704-25a7-370a-9be0-124fc34fd501",
                        "entry_id": "017a5b2d-36dc-36f5-b37b-f0926b1c85f1",
                        "glosses": [
                            "aus dem Ausgangsmaterial Tabak neue, höherwertige Produkte herstellend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463bf859-72b6-4a8d-a257-244548889de8",
                                "sense_id": "99ffd704-25a7-370a-9be0-124fc34fd501",
                                "text": "„Es gehe um eine Million Arbeitsplätze in der tabakverarbeitenden Industrie, die noch dazu in der EU rund 135 Milliarden Mark an Steuereinnahmen sichere.“"
                            },
                            {
                                "example_id": "c85bd04a-7da0-4cc6-86f1-efc0a6b8d554",
                                "sense_id": "99ffd704-25a7-370a-9be0-124fc34fd501",
                                "text": "„1849 bestanden im Kreis Herford bereits 18 tabakverarbeitende Betriebe. Oft wurden die Zigarren (vor allem in der ländlichen Umgebung der Stadt) auch in Heimarbeit gerollt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
