                        "glosses": [
                            "een regering die gevormd is uit meer dan één politieke partij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5fe8cd-16f1-4844-af01-8058faa93414",
                                "sense_id": "5bf52d27-f047-3569-835a-521d3c554525",
                                "text": "Zelfs de Britten worden nu geregeerd door een coalitieregering."
                            }
                        ]
