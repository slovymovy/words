                "senses": [
                    {
                        "sense_id": "e710674b-96dc-3ccf-ab12-6581e30a19cf",
                        "entry_id": "9b1367b7-7592-3dfe-890b-ec947e558167",
                        "glosses": [
                            "behördliche Genehmigung, Fahrschüler ausbilden zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd34eb0-cc34-48dd-bf5c-f746b1544bf3",
                                "sense_id": "e710674b-96dc-3ccf-ab12-6581e30a19cf",
                                "text": "„Der Fahrlehrerberuf hat einen schweren Stand: Die Zahl der Fahrlehrererlaubnisse sei deutschlandweit in den vergangenen zehn Jahren von rund 55 000 auf etwa 44 000 zurückgegangen, heißt es vom Niedersächsischen Fahrlehrerverband.“"
                            },
                            {
                                "example_id": "938ace3b-a94f-49c6-bfdd-5626ccfeb7be",
                                "sense_id": "e710674b-96dc-3ccf-ab12-6581e30a19cf",
                                "text": "„Nach ausführlicher mündlicher Verhandlung hat die 15. Kammer des Verwaltungsgerichts unter Vorsitz des Präsidenten Ingo Behrens die Klage eines Fahrlehrers gegen den Entzug seiner Fahrlehrererlaubnis abgewiesen.“"
                            },
                            {
                                "example_id": "40800f21-e4e8-4ec8-a770-e055ff104279",
                                "sense_id": "e710674b-96dc-3ccf-ab12-6581e30a19cf",
                                "text": "„Je nach Fahrerlaubnisklasse dauert die Weiterbildung länger, so zum Beispiel die Fahrlehrererlaubnis der Klasse A mindestens 13 Monate, die der Klassen CE oder DE mindestens 14 Monate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
