                ],
                "senses": [
                    {
                        "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                        "entry_id": "34bf21af-a811-33e3-bfaf-ca34f82d883b",
                        "glosses": [
                            "British and Canada standard spelling of clamor."
                        ],
                        "tags": [
                            "Canada",
                            "UK",
                            "alt-of",
                            "countable",
                            "standard",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5804d11b-62f9-4853-b23c-4494be9fc1b8",
                                "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                                "text": "Sickly eares Deaft with the clamours of their owne deare grones."
                            },
                            {
                                "example_id": "281499a3-d45d-4c0e-bd4d-2eba2a244a4f",
                                "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                                "text": "For when he knew his Rival freed and gone, / He ſwells with Wrath; he makes outrageous Moan: / He frets, he fumes, he ſtares, he ſtamps the Ground; / The hollow Tow'r with Clamours rings around: […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
