                    {
                        "sense_id": "32ef0b39-065b-38bf-bcba-519f2584a600",
                        "entry_id": "0677119c-a039-305f-af3c-9bf7f6643596",
                        "glosses": [
                            "Cabine placée dans les salles de vote et où l’électeur s’isole pour préparer son bulletin de vote afin de garantir le secret du scrutin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecc7b62-74dd-4e27-b81b-3bc7d73a4c25",
                                "sense_id": "32ef0b39-065b-38bf-bcba-519f2584a600",
                                "text": "Quand le parfum envoûtant de l’isoloir flotte dans l’air, derrière les petites et grandes séductions, tout est question d’intérêt partisan."
                            }
                        ]
                    },
                    {
                        "sense_id": "82073687-3619-3a1b-9974-69b9d8a96bcf",
                        "entry_id": "0677119c-a039-305f-af3c-9bf7f6643596",
                        "glosses": [
                            "Confessionnal dans les paroisses chrétiennes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1c42921-ea79-4167-a802-71d3936eb253",
                        "source_entry_id": "0677119c-a039-305f-af3c-9bf7f6643596",
                        "target_lang_word": "Wahlkabine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahlkabine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a469ac-f8a8-3781-a8c6-7afd591e0927",
                                        "entry_id": "5ca3b0d6-b4ab-3bc0-842e-05d11647cd96",
                                        "glosses": [
                                            "ein für Dritte nicht einsehbarer Raum oder Verschlag, der eine geheime Wahl ermöglichen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c28b773-bbd6-4990-ae29-bdc13eeea21d",
                                                "sense_id": "b5a469ac-f8a8-3781-a8c6-7afd591e0927",
                                                "text": "Der Wähler füllt seinen Stimmzettel in der Wahlkabine aus."
                                            },
                                            {
                                                "example_id": "b93fa51d-6163-4cd3-b204-ea18264a424b",
                                                "sense_id": "b5a469ac-f8a8-3781-a8c6-7afd591e0927",
                                                "text": "„Wer sich ein Bild davon machen will, was ihn am 26. Mai in der Wahlkabine erwartet, kann sich die Stimmzettel des Wahlkreises seines Bezirks schon einmal online anschauen und damit vertraut machen, wie die Innenbehörde am Dienstag mitteilte.“"
                                            },
                                            {
                                                "example_id": "b0ed1334-4523-40bb-bd1a-0e388cc3a63c",
                                                "sense_id": "b5a469ac-f8a8-3781-a8c6-7afd591e0927",
                                                "text": "„Die Bezeichnung Wahlzelle hat sich in Österreich (anders als in Deutschland, wo man von Wahlkabinen spricht) eingebürgert, steht bei uns sogar im Gesetz: Im Paragraf 57 der Nationalratswahlordnung wird bestimmt, dass in jedem Wahllokal mindestens eine Wahlzelle stehen muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29007c99-91a4-41d8-8b71-f38f7381a2d5",
                        "source_entry_id": "0677119c-a039-305f-af3c-9bf7f6643596",
                        "target_lang_word": "Wahlzelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahlzelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe2eced-7762-3e7e-8e01-821270866e45",
                                        "entry_id": "dd75aac5-1571-3c78-acae-02b422d8b223",
                                        "glosses": [
                                            "für Dritte nicht einsehbarer Raum oder Verschlag, der eine geheime Wahl ermöglichen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a01688c-2af4-4990-bbd3-1a8aa5535f1a",
                                                "sense_id": "cfe2eced-7762-3e7e-8e01-821270866e45",
                                                "text": "„Die Bezeichnung Wahlzelle hat sich in Österreich (anders als in Deutschland, wo man von Wahlkabinen spricht) eingebürgert, steht bei uns sogar im Gesetz: Im Paragraf 57 der Nationalratswahlordnung wird bestimmt, dass in jedem Wahllokal mindestens eine Wahlzelle stehen muss.“"
                                            },
                                            {
                                                "example_id": "a238ece9-978a-4aca-9833-304484222ad3",
                                                "sense_id": "cfe2eced-7762-3e7e-8e01-821270866e45",
                                                "text": "„Eine einmalige Chance, Ihre Stimme außerhalb der Wahlzelle ganz direkt geltend zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
