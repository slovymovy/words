                        "form_id": "e4d08069-7810-4593-be6b-9d809c9542ae",
                        "entry_id": "ccefd094-2bef-3c6c-8683-7b891bbb73c6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most traceable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                        "entry_id": "ccefd094-2bef-3c6c-8683-7b891bbb73c6",
                        "glosses": [
                            "Capable of being traced; possible to track down."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acbb26fb-260e-4dc3-b3b2-ad3132013639",
                                "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                                "text": "The course of the abandoned line is still clearly traceable."
                            },
                            {
                                "example_id": "a51731e8-9f48-4b70-b92c-ebd143b30c6c",
                                "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                                "text": "There was no traceable evidence left when the detectives arrived."
                            },
                            {
                                "example_id": "278ce8df-c596-4723-8639-2fac91e2407d",
                                "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                                "text": "Homosexuality is easily traceable in India. Dubois referred to houses devoted to male prostitution, with men dressed as women, and imitating the ways of women."
                            },
                            {
                                "example_id": "405ff9aa-b89b-43ef-8d63-b9e0cc8aa2e8",
                                "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                                "text": "For those who do not have the money, as well as for those who are reluctant to commit any potentially traceable act of positive support, the boycott serves our purpose well."
                            },
                            {
                                "example_id": "bc39418a-ff3d-440d-838a-94b0bbee7944",
                                "sense_id": "2e46631f-0e2f-3029-9935-55947b3864cc",
                                "text": "The source of this characteristic is easily traceable to the wrestlerlike postures of the typical round-volumed sculptures."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbc6beaa-8ce8-3c64-8bb3-9bb40761227b",
                        "entry_id": "ccefd094-2bef-3c6c-8683-7b891bbb73c6",
                        "glosses": [
                            "Containing a Hamiltonian path."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57ad7992-729c-46dd-948b-b9e29d3a9103",
                        "source_entry_id": "ccefd094-2bef-3c6c-8683-7b891bbb73c6",
                        "source_sense_description": "capable of being traced; possible to track down",
                        "target_lang_word": "nachvollziehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachvollziehbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                        "entry_id": "96cc8068-e12a-35de-b3c2-b6b27d791d07",
                                        "glosses": [
                                            "so, dass man die Gründe oder den Werdegang verstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1d026b-0952-48bb-8689-ebcee6853da7",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "Die Aufgabe ist sehr leicht nachvollziehbar."
                                            },
                                            {
                                                "example_id": "6069f216-3b7e-4ec3-aed0-b04aaa114143",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "Sein Verhalten war nicht in Ordnung, aber nachvollziehbar."
                                            },
                                            {
                                                "example_id": "1de608af-6f16-49e9-9d35-abe48987774e",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "„Die Vulkanier sind zudem, in schönem Widerspruch zu ihrem Namen, berühmt für ihren extrem rationalen Charakter, für ihr dogmatisches Beharren auf Faktenevidenz und logisch nachvollziehbaren Entscheidungswegen.“"
                                            },
                                            {
                                                "example_id": "64052349-888d-400d-bf00-b1def87d7501",
                                                "sense_id": "67f866bf-db90-34ae-98c1-fc0248ac93ed",
                                                "text": "„So nachvollziehbar Huizinga die spielfeindlichen Einflüsse industrieller Marktförmigkeit auf Kunst und Literatur auch aufdeckt, verbirgt sich in seiner Argumentation doch ein innerer Widerspruch: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
