{
    "word_family": [
        "dump",
        "dumper",
        "dumpy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b8821c1-38cb-3d61-bee3-0c7fa4e0e965",
                    "sense_definition": "Present participle and gerund of <w>dump</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew is <w>dumping</w> sand to fill the hole in the road.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада <w>сваливает</w> песок, чтобы засыпать яму на дороге.",
                                "de": "Der Bautrupp <w>lädt</w> Sand <w>ab</w>, um das Loch in der Straße zu füllen."
                            }
                        },
                        {
                            "text": "He felt guilty about <w>dumping</w> all his responsibilities on his coworkers.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал вину за <w>сваливание</w> всех своих обязанностей на коллег.",
                                "de": "Er fühlte sich schuldig, all seine Verantwortung auf seine Kollegen <w>abgewälzt zu haben</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dumping ground",
                        "dumping snow",
                        "dumping trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>dump</w>.",
                        "de": "Partizip Präsens und Gerundium von dump."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливание",
                                "target_lang_sense_clarification": "в кучу или перекладывание ответственности"
                            },
                            {
                                "target_lang_word": "сбрасывание",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abladen",
                                "target_lang_sense_clarification": "Sand, Schutt oder Lasten"
                            },
                            {
                                "target_lang_word": "abwälzen",
                                "target_lang_sense_clarification": "Verantwortung oder Aufgaben übertragen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec6f1db6-c1b2-3b85-9b00-4d8931cf446d",
                    "sense_definition": "The disposal of something no longer needed, or of no value.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "disposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has increased fines to stop the illegal <w>dumping</w> of household waste.",
                            "target_lang_translations": {
                                "ru": "Город увеличил штрафы, чтобы остановить незаконный <w>сброс</w> бытовых отходов.",
                                "de": "Die Stadt hat die Bußgelder erhöht, um das illegale <w>Abladen</w> von Hausmüll zu stoppen."
                            }
                        },
                        {
                            "text": "We saw a sign that clearly stated no <w>dumping</w> was allowed in the park.",
                            "target_lang_translations": {
                                "ru": "Мы увидели знак, на котором было четко написано, что <w>сваливание</w> мусора в парке запрещено.",
                                "de": "Wir sahen ein Schild, das deutlich besagte, dass das <w>Abladen von Müll</w> im Park verboten war."
                            }
                        }
                    ],
                    "synonyms": [
                        "disposal",
                        "discarding"
                    ],
                    "common_phrases": [
                        "illegal dumping",
                        "no dumping",
                        "waste dumping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утилизация или избавление от чего-либо ненужного или не имеющего ценности.",
                        "de": "Die Entsorgung oder das Abladen von nicht mehr benötigten Dingen oder Müll."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброс",
                                "target_lang_sense_clarification": "отходов, мусора"
                            },
                            {
                                "target_lang_word": "сваливание",
                                "target_lang_sense_clarification": "выгрузка мусора в неположенном месте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Abladen",
                                "target_lang_sense_clarification": "von Müll oder Abfällen"
                            },
                            {
                                "target_lang_word": "Entsorgung",
                                "target_lang_sense_clarification": "Beseitigung von Abfallstoffen"
                            },
                            {
                                "target_lang_word": "Verklappung",
                                "target_lang_sense_clarification": "oft auf See"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58bccea3-4fd7-38e4-ac50-89d9f072fb07",
                    "sense_definition": "Selling goods at less than their normal price, or even at a loss, especially in the export market as a means of securing a monopoly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government imposed tariffs to protect local industries from foreign <w>dumping</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело тарифы для защиты местной промышленности от иностранного <w>демпинга</w>.",
                                "de": "Die Regierung verhängte Zölle, um die heimische Industrie vor ausländischem <w>Dumping</w> zu schützen."
                            }
                        },
                        {
                            "text": "Accusations of price <w>dumping</w> have caused tension between the two trading partners.",
                            "target_lang_translations": {
                                "ru": "Обвинения в ценовом <w>демпинге</w> вызвали напряженность между двумя торговыми партнерами.",
                                "de": "Vorwürfe von <w>Preisdumping</w> haben zu Spannungen zwischen den beiden Handelspartnern geführt."
                            }
                        }
                    ],
                    "synonyms": [
                        "underselling"
                    ],
                    "common_phrases": [
                        "anti-dumping duty",
                        "price dumping",
                        "anti-dumping measures"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business/economics context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продажа товаров по цене ниже обычной, часто даже в убыток, особенно на экспортном рынке.",
                        "de": "Der Verkauf von Waren unter dem Normalpreis oder sogar mit Verlust, insbesondere im Exportmarkt, um Konkurrenten zu verdrängen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демпинг",
                                "target_lang_sense_clarification": "экономический термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dumping",
                                "target_lang_sense_clarification": "Verkauf unter Wert oder Preisunterbietung"
                            },
                            {
                                "target_lang_word": "Warenverschleuderung",
                                "target_lang_sense_clarification": "Verkauf zu extrem niedrigen Preisen"
                            },
                            {
                                "target_lang_word": "Preisdumping",
                                "target_lang_sense_clarification": "gezieltes Unterbieten der Marktpreise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}