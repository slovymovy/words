                        "sense_id": "7df94fea-5256-3540-81ac-202d332efc24",
                        "entry_id": "b5553b97-06b7-3b0a-a464-10384b39b6cd",
                        "glosses": [
                            "Tricher (à un contrôle scolaire ou un examen)."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "3759270e-1e09-494f-bc11-0cc01da8f2c0",
                                "sense_id": "7df94fea-5256-3540-81ac-202d332efc24",
                                "text": "Je dis, oui j’ai un problème, je ne comprends pas pourquoi, pendant les leçons de religion, vous nous recommandez de ne pas « mascogner » à l’école."
                            },
                            {
                                "example_id": "882ac08d-4c30-4461-b696-4d195a7cf8be",
                                "sense_id": "7df94fea-5256-3540-81ac-202d332efc24",
                                "text": "Si les élèves de première ont décidé de mascogner, ce n’est certes pas pour discréditer la culture, mais pour déconsidérer leurs maîtres."
                            }
                        ]
                    }
