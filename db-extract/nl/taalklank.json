                    {
                        "translation_id": "3cd094a5-eeaf-42ca-911d-546b55d09664",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
                        "source_sense_id": "4a4007a4-3ce5-3aa0-8222-45a73f6e17b6",
                        "source_sense_description": "(taalkunde) een klank die betekenisonderscheidend werkt in een taal",
                        "target_lang_word": "Phonem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phonem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                        "entry_id": "03685094-2286-33b1-badd-cfe6eda71739",
                                        "glosses": [
                                            "die kleinste bedeutungsunterscheidende sprachliche Einheit (Langue)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b3ac9a-14dc-40e4-bb47-deb393963769",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "/r/ : /f/ => rein : fein. In diesem Minimalpaar zeigt sich, dass /r/ und /f/ zu verschiedenen Phonemen gehören müssen. Weiteres Beispiel:"
                                            },
                                            {
                                                "example_id": "4cf2042c-158a-4af8-9b90-1c3f2f6125f4",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "/h/ : /m/ => Haus : Maus"
                                            },
                                            {
                                                "example_id": "885a568e-0329-411a-acf3-c4d4e5667904",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "Zungenspitzen-[r] und Zäpfchen-[ʁ] sind beide freie Varianten (Allophone) des Phonems /r/; man kann mit ihnen allein kein Minimalpaar bilden."
                                            },
                                            {
                                                "example_id": "1856f62b-4fa4-49ac-b03f-b7b75213e108",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Jedes Wort in dieser Strophe entspricht den phonotaktischen Baugesetzen der englischen Sprache, d. h. die Phoneme, die kleinsten bedeutungsdifferenzierenden Einheiten des Englischen sind richtig kombiniert worden.“"
                                            },
                                            {
                                                "example_id": "800a8998-995d-4214-a55e-a5fd9697f412",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Was den Lautstand anbelangt, so bezeichnen wir die Bestandteile der Wortform als Laute; betrachten wir die Laute vom Lautsystem her (z. B. danach, ob sie Bedeutungen differenzieren können oder nicht), dann sprechen wir von Phonemen.“"
                                            },
                                            {
                                                "example_id": "d0a623d8-13f8-439d-947f-2afe9f440d11",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Ein Phonem mit erheblicher allophonischer Variation ist der š-Laut im Schwedischen.“"
                                            },
                                            {
                                                "example_id": "2f460094-db0e-4142-8f59-7abec0eff1c0",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Aber wenn sie in der Vorlesung auch nur das Wort »Phonem« erwähne, berichtet Valtin, »ist bei vielen Studenten sofort die Aufmerksamkeit weg«.“"
                                            },
                                            {
                                                "example_id": "d26af33a-46b4-4e95-a09f-16a5d4bc6501",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Der regelrechten Realisierung eines Phonems gehen viele einzelne Schritte voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e273667a-6c4e-44ec-b0fc-b43f519c6cdb",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
