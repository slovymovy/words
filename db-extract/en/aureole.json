                        ]
                    },
                    {
                        "translation_id": "f9e572b3-3bb4-4cf6-81e2-f0fc09fc29cc",
                        "source_entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                        "source_sense_description": "circle of light or halo around the head of a deity",
                        "target_lang_word": "Heiligenschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiligenschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f2e0d9d-0c60-318c-9bc6-81cf076c7354",
                                        "entry_id": "f3c3a4ea-02fb-3708-9903-16a3b24073df",
                                        "glosses": [
                                            "strahlende (oft goldene) Scheibe, Ring oder Strahlenkranz um oder über dem Kopf eines Heiligen (auf religiösen Bildern) als Sinnbild ewigen Ruhmes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18297e6-c342-4199-a54d-051e66461320",
                                                "sense_id": "4f2e0d9d-0c60-318c-9bc6-81cf076c7354",
                                                "text": "Auf Bildern mit religiösen Motiven sind oft Heiligenscheine zu sehen."
                                            },
                                            {
                                                "example_id": "b4be369d-b942-46a8-9fb6-afbd4b41ab3c",
                                                "sense_id": "4f2e0d9d-0c60-318c-9bc6-81cf076c7354",
                                                "text": "„Jemandem, der alles vergöttlicht, konnte diese Statue sehr leicht als Abbild unseres Erlösers erscheinen, denn der Bildhauer hatte den Kopf mit einer Art Heiligenschein umgeben, mit dem die Bildhauer und Maler die Heiligen darstellen.“"
                                            },
                                            {
                                                "example_id": "e3bf151d-7aaa-4036-8280-04ab7776b571",
                                                "sense_id": "4f2e0d9d-0c60-318c-9bc6-81cf076c7354",
                                                "text": "„Und nun wurde Chastity von allen ihren lieben Kolleginnen gleichzeitig gekniffen und gequält, aber methodisch und überlegt, um ihre Flügel und ihren Heiligenschein nicht zu ruinieren, denn dies war ja schließlich keine Orgie.“"
                                            },
                                            {
                                                "example_id": "1e5c78f9-215c-40b3-9587-ba9e2a81a69c",
                                                "sense_id": "4f2e0d9d-0c60-318c-9bc6-81cf076c7354",
                                                "text": "„Ben fuhr zu mir herum, seine Augen kalt, die Lampe hinter ihm wie ein wütender Heiligenschein hinter seinem Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f6591c6-8569-3cf5-aa1d-c88ae04accf2",
                                        "entry_id": "f3c3a4ea-02fb-3708-9903-16a3b24073df",
                                        "glosses": [
                                            "übertragen: hohes Ansehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5869eab-2c02-4bec-bda6-ddfa0d661d20",
                                                "sense_id": "0f6591c6-8569-3cf5-aa1d-c88ae04accf2",
                                                "text": "„Und so liefert der Abenteurer dem König nicht nur ein Objekt für seine Gier, sondern auch noch den Heiligenschein dazu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8544186-8bd3-4982-ae14-b230ebc185c1",
                        "source_entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                        "source_sense_description": "circle of light or halo around the head of a deity",
                        "target_lang_word": "Aureole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aureole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1038b079-dd26-3f2b-91d1-1667e5b6242b",
                                        "entry_id": "d883775b-db8a-3b11-b2a6-1cb4e2eec31e",
                                        "glosses": [
                                            "Strahlenkranz um die ganze Figur/Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650b3cc4-1be5-4fc1-9a4c-fa5eb458fbcf",
                                                "sense_id": "1038b079-dd26-3f2b-91d1-1667e5b6242b",
                                                "text": "„Der weibliche Teil der Gesellschaft und überhaupt das, was man im eigentlichen Sinne als »Welt« bezeichnet, nahm ihn freudig auf, weil er eine reiche und ansehnliche Partie bedeutete und nun nach seiner langen Abwesenheit fast als neue Person wirkte, geschmückt mit der Aureole, die ihm die romantische Geschichte seines vermeintlichen Todes und des tragischen Endes seiner Frau verlieh.“"
                                            },
                                            {
                                                "example_id": "b94cb3e6-573d-4a38-b3e7-e3b16e3d7a3f",
                                                "sense_id": "1038b079-dd26-3f2b-91d1-1667e5b6242b",
                                                "text": "„Ihr geschminkter Mund lachte, sie wiegte sich leicht in den Hüften, und die Sonne zerschmolz das Blond ihrer Haare zu Gold, einer schimmernden Aureole um ihren Kopf.“"
                                            },
                                            {
                                                "example_id": "34f4ec72-fcc5-47ad-abc6-30bde4e66dfc",
                                                "sense_id": "1038b079-dd26-3f2b-91d1-1667e5b6242b",
                                                "text": "„Cuvier war ihnen bis jetzt im Glanz einer Aureole erschienen, hoch auf dem Gipfel einer unangreifbaren Wissenschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8217ea95-490d-379d-acc5-bb815177452f",
                                        "entry_id": "d883775b-db8a-3b11-b2a6-1cb4e2eec31e",
                                        "glosses": [
                                            "angeleuchteter, dunstiger Kreis um Mond oder Sonne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6e8c92-f8ea-44b9-8405-34c7769b5ba0",
                                                "sense_id": "8217ea95-490d-379d-acc5-bb815177452f",
                                                "text": "Dicht um die Sonne oder auch den Mond liegen farbige Ringe, welche man auch Höfe oder Aureolen nennt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
