                        "glosses": [
                            "Véhicule automobile équipé d’une plateforme destinée à présenter des animations au public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d956721-a91e-40fd-ae09-c25a8017780c",
                                "sense_id": "edf03bea-6e08-3379-a21b-27df18f0e6a7",
                                "text": "Sur le car-podium, l’animateur n’a pas le renfort des strip-teaseuses professionnelles comme à Saint-Dizier."
                            },
                            {
                                "example_id": "44ef00d8-f4a4-454d-8719-a08b53bb713f",
                                "sense_id": "edf03bea-6e08-3379-a21b-27df18f0e6a7",
                                "text": "Il veut donc en profiter, et nous sommes toujours très sollicités en dehors des vols, qu'il s'agisse de soirées officielles ou plus simplement de rencontres avec le public sur les cars-podiums ou dans les allées des meetings."
                            }
                        ]
                    }
