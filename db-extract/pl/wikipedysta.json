                                    {
                                        "sense_id": "6b95f6c5-f0a5-3e2a-9646-82392c5e1d09",
                                        "entry_id": "f5c4b6ef-4e8d-3f66-95a7-4a35ed95a3d5",
                                        "glosses": [
                                            "een gebruiker [2] op Wikipedia."
                                        ],
                                        "tags": [
                                            "wikitaal",
                                            "Wikimedia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f5fe82-c8a6-4a26-9db6-ad4744ffce71",
                                                "sense_id": "6b95f6c5-f0a5-3e2a-9646-82392c5e1d09",
                                                "text": "Hij was een Wikipediaan in hart en nieren: zeer hoog opgeleid, maar zonder echte baan of sociaal leven en dus met genoeg tijd om zich vast te bijten in Wikipedia-artikelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
