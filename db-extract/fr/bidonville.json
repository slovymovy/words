                                        "sense_id": "49d6ca2d-b9e8-3d7f-bd41-a487b9a578ae",
                                        "entry_id": "a48711ed-9f6e-304e-83a9-fbce8aeecadf",
                                        "glosses": [
                                            "An area, such as a suburb, consisting of mean, roughly-constructed dwellings inhabited by poor people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133ebe3d-1c2f-4d6e-bef7-07e4a13abd4f",
                                                "sense_id": "49d6ca2d-b9e8-3d7f-bd41-a487b9a578ae",
                                                "text": "The navvies of the Midland Railway toiled for years to build it, enduring grim conditions in shanty towns that were built miles from civilisation. But build it they did, to form part of the Midland's main line between London St Pancras and Carlisle via Sheffield and Leeds from 1876."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
