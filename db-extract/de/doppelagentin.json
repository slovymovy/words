                    {
                        "sense_id": "09ced529-b7fe-3b14-a30b-e639c604217c",
                        "entry_id": "e72ec86a-6c13-3366-aeed-30d852fbd18c",
                        "glosses": [
                            "weibliche Person, die gleichzeitig für zwei konkurrierende Nachrichtendienste tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc1d187-3406-4274-ae4f-008956025a96",
                                "sense_id": "09ced529-b7fe-3b14-a30b-e639c604217c",
                                "text": "„Die Verblendungskünste schöner Frauen nützten Dienste zu allen Zeiten: von der legendären Tänzerin und Doppelagentin Mata Hari um 1900 bis zur 2010 enttarnten russischen Spionin Anna Chapman, später als Model im Einsatz.“"
                            },
                            {
                                "example_id": "886943bd-49cd-477b-8299-70ecc0108202",
                                "sense_id": "09ced529-b7fe-3b14-a30b-e639c604217c",
                                "text": "„Ja, ich bin eine Doppelagentin der Russen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
