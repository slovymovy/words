                                    {
                                        "sense_id": "682f40f3-7bbd-3664-b328-bb191f5d60a3",
                                        "entry_id": "18530c1f-c634-38ea-831b-4beb50d0835c",
                                        "glosses": [
                                            "A long speech by one person in a play; sometimes a soliloquy; other times spoken to other characters."
                                        ],
