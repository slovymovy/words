    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91ecd593-b647-3775-b52f-0b31de921413",
                    "sense_definition": "Tracer des signes graphiques ou des lettres représentant le langage sur un support.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "graphisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande aux élèves d'<w>écrire</w> la date sur leur cahier."
                        },
                        {
                            "text": "Il préfère <w>écrire</w> à la main plutôt que d'utiliser son ordinateur."
                        }
                    ],
                    "synonyms": [
                        "noter",
                        "coucher sur le papier"
                    ],
                    "common_phrases": [
                        "écrire à la main",
                        "écrire au stylo",
                        "écrire au tableau"
                    ]
                },
                {
                    "sense_id": "6545ac10-4b10-319f-b5b0-709e8df15626",
                    "sense_definition": "Communiquer avec quelqu'un par une lettre, un courriel ou un message écrit.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé d'<w>écrire</w> une lettre à ses grands-parents pendant les vacances."
                        },
                        {
                            "text": "Pense à m'<w>écrire</w> dès que tu arrives à destination."
                        }
                    ],
                    "synonyms": [
                        "correspondre"
                    ],
                    "common_phrases": [
                        "écrire une lettre",
                        "écrire un message"
                    ]
                },
                {
                    "sense_id": "ded45cb8-65f7-306a-b33c-281d19b4d18e",
                    "sense_definition": "Représenter un mot selon les règles de l'orthographe.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "orthographe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourriez-vous m'expliquer comment vous <w>écrivez</w> ce mot rare ?"
                        },
                        {
                            "text": "Cet élève attentif parvient toujours à <w>écrire</w> sans fautes d'accord."
                        }
                    ],
                    "common_phrases": [
