                    {
                        "translation_id": "c47e21ba-8c7b-4204-914e-bd97bced8238",
                        "source_entry_id": "ddde3792-93e0-3c68-a617-d3613109fab2",
                        "source_sense_id": "1b4bf34c-4847-364e-ba9b-b6f97556b3a2",
