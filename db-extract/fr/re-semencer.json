                "senses": [
                    {
                        "sense_id": "da3996fa-0a39-3e9f-8ea6-8f6e46d0f802",
                        "entry_id": "7c018e13-f40e-3930-a6e3-4abd6d0d4f9b",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43af366d-ae63-44f0-8698-5186c879afad",
                                "sense_id": "da3996fa-0a39-3e9f-8ea6-8f6e46d0f802",
                                "text": "Il faut dire que le père Schmeiser avait fait les trois : planter, commercialiser et re-semencer."
                            }
                        ]
                    },
                    {
                        "sense_id": "1798d108-c81a-34cf-8772-50a16db9cbba",
                        "entry_id": "7c018e13-f40e-3930-a6e3-4abd6d0d4f9b",
                        "glosses": [
                            "Clouer à nouveau avec des semences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34200db-981c-46c1-a42f-1b69d7e43c94",
                                "sense_id": "1798d108-c81a-34cf-8772-50a16db9cbba",
                                "text": "comme promis, je vous raconte mon cours de lundi… qui sera bref car je n’ai fait que \"semencer\" semencer et re-semencer !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b94434f8-e59f-3782-879d-dba03953da5b",
                        "entry_id": "7c018e13-f40e-3930-a6e3-4abd6d0d4f9b",
                        "glosses": [
                            "Utiliser une nouvelle semence dans un générateur de nombres aléatoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91a7da6-92e0-4585-a869-c17fb59a3821",
                                "sense_id": "b94434f8-e59f-3782-879d-dba03953da5b",
                                "text": "Un GNA n’a pas besoin de re-semencer, mais s’il ne le fait pas, il doit y avoir de l’entropie ajoutée à un taux meilleur que la sortie du GNA."
                            }
                        ]
                    }
