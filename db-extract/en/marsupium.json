                    {
                        "translation_id": "78a8d61b-bf16-48a4-87a5-48ecf66f5ace",
                        "source_entry_id": "ec98fae5-224b-372b-a858-7fabdd70f830",
                        "source_sense_description": "pouch of a marsupial",
                        "target_lang_word": "су́мка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́мка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0b1d61f0-0ef2-378b-b375-c59a963e0d4c",
                                        "entry_id": "99980f5c-f18c-32c5-acd1-dd0095e2a9f5",
                                        "glosses": [
                                            "сравнительно небольшое вместилище из ткани, кожи или другого мягкого материала с ручками (ремнями) для ношения предметов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ce7bdb-fef0-482a-a6f3-482b464eb206",
                                                "sense_id": "0b1d61f0-0ef2-378b-b375-c59a963e0d4c",
                                                "text": "Рядом с дедом валялась его сумка, в которой находилось что-то бугристое."
                                            },
                                            {
                                                "example_id": "61380cc2-fb0f-4fe2-9c04-5b45c29cfa29",
                                                "sense_id": "0b1d61f0-0ef2-378b-b375-c59a963e0d4c",
                                                "text": "У меня была сумка (через плечо), набитая всевозможными подарками, и отдельно — три бутылки армянского коньяка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea9fd5c-25f9-3966-99b5-012d2a468a57",
                                        "entry_id": "99980f5c-f18c-32c5-acd1-dd0095e2a9f5",
                                        "glosses": [
                                            "зоол., анат. у сумчатых животных — о́рган в виде кожной складки на животе для вынашивания и развития детёнышей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839f890f-925c-4d3a-9604-e8e5925241fd",
                                                "sense_id": "5ea9fd5c-25f9-3966-99b5-012d2a468a57",
                                                "text": "Новорождённый детёныш кенгуру ползёт от родового канала к сумке без всякой помощи матери и прицепляется к одному из сосков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2bf686-aa73-3caa-a124-57275b8251d9",
                                        "entry_id": "99980f5c-f18c-32c5-acd1-dd0095e2a9f5",
                                        "glosses": [
                                            "анат. название некоторых о́рганов из соединительной ткани, вмещающих другие о́рганы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf397c7-992f-4e4d-807b-87cdf3df1167",
                                                "sense_id": "7b2bf686-aa73-3caa-a124-57275b8251d9",
                                                "text": "Суставная сумка прикрепляется по краю суставных поверхностей и укрепляется связками, идущими от лодыжек к костям стопы."
                                            },
                                            {
                                                "example_id": "2b50a2f2-60da-407f-bd0e-465b939befa2",
                                                "sense_id": "7b2bf686-aa73-3caa-a124-57275b8251d9",
                                                "text": "Позади желудка находится щелевидное пространство брюшинной полости — сальниковая сумка, отделяющая его от органов, располагающихся на задней брюшной стенке: верхнего полюса левой почки, надпочечника и поджелудочной железы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3975fa2b-924f-3777-9c04-f47cec2576b0",
                                        "entry_id": "99980f5c-f18c-32c5-acd1-dd0095e2a9f5",
                                        "glosses": [
                                            "микол. аск, орган полового спороношения у аскомицетов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce07b064-447b-4bee-add3-32a2ef5c1f0c",
                                                "sense_id": "3975fa2b-924f-3777-9c04-f47cec2576b0",
                                                "text": "К сумчатым грибам относятся грибы с многоклеточной грибницей, у которых основным органом размножения является сумка, или аск."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e3314c-ab05-3b33-a08b-87caad6286ec",
                                        "entry_id": "99980f5c-f18c-32c5-acd1-dd0095e2a9f5",
                                        "glosses": [
                                            "матем. то же, что мультимножество"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
