                    {
                        "sense_id": "abd9b60f-2010-3f74-9a33-e5e34958753a",
                        "entry_id": "f409a702-4f6a-3e8c-bbc0-1865ee1f92a9",
                        "glosses": [
                            "Gebrauch oder Anwendung von etwas, sodass es dem Anwender Nutzen bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d5e9fc-b360-46ff-8646-1c7232dcbb75",
                                "sense_id": "abd9b60f-2010-3f74-9a33-e5e34958753a",
                                "text": "„Die Zentrifuge ist ein technisches Gerät, das unter Ausnutzung der Massenträgheit arbeitet; die Funktionsweise beruht auf der Zentrifugalkraft, die aufgrund einer gleichförmigen Kreisbewegung des zu zentrifugierenden Gutes zustande kommt.“"
                            },
                            {
                                "example_id": "582ce8a0-4484-4cbd-ab36-5afb637f0af7",
                                "sense_id": "abd9b60f-2010-3f74-9a33-e5e34958753a",
                                "text": "„Eine Verbunddampflokomotive hat eine Dampfmaschine mit zweifacher Ausnutzung der Dampfdehnung in getrennten Zylindern, die als Verbundwirkung bezeichnet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "03271253-1289-3220-a757-9aac7763d1ff",
                        "entry_id": "f409a702-4f6a-3e8c-bbc0-1865ee1f92a9",
                        "glosses": [
                            "meist unrechtmäßiger Gebrauch von etwas oder jemandem, ohne Rücksicht auf den entstehenden Schaden zu nehmen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "1f86b5f5-36d6-459d-a90f-ce4a78e075ae",
                                "sense_id": "03271253-1289-3220-a757-9aac7763d1ff",
                                "text": "Verschärfte Gesetze sollten die Ausnutzung der Ureinwohner unterbinden."
                            }
                        ],
                        "sense_index_json": "\"2\""
