                    "target_lang_definitions": {
                        "en": "Expresses doubt or hesitation.",
                        "ru": "Выражает сомнение или нерешительность.",
                        "it": "Esprime dubbio o esitazione."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "expressing hesitation or uncertainty"
