{
    "word_family": [
        "quick",
        "quickness",
        "quicken"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c691aa24-7e91-32a6-b444-d39381f6d1ef",
                    "sense_definition": "In a rapid manner; with high speed or fast motion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete ran <w>quickly</w> across the finish line to win the gold medal.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>быстро</w> пересек финишную черту, чтобы завоевать золотую медаль.",
                                "zh": "运动员<w>迅速</w>跑过终点线，赢得了金牌。"
                            }
                        },
                        {
                            "text": "If you move <w>quickly</w>, you can catch the bus before it leaves the station.",
                            "target_lang_translations": {
                                "ru": "Если ты будешь двигаться <w>быстро</w>, то успеешь на автобус, пока он не уехал со станции.",
                                "zh": "如果你动作<w>快</w>一点，就能在公交车离开车站前赶上它。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fast",
                        "rapidly",
                        "speedily",
                        "swiftly"
                    ],
                    "antonyms": [
                        "slowly"
                    ],
                    "common_phrases": [
                        "move quickly",
                        "walk quickly",
                        "respond quickly",
                        "act quickly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро, с большой скоростью или стремительным движением.",
                        "zh": "以极高的速度或敏捷的动作进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстро",
                                "target_lang_sense_clarification": "с большой скоростью"
                            },
                            {
                                "target_lang_word": "стремительно",
                                "target_lang_sense_clarification": "очень быстро и энергично"
                            },
                            {
                                "target_lang_word": "оперативно",
                                "target_lang_sense_clarification": "быстро и эффективно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快",
                                "target_lang_sense_clarification": "速度高"
                            },
                            {
                                "target_lang_word": "迅速",
                                "target_lang_sense_clarification": "动作敏捷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                    "sense_definition": "Within a short period of time; very soon or without delay.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Luckily, the technical error was <w>quickly</w> corrected by the IT department.",
                            "target_lang_translations": {
                                "ru": "К счастью, техническая ошибка была <w>быстро</w> исправлена ИТ-отделом.",
                                "zh": "幸运的是，技术故障被IT部门<w>很快</w>修复了。"
                            }
                        },
                        {
                            "text": "The situation changed very <w>quickly</w> after the new law was announced yesterday.",
                            "target_lang_translations": {
                                "ru": "Ситуация изменилась очень <w>быстро</w> после того, как вчера был объявлен новый закон.",
                                "zh": "新法律昨天宣布后，情况发生了<w>很快</w>的变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promptly",
                        "immediately",
                        "fast"
                    ],
                    "antonyms": [
                        "slowly"
                    ],
                    "common_phrases": [
                        "very quickly",
                        "happened quickly",
                        "finish quickly",
                        "learn quickly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение короткого периода времени; вскоре или без задержки.",
                        "zh": "在很短的时间内；很快或毫不拖延地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстро",
                                "target_lang_sense_clarification": "за короткое время"
                            },
                            {
                                "target_lang_word": "скоро",
                                "target_lang_sense_clarification": "через небольшой промежуток времени"
                            },
                            {
                                "target_lang_word": "вскоре",
                                "target_lang_sense_clarification": "в ближайшее время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很快",
                                "target_lang_sense_clarification": "时间短"
                            },
                            {
                                "target_lang_word": "立即",
                                "target_lang_sense_clarification": "毫不拖延"
                            }
                        ]
                    }
                }
            ]
        }
