                                    },
                                    {
                                        "sense_id": "11d6e7a3-ec6c-3d7e-b139-c386f8e7a3f5",
                                        "entry_id": "7dd0a688-7051-38be-ad6b-d7e062813592",
                                        "glosses": [
                                            "Fit to inspire mourning; tragic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ec8ce6-4ac5-4352-8a8f-6cab12ff2b04",
                                                "sense_id": "11d6e7a3-ec6c-3d7e-b139-c386f8e7a3f5",
                                                "text": "Having deposited our mournful burden upon tressels within this region of horror, we partially turned aside the yet unscrewed lid of the coffin, and looked upon the face of the tenant."
                                            }
                                        ]
                                    }
                                ]
                            }
