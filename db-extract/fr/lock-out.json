                        ],
                        "examples": [
                            {
                                "example_id": "c03ae9e5-b9ff-42f4-90e2-c18300b86858",
                                "sense_id": "278dcfab-dbc1-3932-a7da-d84fdfc910eb",
                                "text": "Décider le lock-out."
                            },
