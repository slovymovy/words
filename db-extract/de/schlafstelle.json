                "senses": [
                    {
                        "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                        "entry_id": "14fedbf0-2439-3028-9082-2246e1915247",
                        "glosses": [
                            "Stelle, an der jemand oder etwas schläft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5e1d31-99e3-46c6-a8dd-8aac31f094d1",
                                "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                                "text": "Eine Koje ist eine enge Schlafstelle."
                            },
                            {
                                "example_id": "cbd1673b-6f5e-4a4b-b6c1-284340fc7c40",
                                "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                                "text": "„Damit niemand erfriert, gibt es mehr Schlafstellen und eine Notfall-Hotline.“"
                            },
                            {
                                "example_id": "a8ca2fef-365b-4a27-a199-6429a73a0c87",
                                "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                                "text": "„Beim Mittagessen sitzen wir zusammen am Tisch, und unsere Schlafstellen richten wir auch gemeinsam, immer zwei und zwei, ich schlafe mit Dita zusammen.“"
                            },
                            {
                                "example_id": "0f4b3f6c-3294-489d-8a82-127208115c2b",
                                "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                                "text": "„So tauchte ich, nachdem ich Mr. Mifflin erzählt hatte, was für Gefühle mich bewegten, im Parnassus unter und machte es mir auf der Schlafstelle gemütlich.“"
                            },
                            {
                                "example_id": "8b9d24a7-4248-46c9-91c6-859f53630238",
                                "sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                                "text": "„Ich habe Glück mit meiner Schlafstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "412d39ad-83a1-4796-8e6d-ee987f51d40c",
                        "source_entry_id": "14fedbf0-2439-3028-9082-2246e1915247",
                        "source_sense_id": "da016630-a4ad-3c50-b5e9-9b6cf83a55de",
                        "source_sense_description": "Stelle, an der jemand oder etwas schläft",
                        "target_lang_word": "flop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566da1c3-68b4-3683-9efd-7f312ba5048b",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To fall heavily due to lack of energy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39a4fc11-beb3-4a96-9e92-48553990c2df",
                                                "sense_id": "566da1c3-68b4-3683-9efd-7f312ba5048b",
                                                "text": "He flopped down in front of the television, exhausted from work."
                                            },
                                            {
                                                "example_id": "0aa5ac55-b99a-48a5-839e-7a47a7baebab",
                                                "sense_id": "566da1c3-68b4-3683-9efd-7f312ba5048b",
                                                "text": "There was [in the clock in Lyons Cathedral] a centre puppet of the Virgin Mary; and close to her, a small pigeon-hole, out of which another and a very ill-looking puppet made one of the most sudden plunges I ever saw accomplished: instantly flopping back again at sight of her, and banging his little door violently, after him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d352570c-7245-35ba-94a8-e786e713a5b6",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To cause to drop heavily."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60ab10a-b090-4599-9b12-541ea8e9f377",
                                                "sense_id": "d352570c-7245-35ba-94a8-e786e713a5b6",
                                                "text": "The tired mule flopped its ears forward and trudged on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a977e3b2-21da-3ab9-bbcd-35adf0606ebe",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To fail completely; not to be successful at all (of a movie, play, book, song etc.)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2265e4b-8ebf-4bd0-8e68-9945d5e6e1b5",
                                                "sense_id": "a977e3b2-21da-3ab9-bbcd-35adf0606ebe",
                                                "text": "The latest album flopped and so the studio canceled her contract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b945ca-0fed-3688-bcc6-4ff71153801d",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To pretend to be fouled in sports, such as basketball, hockey (the same as to dive in soccer)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06faf4b1-c0f6-4a95-ada0-829c8a84e41b",
                                                "sense_id": "66b945ca-0fed-3688-bcc6-4ff71153801d",
                                                "text": "It starts with Chris Paul, because Blake didn't really used to flop like that, you know, last year."
                                            },
                                            {
                                                "example_id": "99ea717c-73af-4300-9df7-9be8a5f53fb4",
                                                "sense_id": "66b945ca-0fed-3688-bcc6-4ff71153801d",
                                                "text": "While Stern chastised Vogel for on Thursday calling the Heat \"the biggest flopping team in the NBA,\" he did intimate that he sees merit in the sentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aca4caa-96d6-3631-8707-1b2b9ae9b642",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To strike about with something broad and flat, as a fish with its tail, or a bird with its wings; to rise and fall; to flap."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8391c83a-c818-4519-b583-93773fd93b22",
                                                "sense_id": "2aca4caa-96d6-3631-8707-1b2b9ae9b642",
                                                "text": "The brim of a hat flops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a68bd8b-90af-394a-9932-254fe5023a1a",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To have (a hand) using the community cards dealt on the flop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a941b5ef-36b5-4aa6-b01a-fd802eabea7e",
                                                "sense_id": "5a68bd8b-90af-394a-9932-254fe5023a1a",
                                                "text": "Both players flopped sets! Cards dealt on the flop: Q95. Player A's hole cards: 55 (making three of a kind: 555). Player B's hole cards: QQ (making three of a kind: QQQ)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585fed09-9731-340f-bd8a-70c0a085a54b",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To stay, sleep or live in a place."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afcecf68-9835-47aa-8d86-761bfad1fe58",
                                                "sense_id": "585fed09-9731-340f-bd8a-70c0a085a54b",
                                                "text": "[…] not just the old material goal of \"three hots and a place to flop,\" […]"
                                            },
                                            {
                                                "example_id": "c0d75dec-b13f-456e-988d-f5b194f0c481",
                                                "sense_id": "585fed09-9731-340f-bd8a-70c0a085a54b",
                                                "text": "They have opened up crypts and basements as immense pads where vagrant and impoverished hippies can flop for the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029472cb-1a47-31d1-aab5-1449e038c453",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To flip; to reverse (an image)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf66a2f-1439-4dac-bbe5-646d0a37fe27",
                                                "sense_id": "029472cb-1a47-31d1-aab5-1449e038c453",
                                                "text": "[…] in order to flop the image left-to-right, or all printing will appear reversed."
                                            },
                                            {
                                                "example_id": "3eaf5ae8-8d03-43e8-86cc-a7af400f709d",
                                                "sense_id": "029472cb-1a47-31d1-aab5-1449e038c453",
                                                "text": "The possibilities of this type of shot are almost limitless. By quartering the screen and duplicating and flopping the picture, a kaleidoscopic effect is achieved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb7fd45-b4f3-3dae-a84d-ca8c18f1fedf",
                                        "entry_id": "36175901-2234-308d-910b-56a8e08af4bd",
                                        "glosses": [
                                            "To deny someone parole."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eb67842-b7de-4c41-822f-32ec2c4f1c27",
                                                "sense_id": "cfb7fd45-b4f3-3dae-a84d-ca8c18f1fedf",
                                                "text": "I've been incarcerated going on 9½ years. I have never been back on the streets or given a chance to prove myself to society. Every time I would meet the parole board they would flop me telling me I would be a threat to society."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bce59c42-feaa-3987-99f3-6112d694300d",
                                        "entry_id": "7aa8bacc-5f1e-325e-8a64-0be7ad80f3e7",
                                        "glosses": [
                                            "A heavy, passive fall; a plopping down."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c72adcec-6e96-3e16-84c2-66358acc278b",
                                        "entry_id": "7aa8bacc-5f1e-325e-8a64-0be7ad80f3e7",
                                        "glosses": [
                                            "A complete failure, especially in the entertainment industry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf6f070-58f3-46b8-926e-626fd950f12d",
                                                "sense_id": "c72adcec-6e96-3e16-84c2-66358acc278b",
                                                "text": "Well I know your little baby sister / She thinks that I'm a flop / But I guess that you know that it's true / I spent more time at the bottom than the top"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da07031-607a-3011-a553-507372a2f527",
                                        "entry_id": "7aa8bacc-5f1e-325e-8a64-0be7ad80f3e7",
                                        "glosses": [
                                            "The first three cards turned face-up by the dealer in a community card poker game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffaf890f-98b8-45f6-9517-2b8897c7dc39",
                                                "sense_id": "4da07031-607a-3011-a553-507372a2f527",
                                                "text": "The flop didn't help you but probably did help the other hands."
                                            },
                                            {
                                                "example_id": "3cdb37a6-5b2d-417b-8bb7-6fda691568cb",
                                                "sense_id": "4da07031-607a-3011-a553-507372a2f527",
                                                "text": "Here are six tips to help you play successfully on the flop (the first three communal cards)."
                                            },
                                            {
                                                "example_id": "0e4b1aac-fafd-41a4-990f-14ad05514c7f",
                                                "sense_id": "4da07031-607a-3011-a553-507372a2f527",
                                                "text": "The strength of your hand now has nothing to do with how strong it may have been before the flop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c51a30-ef82-3e10-be4b-1df6042c14a4",
                                        "entry_id": "7aa8bacc-5f1e-325e-8a64-0be7ad80f3e7",
                                        "glosses": [
                                            "A ponded package of dung, as in a cow-flop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fd1b40-4a73-4c7e-a6b9-d0994d39976c",
                                                "sense_id": "11c51a30-ef82-3e10-be4b-1df6042c14a4",
                                                "text": "\"Maybe as you think,\" he said, \"because as I've the misfortune of an accidental slip on a cow-flop therefore I has the inability of an unborn babe, ..."
                                            },
                                            {
                                                "example_id": "e2293515-0764-465b-94a9-33168dd3697c",
                                                "sense_id": "11c51a30-ef82-3e10-be4b-1df6042c14a4",
                                                "text": "... cowpat or cow-flop, Cow dung, often used dry as heating fuel."
                                            },
                                            {
                                                "example_id": "61b4cce2-0bc4-4a7b-987f-88b65fe29f6b",
                                                "sense_id": "11c51a30-ef82-3e10-be4b-1df6042c14a4",
                                                "text": "\"Cow flop in a neat package is still cow flop. What did Cable stand to gain from the flood?\""
                                            },
                                            {
                                                "example_id": "f8b6dcad-4803-4a00-8994-aedef8d491e6",
                                                "sense_id": "11c51a30-ef82-3e10-be4b-1df6042c14a4",
                                                "text": "2018 Brent Butt as Brent Herbert Leroy, \"Sasquatch Your Language\", Corner Gas Animated\nWherever legitimate tracks are found there's always some fresh scat, y'know, poo, flop, dumplings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbdaaf04-68bb-3115-a93b-7ee405364105",
                                        "entry_id": "7aa8bacc-5f1e-325e-8a64-0be7ad80f3e7",
                                        "glosses": [
                                            "A flophouse."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3d3c29-8db7-4bf5-8265-823708272ffb",
                                                "sense_id": "bbdaaf04-68bb-3115-a93b-7ee405364105",
                                                "text": "He was kind of worn but the tooth said he'd never lost a fight or slept in a flop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91fb7ac6-bffd-326a-bc91-49e197526069",
                                        "entry_id": "844172bc-5d1e-3cec-b313-e5f066cef8ce",
