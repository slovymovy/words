                        "glosses": [
                            "Se comporter comme un ratichon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcbb041-7d1b-481a-b9ef-351ae5c85f94",
                                "sense_id": "e4335172-2918-3991-9a34-d7d4c53726bd",
                                "text": "Les bourgeois apportaient un louis, une thune Et tes frocards, oblats, maristes, capucins, Ratichonnaient comme des porcs sur leur fortune."
                            },
                            {
                                "example_id": "8fbf1bf9-6761-4d98-ac52-2819491c6ff0",
                                "sense_id": "e4335172-2918-3991-9a34-d7d4c53726bd",
                                "text": "Que les viviphiles se rassurent tout de suite : je ne suis pas tombée assez bas pour me mettre à ratichonner sur mes vieux jours, foutredieu !"
                            }
                        ]
                    }
