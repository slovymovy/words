                                        "examples": [
                                            {
                                                "example_id": "57f958b3-012c-4044-bd18-0f3928eb4e36",
                                                "sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                                                "text": "Heute Abend bin ich mit Freunden zum Karaoke verabredet."
                                            },
                                            {
                                                "example_id": "1eb2e51e-fa7b-47d9-b99c-8dc9d8d97b0a",
                                                "sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                                                "text": "„Das sangesfreudige Volk macht das nicht nur in Diskotheken, mittlerweile bietet jede Kneipe, oft mehrfach in der Woche, Karaoke an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
