        "fr-extract.jsonl": [
            {
                "entry_id": "14d9f58e-9d85-3c08-8d61-1ca1f6391d6e",
                "word": "nugget",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c7bcf7e-e5bc-4d40-b573-f980c621b980",
                        "entry_id": "14d9f58e-9d85-3c08-8d61-1ca1f6391d6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "nuggets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                        "entry_id": "14d9f58e-9d85-3c08-8d61-1ca1f6391d6e",
                        "glosses": [
                            "Morceau, habituellement de poulet, ou à base de poulet (occasionnellement un autre ingrédient est utilisé à la place, comme du fromage, ou du bœuf), pané, et frit à l’huile ou cuit au four."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "10384b86-71a3-4334-b53c-3399f655deed",
                                "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                                "text": "Greenpeace accuse McDonald’s et le géant américain du soja Cargill de « saccager » les forêts amazoniennes en y cultivant le soja nécessaire à alimenter les poulets qui finiront en nuggets."
                            },
                            {
                                "example_id": "1b6ed7f0-7380-49ee-8d7e-4a1cf6abd142",
                                "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                                "text": "Sauf que McDo, qui mise sur le poulet pour tailler des croupières à son concurrent KFC, s’inquiète pour l’avenir de ce bijou nutritionnel qu’est le nugget."
                            },
                            {
                                "example_id": "34974f66-8285-4a06-8c55-f5c0fcc41c1f",
                                "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                                "text": "Elle était comme cette image qui s'affichait sur son portable, un petit poussin qui fuit ne voulant pas être une nugget."
                            },
                            {
                                "example_id": "83e76fff-2467-41f1-b2be-ed14ab79cdfe",
                                "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                                "text": "Une nugget (mot anglais signifiant « pépite ») est une croquette en forme de bâtonnet, panée et frite. Les nuggets sont généralement au poulet."
                            },
                            {
                                "example_id": "817739e5-f3a1-41c3-a3f7-8aa010241e65",
                                "sense_id": "a0d743cb-4be3-3531-bc58-0b54219a600b",
                                "text": "Ils prirent possession du chalet et elle descendit au village les approvisionner en junk-food à prix d'or : frites au four, nuggets surgelés, glaces, sauces samouraï, ketchup et mayonnaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fa90ef8-e37f-3393-84a1-dad9e2b6caf7",
                        "entry_id": "14d9f58e-9d85-3c08-8d61-1ca1f6391d6e",
                        "glosses": [
                            "Pépite."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "examples": [
                            {
                                "example_id": "baa1ce5a-b0f6-4b65-a99e-6d843e366827",
                                "sense_id": "0fa90ef8-e37f-3393-84a1-dad9e2b6caf7",
                                "text": "… près d'Orange (Nouvelle-Galle du Sud) un berger découvrit une nugget pesant un peu plus de 2.217 onces, soit près de 69 kilogrammes d'or pur ; …."
                            },
                            {
                                "example_id": "c83ed112-6103-4f32-8367-665bc64f9063",
                                "sense_id": "0fa90ef8-e37f-3393-84a1-dad9e2b6caf7",
                                "text": "Le 13 mai on vit un homme rapporter à Bathurst un fragment d'or , un nugget, — c'est le terme californien qui est passé en Australie, pesant treize onces et estimé à trente livres sterling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd38c904-49fd-444c-bedf-c541826a191c",
                        "source_entry_id": "14d9f58e-9d85-3c08-8d61-1ca1f6391d6e",
                        "target_lang_word": "nugget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nugget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10efc133-55f6-378d-9bb4-440700a78b09",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A small, compact chunk or clump."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0897b71-a1d5-4128-aa61-0c8645408d42",
                                                "sense_id": "10efc133-55f6-378d-9bb4-440700a78b09",
                                                "text": "a gold nugget"
                                            },
                                            {
                                                "example_id": "221f3e7f-9783-4ef5-8123-e07b19c72b31",
                                                "sense_id": "10efc133-55f6-378d-9bb4-440700a78b09",
                                                "text": "Rough men brought pickle bottles full of nuggets. Mysterious dirty-looking calico bags were opened, disclosing small quantities of water-worn flaky gold, which had been washed out of the beds of rivers with a cradle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e59433-50fd-30b2-8835-a53aa467d62c",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A chicken nugget."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1fb362-8927-45d0-a679-6ca4119b33b5",
                                                "sense_id": "89e59433-50fd-30b2-8835-a53aa467d62c",
                                                "text": "By now, we hope you have said “no” to processed nuggets and fingers. Instead, how about taking some real chicken, tossing it with real eggs, a little tangy mustard, and a crunchy quinoa coating?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4a1bb8-d5e1-3ada-9a97-1cff4d36b99b",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A tidbit of something valuable."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb9f438-c021-4aca-87e3-a3691be76a37",
                                                "sense_id": "7a4a1bb8-d5e1-3ada-9a97-1cff4d36b99b",
                                                "text": "a nugget of wisdom"
                                            },
                                            {
                                                "example_id": "f47c2b8d-477d-429f-b475-830a2fbb04b3",
                                                "sense_id": "7a4a1bb8-d5e1-3ada-9a97-1cff4d36b99b",
                                                "text": "a nugget of truth"
                                            },
                                            {
                                                "example_id": "2eb04ce5-5125-45c9-9f7a-b9301e12d70e",
                                                "sense_id": "7a4a1bb8-d5e1-3ada-9a97-1cff4d36b99b",
                                                "text": "As he has in superb works like “The Source” (based on the Afghanistan war logs leaked by Chelsea Manning) and “Sound From the Bench” (which set excerpts from Supreme Court proceedings), Hearne takes these found-text nuggets and gives them music that moves from lushly meditative to frenetic and obsessively repetitive […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14eb787-40e6-341c-9b2c-eb016d8fef64",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A small piece of tasty food, a tidbit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "652674ee-cb08-324b-af35-ec72ff186f4c",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A type of boot polish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88b65f74-c6ba-3e54-8452-559a4eb37bba",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A bud from the Cannabis sativa plant, especially one that is potent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d08933c4-b57c-36a9-acaa-b36eb470c7be",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "An inexperienced, newly trained fighter pilot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ef2c60-817f-4d5b-a742-3017a536f709",
                                                "sense_id": "d08933c4-b57c-36a9-acaa-b36eb470c7be",
                                                "text": "Jack stifled a smirk at the ensign's expressionless non-reaction. He'd been a nugget himself once, the new guy fresh from training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafaaff1-9ab1-32fe-a66c-c06c84c96f9b",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A partial description gleaned from data mining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd33de88-8e32-4b8b-b494-479c61912eae",
                                                "sense_id": "bafaaff1-9ab1-32fe-a66c-c06c84c96f9b",
                                                "text": "We have previously said that the heuristic algorithms produce good nuggets for most classes and most λ values […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d184bfa-ae95-3e15-9590-836d083faf35",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "A person with no arms or legs; a basket case."
                                        ],
                                        "tags": [
