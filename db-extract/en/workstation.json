                    },
                    {
                        "translation_id": "f6e5f8f3-74da-425d-950b-a04a4077f395",
                        "source_entry_id": "00b4933a-a7a6-3ae0-a766-9ebd8af353bc",
                        "source_sense_description": "powerful desktop computer",
                        "target_lang_word": "werkstation",
                        "target_lang_code": "nl",
