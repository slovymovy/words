                "senses": [
                    {
                        "sense_id": "72a8854f-477d-3716-84f8-e0e0ed02c8ac",
                        "entry_id": "bac69811-42ba-3743-bca1-e9f18a702588",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen und Einrichtungen zur industriellen Herstellung von Gütern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e5709c-02e5-415b-8df9-ad9957e7e2d0",
                                "sense_id": "72a8854f-477d-3716-84f8-e0e0ed02c8ac",
                                "text": "„In einem vorher wohl kaum für möglich gehaltenen Ausmaß wurde diese Industrialisierung, begleitet von zahlreichen Verbesserungen der Produktionstechnik, durchgeführt.“"
                            },
                            {
                                "example_id": "15e40c52-84c1-4b5e-ac19-14ebdea3ffe2",
                                "sense_id": "72a8854f-477d-3716-84f8-e0e0ed02c8ac",
                                "text": "„Wer Produktionstechnik in Lemgo studieren will, kann sich noch zum am Montag beginnenden Wintersemester direkt in der Hochschule einschreiben.“"
                            }
                        ],
