                                "nl": "De kinderen openden hun cadeautjes met gilletjes van <w>vreugde</w>.",
                                "pl": "Dzieci otwierały prezenty z piskami <w>radości</w>.",
                                "de": "Die Kinder öffneten ihre Geschenke mit Freudenschreien vor <w>Entzückung</w>.",
                                "fr": "Les enfants ont ouvert leurs cadeaux avec des cris de <w>joie</w>.",
                                "it": "I bambini hanno aperto i regali con strilli di <w>gioia</w>.",
                                "cs": "Děti otevíraly dárky s výskáním <w>radosti</w>.",
                                "tr": "Çocuklar hediyelerini <w>sevinç</w> çığlıklarıyla açtılar.",
                                "es": "Los niños abrieron sus regalos con gritos de <w>alegría</w>.",
                                "zh": "孩子们尖叫着<w>喜悦</w>地打开了礼物。"
                            }
                        },
                        {
                            "text": "To my <w>delight</w>, the sun came out just in time for the picnic.",
                            "target_lang_translations": {
                                "ru": "К моей <w>радости</w>, солнце выглянуло как раз к пикнику.",
                                "nl": "Tot mijn <w>vreugde</w> kwam de zon precies op tijd voor de picknick tevoorschijn.",
                                "pl": "Ku mojej <w>radości</w>, słońce wyszło w samą porę na piknik.",
                                "de": "Zu meiner <w>Freude</w> kam die Sonne gerade rechtzeitig für das Picknick heraus.",
                                "fr": "À ma grande <w>joie</w>, le soleil est apparu juste à temps pour le pique-nique.",
                                "it": "Con mia grande <w>gioia</w>, è uscito il sole giusto in tempo per il picnic.",
                                "cs": "K mému <w>potěšení</w> vysvitlo slunce přesně včas na piknik.",
                                "tr": "Büyük bir <w>sevinçle</w> gördüm ki, güneş tam piknik vaktinde açtı.",
                                "es": "Para mi <w>alegría</w>, el sol salió justo a tiempo para el picnic.",
                                "zh": "令我<w>欣喜</w>的是，太阳正好在野餐时出来了。"
                            }
                        }
