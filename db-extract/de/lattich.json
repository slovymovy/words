                                                "example_id": "f13caa51-178b-4d72-8ad2-5fc01a8b24df",
                                                "sense_id": "add8877c-a612-3ff2-892c-3e91b07a010f",
                                                "text": "Semez du chou chinois, des épinards et des laitues à couper"
                                            }
                                        ]
                                    },
