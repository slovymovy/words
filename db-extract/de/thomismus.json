                    {
                        "translation_id": "1b5c1f99-bd27-4ec5-acac-f9bf5faa7cfe",
                        "source_entry_id": "f8d553c4-6dea-3de9-9169-84b20e8860d3",
                        "source_sense_id": "9ee173ee-5b83-3f0f-b1b7-d9bd1d4cf8f2",
                        "target_lang_word": "thomisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
