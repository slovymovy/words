                                        "entry_id": "6ac3bc0f-6575-3a1d-a621-df7de79ddc1e",
                                        "glosses": [
                                            "Verhalten, bei dem man versucht, durch Wachsamkeit und/oder Zurückhaltung negative Folgen oder Schäden zu vermeiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af99a14-6bdd-477b-9d3a-3d82779f0c60",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "Im Straßenverkehr ist immer Vorsicht geboten."
                                            },
                                            {
                                                "example_id": "96b1fd1b-09d2-4d9b-8292-321d59069131",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "Man muss beim Umgang mit ihm immer einige Vorsicht walten lassen."
                                            },
                                            {
                                                "example_id": "83c8e2e7-d7b9-4b66-9ca8-85ebf777b391",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "„Keine Investition ohne vorherige Renditenkalkulation. Doch Vorsicht, wenn die Rendite-Versprechungen allzu vollmundig sind.“"
                                            },
                                            {
                                                "example_id": "5843dddf-b870-4f83-8c76-d59b8c3bd188",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "„Vorsicht und Aufmerksamkeit waren gefragt, um nicht in den Dreck zu treten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                        "entry_id": "6ac3bc0f-6575-3a1d-a621-df7de79ddc1e",
                                        "glosses": [
                                            "Hinweis auf eine Gefahr, meist als Ausrufesatz oder auf Schildern; Aufforderung zu [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95a7465-af6b-47c4-96ad-0e126d48f293",
                                                "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                                "text": "Vorsicht! Sonst fällst du noch die Treppe runter, Mensch."
                                            },
                                            {
                                                "example_id": "f70eff03-030a-4ea0-bc7c-85774b46b295",
                                                "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                                "text": "Auf einem Schild steht: Vorsicht vor herunterfallenden Lasten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
