                "senses": [
                    {
                        "sense_id": "ff8d5927-85c5-3d00-9555-fd90d2d243f5",
                        "entry_id": "2b4e4586-9d5a-3ffd-b644-9405c63d2047",
                        "glosses": [
                            "zoals een gek zou doen; overdreven en onnozel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f857c7fb-bbad-4db6-a02f-989dc4ba379c",
                                "sense_id": "ff8d5927-85c5-3d00-9555-fd90d2d243f5",
                                "text": "En dan lees ik in de krant dat Nederlanders dankzij het echt heel erg mooie liedje het songfestival weer zijn gaan waarderen. Het songfestival was op zijn retour, niemand keek er meer naar omdat de muziek op het festival zo mallotig is. Maar niet langer. Morgenavond gaan miljoenen mensen, net zoals ze dinsdag deden bij de halve finale, zich door anderhalf uur van die mallotige muziek heen ploeteren, alleen maar om Anouk een echt heel mooi liedje te horen zingen."
                            },
                            {
                                "example_id": "241c954c-f582-42b1-adcf-9be7ffecc288",
                                "sense_id": "ff8d5927-85c5-3d00-9555-fd90d2d243f5",
                                "text": "In de supermarktdiepvries ligt een in het oog springende zak patat. Op de verpakking staat een spijkerbroek met een kontzak vol dungesneden friet (???) en een badge met de tekst 'I love skinny fries'. Skinny fries, een naam die niets te maken heeft met calorie-armoede maar des te meer met een mallotig marketingplan om krokante dunne frietjes aan de jongeman te krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92f6e0b6-f4e1-4252-ae7b-731b419f3fae",
                        "source_entry_id": "2b4e4586-9d5a-3ffd-b644-9405c63d2047",
                        "source_sense_id": "ff8d5927-85c5-3d00-9555-fd90d2d243f5",
                        "source_sense_description": "zoals een gek zou doen; overdreven en onnozel",
                        "target_lang_word": "dorky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dorky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf89f9c-fa7d-30bf-bae9-fe2aac2ef374",
                                        "entry_id": "94b4c287-667d-30a9-9d7a-999a0d2a8e54",
                                        "glosses": [
                                            "Like a dork."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d89f36-1ee1-4e93-8784-28846148108c",
                                                "sense_id": "bcf89f9c-fa7d-30bf-bae9-fe2aac2ef374",
                                                "text": "I entitled the piece \"Dorky\", dork being slang for a person who does not belong to popular groups, usually an outsider, an odd person, sometimes inept, other times cranky."
                                            },
                                            {
                                                "example_id": "76bc6a1f-612d-46b6-9ef6-288defbf9990",
                                                "sense_id": "bcf89f9c-fa7d-30bf-bae9-fe2aac2ef374",
                                                "text": "Anyway this dorky guy asks Sallyfrass to dance and she kind of likes him..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
