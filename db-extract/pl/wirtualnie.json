                    },
                    {
                        "sense_id": "9ecd9646-87aa-3a9d-a3c7-1d0dba4ca1bb",
                        "entry_id": "012ca27b-0714-352c-b119-c1407634a593",
                        "glosses": [
                            "dopuszczając, jako możliwe, jednak mało prawdopodobne w rzeczywistości"
                        ],
                        "tags": [],
                        "examples": [],
