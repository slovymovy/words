                {
                    "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                    "sense_definition": "Completely or entirely; used to emphasize a quality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>perfectly</w> normal to feel tired after a long run.",
                            "target_lang_translations": {
                                "ru": "Это <w>совершенно</w> нормально — чувствовать усталость после долгой пробежки.",
                                "zh": "长跑后感到疲劳是<w>完全</w>正常的。"
                            }
                        },
                        {
                            "text": "She made it <w>perfectly</w> clear that she was not interested.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>совершенно</w> ясно понять, что не заинтересована.",
                                "zh": "她<w>十分</w>明确地表示她没兴趣。"
                            }
                        }
                    ],
