                    {
                        "sense_id": "ace3c62a-75d9-385b-8eb2-29f974082e0b",
                        "entry_id": "dc667566-b33f-3b91-88f1-5092f237791d",
                        "glosses": [
                            "vorübergehende/dauerhafte Beeinträchtigung der Funktion des Organs Herz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da75939f-78fb-4853-9b60-a6c0b290ddda",
                                "sense_id": "ace3c62a-75d9-385b-8eb2-29f974082e0b",
                                "text": "„Das Risiko einer belastungsinduzierten Herzschädigung durch Ausdauersport wird gegenwärtig wieder vermehrt diskutiert, da nach Ausdauerbelastungen den Grenzwert überschreitende Anstiege kardialer Marker (Herzenzyme wie Troponin, IMA und BNP) beschrieben wurden, die sonst bei Patienten nach Herzinfarkt oder bei einer Herzinsuffizienz erhöht sind.“"
                            },
                            {
                                "example_id": "63bb55eb-bd06-455f-8e4c-00803b150b57",
                                "sense_id": "ace3c62a-75d9-385b-8eb2-29f974082e0b",
                                "text": "„Forscher der Frankfurter Universität haben in einer Studie festgestellt, dass Dreiviertel der untersuchten Covid-19-Patienten Herzschädigungen aufwiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
