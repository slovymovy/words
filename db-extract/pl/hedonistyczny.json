                ],
                "translations": [
                    {
                        "translation_id": "cec4d250-7fcb-4732-9bb6-af8c2877fe64",
                        "source_entry_id": "ffb6ae27-2566-3c04-8e59-cbf93ece9d38",
                        "source_sense_id": "2b9db28b-932a-3801-8377-f23581a55766",
                        "target_lang_word": "hedonistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hedonistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3615a56-1a15-3b0f-bfa9-f4431f68a0a5",
                                        "entry_id": "93b2fe7f-bee2-32f9-ba62-cc272f53791b",
                                        "glosses": [
                                            "Devoted to pleasure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3a5b27-0a3c-44b1-a617-8f91585351a7",
                                                "sense_id": "b3615a56-1a15-3b0f-bfa9-f4431f68a0a5",
                                                "text": "Among philosophers, attention to suffering has been a casualty of a long series of attacks on hedonistic utilitarianism—the doctrine that people are morally required to maximize the total surplus of happiness over suffering."
                                            },
                                            {
                                                "example_id": "30964194-9927-4bbb-a32a-5f53cc217361",
                                                "sense_id": "b3615a56-1a15-3b0f-bfa9-f4431f68a0a5",
                                                "text": "He refers to the danger of leading our lives on a hedonistic treadmill, seeking more accomplishments and trying to get more things and more money, leading eventually to ever increasing expectations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa7a1594-600c-4fb4-a333-741260ce6f52",
                        "source_entry_id": "ffb6ae27-2566-3c04-8e59-cbf93ece9d38",
                        "source_sense_id": "2b9db28b-932a-3801-8377-f23581a55766",
                        "target_lang_word": "hédonistický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hédonistický",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "600f2aa1-561b-3092-afdf-20c8ba5bfc13",
                                        "entry_id": "dc22fa8b-56af-3a04-bf8a-018f051b4b8a",
                                        "glosses": [
                                            "vztahující se k hédonismu nebo hédonistovi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7459ade-18fa-469f-93d0-f3aa64d5d121",
                                                "sense_id": "600f2aa1-561b-3092-afdf-20c8ba5bfc13",
                                                "text": "Známý, moderní fakt - sekulární společnost se vyhýbá tématu smrti. Hédonistická společnost uhýbá před faktem smrtelnosti. Odsouvá umírání („konec“) do nemocnic a do statistik. Jakmile se smrt promění v číslo, jde s ní pracovat jinak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2226272d-a91a-4e2b-aa1e-8586132d7fb2",
                        "source_entry_id": "ffb6ae27-2566-3c04-8e59-cbf93ece9d38",
                        "source_sense_id": "2b9db28b-932a-3801-8377-f23581a55766",
                        "target_lang_word": "hédoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hédoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d28b67ce-3952-35f6-a97c-4463880f3b7e",
                                        "entry_id": "53302d89-ead7-3d5d-9a1b-f15136e381ca",
                                        "glosses": [
                                            "Relatif à l'hédonisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a41842-b10d-4d17-a094-8bc6127b5871",
                                                "sense_id": "d28b67ce-3952-35f6-a97c-4463880f3b7e",
                                                "text": "La recherche hédoniste du plaisir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hédoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                        "entry_id": "6cff6a68-0204-3281-9a38-59ba489ac6e3",
                                        "glosses": [
                                            "Personne qui recherche le plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a98f89e-9bbb-4bf0-ad2f-1d4d7ddb8ffd",
                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "C'est un hédoniste."
                                            },
                                            {
                                                "example_id": "d4d63420-3c9c-4620-b176-0fdb86277f91",
                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "C’est, nous semble-t-il, faire de Socrate soit un cynique soit un hédoniste."
                                            },
                                            {
                                                "example_id": "3423c20c-cdd9-43f5-80d6-954f76ee4937",
                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "Le succès de La Première Gorgée de bière m’a fait ranger du côté des épicuriens, voire des hédonistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdeca4af-f062-461b-be02-d63baeda2898",
                        "source_entry_id": "ffb6ae27-2566-3c04-8e59-cbf93ece9d38",
                        "source_sense_id": "2b9db28b-932a-3801-8377-f23581a55766",
                        "target_lang_word": "hédonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hédonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1468cb2e-9a91-3268-a09f-9cbba59104a5",
                                        "entry_id": "ab05a9cd-0c9d-3965-a404-8bda1bcb78fc",
                                        "glosses": [
                                            "Lié au plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bb79b15-6a23-40fe-bcf0-2d5cc1371710",
                                                "sense_id": "1468cb2e-9a91-3268-a09f-9cbba59104a5",
                                                "text": "La dimension hédonique de la consommation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59d8f10e-89f0-41e7-a408-134a10a5f19c",
                        "source_entry_id": "ffb6ae27-2566-3c04-8e59-cbf93ece9d38",
                        "source_sense_id": "2b9db28b-932a-3801-8377-f23581a55766",
                        "target_lang_word": "hedonistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hedonistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5667d588-75e0-3183-b93d-cc1465ce4cc8",
                                        "entry_id": "ba508dfe-23cb-3681-b00a-5e37cf2f5941",
                                        "glosses": [
                                            "den Hedonismus betreffend, am Hedonismus orientiert"
                                        ],
                                        "tags": [
                                            "Ethik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efa23e8-ba9e-4cf7-af7c-2544319a45e2",
                                                "sense_id": "5667d588-75e0-3183-b93d-cc1465ce4cc8",
                                                "text": "„Aristipps Schüler haben die Implikationen, das heißt die im Grundsatz schon angelegten Folgen des hedonistischen Prinzips nach verschiedenen Richtungen hin weitergedacht […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a495da8-085b-36b1-a72d-156f8a66a1e8",
                                        "entry_id": "ba508dfe-23cb-3681-b00a-5e37cf2f5941",
                                        "glosses": [
                                            "von Lust, Vergnügen und Genuss betont"
                                        ],
                                        "tags": [
                                            "general",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4476f291-9e71-43ba-816a-235cfaa3ccb9",
                                                "sense_id": "6a495da8-085b-36b1-a72d-156f8a66a1e8",
                                                "text": "„Wir haben Angst, dekadent und hedonistisch zu wirken.“"
                                            },
                                            {
                                                "example_id": "a2a68499-b4e6-48e2-be0f-f992d5e154fa",
                                                "sense_id": "6a495da8-085b-36b1-a72d-156f8a66a1e8",
                                                "text": "„Das Böse war schon in ihnen selbst. Es hatte sich schon alienmäßig fortgepflanzt und durchgefressen – kulturrevolutionär, hedonistisch und lebenskulturell, postmodern und alltagspraktisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb60d36b-29e9-43b8-96da-0565e0992ba4",
