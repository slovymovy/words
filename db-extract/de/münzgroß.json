                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd118ac6-3566-3fda-bb5a-425710895e44",
                        "entry_id": "ffc994b2-d8d3-3b80-a013-838589625f26",
                        "glosses": [
                            "so groß wie eine Münze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a21a3d9-0bd5-4dd5-952c-d0dd5d80c51e",
                                "sense_id": "fd118ac6-3566-3fda-bb5a-425710895e44",
                                "text": "„Er bewegte sie langsam und präzise, bis ihre münzgroßen Saugnäpfe an jeder von Sarys Brüsten andockten.“"
                            },
                            {
                                "example_id": "b6f0c96b-19cf-4cab-94f5-992598418520",
                                "sense_id": "fd118ac6-3566-3fda-bb5a-425710895e44",
                                "text": "„Erst als Tori ein münzgroßes Loch in die Wand schlug, wurde ihr klar, womit sie ihre Wohnung teilte.“"
                            },
                            {
                                "example_id": "663fdb5b-99a9-4cd0-835f-2ba720a62410",
                                "sense_id": "fd118ac6-3566-3fda-bb5a-425710895e44",
                                "text": "„Er zog eine münzgroße Scheibe aus Knochen mit einer eingravierten Eule hervor und warf sie ins Feuer.“"
                            },
                            {
                                "example_id": "8fd86af5-22fd-4e09-ad3e-1be9e5450440",
                                "sense_id": "fd118ac6-3566-3fda-bb5a-425710895e44",
                                "text": "„Der zweite Treffer hatte das münzgroße Einschlagloch um etwa 50 Prozent vergrößert.“"
                            },
                            {
