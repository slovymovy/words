    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8dd77bc-209a-3ca3-9101-d0337573d3a8",
                    "sense_definition": "The present participle and gerund of <w>sail</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>sailing</w> to the island tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Завтра утром мы <w>плывем под парусом</w> на остров.",
                                "tr": "Yarın sabah adaya <w>yelken açıyoruz</w>.",
                                "zh": "我们明天早上要<w>航行</w>去那个岛。"
                            }
                        },
                        {
                            "text": "The boat was <w>sailing</w> smoothly across the calm water.",
                            "target_lang_translations": {
                                "ru": "Лодка плавно <w>шла</w> по спокойной воде.",
                                "tr": "Tekne durgun suda sorunsuzca <w>ilerliyordu</w>.",
                                "zh": "船只在平静的水面上平稳地<w>航行</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола sail (плыть под парусом).",
                        "tr": "\"Sail\" (yelken açmak / seyretmek) fiilinin şimdiki zaman sıfat-fiili ve isim-fiili.",
                        "zh": "动词 sail 的现在分词和动名词形式，指驾驶帆船或在水上航行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плыть под парусом",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "идти под парусом",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yelken açma",
                                "target_lang_sense_clarification": "eylem"
                            },
                            {
                                "target_lang_word": "yelken açarak",
                                "target_lang_sense_clarification": "durum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航行",
                                "target_lang_sense_clarification": "指船只在水上移动"
                            },
                            {
                                "target_lang_word": "驾驶帆船",
                                "target_lang_sense_clarification": "指操作帆船的动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13c59e6a-3697-3bfe-ad0d-73f42513c025",
                    "sense_definition": "The sport or activity of traveling across water in a boat powered by the wind.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loves <w>sailing</w> and spends every weekend on the lake.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>парусный спорт</w> и проводит каждые выходные на озере.",
                                "tr": "<w>Yelkenciliği</w> çok seviyor ve her hafta sonunu gölde geçiriyor.",
                                "zh": "他热爱<w>帆船运动</w>，每个周末都在湖上度过。"
                            }
                        },
                        {
                            "text": "We decided to go <w>sailing</w> despite the cloudy weather.",
                            "target_lang_translations": {
                                "ru": "Мы решили отправиться в <w>плавание под парусом</w>, несмотря на облачную погоду.",
                                "tr": "Bulutlu havaya rağmen <w>yelken seyrine</w> çıkmaya karar verdik.",
                                "zh": "尽管天气阴沉，我们还是决定去<w>航海</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yachting",
                        "boating"
                    ],
                    "common_phrases": [
                        "go sailing",
                        "sailing club",
                        "sailing instructor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спорт или занятие, заключающееся в путешествии по воде на лодке, приводимой в движение ветром.",
                        "tr": "Rüzgar gücüyle çalışan bir tekneyle suda seyahat etme sporu veya faaliyeti.",
                        "zh": "利用风力驱动船只在水上旅行的运动或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парусный спорт",
                                "target_lang_sense_clarification": "вид спорта"
                            },
                            {
                                "target_lang_word": "плавание под парусом",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "яхтинг",
                                "target_lang_sense_clarification": "современный термин"
                            }
                        ],
                        "tr": [
