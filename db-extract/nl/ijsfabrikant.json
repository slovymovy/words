                        "examples": [
                            {
                                "example_id": "f0e10827-a33c-4c50-bb27-058aed009ace",
                                "sense_id": "8a368b21-fd12-3f5c-bfa0-aee0a92b8f00",
                                "text": "Iedereen kan online bekijken hoe de Israëlische minister van Economische Zaken haar Ben & Jerry's uit de vriezer haalt en in de prullenbak mikt. Als de ijsfabrikant geen ijs meer wil verkopen in Joodse nederzettingen op de bezette Westelijke Jordaanoever en in Oost-Jeruzalem, dan komt het er bij haar ook niet meer in, zo maakt de bewindsvrouw in de door haar geposte video glashelder."
                            },
                            {
                                "example_id": "e58340c8-ff80-4d1a-867e-15080d1355cc",
                                "sense_id": "8a368b21-fd12-3f5c-bfa0-aee0a92b8f00",
                                "text": "De ijsfabrikant roept Facebook op harder op te treden tegen het zaaien van verdeeldheid, het aanwakkeren van racisme en geweld en ondermijning van de democratie."
                            }
                        ]
                    }
