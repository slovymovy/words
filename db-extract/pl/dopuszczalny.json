                                        "sense_id": "5e599d8e-2357-36ec-a6af-13cd698052ab",
                                        "entry_id": "aab042bf-6f52-36b3-89d5-2461d367e17e",
                                        "glosses": [
                                            "nicht gegen eine Regel verstoßend; explizit erlaubt, gestattet oder auch nur tragbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afae8b86-92c5-4ea0-9916-205409df7508",
                                                "sense_id": "5e599d8e-2357-36ec-a6af-13cd698052ab",
                                                "text": "Diese Maßnahme ist nicht zulässig."
                                            },
                                            {
                                                "example_id": "e20dc294-44b2-456e-8ccf-f224c954c673",
                                                "sense_id": "5e599d8e-2357-36ec-a6af-13cd698052ab",
                                                "text": "Passen Sie auf, dass sie mit all den Bücherkisten nicht das zulässige Gesamtgewicht des Anhängers überschreiten."
                                            },
                                            {
                                                "example_id": "5f3f4cbe-80df-4094-8a30-655546b8f699",
                                                "sense_id": "5e599d8e-2357-36ec-a6af-13cd698052ab",
                                                "text": "Das scheint mir durchaus eine zulässige Frage zu sein, aber ich kann sie aus dem Stegreif nicht beantworten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
