                    },
                    {
                        "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                        "entry_id": "7f575c1c-7a17-3c35-ba17-59068de0bfca",
                        "glosses": [
                            "Some unspecified time in the future."
                        ],
                        "tags": [
                            "humorous",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad0f79d4-d3ca-4ded-89bb-0b68e79e1e05",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "The plumber said he would come tomorrow. But I think he will probably be here mañana."
                            },
                            {
                                "example_id": "0d51abf4-1a1a-4036-a01a-111fb701be20",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "The answer was always a harassed smile and a promise that there should be machine-gun instruction mañana. Needless to say mañana never came."
                            },
                            {
                                "example_id": "68ca892e-5bef-484b-bdfb-0ec3e6eebd38",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "He swore he was coming to New York to join me. I pictured him in New York, putting off everything till manana."
                            },
                            {
                                "example_id": "4cf0bbda-71ff-4489-8e80-bac9989dc080",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "Oh, my sweet Diana, I can't wait for the manana / There's a hotel down in Mexico just made for two"
                            },
                            {
                                "example_id": "64f64f91-d8be-4d7e-be82-52099671c1b0",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "When doing business, they [linear-actives] are keen on punctual performance, quality, and reliable delivery dates. Mañana behavior and overloquacity are frowned upon."
                            },
                            {
                                "example_id": "64b80afd-6cee-47db-888e-1ffb60f72426",
                                "sense_id": "63f00bab-1652-3b4e-8b10-fd9322ee2b97",
                                "text": "“[With]^([sic]) the Greek government it is every time ‘mañana’,” said Lithuania’s president, Dalia Grybauskaitė, one of the Greek government’s harshest critics. “It can always be ‘mañana’ every day.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b330fffe-eb99-446d-bb3a-72f8b0b3588a",
                        "source_entry_id": "7f575c1c-7a17-3c35-ba17-59068de0bfca",
                        "source_sense_description": "some time in the future",
                        "target_lang_word": "ooit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
