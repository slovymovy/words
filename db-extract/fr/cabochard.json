                            "feminine"
                        ],
                        "form": "cabocharde"
                    },
                    {
                        "form_id": "2793c371-bbcc-40b8-9459-8a2546c527c6",
                        "entry_id": "5c944658-4007-3455-9da2-16af45c8e3e0",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "cabochardes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f4fa215-2af5-3a55-9472-459159a77613",
                        "entry_id": "5c944658-4007-3455-9da2-16af45c8e3e0",
                        "glosses": [
                            "Qui a mauvaise tête, en parlant d’un animal, généralement un cheval, un chien ou un âne qui a du mal à obéir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5b62ef60-530b-4e69-97fb-4e785899e7bd",
                                "sense_id": "0f4fa215-2af5-3a55-9472-459159a77613",
                                "text": "Malgré son trench-coat vert bouteille, son chapeau avachi et sa tête de cheval cabochard, il avait l'air d'un instituteur en balade avec les premiers de sa classe."
                            }
                        ]
                    },
                    {
                        "sense_id": "28e1555b-fb51-3700-8505-8d75a59a0a4b",
                        "entry_id": "5c944658-4007-3455-9da2-16af45c8e3e0",
                        "glosses": [
                            "Têtu, qui n’en fait qu’à sa tête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "aa7bd884-d85c-4269-9482-1ffc907b71d7",
                                "sense_id": "28e1555b-fb51-3700-8505-8d75a59a0a4b",
                                "text": "Quatre filles telles que nous, c’est donc si difficile à caser, à planter solidement quelque part ?… Ni méchantes, ni bêtes, ni laides, un peu cabochardes seulement…"
                            },
                            {
                                "example_id": "690fe4c5-f56b-402a-8efe-c8689a0d5277",
                                "sense_id": "28e1555b-fb51-3700-8505-8d75a59a0a4b",
                                "text": "Et Simon songeait même, malignement, à la surprise de l’adjudant Pommier, si lui, le cabochard, la brebis galeuse, se trouvait, au terme du trimestre, à la tête de la 1ʳᵉ section, élite d’une trentaine d’élèves qui dirigeaient en ce moment des yeux intéressés vers l’estrade."
                            }
                        ]
                    }
                ],
