                ],
                "senses": [
                    {
                        "sense_id": "5ab6cdd0-23c1-3285-92ca-acbede847392",
                        "entry_id": "8b6612d6-5fcd-38ab-ad41-d9dfbc835cfe",
                        "glosses": [
                            "Qui ne peut être paré ou contredit ; à quoi on ne peut rien opposer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a831bf94-4824-4ab9-b676-7160c9441f16",
                                "sense_id": "5ab6cdd0-23c1-3285-92ca-acbede847392",
                                "text": "[…] d’où il résulte que la riposte, qui demande une entière fermeté sur les jambes, pour être vive, devient absolument imparable."
                            },
                            {
                                "example_id": "56800541-944a-44f4-893f-f78953745364",
                                "sense_id": "5ab6cdd0-23c1-3285-92ca-acbede847392",
                                "text": "Il tenta un passing-shot pour contrer Tyler qui était monté au filet, mais il était arrivé trop tard pour contrôler parfaitement son coup. La volée de Tyler fut aussi brutale qu’imparable et laissa son adversaire sur place."
                            },
                            {
                                "example_id": "461558cb-b4d5-4714-8a3d-86929134509c",
                                "sense_id": "5ab6cdd0-23c1-3285-92ca-acbede847392",
                                "text": "Aucun nouveau réacteur n’a été construit depuis les années 1990. Ou si peu, quand on voit les difficultés d’amener le chantier de Flamanville à son terme. D’où cet argument imparable des équipes d’EDF : pour ne pas perdre la main, il faut en construire plus souvent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39001550-bc42-45cc-b543-ab0cd418720b",
                        "source_entry_id": "8b6612d6-5fcd-38ab-ad41-d9dfbc835cfe",
                        "source_sense_id": "5ab6cdd0-23c1-3285-92ca-acbede847392",
                        "target_lang_word": "unbeatable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                                        "entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
                                        "glosses": [
                                            "That cannot be beaten, defeated or overcome"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168edcf8-afc0-4171-9620-528154aa1f85",
                                                "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                                                "text": "Deep-set and steady, with eyelashes that many a woman had envied, they showed the man for what he was—a sportsman and a gentleman. And the combination of the two is an unbeatable production."
                                            },
                                            {
                                                "example_id": "6bc6bb75-5ad6-4861-8728-8d9853e2b123",
                                                "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                                                "text": "Lauren James was exceptional out wide, Millie Bright unbeatable in defence and Lucy Bronze tireless in dealing with Spain forward Salma Paralluelo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unbeatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea91e70f-8693-3ed6-a714-196db1e46fc2",
