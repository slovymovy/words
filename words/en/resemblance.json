{
    "word_family": [
        "resemble"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "011ade25-188d-37d7-b95b-5bbdd260d3c5",
                    "sense_definition": "The quality or state of being similar to someone or something else.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a striking <w>resemblance</w> between the two brothers.",
                            "target_lang_translations": {
                                "ru": "Между двумя братьями существует поразительное <w>схо́дство</w>."
                            }
                        },
                        {
                            "text": "The portrait bears a strong <w>resemblance</w> to the original subject.",
                            "target_lang_translations": {
                                "ru": "Портрет имеет сильное <w>схо́дство</w> с оригиналом."
                            }
                        }
                    ],
                    "synonyms": [
                        "similarity",
                        "likeness"
                    ],
                    "common_phrases": [
                        "bear a resemblance",
                        "striking resemblance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние сходства с кем-либо или чем-либо другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схо́дство",
                                "target_lang_sense_clarification": "наличие общих черт или подобие между объектами"
                            },
                            {
                                "target_lang_word": "подо́бие",
                                "target_lang_sense_clarification": "внешнее сходство или соответствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83109175-ed1e-32b5-9bd3-208ef9e7f0d1",
                    "sense_definition": "A representation or image that looks like something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue is a perfect <w>resemblance</w> of the famous leader.",
                            "target_lang_translations": {
                                "ru": "Статуя является идеальным <w>подо́бием</w> знаменитого лидера."
                            }
                        },
                        {
                            "text": "He kept a small <w>resemblance</w> of his childhood home in his pocket.",
                            "target_lang_translations": {
                                "ru": "Он хранил в кармане маленькое <w>напомина́ние</w> о своем доме детства."
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение или предмет, который выглядит как что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображе́ние",
                                "target_lang_sense_clarification": "визуальное представление объекта"
                            },
                            {
                                "target_lang_word": "ко́пия",
                                "target_lang_sense_clarification": "предмет, точно воспроизводящий оригинал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88681394-4db3-3509-a71f-f3edd91d6206",
                    "sense_definition": "A comparison or a statement that highlights similarities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet drew a <w>resemblance</w> between the falling leaves and fading memories.",
                            "target_lang_translations": {
                                "ru": "Поэт провел <w>сравне́ние</w> между опадающими листьями и угасающими воспоминаниями."
                            }
                        },
                        {
                            "text": "His speech relied on a clever <w>resemblance</w> to illustrate the complex problem.",
                            "target_lang_translations": {
                                "ru": "Его речь опиралась на остроумное <w>сравне́ние</w>, чтобы проиллюстрировать сложную проблему."
                            }
                        }
                    ],
                    "synonyms": [
                        "similitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнение или утверждение, подчеркивающее сходство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравне́ние",
                                "target_lang_sense_clarification": "сопоставление двух явлений для выявления общего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ae1c7ee-c3dd-3a63-b320-c21a1757f39d",
                    "sense_definition": "The appearance of being true or real.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The story lacked any <w>resemblance</w> of truth or logic.",
                            "target_lang_translations": {
                                "ru": "В этой истории не было ни малейшего <w>правдоподо́бия</w> или логики."
                            }
                        },
                        {
                            "text": "His argument had a faint <w>resemblance</w> to reality despite the errors.",
                            "target_lang_translations": {
                                "ru": "Его аргумент имел отдаленное <w>схо́дство</w> с реальностью, несмотря на ошибки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимость правдивости или реальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдоподо́бие",
                                "target_lang_sense_clarification": "внешнее сходство с истиной"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}