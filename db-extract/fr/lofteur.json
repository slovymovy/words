                        "glosses": [
                            "Acteur de la Loft Story."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80dc80d5-0c7b-463e-a6f2-c335fcaae9c1",
                                "sense_id": "0200f771-1820-3736-a693-0d01a6491167",
                                "text": "Une entrevue «exclusive» avec un lofteur évincé est présentée au Grand Journal de TQS."
                            },
                            {
                                "example_id": "c9dd9128-7d34-4dc8-a118-d6f2aceeebb2",
                                "sense_id": "0200f771-1820-3736-a693-0d01a6491167",
                                "text": "Progressivement mis en confiance, les staracadémiciens, les lofteurs et autres participants du voyeurisme de masse finissaient par divulguer face caméra, des éléments personnels de leur vécu. Les débordements se faisaient rarement attendre."
                            },
                            {
                                "example_id": "626e46b7-3e7f-463b-b27d-84712b90f35b",
                                "sense_id": "0200f771-1820-3736-a693-0d01a6491167",
                                "text": "On a dit Sarko, mais cela aurait pu tout aussi bien être Paris Hilton ou, chez nous, les faiseux de recettes, lofteurs et autre pléthore d'histrions qui dispensent leurs avis émotifs, polémistes et souvent démagogiques contribuant ainsi à vider de son sens le débat public."
                            }
                        ]
                    }
