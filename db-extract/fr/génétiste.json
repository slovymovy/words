            {
                "entry_id": "bcd8cefd-adb9-36fb-9ce0-e8d8bd74b283",
                "word": "génétiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d02cd860-da7b-4d66-804b-db26e5d74ef6",
