                        "examples": [
                            {
                                "example_id": "3cc0a5c6-c657-4f0e-8db1-288ad4f3fcce",
                                "sense_id": "f063a773-132a-3dbf-a6da-0856c255a72f",
                                "text": "„Der Geruch des Taxis erinnert mich an eine Mischung aus Kneipe, Schuhputzmittel und Restaurant.“"
                            },
                            {
                                "example_id": "d049fd09-8355-4ace-8038-97ff91171943",
                                "sense_id": "f063a773-132a-3dbf-a6da-0856c255a72f",
                                "text": "„Die Färbemittel enthalten oft giftige Farben, auch durch Schuhputzmittel sind schon Vergiftungen durch Anilin, Nitrobenzol usw.“"
                            },
                            {
                                "example_id": "c6c5ff65-7311-4c5b-a7cc-b94a049eb44a",
                                "sense_id": "f063a773-132a-3dbf-a6da-0856c255a72f",
                                "text": "„Harvey zaubert noch etwas Schuhputzmittel aus der Packtasche und wienert seine bereits geputzten Stiefel nochmal auf Hochglanz.“"
                            }
                        ],
