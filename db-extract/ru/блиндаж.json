                                "target_senses": [
                                    {
                                        "sense_id": "6592047e-5616-3508-9639-7459f59848b2",
                                        "entry_id": "ee213538-5a93-3a5a-8a3a-401edccddbcc",
                                        "glosses": [
                                            "überdachter Raum, in dem man oder etwas gegen unerwünschte Einwirkungen oder Beobachtung, Bemerktwerden von außen geschützt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007d064c-172f-40cc-957f-d7ea77777e9b",
                                                "sense_id": "6592047e-5616-3508-9639-7459f59848b2",
                                                "text": "Als Unterstand bauten sie einen Carport."
                                            },
                                            {
                                                "example_id": "35449d9c-7fe2-4c97-9929-858f1992e6a3",
                                                "sense_id": "6592047e-5616-3508-9639-7459f59848b2",
                                                "text": "„Er holte seinen Wagen aus dem Unterstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8a1b5c0-ba90-34ec-a986-f0ca99a7663c",
                                        "entry_id": "ee213538-5a93-3a5a-8a3a-401edccddbcc",
                                        "glosses": [
                                            "Stelle, wo man sich unterstellen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6df642d7-f901-43b0-9419-dfdda4b61550",
                                                "sense_id": "f8a1b5c0-ba90-34ec-a986-f0ca99a7663c",
                                                "text": "Bei Regen kann ein Baum als Unterstand dienen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                        "entry_id": "ee213538-5a93-3a5a-8a3a-401edccddbcc",
                                        "glosses": [
                                            "besonders gesicherter, oft unterirdischer Schutzraum für Soldaten oder Waffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb48dd41-447b-43b3-897e-6cb84a2f2ecb",
                                                "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                                "text": "Sie übernachteten in einem Unterstand."
                                            },
                                            {
                                                "example_id": "1778888a-f7fb-4694-983e-09bc31d58146",
                                                "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                                "text": "„Nach dem nächsten Einschlag laufen zwei Mann mit den Gemüsetöpfen los, die fünfzig Meter bis zum Unterstand.“"
                                            },
                                            {
                                                "example_id": "082e8222-15c3-45f7-b35a-e3bdc184d432",
                                                "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                                "text": "„Wir stürzen in den Gang, der vom Unterstand seitlich in den Berg sich gräbt.“"
                                            },
                                            {
                                                "example_id": "20244d2d-577a-4289-9351-0108de6f351f",
                                                "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                                "text": "„Da unser Unterstand den Graben völlig versperrte, bauten wir einen Umgehungsgraben, in dem nun der Verkehr ging.“"
                                            },
                                            {
                                                "example_id": "083e11f5-b925-45d1-9d46-e81b0b7c286a",
                                                "sense_id": "2493652f-953c-39e9-ae30-c39629358148",
                                                "text": "„Fünf Minuten später kam Denissow in den Unterstand, legte sich mit seinen schmutzigen Stiefeln aufs Bett, tat wütend ein paar Züge aus seiner Pfeife, warf alle seine Sachen durcheinander, hing sich Kosakenpeitsche und Säbel um und wollte hinausgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc678e4-096e-40c9-af28-87ecfe6afaa9",
                        "source_entry_id": "079a0b13-c1c2-3d24-a8f5-819d22ee2dd3",
                        "source_sense_id": "9975452b-aeae-32dc-914b-f59ee2c69bc7",
                        "target_lang_word": "Bunker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bunker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "bombensicherer/volltreffersicherer Unterstand für Menschen und Kriegsgerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2367ae81-9db6-4713-bc81-61fb9b09ac3a",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Neben mir sehe ich ein dunkles Loch, eine hinabführende Treppe mit anschließendem Bunker. Schwarz, feucht und jedenfalls verlaust Platz für drei Mann nur. Die Sanitäter, die darin liegen, wollen mich nicht hineinlassen.“"
                                            },
                                            {
                                                "example_id": "c0f5aeca-6a08-4319-bcea-bbb1da26dcf4",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Im Bunker lauerten wir meistens an der Tür herum.“"
                                            },
                                            {
                                                "example_id": "f3fd5fca-3809-4e63-9afa-9aa0f755a9c8",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Er hatte im Bunker schon ganz anders schreien gehört.“"
                                            },
                                            {
                                                "example_id": "9e26e34d-c66f-4b5f-903c-f530fa5583a6",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Vor allem wohl, weil für den langen Weg hin und zurück zuviel Arbeitszeit verloren ging, hatte die Werksleitung begonnen, auf dem Fabrikgelände einen eigenen Bunker zu bauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51ce3784-95aa-3e71-bc3f-5fc518d64a0a",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "Gefängnis"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950c98c4-d6e5-4077-a4bb-eff68dc55d36",
                                                "sense_id": "51ce3784-95aa-3e71-bc3f-5fc518d64a0a",
                                                "text": "Oh, shit, sitzt er jetzt im Bunker?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "Behälter oder Lagerraum, meist als längerfristiges Zwischenlager gedacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ead6ae-d910-4c63-871a-2a9194690d04",
                                                "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                                "text": "Bunker ist in verschiedensten Zusammenhängen ein Typ von Lager, zum Beispiel in der Schifffahrt und im Bergbau."
                                            },
                                            {
                                                "example_id": "c6ed8d4f-9fda-41eb-b131-0f7812b6f716",
                                                "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                                "text": "Oh, in meinem privaten Bunker gibt es so einiges, Obstkonserven, Spaghetti und die eine oder andere Flasche Whiskey."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8bd72dc1-be3e-3584-9f76-242d22c7a8ad",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "mit Sand gefüllte Vertiefung auf einer Spielbahn, absichtlich platziertes Hindernis"
                                        ],
                                        "tags": [
                                            "Golfsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f426ae-de1c-4fba-81e6-624662cf6bdf",
                                                "sense_id": "8bd72dc1-be3e-3584-9f76-242d22c7a8ad",
                                                "text": "Mit einem präzisen Schlag aus dem Bunker, der direkt neben der Fahne landete, konnte er das Par retten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
