                        "glosses": [
                            "Eigenschaft/Handlung, die schwer oder gar nicht zu berechnende (imponderable) Momente aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "338a183d-5fe2-436b-ad31-b6b98c3882b6",
                                "sense_id": "3d36687b-76b5-38a0-8e46-1164e6e1c1cc",
                                "text": "„Sexualität, Liebe, Erotik könnten stattdessen in all ihrer Bizarrheit, Doppelbödigkeit und Imponderabilität thematisiert werden.“"
                            },
                            {
                                "example_id": "426279e6-50a1-4e27-80b6-4376d4c99302",
                                "sense_id": "3d36687b-76b5-38a0-8e46-1164e6e1c1cc",
                                "text": "Man kann sich eben nicht gegen alle Imponderabilitäten feien."
                            }
                        ],
