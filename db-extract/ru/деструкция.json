                    },
                    {
                        "translation_id": "c435fcee-435d-4dcb-b4f2-143dad6ec360",
                        "source_entry_id": "d4cb9f2d-7aa4-3785-9e9a-b66d1ba019f6",
                        "source_sense_id": "3af2f622-7e62-326e-a8b9-c88c37efcbf8",
                        "target_lang_word": "Destruktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Destruktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "417b0278-307c-3efa-95bc-a110001e5206",
                                        "entry_id": "f4457782-3eb7-331e-a071-5ecf398b173e",
                                        "glosses": [
                                            "Beschädigung, die etwas unbrauchbar und/oder unbenutzbar macht"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f61e76-ae2a-4a7a-816f-50ffd5a278d6",
                                                "sense_id": "417b0278-307c-3efa-95bc-a110001e5206",
                                                "text": "Der Sprengmeister ist mit der Destruktion von Gebäuden beschäftigt, die den heutigen Standards nicht mehr entsprechen, oder anderen Bauvorhaben weichen müssen, und muss dabei größte Sorgfalt walten lassen."
                                            },
                                            {
                                                "example_id": "2a3a8599-3618-45fb-9478-562431ad5228",
                                                "sense_id": "417b0278-307c-3efa-95bc-a110001e5206",
                                                "text": "Die Ausbeutung natürlicher Ressourcen wird über kurz oder lang zu einer Destruktion des Ökosystems führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68a07ef2-e73a-3594-a0c8-290319289b34",
                                        "entry_id": "f4457782-3eb7-331e-a071-5ecf398b173e",
                                        "glosses": [
                                            "Vorgang, etwas zunichtezumachen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "formal"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "765aa7c3-d15c-3b2f-a6ba-5eae264a6ac1",
                                        "entry_id": "f4457782-3eb7-331e-a071-5ecf398b173e",
                                        "glosses": [
                                            "Abtragung durch Verwitterung"
                                        ],
                                        "tags": [],
