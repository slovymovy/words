                                    },
                                    {
                                        "sense_id": "8bb23f8d-0eed-3234-94a4-0247ecf90c2c",
                                        "entry_id": "5a85fe63-3339-30c0-8680-162221667bd7",
                                        "glosses": [
                                            "Acte ou fait ayant pour conséquence d’incorporer un bien au domaine public."
                                        ],
