                ],
                "senses": [
                    {
                        "sense_id": "1dc23d6d-9875-3a45-ae6f-d367d3787727",
                        "entry_id": "318dbc00-9ab9-3a4e-9042-c9412620fa9f",
                        "glosses": [
                            "Action d’embraser, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb537cf-68a3-4c11-b419-260626f748cb",
                                "sense_id": "1dc23d6d-9875-3a45-ae6f-d367d3787727",
                                "text": "La première supposition est conforme à l'ancienne tradition des Grecs, qui croyaient que l’embrasement d'une forêt décela le fer au sommet du mont Ida, en Crète."
                            },
                            {
                                "example_id": "610bc7dd-743c-4493-9828-2b4a6a07e352",
                                "sense_id": "1dc23d6d-9875-3a45-ae6f-d367d3787727",
                                "text": "Par ailleurs, même si un tel embrasement devait se produire, le problème du renversement du pouvoir bourgeois resterait entier."
                            },
                            {
                                "example_id": "6a3e8c30-5e8e-4e90-879e-9ab7e68e9097",
                                "sense_id": "1dc23d6d-9875-3a45-ae6f-d367d3787727",
                                "text": "— L’embrasement du Moyen-Orient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "879dbfff-b3b7-4096-a2fb-a320e3bceea2",
                        "source_entry_id": "318dbc00-9ab9-3a4e-9042-c9412620fa9f",
                        "source_sense_id": "1dc23d6d-9875-3a45-ae6f-d367d3787727",
                        "target_lang_word": "lighting",
