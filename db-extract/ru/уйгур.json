                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6573e156-4025-4925-bbb3-e3bcc6a3cf64",
                        "source_entry_id": "40eec60d-11e6-373e-bc37-ae2822628956",
                        "source_sense_id": "8ddc6a51-6bd5-3bea-82e1-3a3f5889f72c",
                        "target_lang_word": "ouïghour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouïghour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4091d73-946f-3c9d-b491-3b268ca0f92f",
                                        "entry_id": "22e07c55-f1fb-390c-9c97-5a8a2c79ab81",
                                        "glosses": [
                                            "Qui concerne la langue nommée ouïghour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9b73ac9-7e79-3a6a-977c-c0b32cbc4e45",
                                        "entry_id": "22e07c55-f1fb-390c-9c97-5a8a2c79ab81",
                                        "glosses": [
                                            "Qui concerne le peuple des Ouïghours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0534a0e0-8b6a-45c6-b0f9-d6ba0ff446a1",
                                                "sense_id": "e9b73ac9-7e79-3a6a-977c-c0b32cbc4e45",
                                                "text": "Plus de la moitié de la cité traditionnelle ouïghoure — la minorité turcophone musulmane de la province — a déjà été rasée."
                                            },
                                            {
                                                "example_id": "b7a27d6d-2ff4-467f-b17d-1e71b95aab4d",
                                                "sense_id": "e9b73ac9-7e79-3a6a-977c-c0b32cbc4e45",
                                                "text": "Aujourd’hui, il est impossible d’ignorer le génocide de la minorité musulmane ouïghour par le gouvernement chinois."
                                            },
                                            {
                                                "example_id": "a2ed2517-e9bc-421e-bb65-fc5f13baddba",
                                                "sense_id": "e9b73ac9-7e79-3a6a-977c-c0b32cbc4e45",
                                                "text": "Même chose, encore une fois, en Chine, à propos des accusations occidentales au sujet d'un génocide ouïghour, que le gouvernement de Xi Jinping nie fermement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouïghour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d39a297-7d7d-35f9-bf75-0cfa67db2818",
                                        "entry_id": "06648dbb-1777-3557-959f-56aef13a014b",
                                        "glosses": [
                                            "Langue de la famille turque parlée en Asie Centrale et au Kazakhstan par environ 9 millions de locuteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34220130-8661-47d8-8f98-6dd24d50287b",
                                                "sense_id": "5d39a297-7d7d-35f9-bf75-0cfa67db2818",
                                                "text": "Il aurait subi de grandes influences de la langue tujue, de l’ouïghour, plus tardivement du chinois, de l’arabe, et enfin de l’anglais et du russe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
