                                "target_senses": [
                                    {
                                        "sense_id": "3d96fb32-a498-3bf7-ae2d-210642bb9f41",
                                        "entry_id": "9eb6b0ab-934c-3435-a3f2-f4bc1c01780b",
                                        "glosses": [
                                            "monatliche Blutung der Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377c5d37-32a3-46f8-a253-2e62418c21c6",
                                                "sense_id": "3d96fb32-a498-3bf7-ae2d-210642bb9f41",
                                                "text": "Die Frau hatte vor einer Woche ihre Menstruation."
                                            },
                                            {
                                                "example_id": "971d3738-2e33-4f77-9f29-033d7cf3821a",
                                                "sense_id": "3d96fb32-a498-3bf7-ae2d-210642bb9f41",
                                                "text": "„Keine sah älter als dreizehn aus, aber wie es ihr Schicksal wollte, hatten sie ihre erste Menstruation gehabt – die bei Mädchen im Busch angeblich früher einsetzt – und waren deshalb für die Zeremonie ausgewählt worden.\""
                                            },
                                            {
                                                "example_id": "2fa6e8a2-ae8a-4330-af78-139a8e8fceb2",
                                                "sense_id": "3d96fb32-a498-3bf7-ae2d-210642bb9f41",
                                                "text": "„In dem Moment erhielt sie eine verzweifelte SMS ihrer älteren Tochter, die zum ersten Mal ihre Menstruation bekommen hatte und sich ängstlich und bekümmert meldete, obwohl sie eigentlich wusste, was da eingetreten war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29dd8ed8-41f3-4eda-8035-da42116f64c8",
                        "source_entry_id": "aa0010fd-55d7-38a3-ad98-4de05e72b18e",
                        "source_sense_id": "8d46ea2a-b0da-39b1-ac6c-518e01a310e0",
                        "source_sense_description": "maandelijkse bloeding bij vrouwen en geslachtsrijpe meisjes",
