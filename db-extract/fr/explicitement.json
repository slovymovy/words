        "fr-extract.jsonl": [
            {
                "entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                "word": "explicitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                        "entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                        "glosses": [
                            "D’une manière explicite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ac3333-5288-47ba-9e6c-7ade0d536e85",
                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                "text": "Les points de foi qu’il faut croire explicitement pour être sauvé."
                            },
                            {
                                "example_id": "4c1c34f1-2d9d-4ca2-bde5-3ab551b14f8f",
                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                "text": "Les successeurs de Descartes nient l’efficace des causes secondes ; Descartes en partie la nie et en partie l’accorde. Il l’accorde explicitement, mais implicitement il la nie."
                            },
                            {
                                "example_id": "c116e08f-98fc-44f1-a113-0adcfd52e7eb",
                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                "text": "Quelques jours plus tard, les médias relaient la mort d’un autre jeune missionnaire, le protestant John Allen Chau, qui s’est acharné à se rendre une bible à la main sur l’île North Sentiment de l’archipel Andaman, dans l’océan Indien, dont les habitants rejettent explicitement tout contact avec le monde extérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d20cd3f-9f89-4018-845f-557cd8b26eb3",
                        "source_entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                        "source_sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                        "target_lang_word": "explicitly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicitly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                        "entry_id": "affb9cac-0619-38df-a2f4-206c8ed896a0",
                                        "glosses": [
                                            "In an explicit manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c506f583-18da-4dae-b92a-bdde5f1f9dab",
                                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                                "text": "The fifth amendment to the United States constitution provides explicitly for the protection of private property."
                                            },
                                            {
                                                "example_id": "44c3c3c5-429b-4639-a616-fcc30e068e7a",
                                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                                "text": "Descartes's methodism with its regulative criterion leads him to explicitly deny that accidentally true belief qualifies as knowledge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c02d49fc-50ea-4736-b6e6-8d776872e4f8",
                        "source_entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                        "source_sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                        "target_lang_word": "unambiguously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unambiguously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                        "entry_id": "caee5e1a-b368-3da5-8834-eb03dfe56f36",
                                        "glosses": [
                                            "In a manner that is not ambiguous; leaving no doubt; clearly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db344b50-f643-48b8-b4e6-899928dcecf0",
                                                "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                                "text": "She told him unambiguously to leave, yet he failed to leave."
                                            },
                                            {
                                                "example_id": "d29594e3-6005-483c-a3e2-cbf1cabc796c",
                                                "sense_id": "6fdc5d28-4915-3fd7-a499-25ea92392ded",
                                                "text": "The break with tradition that Francis, who has died aged 88 after suffering from double pneumonia, represented even managed to trump the shock value of the resignation of Benedict, who was the first pope for 600 years to take that option rather than die in office. Immediately, Bergoglio signalled unambiguously that he intended to be a different kind of pope, one for the 21st century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7066a228-c6c0-4eef-9744-1563147c8dc7",
                        "source_entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                        "source_sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                        "target_lang_word": "unequivocally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unequivocally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                        "entry_id": "dff512b6-20c5-3a47-a736-0fce82a8b63f",
                                        "glosses": [
                                            "In a way that leaves no doubt; in an unequivocal or unambiguous manner, unquestionably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91553daf-def3-4819-88b9-eb8c21af4d0c",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "They strove to make their product unequivocally the best in the industry."
                                            },
                                            {
                                                "example_id": "0b354b68-5bbb-4321-a36f-5775e32df931",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "'Surely, in hindsight, you realise she was an unsuitable wife for you,' he stated unequivocally.\n'Don't go there, Dad,' Luc warned, hard ruthless steel in his own eyes. 'You've lost one son. You're very close to losing another.'"
                                            },
                                            {
                                                "example_id": "b96527f6-c8b1-4e22-b98d-31c92c34fea8",
                                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                                "text": "The millettioid group involves the unequivocally sustained millettioid and phaseoloid clades including numerous vital crop species, for example, the cultivated soybean […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebf558e8-d24a-4870-b4ea-a7333c6db929",
                        "source_entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                        "source_sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
