                "senses": [
                    {
                        "sense_id": "44d385a6-171b-346f-912a-7b8758198a43",
                        "entry_id": "31deab22-bdf0-38f1-921b-e09e035e79f2",
                        "glosses": [
                            "Ancienne graphie de Liège, antérieure à 1945."
                        ],
                        "tags": [
                            "archaic",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5f708417-db56-4a6a-96ef-6c4fde226b0c",
                                "sense_id": "44d385a6-171b-346f-912a-7b8758198a43",
                                "text": "Trois verreries existent dans la province de Liége, une à Liége même, une dans la commune de Chênée, et la troisième est établie depuis quatre ans dans l'ancienne abbaye de Val Sᵗ Lambert, commune de Seraing."
                            },
                            {
                                "example_id": "b4891a66-913e-4a60-a294-387d39e7c8a3",
                                "sense_id": "44d385a6-171b-346f-912a-7b8758198a43",
                                "text": "Elles vont être conduites par voie d'eau jusqu'à Liége en empruntant l'itinéraire suivant : la Seine jusqu'à Conflans, l'Oise jusqu'à Compiègne. l'Aisne jusqu'à Condé, le canal latéral de l'Aisne et le canal des Ardennes jusqu'à la Meuse, qu'ils aborderont à Pont-à-Bar, près de Charleville-Mézières."
                            }
                        ]
                    }
