                                ]
                            },
                            {
                                "target_word": "Nazarene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df24f16f-5610-37b0-93c7-abe634e76491",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A person from Nazareth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b84be66-3eff-4253-b8e2-ea8c4e5d0daf",
                                                "sense_id": "df24f16f-5610-37b0-93c7-abe634e76491",
                                                "text": "While Jenin was starving under curfew, Nazarenes were only twenty minutes away, watching televised footage of their neighbours ‘in solidarity’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533f3bba-34f5-366d-9926-20f4f15f2d84",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A member of the Jewish sect of the Nazarenes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b19b8cfc-19f0-47dc-8451-d22586397d06",
                                                "sense_id": "533f3bba-34f5-366d-9926-20f4f15f2d84",
                                                "text": "He was formerly with the sect of the Pharisees, but now he is a Nazarene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a28392b-3814-3405-8d9f-fdaa795d8551",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A Christian, a follower of Jesus."
                                        ],
                                        "tags": [
                                            "in Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c0784dc-7725-3e00-9d0b-ec4055f9eb09",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A member of the Church of the Nazarene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb0d614-483b-4d77-8b84-09a9cb93c5b1",
                                                "sense_id": "2c0784dc-7725-3e00-9d0b-ec4055f9eb09",
                                                "text": "I have been a Nazarene for several years; I joined the church in 1946."
                                            }
