                "senses": [
                    {
                        "sense_id": "9418af1b-ea16-3148-921f-59e1ac45919f",
                        "entry_id": "5f511690-5c79-3a7e-a9b4-1e742829486b",
                        "glosses": [
                            "ткань, сотканная в домашних условиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7574c53-fe67-4989-a0d8-e78567b7ea0b",
                                "sense_id": "9418af1b-ea16-3148-921f-59e1ac45919f",
                                "text": "Для производства такой самотканки употребляется обычного типа ткацкий станок, распространённый по всему Востоку."
                            }
                        ]
                    },
                    {
                        "sense_id": "3abd1a96-40a2-3b79-a5be-ced95ac6308f",
                        "entry_id": "5f511690-5c79-3a7e-a9b4-1e742829486b",
                        "glosses": [
                            "разг. одежда из такой ткани"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fee6551-432b-422c-b65c-6b8a2d601154",
                                "sense_id": "3abd1a96-40a2-3b79-a5be-ced95ac6308f",
                                "text": "Они были люди старого закала, грубые, невежественные, обирали своих крестьян, водили дворовых в самотканках и босиком."
                            }
                        ]
                    }
