                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28c08895-d4da-47a9-abb4-42a8aa716412",
                        "source_entry_id": "e354fbb2-05ca-3fb3-995f-db06313a4ced",
                        "source_sense_id": "43eb06d8-a146-3c3b-981a-12008a4ae4ef",
                        "target_lang_word": "corbeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corbeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Nom vernaculaire du grand corbeau (Corvus corax), gros oiseau passereau carnassier à plumage noir et au bec fort et noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7d5614-19dc-4bf2-abdf-0fa5251f59a4",
                                                "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                                "text": "S’étant emparé d’un vada qu’une vieille femme vendait dans la rue, un corbeau s’apprête à le dévorer, perché sur une branche, lorsqu’un renard survient."
                                            },
                                            {
                                                "example_id": "3b1d524c-a8e3-4c94-a161-0e97ddd14659",
                                                "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                                "text": "[…] ; un corbeau déjà dressé et comment (il buvait du vin), avait jugé bon néanmoins de renoncer aux bienfaits de la civilisation et de reprendre la clé des bois ; […]."
                                            },
                                            {
                                                "example_id": "dc934075-48c0-4ede-8f35-3b14259290f7",
                                                "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "fe725285-64c9-4e9f-827a-d5db932a62b2",
                                                "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                                "text": "Le corbeau nommé Jet vit depuis près de 10 ans au centre de réadaptation Wildlife Haven Rehabilitation Centre à Île-des-Chênes, à environ 30 kilomètres au sud de Winnipeg. Jet a appris beaucoup de nouvelles habiletés, comme celles de parler et de reconnaître des couleurs."
                                            },
                                            {
                                                "example_id": "05541df4-445e-49b7-803a-5525c65be30f",
                                                "sense_id": "349e2a3f-24d1-3239-b9b8-bc0a8434af1b",
                                                "text": "Les corbeaux sont des mets recherchés sous l’Occupation, ils se vendent jusqu’à 20 francs pièce – et font de bons bouillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95e9ecc-150b-3bda-b588-104b7c3432fd",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Oiseau d’allure proche du grand corbeau (1) (freux, corneille, choucas, etc.) pouvant appartenir aux genres Corvus et Pyrrhocorax."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88911850-4eac-4702-8be6-745c1d95d3e2",
                                                "sense_id": "a95e9ecc-150b-3bda-b588-104b7c3432fd",
                                                "text": "Toute la journée, un vent aigre a soufflé de l’Ouest ; le ciel est resté bas et triste, et j’ai vu passer des vols de corbeaux…"
                                            },
                                            {
                                                "example_id": "d2aed18e-c418-4ece-9ca4-d46a3263fc31",
                                                "sense_id": "a95e9ecc-150b-3bda-b588-104b7c3432fd",
                                                "text": "Au moment de repartir, notre attention est attirée par une nuée de corbeaux s'agitant au-dessus d'un groupe d’êtres humains."
                                            },
                                            {
                                                "example_id": "6821c266-3ebe-4859-ae22-c3c773484fb3",
                                                "sense_id": "a95e9ecc-150b-3bda-b588-104b7c3432fd",
                                                "text": "Quelques années plus tard, deux autres répulsifs pour corbeaux sont découverts : la diphénylguanidine et le triacétate de guazatine. Ces produits sont assez strictement limités aux corvidés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6901064-0f6f-3ca7-80fb-0d3b4e54aa48",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "En temps d’épidémie, personne chargée par les autorités de sortir de la ville les cadavres des pestiférés afin de les réunir dans des fosses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0608b0-91e3-42e4-aa1d-b035a4b1fc26",
                                                "sense_id": "a6901064-0f6f-3ca7-80fb-0d3b4e54aa48",
                                                "text": "Ce qu'il y avait de terrible au milieu de cette agonie de tout un peuple, c'était l'hilarité, la joie, l'allégresse de ces hommes chargés de réunir les morts, et qu'on avait baptisés du nom expressif de corbeaux."
                                            },
                                            {
                                                "example_id": "5b47e171-4591-4131-8b5f-83659f3beaf4",
                                                "sense_id": "a6901064-0f6f-3ca7-80fb-0d3b4e54aa48",
                                                "text": "On l’appelait le corbeau, du nom qu’on donnait à ces hommes sales et ivres qui fossoyaient les morts avec une indécente brutalité très répugnante. Il fallait convenir qu’il n’était pas très populaire."
                                            },
                                            {
                                                "example_id": "8a9d177f-8bb6-4915-8ffe-bb9fe41a2245",
                                                "sense_id": "a6901064-0f6f-3ca7-80fb-0d3b4e54aa48",
                                                "text": "Quatre hommes qui avaient la chemise en dehors des pantalons et étaient ainsi revêtus de l’uniforme habituel des corbeaux arrivèrent avec une civière."
                                            },
                                            {
                                                "example_id": "85091e4c-186f-47bb-a5fc-77a677da571e",
                                                "sense_id": "a6901064-0f6f-3ca7-80fb-0d3b4e54aa48",
                                                "text": "Ce ne sont pas des fossoyeurs. […] Ces hommes en casaquin sont des corbeaux, ainsi nommés à cause de leur croc, par quoi ils crochent dans les morts pour non pas les approcher trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ceea868-5d8f-33c8-a28a-acd0fc7c476a",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Nom donné quelquefois aux porteurs des morts."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96265411-8aaf-31ef-ba53-c76a20fb49c0",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Nom donné quelquefois aux prêtres à cause de leurs vêtements noirs."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9769a14-70fa-3070-8b95-33fe40a78381",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Auteur de lettres ou de coups de téléphone anonymes."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c987b3-9c70-481b-a188-fa12ea7278d7",
                                                "sense_id": "f9769a14-70fa-3070-8b95-33fe40a78381",
                                                "text": "Les juges chargés de faire la lumière sur les envois anonymes adressés en 2004 à leur collègue Renaud Van Ruymbeke, ont découvert un deuxième corbeau dans l’affaire Clearstream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d0a48c8-75d7-3cf6-b544-a115a7540a6d",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Pierre, pièce de bois ou de métal, façonnée en console, moindre en hauteur qu’en saillie, encastrée dans la maçonnerie et placée en saillie du nu d’un mur, servant à supporter une charge (poutre, corniche, balcon, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4bec7c8-48e6-4b90-96a7-2aa1e5aa5ff1",
                                                "sense_id": "2d0a48c8-75d7-3cf6-b544-a115a7540a6d",
                                                "text": "Puis, à mesure que la charpente métallique montait, (,,,) les consoles et les corbeaux se chargeaient de sculptures."
                                            },
                                            {
                                                "example_id": "8a99ff40-d6ca-4bf5-9bab-331fe99a3e86",
                                                "sense_id": "2d0a48c8-75d7-3cf6-b544-a115a7540a6d",
                                                "text": "Bâtière d’ardoises à coyau sur corbeaux calcaires en quart-de-rond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0dad8b-4083-3177-a109-ae5708193582",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Espèce de grappin d’abordage et de pont volant, utilisé par les Romains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106409b7-e82c-45f3-ba8f-3a0e2a01d140",
                                                "sense_id": "ea0dad8b-4083-3177-a109-ae5708193582",
                                                "text": "Les Romains suppléèrent à cet inconvénient [la supériorité des Carthaginois dans la manœuvre des vaisseaux] par une machine qui fut inventée sur-le-champ et que depuis on a appelée corbeau, par le moyen de laquelle ils accrochaient les vaisseaux des ennemis, passaient dedans malgré eux et en venaient aussitôt aux mains"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a67c8e1-8ba9-3696-947d-6af396def2aa",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Cépage donnant du raisin rouge nommé aussi montmélian en Savoie. Ce cépage possède une quarantaine de synonymes."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a6a13f-29fa-42bf-8b7b-bf05843332cc",
                                                "sense_id": "5a67c8e1-8ba9-3696-947d-6af396def2aa",
                                                "text": "En 1970, l’ampélographe français Paul Truel découvrit, lors d’un voyage à Mendoza, que ce cépage [bonarda] était en fait le corbeau, appelé aussi douce noire et charbonneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "903ccc5b-384e-3769-b036-938152c16626",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il est généralement représenté de profil, debout sur ses pattes et de sable. À rapprocher de corneille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc504355-a176-413f-abd2-382ff3a50c96",
                                                "sense_id": "903ccc5b-384e-3769-b036-938152c16626",
                                                "text": "Écartelé d’or au lion de gueules et d’argent au corbeau de sable, becqué et membré de gueules, qui est de Fourcès du Gers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a44a11e-7c97-3be8-9c34-aa1b0691cea4",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Jeu traditionnel de village."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebdc0b0-a7eb-4094-8887-8de99642c665",
                                                "sense_id": "0a44a11e-7c97-3be8-9c34-aa1b0691cea4",
                                                "text": "Les uns se répandaient dans les cabarets pour digérer en fumant une pipe. D’autres jouaient aux quilles ou au corbeau, ou bien encore au bricotiau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a552aba4-0b04-3eb2-870d-e893fe21f530",
                                        "entry_id": "ed3a9346-1b57-333e-98ff-4d9381b300f4",
                                        "glosses": [
                                            "Premier grade des initiés du culte de Mithra."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "corbeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4812dba9-e597-3387-8859-b3fabfdc028c",
                                        "entry_id": "8bff210b-1740-38a6-867b-3e1d5a542ade",
                                        "glosses": [
                                            "Qui est du noir le plus sombre, avec parfois des reflets bleutés. #000000"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd94a47-71ac-4f05-bb8c-90f39b943dd0",
                                                "sense_id": "4812dba9-e597-3387-8859-b3fabfdc028c",
                                                "text": "Un feutre assorti à la robe, crânement relevé, couronne ses cheveux corbeau coiffés en arrière, dégageant le front lisse."
                                            },
                                            {
                                                "example_id": "b7dc506d-dd3b-400e-bf5a-2d5e96d04126",
                                                "sense_id": "4812dba9-e597-3387-8859-b3fabfdc028c",
                                                "text": "[…] d’étonnantes dates, Lourdes, Fatima, Maria Goretti, reliées aux chapeaux corbeau des vieux curés plutôt qu’au petit béret des vicaires motocyclistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae1cdfa-bc1f-39cb-af4f-e3c5f176748f",
                                        "entry_id": "8bff210b-1740-38a6-867b-3e1d5a542ade",
                                        "glosses": [
                                            "Qui appartient au peuple amérindien des Corbeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629696db-3788-4aaa-9497-29e3df706051",
                                                "sense_id": "fae1cdfa-bc1f-39cb-af4f-e3c5f176748f",
                                                "text": "Endeuillé, le chef corbeau reçoit les cadeaux sans broncher ni témoigner de la moindre gratitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
