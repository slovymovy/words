{
    "word_family": [
        "dry",
        "dryness",
        "dryly",
        "undried",
        "overdry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1349bc05-0954-328d-8d61-49e7210fee86",
                    "sense_definition": "A household appliance used to remove moisture from clothing and textiles, typically after they have been washed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drying_appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the wash cycle finished, I moved the wet clothes into the <w>dryer</w>.",
                            "target_lang_translations": {
                                "ru": "После завершения цикла стирки я переложил мокрую одежду в <w>сушильную машину</w>."
                            }
                        },
                        {
                            "text": "The <w>dryer</w> sheet makes the laundry smell fresh and reduces static electricity.",
                            "target_lang_translations": {
                                "ru": "<w>Салфетка</w> для <w>сушки</w> придает белью свежий запах и уменьшает статическое электричество."
                            }
                        }
                    ],
                    "synonyms": [
                        "tumble dryer",
                        "clothes dryer"
                    ],
                    "antonyms": [
                        "washing machine"
                    ],
                    "common_phrases": [
                        "dryer sheet",
                        "tumble dryer",
                        "clothes dryer",
                        "ventless dryer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бытовой прибор, используемый для удаления влаги из одежды и текстиля, обычно после стирки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушильная машина",
                                "target_lang_sense_clarification": "бытовой электроприбор"
                            },
                            {
                                "target_lang_word": "сушилка",
                                "target_lang_sense_clarification": "разговорное название прибора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "570ae489-da59-3590-9e06-7b3dc5e73c96",
                    "sense_definition": "An electrical device used for blowing hot or cool air over wet hair to accelerate evaporation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drying_appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>dryer</w> to style her hair before going to the party.",
                            "target_lang_translations": {
                                "ru": "Она воспользовалась <w>феном</w>, чтобы уложить волосы перед вечеринкой."
                            }
                        },
                        {
                            "text": "I need a hair <w>dryer</w> because my hair takes too long to dry naturally.",
                            "target_lang_translations": {
                                "ru": "Мне нужен <w>фен</w>, потому что мои волосы слишком долго сохнут естественным путем."
                            }
                        }
                    ],
                    "synonyms": [
                        "hair dryer",
                        "blow-dryer"
                    ],
                    "common_phrases": [
                        "hair dryer",
                        "handheld dryer",
                        "ionic dryer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое устройство для обдува влажных волос горячим или холодным воздухом для ускорения испарения воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фен",
                                "target_lang_sense_clarification": "для сушки волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "777ffd53-0392-3cd2-81a8-fe19002c44d6",
                    "sense_definition": "Any person, machine, or substance that removes moisture or humidity from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drying_agents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun and a northwesterly wind are great <w>dryers</w> of the earth after a storm.",
                            "target_lang_translations": {
                                "ru": "Солнце и северо-западный ветер — отличные <w>осушители</w> земли после шторма."
                            }
                        },
                        {
                            "text": "The industrial grain <w>dryer</w> was a large structure built to process the harvest quickly.",
                            "target_lang_translations": {
                                "ru": "Промышленная <w>зерносушилка</w> представляла собой огромное сооружение, построенное для быстрой обработки урожая."
                            }
                        }
                    ],
                    "synonyms": [
                        "desiccator",
                        "dehydrator"
                    ],
                    "antonyms": [
                        "moistener",
                        "humidifier"
                    ],
                    "common_phrases": [
                        "grain dryer",
                        "industrial dryer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой человек, машина или вещество, удаляющее влагу или влажность из чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушилка",
                                "target_lang_sense_clarification": "устройство или приспособление"
                            },
                            {
                                "target_lang_word": "сушильщик",
                                "target_lang_sense_clarification": "человек, занимающийся сушкой"
                            },
                            {
                                "target_lang_word": "осушитель",
                                "target_lang_sense_clarification": "техническое устройство или вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70085b9f-afa3-3eb6-9cfb-2fa3eefe049b",
                    "sense_definition": "A chemical additive or catalyst used to speed up the drying process of paints, inks, or varnishes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drying_agents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist added a liquid <w>dryer</w> to the oil paint to make it set faster.",
                            "target_lang_translations": {
                                "ru": "Художник добавил жидкий <w>сиккатив</w> в масляную краску, чтобы она быстрее застыла."
                            }
                        },
                        {
                            "text": "Without a proper <w>dryer</w>, the thick varnish might remain tacky for several days.",
                            "target_lang_translations": {
                                "ru": "Без подходящего <w>отвердителя</w> густой лак может оставаться липким в течение нескольких дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "siccative",
                        "drying agent"
                    ],
                    "common_phrases": [
                        "paint dryer",
                        "liquid dryer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in chemistry and arts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая добавка или катализатор, используемый для ускорения процесса высыхания красок, чернил или лаков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сиккатив",
                                "target_lang_sense_clarification": "в химии и живописи"
                            },
                            {
                                "target_lang_word": "отвердитель",
                                "target_lang_sense_clarification": "ускоритель высыхания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "182bd4f4-1eb6-3ebf-b2e9-a51edc46a8c9",
                    "sense_definition": "The comparative form of <w>dry</w>; more dry.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This towel is <w>dryer</w> than the one I used earlier.",
                            "target_lang_translations": {
                                "ru": "Это полотенце <w>суше</w>, чем то, которым я пользовался раньше."
                            }
                        },
                        {
                            "text": "The climate in the desert is much <w>dryer</w> than in the tropical rainforest.",
                            "target_lang_translations": {
                                "ru": "Климат в пустыне гораздо <w>суше</w>, чем в тропических лесах."
                            }
                        }
                    ],
                    "antonyms": [
                        "wetter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного dry; более сухой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суше",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "более сухой",
                                "target_lang_sense_clarification": "сравнительная степень"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d1fdd6a7-aeba-3082-b573-e3c8fbc2ee91",
                    "sense_definition": "An English and German surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Dryer</w> was appointed as the new head of the local history department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Драйер</w> был назначен новым главой отдела местной истории."
                            }
                        },
                        {
                            "text": "The <w>Dryer</w> family has lived in this small village for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Драйер</w> живет в этой маленькой деревне уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская и немецкая фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Драйер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}