                "senses": [
                    {
                        "sense_id": "109cc2f7-9efa-38cc-a74d-079a97df1eb3",
                        "entry_id": "c2fcdb9f-08f1-3e03-9ead-eb7f47bbc674",
                        "glosses": [
                            "To furnish or adorn with a fringe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39cf6535-7ecf-496d-85a1-bcebbb6aef70",
                                "sense_id": "109cc2f7-9efa-38cc-a74d-079a97df1eb3",
                                "text": "[...] women themselves went in armour, (having a brave lasse like another Penthesilea for their leader, so befringed with gold, that they called her Golden-foot) riding astride like men [...]"
                            },
                            {
                                "example_id": "95fb11ff-3c6f-49df-99d3-807474bcfa9f",
                                "sense_id": "109cc2f7-9efa-38cc-a74d-079a97df1eb3",
                                "text": "And when I flatter, let my dirty leaves\n(Like Journals, Odes, and such forgotten things\nAs Eusden, Philips, Settle, writ of Kings)\nCloath spice, line trunks, or flutt’ring in a row,\nBefringe the rails of Bedlam and Sohoe."
                            },
                            {
                                "example_id": "06e44236-fb9d-46fd-b000-dc278152b894",
                                "sense_id": "109cc2f7-9efa-38cc-a74d-079a97df1eb3",
                                "text": "1823, Lord Byron, Don Juan: Cantos IX.—X.—XI., London: John Hunt, Canto 10, stanza 29, p. 32,\n… each dress he sported,\nWhich set the beauty off in which he glowed,\nAs purple clouds befringe the sun …"
                            },
                            {
                                "example_id": "0b2dfa5b-817c-4e56-98bd-1b99fbfc2d13",
                                "sense_id": "109cc2f7-9efa-38cc-a74d-079a97df1eb3",
                                "text": "[…] during a year or more, Gentleman Brown’s ship was to be seen, for many days on end, hovering off an islet befringed with green upon azure, with the dark dot of the mission-house on a white beach […]"
                            }
                        ]
                    }
