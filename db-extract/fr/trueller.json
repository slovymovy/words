                ],
                "senses": [
                    {
                        "sense_id": "a68c7650-66c4-3695-8e00-9ceb97d1e080",
                        "entry_id": "1ec7c821-ba88-342a-ae1d-53d3202839fa",
                        "glosses": [
                            "Placer le mortier avec la truelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd72269-2b61-4386-aa86-c3123c00b29a",
                                "sense_id": "a68c7650-66c4-3695-8e00-9ceb97d1e080",
                                "text": "Avec de grands parti-pris d'ombre et de clair, on peut trueller et maçonner ses tons, mais le clair pur, sans délicatesse de main, est si impossible qu'il n'existe pas un seul tableau, une seule esquisse du XIVe ou du XVe, qui représente de tohu-bohu d'accents de vigueur empilés les uns sur les autres."
                            },
                            {
                                "example_id": "072a09c2-4b13-4b2c-a357-e6c85d972811",
                                "sense_id": "a68c7650-66c4-3695-8e00-9ceb97d1e080",
                                "text": "trueller, étendre le mortier avec la truelle"
                            },
                            {
                                "example_id": "87975cd8-c1e4-4c88-a0a7-3cae0f93e4da",
                                "sense_id": "a68c7650-66c4-3695-8e00-9ceb97d1e080",
                                "text": "Bastien Champartel, le maçon, fut requis d’en trueller les parois."
                            }
                        ]
                    },
                    {
                        "sense_id": "449761a4-2138-3de0-a2bd-5e4c6443b46f",
                        "entry_id": "1ec7c821-ba88-342a-ae1d-53d3202839fa",
                        "glosses": [
                            "Appliquer la peinture d'un tableau comme avec une truelle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4e257b49-7376-4201-a043-08b149fef33a",
                                "sense_id": "449761a4-2138-3de0-a2bd-5e4c6443b46f",
                                "text": "La manière de peindre de Goya était aussi excentrique que son talent : il puisait la couleur dans des baquets, l’appliquait avec des éponges, des balais, des torchons, et tout ce qui lui tombait sous la main, il truellait et maçonnait ses tons comme du mortier, et donnait les touches de sentiment à grands coups de pouce."
                            }
                        ]
                    }
                ],
