                        ]
                    },
                    {
                        "translation_id": "082c1368-1c94-42c3-b665-08ca0b5c5f8c",
                        "source_entry_id": "7608b216-25d0-313f-8a0d-ebdf2a2cc797",
                        "source_sense_description": "a dominion ruled by a baron or baroness",
                        "target_lang_word": "име́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "име́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d329f025-43d5-3219-9684-716024d97a7d",
                                        "entry_id": "eaa5c7ce-6847-3ae1-9ec2-f5c8c2accd65",
                                        "glosses": [
                                            "земельное владение помещика, обычно с усадьбой; поместье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1abb818-e90f-4d7c-a8c3-6455fe386f12",
                                                "sense_id": "d329f025-43d5-3219-9684-716024d97a7d",
                                                "text": "В чине бригадира, семидесяти пяти лет вышел в отставку и поселился в малом своём имении в Калужской губернии."
                                            },
                                            {
                                                "example_id": "f04bcc1b-3b44-4343-aeda-ac9c016e5759",
                                                "sense_id": "d329f025-43d5-3219-9684-716024d97a7d",
                                                "text": "Хозяйством он не занимался, имением правила его мать."
                                            },
                                            {
                                                "example_id": "d1e28d2f-1a0a-4662-8418-81bef1b15e7e",
                                                "sense_id": "d329f025-43d5-3219-9684-716024d97a7d",
                                                "text": "В самом начале тридцатых годов она [матушка] успела приобрести значительное имение. Это было большое торговое село Заболотье, заключавшее в себе с деревнями более трех тысяч душ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fea4309-3197-30f4-a85b-9d3fd5fd930a",
                                        "entry_id": "eaa5c7ce-6847-3ae1-9ec2-f5c8c2accd65",
                                        "glosses": [
                                            "устар. имущество, собственность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b451b0-8b5d-4b89-aaa7-12ac87685d3d",
                                                "sense_id": "4fea4309-3197-30f4-a85b-9d3fd5fd930a",
                                                "text": "Фридрих, точный во всем, заранее составил завещание, которым отказывал порядочную часть недвижимого имения Адольфу, наследнику после умершей матери его, а лучшую главную часть и все движимое имение ― своей Ревекке."
                                            },
                                            {
                                                "example_id": "44a48950-4414-4f91-88c3-c6f0cad5ca72",
                                                "sense_id": "4fea4309-3197-30f4-a85b-9d3fd5fd930a",
                                                "text": "― У тебя всего-навсего имения было кафтан да топор…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
