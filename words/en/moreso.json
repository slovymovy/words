            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1456b82e-568b-3359-b433-c60138744b49",
                    "sense_definition": "More than anything else; rather or to a greater extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The change in the schedule was <w>moreso</w> a preference than a strict requirement.",
                            "target_lang_translations": {
                                "pl": "Zmiana w harmonogramie była <w>raczej</w> preferencją niż rygorystycznym wymogiem."
                            }
                        },
                        {
                            "text": "It was <w>moreso</w> about timing than about a lack of effort.",
                            "target_lang_translations": {
                                "pl": "Chodziło <w>bardziej</w> o wyczucie czasu niż o brak starań."
                            }
                        }
                    ],
                    "synonyms": [
                        "rather",
                        "more"
                    ],
                    "common_phrases": [
                        "moreso than"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardziej niż cokolwiek innego; raczej lub w większym stopniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bardziej",
                                "target_lang_sense_clarification": "w większym stopniu"
                            },
                            {
                                "target_lang_word": "raczej",
                                "target_lang_sense_clarification": "wskazuje na preferencję lub celniejszą opisać sytuację"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d38f21f9-a57a-3acd-8162-8ced5589a0ab",
                    "sense_definition": "Nonstandard spelling of <w>more so</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Resources are becoming scarce and are expected to become <w>moreso</w> in the future.",
                            "target_lang_translations": {
                                "pl": "Zasoby stają się rzadkie i oczekuje się, że w przyszłości staną się <w>jeszcze bardziej</w> deficytowe."
                            }
                        },
                        {
                            "text": "The second test was difficult, even <w>moreso</w> than the first one.",
                            "target_lang_translations": {
