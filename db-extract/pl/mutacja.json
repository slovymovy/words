                            {
                                "example_id": "23b69fa0-adf4-4ac6-89e5-1e0d29ce4436",
                                "sense_id": "3a545f97-3a20-366f-8a83-51864eb8b999",
                                "text": "Wśród duńskich norek wykryto szczególną mutację koronawirusa, co potencjalnie może stanowić poważne zagrożenie dla zdrowia publicznego na całym świecie."
                            }
