                "translations": [
                    {
                        "translation_id": "08232bf6-d11f-40b7-b5da-d6ab5fe43393",
                        "source_entry_id": "3307f44c-b044-3b1c-8c6b-ed6a6fbed1a5",
                        "source_sense_id": "c1667333-f8fe-3311-8c0d-97c870bb01d2",
                        "target_lang_word": "behold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46db7a4e-bdc6-304d-a85b-fd3b0810aa18",
                                        "entry_id": "08ac52ed-9fbb-313b-8696-df497f94826e",
                                        "glosses": [
                                            "To look at or see (someone or something), especially appreciatively; to descry, to look upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a282e04-b71c-4e1c-aa9e-51cd6a5d5cf0",
                                                "sense_id": "46db7a4e-bdc6-304d-a85b-fd3b0810aa18",
                                                "text": "There's not the ſmalleſt orbe [in the sky] vvhich thou beholdſt, / But in his motion like an Angell ſings, / Still quiring to the young eide Cherubins; / Such harmony is in immortall ſoules, / But vvhilſt this muddy veſture of decay [i.e., the human body] / Doth groſſely cloſe in it, vve cannot heare it."
                                            },
                                            {
                                                "example_id": "0cb94bf2-f209-4dbe-be88-6923eb5940e1",
                                                "sense_id": "46db7a4e-bdc6-304d-a85b-fd3b0810aa18",
                                                "text": "[…] Alaeddin ate and drank and was cheered and after he had rested and had recovered spirits he cried, \"Ah, O my mother, I have a sore grievance against thee for leaving me to that accursed wight who strave to compass my destruction and designed to take my life. Know that I beheld Death with mine own eyes at the hand of this damned wretch, whom thou didst certify to be my uncle; […]"
                                            },
                                            {
                                                "example_id": "e263f482-f477-48f0-9deb-d7fdd450d180",
                                                "sense_id": "46db7a4e-bdc6-304d-a85b-fd3b0810aa18",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Now she had come to look upon the matter in its true proportions, and her anticipation of a possible chance of teaching him a lesson was a pleasure to behold."
                                            },
                                            {
                                                "example_id": "7ada6c9b-1894-43af-8477-f8581f53764b",
                                                "sense_id": "46db7a4e-bdc6-304d-a85b-fd3b0810aa18",
                                                "text": "I was working in the lab late one night\nWhen my eyes beheld an eerie sight\nFor my monster, from his slab, began to rise\nAnd suddenly, to my surprise\nHe did the Mash\nHe did the Monster Mash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5f285a-3658-3726-b004-5bf3df580d81",
                                        "entry_id": "08ac52ed-9fbb-313b-8696-df497f94826e",
                                        "glosses": [
                                            "To contemplate (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b87f1a1-842c-3f1d-8c41-ffdd5a9f5efd",
                                        "entry_id": "08ac52ed-9fbb-313b-8696-df497f94826e",
                                        "glosses": [
                                            "To look."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c1bdbdb-fc06-4c50-b2e2-27037e8cb15b",
                                                "sense_id": "1b87f1a1-842c-3f1d-8c41-ffdd5a9f5efd",
                                                "text": "Lo and behold."
                                            }
                                        ]
                                    }
                                ]
                            },
