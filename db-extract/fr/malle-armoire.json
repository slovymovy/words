                    {
                        "sense_id": "278ca9da-ce8d-313e-804b-f553d037ac6f",
                        "entry_id": "6b0d6e8d-1cf5-3902-b6e3-8c5bd5cf24dd",
                        "glosses": [
                            "Malle aménagée pour servir d’armoire en l’ouvrant sur le côté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f4e94a-3089-43fe-9efc-20b418c912aa",
                                "sense_id": "278ca9da-ce8d-313e-804b-f553d037ac6f",
                                "text": "Mais elle était ouverte, debout, une malle-armoire : il y avait à l’intérieur des rangées de souliers de femmes, en pente, tenant par les talons à une traverse, les pointes d’une rangée venant derrière les talons de la rangée en dessous, comme les tuiles d’un toit…"
                            },
                            {
                                "example_id": "b2748b1c-f178-4da6-934b-8d29cab374d4",
                                "sense_id": "278ca9da-ce8d-313e-804b-f553d037ac6f",
                                "text": "Ce qui n’empêche pas l’avènement des malles-cabines ou malles-armoires que l’on pose debout, nouvelle conquête."
                            },
                            {
                                "example_id": "d440f43d-1a55-404f-8917-6749e632766a",
                                "sense_id": "278ca9da-ce8d-313e-804b-f553d037ac6f",
                                "text": "Les comédiens emmènent le visiteur à Louxor avec les malles-armoires qui prenaient place sur les bateaux à vapeur, ou encore dans les stations balnéaires huppées de la côte avec les malles-coffres des premières voitures."
                            }
                        ]
                    }
