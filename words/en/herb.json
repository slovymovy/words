                            {
                                "target_lang_word": "trawka",
                                "target_lang_sense_clarification": "slangowo o marihuanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2065b3-9ff8-33d5-83a5-8f37142524eb",
                    "sense_definition": "A plant with a soft stem that is not woody and dies down to the ground after flowering.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Botanically speaking, a banana plant is a giant <w>herb</w> because it lacks a woody trunk.",
                            "target_lang_translations": {
                                "ru": "С ботанической точки зрения, банан — это гигантская <w>трава</w>, так как у него нет древесного ствола.",
                                "pl": "Z botanicznego punktu widzenia bananowiec to gigantyczna <w>roślina zielna</w>, ponieważ nie ma zdrewniałego pnia."
                            }
                        },
                        {
                            "text": "This perennial <w>herb</w> will grow back every spring.",
                            "target_lang_translations": {
                                "ru": "Это многолетнее <w>травянистое растение</w> будет отрастать каждую весну.",
                                "pl": "Ta wieloletnia <w>bylina</w> będzie odrastać każdej wiosny."
                            }
                        }
                    ],
                    "synonyms": [
                        "herbaceous plant"
                    ],
                    "common_phrases": [
                        "perennial herb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение с мягким стеблем, который не одревесневает и часто отмирает до корня после цветения.",
                        "pl": "Roślina o miękkiej łodydze, która nie jest zdrewniała i obumiera po przekwitnięciu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травянистое растение",
                                "target_lang_sense_clarification": "ботанический термин"
                            },
                            {
                                "target_lang_word": "трава",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "roślina zielna",
                                "target_lang_sense_clarification": "termin botaniczny"
                            },
                            {
                                "target_lang_word": "bylina",
                                "target_lang_sense_clarification": "roślina wieloletnia niezdrewniała"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23c6022f-1c7b-3c51-b4b4-2e86bbbb61fc",
                    "sense_definition": "A lame, uncool, or socially awkward person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>herb</w>; just come to the party with us.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>занудой</w>, просто пойдем с нами на вечеринку.",
                                "pl": "Nie bądź takim <w>sztywniakiem</w>, po prostu idź z nami na imprezę."
                            }
                        },
                        {
                            "text": "He thinks he is cool, but everyone else sees him as a total <w>herb</w>.",
                            "target_lang_translations": {
                                "ru": "Он думает, что он крутой, но все остальные считают его полным <w>лохом</w>.",
                                "pl": "Myśli, że jest fajny, ale wszyscy inni uważają go za kompletnego <w>frajera</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "loser",
                        "dork"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "pronounced with /h/"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный, некрутой или социально неловкий человек.",
                        "pl": "Nudna, nieatrakcyjna towarzysko lub niezręczna osoba."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лох",
                                "target_lang_sense_clarification": "сленг, оскорбление"
                            },
