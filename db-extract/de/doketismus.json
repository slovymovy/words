                                        "entry_id": "a95edb32-523b-3d82-9d00-0c7eb553ccd9",
                                        "glosses": [
                                            "Secte chrétienne du IIᵉ siècle qui prétendait que Jésus n'était né, mort et ressuscité qu’en apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bee681a-3a5f-42f8-8f69-1ad25b534798",
                                                "sense_id": "2fe8501e-dce1-39d7-974f-bc9ace815541",
                                                "text": "Le docétisme est une hérésie chrétienne qui désigne un ensemble de courants de pensées du début du christianisme, relevant du courant christologique sarx pour lequel le christ se faisant « chair » ne signifie pas qu'il se fait « homme »."
                                            },
                                            {
                                                "example_id": "a45d0a72-0052-4d39-9fe3-d544e5ff35a5",
                                                "sense_id": "2fe8501e-dce1-39d7-974f-bc9ace815541",
                                                "text": "Il en va, contre tous les docétismes, du réalisme même de l’Incarnation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
