                {
                    "sense_id": "c13bea19-090d-38a3-b6dd-7f1c1d76ebca",
                    "sense_definition": "A small inlet, often saltwater, leading to the sea or to the main channel of a river.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat was anchored in a sheltered <w>creek</w> away from the rough sea.",
                            "target_lang_translations": {
                                "ru": "Лодка стояла на якоре в защищённой <w>бухте</w>, вдали от бурного моря.",
                                "zh": "船停泊在远离波涛汹涌的大海的一处避风<w>河汊</w>里。",
                                "es": "El barco estaba anclado en una <w>caleta</w> protegida, lejos del mar agitado.",
                                "tr": "Tekne, hırçın denizden uzakta, korunaklı bir <w>koyda</w> demirlemişti.",
                                "de": "Das Boot lag in einer geschützten <w>Bucht</w> vor Anker, fernab der rauen See."
                            }
                        },
                        {
                            "text": "At low tide, the muddy banks of the <w>creek</w> are visible.",
                            "target_lang_translations": {
                                "ru": "Во время отлива видны илистые берега <w>залива</w>.",
                                "zh": "退潮时，可以看到<w>河汊</w>泥泞的河岸。",
                                "es": "Durante la marea baja, son visibles las orillas fangosas de la <w>caleta</w>.",
                                "tr": "Gelgit çekildiğinde, <w>koyun</w> çamurlu kıyıları görünür hale gelir.",
                                "de": "Bei Ebbe sind die schlammigen Ufer der <w>Bucht</w> sichtbar."
                            }
                        }
                    ],
                    "synonyms": [
                        "bayou"
                    ],
                    "common_phrases": [
                        "tidal creek",
                        "muddy creek"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой залив, часто с соленой водой, ведущий к морю или главному руслу реки.",
                        "zh": "一种小的入海口或河汊，常为咸水，通向大海或河流主干道。",
                        "es": "Una pequeña entrada de agua, a menudo salada, que conecta con el mar o el cauce principal de un río.",
                        "tr": "Denize veya ana nehir yatağına açılan, genellikle tuzlu su içeren küçük girinti veya koy.",
                        "de": "Eine kleine Einbuchtung an einer Küste oder einem Flussufer, oft mit ruhigem Wasser."
                    },
