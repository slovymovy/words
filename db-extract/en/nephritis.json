                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néphrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                        "entry_id": "7f0577a5-5fc2-313a-9833-60e9a5a41b26",
                                        "glosses": [
                                            "Inflammation du rein."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d6f003-d378-4ed3-803c-969be1c647ec",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Dans certains cas, on observe en outre de la céphalalgie, de la dyspnée, du coma, symptômes qui sont presque toujours sous la dépendance de l’urémie occasionnée par la néphrite."
                                            },
                                            {
                                                "example_id": "b47168ac-426f-4b1d-93b5-f3d9cf9a78f9",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Mon frère venait d’être pris d’une néphrite qui réclamait encore des soins et lui interdisait d’être interne."
                                            },
                                            {
                                                "example_id": "0f6e0bb0-ecba-4701-8a0a-1704c82aaa38",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Bien que souffrant d'une néphrite chronique avec complications cardiaques, il ne voulut pas consentir à prendre le moindre repos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c59843-2bff-3ab4-8c28-a11dd5fe58e4",
                                        "entry_id": "7f0577a5-5fc2-313a-9833-60e9a5a41b26",
                                        "glosses": [
                                            "Variété verte de trémolite ou d’actinote qui est une des deux composantes du jade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6459bc-9ee5-42ef-851f-6ec90d48a6b4",
                                                "sense_id": "d6c59843-2bff-3ab4-8c28-a11dd5fe58e4",
                                                "text": "Leur industrie n’était pas complexe, encore qu’ils connussent le métier du potier et les éléments de ceux du menuisier et du charpentier. Ils n’usaient point de métaux, mais d’une sorte de néphrite fort dure, dont ils faisaient leurs harpons, leurs scies, leurs haches, leurs couteaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd651376-415c-4c4d-a7f1-3da9d5043016",
                        "source_entry_id": "2b6e4e0e-f638-3154-96bb-9b42e6851889",
