                ],
                "senses": [
                    {
                        "sense_id": "12ac2336-e1cc-3648-b187-062f5893c592",
                        "entry_id": "2caefe41-9663-3cc0-9d0d-cf779ca1a9c9",
                        "glosses": [
                            "Enlever son caractère sensuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8217a557-277d-412f-92d3-94721dcaf5d2",
                                "sense_id": "12ac2336-e1cc-3648-b187-062f5893c592",
                                "text": "J’ai essayé de désensualiser le corps de mes modèles afin de pouvoir les montrer comme un objet esthétique, et non comme un objet de désir."
                            },
                            {
                                "example_id": "9209fb2e-eccd-4295-817e-1aefe9d8c449",
                                "sense_id": "12ac2336-e1cc-3648-b187-062f5893c592",
                                "text": "Pour le comprendre il faut à la fois conjugaliser, donc sexualiser la relation parents-enfants et désensualiser la relation conjugale."
                            },
                            {
                                "example_id": "5d4305da-a249-4b14-ad93-b31d8033d9b9",
                                "sense_id": "12ac2336-e1cc-3648-b187-062f5893c592",
                                "text": "Avec Nu au poulpe, il tente de désensualiser le corps féminin, de le désexualiser en jouant sur les contraires, les contrastes de textures, le repoussant et l'attirant."
                            }
                        ]
                    }
                ],
