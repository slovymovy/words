                "senses": [
                    {
                        "sense_id": "e8bd6855-3d6f-34a9-9b14-1a58ebe633ac",
                        "entry_id": "08ab4309-75f7-3782-b1aa-376ca403b158",
                        "glosses": [
                            "Nourrir avec du camembert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e7efae6-5369-4769-be8c-9eeaa7b72a8f",
                                "sense_id": "e8bd6855-3d6f-34a9-9b14-1a58ebe633ac",
                                "text": "Je continue à hypervitaminer mon pauvre Désiré, à le camembertiser aussi et à essayer de lui redonner confiance en lui."
                            },
                            {
                                "example_id": "d3018b14-7f68-426c-a4b3-e3899cdb5805",
                                "sense_id": "e8bd6855-3d6f-34a9-9b14-1a58ebe633ac",
                                "text": "La filozofylle c'est un soufflet au camembert ; c'est gros, impressionnant, ça sent pas très bon, c'est pas très ludique. Donc déjà faut aimer se camembertiser ; c'est peut-être pour ça qu'on peut parler d'une élite."
                            },
                            {
                                "example_id": "085065fc-be81-4fdb-b7fb-8acb50359ec6",
                                "sense_id": "e8bd6855-3d6f-34a9-9b14-1a58ebe633ac",
                                "text": "En témoignent l'émouvant \"El Angel Exterminator\" à la trompette étonnante ou \"Dynamite\" tout droit échappé d'un Gong tout frais camembertisé !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e94edea-f0e3-3884-ae51-c8724dfbe230",
                        "entry_id": "08ab4309-75f7-3782-b1aa-376ca403b158",
                        "glosses": [
                            "Donner un caractère français à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18261091-624f-4b64-96b1-13700918783e",
                                "sense_id": "9e94edea-f0e3-3884-ae51-c8724dfbe230",
                                "text": "Non, eux, ne s'étaient pas tatamisés, selon l'expression consacrée, mais avaient plutôt camembertisé en douce leurs épouses japonaises."
                            }
                        ]
                    }
