{
    "word_family": [
        "extension",
        "extensive",
        "extensible",
        "extensor",
        "extent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4af3d7b4-07bc-3a8c-8f60-7f6bb22384a9",
                    "sense_definition": "To cover a specific area or distance in space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_coverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vast desert <w>extended</w> for hundreds of miles in all directions.",
                            "target_lang_translations": {
                                "ru": "Обширная пустыня <w>простиралась</w> на сотни миль во всех направлениях."
                            }
                        },
                        {
                            "text": "The new hiking trail will <w>extend</w> across the entire mountain range.",
                            "target_lang_translations": {
                                "ru": "Новая туристическая тропа будет <w>тянуться</w> через весь горный хребет."
                            }
                        }
                    ],
                    "synonyms": [
                        "run",
                        "stretch"
                    ],
                    "common_phrases": [
                        "extend for miles",
                        "extend across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать определенную площадь или расстояние в пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "о территории или пространстве"
                            },
                            {
                                "target_lang_word": "тянуться",
                                "target_lang_sense_clarification": "о дороге или ландшафте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c74f1e8d-fa64-375e-9da2-f3a544b1060c",
                    "sense_definition": "To make something last for a longer period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temporal_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student asked the professor to <w>extend</w> the deadline for the final essay.",
                            "target_lang_translations": {
                                "ru": "Студент попросил профессора <w>продлить</w> срок сдачи итогового эссе."
                            }
                        },
                        {
                            "text": "We decided to <w>extend</w> the deadline by one week to ensure quality.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>продлить</w> крайний срок на одну неделю, чтобы гарантировать качество."
                            }
                        }
                    ],
                    "synonyms": [
                        "lengthen"
                    ],
                    "common_phrases": [
                        "extend the deadline",
                        "extend a stay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более длительным по времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "срок или время"
                            },
                            {
                                "target_lang_word": "продлить",
                                "target_lang_sense_clarification": "увеличить срок"
                            },
                            {
                                "target_lang_word": "увеличить",
                                "target_lang_sense_clarification": "срок действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52dea794-f9e9-3d2c-9614-73a72bc3632e",
                    "sense_definition": "To make something larger in area, scope, or size.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>extend</w> its business into international markets next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>расширить</w> свой бизнес на международные рынки в следующем году."
                            }
                        },
                        {
                            "text": "They want to <w>extend</w> the house by adding a new sunroom at the back.",
                            "target_lang_translations": {
                                "ru": "Они хотят <w>расширить</w> дом, пристроив новую веранду сзади."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "expand",
                        "increase",
                        "widen"
                    ],
                    "common_phrases": [
                        "extend the range",
                        "extend the scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо больше по площади, охвату или размеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "бизнес или сферу влияния"
                            },
                            {
                                "target_lang_word": "расширить",
                                "target_lang_sense_clarification": "границы или возможности"
                            },
                            {
                                "target_lang_word": "пристраивать",
                                "target_lang_sense_clarification": "о здании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdebbd86-a783-347a-af68-b03050e17a0f",
                    "sense_definition": "To offer or give something, such as an invitation, sympathy, or credit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bestow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee would like to <w>extend</w> an invitation to you for the gala.",
                            "target_lang_translations": {
                                "ru": "Комитет хотел бы <w>направить</w> вам приглашение на торжественный вечер."
                            }
                        },
                        {
                            "text": "It is important to <w>extend</w> an invitation to all members of the local community.",
                            "target_lang_translations": {
                                "ru": "Важно <w>разослать</w> приглашение всем членам местного сообщества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extend an invitation",
                        "extend sympathy",
                        "extend credit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложить или предоставить что-либо (приглашение, соболезнования, кредит)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "приглашение или соболезнования"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "сочувствие или благодарность"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "кредит или льготу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce2c30ad-db26-344f-b1ef-fc3faf7b261a",
                    "sense_definition": "To straighten out a limb or part of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had to <w>extend</w> her arm fully to reach the finish line.",
                            "target_lang_translations": {
                                "ru": "Спортсменке пришлось полностью <w>вытянуть</w> руку, чтобы достичь финиша."
                            }
                        },
                        {
                            "text": "Please <w>extend</w> your leg slowly to test the flexibility of the joint.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, медленно <w>выпрямите</w> ногу, чтобы проверить гибкость сустава."
                            }
                        }
                    ],
                    "synonyms": [
                        "stretch"
                    ],
                    "common_phrases": [
                        "extend your arm",
                        "fully extend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпрямить конечность или часть тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытягивать",
                                "target_lang_sense_clarification": "руку или ногу"
                            },
                            {
                                "target_lang_word": "разогнуть",
                                "target_lang_sense_clarification": "конечность"
                            },
                            {
                                "target_lang_word": "протянуть",
                                "target_lang_sense_clarification": "руку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb7fcfb-143a-3056-bd95-81aa0e09fb70",
                    "sense_definition": "In programming, to be a subtype of or inherit from a more abstract class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this software architecture, the 'Manager' class will <w>extend</w> the 'Employee' class.",
                            "target_lang_translations": {
                                "ru": "В этой архитектуре программного обеспечения класс 'Manager' будет <w>наследовать</w> класс 'Employee'."
                            }
                        },
                        {
                            "text": "You can <w>extend</w> the base class to add specific functionality for your module.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>расширить</w> базовый класс, чтобы добавить специфическую функциональность для вашего модуля."
                            }
                        }
                    ],
                    "synonyms": [
                        "inherit"
                    ],
                    "common_phrases": [
                        "extend a class"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В программировании: быть подтипом или наследоваться от более абстрактного класса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "свойства класса"
                            },
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "функционал базового класса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd0f0d3e-77ba-3d0c-be5b-cfc3c2bd22e8",
                    "sense_definition": "To increase the quantity of a substance by adding cheaper or weaker ingredients.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adulteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the food shortage, bakers would <w>extend</w> the flour with sawdust.",
                            "target_lang_translations": {
                                "ru": "Во время нехватки продовольствия пекари <w>разбавляли</w> муку опилками."
                            }
                        },
                        {
                            "text": "The chef managed to <w>extend</w> the soup by adding more broth and vegetables.",
                            "target_lang_translations": {
                                "ru": "Шеф-повару удалось <w>увеличить объем</w> супа, добавив больше бульона и овощей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extend with water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить количество вещества путем добавления более дешевых или слабых ингредиентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбавлять",
                                "target_lang_sense_clarification": "жидкость"
                            },
                            {
                                "target_lang_word": "увеличивать объем",
                                "target_lang_sense_clarification": "продукта за счет добавок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34f53a6-202f-3fd0-a28d-4e14598f3eb5",
                    "sense_definition": "To reenlist in military service for an additional period of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After serving four years, the soldier decided to <w>extend</w> for another term.",
                            "target_lang_translations": {
                                "ru": "Прослужив четыре года, солдат решил <w>остаться</w> на еще один срок."
                            }
                        },
                        {
                            "text": "He liked the overseas assignment so much that he chose to <w>extend</w> his tour.",
                            "target_lang_translations": {
                                "ru": "Ему так понравилась командировка за границу, что он решил <w>продлить</w> срок своей службы там."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extend a tour"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно поступить на военную службу на дополнительный период времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "срок службы или контракт"
                            },
                            {
                                "target_lang_word": "оставаться",
                                "target_lang_sense_clarification": "на сверхсрочную службу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33c0ed53-2cfd-386a-b3d6-29ae514b21db",
                    "sense_definition": "A misspelling of <w>extent</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer used the word <w>extend</w> when they actually meant the size or scale.",
                            "target_lang_translations": {
                                "ru": "Писатель использовал слово extend, хотя на самом деле имел в виду <w>размер</w> или масштаб."
                            }
                        },
                        {
                            "text": "It is a common error to write <w>extend</w> instead of the noun form.",
                            "target_lang_translations": {
                                "ru": "Это распространенная <w>ошибка</w> — писать extend вместо формы существительного."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание слова extent."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "вместо существительного extent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}