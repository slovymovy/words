                ],
                "senses": [
                    {
                        "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                        "entry_id": "bc060dc3-9a7e-3cc7-8d4e-eff258e4bfe4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6cc501c-b9cb-4589-836b-cab7ec5a70a2",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Frau Kittler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6816e27b-9099-41e0-a8c9-f55dad29405a",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Herr Kittler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "71db9409-40ea-4adc-a68e-8614629f8fc6",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Die Kittlers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "98024d0a-d11b-464b-9f0a-22723e050f8d",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Der Kittler trägt nie die Pullover, die die Kittler ihm strickt."
                            },
                            {
                                "example_id": "251e8b61-45db-401f-b65b-31ed426f4f70",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kittler kommt, geht der Herr Kittler.“"
                            },
                            {
                                "example_id": "b6ed1cee-8a31-4ec0-baa7-78b5ffe06c87",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Kittler kommt und geht."
                            },
                            {
                                "example_id": "6b570895-f433-486d-9725-de5648b65914",
                                "sense_id": "aca92bcf-8ff5-332f-bca4-c43cdf9fa49b",
                                "text": "Kittlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
