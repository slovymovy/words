                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58ed0d6-55e5-4421-8ec5-af702d623520",
                                                "sense_id": "66d7dfe3-443e-3910-af1f-0ff55ddbf754",
                                                "text": "After their father died and their mother fell into drink, Petr Khokhlov and his brother, Sergey, were sent to an orphanage in Novouzensk, a small, dusty town of low-slung Soviet-era apartment blocks on Russia’s border with Kazakhstan."
                                            }
