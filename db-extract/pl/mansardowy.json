                "senses": [
                    {
                        "sense_id": "1e2af59a-df61-3795-9d93-a20cd2154453",
                        "entry_id": "eb2b11ec-e390-32bf-bf6c-c1c09b6559e1",
                        "glosses": [
                            "związany z mansardą, dotyczący mansardy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c022f5b5-b324-4168-ae06-e56022fbf7ad",
                                "sense_id": "1e2af59a-df61-3795-9d93-a20cd2154453",
                                "text": "Budowla jest przykryta dachem mansardowym, czyli dwuspadowym, którego kąt został zwiększony na połowie długości, zwykle symetrycznie po obydwu stronach"
                            },
                            {
                                "example_id": "19db555e-ac3b-473f-8c25-b3d7d48fee4d",
                                "sense_id": "1e2af59a-df61-3795-9d93-a20cd2154453",
                                "text": "Moje okna wychodziły na podwórze, ale mieszkanie znajomka patrzyło na ulicę już bardzo wysoko, bo było mansardowe, i żeby zobaczyć samą ulicę, trzeba było bardzo wychylić się, po prostu karkołomnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
