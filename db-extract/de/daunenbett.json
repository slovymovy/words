                                    {
                                        "sense_id": "95c2b901-a761-3b89-b8ae-8a6beddf1b58",
                                        "entry_id": "b8111ef4-6704-3c5d-9301-e68570b7d1d0",
                                        "glosses": [
                                            "A quilt or usually flat cloth bag with a filling (traditionally down) and usually an additional washable cover, used instead of blankets; often called a comforter or quilt, especially in US English."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada",
                                            "Ireland",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170aade9-4ff9-4c94-8a6b-dcaa1c5a1abc",
                                                "sense_id": "95c2b901-a761-3b89-b8ae-8a6beddf1b58",
                                                "text": "He pulled the thick duvet over his head to block out the morning light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc52df51-b0ea-3d24-8730-18a1388685d4",
                                        "entry_id": "b8111ef4-6704-3c5d-9301-e68570b7d1d0",
